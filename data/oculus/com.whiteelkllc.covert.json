833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMgllc0kKogQ7kNvwG9hk1b&_nc_oc=AdrEa1UGF1Hned9aPaoWw1wp2i4vK4uCX9dZPZzHzR3gvcQHHxFAsH9yUdSiAlAc6-g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUptjbMUZfVpisWvP7j2dErqwtILKRmlupZGGaz_j1PQ&oe=6AE60A65"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLB5nJ8JEOUQ7kNvwFC8z3W&_nc_oc=Adq3CEf7nW8nJ7gr_9A6a74dLmRqOEyvrkMLSD-N41KzMUE9E3_UduhcrsRD9DfIHcA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpdWe0X-5XAhuBoxgcNoaIDfulWwjxiWStbZNLilMm_Q&oe=6AE604B5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZgGZRXFesUQ7kNvwGeH8FJ&_nc_oc=AdpfzdvVO5Cs6bcH3vMETpIlTXfzZj2Xnti3DjAHJKxwthXHUs1MUGnb9WFQHoSZfUg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVrnrJooeCOzzR8BIEU1QFC7cmM_oa5YlMuTY0ZtCxPA&oe=6AE6109F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RyW8tCYRtGgQ7kNvwF9rI-0&_nc_oc=Adrs6wM6AFZCIt6hWbM7zYUdbOH_DnlCgP97d-SQ5VrXmunn3jzWag8csTYUyA8CrRo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPrWMvftmwRwwbZJAc4uPqXMXgeOSxVwYuucTbY_wg2g&oe=6AE5EEA3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELyRm3k8XG4Q7kNvwHBa3D1&_nc_oc=AdoSwvOR9UEI64UHsqlh9eIylknr9U4Qcrxfs8AcozSd0loBJvJmbq2w15LIa9gP0u0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsV9WuFc7lrO_MQo92hDY7f4sCpie62_iOUq3Ja8pU_Q&oe=6AE613E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
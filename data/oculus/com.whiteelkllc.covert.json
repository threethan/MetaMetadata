833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvHT8CN08foQ7kNvwGnhF6z&_nc_oc=AdpU7597b1HPJGSWniDQsSaGoo-qCjWLZw0uEbWYqJfGiVyEyZehJAw3NhueMpU-Cb8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jQvLhYNdWdgyW8EWQ7qgtfDVxWWzyfDhMZ3FMk_7eXg&oe=6A19B1E5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMIqv5tBLhUQ7kNvwHy91Bl&_nc_oc=Adqd8gg1c7x0wIvVTPfUqJi19bb7pOYtULaoZpEwvRNx1J7mGaxSMntHpOwJbVSxvcc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7B2lmOFgZK4jx_MXTVXHBVHa7_ez6deGj4BbEFh0rIcA&oe=6A19AC35"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6QA3QjX3Z8Q7kNvwEeSjyA&_nc_oc=Adq6j79NseW30RJJzTwbqWPPF47zwbelDd6-6r2CUSfFEXqkA2-fqRsypEShV6whgGE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5g8dh_w53_gZjh2WY0bfEiL4tQHlhD_lvhnL3DqA2BNA&oe=6A19B81F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHaMUiRWg7IQ7kNvwGoG8lR&_nc_oc=Adok2AE0dLQSwJS7ytAZb9LJlHQ6ZBeok8QxZCEMf_QycQMn4yiAcNPdhuLjDaLAYEE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XyVmBzW4OPsJKE-g_3txa7eIxhoRgPHQ0qnSbEWNt5g&oe=6A199623"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeWy4azQGfoQ7kNvwFIzETS&_nc_oc=AdoMEd70m_m8GSPEIKacH2vl5CPHQL4fOQZ2IiDc2_H24u9O91ST7ciRFUM5VrbB6Cs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SrTMJfsiBGsCakjO7HbCNFDxGOBDlwLVd9jAuOgK8ig&oe=6A19BB61"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
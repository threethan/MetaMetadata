833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikjKyyv75DMQ7kNvwGjR4F4&_nc_oc=AdoPIgiIdGIIPxg0jIsUZb7KY6JL6HhbeFthraViH6lRVvJ_32P8kejL-RQfXTV6nUg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RTp4p3GmabWpWHHKbPwoevNAWqJu8qCB0U2-4xNf6nw&oe=6A243DE5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inQmCNDrgOgQ7kNvwG9Yd0_&_nc_oc=AdoPZrCuhYmsnOBEOr-yZhlNw-ldKDXNEp7x5ph9LLktu-d5Q5OQJi1n6F7oe2pnfuk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WrvbXVsSTIThtaC_3utNNITcAKTNu2xx0LdeluKkcdA&oe=6A243835"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eN5ByShfI8Q7kNvwFvNWDU&_nc_oc=Adr1-rhf-a_TfLtdjBlxQoy63gqpql7jT-rWX7_L-h2KMawQ691zXaKkN8XpM7fL6l8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Oxvnc4ZlxYK9kP0SZEcR3sru1tiODhj8hGTmeCKxrlA&oe=6A24441F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-Mg3Si5KE8Q7kNvwECXQ_a&_nc_oc=Adr-FzgHvEXGCRO81Pdwbu30vhaVDZv4_N1evHBPj52C1DJwBufuN1ekXj2Y1fPlHAE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FNYu6tkK7UQ0bayAqodrYhsPNJa0Cwbo__LQXKv-9tg&oe=6A242223"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6K6VTFG84LcQ7kNvwE_0hcC&_nc_oc=AdqLpjuF5kVhNSEVc48gK228d5U7ITisz0r2_b-0oSk1aR7LPgVzJn1MOfAsGl2fJ8k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iZ1aIF0XFtj8gd_LlO6HqfW1og4Cwzd8Jzj_lum704Q&oe=6A244761"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
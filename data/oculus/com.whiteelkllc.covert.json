833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mqm0pk5mXZYQ7kNvwE_8Eue&_nc_oc=Adr19OyB9Oco1X2Ji9h-7CW126Co1FEEMkzZe9Ega61Fzy5RYBDelpanFSWioNI93L4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJmGMkpalSLhGZTfgSyXjdkC6X9-sf-gUL5Q-fQPJq0g&oe=6AEF44E5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXqPpiJEOqwQ7kNvwGaVhA-&_nc_oc=AdrXJW9rmfxOglge-hOPZceyik3rrrYBD5kkM0nSMTP-mdNAZH1TCkpIeBq1NFkWtqE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEop5z09WPNt7bKHb0QsIKiDMvOm0ahBW-4DMUy68VuA&oe=6AEF3F35"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_f-mNj1qCgQ7kNvwEcgTcC&_nc_oc=AdoHcJnTMYwaFMTv0ozq765h_fbSW3NFi0ComdwOm2F1-P_9Bmqzvo1--hk_pVQwyXA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOFW64LSIO8AJEnnfpdQAphKBSMzM8i8qaIrSzo5NksQ&oe=6AEF4B1F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hQ4yWJqQjkQ7kNvwHgmiEI&_nc_oc=AdrG88EpFYo55rUSfzkl7043aVWORDOU7kNOVbSnAY_Ji13LAT5cfNRV2WrznE4GK4U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR62OPYdSQPc9pPWQe7hW9447IsiAGu0mKYC56MLiWnaQ&oe=6AEF6163"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-9c5Z9J73IQ7kNvwE64poD&_nc_oc=Adq_8A9oR_TlBN1O_XBv6oDn3K-T_726Eqy3A-znQIOuUDJJG57lfwohX5OPL-E_0io&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxR6vmggZ48XYZEdwS3OSA_LZiDZPnm2l7gbgOvfwxtQ&oe=6AEF4E61"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
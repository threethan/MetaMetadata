833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8PUKvo_lzwQ7kNvwFuLsH0&_nc_oc=AdpgcYojzEBbzmqZGbj_aCex-z4RcAJRvEenc0sgI3b5aSwUK_jynMCTcRqwoDYV9_0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRxlThylumgj7r6YuGSDvh4wXXoMuwmQncTdYdytw6mw&oe=6ACBAC65"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dt7-JFs0_poQ7kNvwGvCYok&_nc_oc=AdrIxnUk-K0UDvZ4-sd0baDRFozBdSQJRyJfEEpNA9Y2MY7ivcL9no6I8tBTkahCf_0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzAHzTzn9fB_yMosZI1RYXDdu0ERsE8rSJ7Gy9urkI3A&oe=6ACBA6B5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjQDjZf80mEQ7kNvwG35bSu&_nc_oc=AdpmVwKW5fv7V4OEu1LL-kfSopMaFlQz2jS-tcaBqAh1YpZdQkPCHOCn_Wa2jBAYTUc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIgt9fPrF1isGmaEK-SI86J4zi6dGO4CiO-Suy_QcqWw&oe=6ACBB29F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mC3rO3LpICUQ7kNvwGKecL2&_nc_oc=AdoD_FNcDHqq0EYHz-_ms5-nhHLSIJ1UUbolnPzKtJ0Dm0Nxr1gIuHussigNeAyOOLI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7lSc9MI0FSrfwNZ8Oiv8CLrSo5ZTnecA2Ca_Duv1V8g&oe=6ACB90A3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8VJzERLARQQ7kNvwGCkR37&_nc_oc=AdqyaLrbBwOSU2lL5a5FjPF4M5Ka1_Zx3oY2t039TrJGBOXinaCbOH1xo9_GqKSPJt4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEz7QFGKmIu0n39rjFfOopoL26PxsDDl2W7E7ACr7jQg&oe=6ACBB5E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
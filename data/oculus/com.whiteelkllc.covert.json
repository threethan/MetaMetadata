833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ezv-fXEZlsQ7kNvwFpJJUs&_nc_oc=AdomGjK79KrhQDdeRu-Ef91JtZOaBrAMtKq0offzrmVwUUi7ElPlF9ceHvhN19hDL68&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EUu2-uxkeGC1lTWL_cXbVCyLHqirWFmXGlYmBRyCw3g&oe=69D248A5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aH5w8SloXhoQ7kNvwEJB-4f&_nc_oc=AdrZ1HpOIe5ZbrjLPaG5ES7EAB5FkmXjCDQrx16MEfy6P8XI57NOeUWduU1zzB3ZQYg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AShAg9lIwQ4-N6ivEdaZbsde-2tNVETXwN8plDUMx7A&oe=69D27B35"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWyVBxqJCKoQ7kNvwE_A1AW&_nc_oc=Ado2yV4LUyr3u-W6pR7BXfmHmeFIGb-j7GqfPFIktrom8A4QlxjA4jz40lXzEpzhINs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3M3rBo-KEjlx-fyFWf68fziXMxGYEax-y_juEVMvVp5g&oe=69D24EDF"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtSJ6xSH4KYQ7kNvwE9G-wQ&_nc_oc=AdpNKMzyGyYzJtavDwMZ5-04kCv14SL0uheXh_IcETT-IczXjCp5NHSKppf-JPuxq-o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af020bwPNpW8W-WJBSEtkcLEIfcPXpE3_XGlRCBmUqKLrg&oe=69D26523"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-jzx_DBDNQQ7kNvwGrjBma&_nc_oc=AdosR-owXvN9QAbOJqYDbiTo_7rSCtY1jWL1z39Mmh6VRn8hbrp4CBuZcjubSTPCj5w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gUpY0-NAHt-GXGnpLTTXX4nNIn7YC6puAbPzcA_YOcg&oe=69D25221"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
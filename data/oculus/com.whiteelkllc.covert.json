833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3HRQiZ1syMQ7kNvwFgV56-&_nc_oc=Adrlm7HTCmhz086T8a7idwgF2g-19KPnopFs4fYBm_Ymckca4OfNdIbaqKFnarKzcLs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxm5TkoO_xa3PfnDfb_oyz_7KXBklNqz30E-T3pfAnxA&oe=6AF9D0E5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPSlg6-n6bEQ7kNvwF7jzIJ&_nc_oc=AdqGvIIYEXvZjoqylkT83hflhsmbzFjaPM9iTO9WWzLU5_FoYiou6DB9vZ9PyTYaGgQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8sGxMDJ7F9yOFNy5gdTeMWletwRTlLAk4MpCGPBYNyg&oe=6AF9CB35"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAUy-Sc124YQ7kNvwEi8SLv&_nc_oc=AdqzYikNMyIHH7jNKXME7rBLBsODs6TB18y-M_hhYb0IefPAL-7J6a_6eFZWOtRR6xU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbJautjqq9C7S6VEel8T4AkxS6zIoYAiiJM05wQVHBXA&oe=6AF9D71F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCwOFoRh8VIQ7kNvwF2iZum&_nc_oc=AdrhZyyaUNwelSjQZ9toQc8BIaC5wGe3fhkJv_NkBWMEJbi5MwiTvP-hsB9RXrzmOjw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpNqD67kpMH9AEKwW1ndj6GYBdXHyFR0U-Ld3n2sAF7g&oe=6AF9ED63"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAuZoKf4w9gQ7kNvwE92aC7&_nc_oc=Adq_uKUILfen9gT9Lstq5yf_eWwX4n5WVpKpmLDMUFcKOvP8ikRb9hDgUUVm6OjXpi8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTC8-_YY-ExmgwBxF2_Zh7KRhdr2OO959rbBiug5pb18A&oe=6AF9DA61"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
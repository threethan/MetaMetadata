833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikjKyyv75DMQ7kNvwFCF1mh&_nc_oc=Adoe_vBy0hiSriE19YRILFHKmKEKLy5tTGLojY8D7HIWXhTyJHFuAMJ_FSR8pvYo7Ho&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9c2a6Q7O6PmQ8i5d45JZrh09J1yRKfftqXJc2b89LQYA&oe=6A219AE5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3h5_Sinw12wQ7kNvwGrWi2Y&_nc_oc=AdqJx8U3zDYAkZbVAo3QedQ17otpxws7wOvB1RFKk1rPFwajNyAfk53gNDr-VBhuzTU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yZ7rbcjAwgdE2Iuk38vT-e-oo0GeB5tlRYbTN2PyYQQ&oe=6A219535"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckeHYAaOM0QQ7kNvwFSu4Sh&_nc_oc=AdroPCLNiYxReqCWSgZovmNTnbqLEIZS9IKRZ0sLXOZOTG4qyk7yKMEfJJE1MaGcJJs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9K9WXY0Kt7ikEINecooNmNghQqryO06StD9YC-w-c-MQ&oe=6A21A11F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgN3t-5qe6UQ7kNvwF8SHOR&_nc_oc=AdpZu0wa9y-79PYWtCoxry0uIZ_G4_lFdQ37SjcBEYelPgBAibmIfxxwBkrD1YlP77w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-q_XPGLBuVshWCSED2-TnareVDs5q8ntaBVL5vFsmzwA&oe=6A217F23"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tO2xk2tNZZkQ7kNvwFzy651&_nc_oc=AdoOAtzxDI5VGsYdE7t_YG6KOTBJ2pQSFhEA-Txj0WmLd-wy_HkjNqlo3DAidrYDl-4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-66F4NQ6U-bq-_xWdvTPj1N6wWMK5H_Pw9JyF1kFK4ZQ&oe=6A21A461"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vv1sqjAkDWYQ7kNvwGE53L0&_nc_oc=Adr9JyYnlCvUXEVXhD8Xz5TUhP_zR2bViVJTb_f6r1QW2uaBGDcMbxm0shRHJYs6coE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6RxiVR8kZg-00tYb4OjHs-y0Y85aG8lf8T5gE3l2YLg&oe=6A5656E5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hBlrqzp6z8Q7kNvwETtpYs&_nc_oc=AdqjHmTvZSqymiiJsjjzhU4TPoGp6zAr3BZtKN-aoR2qJYc1sgN5y0YruKAukxbvomM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlPzyiubK1NyAh_YtVjPOFlJ5GHaJDGN5SCDXU5wvkXw&oe=6A565135"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOCKNdyJLIAQ7kNvwGOmp-S&_nc_oc=AdoEZuXC1Rh0x2j0j6UnIrn8XvVme_XoPH7VavPh-bwhLWv1zCKdojKXBCXZ0AOVQwc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAO4gIkNAOquMSfFqvt2gUDNuMxC4jfazYompjyuW_pug&oe=6A5624DF"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QH5t1WsYsmcQ7kNvwGv-0TN&_nc_oc=AdoX-EqpPVnHbfKg1wpWOd8xIPoNd3d_O7V55xFKdwVdKAJg1PjWJpLp0GtbQBukBBU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOSR1Xazj-Ij6mRlKe3D1sXac93Y9hgGjfUIkmI1GnTw&oe=6A563B23"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qm3Mpd8-dZ4Q7kNvwF20JKF&_nc_oc=AdoPu4N1guGA-ifb1ceZ5qZ6tJ2iD8KPi0srv1KpKXFhkkHT9qLlfFKrz1sDH-g8WJA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdEv2fCEASBtk0KVo_q7C7Pd5xUH33S9S6NE_1aNOzMg&oe=6A562821"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
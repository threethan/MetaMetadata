833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzwNOJBKTXAQ7kNvwEEcHfq&_nc_oc=AdqAggKLBNGp49we_b7_wrBHtgTHXMsOLcjbdUIcfbpsvVDCej8uru1h04g4bc9Lx8I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNJnM4SwIsAnHXjIa8iscn-skORVlA055ZC8lUfLnwzA&oe=6AB7E5E5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yFszn7JChMQ7kNvwH4F0p6&_nc_oc=AdoAMgsiRCsP6QqOZ4Cav_j-MqdbNVryBuPsjLnbfx5IehzzGd7d91lW_r3usITs4Uw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhQ9j13BbL4c_KO_4bNn6E6AojTcdDunFgTKJZeYqTlg&oe=6AB7E035"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBN11-BdxGkQ7kNvwGKA8Iy&_nc_oc=AdoshQHmYhFFq24yHJESt7ZNwEcfK50bkHxmCOotV9XRdVQU2X4oOhLEyquqMQV7PKo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ77dZwqriTgTo8AJ3R7VtKzfHTROYcq5tpnTYbnO_EEQ&oe=6AB7EC1F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=047oS8XD8mcQ7kNvwE9ejfc&_nc_oc=Adp-diD2NwjPCgr_ifSdiUuk0arKLU-1QUl6Zbd5sGkUKyK7K7vKj41-8uP1ipFYoI8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK01I_OrYByL4_08He3e1ihKajoQQPiOKfnzSYIFXbyjw&oe=6AB7CA23"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98VjZiQjWgYQ7kNvwGG5Q34&_nc_oc=Adrdkw6lRZ3QNdYHODs2CiG3_pyrlESWrrxd-WZFUUmhNqWlUL8doac1dpvjHmty_Ps&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7kytKe8Uv_W2yINz5rW-i2cP5cx5DkwLAZpwgyNUQ8g&oe=6AB7EF61"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
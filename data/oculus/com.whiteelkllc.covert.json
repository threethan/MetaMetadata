833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06dESJ9FGvYQ7kNvwGldBhF&_nc_oc=AdqO5wHgfMTGnbPCalrnoY7q_YQuFd8ZB6uWwcEP01njUQnCHt3IYisvU-_fI5Xlo40&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NL9mZ3HII3euxUKQ2RKTvk0_l9ir3y6JTZiA9_hgiEg&oe=6A3FED65"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8UPGDhSN0IQ7kNvwEabv5v&_nc_oc=AdrruXmk83EDGCcTvHoP3A_xEiOHdrT6ZJpm8DQiM7rJbsKxUdL-PPGcayblqVTRVBY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_V6cH1M715CWAC2dtLZgonn45Ubo5Okj_pjYxZWFkiJw&oe=6A3FE7B5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhJgZrQ_62kQ7kNvwEOnehH&_nc_oc=AdoXvRrVUb6C21xFisTYcyHZqufPOP4dY1gsEL6Qv2sGmVFv7-rvymSCytTg06jb-iw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QXF-Jphi27uCc6KO-f2zn4xBKndh9jHBPosuVxLhDog&oe=6A3FF39F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JU3_hjEsA1sQ7kNvwG3x-FC&_nc_oc=AdoKsy1Kr4xujka2XSFYB2aQcrzgd0AtRK0CzwW71GW5WujX2xkrh1vR9mGe_W_exP8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_auGeoDMUVFzc7aGfUR-X3fpYLVyztBut34dBxelPfYQ&oe=6A3FD1A3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfohb7QrcJAQ7kNvwH9Ng3_&_nc_oc=AdqVo3fJ2tLFErCk02Aso9CYThrLn0Pf6huD-b1N6kNqHzP34Ezk0kM82EvuFyv05sg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kI3BYm6myEh8DKZJRdgwqxYSQnI10SgvR3L3rUNIsnA&oe=6A3FBEA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
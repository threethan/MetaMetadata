-ncW-2Jhn8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Pv4mP7urKC37WgNfA6OG_OYb45OBVRLAm-wpc1llTyg&oe=6A36BC61"}, {"file_name": "migrated_image.png", "id": "253206549028394", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rM0ooU5qfAQ7kNvwFlIM7W&_nc_oc=Ado8LwMooenZx4wGdweLN5T2xOFAVotfW0duT1tZNvfEhBIFGGne_F2oIah5sM91ZK0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8o2zQkuvHUb0KTAitqadkjEKqgkUfXWjGXL5vqNLj-Tg&oe=6A369723"}, {"file_name": "migrated_image.png", "id": "218094582882646", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dCbzFZ9kesQ7kNvwEQlAi2&_nc_oc=AdrvEr4K0-F-DTJj7HOKRHkE0uIvqqCxXk-vxoguFieJLyMDLMbElTk7sPclwSwV5hk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SzPB1zacdGrD7k2Kh9NG4Z6a6iIww70c17giU0w-btQ&oe=6A36AD35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/2GGwDm", "id": "2004284723198024", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974841_2004284729864690_645501217715257344_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oe41QeDrHlQQ7kNvwHE0ZEb&_nc_oc=AdrVDFXvzGGpGeRoDf32x7nMybCF6Wt05bx9smKKjX0hO7Mrj26panM2EEev_Yy111Q&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oxMb79Td3IE2FjxB1GMg9SQVOJxs5Jh2W1y5rpBbo7w&oe=6A36AA02"}, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "Recruited by a mysterious client, you and a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation and trust will be needed to sneak past guards, hack through laser grids, crack safes, and much more\u2026\n\nTeam up and pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends and family from anywhere\nPass-and-play: Introduce your friends and family to the unique and immersive experience of VR, while putting your stealth, communication, and trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/privacy/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "2720827291556251"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "311056959495809"}, {"status": "PUBLISHED", "id": "271645033526663"}, {"status": "PUBLISHED", "id": "291561038180641"}, {"status": "PUBLISHED", "id": "413772986033040"}, {"status": "PUBLISHED", "id": "384314225626030"}, {"status": "PUBLISHED", "id": "649827842093917"}, {"status": "PUBLISHED", "id": "445581909533454"}, {"status": "PUBLISHED", "id": "21126408557
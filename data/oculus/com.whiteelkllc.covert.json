833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Zf3VXhzI6EQ7kNvwHrHVgw&_nc_oc=AdoCS6Y_2fEG0pEwsqU5xrtFQZ7AaX2_iGiYTRDiIWK9oDlb_QXl0wz2QcUFc1SdmoE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPloWrreKnpIpjPdzm1TI3dyZ4IffeQW0H8RgllpddAcg&oe=6ADE2165"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sf2ZSckQrgQQ7kNvwHfrvtP&_nc_oc=AdqgXrJivSd0luoL5N7FYLF1oXS_ZQ5hITzv4gKw5YySLIKH3XMUO9KTks8t4hVNR3w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkb4qDS9XquV56Qt4vp2q6Y3v0mbEoGNyXhqp4tTEAEQ&oe=6ADE1BB5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWASbkUFYOAQ7kNvwHJ-lJr&_nc_oc=AdpDxMsdKzlJx6yg9LZBT21JUGnIMjcYXSmS_EezD_mlD4xDlAN3yZQOqlox5JQkr6k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7fbR9vXxrHIuhAqzPX-tB0HFC6X8R3CZX-kjZ-KMmZQ&oe=6ADE279F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdz7CH_0b8EQ7kNvwESaSQL&_nc_oc=Adp42-Z3qm63Sf8NpGkkaKKB3hztaxYBbQAl9caL_8hKXUywaT2ScpF8Kh3xhZKeqg8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-LZ1G4x-hxXwkgrFVI7QgtC4drpcMn3IakcytxKCT0g&oe=6ADE05A3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIZS1KzsmdkQ7kNvwGPIzOm&_nc_oc=AdoXGR4YZ7xayBWgaSsUrvLWfcQfYMcphepVYR6JE6VRpkK2KMA0KnHksz2E2sG0mSA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTObLCW02Tj0ZSPfPqLEc9a6gPmQTi-XNpYQ81iH_Acg&oe=6ADDF2A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PW3EU8-00kwQ7kNvwHx-Hq1&_nc_oc=AdrJ5mRXDmFOFwwwelJnuwQfwMQStL8S4DaxZ5h5Idtw02C2vDwLMqogiVU6XpkO21g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8p4Ouasuxkvz21B7yhuiSNHPm__18wiDNQ6X5vAgrilQ&oe=6A3AA765"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tb7vuNN7uBkQ7kNvwFlYJy6&_nc_oc=Adq7M1tEVTZa5qKCSantha4SB1BaoR6pRduAerFE21bIQoSc_kdJKWhfJfe9E7jQKoI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mJgu9P9KNmbjPzNDdtTtFZ5RBVULfL6PDCOlDvW7fRA&oe=6A3AA1B5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75CgkoFO00EQ7kNvwGh0viP&_nc_oc=Ado8kvLygp1rGHuhCVQ0OqA3Lb6IURe20fnCDFxwGZ7toGT7ScpVHLCY2lytVCsWL_4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9300OGM8jP2_3_Vm12Ey7LMf0eb88mF-dNH4FFZQlNJg&oe=6A3AAD9F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PZee_uc7coQ7kNvwGf_6Hx&_nc_oc=Adqoisc-mdYh_Jg1o2qa8r-QN5r5tSHFIAl4hnJoaNUaSdEvUHO5nZ4fBvHG-yNh7yA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ueRGb3iuL5q3u7JdjKDNLYol_PVnzH2S5GaKzEkg6lg&oe=6A3A8BA3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H76PO2FPBP0Q7kNvwHQFdC6&_nc_oc=AdrEnh_KpeZJdS8xIsfqjo_B0cG27P7GBE_w1eh1fGSJl3iVhR5v9106vxVr8MTMeRM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tjpJxdapkicFx7XJEtVRQHg2axsuCsBXMcyBRtah43Q&oe=6A3AB0E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
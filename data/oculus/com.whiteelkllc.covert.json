833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JB6ODIQIkmAQ7kNvwHm7n6h&_nc_oc=AdqynsSUOTDOFdZHXju-ox9Kq9A2tWmRp3JXTYp0iD9oerPAqEySXzHgn3sht5eGpjc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOo7uBLuMUwtTkmWl1da97p4QzItZhiRHkKfsxBr3OBWg&oe=6AC66665"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aN6qVInlZtIQ7kNvwFIzeM9&_nc_oc=AdqfOtBY15eONRbiaZ2mwcnzlqihqLDPfvP20riJc8YrDFed-hCyGHyr5dOy8syuneg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2lwxYbV7DFBNq3aOOYlC5ThNy_Hi2Umgfo5lqtIwxdA&oe=6AC660B5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixfmIc3axSMQ7kNvwGPBGYx&_nc_oc=Adr0G_cqGaIxmn3Z0agYqv3wf-IFriiVrEZnB-5iNZSN3sIz_E-ysLCDZdnG0b8pYC4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNguu5XoUgfI5k7QIlEYHwiEDj6eNvXKvcRmYgxB06sFw&oe=6AC66C9F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBTray5i8g0Q7kNvwG_-NnA&_nc_oc=AdpiVHGs3t8e7DyxkxFrYqCtU-lvO9HKda-l1EzgK7Cl62P8wwLZA2zZWFnpxVciq1c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtcZzYNliL734wgVoDPWukNDHA0sNCu1tgQ_rI_8INRw&oe=6AC64AA3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRlD5KUdlxkQ7kNvwHcMvOu&_nc_oc=Adr2ktvKwXJnKW-uNT6hW-NwaQAKEpUhnEp4QJ6K-p81oFMGZnqS6vszvYIk88SswXo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNInKdGFNNwWG4jKfYq3zSXIqnJQPmWzTUNUb7RUwgWQQ&oe=6AC66FE1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
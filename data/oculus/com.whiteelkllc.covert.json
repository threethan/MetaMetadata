833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Ui3Ws5j74YQ7kNvwESgoyN&_nc_oc=AdqvKNRz5LvgcZDaDQiJd8e4KifLtiXUgkqRFhlYje0cVixal-6z4oQq6s6QVFmRRig&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGO7K3VBAEfzFCAH43nahdloVNfrc4HZlziuC3JskqaNg&oe=6A81A025"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hO0bLYlSDMQ7kNvwGY7xjB&_nc_oc=AdomsHlB9A44RB23z03maCs-zggI6Lvho2C2CtDp_QLueK2bCkd2l4Jps6_GEhmjM3c&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAZ1cDVOQw2bKAXiUhLBWEBGWedq3xpMlAWdWsST_RFA&oe=6A819A75"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaqQWrhGPxMQ7kNvwHeDkru&_nc_oc=AdoqO27gcxNbru9f4cAJn2sDhZH3lp7vPptgUP0V0OjmVN4WDvaalg92mqWi0fPA3Lo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3GUUL53Q2VX3imPhEyX2Ez2tp-mFLEA7KVDkZdmJ24g&oe=6A81A65F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoqTuNV73GwQ7kNvwFb7ieN&_nc_oc=Adp1Y_L8Fdo7zmm6vbpVlNF7oAKexUSxuMxhffEVhq9MalUkb0j5T1hgoD6hs7VHN-Q&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsGHuff2bSxrKx9w_rhNAfe3wkEbhWNVIndENwe0D1Gw&oe=6A81BCA3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVTYFycXyqYQ7kNvwHvyhyR&_nc_oc=Adot-4R7K83NJGCk3L4tqwzv3q0aYIEks3oR8kgACW9N9R8_24do39-NJQBBCkFfYio&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG08wz8GCZAHDWPPaSmyuJN2k_-3RGcHiE2veL5XobnlA&oe=6A81A9A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
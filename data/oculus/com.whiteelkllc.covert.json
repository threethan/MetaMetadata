833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyarDDip_dEQ7kNvwFSxkUF&_nc_oc=Adr94pX9rtYvVaQ2pUyevug2xEUNULyzJ2LBKtmvsIdlA51NKw1X8FASJw7efrQI_ZQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_0XkDv5tOzW6k0heeDFF6iPb8c7eDpohqtyqsY2cKkA&oe=6A1DA665"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05io0Zw6nKMQ7kNvwHK5m0D&_nc_oc=AdowzR5DwRVGTuMgtxbn4M1j5U0YbJLwmU3IzfYcejCFKZ-W1qUUdcNZ1YQugNEc15A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-C6ai2VwTEQm_DnwtlRddaV7lJEnseA5GInLKyOiuFA&oe=6A1DA0B5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDd2nIeZWQwQ7kNvwEgavcs&_nc_oc=Adqe9ToAFO_f6TcCsyxs66pbWyVmP-8kt3itxQMmyG0KYO0CVlYDeCpnc9aegW6ud5I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58dfoJkE_YoMb1hsVZMuTBbFa3bC1y5FVZ1-Q_sgXBBg&oe=6A1DAC9F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0IB-8odpg8Q7kNvwGuY4Xz&_nc_oc=AdonbQYAxFchL7Nul14WkjdQIO_YHHgUc3idl0-qHZUUDcLtuUqHvsFyBMLpSHjmO00&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5t0Y30IAih0QlboIzV5hlU_XMcWld2u8ijOBJy95bP1A&oe=6A1D8AA3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ErsoTQWzlcQ7kNvwETn0hT&_nc_oc=AdotmhBwlTWihUvSjYtnqETFUp8kKGaoR9ff26kh1WRe_PDos5r16U6vMZcFbZT00Ug&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7v3qZfnYNHaU_9z0PEJZAycKtWUQVsEM-3-C2JEltGyg&oe=6A1DAFE1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
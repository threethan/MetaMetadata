833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3U4G_Ubf9AMQ7kNvwEOABCz&_nc_oc=AdqkyaycsHwVM88heutzROIpQlOqP6nnV8HFEmssvmKfG7_da-JRrNda-cWITkz-Lng&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAY20jKoMLCc7_8qQ8xMexljCTKD427hhTsSFPJ2tdyFA&oe=6A6F2B25"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4CFzbHcs3qcQ7kNvwGApQHy&_nc_oc=AdqXbJDRnNUCRsn1u7rVtZ5BXzU1_oa7ugc3zG5yo68yoZFQXUFRR3t--9a7UQ_-5lA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBD7TSF8qWLEl5g3FypQ4li--KH6gTU9XciJ9eq9ebbAA&oe=6A6F5DB5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZe_9s7dN7AQ7kNvwFVrBo1&_nc_oc=Adp5fdA-T4tpTpc59Ab2R06UlO39SSZAjrLNH4MFaEClGci4B5R-2uv_tf6k-_wD-1M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBziio-zuwiB4RrHgfmB-1CDDYhjam3mkaIbe4p9zcX0g&oe=6A6F315F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjlyHtEseqgQ7kNvwENA0_O&_nc_oc=Adp3pNNP5_JXdj7_kQrtpEzmm7dl7Zk9CTgAxorcQg_RHNmY_mTzK-_7-LkGrMEsuGw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwyivYizre5Dbsl1A3hzGCrHMAwIuyzt_hmjaX18Yh5w&oe=6A6F47A3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aI3a47l1OlkQ7kNvwHvNnzj&_nc_oc=AdpAVjCk9SFZOS6tztGidaVw-nG-QzM8-AAyWGgQAii6wflkUtMm06TeWFLCMFdxDzI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7JoHF2w0v7rio0UITq7ZZGDKfY0OgPEL4DCk9a_b0Dg&oe=6A6F34A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnONPtgfglYQ7kNvwGvLoqn&_nc_oc=AdrrfDM5JeyMRiIgo4vuVRKJRJTmUmwAqU4aNhS2g2Kqzwcl77a1niQDuohGlvAC7uY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMaSVw7S7TKiz1pFwUy79vU6NOtIS4P69MFWtJ5ggi5w&oe=6A649F25"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCz5etam2T8Q7kNvwEwQU_g&_nc_oc=AdoA02EX2j6B8d9bc3KfgsvfabD4dAPw12gmGV5zxAKxdtEZyGfFfECnbcs_vcqnl1U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5sJb3Yeszwb-5Kf3b3IzwMAsSTLNJWMzqpILtHc7xiA&oe=6A64D1B5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGLmndgeYKEQ7kNvwE-lHCz&_nc_oc=AdowXdpU0ugPbFNOKQsm5D3cNWBLpoGz_XSM7z6ljj7Pb21JIZo2Ktsxb1YVT3onU04&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0iZgmHiAzuKIbTrPcLlR21dPRR3dAyMfYIcW-iG_1Dw&oe=6A64A55F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KmsUoMNHpsQ7kNvwEgyyHi&_nc_oc=AdqLVz_pouB2BLAO8tfnoJh1pcPkxkiK5ZlLAUF8WxM70g1afPJm3RTAN0BsjPxAgE4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDgTxzlu8HuBTm-OHYEhwk0-j-lcoijDBC8mcoF4KMQg&oe=6A64BBA3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmKCTAU-Qb0Q7kNvwFsqYs_&_nc_oc=AdqKwMMhAffpjqQJF3louCO8FNMohLP_Unf86i3e4pRIYNlgp333svej1zsQY8350Bw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0_XgSjtiUliXvQDxX_UN65FVOSqI3s7PR107IvX5vcQ&oe=6A64A8A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NAuTiX9H28Q7kNvwEfwiEJ&_nc_oc=AdpwfGW7kfLkPoDiOUk6PHWivyDM3wGt6B7wCCzCbC8SmDmWW69rAmEMJUF9Wt1IXYw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6V9PjJuDGyXqW239vbJgvsF1x6ntHw8j3ZSpeU7tDLOA&oe=6A0C82E5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hp78gim-jc0Q7kNvwHXYFfx&_nc_oc=AdqGLhwqP5weGnQkYSvVzWECqdNSqIEgCba493c8S0SITm5JOpct1BCgWweg4bvZoWk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SpE55qJNbuFoQMIdPAxZkccTK4nhlwcPcEPj49Hvtgw&oe=6A0C7D35"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZ43-CLCtd8Q7kNvwFtAl_A&_nc_oc=AdqmzeH227WMDPAzy4cjoMCExAp574cgNwi49ptH0hAiKsbtFyN2qF9q6AGEAnBzeUs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rJ2aZLQnyLAdIw1ABFTCdS1_5DF8m4qx8Z8B2WAbrKQ&oe=6A0C891F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCda9BV6GM4Q7kNvwEiEsq0&_nc_oc=AdqXw4lpl-joC1iPsNi6Aa4aAPV5llV-F6tvLuqVsmTz5LU-xBKAy0kkEcUaInMf6TU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5F3RlKrv5lkBRczMGMsniAjkXhHHyGwTAW6UCLPqi-IA&oe=6A0C6723"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOn19o_Kyj0Q7kNvwHDhOpt&_nc_oc=AdqMZl1KSv-yDQBxq6LNUgXrDye3vxGFLDtp5e7vzy--xkRDvClLi9XVcSSTPC1tfZo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63i23j6zekgbKUyBouCZ-jaRsYB3Et7Sdum_mXDr3JLA&oe=6A0C5421"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
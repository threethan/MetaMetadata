833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3pJ-6CJE4gQ7kNvwGHoSSI&_nc_oc=AdoU0k8Zay4OJxvuUFe87ck0ZIGKl6ITNfPqijU-L9QYim5wuDgw5yX7mLtkqUVZp2g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRHWm8ldyDmYvAXVsNpKXd9AX3YKYkgC2-OS4be_g4CA&oe=6A69E525"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdt_azYkZPcQ7kNvwHVUcMC&_nc_oc=AdrTEeIRq-Ddm4_Mmgq92TFL4kYFnMJGHnP3cl3OveAmA8LpG3Fya9rk3hOfWdL0U9M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoXSQ5uGkzKtvy0rqCoGIsYa2dZrt4Sh6eMqy9oaqIsA&oe=6A6A17B5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8nE7f9GDKEQ7kNvwG0EkoR&_nc_oc=AdrRVK9apYcDMFxVRUNyt8XtzJ2V7lDvZ4B07qI3_ZEx8_Z3oQml-UCdNn8EUhGf5d4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDA6z32smOe6v0PD0XUkFluMpKpvD8qLSLnLfSx407MHA&oe=6A69EB5F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4UwP9qGhdoQ7kNvwH314Hr&_nc_oc=AdpXpYy8dCs10oDFVVmNxlG-oTx40V_9fzAEY3YM3zrQ40QGN5VXEP7lGzf600tJy-c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeFgEH_sOw6zoKvTSah-WzecTxOdFrmNcrl7FGnve5Gw&oe=6A6A01A3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4_XlIcPG7gQ7kNvwEQkE52&_nc_oc=AdrDR_a-iqGOKFrRzxWoUwr3jotiUjFq8ah8iKVGIpo_UY4XjAv1_DGlVclDSypQiQo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0MARq3uZ1V2Pa5yj3kGTUjSbgs6lEDBLRcV_-DKOrOw&oe=6A69EEA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
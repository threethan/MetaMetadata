833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RR1H88me1CMQ7kNvwFvfC7Z&_nc_oc=AdrBZ1ebMLoS-0gv4cfNIyxoAUb0D_FaWNXk8u9h5ts7_uwBhub9yZuN4rVLD8w8SqA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bx6_fGinTvq5oTsmkCHoWnO8K2yq8vVBHU_S1hZ8qiw&oe=6A47D665"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elZRM_ePrrEQ7kNvwFdbkvi&_nc_oc=AdrpibjegFZ9ouligo9DZLCSEOMGB8BPo9bt6QVzeK0YnH1Jk35JCEG0MIWTBTt80Go&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iX3hwKodbdgAufZyzhWw7HHjSwUmVojBOik5sDc8hIQ&oe=6A47D0B5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kftS-KUm3G0Q7kNvwGXnsgl&_nc_oc=Adrxyz4TvAZiyBuNkapvYJLJe-A8NV78GOQGTqEi4BXrmTyuOhuivkdhXPTckv8Xmic&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ERbFyDTL2ao2LQ1JDqSZ5Ts4HSFoRpQghggWeYOAcag&oe=6A47DC9F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oje4I73psowQ7kNvwFjpK3M&_nc_oc=AdrmwLBkQ_pJxMfx6jaJV3Y4adNPyjRLKzPfpcPByLjnLrWzySKbpdgZg4dJd_OIcRI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-f_trEccWltqGQLx04TWxOKjUpYPO5QCsXcb-GV96ZXQ&oe=6A47BAA3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9i5hYREK_IoQ7kNvwGGKIVw&_nc_oc=AdqzQRRgUPHODRCuSAgvy7E0UfcAyvNSku5_TUtymqe6N10WfR9d_y6MZ8OsT8zkfbs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1qRnYlD_QdrQPcyC1xkEfjkEj-w-PoLLqp1D35chl7A&oe=6A47DFE1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
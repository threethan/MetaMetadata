833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfvFLraDRjoQ7kNvwEW77J0&_nc_oc=AdrTbsGuVxryp9ti3D1KmacP6Wsnjualt2a_CjyJXvHEuNxcn4zE4ffCRTn3iJGBg7k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB78e1iBRU2WJ4eSFFtXgv0yl68cWw0FJzC57z0tfApYA&oe=6A537BA5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hBlrqzp6z8Q7kNvwGDw0vP&_nc_oc=AdpPd4md9aeL_FCpQI7g3iDLXgQ2mibNY-TBhnkTV1-DvVqA3NN75BtB5-JbqvI_dqg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZ-fkgP1byjJtTccgpuYj0caAVdg0JyukWyLHwV8XSNA&oe=6A53AE35"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLzEGknrSnkQ7kNvwHn5Pl_&_nc_oc=Adr-I0DoPMU4TPD8TpslfBDSKQpoGT4plvwpEgGhT3Tl9rfMpsmyZ9Hzbd37l0QNQxs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARiasJh4FD-HEtucIXdRy53A01DoR0UdkXz9J_NXWqPg&oe=6A5381DF"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QH5t1WsYsmcQ7kNvwHV6Maj&_nc_oc=AdqDnt6--rqrY1bY-b75MJFPgIV8FeJGBF0t6VikSzWoOxK3nhNGHjEZ7-006AElU0U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0lU5BMMC8n9ecmb2sUEAn8cMGosaz-z94mlyiUEjd6Q&oe=6A539823"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ln4St9BhEx4Q7kNvwGbuVGi&_nc_oc=Adrf0mCEulIfqR0UfhLqRnhxmT8W1nJ9dBRaGj0zuzul0sTb5m2GUIsP0WcLD6b2WhI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOXnahJozNPjFzR4V8ixQwKlaOYF7yh95u8Gio6aNdXA&oe=6A538521"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
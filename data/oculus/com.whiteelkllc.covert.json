833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czvfVONfeAEQ7kNvwGP7aD3&_nc_oc=AdrXRqNijcCk7cq0iZvSEQdYrag6hz6BscaQ7Un4-oBT7qjdx1y7ycdFdTe1H-dxzgg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTVBDs_bDdTQi9OCWKBkoY_ReeGh2yhlxOLw_B6ZRWlg&oe=6A707CA5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4CFzbHcs3qcQ7kNvwEtYgP2&_nc_oc=AdqpqTTe2ZYM6titmWmVYWtJ-7F_wWlz-_ruaAlJNMv0c2wAvqWQSv9iphH6GCM6VIE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNGW-N8tmDx0iH-KO4u4t8YAFdhbQq1PDNoy7OSFHyew&oe=6A7076F5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZe_9s7dN7AQ7kNvwH9iuF_&_nc_oc=Adr2g6SWa27uIT3Kv7Zx-xfBXOf7AmKmV1_tCt82vDmuEvG8bchrCuaytxGGUgBZJAY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGNtY7AWhtV8ogpUPeRdGCqsq5915hobBzzZKqhq_qqg&oe=6A7082DF"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjlyHtEseqgQ7kNvwFFIWG3&_nc_oc=Adq2Mt7w5Cu1lfWWSxSw-S38HJoKy4AiglHXl2mp5Py3vrwmacO6Nl4w-ucUsSqvkW8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGimnWvlQgXaVWPH3Hd2HjQIu-8YN1--pLW9SuAuysI5g&oe=6A709923"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aI3a47l1OlkQ7kNvwHrmlOH&_nc_oc=AdqZmiZ_c0f_BOZ6S8JQFwBT4xM-uxs8Cqo1CBihQxsSXvOGviQNJf-ZCW4fu4jzBcc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpnzlZ8R4v21m2yJXulQYO_vG_DRnwpdE2MU6NDBizaQ&oe=6A708621"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Ui3Ws5j74YQ7kNvwGYXEwo&_nc_oc=Adqd5An33NxJH6U0-8EexVxJVrhQus6P29ArFmnEIY1oG86bCGXyqv8dmP0HDL2scIo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqE44I-u76meTeny3dJi6MWhn6Ktr7ra-igvHibTU8ZQ&oe=6A82F1A5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vI3OQ4RNRhoQ7kNvwFVuDB9&_nc_oc=AdpJnSV-fvFp4uQz1czBntDj1yrVzD2RO6_EezN8FGgxaG4T61Yx4d7jVYD1yhlxzfs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8X35uGhXL1nWnyS7l-avVH0SPLgAOxZ9W3ng6BD49wg&oe=6A82EBF5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaqQWrhGPxMQ7kNvwHihRez&_nc_oc=AdqN786CPwltmbU0jK6_M5eVS8rDHdHRQvL2EeOcmJIecpYUrnSUw0kASueT16lJsfw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFDf_iRCP60FrirdpAegnnT4xwy7eg5tMDA9Pe6htL-Q&oe=6A82F7DF"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KofHM0dUe_UQ7kNvwEzq4cY&_nc_oc=Adpzr5EmhKDoCAJ06C4mCPockYbjlnJTPsUGuDpnd5oFRSrUgdmedJR6XWWt5XfXz-c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvuvBuqmGFHw6VNegi1XPAaxwPB3uDblyFa8YrvHREKg&oe=6A830E23"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVTYFycXyqYQ7kNvwGFONiE&_nc_oc=AdqOIk1W0axpVeFEay9GxMH_OMvmPI0CFHVmfvANxhHJuGic7BTgAGfMa40xDsm403Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDDljTPuE3GqqSgIdJohH6Mw8mYzMpgiv8-LnFeTHgYw&oe=6A82FB21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mx8V9lyWKkEQ7kNvwF_Rzaq&_nc_oc=AdqROaq8PaXzYNueSk1rcKD8mI5Qo-SFRZlQ8m8ok7LBrUtuaj_bH7fWXar23R4_bT0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEEzedCNVx7ruU1vN2HghK8INspkSph1q2alTs2KPvpQ&oe=6A61FC25"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_OABTmktsQEQ7kNvwEIN25p&_nc_oc=Adqb14Nwuu2kgwRhP9u1ghGXiCsLhbXiW0a1Dz5slXQTmUznMRx2Cc1PXFD6OfaPfV0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmINC_5x6Zy7mg0qxr0VX-ubG03DorFBN2t4ahdPfupQ&oe=6A622EB5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGLmndgeYKEQ7kNvwHseB_E&_nc_oc=Adr7FoJhO6ZcP4ushHbpKfup9QGh1if908Hb42CGjFc_rBkkqcpv7j9DvDk-8AvwtB4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6GOn3YdEYrYnAXmfrcwLAVGz_XOqpzat_0QQAn6r0Ng&oe=6A62025F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNEW3XhWmokQ7kNvwHByCyp&_nc_oc=AdoPsyLjbFUW5pZdtvotAwjQ0RT38Na-xHLDCf_eBV0ASBzw9zcd8iXcQFG8BYdRFWU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5BEtqY_jxKGvRRcaZRPSjhM8gMWkeNvcvXvnYERbYYA&oe=6A6218A3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmKCTAU-Qb0Q7kNvwGn1vC3&_nc_oc=Adp3TdqWeIVk5B06KMO5Eb2M8MygwZ7JXyA3CSSqL3wryEyu8KzrhCOjIYl3xZ2X31c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJN9wjKOahKOrtuE8i7k8GG1utjoh2S-eVApjUfi1vBQ&oe=6A6205A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
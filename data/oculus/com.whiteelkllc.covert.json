833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwiYnbIjQ3cQ7kNvwEL9mmB&_nc_oc=AdqvOhJgbmmlKSEZWTTfmQ3mWgucEumL7ltqDcPlf4_J0XhckkH0RNSicYTsLUB0GtM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qAH1zU3iXrBbRyuLxa0_s0Sfd07vEtgJYr8pOwid_jg&oe=6A2D7865"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynGR9cdUuCMQ7kNvwGHVosw&_nc_oc=Adq9uk3T18I4848kjowUqUUs0VsuhRySCkgQEjV017PkpBRXJ5TVdfsBdclFdUz_6bI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qVCuUv_-MfWIVDCFLSoVo1-s0NXQxdyEKTEPZ9RJ32g&oe=6A2D72B5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUXEGKvFUGwQ7kNvwHcQa6J&_nc_oc=AdrsRJCa63Xe1zIbFVLCYeQM8wTFuyU-zeBgpHHPYuRTSJiCHnmp5vMh4QSV3jx7J94&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xMFCvAqoeshVcEVG5HBblfvL91k72keKI-Wcg858xWQ&oe=6A2D465F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24W_SeyPn60Q7kNvwGxZpU3&_nc_oc=AdrwlUlE4vQCOz3E9Vy971jPUvloU3kr6swDNVK49NAM8b76rRHLMqQLEyhslVATbKk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BbRhKPz8L8MpS2tbA6YikEvwHTnTvBM-fVGqE_tpeqw&oe=6A2D5CA3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpOyeOX2RgQQ7kNvwH2Ond6&_nc_oc=AdqTGwBK2MVNLijn5e9xh6q5ue9HW8Ew8QNvrq1CUAF9RPSTJGoSfrMEojOmUYnSCI8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-z5MtquoMiWbHf_wGEA5gdFk1wSKo3IHJYPl2BN0JmqA&oe=6A2D49A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
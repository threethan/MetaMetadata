833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6rN-giJNZkQ7kNvwEonOkd&_nc_oc=AdrpL71uHWVi9ZVnE2RzluyndKFjWqS0LOZDh8u-ckEIuQJu4X_ff5Szk7PIBOvbMrA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnv0EyQyR3BhUOpm85eCdrQSFCH95BiTQkWgM0Wba1gQ&oe=6A4D1C65"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nUBGmABDVwQ7kNvwHGUick&_nc_oc=Adq2RTLF2YEeEeydkSmT0j_yJeMNlyjiysAL7Kl2Ko-QWax5qyibVsxvkDO7Kzg1iME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYxHd9dxFAMHm114fuSpR31q_6HW5HUQ4MVSM-pkpHDg&oe=6A4D16B5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rw9gQHkxnUUQ7kNvwGDXpab&_nc_oc=AdqnxX9ZFSiHyEdPBU1vdj9E9tsEy93ju-9CEv5R11sXWmSIAeJ4CZ3-Gdg0GI8ELLc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5yuh1Ni67f0I_0sK4VJ3VK19mMATi3hL_qLog7Sphgw&oe=6A4CEA5F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2UAEflYOpsQ7kNvwG7nHWk&_nc_oc=AdqHmJgd_xEoY_3A26idcoic6jCyNbswvANcciCFJ5KU3wIU4vxAnYkyrU6YebZ7zfA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3kuCp5r6Yo1emtjscniPBa3z4KRzTRcZSc7TKQKenmA&oe=6A4D00A3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ad4Ju1ltZysQ7kNvwEvtTQU&_nc_oc=Ado7ah2D4wT-8HW6i4jhXQ2yfsWtpCEUUxvTrdfieStVt_OuDiLNgXci4bi3d-H_Q38&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTLo1J3Pb2u9Nq1JjY0lYpYJYa3pq2CVdaeV_bCHbqpg&oe=6A4CEDA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJtGT27MX4gQ7kNvwHMsF2M&_nc_oc=AdoXBPAf5xfAOeGEBwj7SUlh2lEt3f-farYgiVU2Y6SlG3Y_-8npnIk6oANUIi58DA8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8H0r_FNgNCuABFAlxVTjAs7D_0-eDjRKzHD3FuY06VWw&oe=6A340FE5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dCbzFZ9kesQ7kNvwGtI_9D&_nc_oc=AdqscGvkLHu2Z7BfqTe1-XdzFzNHHWbH1yZ8IDMdp6NJx-RrhmQVDlE5u_kJbjG_G0A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_J4gATpgg7aCELCVjlyqZoftnpzGXI6ojFc-4rKjLcPQ&oe=6A340A35"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PT0KYkM6AHEQ7kNvwE4e9o4&_nc_oc=AdraLCmt8w7SSY7RmvG26QvIe8VlvrWlOXAqqq6ibR9AC9jlhLUWHq0HSVonScFm9VE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sjQeVDd7nKhFQGAgR7ThgMH6BNiHLFlu9IckmtWSCUw&oe=6A34161F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rM0ooU5qfAQ7kNvwEAejA7&_nc_oc=AdrmNG769fAMa-fx2euZSoX5nn1D8hWYxjkOS_R1kueFND1XMulTk3nU8DMcTZLbNJY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iZk89WnKdtICuZzTwB-lP4xFwjttTNXgO3OOX0QjJ2w&oe=6A33F423"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ug27eI9PRnkQ7kNvwF58kW1&_nc_oc=AdqBK2IQ5x_HLzFVCiF1NDZju4szpiqMQn4VgWcaQHLEwp4Hd53SnHXK9eJtwMGM2Ys&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EChhccFc7OCnkjIxXlLCyGaI_mDmctEcxdvZe3R2_Ug&oe=6A341961"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfvFLraDRjoQ7kNvwEyNGjU&_nc_oc=AdrlX0D_1Zk9DoIRNgDIAgVSzoHl3IfeW5LKa2jBVobZBiNes4TM4mnhWbgtCdCUL4A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxSxYd2X22WtkDjKMTM10gCoOWgS8hm8nzKRFl7YWLig&oe=6A5110E5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZwnUAunojIQ7kNvwG_r45G&_nc_oc=AdoxsNGqibnM8xATzOAegMJEEUi0SsFVAaBwLdgDOD04noVCdKdlIqiiDkppC93jwSA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWfZwh6b2XG1KAZJNODqMGT33k66HNGhL709KivZUdYg&oe=6A510B35"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZGL1DKTPm4Q7kNvwHLca-Q&_nc_oc=AdoMDZ1zQX8uEKcI99ckMDOMvz2CRLsnWTjcXtL3i-FXLtO4L78p6UrzbtF0mHZUXjk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6j_o44_RIST6S8a8-ybSRaWXywLAWosKG17igytF6hg&oe=6A51171F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUlzaMRz1ZkQ7kNvwH7dacF&_nc_oc=Adrgr47tg-6vRMl3Gatx61pRvH4hmS-B6f_g3mbslsBzwQLYwUbE5s5LE_PCM3kS67U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCH_Vf86BytUqZlYVpONj9LJiyPV9OuxJ7UYz2wJowDnQ&oe=6A50F523"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t30G2kTi_EMQ7kNvwGLhgb_&_nc_oc=AdpSO4UQwqdr8LIK2kGRb9USQGAeU-8NKGUX_UPhqGOq76a6A7su09d92QagbYy1lVI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqpoQtQHhjBOuDrrAh7zAMG8rvAkb5CToihgbuIsF0fQ&oe=6A50E221"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
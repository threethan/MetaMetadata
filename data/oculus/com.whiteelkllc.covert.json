833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXKtnxZt050Q7kNvwHW5EIg&_nc_oc=Adpy2wbIyBicMVn-9yzKefhVv0XuMaa-4grmLhUVWQ8UzvVUc3vOO3FE99pruhzrNHA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BviudyLNs_qFTDyLAngHzBWtBnFfYjJK2crKWMvczlA&oe=6A107765"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUSaJfz_9pcQ7kNvwEe280S&_nc_oc=AdrmuReI7P41l-yJdcgqugHV2vt5WeYz0hr4j76ZE7xiJYzOIUf33o5byzkil8M-UWI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4P9PFck23dc6lllUmBBmLxzx2M0YW4lVy-IqLHQxzDAA&oe=6A1071B5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGTcwX5HUsUQ7kNvwEyRZrS&_nc_oc=AdoxuOSMUqORWnw99t3ys_Ix6vmlRGtQTUi8Od-pQBodfbFLwGt0iqoXAKGnXV29Rjg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CRjInxSzA-2KSqIMH8bnXdMVrTtnDG5X6bWsOZjLFbA&oe=6A107D9F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAW7vmvFa4AQ7kNvwH99OrS&_nc_oc=AdryF0xBIzqXvplZp8sZi-pnQOl1w9uzIbuerITOxjGwzhOZmV6cbH6K_A7ryVqDvJo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yXoCVo_FcwVh6byi4Y2sLOJlP9GOoLjJrbw1OHSzdvw&oe=6A105BA3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbEJsX8i61AQ7kNvwFPiDR4&_nc_oc=AdrkmCNkzz-6Rm8XVataF4y2XJcPp-tUohDSSE88WCaP3W6ubxpj2BIOMy6HrcN6cFU&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4H5zn-ICbW0Y1SWqyHFKycTzWxFNqy4lqkbdgi7wH6CA&oe=6A1080E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
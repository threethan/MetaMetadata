833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvUEJDibM_QQ7kNvwG9rp73&_nc_oc=Adrozx-2SjM7ptqKy8JDt1glxOW9tEy2V8F-abyyqewHqHWm7Xb2EAUBPS-Q9KIlFnQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNchCs92Iv_gJyNLBWwXtSf8MnHSBiSMadOMjO92BQ-SA&oe=6AD39565"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6l8ukehb6kQ7kNvwFmwTGu&_nc_oc=AdoP_I49t_46pfESpTFQqMi-sUYX5CWhLgXd13R4t0lEbHG1KSjj2YdxAJAFUyfBpTQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6rscWrYCnpbLpIieQjyB8gYVQnftGHgcdkuL3bqGvFw&oe=6AD38FB5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9kOZrXhZZUQ7kNvwGQanuE&_nc_oc=Adr0yewoKLYD7GMFXVRhbBgXVOLThTxvtW3arOr62FDlQMe03PKgWa1_2aqbtI6zQmg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkAz8gqI2-7h-SarF_fDJUl6ri_wxxptP3x-pyFrE6tQ&oe=6AD39B9F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvCQyuRaPhcQ7kNvwE88GgI&_nc_oc=AdpED10clkmEyjY4wRzi83X2PB6MnuGmlIuZyoE8r8wYzIvMpupwigAE2X-GjoDFGTo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM95txmTrGU48zC9uie1xqvDeeweu5Fc2EQBRB1j-0umw&oe=6AD3B1E3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yq6oY66-p9EQ7kNvwHTwatV&_nc_oc=Ado_kxVI7eOylOR6vMYDoI9Hpeg6iH7YeM_uSVSFPSQ7gR2EVU1hvcKzWo6pj05qim8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMl5sFb-snnYCiEjIUnjGvWvNBjNFo38EqdliOv-gYDHQ&oe=6AD39EE1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
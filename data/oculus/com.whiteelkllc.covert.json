833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NAuTiX9H28Q7kNvwFFkf6E&_nc_oc=AdoVPmwgGv2GLs_Cf_gphuDSoB0OOUiyG_I-FOC4zRCqdHM6XHBrtXCA7o2oNs5Cv-M&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74Ml4Us7qP8ooopAdairgQio5HLWBUqYovL-R19QklQA&oe=6A09DFE5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YY5e7PB5ahUQ7kNvwHlH_Ht&_nc_oc=AdpB4WiOwFXEePN9h9NUFwLh6poK6UhiOjbvGtpopwNorRCbG3kAx1vatxKS7dOgBww&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5p5XCNEDUM8vW_SExrCOtq5s6uMvNqVXHB337fG1yLvg&oe=6A09DA35"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vag25iQpdZIQ7kNvwGiANLb&_nc_oc=Adpd_XSSrMux9iyfIOIqyNqAF14oMrZe7BP1j9UHr8lEvqGhRklB89kmAWWcPlZjVCY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nCxaWksk4yfNsy2m9Z80Ew1uZHN4Hu3kp3UW-7qN59g&oe=6A09ADDF"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZybR5DbUpGUQ7kNvwGo2SZ5&_nc_oc=AdoORZhi-VWRi9G_GHsmGsz5K9MPcRzLXnyiV_MjDF1l-qoS8KJF_T4RwnPsRSY_LRc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4opL6cVQr-xP_Nq4IhlC_nl84-fduiFPZ3NDhY96DOhQ&oe=6A09C423"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKuLRKxQK70Q7kNvwHYTlNv&_nc_oc=AdpfhqUakVl3PCt52lOfdHnSES1NxLmu7HOa9hBKYi_httKOa0eQHpNHy1_rdykpVUA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TZhQYqxvY5ejPoave_H7kUYE-33ErUWGE7_9bH1U8cw&oe=6A09B121"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
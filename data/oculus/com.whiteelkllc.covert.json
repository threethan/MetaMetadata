833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdRu8hqCRH0Q7kNvwFtsgTx&_nc_oc=AdoJWiz48ZhWHvCXorFjXifV_5LZMjO4OoCF2cvL3hMmDqPWa4t-FGG_Bf2YJvsdmO8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAN7hAov4TKBoCMJCZk6zst72gwWr4vjpa8LWm85TZ2g&oe=6ACFA0E5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eI9Msp83HUsQ7kNvwGY5bqt&_nc_oc=AdrI5hpBhfBCnJsKBc7tbmjGwuITP7jG3IuO02BXfa8o2pelVBnexoCBWg_jFdsk-QI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLTBprTeI3-Jn5Fzi8DE4bi-l4Jk_SX5TPU6PjU0pNZg&oe=6ACF9B35"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUQxbcg0l1oQ7kNvwH5vd9I&_nc_oc=Adp9emgh4YKeWaBGqJuZZiV3ZllVdPuWbCY4hq5qSJ61kmJ9vKYAfdBLpkA_Ysrit8E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkkO1kvR9zWjVTlKKcJoa3JiZYD5hqd7UUnO7rwgsRWg&oe=6ACFA71F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AupCbG-mp3oQ7kNvwFVcHlD&_nc_oc=AdqERLX_7gLcqVNC0-FZm_wdYhMeQ2Hz8pv_XLJJaNWnyAQuJ-c67BzQdgdDFS9RthQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9fSGrh_5xJdJo7YiQv10i6phEVLpUwLwK6ixNxdDlvA&oe=6ACF8523"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDX7dlTWf8wQ7kNvwHxl47k&_nc_oc=Ado04oNiszG46Q1XMMq79rCNOTSh5KZdGzbMBtwsxMykWS7ZxdmvurY3zPdkVmhFUO0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoFydyhQiHepY2vX-mSHfY4IvuRaMdfGxb9Ci9-4cj3g&oe=6ACFAA61"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
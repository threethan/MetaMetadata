833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2Z8bNrBYc0Q7kNvwGiptmK&_nc_oc=AdrWre9YsHj1-oj5RuIjMjCuWx-xOT0uMadvy-8PHX8zTOxUipRhr9pUjVn4PHIn-aE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af435NIhW-ZxzlXCNLAZ7i89UwZfD3m56UB8i2vjkvCjkQ&oe=6A146BE5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ixsVHqpq5cQ7kNvwEOnzt1&_nc_oc=Adrn0bt1w2r5PoTL95KKeKebsmTflnH-nrx6ez8KF1BICcUsaLmzAAXs05Y9xGSIZP4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dV2PmReLaoCz1jRxHyymRj3K8FyJil-nZhMDftd2qkA&oe=6A146635"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqx6T37w8x0Q7kNvwEObuY_&_nc_oc=AdoAPv-GARWvKLh_ZCq8LruKv1Ov_3gGQg_F38B1mWnxpuZ_kHGmF3tplxwqrpM0A-0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MMIFSiQ99Z5mXn1huom7aNmXlBuLX-7x8awcrwWLvLA&oe=6A14721F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZiZxd320nUQ7kNvwEJZPMk&_nc_oc=Adqe5owVc5h6IfuvPjIY5RQXrLTcry-YBAhrm3lFL_EtIdrY-amSKz0eChFW8zUXf64&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZkBndnUAK1EKsyuHKuEz_MhuOnFjHPcLDTUedTl8kMQ&oe=6A145023"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfoADFgPt_cQ7kNvwGGtx88&_nc_oc=AdpRzYUbZ-RUm6llCxptAQVuAbmurN0omD0Nsx8ZK424yE1zxLZccbDyFWluv4ncPG0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63o48tW6H7bmb1aYH_q1ldriGOsJuLFyOS-icoN72wmw&oe=6A147561"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
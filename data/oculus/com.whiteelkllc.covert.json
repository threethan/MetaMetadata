833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhIx6RDs8OYQ7kNvwFtFlcn&_nc_oc=Adq6DfAN8uDX735JpY__ODaMe3eJ_IQIGd3cNjYB4o_CyaXRpz2TGt3NZKjXVu08dVA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBI_c4DAzQev2WduJCU5b9YOv8DEkP_XPl51Q761KlsAw&oe=6A5A4B65"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGhEjXTOjjsQ7kNvwHqXca6&_nc_oc=AdpTL1JNBeKxQZYszg9k6_NmKQ68GyZIbZ0ZGBw6qIqUxeAi9xP6JBpwZtXb-EJ40a0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAc07Hng8GnpN-Cnh_1zk4wjdzxJvYeB9VICQzXk80cGw&oe=6A5A45B5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NqiGXMGHJuIQ7kNvwHruAvu&_nc_oc=AdpdHgaSUTZ4PSDsuu-8hD_ooSYs6phQcGrPJ7drhwZtOzQ3cM68nQxxUOY34CrwMyE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGSbPiS_XkteuPl96zjLOu0nZHTBt3VXkvQlBJw2iUjA&oe=6A5A195F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWksozMBVnkQ7kNvwFUeAhb&_nc_oc=AdpSM6DmidriS_fp3zDU5II7how8RhZehSVlY7kac6wOhQUno48xuou94ceMaM56lIo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkclsadF36cMtR_P2mPOslEFeACcPj58eHsEABnzhmoQ&oe=6A5A2FA3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hffge-FfMrIQ7kNvwGt15Rb&_nc_oc=AdoxR82HskX_eUEWuwFYeIeHgJtyzCwpkSgeKXbDZ5TL0iVNE9r0LkQgflcPVv-K9pw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHR98_akTCixSLFr3TpmE5HPktHbXxPrwFOtCtXXUvmA&oe=6A5A1CA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
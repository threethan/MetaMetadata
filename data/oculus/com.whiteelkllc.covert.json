833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXKtnxZt050Q7kNvwFR8btB&_nc_oc=Adr9aKDdiWsaOKNIFvfx8WFMZNH6TIBCBkKYF_qaL1ywOZ93x6RTXyUwpZ_IFQm9OY4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70ydiCWpxQHruxtkp5NV-XU3evQllQkCK4E2KJEvM7Jw&oe=6A0F25E5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hp78gim-jc0Q7kNvwGZVRfV&_nc_oc=AdpJkkCYbrzmkv7xck5V36m2hp5IBer68MxlrdfZ6AGohGbcw2LRZbpUYaoeVYkNTNE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fSrLOMXVgFfX9FHZ8utnL7imXrzZJeSQ6_1d__P3bJQ&oe=6A0F2035"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGTcwX5HUsUQ7kNvwFZ1E38&_nc_oc=Adqs5gosq9yKbRwBd_YC4vUHz3SN-cea3PyM3KnbbnbGPQDtlGn1OBeedknb5FC2_So&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55KuY4vCxKjuGfl3QzztplJpkWgjEfc3caDC-xi4z_yw&oe=6A0F2C1F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCda9BV6GM4Q7kNvwF42Da4&_nc_oc=AdqPnMFlbdS6wFrIhX4BqmIHQNda69fxYE3I_BBZ950UO9Nn-cKOUNmfucBxy7SIZ5g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5v28TZp_50gyTwNUH7wAlnjqXPmyoh0lPcnj0qxa9_Jw&oe=6A0F0A23"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbEJsX8i61AQ7kNvwG8ToeG&_nc_oc=AdoNzaIZb4x4tEU3sHiAtJzCBl4JVC5fUXBwr0zkMkf1AoZBEFC83jYfRn_bzrsttRc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HLy7u6ECH64z33oAnYxwt-fLyzco8dI2aCddQIp8nPg&oe=6A0EF721"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
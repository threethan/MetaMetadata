833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shcJJ0d_9WUQ7kNvwFvy9Qb&_nc_oc=AdpXmqDc2SDthRhbvJ6pTwiRUm51LlvWiEawLfZXhaSHCTLxjAI7orYLIk0e9dUJp-s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHL0fyb4efQr_UrTbylih06KV1mAakVVLB9Xg8_kFnaQQ&oe=6A7C5A25"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLAx5UkmWmkQ7kNvwFszSye&_nc_oc=AdpfLl5UtV0hlcEdCZpf6xp_xBlpE3IGTYbwmqCmoIj97TipmmywO0dh_YIF7rTkeoI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2t2fbS3SmnlKAamcPsWYU47gHOGk3oDoh0b8Xf_X5OA&oe=6A7C5475"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NutnQIG17u0Q7kNvwHyZYNa&_nc_oc=AdoEHvrA6e_P-wf_SJKnZH5lbiiWy2JLMwanuuWZDkbmMxv8QjFNIu8Sm6s7xRPYb4s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6wyXFUoPVDVW-ER1yMWQ4hY87L6TpUM7ki4vI6OaObQ&oe=6A7C605F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vI4EakWj3zUQ7kNvwG5T5kr&_nc_oc=AdrmtkZA_6XQNh5MY4yT2R9vtU-ypZ0uaG6WA-2yPSodA7N7rlKQ2DzzFhMYdaohktU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEicmTATERau-Rt-no6ozflWtGKG5KhUVkAvVOTRGkYDA&oe=6A7C76A3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJmoMDHX6kYQ7kNvwFn610y&_nc_oc=AdqZQX8tCPa0yNToMzwqzLB49CdyZ-DSe7MHUrPaDTDLn15_blsx_uoiZn7_Csh7Y5g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGydeW87k9CTB-3UeopBFsDvLbtU0FP60G8i7qrOCorRA&oe=6A7C63A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
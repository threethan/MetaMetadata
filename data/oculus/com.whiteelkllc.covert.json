833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jaq4L-O8Q2QQ7kNvwF0tcPL&_nc_oc=AdoqZIx7PoTw7BMe1ApKDDQcyxI0GiUe__pihiHJ49xCMRcT7D9BAis4sBVSbVr08QE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mzaidAchQN1ybvRGoNuEqwzxB0S0pSa4I-VkJnDjY8g&oe=6A43E1E5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxglnDjMQlEQ7kNvwE8vps3&_nc_oc=AdrpNvoDptASS8UEcDj6ktLcFpdlaoKvXOAP3IwqMEwAmmYw6bDgcE9GTyv5-QXph1k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-inbuIGXC-9-mYHJrTvJsMjv6RAr_VcFWoC-POz8y89w&oe=6A43DC35"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knUeDAUuBTwQ7kNvwHNms1N&_nc_oc=AdpusmFE0juNyWT8bHazwF0ITBW3bRV27UAWdw8Y0bS5fg_YSAawL8r6_BnN_cLHlQA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MScvJzt8imkoysyIGiTYtC475C7Iwk0d8JmZ939Ku5g&oe=6A43E81F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsC5jUhJrh8Q7kNvwHgZdJQ&_nc_oc=AdpFOFi5rijJlKjA5JX_Dg3zOL7KeFPYbBBtq5qpFtUvA_iCoFxiI8F_89-bE4zjaZM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fpuFdr1CFvoBqoR0X-Bg9UY6293foSMVHsvArHU3k5A&oe=6A43C623"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3eBMoPoPjgQ7kNvwGspdFU&_nc_oc=Adr_HjTzJsmIKNwc8p-kysqBvwGU3_oUWhJB7pfxCuuJZpNfNHn8CJfAHQTxkKNhUJQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96M2MKk4HgV1Aj2qDPn7_t1vv0KlMBjDv6Xyi0Q7_1HQ&oe=6A43EB61"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtAdyKgFVVAQ7kNvwFh1UW2&_nc_oc=Ado3eHeDp2DzJ89PGUheq1r4yxUxu1bv0tNgAwz46GF4cZ5JdFNXCZmReo6SGNKhvuA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Y8QWlc3KQVAQDd_m_E2NcMjDYo2CT8nrkNSiIEOrnIQ&oe=69E60F25"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pU6qQ6kmsekQ7kNvwG8_UqY&_nc_oc=AdrPBBLDbHFqb5R3W0ZkN9-TG4ya4mgzQl08e5gYLmVg12H_gTDClvbBQVkPKKIrRfM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Ei5I_QfE4DZ-AzJXMvshHb70XYPYso8Iq5VBTtCs4Zg&oe=69E641B5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQGKieTwaTEQ7kNvwEEsa0y&_nc_oc=AdrciGcsWDsuiXmyyKtDIkoqnMEEzOCvwqBquu1R3mKYqzc4nPq6CQ_ebOM_nMWrz7w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LhbGaXsrzRS_YeaUhKz14oNAGLfw3xJO4BIgq-2R5cg&oe=69E6155F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-NoCZ_wUWsAQ7kNvwFMDEah&_nc_oc=AdqSX9cetHakuqiZ1sUwluT5HyF8iGU2Hp45nNkPw15ADBunRAvnB-VPqlCrP3xhInQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xHq7lcZlyc37P9rHV_0KtaZe78X3ZoiSHCipPn-OqGA&oe=69E62BA3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNd8J0i67pAQ7kNvwHIelt5&_nc_oc=AdobXNoQENKG1usLRcXUh-KRKSjvugVSu5YDT1jQWeLQsojbzwPi7NW-CQQ7LbCOj2Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dL0BfZjBVc2XvwNxeJaKERj8p61aSqmbpmgB5TUCEJw&oe=69E618A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
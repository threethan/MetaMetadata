833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjWIlE6YndUQ7kNvwE0wHg6&_nc_oc=AdrftKc013gDVWFfFVDYmbrFyCHQVw4QyVKCluGJQfThz7KMBtboYd0EFZ-SzCokT8A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7I1vyBY-9jbiFKGTK6Umzd0KwywP5hjAq2Lp739fhkew&oe=69FA0DE5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIvcc8VfADQQ7kNvwGCMkUO&_nc_oc=AdpACXN-cln042QjzD96GJYhp3fzU2D4KAZ5Tv2B03JzS6prZkKWwxd56P30-gkuu6k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LTuZ33Qs7zTI_Hc-s-mx9wohbpr5UVUHZSZOUaesWJw&oe=69FA0835"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TyHuxHPlRQoQ7kNvwE8sDgW&_nc_oc=AdrMvWw_VNgM_V70ntKVSVs9SFTQZeGxDo5Nge0zhSJTFLajvxlDK-xfVBAuyUEavO4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ieh5sLw7Ab1iXOx-wWtW26qgajGnst4oZCcZalpz4xw&oe=69F9DBDF"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYuRthqSuPkQ7kNvwHc393I&_nc_oc=Ado_7EIK-acl3UcjQYtmhgWQGvKvT8NyVGCmL2Wc4_NIBRU69x5RKZq3F2Ifz3igMvs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UVNt7r-IOymQtpih6FXU4Bi3cDH4JXUuft9ptbSU6bA&oe=69F9F223"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bssIgEvMDQMQ7kNvwFNgFnp&_nc_oc=AdpAxqb-Mu-2xqBR5wsN-EAwRBGHBJBrUPWxg7cysxZrvgt3NjAEUz3W7WTOtEBHcps&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af793d8XQ5pG5eMapzaDNOh7vmY4WewilQ_FjsZ9FHKZAw&oe=69F9DF21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
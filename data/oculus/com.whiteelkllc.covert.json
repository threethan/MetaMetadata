58833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2Z8bNrBYc0Q7kNvwHhql2K&_nc_oc=Adp0ru4_pkaF14IH6Cs_7Jb0KbBVGkhJfwvLSGmncQcx_dY2ARkaEjTTKNw7n6X7xvg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7o6s5AdB9F7UroxtphbY4BrzPLo9A_GDbEB7ivOYnWzQ&oe=6A11C8E5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUSaJfz_9pcQ7kNvwElGwKj&_nc_oc=AdoyRd-5j2B3GnJnDIm96fpiuSydHdhU3RHq1X4Xwa8wikbqVz1wavZBsVIEm37838I&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4V-1zM3Sf23D5asfNb1m6b6Nvi-n4Rva5JXiKMNwprWQ&oe=6A11C335"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGTcwX5HUsUQ7kNvwGbh356&_nc_oc=AdrtP12NZJC77-l9Btzu9gY1PHTUzUl9gvT35FBft3pTmQcyOrkHYyD2xS5gXgdOTOY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Tdq-xA2KNvOo5JxMPQ8Hg7p6UUnTLtmMJzqWh3UD1RQ&oe=6A11CF1F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAW7vmvFa4AQ7kNvwHvrBWP&_nc_oc=AdoVqzTyNl0Dz7kvDa281513q-6CcCv58zGGiK-mJ_OI5JbHsNvOj3IkquANG0Abhg4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dsFxMd-PE08P7RMmxviI3u-WxOWzEOhh1IonoUonrxQ&oe=6A11AD23"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbEJsX8i61AQ7kNvwH_aRYf&_nc_oc=AdouZlwkyTbqN_rpNTmTJWOUyihN1u8xus4Qvc3_JCCDgGVAehljgpe0G5TT3-C4SZA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40IVyQDCDIgDUz3opXRTl2nW31n_wW4AQcDBxb74ZXkw&oe=6A119A21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area
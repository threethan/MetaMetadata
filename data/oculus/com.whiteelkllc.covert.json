833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvHT8CN08foQ7kNvwF8-G2s&_nc_oc=AdqTFcYp2N5DqvfLfIjscMQBrJJkEr27gOokDp6s1nKe0LZSDDNDAa_jgXhjsiQftHA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SFCaU8V0Ro2tKA3vh6GnDD4G6-GXQ9WvM2g8akFnszw&oe=6A1C54E5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05io0Zw6nKMQ7kNvwFxcsQd&_nc_oc=Ado21CEZ_0nO3RZXDJqC-u61YjXFoRMZfv_mhCSo8sjcdjtlkl7cHxzR2xHArfyQILQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7A1IzLi7AwI3ZtajVeQLmxcen8n_ebe5-XO5ktHLubHA&oe=6A1C4F35"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDd2nIeZWQwQ7kNvwExlCbd&_nc_oc=AdrHoa3_KcIpqaX23hwnxq1G7EeADUA9fg_t6CPLkIw8lrH6_t_lSoJR263bmxnA3_Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46xXPFOIQS-oJSCiVARjMcB_jAGlF9H9WcaWQ6eMjTKw&oe=6A1C5B1F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0IB-8odpg8Q7kNvwF_7ixI&_nc_oc=AdrF_uDnc9tR2UMAkbYFa4DEsq4nteUg7iW4fOJpk4aZjM0jVcbQ2krQZpQwb4Yjgwg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59WRQIDktmBMNKqjBSNt739Xko4-gcKvVqzayNwPoD6g&oe=6A1C3923"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ErsoTQWzlcQ7kNvwEajE_L&_nc_oc=AdpyqMaV2HLKoWYNccnZoyUBT4KCxvB_7Y8BbPVS9pSt78uSp9IbxINl_kFhrzxseIM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49SZmSv0eLyp-oWkBd2_F1sc-K55W5H31S0tngmPlVEw&oe=6A1C5E61"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
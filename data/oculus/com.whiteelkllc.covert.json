833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3U4G_Ubf9AMQ7kNvwEmrFl5&_nc_oc=AdoOKH3lKCIXylQEug8PNMZFJ1UWlo-o0otGr5RTwOFRDjwKW1GKBvdw2Y1Id3a0eKI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBo6u4dAeoWIhx8lT-UwPTMOBD-xR5zjFsM-aNzlYFnMA&oe=6A6DD9A5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPD53ax_qYEQ7kNvwGkKvNn&_nc_oc=AdriGus-dwLssl-zanTM6igNcCP7xJj8vaciOyDvxtbmUZYA_K3bIw24tygaQKhrcp0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2PL-VsDtuYb6Pb0pyp4Lz8hwK5yZyyUuoTdz27NzH3A&oe=6A6DD3F5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZe_9s7dN7AQ7kNvwGL_Grp&_nc_oc=AdrAjvkHOaISaMeAtnQ-uBGjXKkJK2TVWj-oD3Q0MoV32oi-A_cMCWXWap0s3lUCY4g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVGNj1jTd_0SWtj1n7ae11yc9aYbEieHODafgIcHLUrQ&oe=6A6DDFDF"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFAcdP31Md8Q7kNvwGxaQU6&_nc_oc=AdrWBon_gL2Y4cVFyGDCMGTYIXBg4N4gN96SF5EEbaiXVh1QCqP-_RuKzynUuEJUjjk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXLQ0LVgO-u3PCBS8QpH_R9Xj9CMrGTpp1Ar9nvl5hrg&oe=6A6DF623"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aI3a47l1OlkQ7kNvwFONUQo&_nc_oc=AdphuWFquRpvvHqjOOGvJZa7xgT6JnR55v1quZjJG4NsoEbMA1Myf2avylyI-0r9H6w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSDdC9eZIC0dvG2cmLF952nysuJT5nknIP9YImpLHNOQ&oe=6A6DE321"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
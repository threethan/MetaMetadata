833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzwNOJBKTXAQ7kNvwF6djsF&_nc_oc=Adpcz-li2m6UnioNm4-JYCaTBwoYT2upveDvi8RF50eqTbCZUj6MevhlP2i3FmUP_jg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJY8oYPgSe6rcMnWPeD-XOl43HlK6mjuNuXA3eC9eeQMg&oe=6AB93765"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yFszn7JChMQ7kNvwFUoFfz&_nc_oc=AdrsesXiXp4ejAsOVNwhffDzBAPYpZUld8Fu-8aPYC5earXipBUh1dvxq1-SymhCwqM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIA01x1uBY368AvNPekvbEeHK8eFoasm7wAjKVtXz1qRw&oe=6AB931B5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXAE5OdB354Q7kNvwFt5jUT&_nc_oc=Adp-x0V1xab6FAiBIuzQlmJbe7DFAIAuJy71MqBBFDtrKtOo28th7Try3enY6URkDdA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhQ3Fpq-SOnoPfOwdd39t2dX6ppwInE0Yln6jfHPtceQ&oe=6AB93D9F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=047oS8XD8mcQ7kNvwHaylCm&_nc_oc=AdpMbEzryf8jiQdOLe4Z1DJM_QgqMmhPDJchAVKnHJX7nZ-rFA5I9rwpbS16U0vyaaM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZ4kgSg8EELtP-KIKmOVNp7xLxiXDBVmX-uwz86GW7Cw&oe=6AB91BA3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCnUGM02NncQ7kNvwEjnSYt&_nc_oc=AdqtqRaxRWcxKFSrIQd7Hn4oCYYU3VTE6F-XxOk9GclPVHtpMKO1LbQfD7gc396bf0c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPs8uGV4TsZMBLsPnZDHhQlxWFIUavWWIN8ku1R0HEjQ&oe=6AB908A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
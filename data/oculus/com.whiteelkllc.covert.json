833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhIx6RDs8OYQ7kNvwF-SKHr&_nc_oc=AdrlfLFR7XdhqwElGGQ_0Lz0U-Q0TqrnH34ycfwlnQ205Uz0ic-KkhZunJWMGTCPSXg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwxrnyOfpFl8P9hyIReHHnXGijOcz5gpccJCgsvp3mZA&oe=6A58F9E5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGhEjXTOjjsQ7kNvwFXt7is&_nc_oc=AdoJ2RYa8DloWY4bgmF3hmnHO_TXjy4PInf6MQFEPnLj77Wb4XmsdXV7Va3JLQEpfM0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD37XKCkUtBBQVXbL3VOKn7jUo931_cDl51srbczByJSQ&oe=6A58F435"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOCKNdyJLIAQ7kNvwHReFcr&_nc_oc=AdplP-SrHMgT7Np9BBs8VLqHxTfKBvSgy8lCHb6dOUR9HbADI7uVJmZ5VNpq7Qr6-z4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2dFdEAOjc52WyD0YjKJ0Mpt8mTE4Pb2jGv5Bl1DiAbA&oe=6A58C7DF"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWksozMBVnkQ7kNvwHFtg_w&_nc_oc=AdqvGSK-2UW_7srbJ3sydyItHyuQW12iVZz9djD04FU2JmsUAr3sw0akSC5HqEkyYko&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAq4PDNQT1nRVz7sL5EtJUvBsKpF0gqFLD6fDRt-_u3yg&oe=6A58DE23"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qm3Mpd8-dZ4Q7kNvwG3TDkZ&_nc_oc=Adp3CQsKDQH-XJDp7EUlUSJUZ3Wu2sJIeANhjKj2WAtWhP9n-P6nQl9MtJsj1evGum0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhq2wPAoBGJS6Uu7POo55vX5Vz6g8MkznUC-_fCjN53g&oe=6A58CB21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
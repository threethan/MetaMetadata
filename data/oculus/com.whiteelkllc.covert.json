833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsvuDsMDLRMQ7kNvwHna375&_nc_oc=Adqh9MDoceic1WhQIJTVEBbT8QlRviMLMGOf9aMjrm6Cl3QHAUSPEbOWVPjT-A7rG_4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Y-8eXQBHPTge8oNrXlIIrJZKZpGnUzhTVzaqMLCiZIg&oe=6A00A565"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeRoiVpSHPQQ7kNvwEbmm7y&_nc_oc=AdoBmzjTs5T3X19LpxMDOFls6IqebYxUmKCTINkL5U91EMT_a61syXTttXZ1EeP5CQA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gS67nMMGeFsHh-4ytu-vgJNN8nZ1coNmIg_0l6p-UvA&oe=6A009FB5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPwwlzyHTDgQ7kNvwEbQ-yF&_nc_oc=AdosbMt5j4reo6xMi3WNGihv3nsqpbOSpRCT6_xaUR-PBd4gAfYSya68eCdwnHCuB6o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YyeCnNRP1PAB5oMXZWHf1mK2sTw39mgo_GWIL2_HcmA&oe=6A00735F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJnZZE1uCJsQ7kNvwGTv_V8&_nc_oc=Adp3J2xMG-PV032mq1lmlU3u0PYKZpGNF9vh_Dq5Yuvixs7IyeKrKYqm6AtOQ5ol-Hw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IjzlnPE_Wxyu92qqCVL_LefjHRNJOKx8fi9K-a_JRVQ&oe=6A0089A3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IiC3N8vyPQsQ7kNvwGIDzzd&_nc_oc=AdptZnv7J9p69JgPEAZ8_4TdiEZKFub_2jusIhizcMGNOREcegduvUYN1lmzRbLvAk0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6isOJs_RsnZ-Dkv0t0OlW2tEgzXFLchXWRH24rjG2qtA&oe=6A0076A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNQik_i6YfoQ7kNvwFWA0sU&_nc_oc=Adot3E5xtjyOrltIaha4s3cyuY7tTBuD3-YAXdwDD1NvUaK1N3mI0pTVAtioDxLZ4N0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCq1jqUwLE3hWPmDBUmXnG4xv209k1B4g6r1SwncCa4HA&oe=6A5CB625"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rC8fYEzFuhEQ7kNvwGWZYt9&_nc_oc=Adqe-GuCz7RY28UUVakdTaNCeqRAKDsHNe1wYBF1Wb4pYm2FBE12HcwDX8OrwFnlcG4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGyYxYvMSx6fBbVeufNTMtRkUtyEvBQGaB96o2dn4T7A&oe=6A5CB075"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NqiGXMGHJuIQ7kNvwEhP9hh&_nc_oc=Ado1Ktr-xgYCTROt61Z1HeSGvgxpB0z8BQeDELHWZ-lhWwCv8lzq5tD0Lz1qvasPnTU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClUl2ECbFN2a99A2IqLnoCW85c6IFTdMcwIH77eym-nA&oe=6A5CBC5F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7VFndujptoQ7kNvwG49EmM&_nc_oc=AdoS_mN4zPu3L_uNlqa4oLkDDNj4JYvyf3rZe2Q_LP2FRvnsndORTHloA-J_MQPB-Cc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6_gLG-Yawg8VlfTKJ87c9DGQf5YkyBQNgGJy2HkMsOQ&oe=6A5CD2A3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hffge-FfMrIQ7kNvwH7ymL_&_nc_oc=AdrpQOskPrmZRDnPLST8-p2qTf7tzn84UBVTHlQHS8HwnlWmUYAArodvN50X-9-nvtQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByg_gtl42kyQdO4Ve-1sWGG9RXD8pZ7tfk82yEsALcYg&oe=6A5CBFA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
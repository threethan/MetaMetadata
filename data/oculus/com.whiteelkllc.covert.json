833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jaq4L-O8Q2QQ7kNvwGxgRRx&_nc_oc=AdrM-KdQoMydROkcU9JScV7o5Mv_nTWqlYrTIL9OGHmbTN_ulQX1ZEcd3DIHAfx31zc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__YpgysyLO2KZGVOZqnu_D4X1WTcIlIqz6g24CyNcEKA&oe=6A413EE5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8UPGDhSN0IQ7kNvwGlIsmd&_nc_oc=AdqS5sqiLcEAagTquSX8MepK254xQp_bqGgax6083VYUtdINeGPPqqFDxvMZc7VfXwI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JqwtpLQRQUxtAgM3kPvP6ZJEkIcKQjQbNKPohDPhDqQ&oe=6A413935"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhJgZrQ_62kQ7kNvwFTXlP4&_nc_oc=AdpYi6P0mv_Hg5hHKfoJU2QT8uZPtO_ET9kI9REFjDPgixWRFDwP0CYw5IY3Il3asrk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aDm3mssoIpJNUbyVlQ7L1YTDGJE0HG0v3N2gDSuLgug&oe=6A41451F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JU3_hjEsA1sQ7kNvwEHnq-q&_nc_oc=Adq1rJ0R2J6gTrOI3D2oyL6M1-OQ5WdrihvDxsau9jK7cyOhqltTpZ3YBaN7LrCfwH0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MALB6Py1pfyZhhHC4_WvR_2W2E_4e30H0BGyVhOXTkw&oe=6A412323"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfohb7QrcJAQ7kNvwF7WGlb&_nc_oc=Adqrix4MyOgKcmYId0q_vHVoAHIHFZ4g7BeRGOgWlGZ9RTOSyRs2Md4OShHP8IBQTVU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8frot8bnM9bH8HhCmoM8EecoJ84HactlSgz9YAlba0QQ&oe=6A411021"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
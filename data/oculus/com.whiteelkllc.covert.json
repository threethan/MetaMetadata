833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdRu8hqCRH0Q7kNvwEbR5IC&_nc_oc=AdoRGz1StIWfBPxwKgTYnNiUMRnI4fpf2IAc465RLFmhcPmo7E1Jlzw_RcBXOV1Q5Uw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXy1t4tmIXhnKOHhsEkCNiUKt8UhvpgPQqm_550MAf3Q&oe=6AD0F265"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eI9Msp83HUsQ7kNvwGlVI_k&_nc_oc=AdpM90zL0xGYQQQ3TnK2OvmiF2Tf53jtl2tImT5szk7PIaw1CFcAm05w_7_YOVdpV_s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNavxbcBkUQBkwBocOngapbTYifMrMP9kZGnt5crnVc2g&oe=6AD0ECB5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9kOZrXhZZUQ7kNvwEtDMn9&_nc_oc=Adqaks_rgowtBUZ9ZL-k0q5ZVJEb1agXcoSf4W6sLfQXXtFqr08i1nX5EENVANlTFmc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoUVcrMrqmRWAjBe--30sMRtlroYxb518V_C-BXWbc4Q&oe=6AD0F89F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AupCbG-mp3oQ7kNvwFSAbV_&_nc_oc=AdryhdDFBG5a-nCXygFtoigEqXwhH7BcUbAiR9X-udZm7A5-ykti8ZqTzThitg4CMzQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4stLikrnxzLUb5YSuBheZpoUcWs646ogxnpqxup1-iQ&oe=6AD0D6A3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yq6oY66-p9EQ7kNvwEogOED&_nc_oc=AdotOF2bJg6sI_eL5ocalpCr-bojk_x3I9Bt5xcvKs6R_tI_Shm5GiWPaWiIMPq7nAI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP038NnvsWTcw_gehzyziffV_3SjfeFgkC1rHhq7-0Lcg&oe=6AD0FBE1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
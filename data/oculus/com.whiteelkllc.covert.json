833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PaMHEIPccC8Q7kNvwHkEFn5&_nc_oc=Ado8LgegYd5JbfCE5QVRGMbYoGLZzB_42Xhc21bdcpVxUbjOMJtnDvOx3WbxuTpUu6g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sDJKoZlB3DlEqC5WHxCDD522qGEO9nfxMPynWbfWv4Q&oe=6A15BD65"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ixsVHqpq5cQ7kNvwGezpD4&_nc_oc=Adp_L10ok47Z7cc2cwsRVkvXx9ruawWjNltTJTmMya0h93DPbtZ7_gQkeBkWo50OV7E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qFbf8nyuqbg_VXOabNcEnZO0S4OdGz7px7gyYHwTrdA&oe=6A15B7B5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqx6T37w8x0Q7kNvwGGamvr&_nc_oc=AdqVIKQgoY8q_26OJWOTNK7dZYDfCkqA3O0IR87rP0MMUZXFoT3DqOLwXtIhPYLVS_Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Epxx2BsmH8GdlUsO9GBIdNmMm9utlVr4j0iTl7z4kBQ&oe=6A15C39F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZiZxd320nUQ7kNvwGa69rV&_nc_oc=Adpchw1vqSEonNrgHLxW1Yh9lOC_ob1j_1co_qhAuBzxmWIAXO5IIKUKko6LII9A_VM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nB5HXjBfEsmLfnzHeC4G1TBVSuSq-UEPpi4Gh7qwydg&oe=6A15A1A3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfoADFgPt_cQ7kNvwGrAFV9&_nc_oc=AdobqMYRQkgznOTN1k70lI3C2g6Nkz4qVzllRxW1XG4Buejg0r1TOILEV7wNXdfCaNs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55vy102AxH0WUSuHnK2GXLMHSzBCZZ58q7tQkyAPBXCQ&oe=6A158EA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
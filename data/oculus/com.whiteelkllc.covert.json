833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9fXE9dhX8UQ7kNvwHywBY8&_nc_oc=AdpBL2kgtKECoyKjNz0-7a3xUtrjGe-0j1u-vMYMBJJ_yTG6zi-MgcOrsIs3ZdPuO3Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3-8ebun5VNSEWyx_Ozynrg10vQJ6wCv9l2SECsduZlvw&oe=69F8BC65"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIvcc8VfADQQ7kNvwFsSnch&_nc_oc=AdpFmhdx0o2DKDglO7wse70GwuFim3Mk6GNDcC00KrBhl_Q62wtI9KFG9K3ELntBhDo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0tOqoifxG-wQIbQSTbAD60H3ieJptJwKg2hPBH9DLM7A&oe=69F8B6B5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TyHuxHPlRQoQ7kNvwEFBiwk&_nc_oc=Ado_jh8Zq0dNkqaS6-uDlTrVZixBluMCdyi00Qre6DiIKNsKvQTsvGMQxH8bSJHty5M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ibBiKcGZ5ACGtD4pn8X19mIsX05KJ8WsVsGR42iYYAg&oe=69F8C29F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYuRthqSuPkQ7kNvwEfKdMD&_nc_oc=AdrBstl4oSx0QIbxxvz_tPeHZG87wEW8SHe8r_ONRJIsuneVj47wwrUWVPm9Gcec8fQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0l6UQmOjzs87sTO5rjIWWF8wS2jrklGG21M1kr9sZQWg&oe=69F8A0A3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bssIgEvMDQMQ7kNvwHQstFH&_nc_oc=AdrWPPoAnWGGdtmmFMfdRnbxA3OhCEuBZpciLenkOIZ-uo5l3hjGhxDe_nmUvjtfUUo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2mUVQPn49rNVoyJtcowH0a0SI94NX0qoP1iftpdI_z1A&oe=69F88DA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDwtoKPLgkAQ7kNvwGG4foc&_nc_oc=AdrtiFX0I7HASQizEgCoHMeveSEP0obNxCTqo_OvLznS2a0D-b5GMofsR45dCYOQU6s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2NaCVDKt3Io0HEKC5pC2IW5CwzwcJrjlTEIFjRwjQA5g&oe=69EF49A5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEALtZBUyowQ7kNvwGiWimM&_nc_oc=AdqovnkS_Hw5_JKWj1BKca5Op2i6jG3ziL0-ATc4_ugVaoDb8VMOC-JeYGFWFKt3D8g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af19NhK_q1MzT87UvNwLDVzTEZLukmBp-mdyTM0lboPwfQ&oe=69EF7C35"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URNvD_E_p_cQ7kNvwGapkKf&_nc_oc=Adr_cB1zx7TbMI3y03w0g0mpK9zZj5CF_PkDuZaJADLtXCYoPOVZAAxdM-M77Rh2H24&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1FYvQBuHi0VzJ2sFQO5-QNV47hIUdqiMEo-7ZaESsEpg&oe=69EF4FDF"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aqvo2drW3EQQ7kNvwGx4cwC&_nc_oc=Adqzjcc3ePfCsuadlVzMrGm25eYWQz7MXot0EkTJoqnOio4oCz5oJgvnGSXDUzXU-5o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2EkELVWYy6F313AOB1BsO-_GPrPzWOyD_y7-Tz5Gqxew&oe=69EF6623"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLIAr7FBqmQQ7kNvwHgqrc4&_nc_oc=AdoZeMAsbhX_O3Y6oujBtktvHWzvnwRLyqudD60TMQ-qNh0TXeQXEFu71fZzbdtSwyQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2W6bNkq7mXVLKXEkQkSZDQe3hLW7iAtq0UzMrwV8vqUw&oe=69EF5321"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
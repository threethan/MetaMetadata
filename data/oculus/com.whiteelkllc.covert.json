833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8PUKvo_lzwQ7kNvwGuEvqE&_nc_oc=Adq8Z7ktHwxxRk1UgZ18A1H7aBuuUzYfz14bYiHbwYSvqw-vAAYl781lqkW2GkVVwLo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAVTFS30Zw-JzJCCIh3Nmcn1FQsNcnDoMhiU1TaxITkw&oe=6ACE4F65"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eI9Msp83HUsQ7kNvwEggTyZ&_nc_oc=Adrsyie-MGG1A7gOu7foDytuoQ6NP-jgZVq9JxHeby385WZMf96zl5M0nT0Bn6v8cNA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMI_SSTTR4A1b29Zeza3evlhPKFsma94p_6u7qi9BvxyA&oe=6ACE49B5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUQxbcg0l1oQ7kNvwFObIzp&_nc_oc=AdpzwNtMySi8ImfKBm6U5H-S6-XWvwz_hcWkag3ITxk87yjodMs2L7LkBqCfVmVZe6s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXar8-0OQ0_imhzBbPd3g01_ziz3FBEQWsY3iIvngllQ&oe=6ACE559F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AupCbG-mp3oQ7kNvwHsR8a7&_nc_oc=AdpSse6nOGn-NCPWKNRLmoC3gt_uY1aTDAJZ-L0DENorxuFgCc8bbCkIJomkh4Zc79A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRQcMEmjrLUMnyfKsnJSOeoLImpbPtFme1jNWRwPtghQ&oe=6ACE6BE3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDX7dlTWf8wQ7kNvwEmCLkN&_nc_oc=AdqQKAWvgyy1JmudPnZriu5my2lOAP-OxKv-cjsfchhmk1o7Wd3dvnkb0jz9UK2JT8s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO96GlXQA8kpbeM-caNqEExTFyVLMKPX0NWRg8_uJal2A&oe=6ACE58E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
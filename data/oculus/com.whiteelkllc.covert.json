833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m74Y3VntdTUQ7kNvwHqOkio&_nc_oc=AdrZLbtqnkLUGY_aXZn42YJoo79INQPi2oR3fNYR9cgrSWWNyXz-ZWDg_VImS-6Ot9k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVbLfu6jXIe2NKTwoWuriU7b2x9gMB9L_Qs8rpvt9p1Q&oe=6AB3F165"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02Znw8qDWQUQ7kNvwFV8TQQ&_nc_oc=AdpEAHKiXgylKihpXRR60myu8HJo66yoIxka1PuC9BmAguC0dZjaO9JhGbiYT9aXoCs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_RAART3-11NfR0QETvn1auJutxZc5nd8QCP6djLIxiA&oe=6AB3EBB5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FU5hTE-2kRsQ7kNvwE0dpvb&_nc_oc=AdrhuUr5vZDG7NJjDXteQT2qejTIDp3W6rF9apGK8doRJ5dMOli2xU7Bxeh5FfPCBPs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfm3Ku6hXSxvOEef1id0B15wwVNpWR_CunBjqjDrRWaw&oe=6AB3BF5F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndqayJpBSzcQ7kNvwH41KX8&_nc_oc=Adr5bPOaBTFdiXhfjo549C5rjlwWoL_wBdiv0UR46LfuTWSQUavCQOsUpsI1kTSB28Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYkGpyBQMvH9IPBkxuQDLpUB6HUWf1sSHOfX9vptQhZw&oe=6AB3D5A3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2j4xeI3toEQ7kNvwGwu6l8&_nc_oc=AdoUlgsM8XOc68Z1aPtneRNfeS0d0rXDL7qNsMnFZf6-x36TeaAKUOc-6Gsc0tpK74w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaTykeLazYw2rLIc294meDL5GD7g_2Ko2cWuCRVOjYbQ&oe=6AB3C2A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32DO0FWw6-0Q7kNvwGUSFG2&_nc_oc=AdrMOZoEMQsAEoyOWzF1dHLsPnEEk-pM7rjTbmnSw5t9GhY-nUzPh_9GF0I8G5eoKN4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYNrD-zwTcPFlkCjPXhRpK9HbIf-Hc176i3OHPvVCjMw&oe=6A8ADAA5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kkmJSbAi58Q7kNvwFI-LnQ&_nc_oc=AdogGuNJ-CaTRy-WjXZXiefnEjoRxY-6HB_x4_BqCaSfSqfZu1g52B9_Ge4tfvkpKh0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXpwvHJo0u6x69p2TIknkEKQHhQhvHGIA0tt4fZaea-w&oe=6A8AD4F5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwSxakRLSUkQ7kNvwE8cAFU&_nc_oc=Adqd8CB1k25FmctKGp_MPBTTo5JJ79Jy0FItg2GaeP0f9uhDVmmMy9xldVmfaTtvlkY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4AKkIL5a6hn6lFtHcDFF30dDLOXk-hpmlNoDj2M8raA&oe=6A8AE0DF"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUIghZqt6eYQ7kNvwGJkZGA&_nc_oc=Adpe17805Sb2TOrDsGen-0d_uMV8kuZz0YwZM44rN1a-MQ93wH8_MOtJ6pD6RvePfQc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENW1qkJzB1D3yQ6Tmfr-DQeRMjtxIjj8e1xXZizF85VQ&oe=6A8AF723"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwNOkLVwZF8Q7kNvwEYd3Fg&_nc_oc=AdqEz4LOwS7oSagYLrEVyPDt3Fu_OdmFGtrjmOqNmNeoUMn8dlXJeaLE2MfPi_E-qGQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQcYSBqz1AjVzW-uXRMLYIp32Qtpb9mhtoz2Qv_i-bwQ&oe=6A8AE421"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
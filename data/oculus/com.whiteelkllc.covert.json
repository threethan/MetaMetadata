833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6rN-giJNZkQ7kNvwHqRBqb&_nc_oc=AdrCOxlGLIDGg7Z0t_uwiI3gnwrf5hnibc0pKLhsl1K-qcmyb-fqzADT-T3wfkdZtgk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfa2kih514GtJ9PH9qPpmnJh_vzCsd_wDiMDyS0grLpQ&oe=6A4E6DE5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nUBGmABDVwQ7kNvwE9GkHU&_nc_oc=AdpvZe4fTfHpwgdZC9-sCIH8qAOJMDjrqbuyEI3JflBwKP0_0dodyUsjDA2qEqQHzgw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCmuwmu2YCkpsYyui0-xVO1_Iwk0gG_2iVju3JLsovVQ&oe=6A4E6835"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZGL1DKTPm4Q7kNvwE0k9lY&_nc_oc=AdpOxrV-2TEgpj9X0IJbka-rp63kMDCVo_foXZJImtq5Lf95Qif7Shu8iCGgpg8WURs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC68imyQyHRih9bgqR8Fl0y0XEXRLg1d19lGskis7hhNQ&oe=6A4E3BDF"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2UAEflYOpsQ7kNvwHv9vp5&_nc_oc=AdpBUgEAxrpNCCEvjMRA4ezWxUGRCPzIhPaX_zXHgJs6PU2LyP5W_dqBefrCAvlu004&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqr2exP38S1D_IVLbUOJY7GITVt9-38BN9Z3piX2i8ng&oe=6A4E5223"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t30G2kTi_EMQ7kNvwHiCRGa&_nc_oc=Adp4kUu8neSZcW17m-OnQlEDRPj7qJDCUdwYanyHxpHtEskBEGc7tsnjZ8QllwU0xJ8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6OMHOMDjMEE-X9Xp1z0Z443M8nY8kRqrC4sfq9SYf5g&oe=6A4E3F21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
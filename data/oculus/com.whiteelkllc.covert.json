833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJtGT27MX4gQ7kNvwFWTf_e&_nc_oc=AdreOSzMcH_2oPNYq6K66UcPFN0TPZoIYH35AEozakDE8-gLAfKk43nCDIntqxXkl10&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oH9rOMpRdcfBLnh42xXGNLt3EP49ZzAnkD5Zg-8uD8w&oe=6A316CE5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDi9F5anGpoQ7kNvwG0tiYg&_nc_oc=AdrvE-UgCK6YjGolW908zQuO4IYdQQrdQacRb8zWqMVAMW68SFRy2PtOk-xi5IQ_3uM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_Ou8Qu4mfCGC4wq46yn21FozGY9fArO3-YDymAnKx8Q&oe=6A316735"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oS0hl0YKVUQ7kNvwE4rtdC&_nc_oc=AdrZAc2fUx9kWxX3pbX2RJR5xUAK_WVW8dzzZkmbW_Za7zHy8mjHdxqjDsUOguLBTw4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MvXySoM-k7fUrIz_DDW94UPMqeSkpIruPOiXK4fQPkw&oe=6A31731F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDuXkGzbGd8Q7kNvwHgAZ8Y&_nc_oc=AdoRrvgIUZRL_fdodHq3Q6l4QNb-KwJzzahWlmClfAzkt_SUSjLamE4h4_CON90l3Lg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8A8fZwuiCnI40HoxH58OOshM50kL2LYts28_vlNPvQRw&oe=6A315123"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpW-aBXrKscQ7kNvwE5f_pF&_nc_oc=AdrDyjTY_71iNrtC3uIsveHmZByJKTuVqgESHkgD2QlIyCn6AkyB-kzxWmz7oOibBxk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Lm3kcQE0gYW7Li4VlG8If39-KGbdKu-qsw2WOZZsnog&oe=6A317661"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
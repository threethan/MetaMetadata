833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsvuDsMDLRMQ7kNvwH1a-rf&_nc_oc=AdqrGu1vrfcQrt1QLe47Z_t-bOsRBa37Y3V2jtKw2cCjAdW8jR3EORKVIZ_sKK3rfRo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vbqfgiPpqjPUveIGcY43OaDfB8jGqK72oUYvsuIX8aA&oe=69FE0265"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldBSZqV91ooQ7kNvwEomtJb&_nc_oc=AdqUbtg0IvQFoaAeI57PaZssDvndwaVeBPrJMqnQU4XJb6s6k0As0KSYynA_ymZKDn0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4prNSLzykQYSxw_nghMqnLq_h3Gj99_uyWbNJwt10GCQ&oe=69FDFCB5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5IqeTpibkwQ7kNvwGNv-Ve&_nc_oc=AdorZrGac2MUvr2TQpuFGTu51pYAWPzJFQR0HoCvr1JIOad2EFl37b8z4T24Am1lAEY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zV4QSs54JbI8TJTkk1-_TeZ1x0zo2305AMvup4eWomg&oe=69FDD05F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywWWUx2_N0cQ7kNvwHiuVUy&_nc_oc=Adop6uresZPMtGhkbQs5VE2k2XqfeC0byZJueP5iEcPBIKWT3OF0Cqcp576UxthbG2o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52jOUENfPIm80T129rAFG41OAT6niTiJwld1E_ulIqHQ&oe=69FDE6A3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmkkOdSwsR8Q7kNvwFhxApt&_nc_oc=AdrFY_JTjJSXap_sht7HiEkechHPlGGtgTB2VwT-x0w5VJzn3t5Zx9EJxyZsSNSE9h8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LdARtlnSMcxNJ5uBveToa3ZUnODKURmpw4Qey4Ajarg&oe=69FDD3A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
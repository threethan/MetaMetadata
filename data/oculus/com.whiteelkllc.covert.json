833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PaMHEIPccC8Q7kNvwE45PSM&_nc_oc=AdrtrF_ajMzSNKkVrHav7PRdJHKaTY8jsEMpfwak0-kvxCC8jTrg2R-waF2fUx1AXs8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HWjvxk524S_RUidGiQnQA8djP8spRybe7ATQA32Bv3g&oe=6A170EE5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ixsVHqpq5cQ7kNvwGotggY&_nc_oc=AdpaJK6quty1JKSqIagyhvvvaAY0EWjU3AFm0WIZcNUjAi4DU-rW2Oue8PMBhcCd9E8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PNwvRp5KmrY1s5Kmxu7cx2scNUGbShLU0Kc0oktWAfQ&oe=6A170935"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6QA3QjX3Z8Q7kNvwH-tqtE&_nc_oc=AdrR_nlt2Y7OsE_0d9Q2I7I3DtD7n8A0FW6onQ6zhRy7s7wxUfs7YsmxdISWfg9jKEQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6k52rFLzZxISj3AXDG5xA195bpWp_u-YOLUzogUt4T9g&oe=6A16DCDF"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZiZxd320nUQ7kNvwF_UwoJ&_nc_oc=AdqFbpHaorK7ZJoLwxh3G54Mujm2gffq1OX4xQfpF7acrVDVgya5WeYEpcNS2MuBYjE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yKZPeWn-rhaRyfB1GSGwB93mfHSd2ReTMgHqlHQzmFw&oe=6A16F323"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeWy4azQGfoQ7kNvwGCoSM9&_nc_oc=Adotym0ukRv5M6ExeG7iZ87QjGV_71Q7-_I-pGWXgg0BThmDgii7o3uqJPBHp_qEPpM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PGnZkd2M9dZDKgKVxacKsRacocBl_hmUsT3QuWbkJZg&oe=6A16E021"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
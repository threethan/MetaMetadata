833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3U4G_Ubf9AMQ7kNvwFqra9t&_nc_oc=AdrkRJBfgotOF7kElcFkI01736vF5JRQy3EVxixJC9iSu6p0RhBInjv6Q4svjpLVoMQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBURMjPE_EM2KssGogA_YIjH8ZdG1k-rs_q8merfDuszQ&oe=6A6CC065"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPD53ax_qYEQ7kNvwEmzrbp&_nc_oc=AdqlZA6VFlU_Lp1d6A3uNTY_35yNV5g0aCFmWD8WuPo4h1L5IXyZ_eznmIl1WcJZHcw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZdMYrTZBmB8rd81rgZhGMbXt41xOCce-VB6KBerVINg&oe=6A6CBAB5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8nE7f9GDKEQ7kNvwEM_qC6&_nc_oc=AdrdnISthypfqeTv9_AuICvIv4VkB0IiziiseVicC8_iDfocAXGrWRK4SpOpBSPFtwE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZsLmv6HqEqz2ae8xcpSXvvCxnPECmcjDsEJVmfner9A&oe=6A6C8E5F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFAcdP31Md8Q7kNvwEl4czg&_nc_oc=Adr8MlvxjWoxK4KO6lUg6DPvAl74cgsyXeKgYmRmDlKHc_wYcXKYL7wmkevut-M3j7A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMPnDHphyT1r4BVtYYVFl2Va_nSb_b1zalAEHkaTOQgA&oe=6A6CA4A3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4_XlIcPG7gQ7kNvwGvOXm4&_nc_oc=AdoC7mkH-rN1mzjt4bzYxH4wfiQtZKxB0EuZ0WC1yVvDjY_uZa_CF3LGlU852Ujqsq0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRyjgLLfrcxUQGFEI_U8WKKJE8b4uMq3ZymRLZrJIXug&oe=6A6C91A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2ET1H6BhesQ7kNvwHrlMDs&_nc_oc=Ado8fhEYBgWaEpcNn5DCg4njgvH7hSbghVco0AspFdkBQ36FCUBDoGHCyb_vei_Byr0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9-Ix81Wc18s0hD_Z60s5gHfn-zvSjx5675TV4lXADEA&oe=6AE0C465"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sf2ZSckQrgQQ7kNvwEOCLy1&_nc_oc=AdraOOXtRwIcE4greTeOyBE3iPtkMhMXESUUzy0wPF5UjToQeTuYOSQ_xejkHS7aF2M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAhrnrpwjpk_WgnW1r8Vr6YEUuTCwKD7chn4cPumB8PQ&oe=6AE0BEB5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1dYZuiLWsMQ7kNvwF3b3Tt&_nc_oc=AdrYmMDfniPOWQMhAIVooW9kvzhbdVTLGahg5_-tNVOIf5zdGHzkQsH3N0AbUy-i7gw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOluD-zqE02WWHAPDpKxxPIw_XMqhPSd5PVIWpmrpittQ&oe=6AE0CA9F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdz7CH_0b8EQ7kNvwFzeVHB&_nc_oc=AdqHC1pAKLyYsxul1BxphRXgn9ebFdnpZzv1p5hMfPQXYJ3OR9r_4QPGLt_fcqiqIZg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2zL-08X1GGewC67arkokE_nvFRK1U8EZ65S00kxisNw&oe=6AE0A8A3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gghKXHOo_MIQ7kNvwEMyzSt&_nc_oc=AdqTnBEc0steD1MzAM_IAYpdei2tG86pPYk5NZMb-9Vv3aijduOc3k3C2jj3X3DkTQE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_JB00X8fIYhPoQneHWTb7KRZ_ip-Jh_yduiougJaDbQ&oe=6AE095A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvHT8CN08foQ7kNvwEaHrzl&_nc_oc=Adp9i6Rns5zY99e82O8FTtbvzh62QiqZlQaMZXGIVNqIUoDFK4c0ukTY4HerZP4JHho&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bPygSO4Cp5VGLBW8Q9ZgB2sj7fY70d_tVTI6H2jfFEg&oe=6A1B0365"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMIqv5tBLhUQ7kNvwEiWNLz&_nc_oc=AdqZ3IMQopSoqcsj_eKX3H2RxXf0IkciFkIl1CzqbWkdSvvyqhCfxDesZAkxAnVq25c&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rpG42tXyrKciA9oAUMWsedOan9UFi9ba3XqLP1AnYfA&oe=6A1AFDB5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDd2nIeZWQwQ7kNvwF0dkYG&_nc_oc=AdorOEcwRQvJo-d5pxSv9jMgL7BiLDruqqrmirdEBaO4RRpCknfNOU4WzFNj9eNclxY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lUdjdxMvfczi1Rv6kkMXkY58o2Ob8ty-qBjOvCtPzAg&oe=6A1B099F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHaMUiRWg7IQ7kNvwFlefdl&_nc_oc=AdrIZb4TYb3AdI0agCs5WtTv4-2XvK0xCHK3dZDgKmkarD5a24dnwO-HKsp5Nz5EJBw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-7TthhTW08POLtTg5I3EfDVTAguZ5MMckvxeg1GfKcw&oe=6A1AE7A3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ErsoTQWzlcQ7kNvwEuv7Q8&_nc_oc=Adp74qQVwjI6FGYKKqqkaS8j7cr9HsaV5FTeChJK8j_rTFQmTgZKKpIUlxqqV5D04b4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7anH9kSY4IWngo-pXD2msKhGJnmPenhGyXyA5WqaLrug&oe=6A1B0CE1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czvfVONfeAEQ7kNvwG_PzaE&_nc_oc=AdoMROX8s53SST-tkUjPLA2aiR9VlSjNc85SQR-O-MAGVteDcImctLnwmqEH05kwAGY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqBE7yZtpXcfIzgVWUIXz-QhfE8Q4ttyiMuNIvrphsgg&oe=6A7357E5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IA-nlxnhcMwQ7kNvwEkymza&_nc_oc=Adr8UTn3cmXYJ_7lx7U8Q-CU-_yGpdiV8uuAqJaRZUyaaoKV3PtWac5eisOK1kH1058&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFh1lHWRhvugtGBU96A32utxrCfLDMFsBSnDGKCnzUrQ&oe=6A735235"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfyvdrYd3p4Q7kNvwFd5aoR&_nc_oc=AdrQEJ-6B2NdbOzdaRqXJx2nS6A4JT54vnAw0gq9Ix6SnCUUSLVF5oKc-4j2F_DI0Pk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZJYj1m1AFf_VgTPKD_GuW5nzC9W51P8Hltez7kgczyg&oe=6A7325DF"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0p8A7pB8lIQ7kNvwEdgVVk&_nc_oc=AdqK8zYX8wF0XLJBflshPR3l0E5GN8mHh5tMZQd-W3SblyTr-gjWvmOr9iOARa1b6Wk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVdlreWZMAoofkS95DQc5SmrTzPGyhEVFXx_1jiv3MJA&oe=6A733C23"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qk36svZNBpEQ7kNvwFzjn90&_nc_oc=AdosZS5c4tH3gLjRK_wRhOsphqC6QhvmvtPLFUduoYsT1pPS_JiOVHkJqeJ7m8LzHuQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjzyvUt98GXI2WJ5OcYvn7ynhp7q6KgIgnE8--_upNpw&oe=6A732921"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
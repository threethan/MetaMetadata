833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAwA_sVl-5cQ7kNvwEXBlYG&_nc_oc=Adr60l2ox-6DTHS70Ubz-9INd-mTi2qUQtJoMGYPwiHMhaPUMNSxVWLrvtu-OR6PjWM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAV7aprHa82tkblS7OhBVzfeg9wA_JhGvn061QAnQKlkw&oe=6A4A7965"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elZRM_ePrrEQ7kNvwFqrxKw&_nc_oc=Adq0aZg69aBgaxIXOJUSSitcxSPRE8q3fyoSbe8_5x8-Ru3Ii3X0CJ1RopS8Voab5Vg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsK0RwW8MCwI55zqCQt30mV38inKOZosPPQoslUeLmmw&oe=6A4A73B5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rw9gQHkxnUUQ7kNvwGeAeXN&_nc_oc=AdpKKflCOkBtKZVC3dmPHZ1g05yrok5b-6oy4qOTtXWFcf_l9pY3JiRguL6M89dINzM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvgTAKYCQA_lIL3x4rA59m-QIMdOYvLN_C6OYYEU73Kw&oe=6A4A7F9F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oje4I73psowQ7kNvwHbuf6B&_nc_oc=AdrYlvex2HMVvin9DjCFi4MDwf9_3Pdab2ZoXfqMyXC8-YKH1fGKEaO2eC_orzAT10I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHe5nipfrxsnRximEd6g48z7ZO0B-UT4RuBIehBjXoiA&oe=6A4A5DA3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ad4Ju1ltZysQ7kNvwEB7T3T&_nc_oc=Adp80itjK4I7PUfwUz9YyMGZz-0XT9Hc6B7LaFwOEuCyxo-vUfUtAkbsD5kF6Skxi1o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRd7InJr-hyyRiVxiIlWlZC6PrD6fHSumd6nJ8ipOIGA&oe=6A4A82E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
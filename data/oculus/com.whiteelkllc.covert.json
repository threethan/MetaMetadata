833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAwA_sVl-5cQ7kNvwERWA53&_nc_oc=Adovb3f7lmfTYeX2gO9tj5q38iu-BKL4gjoldusDSxzsGpRLJcKWRLoAF8R1U-AiYM0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD87zeQNTs0FgwMyKVbtgHNwwa33wvumTBxf2jxy0K_RQ&oe=6A4BCAE5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nUBGmABDVwQ7kNvwH4qArL&_nc_oc=Adqz57uzwFAi3WXbD9lT8lFQYrvToRq8MIVg78kNlf_l9_N_A_eyMi4v_Y3fL4v8Avs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3PJtilMgptReQd8dTI76X9JSuq8ZwsWD6F2_CtyHBzw&oe=6A4BC535"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rw9gQHkxnUUQ7kNvwFC-Ufd&_nc_oc=AdoRugapQJ1WRvpuLSTAt8qz_nISVwQYnd4NorGSTOt0NzhulasSLUlc3FKvVNxvWBA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFYYL2SgwMBAagX5gE3-ST85fbVtzlTGRPpCxuIyrJBQ&oe=6A4BD11F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2UAEflYOpsQ7kNvwG8ylyb&_nc_oc=AdqapwhmBKCdoRjD9LWQ0wA0p7mCjVpC_LHeZlILig-LWmANKpDC1b7htxIXDebnaa4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCk1yUWjUvRBLqEDGqFOkZ4ZbxcBv_7f4cjJYYPoZj7sA&oe=6A4BAF23"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ad4Ju1ltZysQ7kNvwHYFcpi&_nc_oc=Adp5ear8iASPFqno9fRUV2xmtg6JbczsV8ujN6r3zFvV_FRDV9i3LwIbAjUBd6fSwzo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkR3KC4VJlNkSri4i6RM2XZJz_I3X52cm9eMNH99MNQw&oe=6A4B9C21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
sxs7ktoezA&oe=69F1F621"}, {"file_name": "migrated_image.png", "id": "253206549028394", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IOvcpqrd0cQ7kNvwEnyBHR&_nc_oc=AdpKvfPeB1YGDGn0JxiDrryajvDyhW6z4ReEQQIdGPHQiyFA15tBl27zH52uu8AI3gw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1hDNfeXs42_JUbDEvRPXpz9iBqCKw4J90X3s5PiAMV0Q&oe=69F20923"}, {"file_name": "migrated_image.png", "id": "218094582882646", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bo_3r3cl43IQ7kNvwEu-scn&_nc_oc=AdpDN0e4Oi2E7Fg8Xu7rJyPBwGsXgFsP8hLYFF3AcYAxV9PLQmjRVv_htbtl7rgdo1Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2VvCRcWTSG8MJ5sbOwkpsEggfCmodBT9Dztdn-tnz1-Q&oe=69F1E6F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/2GGwDm", "id": "2004284723198024", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974841_2004284729864690_645501217715257344_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgGRvdexiQAQ7kNvwEt8ddv&_nc_oc=AdpbRVXfbevkaP2u0uf4tt2iyiAp_foT6aMJxX9ErpZcPpDbizLQcqs06-d9_2vjXnk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2sP2SAwzpICwZ11Epz-E-W6Xyevlmw8Pu8xCmn1z1ckA&oe=69F21C02"}, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "Recruited by a mysterious client, you and a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation and trust will be needed to sneak past guards, hack through laser grids, crack safes, and much more\u2026\n\nTeam up and pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetri
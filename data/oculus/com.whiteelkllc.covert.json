ng?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tU6R9KXQHFwQ7kNvwHPomMd&_nc_oc=Adm0paGCQWLjVpeyjaX9muSMd8oc7XSt6GIPf2CiQiLWvqEKxPmkV-yO38331zXY9Ew&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftN7B-TW8EJn4sl1sseQfXhzX5L7mh6_k4OYc6utD_taQ&oe=69A6E3A3"}, {"file_name": "migrated_image.png", "id": "218094582882646", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKQpqB4rKswQ7kNvwGiERXK&_nc_oc=AdnvlMcPXmhKu-5Dd23djhZ2KOvG-vkkL-8k01fFxNj3Ctcg2ed0MRmH8FWPqXTEiNw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftdKKdukIOeE5JSDsoKZQONELfxqeNNkHKoXTg0SpNPpg&oe=69A6C175"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/2GGwDm", "id": "2004284723198024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974841_2004284729864690_645501217715257344_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhGgwe71dMYQ7kNvwG8U1q7&_nc_oc=AdkuLJ74LcyhHui_yCmrwgKWp1SCyv6QgpDUAmlHH9njUis9Vp8HZwfZaNGud2T80tM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftrV9BrYSiUg8Tvu7cMj2NnL55sP9BmLXq00rV7-rsJEA&oe=69A6BE42"}, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "Recruited by a mysterious client, you and a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation and trust will be needed to sneak past guards, hack through laser grids, crack safes, and much more\u2026\n\nTeam up and pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends and family from anywhere\nPass-and-play: Introduce your friends and family to the unique and immersive experience of VR, while putting your stealth, communication, and trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/privacy/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "2720827291556251"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "311056959495809"}, {"status": "PUBLISHED", "id": "271645033526663"}, {"status": "PUBLISHED", "id": "291561038180641"}, {"status": "PUBLISHED", "id": "413772986033040"}, {"status": "PUBLISHED", "id": "384314225626030"}, {"status": "PUBLISHED", "id": "649827842093917"}, {"status": "PUBLISHED", "id": "445581909533454"}, {"status": "PUBLISHED", "id": "2112640855713654"}, {"status": "PUBLISHED", "id": "413037712668542"}, {"status": "PUBLISHED", "id": "2195178844086605"}]}, "baseline_offer": {"id": "2195178844086605"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1542873600, "status": "PUBLISHED", "id": "311056959495809"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
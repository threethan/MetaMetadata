833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEJcGd8XT1cQ7kNvwGFWNNJ&_nc_oc=Ado5kh5thD46Cj0ozCYT911UHH87_w5z1a_b420_QcESj6Ni5Vsgk79uilOf9lUg0Vo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJ3kzSXO5YY129zcJSvl4JqZNoggt154OGXZ8kmOjw_A&oe=6A75FAE5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IA-nlxnhcMwQ7kNvwHiHjWG&_nc_oc=Adq01gSwysOYX3KgmNTP1_42TuWfmakd7rls4K_3sTtr_wgfxbEYUDC5dcLO0upMPEI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGo8o5kdkl23wOS4eOFtWZiaHFPZdkTRf0jyHIaZrqZjg&oe=6A75F535"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4cpM7rciRoQ7kNvwEEK84k&_nc_oc=Adq-F7UwNufuaEAfwsG5qqOvpWxwK4321QpYkuMeBr9MluBNpnUfkG0E7Yx4h6db37s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9TH6XwCV8PxnzwYO02IP6x3aS1RRqQhIs-Fu2vn31_w&oe=6A75C8DF"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0p8A7pB8lIQ7kNvwHv-GH8&_nc_oc=AdoQM9cfBizKAfI8YfM37lgwc8BkjCv-Bdhof6wM71lYI4BSzVR7_z0tmuQsGnwnlUE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWkFYoH0sxwAlmaX5wxEZY8Wpym9KH5TiDBFlszUy1FA&oe=6A75DF23"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AyxM-oAmVvcQ7kNvwGVfOw3&_nc_oc=Adpqq8QPr4YqeYoLriTV8zcONwBRhnQ3HPkZ12yN7NTnPGkYDDx_mwjCzdx9K6R1A6o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnUkRZXqStB31V7v_1cGqa9GRlpPfRvQCPUwNOUCvBGg&oe=6A75CC21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
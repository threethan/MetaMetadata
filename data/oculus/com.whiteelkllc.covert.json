833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqV3yDUKTw0Q7kNvwESxDil&_nc_oc=AdqwgqYYu2z2EhiVUv6Oun03r-hMA7YCzonWSycQ45fIYu10kJCKxUIoAbtHq2AnYl4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ozCkr29K_LPBa-ek0f2VHcxIO3H5G87WRmeJoT_QP2Q&oe=6A2C26E5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynGR9cdUuCMQ7kNvwGJ5zid&_nc_oc=AdoPqN_hBy1ub3OoBHljZxKKhrqb3od82eP27mpUyMDga_j61ubRXIaMDx9WpTtGjEI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yIBxCmb41IURGafn4Q35LraQIrrifiuhxJZbFWI3Z_A&oe=6A2C2135"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUXEGKvFUGwQ7kNvwE95Xo-&_nc_oc=AdpY0nIqHuE_mfck1J8VT8TGyCyiXdeYaqkUCLiHZC79D-0AmyVekC08JpTko51f9Go&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FyR7Bx4r2bSO8_ymFeD0Mw6IoNefNhKShRMiSRfDaHw&oe=6A2C2D1F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24W_SeyPn60Q7kNvwFBzBpV&_nc_oc=Adqk1Qa1m22gQkmRxxCH7V5m5W2LZZcuhfdzp_fwXQC9mEpiqJTtjr6IYNX06zE4bwk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_t_g8PL0KSJynri63E8wvGmrAQXEK3XCs09G4PhSYaog&oe=6A2C0B23"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpOyeOX2RgQQ7kNvwE1nqxR&_nc_oc=Adqh_LFh8CRJiIDXlP-N80lqWSYqqA97uH7DzJcKKhZ9uOKNQcTgVWe98GYMeao5tSk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Tx5FVEbImn7YRhjgaXoDN62n-PnqhTl5UiJKWoIQLXg&oe=6A2C3061"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2Z8bNrBYc0Q7kNvwFI0nQH&_nc_oc=Adq6dOBExQ9GbFmMCEKpfTg4pTeGxOACegtKXeXuVczK7rGkBxXpfLqhzxyKtB1cnJY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BuPCRZqpROSDOMBGgYkgUkGX9pNy0ZulSk636waGiDg&oe=6A131A65"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUSaJfz_9pcQ7kNvwEIp0f-&_nc_oc=AdpH-CRNNU5gctEZ8hFWbX21xaf7PU6U8-sZwEaMJh8O9sVw-e4gfWMlsUsn3WXng-0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nsz1gaoBAkDRSOs-wQplZJWftKEcVJ-mrdgnxg_jUJg&oe=6A1314B5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqx6T37w8x0Q7kNvwErhYEJ&_nc_oc=Adq7W--VIDVdv7lvei4wa2Uc7IPeYOqNJ8e_rTRHVCzRnZ5DaOgM4qSbR8HGCFxBCtg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7N5LgVuIV9ofl_cC6qZBP0YGc1-C4LFXeYZ9f2HE34LA&oe=6A13209F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAW7vmvFa4AQ7kNvwFj7UQB&_nc_oc=Adp8Hte54JI_Q0TZq39W9k1RD_GG4qMByRvo8lfkcbJx18Wvj4CM-6k-WFOLW6Iwemo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zC7rqWbWzqj6iQAxC-lJreFBlsYB2k0vlnaDqcMTJXg&oe=6A12FEA3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfoADFgPt_cQ7kNvwG1aPOz&_nc_oc=AdqZG7X1L-TclbBTT5QQSsmaTDUxwmWmrlTcIqLWkMrnKnGNRZtqirsOtSzYtPP-2DY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xWIuQ_spxfcuuz8Kmi1x45ThPXva0pC02XnmvuqACTw&oe=6A1323E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
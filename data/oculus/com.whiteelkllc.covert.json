833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewHVwkjr8JYQ7kNvwG8bopp&_nc_oc=AdpL6IwRbZHNWiQSZADTXLtZNVP8My4pzqSashtCsu0BkENnkj7WTXqyk29DRPP2AtM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af815tgYoWMvF1MChvwG3cjQs-n3tLRp4-0iQQvG0U-nfg&oe=6A380465"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tb7vuNN7uBkQ7kNvwE1-apo&_nc_oc=AdpW4IWNvsc9dlhoycqi8IwGI93Ty49NMnSadcAdT6ZcKz-BoSk5X1-bGsY5zaoxnqE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0RHf4dAcd6SDWByuJ6PhBXqiebYkmUHLbZ2duxQTGtw&oe=6A37FEB5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vt5Xeh37BAsQ7kNvwEH7Z0A&_nc_oc=AdqpUOIXtqXc0bAr2czCHveY2JPHBxXDJUHcGSt9_4Bz4KNY9ZQi3sYbWUm7JV73Wv0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jbhYljgsrK4fRypeYD7oKVt6VoJnGtxj0x3WwE-t75g&oe=6A380A9F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PZee_uc7coQ7kNvwHb5i70&_nc_oc=AdrrkUmFr5UHnEQ5rzifwn6W-XtY0a4EWd57iQ7aNVW-rs_k9eFaQM3rH4IuuXINBk4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kBBFCtnFtXkwbgmBEKNQVTqVeiyB6C8ynELEqZtk5cg&oe=6A37E8A3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKglqP2GmaIQ7kNvwE3DJPu&_nc_oc=AdoeX1vQvrj2TNgNo2tQDqw4BwOYVFnnOmehv3NdGpTTloUV2PIpuBYpxSlfI7V8f-M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KICs6g0Qu3qajG5qyydUv467LMT-ukDByRamlnKKs0Q&oe=6A380DE1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
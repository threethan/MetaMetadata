833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PzgCuNEFc8Q7kNvwE_HLwl&_nc_oc=AdqRt039XIcrAyOZLaRWAo0j_qg6p2tXY-DKxI_WYmHp5kBmWwTDqD__4SeQf9U-XfI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwXYzDwAjo25OJA5UO3g5XYK7C1HbcVGUk3R3_mHW94dw&oe=69D0F725"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aH5w8SloXhoQ7kNvwGsmtNt&_nc_oc=AdrosE_kb03XZPpboQF9XLAmImcFG1AecW3i5lqAZcYgkUVfOxnRgHm43UnuSzXcwMc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyyoPJDrBtEXQmsEC2KkTj0sCiUSgOamQfQ0xkM8tpwhw&oe=69D0F175"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWyVBxqJCKoQ7kNvwFM2001&_nc_oc=AdpLaiRFvtRQ7AErvHmp9DpEfr4A710r9u_AkB1vFFoyK02e-8yaIn3NuvpB22UEP1I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyFiZR_OUX257Q7grA1hPn2qGw0VQsBYACw-NEW0B69Sg&oe=69D0FD5F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtSJ6xSH4KYQ7kNvwENE4Ge&_nc_oc=AdpQB-nmj7Al6SohZr5PqdFrmowzx8yy9S7vRbAoVvbgOhg02y2JT9-CkRLPl6fOXT0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxVTjCxSGMwSOFIdFd3-AlWuoDz-r3ODIaltR4l8UeNVA&oe=69D113A3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-jzx_DBDNQQ7kNvwHAVSiv&_nc_oc=AdoYThfAuADiF5ns8eiAphOcgPZyQ8yP_KuL8QrHpG_J9iLHzdxrZRL7dBlFcrpyR6A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxxg8Sa5jnSXR7p94orJTYLzS5gt9ZVxikW8XIey-YXXQ&oe=69D100A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
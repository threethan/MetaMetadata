833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vv1sqjAkDWYQ7kNvwGzAi-G&_nc_oc=Adqi1nwdbCw9AW8X1R-JiF2u6AaP1pizv_bsbmitJNz3GG88gg1AdbYqd-JxYi1pAgE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKR7UR7YW4Dv7gEw_h3_nckVYnLpXEeN2DNOAc0Z6I1Q&oe=6A550565"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hBlrqzp6z8Q7kNvwHTnCiZ&_nc_oc=AdqPE5hzntocFRxhiWVS8v5h0Wll4BNMJLgqGJFpZ6O0Tq-SIRFTawvvXGTckSPvvlE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAm6bx4hapEKbCkqQ4lvhhhvi9T0JQhNqR0hDumnJ82AQ&oe=6A54FFB5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLzEGknrSnkQ7kNvwGLnvnG&_nc_oc=AdqDD6rzWMkviv1eM_mKLGM42iTB5SnTPN6N_UMSLb5W3RKJ7kVZ9b8Rk0DKyAGAf0A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKCA-ZKLVFVYBRr135V4nVqyDbAevaKrY8VmagvwTRuQ&oe=6A54D35F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QH5t1WsYsmcQ7kNvwE_54fh&_nc_oc=Adokix26kXjNKJ18Ag5aaMC2NwGX1cFkTr-wIjJ5Zg7Ta7IEnMzqg845YP3y8OAgz8E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiB97V-KKW2gZpD3aptg3br5IgAYuZsYFfpCE6eeMyQQ&oe=6A54E9A3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ln4St9BhEx4Q7kNvwH2NsWm&_nc_oc=AdrBDlV_khjxXhSyfLDmZhbqa1XqYrkDjUnRG76mAke4j_s9e5xXbxT6FVm_XxqpsBQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQbVLqCgQmlvDYNd6aNbu6G1LTvuZ_NDi3PCmi0xqk-w&oe=6A54D6A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
8833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Vz4eCTTsJAQ7kNvwEgY4fB&_nc_oc=AdqXKmV-fxjhcpBt-d8SIfHEV7rBB_XtDQFQTDu55-YluP0FwkLs_cqvjcn05He_c7E&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiEzbPqzP6A6a3oxFahbB7NgcbgeoAQfkpobFs0K7eNQ&oe=6AA41F65"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epTvF7qOQdIQ7kNvwHhFz9i&_nc_oc=Adp6w_jYs3bipsCQDHCYGC3shLtwfYPeK3F67uR4hN6rudAXc7UboJ65lZ24QJi-2-Y&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2Xpsfs-U12mV1iWYWlMN03Zi6S1BdrWh64d6e4yEO_g&oe=6AA419B5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6jNMRQp3MoQ7kNvwEMvr4Z&_nc_oc=AdqddhGvLYkjO_wKtO8XNOiEPhqOn9gqaPcGXi3PTdGXxy3mA5L1LlsrAjYY4Yn-kTs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5Sbw5VNDhYNeeh4sRcjSH-RUtzufqgDsQCAyn9biKEA&oe=6AA3ED5F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HylyaxY_DXQQ7kNvwHOKKEb&_nc_oc=AdpQvwgsoEoEAAhHxBQ9ToUrW6yex0Ysotw7O9xM7r21TeObxtoWNUCUeDGjJfHUzYE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKk-AKUj-SleDJObGetSX00Q1mtpEyn5ewva2D3lPKIrA&oe=6AA403A3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmLGmqSuVigQ7kNvwGVeUz5&_nc_oc=Adr_kBWgCljR5omb6BzsfbA8alK7dEN7ufv84ySzO3EK8UgIQ1xnkmfH5yh8Wtn6cgs&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSIXLdSueLLufSFs0aF6_umlSQsAhWubmYZDSq-PvFOg&oe=6AA3F0A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area"
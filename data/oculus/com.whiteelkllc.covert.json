833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Zf3VXhzI6EQ7kNvwFTSx1w&_nc_oc=AdqQGPtMnXSdZ7jvWRRHK4wn92r3QI56Ipkk3G7oiHMKvxRuuZte5IXrt_uBm1igqUY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsuj8X9o_xXkzjlckgscjIEob22Vpimf1--ISU1dM5bA&oe=6ADCCFE5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siCOSMPMoJUQ7kNvwFYkGwF&_nc_oc=Adr1n8ngI_LlPnGcuLXiJ3zMi5NQ8yzJ1i-h2c8M10yYuFaPRcsGUa2mLuW0s-4XLxI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIPl5BuOp0xrYvQBnZkUrrP8tZv_t3p7IHDpBWVqxSxQ&oe=6ADCCA35"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWASbkUFYOAQ7kNvwHC7DKm&_nc_oc=Adq158ZZ522aAxEyC8J-sLhLVEqwXs75IbdgmGspVuoSM5-RZ613Tl9ZlNVeAoSFgzQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN02G8eJOM1cYSy6-jKN7DH17JVYxHMl8jSJ9tbItmbUg&oe=6ADCD61F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znPZsr0vXCYQ7kNvwECQYZD&_nc_oc=Ado3fEelvYeeIJHJByOf4xr8rcFeluiZWF41j8di50ABCGzRJ1sibrcQJ02Tpj1Kp9I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzoyFvor17k7y86_XwRsKA3vyN0dqBYQgCxtcLsnAHSQ&oe=6ADCB423"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIZS1KzsmdkQ7kNvwFpNu7T&_nc_oc=AdpC4ErVaSFubWv2wi_NOT_b96v2m1y5XJ5POulA025OOMNlOnkiKym-b1lkoJ-cymw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9g9H56HqFc2D7Qzg8oDTCgcKnM3FR8tZLDLycRm91eg&oe=6ADCD961"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
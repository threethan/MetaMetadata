EaLO3k&_nc_oc=AdpTEnVQsq8UqsDmLL4lMu3ecpUarIzg6scCCKkKL2Hh0ug30N7CRe9uo0S9xXsvi1o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXEAi5LP-yfdMuH5RHbol0IQuuRkUmZH1gAalIydd-6pQ&oe=6B104BFC"}]}, "id": "1351699543705270", "locale": "en_US", "screenshots": [{"file_name": "02_outlaw_shootout.png", "id": "2584396018651904", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593727470_2584396021985237_535049112529665532_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSckerFGbLsQ7kNvwHaX4Fh&_nc_oc=Adq-f2yDE4fiL72PivFAsuixavrXb9EBcJ-yv0ZyLEtT0EAxjSB0w4ewXWcJq6ljXVI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV7uFwLUGymBh6a6AiTuXyFcGVuvPhxDt1fMABuIY-orA&oe=6B104193"}, {"file_name": "04_finger_guns.png", "id": "4181077275358223", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622195_4181077278691556_836725626422341739_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiVkiA4DOV0Q7kNvwEGCaIX&_nc_oc=AdoP66ldWxhB_MGoGdYWLGynk7DxsyX1BV0Zr3Y3kyvoiP5J0jCwDM3nHPfBOUwoxSQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVCt9dC2Fa8e9gHUNu1JLwqS2Ty4LCticpYDCv0aWM8QA&oe=6B104FD9"}, {"file_name": "03_carnival.png", "id": "1800971487903728", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593845024_1800971491237061_6469727041409901463_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b53PcjMMsOsQ7kNvwFU3xBs&_nc_oc=AdpMecOFwbNd5tOG8R2Zxhe40lE6xg7C7iNvtlzpjug72M3CjlE4QglI92Pltyt9vi0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVQKKnEg2u2Y8FfIC6i9X80HgWN3wfnEC03OO6y9yfakg&oe=6B1053A1"}, {"file_name": "06_pie_patrol.png", "id": "1809509346712851", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499626806_1809509350046184_7778539780440676097_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpFFe1KYBvoQ7kNvwFgJru0&_nc_oc=Adoos776wcT2BMYiGt4iUv8R-Uk1vf8pzBOa2eV0KGdLoZXEgYaSuloXakAP6af1y-o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXapiPFCSdvQFo8l6NkWGMhjXard2xCqjlEkDKqoNy99g&oe=6B103EA6"}, {"file_name": "09_wardrobe.png", "id": "1173989045568646", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624583_1173989048901979_2520353498644947262_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3EcpCgLeN0Q7kNvwFFBeAS&_nc_oc=AdqQDYUA_pDXg1sMcruEgCc3-lTpVC7GcrN2yNxeMK6ojwreFCAViILpl83rT5aQguY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVPOp3KBwp9AeLEIYXe0-2I16VrJ5ZJUmpNs_mC9xVERw&oe=6B104936"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fingerslingers", "keywords": [], "long_description": "Fingerslingers is a cartoon Wild West shooting gallery you play with your bare hands. Make a finger gun, drop your thumb to fire and point at the sky to reload. There's nothing to learn: shoot a sign to start.\n\nTHREE WAYS TO SLING - Finger Guns: thumb down, bang. - Slingshot: pinch the pouch, pull back and let go. - Water Balloons: pinch to fill one, swing and throw.\n\nFIVE SOLO MODES - Classic Hunt: three shots per flight. Don't let them escape. - Quack Attack: 90 seconds of mayhem. Chain combos, pop power-up balloons for slow motion, double points, triple shots and exploding pebbles, and chase the golden ducks. Don't hit the chick! - Carnival: rails of tin ducks and pop-up bullseyes. Accuracy pays. - Pie Patrol: bandit ducks are after your pies. Stop them. - Free Range: no timer, no pressure. Just practice.\n\nSADDLE UP WITH FRIENDS Play with up to four people. Share a four-digit room code, jump into Quick Match, or play together on the same Wi-Fi. Fingerslingers plays across Meta Quest and other VR Headset. - Quick Draw: hands down until the bell. Draw early and your gun jams. - Shootout: everyone for themselves. Lean out from cover, take your shot and duck back down. - Team Shootout: red against blue. - Outlaw Shootout: you and your posse against a gang of bots. Play it with friends or on your own.\n\nShootouts are fought across ten maps, from Hay Field and Frontier Town to the Gold Mine, Boot Hill and Cactus Canyon.\n\nVoice chat is built in. You can turn your microphone off, m", "short_description": "Make a finger gun, drop your thumb to fire and blast cartoon ducks across a sunny Wild West town. Five solo modes, three hand-made weapons, and duels and shootouts for up to four players online, with cross-play. No controllers needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jumpchasegames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Jump Chase Games LLC", "support_website_url": null, "website_url": "https://www.jumpchasegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "MULTI_USER", "MULTI_USER", "MULTI_USER", "SINGLE_USER"], "id": "1683785826454975"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622916_1615576746969403_7312987221789378818_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--wiUCaz33QQ7kNvwEVn3fP&_nc_oc=AdqpS5UZBRQcP0vkHLLXP4sism2aLIgaFKy0ld-0BkGKmFCV-7l_aG9MoqnMtEhPgn8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVgqA9
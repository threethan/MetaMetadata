80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROAa42BI0MwQ7kNvwHMnf1L&_nc_oc=Adq-0jWkwMKwVk_jyeS6oWX-7SJVTTbh4Yx62KcGyAZo2rf4fXGKcMK6GRKLUZV3i5g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70Y7_BtPk2CFJVy1ZvIkrCCzE9gej5e1HQwaVpQep2IQ&oe=6A1ECE60"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVpUWRh7pgAQ7kNvwFYFLJ_&_nc_oc=Adogw3VNPIM6b-VvRQbDnTpgpEIMo3D5Mu3g1qluF0wP40H4Pz3A2iMk4bEr2NeSvEo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Drusgz5085YyMn3zIBCnUTJMDrkkxuYytNIDjUBfNBA&oe=6A1EE0BB"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E19rHpKenPUQ7kNvwF8GmLW&_nc_oc=AdrbTFx0B6mhgyy8S69VVhDC_1l4gpb50CVFkuAwecv1nh4PF3MyjSas858WEv3ffA8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7p3QeTPHL2D0ckgbUMM9IX1afLqOJV7DKsbVne-tJsjA&oe=6A1EEE71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4e4HmKExZ7wQ7kNvwEovfAV&_nc_oc=AdoAMNZuA1krMcQcvSbOyb90tQUlSi_Kah8GZk0FEQS5b_vB9c5plBwjvgrna9Dx5Sc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4o8zyiyor0s2UXpU6UJzVlXzQbpyThPxXjIHzHCAunnw&oe=6A1EC88F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07pqHKa5qbsQ7kNvwE_UEKx&_nc_oc=AdqmnoJAncPDgzb1xkBlQy1u3c5Qt9-UeOU2RDtblAspyGzurGePCCgWVs2wzsNbIqc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BpBZThbe7NOZIUF3V6re2DGoJTIc1r-7JjQu6J2NOiA&oe=6A1EED28"}, "is_concept": false, "is_test": false, "is_trial_offer_va
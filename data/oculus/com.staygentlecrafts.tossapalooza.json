80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOTzLbGB4-4Q7kNvwFasMb7&_nc_oc=AdrTgu58dGJowyaotJiJfiDWOLmRHiAKiijrkwvck2Pqh8Krpzc0mzTHhKSePzEnKYg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8J5va6lAD7QcUiMjkvO9eTruJ-b3HTAmaXW_YHZC89Q&oe=6A5A21E0"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCVbR7wcWlIQ7kNvwEHlm3X&_nc_oc=Adpi-TLHN4_niTYDra7ujIgm1K7I-OsQJk5WO9qTPzgJ1YLnjY7ReJ86y_MLhQVG3gg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBB2PD8JQtOq6tAlFQQMPZS6L3-t0EN4Zh_2NzKkUFZjg&oe=6A5A343B"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8llqYgH344Q7kNvwGOnAnp&_nc_oc=Adpbqzf7QyD6c2QJWc84fCfo4G_c-XJAYG2syPnsOKqFnwrtVKlZw1htHWpMhXD5lHw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZ1xbVMhjaU5G_yiXvmJARE8xeyhQwf4919NR0TRcdBA&oe=6A5A41F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmfSRcVwx-MQ7kNvwEVeo7S&_nc_oc=AdrX8uz_wVj2Az27b6UahoGkgnFmJbjTlJmK27MBpjX3EiG_kC1Q0pt-yaN52azNcJs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzaTek9eyAqaxvPuvnBHS51rSgU9DCYdAJyOcq9786hA&oe=6A5A1C0F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XiY2U_siBUYQ7kNvwGTfgSt&_nc_oc=AdoDWxATxHrFp6eMoJaM92onfkGqZtn5QiAGVxUERyfhzJCmQbUX-IDDIjYfKJOmBfw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiYm3bGty4ro-Y6CHcS8VHjaLdHRyA29X5pbk8eraBCg&oe=6A5A40A8"}, "is_concept": false, "is_test": false, "is_trial_offer_va
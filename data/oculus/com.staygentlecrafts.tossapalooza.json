CZK2r2Sb9mKi7Fqd_gi_1n4MGFPhpMYq9nLo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftPVdCSTxxbujuJvfTItLyBGkeCi2EY2DGIDcDg7ZjB2g&oe=699C49E0"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFkWjgGvdnAQ7kNvwEz5GXn&_nc_oc=Adn6FP8VMyseyd1CaAAJb_yt2qs3Ozts2c430m0y3LImYNVfzJRQ51UykH3UDHys2uA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsidjFWBfZ94Zrj8JFss1O7uxUVPgxVQLSSCxzTnQaggA&oe=699C5C3B"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3rE6_w887YQ7kNvwEZT6b4&_nc_oc=AdlHBu5T4fcbgUg75Iv6ZiBKOPJ_u-429oimCkIyCFo_UjnCvEk13zuc8SP39kbiiGI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft_L51n5IzW1El11YgnVW6oJtCrgYZe6jX9I8nEwXkgZw&oe=699C31B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Elb6iFMzdfIQ7kNvwFlStCg&_nc_oc=AdkjEpzb4CGPXspqhmAshR9vAbNa8Y0Gb0yPm2-YihQHUvMBZFYNnNkPoWSVrareW9Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvb7GiQfcwc6rKgwFtXohUydgMq3dj8_mGEtE8W8XxK3Q&oe=699C440F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZnpy7Yx3i4Q7kNvwEHSVZI&_nc_oc=AdlYRE6BR8Fk76sd2Vr9mWc-FLnw09uveKxRwj11Eci2OfcVv8DhebdvF4yvF0hjrx8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuE9NJ4Wr20Ko18MrbALXEfb_CMdq5DIQPlQMJ56wj6gA&oe=699C68A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Toss-a-palooza", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_nam
80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTeNIf9KUdEQ7kNvwG5CdTh&_nc_oc=AdoR9VR6FdZy69fsSeYmdlKXFhWDydpaThYwGT6a3diHhMzxwNQ2lILGmGvtXWvy0yg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUUTSui6XQDU-vpVSJm_yvaFgVv5dwnOJE4X6lyOrhuQ&oe=6ACE5E20"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkrJtxuhjawQ7kNvwEkTEde&_nc_oc=Adp-d7OifjiTKyycsUS83unrrg5ANN_ZMynYYZWI2GwRDuwSyBILBOSCmrJIjb7CdOw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbkUd_9lcRvIXJGSX9frwg4PLc_LfDLytSJpS3lWXqrQ&oe=6ACE383B"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpeqxC3mKzIQ7kNvwEsGp2k&_nc_oc=AdqpPTzAHDUFRcCDPUIbUkwSqWAy1YlBqNW9oli4Wu0RNv5fB6jnH18RyLNc-ApikTk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdpJbsM343LPqNhO9xqz1p_5nWnjRGhUTfjxcngIg2Yw&oe=6ACE45F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Quwf7r3eWbgQ7kNvwEB16Tn&_nc_oc=Adr4gdq5tNWU49VZDpwod_fM0Li4LJcgPdYla18EYi0EeHBoBFufVXvw0lvmWlVC7Ec&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8TVpuLAmlUohfPfwhL7JrHb-VyTVoCSLBT_zNnh2lXQ&oe=6ACE584F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LAHOed6DkH0Q7kNvwFMcvD9&_nc_oc=Ado_sabXAtzIJBfZLHlAJf_riU3d_OUysS38ok74llcxF1-3rp_BHVIB3YZoCJAZ-z8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKLK3MYg2JSoGitvmPePgMCfqfOuTWao-k4AqKGGnrsQ&oe=6ACE44A8"}, "is_concept": false, "is_test": false, "is_trial_offer_va
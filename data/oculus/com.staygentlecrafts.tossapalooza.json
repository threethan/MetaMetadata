80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzrtsHTgq28Q7kNvwH897Tl&_nc_oc=Adqp8z1bezSYh5MCQb6bV95dhEE4OMd8awnEEmOf_qC0VZCS0bOqsoe7INXWfvm75TU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74HfB13nnXmr7q9NhJbQoroLMEl3TSNFGkOVNE9d4WZg&oe=6A1593E0"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6b6_sxXljp8Q7kNvwEHrlkq&_nc_oc=AdqmUGATygD3mQK0MXTTLPUJDUT2wa80icZcVwaucDJF423Eo4L5RZuA8OSzISCY5Ho&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OCp5o1PPjpuvKRxY0z3ZCYWauNoZlxYIj6gDvdCTb6A&oe=6A15A63B"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ip77YIRwSY8Q7kNvwGttDWp&_nc_oc=AdrcA6h1OL4qMitfA0nZafB2MPcSYTTCxaeHvg7L8HXrd8H7Qm-8Xka7-bPozPVSGnQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Q87IKE5jcUN_m1ktwYC7RLGBKOi1jpkCzVLO8TPnIeQ&oe=6A15B3F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-1XgDqD82EQ7kNvwGDExLO&_nc_oc=AdpZ3y2MhMqxlsV9z6SvHc_2TxO8cEQrE-r57lR8vhSIXPoz_ASVYYYEG4YGiJQc31o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lZNN2qgKePxogjeWsH4Yqt6h4oY-mG8hPb06kEydvSQ&oe=6A15C64F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJNiPbvWBKoQ7kNvwGN3yOQ&_nc_oc=AdrryBU8xYOMFXi-UKS7rMZj8-mqBv9QGxCHYX6IpAVHUegcnQBFu8Hjyn6n91UAX5Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BJcGo-MWItJ4g_knMwHSNMABOglYdPpifEuhQLEPOVA&oe=6A15B2A8"}, "is_concept": false, "is_test": false, "is_trial_offer_va
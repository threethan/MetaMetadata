80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgJgCMrU788Q7kNvwFJdSqC&_nc_oc=AdqrEFbEP0SQlCuoqturhNtSxBysclnBOOT2k0a5G90sOvCg3fCkqWsmLH11J76czKU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwH7ELEA19yO1uSHfnvBen22_D_z80Bc-cwacXT0K7q7w&oe=69CE62E0"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruy7GAAcwa0Q7kNvwF8ABJs&_nc_oc=AdpzepL0q5eaeJ9vL7NMyWkP8gMRg_31ESaYcVUMYkT8Q6GhACrDFvkW9IB8Nxq1E2w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyXPYOR75AQLu1d_J1O9Qj1uPYZWuKdnq_VLmNKnufDLA&oe=69CE753B"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wx4uXvvx0AQ7kNvwEgNtOt&_nc_oc=AdorlmrtnvNAtJLKCxc_JbJNuBEGw0AlrJe3ckgT_HPkt0w6q7rc3F3wvem8Ss1_xrs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxlotJ20Y47RhamRWMMh12BVF1WPPkwpQoBc8h8yNNxdw&oe=69CE82F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tV9RRMnAPZUQ7kNvwH5xOsh&_nc_oc=Adqu4HSVupDrfwIIWYrGu0N7auHTC1zFEK2OnlIQFXh_QqqtzSt_WdRLkWrAwIBiWdo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwN0L0asbMUwUhmnMUfXeZDtA8ghq9Zxro7DozQG1lnxQ&oe=69CE5D0F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C25A7dkDkFIQ7kNvwEo8aI2&_nc_oc=AdpOPYkKBeQDOFn1iZNfhs652keyBWVyBR0h-pIH0USJB0lm964MiPROtj9U5_57DMY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwAHdZgNosEWUASUQWEi-uxpWdgE1sjvhzLXJDzUwIoeA&oe=69CE81A8"}, "is_concept": false, "is_test": false, "is_trial_offer_va
80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCLD-n69DkcQ7kNvwHH-hdf&_nc_oc=AdqYPZgXbjARCmFmW3V9ungL-YPDtrdJm8vV6ecXc_a6MK2DeP_Nt5eo2g9naX1LIM4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGz6qWewggJM4n0fJ1tGJGMShfntn4ygS-0VwjGMF7tdw&oe=6A95E5E0"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxWq4yaHud0Q7kNvwHiIUok&_nc_oc=AdrDqGfcQ_J_xru5yCt_s92bVtc0gGjkJRtFL-npInYR_R5nG95560r1lrnUUXTwTMw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZRGal90ODCAkMboblHzsgLG0YYHlkCv5jcY096ABEBw&oe=6A95BFFB"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QG-Ry6FhvX4Q7kNvwEGr50K&_nc_oc=Adrqj64wrFJs79iio7Adotj98ZDWeUS4YDXhpNZH8AWl36OTJhg4J04i8EgXsba0gfs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGg24ghnY6EbnTdgAHHZy-j2VKq6ReXznZjPP65yyxrkQ&oe=6A95CDB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hO9b8vSzKNcQ7kNvwEOW7OH&_nc_oc=AdoGc24BxMWrcVMDIa-CK3OCRLgE2nq137sYKp2hzW5OmwpqBdfqNaFKu75jwMyF4Rw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2QIQ2_SGsHlrjAGNFK6HF4kRMlwmWMDTeu01LpVthIg&oe=6A95E00F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npVeiCK9tI8Q7kNvwFI9CAC&_nc_oc=AdqYXwfCOz9rjFc5YsJF_kAGjLKMvWuOb2Ziujt1lgERkoALCaxN9hswPrfdrfA-SNw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG03AVZzSHDyIHZMupIhM42u9aVbLzL16LMGTJ_BC6nbA&oe=6A95CC68"}, "is_concept": false, "is_test": false, "is_trial_offer_va
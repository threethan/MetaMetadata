80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4cg3w57CScQ7kNvwFjOJU2&_nc_oc=AdoDV_rji6_4sZM5gf_nAvb4ALwU8IGTh_og5HXWEvHDwx5O37gkmuCR_JVki6NB1-0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69wwm9j-74XUBvL3kAqRreeBoHTo8YJ2i6jZEriFJO_w&oe=6A0B07E0"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JHKMUMnmOwQ7kNvwF5Hdki&_nc_oc=Adq8Wz8kp4PR2dx1tpdy0gxePvOo_888OMYpjDLIz0Uo6KqCOHMZ2AQpp1bboSfC4Tg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sXB9Jzxva0H24OVOHidQfk2j0eQ9dyRgY3AnP0C-zeA&oe=6A0B1A3B"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SudizCko8NYQ7kNvwEBwONW&_nc_oc=Adru8NlkxoxVR1eBuWlYxcUocBinDsvVEYwVvAC7diXbFoiy90UOy1dDeea5UzAiyZY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sj4rGgHq_d63rei0DeHGVVyH9RsBCDOq8ttcmmHH0lQ&oe=6A0B27F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cx2nYw9N4WIQ7kNvwFxa1eL&_nc_oc=Adq9aTOX-jNOxE2qjwjagpBLNOx2vlLHaPdK1nMoGa4Cmfg0B8lkVbXXfIFj50LanZw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5631m_bodiM2qMzPkniQ-VG-5Yq52eoeIFv7Q1EeLI6A&oe=6A0B020F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWXB_iraRP8Q7kNvwE87Y5w&_nc_oc=AdqkP8mABqVgjLma8U4EtDo_RH9HHefjax_boIxFGaOCCgN8yNNeFQRrAqthW3sHea8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gGFC5FeoLrNjbRpRkBIzRPO13mDR9gN0PyfO9ulN4tA&oe=6A0B26A8"}, "is_concept": false, "is_test": false, "is_trial_offer_va
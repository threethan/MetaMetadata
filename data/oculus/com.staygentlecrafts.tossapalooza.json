64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDy4MN6cRVwQ7kNvwEbM-wH&_nc_oc=AdoERczMZdqQJtrb5bDJa7dhJ5opqKx6PQC3Om_57y6f2j6ANDW_GaAu18813ParocE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUxP0PNYWkduKrpyAZAxzA3FQ1p-gI58Y3fhzc7uqvPA&oe=6AC3B9F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsD4y8lYSKcQ7kNvwH0q0nM&_nc_oc=Adr7w6PyQdF5Rz14agU0YRLfkD6yesdd4X9g2pLBg0PMVtPzzp7o8C81vOXKoJgY4aM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgiHS0pQVU6y14Axd0sbeQnpI_qpGImX24o9zg-2FxeQ&oe=6AC3CC4F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating
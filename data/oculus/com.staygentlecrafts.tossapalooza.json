80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svp5Ktwvu4UQ7kNvwGQwTnL&_nc_oc=Adrlj-A7bB7aah3gjrWBXG-DCaMOold391XJHwwiu_6YS4QwxfGB14S44s-THhw_LMg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZ3bZbEPw8u9SamLhicJgEI9c19d9efvwAnBFcO1MM1A&oe=6A7F0BE0"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aw729HVgXqgQ7kNvwEQov2C&_nc_oc=AdqzHW2dhLIATfIyytsZz1c7EkLcRo0TAPwCQW4wHpX5aMIMT2t_1SPBHhO48RpK--U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTPI5GAp3I7QJfJ6rzcHxW1NJlJjnUG1VHS9hstVu49g&oe=6A7F1E3B"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ku-gjor7iYQ7kNvwF4xxhL&_nc_oc=AdoJBpHqUQxxm_OfnJ5-wkRRa9OqrvQTCElr9rffF8rkdr3nVCondLRK5ejpPBkvGqY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGi3kVI7u0KEYmbAndxZH71dGGDF7j6Ev0ypr1d-fkCyA&oe=6A7EF3B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwBz5Lt2oVkQ7kNvwE1qoFn&_nc_oc=Adp8kkn_m3KPvdTa0G8TQKtWN7nJIRwP_gkyoe0geKp4zwlPGXR0dGss-qFVw-3Yw40&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzSpGxBx58CeXI340M3qoAEKGG3K7jVkoN7P_nDCiiPg&oe=6A7F060F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xo7zbuUVyZMQ7kNvwHyVE1t&_nc_oc=AdqfRqGOVOhAQc03QdDR1_XCKuo1orpQ0T5a0sI_8tPnLcF3O4vi_REaJ-cF-_MmxDM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNCkDdKGlFjW4kdl-zMzvnUT1Gvh-boFqwhcEoTY_d4A&oe=6A7EF268"}, "is_concept": false, "is_test": false, "is_trial_offer_va
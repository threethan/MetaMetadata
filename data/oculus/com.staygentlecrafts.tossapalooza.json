80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sI2S6cVl6gAQ7kNvwEy4wvU&_nc_oc=AdoyjGeRhXlV9c53giJzkTJyZs2O-E-1xjCVjXZV7DLxEWMSHmBFddJJJIfHc5W4zuM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Iw5bSm3eZQUCyF-TRhR7TQ3STmw-eRNv04KzAFkbXgw&oe=69EF5860"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSDH8C46OOwQ7kNvwHwNe9-&_nc_oc=AdoyM_p9jA0Un4Rmk6dgOBjp5h2t1f3Tpm3ppd3bt8XRI5_smc2cqkwX6Ya09fcvaVA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af08OGiEr3nplExtEJcPjhFssHNL8aNkMy-_XyB0hoGgGw&oe=69EF6ABB"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2t_VHMmOYsgQ7kNvwEfhq5J&_nc_oc=AdqSO55Q4sC-dDXSIXF3wbZHlPxsdrXWclCg-aYAURdYOFI3Ux_-fNYsSogSwu4wUnk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af32-1cxJHnbf3pDMxfnyjAvk7F_rLm1c3vQnvoQ5GAt2g&oe=69EF7871"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8VI8edmW2wQ7kNvwEnOiRl&_nc_oc=Adqci2if0xI7QEnj9Ji0pHBTZxLGCR8BmPtRhurOJk54hQhvB5erwqpkH11mbIka8TE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1cgydtg_dxjusrk4bc7d0pwK34TwzWGT9ZFTSZB-RkjQ&oe=69EF528F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vex8lVyy_8MQ7kNvwGWwvfX&_nc_oc=AdpH4vOpa405ETDvZX-JmOVbh40ZnK5YSwHhG4TVZl-yqkG4r23zN7n8cPbQWTviero&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2T-u5zC2oAVASY_h7za2vwzE9dTDhebAL_wEPg_e_A5Q&oe=69EF7728"}, "is_concept": false, "is_test": false, "is_trial_offer_va
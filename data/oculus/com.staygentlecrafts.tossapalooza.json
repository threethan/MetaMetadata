80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzrtsHTgq28Q7kNvwFX35MK&_nc_oc=AdqJE2ZvYfSVcMQCoeTX7GM2slP20X15_w1pdwVxYYTt2XkpdxpwmR7HmX8k1-pdR-k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62hDlwu6D6Gm57glG9_nrIueW8RXsDvJtBlcPN0a_7bw&oe=6A1836E0"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFhPxqlh7_cQ7kNvwEcdXec&_nc_oc=AdrLyszn0fVowaMt7WM4QYxQS5JObbwjk0gQ3FpMn4E2U6s49HKR56sZ3eNkEnzi8gs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CkKoQ-k5_AoBCKTkFGEIHGiTvkLVgCwrl1EUn1zZOgQ&oe=6A18493B"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVUTj9nmJW8Q7kNvwG0kzEv&_nc_oc=AdrY91EkP7K1vTwDpQDc8YQWqj0nJR47tvCBPbJlFbpeGUEP6wy2onkswjzPORO6deE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XCRbOwyysw3e-1gRfP-YVhjdXF8z7NVg5uae95il9sQ&oe=6A1856F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSpzthnJst4Q7kNvwEijb4l&_nc_oc=AdpSCezO3x0oW1pWv53Pe8u4UgiTE_4ZvXxtOCJfxJos2pX1JMoH76oAyC_I7nLLfj8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xrDislXy487Fg_9mCmVti2wLaM3LzeRqbiyK_Up1MFA&oe=6A18694F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4BaRycqhSsQ7kNvwFomFrv&_nc_oc=AdqNZ-d8leMj5Vet78SNgSckJEV0FDjIXvxAHAl34Xj2-Oluxx4o9Udv2BCNMyrV5Ys&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vPYp-te1SAzHxsi6qaDP3MM2sPE_2vvsCqlxNqQomtQ&oe=6A1855A8"}, "is_concept": false, "is_test": false, "is_trial_offer_va
80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBi-hDXGqngQ7kNvwEOqcsq&_nc_oc=Adr5k-0WhPyIsyARb4z5HjGAt4QcU9DXAIVhBmH28I_iUdoplhjgjSwxwY2FAzdT1gY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6b2DziThLUpDuKnPlmWvIVMyse8srfOUN4s7WD8bNuw&oe=6AA00160"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQ0_5Nt6hiYQ7kNvwGn09zy&_nc_oc=Adozb0XSO3aIKPsbuxpc9g3jfLdm4EXkAqtQxmaeJeF1SETZJ2c1ml7jPzPwSvW87KU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHtBaRuvWVWm4Q4ip1Qzvij6AqWHvg52cuRCRk7MYAFQ&oe=6AA013BB"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kioJjYWmdc4Q7kNvwGKJc-a&_nc_oc=Adp4J47XMq1vubuMho8OcxtBulCO_pbODPnZ476wGZG3YJ_Py4EbbRedqWJ4_ESPN80&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0ZV3otRsmneB7_xoFIWmJt88yEniz_mJp5HPLeEUYqA&oe=6AA02171"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5Oprw2xf_AQ7kNvwGVmU_7&_nc_oc=AdrmGYXEHdBW-zEnI7SF8HRgaOMlCAslkPH80AfNDYH0THa2lmSlpbpI4XnVdK5U20I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkjxHzjumnhj3cDGFnL65T0v_ZRuweLL_dyJPQYcFQbg&oe=6A9FFB8F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ro-yWhzNyWMQ7kNvwE6majB&_nc_oc=AdpFE9etkmt_L12JWqQRXWqizHi9H3CSqFi8zy99zAHoiUwL6La1R-Cv40Q5-1Oa9t4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLg0nxVZCAQ19zHm2cs4UED7S8bZLUDtcyeBIVvMwGAGw&oe=6AA02028"}, "is_concept": false, "is_test": false, "is_trial_offer_va
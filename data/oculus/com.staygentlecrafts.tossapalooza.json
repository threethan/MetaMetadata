80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YG0XTamSphEQ7kNvwG-woqL&_nc_oc=AdoJdIps-DHs0gVgH7-HOO1cV5xY2I9AiBf1mwSkjxKTrXuD-L9TaAOj34GsbjgFE2E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbn6-WdLFjfavF3EEoqnkeyiJGpksRe7j-LS7JUsQL-A&oe=6A79C5E0"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CraurqiMi6cQ7kNvwFlSkcH&_nc_oc=AdpUyeGeso-BFtcqQuOtEEsYFBWOPOVur2GbWMINIj_zB2qAe72meGl5posjBu2WiW0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5YAiyE0GP_OBC8mN8mc-SacNGJ4eH_2X-JUzo2RovsA&oe=6A79D83B"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XM0vT2pObQQ7kNvwF2kphT&_nc_oc=Adp1WGT5D4W4CsqL_t7IHPjJ9mN85qU7z4Iex0YdkO0h53kf4dTfyrb17sbf6dLGQUk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIckkN2JZtm04Za12wcT0IOvnu4vrLeCmWnM06TO_QVA&oe=6A79E5F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xg-6sy9Zi0oQ7kNvwGZMjhC&_nc_oc=AdpGyxibYRWaLOXSyuuYey0tqYA_sbBKwimywZMspDyWnXEO5C_8BepiJ-QqCBSBl-E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzPSGIEa0yeebm_k4eHsy6OC8PlAJ2JRNKgdbBVFAUFQ&oe=6A79C00F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lhd9jPd78m0Q7kNvwFwWRyc&_nc_oc=Adp5zN5CkiiG6XHC5zm581zeNyMK8QO6qJd0r7cGCkKHF0fPohlqANYQg071NkMGVXM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQER1UEPGXBj21K501lLzlXRsqSvlo0ct4crgi653b5b0A&oe=6A79E4A8"}, "is_concept": false, "is_test": false, "is_trial_offer_va
80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tuIqkQvR0zAQ7kNvwEx2sk0&_nc_oc=AdrQGyeJxlr5vlnuVeHoyq4zUKYmTdg_JXjWuxwzYd_M4zqkHhm56i7sYo9k9vRHaD0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VUQ5O3H1_yYN0WrkXos0kjwdA0blW4BMslJ7qKWox7w&oe=6A259E20"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgIfSo9P5Z4Q7kNvwE1CP7U&_nc_oc=AdqqSD5z545Rvnh5rmzZVMBu3jotXBNwqkSxpYJObPmQP643lH1LMd7Ia2U2KO5xAKs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dZLt12FvD0d9m1ZIZ_hGaXZiXmOVsQrp4CzsBzFTcbg&oe=6A25783B"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=270jj-KCSD8Q7kNvwGqfntR&_nc_oc=Ado4Iu0hULPkTvbNmkWb8c3CJEslDcKv8AYZTnAYlOGkR_8f3GZcuKrY1UXnMEc9yjY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zKNn8GePhC2g3Gra_es8kMmShig2LB4nczNBOzWfMeg&oe=6A2585F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTCSZZR-8csQ7kNvwEVbnps&_nc_oc=Adp8cserH8NmaGheKJqrAGa9wkv-sd4ujg4MnO--N4IxHGndkJoL9OcCN-RQzXPTw2c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84Jlgma_0RUABr9ozB-LL2FDnPjhfU6eqtDYVFgU0sxA&oe=6A25984F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFEzPGnDrB8Q7kNvwGL2C2t&_nc_oc=Adp-rv6ovfjbyDuv0X2iHLPHjH-DYexXaC5Orkvpdrv1ucCBToh8d8LNPjx5q9VSA2c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-I98Y6xi9ily7XfNQ_TZtzMTsyhtTJKPE1RpF30rr8SQ&oe=6A2584A8"}, "is_concept": false, "is_test": false, "is_trial_offer_va
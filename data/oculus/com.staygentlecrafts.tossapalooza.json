80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WZ1qk3DM30Q7kNvwEPkoER&_nc_oc=Ado9djDC1jTaXgZY0NWKY9NXEBeYlnktirT_-uSo40LjGUv3zctfGRV_K8Qj8uJrY0s&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbMzfq5-UDUqH9waGnIeNHlKsxLf0FOcSKQoUHB0flyQ&oe=6A973760"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxWq4yaHud0Q7kNvwH29qUk&_nc_oc=AdqgZifJdt4SwaydA5L3Uz45Y5PRC0vfpccTdh6mPpUEelkTCvA4nEA_W6N-O8TKgtA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOSUC1-N0Zjx8QVIvGEw_L5nkcCbGis5Sey1O-wFme5w&oe=6A9749BB"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QG-Ry6FhvX4Q7kNvwG3dP8E&_nc_oc=AdpafhvHyco0o1BCx6yk04za2prhZknSb1FRFdv9igdsH7SB5J9sECVoznKRu9ei24o&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGgPQVfNJdK52mcESvjVG1gjY4vsvknXHlAMIC9xLrtQ&oe=6A971F31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hO9b8vSzKNcQ7kNvwHGO7Vs&_nc_oc=Ado8sOk9I4KoHP6tmVEFzlQvqrbgL5Upf8VuIjz9MKhlcgUNQVRkRZtx3jKthzjCitc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGq2UxzelQAdR4N3EinYfXUpeekDAJ1CBuViXTW3xd2Ug&oe=6A97318F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npVeiCK9tI8Q7kNvwETwG6_&_nc_oc=AdrR__0VgTntb_JxbtXqwqgTGmLT4HCQpeFfaiYtswBXLIK4UNdb-gTi4OHjPkwU-oQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHu5fixYZGtGH6jPfoiMb4-UYfCYJXEBYOeI9dprrDgZw&oe=6A971DE8"}, "is_concept": false, "is_test": false, "is_trial_offer_va
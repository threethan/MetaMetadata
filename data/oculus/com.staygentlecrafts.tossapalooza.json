80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZB6V1yJHXyYQ7kNvwHEq62S&_nc_oc=Adry-cZ_nGB6Z-939PcF8VG9bcoYaUSHfFAsfRokjnyw3AirIXr34BFFklVTCnt1AtE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-Ws3ISewLY7JdxU00QK9I_JkVWn87T4WYPbZFQlRHRA&oe=6AF1F6A0"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PomJ3sUlJVMQ7kNvwFH6Xxq&_nc_oc=AdrVJnEN63usBn3jbC96a6n2gobVtvj0iuY_DDuoGz8fCE68CKnKo5UpzndhF9xJXg8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtwoDh9WD2mUg2aPOFNFOabw_eCwtgtFz2L1AW1JxWCA&oe=6AF208FB"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KcDdlrYpZAQ7kNvwH51Io5&_nc_oc=AdoTAItftPnHbnPajY7pcvOSRLBH-A1yKspSfv87D_6KCBKdbchMFVmX2bUBW4jyrkE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFuTy66q4tH5YuHRWgGNYP_XgvAqbEEHpHM7R5eA1nQA&oe=6AF1DE71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPVEzkumTjcQ7kNvwFIqs2X&_nc_oc=Adot9TCEI8d5j14df6yVf5J_X8dk3wLpXQ59rHzCzoP36DdAsqIcyLZu0m9D4GMi8NU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1T6ducZtqcoDQNcfcGJUApWY762Ht2fZVk_hwbrqgpQ&oe=6AF1F0CF"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CC5yXWFu3XIQ7kNvwHNXlHT&_nc_oc=AdrZr_DdhWLoum2wjU-OaBqhFG2RewC-GCLGubJ2OomuPxkc5Bt_woKF8Dx0-nuNFkU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ06FMoLLJoXYqbi1W6iuYrFOToVTF7GtvouNh47-bIUw&oe=6AF1DD28"}, "is_concept": false, "is_test": false, "is_trial_offer_va
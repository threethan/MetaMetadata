80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gq93fz_XNocQ7kNvwGMw7mn&_nc_oc=AdpCqivOt0iJKCHoZZal_Rn5ahxPkjh4xLLM51sAOTFo1x2BraH5R0Rwx_OMnbxNXvo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01BoYmoRC35VMqvmv5p8P4vbyRCpDomaXs6EI27_M33g&oe=69E0D7E0"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UpIwgrUngGYQ7kNvwGXfpfM&_nc_oc=AdrqIKJgfLyZXmLL1urIGzJO13XAxs3Tn9P74BTgFiYoFCTLeyqGxBjfhe_vEbhlU_g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Efb66itjmt3g6UdENjzpAa6AmXXNkPANqEQpswgbIoQ&oe=69E0EA3B"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzlHEvnT-ZsQ7kNvwHgDxqz&_nc_oc=AdqXbxgQUmrzaYuKF6AKn8zr69RQlHTp3mlP0huHBol05Vv5V9UNFCG1fKBVnXf_qq0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qhZWIJyl3zGNoHf5pQqnDY9ysflkpS-SnWJmyMZqPRg&oe=69E0F7F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jvJyarFsKQQ7kNvwFG0q67&_nc_oc=Ado-0Edy0vMWZCjmi9JHqaNmw52rXK-S7DWkWNO6Vyjw-e2524M66CKDEPeOBgfWrZA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YyKtqK3I0uJxAUm1UvZ-DVxKPy0gpp8h9-ZVDzYV1Iw&oe=69E0D20F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_WQzREAnkIQ7kNvwE-lPHf&_nc_oc=AdolgAAcoqLlddFxfcWnw-ECma0YNz1iPzNXOD4ZGDWjhrV9JK5WhLOBArs8E7Uucys&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OAq0VWD6grZMThq7JbooQUVzR_fFWWfDIt0Lb9D9QUQ&oe=69E0F6A8"}, "is_concept": false, "is_test": false, "is_trial_offer_va
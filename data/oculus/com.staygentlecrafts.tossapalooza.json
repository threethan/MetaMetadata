80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQ4RED8N3C4Q7kNvwGBnj2t&_nc_oc=AdpMByuRx0zyo2r5_I8sM_s6x-gXL4sLcunFybbtNvCcR4GY0CZdbZ5B2m81dGESZlM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrGrC2GjkAEB9H0T0a5c2DGBsLcW2OOK2D2MVZm13kqA&oe=6A5CC4E0"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=df-a9eXnqskQ7kNvwGoQuAe&_nc_oc=AdqfCzhRsMGmadtyN7sM0pEprn3pq4xJ9nKxFWbBZnpTt2j9P7Gq3q4i_j6xLLgMjK8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANl9hSvv2fEjy4P4LMhJqXEaX7mgKPLBLhMIklTDdOYA&oe=6A5CD73B"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8llqYgH344Q7kNvwGWOUqT&_nc_oc=AdqU83E0L0oVGDD--jm_RDKyYujULGAJYLvnB8N34mWG4Wb8IV8M3t2nREyT9U-jkI0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsvcazyhMB-SFM_Ul9BQ7aQI6870_NCNC4PyHq5NX6Qw&oe=6A5CE4F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmfSRcVwx-MQ7kNvwFxW-IP&_nc_oc=AdpHb1ipw492KNOcSHnsOuSuaLgnncBngat45zUXP8ifSPeFmJRsjXSXCg5DeQlX8rs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBE4PCIn4o0449uQNnBQA5_33BPYz6Um4D1daCjPPhqgA&oe=6A5CBF0F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XiY2U_siBUYQ7kNvwGL6nOQ&_nc_oc=AdqyEUHo7IGPSAQJldYu6Xe_1JKZCYUv-gob_Jgphju7gzootlysBhbjW0Nh6eivRok&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWepvLB49VwqSYIrXsvo2W9I_Lk8vKn67hK67E5noNnw&oe=6A5CE3A8"}, "is_concept": false, "is_test": false, "is_trial_offer_va
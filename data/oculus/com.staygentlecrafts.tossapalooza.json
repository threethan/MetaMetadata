80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCNZCT5fzSAQ7kNvwH1t38-&_nc_oc=Ado1AqrNZZC0imexb3-a3Q0ybBjGBzEbTTY86TvjYkZAIUB3ryFcQHzEV-bZg2JcFHw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdrcNVb0-Hqr-1T7DYXHZm46KXjacxPSZ1ud8AVFkI5g&oe=6AC280A0"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78PNYNL9I4gQ7kNvwEixstV&_nc_oc=Adql0t0BEe9FQFrUAqzk6eDOiA9yveYqaJfUzh4njlCUsgiqnuGf6pgHfQ6arYoUHdc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPC1PY4hZuTzeVo7B2fsA9eJs0oPdWv3ClOR6IabXG8dQ&oe=6AC25ABB"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDy4MN6cRVwQ7kNvwFgEQxH&_nc_oc=Adog7zfB-QD0olNnPfMufeDt8eTSGvF0i1KlvZI7KEkgyxwwCH5G6QLYXfbUwkxJJpY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-_hc74vtCs42-GELt1h71NfsDxOEYPPVVB0vpGfqO4A&oe=6AC26871"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yz9msUMw5fEQ7kNvwF_4Tvk&_nc_oc=AdqmOn_lqYlJKdiQpMGpCpTpkjCRoVhiEtQdtHdQAfrAMLl6X7zaOCudY_dUXRlgaKk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6FQM59v7yFIloCT0lDCly4oXW6gydCdqE2SiJdKT_xw&oe=6AC27ACF"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-aXILR4VbgQ7kNvwEFmYzl&_nc_oc=Adq_zN6vaPlC47__gWcVxp4YoYUqavsEAlBQ6v0hZbWzIO3vyfEhWQCrDAMnW-wOY6E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyNwasHcH53_7GPi-SnSquOv9bQRXXbnH85bt80-5iZQ&oe=6AC26728"}, "is_concept": false, "is_test": false, "is_trial_offer_va
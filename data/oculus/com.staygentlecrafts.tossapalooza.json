80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hX4OVNZKaooQ7kNvwGwdciO&_nc_oc=AdpH2SwiEoJUnu5eY9etiuWWq9wwwOq7uamCL6twPSw44JSfZ1nsf5h69RasO6efBPk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAchiPpAN9Efmf-awD7HSuZhOaIyu1MrhJ5ZlmHcbRag&oe=6A902F60"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oquSvJFUIs0Q7kNvwHYv5tg&_nc_oc=AdqEdA2UH3Bz1SAvtJZcdFWWjS5w5FASd8ialbkG3EACVFxcjloMYh7c-nPcE4l7NDo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_SUxTW21EM0Ly-5I9H87evQqVOlU6DyuTpPhN7C75wQ&oe=6A90097B"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzpYNOa-THkQ7kNvwFU0o06&_nc_oc=AdpSmxrbOlHxw0UVPCjlGjfiX6VXojhOjMQfo425Qdnp4-tvbN-UU904WrgwqF0SGm8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6uGhZdX5OATBqjxB7fmBf9pOdrFg4gZevhndiKxyk3Q&oe=6A901731"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72LQuwvNTUoQ7kNvwE3PotI&_nc_oc=AdrkyjQ1vnMpXLbYORjAqnH-3MHhnTuh9jdTUy3ad21u_sDZEhQqHAm0jSPeaJc9SRU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAgrt_qWBAmEyGTWgxghMMz-_13VuP6_fh2br1Br0WXQ&oe=6A90298F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nv3Bu-XfJHwQ7kNvwH0kulJ&_nc_oc=AdpwFIQQZa5pPBVmOS4rd1yyNAa8hBrxU7eRvP9Vx9Mm4HaqTQ79GPlH9pUwjzzOA4w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhFMuq8w9VnNPiiKI-OKea6tuaT440bKJgaRddGnAj0w&oe=6A9015E8"}, "is_concept": false, "is_test": false, "is_trial_offer_va
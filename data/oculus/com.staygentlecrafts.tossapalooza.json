80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0rw13TC_-IQ7kNvwFkyLjO&_nc_oc=AdrS-7lo0oshI1mJUkWCpBl5XdWV9ljtb-RvFSd2o9bJuNx7IfSbV4K_lDkj3bNLgIs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Iel4Rjed1a8gC20QiNdlukZ3J-GfBQ_Wt0n7fpzsfmQ&oe=6A2EA060"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6AHVTL3A-N4Q7kNvwHrgwYI&_nc_oc=AdoZRMT3rDcZOzvWOPR0MWMNhTs1YRx07BcCJUuFZrV-Bmu4807TnaGL-JQPdsjqk74&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7CwmB7Xmufg4MSNvqXJXTHCMkvoXrIGBZVX5XV-g38g&oe=6A2EB2BB"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_E5O5lr7jsQ7kNvwEh8mtS&_nc_oc=Adq9QjCopsFnnOMJaw306DPpH_UOf8Bgj946PhCI51nZHsz6JYua50Um2LHUSt1CV5g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fTXN5blynkqJhq3ZRhX58vHCI3Kr7SpG8Iubw0z7WgQ&oe=6A2EC071"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mx6outOjYYQQ7kNvwGLVDGH&_nc_oc=AdpyGgLEsJPK1iW5djpYBeByjDIgbGQ74-FWnzm06GgnYQLPC-6vApRyWJx9I7dBqrg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uLHAnYO5_4IXMrOoYrNCuEctHx2NZYk3DHQATusM_lw&oe=6A2ED2CF"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fayykKOs_2QQ7kNvwFgm8o_&_nc_oc=AdoWdHanFH8MOQiZBnEPAVtiDAQ14McZyvFEenwTtm_gqEvs0MHeTjO0rcrV92Rj3bg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bd9k9jNwAKn5NawQhCjtcyTBOJk5EShc-iJFAKIiS0g&oe=6A2EBF28"}, "is_concept": false, "is_test": false, "is_trial_offer_va
64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3cRYVTSbGIQ7kNvwExNSdb&_nc_oc=AdrI7Bwv8SVM2J028TywnHHjnrpS23JdfQgZn3exSf_C6Fu4z1gR9SOUh3gn4Vfb48Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56JDNCGBcV8u-PFt514maB5wNLbp7-0GMFo3vblozDDQ&oe=69FDF8F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Av2Y8w_fhzMQ7kNvwH3iTto&_nc_oc=AdqZI1YWRhghKKODf6xgSIGZusgAjhFk7-OtE2Y_neHqSPyvX8TNwqazlUu-E6OOOT8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CuzRc7GtxpuOfkzkJDT92R4F2Q1nDkSowLKn8pGfxOg&oe=69FDD30F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating
80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Af43ZnvYP_QQ7kNvwGaUnsy&_nc_oc=AdqrEDw5tK53iz_J1nE2qa4iOIYKyL1G38XJDFnGoPdTcJXPLRy5vyr0G19NnXBKILE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0Vn5H0Y5N1qRGL8fSrs2i2LHIRplpnaXmGtkis-acvQ&oe=6ABBB0E0"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SFcJuSqvYgQ7kNvwH2sWGk&_nc_oc=AdpImVWSos024AA7q0kiuVTBaSsgXztua3Yf_itR7gqchyjq0vpW7N2uuo9LdP2b734&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIc9USBxGcJnIE8hCJBscCaqyNuDPlBGMM-N0knJvTAAQ&oe=6ABBC33B"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ok-CNlym0TcQ7kNvwFel9Kt&_nc_oc=Adr93AczBRXoWSH6n9guW0FO-V5pe7h3X44CyuJs2JEEQx0UDO_QQ_g5oWG6PwsiQ7Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJa0ADyyAvEszLcuyMyzUiGPXUwr47BPicOmQPuymapSA&oe=6ABBD0F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SY3ak4RCjwQ7kNvwHkGvx7&_nc_oc=AdopVJJqvI9C25pEagKUiEaEKJy_Js_d3W7h62ULWZ3R1DXOd0TwFFbq_QxoYqP6E5g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwdZ2zqpWJ2LyYZzxiChE2BK9uEJuRBMLFUl486VA7XQ&oe=6ABBE34F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HH_EBo5HlhQQ7kNvwEuAwCq&_nc_oc=AdpEmv37Uc4J9P5zqeD85wDZedcep2gcVmxM1ek26zZUD8LSttNaTd4_bQuUavoqhxg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDcROPftSVMzGwai83R26IaBw5k8lqEsfGF6rxLQXTxQ&oe=6ABBCFA8"}, "is_concept": false, "is_test": false, "is_trial_offer_va
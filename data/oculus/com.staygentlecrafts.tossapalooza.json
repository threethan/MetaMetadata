80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMXoljQ3VysQ7kNvwEEiqPD&_nc_oc=AdoUbWCT8cO4ZaFgmMdcylXCCbqC-wov1COM9ZqXJ6z2__bvx2VnQcmZamlDnsEqSYI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-kc9Dh2WbesKoa1uFgbxhMBTLjPUQ-FpXhRredN-y_g&oe=6A244CA0"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgIfSo9P5Z4Q7kNvwE2SwZ1&_nc_oc=AdqSYLlw8a6u8uF1p8_zuJQ5epkprsCTsQtD6lkiA7sKFKZ1eYaCDkpFnVMGMTgZQIE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wuiYwGyxj8lJUA7HOXpBaJsevQbV7MFKY-EqR0kCLhg&oe=6A2426BB"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=270jj-KCSD8Q7kNvwHHBhF1&_nc_oc=AdoskKmfmwRVuo5s_gqdnMFuwXNhdVFsWHdlZ0jZR3CSTGX3aNngJytD2rKr4V1BzOA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7OMqkIAVRd8XZli72A5NDPAFzo0yjGsSs3gwm9TVAqw&oe=6A243471"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3om75aZABwQ7kNvwEDOosm&_nc_oc=AdrNeDaeJ1vdLul1LuL9xO4qKpjBQXX9pRxV-94pAnBRQRj183wQoxXJrH_qKHUrIPo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rFCCh8ueobq7zi3RvXJaMsCtq-n7IOLRQzTN5jF3oPw&oe=6A2446CF"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFEzPGnDrB8Q7kNvwG29JZP&_nc_oc=AdqXsf-r2kZfQ7WoHKIKHl1f18fXr4jsfrCsG94t8RO9u14cAknJcIO4AE7_rJfBz8s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IWpdWejkQ0QzExymN-rXYZyQmArKVRPoGvnzWePjg1Q&oe=6A243328"}, "is_concept": false, "is_test": false, "is_trial_offer_va
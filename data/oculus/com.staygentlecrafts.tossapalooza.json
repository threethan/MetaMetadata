80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-ALuTWfld0Q7kNvwEt7RIy&_nc_oc=Adr7HQty41gUv7mfqTj7zwY0j5nRSLWdIrYVaEwZBrOMk3fE6BlVkqIsCq41swRn824&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HoH4zShL2wyVeBgcmgpVCq28hMCxbMKzMh3HPXwBcqg&oe=69FDD8E0"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dlqw62yompEQ7kNvwGeNyFl&_nc_oc=AdovY4OnWKZssH7mxlTBLvHkqrWKmMKlcXty3CDxK2kuDmeNVtAv7n7bcf7Aq8vAXZI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61fSSVHeu2-MNIz1LQDai02Z6fzjvVVVymLB2xIFGxcg&oe=69FDEB3B"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3cRYVTSbGIQ7kNvwExNSdb&_nc_oc=AdrI7Bwv8SVM2J028TywnHHjnrpS23JdfQgZn3exSf_C6Fu4z1gR9SOUh3gn4Vfb48Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56JDNCGBcV8u-PFt514maB5wNLbp7-0GMFo3vblozDDQ&oe=69FDF8F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Av2Y8w_fhzMQ7kNvwH3iTto&_nc_oc=AdqZI1YWRhghKKODf6xgSIGZusgAjhFk7-OtE2Y_neHqSPyvX8TNwqazlUu-E6OOOT8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CuzRc7GtxpuOfkzkJDT92R4F2Q1nDkSowLKn8pGfxOg&oe=69FDD30F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYEMZ6SwDYMQ7kNvwE8rfEm&_nc_oc=AdrdavBtBaDJ2Q9_Hhxt9z1AeWGafibR7Zk4UC5W4DIE45yf_SDSS696gMGyK2vJDRE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hUlK0c7Dqey01YDgHQSvnVIX8uMrcjyYY1mw5PZvYGA&oe=69FDF7A8"}, "is_concept": false, "is_test": false, "is_trial_offer_va
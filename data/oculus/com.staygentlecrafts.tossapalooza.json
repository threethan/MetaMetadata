80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsPq8YgGT0wQ7kNvwGmXahZ&_nc_oc=Ado_33iFD8tSD1unyodDPA1Kav_m88cFg7XWT72Odo3e4D7w26-cXaKGQS-4t5i1dBI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJXgBczCmlLOpZvvEB_RHEy_JUIKL2qqMe5q5tZkZ12Q&oe=6A6750E0"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psMXMihSupoQ7kNvwGSM0kG&_nc_oc=Adpeo3ZZ7eyZhARD40p4jHZkasnGSOOqp1VOs2euohPxWMnJXfHppmzsjbtmZ3RrAHE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXe3gvSzq2K_NYI8puCVBeBjmiaZlJTZHWnlSqi55O3w&oe=6A67633B"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WebesMBztSAQ7kNvwGEabL_&_nc_oc=Adq6W1d-2m5Hq7g-NLewBcpAFDG8qLhyaoqO1TrAU0D7BSM_JcTMLNipWy0SZ74d9Sw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSt2pDeyJCeKrywu33B6-Lce-9cEmrJruDNxfj7t26Mw&oe=6A6770F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njrzuegwyMcQ7kNvwHFEGZG&_nc_oc=AdrznBb663M3U7vawOMM9Jp-RrIhQqS5Acxo160b-byKaOU8Il88yqAlN4cg4DOrIfU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFgbsWLabr0JxAPgVC56pFYb4pGwPhnJ-5ZkNFQ5v3Og&oe=6A674B0F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmgF_AG0BwEQ7kNvwEQZihs&_nc_oc=AdqNJTGk4h28xQNlJSpS9ZAnzbrNMxDzEp7o-JqoLn-ZxEW1zfhjTgdBvvIyvzuu5nM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxTyJxnDt7eyipBHL16LNe_houFmNdMRu05zoscGLodg&oe=6A676FA8"}, "is_concept": false, "is_test": false, "is_trial_offer_va
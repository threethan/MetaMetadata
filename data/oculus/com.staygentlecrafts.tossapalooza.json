80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUDjr9jUQRgQ7kNvwFFi9y0&_nc_oc=Adq-UFmBJdDhKs63XFfUhNeGC2o5Keuf7hjqIXRZo9gj6DumqcvsQ0orvIjRFv3LNEQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bAwMp9e35xRvVRG2EqduAcGcDgDzM4s-77xRM6iyUbA&oe=69E8C0E0"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSBC1A8stroQ7kNvwGM2TMG&_nc_oc=Adrate-_Znz2PZXADrAkVmCqiaQKfaOWkE96BTfSx654GxVZ4234JEl82bvy0chPWhw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01jJsBl1zaeg6zqOSzElam6WH1IsdndLPtd3LmNVBruA&oe=69E8D33B"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzNQ6kVt49cQ7kNvwG23MSm&_nc_oc=AdrqRNjkNK6cnAlBEOXIdO2ieGVrW-KGxI8Bn6JXiFm0MFPbnfWBxXKXREhvFy242Jw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OBUwWQ4igk_LBz9Zvv_02sWR2JMg8EGpfPcEXT739pA&oe=69E8E0F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjnC1Uvx-K8Q7kNvwEJL8nr&_nc_oc=AdpZ9V842lYXdAw4VRDPKnUKtkI7QXWjXLzk9C8Jtx63tVeB86q-dohTt1jT-KqdW38&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hRWrwgdce2dw1vugZZX35oCYXk1nmEa-IobCYk2tvhw&oe=69E8BB0F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdQAcjumVbkQ7kNvwHP8DcE&_nc_oc=AdpGlVgESN42I98U0k9_8ndLmODQkbmZiAhgtmjb3dVCxp0cQ1nsHaMUpxT3iFhkv68&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CsiFRaCK88y2LL7A_UQtLETZXpINEzqzpk_FtRB5_9Q&oe=69E8DFA8"}, "is_concept": false, "is_test": false, "is_trial_offer_va
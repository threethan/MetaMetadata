80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0rw13TC_-IQ7kNvwFpsUvZ&_nc_oc=Adq9KljMDQi31YbKzkmmEY5D-vWtQmWxAwvbtICTA2qXAFUlIQR8-ITccp50ZJsshVc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-d2xgPIwFH-VGY57RHmpPubDxCBfu_66ZcFJInojyIWA&oe=6A2D4EE0"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6AHVTL3A-N4Q7kNvwGlbq3l&_nc_oc=AdoW7tdsBolEh6dJ7uPksTo8LQxFwC8h3ATqbyBp8jY6E4ZRut69BkI8iValzeUTV_k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8f9mkhIVas6bdZnsEedrsKTmLXcbkSx0OtBQMGScKD5w&oe=6A2D613B"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wIItylVH6QQ7kNvwHB4ijh&_nc_oc=Adq-bm-2wE5W1v2rS1zWZDl3tWon6FV1GVX9iV5G-jacw1FAMr3L5mE3k62KquY5l4Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8R6d83fpuDhT4l89JaM_pQvA-bvBf8C2QcEQ5_gzeDMg&oe=6A2D6EF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Fy6AQDsmgYQ7kNvwGiiuJx&_nc_oc=AdrG8-lI8TM-yHs14mwWv_Kvh7Ei0k3Brgcyj06tKpP_lBb0B_4gjoYg2NO-7hh_BQM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af810Z-3A6jCYGRNXJSg_4Qizb9DBUcSUqC8RsE0sRhefQ&oe=6A2D490F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PdfC-MOKcMQ7kNvwFkGYri&_nc_oc=AdqXvU0QmnMHCcBHDG4Isf4KZ1KSMKMOL4ee7ZBcM7KdK4ETFSrhftUTSr4ApqDpVrI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eOu0j6TZyClpRCDKQX2GlIlQGBKHaWcfTnte4Nswf2A&oe=6A2D6DA8"}, "is_concept": false, "is_test": false, "is_trial_offer_va
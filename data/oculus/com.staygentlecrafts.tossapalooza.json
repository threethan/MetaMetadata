80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jF5zZmMoLvgQ7kNvwEnfGvo&_nc_oc=Adq_9-qwcVmKvtvImL5ruSjC7EmqYii4V0dvPr2zdICBvN9axISfvfxGZ5_Fb0gSgQM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5I7h-KFGC_B4xlUlQ_xUictFNeGpn3XZmFA1V492Xhbw&oe=6A047060"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nV8WU_lLMoQ7kNvwF_1wM2&_nc_oc=AdpYiXs2J58gefsir8I0PZWIfWd_XHJtKk8AkbLVItX1xmnWd5C03MzcuN9H4Hb7c_I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lZwZV6_kbYbkah-EGgaYKdeBOGOqj_43_qW8_33_BgA&oe=6A0482BB"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUWiVBzXXYMQ7kNvwGfHc4L&_nc_oc=AdpsDv8Fkkn2z91CdtXSYmtRc_iQrCCf9E7zw5L7sAc-S5bDTm3NRYHVSqLGLcQ2DXo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HBl8aQ7Q_U7mF_HQVtkLxD1O4t0HH32tmSoxDyaqw8w&oe=6A049071"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2iCTMHe4l0Q7kNvwGWFhN7&_nc_oc=AdodUKBRVddMJlK2DdiWY9ALLCED9EkBjMhyoaSzmfMBH3cWvToVYp6WNG5mF9-Dqcs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NABjie-Td2yGDdd1fX8cwM9WcjZrFl-2oqGTIs3eKBg&oe=6A046A8F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QzOvRhStnb0Q7kNvwEESM7T&_nc_oc=Ado8l56BKkDj-R5HiwnTr_FAEdvsncb8w6mA0Fr0lcj3gRMvzQfuD95wwZ-OHKVpgKo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78xj5Ep8P_PGkcLaJBpmSui5N327X5c1dXrfs4bZYjdw&oe=6A048F28"}, "is_concept": false, "is_test": false, "is_trial_offer_va
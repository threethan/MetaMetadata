80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfqQtsAxz_4Q7kNvwEoI5UH&_nc_oc=AdoWmC-os60nqUp3ePfAO5ZbGMcLdsOz8I9O7NSlPtuKiTRfD8K_v1u76r2zv4Fy67Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5udAKgerHD7QTP7dvpYt6ksfOgaSe9K3M2OS1bqUUiCw&oe=69FB35E0"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUMEGsAeHDQQ7kNvwHtSYks&_nc_oc=Adpt6ccWDZEY6L0tLFUYE9yxk5qUlyxaBfj-79a6SGfabbsJ1VAZVlVqHmWUdkQLR-8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bnFikFOOHuBLxvmSwr1EMV4ZErSh6R4r-MvLzxX-eRA&oe=69FB483B"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3cRYVTSbGIQ7kNvwFUrsAi&_nc_oc=AdqhGOdosY_AJXDII7H0Qj4pWUXn4DSUYl1GWkKop7EvjTQZNMtLh4r8-2kL9PLg29g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ru837TR-efPWAbBF7J-Y_arVu4TGU0aGkcSI6axPTiQ&oe=69FB55F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Av2Y8w_fhzMQ7kNvwEn8aoS&_nc_oc=AdqwujfM4RjCzIcApqtghkr0qeXxPMh2R1oTde0QnCx212yTtwx4tYU_AuyCBHArtTM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79JYWqJxF24M3q6MHZBMOvfGrLtidD-QCOZKui5TJ2Rg&oe=69FB300F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYEMZ6SwDYMQ7kNvwHgM_ex&_nc_oc=Adp3G0gwnhV7L-uJuiS3NMovqKTZ28Nf9bwfrX3MOVg4Cx1-U-qZ8FrePb70l-bISUI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RWHWh_kLFRhcAyLl98R-efqyXgwMunB0NnA_kVm5nLQ&oe=69FB54A8"}, "is_concept": false, "is_test": false, "is_trial_offer_va
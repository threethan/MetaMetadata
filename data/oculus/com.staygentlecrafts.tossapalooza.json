80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9nXhMGqi9AQ7kNvwEHIuQL&_nc_oc=AdrEh16bNya7ZCF4rvbqFMaUwXI__YFjrtQ2XJ5abPHX-u3DVG6KKGAaaToSm97RnUE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4moETTsS25YTi-6iNF76UogmxRqOE-Ji4Uoj_puG0FdA&oe=6A12F0E0"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pY47m7smrqgQ7kNvwEP1KOs&_nc_oc=AdrT2WZQID4LKlu8SnEpAx_RsRYKdHeOQxy04NEV7phrhhTK5IIkiKZ0FEA-UC931ZE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gCY5wt_HvSznksYGQQGzGxm_UZzov54ikjzWjLdf3Kg&oe=6A13033B"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ip77YIRwSY8Q7kNvwFTso_K&_nc_oc=AdqReF7Z8utg6BywEZ0oCdfwG2lNXSByFlBWcktcC6iefY5pRsHihM2N1n0fm1kaF04&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-BAvj4-XDplP7uNap0toiWeglTJFgatWdN2OnYeRGbw&oe=6A1310F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-1XgDqD82EQ7kNvwEYijX9&_nc_oc=AdpBH84BCd1iqkWLgmnJ2qVNHDvmH8ReNDlPgW1xusQE-flWVD2zaE1Ng21tbUYPh2I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hHyWYn2-Pqup_Kp56riWbcrHMqyjiRkWzQ95gE57RDw&oe=6A13234F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJNiPbvWBKoQ7kNvwH7Qt-W&_nc_oc=AdrtaEk7F6wejLe-fDB1t20RRhCMa8sBWsVmFrG5_xgr-jEwTko9UfVnBBbKdkYatc8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nbsBW23FVadOvTyPCvqWrfdMMgKidi6Z2ZCfv52S_0g&oe=6A130FA8"}, "is_concept": false, "is_test": false, "is_trial_offer_va
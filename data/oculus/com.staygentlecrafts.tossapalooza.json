80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUIDE4rrZewQ7kNvwGoOnnq&_nc_oc=AdpQ1UYkErCgiXzHyeYg26J2Pdvg60ZiecCWUQA-ZmDDgeuVYkPpVUEot4dJFNzL8q8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3suYpFt9RGK1DmbzrCd8m4678e7EU3aBRNNDJzkNoOQ&oe=6A732E60"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V--tJkyy76oQ7kNvwFo62uS&_nc_oc=AdpySXfMnFL-eJ_LCRLbjy4M4Bk50x1vJ6krVILctsAhYafO8qcQ8zc9_oJUd36lKa0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0DPRXI6A0tjK7YiQRWqbORMUYR_PbB3DVgQ4Gsz2TvA&oe=6A7340BB"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62F-50dhGJMQ7kNvwEGFYar&_nc_oc=AdprVwcpViEBVGXXtGj1DjzhWOMAm-Hw47LNVG80Ft7j7yIvaHolbcggsj4GjrK_Bic&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHn3s3BlIzKA0pHlcVePLp9-lD_76DHcGQ8NLokd45iw&oe=6A734E71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58JABK-RPvQQ7kNvwEn6bbT&_nc_oc=Adrkc0JIIdeLMMGKTqcb3zkcLevYSH0lQhFjXbptbJ8gUkvPZhR67fYD7cW9-5sWJtk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4jfNUISQPSMFp22vVbMassuTJyZNSXYskH_COQIGvUQ&oe=6A73288F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4OEpSmiuDkQ7kNvwGyOvMI&_nc_oc=AdrBLSN7SR5j1R4_BoKwgsnH-me6VSp-KF4yUzN6qQs8YQHqHA4RajRzGYjcNlEEZp8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXO1NM7IpefylJa0FgDC1R3stYuUXHQYjdrCk5wxQvhg&oe=6A734D28"}, "is_concept": false, "is_test": false, "is_trial_offer_va
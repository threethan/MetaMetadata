80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5audP83HgtQQ7kNvwHpYphm&_nc_oc=AdohyHHpHyPY4TcdkRSOcjKantUdEdhE99oZVuOv7II_uODos4uDbmlCK00HzSYFUwE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSRt-9BxRGJbS0e7NYrJ8UBcNOxYE6s4630oHBtVTR6g&oe=6AE5E0E0"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6luaKpjZyUQ7kNvwGGj46B&_nc_oc=AdqQTt27MWLMoJfANTLN_8rG834BkGsHYbNNakC--vtDZk19bxKgUJJJj0L3ZATIW0M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFfu4yyode7a8FZRDgI4LumG4T2SeiPYiEd71meTDLag&oe=6AE5F33B"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExLkTdTPeLIQ7kNvwFSwEna&_nc_oc=AdrJyxqFugoh-2cZgscZuHUjh1qrwnCKR5Ukm2KXiYmgoPb29kb24_9Onvoj12SuBxY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSgPo_M9Are-2S8656SVjnERK6BEE0c5BtzXyVg0V8Qg&oe=6AE600F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJvJ-fsxPK8Q7kNvwGV4-TM&_nc_oc=Adqu_F2JIT27_MuSs1j9_JwMA4n6HceQ_GtIwrGft6InAzCIEEVQgneFczeaniXSWO4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQkPDjDctICWHYLh21qUi9NrBrRAfzt1aX0C6BhseRWA&oe=6AE6134F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iv8hquvIuFYQ7kNvwHPSEsN&_nc_oc=AdoVdEfd6bN8NSPv4AjPMEDFoQj41zZolMyrHkdK36egYyAR965DJHQkouc4_z084jk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3lezAFbFThWnFpFvEXaUtBwv1dtBYqEX-B8Aj4JxkfA&oe=6AE5FFA8"}, "is_concept": false, "is_test": false, "is_trial_offer_va
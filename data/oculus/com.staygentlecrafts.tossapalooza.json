80618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8zV_AZv168Q7kNvwGAX8li&_nc_oc=Adr6k_6m0qubCSQrFsHWUb-YdFKOw7Y9mtsOguDcO5c1FztgZ5iyc6XxKrU4mAomJjc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EEhOBT7mZOoRd3E5iEx3-QiLuoLD2qbu2RzbuK4vtgA&oe=6A4509E0"}, {"file_name": "ss10.png", "id": "1145285336765633", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982529_1145285340098966_1283969571783196705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiCRI81E7xUQ7kNvwG7J018&_nc_oc=AdqaFd_k9-WeVC7dqB8_6TciMv7IigccQBNhjqeYbdPqx9akUwC_ler0KvbVKea25LM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IhE1rKJwWRaFHBtazHchHgAxTC9y4qLVDNxJ3uUmnTw&oe=6A451C3B"}, {"file_name": "ss8.png", "id": "1278615743113680", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75203619_1278615746447013_437012452601341687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AuHIkMw4xsQ7kNvwFVVgeS&_nc_oc=AdrNN52kiFoXEFZiBP_VLsBn5bh9K5pPsAnjB9FBe0GANTEOxrU6LAjtF2iRV-7WmtM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aROQalgnkoAZCAM6zC-xA401Zmvbfw_yzdQ5maQJjbQ&oe=6A4529F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss11.png", "id": "511586234538272", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75286675_511586237871605_4390422521215217075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rww_cQIQjiUQ7kNvwGboQKE&_nc_oc=AdqDxIaPcUvRIw3eFOf8ypH9DbxwW9Kk4QLeaWceQ71KzpU-G1w1zWjsGFmN0fB1GrE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zZSDe6kPU8UKY4UGmFcJW918t2XQ9bCMnfVJdT1fe-A&oe=6A45040F"}, "display_name": "Toss-a-palooza", "keywords": [], "long_description": "Experience the excitement of Mixed Reality gaming in Toss-a-palooza! Play classic games like Skeeball and Bowling without the need for controllers\u2014just use your hands with intuitive hand tracking. Engage in local multiplayer by simply passing the Quest headset between players. Keep an eye on your high scores, both overall and daily. Customize your gaming environment by moving the scoreboard and gameboards anywhere in your space ensuring your setup remains consistent each time you play. More games and options are on the horizon, so break through the walls of reality and start playing Toss-a-palooza today!", "short_description": "Play classic games like Skeeball and Bowling in Mixed Reality by just using your hands with intuitive hand tracking."}]}, "developer_name": "Stay Gentle Crafts", "developer_privacy_policy_url": "https://www.staygentlecrafts.com/appspolicy", "developer_terms_of_service_url": "https://www.staygentlecrafts.com/appsterms", "publisher_name": "Stay Gentle Crafts", "support_website_url": null, "website_url": "https://www.staygentlecrafts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8901274699924707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974755_430884359944183_8811791502844437433_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHRuSeTLDlMQ7kNvwHhZtpt&_nc_oc=Adoux-TWzsW8sJlTrmqQG5FD7SucXeZ1v6jXvDbkOTKySnqB_l54QhSB-N5RQRr9TTw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98_DZ-5kBujjyGfz-sGN0Af0DcGQ31RqRilqep_sjUBQ&oe=6A4528A8"}, "is_concept": false, "is_test": false, "is_trial_offer_va
kNvwF1GUcz&_nc_oc=AdpLyl7lK0RM_NAYzLE1X8NF7LslzUe4KLZ3fanWu6H85f69BcO_u44ocVpaXfLzpZM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-T1s0orix0jvuHiqUPY_lxUa80TlodQGkF_AMposc2g&oe=6B09AAB4"}, {"file_name": "idk6.png", "id": "1090500127021401", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604370996_1090500130354734_4563549512140256971_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytp_g3MIgKkQ7kNvwHRLmUc&_nc_oc=Adp7aXHCuXsuuKzBsVa-4xj3-mMGhAzdJaE7Q60DW9KK00cMrDTFLRjnFbIHoTv6lx0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCn7i3VUwZLxHly9b1lx1hXs8UdBxLdBgs4Hy0boGepQ&oe=6B09CEBF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Echo V67", "keywords": [], "long_description": "Project Echo V67 is the ultimate physics-based VR game where your hands are your feet! Brought to you by the creator of Terra Tag, this project is built from the ground up to give you that classic, fast-paced momentum movement you love, packed with a ton of brand-new twists.\n\nForget teleporting or using joysticks to move around. In this game, if you want to move, you have to actually push off the ground, bounce off walls, and swing from objects using your own two hands. It takes split-second timing to master, but once you get the hang of it, you'll be flying through maps like a pro.", "short_description": "This is the app published by the owner and developer of Echo Tag Reborn. Bringing a massive game developer\u2019s vision back to VR, this isn\u2019t just an update\u2014it's Project Echo V67. Experience all-new features and the original intensity. Get ready to run, jump, and tag like never before in Echo Tag Reborn V67!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-echo-v67-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "RVXGT\\AIDENVRGT|", "support_website_url": null, "website_url": "https://sit
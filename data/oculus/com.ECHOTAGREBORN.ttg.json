kNvwFcShh1&_nc_oc=AdptMgtjn-86fWO0WhbIqjCt-chQYDDHYi6WERdTvGo9VOt8krAsnQy4QA8ppaw1tW8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS06RU-q-aTf_qJ47fQhvqN6EbX4X3QFVdrEcG6YVCI-A&oe=6B031334"}, {"file_name": "idk6.png", "id": "1090500127021401", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604370996_1090500130354734_4563549512140256971_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUJvsNfIEfIQ7kNvwFUCFQG&_nc_oc=AdpZhATdMvGwH3LmZTrSfk9b_kfagIQy2VpWxKtl-v1gzRzr70yIXsT_KC5fHEwBCZo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJk1T-0-Eqyu_a_-JLiQtI_hLLFFOtQ87wwiE0wxnU4Q&oe=6B03373F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Echo V67", "keywords": [], "long_description": "Project Echo V67 is the ultimate physics-based VR game where your hands are your feet! Brought to you by the creator of Terra Tag, this project is built from the ground up to give you that classic, fast-paced momentum movement you love, packed with a ton of brand-new twists.\n\nForget teleporting or using joysticks to move around. In this game, if you want to move, you have to actually push off the ground, bounce off walls, and swing from objects using your own two hands. It takes split-second timing to master, but once you get the hang of it, you'll be flying through maps like a pro.", "short_description": "This is the app published by the owner and developer of Echo Tag Reborn. Bringing a massive game developer\u2019s vision back to VR, this isn\u2019t just an update\u2014it's Project Echo V67. Experience all-new features and the original intensity. Get ready to run, jump, and tag like never before in Echo Tag Reborn V67!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-echo-v67-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "RVXGT\\AIDENVRGT|", "support_website_url": null, "website_url": "https://sit
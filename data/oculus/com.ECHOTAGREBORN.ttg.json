=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YU0bdASCOGgQ7kNvwF5DQYE&_nc_oc=Adrw9XOpEvckqYMDGxG_iwEuyjA81EdTrviP5r-hU6FovKhX7DAP99v_SpcLrRPtMYc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRp5TfvMaqNg-vD0j2_r8CFmPpZpnBc2VmByEW7CLe2Ng&oe=6AF5CFFF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Echo V67", "keywords": [], "long_description": "Project Echo V67 is the ultimate physics-based VR game where your hands are your feet! Brought to you by the creator of Terra Tag, this project is built from the ground up to give you that classic, fast-paced momentum movement you love, packed with a ton of brand-new twists.\n\nForget teleporting or using joysticks to move around. In this game, if you want to move, you have to actually push off the ground, bounce off walls, and swing from objects using your own two hands. It takes split-second timing to master, but once you get the hang of it, you'll be flying through maps like a pro.", "short_description": "This is the app published by the owner and developer of Echo Tag Reborn. Bringing a massive game developer\u2019s vision back to VR, this isn\u2019t just an update\u2014it's Project Echo V67. Experience all-new features and the original intensity. Get ready to run, jump, and tag like never before in Echo Tag Reborn V67!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-echo-v67-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "RVXGT\\AIDENVRGT|", "support_website_url": null, "website_url": "https://sites.google.com/view/websiteforprojectechov67/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area
kNvwE6pevV&_nc_oc=Adq2am9qycY0DiL_C0CtH01zxsjE_msfH6XQq6z7NvGaAs5sLWvIFowRBjJTZwjtFLI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTs3H_2E7Q-UFqzNTZfnJVdq_jJov0CjzyDY67joex3qw&oe=6B0D9F34"}, {"file_name": "idk6.png", "id": "1090500127021401", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604370996_1090500130354734_4563549512140256971_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSACpvzpJDUQ7kNvwGbk-xf&_nc_oc=AdrBRKTUKsvSPAaoObiuz75H0blVfeAo4hOsVTQ7dHPuY21EnxTHl2TIBe0kbMgPaTE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTE4TqHzd1B1SIuIRzi8OCYmuPspU6NVnff2jHrp9BEkQ&oe=6B0DC33F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Echo V67", "keywords": [], "long_description": "Project Echo V67 is the ultimate physics-based VR game where your hands are your feet! Brought to you by the creator of Terra Tag, this project is built from the ground up to give you that classic, fast-paced momentum movement you love, packed with a ton of brand-new twists.\n\nForget teleporting or using joysticks to move around. In this game, if you want to move, you have to actually push off the ground, bounce off walls, and swing from objects using your own two hands. It takes split-second timing to master, but once you get the hang of it, you'll be flying through maps like a pro.", "short_description": "This is the app published by the owner and developer of Echo Tag Reborn. Bringing a massive game developer\u2019s vision back to VR, this isn\u2019t just an update\u2014it's Project Echo V67. Experience all-new features and the original intensity. Get ready to run, jump, and tag like never before in Echo Tag Reborn V67!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-echo-v67-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "RVXGT\\AIDENVRGT|", "support_website_url": null, "website_url": "https://sit
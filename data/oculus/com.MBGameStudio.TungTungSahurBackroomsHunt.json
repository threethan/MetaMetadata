BQ&oe=69B9522E"}, {"file_name": "85744240-3b86-4162-9aff-da41fd9afae622.png", "id": "1260121868854702", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825054_1260121872188035_1371633518935519360_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wi2MVPYvILYQ7kNvwEj5YEu&_nc_oc=AdncjphnNXAL0BxxdEkG5YlUHlTRbYNAnyZmvLNKWbNIijoHkewRa3SuCjneiikz67Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxxyokpu8fOXKnl_PVXPSiK-GVBZfCzM2kthamBH2dzpA&oe=69B948E7"}, {"file_name": "85744240-3b86-4162-9aff-da41fd9afae6.png", "id": "1452075382906468", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303280_1452075386239801_3976805739354483577_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMAJQwRF07kQ7kNvwGTkb5e&_nc_oc=Adm9rqmNjK7EDLi4ImHA4zjynFl4s5Olbu7Vg6DZF8EcIVbWxW2sa2bcPk2azcZMZEo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxH0g0e5pKXV-PYBlRVThWZpcRYeyDdblmXj2l9RUzfEQ&oe=69B94A3B"}, {"file_name": "1f-da41fd9afae6222211111111.png", "id": "1238999984094264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307931_1238999987427597_6928336763165816346_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Hyil4OhCx4Q7kNvwFoUKN9&_nc_oc=Admk25ijrIbjdnYHXhW7f-GqwmOMRlu4ERx0HeNGNIrAJI2DxklsEgpTwYYufc17L_U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxw1ogLGt8uDldqDwTdm_tGUlB0qdI8M-UbX8t5wAgoNA&oe=69B93AC5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tung Tung Sahur: Backrooms Hunt", "keywords": ["Tralalero", "tung", "sahur", "horror", "ape"], "long_description": "Welcome to Tung Tung Sahur: Backrooms Hunt, a stealth-horror survival game dripping with brainrot chaos, inspired by the viral nightmares and its many cursed cousins.\n\nYou and your animal company are dropped into the surreal depths of the backrooms, a sprawling, dimly lit maze crawling with strange objectives to collect \u2014 and stranger entities to avoid. Chief among them: Tung Sahur, the terrifying Scary Baboon known for his echoing war cry: \"TUNG, TUNG, TUNG, SAHUR\".\n\nHear that? Run. Or hide. But never stand still.\nBecause when the lethal ape known as Tung Sahur hunts, he never stops.\n\nEmbrace the absurd. Scream. Fail beautifully.\nTralalero tralala, welcome to the hunt.", "short_description": "Tung Tung Sahur: Backrooms Hunt is a chaotic horror experience where you and your animal company sneak through the backrooms to collect mysterious objectives \u2014 but beware the lethal ape known as Tung Tung Tung Sahur. If you hear \"Tung Tung Tung Sahur\", it\u2019s already too late. This is Brainrot survival at its peak. Tralalero tralala. Can you survive?"}]}, "developer_name": "MB Game Studio", "developer_privacy_policy_url": "https://mbgamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MB Game Studio", "support_website_url": null, "website_url": "https://MbGameStudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24711423311852646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830776_722776697279593_531946305537617891_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ur-wmVVCPH8Q7kNvwF_Lk2l&_nc_oc=AdkuYqbLiF6pnKU0zJE7crWT7h_4iayHn5_gduf1qzuLlnx-T1m4AKE0IrPGXIn8550&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com
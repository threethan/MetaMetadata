365_860006373333139637_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvcRmciE0nwQ7kNvwHHZJH7&_nc_oc=AdrMEJ_CN_SwavT4jOAZGnNEk0ca99MrUkT2p6rtqOd4ewuNGYGdg-4h3ghWpYDhGBY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JTAMxDFXAZJFgXEcwSfHazNkeAlaF28_-YC1xcAv3Tw&oe=6A0C60AE"}, {"file_name": "85744240-3b86-4162-9aff-da41fd9afae622.png", "id": "1260121868854702", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825054_1260121872188035_1371633518935519360_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHkwjCIen0wQ7kNvwFY6nhn&_nc_oc=AdocZja_Znmw5_ZEu2k37jk9A9hjdz_7XmH45MgaOqX3r7a7Vn0FnjRy-QvevI7ebsE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TmY41HTUuKLEqMqReVJYVDnYrJgM0SnhGzL36J2kPtw&oe=6A0C5767"}, {"file_name": "85744240-3b86-4162-9aff-da41fd9afae6.png", "id": "1452075382906468", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499303280_1452075386239801_3976805739354483577_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZ4bQqKiMGgQ7kNvwGjyFnp&_nc_oc=Adqd0aOo3lskcmp3cyfONXglFdMYznkZ5U2eaykMOSvP5wQqu2RHv-2i5Xq0Xwvhtrg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Gre_cht3vRDW4FNUmu80DNFyAxlV3PtiMyMPuEzh51w&oe=6A0C58BB"}, {"file_name": "1f-da41fd9afae6222211111111.png", "id": "1238999984094264", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499307931_1238999987427597_6928336763165816346_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbeesS2rnsYQ7kNvwHIvdlk&_nc_oc=AdrBdYAxolhKE_G63F1AZqCwrj-Yu_h76cjp_fuNgwVdzY3DG3AxHLDh6VPJfKnkpqg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xjyvOhNQ0cgPqLANk1w4MPf2gCIsyqgtSfgGxoTVtyQ&oe=6A0C8185"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tung Tung Sahur: Backrooms Hunt", "keywords": ["Tralalero", "tung", "sahur", "horror", "ape"], "long_description": "Welcome to Tung Tung Sahur: Backrooms Hunt, a stealth-horror survival game dripping with brainrot chaos, inspired by the viral nightmares and its many cursed cousins.\n\nYou and your animal company are dropped into the surreal depths of the backrooms, a sprawling, dimly lit maze crawling with strange objectives to collect \u2014 and stranger entities to avoid. Chief among them: Tung Sahur, the terrifying Scary Baboon known for his echoing war cry: \"TUNG, TUNG, TUNG, SAHUR\".\n\nHear that? Run. Or hide. But never stand still.\nBecause when the lethal ape known as Tung Sahur hunts, he never stops.\n\nEmbrace the absurd. Scream. Fail beautifully.\nTralalero tralala, welcome to the hunt.", "short_description": "Tung Tung Sahur: Backrooms Hunt is a chaotic horror experience where you and your animal company sneak through the backrooms to collect mysterious objectives \u2014 but beware the lethal ape known as Tung Tung Tung Sahur. If you hear \"Tung Tung Tung Sahur\", it\u2019s already too late. This is Brainrot survival at its peak. Tralalero tralala. Can you survive?"}]}, "developer_name": "MB Game Studio", "developer_privacy_policy_url": "https://mbgamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MB Game Studio", "support_website_url": null, "website_url": "https://MbGameStudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24711423311852646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lg
b86-4162-9aff-da41fd9afae6.png", "id": "1452075382906468", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499303280_1452075386239801_3976805739354483577_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ij4Z1YEanDMQ7kNvwGSwzbx&_nc_oc=Adr3v1zlrD-DTuzvNkW6Org_kEhvnB6MWhJHfXexrCVsZtKRxHGIc9yhdlu1i169XLo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3kRuYLhD-89tDNwey2OLdeB7OaATg9xR53CaQlua4jg&oe=6AFF24FB"}, {"file_name": "1f-da41fd9afae6222211111111.png", "id": "1238999984094264", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499307931_1238999987427597_6928336763165816346_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PLx1WguJrEQ7kNvwFHyg8e&_nc_oc=Adoby_vI1dcl74pPKlbOm7aim8jv3bVtMEESG-ZDEjQdP2q-4e02l1TqGYr_Ad6aWkg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSry4FrOQAQci2CAeqxpt9w1_52KcclBKIewVF7rJOs0w&oe=6AFF1585"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tung Tung Sahur: Backrooms Hunt", "keywords": ["Tralalero", "tung", "sahur", "horror", "ape"], "long_description": "Welcome to Tung Tung Sahur: Backrooms Hunt, a stealth-horror survival game dripping with brainrot chaos, inspired by the viral nightmares and its many cursed cousins.\n\nYou and your animal company are dropped into the surreal depths of the backrooms, a sprawling, dimly lit maze crawling with strange objectives to collect \u2014 and stranger entities to avoid. Chief among them: Tung Sahur, the terrifying Scary Baboon known for his echoing war cry: \"TUNG, TUNG, TUNG, SAHUR\".\n\nHear that? Run. Or hide. But never stand still.\nBecause when the lethal ape known as Tung Sahur hunts, he never stops.\n\nEmbrace the absurd. Scream. Fail beautifully.\nTralalero tralala, welcome to the hunt.", "short_description": "Tung Tung Sahur: Backrooms Hunt is a chaotic horror experience where you and your animal company sneak through the backrooms to collect mysterious objectives \u2014 but beware the lethal ape known as Tung Tung Tung Sahur. If you hear \"Tung Tung Tung Sahur\", it\u2019s already too late. This is Brainrot survival at its peak. Tralalero tralala. Can you survive?"}]}, "developer_name": "MB Game Studio", "developer_privacy_policy_url": "https://mbgamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MB Game Studio", "support_website_url": null, "website_url": "https://MbGameStudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24711423311852646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491830776_722776697279593_531946305537617891_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yr8QXtCmb08Q7kNvwGzrV3d&_nc_oc=AdrZHC-IOeV10dnQhGLwe2iSIsA6PhsSyg11l-NdVJ4Z8f_cUahCom6rbWZAl14Bgco&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe73RrXJ-L7mHyFEnyEjVHBpHfTd_-q_s1K1vXa_zDoQ&oe=6AFF07AD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tung Tung Sahur: Backrooms Hunt", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Survival", "id": "64435
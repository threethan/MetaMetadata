fd9afae62222.png", "id": "716933608008032", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507829689_716933611341365_860006373333139637_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AWmNrhpQVoQ7kNvwHmE-Cu&_nc_oc=AdqqPztMyjnO-mrr-X5fXjGleqFIs1hp1ViAYbdVWIHJm4bxLemVlMZTQpUKEudlhok&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_UzgLwjwQOvMIfMhmFJ163knQ8gIY1Vx8Gd2c-zZHhw&oe=6A67582E"}, {"file_name": "85744240-3b86-4162-9aff-da41fd9afae622.png", "id": "1260121868854702", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825054_1260121872188035_1371633518935519360_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxFpl8qiXeAQ7kNvwF7VrE1&_nc_oc=AdooIOYejOJCEYakwzMikRJt5nfjdOGIsR9uLzkFUc8cnOPbwQvUH57WMuOP482nab0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDv1UcJ0ko-DP6D6iC2CrLDOK5vJwl0NOayCupYnmLGuA&oe=6A674EE7"}, {"file_name": "85744240-3b86-4162-9aff-da41fd9afae6.png", "id": "1452075382906468", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303280_1452075386239801_3976805739354483577_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWqmD-Twl3UQ7kNvwEMpoeC&_nc_oc=Adq6lJxOrxIxc6Cmx6UL4QGdN0p7E70BvUChitHnFg_j54cVZYSQH0H1FEBupLW0twc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApUgI0aKYmq1VzfWZ46jxBUm8knMM3AGsxx-WRQB2xrA&oe=6A67503B"}, {"file_name": "1f-da41fd9afae6222211111111.png", "id": "1238999984094264", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307931_1238999987427597_6928336763165816346_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ooF4NXguc0AQ7kNvwHT-5qk&_nc_oc=Ado5SR9JOJVKMlBiv9jpxYtR8P-5kubfALxzwNmPp2h2vJC1OmOSrfCQmDvWmx2hu8Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZAXa8r_Kv6LEtOxsudEKSzvTk_Nd7PwpyZOEiXjqCDA&oe=6A677905"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tung Tung Sahur: Backrooms Hunt", "keywords": ["Tralalero", "tung", "sahur", "horror", "ape"], "long_description": "Welcome to Tung Tung Sahur: Backrooms Hunt, a stealth-horror survival game dripping with brainrot chaos, inspired by the viral nightmares and its many cursed cousins.\n\nYou and your animal company are dropped into the surreal depths of the backrooms, a sprawling, dimly lit maze crawling with strange objectives to collect \u2014 and stranger entities to avoid. Chief among them: Tung Sahur, the terrifying Scary Baboon known for his echoing war cry: \"TUNG, TUNG, TUNG, SAHUR\".\n\nHear that? Run. Or hide. But never stand still.\nBecause when the lethal ape known as Tung Sahur hunts, he never stops.\n\nEmbrace the absurd. Scream. Fail beautifully.\nTralalero tralala, welcome to the hunt.", "short_description": "Tung Tung Sahur: Backrooms Hunt is a chaotic horror experience where you and your animal company sneak through the backrooms to collect mysterious objectives \u2014 but beware the lethal ape known as Tung Tung Tung Sahur. If you hear \"Tung Tung Tung Sahur\", it\u2019s already too late. This is Brainrot survival at its peak. Tralalero tralala. Can you survive?"}]}, "developer_name": "MB Game Studio", "developer_privacy_policy_url": "https://mbgamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MB Game Studio", "support_website_url": null, "website_url": "https://MbGameStudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_mod
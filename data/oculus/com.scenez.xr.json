t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBLPdV_50rXMFQvc_Atgn_4Ausu_OH0cHAvrgWAR1GQA&oe=6ABA7B45"}, {"file_name": "MetaScreenShot ScenezXR Mica1.png", "id": "1493385884904887", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974469_1493385888238220_5074879560501904780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyM0YAdt-7AQ7kNvwHNM9dV&_nc_oc=AdrA104N7WsfQoofdVcXZ6liumanVpyKzVpjYBMkyLBkNUioPkj3Nlx0WX7njQPJ3Y0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJA23rrchEmug83t1a2ypaJodXKdcCG3-t6zO0J2I0uBA&oe=6ABA65C6"}, {"file_name": "MetaScreenShot ScenezXR JM.png", "id": "1151098436114581", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974886_1151098439447914_4249611160335607262_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPjgOdcksA0Q7kNvwFFVeRA&_nc_oc=AdoGOMRc0-1rQ0FfX_KhH1A_ta4hspbu_zXbWm28DXW-LUJ44XbHq5jBRwYTn34wyCw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgBto0aJsIeMJ_OLE_lZAFPOR6wyGq_YJh2oAZTqRtFg&oe=6ABA7441"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverimage ScenezXR.png", "id": "1147384969808452", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974802_1147384973141785_3689711553277891187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGUSscafYGkQ7kNvwFwoRsx&_nc_oc=Ado9_AqHQ1qLWJfj-ozZrVtrwvzLwhGyTsH5GRJ8j3L0BqTrwWlBYkBjFmfSNU7XETs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIopvVfsrY3tqmY3AoCLNnX5it8tmfDoq6thaxwfXrc9A&oe=6ABA7472"}, "display_name": "Scenez XR", "keywords": ["music", "entertainment", "comedy", "4d"], "long_description": "Step into a new dimension of entertainment with Scenez XR, exclusively on Meta Quest 3. Dive into an unparalleled 4D volumetric experience. Witness breathtaking live performances from your favorite musicians, captured in stunning volumetric detail, as they come alive around you. With the power of XR, you can place the artist right in your home, turning your living space i
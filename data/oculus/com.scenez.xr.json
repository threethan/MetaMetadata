t-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtETeW2qrvbPFvGx7OyDno8AudXvlJJ7fDih5E9NB8wA&oe=6AE359C5"}, {"file_name": "MetaScreenShot ScenezXR Mica1.png", "id": "1493385884904887", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974469_1493385888238220_5074879560501904780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YcfgbrO0xAcQ7kNvwHdYlky&_nc_oc=AdqqqTdiC7p-rOQvGW8SkTjAVSALU3L7mkGg-O3-VaeacMz8a9NJhDPMWpitOVhpDnw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-jyLLJtgpSlshIr2mJdZ8D_NBp_ppWqgbZwwEfpZPPw&oe=6AE34446"}, {"file_name": "MetaScreenShot ScenezXR JM.png", "id": "1151098436114581", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974886_1151098439447914_4249611160335607262_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nnCDhIaMREQ7kNvwGRX-F2&_nc_oc=AdqEEGI1v5Rhb5cwgcsWarb229J5pGjLcZ93B7e95Fv4PPnralhHAqJm8yxOtkQxrig&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnzg9U2Hb-GvKdKsAXUa1a217f5M94P3iJ0YDT0Mj3gA&oe=6AE352C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverimage ScenezXR.png", "id": "1147384969808452", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974802_1147384973141785_3689711553277891187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8u0Af5AkVlcQ7kNvwH1Xts1&_nc_oc=AdrzVrIKW2RxnhG0F43ou2KU2UmHYp1XAfqSPSaJe9bNNfgHCZXKlWTqHC5ZoGKfPvg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOskRv1Xp2RCuyym0i9Bmww1Qy11turN3nFHoMhZ8pAQg&oe=6AE352F2"}, "display_name": "Scenez XR", "keywords": ["music", "entertainment", "comedy", "4d"], "long_description": "Step into a new dimension of entertainment with Scenez XR, exclusively on Meta Quest 3. Dive into an unparalleled 4D volumetric experience. Witness breathtaking live performances from your favorite musicians, captured in stunning volumetric detail, as they come alive around you. With the power of XR, you can place the artist right in your home, turning your living space i
t-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAlAw_3TCy-QZnTdpN6kpWRQThYlqryx2YBsND9hWNvw&oe=6ADCC245"}, {"file_name": "MetaScreenShot ScenezXR Mica1.png", "id": "1493385884904887", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974469_1493385888238220_5074879560501904780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWir3e6FNAQQ7kNvwHQXAlu&_nc_oc=AdoBrrppU8fGxFRHyKoNvIhZFx74xvVzXJcrRjvY6GoKGqhV7uFQ6yUqjKX-BvLfX00&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtETub9L2snZnc2z9g1kG1kmMnntwjuJ2pI7eaLSCKtg&oe=6ADCACC6"}, {"file_name": "MetaScreenShot ScenezXR JM.png", "id": "1151098436114581", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974886_1151098439447914_4249611160335607262_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8WQOYKG1tAQ7kNvwHpCqJy&_nc_oc=AdqOaQZsNAlLVoCpJN2_49Jg32xh4wLta4MCpQTJYLxJwu-DzW6T1oM9SO7x6M3MSMQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuvbS11FQPgRLVBxMi-CZP5wpsKfsScd6Xi7Cguh7unA&oe=6ADCBB41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverimage ScenezXR.png", "id": "1147384969808452", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974802_1147384973141785_3689711553277891187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3Lk_ycMZC8Q7kNvwFMcGMv&_nc_oc=Ado2pRsnVpsFDrECNTj96gGy8l0ovn9YRTiHPQhGtAATVkWSkJnJT05sU5SzDRjp3MI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_RZwXZnzVrzjwuOwy6_vlgfMUTW5De4BT0MEyjjW_gA&oe=6ADCBB72"}, "display_name": "Scenez XR", "keywords": ["music", "entertainment", "comedy", "4d"], "long_description": "Step into a new dimension of entertainment with Scenez XR, exclusively on Meta Quest 3. Dive into an unparalleled 4D volumetric experience. Witness breathtaking live performances from your favorite musicians, captured in stunning volumetric detail, as they come alive around you. With the power of XR, you can place the artist right in your home, turning your living space i
t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzqQg_vjUwodMTQP5hw07MpoZWA2b3mgQFbqmrKhBJog&oe=6AF47D45"}, {"file_name": "MetaScreenShot ScenezXR Mica1.png", "id": "1493385884904887", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_1493385888238220_5074879560501904780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPpQP6vKnQcQ7kNvwGqZRoo&_nc_oc=AdrFEn514-reYqrgfbZ2d_RcdGkqdg9le5R87F8PsRhlojJPLfxNHNuSP3DUogo0N84&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ21xIrOhJNEzB_DV8pz3Jx1_ubZ3gD6DlYZoHCeg_MdA&oe=6AF4A006"}, {"file_name": "MetaScreenShot ScenezXR JM.png", "id": "1151098436114581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974886_1151098439447914_4249611160335607262_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BJcwWSi5vcQ7kNvwEbbUfl&_nc_oc=Adrg2myR_sxXwJBnmQoAolnkBDlbJPA5df7fMCPVTB2ty-53oYeirD8P1q4rJwzpvRs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnm-TUOdJ8S5EbtyjoP_yXB0QOIzBHLVntKJ93tYSSBw&oe=6AF47641"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverimage ScenezXR.png", "id": "1147384969808452", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974802_1147384973141785_3689711553277891187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeylENbhoyEQ7kNvwGG57mZ&_nc_oc=AdqJM4mwrB9_AFIdrgq4s_bUlvkOoQfYa1PegQGWREX5BDWeVNgrwF9vHNpKKJnFpug&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXGzLVQTVmW-JUjzT6Y4AwdNiJS5L4f8YiX9DK3lJP6g&oe=6AF47672"}, "display_name": "Scenez XR", "keywords": ["music", "entertainment", "comedy", "4d"], "long_description": "Step into a new dimension of entertainment with Scenez XR, exclusively on Meta Quest 3. Dive into an unparalleled 4D volumetric experience. Witness breathtaking live performances from your favorite musicians, captured in stunning volumetric detail, as they come alive around you. With the power of XR, you can place the artist right in your home, turning your living space i
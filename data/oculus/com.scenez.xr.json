t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM73AcYaXciRlVO0k2-BjHurbyhRNiygtHfMNBWISEvqQ&oe=6AD23645"}, {"file_name": "MetaScreenShot ScenezXR Mica1.png", "id": "1493385884904887", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974469_1493385888238220_5074879560501904780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPKW5C52_OoQ7kNvwFdmv1g&_nc_oc=AdpMbjSn78SIPx7SNj32xBDAbWojDVkurtURZk1ca4XpX1I854yf5Qhab1j_6-gYubw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdqYsY4ck9MZB74z7vu5y7qeDFkAF7HIcK7yHM_zonQg&oe=6AD25906"}, {"file_name": "MetaScreenShot ScenezXR JM.png", "id": "1151098436114581", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974886_1151098439447914_4249611160335607262_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRDi4FpJ8KcQ7kNvwH3sGM-&_nc_oc=AdoYX3z_fHGU4hLXe8fhPUwA37ktxQ7-mL2St_GuBzC_j8merW9RkOrErJZ9XwOI-tc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPU28UiY265RG52EukfRFEHW1YJtrXCW-Sd3oASwuYg9w&oe=6AD22F41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverimage ScenezXR.png", "id": "1147384969808452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974802_1147384973141785_3689711553277891187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcUeJn0yFjEQ7kNvwGD4Xis&_nc_oc=AdrptTJwy6hUVh-WZKzFOhQT6veaTBgnMBJf7olLkS6o4CbC7hkVpj2FR1jYJiRkZzQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPO66EqdAL5Bb7xXqw8Ozr6b7RjzCT58mo7W7adHBU18A&oe=6AD22F72"}, "display_name": "Scenez XR", "keywords": ["music", "entertainment", "comedy", "4d"], "long_description": "Step into a new dimension of entertainment with Scenez XR, exclusively on Meta Quest 3. Dive into an unparalleled 4D volumetric experience. Witness breathtaking live performances from your favorite musicians, captured in stunning volumetric detail, as they come alive around you. With the power of XR, you can place the artist right in your home, turning your living space i
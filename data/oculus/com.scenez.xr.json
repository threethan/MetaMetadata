t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-5slB7sjB5oZvAunSJQ94OCGLzXzgDGeYZJzuiudg8w&oe=6AEF3745"}, {"file_name": "MetaScreenShot ScenezXR Mica1.png", "id": "1493385884904887", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_1493385888238220_5074879560501904780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmeoqcmF_70Q7kNvwFSUprB&_nc_oc=AdqVZs8sAeIQn5hQeQpzb71muy0-FqRP-fDKLA1oGdnhdmCyo_OyWyalv0MqhPp0f78&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZIfMzki2xroGQAqqbJbmbU2OX38SYtc0LIi-so_1unA&oe=6AEF5A06"}, {"file_name": "MetaScreenShot ScenezXR JM.png", "id": "1151098436114581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974886_1151098439447914_4249611160335607262_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0b_q4t1FVIQ7kNvwHg2pZx&_nc_oc=AdrsnxIZUvRSroOrD8mwP-CXIEjvPVpT2B7jvjwBjn_-tF-rTeVvfhprlMdcHgmvKnA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPQUWa7sNGzuVAItoVX404uoWQhKGECzw_TPOAH-AW0w&oe=6AEF6881"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverimage ScenezXR.png", "id": "1147384969808452", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974802_1147384973141785_3689711553277891187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPorKAI5wZwQ7kNvwGByRYv&_nc_oc=Adqi2EKjjUrVwL6iX9j0JMrnEzTRkOhNAd79jpJqc6a20Pn3dJie0Bbo-W05Jy42nKk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWSJN6jc_VRfPbCh616-mKpUfD6h3nggWODRL0f6OksQ&oe=6AEF68B2"}, "display_name": "Scenez XR", "keywords": ["music", "entertainment", "comedy", "4d"], "long_description": "Step into a new dimension of entertainment with Scenez XR, exclusively on Meta Quest 3. Dive into an unparalleled 4D volumetric experience. Witness breathtaking live performances from your favorite musicians, captured in stunning volumetric detail, as they come alive around you. With the power of XR, you can place the artist right in your home, turning your living space i
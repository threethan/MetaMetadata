t-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjFxPUJNXb28i1ItqbvS6u0kqST2y4FsCH6-PkPiqwBw&oe=6ACA4D45"}, {"file_name": "MetaScreenShot ScenezXR Mica1.png", "id": "1493385884904887", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_1493385888238220_5074879560501904780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crWXN5LQZ4sQ7kNvwHkJkdJ&_nc_oc=AdqxxHGfHHeHQjwTbFrd0QBb5TIKQBTdjAogxnHT4o4gCBZuq1eZr5sAi3CvMCgXc2g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7jHuj2x7YvkNXUChJViH-qdN3Uhnlgt0yu-nSuvSIhA&oe=6ACA7006"}, {"file_name": "MetaScreenShot ScenezXR JM.png", "id": "1151098436114581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974886_1151098439447914_4249611160335607262_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRsRIZsbfqAQ7kNvwHFlkMf&_nc_oc=AdoEaGP_rCxliyMh3_C6UJW3bd2rJdlR2UUm8_M1dyBiH-PF9ZV88TsxatDyvTc_srM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUsHkiSB5OK8MKLPxcM-N6y-ptyn0QwoNsMkCVdIHPTA&oe=6ACA4641"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverimage ScenezXR.png", "id": "1147384969808452", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974802_1147384973141785_3689711553277891187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBfrsMrMek8Q7kNvwFssQzW&_nc_oc=AdoU4ocWiT-Dj3CrdKlY7_rlb56RIhreMGe88-lcsS47zCxoThUG8oup-ihCsrWxeMU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSCAHtGXVw7TDNGqpVjWnZL3wQJc9a8K2M2UDC93YAXg&oe=6ACA4672"}, "display_name": "Scenez XR", "keywords": ["music", "entertainment", "comedy", "4d"], "long_description": "Step into a new dimension of entertainment with Scenez XR, exclusively on Meta Quest 3. Dive into an unparalleled 4D volumetric experience. Witness breathtaking live performances from your favorite musicians, captured in stunning volumetric detail, as they come alive around you. With the power of XR, you can place the artist right in your home, turning your living space i
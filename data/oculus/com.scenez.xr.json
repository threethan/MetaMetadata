t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOm6-JLFpir8IyQjAePsvep3ZlcpRu3sHpAZ50wPwi-qQ&oe=6AC112C5"}, {"file_name": "MetaScreenShot ScenezXR Mica1.png", "id": "1493385884904887", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_1493385888238220_5074879560501904780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-8gjmvfs_MQ7kNvwFZCuL2&_nc_oc=AdqtOutIJsRFIg8bbDEkul9b9V7v2FVy7AjcOhMGoe8PZbEZ5mxiQZnqEJSwUtO1R2g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlUHbP-A9gpQwAd1nGyo3QVNBESRAatCCi6l4GrnPH2w&oe=6AC13586"}, {"file_name": "MetaScreenShot ScenezXR JM.png", "id": "1151098436114581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974886_1151098439447914_4249611160335607262_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LoAhjRr1NKgQ7kNvwGjne7j&_nc_oc=AdqNUZHuSCUErK_7XSASwacYt8aSRBZeP4YPppn1awccpLneeEmtVTu2I01v-uOe_fI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7lrmy-d1sMeR80PEO-9mDx8hF5gJYZxBRIx70-xknyA&oe=6AC10BC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverimage ScenezXR.png", "id": "1147384969808452", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974802_1147384973141785_3689711553277891187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywU9nvjS9zEQ7kNvwFmpaZ-&_nc_oc=AdpggP59yalpJpTcOGA9pqXzhb2HtiIJcgBWK441Wg2Fdh_KwshxPM-LwT7QhNnJH-A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOb_66WxoJaNfOZDHqpWPWk86AqT7McNHwCyTlpcBVfFA&oe=6AC10BF2"}, "display_name": "Scenez XR", "keywords": ["music", "entertainment", "comedy", "4d"], "long_description": "Step into a new dimension of entertainment with Scenez XR, exclusively on Meta Quest 3. Dive into an unparalleled 4D volumetric experience. Witness breathtaking live performances from your favorite musicians, captured in stunning volumetric detail, as they come alive around you. With the power of XR, you can place the artist right in your home, turning your living space i
t-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROX3f5_KmXyjcEdiR_1SwZKsyna5vn9qfNinO3MrWZqA&oe=6AF32BC5"}, {"file_name": "MetaScreenShot ScenezXR Mica1.png", "id": "1493385884904887", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974469_1493385888238220_5074879560501904780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPpQP6vKnQcQ7kNvwHPPVnf&_nc_oc=AdpdTTIeVXLBkWEirxND1FSWIqEC-A3b8AJqo5TPCySvU5nYpszM-APEkHkTCXWA7bw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRczT1MWOHvq2462-y1445Whwd9gsE4D1yJE8QrKFD0qA&oe=6AF34E86"}, {"file_name": "MetaScreenShot ScenezXR JM.png", "id": "1151098436114581", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974886_1151098439447914_4249611160335607262_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BJcwWSi5vcQ7kNvwGwiIep&_nc_oc=AdpFJmSQeR-sFS5c1UhUNOumV0jEwcbkCJ4BWKYKjx0tArZxDZQCYne5LvN1MiLltD8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfdhDn-dXLdcHoarX7hKure4pv6hcR1DLq-uYXfjPDqg&oe=6AF324C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverimage ScenezXR.png", "id": "1147384969808452", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974802_1147384973141785_3689711553277891187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Zxa-pIN_C4Q7kNvwHcWkED&_nc_oc=AdpPVCv8EbCqMY6nkqDuiMZqoX1v4gv7H7GXZnjU5pYhHSiP6YF9rZoSr_0zeVqAlQM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqXnYQ08ycTeANnE436IaCQM5z92O9-bLR3BZZr87igA&oe=6AF324F2"}, "display_name": "Scenez XR", "keywords": ["music", "entertainment", "comedy", "4d"], "long_description": "Step into a new dimension of entertainment with Scenez XR, exclusively on Meta Quest 3. Dive into an unparalleled 4D volumetric experience. Witness breathtaking live performances from your favorite musicians, captured in stunning volumetric detail, as they come alive around you. With the power of XR, you can place the artist right in your home, turning your living space i
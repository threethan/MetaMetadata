t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEnXA5z7w2qY85fMDdSIoAT_avEGyvwgW7igZX5XdooA&oe=6AB929C5"}, {"file_name": "MetaScreenShot ScenezXR Mica1.png", "id": "1493385884904887", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_1493385888238220_5074879560501904780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyM0YAdt-7AQ7kNvwEqs8BP&_nc_oc=AdpgrlEi3PBpb_tjrQ0JiD9L8jftv2a2kk3Xpzpx2wT4ydH3UfNqZLfcrZ3msuYuIOE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0bsueHXDRI0qQ6Zf22RRFlMihKVmdjX_LfKkfpm79Qg&oe=6AB91446"}, {"file_name": "MetaScreenShot ScenezXR JM.png", "id": "1151098436114581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974886_1151098439447914_4249611160335607262_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUyzgfcV4uMQ7kNvwGGuIsC&_nc_oc=AdrYXamnwxMgQA67v4PGKNJLfkMn4NF-sV79jXo0DFoygu-EfGKknSmRmZzjnotz_Jc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlaEDk0pXvgtXBGvh-6c8whO1B8XE-XUfXOHrxML3DUg&oe=6AB922C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverimage ScenezXR.png", "id": "1147384969808452", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974802_1147384973141785_3689711553277891187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGUSscafYGkQ7kNvwFxbqf3&_nc_oc=Ado_kyeiVn1pixjURd_7rjvgyPjjhsjDK3Bmi6z1AOx9u6ocrA3cADjrolPPKra70gM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIheO2p3q1Fz_v8ttU4MvrCWVSumAAsXD68SxZOOqkNrQ&oe=6AB922F2"}, "display_name": "Scenez XR", "keywords": ["music", "entertainment", "comedy", "4d"], "long_description": "Step into a new dimension of entertainment with Scenez XR, exclusively on Meta Quest 3. Dive into an unparalleled 4D volumetric experience. Witness breathtaking live performances from your favorite musicians, captured in stunning volumetric detail, as they come alive around you. With the power of XR, you can place the artist right in your home, turning your living space i
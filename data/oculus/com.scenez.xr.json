 ScenezXR DU1.png", "id": "860114692631071", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974628_860114695964404_8521826312028011421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKB2-vHsC_4Q7kNvwFX0WJy&_nc_oc=AdmK5HdGhePBSqW3n0NV2oxCxyfxW4dc_nyOX5QnpcjvwNY9-D56NkxK2eZhI8961lU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuWz30GRs8HNbOV0b4wzmNKEL6cR-2lYwblLUhF60LyGQ&oe=69987145"}, {"file_name": "MetaScreenShot ScenezXR Mica1.png", "id": "1493385884904887", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974469_1493385888238220_5074879560501904780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYNnSIGC1u8Q7kNvwHY8_td&_nc_oc=Adlhg2DMotyk3KOnBMK9pZePDSsUjNEyOFosXd34RQ-urunejf2wM1Nge8xyRGWDytk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aft1h9RLGJKd84xjnurxlvVEY5BNXyOhLIeC_WHjiDnx2g&oe=69985BC6"}, {"file_name": "MetaScreenShot ScenezXR JM.png", "id": "1151098436114581", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974886_1151098439447914_4249611160335607262_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEjmZFp3qe8Q7kNvwGVIl_4&_nc_oc=AdklRTIjE2T_xOYR8okvhXvuG3xODT_loIQAVKumcE-hSOPIgTsGrGymlLUY2ltkDP8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvVxPJKvNtICO0fr1-Qwk497zdCkVSGoysNsqd7hrgFpg&oe=69986A41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverimage ScenezXR.png", "id": "1147384969808452", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974802_1147384973141785_3689711553277891187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtK-8GPcei4Q7kNvwH3xPon&_nc_oc=Adl-5a2aQ6KM4URhuSqWSa9_c2ap00BcTllhT6-do-YyfF32zsInnODq85OVtnTKsZQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfurXTJ7eQH5Mg0VOjTTowddc3EvUkrSb9JaKYKgzBdRHg&oe=69986A72"}, "display_name": "Scenez XR", "keywords": ["music", "entertainment", "comedy", "4d"], "long_description": "Step into a new dimension of entertainment with Scenez XR, exclusively on Meta Quest 3. Dive into an unparalleled 4D volumetric experience. Witness breathtaking live performances from your favorite musicians, captured in stunning volumetric detail, as they come alive around you. With the power of XR, you can place the artist right in your home, turning your living space into an intimate concert venue. Feel the music, see the performers in 3D, and interact with the environment in ways you never imagined. Scenez XR pushes the boundaries of immersive technology, bringing you closer to the art and artists you love. Get ready to experience concerts like never before, only on Scenez XR.", "short_description": "4D Volumetric Performances brought into your home! \nThe future is NOW!"}]}, "developer_name": "Paul Vowell", "developer_privacy_policy_url": "https://scenez.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "4D Fun Inc", "support_website_url": "https://4dfun.io/", "website_url": "https://scenez.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING", "GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7991895534271079"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001701_866835432205873_6448606357567963446_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=er32IIJqrkQQ7kNvwHfEPZY&_nc_oc=Adlw-dN5uAjZF50pQuwo9SeF-cWqiLAMDNKDIZ8tWfLqPzCNGA0-GyiEzpzQOLCB35g&_nc_zt=3&_nc_ht=scont
t-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbp6RdGoqIEb2rZq7X8OlJ7lYhyV3rl6hfisCHU_EyyA&oe=6AC8FBC5"}, {"file_name": "MetaScreenShot ScenezXR Mica1.png", "id": "1493385884904887", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974469_1493385888238220_5074879560501904780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crWXN5LQZ4sQ7kNvwGB6JVy&_nc_oc=AdpTdrSNN-E-bSuOsP5LE-RYtSL7BZZZxXnzJ7b5M8lNoEfhaH1DuB0dluHw0uAwxLc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgSDMZcOCVtK7kgOwr29n0zCIHMk5eRgM8HfpPl1_gGQ&oe=6AC8E646"}, {"file_name": "MetaScreenShot ScenezXR JM.png", "id": "1151098436114581", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974886_1151098439447914_4249611160335607262_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THLGvBAv5WUQ7kNvwHK9WXi&_nc_oc=AdqPn-JoX5hQvrr_SXtpG0lUGI5sw1AQF5hps_Rnd8Okb-8wLM7SgsE-QS0SaTSC9YE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWMYSIXOiNR_CAcOTudEpOdrdi6VfDXabfetJ9OTYkww&oe=6AC8F4C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverimage ScenezXR.png", "id": "1147384969808452", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974802_1147384973141785_3689711553277891187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBfrsMrMek8Q7kNvwH_xsCi&_nc_oc=AdrOD7ZMmJSJvBzYdTxHkfKhsR6uPf0hAVVPFh93FqACr5EsHqzPeKHRkS9dVrpq0v8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgZkkfKuL_sVEHC48kgjjQx4jScnWCI4zfjSrMePTqpw&oe=6AC8F4F2"}, "display_name": "Scenez XR", "keywords": ["music", "entertainment", "comedy", "4d"], "long_description": "Step into a new dimension of entertainment with Scenez XR, exclusively on Meta Quest 3. Dive into an unparalleled 4D volumetric experience. Witness breathtaking live performances from your favorite musicians, captured in stunning volumetric detail, as they come alive around you. With the power of XR, you can place the artist right in your home, turning your living space i
t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVAr8sgX12qzkjnzEqXWH6OIf5gNg2SzXkE8sFv5HV_A&oe=6AC658C5"}, {"file_name": "MetaScreenShot ScenezXR Mica1.png", "id": "1493385884904887", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_1493385888238220_5074879560501904780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMzLst97-C0Q7kNvwFqgGZc&_nc_oc=AdqWb0SbAbqwuA4Npigud2IORwl1avpXC-3arGexzJ2WHtBAlrgJxZKWP4R493wjtRM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOitOSO6ulahN-MD0m1euyRoi6boZHaQ3LOngsgZIZHQg&oe=6AC64346"}, {"file_name": "MetaScreenShot ScenezXR JM.png", "id": "1151098436114581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974886_1151098439447914_4249611160335607262_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THLGvBAv5WUQ7kNvwFsKdfd&_nc_oc=AdqD8DLMtAHUox7lAyUzJbvCYF5_i1BVrx5dcmjDst7TKpCl1GebOuzj1OKPpUDhHF0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8BUSkjc0beyrq-xKMtgSadnF5NHTQ5i1-mYyqval3FA&oe=6AC651C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverimage ScenezXR.png", "id": "1147384969808452", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974802_1147384973141785_3689711553277891187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnOtPH5MSLUQ7kNvwFssb2r&_nc_oc=Ado9WtuIYWMMb9NybyIUjF08BwJBZIerMLyAwaGvla2A5wFWM3LG507Sk0FBGhEku3c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqTwYH4VfFd88JmqMS_RqQ4dxhP-nOSPfcLVCYP_g3rw&oe=6AC651F2"}, "display_name": "Scenez XR", "keywords": ["music", "entertainment", "comedy", "4d"], "long_description": "Step into a new dimension of entertainment with Scenez XR, exclusively on Meta Quest 3. Dive into an unparalleled 4D volumetric experience. Witness breathtaking live performances from your favorite musicians, captured in stunning volumetric detail, as they come alive around you. With the power of XR, you can place the artist right in your home, turning your living space i
t-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLxEifsZRr9Fk8xyF8LAZIa4ABF_PUJFbDzmbLa_B5DQ&oe=6AF9C345"}, {"file_name": "MetaScreenShot ScenezXR Mica1.png", "id": "1493385884904887", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974469_1493385888238220_5074879560501904780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgxthetPw24Q7kNvwE0_oYI&_nc_oc=AdrdUBLUuggtkFm9fG6Mqfk9iOnlQ4EU8hkcZMX---g_CyLD3jQUpZjYeibr5VGwhes&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJtZxuOlZhOJGRmoqWx0ho8zPjxIX2TBHaafFcpuEYIg&oe=6AF9E606"}, {"file_name": "MetaScreenShot ScenezXR JM.png", "id": "1151098436114581", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974886_1151098439447914_4249611160335607262_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYTqCU-lcvEQ7kNvwGUOm66&_nc_oc=AdotVmUoduTKMhUjwngfdQc0fC-WWwb6vYLYo9mH3c8O4s09fsyTohWu1v141pk1rEM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAzrPADRAqutQTXbFt7ynmfnepTJtbydUVLgUY7x_lyg&oe=6AF9BC41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverimage ScenezXR.png", "id": "1147384969808452", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974802_1147384973141785_3689711553277891187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MN78MK5aro4Q7kNvwEUtl7G&_nc_oc=AdqnEeiF3wHTOnUjyd0h0KteKsPguvOeGsmEtG4AswNXJ2CQPxQavS7PojHdjfUqqG0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVRUFIwk5ykPzcO2xTQY07H-JhHg3FMAhMzXMNsI6iDA&oe=6AF9BC72"}, "display_name": "Scenez XR", "keywords": ["music", "entertainment", "comedy", "4d"], "long_description": "Step into a new dimension of entertainment with Scenez XR, exclusively on Meta Quest 3. Dive into an unparalleled 4D volumetric experience. Witness breathtaking live performances from your favorite musicians, captured in stunning volumetric detail, as they come alive around you. With the power of XR, you can place the artist right in your home, turning your living space i
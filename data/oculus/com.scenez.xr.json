t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOESIdDPvEvInZjWbbhBKREgpBNlI2Y4lFELuCHm33rg&oe=6AE74E45"}, {"file_name": "MetaScreenShot ScenezXR Mica1.png", "id": "1493385884904887", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974469_1493385888238220_5074879560501904780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v090oFsJNosQ7kNvwG5q6k5&_nc_oc=AdoJTtZWul96C_5heBPTLxq6XjO7EzdQTn6wC_gwjYMESFPPvirqKA9uzyp9zmARl2w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGIurGRbXUpEj7wdRYVRVXoFZQ6h_mjEBEA-hvHYSI3g&oe=6AE77106"}, {"file_name": "MetaScreenShot ScenezXR JM.png", "id": "1151098436114581", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974886_1151098439447914_4249611160335607262_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7oG_StU4akQ7kNvwFMjzjc&_nc_oc=Ado3pKanfydr4x_ZTSszwTYpRZ8GQAg5L7e7GSkDctOGX0L2CyAk58o56PMqR65hb3w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRhZzlN0rnkiMKuExNFxfeUOmbmXCxypdND6KvZ3uFtw&oe=6AE74741"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverimage ScenezXR.png", "id": "1147384969808452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974802_1147384973141785_3689711553277891187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjEDoerjugEQ7kNvwGedo3Z&_nc_oc=Adr2cg9r6QpdG-J-3l16-UQ4dIJK1Qpk7EiHNPBfGppZglQZZnEESZ8ZFYG3ToM6gx8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThu4o16O9cuZS-0Q4OjvRBFbFFB4MUy2lCXavkeufoVA&oe=6AE74772"}, "display_name": "Scenez XR", "keywords": ["music", "entertainment", "comedy", "4d"], "long_description": "Step into a new dimension of entertainment with Scenez XR, exclusively on Meta Quest 3. Dive into an unparalleled 4D volumetric experience. Witness breathtaking live performances from your favorite musicians, captured in stunning volumetric detail, as they come alive around you. With the power of XR, you can place the artist right in your home, turning your living space i
t-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0HpT6hcyTCrVVTbewEEiptlSY80l_LHIMEb-1A6_yuQ&oe=6ACB9EC5"}, {"file_name": "MetaScreenShot ScenezXR Mica1.png", "id": "1493385884904887", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_1493385888238220_5074879560501904780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mg1FDbA4U_8Q7kNvwHxb_uE&_nc_oc=AdpXmLLNuqpukizyYtRQEsbqWgbPXqQyLICa3vsvYmqFh_X3VbwZ0ZRFkZswBNR1BsQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4maBOSBXJfcUyfztYDMyT7du2jdW9LqWlFtkdKmztXA&oe=6ACBC186"}, {"file_name": "MetaScreenShot ScenezXR JM.png", "id": "1151098436114581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974886_1151098439447914_4249611160335607262_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRsRIZsbfqAQ7kNvwGg6Yo7&_nc_oc=AdouydF5jeC9G-pKFdlhTLoaZ8pC9R6llvzPwLKdC1N8oA1YIu-X1u9VombNtMMr7Gw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLHUzgNQ4vuh_yuh29IaYoAlcBFlF2yNj0Q0J49GhR_g&oe=6ACB97C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverimage ScenezXR.png", "id": "1147384969808452", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974802_1147384973141785_3689711553277891187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBfrsMrMek8Q7kNvwEv1Hje&_nc_oc=AdrT73OPZBNlxFrYxcsbxmC4kgjiK3ZYo6pqXGDaOxLPQ6wVidG7yiLXxPXeeb1_NBU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNl-l-yLKQ03unciSgYgiiRDssCObTvOtvKXE6JnIWKOg&oe=6ACB97F2"}, "display_name": "Scenez XR", "keywords": ["music", "entertainment", "comedy", "4d"], "long_description": "Step into a new dimension of entertainment with Scenez XR, exclusively on Meta Quest 3. Dive into an unparalleled 4D volumetric experience. Witness breathtaking live performances from your favorite musicians, captured in stunning volumetric detail, as they come alive around you. With the power of XR, you can place the artist right in your home, turning your living space i
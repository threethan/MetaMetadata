t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLUZVYDJNSY1P_pAmPjomLfrc9a2y4oLeBDhzaMvs15A&oe=6AC3B5C5"}, {"file_name": "MetaScreenShot ScenezXR Mica1.png", "id": "1493385884904887", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974469_1493385888238220_5074879560501904780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMzLst97-C0Q7kNvwEzoHAn&_nc_oc=AdpGPQrgWBcL6x7UHTdhlbDQZ4aS8saqUXwwZgMMkwi-FaZonS-CJGJt7UL4YGT8qjc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPa5Jc1hX1LPSwc8POkvTwhN0-_uGR45NYFw5su98-cWA&oe=6AC3D886"}, {"file_name": "MetaScreenShot ScenezXR JM.png", "id": "1151098436114581", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974886_1151098439447914_4249611160335607262_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xPJPkfhXhgQ7kNvwHLQ41u&_nc_oc=AdqPbG6QZMIrA5-o_QqG_l9FAP5TvP3szg1Tln9xF8MmlXQm2VEYRg0FQpC-6Ax80Ug&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZTcuxGvk2t4Px3xBLGLvAlDKSxuXGaUPPhAI1ATwSUw&oe=6AC3AEC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverimage ScenezXR.png", "id": "1147384969808452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974802_1147384973141785_3689711553277891187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywU9nvjS9zEQ7kNvwEdIwFW&_nc_oc=AdpXEiEeoNXi0W_0eS-RZAlRwH4w24zvdM9kV63goCoC-PmpL7zAHNiV5gkbaaI7WMY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtU_aCSDVmnOaXmj8KaRWZxcscSeomTm4WBHOyXAGhDA&oe=6AC3AEF2"}, "display_name": "Scenez XR", "keywords": ["music", "entertainment", "comedy", "4d"], "long_description": "Step into a new dimension of entertainment with Scenez XR, exclusively on Meta Quest 3. Dive into an unparalleled 4D volumetric experience. Witness breathtaking live performances from your favorite musicians, captured in stunning volumetric detail, as they come alive around you. With the power of XR, you can place the artist right in your home, turning your living space i
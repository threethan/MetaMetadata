t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRl0rf9zc1bftSlLWGZxAFjXmCjTtMq824x7U-yk2hWiw&oe=6AF8AA05"}, {"file_name": "MetaScreenShot ScenezXR Mica1.png", "id": "1493385884904887", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_1493385888238220_5074879560501904780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgxthetPw24Q7kNvwGYR-Mu&_nc_oc=AdrxUk1HLCbwzd2UgqR9keI9Oma0-LMLQUPKNQepBQPfYwg3dPe1LpKiA_JD8ITLE58&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyRoX5eG95sIjHtfNQ4agyRMieQGjNKqAY7RyETqu3AQ&oe=6AF89486"}, {"file_name": "MetaScreenShot ScenezXR JM.png", "id": "1151098436114581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974886_1151098439447914_4249611160335607262_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9oMr0aJjrXgQ7kNvwH4pkwu&_nc_oc=AdqHRmqnjD1B4pQ6LAYsIwvXDO8f0AxE4SsRaKgXvNEcqG-zznfxUPMfIXVHbu17VDE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRD-WftSJfwiBx8rFnLAt8p8UH4fOvIl15YAYKM4F7jgA&oe=6AF8A301"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverimage ScenezXR.png", "id": "1147384969808452", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974802_1147384973141785_3689711553277891187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MN78MK5aro4Q7kNvwHItxyi&_nc_oc=AdpNYkObOkAjkvNJElHOmBkar4LgxivTcOU10FyB--b67VBARgtMnmsCg06wjxOleYg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe7yPlJQBi3BWazl_jFJz9oB8Z_pncJdYVKZVMyAjVWg&oe=6AF8A332"}, "display_name": "Scenez XR", "keywords": ["music", "entertainment", "comedy", "4d"], "long_description": "Step into a new dimension of entertainment with Scenez XR, exclusively on Meta Quest 3. Dive into an unparalleled 4D volumetric experience. Witness breathtaking live performances from your favorite musicians, captured in stunning volumetric detail, as they come alive around you. With the power of XR, you can place the artist right in your home, turning your living space i
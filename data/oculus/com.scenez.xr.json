t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAA4mqSl967W5ywnSBdwmQiy2h_WUMtZKxXCVj4lNhpA&oe=6AF5CEC5"}, {"file_name": "MetaScreenShot ScenezXR Mica1.png", "id": "1493385884904887", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974469_1493385888238220_5074879560501904780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPpQP6vKnQcQ7kNvwGuVldL&_nc_oc=AdqbevWZfIDTesxzCZg1IuKbdxoIhGVX1gc9RR84I8sjnRO-KZhU3ziJFp_-bGcpHPo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrEN-PHjN6GsbVy8BZRxMExNVqO5ZinmsKDn9amDSvTQ&oe=6AF5F186"}, {"file_name": "MetaScreenShot ScenezXR JM.png", "id": "1151098436114581", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974886_1151098439447914_4249611160335607262_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9oMr0aJjrXgQ7kNvwFqE-ig&_nc_oc=AdpZ2vvKyC65aqKmpXV7fmrgHJOlC6L3kYKHtqkjffpQlyxWT7z4Hu9wQhDgoj6xvvQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEphMxpLAYlJ1Tch8qJY22n8DtfC9QE7lGmxj-0dBURw&oe=6AF5C7C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverimage ScenezXR.png", "id": "1147384969808452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974802_1147384973141785_3689711553277891187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeylENbhoyEQ7kNvwHKG9_j&_nc_oc=AdoO-jSIq8BpQVtyd_uxiQNk6KG3p2mBc4vceoWjXcdmRpua45fTuIYm0jlXhzREzzg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_xEsU45d-IIu0leVTjblPbM7d4YcpfqiMMkdywahi_Q&oe=6AF5C7F2"}, "display_name": "Scenez XR", "keywords": ["music", "entertainment", "comedy", "4d"], "long_description": "Step into a new dimension of entertainment with Scenez XR, exclusively on Meta Quest 3. Dive into an unparalleled 4D volumetric experience. Witness breathtaking live performances from your favorite musicians, captured in stunning volumetric detail, as they come alive around you. With the power of XR, you can place the artist right in your home, turning your living space i
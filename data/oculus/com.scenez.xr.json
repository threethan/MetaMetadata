t-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbG0w-Q_x9pCIrRrswy-iqi_NdWljtBvfynboWtdU1Tg&oe=6AEC9445"}, {"file_name": "MetaScreenShot ScenezXR Mica1.png", "id": "1493385884904887", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974469_1493385888238220_5074879560501904780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YD67A_g1BREQ7kNvwEJCFbz&_nc_oc=Adq9corHn3jPNWNXW2Ci9hz_eOZNRvAfXEQzJUUOKHyZO23omaUoATOKZdoT1oJMaZQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3Xw89HNslJ-DrtDGG3gOXwAUMEzPktqvD-pMV2Mon9w&oe=6AECB706"}, {"file_name": "MetaScreenShot ScenezXR JM.png", "id": "1151098436114581", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974886_1151098439447914_4249611160335607262_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWGn5Ju0lqMQ7kNvwEu7qxU&_nc_oc=AdrOVvFJ6kkQXmwDbSazMYxyYRs0XFkYaanFF3jQ4PafA2PEO-XW2Cxwt_t_rdR-VR4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQz46bRKRwkkL4QP7dz6K9B_a_kZaC_zJMrkm2vcwcf5A&oe=6AEC8D41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverimage ScenezXR.png", "id": "1147384969808452", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974802_1147384973141785_3689711553277891187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPorKAI5wZwQ7kNvwHkvKkx&_nc_oc=AdrRilFShQnyGZri9s_Oq4u298b9_uMON4uZhAybNl7_oEdb8Vmd1FPs8DE1OnkhR8c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlEi_I0xanvioRxgJz2aY49VW62EFVDKCUOiwFP3p_fQ&oe=6AEC8D72"}, "display_name": "Scenez XR", "keywords": ["music", "entertainment", "comedy", "4d"], "long_description": "Step into a new dimension of entertainment with Scenez XR, exclusively on Meta Quest 3. Dive into an unparalleled 4D volumetric experience. Witness breathtaking live performances from your favorite musicians, captured in stunning volumetric detail, as they come alive around you. With the power of XR, you can place the artist right in your home, turning your living space i
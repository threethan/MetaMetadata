t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj_tKtAoie9F2cXZyuzLu41aZnAvvKF4KQlvPpo3j2OA&oe=6AF72045"}, {"file_name": "MetaScreenShot ScenezXR Mica1.png", "id": "1493385884904887", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_1493385888238220_5074879560501904780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgxthetPw24Q7kNvwGAnpil&_nc_oc=Ado65g_Fzp5DA1SQ0YOh2L3qhirgCp8Whild6WvkLxAVW_uOT0znDySYY8fESXDROyw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSozOVlSTwqQxEEBVCwW3WZrzNpWO_LZKZ1jCXK8GmArg&oe=6AF74306"}, {"file_name": "MetaScreenShot ScenezXR JM.png", "id": "1151098436114581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974886_1151098439447914_4249611160335607262_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9oMr0aJjrXgQ7kNvwE3ExkR&_nc_oc=AdpUbaoo9HNpMp58cL2uKGQ9K9IFGBPL9QVzYGmGimTO7VGGK3PPbZ56jil-m5AACMk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLra6q0YBYy9vU7FZK3easCWRBeHE41bhQPak8CQGN_A&oe=6AF71941"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverimage ScenezXR.png", "id": "1147384969808452", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974802_1147384973141785_3689711553277891187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeylENbhoyEQ7kNvwG_NSlF&_nc_oc=AdoEuadrN9bmBjj0aJQ-5PyDPXqxsquOxKDBeiMwT9yDaqRGxk3wmDnGGsAG3xLDg8A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFBgIFTGaOJa2PjUmUcJItlFTMR0JLCCOLuMt5F7OHpg&oe=6AF71972"}, "display_name": "Scenez XR", "keywords": ["music", "entertainment", "comedy", "4d"], "long_description": "Step into a new dimension of entertainment with Scenez XR, exclusively on Meta Quest 3. Dive into an unparalleled 4D volumetric experience. Witness breathtaking live performances from your favorite musicians, captured in stunning volumetric detail, as they come alive around you. With the power of XR, you can place the artist right in your home, turning your living space i
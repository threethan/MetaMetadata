t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOegOz_PxKNKgc5TGCc-1KSr4jIyeWk8dqI_lIHWL-Ftg&oe=6AE5FCC5"}, {"file_name": "MetaScreenShot ScenezXR Mica1.png", "id": "1493385884904887", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974469_1493385888238220_5074879560501904780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YcfgbrO0xAcQ7kNvwFQYtH8&_nc_oc=AdrEigEnVc0w1v29qeEYCv4KJi2SrOTqWTAxD8Ch-cADYv9yH-QiKujNBxdMbWAp2WM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCec0TXT0nTUH033W95qySLy0Kor3qJ8b6AK41Y59OEg&oe=6AE5E746"}, {"file_name": "MetaScreenShot ScenezXR JM.png", "id": "1151098436114581", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974886_1151098439447914_4249611160335607262_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7oG_StU4akQ7kNvwEu83Dy&_nc_oc=AdpRVnk9gk4Zb6J4BTF4HVj_euJd1ZQh4uJyDsp4xpEMmhn-bdNegwa0EY0PVhufRho&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7WYxYORllCgTgsJvmD_UXTmjsibVljsBdQxhNJngevA&oe=6AE5F5C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverimage ScenezXR.png", "id": "1147384969808452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974802_1147384973141785_3689711553277891187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjEDoerjugEQ7kNvwEzYXbZ&_nc_oc=AdrtpfZUqFCaWiiIyWoWR_ZR2-PpL3ZoTyU2IHLPgT6u4Ah72MnXRE6cL-plNhKUhRc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJhbBgZSB4FsNeohT2XAHwxEUhlE_mm6CZfz-Pt7hdsg&oe=6AE5F5F2"}, "display_name": "Scenez XR", "keywords": ["music", "entertainment", "comedy", "4d"], "long_description": "Step into a new dimension of entertainment with Scenez XR, exclusively on Meta Quest 3. Dive into an unparalleled 4D volumetric experience. Witness breathtaking live performances from your favorite musicians, captured in stunning volumetric detail, as they come alive around you. With the power of XR, you can place the artist right in your home, turning your living space i
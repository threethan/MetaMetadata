t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHSuRDaQnjaw21I7kOa7L-BzoiZ5ThnftDZF6YI5Emvg&oe=6ABBCCC5"}, {"file_name": "MetaScreenShot ScenezXR Mica1.png", "id": "1493385884904887", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_1493385888238220_5074879560501904780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLWw_k3J3BgQ7kNvwHi51KZ&_nc_oc=Adr9hHMTwwP5aACtmivZuu72NDy3_-qsQjjkbtvL1RXUQ_lIfyAmCZ1Y4TdNTtmJPes&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKm8tHbgGoCIV2KUnqnEaZipcGZN-K3aTVaupziyOXS-Q&oe=6ABBB746"}, {"file_name": "MetaScreenShot ScenezXR JM.png", "id": "1151098436114581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974886_1151098439447914_4249611160335607262_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPjgOdcksA0Q7kNvwGYo2HE&_nc_oc=AdpOeoxncSJ_sTeeGESrIzFCRUO51dpAV4qDoiv4Re2fiWqGyjl2VjqN5WT09B7yxw0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrM5iwamYlDTlYaEg6cqUYp9kMIq4qLElgsa_3_16XeQ&oe=6ABBC5C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverimage ScenezXR.png", "id": "1147384969808452", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974802_1147384973141785_3689711553277891187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGUSscafYGkQ7kNvwGO3IE5&_nc_oc=AdqYhdFlCc0iT1oPR7CHdwZaLzgM4Gm2_0FnjJvcp_kwg5RbjVlTdH967g-GkAvYrsQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgINy-swda8mTDTY-fhWTAO5dp9oIwXMOWMe3I2_YhuQ&oe=6ABBC5F2"}, "display_name": "Scenez XR", "keywords": ["music", "entertainment", "comedy", "4d"], "long_description": "Step into a new dimension of entertainment with Scenez XR, exclusively on Meta Quest 3. Dive into an unparalleled 4D volumetric experience. Witness breathtaking live performances from your favorite musicians, captured in stunning volumetric detail, as they come alive around you. With the power of XR, you can place the artist right in your home, turning your living space i
t-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHWWz_mAInM4v3-P9uI2HeMlgbPiXjyROllDNacXrbjw&oe=6AC50745"}, {"file_name": "MetaScreenShot ScenezXR Mica1.png", "id": "1493385884904887", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974469_1493385888238220_5074879560501904780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMzLst97-C0Q7kNvwGjTrMM&_nc_oc=AdrGzelCUNdyU6wBJfFIpQ1FP06Mj5E3E2R5BNX169yXyPdwVaqEbsRYJb7lXxIQ4R8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOylNDke5jIT5sbubSHw9Eotmguenr7s-eBqrPYy0bcrA&oe=6AC4F1C6"}, {"file_name": "MetaScreenShot ScenezXR JM.png", "id": "1151098436114581", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974886_1151098439447914_4249611160335607262_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xPJPkfhXhgQ7kNvwHZAV1n&_nc_oc=Adrndl4TCe66EoWJysC2IkZDsvD9UzZ8GIPkDHMw_QnMCjakamv1q8xiSjkXk7ddydQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHeHZK5cFTrWT8tkBvvUHQpPXQB7Aahornyl8f_csXXQ&oe=6AC50041"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverimage ScenezXR.png", "id": "1147384969808452", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974802_1147384973141785_3689711553277891187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnOtPH5MSLUQ7kNvwHTkxr4&_nc_oc=AdpfEPAjY2h0KgUJpEjca1Vc8984iJOLPsclALrBoUA_iyqqShJqwzhEd-t6nT_cU0o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgCOP1lSphM5CzzHuEgHQIBsjHAHpZ7xCY4JoIchz_pQ&oe=6AC50072"}, "display_name": "Scenez XR", "keywords": ["music", "entertainment", "comedy", "4d"], "long_description": "Step into a new dimension of entertainment with Scenez XR, exclusively on Meta Quest 3. Dive into an unparalleled 4D volumetric experience. Witness breathtaking live performances from your favorite musicians, captured in stunning volumetric detail, as they come alive around you. With the power of XR, you can place the artist right in your home, turning your living space i
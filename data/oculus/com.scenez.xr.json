t-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIt9FmIclp7vAK2mZI3q80Yyl2KXJgojCLI3lAoyHW1A&oe=6AE20845"}, {"file_name": "MetaScreenShot ScenezXR Mica1.png", "id": "1493385884904887", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974469_1493385888238220_5074879560501904780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2B8J_i5ObIMQ7kNvwHSNT8M&_nc_oc=AdrSDhSFDfxfjnp22H49C6Vhrbs_PWbopa_uHaAjijUs0ulqgu6qzBH6AUIGegmU5uM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyAO-LtxVwy5gVtkjUD8QjTrzzRtYIN0F2qHEOCVJ6rA&oe=6AE1F2C6"}, {"file_name": "MetaScreenShot ScenezXR JM.png", "id": "1151098436114581", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974886_1151098439447914_4249611160335607262_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nnCDhIaMREQ7kNvwE3rSXF&_nc_oc=AdpTA5SiNxiX9fiNNNDz7TqKWpaLk6M2S_v_w79wVstO9AicQPOjdNNC-YGM57sIZPo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdt6ppPAEFY1p71oL2Y1jtItLoxmTVXBrpZAasSN-84Q&oe=6AE20141"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverimage ScenezXR.png", "id": "1147384969808452", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974802_1147384973141785_3689711553277891187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8u0Af5AkVlcQ7kNvwE1ydWm&_nc_oc=AdoPBw4F48DU1ZCzouP_a7TaWfFCInAjITE9gjJ-mMceVr_EAablfZJZmXT8Gj4ew0M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCyooPa_8xoEYFQ__K0HQ5WhNvV4K0Et-04VEdCcn7Dg&oe=6AE20172"}, "display_name": "Scenez XR", "keywords": ["music", "entertainment", "comedy", "4d"], "long_description": "Step into a new dimension of entertainment with Scenez XR, exclusively on Meta Quest 3. Dive into an unparalleled 4D volumetric experience. Witness breathtaking live performances from your favorite musicians, captured in stunning volumetric detail, as they come alive around you. With the power of XR, you can place the artist right in your home, turning your living space i
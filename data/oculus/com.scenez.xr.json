t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHkEvb5neAe9n11rEP5pn74LO984oEmd_GkyGl4PwS4A&oe=6ABD1E45"}, {"file_name": "MetaScreenShot ScenezXR Mica1.png", "id": "1493385884904887", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974469_1493385888238220_5074879560501904780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLWw_k3J3BgQ7kNvwGAL2E8&_nc_oc=AdpPRq8hIpQ1Bg48YotfJ-KLXm9i_0e7hVo0npn-wMoLVYHnCSb53i-I2OHw7bUlHrg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdbm_m_-WwkLxDMEy-4D76Kk959G6InRQoH5sHhMsqrg&oe=6ABD08C6"}, {"file_name": "MetaScreenShot ScenezXR JM.png", "id": "1151098436114581", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974886_1151098439447914_4249611160335607262_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPjgOdcksA0Q7kNvwFpPBGl&_nc_oc=AdphjxjhcCE4vPN9Q_wP9AcLpQpZeXqybkgLkdFTR9X5N1GcMQ39-eyBb8ycNrbjqek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9J6MqhlBZ4gUOTXlPg7Msub_lKBJbJacoZZsGsPnQiw&oe=6ABD1741"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverimage ScenezXR.png", "id": "1147384969808452", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974802_1147384973141785_3689711553277891187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4fW46FLZQwQ7kNvwEl9aRL&_nc_oc=AdrFDmnl3JjswL9fXGTeKXsB4gvNaIloPo00oG9pXxTziaSv-4EsZ3JpLQikGeyLfCk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJi9pBf6KtNuV-H1zgyx5zt7Z3-fUVOdKqJvN8B-cmEcw&oe=6ABD1772"}, "display_name": "Scenez XR", "keywords": ["music", "entertainment", "comedy", "4d"], "long_description": "Step into a new dimension of entertainment with Scenez XR, exclusively on Meta Quest 3. Dive into an unparalleled 4D volumetric experience. Witness breathtaking live performances from your favorite musicians, captured in stunning volumetric detail, as they come alive around you. With the power of XR, you can place the artist right in your home, turning your living space i
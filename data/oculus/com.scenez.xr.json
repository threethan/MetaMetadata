t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMnS9XTT-ohGapYsNJpyEVPUxtUfMUTcnMc02WQ_mEsg&oe=6AE9F145"}, {"file_name": "MetaScreenShot ScenezXR Mica1.png", "id": "1493385884904887", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_1493385888238220_5074879560501904780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v090oFsJNosQ7kNvwHw0ntL&_nc_oc=AdqjD5XGtbbl2NPZA4Z-SlEE8LfxKO4fMugBleyG--AaIC2boH6WrwczxBjS3siZTUY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCq8lqn5SbC_ZT-o3E0QI70hHqhEAJpRxn0EDticHo8w&oe=6AEA1406"}, {"file_name": "MetaScreenShot ScenezXR JM.png", "id": "1151098436114581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974886_1151098439447914_4249611160335607262_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWGn5Ju0lqMQ7kNvwEw_xNP&_nc_oc=Ado3yKf9vRrsHSbNjVVWkFgMwVDL7ae86Rr9CubL8vP9Yy3f9gvThzVqet0TFycP7go&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVWmhGgLaf0Hf5ESUcSqd2UFw4oy41lMCJb2BUEBfN-g&oe=6AE9EA41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverimage ScenezXR.png", "id": "1147384969808452", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974802_1147384973141785_3689711553277891187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6bgp-jxZuAQ7kNvwH3qDIX&_nc_oc=AdonpXY_szKJ_PdBgNSvrXINZJoaxQsEAlZzVYbmkPlCEeCfolpKcyTw5C3HdJ0CWcE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2ZKsy4lxoYjbbnp6JctXY8KQYQoylnoorSNfASWchBw&oe=6AE9EA72"}, "display_name": "Scenez XR", "keywords": ["music", "entertainment", "comedy", "4d"], "long_description": "Step into a new dimension of entertainment with Scenez XR, exclusively on Meta Quest 3. Dive into an unparalleled 4D volumetric experience. Witness breathtaking live performances from your favorite musicians, captured in stunning volumetric detail, as they come alive around you. With the power of XR, you can place the artist right in your home, turning your living space i
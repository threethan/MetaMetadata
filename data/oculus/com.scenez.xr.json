t-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6mrMDetRhlk6z4YWkK72VehZ62kHskfyJZ40Ejp4KrQ&oe=6ADF6545"}, {"file_name": "MetaScreenShot ScenezXR Mica1.png", "id": "1493385884904887", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_1493385888238220_5074879560501904780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2B8J_i5ObIMQ7kNvwFrLqqB&_nc_oc=Ado0P84xAMTTgHXjPPhXDJlebfZvIUWK6CKoud0FLTDG98ueUcqWsDKyNoZIas2Y1O4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5f3zWbV-lBHbPJHvUFMUV33U8PZmejcDNOAOoO9GmsA&oe=6ADF4FC6"}, {"file_name": "MetaScreenShot ScenezXR JM.png", "id": "1151098436114581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974886_1151098439447914_4249611160335607262_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wq8NZBBdsjIQ7kNvwHbRE74&_nc_oc=AdpPAT4njkTTRQy0JV1wkr7s4IUAthOq6JHpAfgcMYcOSGb17efaNhI27tWmBxjvi78&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFd6UvQgXNjJ---oj0XFwmVmGAViLeeBYcgeeU_Fh3UQ&oe=6ADF5E41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverimage ScenezXR.png", "id": "1147384969808452", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974802_1147384973141785_3689711553277891187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3Lk_ycMZC8Q7kNvwF9s18O&_nc_oc=Adr-WPN4Bm5-ku2KjIdEImuLNnpd9TNDo7FScti9JCNVxknCeZ0Eh3fkQVo6s_4Ko0o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObR3xYGt61Z7JqfvJAe07ZXC1GtuopmPctWhEPUn1X4A&oe=6ADF5E72"}, "display_name": "Scenez XR", "keywords": ["music", "entertainment", "comedy", "4d"], "long_description": "Step into a new dimension of entertainment with Scenez XR, exclusively on Meta Quest 3. Dive into an unparalleled 4D volumetric experience. Witness breathtaking live performances from your favorite musicians, captured in stunning volumetric detail, as they come alive around you. With the power of XR, you can place the artist right in your home, turning your living space i
t-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDyMjKX8njF1doT3vwCRG2lcXbLG0vHbInNR_Mn94BSA&oe=6AD387C5"}, {"file_name": "MetaScreenShot ScenezXR Mica1.png", "id": "1493385884904887", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974469_1493385888238220_5074879560501904780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTOkifdgbU0Q7kNvwFKijzM&_nc_oc=AdroPS_P5odYq2wDXgiH-FbK5EPTztXyVe95yrUoCfOdFVOG6-AB7kq8Faj6I6NP8HE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBqg39X5Xlki7pQvILsa8y0ut2W3x_icivnxRntHwt2Q&oe=6AD3AA86"}, {"file_name": "MetaScreenShot ScenezXR JM.png", "id": "1151098436114581", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974886_1151098439447914_4249611160335607262_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRDi4FpJ8KcQ7kNvwGD70Is&_nc_oc=AdrgQ8pG36-cCgirEN7lE7i9fpy_6jw0JN6V7lFpaD86M7lMCn_Ju7CvjUuUN4eYnTE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuzkCX9RDmnLMl0y6ALW4NMdoPT8T9UAT8HfAYq7ct5Q&oe=6AD3B901"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverimage ScenezXR.png", "id": "1147384969808452", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974802_1147384973141785_3689711553277891187_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcUeJn0yFjEQ7kNvwF9bAVV&_nc_oc=AdpKp8WoGPfIpx-OaWNaBj-uish_Z4chsac6TX9XEKk689oURgeeUWw5ykgUR65bE3o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNifMoeoqOkJRud8FangeIy48Ry9Lw9NmTbVrQB50IEow&oe=6AD3B932"}, "display_name": "Scenez XR", "keywords": ["music", "entertainment", "comedy", "4d"], "long_description": "Step into a new dimension of entertainment with Scenez XR, exclusively on Meta Quest 3. Dive into an unparalleled 4D volumetric experience. Witness breathtaking live performances from your favorite musicians, captured in stunning volumetric detail, as they come alive around you. With the power of XR, you can place the artist right in your home, turning your living space i
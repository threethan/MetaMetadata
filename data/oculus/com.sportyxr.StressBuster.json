scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593938515_1098788713112436_6078655708237859100_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CpbbPhXyjoQ7kNvwHhU9MD&_nc_oc=Adr7vlBnaLkJa-kl-A3TpW0UTAjiE4VI42vgB0pqGKC04ilOM7_Orl0__FcFJFeZ1w8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSaeUGY_lQe9Ow1MN4AXNjEMXRBoQ2HFoVbGJhJ0ivDuQ&oe=6B0D9BBC"}, {"file_name": "S4.png", "id": "1813436726462992", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622184_1813436729796325_5058275735964122926_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8wRBs5tOq4Q7kNvwHt9s3z&_nc_oc=Adqsf3u0QElpYHkpHjYpqT3hEPzHnGs4zTLVuXA-iR3spP9bbq3hVINnrdUDJT1UEm4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQN0mfHDmUFIZGm4rcdxUOc4Oc8PuL0YyOELDe3T642Iw&oe=6B0DC449"}, {"file_name": "S5.png", "id": "2180614999185782", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620403_2180615002519115_6426376516739521475_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZoZgAaROBkQ7kNvwG1EkEW&_nc_oc=Adp4UtiZnx-fX79nJ2o3yDiayIZQHt9IjeBrZtzMs1ydpAmhGZKD3TD0M6ooRBYDaNs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQXeG-L2r_v1xYpTAmfxlEb5P11HH3s3eX1YgyVxDZ5tg&oe=6B0DC7CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hero Cover.png", "id": "1631722188320519", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620532_1631722191653852_5943683113533786268_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GciK-mEfJ3EQ7kNvwH1dd0p&_nc_oc=AdqE5FD3UYqScy1pYgdjV_gi9KOERXMPRMQ1IN-O6PrkzhsVlYzYUq3emvbgJ7RtC_U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTm1jWOpYFql-OTkWvsxJu-_Hvc-CQ9bbvsRU0vM9QrcQ&oe=6B0DC7CA"}, "display_name": "Stress Buster", "keywords": ["stressbuster", "balloon", "balloongames", "sportyxr", "popgame"], "long_description": "Every pop counts in **Stress Buster by sportyxr!** Pop balloons, avoid bombs, and time your abilities and power balloons to chase your highest score.\n\n**PLAY YOUR WAY**\n\nPlay in a 3D virtual room or your real surroundings with passthrough. Use VR controllers or your own hands with hand tracking.\n\n**FOUR GAME MODES**\n\n- **Classic:** Three bomb hits end your run.\n- **Arcade:** Chase your best score in 60 seconds. Bombs deduct 50 points without reducing lives.\n- **Multiplayer:** Create a room, share the code, and play with friends.\n- **Event:** Enjoy special events with new backgrounds and event music. Round duration follows the song.\n\n**CHOOSE YOUR ABILITIES**\n\nEquip two abilities at a time, one per hand. Pop 20 balloons to enable ability use.\n\n- **Magnet Pulse:** Pull balloons closer for 3 seconds.\n- **Shield:** Protect yourself from bombs for 3 seconds.\n- **Slow Field:** Slow balloons for 3 seconds.\n- **Echo Pop:** Trigger a nearby balloon-popping chain reaction.\n\n**POWER UP YOUR SCORE**\n\nNormal balloons earn **+10**, golden balloons earn **+50**, and bombs cost **-50** points.\n\n- **Double Strike:** Double points for 5 seconds.\n- **Golden Rush:** All balloons turn golden for 5 seconds.\n\nCheck player scores on the leaderboard and make every pop count!", "short_description": "Pop balloons, dodge bombs, and chase high scores in Stress Buster! Play in a virtual room or in your real surroundings using passthrough, with VR controllers or hand tracking. Equip two abilities, trigger power balloons, and enjoy Classic, Arcade, multiplayer with friends, and special events."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sportyxr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "SportyXR", "support_website_url": null, "website_url": "https://sportyxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": 
scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593938515_1098788713112436_6078655708237859100_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMNUXOTwcfYQ7kNvwFnpVUL&_nc_oc=AdoqGcOfVcoEHqULaBfHV7-z_ncTWe8tFwcNFVDsBYAUuZdn_atomsNTz8GL190jOJw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQPhHVQBvlUUwjDLhc6Twn4y95xIb2xhgpX4FXY00SSMw&oe=6B0C827C"}, {"file_name": "S4.png", "id": "1813436726462992", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622184_1813436729796325_5058275735964122926_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8wRBs5tOq4Q7kNvwEszWku&_nc_oc=AdoFjzyceDFut7qva7NA_emUGzQTZ_Rc8L-aHDAIqv1XWwfjhtUW7q_SC6N3ikQj2cQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQDMaPmsE-yOeQ4Yr9QY1-G3EPct7SZ0xe6YsvWhfdq1A&oe=6B0C72C9"}, {"file_name": "S5.png", "id": "2180614999185782", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620403_2180615002519115_6426376516739521475_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZoZgAaROBkQ7kNvwFDryn3&_nc_oc=AdpIC3w0_rZKZGXZMFmYLp-1h5lxjKqI1mx--3iI5tQRwTrNSlHRoxJd0V_KLIfRivc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRB4vWUiWCScc-2_pcryJZy2AymeGxxU3GeiK-WQNYtWQ&oe=6B0C764C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hero Cover.png", "id": "1631722188320519", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620532_1631722191653852_5943683113533786268_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GciK-mEfJ3EQ7kNvwFFCVEt&_nc_oc=AdqfRM-DDJa06vv1Xz8IcviCsWN1RJg7XhqpwvRoP8TA01kXWQgoRdVBNkOUyuVtKDU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTxWkEKqZbTPucaOmjPziA0YyQrSbUr8l7XBIy6-kFBAQ&oe=6B0C764A"}, "display_name": "Stress Buster", "keywords": ["stressbuster", "balloon", "balloongames", "sportyxr", "popgame"], "long_description": "Every pop counts in **Stress Buster by sportyxr!** Pop balloons, avoid bombs, and time your abilities and power balloons to chase your highest score.\n\n**PLAY YOUR WAY**\n\nPlay in a 3D virtual room or your real surroundings with passthrough. Use VR controllers or your own hands with hand tracking.\n\n**FOUR GAME MODES**\n\n- **Classic:** Three bomb hits end your run.\n- **Arcade:** Chase your best score in 60 seconds. Bombs deduct 50 points without reducing lives.\n- **Multiplayer:** Create a room, share the code, and play with friends.\n- **Event:** Enjoy special events with new backgrounds and event music. Round duration follows the song.\n\n**CHOOSE YOUR ABILITIES**\n\nEquip two abilities at a time, one per hand. Pop 20 balloons to enable ability use.\n\n- **Magnet Pulse:** Pull balloons closer for 3 seconds.\n- **Shield:** Protect yourself from bombs for 3 seconds.\n- **Slow Field:** Slow balloons for 3 seconds.\n- **Echo Pop:** Trigger a nearby balloon-popping chain reaction.\n\n**POWER UP YOUR SCORE**\n\nNormal balloons earn **+10**, golden balloons earn **+50**, and bombs cost **-50** points.\n\n- **Double Strike:** Double points for 5 seconds.\n- **Golden Rush:** All balloons turn golden for 5 seconds.\n\nCheck player scores on the leaderboard and make every pop count!", "short_description": "Pop balloons, dodge bombs, and chase high scores in Stress Buster! Play in a virtual room or in your real surroundings using passthrough, with VR controllers or hand tracking. Equip two abilities, trigger power balloons, and enjoy Classic, Arcade, multiplayer with friends, and special events."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sportyxr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "SportyXR", "support_website_url": null, "website_url": "https://sportyxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": 
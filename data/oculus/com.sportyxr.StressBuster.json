16_808732771557966847_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ef3CYlHPFHsQ7kNvwF4Oi-6&_nc_oc=AdoHecyaL-5_ZmETAQlmmqpXeyM69uwieg24oE5aAC6DGz25sVL9bTnW8hzf-rVw_NY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOqrpQAO5DosmZOuRTTW9mPZ_Bm9HPLosP6So44dgnNg&oe=6AFDAF5C"}, {"file_name": "S3.png", "id": "1098788706445770", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593938515_1098788713112436_6078655708237859100_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQK3cm1USBEQ7kNvwGjZuNk&_nc_oc=AdpIHGf8fwfIR35GkdfCLO6d3k7151LezgvCG6O3YzbbObHGNoWr8hFHqvDOgh2mW0I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSK5udUMAyK3GethCuajNEPfZEOAV2105DBd4rd3wVB7w&oe=6AFDC9BC"}, {"file_name": "S4.png", "id": "1813436726462992", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622184_1813436729796325_5058275735964122926_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLYU1RiRSVsQ7kNvwFc3z5h&_nc_oc=AdreZGIO-A_queFIc6Jm3TQ2MPdyIT8vZl5EaE2H34ZxqRxB-tfxMdiWpfdMBU4-60Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqZ8Afmd4CK02hEKOmmzDiOCwq_qEJaJ2XdniiQVdJDA&oe=6AFDBA09"}, {"file_name": "S5.png", "id": "2180614999185782", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620403_2180615002519115_6426376516739521475_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5IxZEtylKcQ7kNvwHYXhpm&_nc_oc=AdqCeYKmZQKJaM3NNXTS5uL9BS1LgUEsLPoZgZ3YbdYfghLuNAtUdORbTExV-7irnAY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV3CMPw4AzyeQO1sN1iRsR5N9_Mh7SQjttjscUWH0Stg&oe=6AFDBD8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hero Cover.png", "id": "1631722188320519", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620532_1631722191653852_5943683113533786268_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMZF3b6_cIYQ7kNvwEV_ClD&_nc_oc=AdqMTYdSUX0Yv5NobruT8I_3ZXzshaGbejlyXqK4bdp8TsKv9_eiFCQ0_brfzC2RJl4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlAQ5AU9b2Z8YA4oExhr9D2GAcJR9f9qKmhlliu2A3VQ&oe=6AFDBD8A"}, "display_name": "Stress Buster", "keywords": ["stressbuster", "balloon", "balloongames", "sportyxr", "popgame"], "long_description": "Every pop counts in **Stress Buster by sportyxr!** Pop balloons, avoid bombs, and time your abilities and power balloons to chase your highest score.\n\n**PLAY YOUR WAY**\n\nPlay in a 3D virtual room or your real surroundings with passthrough. Use VR controllers or your own hands with hand tracking.\n\n**FOUR GAME MODES**\n\n- **Classic:** Three bomb hits end your run.\n- **Arcade:** Chase your best score in 60 seconds. Bombs deduct 50 points without reducing lives.\n- **Multiplayer:** Create a room, share the code, and play with friends.\n- **Event:** Enjoy special events with new backgrounds and event music. Round duration follows the song.\n\n**CHOOSE YOUR ABILITIES**\n\nEquip two abilities at a time, one per hand. Pop 20 balloons to enable ability use.\n\n- **Magnet Pulse:** Pull balloons closer for 3 seconds.\n- **Shield:** Protect yourself from bombs for 3 seconds.\n- **Slow Field:** Slow balloons for 3 seconds.\n- **Echo Pop:** Trigger a nearby balloon-popping chain reaction.\n\n**POWER UP YOUR SCORE**\n\nNormal balloons earn **+10**, golden balloons earn **+50**, and bombs cost **-50** points.\n\n- **Double Strike:** Double points for 5 seconds.\n- **Golden Rush:** All balloons turn golden for 5 seconds.\n\nCheck player scores on the leaderboard and make every pop count!", "short_description": "Pop balloons, dodge bombs, and chase high scores in Stress Buster! Play in a virtual room or in your real surroundings using passthrough, with VR controllers or hand tracking. Equip two abilities, trigger power balloons, and enjoy Classic, Arcade, multiplayer with friends, and special events."}]}, "developer_name": null, "deve
.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzqqKVjsnKNKtbya6yVVzELMK24iYNw0uMzKY6vzXcjA&oe=6AF9D53C"}, {"file_name": "S4.png", "id": "1813436726462992", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622184_1813436729796325_5058275735964122926_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOQ6LTA67hsQ7kNvwG0cPjO&_nc_oc=Adqlqon3ZopiwwjtNzI0W69C7PknIO3Bi3v8VtpS_23jF9M7_iQSaywyW8LZ85amDuc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqJjU68mQjltTdAqJJ54PrhRU20f02oPBq5pqT-NhZmQ&oe=6AF9C589"}, {"file_name": "S5.png", "id": "2180614999185782", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620403_2180615002519115_6426376516739521475_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZJJN7QSn-wQ7kNvwE6KzYn&_nc_oc=AdrAhELmr6PjT-2Hc_2EX6AnoLSB-isLK9CK1r1dhW_7tU3YRjH9zGu9YPQBNsVrSP8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOQNcdNIzbRvO55DoGfp6PTKnDVi4TxwArZBDKE3BjCQ&oe=6AF9C90C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hero Cover.png", "id": "1631722188320519", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499620532_1631722191653852_5943683113533786268_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjMSDFV7EroQ7kNvwGhfXgO&_nc_oc=Ado2k86TaUVcD5ESRw1Hzdpk7ChcUG_Y4wgE1c5UqBzDz90hsy84ZHWyvEEtsY4x_fA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqA8ym58QCwP3a4NvGjYa69Ag6O_PSPS7UNyfmkjCWqQ&oe=6AF9C90A"}, "display_name": "Stress Buster", "keywords": ["stressbuster", "balloon", "balloongames", "sportyxr", "popgame"], "long_description": "Every pop counts in **Stress Buster by sportyxr!** Pop balloons, avoid bombs, and time your abilities and power balloons to chase your highest score.\n\n**PLAY YOUR WAY**\n\nPlay in a 3D virtual room or your real surroundings with passthrough. Use VR controllers or your own hands with hand tracking.\n\n**FOUR GAME MODES**\n\n- **Classic:** Three bomb hits end your run.\n- **Arcade:** Chase your best score in 60 seconds. Bombs deduct 50 points without reducing lives.\n- **Multiplayer:** Create a room, share the code, and play with friends.\n- **Event:** Enjoy special events with new backgrounds and event music. Round duration follows the song.\n\n**CHOOSE YOUR ABILITIES**\n\nEquip two abilities at a time, one per hand. Pop 20 balloons to enable ability use.\n\n- **Magnet Pulse:** Pull balloons closer for 3 seconds.\n- **Shield:** Protect yourself from bombs for 3 seconds.\n- **Slow Field:** Slow balloons for 3 seconds.\n- **Echo Pop:** Trigger a nearby balloon-popping chain reaction.\n\n**POWER UP YOUR SCORE**\n\nNormal balloons earn **+10**, golden balloons earn **+50**, and bombs cost **-50** points.\n\n- **Double Strike:** Double points for 5 seconds.\n- **Golden Rush:** All balloons turn golden for 5 seconds.\n\nCheck player scores on the leaderboard and make every pop count!", "short_description": "Pop balloons, dodge bombs, and chase high scores in Stress Buster! Play in a virtual room or in your real surroundings using passthrough, with VR controllers or hand tracking. Equip two abilities, trigger power balloons, and enjoy Classic, Arcade, multiplayer with friends, and special events."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sportyxr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "SportyXR", "support_website_url": null, "website_url": "https://sportyxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["e
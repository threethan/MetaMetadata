20f&oh=00_AQS4Qr-YTc__0yS2bySWzp8Zqzz6VRxo3Su-CXmGFnS_PA&oe=6AF9B609"}, {"file_name": "Room Create View.png", "id": "322418487619741", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75375768_322418490953074_6308219602231064684_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDmxYhylgJgQ7kNvwEfnD4y&_nc_oc=AdpexBwsu9etWHERJi9seP6itlGM6accXDKQuWqW6hUTcelivaKasT2Aan4-zLkXm-U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxtIszvjvt_0MavKQ874O0gpxVkfUJqO4M_BNLDbP_bQ&oe=6AF9C43A"}, {"file_name": "Mode View.png", "id": "1900866173765286", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86610709_1900866177098619_628125805260548948_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TUTispisfAQ7kNvwEVR_UG&_nc_oc=AdoQhc4CWyHU-5uivhBQc25j_DkjWgabaRbVjSOYyvZbRk-nlWlRpf62yQts7dlL89U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6_ieZBEWvFVNIdA4pNXZVBS4j_QRncH3vnLKKJ2Z9yQ&oe=6AF9C3BF"}, {"file_name": "UI View.png", "id": "1049027436613741", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031628_1049027439947074_8056414187091788098_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SqcM5q5pGsQ7kNvwGA3dQ7&_nc_oc=Adq9opQiPgoNUnh7pe4_y9prpDtznTqiMzU_N7n6hYoFHMRuvEmUtA6mta6gabkHXv8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9cZRQzZv971z9zC20Ni5Cd1Lo9-guGaQfOLCpLWKimQ&oe=6AF9DE43"}, {"file_name": "Mode UI View.png", "id": "1574364160128039", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974714_1574364163461372_1111073213499913598_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNqp-Aa_wcoQ7kNvwGGhyvv&_nc_oc=AdoL8Gdb2xPBEZXfjN8tJ36f-etl7H_5Y6qNLk-jvJEUI1bimmWfT_rRj3xehyJnprA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvdD9bC0IY2_YQACHihGLKbbKBtWlYl99mgUimrd5hgw&oe=6AF9BF85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer cover image.png", "id": "488958403744146", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75294244_488958410410812_388897917011316775_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6dfnepVf_AEQ7kNvwFoQh4H&_nc_oc=AdpE7D87OgIDI3UY8TH7KZXq-PvBnad8VdHMf6gsvq673BfOiFlue4OcpaHZEUjisqg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwuRzP5eUv8Gh9DyOWt7XU42bsZnXsItdy89FfrFu_hg&oe=6AF9D68F"}, "display_name": "VRCarCamping", "keywords": [], "long_description": " A new VR experience has arrived in the MetaQuest store for you: \"VR Camping Customizer\" is a unique game that combines car customization with the fascinating natural environment of virtual reality. More than just a camping experience, this game offers players the freedom of car design and the opportunity to explore different natural terrains.\n\n- Car customization: Players can design their own vehicle, apply a variety of accessories and customization options, and each vehicle can be fully tuned to their personal preferences.\n\n- Variety of natural environments: Players can explore different natural terrains, including mountains, oceans, forests, and more, and experience the beauty of nature in a realistic way.\n\n- Freedom modes: Create, share, and play modes with your friends to freely explore different camping areas. The camping experience in different environments is realistic and exciting on every level.\n\n\nPlayers first customize their own vehicle and then take it on a virtual camping trip. Each camping area is filled with unique environments, sounds of nature, and lifelike details. The game utilizes a realistic VR platform, giving players an authentic nature experience.\n\nFuture updates coming soon:\n- More car options\n- New camping locations and content\n- Tools for easy modding\n\nDownload the \"VR Camping Customizer\" from the MetaQuest store and enjoy adventures that are impossible in real life. The freedom of traveling in a virtual world is waiting for you.\n{1562070551182401}\n{7933566916698049}\n{566139789070580}\n{2087543311640085}\n{520874930469929}\n{862687135286693}\n{1024178352716116}", "short_description": "Welcome to the new world of virtual car camping!\nMake your custom item !\nCustomize your car !\nPlay with friends !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pamechanic.tistory.com/entry/SimulFatory-%EA%B0%9C%EC%9D%B8%EC%A0%95%EB%B3%B4-%EC%B7%A8%EA%B8%89-%EB%B0%A9%EC%B9%A8", "developer_terms_of_service_url": null, "publisher_name": "Not Exist", "support_website_url": null, "website_url": "https://pamechanic.tistory.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "8533361076686687"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1054927459387241"}]}, "baseline_offer": {"id": "1054927459387241"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1728485700, "status": "PUBLISHED", "id": "1054927459387241"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23957457263850485", "version": "0.1.31"}, "id": "630819515817021", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6772767489412730", "is_concept": false, "latest_released_binary": {"__typename": "An
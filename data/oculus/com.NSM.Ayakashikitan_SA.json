_833930870858181_4700514849234738106_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsPoyk6lV5kQ7kNvwHSZ_fq&_nc_oc=AdkYxpwv_JlT3kBHB9DcRP864gFmuM8Ek0ruFxHu9sy0ukcs5z56zJDO1Y265YAhTR4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzS1wGqV8JvK6NN0yjLuxWy_8cdcK1GBODrZ44SivUrkQ&oe=69B02B8B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AYAKASHI KITAN", "keywords": [], "long_description": "\"AYAKASHI KITAN\" is a Japanese-style horror action VR.\n\nIt is an adventure where the shrine maiden and her disciples become a phantom called \"AYAKASHI\", confront the mighty evil spirits that prevail in the city, and save the world.\n\nBy adding an element of exterminating evil spirits to the Japanese-style haunted house, even those who are not good at haunted houses can enjoy it.\n\n\u25c6\u25c6\u25c6\u25c7\u25c7\u25c7\u25c6\u25c6\u25c6\u25c7\u25c7\u25c7\n\nCollaboration with virtual YouTuber Kimino Miya!\n\nLife-sized Kimino Miya is appearing as one of the shrine maiden's disciples! She will have an adventure with you.\n\nAudio and subtitles are not localized.\n", "short_description": "AYAKASHI KITAN is a Japanese-style horror action VR.\n\nIt is an adventure where the shrine maiden and her disciples become a phantom called \"AYAKASHI\", confront the mighty evil spirits that prevail in the city, and save the world.\n\n\nCollaboration with virtual YouTuber Kimino Miya!\n\nLife-sized Kimino Miya is appearing as one of the shrine maiden's disciples! She will have an adventure with you.\n\nAudio and subtitles are not localized."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nsmweb.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "NSM_xRLabo", "support_website_url": null, "website_url": "https://www.nsmweb.com/works/ayakashi-app/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": 
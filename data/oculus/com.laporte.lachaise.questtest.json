9eZkMr8GXxJ1-DzxwNY7fxy2ZuICbwPEHDMSa8yVNmfTTZSrOZc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJQC0CO4I0aINjrh0hn4wyRWR30MumfXnnXfpP4H_y0w&oe=6AF1F685"}, {"file_name": "8.png", "id": "960789359885080", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593801605_960789363218413_3146228071517062954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BdOrdS7IT3YQ7kNvwGILF-_&_nc_oc=AdoIMe619Ripexp0ljQtrEknx4hP-x82K04ys2pOqYD5axRyO5ICAlAL3tyjNkTclq0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUxiAbX_ernnEAke4vwz3vdm7WGnMX3_re_3L7C8jq-Q&oe=6AF1E7ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "O\u00f9 vas-tu comme \u00e7a ?", "keywords": [], "long_description": "O\u00f9 vas-tu comme \u00e7a?\nA Journey Through Space and Time\nWhat paths have humanity's spacecraft traced through the Solar System? Where did they go, and where are they heading now?\nO\u00f9 vas-tu comme \u00e7a? invites you to explore the history of space exploration from a new perspective.\nSit in a chair near the Sun and watch the journeys of spacecraft unfold around you. Follow Voyager 1 and 2 as they travel beyond the planets, discover the intricate orbits of planetary probes, and experience the vastness of space.\nTwo Ways to Explore\nVoyage \u2014 Discover Space\nMove freely through a three-dimensional Solar System. Find spacecraft, planets, and significant moments in exploration history.\nHistoire \u2014 Discover Time\nSee spacecraft trajectories extending through space and time. Each path tells a story of departure, discovery, encounters, and journeys still continuing today.\nExplore at Your Own Pace\n- Follow missions including Voyager, Pioneer, Apollo, Cassini, Juno, and Parker Solar Probe.\n- Discover historical events along their journeys.\n- Observe trajectories from unexpected angles.\n- Experience the relationship between distance, direction, and time.\nThere are no scores, enemies, or missions to complete. Just curiosity, exploration, and the freedom to look around.\nWhere are you going?\nPerhaps the answer begins with a chair near the Sun.", "short_description": "Explore the history of space exploration in an immersive 3D environment. Follow the paths of Voyager, Pioneer, Apollo, Cassini, Juno, Parker Solar Probe and other missions through space and time. Move freely, discover key events, and experience the scale and direction of humanity\u2019s journeys beyond Earth from a new perspective."}]}, "developer_name": null, "developer_privacy_policy_url": "https://laporte727.github.io/ecole.la.porte/lachaise.html", "developer_terms_of_service_url": null, "publisher_name": "La Porte", "support_website_url": null, "website_url": "https://laporte727.github.io/ecole.la.porte/laporte.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1196267113580654"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593809430_2195115617705807_3668577298600828953_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lg9DSCtrOU8Q7kNvwE_Ckuz&_nc_oc=AdqdFZgrFYnnEVdYx9igj1gD0p6-wS_4tHqMNfewZbKsLzVmswX-Un9rEN1PRZTwdUY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6L68DnEVHnVOfDum1EjIlHV1cPjnlV0vFgP5wuYhSJg&oe=6AF1D8F2"}, "is_concept": false, "is_test": false, "is
yQ0JU6LkQ7kNvwFdfxSd&_nc_oc=AdrKEJ1J2TTksnlZRHZbWtdOSgaTGyiXzRvONMeWVTEPRBgOWmA_lfab2cdyerBKbK0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14sHO05shTwJxYtL8fFW3GBV9PXGn94cWVidHaOiw8HA&oe=69E0CDFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bWTSzx", "id": "1427166791004962", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569484_1427166794338295_2825022452705263616_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GAqNNFv3hIQ7kNvwFI-S6a&_nc_oc=AdqNGzaN_jQBZgsctXBugnJgYbM1Jwfxo--x2jiEwIkFQQ2uvQbHZTwkHlkDeHzxERs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ng0r7hsL4XwbvxP1IaSkkLU1tgqj_LoDwje35mnb0sw&oe=69E0E88F"}, "display_name": "ecosphere", "keywords": ["Nature", "Wildlife", "Animals", "Education", "Travel"], "long_description": "Venture into the wildest places on earth and meet the humans protecting our most precious wildlife. Explore the great savannahs of Kenya, discover the ancient jungles of Borneo and dive into the rich coral reefs of Raja Ampat. Encounter elephants, orangutans, manta rays and some incredible humans, all in stunning cinematic footage filmed from the air and deep into the ocean.\n\n\u2018ecosphere\u2019 sets out to redefine the limits of 3D-180 cameras, natural history storytelling and conservation filmmaking. Travel to nature\u2019s most fragile and diverse ecosystems, where indigenous and community-led efforts are creating space for humanity and wildlife to thrive together.\n\n\u2018ecosphere\u2019 is an uplifting nature documentary series by the award winning studio PHORIA. Produced in partnership with World Wide Fund for Nature (WWF), Silverback Films Ltd and Oculus, this groundbreaking series is narrated by Emmy Award winning actress Anna Friel.\n", "short_description": "Venture into the wildest places on earth and meet the humans protecting our most precious wildlife. Explore the great savannahs of Kenya, discover the ancient jungles of Borneo and dive into the rich coral reefs of Raja Ampat.\n\n\u2018ecosphere\u2019 is an uplifting nature documentary series by the award winning studio PHORIA. Produced in partnership with World Wide Fund for Nature (WWF), Silverback Films Ltd and Oculus, this groundbreaking series is narrated by Emmy Award winning actress Anna Friel."}]}, "developer_name": "PHORIA", "developer_privacy_policy_url": "https://www.phoria.com.au/documents/privacy-policy.pdf", "developer_terms_of_service_url": "https://www.phoria.com.au/documents/terms-of-service.pdf", "publisher_name": "PHORIA", "support_website_url": "https://www.phoria.com.au/", "website_url": "https://www.phoria.com.au/projects/ecosphere/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "TRAVEL", "DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7773914192634706"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2545574122476228"}, {"status": "PUBLISHED", "id": "274755760387067"}]}, "baseline_offer": {"id": "2545574122476228"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1762490940, "status": "PUBLISHED", "id": "2545574122476228"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6240940265970677", "version": "1.2.2"}, "id": "2401360093316813", "channel_name": "LIVE"}]}, "is_for_oculus_keys_o
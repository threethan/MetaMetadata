-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2QbXuV_b-s4t0SLCbm2vv7Wo2ZpWJype4Lzzj15Sy7w&oe=6AFB30E9"}, {"file_name": "8WxPrn.png", "id": "541918229816758", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974819_541918233150091_172458888442937344_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87uLi_eAe2IQ7kNvwG1-lWa&_nc_oc=Adp1YJb3u6grTw0N5nSEHeHUG8UwDcMxm8r75hCNVRCW63EYocAui1VlkZQ8ThXjkN8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6dHZg_v0MuVXX-wIQax3aOTLcI-5AeyySPS3i_Qru7A&oe=6AFB273E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bWTSzx", "id": "1427166791004962", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57569484_1427166794338295_2825022452705263616_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOmw1P4EpyYQ7kNvwHzo9h1&_nc_oc=AdrlUp1snaK60U-uqsJ2-pRr737fzGI5RpZ_9vSxO-XnHqTLhsNMD4qNSPE5WB7ffdU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4BRjmmBSNfMU1kCoQgGzQn6aYgZy79aovLhRsUsHv3A&oe=6AFB41CF"}, "display_name": "ecosphere", "keywords": ["Nature", "Wildlife", "Animals", "Education", "Travel"], "long_description": "Venture into the wildest places on earth and meet the humans protecting our most precious wildlife. Explore the great savannahs of Kenya, discover the ancient jungles of Borneo and dive into the rich coral reefs of Raja Ampat. Encounter elephants, orangutans, manta rays and some incredible humans, all in stunning cinematic footage filmed from the air and deep into the ocean.\n\n\u2018ecosphere\u2019 sets out to redefine the limits of 3D-180 cameras, natural history storytelling and conservation filmmaking. Travel to nature\u2019s most fragile and diverse ecosystems, where indigenous and community-led efforts are creating space for humanity and wildlife to thrive together.\n\n\u2018ecosphere\u2019 is an uplifting nature documentary series by the award winning studio PHORIA. Produced in partnership with World Wide Fund for Nature (WWF), Silverback Films Ltd and Oculus, this groundbreaking series is narrated by Emmy Award winning actress Anna Friel.\n", "short_description": "Venture into the wildest places on earth and meet the humans protecting our most precious wildlife. Explore the great savannahs of Kenya, discover the ancient jungles of Borneo and dive into the rich coral reefs of Raja Ampat.\n\n\u2018ecosphere\u2019 is an uplifting nature documentary series by the award winning studio PHORIA. Produced in partnership with World Wide Fund for Nature (WWF), Silverback Films Ltd and Oculus, this groundbreaking series is narrated by Emmy Award winning actress Anna Friel."}]}, "developer_name": "PHORIA", "developer_privacy_policy_url": "https://www.phoria.com.au/documents/privacy-policy.pdf", "developer_terms_of_service_url": "https://www.phoria.com.au/documents/terms-of-service.pdf", "publisher_name": "PHORIA", "support_website_url": "https://www.phoria.com.au/", "website_url": "https://www.phoria.com.au/projects/ecosphere/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "TRAVEL", "DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7773914192634706"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2545574122476228"}, {"status": "PUBLISHED", "id": "274755760387067"}]}, "baseline_offer": {"id": "2545574122476228"}, "is_ap
": "en_US", "screenshots": [{"file_name": "mjjnCw.png", "id": "284806329367056", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568680_284806332700389_325656772708663296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohQbd1xnRQwQ7kNvwFGyV_n&_nc_oc=AdnYvz_3ZKNe5GuoKED1GMWIxCvlQtiLaknUq3Pyzgxy0rfle43w9Jv0xkxcpAoNfBw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7-dvh4ub5rKRA9dffytScOlxCmJI9ntIxYryULcGMGw&oe=69AEC39D"}, {"file_name": "1jtYS9.png", "id": "249758936443007", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974812_249758939776340_7802935633768349696_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FCP1hFfkGMQ7kNvwFASDhr&_nc_oc=Adm7h198wQFtyA27tEBzv5Ub_aDdVbkOGbzpJwVOL26oDZ_IZUdD_CwNbPGUm-vebS4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyCYPIhzd2SzdYm7S3YbH9ei0_TZgfQaPot-cmRfbpSGw&oe=69AED392"}, {"file_name": "BWkmA0.png", "id": "266547704690328", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86625023_266547708023661_6215900683380457472_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsiJrrZQjlUQ7kNvwEsdfzN&_nc_oc=Admz0PD1TiP3X_en1FWFMGZWndeAJRhRxrO-5Rzdtvr1Avn9mJsF0jRxZWoQPF3Ajjo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz4IqQRm6Q_1KnmM7WUXpWfABJVQ6-OyuxGm4wdTAkM0Q&oe=69AED73E"}, {"file_name": "XItBRB.png", "id": "545446829479826", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031547_545446832813159_6768075143676690432_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoiPUQNqCeQQ7kNvwH7VsKZ&_nc_oc=Adna-co5Wh_aFW8RDk0jWzaoPwKh0JLYAPtcDsdFA63ZE0yRWB67JGScLdm3Z3D1E6Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRXS13GXyeM-n1bx1YxSAzlMQzMjU4lEW0wjnO4YN6qg&oe=69AEBEA9"}, {"file_name": "8WxPrn.png", "id": "541918229816758", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974819_541918233150091_172458888442937344_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgKg1H3O0jUQ7kNvwGwOAQ_&_nc_oc=AdmRQ8AcixDNFfGY4QfCfsOhA9owyvPcNPpqXjgFpgqrbdMUMAHnhqrsF4b7hvjEgWA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw28ArT11FocI-tO4bwWoDA6LwkuykZ_5eCGrSIWGTxYg&oe=69AEB4FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bWTSzx", "id": "1427166791004962", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569484_1427166794338295_2825022452705263616_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Amcv8gdi2sgQ7kNvwEQEhSh&_nc_oc=Adm20x4xwlF8avjWILx-KXFBeZYbWp6icKYExHJ_cM_tzKfANzfVb5yH0TZ0cXN2N2I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyViQCuYgbDcNN3pe5gQWtMkVfJES3Em5eDnycyCfsJ1Q&oe=69AECF8F"}, "display_name": "ecosphere", "keywords": ["Nature", "Wildlife", "Animals", "Education", "Travel"], "long_description": "Venture into the wildest places on earth and meet the humans protecting our most precious wildlife. Explore the great savannahs of Kenya, discover the ancient jungles of Borneo and dive into the rich coral reefs of Raja Ampat. Encounter elephants, orangutans, manta rays and some incredible humans, all in stunning cinematic footage filmed from the air and deep into the ocean.\n\n\u2018ecosphere\u2019 sets out to redefine the limits of 3D-180 cameras, natural history storytelling and conservation filmmaking. Travel to nature\u2019s most fragile and diverse ecosystems, where indigenous and community-led efforts are creating space for humanity and wildlife to thrive together.\n\n\u2018ecosphere\u2019 is an uplifting nature documentary series by the award winning studio PHORIA. Produced in partnership with World Wide Fund for Nature (WWF), Silverback Films Ltd and Oculus, this groundbreaking series is narrated by Emmy Award winning actress Anna Friel.\n", "short_description": "Venture into the wildest places on earth and meet the humans protecting our most precious wildlife. Explore the great savannahs of Kenya, discover the ancient jungles of Borneo and dive into the rich coral reefs of Raja Ampat.\n\n\u2018ecosphere\u2019 is an uplifting nature documentary series by the award winning studio PHORIA. Produced in partnership with World Wide Fund for Nature (WWF), Silverback Films Ltd and Oculus, this groundbreaking series is narrated by Emmy Award winning actress Anna Friel."}]}, "developer_name": "PHORIA", "developer_privacy_policy_url": "https://www.phoria.com.au/documents/privacy-policy.pdf", "developer_terms_of_service_url": "https://www.phoria.com.au/documents/terms-of-service.pdf", "publisher_name": "PHORIA", "support_website_url": "https://www.phoria.com.au/", "website_url": "https://www.phoria.com.au/projects/ecosphere/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "TRAVEL", "DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7773914192634706"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2545574122476228"}, {"status": "PUBLISHED", "id": "274755760387067"}]}, "baseline_offer": {"id": "2545574122476228"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1762490940, "status": "PUBLISHED", "id": "2545574122476228"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6240940265970677", "version": "1.2.2"}, "id": "2401360093316813", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename
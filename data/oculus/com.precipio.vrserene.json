vAQ7kNvwF7WzXl&_nc_oc=AdqW7BQPL5U0HItLXaB-owwQO0rQuAcpQF1JebZwUuRPNgcoiNmLAEsupG1JG1JPyqE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWHDardXaP339WlAAnjLu7rcrzdGINPxbsTZtcxDa6XQ&oe=6A8C25EC"}, {"file_name": "Serene-screenshots-Playing5.png", "id": "1401030701928333", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307470_1401030705261666_2656141254482985619_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysIx3ViomdoQ7kNvwFbToaq&_nc_oc=AdppL2AGoa2fmBYAsl8ey7oaN-IcFWL0OI01BJnS6J8yLo2LnEwgUnZWo1Sf02Ime0U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFR5u2YtNbJknu8dtgt6KGKfRpxH3dKSPmkdwh2FPJ9yQ&oe=6A8C31DC"}, {"file_name": "WhatsApp Image 2026-08-04 at 8.27.42 PM 1.png", "id": "1021058757363850", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499311585_1021058760697183_1362493445934997789_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LtnSomG6YQ4Q7kNvwF-OWKm&_nc_oc=AdqzHqmJ4JS8xgV9-svCmypB-1dZBRZiOGQU0s3N9Xkjg1I6vl_GTz8eChVIG9OgFwg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqxWaksTkSwCMaBZ3BGv5pDNBKtQtB28qwXEt9M44f1w&oe=6A8C4528"}, {"file_name": "585727769_1360043732895875_7156558315542908948_n.png", "id": "981054994952868", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312310_981054998286201_4354316805160970699_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9V_afKTjUcQ7kNvwExt8kE&_nc_oc=AdqoK9g-P28jZEkzUbgZr4e7YRr2X5p8x1JFjXGA2poLNnxalVFshlXl5jaCWSDi7uY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFd129rtd8b05EyphzA4S5wqR9XtiBxCeVk7osnVD3j5g&oe=6A8C2C3E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Serene Precipio", "keywords": ["serene", "precipio", "infusion"], "long_description": "\nTreatment days are long. Serene makes them lighter.\nSerene VR is a clinically informed virtual reality experience designed specifically for people undergoing chemotherapy infusion. Developed in partnership with Precipio \u2014 a leader in cancer diagnostics \u2014 Serene brings research-backed immersive distraction directly to the infusion chair.\nWhat Serene offers:\nStep into a world beyond the clinic. With a single tap, patients can leave behind the hum of infusion pumps and sink into handcrafted immersive environments \u2014 a sun-warmed coastal trail, a quiet forest at dawn, a meditation retreat perched above mountain peaks, or a slow drift through a coral reef teeming with color. Each scene is designed to occupy the senses fully: layered ambient soundscapes, 360\u00b0 visual environments, and gentle guided narration that invites the mind to travel, explore, and rest.\nWhy it works:\nResearch on immersive distraction demonstrates that engaging the visual and auditory senses simultaneously can meaningfully reduce perceived pain, anxiety, and stress. When the brain is absorbed in movement, wonder, and sensory input, it has less bandwidth for discomfort and worry. Serene is built on this principle \u2014 not as a novelty, but as a purposeful therapeutic tool.\nBuilt for the clinical setting:\nSerene is designed to be simple enough that a nurse can hand it to a patient in under a minute. No controllers required. No complex menus. Patients look, breathe, and travel. ", "short_description": "Immersive escapes designed for patients in cancer infusion treatment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://serene.precipiodx.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Precepio", "support_website_url": null, "website_url": "https://serene.precipiodx.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": nul
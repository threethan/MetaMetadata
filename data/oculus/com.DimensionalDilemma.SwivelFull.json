AE0B99C"}, {"file_name": "YES3.png", "id": "25662881226690906", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75520122_25662881230024239_6299176207333418075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5tC4O-CYbwQ7kNvwHvqjz5&_nc_oc=AdpI66tlVegvUtPk7tsdF35QbS1bCaR9KHwcmF6_9NDCzz9n7eg91Qwb2K-p5ZLCOow&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtbkS-wpoQ7yM0VtkrKUX3XXqfi953tNe91IiGQv8stw&oe=6AE09EF2"}, {"file_name": "YES4.png", "id": "1354074085262388", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974741_1354074088595721_9212956591605280011_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B33VTyszcEEQ7kNvwEZQFIB&_nc_oc=Adp3vospuPsyDhuCXGhZDA2x1XZwLcIHO838fiSPqcYcBM7JeWvIga6eSmT5YWOZTqU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjoOWlGn44HUANHrDCU8_i3kv9jeKifenXZUS22w2TpA&oe=6AE0AB80"}, {"file_name": "YES5.png", "id": "1433907864677225", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974905_1433907868010558_5661496313997694104_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iv_uowSXMSwQ7kNvwH0evY3&_nc_oc=AdpoM6knwN_T6_jUJbC5XoDWw3v9vHeyLXf6oXvH_kkSc9VY7JSSobwrF1iZdwP59bQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-MrQdhqi1-267NtR3AtlFd9A1sJqZwl_JIWjj9Ob_cw&oe=6AE096EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "782721247326589", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/427384304_782721250659922_2238916620449805730_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QATehTLUfN0Q7kNvwEUMwYI&_nc_oc=Adq3nr_kZ_StDfOItjfBs5FTG4ct628KzM-enuR_-yk_YXHyhPfE2pK00KW1ydtT3E0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAPJBYsu9Yf7DvaoKuZLJvJg-t3c2nxI45weMuXfK9cQ&oe=6AE095FD"}, "display_name": "Swivel", "keywords": ["spin", "ride", "rhythmic", "fitness", "seated"], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style:\n- Fly - pop\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": "https://www.swivelvr.com/contact-us", "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": []
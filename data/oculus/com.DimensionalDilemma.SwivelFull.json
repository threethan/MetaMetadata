5771-25/75520122_25662881230024239_6299176207333418075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEPi6aAYP64Q7kNvwF6iKj_&_nc_oc=AdlLmhCUTHZY5EBockz2CkLR1JOEcKFJGpYZDsiAMWfg_P1P0wuN-hRMpOv9tAkP0-8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftS_up6oMnMhh_-f5htaj1SR9PFKMo7fUqrMLa-59wlMg&oe=69A82B72"}, {"file_name": "YES4.png", "id": "1354074085262388", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974741_1354074088595721_9212956591605280011_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MehS2oI8ZDQQ7kNvwFqTZp5&_nc_oc=Admag5fPQo1Im_e21VOaH3Z8Vh6iBBxhbCR3V8lILCHo89GH2ZuBCDwQfE-b8lRqI1g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftHDzixubfBUWmj25JdbLCYKjXW6JWVV7AAKn3c5z3Hkg&oe=69A83800"}, {"file_name": "YES5.png", "id": "1433907864677225", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974905_1433907868010558_5661496313997694104_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tz8Tsa0t0q0Q7kNvwHGTJ0W&_nc_oc=AdnToGM7y3A97NI5SDKpcRI-3VG2OzjGlHYknUeApTpaSrX122KFRpjxAl5xIKoHC-U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvQ1yb1JpYnXsZBpUucC-FwlnjlVe8ONMUsIKBSbqaM1A&oe=69A8236F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "782721247326589", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/427384304_782721250659922_2238916620449805730_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBDucqdKFGwQ7kNvwGZYoZI&_nc_oc=Adl_7jHByJjeo3OONpdQCav-CNW-wN6ZhLzVWPXIfGoAmHuluZ4VOEQWf_YpEG02QWM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftbzcLwBwRoSaHwsBYJKsagFvyJTHce0DbypMoX4BaM-Q&oe=69A8227D"}, "display_name": "Swivel - Full version", "keywords": [], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe:\n- Fly - pop (free)\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": "https://www.swivelvr.com/contact-us", "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMEN
zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0E56vMZvo_OL19lH1MTDMdfNFtdzeI2uf2cvWA0R6ARA&oe=69F0ADF2"}, {"file_name": "YES4.png", "id": "1354074085262388", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974741_1354074088595721_9212956591605280011_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dc2zEnshBWAQ7kNvwE7_v5i&_nc_oc=AdoztX1UwOQEoscVa-rEZHOphelFkRutaaKqcIHQzSN6s4wpS3bGFud5nVwIfTi0H3U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0dQyzO9ndJCFpNdwe77W0CDECaWtNngRfBxq5jF4FtQg&oe=69F0BA80"}, {"file_name": "YES5.png", "id": "1433907864677225", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974905_1433907868010558_5661496313997694104_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2mcgSWyUzsQ7kNvwEliK3r&_nc_oc=AdrxJuzvRH3McQJyEx232-xy4RqgFOC9GQcasaVSCLc-sbKya920_UbHjruGvXNze1o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1uOwSiypMc1ehgeh_pPGpymVesvwji7bqfvST_e-c2Tw&oe=69F0A5EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "782721247326589", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/427384304_782721250659922_2238916620449805730_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9e17KkqoYYQ7kNvwF_wC6c&_nc_oc=AdqU5w6ePjv6wyb9h1FfSRLH3vs50MCY6b-JDeAkF5RCu6STmC2wV4igYwaMclwY74U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1YjmVd5Z0wJvuF_oeXLnn3Djh3ZES_rm7PHzftUDnvPg&oe=69F0A4FD"}, "display_name": "Swivel - Full version", "keywords": [], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe:\n- Fly - pop (free)\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": "https://www.swivelvr.com/contact-us", "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_mo
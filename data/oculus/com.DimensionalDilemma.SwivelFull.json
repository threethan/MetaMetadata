sid=6e7a0a&_nc_ohc=URd79hdSONIQ7kNvwHUyLi_&_nc_oc=AdplUHrobLBZRklI1-e0xkUfJ9W1U8xGs7dRVul17I1cue2blFCKuRh1rQ5m9Vhkcvs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQu-oMTl8xm0bJOVy5xOMBIc7WMGqGTrYI8aXBU-nefPQ&oe=6AFC691C"}, {"file_name": "YES3.png", "id": "25662881226690906", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75520122_25662881230024239_6299176207333418075_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-6xzBsPnfkQ7kNvwHLQPPy&_nc_oc=AdpPYMDYD_4A--uUcWKDaWGeVmMvLFotS0dCmzmG4-h5zq4BSVFmASLtDmSFzQSFz8I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgMLfow0nGgq5xuUUswdSomrcEn7lbBPTEeX7chpcGYw&oe=6AFC86B2"}, {"file_name": "YES4.png", "id": "1354074085262388", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974741_1354074088595721_9212956591605280011_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkwTafvGIuwQ7kNvwE88tld&_nc_oc=AdoCubcpicENUnswcWcGTKdLuO4fsg3SYA9haMAnBft6S8Dqqjw8-dVzMTaVyB08JyY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIgr-AapX1aj5fZ5se-Y1Qvo9ebfzDF_sRNcBLPS4uBg&oe=6AFC9340"}, {"file_name": "YES5.png", "id": "1433907864677225", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974905_1433907868010558_5661496313997694104_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcMnOYGwJ84Q7kNvwF8zB4L&_nc_oc=AdrssovXwaC3zhsE8BGAmM6aJqAujqT-2q9TK05E1sSI62iBD_NnqWqooTlncKR1gkA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3VqBWdOTFChcxKnvGmeG-PESdf8XDfpbntadodhi5gA&oe=6AFC7EAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "782721247326589", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/427384304_782721250659922_2238916620449805730_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nuMHYUnhR8Q7kNvwGUeIo0&_nc_oc=Adoecv8ZG17kgU9Cv3S5t3ag8vJdO_o51q5UOPfzta_nIw7S_UsfBu-KJnCPJChodP0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSB3EqIRHU9Zsf7AqDffNUCv61AGnvnxiitdmNTsOVqeA&oe=6AFC7DBD"}, "display_name": "Swivel", "keywords": ["spin", "ride", "rhythmic", "fitness", "seated"], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style:\n- Fly - pop\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": "https://www.swivelvr.com/contact-us", "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7774007276038100"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031360_1572910846960835_8224561559878044455_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SneJQLlGg4UQ7kNvwElq4HF&_nc_oc=AdrdqLx8CXFCytQEwCByt4-edsM3FNae_VwRi1v7KakoKYF3exWp8ZMqmNKXJwoXaLg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJhQ3HVoMA6ObYM8zzkaLvudp8Km6UHphjouW9K15HiA&oe=6AFC6BF8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Swivel", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1717102740, "lastRevision": {"nodes": [{"id": "7277099832395516", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7277099809062185", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "418267027782258"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {
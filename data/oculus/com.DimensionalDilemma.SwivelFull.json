771-25/75520122_25662881230024239_6299176207333418075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hf0b4A5-j0Q7kNvwGq7466&_nc_oc=Adl7trGVTxErI1VRnhy3XEpebL7X4bGAQmJlvPCxweAhW5ZA9Fd4A63HZo9JBE2_Ci8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftN40Mme4PVoGg3aD0K8gQP4fqTbm3fPI4OMMdUayHEOw&oe=69A436F2"}, {"file_name": "YES4.png", "id": "1354074085262388", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974741_1354074088595721_9212956591605280011_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bg8mjzFeEBIQ7kNvwFX6lvW&_nc_oc=AdkQJyOgPGlUMmJ9QJr_4E09KZUNR8mL_CZEzbKYpJqSXIPUnC7JD6_jBY13U2AlOos&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftoTJYFi9TG2wYlVZ_jlt6tze1mhk2gNoNDyfoRYPNGpg&oe=69A44380"}, {"file_name": "YES5.png", "id": "1433907864677225", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974905_1433907868010558_5661496313997694104_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAO8uiCkULYQ7kNvwFIe_rE&_nc_oc=AdmYTeeqH7YpdjwNG7pk7R_EMhZ-Fq0n_l6RnHEF2sVWSftLKUrWeDA6fyQuPsIfxso&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuKUbHXMsbZDd72YhHwvfWOAI7D-UmJXSLRMHbsmnweJA&oe=69A42EEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "782721247326589", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/427384304_782721250659922_2238916620449805730_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ei_g48E7RTQQ7kNvwHLDgiv&_nc_oc=AdkPV5Arly10-7ShsCSjJE_gKCt7OirRFnwor8-I3vV_3vLB_xhzCqNYuqCj_C4xsuQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu_-JuX4p1mLpbunw2EPYCW1_lQl0CEd1I7yTk7KgLLgg&oe=69A42DFD"}, "display_name": "Swivel", "keywords": ["spin", "ride", "rhythmic", "fitness", "seated"], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style:\n- Fly - pop\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": "https://www.swivelvr.com/contact-us", "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
A14611C"}, {"file_name": "YES3.png", "id": "25662881226690906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75520122_25662881230024239_6299176207333418075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dx6NKnO3VZ0Q7kNvwH9aFSB&_nc_oc=Adp6fR7A59G6tIvsZTF3WuCb6qhiz34ArDveYKlJ-OSQ09ivxYgVPcGOuRwlNNQoaJk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5m1k4vgFnfIoLpWIBxA45n8J3INAsT2LsaRDEmgvjYtA&oe=6A144672"}, {"file_name": "YES4.png", "id": "1354074085262388", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974741_1354074088595721_9212956591605280011_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q59XyEf_IVgQ7kNvwEtQ9Ex&_nc_oc=AdqL55fXIhY1f08to1pUMWQ-G1RdVj5QivqNQ5qVJ9GLQtuFpYS6A4o33TOm8q10mUM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fwUU9r6aeButGXKnKJNjzEecB2ScavE6c2ihgFva7dQ&oe=6A145300"}, {"file_name": "YES5.png", "id": "1433907864677225", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974905_1433907868010558_5661496313997694104_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=816eLUTtN2YQ7kNvwFpqjyz&_nc_oc=AdoN77J9ZeLIh3zWbkhAMyECGAZ71aU1_wAD4PS52sbinIY-ZkyjM6j_JF1ezFGQvCQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VFglOSHBgjyT00Y79qrfMX9T_Ch0hik9vRQG8fGvPJQ&oe=6A143E6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "782721247326589", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/427384304_782721250659922_2238916620449805730_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y06aQG6UT7AQ7kNvwHzmthX&_nc_oc=AdrJogDYekfJ8zYor6CzV6xJ4F3WKSSKzaJXfFD3IGvQ_xaIrRFudHHxotTI9kpeMMo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gfNP7agipTwpFvmzsIx7Sxx3WgxL5M7kqWLJLlnjzjQ&oe=6A1475BD"}, "display_name": "Swivel", "keywords": ["spin", "ride", "rhythmic", "fitness", "seated"], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style:\n- Fly - pop\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": "https://www.swivelvr.com/contact-us", "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": []
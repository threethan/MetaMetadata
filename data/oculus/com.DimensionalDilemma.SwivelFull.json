A1C4A1C"}, {"file_name": "YES3.png", "id": "25662881226690906", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75520122_25662881230024239_6299176207333418075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pyW546IJWmwQ7kNvwHJ5P6T&_nc_oc=AdpCwZhIY-umCG0wpzpXHTARgIY2Xakk8QgzsDLu2rz7SEqTePubu67bH_5dcDvcnLw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dUAr23HLCWTNfIYUVnSe4PO4ieMXOhke6gfeIThUuFw&oe=6A1C2F72"}, {"file_name": "YES4.png", "id": "1354074085262388", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974741_1354074088595721_9212956591605280011_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B14jDvoWWBYQ7kNvwFIl9ea&_nc_oc=Ado75dFlmV6_Qg48iw8F5uG-9BmjxcVQjzjtQKyS-kvNR22QMjjSAnujAsdCbSLk1Y8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PEhE-uf67xr2andVH0kuW0106Xfep8XGUvlzYOI_IlQ&oe=6A1C3C00"}, {"file_name": "YES5.png", "id": "1433907864677225", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974905_1433907868010558_5661496313997694104_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HG9YlEEDJ2sQ7kNvwER9xuQ&_nc_oc=AdoXlJIQkEmqqLhfjMeXOg2YBQ7yNl3sydJyI6r-79HbdHQgO9kgNvnUlJI68kqXHJE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-1Olcsrkq7T8_R76Wy7UQL4VbPK_s3-s_YLEWHs9A5g&oe=6A1C5FAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "782721247326589", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/427384304_782721250659922_2238916620449805730_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDAM9YfkSaoQ7kNvwETuklA&_nc_oc=AdpQ4HF1kA0LO8orOJYL_UWXkTzL1e4_JGtqDomVovqO9N3l6xlYUMefo-z_hGViBWY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SAylxXGUIuwRTYKAnLOsAqqIlJsplfEh-NNd3iY6r_g&oe=6A1C5EBD"}, "display_name": "Swivel", "keywords": ["spin", "ride", "rhythmic", "fitness", "seated"], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style:\n- Fly - pop\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": "https://www.swivelvr.com/contact-us", "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": []
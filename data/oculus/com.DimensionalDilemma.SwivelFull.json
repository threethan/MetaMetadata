sid=6e7a0a&_nc_ohc=URd79hdSONIQ7kNvwHxrv2o&_nc_oc=AdrMsnd8OBAry6f3Y_tNRYAVeeC8gc-M3X5dqnpSwVkH2F6QjHRLFY4JONNZRtWzIjw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnDEfgjywlHIwI-MrEQ5ZHSamyT_OVgenbBshd5-9JjQ&oe=6AFB179C"}, {"file_name": "YES3.png", "id": "25662881226690906", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75520122_25662881230024239_6299176207333418075_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-6xzBsPnfkQ7kNvwGbd6Fc&_nc_oc=Adpz5J7AqaSXKc6QfBpnO5Aza9n2FL20Vm_QV8DY25hHzCapW__upKD6u2GDk11nAao&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7Ax3lPeKmm88kPvH0u2C5UOSvpyqLxUuUUvZNhjDrjg&oe=6AFB3532"}, {"file_name": "YES4.png", "id": "1354074085262388", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974741_1354074088595721_9212956591605280011_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkwTafvGIuwQ7kNvwEKrA3N&_nc_oc=AdozC8EOkInE1cVD-GY4nETDtzTV69GzW1jRb7WSKWyG-pBD7jxu0EuHW6v-LLQFONE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHe9p-dy5ADmrd7LZpxyZyVHoojcVsu1d_PFoIGsoyXA&oe=6AFB41C0"}, {"file_name": "YES5.png", "id": "1433907864677225", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974905_1433907868010558_5661496313997694104_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcMnOYGwJ84Q7kNvwGCx7ow&_nc_oc=AdoCH0pFRc-j8aYOL04pLXTP2nxaQD52qhbwG6d723w0dn_hAxyQvz9n3dBmygaMYTI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAv_YsLIHMXrPWDrEIwOLigotU7yITA1QTFMe-QJKAEg&oe=6AFB2D2F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "782721247326589", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/427384304_782721250659922_2238916620449805730_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nuMHYUnhR8Q7kNvwG-HFRt&_nc_oc=AdoPFGpesb6TbTdRo4vLGlB2a_t9ndZ064s2W6Ul0rlUWd3EenDw9y5uoIcFRSmDoAQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUR9uwsII7mR-wjF09vGxreTozj4l1E9Iq1OmkgurZkg&oe=6AFB2C3D"}, "display_name": "Swivel", "keywords": ["spin", "ride", "rhythmic", "fitness", "seated"], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style:\n- Fly - pop\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": "https://www.swivelvr.com/contact-
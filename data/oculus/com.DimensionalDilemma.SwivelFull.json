sid=6e7a0a&_nc_ohc=8JaOkLLML94Q7kNvwHGHD8o&_nc_oc=Adr2NVXisedKY2ZqSG391cxy60P8QUKH_O_48CwExnqIn5vtGbDC5kStZIyjQTKPeCk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmY80Ruyy4USRucqqks2IxoGYgTt-8jJTujBzTHkjcww&oe=6B04521C"}, {"file_name": "YES3.png", "id": "25662881226690906", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75520122_25662881230024239_6299176207333418075_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYfxAfd0kUQQ7kNvwEb3M0V&_nc_oc=AdpPa7oHPsvTovxIg3xSUzNZj_bRFHlT4EQJ6QzboW57YNsQQjE7nCKOoxLhyBr03V8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStMj-mf85NTsqH9n8MdGudMfjFcT6Ku5XLluLnAhKgRQ&oe=6B046FB2"}, {"file_name": "YES4.png", "id": "1354074085262388", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974741_1354074088595721_9212956591605280011_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-QxKzX8YGwQ7kNvwGaW3LU&_nc_oc=AdrHJkYmVHfH0gNPaTLI_wPxnrFgpysji9dpubrLnlm4wuPGoG1buQA2TRMlOwLHSng&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfgEzTygDyFPejc4Xx5GsFxhlojGb5lQxwLxrxw0GueA&oe=6B047C40"}, {"file_name": "YES5.png", "id": "1433907864677225", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974905_1433907868010558_5661496313997694104_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BiTtNT7RZ7EQ7kNvwHCSmvq&_nc_oc=Adqo_Bo4KQBt8-XzHdzdvo50nadUJiyYpczd6yVqORAuLhJ_CKLcpZ5Xe1wODxM-4Vk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZWHN3QbbHYx6abFtyFqhYHLjHuv98EKgZUrza90BYIg&oe=6B0467AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "782721247326589", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/427384304_782721250659922_2238916620449805730_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysTa6BQGE7oQ7kNvwEqy5Ft&_nc_oc=AdpZtPjcOavMyg6tyv4xZ_bA1etJQ4j2ho5pj_yBU0Nm55vvLOXNKjanXr2uHDY2_GQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKxvPaox-yy4aSJgy8OoyMJFszrMNmg19iB_C2_j5WVA&oe=6B0466BD"}, "display_name": "Swivel", "keywords": ["spin", "ride", "rhythmic", "fitness", "seated"], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style:\n- Fly - pop\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": "https://www.swivelvr.com/contact-
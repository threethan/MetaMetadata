A81955C"}, {"file_name": "YES3.png", "id": "25662881226690906", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75520122_25662881230024239_6299176207333418075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15k5ImcCWXEQ7kNvwGn0kxI&_nc_oc=AdqZsmZR7k3mTaEcZ6UPKGqPuuxlNi979V5xg_GvcwrO1Ta86-pY6uA6XBu6A3xmyGE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTtDHt5TGg1ifxXjBRLF8vzn7Sfv0nXJTQifvEeI6IJQ&oe=6A81B2F2"}, {"file_name": "YES4.png", "id": "1354074085262388", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974741_1354074088595721_9212956591605280011_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Er3qfcaIkOIQ7kNvwEEAOar&_nc_oc=Adp-trWk8VyH721OyigN9ZFfakvYvD6VLa1lJpvAsqy95CtMAhXhl7nUgW8ysDexeD0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFeQ_LCaOZt1dtK9UM1uQVlSHlsjQqgA8ixC3maEk0VA&oe=6A81BF80"}, {"file_name": "YES5.png", "id": "1433907864677225", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974905_1433907868010558_5661496313997694104_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THrkbWeZAGAQ7kNvwFOh5eP&_nc_oc=AdoToZ40w1Bn6L9d9-XcVHNeV4ZosegCbpg0FOfh2Vy5cAJacuRcNG33ntl0b8IwSy4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPFMdMJeD3E0azd-tZQgCGDSVUFHAEfBPUYLjKMEDWcg&oe=6A81AAEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "782721247326589", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/427384304_782721250659922_2238916620449805730_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnDBizfsFxEQ7kNvwE3TmUT&_nc_oc=AdovmFpKibNWbi_SP6CwrNMMK33ib-mXQwhFu8Ytu8HljJYkZ1pnjInlis7WzHaJG6o&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHk3cbhPvAXL379gYEMVoah1eo-q8kK-VI8uKchhVT3uA&oe=6A81A9FD"}, "display_name": "Swivel", "keywords": ["spin", "ride", "rhythmic", "fitness", "seated"], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style:\n- Fly - pop\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": "https://www.swivelvr.com/contact-us", "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": []
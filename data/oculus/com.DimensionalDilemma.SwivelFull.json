sid=6e7a0a&_nc_ohc=0DlqeEokAAwQ7kNvwHx_Qll&_nc_oc=Adq0lk2J-1XzExZCgOEnPX42teALP-8hSbMmQZCJbL4rRheJBql6XOjCgX3XLXufDHY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzQMg079U8-lYtrfoRM5aGx_xRJgaS7IKjA9dGxe4aMw&oe=6B08469C"}, {"file_name": "YES3.png", "id": "25662881226690906", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75520122_25662881230024239_6299176207333418075_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utNgQXcSwu8Q7kNvwFPyMK5&_nc_oc=AdrnC4TFUxyVDPcTH7fqg-PpatFS7Ov-szsrBnL2th8uxIgvb-aOgUJqBy7OnPt4JkI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNoGq0kgyINVaSsv_N0Zc1NKksc1wJfLrEl_GQ4zWFkw&oe=6B086432"}, {"file_name": "YES4.png", "id": "1354074085262388", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974741_1354074088595721_9212956591605280011_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3U2wsjvCuqYQ7kNvwEl-rb7&_nc_oc=AdoKAbEkrB4--2Pv2ZmKHAq6-kKPT6R3JfdFlxZ2AchBe5KOnc8bDLyrTCJO1aoL0Os&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkgAxAN4j1HqSJ4B64mj-oUN0Yx2sCRzmLh2ow6wNjIA&oe=6B0870C0"}, {"file_name": "YES5.png", "id": "1433907864677225", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974905_1433907868010558_5661496313997694104_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1Dcroo_upsQ7kNvwGuorIh&_nc_oc=Adoqd3VAqgPq7lxXMk9VpvYniBg-MexkSf7GTkwK_LN321FpDwJhHnCAIe641GJkjjI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDXK44u9qxBYgBCBW9jYXisAidkGJqJ6u6cQYTX1lwEw&oe=6B085C2F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "782721247326589", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/427384304_782721250659922_2238916620449805730_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pELxjAGtmloQ7kNvwFwHcQh&_nc_oc=AdqOcjus8lEHbTW9nodlCI0_fkP81CInN9PdsD_ansmgyEGt_oJZb5ancxlroY2YUgQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJ49tIP3CHDuQFaEyJhT4FvWiDKtVcqYiIn6vxwwbvTg&oe=6B085B3D"}, "display_name": "Swivel", "keywords": ["spin", "ride", "rhythmic", "fitness", "seated"], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style:\n- Fly - pop\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": "https://www.swivelvr.com/contact-us", "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7774007276038100"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031360_1572910846960835_8224561559878044455_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIfXUj6bp24Q7kNvwH9ih07&_nc_oc=AdrV7f_ObWva_2q18VEcEDXIo65VPKb2tlVIl4_I8MATp76bhE54aDOtQzTmN8FdFSc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6xbeAWgW-Cydce6BzYU7dxcRcPoI_e-ffOxalrHFQBg&oe=6B084978"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Swivel", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1717102740, "lastRevision": {"nodes": [{"id": "7277099832395516", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7277099809062185", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "418267027782258"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {
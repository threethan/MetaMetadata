sid=6e7a0a&_nc_ohc=y72DfVfRQ24Q7kNvwHfZjBH&_nc_oc=AdqtZpawgF_JouoOMnS8hflEIoatLz5zT91l-du8NHcs7Q70rQ_mF3-V94Egjiwi9bI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT279yarciyIUuJkQElkfWmo_kN1mzeACMUI1idfohnLg&oe=6B09D05C"}, {"file_name": "YES3.png", "id": "25662881226690906", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75520122_25662881230024239_6299176207333418075_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utNgQXcSwu8Q7kNvwFmvjEh&_nc_oc=Adqs1JYkTLFU5tqLrPzUXsek5LC_W_3jMxUz54y1i7oL1ukFcGd_hUxNgTjrR2K6L1g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYjjHEjEMGqi1xaScflE0my-RRMIX8nLeg5v8HQFQ3oA&oe=6B09B5B2"}, {"file_name": "YES4.png", "id": "1354074085262388", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974741_1354074088595721_9212956591605280011_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJkO8w1EaUQQ7kNvwGOdjVn&_nc_oc=AdrprjoQpix8_xm9FY5CnJ6t1_clz0y9V6nLrTeDFJUScSZVr67QZNSfVZXCzcQKfFM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAANZ-YxuqN_EeE9Wr1dKMXkFL4jzCNJLADUgipnvaOA&oe=6B09C240"}, {"file_name": "YES5.png", "id": "1433907864677225", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974905_1433907868010558_5661496313997694104_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1Dcroo_upsQ7kNvwFgykiU&_nc_oc=AdraaY3hLSJ-gW1mijEgEz510aK087WVRe0KDeil0TbekjAtPhyQNhQNBXlMQfpwy8k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmAJp0-zi0M0dq8eC4yaoLe-taCspx-Ub7Q-FLoAD4OQ&oe=6B09ADAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "782721247326589", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/427384304_782721250659922_2238916620449805730_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pELxjAGtmloQ7kNvwGGYFEI&_nc_oc=AdpllPvGoSgP8fUxHpF-U0lv7_gaVXVaME0MSse7-xOsHVkyiybP6qETiACLJH0l43w&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS73b2YTOeXP894squ_JkfxM5-Tn6q4MA2PyWRs0xXXMg&oe=6B09ACBD"}, "display_name": "Swivel", "keywords": ["spin", "ride", "rhythmic", "fitness", "seated"], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style:\n- Fly - pop\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": "https://www.swivelvr.com/contact-us", "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7774007276038100"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031360_1572910846960835_8224561559878044455_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIfXUj6bp24Q7kNvwF_qVOF&_nc_oc=AdpwprKGYbUwAsAY1b5lV0RphuYsN9uvxJyXFXrDQABhha6CgBwL12aU18yM_3mIPQY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCpvr8oiCy5CDXUdKOzWPoOuDZ9XPv6Muy54qP6elhsg&oe=6B099AF8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Swivel", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1717102740, "lastRevision": {"nodes": [{"id": "7277099832395516", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7277099809062185", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "418267027782258"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {
sid=6e7a0a&_nc_ohc=y72DfVfRQ24Q7kNvwHCy7m3&_nc_oc=AdrQZ9Rfs6OCIRtNuMk46udSx2_OwtjNmSS_Ylp10kZFkn3obg13H6QUw2NYih2CjVA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRRaHFg219uuBRdHyR3fwsNZjm5nlmhVJOEqHa4OItDcg&oe=6B0C735C"}, {"file_name": "YES3.png", "id": "25662881226690906", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75520122_25662881230024239_6299176207333418075_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4U7RrOIzW1AQ7kNvwFYjKRN&_nc_oc=AdpvZnFSSi_WN4ZqbFeoW8-_Lv_RrzcszfpmvgWkR9uAFMjbCCZndv1uNF5FMWqP-LQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS4R0fcILIqRvrzQbA_3DRUsFGZeBqqpTYBlSjEWLXdMg&oe=6B0C58B2"}, {"file_name": "YES4.png", "id": "1354074085262388", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974741_1354074088595721_9212956591605280011_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJkO8w1EaUQQ7kNvwHHzoCd&_nc_oc=AdqVpu5tCmVQJB3TbZtpKGoDswBGtqEl5W7bR2o7o-87F_bIlbA_7oLOrO-Hdn2cpto&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQF5e2hfAb3oKTsX3cM2zz9tLwNJ1JpnG3l06jGfIgeOg&oe=6B0C6540"}, {"file_name": "YES5.png", "id": "1433907864677225", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974905_1433907868010558_5661496313997694104_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nPQt_HBjiMQ7kNvwFiiqzc&_nc_oc=AdoX2KDi9ni5k2ss-drkcwGsh95W6tJM46zE1snPDTGh78I4W3H-MV9X8yswyPhN0Aw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQx46mM3nzy5-QtvUSe_QGlS3BA9rVInNxdPj33H-HOXw&oe=6B0C50AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "782721247326589", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/427384304_782721250659922_2238916620449805730_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72MIwXwjr9wQ7kNvwE6p_lY&_nc_oc=AdovYmguX8RNvok2fmDlUD9Nc0ULdNL2qy7AB6qAeQpHkqrcyuhj8LaZhDozsXbjxis&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTD0ZobOkm9_cPdVnwVJkttwhbar9T9K6fGKrvb3Gv3bQ&oe=6B0C4FBD"}, "display_name": "Swivel", "keywords": ["spin", "ride", "rhythmic", "fitness", "seated"], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style:\n- Fly - pop\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": "https://www.swivelvr.com/contact-us", "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7774007276038100"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031360_1572910846960835_8224561559878044455_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DP-q073gg2cQ7kNvwH_9cip&_nc_oc=AdqE3AUVufMNwhKBs--HtIsdtFWTW7SWZ92ljTbegOOXNNc0htgOOeyDjPV6_eG32s0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRSZy1LpAwR8y3XMiOXYQ3dlPSGDHvtk9d3192NCiBQVw&oe=6B0C7638"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Swivel", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1717102740, "lastRevision": {"nodes": [{"id": "7277099832395516", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7277099809062185", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "418267027782258"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {
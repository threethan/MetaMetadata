m"], "long_description": "Explore core physics concepts in an interactive virtual laboratory designed to support immersive learning.\n\nUsers can observe and analyse the motion of a ball as it falls, rolls down a ramp, and undergoes projectile motion, while adjusting variables such as mass, friction, ramp height, drop height, ball radius, and gravity. The ability to rewind, repeat, and compare multiple experiments helps users investigate how each variable influences the motion.\n\nAvailable in both solo and multiplayer modes, the app can support teacher-led instruction, collaborative learning activities, and independent inquiry.\n\nIn collaboration with the University of Glasgow.", "short_description": "Explore core physics concepts in an interactive virtual laboratory designed to support immersive learning.\nUsers can observe and analyse the motion of a ball as it falls, rolls down a ramp, and undergoes projectile motion, while adjusting variables such as mass, friction, ramp height, drop height, ball radius, and gravity. The ability to rewind, repeat, and compare multiple experiments helps users investigate how each variable influences the motion.\n\nAvailable in both solo and multiplayer modes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.edify.ac/physics-lab-projectile-motion-privacy-policy", "developer_terms_of_service_url": "https://www.edify.ac/physics-lab-projectile-motion-privacy-policy-terms-of-service", "publisher_name": "Soluis Tech Ltd", "support_website_url": null, "website_url": "https://www.edify.ac/physics-lab", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recomme
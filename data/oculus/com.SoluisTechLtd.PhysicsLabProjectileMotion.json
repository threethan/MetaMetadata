designed to support immersive learning.\nUsers can observe and analyse the motion of a ball as it falls, rolls down a ramp, and undergoes projectile motion, while adjusting variables such as mass, friction, ramp height, drop height, ball radius, and gravity. The ability to rewind, repeat, and compare multiple experiments helps users investigate how each variable influences the motion.\n\nAvailable in both solo and multiplayer modes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.edify.ac/physics-lab-projectile-motion-privacy-policy", "developer_terms_of_service_url": "https://www.edify.ac/physics-lab-projectile-motion-privacy-policy-terms-of-service", "publisher_name": "Soluis Tech Ltd", "support_website_url": null, "website_url": "https://www.edify.ac/physics-lab", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "27027467183545323"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820855_1332309658741649_2076113401451359031_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuVFlivsJiIQ7kNvwGGkqPK&_nc_oc=AdrLEdqauPpVHb2DcBBcLlZZ-VlgcjowcUSTS9zrf_ONKA2ErP91r9uBmooV2hzPhko&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUCz2LZuje0hKOPgUgxl7GSxLRQiAkE8u9J0b41CLwtg&oe=6A79D584"}, "is_concept": false, "is_test":
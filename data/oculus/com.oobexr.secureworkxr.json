c_ohc=WxSB203l6HAQ7kNvwFiUAmJ&_nc_oc=AdoxlmdCAkR5KXr4It29Xs_adiv5QxBNHQ-8ix_ggRtYNFY-s35nB9kU8CYJXtzU68o&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tG7fp0jxwHDGskmcwmh_9J7hBk_-bvDLq9h7DYp82Yg&oe=6A1AF433"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1044_scritta.png", "id": "1838240176811669", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491819281_1838240180145002_5437066614096815667_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lyqf5mNJc8Q7kNvwE12B33&_nc_oc=AdpDdcDZs0YDfXvSwMR3UN_FF_WHVwWGeAlqAGkiMvqMH7QJaAodgj523o9sTos1FGI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5daIF00hEn4mYOP5Sg8iAq4HpJ1hRdEcbjwTMo9Mt5pw&oe=6A1AF2D7"}, "display_name": "SECUREWORKXR", "keywords": [], "long_description": "Our app is designed to transform the way companies and employees approach workplace safety. Through interactive and practical exercises, it enables users to learn, practice, and reinforce essential safety procedures in a dynamic and engaging environment.\n\nWith a focus on hands-on training, the app simulates real-life scenarios that help workers gain confidence and competence in applying safety measures. From hazard recognition to emergency response, every module is structured to ensure compliance with regulations while enhancing awareness and preparedness.\n\nWhether used for onboarding new employees or continuous professional development, the app provides flexible, accessible, and measurable training. Companies can track progress, evaluate performance, and ensure their teams are fully equipped to work safely and effectively.\n\nBy combining technology with safety expertise, our solution empowers organizations to build a strong culture of prevention and responsibility.", "short_description": "A SaaS platform available by subscription for conducting workplace safety courses and training exercises."}]}, "developer_name": null, "developer_privacy_policy_url": "https://theappxr.com/pr
c_ohc=WxSB203l6HAQ7kNvwHkQ-LD&_nc_oc=Adpv1saDpIaUBfQ3e3VgYSkNQvMPp_8QQ-YhOU-fxI6GgYJqTMcJ_zdI-zl_v25G6uM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7G4vjEJ-_2ILqUZYarSlpsEmj_ZqRiuokZqjTmUtnrnQ&oe=6A1D9733"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1044_scritta.png", "id": "1838240176811669", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819281_1838240180145002_5437066614096815667_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgwjCGrJUxIQ7kNvwFjCVlc&_nc_oc=AdooCIKrhh4dDJTNqgmO2dbaB_vsc2Hrg35rc_6zD7txnXMGhTPSfg3jXKmeuqNsBlA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hg3K3D4_JheMh9PRXL5HuU8_XaKUDTe9y0C91BaD4Eg&oe=6A1D95D7"}, "display_name": "SECUREWORKXR", "keywords": [], "long_description": "Our app is designed to transform the way companies and employees approach workplace safety. Through interactive and practical exercises, it enables users to learn, practice, and reinforce essential safety procedures in a dynamic and engaging environment.\n\nWith a focus on hands-on training, the app simulates real-life scenarios that help workers gain confidence and competence in applying safety measures. From hazard recognition to emergency response, every module is structured to ensure compliance with regulations while enhancing awareness and preparedness.\n\nWhether used for onboarding new employees or continuous professional development, the app provides flexible, accessible, and measurable training. Companies can track progress, evaluate performance, and ensure their teams are fully equipped to work safely and effectively.\n\nBy combining technology with safety expertise, our solution empowers organizations to build a strong culture of prevention and responsibility.", "short_description": "A SaaS platform available by subscription for conducting workplace safety courses and training exercises."}]}, "developer_name": null, "developer_privacy_policy_url": "https://theappxr.com/pr
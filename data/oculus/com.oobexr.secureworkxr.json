_1838240180145002_5437066614096815667_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7yEx1vFn1YQ7kNvwFdU_dI&_nc_oc=AdpDMkvi_X5T-rE9lkBLdMGZu-oUPlqqfCSt__ae4c3lhktsc5pS9gVbv_yS8sDL7k0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXf919iHhx_6ZebtyfaZjyDByyQnQBksZxnUXxJwohwA&oe=6AE356D7"}, "display_name": "SECUREWORKXR", "keywords": [], "long_description": "Our app is designed to transform the way companies and employees approach workplace safety. Through interactive and practical exercises, it enables users to learn, practice, and reinforce essential safety procedures in a dynamic and engaging environment.\n\nWith a focus on hands-on training, the app simulates real-life scenarios that help workers gain confidence and competence in applying safety measures. From hazard recognition to emergency response, every module is structured to ensure compliance with regulations while enhancing awareness and preparedness.\n\nWhether used for onboarding new employees or continuous professional development, the app provides flexible, accessible, and measurable training. Companies can track progress, evaluate performance, and ensure their teams are fully equipped to work safely and effectively.\n\nBy combining technology with safety expertise, our solution empowers organizations to build a strong culture of prevention and responsibility.", "short_description": "A SaaS platform available by subscription for conducting workplace safety courses and training exercises."}]}, "developer_name": null, "developer_privacy_policy_url": "https://theappxr.com/privacy-meta", "developer_terms_of_service_url": null, "publisher_name": "OOBEXR", "support_website_url": null, "website_url": "https://secureworkxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
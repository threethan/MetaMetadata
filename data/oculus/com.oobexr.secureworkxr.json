c_ohc=vHjKblY3NG8Q7kNvwGMa7w9&_nc_oc=Adryf9Q9udjNb58OeaZVm_O8TlaOuOzVoWEteuHIlq6TNBSQmYaQd0AlgagEDmUo0Kg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VCEwqcJ3mgBpfMW-UnYrYq7g6Hf-YJXeK-L1T6PZZMQ&oe=69F9FEB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1044_scritta.png", "id": "1838240176811669", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819281_1838240180145002_5437066614096815667_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLx9ckuVbRkQ7kNvwFXQOPJ&_nc_oc=AdrsaxrLNyei-k6Ap_EAXl2L2WeuABIJKwHA-80T4RJvHBQoE3-1IsmcUFvAEKWEMRI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4t7oGdIX4Quzv1hrMsknQdFANqnEpstDFHZwG-lQk1Ow&oe=69F9FD57"}, "display_name": "SECUREWORKXR", "keywords": [], "long_description": "Our app is designed to transform the way companies and employees approach workplace safety. Through interactive and practical exercises, it enables users to learn, practice, and reinforce essential safety procedures in a dynamic and engaging environment.\n\nWith a focus on hands-on training, the app simulates real-life scenarios that help workers gain confidence and competence in applying safety measures. From hazard recognition to emergency response, every module is structured to ensure compliance with regulations while enhancing awareness and preparedness.\n\nWhether used for onboarding new employees or continuous professional development, the app provides flexible, accessible, and measurable training. Companies can track progress, evaluate performance, and ensure their teams are fully equipped to work safely and effectively.\n\nBy combining technology with safety expertise, our solution empowers organizations to build a strong culture of prevention and responsibility.", "short_description": "A SaaS platform available by subscription for conducting workplace safety courses and training exercises."}]}, "developer_name": null, "developer_privacy_policy_url": "https://theappxr.com/pr
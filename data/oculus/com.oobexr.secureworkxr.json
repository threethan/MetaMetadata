=6e7a0a&_nc_ohc=tzbocrnIxqEQ7kNvwFqiXqj&_nc_oc=AdrLijwhqjjOPbOKx3NGneZJToG8FXbhq0L-pVOpZazx0Z6AvZkWIMyiLcKfr7QIGqQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KMBRoAc-Jip-trdBIFtuC8N78AHsiPgGuaGhu2x0ukQ&oe=6A36A3B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1044_scritta.png", "id": "1838240176811669", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491819281_1838240180145002_5437066614096815667_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1IiFyeovk8Q7kNvwEyBFyF&_nc_oc=AdqvGclAkYzoZHid5pQAOk879TVAQ2BD3wyGASb9VwhMul8CShd_Das9B8CWhFC3tIM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dYFIkleF4hYdi7-EGxMrIQptpEse34WIbCBohfkj2Ew&oe=6A36A257"}, "display_name": "SECUREWORKXR", "keywords": [], "long_description": "Our app is designed to transform the way companies and employees approach workplace safety. Through interactive and practical exercises, it enables users to learn, practice, and reinforce essential safety procedures in a dynamic and engaging environment.\n\nWith a focus on hands-on training, the app simulates real-life scenarios that help workers gain confidence and competence in applying safety measures. From hazard recognition to emergency response, every module is structured to ensure compliance with regulations while enhancing awareness and preparedness.\n\nWhether used for onboarding new employees or continuous professional development, the app provides flexible, accessible, and measurable training. Companies can track progress, evaluate performance, and ensure their teams are fully equipped to work safely and effectively.\n\nBy combining technology with safety expertise, our solution empowers organizations to build a strong culture of prevention and responsibility.", "short_description": "A SaaS platform available by subscription for conducting workplace safety courses and training exercises."}]}, "developer_name": null, "developer_privacy_policy_url": "https://theappxr.com/privacy-meta", "developer_terms_of_service_url": null, "publisher_name": "OOBEXR", "support_website_url": null, "website_url": "https://secureworkxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27786035180983368"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1157044369623416"}]}, "baseline_offer": {"id": "1157044369623416"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776788040, "status": "PUBLISHED", "id": "1157044369623416"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28403844965869050", "version": "2.33.0"}, "id": "1504523420889121", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25813865021533737", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28403844965869050"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1504523420889121"}]}, "change_log": null, "created_date": 1780673886, "id": "28403844965869050", "version": "2.33.0", "version_code": 34, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"no
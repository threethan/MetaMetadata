_4269003543351780_8773771140775458131_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2cAUtlRhqYQ7kNvwGqfAx2&_nc_oc=Adp6RlSWh1uuaSjTezFggWKzqLj3AGuUj8HKf6TONbPVBbo-fBIw_xj8oefZvGoUIso&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBItipjyD8MSETiUNmJrDA0NMQdOseOlismIiUptY9I5A&oe=6A5F5B7E"}, {"file_name": "2.png", "id": "1655501715560933", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604293968_1655501718894266_2742929868489932007_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elcSWpdWKn4Q7kNvwET_dp9&_nc_oc=Adr4OPz-f67_bkN6IIs4fD2kTp_P18MZOvoSky6S8YJTzZhHdpv36JX6QxWK-X0wZPk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4lnRht7xLs0M6h4dfXIFf0y56-C9bX1mE6IT2X-Qqvg&oe=6A5F70A2"}, {"file_name": "3.png", "id": "2229282971215153", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310731_2229282974548486_87169362037627575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DH8NyZdPp54Q7kNvwHVdxUo&_nc_oc=Adq1uEChVXTN0Uzz2socuTFkaltimQ7NvAD-L6Hhy8fgG087Cn21W8HDoIYQ2tCV6uQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsvhsVIfajjoNzBb4ypW-auGlD_NXnzDoDXKRewlsUNg&oe=6A5F77E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "I am janitor 2560x1440_v2.png", "id": "1506385487643508", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/507833663_1506385490976841_5082961608361444936_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IE9aeMw4BQgQ7kNvwFyyBgQ&_nc_oc=AdooLpEoOTK_iMeSO3fep1TuI0IbVjeYFeliQQ2VUxuvxIJclPUJQD01Ne_lr-GNvpc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAfkKZlDwFo5roOyjY3hR8tV7yf6gv_Sq5RXCmVrcRYg&oe=6A5F57E3"}, "display_name": "I Am Janitor", "keywords": ["Sandbox", "Simulator", "Casual", "Janitor", "Nightclub"], "long_description": "**Welcome to the night shift!**   \nI Am Janitor puts you in the shoes of a nightclub janitor in an interactive VR sandbox. Clean up wild parties, tackle gross messes, and earn cash. When the boss isn\u2019t looking, use \"unconventional\" equipment to turn the club into your playground!\n\n**\ud83e\uddf9 Play as a Janitor**  \nExperience the nightlife from a new perspective. Scrub floors, scrape gum, clear trash, and fix VIP disasters and overflowing toilets.\n\n{1042040988342664}\n\n**\ud83d\udee0\ufe0f Tools & Chaos Gear**       \nMaster mops, scrapers, and chemicals. Tired of cleaning? Unlock secret items like a Flamethrower, Gravity Gun, Freeze Gun, and Nunchucks to turn the party upside down!\n\n{37145708065016388}\n\n**\ud83e\udea9 Take Over the Club**       \nJump behind the DJ booth, play pool and darts, or just throw wads of cash around the VIP lounge.\n\n**\ud83d\udc4a Fight or Flight**.  \nUse your grappler to snatch food or engage in physics - based brawls with annoying customers. Keep your antics hidden, or security will hunt you down!\n\n{873802869112983}\n\n**\ud83e\uddea Interactive VR Sandbox**       \nManipulate everything. Throw food, juggle drinks, hit guests with your mop, steal drinks, or freeze them in place to watch the hilarity ensue.\n\n\n{1018073880714113}  \n\n**\u2728 Key Features**\n\n- Deep Cleaning: Scrub gum, fix plumbing, and clear out mountains of trash.\n- Physics Freedom: Pick up, throw, break, and interact with everything.\n- Chaos Arsenal: Master ridiculous weapons like the gravity gun and flamethrower.\n- NPC Interactions: Mess with guests, dodge bouncers, and ruin everyone\u2019s night.\n- Mini-Games: Take a break to play darts, pool, bowling, and more.\n", "short_description": "Welcome to the night shift!   \nI Am Janitor is an interactive VR sandbox where you clean up a chaotic nightclub. Scrub sticky floors, fix gross toilets, and earn cash. Tired of working? Unleash total chaos! Unlock secret gear like a Gravity Gun or Flamethrower, brawl with annoying guests, dodge angry bouncers, or take a break to play pool and hijack the DJ booth. Be the perfect employee or the absolute worst in this physics-based playground!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy-policy/meta-en", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "974085462183449"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1759748541700957"}]}, "baseline_offer": {"id": "1759748541700957"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782316800, "status": "PUBLISHED", "id": "1759748541700957"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "993538823571446", "version": "1.2.1"}, "id": "1031022052830106", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "974085455516783", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "993538823571446"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1031022052830106"}]}, "change_log": "Minor bug fixes", "created_date": 1782392687, "id": "993538823571446", "
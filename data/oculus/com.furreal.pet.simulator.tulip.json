 {"file_name": "1.png", "id": "2196148314229131", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499299842_2196148317562464_4572920629640346196_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akCrM2Q1tYYQ7kNvwGlGS3Y&_nc_oc=AdkaKA23ly8xOGH-0OnWemjbdKKPQpZeOSR7t_nJbUUhjvYv7SJOyYzCyrsgnryKJ-Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs3-BdLjy7iX2dLPgSQ9xP39GWy1zIpzQuzVrXc_owB2w&oe=69A81D1E"}, {"file_name": "4.png", "id": "1081501416740445", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822883_1081501420073778_677441529012800346_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYK2DP80nGcQ7kNvwFjeJbd&_nc_oc=AdlJGQVEJ5VOvNJy13eNnHAsOsAhAN-Bpjp79pWoJjBIKRwJpUUV_JpxSmWdEWt_Hkw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftgz_IvGqXoJAd2XXbzEeSyyNlKEQAXxqRhVpngc-9CWw&oe=69A82A16"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FurReal - Pet Game", "keywords": ["PetSimulator", "PetGame", "DogGame", "CatGame", "FunGame"], "long_description": "Welcome to FurReal VR your new best friend awaits!\nExperience the joy of having a furry companion like never before in this deeply immersive VR pet simulator. Choose from a variety of adorable animals dogs, cats, rabbits, and more and build a genuine emotional bond in a virtual world that feels alive.\n\nWhether you're teaching tricks, tossing toys in the backyard, going on walks, or simply cuddling by the fire, FurReal VR brings the unconditional love of a pet to your headset. Designed for all ages, this experience blends fun, care, and connection into one unforgettable journey.\n\n\ud83d\udc3e Features:\n\u2022 Realistic pet behaviors and reactions\n\u2022 Feed, groom, and care for your pet daily\n\u2022 Teach tricks, play fetch, and explore outdoor zones\n\u2022 Expressive animations and emotional bonding\n\u2022 Calm, therapeutic environments perfect for relaxation or fun\n\nNo mess, no stress just pure love and companionship. Whether you're a lifelong animal lover or simply looking for a joyful escape, FurReal VR is as real as it gets.", "short_description": "FurReal VR is a heartwarming virtual pet simulator where you can adopt, play, feed, and bond with lifelike pets in a beautiful interactive world. It's more than a game it's a friendship."}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24131907983165503"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819300_3715131688796231_5096220453659929609_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bzNijXp-JQQ7kNvwFbLMRg&_nc_oc=AdkbvfLbLG6tp9sV9rZCtAxPuLEdiZws-vR9tzJvcbFUKmO6CEha5GwYzP4CiHzOCy4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftdCTsxTn-kqkehheIHs6exb7R4Fk8gm85WH2NeFzSfaw&oe=69A8136B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "FurReal - Pet Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_dat
scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FKaUCwhCpJmZxZVv2pXriKuezuMaFLXZguwWSjwROdA&oe=6A032EEB"}, {"file_name": "2.png", "id": "765696525884143", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307311_765696529217476_2871864312383696854_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7px9MAe2wgQ7kNvwEecBUj&_nc_oc=AdoB3ZX96BmoDAQ0U0BfgUcXg1VZac7GW_LDxsJLwh8XnRSA8tzcsgTzInpcAYqkl7Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BmbBzH7S0sucF7cTCkZuqv1eumDNwYE0sIet1qlqaLA&oe=6A0318BD"}, {"file_name": "1.png", "id": "2196148314229131", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299842_2196148317562464_4572920629640346196_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AgeJtngHxhgQ7kNvwHWXu14&_nc_oc=AdqfToGd-bziL2DxhEMoR5-Vv7qU56KDHn5ssVQZNqwfoQKa1sEVZsbuGm38ew0Me60&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40PNNdDME0ZdCiceC3npYvon_VwJ8sltVuEjO1cc3Omw&oe=6A03149E"}, {"file_name": "4.png", "id": "1081501416740445", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822883_1081501420073778_677441529012800346_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9RbIJdNvMIQ7kNvwFfxDbc&_nc_oc=Adq7rsyvwRdNvz4znJuFTpPpEO7HqR407DerCqGCcNsBqZItBs-es4WZBUrmFlBjFTE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EZ9-UWei2tMDA158thZXbxDIE7o8V0hip4q1Jji9w3A&oe=6A032196"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FurReal - Pet Game", "keywords": ["PetSimulator", "PetGame", "DogGame", "CatGame", "FunGame"], "long_description": "Welcome to FurReal VR your new best friend awaits!\nExperience the joy of having a furry companion like never before in this deeply immersive VR pet simulator. Choose from a variety of adorable animals dogs, cats, rabbits, and more and build a genuine emotional bond in a virtual world that feels alive.\n\nWhether you're teaching tricks, tossing toys in the backyard, going on walks, or simply cuddling by the fire, FurReal VR brings the unconditional love of a pet to your headset. Designed for all ages, this experience blends fun, care, and connection into one unforgettable journey.\n\n\ud83d\udc3e Features:\n\u2022 Realistic pet behaviors and reactions\n\u2022 Feed, groom, and care for your pet daily\n\u2022 Teach tricks, play fetch, and explore outdoor zones\n\u2022 Expressive animations and emotional bonding\n\u2022 Calm, therapeutic environments perfect for relaxation or fun\n\nNo mess, no stress just pure love and companionship. Whether you're a lifelong animal lover or simply looking for a joyful escape, FurReal VR is as real as it gets.", "short_description": "FurReal VR is a heartwarming virtual pet simulator where you can adopt, play, feed, and bond with lifelike pets in a beautiful interactive world. It's more than a game it's a friendship."}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24131907983165503"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819300_3715131688796231_5096220453659929609_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-
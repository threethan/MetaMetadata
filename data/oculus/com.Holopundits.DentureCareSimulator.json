D"}, {"file_name": "Screenshot_Denture_care_SS_05.png", "id": "532050912599107", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003266_532050915932440_7858627279682767410_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpE4xNHBTQsQ7kNvwG1ATRR&_nc_oc=Adp0zd_yup4B2AUMmMbG-ck59iKx6SFdp1GvonzBCx78XjcFkdJwq5BCwC9MEucoq5E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8I3pWpyxIjPaZY5sbAiiBA46bLnTRIXS2vNu65y1ljrA&oe=6A217C3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "897456102209936", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982716_897456105543269_5076105286420963898_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFz0YtWvFmcQ7kNvwHKiBz5&_nc_oc=AdrgeIL7CsucXzhL75RhoQOLLW_lcX9RveYlPQSia5Ik0LamL_oFT4udHnylbbhCecg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8i6K8kx3jV8zKeN1lxX6PKeMHVhkhI5r1ZymljgOsaAw&oe=6A218CE5"}, "display_name": "Denture Care Simulator", "keywords": ["denture", "vr", "simulator", "CNA", "dentist"], "long_description": "This VR simulation teaches the essential skill of cleaning upper or lower dentures, focusing on hygiene and patient comfort. The tutorial includes preparation, communication, denture removal, cleaning, and reinsertion. By the end of this tutorial, participants will be able to: \n- Remember the steps and safety protocols for cleaning dentures. \n- Understand the importance of maintaining proper oral hygiene for patients with dentures. \n- Apply the correct techniques for removing, cleaning, and reinserting dentures. \n- Analyze the condition of the dentures and the oral cavity to provide appropriate care. \n- Evaluate their technique to ensure it adheres to best practices and safety standards. \n- Create a hygienic and comfortable experience for patients during denture cleaning. \n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with proper care efficiently and compassionately in real-world clinical settings. ", "short_description": "Learn the proper technique for cleaning upper or lower dentures to ensure patient oral hygiene and comfort."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8778953515465501"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24873238925610370", "version": "2.0"}, "id": "878774917021144", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8778953495465503", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24873238925610370"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "878774917021144"}]}, "change_log": null, "created_date": 1753370153, "id": "24
zNthThTqYQ7kNvwHRikSs&_nc_oc=AdnDIIHu-4b7Z-dzIhl2pba8S3h8Hcae5XWa56WxsZahDdh9Ya8m4fyK_CvUKLFZHZw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwwfU6-9U4iVHCqatL_GDaSmIY0wmgrMtx9RvMyLtd65Q&oe=69B4187D"}, {"file_name": "arcade.png", "id": "630014648257746", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974472_630014651591079_7504793165658418968_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8QIagnm-9BUQ7kNvwGUq_DP&_nc_oc=AdnMH3DDIB8UnRY9DpqBhQaRpqZNdyuXJQaUCfH50cjfMeTRaSFWY4OV8KOrZC_QQsE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyhuDNqtBLE-jqvB9hE6JaRHE_GmrHKkMI9rwfyUNpVzQ&oe=69B41038"}, {"file_name": "survival.png", "id": "988436068735862", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422391_988436072069195_1389652558864199259_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbsFGH6v8dQQ7kNvwHVLvOd&_nc_oc=AdkUv188IgSK8kk4Bxb6EKsxPpRe3dU-617W_bl-b9LkxXLXYpu-RRCwnXsUZ-17vfU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx9pUD2XcFoAhtRuCcgThGnAkuPcyIGe6J15T8cxKbdBg&oe=69B400F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vidthumbsnail.png", "id": "962565014397132", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031384_962565017730465_4974300260370899112_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kmyzzdj8BsIQ7kNvwEvS6tB&_nc_oc=AdkMdShk0f8spawAD3u-PYrXtbA1rdoU_brnxqqC_0s0wndp8N41IVpasHn89kC5-p0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxStpmmgy7xFYgXOVCKBa7_Cpvamp7w5eAu0yIJtfuelg&oe=69B3FB55"}, "display_name": "Neon Kite", "keywords": [], "long_description": "Neon Kite is a VR Arcade Kiteboarding Game inspired by the Synthwave genre.\n\nThere are 4 game modes available so far:\nTutorial: Learn the basics.\nChill: Free Play mode with no goal.\nArcade: Hit the goals with the matching color of the board.\nSurvival: Don't get eaten...\n\nEnable Pro Mode for more realistic control.\n\nMusic: \nESCP - https://escp-music.bandcamp.com\nMusic promoted by https://www.free-stock-music.com\nAttribution 4.0 International (CC BY 4.0)\nhttps://creativecommons.org/licenses/by/4.0/\n\nAnd Karl Casey @ White Bat Audio\n\nMore details on https://www.neonkitevr.com/music\n\n** Neon Kite may contain flashing imagery. Use the \"Light Mode\" at the beginning of the game for the same experience without flashes.\n\n** This game is still in development and the upcoming updates are included.\nYour support is greatly appreciated!", "short_description": "Neon Kite is a VR Arcade Kiteboarding Game."}]}, "developer_name": "Alexis Taillon", "developer_privacy_policy_url": "https://www.neonkitevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.neonkitevr.com/terms-conditions", "publisher_name": "Alexis Taillon", "support_website_url": "https://www.neonkitevr.com/contact", "website_url": "https://www.neonkitevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "791700912222772"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035360_3213497065638881_4522436697499709862_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=579qaB05FlUQ7kNvwE_36JQ&_nc_oc=AdlGSWQ5lCK_KuFiC6eGNyL2J0-HxbxBN92IGVDeMpP-VGbuMPwOVA1aSfd-JwWuqpQ&_nc_zt=3&_nc_ht=scontent-o
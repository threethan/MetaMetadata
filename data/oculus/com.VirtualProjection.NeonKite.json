tent-atl3-3.oculuscdn.com/v/t64.5771-25/57566677_246277690705409_2473846080075905053_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ryA-pg7RyEQ7kNvwGbDtuA&_nc_oc=AdpZLSHsCVy6ceh4c-6i1VIDrhNQF_knhdS2oGx6MzyqMTskLzhQ4VxckZL-Hu55fLQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2TW2CZ_3_0TUXzwuKlY4U0xAHrkPoW_SNYrdHstfpH4w&oe=69F2179C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "scr1.png", "id": "654714935933991", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974854_654714939267324_4530836751251932482_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeSuTmDiT7YQ7kNvwEq2nd0&_nc_oc=AdrjMiy2Rjtg_VRBOt4bqmLt64SSICX0uytZs7pCJ2LnXVM-A7YiBw56VscENlDQghs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af39jnAU-MEhtUybjaVr94z6HboYQrKYUhokZtwHM6k59Q&oe=69F21864"}, "display_name": "Neon Kite", "keywords": [], "long_description": "** Neon Kite contains flashing imagery that may be uncomfortable for some users. But I\u2019m currently working on a no-flash mode.\n\n** This game is still in development and the upcoming updates are included.\nIf you are looking for a full game experience, I suggest that you wait for the official Oculus Store release. Your support is greatly appreciated!\n\nNeon Kite is a VR Arcade Kiteboarding Game inspired by the Synthwave genre.\n\nJoysticks and buttons are not a thing in this game! Use your body to surf, steer, jump, spin, glide, and dive! \nScore points and add time to the timer by passing through the checkpoints with the appropriate board\u2019s color (red and blue, just like BeatSaber!).\nThe Sea is randomly generated, every try is unique!\n\nMusic made (and approved!) by ESCP\nSynthetic, Above The Clouds, Through The Waves, Neonscapes, Sundown, Goodbye Ocean, and Stardrive \nBy | e s c p | https://escp-music.bandcamp.com\nMusic promoted by https://www.free-stock-music.com\nAttribution 4.0 Internation", "short_description": "Neon Kite is a VR Arcade Kiteboarding Game."}]}, "devel
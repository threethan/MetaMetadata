MfIK6SAWfbYB7bc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1RJ3YWlht5rBmXGoyKxmQ3U8fh_aaI6gXFU5kbEubmIQ&oe=69F0BD7D"}, {"file_name": "arcade.png", "id": "630014648257746", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974472_630014651591079_7504793165658418968_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FfRObN85qMQ7kNvwGPg2zw&_nc_oc=AdrheS_q0aAB1_2q6R1zpFhuaAAmlB9V_fHwevhK6KSLqvpN8z_4ioUmcy2ZbuafH9Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2CHOnNdpsWy-z9_u-dzNsoIZ0tNLKnp3QKW5PTc8BZ5Q&oe=69F0B538"}, {"file_name": "survival.png", "id": "988436068735862", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422391_988436072069195_1389652558864199259_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3QH5l-AG4sQ7kNvwG1-QKY&_nc_oc=AdqGp_SvbrdhZymfNtJC2nIamCkAa3x-Tuia34bpt8NAZA79Y2Hdym2sHIGohIjOuvk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af39RpK4RQbr4ZSlJbFycVtah5RwmD-1Uo4xcfudlwTuhA&oe=69F0A5F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vidthumbsnail.png", "id": "962565014397132", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031384_962565017730465_4974300260370899112_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DX8yF2MFYecQ7kNvwF6W5OY&_nc_oc=Ado5xmMo80GbqycPPwmDuXEeEwqBBOODpzFpNdveRPr4lVfg-B0MCfweULMqxpzJheg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0ZDDesWu_8-Ir32GSM6_OA0Sf7oouGhyDX62aXWF5vDA&oe=69F0A055"}, "display_name": "Neon Kite", "keywords": [], "long_description": "Neon Kite is a VR Arcade Kiteboarding Game inspired by the Synthwave genre.\n\nThere are 4 game modes available so far:\nTutorial: Learn the basics.\nChill: Free Play mode with no goal.\nArcade: Hit the goals with the matching color of the board.\nSurvival: Don't get eaten...\n\nEnable Pro Mode for more realistic control.\n\nMusic: \nESCP - https://escp-music.bandcamp.com\nMusic promoted by https://www.free-stock-music.com\nAttribution 4.0 International (CC BY 4.0)\nhttps://creativecommons.org/licenses/by/4.0/\n\nAnd Karl Casey @ White Bat Audio\n\nMore details on https://www.neonkitevr.com/music\n\n** Neon Kite may contain flashing imagery. Use the \"Light Mode\" at the beginning of the game for the same experience without flashes.\n\n** This game is still in development and the upcoming updates are included.\nYour support is greatly appreciated!", "short_description": "Neon Kite is a VR Arcade Kiteboarding Game."}]}, "developer_name": "Alexis Taillon", "developer_privacy_policy_url": "https://www.neonkitevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.neonkitevr.com/terms-conditions", "publisher_name": "Alexis Taillon", "support_website_url": "https://www.neonkitevr.com/contact", "website_url": "https://www.neonkitevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "791700912222772"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035360_3213497065638881_4522436697499709862_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgqRib5z_WsQ7kNvwFV1dz7&_nc_oc=AdpFbVR0rkC4b-VMJ9zrT-2clhoUag-y7GCwUjzFzYs4neFl-YEe6VFKt9P7LfVz42I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af05446XR9GjobYUHmFhFbUjmQlRlZAO11TrSkUO49eiCw&oe=69F0B4E6"}, "is_concept": false, "is_test
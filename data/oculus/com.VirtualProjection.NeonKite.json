JCm3rISRwQ7kNvwFnjzfM&_nc_oc=AdnBXAjT9ZOmm5FLHw7TRRGaiLyVmaJbPS1ysA7_eFYtA6csSlDYNsMaxFli_XFYiz0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyixchbfKgr1ZlV1AuL5aDqqp6D33ut7m7y0xtj8TDd5g&oe=69BFF5FD"}, {"file_name": "arcade.png", "id": "630014648257746", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974472_630014651591079_7504793165658418968_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41bxwgdJbKIQ7kNvwGlooPW&_nc_oc=Adn2U6ji_EG5V6gYe77aWj-alo91cKJTGWzkRI4Ywy2isDkNzaVv-RUQSOuj5FltNIE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxO5hJrkDgO3_ekMnMIkPkKOeop-YsQFvCK-L1UuaZ4kQ&oe=69BFEDB8"}, {"file_name": "survival.png", "id": "988436068735862", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75422391_988436072069195_1389652558864199259_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkKQnSGRu4sQ7kNvwEKzeBe&_nc_oc=AdmSlzfHLxy-pVdzxgWuqlkdqbsaJVHo-0RKKZFW0C_doB2yNIY4pGjHhSitX8Dzxeo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzdcIFFSMh6n6NXi61Jiel67M8te6cImvImExB0VAKhZg&oe=69BFDE73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vidthumbsnail.png", "id": "962565014397132", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031384_962565017730465_4974300260370899112_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtsWR4gfGKAQ7kNvwHbaadj&_nc_oc=Adm5gADNCtgUDpAWgtazw61r75ZBKOaQszNBAhAdf8T9aySKeKNL8xpFt0G7ED-cVAU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxIIoesWelrwvV5DD-AEU6-jAoGnajhF2tM33zoDbdMFQ&oe=69BFD8D5"}, "display_name": "Neon Kite", "keywords": [], "long_description": "Neon Kite is a VR Arcade Kiteboarding Game inspired by the Synthwave genre.\n\nThere are 4 game modes available so far:\nTutorial: Learn the basics.\nChill: Free Play mode with no goal.\nArcade: Hit the goals with the matching color of the board.\nSurvival: Don't get eaten...\n\nEnable Pro Mode for more realistic control.\n\nMusic: \nESCP - https://escp-music.bandcamp.com\nMusic promoted by https://www.free-stock-music.com\nAttribution 4.0 International (CC BY 4.0)\nhttps://creativecommons.org/licenses/by/4.0/\n\nAnd Karl Casey @ White Bat Audio\n\nMore details on https://www.neonkitevr.com/music\n\n** Neon Kite may contain flashing imagery. Use the \"Light Mode\" at the beginning of the game for the same experience without flashes.\n\n** This game is still in development and the upcoming updates are included.\nYour support is greatly appreciated!", "short_description": "Neon Kite is a VR Arcade Kiteboarding Game."}]}, "developer_name": "Alexis Taillon", "developer_privacy_policy_url": "https://www.neonkitevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.neonkitevr.com/terms-conditions", "publisher_name": "Alexis Taillon", "support_website_url": "https://www.neonkitevr.com/contact", "website_url": "https://www.neonkitevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "791700912222772"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035360_3213497065638881_4522436697499709862_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9dEmcdj4UsQ7kNvwE8gpI_&_nc_oc=AdlI6zBpng6fXer4AFCrpTDFIS_4oqxFwXAncImRkO_jYXHTM_qMWNcwlL4jdi01Lzc&_nc_zt=3&_nc_ht=scontent-i
F0Sj8yQbXgxCZq8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuqbetrGuZMP33KvI0NYN6w3VWvmeZZiSy4IYqLY_DxOw&oe=69A597FD"}, {"file_name": "arcade.png", "id": "630014648257746", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974472_630014651591079_7504793165658418968_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CMN8ypvNgwQ7kNvwEzNX9H&_nc_oc=Adn8ilZIR5WlnIlHtgLmoomDcY8k9bF62NnlWwkQJjQLgryOOPrk5iexQNnbm8u9R3o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afu-cqjKhM5cFf3jQJpwWevV0agsKr-XXTyC7Bm_B1UUNg&oe=69A58FB8"}, {"file_name": "survival.png", "id": "988436068735862", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75422391_988436072069195_1389652558864199259_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wH3UBEeiilYQ7kNvwEKr83J&_nc_oc=AdmSpC5IltExUZeKMcpqXXqlZIgOlDhg010eqwWBIeUVuF1xaavFB-6dGUJLQtTgqUI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afu4zIwUojxVHnMKKkIrBbZDacl1CS_Nranrl-h7XIYzHQ&oe=69A58073"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vidthumbsnail.png", "id": "962565014397132", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031384_962565017730465_4974300260370899112_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cs82dnz-FJUQ7kNvwHUIMeF&_nc_oc=AdmyvS-cle8OnJ8nO1PKwlx6qViSlGCHQrGQlxOUnRapTZn3uA6syRV4684ErLycJuY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsPJyc-HoKbG3-hnUa6SZkuynRGtKksRzlgjKRHyKDIHg&oe=69A57AD5"}, "display_name": "Neon Kite", "keywords": [], "long_description": "Neon Kite is a VR Arcade Kiteboarding Game inspired by the Synthwave genre.\n\nThere are 4 game modes available so far:\nTutorial: Learn the basics.\nChill: Free Play mode with no goal.\nArcade: Hit the goals with the matching color of the board.\nSurvival: Don't get eaten...\n\nEnable Pro Mode for more realistic control.\n\nMusic: \nESCP - https://escp-music.bandcamp.com\nMusic promoted by https://www.free-stock-music.com\nAttribution 4.0 International (CC BY 4.0)\nhttps://creativecommons.org/licenses/by/4.0/\n\nAnd Karl Casey @ White Bat Audio\n\nMore details on https://www.neonkitevr.com/music\n\n** Neon Kite may contain flashing imagery. Use the \"Light Mode\" at the beginning of the game for the same experience without flashes.\n\n** This game is still in development and the upcoming updates are included.\nYour support is greatly appreciated!", "short_description": "Neon Kite is a VR Arcade Kiteboarding Game."}]}, "developer_name": "Alexis Taillon", "developer_privacy_policy_url": "https://www.neonkitevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.neonkitevr.com/terms-conditions", "publisher_name": "Alexis Taillon", "support_website_url": "https://www.neonkitevr.com/contact", "website_url": "https://www.neonkitevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "791700912222772"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035360_3213497065638881_4522436697499709862_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TR_jPcsm3tUQ7kNvwEjbnqK&_nc_oc=Adl4TpF5rzscLxMd25og57Xo7muWkvqJsw1XaQrMpY_XDeGbTRP6AfH-bIstwU-qttk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afs0wh9dmbJfklKw-hCe37pmFC4x74ImemJZ53K12Euwhg&oe=69A58F66"}, "is_concept": false, "is_test
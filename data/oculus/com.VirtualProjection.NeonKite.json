0goLus19UQ7kNvwGbUA7K&_nc_oc=Adl9DFisng6xuPh81GJSqaD4tBdPZkcAOuJD_CLla6DVVrmhJF3D74jbGhBaCk-9TZg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXa345b41vXJ09ByX-73rbDdrzugB4FI43cs1XlZA9YA&oe=69AED27D"}, {"file_name": "arcade.png", "id": "630014648257746", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974472_630014651591079_7504793165658418968_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prEHR9qvYxgQ7kNvwEVCWbl&_nc_oc=Adm7I7Xqb6mV1oYFMa-k6F1UVECXJXhx4cPmWBBbfbYDwRrEUfbrzjXN4dmT_6Jqc54&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyRJZMlGRvO6qGibp8KXtgHjgpzqiCmKuxprHIXitCLDA&oe=69AECA38"}, {"file_name": "survival.png", "id": "988436068735862", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422391_988436072069195_1389652558864199259_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTExO9oDDaIQ7kNvwHXO9WR&_nc_oc=AdmX6I66ndatDLeE0N-uMr8Ckx6APmsB9Y6Iz9up1zw_yvqB9KKw-Cz6S4C20sEt5LE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxyM0ez506HW0N-fFO1fnNrnXpol_k8VecbiT8I8fJiFQ&oe=69AEBAF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vidthumbsnail.png", "id": "962565014397132", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031384_962565017730465_4974300260370899112_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSm2oFTs2wgQ7kNvwFH3b0M&_nc_oc=AdlL3t7uRMKj5_leFkBLh6gMdoaakdsbJ9DbnckPUOUSwvfQlY0OJ31tWhTrvW8QJ98&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwUrJ4K5x5364GUIsfD1cZQxgMnucfHgqd8kEEaDOmJ7w&oe=69AEB555"}, "display_name": "Neon Kite", "keywords": [], "long_description": "Neon Kite is a VR Arcade Kiteboarding Game inspired by the Synthwave genre.\n\nThere are 4 game modes available so far:\nTutorial: Learn the basics.\nChill: Free Play mode with no goal.\nArcade: Hit the goals with the matching color of the board.\nSurvival: Don't get eaten...\n\nEnable Pro Mode for more realistic control.\n\nMusic: \nESCP - https://escp-music.bandcamp.com\nMusic promoted by https://www.free-stock-music.com\nAttribution 4.0 International (CC BY 4.0)\nhttps://creativecommons.org/licenses/by/4.0/\n\nAnd Karl Casey @ White Bat Audio\n\nMore details on https://www.neonkitevr.com/music\n\n** Neon Kite may contain flashing imagery. Use the \"Light Mode\" at the beginning of the game for the same experience without flashes.\n\n** This game is still in development and the upcoming updates are included.\nYour support is greatly appreciated!", "short_description": "Neon Kite is a VR Arcade Kiteboarding Game."}]}, "developer_name": "Alexis Taillon", "developer_privacy_policy_url": "https://www.neonkitevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.neonkitevr.com/terms-conditions", "publisher_name": "Alexis Taillon", "support_website_url": "https://www.neonkitevr.com/contact", "website_url": "https://www.neonkitevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "791700912222772"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035360_3213497065638881_4522436697499709862_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqDphtHrpUcQ7kNvwGhbD2m&_nc_oc=AdlYnm5wPL-DTyx23V0Na5Brx_XQKnvL8gwfJsCFrSX6veP09gCJngWB4RPmkR0Bud8&_nc_zt=3&_nc_ht=scontent-a
EUdzcw7mXypAhps&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afub-geQKiBEl4y3nZjfsG5lz6tL_PO5ZZUVvLXYIJSqrA&oe=69A6E97D"}, {"file_name": "arcade.png", "id": "630014648257746", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974472_630014651591079_7504793165658418968_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CMN8ypvNgwQ7kNvwFZ_8iL&_nc_oc=AdmMbWUar9ZvOvT1PbVa0JYkcTAojyd2m4Jod3KIHbmDJfgxNE97iPh2TJwana7O3wo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftuRVpWCzHyPI08GPcbuhHww5CyLDPmqTRVnrku4W24kQ&oe=69A6E138"}, {"file_name": "survival.png", "id": "988436068735862", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75422391_988436072069195_1389652558864199259_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wH3UBEeiilYQ7kNvwH8U7Is&_nc_oc=AdneXEkV1QRHuc23zWdjkIzdsFTcwQkOjggDX0G00_V1P6ynEVTLYzRSF4hA5e631TQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft6JOkCxC0tLtkNycKFA7hoKPS-UD8AeTlPe-qDM2B_xA&oe=69A6D1F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vidthumbsnail.png", "id": "962565014397132", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031384_962565017730465_4974300260370899112_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96_FKepkda8Q7kNvwFacOy2&_nc_oc=Admrj6We_3_pAVfz1Ar4Ri4aKgzvlIcPhHPmLnd_DvTZq-KIZm0sYhh2km5RzJE2ST4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs2UjR7IeThWQw3rhUDgZpq2cdLyNswzzzAzcnnJgtqzg&oe=69A6CC55"}, "display_name": "Neon Kite", "keywords": [], "long_description": "Neon Kite is a VR Arcade Kiteboarding Game inspired by the Synthwave genre.\n\nThere are 4 game modes available so far:\nTutorial: Learn the basics.\nChill: Free Play mode with no goal.\nArcade: Hit the goals with the matching color of the board.\nSurvival: Don't get eaten...\n\nEnable Pro Mode for more realistic control.\n\nMusic: \nESCP - https://escp-music.bandcamp.com\nMusic promoted by https://www.free-stock-music.com\nAttribution 4.0 International (CC BY 4.0)\nhttps://creativecommons.org/licenses/by/4.0/\n\nAnd Karl Casey @ White Bat Audio\n\nMore details on https://www.neonkitevr.com/music\n\n** Neon Kite may contain flashing imagery. Use the \"Light Mode\" at the beginning of the game for the same experience without flashes.\n\n** This game is still in development and the upcoming updates are included.\nYour support is greatly appreciated!", "short_description": "Neon Kite is a VR Arcade Kiteboarding Game."}]}, "developer_name": "Alexis Taillon", "developer_privacy_policy_url": "https://www.neonkitevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.neonkitevr.com/terms-conditions", "publisher_name": "Alexis Taillon", "support_website_url": "https://www.neonkitevr.com/contact", "website_url": "https://www.neonkitevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "791700912222772"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035360_3213497065638881_4522436697499709862_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TR_jPcsm3tUQ7kNvwHRwKKq&_nc_oc=AdkD0HbOTs3dRuotg2w21sfNHr6_Sj-mRbDjhlqEJe7rC9OgH4Wwd6lP6PmS_-QGLxs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftc765YyFIs1Frl22Y7T9xcJkLYHTi8wApDGVIKmvlorw&oe=69A6E0E6"}, "is_concept": false, "is_test
XgD5oACN8Q7kNvwFXFd63&_nc_oc=AdpGQAAA1n3EhVMZZ-wLJfm7bJko0Ei8j81y_RB-xBtLY1JwsFOv9mxJPZ80Yoa6bJ8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx1qOT31C1umXkQ5_wPXoT6HuyXITseT2IECqFEo14utg&oe=69C1477D"}, {"file_name": "arcade.png", "id": "630014648257746", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974472_630014651591079_7504793165658418968_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lt6TCDROMU0Q7kNvwGKSxsS&_nc_oc=AdrWMXKW3sr4mdBg8thyx1xdrZa3YyOnUVXdRgcSkCKyrwWE1Tv4PlEfRTQ4ypeBaPY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwkoP4LpMOL02BbPa05KNaFIZnU4_IG27MWtYaM_Wt2Lg&oe=69C13F38"}, {"file_name": "survival.png", "id": "988436068735862", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75422391_988436072069195_1389652558864199259_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkKQnSGRu4sQ7kNvwEv2gjv&_nc_oc=Adp5wh4EY_jVlmuWgo8jfzyL9vxssVDJ1GmaRcXkR_2j7FVCjTXG_SwkEEOwEoRs4lY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyYEWiJ4moF0ISfYBTju1jaOTW6U_2XCwMMM-ImiNdpjw&oe=69C12FF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vidthumbsnail.png", "id": "962565014397132", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031384_962565017730465_4974300260370899112_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtsWR4gfGKAQ7kNvwH53h_K&_nc_oc=Adrmexzhi7pXMUWb6Zk74fMHSTdfKqmfkUPxg2-QCGj3NO8SM8evoocXngiay3Y-XUs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzvZx7xj8TjG3A19NqDM0_ANnXyjRcirbgvS8zs6XygsA&oe=69C12A55"}, "display_name": "Neon Kite", "keywords": [], "long_description": "Neon Kite is a VR Arcade Kiteboarding Game inspired by the Synthwave genre.\n\nThere are 4 game modes available so far:\nTutorial: Learn the basics.\nChill: Free Play mode with no goal.\nArcade: Hit the goals with the matching color of the board.\nSurvival: Don't get eaten...\n\nEnable Pro Mode for more realistic control.\n\nMusic: \nESCP - https://escp-music.bandcamp.com\nMusic promoted by https://www.free-stock-music.com\nAttribution 4.0 International (CC BY 4.0)\nhttps://creativecommons.org/licenses/by/4.0/\n\nAnd Karl Casey @ White Bat Audio\n\nMore details on https://www.neonkitevr.com/music\n\n** Neon Kite may contain flashing imagery. Use the \"Light Mode\" at the beginning of the game for the same experience without flashes.\n\n** This game is still in development and the upcoming updates are included.\nYour support is greatly appreciated!", "short_description": "Neon Kite is a VR Arcade Kiteboarding Game."}]}, "developer_name": "Alexis Taillon", "developer_privacy_policy_url": "https://www.neonkitevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.neonkitevr.com/terms-conditions", "publisher_name": "Alexis Taillon", "support_website_url": "https://www.neonkitevr.com/contact", "website_url": "https://www.neonkitevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "791700912222772"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035360_3213497065638881_4522436697499709862_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9dEmcdj4UsQ7kNvwFxoy8N&_nc_oc=AdoUd2JYrfPGXcXrJT0nkvlLq_avffveiJwjI7NNwiRIBm1FA6jWfnXBzpj7e9MtJd0&_nc_zt=3&_nc_ht=scontent-a
zNthThTqYQ7kNvwHN96Bs&_nc_oc=AdloyFZ5ad5Qk7NQFAo4GLmsHdVLsc9XFduLrjyOP3e8493cFF4SbJsNomtEmC_qJyw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw8bMKfXa3Ta9PmKXfhOdcPHAI_CCxLI8eXAy5jAhc8Nw&oe=69B2C6FD"}, {"file_name": "arcade.png", "id": "630014648257746", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974472_630014651591079_7504793165658418968_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8QIagnm-9BUQ7kNvwFlKoOr&_nc_oc=Adk69ZtT__rDqh-duLKR_yNijpiNxzt8YLwNOv2D0ypjDKpZuZldeBx51t29V9QWxvE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzEBondseegnCXMJ2WHQN2GLbG68xA-t6OD6plinTNZig&oe=69B2BEB8"}, {"file_name": "survival.png", "id": "988436068735862", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422391_988436072069195_1389652558864199259_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ql4A_d62RsAQ7kNvwGD9X0j&_nc_oc=AdmTyQp-f94gytX795Ffq1xBThQF16k4D1_9psKpcwrGVcIHqclv6dalMoLJnEpXVVY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx0DffVo2QVoiqCciFiNM7BnymeT20qpPp1-N7kY-q0rg&oe=69B2AF73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vidthumbsnail.png", "id": "962565014397132", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031384_962565017730465_4974300260370899112_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kmyzzdj8BsIQ7kNvwEAGRks&_nc_oc=AdlI-G1FL1RaEi9wIO93r8WIxdZfopqtCrJcAliEUEiVHF9DW5VQ8Mb75omVHLj_S9Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afws0P8bIJmYhqI0YWmkT-vNbbu7UgmaYtYqccIFVmVrGg&oe=69B2A9D5"}, "display_name": "Neon Kite", "keywords": [], "long_description": "Neon Kite is a VR Arcade Kiteboarding Game inspired by the Synthwave genre.\n\nThere are 4 game modes available so far:\nTutorial: Learn the basics.\nChill: Free Play mode with no goal.\nArcade: Hit the goals with the matching color of the board.\nSurvival: Don't get eaten...\n\nEnable Pro Mode for more realistic control.\n\nMusic: \nESCP - https://escp-music.bandcamp.com\nMusic promoted by https://www.free-stock-music.com\nAttribution 4.0 International (CC BY 4.0)\nhttps://creativecommons.org/licenses/by/4.0/\n\nAnd Karl Casey @ White Bat Audio\n\nMore details on https://www.neonkitevr.com/music\n\n** Neon Kite may contain flashing imagery. Use the \"Light Mode\" at the beginning of the game for the same experience without flashes.\n\n** This game is still in development and the upcoming updates are included.\nYour support is greatly appreciated!", "short_description": "Neon Kite is a VR Arcade Kiteboarding Game."}]}, "developer_name": "Alexis Taillon", "developer_privacy_policy_url": "https://www.neonkitevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.neonkitevr.com/terms-conditions", "publisher_name": "Alexis Taillon", "support_website_url": "https://www.neonkitevr.com/contact", "website_url": "https://www.neonkitevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "791700912222772"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035360_3213497065638881_4522436697499709862_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPFhuiwKYTIQ7kNvwFFhwum&_nc_oc=AdlrN_-YWXV-4it14GC-p_a6oKR2crkgVNDLAOIPjA27RRrFYP0qz-2XntNKkAYrj3A&_nc_zt=3&_nc_ht=scontent-o
-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQLKsTMA_IVpvD2KW2ePbMfH1wfOj0G4WNIT1qeb1FQA&oe=6A9C1406"}, {"file_name": "scr5.png", "id": "246277687372076", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566677_246277690705409_2473846080075905053_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhfh2iUU5iMQ7kNvwG6qqv9&_nc_oc=AdoXG8GY-4qEcczmCAACW06ocSw3Gt02jleTvnxx4qnqSZkpLWJqz6b1q2ZFr0JnbgU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1C7ic-C2-DCOD7R7y88dt-I7djRj-snZqdLLTN8E2ew&oe=6A9C291C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "scr1.png", "id": "654714935933991", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974854_654714939267324_4530836751251932482_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdgPGcgy-9AQ7kNvwEOdyhZ&_nc_oc=AdqTfgtO6_oKWyywwkAMjP3nAViOYrKZgnLoesrSybmjDEMOoyL4D3LRyUxcpUeZmKI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIO40MdeXivFVbJKfgbxF0RLVPfvXZ9Y9w6abeYXDny2w&oe=6A9C29E4"}, "display_name": "Neon Kite", "keywords": [], "long_description": "** Neon Kite contains flashing imagery that may be uncomfortable for some users. But I\u2019m currently working on a no-flash mode.\n\n** This game is still in development and the upcoming updates are included.\nIf you are looking for a full game experience, I suggest that you wait for the official Oculus Store release. Your support is greatly appreciated!\n\nNeon Kite is a VR Arcade Kiteboarding Game inspired by the Synthwave genre.\n\nJoysticks and buttons are not a thing in this game! Use your body to surf, steer, jump, spin, glide, and dive! \nScore points and add time to the timer by passing through the checkpoints with the appropriate board\u2019s color (red and blue, just like BeatSaber!).\nThe Sea is randomly generated, every try is unique!\n\nMusic made (and approved!) by ESCP\nSynthetic, Above The Clouds, Through The Waves, Neonscapes, Sundown, Goodbye Ocean, and Stardrive \nBy | e s c p | https://escp-music.bandcamp.com\nMusic promoted by https://www.free-stock-music.com\nAttribution 4.0 Internation", "short_description": "Neon Kite is a VR Arcade Kiteboarding Game."}]}, "developer_name": "Alexis Taillon", "developer_privacy_policy_url": "https://www.neonkitevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.neonkitevr.com/terms-conditions", "publisher_name": "Alexis Taillon", "support_website_url": "https://www.neonkitevr.com/contact", "website_url": "https://www.neonkitevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "338944941436659"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PENDING", "id": "1641079453792939"}, {"status": "PENDING", "id": "965351873051558"}, {"status": "PENDING", "id": "1625872238524389"}, {"status": "PUBLISHED", "id": "195461572746260"}, {"status": "PUBLISHED", "id": "1876821542515935"}]}, "baseline_offer": {"id": "1876821542515935"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1641079453792939"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6876710815736931", "version": "0.7.5.3"}, "id": "167673648853086", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"node
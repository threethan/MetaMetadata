_nc_ss=8&oh=00_Afyb2P9EL8lFU5_HSuElJxhLZv-xShTG30JaLZfh2O5ong&oe=69BC004E"}, {"file_name": "6.png", "id": "549311438154543", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392298_549311441487876_3728304501720690017_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWbNvOGU8vYQ7kNvwFPV9By&_nc_oc=AdmJWhT7y8kyULp7ksgLhJ6J7YfiBb1nGdiMO_tHgyZWLvWXl-rOOQG-WIDgQj48q00&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxh2MQvqKfcXundl89SACoHa1rraVFjXdPToPp2dr_sUQ&oe=69BBF956"}, {"file_name": "8.png", "id": "1374609327327380", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393526_1374609330660713_5102815460113648464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkKBihm5kaUQ7kNvwG3pDIl&_nc_oc=AdnAKdQylT6tsVWOkmiKp1AA0LQpze9CILrlYLX8uPSP1ELBR5xRvbU9EnZboduqY1U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx3SA2SsI5TjYAd9c8GkR7TgajMAm1u7XQJDHAodUcoRg&oe=69BBEFAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "914855980540243", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393887_914855983873576_3471487188126119305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jp0m4dvgxZIQ7kNvwF0tXLO&_nc_oc=AdlZ0fc41dLeuLoczKYwfTGvOWNOj8ndXaiLtI2PbsPJm5IS3Ff2-vtJBi--UR5rSe0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwc1hq4r_BnWvymSKqLX0aXnmx8QPOw8olyS1k3oDDKRA&oe=69BBF60D"}, "display_name": "Factory Frenzy: Toy Rush", "keywords": ["toy", "factory", "job", "work", "learn"], "long_description": "Accept the challenge of operating a toy-packing factory as a single staff under the pressure of a tough Boss while time is ticking for the orders to dispatch. Operate the Fork-lift to load orders in truck while rush to the racks to load more and more toys. Sort through the toys in try for each order and fold, staple and label each carton in time.\n\nThe Boss will initially guide you for each process but if you are slow, the same Boss will get angry and put pressure on you to work with speed. Wrong orders would get rejected and need to be repacked.\n\nStack the packed cartons on pellets so can be lifted using Fork-lifter and load in Truck in time.", "short_description": "Accept the challenge of operating a toy-packing factory as a single staff under the pressure of a tough Boss while time is ticking for the orders to dispatch. Operate the Fork-lift to load orders in truck while rush to the racks to load more and more toys. Sort through the toys in try for each order and fold, staple and label each carton in time."}]}, "developer_name": "ABSTRON Pvt Ltd", "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD", "support_website_url": null, "website_url": "https://skippyapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9303961773054996"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391958_2292434421127554_7868987007485856554_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKUPJnqQRNMQ7kNvwH15e-V&_nc_oc=Adlob-qM7PKZoT-ccQ67cZ7KXV0TFXm9NyAh9fwKAxWskvAgy9A3zTK_9b1MyFnHrsk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzavKoIwccudDCGvM6VfAlwAoCIbdnx6A5Eog5BTjqkGw&oe
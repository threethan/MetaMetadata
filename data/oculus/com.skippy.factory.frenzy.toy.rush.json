 "6.png", "id": "549311438154543", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392298_549311441487876_3728304501720690017_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=besOR64bsOgQ7kNvwEFAarB&_nc_oc=Adq2HsEGV3l3UetaDx8cA-jpfgTKVdb8WCBYvcG_dR9s09ZPoCUglpRXOLuqKi7E_ZA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2rKxHqEQhfTkDoxGl8FMLRhtqgP5iGK9Us31_9qGpGuw&oe=69F0B556"}, {"file_name": "8.png", "id": "1374609327327380", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393526_1374609330660713_5102815460113648464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIKJ_AfATaMQ7kNvwFYxbWU&_nc_oc=Ado0YhA4miVjmC3wD8BCBYfwsSMFITjM8y8h2tyFgcVXBvoezmO5A79URPKrj6-LQvs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3_nItThry4nIYpv1oAPxxpBwU692Hwx3VytE3Zi2YTyg&oe=69F0ABAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "914855980540243", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393887_914855983873576_3471487188126119305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKxfW4bqYs0Q7kNvwG76lHi&_nc_oc=AdrHSwspKoC-5PScKP2I-aBx1z88-YmI6cqV-it2gRg6Ez4WNZXPI3IiLtDpNJnYDT0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2lzTz1CoqbSqCeUZcK50Gluq16unMxidMPkN9r3eH-8w&oe=69F0B20D"}, "display_name": "Factory Frenzy: Toy Rush", "keywords": ["toy", "factory", "job", "work", "learn"], "long_description": "Accept the challenge of operating a toy-packing factory as a single staff under the pressure of a tough Boss while time is ticking for the orders to dispatch. Operate the Fork-lift to load orders in truck while rush to the racks to load more and more toys. Sort through the toys in try for each order and fold, staple and label each carton in time.\n\nThe Boss will initially guide you for each process but if you are slow, the same Boss will get angry and put pressure on you to work with speed. Wrong orders would get rejected and need to be repacked.\n\nStack the packed cartons on pellets so can be lifted using Fork-lifter and load in Truck in time.", "short_description": "Accept the challenge of operating a toy-packing factory as a single staff under the pressure of a tough Boss while time is ticking for the orders to dispatch. Operate the Fork-lift to load orders in truck while rush to the racks to load more and more toys. Sort through the toys in try for each order and fold, staple and label each carton in time."}]}, "developer_name": "ABSTRON Pvt Ltd", "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD", "support_website_url": null, "website_url": "https://skippyapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9303961773054996"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2292434421127554_7868987007485856554_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUaPF9MRTl0Q7kNvwHztMF1&_nc_oc=AdpdhSm77Rf2MrLd1WbAXRt_nVTE49CaUjrKBBbfkwKK7buW_2pMa4VRg7NMCj5G-EQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3uEpv27j1gtT_ch04VBUfULhzkL2ih7t0N4HKvmJB4-A&oe=69F0C828"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Factory Frenzy: Toy Rush",
_nc_ss=8&oh=00_AftuK9MSYK-7DU_zCDfQyCw9HCv1aZUfUKBXHtqGKL723Q&oe=69A839CE"}, {"file_name": "6.png", "id": "549311438154543", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392298_549311441487876_3728304501720690017_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQPc_RVmejEQ7kNvwF7TiMt&_nc_oc=AdnqnfLk182tD8-Y4a-wNB4PvRsFqUtgbg15HBHyhyLdfaCIDDWFwgBkBuWIvrDhU-M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsvI7cCP_f5vInYvKikCYbeRKjUsJmJ4J6eB74O1iSuDQ&oe=69A832D6"}, {"file_name": "8.png", "id": "1374609327327380", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393526_1374609330660713_5102815460113648464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujnhmgp7cAoQ7kNvwHr6vzT&_nc_oc=AdlW-3C0x0iUT2MRtIPre7oMmTZ9rvjij7VdABS-yVVL9eI-J4OuaZ0sCpoYhXLJq9Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuhcYgYLcRwvtowEzwb0Gd7UXBFmQPFb2tl8xoreMAvqQ&oe=69A8292B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "914855980540243", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393887_914855983873576_3471487188126119305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kqj6HrA8VsUQ7kNvwGir-0q&_nc_oc=AdkDiDrBsHUZTXwvsklJ-Vl7p5DvY0OvYlYrd1V7UL-JfhiaJdFPYMNk0mQnD-9-VxM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsIz2GQtwzDkC71Q2uF0tQnHJi98Wb0hIKodltUVcyUWg&oe=69A82F8D"}, "display_name": "Factory Frenzy: Toy Rush", "keywords": ["toy", "factory", "job", "work", "learn"], "long_description": "Accept the challenge of operating a toy-packing factory as a single staff under the pressure of a tough Boss while time is ticking for the orders to dispatch. Operate the Fork-lift to load orders in truck while rush to the racks to load more and more toys. Sort through the toys in try for each order and fold, staple and label each carton in time.\n\nThe Boss will initially guide you for each process but if you are slow, the same Boss will get angry and put pressure on you to work with speed. Wrong orders would get rejected and need to be repacked.\n\nStack the packed cartons on pellets so can be lifted using Fork-lifter and load in Truck in time.", "short_description": "Accept the challenge of operating a toy-packing factory as a single staff under the pressure of a tough Boss while time is ticking for the orders to dispatch. Operate the Fork-lift to load orders in truck while rush to the racks to load more and more toys. Sort through the toys in try for each order and fold, staple and label each carton in time."}]}, "developer_name": "ABSTRON Pvt Ltd", "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD", "support_website_url": null, "website_url": "https://skippyapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9303961773054996"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_2292434421127554_7868987007485856554_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1nanQk1xScQ7kNvwHu0bIx&_nc_oc=AdlHKMGCxbljQyuujgNPS4eyCxlx1tlr-GdnfixCBGLIthf7foT3JOQGMAKKmNzKmko&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsuOTmr2NSW9fOIPOds1zG8uJHGC30FAKbH5eH0IGkmlA&oe
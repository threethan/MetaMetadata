 "6.png", "id": "549311438154543", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392298_549311441487876_3728304501720690017_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-K-Lus5ZS0Q7kNvwHM1TCq&_nc_oc=Admzb1RxVDZssUoIU-A0Q3GuTsIfiKDPQwUtNxgVh6oGWbAFDOCvDf6ic9vKLqCPBxM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu6Xh_UOXmI4gnabt3khvBWfH19YrmShYO4BoMJFsodVA&oe=699DA6D6"}, {"file_name": "8.png", "id": "1374609327327380", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393526_1374609330660713_5102815460113648464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcHlWcc02mUQ7kNvwE4Si4c&_nc_oc=AdlBUQTsrCQOyNjncK2j5Oi9uZunzPoDwLoHeupsXdU39nBSe-ZfBkHR6YRpvkW26jU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfseE0hPXeD1CdYodCGvAKcS9YD1EO0ToLVhoILSOMzxSQ&oe=699D9D2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "914855980540243", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393887_914855983873576_3471487188126119305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTQt30wntWsQ7kNvwF7D6fS&_nc_oc=Adnmgo7zf50hu193Iz0dHhijbI9cRI38ycvuBf1gZ4-2td2CBZ3JM-4YgF6ACvxJqOo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsxsh2YedNPEvEy7Hj28XV9oJJ-iDExylShboaaJkzhsg&oe=699DA38D"}, "display_name": "Factory Frenzy: Toy Rush", "keywords": ["toy", "factory", "job", "work", "learn"], "long_description": "Accept the challenge of operating a toy-packing factory as a single staff under the pressure of a tough Boss while time is ticking for the orders to dispatch. Operate the Fork-lift to load orders in truck while rush to the racks to load more and more toys. Sort through the toys in try for each order and fold, staple and label each carton in time.\n\nThe Boss will initially guide you for each process but if you are slow, the same Boss will get angry and put pressure on you to work with speed. Wrong orders would get rejected and need to be repacked.\n\nStack the packed cartons on pellets so can be lifted using Fork-lifter and load in Truck in time.", "short_description": "Accept the challenge of operating a toy-packing factory as a single staff under the pressure of a tough Boss while time is ticking for the orders to dispatch. Operate the Fork-lift to load orders in truck while rush to the racks to load more and more toys. Sort through the toys in try for each order and fold, staple and label each carton in time."}]}, "developer_name": "ABSTRON Pvt Ltd", "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD", "support_website_url": null, "website_url": "https://skippyapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9303961773054996"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2292434421127554_7868987007485856554_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9H8469FI7YUQ7kNvwFuQSZK&_nc_oc=Adk6ry1KGOWayu5Uh2Xukz-rJ1WPwSEbTXBHG7QQgNP7unfh1_r9-gtUhkXpuYSGI4Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvLMy10vnIyNdcnRMvrDZ-wTbzxU0m12IVn9vgY5T3Skg&oe=699D8168"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Factory Frenzy: Toy Rush",
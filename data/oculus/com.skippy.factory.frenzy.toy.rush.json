f-DrRU5CkmbqKI0nHK-iJ9gPeq2p8XIMUxRFreyQkAA4g&oe=6A37E656"}, {"file_name": "8.png", "id": "981554233911395", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393325_981554240578061_5085458958517087592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtrepucc09kQ7kNvwG4vE8y&_nc_oc=AdrBKA1CQ_k91y071gCrPAX-rK-1Bt_nOluV71f89aQvk-AQZDzRprv4M16j1h3YTEI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kaItdTvBGXAxgQvRc-k2VEY_qRezrBflzaoGhYVguBg&oe=6A37EB08"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Factory Frenzy: Toy Rush", "keywords": ["toy", "factory", "job", "work", "learn"], "long_description": "Accept the challenge of operating a toy-packing factory as a single staff under the pressure of a tough Boss while time is ticking for the orders to dispatch. Operate the Fork-lift to load orders in truck while rush to the racks to load more and more toys. Sort through the toys in try for each order and fold, staple and label each carton in time.\n\nThe Boss will initially guide you for each process but if you are slow, the same Boss will get angry and put pressure on you to work with speed. Wrong orders would get rejected and need to be repacked.\n\nStack the packed cartons on pellets so can be lifted using Fork-lifter and load in Truck in time.", "short_description": "Accept the challenge of operating a toy-packing factory as a single staff under the pressure of a tough Boss while time is ticking for the orders to dispatch. Operate the Fork-lift to load orders in truck while rush to the racks to load more and more toys. Sort through the toys in try for each order and fold, staple and label each carton in time."}]}, "developer_name": "ABSTRON Pvt Ltd", "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD", "support_website_url": null, "website_url": "https://skippyapps.com/", "category": null, "comfort_rating": "CO
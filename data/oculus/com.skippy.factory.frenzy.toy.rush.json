=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zfNXKCFzD4zgjG3j4Pue4h5PMUEpEb8Upca0FB8vmFA&oe=6A466DCE"}, {"file_name": "6.png", "id": "549311438154543", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392298_549311441487876_3728304501720690017_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99Jn1HPgFvIQ7kNvwG0xEcC&_nc_oc=AdoiTYh0IoyeVgq7rWshCwHDlpq9QV40K6P07WIfcV8ppC7ToA2MB_qBwB-MfyZ-cO0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7pOnWzbUduIYb90K1zxMiJV9F2YK8Nb70vvGNlK8mCg&oe=6A4666D6"}, {"file_name": "8.png", "id": "1374609327327380", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473393526_1374609330660713_5102815460113648464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b15zzVzEYGcQ7kNvwG9Smg0&_nc_oc=AdqNoyky4fjBda8QnaKXQoFBOg050EKnHbBZurABnU-IXT9KhmqsHO-AwwCPobRmm70&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SZoalPUt3o6l7wCZhYxzRpUh21T_SQgDfAbIUd3q1FA&oe=6A465D2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "914855980540243", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473393887_914855983873576_3471487188126119305_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3XAqR0bH3IQ7kNvwGlRQ-L&_nc_oc=AdpWLqym0f46tEtKrbqQTmi6-B2LldekbuzAJeqMdytnWAF02nc2VpNPNW9T8D4sPpw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-F89WUhLYExJznpQ4nL53Jr9shG4r7nktzPgAkNwV-PQ&oe=6A46638D"}, "display_name": "Factory Frenzy: Toy Rush", "keywords": ["toy", "factory", "job", "work", "learn"], "long_description": "Accept the challenge of operating a toy-packing factory as a single staff under the pressure of a tough Boss while time is ticking for the orders to dispatch. Operate the Fork-lift to load orders in truck while rush to the racks to load more and more toys. Sort through the toys in try for each order and fold, staple and label each carton in time.\n\nThe Boss will initially guide you for each process but if you are slow, the same Boss will get angry and put pressure on you to work with speed. Wrong orders would get rejected and need to be repacked.\n\nStack the packed cartons on pellets so can be lifted using Fork-lifter and load in Truck in time.", "short_description": "Accept the challenge of operating a toy-packing factory as a single staff under the pressure of a tough Boss while time is ticking for the orders to dispatch. Operate the Fork-lift to load orders in truck while rush to the racks to load more and more toys. Sort through the toys in try for each order and fold, staple and label each carton in time."}]}, "developer_name": "ABSTRON Pvt Ltd", "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD", "support_website_url": null, "website_url": "https://skippyapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9303961773054996"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391958_2292434421127554_7868987007485856554_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IYnAhdgFkIQ7kNvwEV3f2b&_nc_oc=AdpqfV8VQCvVEounKYEGb-VGnt-cJhZi_ZppqAh4OIHmCt-lOM74nP4kcIPRUFXWVVA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_n
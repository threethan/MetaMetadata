f2pg5fytZE1Km8lCHqf6k67HArpmy0dgjNdfCpMsoIcJQ&oe=69D65756"}, {"file_name": "8.png", "id": "981554233911395", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393325_981554240578061_5085458958517087592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoIhzyOPP7cQ7kNvwEQSSL_&_nc_oc=AdryZ_aQx1D0R5qUsAbGxQ_FoGaq950dx2XOQ9rnr1d51ia7Gh1VaKmPtCwV-ECfTzw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GK97ad_olpNKYu6AeSB5aVO6Rq9mDr63lxkWXQJcd5A&oe=69D65C08"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Factory Frenzy: Toy Rush", "keywords": ["toy", "factory", "job", "work", "learn"], "long_description": "Accept the challenge of operating a toy-packing factory as a single staff under the pressure of a tough Boss while time is ticking for the orders to dispatch. Operate the Fork-lift to load orders in truck while rush to the racks to load more and more toys. Sort through the toys in try for each order and fold, staple and label each carton in time.\n\nThe Boss will initially guide you for each process but if you are slow, the same Boss will get angry and put pressure on you to work with speed. Wrong orders would get rejected and need to be repacked.\n\nStack the packed cartons on pellets so can be lifted using Fork-lifter and load in Truck in time.", "short_description": "Accept the challenge of operating a toy-packing factory as a single staff under the pressure of a tough Boss while time is ticking for the orders to dispatch. Operate the Fork-lift to load orders in truck while rush to the racks to load more and more toys. Sort through the toys in try for each order and fold, staple and label each carton in time."}]}, "developer_name": "ABSTRON Pvt Ltd", "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD", "support_website_url": null, "website_url": "https://skippyapps.com/", "category": null, "comfort_rating": "CO
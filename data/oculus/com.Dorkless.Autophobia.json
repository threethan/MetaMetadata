ri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499295279_2110344499728944_1878018846617532567_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WdPjFYxDwQQ7kNvwHeV32K&_nc_oc=AdoYlwB8JEF4CAqJYwwiN9c3HKZnq46Fgw2PhhtYmCu_ZJcz5Bog8qauqgVWAU0SoDI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpUowYZl1Db8GX5JJXKOVZ1-iXCSZ7TqSbiKoqxx6JqQ&oe=6B09C60C"}, {"file_name": "SS3 (1).png", "id": "1780067252673011", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823431_1780067256006344_4465268074320918637_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbmwXOfbSjcQ7kNvwHgbkx9&_nc_oc=Adq8__0JC18lJne7w0z9XsbkrcA9mTh4XpSgPxfv-rUeNI8MtticftzX7hJ1CEgRonQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaHDk9bZcDCx43pgJO-BAp8UvKVAkKvr6cz0fEr6bAlA&oe=6B09CC15"}, {"file_name": "SS4 (1).png", "id": "1194838315362510", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298502_1194838318695843_6950081927292463613_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-vpt0qxXzAQ7kNvwGjNNV3&_nc_oc=AdoVLEMmIakyq2xRnGXRRJ_53IVEbvWAa2N3dxGUhT0-RNTilqo9J8qHsStNJL1PWy8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSJY7EdIg6xynalgsN_1hlCNt1k2EujJK7HuK7KnCXaA&oe=6B09B109"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS5 (1).png", "id": "656394350797286", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491822817_656394354130619_4479930828811088369_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bvrh_5x9UZEQ7kNvwFoyvD4&_nc_oc=Adr6zzen76EH7j17w_qOVAllY5tAqgNYuIvsFjKci9Z0RG8gL0gqlB6J6NgTi9tp0NM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9Q2DexbXqRyV39T_AZRB9ONC6ogCC2b9leRxZRavS7w&oe=6B09A809"}, "display_name": "Autophobia VR", "keywords": ["liminal", "liminality", "horror", "autophobia"], "long_description": "Step into the surreal and unsettling world of Autophobia, a liminal space exploration game that combines the eerie beauty of forgotten places with the dynamic movement of your own hands. Navigate endless corridors, abandoned malls, surreal bathrooms, and otherworldly environments that blur the line between dreams and reality.\n\nLeap, climb, and swing through hauntingly atmospheric spaces with intuitive, physics-based locomotion. Uncover cryptic clues, solve puzzles, and unravel the mystery of how you got here \u2013 and how to escape. But beware, you're not alone. Shadows stir in the silence, and something is watching...\n\nWith immersive multiplayer modes, discover, explore, and survive alongside friends, or venture into the unknown solo for a truly spine-chilling experience. Will you find your way out, or will you become part of the forgotten?\n\nKeep in mind; this is a WIP! Some areas are not finished!", "short_description": "You have been here before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/autophobiavr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Dorkless", "support_website_url": null, "website_url": "https://sites.google.com/view/autophobiavr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "25476587708617775"}, "review_messages": []}]}, "cover_squ
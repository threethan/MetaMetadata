LM9qsNcEyv9QX5cUL5KSYX3fTUPjE8bO3_rJG1VvfpEo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NjXGYbccKtpr34dph7e_Tzq085tvJVSb-2Y_zoEUi0g&oe=6A3D354C"}, {"file_name": "SS3 (1).png", "id": "1780067252673011", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823431_1780067256006344_4465268074320918637_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yecsZUCqO0Q7kNvwFpDUAG&_nc_oc=Adqdxb3GTdymS--cAvBDmcQ35Rk-8qVEG0sG6qmLh9872Th5F8uPEbntbBcgtY-yKh8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qv6Ts5GP_hd7ryg1vg0xn2EXn7Dyw-S-WSGACMnmcTA&oe=6A3D3B55"}, {"file_name": "SS4 (1).png", "id": "1194838315362510", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499298502_1194838318695843_6950081927292463613_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJY8PK-LYkkQ7kNvwFBiw0y&_nc_oc=Adq5pacnvR6CR5HzzSwLiLh7FOvv0Z8b5EDlLhOn9FnovXa6MerA0U0wfk0W6OerqJM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BKSa_beZhCfLKnf7oUcVlFu9R_KA4woclKwsZjpMhwQ&oe=6A3D5889"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS5 (1).png", "id": "656394350797286", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822817_656394354130619_4479930828811088369_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_L_k8aZK8h0Q7kNvwG-KM0m&_nc_oc=Adp2Ot8w9uRpVEn4LoT45Jbq7b9e1Bfuq0Qy9ldCg2Qq1nrVkD8vKq3HQ_299KPkNvE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OmQG0GIAGv8jwi-0_ngSFYpqMbaCSjqraj85xExCHig&oe=6A3D4F89"}, "display_name": "Autophobia VR", "keywords": ["liminal", "liminality", "horror", "autophobia"], "long_description": "Step into the surreal and unsettling world of Autophobia, a liminal space exploration game that combines the eerie beauty of forgotten places with the dynamic movement of your own hands. Navigate endless corridors, abandoned malls, surreal bathrooms, and otherworldly environments that blur the line between dreams and reality.\n\nLeap, climb, and swing through hauntingly atmospheric spaces with intuitive, physics-based locomotion. Uncover cryptic clues, solve puzzles, and unravel the mystery of how you got here \u2013 and how to escape. But beware, you're not alone. Shadows stir in the silence, and something is watching...\n\nWith immersive multiplayer modes, discover, explore, and survive alongside friends, or venture into the unknown solo for a truly spine-chilling experience. Will you find your way out, or will you become part of the forgotten?\n\nKeep in mind; this is a WIP! Some areas are not finished!", "short_description": "You have been here before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/autophobiavr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Dorkless", "support_website_url": null, "website_url": "https://sites.google.com/view/autophobiavr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "25476587708617775"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499310720_2074638823354477_5745872773407527797_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVnk7s9jsRoQ7kNvwEqUIuQ&_nc_oc=Adq3_Vot9Ir5zvMwHf82qPftT3gNsvy-cJKitOizJl7kQwvGPOfJdWNXw3fXwBtiKNY&_nc_zt=3&_nc_ht=sconten
ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295279_2110344499728944_1878018846617532567_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EegWD7IxVC8Q7kNvwFYryaa&_nc_oc=Adqedj7HRC4W-xtwqFpwH1VIDnzvgtGY8lsSR9m_xFnwX0c-JJqWAu6pDxBr4qYWSmM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAclMCQb9LkTcxx4QjtHEef5ychpLGho3rCa_cUU3JFg&oe=6B04800C"}, {"file_name": "SS3 (1).png", "id": "1780067252673011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823431_1780067256006344_4465268074320918637_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLJJ8b1enWwQ7kNvwGGcnUx&_nc_oc=AdrE7rR_tr1fhbsT_6crhSUKvqWH-hlwHdCzfZc1QXtEhl2EENqpls1aiUaFT4EDYlY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-zTsj70TimKhbXjIa39-ofVgyyuHU8E6azGuoiaIAHA&oe=6B048615"}, {"file_name": "SS4 (1).png", "id": "1194838315362510", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1194838318695843_6950081927292463613_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNKKhdquuPEQ7kNvwHAGwXb&_nc_oc=AdpLHQRmMby1vVJyYvbxfXo15xDP38_HRkSkZVZFOHNTdooEEcflQ6JI9FY8RaYuUsg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTzo_bzGmEnfatSBmMud-X8OgQSaTe44mEdGqcqLbLzg&oe=6B046B09"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS5 (1).png", "id": "656394350797286", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822817_656394354130619_4479930828811088369_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmpCfzYxeG8Q7kNvwEeDYKh&_nc_oc=AdrdT_AOewKgoWGv7_vAwrAJxanXbTmxFIvxXxhTMNEuxDXM1UQp8pHN3pnOFJS2_D4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQik9AiM6fDaF_XMC8vphX9CewASF0zu9_o9rmouNFhng&oe=6B046209"}, "display_name": "Autophobia VR", "keywords": ["liminal", "liminality", "horror", "autophobia"], "long_description": "Step into the surreal and unsettling world of Autophobia, a liminal space exploration game that combines the eerie beauty of forgotten places with the dynamic movement of your own hands. Navigate endless corridors, abandoned malls, surreal bathrooms, and otherworldly environments that blur the line between dreams and reality.\n\nLeap, climb, and swing through hauntingly atmospheric spaces with intuitive, physics-based locomotion. Uncover cryptic clues, solve puzzles, and unravel the mystery of how you got here \u2013 and how to escape. But beware, you're not alone. Shadows stir in the silence, and something is watching...\n\nWith immersive multiplayer modes, discover, explore, and survive alongside friends, or venture into the unknown solo for a truly spine-chilling experience. Will you find your way out, or will you become part of the forgotten?\n\nKeep in mind; this is a WIP! Some areas are not finished!", "short_description": "You have been here before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/autophobiavr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Dorkless", "support_website_url": null, "website_url": "https://sites.google.com/view/autophobiavr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "25476587708617775"}, "review_messages": []}]}, "cover_squ
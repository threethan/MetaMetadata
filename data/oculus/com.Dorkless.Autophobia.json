ntent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbnlI89am_PDTG9z6lvkXu3A7D75VpTSmjHIF91aJnTQ&oe=6A69F349"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS5 (1).png", "id": "656394350797286", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_656394354130619_4479930828811088369_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiP0XlmFEQcQ7kNvwENc21c&_nc_oc=AdoKPWq86B-edUDDXxGa5JWaHFDrDUErdiYlf5qnoKwtH9NVRbtzOmbkyt5RitUiHRY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZ1Z5GEp-Dk-GvO8NInSWeJ_uZmC6tiwMTdsy68Ulf2A&oe=6A69EA49"}, "display_name": "Autophobia VR", "keywords": ["liminal", "liminality", "horror", "autophobia"], "long_description": "Step into the surreal and unsettling world of Autophobia, a liminal space exploration game that combines the eerie beauty of forgotten places with the dynamic movement of your own hands. Navigate endless corridors, abandoned malls, surreal bathrooms, and otherworldly environments that blur the line between dreams and reality.\n\nLeap, climb, and swing through hauntingly atmospheric spaces with intuitive, physics-based locomotion. Uncover cryptic clues, solve puzzles, and unravel the mystery of how you got here \u2013 and how to escape. But beware, you're not alone. Shadows stir in the silence, and something is watching...\n\nWith immersive multiplayer modes, discover, explore, and survive alongside friends, or venture into the unknown solo for a truly spine-chilling experience. Will you find your way out, or will you become part of the forgotten?\n\nKeep in mind; this is a WIP! Some areas are not finished!", "short_description": "You have been here before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/autophobiavr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Dorkless", "support_website_url": null, "website_url": "https://sites.google.com/view/autophobiavr/home", "category": null, "c
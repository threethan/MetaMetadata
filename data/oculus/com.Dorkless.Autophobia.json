B6o0_3eUATzJuqvowfdRqO3PtmyO1pr6jI_-aHQ4maqY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIz-SCTiuuij-xhqxakmS00t_zjQgi-znYq7xFdkwyA3Q&oe=6AA1674C"}, {"file_name": "SS3 (1).png", "id": "1780067252673011", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823431_1780067256006344_4465268074320918637_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0B8WOCnOELcQ7kNvwHAdovM&_nc_oc=AdrBe-jaMzncQjQWFrWG8Uh7jX_ssqrqntzCuBMrgLo2eSFoHYtEzkoNbe_5WOCx2Ds&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFJHwuSX_tAMXN_-XdsVByyi-w6m8_xrvB1MCT8kgNqg&oe=6AA16D55"}, {"file_name": "SS4 (1).png", "id": "1194838315362510", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499298502_1194838318695843_6950081927292463613_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVYbD3-WtkEQ7kNvwG1Yf02&_nc_oc=AdpOj6I-zIhJqq812Zg4EWPpqfFLkN1x0ExLLbDxetxj0XlCYIa0xP1O5sBDHxSLKZA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIo3Aq1MvLoWJth-FG6lmTVjD174w9Ayv_68k38wH9drA&oe=6AA15249"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS5 (1).png", "id": "656394350797286", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822817_656394354130619_4479930828811088369_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RzCPJ9Yq0sgQ7kNvwHOjnHZ&_nc_oc=AdqEzKad5SrlT1SJS0PA-3pZXeavVCe4oh2I2C2-OjOd2syZeKg_OLTRwnQotK0gPuE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKZ_Nnfw0X38aKo0qWXAsnf9rM5ce0zPh_30cd4uoxNg&oe=6AA14949"}, "display_name": "Autophobia VR", "keywords": ["liminal", "liminality", "horror", "autophobia"], "long_description": "Step into the surreal and unsettling world of Autophobia, a liminal space exploration game that combines the eerie beauty of forgotten places with the dynamic movement of your own hands. Navigate endless corridors, abandoned malls, surreal bathrooms, and otherworldly environments that blur the line between dreams and reality.\n\nLeap, climb, and swing through hauntingly atmospheric spaces with intuitive, physics-based locomotion. Uncover cryptic clues, solve puzzles, and unravel the mystery of how you got here \u2013 and how to escape. But beware, you're not alone. Shadows stir in the silence, and something is watching...\n\nWith immersive multiplayer modes, discover, explore, and survive alongside friends, or venture into the unknown solo for a truly spine-chilling experience. Will you find your way out, or will you become part of the forgotten?\n\nKeep in mind; this is a WIP! Some areas are not finished!", "short_description": "You have been here before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/autophobiavr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Dorkless", "support_website_url": null, "website_url": "https://sites.google.com/view/autophobiavr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "25476587708617775"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499310720_2074638823354477_5745872773407527797_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRfySIed0iIQ7kNvwEEfLZi&_nc_oc=Adp42g21TgVdH9Hvr4jxIYt0a63I3P6IUBcAAZdRo9mfHGMyzPMQtJmyd7TOQvJObwU&_nc_zt=3&_nc_ht=sconten
b6Vl4OBmZYcjViJ06lhxud59_Yu9K2Kink1Dev7r_DnI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_e7aAZ4W83yWKZAEfR0V7ryNg4ncUU74pW5gH0e39h0g&oe=6A2C11CC"}, {"file_name": "SS3 (1).png", "id": "1780067252673011", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823431_1780067256006344_4465268074320918637_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOEkyP-HOw4Q7kNvwFgPRYH&_nc_oc=AdprtyvO7V_2jB97jkmssCDo6GXLQRAV98XdmqbG1KMwU5eM1dujkKhLNcdKapvzg4I&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LjbT7lpGGCbp-bBCa1H58JqQqtMX1CSXei_Y1LbW0rw&oe=6A2C17D5"}, {"file_name": "SS4 (1).png", "id": "1194838315362510", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499298502_1194838318695843_6950081927292463613_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLQj2SM2UkgQ7kNvwEubRYN&_nc_oc=AdphKRLIKmpXdoU31LaNziOjZReF8xjsiPmMgtkp2dBo02o-8QRtFuvPsr8mZc7G_MQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Mz9BC3st5LDnUqVYYa7bD-Rk1i3-ZXgh8lgVEhwxr8w&oe=6A2BFCC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS5 (1).png", "id": "656394350797286", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491822817_656394354130619_4479930828811088369_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDP0z3wmGFkQ7kNvwHcnzZ6&_nc_oc=AdrrsG0cpAxGv5auf2QjLX1aEnd-J-2BbbfA6npl4DsI6HsN0jF-SNvKO_kggxwp2iE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dYOJwpifVDdG8q5nXtxZl9e9hlV6HlzXodlBqGm46gg&oe=6A2C2C09"}, "display_name": "Autophobia VR", "keywords": ["liminal", "liminality", "horror", "autophobia"], "long_description": "Step into the surreal and unsettling world of Autophobia, a liminal space exploration game that combines the eerie beauty of forgotten places with the dynamic movement of your own hands. Navigate endless corridors, abandoned malls, surreal bathrooms, and otherworldly environments that blur the line between dreams and reality.\n\nLeap, climb, and swing through hauntingly atmospheric spaces with intuitive, physics-based locomotion. Uncover cryptic clues, solve puzzles, and unravel the mystery of how you got here \u2013 and how to escape. But beware, you're not alone. Shadows stir in the silence, and something is watching...\n\nWith immersive multiplayer modes, discover, explore, and survive alongside friends, or venture into the unknown solo for a truly spine-chilling experience. Will you find your way out, or will you become part of the forgotten?\n\nKeep in mind; this is a WIP! Some areas are not finished!", "short_description": "You have been here before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/autophobiavr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Dorkless", "support_website_url": null, "website_url": "https://sites.google.com/view/autophobiavr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "25476587708617775"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499310720_2074638823354477_5745872773407527797_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3u7yRAe4SIQ7kNvwHZAgG5&_nc_oc=AdoqRdhB1WMdSObYsc2ZQP8IoB0k5xbrfBI47deWoCVU-4XqFTX4_VoPpoFjIESnPSs&_nc_zt=3&_nc_ht=sconten
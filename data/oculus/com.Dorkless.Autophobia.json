IAmOj-SQRszTicQPzH4j4qzuY6UdY5W24Wl_de577osc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCX6hgTbnuE0iBwh5_eUSfDLVJaHOqhUqkpSluaTJZHVA&oe=6A4FAA4C"}, {"file_name": "SS3 (1).png", "id": "1780067252673011", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823431_1780067256006344_4465268074320918637_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHEnGYGP1e0Q7kNvwExtC6P&_nc_oc=AdoLb48xB283YWaXJqsAgopXMlfP1zl18Adq0yCF_aXxX_oOGU2EDkjOJQj06WWU_a4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8sSgMjVrv2AzS8anPYGqJXftRpJYh1d06iCkKAPjmag&oe=6A4FB055"}, {"file_name": "SS4 (1).png", "id": "1194838315362510", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298502_1194838318695843_6950081927292463613_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygTZ2Lrgvv4Q7kNvwGTN7rb&_nc_oc=AdrY5fZmtglR8Nnaavc2GQvWo3DMdTj71fHntqrGdlR3N2sNLwgeCP2tgTMxCpJVEqU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfwX6djG-nTwazJPGUGiwAVR7PWkBQkY6tEpq550jdjw&oe=6A4F9549"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS5 (1).png", "id": "656394350797286", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_656394354130619_4479930828811088369_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBQCWTO0QvIQ7kNvwHa5hRz&_nc_oc=AdpoItxrwl0vIc1GP3djW8NTaplYMJyDY3a5Q-FwpbRw0S4lH868YjTvygDJWO5-a18&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6sd1RagC-zUIronY6ireWgC3naUCM6iGR3Y3iKGWLCA&oe=6A4FC489"}, "display_name": "Autophobia VR", "keywords": ["liminal", "liminality", "horror", "autophobia"], "long_description": "Step into the surreal and unsettling world of Autophobia, a liminal space exploration game that combines the eerie beauty of forgotten places with the dynamic movement of your own hands. Navigate endless corridors, abandoned malls, surreal bathrooms, and otherworldly environments that blur the line between dreams and reality.\n\nLeap, climb, and swing through hauntingly atmospheric spaces with intuitive, physics-based locomotion. Uncover cryptic clues, solve puzzles, and unravel the mystery of how you got here \u2013 and how to escape. But beware, you're not alone. Shadows stir in the silence, and something is watching...\n\nWith immersive multiplayer modes, discover, explore, and survive alongside friends, or venture into the unknown solo for a truly spine-chilling experience. Will you find your way out, or will you become part of the forgotten?\n\nKeep in mind; this is a WIP! Some areas are not finished!", "short_description": "You have been here before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/autophobiavr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Dorkless", "support_website_url": null, "website_url": "https://sites.google.com/view/autophobiavr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "25476587708617775"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310720_2074638823354477_5745872773407527797_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAawq0RYEb4Q7kNvwEZxBa1&_nc_oc=AdohfVLqqv8E-v9cKGjUq7LjBhfULeOnI1zu0xN7xWWtvqplR4Jdof5TwaB3XLvoosM&_nc_zt=3&_nc_ht=sconten
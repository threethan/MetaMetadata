L6fTr8uH1VtqOnw7PrK2SCNHTp0Z4BjE6M7otXw&oe=699DAFCC"}, {"file_name": "SS3 (1).png", "id": "1780067252673011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823431_1780067256006344_4465268074320918637_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSjWou2iyAgQ7kNvwH3Ikr-&_nc_oc=Adnnc-gokIvVwbOZZvzHLkaXQrrpK0-AJzzBq0Y6ULAnGeurd6ctaOFlDe9m2Pb6Nxk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfusfIy1tFWGkzP9tQvNylptwrOybpFtLdE9A_9swvMoow&oe=699DB5D5"}, {"file_name": "SS4 (1).png", "id": "1194838315362510", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1194838318695843_6950081927292463613_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dm5v4dwCT4kQ7kNvwFFyR9y&_nc_oc=AdlywF8pOJW2bWQUAYht2aY4fVOmag19pO7TuiS8O-elvFFSHSZpthIrC6oq7qNTTfQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuR0ZpCBfHHk9_qfH59zsUMtR1D825YMTxfJm-0RqPd1Q&oe=699D9AC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS5 (1).png", "id": "656394350797286", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822817_656394354130619_4479930828811088369_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOBVao6BrD8Q7kNvwHVY8TW&_nc_oc=AdkUf8Wxeo2t5wtL0H8NQJFU7tP7uXX2IvlzehRpqf3yRNG1HlTGPBKq2fsJ2kkj0yk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftRVX_-QmrBfbXb-Eid35BDGJqxXxB9X5CBKgTonVDCFQ&oe=699D91C9"}, "display_name": "Autophobia VR", "keywords": ["liminal", "liminality", "horror", "autophobia"], "long_description": "Step into the surreal and unsettling world of Autophobia, a liminal space exploration game that combines the eerie beauty of forgotten places with the dynamic movement of your own hands. Navigate endless corridors, abandoned malls, surreal bathrooms, and otherworldly environments that blur the line between dreams and reality.\n\nLeap, climb, and swing through hauntingly atmospheric spaces with intuitive, physics-based locomotion. Uncover cryptic clues, solve puzzles, and unravel the mystery of how you got here \u2013 and how to escape. But beware, you're not alone. Shadows stir in the silence, and something is watching...\n\nWith immersive multiplayer modes, discover, explore, and survive alongside friends, or venture into the unknown solo for a truly spine-chilling experience. Will you find your way out, or will you become part of the forgotten?\n\nKeep in mind; this is a WIP! Some areas are not finished!", "short_description": "You have been here before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/autophobiavr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Dorkless", "support_website_url": null, "website_url": "https://sites.google.com/view/autophobiavr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "25476587708617775"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310720_2074638823354477_5745872773407527797_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Rez2i72TZ8Q7kNvwFnbjbF&_nc_oc=AdmiHrk3qltkhBJIZcNZUxyeB4NCz5YIjNGJTq0CmZGNtw1XQcPhRkcvpR-lp007zOA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvn7QtYtfmZ7aAMuCoWIOxBWmQmQFCNjBpn1b8UKWTF5g&oe=699D9C98"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": fa
S", "screenshots": [{"file_name": "screen_eiffel.png", "id": "1003295501194525", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031497_1003295504527858_1355123723881080648_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSgatBJDyRIQ7kNvwHqTVJ7&_nc_oc=AdlJ8EwVPWO7OegnaK-GGSUew2n_g2rUeWzA3UIpRloNk7c9UPE2u15dNZsUowM-IE8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfubGg7fDg9erDm_xuAmn9GU6RfAiOoOWEscK3Sg2ZN3WA&oe=69A178DC"}, {"file_name": "screen_fountain.png", "id": "466331849479650", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39035347_466331852812983_5486320624006544793_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYZBMWwEAs8Q7kNvwFONxr6&_nc_oc=AdmeaLbyzhGsNPIwrKOQWlHR9x7vumZRBpom0J5B5Yw2XOZ8GYa9Oi_u9sYOoBvTUrA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afv7U74iOIj2Og9Gmrdqe2DlsAmeXSHkfyBRu_0fBCkGJA&oe=69A1972A"}, {"file_name": "screen_mgm.png", "id": "1122330232165300", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39001728_1122330235498633_1734121490777853532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hmvmvh1WI9kQ7kNvwFgqZYP&_nc_oc=AdkseY1k_unVh82gOxE36ilUtUeaEZ2NdFBi31uBJkJQ4y2Q8ksxeSTnpGccCe5lbyQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuDB9qkLsLeotsN3PLnm3j__OWx_UVLa0SplbM33RSm5Q&oe=69A1A128"}, {"file_name": "screen_ny.png", "id": "1411688526185233", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75280177_1411688536185232_8539399949079837272_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfJ2iVOl0jQQ7kNvwEoUaRX&_nc_oc=Adno4AAY7m1LEKLXBUhBz9N4abf6PPCymymydyBl1zt_L9ux8ikGbVHgCZZt39r8Xus&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuxySic8v8PJl8Hiyv0Tliacj8ZNoiNBvKFjJ4Ff3QYRw&oe=69A18813"}, {"file_name": "screen_strato.png", "id": "2570873886428849", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75647712_2570873889762182_4179811984470606172_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fk2mm79mKAcQ7kNvwEGeCcr&_nc_oc=AdlDE5Wcon8EtyMdQHA1JLCfujerY_tSNzoKchUEIdiD-CPMjhDoGjMh2c0NzWC4dyA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afts6zSerXFrnp-mvKyGzrQBsg485gQt0iYr1rfM0BskJg&oe=69A19855"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Las Vegas Heli Flight Hanging outside of the helicopter", "keywords": [], "long_description": "Nice VR experience and beautiful memories if you already were there or if not, gain experience as if you are there.\nThis App give you the impression to really be over Las Vegas close to the buildings.\nTake that crazy 360 degree real helicopter flight over Vegas by night without leaving your home, even without leaving your couch!\n\nYou have never seen this before. \nThis is the ultimate VR Experience ... frameless. \n\nFlight time: 14 minutes.\n\nThere are no simulation all is real. It is a real helicopter flight.\nYou fly an extraordinary route, directly over the Strip and over the hotel skyscrapers. The normal tourist sightseeing flight routes are always far from the Strip and cost many times more than that great app-flight experience. The normal tourist helicopter you can see on the horizon. If you have made such a tourist flight Las Vegas once, test the difference here.\n\nYou never have seen Las Vegas from above like THIS!\nTake the helicopter and fly over the shiny illuminated famous Strip with its hotels and attractions.\nLook into any direction, even up and down.\nLook up at the helicopter and track its flight over Vegas.\nLook down and see all the hotels, the towers, the fountains, the Eiffel Tower ...", "short_description": "There are no simulation all is real. It is a real helicopter flight. You never have seen Las Vegas from above like THIS! And you hang outside of the helicopter."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/vegas", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "https://www.vrtravelx.net/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8087215344625845"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1651773429126776"}, {"status": "PUBLISHED", "id": "2486484471753827"}, {"status": "PUBLISHED", "id": "1486845205951115"}, {"status": "PUBLISHED", "id": "2028454484579987"}, {"status": "PUBLISHED", "id": "1200439081848184"}, {"status": "PUBLISHED", "id": "668828345917010"}, {"status": "PUBLISHED", "id": "1561181304554581"}, {"status": "PUBLISHED", "id": "949109597314222"}, {"status": "PUBLISHED", "id": "553654700792266"}, {"status": "PUBLISHED", "id": "1446903949295134"}]}, "baseline_offer": {"id": "1446903949295134"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "1651773429126776"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "10016340291713331", "version": "2.0"}, "id": "394397666534833", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8087215334625846", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "10016340291713331"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id
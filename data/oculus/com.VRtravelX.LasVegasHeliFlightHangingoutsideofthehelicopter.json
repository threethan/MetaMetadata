p6oHzXcB4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC84jOU800lLltIHX4EmEMXXif2_Jy_PXEpuDAVb23b0Q&oe=6A4F8E13"}, {"file_name": "screen_strato.png", "id": "2570873886428849", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75647712_2570873889762182_4179811984470606172_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIosAsYrYe8Q7kNvwGkhCVI&_nc_oc=AdqLN35Opm8UwYaDy0ml2i8gPnXflN6-v7GmEY6pPuOvnTQXc9bA10MaQHaYXFmIarg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMKo9p3UeLJecovA1Ac-IfYi4FaOhxkiHtG81EmO4jOQ&oe=6A4F9E55"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Las Vegas Heli Flight Hanging outside of the helicopter", "keywords": [], "long_description": "Nice VR experience and beautiful memories if you already were there or if not, gain experience as if you are there.\nThis App give you the impression to really be over Las Vegas close to the buildings.\nTake that crazy 360 degree real helicopter flight over Vegas by night without leaving your home, even without leaving your couch!\n\nYou have never seen this before. \nThis is the ultimate VR Experience ... frameless. \n\nFlight time: 14 minutes.\n\nThere are no simulation all is real. It is a real helicopter flight.\nYou fly an extraordinary route, directly over the Strip and over the hotel skyscrapers. The normal tourist sightseeing flight routes are always far from the Strip and cost many times more than that great app-flight experience. The normal tourist helicopter you can see on the horizon. If you have made such a tourist flight Las Vegas once, test the difference here.\n\nYou never have seen Las Vegas from above like THIS!\nTake the helicopter and fly over the shiny illuminated famous Strip with its hotels and attractions.\nLook into any direction, even up and down.\nLook up at the helicopter and track its flight over Vegas.\nLook down and see all the hotels, the towers, the fountains, the Eiffel Tower ...", "short_description": "There are no simulation all is real. It is a real helicopter flight. You never have seen Las Vegas from above like THIS! And you hang outside of the helicopter."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/vegas", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "https://www.vrtravelx.net/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8087215344625845"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1037844535491344"}, {"status": "PUBLISHED", "id": "2994207280788991"}, {"status": "PUBLISHED", "id": "852935961104335"}, {"status": "PUBLISHED", "id": "1651773429126776"}, {"status": "PUBLISHED", "id": "2486484471753827"}, {"status": "PUBLISHED", "id": "1486845205951115"}, {"status": "PUBLISHED", "id": "2028454484579987"}, {"status": "PUBLISHED", "id": "1200439081848184"}, {"status": "PUBLISHED", "id": "668828345917010"}, {"status": "PUBLISHED", "id": "1561181304554581"}, {"status": "PUBLISHED", "id": "949109597314222"}, {"status": "PUBLISHED", "id": "553654700792266"}, {"status": "PUBLISHED", "id": "1446903949295134"}]}, "baseline_offer": {"id": "1446903949295134"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786726800, "status": "PUBLISHED", "id": "1037844535491344"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__type
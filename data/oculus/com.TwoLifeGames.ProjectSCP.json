p", "survive", "free", "multiplayer", "backrooms"], "long_description": "*Note from developer*: Please stop downloading this game it sucks and I made it in like a month and only released it because I didn't think anyone would play it. Play other higher quality scp games instead of this one.\n\nUpdate Ver 11: New gamemode, Run From 096. Read update log for more.\n\nSecure, Contain, Protect.\n\nA social sandbox based in the SCP universe where you can survive and meet other people within SCP Site 17. Choose to be an SCP or a human. Whoever you choose will give you special abilities or items that will help you stay alive.", "short_description": "Multiplayer SCP Survival"}]}, "developer_name": null, "developer_privacy_policy_url": "https://desmondlorenzini.github.io/TwoLifeGames/", "developer_terms_of_service_url": null, "publisher_name": "Desmond Lorenzini", "support_website_url": null, "website_url": "https://desmondlorenzini.github.io/TwoLifeGames/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "33213172871607263"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821989_3976967099260282_811175505808419150_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoojnNhKSDoQ7kNvwGeftCE&_nc_oc=AdlSUimdGv0yBohv9lFWZI_E
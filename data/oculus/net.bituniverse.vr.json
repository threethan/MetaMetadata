TG_odatKog7nakk-MiEaQxD0KTWIy4IQzzkqMiZDnEacZc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSp3anbvxzQXMZ7KVXNm6P6Mu0kQYLYd_rDyyMqqG4-5g&oe=6AFC8E06"}, {"file_name": "03-moon.png", "id": "1071384938989117", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499301196_1071384942322450_5667230253060557647_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKEhy5Ut7jIQ7kNvwHWSJRF&_nc_oc=Adr303sz1tSzytyFEWp1thTaBWpLpqS60jaf6rA47AxRbkMMOuHURoXG5juxQam8Lx0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFJjVYRqzqOG9aUXmRw7rEYmCj9GvWabzQZT_RJFHvfw&oe=6AFC7430"}, {"file_name": "05-technology.png", "id": "1126414410116858", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654867655_1126414413450191_5280060170186944587_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nabGGAE2tWgQ7kNvwHrOABq&_nc_oc=Ado6oA_O0-sgdyMh6sCxk1RZskrApSZnnpw2nMBBr2fzVoQ35SFXu1B1xYD8ChnwWlM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7OFMLzru02q1_vXP7qVmYv-eI2PU54GNIbCxqzhVWMQ&oe=6AFC68A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "2027519524486846", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/759751223_2027519527820179_8497211670320963894_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3Fw1wE8hsIQ7kNvwHy5h_s&_nc_oc=AdotaoeeHyletqWIyzUYyafe3q06ML31WEnIu1JOD7qQaBY1Vw6-bQNRavSy9J-erGs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqFy2pA875u017DKT4iIIwVhiACxfe9BYRcRItJp5i9w&oe=6AFC7A0E"}, "display_name": "Bit Universe", "keywords": ["citybuilder", "idle", "voxel", "tycoon", "incremental"], "long_description": "Grow a tiny town into an economy spanning the solar system. Arrange up to four miniature city views around you, build and upgrade voxel neighborhoods, research technology, unlock Governors and organize trade between worlds. Your cities keep earning while you play, and offline earnings help you return to a growing empire.\n\nMake the workspace your own. Move cities and windows into reach, resize each miniature city, pan its map and zoom into the buildings without changing the plot's physical size. Use Touch controllers or optional hand tracking: pinch to select and collect bonuses, or close your hand deliberately to move panels and pan terrain.\n\nPlay seated or standing in a virtual environment or optional passthrough. Controller users can move through the workspace with the left stick and snap-turn with the right. Adjust brightness, contrast and panel contrast, and bring the workspace back in front of you with Center.\n\nBit Universe is a single-player purchase with three local save slots and 41 achievements. There are no ads, in-app purchases, subscriptions or developer accounts. Standalone Quest saves are separate from PC and mobile saves. Internet is currently required for platform ownership checks. Meta Cloud Backup availability depends on your platform settings.", "short_description": "Build an idle city empire in a miniature workspace around you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bit-universe.net/privacy/bit-universe-quest/", "developer_terms_of_service_url": null, "publisher_name": "Kevin Savill", "support_website_url": "https://bit-universe.net/support/bit-universe-quest/", "website_url": "https://bit-universe.net/quest/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_T
nc_oc=AdrQKiVPb4reLy2g863i1IPdHbJAoziqmcBp1Kpd15c7qCJRplnXzHHVAVdEjAIdpLs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwO7jSb5XeTBvvH4WjMzWvHm4ts-rr4px5cTVZ05PGRA&oe=6A9C38C2"}, {"file_name": "jeitu5.png", "id": "2117745658612429", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031333_2117745661945762_4608989707911002895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLcSi4w_1DYQ7kNvwHYASx0&_nc_oc=Ado_qqOVORyDOsQM7kPfEyVauruKUml1xYSzfPzSlnFHiBkP4CwUbSqR1K-8SHjPtKM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInZcn6gnS0JNzVD02b8kV4Q4QES7EB1ZbCZh957yhNOg&oe=6A9C0B5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "383790830760276", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569444_383790834093609_1923696743628653872_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50zJdq6Ff9AQ7kNvwFZd0zo&_nc_oc=AdqOTsujiAIQtTYZ4GOorunhNfE0a34-Uyg1WKmTg840ud7qPsLgjSLjnmJjCCOGrv0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2mM9CiRRHZ8BtIvSJWmIf8Ds1t9QXqNlN-K0w2wYJhw&oe=6A9C3D28"}, "display_name": "Runfit Fantasy demo", "keywords": [], "long_description": "Welcome to the VR Runfit Fantasy demo!\nJoin our discord!: https://discord.gg/SFZbhxPT\n\nIn this immersive virtual reality experience, you can feel the thrill of an RPG adventure combined with a fun fitness workout. Simply swing your arms as you would while running in place, and you will move forward through the fantasy world.\n\nBut that's not all! You can also unleash melee and ranged attacks on the monsters that lurk in the environment. Defeat them to earn points and progress through the game.\n\nThe team behind Runfit Fantasy are big fans of hit sports and adventure games. We've taken inspiration from those beloved titles to create an RPG experience that gets your body moving. Our goal is to provide an engaging way for players to fight monsters and level up their character, all while getting in a workout.\n\nWhether you're a seasoned gamer or new to VR, Runfit Fantasy offers a unique blend of fantasy adventure and exercise. Step into the immersive world, battle fearsome foes, and get your heart pumping - all from the comfort of your own home. We can't wait for you to try it out!", "short_description": "Adventure and exercise in the fantasy world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wordpress.com/post/runfitfantasy.wordpress.com/7", "developer_terms_of_service_url": null, "publisher_name": "Wazhai", "support_website_url": null, "website_url": "https://runfitfantasy.wordpress.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8222513994434383"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1009645417350843"}]}, "baseline_offer": {"id": "1009645417350843"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1718393340, "status": "PUBLISHED", "id": "1009645417350843"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8268261123193003", "version": "0.4.0"}, "id": "886280359935244", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Applica
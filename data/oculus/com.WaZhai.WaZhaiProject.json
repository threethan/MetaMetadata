&_nc_sid=6e7a0a&_nc_ohc=EQZl_5kqqWkQ7kNvwHcRvnI&_nc_oc=AdpprPNsQlLhZI2rPclhi1M5G6iOy_cY1wJXGxAliLXbJ117Nak3b3CuphA2GXzhvE4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55FvFHJzjlDuIQ48wB_32rnYt83LxOaF_VuOy9vX5enA&oe=6A0C6C68"}, {"file_name": "jietu4.png", "id": "1525353478048811", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75572663_1525353481382144_6682804877096111658_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mx4av75Oo60Q7kNvwFbeApB&_nc_oc=AdpNqqLMDrt-Uj3jCopgP2JZF6bGEwPHYBf9nfqSozbTccwW5dRTw7899GhpiCaiieU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78EMkWOjPadM5N25sbjOdAlukeAKDj7HHr_6XrCB705w&oe=6A0C8542"}, {"file_name": "jeitu5.png", "id": "2117745658612429", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031333_2117745661945762_4608989707911002895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tVU2WipNgUQ7kNvwENtqI_&_nc_oc=Adp5vM-fj14SA3Prv2TrzhEkI1JvkRrPi4ZDHeob5ZjwefIiKFWX1BdhLxiwtHGYjHk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60TQ3LFbCILW0qxRcfBBUceDpQZ0nRmzzDKKqIAhkyDg&oe=6A0C57DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "383790830760276", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57569444_383790834093609_1923696743628653872_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2hSjWNu8lwQ7kNvwFJA3t2&_nc_oc=AdoU27LQHw73Z1p0YQlWVop4tvyHYkvAAN9w7xDIIl03HrJ4S2Yv1rHoiCQy4kDIk6I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZQprDCS4deCaogz4mktOYpdWoO0hLdjV8c73oXVRw-Q&oe=6A0C89A8"}, "display_name": "RunFitFantasy", "keywords": [], "long_description": "Welcome to the Run Fit Fantasy demo!\nJoin our discord!: https://discord.gg/k4byaJNZZP\n\nIn this immersive virtual reality experience, you can feel the thrill of an RPG adventure combined with a fun fitness workout. Simply swing your arms as you would while running in place, and you will move forward through the fantasy world.\n\nBut that's not all! You can also unleash melee and ranged attacks on the monsters that lurk in the environment. Defeat them to earn points and progress through the game.\n\nThe team behind Runfit Fantasy are big fans of hit sports and adventure games. We've taken inspiration from those beloved titles to create an RPG experience that gets your body moving. Our goal is to provide an engaging way for players to fight monsters and level up their character, all while getting in a workout.\n\nWhether you're a seasoned gamer or new to VR, Runfit Fantasy offers a unique blend of fantasy adventure and exercise. Step into the immersive world, battle fearsome foes, and get your heart pumping - all from the comfort of your own home. We can't wait for you to try it out!", "short_description": "Adventure and exercise in the fantasy world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wordpress.com/post/runfitfantasy.wordpress.com/7", "developer_terms_of_service_url": null, "publisher_name": "Wazhai", "support_website_url": null, "website_url": "https://runfitfantasy.wordpress.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8282329241786191"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86625126_994606478960160_6446434179682525185_n.png?stp=dst-png_s360x360&_nc_cat=10
qGvlITNBqjD3lfSvfXRZKrgbxzvwN4Xih6A&oe=6AFF1A54"}, {"file_name": "jietu3.png", "id": "991772675936100", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75322597_991772679269433_4127900603220577428_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXdjDu27bsYQ7kNvwF-CTbp&_nc_oc=AdqLSnN-pqwmMre6ZLMo7xfkeTTGLLAglpGmPkUH2109EbuTZcTwPSfMbMkbjCiDGM4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjv9s6b2TsRaOa6cmqc85SCWWa6Epit4zOnFepFo-A9Q&oe=6AFF0068"}, {"file_name": "jietu4.png", "id": "1525353478048811", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75572663_1525353481382144_6682804877096111658_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEaEDkXyh3cQ7kNvwHQsUV_&_nc_oc=Adrwo6hq_E_NzFhHczpQ5S4p3BOLDMbARoz2k4XdbWsSECDbE3SuBB6VRQcYUH4GszM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzQsMTyVXhONHrSSR6OIQb1O_z6flzofjOmd61uV-rTg&oe=6AFF1942"}, {"file_name": "jeitu5.png", "id": "2117745658612429", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031333_2117745661945762_4608989707911002895_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQ8p9Susy2sQ7kNvwEzfLfq&_nc_oc=Adpzui2CAiY51NmAMSLKLk5tOlrLz6R6jyHeA5Ay0yyKjzafxvbi3UK8qcte3wP3aTA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMgoAQ4ux3N1nRPlWSY-7mH23rnsN9LAuFhXROP_x-rA&oe=6AFF241E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "383790830760276", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569444_383790834093609_1923696743628653872_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IujvHyAC5AQ7kNvwGieZX5&_nc_oc=AdqGDV79BQN59jb-LICfaxXmJzYnrBztDzSXZs2DFLFHkriKw2IDGnqvtGowZqWucac&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-JkPB-SHzOJOQ62B9m80h9Y-zKy8lbvqKHQS5w0JdPQ&oe=6AFF1DA8"}, "display_name": "RunFitFantasy", "keywords": [], "long_description": "Welcome to the Run Fit Fantasy demo!\nJoin our discord!: https://discord.gg/k4byaJNZZP\n\nIn this immersive virtual reality experience, you can feel the thrill of an RPG adventure combined with a fun fitness workout. Simply swing your arms as you would while running in place, and you will move forward through the fantasy world.\n\nBut that's not all! You can also unleash melee and ranged attacks on the monsters that lurk in the environment. Defeat them to earn points and progress through the game.\n\nThe team behind Runfit Fantasy are big fans of hit sports and adventure games. We've taken inspiration from those beloved titles to create an RPG experience that gets your body moving. Our goal is to provide an engaging way for players to fight monsters and level up their character, all while getting in a workout.\n\nWhether you're a seasoned gamer or new to VR, Runfit Fantasy offers a unique blend of fantasy adventure and exercise. Step into the immersive world, battle fearsome foes, and get your heart pumping - all from the comfort of your own home. We can't wait for you to try it out!", "short_description": "Adventure and exercise in the fantasy world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wordpress.com/post/runfitfantasy.wordpress.com/7", "developer_terms_of_service_url": null, "publisher_name": "Wazhai", "support_website_url": null, "website_url": "https://runfitfantasy.wordpress.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supporte
-7U9otKUNLn9FWpgAo689LHdccChv6vJUNw&oe=6B0854D4"}, {"file_name": "jietu3.png", "id": "991772675936100", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75322597_991772679269433_4127900603220577428_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UztsGWBXVBcQ7kNvwGn1jkq&_nc_oc=Adp8ysTO0mwRTqr7XjjJqqh6MuUHCdu1G5BgcbQQvySGkgkjKMFQeQ-lG1wfOoPUVMQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFxPSwPcvUrZfZfudwhea8AQXF8MAvMvkSNnqsyvDWtw&oe=6B087328"}, {"file_name": "jietu4.png", "id": "1525353478048811", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75572663_1525353481382144_6682804877096111658_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZgEdzbAac4Q7kNvwHR53Xb&_nc_oc=Adqm1TtJyASjPuTcbqLetxJKrS47FSyJuYxaTrfMISNwt0M1ZmheYk0lFKuh_PBGXu8&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9mE-0T-F40fBNI1Ke5jYrncoA0jUDP9Mth4Z2lESClg&oe=6B0853C2"}, {"file_name": "jeitu5.png", "id": "2117745658612429", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031333_2117745661945762_4608989707911002895_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aeIBkSq6KE4Q7kNvwHVIcgO&_nc_oc=AdpV1y0qXX2kXekRY252CiZOHZJcTccs_8wWDQ2oM5fwZlnilXdYWpLxSHUXgDPcFk4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzG2IyNKqTBeCtzpC079ZnPdxoQ-NOBCVqPs6_rhWd5g&oe=6B085E9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "383790830760276", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57569444_383790834093609_1923696743628653872_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kq82qwI5sywQ7kNvwEZ7I7S&_nc_oc=AdpGI9hRvP_KSHcy32AFdpy8rklQzAaDq7-eWrxjoBRQly-FLt2KvDQlg0hUYzaHXuc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpQLXF44YJM0RdYGtJoRn9yzzZK5d4mkBlPxNnRp1RYA&oe=6B085828"}, "display_name": "RunFitFantasy", "keywords": [], "long_description": "Welcome to the Run Fit Fantasy demo!\nJoin our discord!: https://discord.gg/k4byaJNZZP\n\nIn this immersive virtual reality experience, you can feel the thrill of an RPG adventure combined with a fun fitness workout. Simply swing your arms as you would while running in place, and you will move forward through the fantasy world.\n\nBut that's not all! You can also unleash melee and ranged attacks on the monsters that lurk in the environment. Defeat them to earn points and progress through the game.\n\nThe team behind Runfit Fantasy are big fans of hit sports and adventure games. We've taken inspiration from those beloved titles to create an RPG experience that gets your body moving. Our goal is to provide an engaging way for players to fight monsters and level up their character, all while getting in a workout.\n\nWhether you're a seasoned gamer or new to VR, Runfit Fantasy offers a unique blend of fantasy adventure and exercise. Step into the immersive world, battle fearsome foes, and get your heart pumping - all from the comfort of your own home. We can't wait for you to try it out!", "short_description": "Adventure and exercise in the fantasy world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wordpress.com/post/runfitfantasy.wordpress.com/7", "developer_terms_of_service_url": null, "publisher_name": "Wazhai", "support_website_url": null, "website_url": "https://runfitfantasy.wordpress.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supporte
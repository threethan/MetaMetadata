&_nc_sid=6e7a0a&_nc_ohc=wc5zm0xy5ZgQ7kNvwHNPRRf&_nc_oc=AdrJQNfCnYV62ZxiA7Bpt83u94279eUjZ6wm8pXJ36tvt1n4FLPGGOCG6ZfgFunzLFw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDa6SOEPRs6lZvqoPc8U25-TzWcR54FMXAfeG6CG4R20w&oe=6A661268"}, {"file_name": "jietu4.png", "id": "1525353478048811", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75572663_1525353481382144_6682804877096111658_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urYf03P54FEQ7kNvwFriko1&_nc_oc=Adr8uKHoz0QSGEDQnS1RObRg-SQyOHGcbZ8WJF3OclJBkfR2ArPUNu1L9vN96J2qD3Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAesUXzZnyMv54mPNtX0VliuOcF0AaZwxJomMY0qYcrdA&oe=6A65F302"}, {"file_name": "jeitu5.png", "id": "2117745658612429", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031333_2117745661945762_4608989707911002895_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-75iG65pkYQ7kNvwGTylNv&_nc_oc=Adrl56LqtuA-v2OdccgPHg0DRtj6JZV6q6B9sDf-cziKGLvleRZJYe3tgJCEyLGgWaM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKXh3KaUiof6N0BaEXVflM5-UU26yuGjzl_PI0m2OqZQ&oe=6A65FDDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "383790830760276", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57569444_383790834093609_1923696743628653872_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AB7M8qVT7GYQ7kNvwH0Y_Hj&_nc_oc=Ado2UqMWoe6Bem41hOL-7ChaiXFkRzEQ4nIgJMIb9kv6F7SGWd9dMBRZ_EbE0BsmPik&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQwUqtGnNd-s_4_Qx5o7CV5HUjbbI4xTjIFQ0uIHyb1w&oe=6A65F768"}, "display_name": "RunFitFantasy", "keywords": [], "long_description": "Welcome to the Run Fit Fantasy demo!\nJoin our discord!: https://discord.gg/k4byaJNZZP\n\nIn this immersive virtual reality experience, you can feel the thrill of an RPG adventure combined with a fun fitness workout. Simply swing your arms as you would while running in place, and you will move forward through the fantasy world.\n\nBut that's not all! You can also unleash melee and ranged attacks on the monsters that lurk in the environment. Defeat them to earn points and progress through the game.\n\nThe team behind Runfit Fantasy are big fans of hit sports and adventure games. We've taken inspiration from those beloved titles to create an RPG experience that gets your body moving. Our goal is to provide an engaging way for players to fight monsters and level up their character, all while getting in a workout.\n\nWhether you're a seasoned gamer or new to VR, Runfit Fantasy offers a unique blend of fantasy adventure and exercise. Step into the immersive world, battle fearsome foes, and get your heart pumping - all from the comfort of your own home. We can't wait for you to try it out!", "short_description": "Adventure and exercise in the fantasy world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wordpress.com/post/runfitfantasy.wordpress.com/7", "developer_terms_of_service_url": null, "publisher_name": "Wazhai", "support_website_url": null, "website_url": "https://runfitfantasy.wordpress.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8282329241786191"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86625126_994606478960160_6446434179682525185_n.png?stp=dst-png_s360x360&_nc_cat=10
Hh8Ul-A7s8JOtG6X8rqOTbalAruCpwidAmA&oe=6B0D9AD4"}, {"file_name": "jietu3.png", "id": "991772675936100", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75322597_991772679269433_4127900603220577428_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhfFfeBFa_YQ7kNvwEoDHqI&_nc_oc=Ado7ip3cfb9CGc86nHLiJnVxDmYIXnTUktyJ2XFpARY8SqfcCel7mOkIiYY0LfkPI18&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTncQ8ffEIC-lNEnrTWeXSAukCVMFJW6KjKfy9JTmICew&oe=6B0DB928"}, {"file_name": "jietu4.png", "id": "1525353478048811", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572663_1525353481382144_6682804877096111658_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJfPhUIhOwgQ7kNvwH_f7tM&_nc_oc=Ado3MClc7IoL9kQJIh_-q9fx-6UEKTRy_DFhK6Xay02KrTWWeJ2Nemte7XnGV-bCs10&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSlSiFU09U7B7z1JaPdlw0uv0LgFV_LGoCtAQltpDGlgA&oe=6B0D99C2"}, {"file_name": "jeitu5.png", "id": "2117745658612429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031333_2117745661945762_4608989707911002895_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3i_UtQjbHAgQ7kNvwFE2OFY&_nc_oc=Adofg2fk_5CEAFo_sG43fDvwXkCfTlGgpo3Sp1YO7EnDhXlrkacsltzpcidZZDqp7Mg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRTHYyYH8_ZaQTnAXcT_VSoDuqOdxAWUgi65FwIMpy2SQ&oe=6B0DA49E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "383790830760276", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569444_383790834093609_1923696743628653872_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFyIJkdi43gQ7kNvwEfn_jU&_nc_oc=Adow9ioX5Hilw9NSevdvEJ6ViX7TbzBxee9oFhilD4Ezwcvq6uvh_fC5P5N65e0I1HU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRLrrqPlS--io4XH8K_luWUZ3DT0vfR2hbePoRN04ML9w&oe=6B0D9E28"}, "display_name": "RunFitFantasy", "keywords": [], "long_description": "Welcome to the Run Fit Fantasy demo!\nJoin our discord!: https://discord.gg/k4byaJNZZP\n\nIn this immersive virtual reality experience, you can feel the thrill of an RPG adventure combined with a fun fitness workout. Simply swing your arms as you would while running in place, and you will move forward through the fantasy world.\n\nBut that's not all! You can also unleash melee and ranged attacks on the monsters that lurk in the environment. Defeat them to earn points and progress through the game.\n\nThe team behind Runfit Fantasy are big fans of hit sports and adventure games. We've taken inspiration from those beloved titles to create an RPG experience that gets your body moving. Our goal is to provide an engaging way for players to fight monsters and level up their character, all while getting in a workout.\n\nWhether you're a seasoned gamer or new to VR, Runfit Fantasy offers a unique blend of fantasy adventure and exercise. Step into the immersive world, battle fearsome foes, and get your heart pumping - all from the comfort of your own home. We can't wait for you to try it out!", "short_description": "Adventure and exercise in the fantasy world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wordpress.com/post/runfitfantasy.wordpress.com/7", "developer_terms_of_service_url": null, "publisher_name": "Wazhai", "support_website_url": null, "website_url": "https://runfitfantasy.wordpress.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supporte
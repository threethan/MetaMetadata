gMIY7wqxUj5LcUr9gQ3VOarLrjbRUvJkEhw&oe=6B046054"}, {"file_name": "jietu3.png", "id": "991772675936100", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75322597_991772679269433_4127900603220577428_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OM8PD5gHLa0Q7kNvwGWMXKs&_nc_oc=Adpa1rSeKkFBZX5Ecf96g6ZNIdAGdKoXkxNdMdZR7vqHxme9HWCrjeCqK65iHERLs5Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfvZpKiBqvgkMrjxo1Y6pmtp-g7ao18WNtYCTywFoLyg&oe=6B047EA8"}, {"file_name": "jietu4.png", "id": "1525353478048811", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75572663_1525353481382144_6682804877096111658_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8clrtyKAzv0Q7kNvwH2L1FO&_nc_oc=AdpJHUVixNHqK_0Vt7ROF4meOdrdsQ4ffGYTsU3O0e_lTAzjCMN5cJAdqwFHklhixRY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYWKNa01DY7kpp2PVdPXPsWz_3B76NgL6T8NaPHQ9mig&oe=6B045F42"}, {"file_name": "jeitu5.png", "id": "2117745658612429", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031333_2117745661945762_4608989707911002895_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7HbWZIussnAQ7kNvwGNMwEb&_nc_oc=AdqVJqF18Hek_0DtkGG6mBbHVguGKgXiHw41oUoR9bgUCLZfcTsovBdLHO8QTGRg3Uk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHUniU2LFu9QBVMDy5Og3-IEQDDB3UvjzJSxwUNpLaWA&oe=6B046A1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "383790830760276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569444_383790834093609_1923696743628653872_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAECuwOskDwQ7kNvwE2SRcK&_nc_oc=AdoDNMot-sz86f0tCbh7ASzcPSREZB0Z3csp7LujpwsnW8k3csAeNuT7J5Vw5-kWess&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmzdInI8tlS0nJ1IkROIa7TOUA8E7u1Yi1IcR4Bn0YNg&oe=6B0463A8"}, "display_name": "RunFitFantasy", "keywords": [], "long_description": "Welcome to the Run Fit Fantasy demo!\nJoin our discord!: https://discord.gg/k4byaJNZZP\n\nIn this immersive virtual reality experience, you can feel the thrill of an RPG adventure combined with a fun fitness workout. Simply swing your arms as you would while running in place, and you will move forward through the fantasy world.\n\nBut that's not all! You can also unleash melee and ranged attacks on the monsters that lurk in the environment. Defeat them to earn points and progress through the game.\n\nThe team behind Runfit Fantasy are big fans of hit sports and adventure games. We've taken inspiration from those beloved titles to create an RPG experience that gets your body moving. Our goal is to provide an engaging way for players to fight monsters and level up their character, all while getting in a workout.\n\nWhether you're a seasoned gamer or new to VR, Runfit Fantasy offers a unique blend of fantasy adventure and exercise. Step into the immersive world, battle fearsome foes, and get your heart pumping - all from the comfort of your own home. We can't wait for you to try it out!", "short_description": "Adventure and exercise in the fantasy world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wordpress.com/post/runfitfantasy.wordpress.com/7", "developer_terms_of_service_url": null, "publisher_name": "Wazhai", "support_website_url": null, "website_url": "https://runfitfantasy.wordpress.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supporte
{"data": {"node": {"__typename": "Application", "id": "8790343097672718", "organization": {"id": "2617159622006195", "viewer_permissions": [], "application_groupings": {"nodes": []}}, "firstRevision": {"nodes": [{"application": {"id": "8790343097672718", "release_date": 1683878400, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 19}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "30150496191230766"}, "id": "6496143703743117"}]}}, "binary": null, "live_binary": null, "created_date": 1770791075, "id": "34083869654560047", "is_initial_release": false, "name_with_fallback": "v60", "pdp_metadata_with_fallback": {"version": 52, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "34083876594559353"}, "release_status": "RELEASED", "id": "8790343097672718"}, "id": "34083876594559353", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8790343097672718", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "843608591070332"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1212542254279088", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Room Escape", "keywords": [], "long_description": "\ud83d\udd0d**\u52a0\u5165Discord\u793e\u533a: discord.gg/vGYjuPcRMM**\n\nRoom Escape\u662f\u4e00\u6b3e\u9ad8\u54c1\u8d28\u5fae\u6050\u5bc6\u5ba4\u9003\u8131\u6e38\u620f\uff0c\u4f60\u5c06\u5316\u8eab\u4e3a\u4e00\u540d\u79c1\u5bb6\u4fa6\u63a2\uff0c\u524d\u5f801893\u5e74\u7684\u82f1\u56fd\u5c0f\u9547-\u72c4\u66f4\u65af\u9547\uff0c\u8c03\u67e5\u591a\u5e74\u60ac\u6848\u80cc\u540e\u7684\u771f\u76f8\u3002\u9762\u5bf9\u9519\u7efc\u590d\u6742\u7684\u7ebf\u7d22\u8c1c\u56e2\uff0c\u4e00\u4e2a\u4e2a\u8c1c\u9898\u5411\u4f60\u88ad\u6765\uff0c\u7ad9\u5728\u6b8b\u9177\u771f\u76f8\u7684\u5341\u5b57\u8def\u53e3\uff0c\u4f60\u4f1a\u505a\u51fa\u600e\u6837\u7684\u6289\u62e9\uff1f\n\n# \u6e38\u620f\u7279\u8272\n- **\u7b2c\u4e00\u4eba\u79f0\u53d9\u4e8b**\uff1a\u7f6e\u8eab\u4e8e\u5341\u4e5d\u4e16\u7eaa\u516b\u5341\u5e74\u4ee3\u7684\u82f1\u56fd\uff0c\u4ee5\u7b2c\u4e00\u4eba\u79f0\u89c6\u89d2\u611f\u53d7\u7eaf\u6b63\u7684\u82f1\u4f26\u98ce\u60c5\u3002\n\n- **\u5316\u8eab\u9876\u5c16\u4fa6\u63a2**\uff1a\u63a2\u7d22\u795e\u79d8\u53e4\u5b85\uff0c\u8fd0\u7528\u89c2\u5bdf\u548c\u63a8\u7406\u80fd\u529b\u6536\u96c6\u7ebf\u7d22\uff0c\u63ed\u5f00\u5c18\u5c01\u5df2\u4e45\u7684\u771f\u76f8\u3002\u6bcf\u4e00\u4e2a\u89d2\u843d\u90fd\u53ef\u80fd\u9690\u85cf\u7740\u5173\u952e\u8bc1\u636e\uff0c\u7b49\u5f85\u4f60\u7684\u53d1\u73b0\u3002 \n\n- **\u591a\u91cd\u89e3\u8c1c**\uff1a\u623f\u95f4\u5185\u8bbe\u6709\u591a\u91cd\u8c1c\u56e2\uff0c\u7ebf\u7d22\u4e4b\u95f4\u7d27\u5bc6\u76f8\u8fde\u3002\u5c06\u5206\u6563\u7684\u8bc1\u636e\u788e\u7247\u62fc\u51d1\u8d77\u6765\uff0c\u63ed\u5f00\u6700\u7ec8\u8c1c\u5e95\u3002\n\n- **\u6c89\u6d78\u5f0f\u4ea4\u4e92**\uff1a\u4e0e\u623f\u95f4\u4e2d\u7684\u7269\u54c1\u8fdb\u884c\u6df1\u5ea6\u4ea4\u4e92 - \u79fb\u52a8\u3001\u5f2f\u8170\u3001\u534a\u8e72\u3001\u6293\u63e1\uff0c\u5b9b\u5982\u5728\u771f\u5b9e\u5bc6\u5ba4\u4e2d\u63a2\u6848\u3002", "short_description": "\ud83d\udd0d\u52a0\u5165Discord\u793e\u533a: discord.gg/vGYjuPcRMM\n\nRoom Escape\u662f\u4e00\u6b3e\u9ad8\u54c1\u8d28\u5fae\u6050\u5bc6\u5ba4\u9003\u8131\u6e38\u620f\uff0c\u4f60\u5c06\u5316\u8eab\u4e3a\u4e00\u540d\u79c1\u5bb6\u4fa6\u63a2\uff0c\u524d\u5f801893\u5e74\u7684\u82f1\u56fd\u5c0f\u9547-\u72c4\u66f4\u65af\u9547\uff0c\u8c03\u67e5\u591a\u5e74\u60ac\u6848\u80cc\u540e\u7684\u771f\u76f8\u3002\u9762\u5bf9\u9519\u7efc\u590d\u6742\u7684\u7ebf\u7d22\u8c1c\u56e2\uff0c\u4e00\u4e2a\u4e2a\u8c1c\u989
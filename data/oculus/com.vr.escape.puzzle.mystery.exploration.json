ghReaNRZ009NYCtmnHg&oe=6A3000D7"}, {"file_name": "2(1).png", "id": "5845626132147754", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75458102_5845626138814420_691991383769524014_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADkVn-dEe0cQ7kNvwHn3v8J&_nc_oc=AdrhZayRNyeulAhOVA93IKhuhsTXiSQ2aHcRKxIRzsAuIG5mnuZuAweuRNCM_vcJxeo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iu3jzBM91PwaojOWrt0-06VcgXXiPzaAzEc6rK62ReA&oe=6A300E9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "879991751404202", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619145_879991754737535_4813747738992134307_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxBeSKWHRDoQ7kNvwGjTBEr&_nc_oc=AdoThpMd_Q9Gk5Wyk4H66-1PAIOv0vKGPnwi45EKDdary13t9gDCmnorXmrrX3Aug48&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RS2Y-aPJgyvtjAYYa9CAHmvZ-MS3y-NgH6FT_85Kgew&oe=6A302342"}, "display_name": "Room Escape", "keywords": ["escape", "room", "puzzle", "rpg", "horror"], "long_description": "\ud83d\udd0d**Join Our Discord: discord.gg/vGYjuPcRMM**\n\nStep into the mysterious world of Victorian England with our thrilling micro-escape game. As a private detective, you\u2019ll be transported back to the Dickensian town of 1893, where unrest and confusion reign supreme. Follow the trail of a ten-year-old unsolved case, and unravel the secrets of the ancient house.\n\n# Immersive Experience\n- **First-Person Narrative:** Travel back to the 1890s of Britain, feel the pure British atmosphere from a first person perspective.\n\n- **Become A Master Detective:** Explore the ancient house and use your powers of observation and deduction to collect clues and discover the truth.\n\n- **Puzzle-solving:** Each room contains multiple puzzles that challenge your intellect. Piece together fragments of evidence to progress deeper into the heart of the mystery.\n\n- **Immersive Experience:** Interact with various objects, as if in a real secret room.", "short_description": "Locked closets, rustling radios, this is your chance to become a true detective and solve the case. With multiple clues and puzzles scattered all over the room, your keen observation skills and decoding expertise will be put to the test. Can you find the missing pieces and unlock the truth?\n\nImmersive Experience\n- First-Person Narrative\n- Become A Master Detective\n-Puzzle-solving"}]}, "developer_name": "Mastery VR", "developer_privacy_policy_url": "https://masteryvrstudio.com/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Mastery VR", "support_website_url": null, "website_url": "https://masteryvrstudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "SIMULATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "es", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34083876594559353"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618274_1636303187658305_7479646700233155470_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDNhxDOzCEQQ7kNvwGC3PpU&_nc_oc=AdodCnqihwIlo-lIe10EBzZYby2VQeEBaEj3gSkQIWB3vurH4wVgvXjgVDIr_H22wh8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JWf2nJNJJzgetLFGSIKstYXe1dSiWsFH1pWMHiVF9NA&oe=6A300116"}, "is_concept": false, "is_test": fa
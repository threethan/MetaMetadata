.5771-25/75458102_5845626138814420_691991383769524014_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPTkw0wEOjoQ7kNvwEKE71i&_nc_oc=AdqrOBoj6vAvdqUsLN3IAicCq_NoUs0YG2RY88pAJ8LXfwGHVg-piiUFWTbFlsHBW3c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1wL6mwwXw2FwP8ziwMzzGyjHQyTVWUQLBp5ciZG8WDbA&oe=69F2181E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-en.png", "id": "1365121774029273", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003276_1365121777362606_4052632569962522041_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7SKIpeFR4gQ7kNvwHOQ6Wi&_nc_oc=AdoeQqSknlbDm7rPYS_Vd4WGBy0-aJALVSiSBH82dcT10KtN0GFGnFlEySIOjuQ904Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2M7vE4Lifch6DW29rbnblm5zH6OqNNUmG6MIlusreXIA&oe=69F20DFE"}, "display_name": "GoneMan", "keywords": [], "long_description": "-Gone Man-\nThe game transports you back to England in the 1890s, where confusion, unrest, and restlessness filled the entire 1893 Dickens town. You, as a private detective, head to the abandoned house to investigate an unsolved case from ten years ago after receiving a mysterious letter. Locked closets, mysterious symbols, rustling radios, to find the scattered pieces around and uncover the secrets hidden behind the disappearing portraits. What kind of truth is waiting for you?\n\n-Immersive Experience-\n\u2022 Real: First-person perspective, you will go back to the 1890s scenes of Britain, feel the pure British atmosphere\n\u2022 Detective: As a private detective, you will explore the abandoned house, collect clues and discover the truth\n\u2022 Decryption: The room is equipped with multiple clues and mysteries, and the final mystery is waiting for you to uncover\n\u2022 Immersion: Explore the room and interact with various objects, as if in a real secret room to explore the case", "short_description": "GONE MAN is a micro horror room escape game. You will be a detective, ravelling back to the 1893 British town, to investigate the truth behind the unsolved cases. Faced with the mass clues, what choice will you make?\n-Key Features-\n\u2022 Real: first-person perspective, feel the pure British atmosphere\n\u2022 Detective:  explore the house and discover the truth\n\u2022 Decryption: multiple clues and final mystery are waiting for you\n\u2022 Immersion: interact with various objects, as if in a real room to explore "}]}, "developer_name": "Suplife Games", "developer_privacy_policy_url": "http://gonemanvr.com/privacy-policy-official", "developer_terms_of_service_url": null, "publisher_name": "Suplife Games", "support_website_url": null, "website_url": "https://vrsuplife.com/home/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "es", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "700457784818553"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "962206256328147"}, {"status": "PUBLISHED", "id": "2120900508677799"}, {"status": "PUBLISHED", "id": "907067931863734"}, {"status": "PUBLISHED", "id": "1408388107631753"}, {"status": "PUBLISHED", "id": "856623353419009"}, {"status": "PUBLISHED", "id": "1253004496591605"}, {"status": "PUBLISHED", "id": "1271645100929343"}, {"status": "PUBLISHED", "id": "596369799798923"}, {"status": "PUBLISHED", "id": "506654892400966"}, {"status": "PUBLISHED", "id": "12691093243
8D9B57"}, {"file_name": "2(1).png", "id": "5845626132147754", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75458102_5845626138814420_691991383769524014_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQ0nNSs73SIQ7kNvwG6sDzr&_nc_oc=AdrGZ5T-r2w6zp-P7OXy9yvbT2nTHPN2oVv6Ey6dXb0O-CbiFxtIwlPH5JVUNDcDhs4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZJ_exZp4tlwa1zH0_WX3zryIj4mTKxwT_pLnwiGW_ZQ&oe=6A8D70DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-en.png", "id": "1365121774029273", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39003276_1365121777362606_4052632569962522041_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPs9A6DT6ogQ7kNvwEt8lGB&_nc_oc=Adp03wMFj-twSr0B2aHImZYknKzU4fa3GY395xUZQFR5IwKD8nB8JLDIgyxXuS4Rx2E&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhw5KYK0RYDbRXn-MEwxRA-EZ9kPAh3mSy3WLafeURhg&oe=6A8D66BE"}, "display_name": "GoneMan", "keywords": [], "long_description": "-Gone Man-\nThe game transports you back to England in the 1890s, where confusion, unrest, and restlessness filled the entire 1893 Dickens town. You, as a private detective, head to the abandoned house to investigate an unsolved case from ten years ago after receiving a mysterious letter. Locked closets, mysterious symbols, rustling radios, to find the scattered pieces around and uncover the secrets hidden behind the disappearing portraits. What kind of truth is waiting for you?\n\n-Immersive Experience-\n\u2022 Real: First-person perspective, you will go back to the 1890s scenes of Britain, feel the pure British atmosphere\n\u2022 Detective: As a private detective, you will explore the abandoned house, collect clues and discover the truth\n\u2022 Decryption: The room is equipped with multiple clues and mysteries, and the final mystery is waiting for you to uncover\n\u2022 Immersion: Explore the room and interact with various objects, as if in a real secret room to explore the case", "short_description": "GONE MAN is a micro horror room escape game. You will be a detective, ravelling back to the 1893 British town, to investigate the truth behind the unsolved cases. Faced with the mass clues, what choice will you make?\n-Key Features-\n\u2022 Real: first-person perspective, feel the pure British atmosphere\n\u2022 Detective:  explore the house and discover the truth\n\u2022 Decryption: multiple clues and final mystery are waiting for you\n\u2022 Immersion: interact with various objects, as if in a real room to explore "}]}, "developer_name": "Suplife Games", "developer_privacy_policy_url": "http://gonemanvr.com/privacy-policy-official", "developer_terms_of_service_url": null, "publisher_name": "Suplife Games", "support_website_url": null, "website_url": "https://vrsuplife.com/home/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "es", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "700457784818553"}}]}, "scheduled_offers": {"count": 17, "nodes": [{"status": "PUBLISHED", "id": "1015390584611971"}, {"status": "PUBLISHED", "id": "1497583408446655"}, {"status": "PUBLISHED", "id": "962206256328147"}, {"status": "PUBLISHED", "id": "2120900508677799"}, {"status": "PUBLISHED", "id": "907067931863734"}, {"status": "PUBLISHED", "id": "1408388107631753"}, {"status": "PUBLISHED", "id": "856623353419009"}, {"status": "PUBL
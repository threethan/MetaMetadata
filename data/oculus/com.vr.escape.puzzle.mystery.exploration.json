1).png", "id": "5845626132147754", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75458102_5845626138814420_691991383769524014_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPTkw0wEOjoQ7kNvwEKE71i&_nc_oc=AdqrOBoj6vAvdqUsLN3IAicCq_NoUs0YG2RY88pAJ8LXfwGHVg-piiUFWTbFlsHBW3c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1wL6mwwXw2FwP8ziwMzzGyjHQyTVWUQLBp5ciZG8WDbA&oe=69F2181E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "879991751404202", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619145_879991754737535_4813747738992134307_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sB1T8Vk3rFYQ7kNvwGzYJGc&_nc_oc=Ado7egzXYnxTz5n5CQ2uZZAnYNetiW4bo1wVdxJ2YR40SzClmNnbAvp2OF0PVEZz9Wg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0JPitS3A2KbVcfw9ZgxvRPJqjrhgI-BJAwgUdSCOv3UA&oe=69F1F482"}, "display_name": "Room Escape", "keywords": ["escape", "room", "puzzle", "rpg", "horror"], "long_description": "\ud83d\udd0d**Join Our Discord: discord.gg/vGYjuPcRMM**\n\nStep into the mysterious world of Victorian England with our thrilling micro-escape game. As a private detective, you\u2019ll be transported back to the Dickensian town of 1893, where unrest and confusion reign supreme. Follow the trail of a ten-year-old unsolved case, and unravel the secrets of the ancient house.\n\n# Immersive Experience\n- **First-Person Narrative:** Travel back to the 1890s of Britain, feel the pure British atmosphere from a first person perspective.\n\n- **Become A Master Detective:** Explore the ancient house and use your powers of observation and deduction to collect clues and discover the truth.\n\n- **Puzzle-solving:** Each room contains multiple puzzles that challenge your intellect. Piece together fragments of evidence to progress deeper into the heart of the mystery.\n\n- **Immersive Experience:** Interact with various objects, as if in a real secret room.", "short_description": "Locked closets, rustling radios, this is your chance to become a true detective and solve the case. With multiple clues and puzzles scattered all over the room, your keen observation skills and decoding expertise will be put to the test. Can you find the missing pieces and unlock the truth?\n\nImmersive Experience\n- First-Person Narrative\n- Become A Master Detective\n-Puzzle-solving"}]}, "developer_name": "Mastery VR", "developer_privacy_policy_url": "https://masteryvrstudio.com/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Mastery VR", "support_website_url": null, "website_url": "https://masteryvrstudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "SIMULATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "es", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34083876594559353"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618344_1634862924516538_8240808108251568097_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hP7VDMrtQsQ7kNvwH8T2Lm&_nc_oc=AdqUXWJ3TqoYn5YADumzNHWlFQCX-5US2UQuwLX1QIeZokrucksVlN3GwsviJDYiU1Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Fz5H-pk63HnX-1Sbwl2wGOnPFcvTmFSuWJ7ydxDf9uQ&oe=69F1E4D7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": 
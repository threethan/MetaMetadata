6e7&_nc_oc=AdrWjJCJ0wQzqWHzug8kRmCmSZsX5eYkpxxzTgyvfxvXGXd8Iq1FLGXNqr6squCSBME&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUDbuDa-35nZXtzRjPslVQSyM5wQnlRSRWrJRWlqXEXFg&oe=6B0EED76"}, {"file_name": "videoframe_1272445.png", "id": "1790361925354442", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908839717_1790361928687775_6053903252248172885_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2-gc7Bt2RkQ7kNvwH9df3w&_nc_oc=AdrjaTDU8alSNmEAUS8lkPAwMCW5e0Y4byahTFnduyXPdf68LYPBhnAcwMLnmy4Q0oE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXNg4VOIQuwLgvp5gzbFBkWk56rcQ5jvDLNARa1pZKllw&oe=6B0F210C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1707263097693002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908887005_1707263101026335_6778224177696791498_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNYC_9fCWgUQ7kNvwGuRcj1&_nc_oc=AdoBSj9NlYn7MqhL-04O_7B_HUN1HqQXHpZnUxN6jRfu5qTsYFelkOo3voksaTeBxvc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWU--EPpOfaAO65NRwfrSi_hQGMpHCeWc2MGYWWVdomZQ&oe=6B0EFAC8"}, "display_name": "Pickleball Beat XR: Rhythm Fitness", "keywords": ["Cardio", "Workout", "Sports", "Exercise", "Paddle"], "long_description": "# Can you keep the beat with a paddle in hand?                                                                                                                                                         \n{965778506366246}\nA robot sends balls your way in time with the music. Swing as the ball reaches the timing ring. When a golden ball comes your way, swing down to smash it. String together successful returns to build a combo and beat your best score.\n\n# \ud83c\udfb6Key Features:\n**\ud83c\udfa7 Find your rhythm.** Preview a song, then pick Easy, Normal, or Hard. At higher difficulties, balls arrive in quicker succession, and you'll need to reach farther to either side.\n\n**\ud83e\udd7d Play in VR or Mixed Reality.** With Mixed Reality on, you can see your own room on your side of the net.\n\n**\u270b Swing left- or right-handed.** Use a Touch controller as your paddle, or turn your palm into one with hand tracking.\n\n**\ud83c\udfc6 Track your progress.** Check your score, best combo, and estimated calories burned after a song. Review your completed sessions and set a weekly goal.\n\n", "short_description": "Swing to the beat in Pickleball Beat XR, a VR rhythm fitness game for Meta Quest. \ud83c\udfb5 Return balls in time with the music, smash golden balls, and keep your combo going. Pick a song and chase your personal best."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29821412454117358"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908839708_917528681355209_1370749636185806504_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THAP5K6BcT8Q7kNvwFYJu5T&_nc_oc=AdoLrmLNFW-7u4vzhskMw1gLe3e-EB0SxABff0hz9uCno5uxuL1aLsAleUetw
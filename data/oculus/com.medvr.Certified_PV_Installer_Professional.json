E1852"}, {"file_name": "com.oculus.vrshell-20250523-161426.png", "id": "9769646833134556", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499329560_9769646836467889_6669860891041665927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTQrBiNVhZ4Q7kNvwFAQGcA&_nc_oc=AdrBn9HWT8Rr2hsO_h7PfjGkL-c88GvW5aTbu_yJquKQASrfLD2PVQHFL-bRHBtGqUg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pSs5Pg9XpTcxwey7BxPzOkjxgVw_eLkw9RC-BQDNi6w&oe=69EDFFB0"}, {"file_name": "com.oculus.vrshell-20250523-161319.png", "id": "2025375454538677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499318017_2025375457872010_6954705406981900900_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04Sr41KFGOwQ7kNvwHkIkCf&_nc_oc=AdryF6tuN5HmWaz12ubf-030oqojg1esmcykdxa98V59UZW2H1NOI26HeguOrEt14lg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0D5PTa2tj4IXxhXsb7k_RLZVATVXIggAJMivuroo9rPA&oe=69EE0576"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified PV Installer Professional", "keywords": ["PV", "Immerselearn", "PVinstaller", "CertifiedPVInstaller"], "long_description": "Certified PV Installer Professional is an immersive VR training app designed for solar professionals and trainees. Gain hands-on experience in essential PV installation modules, including roof structural design, shading analysis tools, slope techniques, waterproofing and flashing methods, racking and equipment installation, MLPE systems, conductor types, and arc-fault protection. This virtual simulation provides a realistic and safe environment to build practical skills and boost industry readiness\u2014perfect for training centers, employers, or self-learners aiming for certification.", "short_description": "Master solar installation skills with Certified PV Installer Professional, a VR training app offering immersive, hands-on practice across core modules like roof design, shading analysis, waterproofing, racking methods, MLPE, and arc-fault protection. Build confidence and competence in a virtual, risk-free environment.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29499005196414785"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "668697729381192"}]}, "baseline_offer": {"id": "668697729381192"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1748703600, "status": "PUBLISHED", "id": "668697729381192"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "32144444785204133", "version": "41"}, "id": "1475421803835515", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29499005186414786", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "32144444785204133"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1475421803835515"}]}, "change_log": null, "created_d
F0uzYc1SNq3Zr-xEA-V12636a65vVBYA&oe=69AC14B0"}, {"file_name": "com.oculus.vrshell-20250523-161319.png", "id": "2025375454538677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499318017_2025375457872010_6954705406981900900_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGtZzQU0glwQ7kNvwHS6Gf1&_nc_oc=AdnPChexeP08TYCeWRftAjMKmY97c_ZRoE3WlCh_MsYkUpsHUb05l5qnQ__7rWshZoU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxoeS_QU8aFHG5SuCY9T1JF9iYgUE6EXimPdX2otYGgPQ&oe=69AC1A76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified PV Installer Professional", "keywords": ["PV", "Immerselearn", "PVinstaller", "CertifiedPVInstaller"], "long_description": "Certified PV Installer Professional is an immersive VR training app designed for solar professionals and trainees. Gain hands-on experience in essential PV installation modules, including roof structural design, shading analysis tools, slope techniques, waterproofing and flashing methods, racking and equipment installation, MLPE systems, conductor types, and arc-fault protection. This virtual simulation provides a realistic and safe environment to build practical skills and boost industry readiness\u2014perfect for training centers, employers, or self-learners aiming for certification.", "short_description": "Master solar installation skills with Certified PV Installer Professional, a VR training app offering immersive, hands-on practice across core modules like roof design, shading analysis, waterproofing, racking methods, MLPE, and arc-fault protection. Build confidence and competence in a virtual, risk-free environment.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_cate
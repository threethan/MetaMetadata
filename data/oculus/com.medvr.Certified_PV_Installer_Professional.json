: "2025375454538677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499318017_2025375457872010_6954705406981900900_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtZgTnfcAV0Q7kNvwHIppUW&_nc_oc=AdkrNzu3849BCvJKHdpE27nhBetJeQraEXdUqwb0OGWST-uVEpLlvu7vR_MKx6_0-tc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvdc9OwxBK5cw-xWoxb1TcipWwCQ4KUf_sDG1E8_2hq-A&oe=69A2DFF6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified PV Installer Professional", "keywords": ["PV", "Immerselearn", "PVinstaller", "CertifiedPVInstaller"], "long_description": "Certified PV Installer Professional is an immersive VR training app designed for solar professionals and trainees. Gain hands-on experience in essential PV installation modules, including roof structural design, shading analysis tools, slope techniques, waterproofing and flashing methods, racking and equipment installation, MLPE systems, conductor types, and arc-fault protection. This virtual simulation provides a realistic and safe environment to build practical skills and boost industry readiness\u2014perfect for training centers, employers, or self-learners aiming for certification.", "short_description": "Master solar installation skills with Certified PV Installer Professional, a VR training app offering immersive, hands-on practice across core modules like roof design, shading analysis, waterproofing, racking methods, MLPE, and arc-fault protection. Build confidence and competence in a virtual, risk-free environment.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1
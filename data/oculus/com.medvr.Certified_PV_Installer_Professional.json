: "2025375454538677", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499318017_2025375457872010_6954705406981900900_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7NhxaVeIRwQ7kNvwHCLSlu&_nc_oc=AdmjexV6wGniLNos6vxfLzmP_lMFN8CgFEJTYoHttf02GjP0L9zmvRUqTDxkJE5Lwo8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afv1PEl49Wh-EwSTbTh9w2PEAs1AmYQi5Ljw4JdYfS-RMg&oe=69A582F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified PV Installer Professional", "keywords": ["PV", "Immerselearn", "PVinstaller", "CertifiedPVInstaller"], "long_description": "Certified PV Installer Professional is an immersive VR training app designed for solar professionals and trainees. Gain hands-on experience in essential PV installation modules, including roof structural design, shading analysis tools, slope techniques, waterproofing and flashing methods, racking and equipment installation, MLPE systems, conductor types, and arc-fault protection. This virtual simulation provides a realistic and safe environment to build practical skills and boost industry readiness\u2014perfect for training centers, employers, or self-learners aiming for certification.", "short_description": "Master solar installation skills with Certified PV Installer Professional, a VR training app offering immersive, hands-on practice across core modules like roof design, shading analysis, waterproofing, racking methods, MLPE, and arc-fault protection. Build confidence and competence in a virtual, risk-free environment.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1
ller"], "long_description": "Certified PV Installer Professional is an immersive VR training app designed for solar professionals and trainees. Gain hands-on experience in essential PV installation modules, including roof structural design, shading analysis tools, slope techniques, waterproofing and flashing methods, racking and equipment installation, MLPE systems, conductor types, and arc-fault protection. This virtual simulation provides a realistic and safe environment to build practical skills and boost industry readiness\u2014perfect for training centers, employers, or self-learners aiming for certification.", "short_description": "Master solar installation skills with Certified PV Installer Professional, a VR training app offering immersive, hands-on practice across core modules like roof design, shading analysis, waterproofing, racking methods, MLPE, and arc-fault protection. Build confidence and competence in a virtual, risk-free environment.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29499005196414785"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id":
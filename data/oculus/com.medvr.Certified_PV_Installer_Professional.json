iad6-1.oculuscdn.com/v/t64.5771-25/499329560_9769646836467889_6669860891041665927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QuQ_4X4TyOYQ7kNvwGx1QJu&_nc_oc=Adqpm28HXh9aetUOg67gQh_LboO9IbJlzZNJ8KJ0U0gMQaQlf4PhPAeYsypyO3Pq0kw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8w1-DWsmhfy0LRuPrPHz1Y5fdCU_kftNywlH35KuY_iQ&oe=6A2D7FF0"}, {"file_name": "com.oculus.vrshell-20250523-161319.png", "id": "2025375454538677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499318017_2025375457872010_6954705406981900900_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQDxJSQtRhsQ7kNvwF0YWmD&_nc_oc=AdrEcCRhNnAxmLUvyB5zCEhfDPWJMULrOS_sODl7wKICiNVf-14rtfopr96SS_EUis8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gL3ikzcQvR8IReZ8tTCKwTwobgxrTiUI0ZLP3JtwFsA&oe=6A2D4D76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified PV Installer Professional", "keywords": ["PV", "Immerselearn", "PVinstaller", "CertifiedPVInstaller"], "long_description": "Certified PV Installer Professional is an immersive VR training app designed for solar professionals and trainees. Gain hands-on experience in essential PV installation modules, including roof structural design, shading analysis tools, slope techniques, waterproofing and flashing methods, racking and equipment installation, MLPE systems, conductor types, and arc-fault protection. This virtual simulation provides a realistic and safe environment to build practical skills and boost industry readiness\u2014perfect for training centers, employers, or self-learners aiming for certification.", "short_description": "Master solar installation skills with Certified PV Installer Professional, a VR training app offering immersive, hands-on practice across core modules like roof design, shading analysis, waterproofing, racking methods, MLPE, and arc-fault protection. Build confidence and competence in a virtual, risk-free environment.\n"}]}, "developer_name": null, "de
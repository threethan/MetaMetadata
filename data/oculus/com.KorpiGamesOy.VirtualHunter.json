uscdn.com&_nc_ss=7f20f&oh=00_Af-TFzpJHcxqJkwciDYc6PQX23CfHYN_ZtF-rBx9AUi6Pw&oe=6A26DF56"}, {"file_name": "VH_Quest_Screenshot5.png", "id": "1491031505991943", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619594_1491031509325276_96326882111576599_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-up-KFCDUFIQ7kNvwGJSnkp&_nc_oc=AdpRgCV1JSg-gs8Gw3S78RhdlfF2wi_rMoxq6J7vOgMXlnaTBoAK7vtk_gFEOKu9E9A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bo9isfT5_0uMXnEdqK0JxRJu1JnOepS-ASxzvRlAmvQ&oe=6A26D8A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VirtualHunter_CoverLandscape.png", "id": "1331252985776585", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298451_1331252992443251_7623400193771431464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3d4Z6UiS7YQ7kNvwHCxwhn&_nc_oc=Adq8VbfyoRAp6g1JFvxIKUqPhOXsKQqHx5Z7IfGE6D6L6JmA-GwsGfmm3cPXMgfWkao&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9m4yMqBLFO85kftT1jvRZuSlJsSJlX1I9xUeiXesAvcQ&oe=6A26E7BF"}, "display_name": "Virtual Hunter", "keywords": ["hunting", "openworld", "multiplayer", "realistic", "nature"], "long_description": "Select your weapons, pack your other equipment and step out into the wilderness. Track animals, use hunting towers or follow your intuition and see what you find. How you decide to hunt is totally up to you! Each hunt is always a new adventure and seeing as you get a fresh spawn of animals each time, a new challenge!\n\nWith our weapon stabilization system, you can make very accurate shots, even at longer distances. Taking a clean shot is important, the animal will go down faster and save you a long tracking job!\n\nEach animal has their own unique behavior, making them challenging and interesting to hunt. With their senses they can see, smell and hear you so approach with caution. Big trophy animals have keener senses, making them much harder but also more rewarding to hunt. Using the right weapon or ammo will give you better rewards.\n\nVirtual Hunter includes a one of a kind trophy mount system, where players can freely place their taxidermied trophies around the lodge! Choose different wall mounts, full body mounts and table mounts for small game. Each animal has several different poses to choose from. Do you want to place your highest scoring red deer over the fireplace or by the door? The choice is yours!\n\nExperience the thrill of a hunt together with up to 6 players. Hike, hunt and strategize together to bag the biggest trophy.  Gather at the lodge to share stories behind each trophy.\n\nYou can unlock different trophy statues by taking down big animals with the correct weapon", "short_description": "Prepare for a hunting experience of a lifetime. Virtual Hunter brings realistic hunting to virtual reality. The game offers a large, open hunting ground where you will find animals such as the majestic red deer, the elusive European hare, wild boar and fallow deer roaming freely in the wilderness. So pack your gear, master the realistic weapon handling and ballistics at the range and then head out into the open wilderness!"}]}, "developer_name": "Korpi Games", "developer_privacy_policy_url": "https://vrkiwi.org/what-vr/eula-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "VrKiwi", "support_website_url": null, "website_url": "https://www.vrkiwi.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULU
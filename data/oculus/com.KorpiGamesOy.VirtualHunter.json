r_Icon.png", "id": "850815467856925", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827585_850815474523591_92781082181011350_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wg8JXQVecoQ7kNvwGy3_Oz&_nc_oc=Ado8W3p4yedSKzpu2gXmgvfNq1Ual8HiUY7CCSNVcL6cAPUQf3jw_Zna40PuWElA6l4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDQMIt2TrTvQjoDDN6urv-i6bKEgSNE4q9hAi4bAGbjw&oe=6A4E4C30"}]}, "id": "1083975200283465", "locale": "en_US", "screenshots": [{"file_name": "VirtualHunter_TrophyLodge.png", "id": "877052164705552", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820387_877052168038885_7140569890049044150_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPupWuijqBcQ7kNvwH075ps&_nc_oc=AdqCly5yVhHGskcgtoU0lR6_ieaXsd7J-Wz9Cor-L3ermg6EjMfFbyFSX0Jz4gqFTYE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDisNPz-H40U-nFnZPvSkIP_ms6J4e4tfO7pA9nOhU2NA&oe=6A4E62DB"}, {"file_name": "VirtualHunter_Pheasants.png", "id": "1397722055227966", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825546_1397722058561299_5715177431533765416_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQ_5d79PSBkQ7kNvwHB8wMR&_nc_oc=AdrIoLQ8Z4in3tRR37210d-M0NGCU1qFH1n6HLyGUa2BfraPbfGSXMDGYGwWaJ4LBQA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXXCU6RysfwCSVHeVOlc4M3VUYcOfFsPkhfUl66riJiw&oe=6A4E3D5E"}, {"file_name": "VirtualHunter_RoeBowHunt.png", "id": "1333933035087858", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303198_1333933038421191_8929030899300895331_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ml65ONAb5gQ7kNvwEnHhij&_nc_oc=Adr50iA3nZ0HwGboFWXbkjjhlN3yZ3L_jnJPEwkob169TUdl3YDTFRrxEi9rDlrzYGs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJhMopWUsY1cL2vMPvBVfNZ_trgD20CYYCVNaOkDwvag&oe=6A4E3847"}, {"file_name": "VirtualHunter_RedDeerScope.png", "id": "4183763298508629", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303140_4183763301841962_2876177868316805297_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASLGGY3JK8UQ7kNvwHoedmT&_nc_oc=AdrOa-Q81-7i1EpbTk5tyrY1Smb0WRd7LSuD1u1n4XZ2hD3AwPVfJGTwemlx4UbEzTQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsr9go9RPurXwUEwW4wtr_2w01e9ysClFOR1iDUBzGsQ&oe=6A4E5EA1"}, {"file_name": "VirtualHunter_FallowBuck.png", "id": "869388082480846", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819281_869388085814179_6505556581967045527_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHDWp4vbs5MQ7kNvwGwZHKO&_nc_oc=AdqqyXgbB2yI0bxqeD0y5S7AN7wk3iZapNnpL3F1Mx3mupUxsNY0CyOCz5LCVPyyUTY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBCA_4d4X72S0zbRICIFvpV7CcL2uP2aaUcyqf008qfQ&oe=6A4E5F8B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Hunter", "keywords": [], "long_description": "Select your weapons, pack your other equipment and step out into the wilderness. Track animals, use hunting towers or follow your intuition and see what you find. How you decide to hunt is totally up to you! Each hunt is always a new adventure and seeing as you get a fresh spawn of animals each time, a new challenge!\n\nWith our weapon stabilization system, you can make very accurate shots, even at longer distances. Taking a clean shot is important, the animal will go down faster and save you a long tracking job!\n\nEach animal has their own unique behavior, making them challenging and interesting to hunt. With their senses they can see, smell and hear you so approach with caution. Big trophy animals have keener senses, making them much harder but also more rewarding to hunt. Using the right weapon or ammo will give you better rewards.\n\nVirtual Hunter includes a one of a kind trophy mount system, where players can freely place their taxidermied trophies around the lodge! Choose different wall mounts, full body mounts and table mounts for small game. Each animal has several different poses to choose from. Do you want to place your highest scoring red deer over the fireplace or by the door? The choice is yours!\n\nExperience the thrill of a hunt together with up to 6 players. Hike, hunt and strategize together to bag the biggest trophy.  Gather at the lodge to share stories behind each trophy.\n\nYou can unlock different trophy statues by taking down big animals with the correct weapon", "short_description": "Prepare for a hunting experience of a lifetime. Virtual Hunter brings realistic hunting to virtual reality. The game offers a large, open hunting ground where you will find animals such as the majestic red deer, the elusive European hare, wild boar and fallow deer roaming freely in the wilderness. So pack your gear, master the realistic weapon handling and ballistics at the range and then head out into the open wilderness!"}]}, "developer_name": "Korpi Games", "developer_privacy_policy_url": "https://vrkiwi.org/what-vr/eula-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "VrKiwi", "support_website_url": null, "website_url": "https://www.vrkiwi.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP"], "id": "10039970539449121"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1389589619599784"}, {"status": "PENDING", "id": "1087781146585645"}]}, "baseli
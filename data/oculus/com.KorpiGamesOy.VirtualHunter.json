scdn.com&_nc_ss=7f20f&oh=00_AQCcCUuGVfVyZy9OIgDaN7iQjSPusFRB8o0sCGfnJ3fQKg&oe=6A4E6C56"}, {"file_name": "VH_Quest_Screenshot5.png", "id": "1491031505991943", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619594_1491031509325276_96326882111576599_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGYkeGstv7UQ7kNvwHc01nX&_nc_oc=AdqFWrWF_awA4ML6GGYslDRp2suI_uPBrBOEr5INn-5hCnmieup-qf8vtJszMJ46SrI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgqZWk8WriGSeYEEskyvs39ZufPAkPURlFJoBqKKnlaQ&oe=6A4E65A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VirtualHunter_CoverLandscape.png", "id": "1331252985776585", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499298451_1331252992443251_7623400193771431464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQv07ai42T8Q7kNvwF28cWn&_nc_oc=AdrZGXgDCbQK1I9gZMRkWHc_2tIay-7PXaY4tdNR8ldnApT2swTfLckMgJIc33TD7So&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTIvd7UFocn4RwHYjUHWkZeBz_NmrQaaNV0yaMAHxT5w&oe=6A4E3C7F"}, "display_name": "Virtual Hunter", "keywords": ["hunting", "openworld", "multiplayer", "realistic", "nature"], "long_description": "# Step Into a Realistic Hunting Simulation\n\nExplore a massive open world and track wildlife with realistic senses and behavior. Choose your own approach with rifles, bows, shotguns, hunting towers, or careful stalking. Every hunt is a new adventure.\n\n**Explore the Wilderness**\n{1350175590406522}\n\nDiscover a massive open world filled with forests, mountains, rivers, and valleys. Dynamic weather, changing conditions, and fresh animal spawns make every trip into the wilderness unique.\n\n**Hunt Wildlife with Realistic Behavior**\n{2086504545602231}\n\nAnimals can see, smell, and hear you. Watch the wind, move carefully, and choose your shots wisely. Larger trophy animals have sharper senses and offer greater rewards.\n\nMaster realistic weapon handling and shot placement with rifles, bows, and shotguns. A clean shot means shorter tracking and a more rewarding hunt.\n\n**Build Your Dream Trophy Lodge**\n{27260124086989982}\n\nDisplay your greatest achievements with our one-of-a-kind free placement trophy system. Choose poses, mounts, and place your trophies anywhere in your lodge to create your own hunting stories.\n\n**Hunt Together**\n\nTeam up with up to 5 friends in online co-op. Explore, strategize, and share your trophies back at the lodge after the hunt.\n\n**Join the Community**\n\nShare your trophies, screenshots, and hunting stories with fellow hunters in our Discord community.\n\nDiscord: https://discord.gg/u5ZM8FNwBV", "short_description": "Prepare for a hunting experience of a lifetime. Virtual Hunter brings realistic hunting to virtual reality. The game offers a large, open hunting ground where you will find animals such as the majestic red deer, the elusive European hare, wild boar and fallow deer roaming freely in the wilderness. So pack your gear, master the realistic weapon handling and ballistics at the range and then head out into the open wilderness!"}]}, "developer_name": "Korpi Games", "developer_privacy_policy_url": "https://vrkiwi.org/what-vr/eula-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "VrKiwi", "support_website_url": null, "website_url": "https://www.vrkiwi.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDI
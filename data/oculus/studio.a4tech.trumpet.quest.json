ScEsIB5CwA&oe=6AE76503"}, {"file_name": "01-lesson-on-stage.png", "id": "2184743165438834", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/814574569_2184743168772167_5992858626349336770_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3bYUNTLeSAQ7kNvwEnI-_6&_nc_oc=AdqaD7KINqjp6vl3CFwmTHbbi7UKnzNvYgsLfHvXtZsjKtzmrFWzyBXmB5HgE8uQA18&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfKNbqqX81qznSQaryqPpbsfGlEXNdOj5mhCaScdxyYA&oe=6AE764CD"}, {"file_name": "02-cut-on-the-beat.png", "id": "1093011173331183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/791586454_1093011176664516_2520923079129981419_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4wk643pQTcQ7kNvwEy-YQ1&_nc_oc=AdoTQg1RU1FRUUTeE12C_wUnksyj5TMuP4WL_bkDP6_beLVjX1_nIaZW3Ajf1Tbi0GQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9vXUqw-faQXkhJMtF0gKqNdHY0eadUry2moNr5he09A&oe=6AE74527"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trumpet Studio: Learn & Play", "keywords": [], "long_description": "Sit in a cozy music studio and bring a golden trumpet to your face. Real trumpet recordings answer every note.\n\nWhen a lesson starts, the curtain dissolves into light and a neon stage opens up. Notes fly out of a brass bell as glowing cubes: play the right note on the beat and your blade cuts them. A live staff shows the note to play and the note you played.\n\n\u2022 75 lessons in five paths: fundamentals, songs, technique, scales and improvisation\n\u2022 Listen to a demo first, slow it down, earn points, stars and streaks\n\u2022 Note study: all 31 fingerings with a reference sound and practice rounds\n\u2022 Free play with an adjustable metronome\n\u2022 Touch controllers or hand tracking, right or left handed: one hand presses the three valves, the other hand's distance from your face picks the register\n\u2022 Written pitch for B flat trumpet, note names as C D E or Do Re Mi\n\u2022 English, Portuguese, Spanish, French, German, Japanese and Chinese\n\nWorks offline. No account, no ads. Your progress stays on your headset.", "short_description": "Play a golden trumpet in VR and learn with 75 lessons on a neon stage that opens in your studio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://a4tech.ai/trumpet/quest/privacy/", "developer_terms_of_service_url": null, "publisher_name": "A4 Tech Ltda", "support_website_url": "https://a4tech.ai/trumpet/quest/support/", "website_url": "https://a4tech.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1391251480734534"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/585799753_29123740943896836_7942614070061734829_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBBsg0fPeDcQ7kNvwG5QgD5&_nc_oc=Adr6vrKNB68pnS1Bjp7JHb90HcovGytWVg1zU4dYk4Ln7Z71ul_X-jy3fV492ozSI5c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvvHQMfzaBnIDpywQT0He38mIZxpgbn3WKHv5yeIGfvQ&oe=6AE76B34"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Trumpet Studio: Learn & Play", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}, {"topic_name": "Hands-On Train
=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBxfiT2fyvYynbqKHXmgbrxS0EdnE3NCHZ9McTmzP8rw&oe=6B0074D6"}, {"file_name": "jj-screenshots_0005_jj-screenshots_0005_Layer-5.jpg.png", "id": "3099794770230761", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499626172_3099794773564094_8430499586268792863_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37ZeWbr9gKMQ7kNvwEihH4c&_nc_oc=AdptHYJJZeMexLdHy0T8hw_xOWhMw9q8j13WnfnMq_QaSRE9bGFuKGZZCpIEVCGW6Rc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSh2yitnwkBcZALDZKf9tBNZWvr1dXV9wqem-adtqMFwQ&oe=6B005657"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JJ_keyart_landscape_01.png", "id": "895140982980720", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619098_895140986314053_4158398188561500219_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RtFtOcTwXY0Q7kNvwHLLO7q&_nc_oc=AdqmuWB_feccP4cc_XXeXWAAfH8YwtJ_WkkdetEsEUBT5YIVyGRp_gZgBox0uInixf4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGVB0Ggqc2necoKDHhGFe79DNw9VZtCLat_btPzgbkWA&oe=6B007C52"}, "display_name": "Jank Jumpers", "keywords": ["climb", "obby", "mountain", "obstacle", "peak"], "long_description": "**Can you reach the top?**\n\nWelcome to **Jank Jumpers, a co-op VR obby** that'll have you making death defying leaps to summit massive floating crags. Team up with friends and work together to discover the path up!\n{732125892790746}\n\n\n# Explore Hidden Routes\nEach level brings new challenges: risky shortcuts, moving hazards, and momentum-based puzzles that reward creativity as much as precision. Discover hangout spots and more secrets along the way.\n{899609659683336}\n\n\n# The Jank Jump\nMaster the Jank Jump and soar to improbable heights and across impossible distances. It will take some practice...\n{697403156562917}\n\n# Reach the top\nMake the climb and the golden idol will be waiting for you at the summit. Earn stars for each crag you complete.\n{4168845696665567}\n\nJump. Jank. Fall. Laugh \u2014 then do it all over again.\n\nSee you at the top.", "short_description": "Jank your way up massive crags"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://jankjumpers.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25544381845214584"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618252_1188031890094780_4307866765820612034_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgkPXyVMT6wQ7kNvwGUQ98K&_nc_oc=AdperaG2OP5Xa72OsM_OYSlTEtVNeD9WTZGgU62ik_NGMfLKVhK2sU7yECSk3Ba03pc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjCd6eucgRDuGSJi8EC1PMkj_0mv4l6Xuixc0D5ExMYw&oe=6B00545A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Jank Jumpers", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"
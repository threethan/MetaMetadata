erIQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QKIvAfChar7Ib_J6l2mSz5VXQdJVvPUbUBIsu9RBrlw&oe=6A427E57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JJ_keyart_landscape_01.png", "id": "895140982980720", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619098_895140986314053_4158398188561500219_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uj_1IiTZvggQ7kNvwGF5nZM&_nc_oc=AdqSsK-BWaUezVZzeAmgy2_F042lvxNioA4rXyKHGICMAiRagNPDi3pe06Ec_YwE-R8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uh9Y4uozegP6cPLBSvNGpOmcFecb7Z9pdybxP1FlikQ&oe=6A426C12"}, "display_name": "Jank Jumpers", "keywords": ["climb", "obby", "mountain", "obstacle", "peak"], "long_description": "Welcome to Jank Jumpers \u2014 a cooperative VR obby where movement is big, the climbs are intense, and every moment feels epic.\n\nTeam up with friends as you explore giant floating crags and master the Jank Jump, a dramatic full-body launch that sends you soaring toward improbable heights and across impossible distances.\n\nWork together to discover the path upward. Each level brings new challenges: risky shortcuts, moving hazards, and momentum-based puzzles that reward creativity as much as precision. Make the climb and the golden idol will be waiting for you at the summit.\n\nJump. Jank. Fly. Fall. Laugh \u2014 then do it all over again.\n\nSee you at the top.", "short_description": "Jank your way up massive crags"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://jankjumpers.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subs
_ICON", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499626010_582324694396459_6357133735676598417_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_dE6gpf-YQQ7kNvwHXYRFQ&_nc_oc=Adohuk6uyeYZCgitps5lTqBWsGmeBpCGJfZLeCm0IX_1QWuzj90JVLCVQrZhREeayUs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eVc_wSJpR1CpkE_yT8N_5rXb_tgR9hSbYWL5qxsAGbA&oe=6A105554"}]}, "id": "668075326027583", "locale": "en_US", "screenshots": [{"file_name": "Neutrophil_2560x1440.png", "id": "819294603846147", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499622315_819294607179480_6692104929756901283_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-boSlCM5_TUQ7kNvwEwU2e0&_nc_oc=AdqT_Z3Sn6WfqO9Rkxu9cpB16pdLmGgd0ZF3ZJGYjUbWPlMhNEYYybBg6LQYT3eTWAE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4x2Fzj26IZHJmzdvTwlWmpHPeXUF9DEQXRPRcQYMYLIQ&oe=6A104F30"}, {"file_name": "PMN_stimuliert_2560x1440.png", "id": "1633042391067869", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619677_1633042394401202_7209868863111439645_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GArcwQOS7TIQ7kNvwFhgXyf&_nc_oc=Adr_S0udE7Z2RSPFK765v1zjpv7F-3df49A9FHZwujbolCrR0ynIUwBs-I2g2G-XIW8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eek1hZquc6D5AnR13SjaJxDOp-EFfTH4qnH7NEl_siA&oe=6A1070C6"}, {"file_name": "Teeth_2560x1440.png", "id": "917057617855874", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499620497_917057624522540_3322054066031636962_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_CKMvUfkIm0Q7kNvwGhhKKm&_nc_oc=Adpw31s6kTVzmixcsf_tjoD_rIW_wecjphE9wU2IVlpT8FBa_HYM7THua98A7576WI4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6otnjhsoK_ZlBI_zrk12oqa7uL27Hdqx_tJ9ov67eRbw&oe=6A1066A2"}, {"file_name": "Ostertagia.png", "id": "974074545049377", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499618882_974074551716043_3982132693816971777_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_fvONR_qc8Q7kNvwE9tWyc&_nc_oc=AdrxYCdkQW_St4ygkNzSiqXWiGozna1hvaN8HaC_BDP97AsGhwWeKhLuypY6mFZJXVs&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_U5lTmU6BoroHcjaLOMuqH7izpOtI4qKRK3ri96sX1g&oe=6A10603A"}, {"file_name": "kidney_glomeruli_2560x1440.png", "id": "1529509712024716", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499618885_1529509715358049_3070632166327873331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7uVI1mMBgwQ7kNvwGw6mm_&_nc_oc=Adr_YGbY7zTgYmU2E_BskllGhWqhqo_r2ZaDUBSwIR0gQqYtwgqxRANRE_W3zhST1F8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xma8heiRcDvf57zI_xTFAet-hGeYqy541RzvCEz_xLg&oe=6A105751"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ConfocalVR", "keywords": [], "long_description": "**ConfocalVR** \u2014 immersive 3D exploration of microscopy image stacks, from Immersive Science.\n\nLoad Z-stacks from confocal, two-photon, electron microscopy, and other volumetric imaging techniques. Navigate through them in true 3D on Meta Quest.\n\n**What it does**\n- Render Z-stacks as navigable 3D volumes \u2014 fly through tissue, rotate specimens, examine structures from any angle\n- Multi-channel visualization with independent color and opacity controls per channel\n- Adjust transfer functions, brightness, contrast, and clipping planes in real time\n- Pre-loaded sample datasets ready to explore on launch\n\n**Broad format support**\n- TIFF image stacks, NIfTI, and DICOM\n- Compatible with data from confocal, two-photon, SEM, cryo-EM, X-ray, AFM, STED, SIM, and more\n- ZIP support: download from Google Drive or cloud storage, extract and load automatically\n\n**Smart data handling**\n- Large stacks automatically subsampled to fit Quest memory\n- Gaussian filtering preserves visual detail during subsampling\n- Progress feedback during loading\n- Desktop version available for full-resolution work \u2014 contact support@immsci.com\n\n**Collaborate**\n- Share a virtual space with colleagues \u2014 examine the same specimen together in real time\n\nStandalone on Meta Quest 2, Quest 3, and Quest Pro.\n", "short_description": "Explore 3D microscopy image stacks in virtual reality. Load confocal, two-photon, electron microscopy, and other Z-stacks in TIFF, NIfTI, or DICOM format. Multi-channel visualization, real-time parameter control, collaborative sessions. Built for researchers. From Immersive Science, makers of StarGateVR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "23981314634790586"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3951916098384535"}]}, "baseline_offer": {"id": "3951916098384535"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774024260, "status": "PUBLISHED", "id": "3951916098384535"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27716054247983254", "version": "4.0.1"}, "id": "675268074856964", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary
g&oe=69D79EB0"}, {"file_name": "PMN_stimuliert_2560x1440.png", "id": "1633042391067869", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619677_1633042394401202_7209868863111439645_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ukPi5b0zF4Q7kNvwGwxtGW&_nc_oc=AdqIliomUZLYqt8934z-r6FJ2MCHcncdWFy91xicH2AS-ZwjQf2V5W4eMiPhVpstlyc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ExICUW-nml1yuXcbJNyuc2y0Qe8itr6nCzeupdIt9PQ&oe=69D78806"}, {"file_name": "Teeth_2560x1440.png", "id": "917057617855874", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499620497_917057624522540_3322054066031636962_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIDDaPS4iUAQ7kNvwGBvcSI&_nc_oc=AdoebBjOm6qsinKMT7wlAfrZ5A5X3j9OH0UMTtwiG4KStogu11QTKjvvbmrxKNRWgck&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0x9TDoGdK42gXcxJ38USTouS_V4hUcnSHifhQWE8vznQ&oe=69D7B622"}, {"file_name": "Ostertagia.png", "id": "974074545049377", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499618882_974074551716043_3982132693816971777_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShL7fmRph1AQ7kNvwHH7HSB&_nc_oc=AdorPe9lDpIv316q9j4_r1oHhsiSPJM8-8AwXxjs_ufylumEsKFCLzn1Ek4CgmRvGrI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DSqLkFnlHCbT1OM2nBiRGnrMqA7hmOHtBfv3prDhD7w&oe=69D7AFBA"}, {"file_name": "kidney_glomeruli_2560x1440.png", "id": "1529509712024716", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618885_1529509715358049_3070632166327873331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Qpbr5gH0lsQ7kNvwGUdvXo&_nc_oc=Adr_IBQK32a2-NOluJvKQsY-pvPZEMHDbVdkTON6Y_zg8W6yQ9GZGnEOatyDnj-s6bM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0q4yNrIjn1gKTdJU0eqbGqEMNlvEfNvoFBkuVZltg0oQ&oe=69D7A6D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ConfocalVR", "keywords": [], "long_description": "**ConfocalVR** \u2014 immersive 3D exploration of microscopy image stacks, from Immersive Science.\n\nLoad Z-stacks from confocal, two-photon, electron microscopy, and other volumetric imaging techniques. Navigate through them in true 3D on Meta Quest.\n\n**What it does**\n- Render Z-stacks as navigable 3D volumes \u2014 fly through tissue, rotate specimens, examine structures from any angle\n- Multi-channel visualization with independent color and opacity controls per channel\n- Adjust transfer functions, brightness, contrast, and clipping planes in real time\n- Pre-loaded sample datasets ready to explore on launch\n\n**Broad format support**\n- TIFF image stacks, NIfTI, and DICOM\n- Compatible with data from confocal, two-photon, SEM, cryo-EM, X-ray, AFM, STED, SIM, and more\n- ZIP support: download from Google Drive or cloud storage, extract and load automatically\n\n**Smart data handling**\n- Large stacks automatically subsampled to fit Quest memory\n- Gaussian filtering preserves visual detail during subsampling\n- Progress feedback during loading\n- Desktop version available for full-resolution work \u2014 contact support@immsci.com\n\n**Collaborate**\n- Share a virtual space with colleagues \u2014 examine the same specimen together in real time\n\nStandalone on Meta Quest 2, Quest 3, and Quest Pro.\n", "short_description": "Explore 3D microscopy image stacks in virtual reality. Load confocal, two-photon, electron microscopy, and other Z-stacks in TIFF, NIfTI, or DICOM format. Multi-channel visualization, real-time parameter control, collaborative sessions. Built for researchers. From Immersive Science, makers of StarGateVR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"
_ss=7f20f&oh=00_Af6gvychMfngmQ3Io-ZVwVc3cMn5qxKEAxUejtFLGR7Q_A&oe=6A0C7C46"}, {"file_name": "Teeth_2560x1440.png", "id": "917057617855874", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620497_917057624522540_3322054066031636962_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=su2MxxGphHkQ7kNvwHSwdGf&_nc_oc=AdqP1FMy9WlW65MR7WHs9wakNGdUJWRIDcp5hmdR3Z8uGFgbqyjE9lAMo4yTWrfYj7E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6a1s5UuRILT_YENd_BM22dvlp6Gebv9SLkr7Z5ZPslWA&oe=6A0C7222"}, {"file_name": "Ostertagia.png", "id": "974074545049377", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618882_974074551716043_3982132693816971777_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wswvHK6KtzkQ7kNvwGhT__J&_nc_oc=Adpi9Z0xzQwU99SwVjOMYV4I6NFuXFP1Gir9FFcMJ51sxPWdlVANt_prv8CO8nCKY-I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Fm2QuV9A1aI-OBPlIiFo8TR9GdEfQcJNxwCeZGxQdLw&oe=6A0C6BBA"}, {"file_name": "kidney_glomeruli_2560x1440.png", "id": "1529509712024716", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618885_1529509715358049_3070632166327873331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsgfMeNrgH4Q7kNvwE0G175&_nc_oc=Adrci8nlXmMXqsQULxhjuNrv7HM7HnF69_Ng1wd0i3wnHXiQUBQzAT54xK5NJNYFinA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68bV324zesfUDQzcShvU3ahg8AyoMK9tsQ-6HWGegJkw&oe=6A0C62D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ConfocalVR", "keywords": [], "long_description": "**ConfocalVR** \u2014 immersive 3D exploration of microscopy image stacks, from Immersive Science.\n\nLoad Z-stacks from confocal, two-photon, electron microscopy, and other volumetric imaging techniques. Navigate through them in true 3D on Meta Quest.\n\n**What it does**\n- Render Z-stacks as navigable 3D volumes \u2014 fly through tissue, rotate specimens, examine structures from any angle\n- Multi-channel visualization with independent color and opacity controls per channel\n- Adjust transfer functions, brightness, contrast, and clipping planes in real time\n- Pre-loaded sample datasets ready to explore on launch\n\n**Broad format support**\n- TIFF image stacks, NIfTI, and DICOM\n- Compatible with data from confocal, two-photon, SEM, cryo-EM, X-ray, AFM, STED, SIM, and more\n- ZIP support: download from Google Drive or cloud storage, extract and load automatically\n\n**Smart data handling**\n- Large stacks automatically subsampled to fit Quest memory\n- Adaptive averaging preserves visual detail during subsampling\n- Progress feedback during loading\n- Desktop version available for full-resolution work \u2014 contact support@immsci.com\n\n**Collaborate**\n- Share a virtual space with colleagues \u2014 examine the same specimen together in real time\n\nStandalone on Meta Quest 2, Quest 3, and Quest Pro.\n", "short_description": "Make your microscopy visible. ConfocalVR lets you load 3D image stacks on a Quest headset and show your data in true three dimensions \u2014 to colleagues, students, funders, or the public."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_intera
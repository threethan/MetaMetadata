_ss=7f20f&oh=00_Af79kIJLiv6vsWRBhEHTA-E1CF5J6lSt1ejZmOMePCBB7Q&oe=6A05E4C6"}, {"file_name": "Teeth_2560x1440.png", "id": "917057617855874", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620497_917057624522540_3322054066031636962_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJE7ov5D-P8Q7kNvwFqDwV4&_nc_oc=AdrSsrHM2OB1Xl2RW7bEa98xvq81qRCR0P41dOt-CjxmMxRDaz7VZBjkdn8lXCVq4oA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-NIbOTaMH06MbJzeTAYnwdkCQFKfOiW2yCY2Zd65bog&oe=6A05DAA2"}, {"file_name": "Ostertagia.png", "id": "974074545049377", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618882_974074551716043_3982132693816971777_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnR-J57z9vQQ7kNvwE36lez&_nc_oc=Adr_rJGnb8Dx7panetK-hhJYkdCovccAVGVpKA6A1WbVllcw3uWuK8-rjBWgo3EyF6M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66QYCyaQvn4c2CyoboLe-z8nZI0xBCRB8uTg9LdVKU5g&oe=6A05D43A"}, {"file_name": "kidney_glomeruli_2560x1440.png", "id": "1529509712024716", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618885_1529509715358049_3070632166327873331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Nq5wuoGR5IQ7kNvwEiW2M6&_nc_oc=AdowDlUxNhR5RJxX2t02l1OKDsgmJJJDx_1j8nFT4C_-Qccizg69sTIaPTFWfmwfEfE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TGfEmFc4sdwLXWJl4YISe7PfxvSkcCBKikVyiMyuz8A&oe=6A05CB51"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ConfocalVR", "keywords": [], "long_description": "**ConfocalVR** \u2014 immersive 3D exploration of microscopy image stacks, from Immersive Science.\n\nLoad Z-stacks from confocal, two-photon, electron microscopy, and other volumetric imaging techniques. Navigate through them in true 3D on Meta Quest.\n\n**What it does**\n- Render Z-stacks as navigable 3D volumes \u2014 fly through tissue, rotate specimens, examine structures from any angle\n- Multi-channel visualization with independent color and opacity controls per channel\n- Adjust transfer functions, brightness, contrast, and clipping planes in real time\n- Pre-loaded sample datasets ready to explore on launch\n\n**Broad format support**\n- TIFF image stacks, NIfTI, and DICOM\n- Compatible with data from confocal, two-photon, SEM, cryo-EM, X-ray, AFM, STED, SIM, and more\n- ZIP support: download from Google Drive or cloud storage, extract and load automatically\n\n**Smart data handling**\n- Large stacks automatically subsampled to fit Quest memory\n- Adaptive averaging preserves visual detail during subsampling\n- Progress feedback during loading\n- Desktop version available for full-resolution work \u2014 contact support@immsci.com\n\n**Collaborate**\n- Share a virtual space with colleagues \u2014 examine the same specimen together in real time\n\nStandalone on Meta Quest 2, Quest 3, and Quest Pro.\n", "short_description": "Make your microscopy visible. ConfocalVR lets you load 3D image stacks on a Quest headset and show your data in true three dimensions \u2014 to colleagues, students, funders, or the public."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_intera
=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BcDMuHFl0uqJX5vmbyyiiu022H5Dft2Kfx2dolF4TCQ&oe=6A1EE879"}, {"file_name": "Immsci_Logo_OnDark_For_App_Store_2560x1440_ConfVR-2.png", "id": "783443877758271", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618069_783443881091604_7906048522184826951_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_yz4_4OsAYQ7kNvwFJiGn3&_nc_oc=AdpoREl_1zkek0E1gTyC2PM7A4ZCFphEW1Mz3lwEkQ1f5tkyBNqvkO0HnXOW72QsLQg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iMT6_dAcQOeEUHkDqO9SXycHaL3vQM5n2xMkaxPW7xQ&oe=6A1EEDFF"}, {"file_name": "ImmSciLogoSingle512x512.png", "id": "582324691063126", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499626010_582324694396459_6357133735676598417_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2u7qeWlnTYQ7kNvwFbdxlS&_nc_oc=Adrz4FFhC67BNnksC9QpMgymrWtjWLe7sdzz4bnQ3gvpWVQQOya-VnZAABBACFL3Eno&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53Qd5ks8FEzBJqdkjgBtzlc2bNF-y6daT1utMBDvVpFg&oe=6A1ED5D4"}]}, "id": "1547753776977758", "locale": "en_US", "screenshots": [{"file_name": "Neutrophil_2560x1440.png", "id": "819294603846147", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622315_819294607179480_6692104929756901283_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNOA9t3N6LgQ7kNvwEk-_lf&_nc_oc=AdoE-_aPklO2dOweaa2nVTMd0X48FhRo0OFDHO-py88qE9vQtd7nqIqAxE8u9AAtgkc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sbhlL29Ct0-ckBIkhWSsQvVwsv_Xdmv_wUVHZlCsFWg&oe=6A1ECFB0"}, {"file_name": "PMN_stimuliert_2560x1440.png", "id": "1633042391067869", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1633042394401202_7209868863111439645_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkQrfo2o4hYQ7kNvwHONIrL&_nc_oc=AdrBOsOKa506DNKwXEnhZVaiJGX3Hpl9X8oFKm776gqYQuXBqlox7fu6SJwsbHO4ucM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nRRCTbxTxrYvNmEBvdZO9Eea5BfKYUOwb1haJCPMOsw&oe=6A1EF146"}, {"file_name": "Teeth_2560x1440.png", "id": "917057617855874", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620497_917057624522540_3322054066031636962_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAL_EC8OB1sQ7kNvwFoTM-a&_nc_oc=AdoOpuTULgHCLhleLf5LKi1lbObZGgpNUHULotppY2SDIS7K5PHXuEeZxDeYFLUuTq4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wnhWfMjxMoMFz0NSei8nfh5Dk1cvAUsH95kcCzARbOw&oe=6A1EE722"}, {"file_name": "Ostertagia.png", "id": "974074545049377", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618882_974074551716043_3982132693816971777_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edyxp91UqBYQ7kNvwHUXfVi&_nc_oc=AdqjiC2dudaZpuipIwHjLnj1_KMmmGLv5zb-yo2hHEaEjf48dJxwBvO-5TsQ8dmHBMc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Xmk34_JCuyXCM8PDMhr1I1PF6zmBB-HFzG2xKrjfayg&oe=6A1EE0BA"}, {"file_name": "kidney_glomeruli_2560x1440.png", "id": "1529509712024716", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618885_1529509715358049_3070632166327873331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vPlG9-bwesQ7kNvwHzL-gi&_nc_oc=Adri08YYf1wWAcGiWlKxUOQ_zVPBAUL-5q0u1S0GhEz49-i2tK2JNSemBuSGtNVY5Ss&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ny7L1s_UvfYoiUhEu6RDsNngVY4xMU8hEMh6V4xzjZA&oe=6A1ED7D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ConfocalVR", "keywords": [], "long_description": "**ConfocalVR**  \u2014 immersive 3D exploration of microscopy image stacks. Load Z-stacks from confocal, two-photon, electron microscopy, and other volumetric techniques. Navigate in true 3D on Meta Quest.\n\n**What it does**\n\n- Render Z-stacks as navigable 3D volumes \u2014 fly through tissue, rotate specimens, examine from any angle\n- Multi-channel \u2014 up to 30 channels with independent brightness, threshold, and opacity controls\n- Format support \u2014 TIFF, NIfTI, DICOM, PNG, JPG loaded directly on the headset\n- Cloud loading \u2014 download from Google Drive or any web source via Quest Browser. No PC required\n- Collaboration \u2014 share a virtual space with colleagues anywhere in the world\n- Measurement \u2014 distances, histograms, object marking and counting\n- 4D time sequences \u2014 display time-series stacks as short movies\n- Real-time controls \u2014 transfer functions, brightness, contrast, clipping planes\n- Smart data handling \u2014 large files auto-subsampled to fit Quest memory (~30 million voxels)\n\n**Who it's for**\n\nScientists, educators, and core facility managers. If your instrument produces a Z-stack, ConfocalVR can render it.\n\n**Larger datasets?** A Windows desktop version handles up to 128M voxels. See immsci.com/confocalvr.\n", "short_description": "Make your microscopy visible. ConfocalVR lets you load 3D image stacks on a Quest headset and show your data in true three dimensions \u2014 to colleagues, students, funders, or the public."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USE
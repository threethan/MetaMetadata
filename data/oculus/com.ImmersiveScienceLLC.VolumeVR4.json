_ss=7f20f&oh=00_Af7pbZlXowKUAZiQQIdEGFUPSd3G7x5XgSyWo6zD5_6wSg&oe=6A19AB46"}, {"file_name": "Teeth_2560x1440.png", "id": "917057617855874", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620497_917057624522540_3322054066031636962_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ny0sRSa4LPQQ7kNvwGIGKrA&_nc_oc=AdoO0Bneji4yppY5HPKWFXHdek5541MPSr-v9l2nrsEdNc82tYGbHJlZ60Bq4idhVKg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6e_BF2PsgDZePV2LyK7MRUYvBRveSaY7lKfzX0i_21kw&oe=6A19A122"}, {"file_name": "Ostertagia.png", "id": "974074545049377", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618882_974074551716043_3982132693816971777_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2_4EAs7h5sQ7kNvwHeRRN8&_nc_oc=AdqJv2W7Fl9IhLwXcy9YhclhwKuSEWE1AUAKZ9e8-6__g1iZCt8KpWJBUtFhzswu6NM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UK3OqnSNk_f7x5OXCPF9CzTlMst9uDJVhKZJ1Kw517w&oe=6A199ABA"}, {"file_name": "kidney_glomeruli_2560x1440.png", "id": "1529509712024716", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618885_1529509715358049_3070632166327873331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDezmuwDia4Q7kNvwEIjuST&_nc_oc=AdoesSM5963JQweS3DjSZkx6jJ3mIRIcxXOQvHBSwRjW4tSURC2ZKHB6XdqIukFnehU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71VbViOtl14VRq6fwMXOXJ7-Hh3huPLQkm1aO07jKtsQ&oe=6A1991D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ConfocalVR", "keywords": [], "long_description": "**ConfocalVR**  \u2014 immersive 3D exploration of microscopy image stacks. Load Z-stacks from confocal, two-photon, electron microscopy, and other volumetric techniques. Navigate in true 3D on Meta Quest.\n\n**What it does**\n\n- Render Z-stacks as navigable 3D volumes \u2014 fly through tissue, rotate specimens, examine from any angle\n- Multi-channel \u2014 up to 30 channels with independent brightness, threshold, and opacity controls\n- Format support \u2014 TIFF, NIfTI, DICOM, PNG, JPG loaded directly on the headset\n- Cloud loading \u2014 download from Google Drive or any web source via Quest Browser. No PC required\n- Collaboration \u2014 share a virtual space with colleagues anywhere in the world\n- Measurement \u2014 distances, histograms, object marking and counting\n- 4D time sequences \u2014 display time-series stacks as short movies\n- Real-time controls \u2014 transfer functions, brightness, contrast, clipping planes\n- Smart data handling \u2014 large files auto-subsampled to fit Quest memory (~30 million voxels)\n\n**Who it's for**\n\nScientists, educators, and core facility managers. If your instrument produces a Z-stack, ConfocalVR can render it.\n\n**Larger datasets?** A Windows desktop version handles up to 128M voxels. See immsci.com/confocalvr.\n", "short_description": "Make your microscopy visible. ConfocalVR lets you load 3D image stacks on a Quest headset and show your data in true three dimensions \u2014 to colleagues, students, funders, or the public."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USE
": "ImmSciLogoSingle512x512.png", "id": "582324691063126", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499626010_582324694396459_6357133735676598417_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rb_lxZk5bL4Q7kNvwHATkBD&_nc_oc=AdpdPT5VW52jmWbZqaUNOLhjOYBB6HxWZTd7pLaaCtoJcf8Ea9CVJmYjkpTvnLXKiSg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sdofzqWFqK8PcssBg98KgMJdQpzCU2niKy-NVCdyfHA&oe=69DE3C54"}]}, "id": "668075326027583", "locale": "en_US", "screenshots": [{"file_name": "Neutrophil_2560x1440.png", "id": "819294603846147", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499622315_819294607179480_6692104929756901283_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOnlkgqt390Q7kNvwGkDYFv&_nc_oc=Adr7jAl5A2i_38RvQoSV09FdBlGG1-WijT7IvYnEvnWZxzzLkbnoVZCLGKmNb6Am9SE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38ueSoxlyBB-kPtL2HCe4imXjIrrx2FUoJd3ELhuGQEg&oe=69DE3630"}, {"file_name": "PMN_stimuliert_2560x1440.png", "id": "1633042391067869", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619677_1633042394401202_7209868863111439645_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmEsTPNma1sQ7kNvwHTIO5X&_nc_oc=Adr69pemujfjguZ-uWfGE6p4w-hm11qNUUYMADH-NblZIQaRX_y_plAjFuDT2uodw3c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fU6l2DzcoXvIgAA1mLyoS6aafDSRJrFluEK7efACqYQ&oe=69DE1F86"}, {"file_name": "Teeth_2560x1440.png", "id": "917057617855874", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620497_917057624522540_3322054066031636962_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggZXkJDPVhwQ7kNvwGRy2JZ&_nc_oc=Adq9jdhfd-SEoG_fr3Beat8nqUUaqmZrjq1Qm_h9rV3GMdRRxrPMaHrJ6LWpRJVtjwU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19y3OjQ0nDADWPn7EQeU7nwhYQv63qeFDDXqFMlCwmpw&oe=69DE4DA2"}, {"file_name": "Ostertagia.png", "id": "974074545049377", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618882_974074551716043_3982132693816971777_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZdXHICWCFcQ7kNvwF27h1M&_nc_oc=AdrMpD1JQyduGGljwSxDZm7bvrNaCWcJweezFebBEvMXcY9RsEM3CgvOcF3LdJreJbo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af342zhCEfHLVtxzruVMpkUaq8EoqNhPt3qmBj_x13WGBg&oe=69DE473A"}, {"file_name": "kidney_glomeruli_2560x1440.png", "id": "1529509712024716", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618885_1529509715358049_3070632166327873331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcUQfEKkoVYQ7kNvwGyLiQT&_nc_oc=Adpw1DPNNzvmd_TjhlyiHTUVb87JAw4skR8DZYlqsOblhMeJJK4VtfKZTtVivhvL-dA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EG6Mbcm_CAmC1wswkqui24opbdh5oHslJHAwOgMGVEA&oe=69DE3E51"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ConfocalVR", "keywords": [], "long_description": "**ConfocalVR** \u2014 immersive 3D exploration of microscopy image stacks, from Immersive Science.\n\nLoad Z-stacks from confocal, two-photon, electron microscopy, and other volumetric imaging techniques. Navigate through them in true 3D on Meta Quest.\n\n**What it does**\n- Render Z-stacks as navigable 3D volumes \u2014 fly through tissue, rotate specimens, examine structures from any angle\n- Multi-channel visualization with independent color and opacity controls per channel\n- Adjust transfer functions, brightness, contrast, and clipping planes in real time\n- Pre-loaded sample datasets ready to explore on launch\n\n**Broad format support**\n- TIFF image stacks, NIfTI, and DICOM\n- Compatible with data from confocal, two-photon, SEM, cryo-EM, X-ray, AFM, STED, SIM, and more\n- ZIP support: download from Google Drive or cloud storage, extract and load automatically\n\n**Smart data handling**\n- Large stacks automatically subsampled to fit Quest memory\n- Gaussian filtering preserves visual detail during subsampling\n- Progress feedback during loading\n- Desktop version available for full-resolution work \u2014 contact support@immsci.com\n\n**Collaborate**\n- Share a virtual space with colleagues \u2014 examine the same specimen together in real time\n\nStandalone on Meta Quest 2, Quest 3, and Quest Pro.\n", "short_description": "Explore 3D microscopy image stacks in virtual reality. Load confocal, two-photon, electron microscopy, and other Z-stacks in TIFF, NIfTI, or DICOM format. Multi-channel visualization, real-time parameter control, collaborative sessions. Built for researchers. From Immersive Science, makers of StarGateVR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "23981314634790586"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3951916098384535"}]}, "baseline_offer": {"id": "3951916098384535"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774024260, "status": "PUBLISHED", "id": "3951916098384535"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27418233637765318", "version": "4.0"}, "id": "675268074856964", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23981314624790587", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27418233637765318"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "675268074856964"}]}, "change_log": "Full support for compressed and multi-frame DICOM files. Single-file DICOMs containing multiple slices (common from certain CT, MRI, and ultrasound scanners) are now automatically detected, decompressed, and loaded as full 3D volumes. Large DICOM series are automatically optimized for Quest memory with near-instant re-loading on subsequent opens. Scene settings, slider adjustments, and channel parameters are now saved and restored automatically between sessions.", "created_date": 1775775551, "id": "27418233637765318", "version": "4.0", "version_code": 331, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23981314624790587", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27418233637765318"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "675268074856964"}]}, "change_log": "ConfocalVR has received a series of significant updates since its store launch. Here are the highlights:\n\nBroader file compatibility\n\n\u2022 TIFF files that previously failed to load now work correctly, including exports from many common microscope software packages\n\u2022 Full RGB DICOM support \u2014 color medical imaging files now load correctly\n\u2022 Improved DICOM series detection handles files with minor metadata variations\n\nLarge datasets just work\n\n\u2022 Datasets that exceed Quest memory limits are automatically downsampled before loading \u2014 no pre-processing needed\n\nBetter VR experience\n\n\u2022 Sharper UI text throughout\n\u2022 Datasets look cleaner on first load with improved default settings\n\u2022 Accurate loading progress throughout\n\nLearn more: www.immsci.com/home/confocalvr/ (http://www.immsci.com/home/confocalvr/)\nQuestions or data loading issues? Contact support@immsci.com", "created_date": 1775603044, "id": "27396883583233657", "version": "4.0", "version_code": 322, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23981314624790587", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27418233637765318"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "675268074856964"}]}, "change_log": "Unity Event Tracking enabled for performance monitoring and usage analytics.", "created_date": 1775586997, "id": "27394877783434237", "version": "4.0", "version_code": 319, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23981314624790587", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27418233637765318"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "675268074856964"}]}, "change_log": "Unity Event Tracking Enabled for performance monitoring and debugging.", "created_date": 1775547932, "id": "27389772877278061", "version": "4.0", "version_code": 318, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23981314624790587", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27418233637765318"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "675268074856964"}]}, "change_log": "Improved text readability and visual quality on Quest. Optimized rendering settings for sharper images. Widened file browser drive list for better readability. Fixed version number display. Internal code cleanup.", "created_date": 1775523861, "id": "27386885014233514", "version": "4.0", "version_code": 316, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
": "ImmSciLogoSingle512x512.png", "id": "582324691063126", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499626010_582324694396459_6357133735676598417_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOAG7Itru7kQ7kNvwGFbcFc&_nc_oc=AdofKMGMSoLgvVXy-buvN9Z_T1BjN3sUOSU8p8QAjrZrffbx3poGLodn_HzgtDKDu0M&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Kp5Aq39LSqrqiiH-NOuMCytTDbA8rdXIPDq2sDApdDg&oe=69E230D4"}]}, "id": "668075326027583", "locale": "en_US", "screenshots": [{"file_name": "Neutrophil_2560x1440.png", "id": "819294603846147", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499622315_819294607179480_6692104929756901283_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fC1QaBlnH1AQ7kNvwGFBPcH&_nc_oc=AdpIwT8L_cuB51ON3L2zrlCA5ET5LJPTlFFzAE0yP5c1GoCrnYCOCIERaPvVLxtEsaE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12UtG5OQDVLUn2ekX8JMJn1oMM-FA_befE6xb4YuJIuQ&oe=69E22AB0"}, {"file_name": "PMN_stimuliert_2560x1440.png", "id": "1633042391067869", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619677_1633042394401202_7209868863111439645_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I89GoN52_vEQ7kNvwF_70Hf&_nc_oc=AdryrhPga3ICMhC6fCNrkUvT0iglk6JnKv9OI18z1BooNj-1UaEwkYzIS-27jcglfVM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_S3WGQ4iFh2LKuMGGqYgpVh2d8MuAxWhGdjh2JWUquA&oe=69E24C46"}, {"file_name": "Teeth_2560x1440.png", "id": "917057617855874", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499620497_917057624522540_3322054066031636962_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElOAQnzxMdUQ7kNvwHSLNR2&_nc_oc=AdroG_vwzcD1ZjJXvSHPAaYz1qTzYa-PrRf0QFgqI56qeItzMVy6wL99vP-lZD_ZTv4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0emjAKsazKfvRcTFnHv8ulzQdY3e7zfrESudkoz-vwKw&oe=69E24222"}, {"file_name": "Ostertagia.png", "id": "974074545049377", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499618882_974074551716043_3982132693816971777_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-nyI-S4UgFsQ7kNvwEdyBZM&_nc_oc=AdqmXQSX6E3q5SnQCw_WNjxQlPW9U2S1yBqOX9BN5HsvPLOfut4mrV2H_ICHD2gkKzE&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34B6y0-u7GY2ow9SMCvWkFnBF6KrXSazwypYU2jKcXLw&oe=69E23BBA"}, {"file_name": "kidney_glomeruli_2560x1440.png", "id": "1529509712024716", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499618885_1529509715358049_3070632166327873331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ftn9MkkbPn0Q7kNvwHC_mlv&_nc_oc=AdokvVSzrDZJQTIG5g-XrHuFIZP-bcsmmjk77QT3jSH1FmGlAom--CMnT6WnE_HIBlY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2akKGEpqLe8UReiDZs_u3hZmnyIkszgIJmRSR10CAREA&oe=69E232D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ConfocalVR", "keywords": [], "long_description": "**ConfocalVR** \u2014 immersive 3D exploration of microscopy image stacks, from Immersive Science.\n\nLoad Z-stacks from confocal, two-photon, electron microscopy, and other volumetric imaging techniques. Navigate through them in true 3D on Meta Quest.\n\n**What it does**\n- Render Z-stacks as navigable 3D volumes \u2014 fly through tissue, rotate specimens, examine structures from any angle\n- Multi-channel visualization with independent color and opacity controls per channel\n- Adjust transfer functions, brightness, contrast, and clipping planes in real time\n- Pre-loaded sample datasets ready to explore on launch\n\n**Broad format support**\n- TIFF image stacks, NIfTI, and DICOM\n- Compatible with data from confocal, two-photon, SEM, cryo-EM, X-ray, AFM, STED, SIM, and more\n- ZIP support: download from Google Drive or cloud storage, extract and load automatically\n\n**Smart data handling**\n- Large stacks automatically subsampled to fit Quest memory\n- Gaussian filtering preserves visual detail during subsampling\n- Progress feedback during loading\n- Desktop version available for full-resolution work \u2014 contact support@immsci.com\n\n**Collaborate**\n- Share a virtual space with colleagues \u2014 examine the same specimen together in real time\n\nStandalone on Meta Quest 2, Quest 3, and Quest Pro.\n", "short_description": "Explore 3D microscopy image stacks in virtual reality. Load confocal, two-photon, electron microscopy, and other Z-stacks in TIFF, NIfTI, or DICOM format. Multi-channel visualization, real-time parameter control, collaborative sessions. Built for researchers. From Immersive Science, makers of StarGateVR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "23981314634790586"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3951916098384535"}]}, "baseline_offer": {"id": "3951916098384535"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774024260, "status": "PUBLISHED", "id": "3951916098384535"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27450161754572506", "version": "4.0"}, "id": "675268074856964", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23981314624790587", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27450161754572506"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "675268074856964"}]}, "change_log": "ConfocalVR Release Notes \u2014 Build 349\n\nConfocalVR now loads DICOM medical images reliably on Quest, including color DICOMs and multi-frame files. This update brings improved rendering performance, live progress during file loading, faster reloads with persistent caching, logarithmic depth control, and proper grayscale defaults for medical images. Multiple stability and quality-of-life improvements throughout.", "created_date": 1776030891, "id": "27450161754572506", "version": "4.0", "version_code": 349, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23981314624790587", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27450161754572506"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "675268074856964"}]}, "change_log": "Release Notes (v4.0 Build 341)\n\n\u2022 Stereo rendering switched to Multiview: Quest rendering now uses Multiview (Single Pass Instanced) instead of Multi Pass, eliminating visual jitter and shimmer on volume surfaces. Also improves GPU performance by rendering both eyes in a single draw call.\n\u2022 Zoom Depth auto-default: Volumes now load with visually balanced depth based on actual dimensions and voxel spacing. Datasets with unequal axis counts (e.g. 512\u00d7512\u00d7170) no longer appear flat on first load.\n\u2022 StreamingAssets refresh on update: Bundled sample data is now refreshed automatically when a new build is installed. Previously, updating without a full reinstall could leave stale or missing data files.\n\u2022 NIfTI auto-downsampling on Quest: Large NIfTI files are now automatically downsampled during loading, matching existing DICOM behavior. Prevents out-of-memory crashes on oversized datasets.\n\u2022 Quest optimization limits revised: Maximum texture size increased from 256\u00b3 to 512\u00d7512\u00d7256; voxel count limit raised from 8M to 30M. Improved image quality on Quest 3.\n\u2022 Image Quality default on Quest: Render quality now defaults to 256 (maximum) on Quest, matching desktop out of the box.\n\u2022 Zoom Depth slider range doubled: Slider now allows up to 9\u00d7 default depth (previously 4.5\u00d7), giving more range for thin datasets.\n\u2022 Zoom Depth slider sync fix: Volume no longer jumps on first slider interaction after loading.\n\u2022 DICOM scan progress: File count and percentage now displayed during header scanning.", "created_date": 1775953645, "id": "27440097515578930", "version": "4.0", "version_code": 341, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23981314624790587", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27450161754572506"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "675268074856964"}]}, "change_log": "Full support for compressed and multi-frame DICOM files. Single-file DICOMs containing multiple slices (common from certain CT, MRI, and ultrasound scanners) are now automatically detected, decompressed, and loaded as full 3D volumes. Large DICOM series are automatically optimized for Quest memory with near-instant re-loading on subsequent opens. Scene settings, slider adjustments, and channel parameters are now saved and restored automatically between sessions.", "created_date": 1775775551, "id": "27418233637765318", "version": "4.0", "version_code": 331, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23981314624790587", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27450161754572506"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "675268074856964"}]}, "change_log": "ConfocalVR has received a series of significant updates since its store launch. Here are the highlights:\n\nBroader file compatibility\n\n\u2022 TIFF files that previously failed to load now work correctly, including exports from many common microscope software packages\n\u2022 Full RGB DICOM support \u2014 color medical imaging files now load correctly\n\u2022 Improved DICOM series detection handles files with minor metadata variations\n\nLarge datasets just work\n\n\u2022 Datasets that exceed Quest memory limits are automatically downsampled before loading \u2014 no pre-processing needed\n\nBetter VR experience\n\n\u2022 Sharper UI text throughout\n\u2022 Datasets look cleaner on first load with improved default settings\n\u2022 Accurate loading progress throughout\n\nLearn more: www.immsci.com/home/confocalvr/ (http://www.immsci.com/home/confocalvr/)\nQuestions or data loading issues? Contact support@immsci.com", "created_date": 1775603044, "id": "27396883583233657", "version": "4.0", "version_code": 322, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23981314624790587", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27450161754572506"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "675268074856964"}]}, "change_log": "Unity Event Tracking enabled for performance monitoring and usage analytics.", "created_date": 1775586997, "id": "27394877783434237", "version": "4.0", "version_code": 319, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
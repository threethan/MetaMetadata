2.png", "id": "582324691063126", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499626010_582324694396459_6357133735676598417_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLFtZVZDtUkQ7kNvwE5yyoF&_nc_oc=Adpn4yWXaqxz92w6WzF0wNqPh6Z0H6DIiVwPc2AJ5Pxw9Ku6jcKcPwdEhby4YHY1Y4g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af14K03HIOxMt_ZhX6hnwnNwldNDBaP2g2Ci8jtlV_DBJg&oe=69F202D4"}]}, "id": "668075326027583", "locale": "en_US", "screenshots": [{"file_name": "Neutrophil_2560x1440.png", "id": "819294603846147", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622315_819294607179480_6692104929756901283_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwjkraQ2fqEQ7kNvwHTvgz4&_nc_oc=AdqrGGe8BCxoC2fDK15CoAiXe__BAgkv-lFmi5i_CSgbsk6DxmutYKguvBSmeEmdx3g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0fl99_w3JmyRHTyHoKo4g7YNssc4TK5No2XjI9MrNIUQ&oe=69F1FCB0"}, {"file_name": "PMN_stimuliert_2560x1440.png", "id": "1633042391067869", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619677_1633042394401202_7209868863111439645_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CeZQNAM3q4kQ7kNvwFY_V9C&_nc_oc=AdoMEX7UNzOUBpGvxt4D0tDglyPSa7GZ6vrfJdadj8HSCQn_OIqU4WOmEAQX0PI0V1M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2Uf-BlvT2bxktMwERBgda-dIeIFLCSDDdTvyuoXiIHTg&oe=69F1E606"}, {"file_name": "Teeth_2560x1440.png", "id": "917057617855874", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620497_917057624522540_3322054066031636962_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHuauhXUdugQ7kNvwH6LtWH&_nc_oc=Ado67H1odPRm8ocyG6NyY6rxuS6wREw3vsKtjkqpzBBSSk10BDV_f6LirnP9vM30DUs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2hHtdcXuGiEMoKvpLh7ODn2PgKtweY4vYFgC66sgpxnQ&oe=69F21422"}, {"file_name": "Ostertagia.png", "id": "974074545049377", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618882_974074551716043_3982132693816971777_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2zUphNKY3QQ7kNvwG5oCx3&_nc_oc=AdoIxL_AIjC1NADBVJY0U8R9TmY4rgULYL_zEeGjNqLzr9UWK3rjt4IvNGX8fJ_ujDU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0R2wp9Qh8eNFoHp6qYqFZd4XuKXbUHLcFmaR8d4jBgjA&oe=69F20DBA"}, {"file_name": "kidney_glomeruli_2560x1440.png", "id": "1529509712024716", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618885_1529509715358049_3070632166327873331_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zh_xRB5BN0EQ7kNvwFtGNHH&_nc_oc=Adr6h5JhPhpJ8HsV8ftMjQJT4-gCakdsuO3xx_XICHc9-ZI0z0_7AmpoFW267JIPuE8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3f7BOS1Wd9e41ZfWgiErnrc_TvejFoE0s_DIUXVDeDCA&oe=69F204D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ConfocalVR", "keywords": [], "long_description": "**ConfocalVR** \u2014 immersive 3D exploration of microscopy image stacks, from Immersive Science.\n\nLoad Z-stacks from confocal, two-photon, electron microscopy, and other volumetric imaging techniques. Navigate through them in true 3D on Meta Quest.\n\n**What it does**\n- Render Z-stacks as navigable 3D volumes \u2014 fly through tissue, rotate specimens, examine structures from any angle\n- Multi-channel visualization with independent color and opacity controls per channel\n- Adjust transfer functions, brightness, contrast, and clipping planes in real time\n- Pre-loaded sample datasets ready to explore on launch\n\n**Broad format support**\n- TIFF image stacks, NIfTI, and DICOM\n- Compatible with data from confocal, two-photon, SEM, cryo-EM, X-ray, AFM, STED, SIM, and more\n- ZIP support: download from Google Drive or cloud storage, extract and load automatically\n\n**Smart data handling**\n- Large stacks automatically subsampled to fit Quest memory\n- Gaussian filtering preserves visual detail during subsampling\n- Progress feedback during loading\n- Desktop version available for full-resolution work \u2014 contact support@immsci.com\n\n**Collaborate**\n- Share a virtual space with colleagues \u2014 examine the same specimen together in real time\n\nStandalone on Meta Quest 2, Quest 3, and Quest Pro.\n", "short_description": "Explore 3D microscopy image stacks in virtual reality. Load confocal, two-photon, electron microscopy, and other Z-stacks in TIFF, NIfTI, or DICOM format. Multi-channel visualization, real-time parameter control, collaborative sessions. Built for researchers. From Immersive Science, makers of StarGateVR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "23981314634790586"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3951916098384535"}]}, "baseline_offer": {"id": "3951916098384535"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774024260, "status": "PUBLISHED", "id": "3951916098384535"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27528331700088844", "version": "4.0"}, "id": "675268074856964", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primar
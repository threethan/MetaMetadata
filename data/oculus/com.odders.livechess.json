9DA0E2"}, {"file_name": "Menu.png", "id": "219917143125234", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974800_219917146458567_57534265389887899_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_-fZ9T87G8Q7kNvwHpjJbg&_nc_oc=AdlR-sh6vVEg2isAYc0bezUNuBwgs1yX2OaRaIScQtN6InxaRyZY3Q7u-gQKVPOXhYM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuf-cmwZvm1KfELhgDKQ41VniqHuApBy2pcFIezbgZ17w&oe=699D837D"}, {"file_name": "Stone01.png", "id": "324973902498518", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974750_324973909165184_7903273729607391907_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DoYwb5j5WgQ7kNvwG-nI5b&_nc_oc=AdmqrhavnebCJgCej_Fx_e3UXXGtrP7TPs8Dp7fpI2B3LT0tblyCo6BKZ21LVXplIoU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsw_PKxcl2KHcW95mjjmJrH8KjIxOxVPwnfUwvIf0ZXhA&oe=699DB0B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QPP_ChessClub_Landscape_2560x1440.png", "id": "955771975176273", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974800_955771978509606_3653996410524113750_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZRNIBXdG1UQ7kNvwFISNMX&_nc_oc=Adlz1L3Xk-fuVRglAl-11unQj-JL0iWZHPs6MxgivaRqJSZ2LOibw51s55FIFCLsC0k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuX_8hdQ7I2jhunDIWXqdS6nLic5IXv6LaAcJVOZ5ODIg&oe=699DB011"}, "display_name": "Chess Club", "keywords": ["chess", "chessboard", "checkmate", "chessmaster", "boardgame"], "long_description": "Play chess, the greatest strategy game in History, in stunning environments! Compete against other players or the AI in the Grand Palace classic hall or fight in Stonehenge, a magical realm inhabited by fantastic creatures.  \n\n> Both hand - tracking and touch controllers supported! <\n\nCompete against others or play just for fun. With several difficulty levels and different time rules available, you can customize the experience to your own skills. Talk to your friends during a match or get to know other players with the voice chat! More content, environments, and piece sets will come in future updates!\n\nKey features\n\n-Play against a friend or the AI (several difficulty levels) \n\n-Avatars and Voice IP in online multiplayer\n\n-Casual and ranked matchs\n\n-Play with touch controllers or hand-tracking\n\n-Track your moves history during a match\n\n-Different time rules (bullet, blitz, real time, async...)\n\n-2 environments and set pieces: Grand Palace and Stonehenge\n\n-Fight animations and sound FX", "short_description": "Play chess, the greatest strategy game in History, in stunning environments! Compete against other players or the AI in the Grand Palace classic hall or fight in Stonehenge, a magical realm inhabited by fantastic creatures.  \n\n> Both hand - tracking and touch controllers supported! <\n\nCompete against others or play just for fun. With several difficulty levels and different time rules available, you can customize the experience to your own skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://chessclub-vr.com/legal-disclaimer/", "developer_terms_of_service_url": null, "publisher_name": "Odders", "support_website_url": null, "website_url": "https://odderslab.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "721041425967142"}
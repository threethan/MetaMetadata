19562"}, {"file_name": "Menu.png", "id": "219917143125234", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974800_219917146458567_57534265389887899_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRTvh0Acl6QQ7kNvwFNgtYg&_nc_oc=AdlUqwSPxCDRXh_ze0kGzTF5X4S8PSNqeI5gYibSskL7XFWtZzZdXssfuDTXD3TY64k&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsF6viGY7YjIaSMBn_qB94mbIHnTi3OivDuaCWtcLurNw&oe=69A177FD"}, {"file_name": "Stone01.png", "id": "324973902498518", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974750_324973909165184_7903273729607391907_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x90ilgIGJWwQ7kNvwHV0V6x&_nc_oc=Adm6_ExEGFQW1frraqdINnjB3H4mcwHOm9EbxU165LwUm9Odn-BaYP6AxTkhJ9hnZeA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuOPBJOgmZuSL_akupBYqrHgvX5co6Rj2q-5CwZc-dATw&oe=69A1A533"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QPP_ChessClub_Landscape_2560x1440.png", "id": "955771975176273", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974800_955771978509606_3653996410524113750_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbGuSRALsaMQ7kNvwE70VbW&_nc_oc=AdkAu5i87HOTMnqj5ohGAViHwi27OgiQeGqLxQMvKmjp6hAnx8NVq4Y94w2VdIHQIik&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuhjxudthCz5vzwNtj1dzCTJTyupY15ipU09lBgcoPLKQ&oe=69A1A491"}, "display_name": "Chess Club", "keywords": ["chess", "chessboard", "checkmate", "chessmaster", "boardgame"], "long_description": "Play chess, the greatest strategy game in History, in stunning environments! Compete against other players or the AI in the Grand Palace classic hall or fight in Stonehenge, a magical realm inhabited by fantastic creatures.  \n\n> Both hand - tracking and touch controllers supported! <\n\nCompete against others or play just for fun. With several difficulty levels and different time rules available, you can customize the experience to your own skills. Talk to your friends during a match or get to know other players with the voice chat! More content, environments, and piece sets will come in future updates!\n\nKey features\n\n-Play against a friend or the AI (several difficulty levels) \n\n-Avatars and Voice IP in online multiplayer\n\n-Casual and ranked matchs\n\n-Play with touch controllers or hand-tracking\n\n-Track your moves history during a match\n\n-Different time rules (bullet, blitz, real time, async...)\n\n-2 environments and set pieces: Grand Palace and Stonehenge\n\n-Fight animations and sound FX", "short_description": "Play chess, the greatest strategy game in History, in stunning environments! Compete against other players or the AI in the Grand Palace classic hall or fight in Stonehenge, a magical realm inhabited by fantastic creatures.  \n\n> Both hand - tracking and touch controllers supported! <\n\nCompete against others or play just for fun. With several difficulty levels and different time rules available, you can customize the experience to your own skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://chessclub-vr.com/legal-disclaimer/", "developer_terms_of_service_url": null, "publisher_name": "Odders", "support_website_url": null, "website_url": "https://odderslab.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "721041425967142"}}
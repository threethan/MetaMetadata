043E2"}, {"file_name": "Menu.png", "id": "219917143125234", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974800_219917146458567_57534265389887899_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRTvh0Acl6QQ7kNvwEotT0c&_nc_oc=AdlRN8tuPH8F8CWNwjR9VOsylrvs3reRokB7tpO8g9PT8zmqbIBnnFwtiR3De_1mFdc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuEKewRR3Pb8_Nt5-uyaNilLuXc48uRebHK62v3k0_QkQ&oe=69A0267D"}, {"file_name": "Stone01.png", "id": "324973902498518", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974750_324973909165184_7903273729607391907_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x90ilgIGJWwQ7kNvwGIndvD&_nc_oc=AdkJm5yj8LMESkl4YjoApctQCpCbVwPaelXk7xiIXdWWZMLbaIGbh9v5IWUBqN40Y_8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfumEFwmPRiuJiL_J48LsNj4eSZW9Bw8LWxXraiaYPoacw&oe=69A053B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QPP_ChessClub_Landscape_2560x1440.png", "id": "955771975176273", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974800_955771978509606_3653996410524113750_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZRNIBXdG1UQ7kNvwEqKhLE&_nc_oc=AdlbFqHd46SK7JEVST7UxoXllShwMqNy86u5DKXEWgfdTTSxH0b-3Iofe8gkRU2DYYg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvf-qHE6ApSLm9xgBePLHnubLyKovgvuRGeo7XaJSP25w&oe=69A05311"}, "display_name": "Chess Club", "keywords": ["chess", "chessboard", "checkmate", "chessmaster", "boardgame"], "long_description": "Play chess, the greatest strategy game in History, in stunning environments! Compete against other players or the AI in the Grand Palace classic hall or fight in Stonehenge, a magical realm inhabited by fantastic creatures.  \n\n> Both hand - tracking and touch controllers supported! <\n\nCompete against others or play just for fun. With several difficulty levels and different time rules available, you can customize the experience to your own skills. Talk to your friends during a match or get to know other players with the voice chat! More content, environments, and piece sets will come in future updates!\n\nKey features\n\n-Play against a friend or the AI (several difficulty levels) \n\n-Avatars and Voice IP in online multiplayer\n\n-Casual and ranked matchs\n\n-Play with touch controllers or hand-tracking\n\n-Track your moves history during a match\n\n-Different time rules (bullet, blitz, real time, async...)\n\n-2 environments and set pieces: Grand Palace and Stonehenge\n\n-Fight animations and sound FX", "short_description": "Play chess, the greatest strategy game in History, in stunning environments! Compete against other players or the AI in the Grand Palace classic hall or fight in Stonehenge, a magical realm inhabited by fantastic creatures.  \n\n> Both hand - tracking and touch controllers supported! <\n\nCompete against others or play just for fun. With several difficulty levels and different time rules available, you can customize the experience to your own skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://chessclub-vr.com/legal-disclaimer/", "developer_terms_of_service_url": null, "publisher_name": "Odders", "support_website_url": null, "website_url": "https://odderslab.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "721041425967142"}}
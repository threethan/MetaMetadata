c_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYlAAndkM-kQ7kNvwG2X6JF&_nc_oc=AdoFxHEonvlvdAUpAMJmt6wc0FZOk9nG3QH8LM8ca-e0T8-Bc0_p5qPnsdQECXYndeU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4PhhGNC_2LJvYYwOEETwhRKMmHor8KIYvQfhz4ecKOw&oe=6B007C33"}, {"file_name": "ss4.png", "id": "849566738088760", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818860_849566741422093_8194763594590044362_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jiGw4LWAj10Q7kNvwEQsukx&_nc_oc=AdrOHHuaF5Mw7ZY_vcqmLh7wislREvECxL6pTbBTmI4cLVUe-GsbUDrp9MNeLmieojg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRt7_9n0T279fnaQktIHiLmmd4mTLdjaFcgpR3eQ8zA-g&oe=6B0080C3"}, {"file_name": "ss5.png", "id": "1257438589138559", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820923_1257438592471892_5307824601549585761_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCctKcN1InMQ7kNvwGfcX_o&_nc_oc=Adq5lNwY5p7qCkj-OzVd7LrZnlJ9Sce9yXOf7Qo3dcqey1dxgE0tJsEYwKMH0crDdio&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcDyeooPpcRje0fH4-J1uQlb1Vjz-WfweS4dRD1-9CPw&oe=6B00731E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "798473796054785", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_798473802721451_3134853349907070682_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2qTATtDbpAQ7kNvwEaUayQ&_nc_oc=AdpOLn-djEH0DiOAt-hrLSe4YihFQDBiNkH7Ba8nVyc7fqbY50dAyjnwcGdyg6VwXkw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNz-b23tdXn4il4VtvpTD-ci6vZ4-YYSvw4i5E_qXTqg&oe=6B007642"}, "display_name": "Parkour Drive VR", "keywords": ["Parkour", "Racing", "Driving", "Physics", "Car"], "long_description": "Parkour Drive VR delivers an intense virtual reality driving experience where precision, balance, and focus are the keys to survival.\n\nHigh above the clouds, a series of extreme tracks await. Narrow roads, sharp turns, floating platforms, ramps, and unexpected obstacles create a parkour-style driving challenge that constantly tests your control. Every movement matters, and every mistake can send your vehicle off the edge.\n\nInstead of traditional racing, the focus is on skill and control. You must carefully manage your speed, steer with precision, and stay balanced as you move through dangerous sky tracks suspended far above the ground. Some sections require slow and careful driving, while others demand confidence and perfect timing.\n\nAs you progress through the levels, the courses become more complex and demanding. New obstacles, steeper ramps, tighter turns, and more daring jumps will push your abilities further with each challenge.\n\nThe immersive VR perspective places you directly into the driver's seat, making every turn feel intense and every narrow track feel truly dangerous. The sensation of height, speed, and balance creates a thrilling experience that keeps you focused from start to finish.\n\nStay calm, keep control of your vehicle, and see if you have what it takes to conquer the sky in Parkour Drive VR.", "short_description": "Parkour Drive VR is a thrilling virtual reality driving experience where precision and balance are everything. Drive across narrow sky-high tracks, overcome parkour-style obstacles, and master challenging ramps, loops, and jumps. Every level tests your control and timing as you push your driving skills to the limit. Stay focused, keep your balance, and conquer the ultimate sky parkour course."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "c
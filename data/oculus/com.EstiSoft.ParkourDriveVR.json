, "id": "849566738088760", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491818860_849566741422093_8194763594590044362_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgCRzipOEvEQ7kNvwEofVB9&_nc_oc=Adr8UlzULSCOcLSAB25ATX_cZYCKSjvBqLKuNsrA5GEOnrCJkX9a7vrQmCnozFc4-mQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8J_IG6P_kBqBUoaqpvEM7NUVxh4ZlwRYA2el_8yTjzzw&oe=6A26C103"}, {"file_name": "ss5.png", "id": "1257438589138559", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820923_1257438592471892_5307824601549585761_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrpaTvkSryQQ7kNvwE8U8E6&_nc_oc=Adp_EMUtYp9T1AK7r_d8yN8MAPTUioaDP3yXB3PV_Zhtf9BZqcV-OgV77AdnNGRRCEY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92ju0ICPRYruer907aWdeilamuoVNWNR82koZteq27nQ&oe=6A26EB9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "798473796054785", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823802_798473802721451_3134853349907070682_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0neyQDNzj4wQ7kNvwFGCIFv&_nc_oc=Adpexw40Z4p3GAYYFVHMyf4Z5KoevuALTWSiRamqBcG_dKpFfVvTT_2ly73XGbPRxTQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_J999U4P96s2xef8ydMW8sLpswsAM_gTPM3FsSWzHmbw&oe=6A26EEC2"}, "display_name": "Parkour Drive VR", "keywords": ["Parkour", "Racing", "Driving", "Physics", "Car"], "long_description": "Parkour Drive VR delivers an intense virtual reality driving experience where precision, balance, and focus are the keys to survival.\n\nHigh above the clouds, a series of extreme tracks await. Narrow roads, sharp turns, floating platforms, ramps, and unexpected obstacles create a parkour-style driving challenge that constantly tests your control. Every movement matters, and every mistake can send your vehicle off the edge.\n\nInstead of traditional racing, the focus is on skill and control. You must carefully manage your speed, steer with precision, and stay balanced as you move through dangerous sky tracks suspended far above the ground. Some sections require slow and careful driving, while others demand confidence and perfect timing.\n\nAs you progress through the levels, the courses become more complex and demanding. New obstacles, steeper ramps, tighter turns, and more daring jumps will push your abilities further with each challenge.\n\nThe immersive VR perspective places you directly into the driver's seat, making every turn feel intense and every narrow track feel truly dangerous. The sensation of height, speed, and balance creates a thrilling experience that keeps you focused from start to finish.\n\nStay calm, keep control of your vehicle, and see if you have what it takes to conquer the sky in Parkour Drive VR.", "short_description": "Parkour Drive VR is a thrilling virtual reality driving experience where precision and balance are everything. Drive across narrow sky-high tracks, overcome parkour-style obstacles, and master challenging ramps, loops, and jumps. Every level tests your control and timing as you push your driving skills to the limit. Stay focused, keep your balance, and conquer the ultimate sky parkour course."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
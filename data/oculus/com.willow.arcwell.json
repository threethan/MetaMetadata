content-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW5J8FGvpvN__B1N6Z3wPV10_o7D0AMpxPJzzGzmscnJw&oe=6B0EF24A"}, {"file_name": "03-portals.png", "id": "1078881841586878", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824328_1078881844920211_4552814501434054898_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLSsQTUsrZkQ7kNvwGXpIF7&_nc_oc=AdqVnW7-w9Xjkmg8dPHy4NB3Re2hxgiJpb9Ic6DfKdwijiJ0H01Blx8xkdR_NkZ1VOE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXLJXUyFgutfdU7phB62dgOMidybCo-mZVUS_WaVA-Wvg&oe=6B0EF411"}, {"file_name": "04-orbits.png", "id": "1416034159859016", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673536876_1416034163192349_1898821495240860005_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXyRF-cOVwQQ7kNvwG_8YZe&_nc_oc=AdqQdI7gI5nOOTQIkfLkhPZul6sceLPrIThYQkmQw610fspfBogUk_rTajaqxgpMl4E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVBp0-Af-gfUvCAQ39rgFFd3Jj6XdQALRwO9b_cpx5w-g&oe=6B0EEDFC"}, {"file_name": "05-playground.png", "id": "914410458195607", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293669_914410464862273_4339150803262777984_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuYvxjgoQWUQ7kNvwHIFIiA&_nc_oc=AdrTlorLVSvdS1G0_r6Hodojt6WvM-dBgl9MDRHNziDxSbVaiKe_L7jJCR_BAgqRnVo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU04Qb3xUOcPIkoEfPnx7F1DPBJVZptrjiyBCyLxBfH2Q&oe=6B0EF85B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Arcwell", "keywords": ["gravity", "rockets", "space", "sandbox", "puzzles"], "long_description": "# Master the arc\n\nLaunch through gravity, guide a careful docking approach, or build your own universe. Arcwell brings orbital puzzles and precision piloting into VR.\n\n# Aim. Release. Refine.\n\nGrip your rocket, choose its direction and launch speed, then let it fly. Watch planetary gravity bend its path. Spend limited fuel to adjust the flight, or retry with a new approach.\n\n{2464820544344023}\n\n# Find a route through the impossible\n\nSlingshot around worlds, travel through black holes, and thread moving orbits. Read the field and experiment until the reactor is within reach.\n\n{1393387289527144}\n\n- **Authored missions** with new orbital problems to solve.\n- **Daily and seeded challenges** for more routes to explore.\n- **The Observatory** your home between flights.\n\n# Precision docking\n\nTake the remote pilot controls in 24 docking missions. Use small thruster inputs and onboard camera views to correct drift, align with the port, and ease into contact. Manage limited fuel as approaches grow more demanding.\n\n{4494738287521877}\n\n# Build your own universe\n\nStep into Playground to create, grow, and move planets. Experiment with gravity and physical interaction at your own pace.\n\n{1834355447992453}\n\n**Single-player. Play offline.** Touch controllers required. Settings and progress stay on your headset.", "short_description": "Launch rockets, master precision docking, and build your own universe in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://arcwell-vr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Willow Development", "support_website_url": "https://arcwell-vr.com/support/", "website_url": "https://arcwell-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1099417865916743"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1135794035612459", "version": "1.3.0"}, "id": "1816986783052687", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1099417859250077", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1135794035612459"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1816986783052687"}]}, "change_log": "Arcwell 1.3.0 \u2014 everything new since 0.33.0\n\n- Hand tracking: play with Touch controllers or your hands. On-screen instructions name the button or gesture for what you are using and change when you switch. Hand-tracking flight controls stay where you put them and can be moved to suit your reach.\n- Hand of Gravity: a new mode on the home console. Set a gravity projector on a table or in the air, then use your open hands (or controller triggers) as gravity wells to bend, catch and sling a rocket through 16 levels. Play in your room in mixed reality, or press SPACE for a space backdrop. Use LOCK to hold the projector's place, turn and field size so nothing changes by accident.\n- Hand of Gravity Playground: place planets and black holes, flick them into orbit, stack moons three deep, resize and tilt orbits, aim black-hole exits, and throw rockets and rocks. Move the rocket and rock launch points to try new angles. With controllers, point the laser (it snaps to nearby targets) or touch with the controller's tip to take planets, rockets and rocks from the tray or the field, and grab orbit rings by laser. Planets pull harder, so throws curve visibly. Three save slots.\n- Tender Uplink: when the station's service Tender calls (or you call it), reach through two ports and work its claws from its camera to complete six rotating repairs.\n- Multiplayer for two: host or join with a private six-character room code for orbital races, co-op Escort (pilot and support drone) or a shared Playground. Fly the Escort support drone with controllers or hand tracking. No public matchmaking, voice or text chat. Both headsets need the same version.\n- TRAINING: a hands-on lesson for each mode: Flight Check, Docking, Hand of Gravity and both Playgrounds. Training is optional and can be replayed any time.\n- Fitting Bay: customize your ship's nose, fins, engines, canopy, paint, finishes, markings, lights and exhaust, and save favorite builds.\n- Pilot suits: refit your suit, helmet, visor and pack at the suit mirror. Your partner sees it in multiplayer.\n- Record Hall: 99 commendations, some of them secret, with patches, trophies and lifetime statistics. Commendations also unlock as Meta Quest achievements, including ones already earned.\n- Miniature rocket ring course in the Observatory, with timed runs.\n- Precision Strike: nudge a moving rocket with the stick, using a small separate allowance each flight. Once your rocket flies past the reactor, its engine locks and only weaker RCS can steer it back. Flight Check now teaches the nudge and labels the reactor, and X retries from any mission result.\n- Progress is included in Meta Quest Cloud Backup.", "created_date": 1794116732, "id": "1135794035612459", "version": "1.3.0", "version_code": 70, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_appli
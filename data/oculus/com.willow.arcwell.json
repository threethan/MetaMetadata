=00_AQRpHvXd6elWDdaxLt2ivCcKGkbed1v4P4JEzrbbtRdzsQ&oe=6AFB277C"}, {"file_name": "05-playground.png", "id": "914410458195607", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499293669_914410464862273_4339150803262777984_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDyGNz8MNVsQ7kNvwG2WJUY&_nc_oc=Ado_YYD9nVWE8FHuCdFY4_sh31MtjCm1o36btOJ4V0VR9_IZy5UgM35roC48Ha4Cu1s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCxZHwZDnUJbYcgnEFpyLdDIrcBexlOVQDTjd0oZtNOg&oe=6AFB31DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "arcwell-universal-cover-safe-2560x1440.png", "id": "2288627021897425", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823910_2288627108564083_983158914315788241_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OR4tEWOpag0Q7kNvwHz3fnX&_nc_oc=AdqdHG1w1GwzR6ubBIX7Jbg8ZNf5bzDDD5aBnvalaUgoKWmzn47qLAs-_oEESnKFT8c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCaZa1YzoojE5I_rHZyCcGFyy_HgL9UGVyDbWF1RCZ7g&oe=6AFB4037"}, "display_name": "Arcwell", "keywords": ["gravity", "rockets", "space", "sandbox", "puzzles"], "long_description": "# Master the arc\n\nLaunch through gravity, guide a careful docking approach, or build your own universe. Arcwell brings orbital puzzles and precision piloting into VR.\n\n# Aim. Release. Refine.\n\nGrip your rocket, choose its direction and launch speed, then let it fly. Watch planetary gravity bend its path. Spend limited fuel to adjust the flight, or retry with a new approach.\n\n{2464820544344023}\n\n# Find a route through the impossible\n\nSlingshot around worlds, travel through black holes, and thread moving orbits. Read the field and experiment until the reactor is within reach.\n\n{1393387289527144}\n\n- **Authored missions** with new orbital problems to solve.\n- **Daily and seeded challenges** for more routes to explore.\n- **The Observatory** your home between flights.\n\n# Precision docking\n\nTake the remote pilot controls in 24 docking missions. Use small thruster inputs and onboard camera views to correct drift, align with the port, and ease into contact. Manage limited fuel as approaches grow more demanding.\n\n{4494738287521877}\n\n# Build your own universe\n\nStep into Playground to create, grow, and move planets. Experiment with gravity and physical interaction at your own pace.\n\n{1834355447992453}\n\n**Single-player. Play offline.** Touch controllers required. Settings and progress stay on your headset.", "short_description": "Launch rockets, master precision docking, and build your own universe in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://arcwell-vr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Willow Development", "support_website_url": "https://arcwell-vr.com/support/", "website_url": "https://arcwell-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1104854882039708"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823783_2877925799259796_8478261074614247133_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_ZX3JvLIdIQ7kNvwFnkGlA&_nc_oc=AdpOYHFms0CNY4HyVrE_TbBR9pJCNLxxI9Q07SZflk2_8NGdpG4mCigWq_fNzp9Kf5A&_nc_zt=3&_nc
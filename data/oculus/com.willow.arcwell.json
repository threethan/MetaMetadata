n", "id": "1099417859250077", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1135794035612459"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793449051, "id": "1127824189742777", "version": "1.2.0", "version_code": 64, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
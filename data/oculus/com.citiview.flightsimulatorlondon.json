BWwQ7kNvwHTht_Q&_nc_oc=AdoHyxbtyG4RqJTZb7EN5vzo4vFh0OM0QZxaE1tu6DJRD-KlIgv8G6D9MNobd_4eWws&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaDDw-Mmf4m4zejHYaS_fgZfZ8AuUOU3zYVTNW3Feakw&oe=6AFDBEB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "3058524477816668", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604347072_3058524481150001_4690734639008493786_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqtRNDRYHmUQ7kNvwFH-QXX&_nc_oc=Adpdi0YuY0re8z11SmtJHJV8jfFr326G7iiereE4_FCAEff2llijDerz37JK1LUM0Jw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCkQmP0gHGxA_gjhCSu8m-B2FG9Sq3veyeUBgb5hU02w&oe=6AFDCC90"}, "display_name": "Flight Simulator London", "keywords": ["flight", "simulator", "london", "jet", "pilot"], "long_description": "Flight Simulator London puts you in the captain's seat over the real London.\n\nTHE REAL LONDON\nReal satellite, elevation and map data: the Houses of Parliament and Big Ben, the London Eye, the Shard, the Gherkin, St Paul's, Tower Bridge, the Tower, Canary Wharf, the O2, Wembley's arch, Battersea, Greenwich, Windsor Castle and 25 Thames bridges. Four airports: Heathrow, London City, Gatwick and RAF Northolt.\n\nA LIVING CITY\nThe Elizabeth line, the Tube, the DLR and Thameslink on their real tracks, red double-deckers and black cabs on the roads, Thames Clippers on the river, airliners in Heathrow's stacks. At night the West End, the river and Tower Bridge light up.\n\nAIR TRAFFIC CONTROL\nA real-sounding radio: taxi and takeoff clearances, departure, traffic calls, the ILS and your landing clearance, with chatter between airliners.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar on the Thames at Greenwich, Canary Wharf and the O2 out of the doors. Walk around, repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet with yokes and a twin-engine fighter.\n\nMISSIONS AND FREE FLIGHT\nEleven missions: the Heathrow city approach, London City's steep approach, a Thames run, THROUGH Tower Bridge, Windsor, a fighter scramble, the West End after dark and a London tour.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real London, built from real satellite and map data: Big Ben, the London Eye, the Shard, St Paul's, Tower Bridge, Canary Wharf, Wembley, Windsor Castle and four airports. Start in your own glass hangar on the Thames, talk to live air traffic control, fly through Tower Bridge, and take out private jets or a fighter. Fly solo or together online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorlondon/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/flightsimulatorlondon/", "website_url": "https://citiview-games.pages.dev/flightsimulatorlondon/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1372823419247527"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes
tWUTguNXmvwwnDBO8Zz3vL0QuxXg7byo7A&oe=6AF1F6B3"}, {"file_name": "screenshot_4.png", "id": "2946902889024064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596168449_2946902892357397_8418128944654342433_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YZILqbEAwIQ7kNvwHe_O6N&_nc_oc=AdrIz4o5Nd_ZbFgIQ9bqLf0fXaHFsqN1DX4VGMIW6kJGJYTcz5Up6iMCmMb1nbL4frQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuG_-dezVhnbI2kO2RBgTWakpgc_F897LaUQ_nxWNn6Q&oe=6AF1DF1B"}, {"file_name": "screenshot_5.png", "id": "841091602416143", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595129854_841091605749476_321224649836160794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFJA1e-9t6kQ7kNvwEccoW-&_nc_oc=Adp1snkqrufS7t18zcYB2_dsVtot9i2jEsvHsm3Cv612c6yBZmQf9Isqprq5mw-NEa0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjNGdbF_pfqhdjqIY-SiniVvATd673V0e9JjDzdFvvFw&oe=6AF1E135"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "3058524477816668", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604347072_3058524481150001_4690734639008493786_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ROFHDCa2m8Q7kNvwExm5XK&_nc_oc=Adowc7Iv42FKvCXbxMQ1uw6da0iXTpxJbxQTo9SvEpK0r5PEjYmOTy-7jYsicA7My4I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRb1mW6mdC-HEjBQr8hF__sJYlniapKmkOOG9YvG8XVzw&oe=6AF1EF10"}, "display_name": "Flight Simulator London", "keywords": ["flight", "simulator", "london", "jet", "pilot"], "long_description": "Flight Simulator London puts you in the captain's seat over the real London.\n\nTHE REAL LONDON\nReal satellite, elevation and map data: the Houses of Parliament and Big Ben, the London Eye, the Shard, the Gherkin, St Paul's, Tower Bridge, the Tower, Canary Wharf, the O2, Wembley's arch, Battersea, Greenwich, Windsor Castle and 25 Thames bridges. Four airports: Heathrow, London City, Gatwick and RAF Northolt.\n\nA LIVING CITY\nThe Elizabeth line, the Tube, the DLR and Thameslink on their real tracks, red double-deckers and black cabs on the roads, Thames Clippers on the river, airliners in Heathrow's stacks. At night the West End, the river and Tower Bridge light up.\n\nAIR TRAFFIC CONTROL\nA real-sounding radio: taxi and takeoff clearances, departure, traffic calls, the ILS and your landing clearance, with chatter between airliners.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar on the Thames at Greenwich, Canary Wharf and the O2 out of the doors. Walk around, repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet with yokes and a twin-engine fighter.\n\nMISSIONS AND FREE FLIGHT\nEleven missions: the Heathrow city approach, London City's steep approach, a Thames run, THROUGH Tower Bridge, Windsor, a fighter scramble, the West End after dark and a London tour.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real London, built from real satellite and map data: Big Ben, the London Eye, the Shard, St Paul's, Tower Bridge, Canary Wharf, Wembley, Windsor Castle and four airports. Start in your own glass hangar on the Thames, talk to live air traffic control, fly through Tower Bridge, and take out private jets or a fighter. Fly solo or together online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorlondon/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/flightsimulatorlondon/", "website_url": "https://citiview-games.pages.dev/flightsimulatorlondon/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "N
5/499619404_1162715349558567_2624655025354226677_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7C-zLsVniIYQ7kNvwEqRQR-&_nc_oc=Adon983Nd_C3_rvZdRFr4xxA8Gq0EW28FCB4brEcBkh3NpRc2W6G2QzDS3X59pxfi-A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTyFHGbYS3RbU-o8Vi_FSs6Xhkpx3kDSOhPSJYiQEz-AQ&oe=6B0B37B5"}, {"file_name": "screenshot_3.png", "id": "1005358128601854", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499624592_1005358131935187_8391633957263609832_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4KD83cO1ikQ7kNvwGlvDR4&_nc_oc=Adoeq9mcXJhpsftgeNB6fFlTLJJxoydbnR4iYg-6hvwu7glrpF-nD_wGDfQJuW93xeI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSNQ6zdAafyFzxWeu64vVx67kfpSSzURXuN3AR96z2FlA&oe=6B0B1519"}, {"file_name": "screenshot_4.png", "id": "1141144951738059", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620532_1141144955071392_990237215074270153_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_NmRJPqSnkQ7kNvwEt74cz&_nc_oc=Adp34sVfpy9w1NGTBTiHwj9zjuli0-nn-LjJ1L_6oVAn8-Kck-MV-GLKH_exI263fpU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRqV8zurmO42a-VOBtUoTjbtPxGgcxgFp9Flf3HkeQ1mw&oe=6B0B1F93"}, {"file_name": "screenshot_5.png", "id": "3467444433435239", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/593723055_3467444436768572_1781971624083964435_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7O53hU6jThEQ7kNvwHxh-0P&_nc_oc=AdpG88pQ9TF5UmeH-Cl_Nk48xWvAr0PoNjKkXVahXwRlU_wiKIajymqKkmFAqvvUhsc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQrEOwMaLSTfgJLr4KSFNtY7wqRQoojI-Gl4y2LhVDkLA&oe=6B0B1D01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11_trailer_video_screenshot.png", "id": "1132038326209321", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/908839758_1132038329542654_4297905480555898203_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oahIQdID8WwQ7kNvwEhLnYD&_nc_oc=Adpfm4ruW_Z3-kTkfcYkr8d20JWaGvhANtWIzjAxIsP8YX8_mx0Uz5bXp8yw3ZsXbys&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRRpXlwybRmAQXIEGN2OSm9gFcttGSEtYWVzU3ycy9EvA&oe=6B0B4023"}, "display_name": "Tuba", "keywords": ["tuba", "brass", "instrument", "music", "band"], "long_description": "A tuba, in mixed reality.\n\nThe valves use real tuba fingerings, so if you already play, you already know them.\n\nMake it the tuba you play:\n- Top-action pistons, front-action pistons or rotary valves.\n- 3, 4, 5 or 6 valves.\n- With 4, the 4th in the row, or on the side as a compensating valve, as on a British brass band bass.\n- With 5, the 5th on your right thumb or for your left hand.\n- With 6, the 5th and 6th both for your left hand, or the 5th on your right thumb and the 6th for your left hand.\n- A tuba in B\u266d, C, E\u266d or F.\n- Any size from 3/4 to 6/4.\n- With 4 valves or more, each valve on the controller button you like.\n\nPlay with friends online, whichever Fncore instrument they have: Violinist, Trombone, Trumpet, Cello or Tuba.\n\nThe music stand shows you how to play 43 pieces, like Saint-Sa\u00ebns's The Elephant, with the fingering for every note as you go. Hear a piece played on your tuba first if you like, then play every note yourself. Nothing is scored.", "short_description": "A mixed reality tuba for Meta Quest. The valves use real tuba fingerings, so if you already play, you already know them. Choose top- or front-action pistons or rotary valves; 3 to 6 valves, placed as you like; B\u266d, C, E\u266d or F; 3/4 to 6/4; and the button for each valve. The music stand shows you how to play 43 pieces, like The Elephant. You play every note yourself, and nothing is scored. Play with friends online, whichever Fncore instrument they have: Violinist, Trombone, Trumpet, Cello or Tuba."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/tuba/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fncore, Inc.", "support_website_url": null, "website_url": "https://fncore.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3158829911130163"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1532216748734353"}]}, "baseline_offer": {"id": "1532216748734353"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795294800, "status": "PUBLISHED", "id": "1532216748734353"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3177453779267776", "version": "1.8.4"}, "id": "1927711961531498", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3158829901130164", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3177453779267776"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1927711961531498"}]}, "change_log": "Ten Christmas carols on the music stand, from Jingle Bells and Silent Night to O Holy Night.", "created_date": 1795467736, "id": "3177453779267776", "version
=o4KD83cO1ikQ7kNvwHjXM0m&_nc_oc=AdqTMa_TBpLfgHHxWWaEzqUL3lrDtFXWMcLzl8fLOygDbqfoqqQs3xVmcfI5HR1hJbw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzNyx1-oO6VlizmM1v0OGxTk8Pylg_f4IlD5thbhlrMQ&oe=6B09C399"}, {"file_name": "screenshot_4.png", "id": "1141144951738059", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499620532_1141144955071392_990237215074270153_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_I30Wk8icZkQ7kNvwE2vsBe&_nc_oc=Adr-lSd18FqO8BwO-hoBi5JUKuRyC8cG-0yH3VZOVaPFQLSTpbCQjgDG6TDCJnTMs0A&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTS3E7HhC3mqnn3FHqwKHZl7CpUiBSRKTAROY8W3wRLhQ&oe=6B09CE13"}, {"file_name": "screenshot_5.png", "id": "3467444433435239", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593723055_3467444436768572_1781971624083964435_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7O53hU6jThEQ7kNvwGirZrK&_nc_oc=AdqRT8LMFkB9KTHk1X8uEIY_-AUjRDya3jvJmDpW9t5due6rmsEU-LPH3b8-Il0l9zQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5GOTvb4Z9qFCSCxSDCUZtnJjixCbQBv-PSn64QsSrRQ&oe=6B09CB81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11_trailer_video_screenshot.png", "id": "1132038326209321", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/908839758_1132038329542654_4297905480555898203_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_p7u0uNoKLMQ7kNvwFrZV6G&_nc_oc=AdoFN5I1IApkggTUUwdCuzPPFCyGZdRK505Dq7tl4NGrFcxUuTPmMkiatR0GtjqVfZE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRKDej2Dq7ebVMZ5dRl1NlO9b4j8W7XKgfQuyxelX0ag&oe=6B09B663"}, "display_name": "Tuba", "keywords": ["tuba", "brass", "instrument", "music", "band"], "long_description": "A tuba, in mixed reality.\n\nThe valves use real tuba fingerings, so if you already play, you already know them.\n\nMake it the tuba you play:\n- Top-action pistons, front-action pistons or rotary valves.\n- 3, 4, 5 or 6 valves.\n- With 4, the 4th in the row, or on the side as a compensating valve, as on a British brass band bass.\n- With 5, the 5th on your right thumb or for your left hand.\n- With 6, the 5th and 6th both for your left hand, or the 5th on your right thumb and the 6th for your left hand.\n- A tuba in B\u266d, C, E\u266d or F.\n- Any size from 3/4 to 6/4.\n- With 4 valves or more, each valve on the controller button you like.\n\nPlay with friends online, whichever Fncore instrument they have: Violinist, Trombone, Trumpet, Cello or Tuba.\n\nThe music stand shows you how to play 43 pieces, like Saint-Sa\u00ebns's The Elephant, with the fingering for every note as you go. Hear a piece played on your tuba first if you like, then play every note yourself. Nothing is scored.", "short_description": "A mixed reality tuba for Meta Quest. The valves use real tuba fingerings, so if you already play, you already know them. Choose top- or front-action pistons or rotary valves; 3 to 6 valves, placed as you like; B\u266d, C, E\u266d or F; 3/4 to 6/4; and the button for each valve. The music stand shows you how to play 43 pieces, like The Elephant. You play every note yourself, and nothing is scored. Play with friends online, whichever Fncore instrument they have: Violinist, Trombone, Trumpet, Cello or Tuba."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/tuba/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fncore, Inc.", "support_website_url": null, "website_url": "https://fncore.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "re
cdn.com/v/t64.5771-25/499620316_967637822741848_6241657300826954312_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k674qWfJFDAQ7kNvwEetZrc&_nc_oc=AdqFLFbAShjQ738JicuCxvaHa-PeT9U3QXnddkHDF0FCBcI1NnOgZvnAcv_gZroD8oI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWo03pCjmRm984XKnS_kSGOlk5oNZWjtX4SvvllOlhFAw&oe=6B106077"}]}, "id": "2155200995089704", "locale": "en_US", "screenshots": [{"file_name": "screenshot_1.png", "id": "1563566038862336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623876_1563566042195669_5922232485509536024_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDWo3Ak9FUcQ7kNvwFQBKNh&_nc_oc=AdrQw121sq4SzXC_lHJ3YRJqukHIFWrWJJqXw-LQ-Y0Y7tiPK4MMJzIihmjf5EwBXew&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVppjowLHtxGXuHahJ3GYhdNwJ5f-7geItU34l55PCiAA&oe=6B105334"}, {"file_name": "screenshot_2.png", "id": "1162715346225234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619404_1162715349558567_2624655025354226677_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhKExDLRXAUQ7kNvwFOuoJn&_nc_oc=Adom1FZjY-J26yhy1dPO2sRasLjXdG-qDLyM4hbb5qxctS7V4Rnaie_6ePxTiiWNGyU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXfrbejC8BsIZlCN3RkEWuTe3CCqzYT2_Yd1fZHRBsDEA&oe=6B104575"}, {"file_name": "screenshot_3.png", "id": "1005358128601854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624592_1005358131935187_8391633957263609832_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G67DdpuU9nAQ7kNvwFHzwDB&_nc_oc=AdpQEzXosmnra1JeFHqHc1S0vjVsEPFTQfRUbF2ui0MqpX7CkbxS0ySzr8Pfw2khup8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVvILBAUcLo6sje0XNhz9xjgV5Jqs7DqYa4XcQZWBxR4Q&oe=6B105B19"}, {"file_name": "screenshot_4.png", "id": "1141144951738059", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620532_1141144955071392_990237215074270153_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_c8S2VOzi-IQ7kNvwGJAdom&_nc_oc=AdqRF-PjhpH_38ciccEXinyFXdtn-FTWvmsRRio_u2EEY5cx5vJj1vxTGnsNuZMl9u4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWlQfxDovsjRdUc6jMIFbSXP8RMYl6hxD3-DqkHkqFYTQ&oe=6B106593"}, {"file_name": "screenshot_5.png", "id": "3467444433435239", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593723055_3467444436768572_1781971624083964435_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEVLBUXf0QoQ7kNvwEbHca_&_nc_oc=AdrL5WXSNifinCjFzAd1ZnWlWoXl22FwfJJsvXMgBtkEY2UcUvc-rXP-00NXRZHl2es&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXHlNP8_wPNrTXpigvjYUQD2KOFJnNQnMNpYro_kDyP2A&oe=6B106301"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11_trailer_video_screenshot.png", "id": "1132038326209321", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908839758_1132038329542654_4297905480555898203_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTNXt-wRyYAQ7kNvwF0bK7a&_nc_oc=AdpLxajcjL6x2D3AdS9iQgNiCBcKV59mhSsskYL8Xr5aAk7o1V6NzXXO2ArvmMAZEoQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWFjjYHGNLfBJ3X6eluv-CvZpLFLjrQw2Mf9QBmicMYcw&oe=6B104DE3"}, "display_name": "Tuba", "keywords": ["tuba", "brass", "instrument", "music", "band"], "long_description": "A tuba, in mixed reality.\n\nThe valves use real tuba fingerings, so if you already play, you already know them.\n\nMake it the tuba you play:\n- Top-action pistons, front-action pistons or rotary valves.\n- 3, 4, 5 or 6 valves.\n- With 4, the 4th in the row, or on the side as a compensating valve, as on a British brass band bass.\n- With 5, the 5th on your right thumb or for your left hand.\n- With 6, the 5th and 6th both for your left hand, or the 5th on your right thumb and the 6th for your left hand.\n- A tuba in B\u266d, C, E\u266d or F.\n- Any size from 3/4 to 6/4.\n- With 4 valves or more, each valve on the controller button you like.\n\nPlay with friends online, whichever Fncore instrument they have: Trombone (formerly Trombonest), Trumpet (formerly Trumpeteer), Cello, Tuba, Drum, or Violin and Viola (formerly Violinest).\n\nThe music stand shows you how to play 53 pieces, like Saint-Sa\u00ebns's The Elephant, with the fingering for every note as you go. Ten of them are Christmas carols, from Jingle Bells to O Holy Night. Hear a piece played on your tuba first if you like, then play every note yourself. Nothing is scored.", "short_description": "A mixed reality tuba for Meta Quest. The valves use real tuba fingerings, so if you already play, you already know them. Choose pistons or rotary valves, 3 to 6 valves, and B\u266d, C, E\u266d or F. The music stand shows you how to play 53 pieces, like The Elephant. You play every note yourself, and nothing is scored. Play with friends online, whichever Fncore instrument they have: Trombone (formerly Trombonest), Trumpet (formerly Trumpeteer), Cello, Tuba, Drum, or Violin and Viola (formerly Violinest)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/tuba/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fncore, Inc.", "support_website_url": null, "website_url": "https://fncore.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_int
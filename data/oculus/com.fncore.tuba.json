cdn.com/v/t64.5771-25/499620316_967637822741848_6241657300826954312_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k674qWfJFDAQ7kNvwFxdpS5&_nc_oc=Adof0F5aHR8JXVHLZxoUbKZt7Dd1vq54XDhV7sfTXthmT0LR_7Ocynni9IjQLJX8adk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUjntXfqFCzYOiS_nDPEZp_Os9aIa3lJxQhqqd_9m2ZQg&oe=6B0F0EF7"}]}, "id": "2155200995089704", "locale": "en_US", "screenshots": [{"file_name": "screenshot_1.png", "id": "1563566038862336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623876_1563566042195669_5922232485509536024_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDWo3Ak9FUcQ7kNvwHiDlbq&_nc_oc=Adomvq9Jd8wZL6N-MLdx47aEeawpm4yQcHD1TOx6llPzEEQ3tqixhBGqQghyvYjFYtw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXR6gS3oPxZ8dvoHAeFYzDclwV7RN2o9FzqZPjpni0BOg&oe=6B0F01B4"}, {"file_name": "screenshot_2.png", "id": "1162715346225234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619404_1162715349558567_2624655025354226677_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhKExDLRXAUQ7kNvwH9sjfL&_nc_oc=AdovnVlSxLOLpMOQOfL0snAT_IoHS8hLTV33KIQ1TKxI2vPrtEWu5ecoI2U_02RFn20&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXIbUbuyOs6_Sm2o4jRLeY0Un8KKBdo6DVTCaei-52p1w&oe=6B0EF3F5"}, {"file_name": "screenshot_3.png", "id": "1005358128601854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624592_1005358131935187_8391633957263609832_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G67DdpuU9nAQ7kNvwELRPnt&_nc_oc=AdrYq4uPZUlbvEHomVc5UK6qq2dexAQoUEb5PlTMZudka_VYYxv0X4JV8RErGwVd-Zs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUYT6-H3iKuAirSshUcUhhgb_XsvtTT8MiJxtKcCuE_6A&oe=6B0F0999"}, {"file_name": "screenshot_4.png", "id": "1141144951738059", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620532_1141144955071392_990237215074270153_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_c8S2VOzi-IQ7kNvwHgeAJU&_nc_oc=AdrbhB7GzjCh7rgcwci5IVzPnEhGcy420zPCLynem8_LzUJ_gV3wYSvF72OL8yjH-Ps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUVA2Nzsa-_N9Kj1zBYRKuRIUDNToZy33PSK0Vkp8ZG1g&oe=6B0F1413"}, {"file_name": "screenshot_5.png", "id": "3467444433435239", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593723055_3467444436768572_1781971624083964435_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Cm-nxhH6uoQ7kNvwGjH4Hp&_nc_oc=AdrtYUP8IVWtS6Hxkl-oiZyNPykjyKaPUeqY0Q8OiEP3SykcADTPnltREcGT7feY-II&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUVO7SJu1OnitAe-ayeZzRhyZWKApqH3j3dIZ8oUxqpWg&oe=6B0F1181"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11_trailer_video_screenshot.png", "id": "1132038326209321", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908839758_1132038329542654_4297905480555898203_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTNXt-wRyYAQ7kNvwEt7Jug&_nc_oc=AdooqpriP1nTF0MHD7_hHrwiSh3k8eH8GIKdz-lQfnISIc-lwHOIFXEwLdLZDQYxyMs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXPxrhbvPEYqKP_NFHMyrvtIGcjkCNvNp9cnpGY9GYDCQ&oe=6B0EFC63"}, "display_name": "Tuba", "keywords": ["tuba", "brass", "instrument", "music", "band"], "long_description": "A tuba, in mixed reality.\n\nThe valves use real tuba fingerings, so if you already play, you already know them.\n\nMake it the tuba you play:\n- Top-action pistons, front-action pistons or rotary valves.\n- 3, 4, 5 or 6 valves.\n- With 4, the 4th in the row, or on the side as a compensating valve, as on a British brass band bass.\n- With 5, the 5th on your right thumb or for your left hand.\n- With 6, the 5th and 6th both for your left hand, or the 5th on your right thumb and the 6th for your left hand.\n- A tuba in B\u266d, C, E\u266d or F.\n- Any size from 3/4 to 6/4.\n- With 4 valves or more, each valve on the controller button you like.\n\nPlay with friends online, whichever Fncore instrument they have: Trombone (formerly Trombonest), Trumpet (formerly Trumpeteer), Cello, Tuba, Drum, or Violin and Viola (formerly Violinest).\n\nThe music stand shows you how to play 53 pieces, like Saint-Sa\u00ebns's The Elephant, with the fingering for every note as you go. Ten of them are Christmas carols, from Jingle Bells to O Holy Night. Hear a piece played on your tuba first if you like, then play every note yourself. Nothing is scored.", "short_description": "A mixed reality tuba for Meta Quest. The valves use real tuba fingerings, so if you already play, you already know them. Choose pistons or rotary valves, 3 to 6 valves, and B\u266d, C, E\u266d or F. The music stand shows you how to play 53 pieces, like The Elephant. You play every note yourself, and nothing is scored. Play with friends online, whichever Fncore instrument they have: Trombone (formerly Trombonest), Trumpet (formerly Trumpeteer), Cello, Tuba, Drum, or Violin and Viola (formerly Violinest)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/tuba/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fncore, Inc.", "support_website_url": null, "website_url": "https://fncore.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_int
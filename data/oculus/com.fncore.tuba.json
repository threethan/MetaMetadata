scdn.com&_nc_ss=7f20f&oh=00_AQTKA92PzJZog87aCyb4D39r6homsB9DbilHkNzfGs1zKw&oe=6B0841C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11_trailer_video_screenshot.png", "id": "1132038326209321", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/908839758_1132038329542654_4297905480555898203_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_p7u0uNoKLMQ7kNvwHEn61u&_nc_oc=Ado7dQX-Teg4wW6hefCoNMtDOWnD1_FthHWhIvdTRtU1djYgYNDQpgFg5Ii3vYBBZ48&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQd1yxZzmn2P3OksrJ-ILawNVDqOpH_U7iS6rNZD7-gSg&oe=6B0864E3"}, "display_name": "Tuba", "keywords": ["tuba", "brass", "instrument", "music", "band"], "long_description": "A tuba, in mixed reality.\n\nThe valves use real tuba fingerings, so if you already play, you already know them.\n\nMake it the tuba you play:\n- Top-action pistons, front-action pistons or rotary valves.\n- 3, 4, 5 or 6 valves.\n- With 4, the 4th in the row, or on the side as a compensating valve, as on a British brass band bass.\n- With 5, the 5th on your right thumb or for your left hand.\n- With 6, the 5th and 6th both for your left hand, or the 5th on your right thumb and the 6th for your left hand.\n- A tuba in B\u266d, C, E\u266d or F.\n- Any size from 3/4 to 6/4.\n- With 4 valves or more, each valve on the controller button you like.\n\nPlay with friends online, whichever Fncore instrument they have: Violinist, Trombone, Trumpet, Cello or Tuba.\n\nThe music stand shows you how to play 43 pieces, like Saint-Sa\u00ebns's The Elephant, with the fingering for every note as you go. Hear a piece played on your tuba first if you like, then play every note yourself. Nothing is scored.", "short_description": "A mixed reality tuba for Meta Quest. The valves use real tuba fingerings, so if you already play, you already know them. Choose top- or front-action pistons or rotary valves; 3 to 6 valves, placed as you like; B\u266d, C, E\u266d or F; 3/4 to 6/4; and the button for each valve. The music stand shows you how to play 43 pieces, like The Elephant. You play every note yourself, and nothing is scored. Play with friends online, whichever Fncore instrument they have: Violinist, Trombone, Trumpet, Cello or Tuba."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/tuba/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fncore, Inc.", "support_website_url": null, "website_url": "https://fncore.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3158829911130163"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1532216748734353"}]}, "baseline_offer": {"id": "1532216748734353"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795294800, "status": "PUBLISHED", "id": "1532216748734353"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3167060683640419", "version": "1.8.0"}, "id": "1927711961531498", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3158829901130164", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "31670
cdn.com/v/t64.5771-25/499620316_967637822741848_6241657300826954312_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1L-GoyDJZMQ7kNvwFukrRZ&_nc_oc=AdrBdzgLvAXMQ9IPxehaTI7EJpK-iqHMDCUC87sXFNMcSh4Q_QdeJmfvAdJDM9dBK_c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSF8c9cgKcK1llm_-GVYvMbmrnr6X20tjO3viWjh8vjrA&oe=6B0C6BF7"}]}, "id": "2155200995089704", "locale": "en_US", "screenshots": [{"file_name": "screenshot_1.png", "id": "1563566038862336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623876_1563566042195669_5922232485509536024_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALGz9X_3qmoQ7kNvwHqtWw5&_nc_oc=AdpTbqNSz6IrgrYthshW_116QETHlZonAWF4N3KotrYjLHldeUbHbDaPow7hnSQupdI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQcVQqRwh5r8mgI6cYA6PuSquqraU3D18wGRPd95yvqOA&oe=6B0C5EB4"}, {"file_name": "screenshot_2.png", "id": "1162715346225234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619404_1162715349558567_2624655025354226677_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7C-zLsVniIYQ7kNvwG7_I7s&_nc_oc=AdplRsKVgnoRf1RlaVcwuZrKREYu-8uFgm_6aacvNLxIjqhhmHM9qKCtjMRSWXnhgng&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTrw42dB3NhAQmthvZ4HHNX4wq79nnBOb-jC3gLADTFyg&oe=6B0C50F5"}, {"file_name": "screenshot_3.png", "id": "1005358128601854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624592_1005358131935187_8391633957263609832_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4KD83cO1ikQ7kNvwEt-74p&_nc_oc=AdqGQ776xLF7AiWggGn7TT0TNjTULQ3fySBLTFJYJXNkXH7t6A5TVWcvolUo8Ha4Jz0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSFsGi7m4Ryo0Q53AVKQGnecoBGPmJd-v0rKQ-flJlh7g&oe=6B0C6699"}, {"file_name": "screenshot_4.png", "id": "1141144951738059", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620532_1141144955071392_990237215074270153_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_NmRJPqSnkQ7kNvwFGj2lN&_nc_oc=AdoMmknRUqFPjrfv-xKnsiMxCfxUwIUgrYlQP_6JjoXgP-MQu28i0cr2AgZ5oFB1r8c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQTNctCvpAX40AxI2600nlqg7dBXOXn71rT8XE96JJoZA&oe=6B0C7113"}, {"file_name": "screenshot_5.png", "id": "3467444433435239", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593723055_3467444436768572_1781971624083964435_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Cm-nxhH6uoQ7kNvwHol1zk&_nc_oc=Adrl4Rosfs6GUtez_xGopgDtHgX0loKJ0cZoWjNRaxYIzPoY1oe6-wCdWbC0VeteiNY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR2eQ2q7XIJoOIwcW_etC4IurW4Ye_Z1uTESwL7X9WC-g&oe=6B0C6E81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11_trailer_video_screenshot.png", "id": "1132038326209321", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908839758_1132038329542654_4297905480555898203_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oahIQdID8WwQ7kNvwFdlhL9&_nc_oc=AdrJTxbmiLSdXxqyjBrok2kKVdCfdDHOk-pjzxW9vZSyhLDY3yl-7xnii5bFSkp8Qxk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTn1GR-F7lsbgnrFAr3EGVQ9TSAkrDWsaMY5ndY2stMNA&oe=6B0C5963"}, "display_name": "Tuba", "keywords": ["tuba", "brass", "instrument", "music", "band"], "long_description": "A tuba, in mixed reality.\n\nThe valves use real tuba fingerings, so if you already play, you already know them.\n\nMake it the tuba you play:\n- Top-action pistons, front-action pistons or rotary valves.\n- 3, 4, 5 or 6 valves.\n- With 4, the 4th in the row, or on the side as a compensating valve, as on a British brass band bass.\n- With 5, the 5th on your right thumb or for your left hand.\n- With 6, the 5th and 6th both for your left hand, or the 5th on your right thumb and the 6th for your left hand.\n- A tuba in B\u266d, C, E\u266d or F.\n- Any size from 3/4 to 6/4.\n- With 4 valves or more, each valve on the controller button you like.\n\nPlay with friends online, whichever Fncore instrument they have: Trombone (formerly Trombonest), Trumpet (formerly Trumpeteer), Cello, Tuba, Drum, or Violin and Viola (formerly Violinest).\n\nThe music stand shows you how to play 53 pieces, like Saint-Sa\u00ebns's The Elephant, with the fingering for every note as you go. Ten of them are Christmas carols, from Jingle Bells to O Holy Night. Hear a piece played on your tuba first if you like, then play every note yourself. Nothing is scored.", "short_description": "A mixed reality tuba for Meta Quest. The valves use real tuba fingerings, so if you already play, you already know them. Choose pistons or rotary valves, 3 to 6 valves, and B\u266d, C, E\u266d or F. The music stand shows you how to play 53 pieces, like The Elephant. You play every note yourself, and nothing is scored. Play with friends online, whichever Fncore instrument they have: Trombone (formerly Trombonest), Trumpet (formerly Trumpeteer), Cello, Tuba, Drum, or Violin and Viola (formerly Violinest)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/tuba/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fncore, Inc.", "support_website_url": null, "website_url": "https://fncore.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_int
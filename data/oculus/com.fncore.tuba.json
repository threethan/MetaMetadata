3_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_NmRJPqSnkQ7kNvwEG6tx2&_nc_oc=AdpgDaA64HuySkTU2ZSZBE1AcfJHWBQwnGhKkOXVY5XKIUdH_VwoKthSx3BsFoX-BbU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQfHiQkcTNiuuAy6RRzYeItzmaDpyz1YWYcAnpS5o29Jw&oe=6B0DC293"}, {"file_name": "screenshot_5.png", "id": "3467444433435239", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593723055_3467444436768572_1781971624083964435_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Cm-nxhH6uoQ7kNvwHGtHdi&_nc_oc=AdrxYyptU2ZBD4JlNGtTBetlGJeYPfVmT-Zou140JPAwVW94BlyBCfF_i_IBM2qCyTI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQtpoPmwqKf_HcFJOpGx6rbxu07mG09zWZe3oEE-St7lA&oe=6B0DC001"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11_trailer_video_screenshot.png", "id": "1132038326209321", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908839758_1132038329542654_4297905480555898203_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oahIQdID8WwQ7kNvwHZ7TMJ&_nc_oc=Adr9Ovr8bC2DJ4vL4hKv8-daShEda2kUnCJIpHcWYHhQxCS9PjhSdVuEvRfw37-awTU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTTcOuZIr_5U05wc3UXgOpS623_2vx5RTXDE83ikajaOw&oe=6B0DAAE3"}, "display_name": "Tuba", "keywords": ["tuba", "brass", "instrument", "music", "band"], "long_description": "A tuba, in mixed reality.\n\nThe valves use real tuba fingerings, so if you already play, you already know them.\n\nMake it the tuba you play:\n- Top-action pistons, front-action pistons or rotary valves.\n- 3, 4, 5 or 6 valves.\n- With 4, the 4th in the row, or on the side as a compensating valve, as on a British brass band bass.\n- With 5, the 5th on your right thumb or for your left hand.\n- With 6, the 5th and 6th both for your left hand, or the 5th on your right thumb and the 6th for your left hand.\n- A tuba in B\u266d, C, E\u266d or F.\n- Any size from 3/4 to 6/4.\n- With 4 valves or more, each valve on the controller button you like.\n\nPlay with friends online, whichever Fncore instrument they have: Trombone (formerly Trombonest), Trumpet (formerly Trumpeteer), Cello, Tuba, Drum, or Violin and Viola (formerly Violinest).\n\nThe music stand shows you how to play 53 pieces, like Saint-Sa\u00ebns's The Elephant, with the fingering for every note as you go. Ten of them are Christmas carols, from Jingle Bells to O Holy Night. Hear a piece played on your tuba first if you like, then play every note yourself. Nothing is scored.", "short_description": "A mixed reality tuba for Meta Quest. The valves use real tuba fingerings, so if you already play, you already know them. Choose pistons or rotary valves, 3 to 6 valves, and B\u266d, C, E\u266d or F. The music stand shows you how to play 53 pieces, like The Elephant. You play every note yourself, and nothing is scored. Play with friends online, whichever Fncore instrument they have: Trombone (formerly Trombonest), Trumpet (formerly Trumpeteer), Cello, Tuba, Drum, or Violin and Viola (formerly Violinest)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/tuba/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fncore, Inc.", "support_website_url": null, "website_url": "https://fncore.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_int
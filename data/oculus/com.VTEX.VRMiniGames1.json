w4HVYg9Kg7GXcY9i0ks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeofZNv6WAsxDBM7gQJ1nqoP8iHULoED9vZKlxM6hOwA&oe=6A789BAF"}, {"file_name": "Microsoft Game DVR - VR Mini Games 1 - VLC media player 2_3_2026 11_44_38 PM_2560x1440.png", "id": "2392281294564338", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_2392281297897671_6971378922962519690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryYsyxBzRjQQ7kNvwGszKL0&_nc_oc=AdrOmK71NaJ9y_BamgeMMGTqTpqSgOAG823uYO97gTWX9GHmbCNcPLvn5iNgs_KhXco&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGZ2FhYcd7XCrwukUbCwxw3GyfsH_1T8Yei8YF6y49Jg&oe=6A788F4A"}, {"file_name": "Microsoft Game DVR - VR Mini Games 1 - VLC media player 2_3_2026 11_44_24 PM_2560x1440.png", "id": "921177857058687", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823930_921177860392020_3564645345416041106_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWrDgPcfZ_8Q7kNvwHSngA2&_nc_oc=AdrKR3lSkE_IlhM9TGaF5BX4BftJx0GzFEfI_odI6C4lYFhUvwMgiPmbGz7joYeEH8U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEq68fKGZUbJvPAtnG_onB_BQaUrjstz0py9DE0Gix_3g&oe=6A78823E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vr_mini_games_2560x1440.png", "id": "2307475766410602", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819511_2307475769743935_6136943080975362221_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_olS99V9uksQ7kNvwHWLlnP&_nc_oc=AdqfnpdLrSUVHf14M0XGmlgABVpa4-DqpeE4R1Ge3yIzy9D9zYJSijwqMvg4AbLy08c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2yJO8MCydgZWctj-Vj61ju2zlztH3cqnlEGEUOli07Q&oe=6A78786F"}, "display_name": "VR Mini Games 1", "keywords": ["bowling", "dart", "archery", "shooting", "basketball"], "long_description": "Step into a world of fun and challenge with this all-in-one VR mini-games collection, designed to deliver hours of immersive entertainment. Experience five unique and skill-based games that put your accuracy, timing, and reflexes to the test in virtual reality.\n\n\ud83c\udfb3 Bowling \u2013 Line up your shot, control your throw, and aim for the perfect strike in a realistic VR bowling experience.\n\ud83c\udfaf Darts \u2013 Test your precision and steady hand as you compete for high scores on the dartboard.\n\ud83d\udd2b Shooting \u2013 Sharpen your reflexes and accuracy in an exciting shooting challenge built for VR immersion.\n\ud83c\udfc0 Basketball \u2013 Practice your aim and shooting technique as you sink baskets and beat your personal best.\n\ud83c\udff9 Archery \u2013 Feel the tension of the bow, focus on your target, and release with perfect timing.\n\nEach mini-game is easy to learn yet rewarding to master, making it ideal for both casual players and competitive VR fans. Whether you\u2019re looking for quick play sessions, skill-based challenges, or fun party experiences, this VR mini-games collection delivers engaging gameplay and immersive controls every time.", "short_description": "Enjoy five fast-paced VR mini-games in one immersive experience!\nTest your aim and skills in Bowling, Darts, Shooting, Basketball, and Archery.\nEasy to pick up, fun to master\u2014perfect for quick sessions or friendly competition in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://v2tex.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "VTex", "support_website_url": null, "website_url": "https://v2tex.weebly.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "reco
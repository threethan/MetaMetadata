_272921140987967_3144135430909545745_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVHvywLtDNYQ7kNvwEfh0tI&_nc_oc=AdnW7qwQ6iWg3oEee8L3N1JccwVBsPQlkou67Gcvc1ENc9NbzUp0Kpy8eCneSFUmveM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsVrdgLtu9m40uUlF-l8JH-fuuJ0erS2PlgPWAwSiDxnw&oe=699846F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art1.png", "id": "212212434213279", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566679_212212437546612_2205253820679213738_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oo02gOetR3YQ7kNvwFrzuDP&_nc_oc=AdnH-dadINczmVskGPBpGPXXKNmyV2bT7peNvOb-UJzy52D9DZyX_K1oiYQ6y_eKRcM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftzY8rVB06pE5DbJwlCVWhtq2GvR61fFG1BsRw0VeN6JQ&oe=6998520D"}, "display_name": "J\u00e4mtland Tent Experience (Adventure 63)", "keywords": [], "long_description": "Experience how it would be like to wake up in a tent and see the nature outside in J\u00e4mtland Sweden.\nThe available locations are \u00c5reskutan, \u00c5nn Lake, Storulv\u00e5n and Gustavsbergsbacken in \u00d6stersund.\nFeel the peacefulness of living in nature and admire the environment.", "short_description": "Experience the camping life, wake up in nature and admire the peacefulness.\nVisit \u00c5reskutan, \u00c5nn Lake, Storulv\u00e5n and Gustavsbergsbacken in \u00d6stersund.\nSee how it would be if you were to camp at those locations, how it would feel like to wake up and see the nature outside your tent."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.virtuelldesign.se/upload/GDPR_virtuelldesign.pdf", "developer_terms_of_service_url": null, "publisher_name": "Virtuell Design AB", "support_website_url": null, "website_url": "https://www.adventure63.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type"
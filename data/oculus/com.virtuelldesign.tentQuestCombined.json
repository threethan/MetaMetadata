-1.oculuscdn.com/v/t64.5771-25/57566679_212212437546612_2205253820679213738_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1LSjh4GpT0wQ7kNvwF_CnMR&_nc_oc=Ado6b8JkcmZ6AMaWFNrJ1dyGEPbvA0p6TbeiiovZXveIUuwLFmHuQcs91SuGYPF3_So&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfhJD8pYSt4c8jSGcrByoD7fR1msIkirABSbkmFynOBw&oe=6B01C54D"}, "display_name": "J\u00e4mtland Tent Experience (Adventure 63)", "keywords": [], "long_description": "Experience how it would be like to wake up in a tent and see the nature outside in J\u00e4mtland Sweden.\nThe available locations are \u00c5reskutan, \u00c5nn Lake, Storulv\u00e5n and Gustavsbergsbacken in \u00d6stersund.\nFeel the peacefulness of living in nature and admire the environment.", "short_description": "Experience the camping life, wake up in nature and admire the peacefulness.\nVisit \u00c5reskutan, \u00c5nn Lake, Storulv\u00e5n and Gustavsbergsbacken in \u00d6stersund.\nSee how it would be if you were to camp at those locations, how it would feel like to wake up and see the nature outside your tent."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.virtuelldesign.se/upload/GDPR_virtuelldesign.pdf", "developer_terms_of_service_url": null, "publisher_name": "Virtuell Design AB", "support_website_url": null, "website_url": "https://www.adventure63.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes":
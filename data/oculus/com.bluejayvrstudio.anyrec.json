kg&oe=6AFDC64B"}, {"file_name": "3.png", "id": "1226239101668148", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035421_1226239105001481_6374634989077934873_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vrn-XowvZl8Q7kNvwFqMwUv&_nc_oc=Adq-Xt31zIEDGnKaQWKD5HokxXwxxeIEkroUQe7WeYdlwKc2Grtkh3k4NHmZdLku3n8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoXY7uI8O9ysENmIica3KqYn_ZwQWLOk0as56uaKCQ_A&oe=6AFDBE53"}, {"file_name": "4.png", "id": "937000821144297", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566697_937000824477630_7834753047034094949_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FPVBHTHDEIQ7kNvwH6uPuV&_nc_oc=Ado8jbS0oDKj40S3AXodeeqmW9rQFfuwCPfRHbow-e5Ad7XvuuxzXT_s6R0MH9IKo0g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWL8EaNIghwyipus0jhkGzOImXzBmiygP4Cx_WwY3hPA&oe=6AFDB307"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1817782692167481", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619836_1817782695500814_1956221623104736519_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTRKP49izlkQ7kNvwGoD3IT&_nc_oc=Adqo6DRP6HGeP1BhF5o6VRwhIdzSfsfGCvzWZFoB6cFz4JNZmNgkfELR-tCQ9lv2p_A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQveSYewZ5ku7mxpJKB4ujeWmNGLlr2udvf75dC4c94fA&oe=6AFDB694"}, "display_name": "BlueJayVRStudio's Infinite MR Arcade", "keywords": ["tabletennis", "foosball", "airhockey", "colocated"], "long_description": "Build your own arcade in Infinite MR Arcade, a mixed reality sandbox for Meta Quest. Play table tennis, foosball and air hockey against AI opponents, or enjoy local multiplayer with friends and family in the same room.\n\n{1397521364782082}\n\n# Sports and AI opponents\n\n- Table tennis: Challenge AI across 100 difficulty levels, with automatic match scoring and serve changes.\n- Foosball: Play first-to-seven matches with automatic scoring. Bots receive and pass the ball, and attempt angled shots and bank shots.\n- Air hockey: Play against AI with a score system and digital clock.\n\nPractice pool, basketball and darts at your own pace.\n\n# Build your arcade\n\nSpawn and arrange multiple tables and equipment. Decorate with furniture, build sculptures with colorful shapes, experiment with physics and save your layout. No preset item cap; practical capacity depends on your headset and scene.\n\n# Colocated local multiplayer\n\nPlay in the same physical space on the same local network (LAN). Each player needs a compatible Meta Quest headset. Custom networking is designed to minimize latency. Remote online multiplayer is not supported.\n\n# Planned AI additions\n\nAI opponents for darts, basketball, pool and other activities are planned for the near future.\n\n{562835183535625}\n\n{1406939197116708}\n", "short_description": "Build your own arcade in Infinite MR Arcade, a mixed reality sandbox for Meta Quest. Play table tennis, foosball and air hockey against AI opponents. Table tennis offers 100 difficulty levels and automatic scoring. Spawn tables and equipment with no preset item cap, decorate, build with colorful shapes and save layouts. Play solo or enjoy local multiplayer in the same room over LAN. Pool, basketball and darts are playable now, with AI for these and more planned for the near future.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bluejayvr.studio/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "BlueJayVRStudio", "support_website_url": null, "website_url": "https://bluejayvr.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
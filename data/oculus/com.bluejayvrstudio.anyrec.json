WhoU1bFTMinFRWN2wX4oqynND2eugEdMeOK5xf1X8iu9gtxCg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfkog5HmuDbhwMlDiS2FfME7NrO_aMTq5-BgMJYWqibA&oe=6A68912A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1403825993899119", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75388630_1403825997232452_2296020040844857761_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=728IKr3t2gcQ7kNvwEOcC2P&_nc_oc=AdqyjJnreKDLBukIJ4MmYWe4O-_jbCj6q6g_1gpQ_VpONcfFaW_jL_aeqjelGdK1PDo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAe7eO8x3jiL2i_48Bf80yILCi9gIBCGrY7_R0-I_g-A&oe=6A68C207"}, "display_name": "AnyRec", "keywords": [], "long_description": "Immerse yourself in the world of Mixed Reality with AnyRec! Transform your room or living space by adding virtual furnishings to create the perfect ambiance. Unleash your creativity by crafting whimsical or adorable sculptures using a palette of vibrant shapes. Engage in lifelike leisure activities, including basketball and darts, with our hyper-realistic recreational equipment*. Plus, AnyRec's spatial memory feature ensures that your space remains exactly how you left it upon your return. Get ready for the ultimate Mixed Reality experience with AnyRec!\n\n* Early Access - Please note, a highly anticipated addition, the virtual pool table, is currently under development.", "short_description": "Decorate, create and play in Mixed Reality! In AnyRec, you can customize your rooms with furnishings, create whimsical or adorable sculptures with various colorful shapes, or play with hyper-realistic recreational equipment* such as basketball or darts. Once the room is saved, you can expect to come back to it exactly as you left it. Get ready for the ultimate Mixed Reality experience with AnyRec!\n\n* Pool table is currently in development"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bluejayvr.studio/privacy-policy/", "develope
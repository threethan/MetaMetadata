v32_mIRcO5iXbAUIQZt-qU2LVrZtEd7z-A6tOa1HUTkD6ufBcqwA-ZY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvL01zj8sxv3tkUQhL7n0_OlbZB6DKDM9VcCcc8q6Xaw&oe=6AA41CEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1403825993899119", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75388630_1403825997232452_2296020040844857761_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eG0jeZVlg7gQ7kNvwHXILUH&_nc_oc=AdrXs-g-548tcpsKqMynCuzQ9B3LZZtD_u2hmfAuBmxaQlmJzKOIdNLjUt7FOlWkBrc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDERYX-h0n2jwgkUqYWQslGMnO-TRLGzmY2POOEtAVRQ&oe=6AA41587"}, "display_name": "AnyRec", "keywords": [], "long_description": "Immerse yourself in the world of Mixed Reality with AnyRec! Transform your room or living space by adding virtual furnishings to create the perfect ambiance. Unleash your creativity by crafting whimsical or adorable sculptures using a palette of vibrant shapes. Engage in lifelike leisure activities, including basketball and darts, with our hyper-realistic recreational equipment*. Plus, AnyRec's spatial memory feature ensures that your space remains exactly how you left it upon your return. Get ready for the ultimate Mixed Reality experience with AnyRec!\n\n* Early Access - Please note, a highly anticipated addition, the virtual pool table, is currently under development.", "short_description": "Decorate, create and play in Mixed Reality! In AnyRec, you can customize your rooms with furnishings, create whimsical or adorable sculptures with various colorful shapes, or play with hyper-realistic recreational equipment* such as basketball or darts. Once the room is saved, you can expect to come back to it exactly as you left it. Get ready for the ultimate Mixed Reality experience with AnyRec!\n\n* Pool table is currently in development"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bluejayvr.studio/privacy-policy/", "d
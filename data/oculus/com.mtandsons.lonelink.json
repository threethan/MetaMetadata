cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DDT0TTG-EgQ7kNvwEY7DgI&_nc_oc=AdocKt1-N-jxH6lAAK1iWgm_z5tcSpIgRLIXkjL0aY1z6xSRV6UKXZddvxtM5XQVcRQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQT5Ztubagc6PeoFpSEzQwlgy2bqj1Ms8_l_qhByfdNmQ&oe=6B0DBC47"}, {"file_name": "screenshot2.png", "id": "1411582317094659", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823259_1411582320427992_592044886641554841_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLaWfWEc1csQ7kNvwFYQapI&_nc_oc=AdpgAUboCCCSEL4pJOSmeGVRrC8ajbjnUFjQslBSaibGjSRVz3_wL_2Jm_LtIhSoJGs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRa8kWUF4_BS8q-oArYxUQe9aOzMrbJQ4-r-JeKvHBWig&oe=6B0DCA0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2631981080605211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_2631981083938544_4537475302819251261_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozDmRiK-KOsQ7kNvwHSwbnQ&_nc_oc=AdrFJasVdnIvh6lUPki1Ct6gQ1NILXoMgAVjCxaLrmEbPaRbNGy6FhCsYTZ6B8CfobI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRqLCbD-PLvxDK-3ALZ8NNvJ-Iw29kKhsp_6Lnz5pcyXQ&oe=6B0D9CE3"}, "display_name": "Lone Link", "keywords": ["shooter", "arcade", "shmup", "space", "fitness"], "long_description": "Lone Link is a VR arcade shooter in the spirit of classic vertical space shooters.\n\nYour ship follows your hand. Move it to dodge the swarm, push it forward and pull it back to dive into the fight or retreat, and let the auto-cannon do the shooting. Fight through 50 waves of enemy fleets, asteroid fields and four giant bosses to reach the final flagship, then keep going in Endless mode.\n\n\u2022 Two ways to play: ARCADE (your ship takes the hits) and FITNESS (the bullets are aimed at YOU - dodge with your whole body)\n\u2022 Three difficulties that change how weapons are collected and upgraded\n\u2022 Special weapon chips: homing missiles, laser beam, energy wave, reflector shield and a time-slowing field - catch the same chip again to upgrade it and trigger a powerful bonus\n\u2022 Power-ups: weapon levels, shields, rapid fire, extra lives and screen-clearing bombs\n\u2022 Elite enemies, asteroid fields and a four-phase boss campaign with a final flagship in three phases\n\u2022 Left-handed option, local high scores for each mode, original synth-rock soundtrack\n\nStand or sit, stay in the middle of your play space and have fun.", "short_description": "Arcade space shooter for VR: steer your ship by hand, dodge fire and take down the flagship."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mikemor76.github.io/lonelink/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "MT and sons", "support_website_url": null, "website_url": "https://mikemor76.github.io/lonelink/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1299984686537226"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1480076250841955"}]}, "baseline_offer": {"id": "1480076250841955"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791913020, "status": "PUBLISHED", "id": "1480076250841955"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidB
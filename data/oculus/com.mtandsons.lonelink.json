c_oc=AdryPzpV20rcsnIVtE4N7S_4xJRnVqCWzJzi9p3XJ4diHSbJMYt0sdTJV83XV9thS64&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREet-7aQFm65Q7OtakEIXAs9jKRYVsc8LGzhL4F0Ni5w&oe=6AFB3BF0"}, {"file_name": "screenshot1.png", "id": "961367426411342", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825462_961367429744675_3252946470243666350_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Zih-fNONHYQ7kNvwEkD9qi&_nc_oc=Adq7ufDqY-FJtu4WQVJ0uIMGNTQzXYsXZRYMVSS2nWqf6i6CYV56A2VrIaEzBgQZT1Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAwbhJWOT_327e9Tf7JvHC-_8Dr0KRBvHmwymdjp7Yrw&oe=6AFB4747"}, {"file_name": "screenshot2.png", "id": "1411582317094659", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823259_1411582320427992_592044886641554841_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wXfKj-hdHUQ7kNvwH5OH5T&_nc_oc=AdqvcVQV9SVdbnlkQHV3Ke9QPw5GGXII18RUwrBRXnM8M0QMKGYHjHb0vc75qVhu6VA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjVoeukvyUwUBFFwBHUKyZGawM9-aEodABbbk5xN9Y9Q&oe=6AFB1CCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_new_2560x1440.png", "id": "1097421869742456", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823279_1097421873075789_6040828962718352785_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_i5ajy6IlIoQ7kNvwEXKgsD&_nc_oc=Adoo1Nc290fNIXG_sZYi0Kya4l-XX3_Cxiq_F4ZVeELEuC4qjdKwasCmWWk7VIltmtE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWIz6WhSXkYZyzps-HTdzoM0PEIb2sq1gb2UyveQBgjQ&oe=6AFB3CB4"}, "display_name": "Lone Link", "keywords": ["shooter", "arcade", "shmup", "space", "fitness"], "long_description": "Lone Link is a VR arcade shooter in the spirit of classic vertical space shooters.\n\nYour ship follows your hand. Move it to dodge the swarm, push it forward and pull it back to dive into the fight or retreat, and let the auto-cannon do the shooting. Fight through 50 waves of enemy fleets, asteroid fields and four giant bosses to reach the final flagship, then keep going in Endless mode.\n\n\u2022 Two ways to play: ARCADE (your ship takes the hits) and FITNESS (the bullets are aimed at YOU - dodge with your whole body)\n\u2022 Three difficulties that change how weapons are collected and upgraded\n\u2022 Special weapon chips: homing missiles, laser beam, energy wave, reflector shield and a time-slowing field - catch the same chip again to upgrade it and trigger a powerful bonus\n\u2022 Power-ups: weapon levels, shields, rapid fire, extra lives and screen-clearing bombs\n\u2022 Elite enemies, asteroid fields and a four-phase boss campaign with a final flagship in three phases\n\u2022 Left-handed option, local high scores for each mode, original synth-rock soundtrack\n\nStand or sit, stay in the middle of your play space and have fun.", "short_description": "Arcade space shooter for VR: steer your ship by hand, dodge fire and take down the flagship."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mikemor76.github.io/lonelink/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "MT and sons", "support_website_url": null, "website_url": "https://mikemor76.github.io/lonelink/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"
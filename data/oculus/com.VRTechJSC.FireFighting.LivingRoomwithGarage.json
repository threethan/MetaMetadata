_4447919805736856397_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdi-99RuijMQ7kNvwEWDVtn&_nc_oc=AdqB_0Yw7icFJe7ZE894Yp4RbCNS_eGcVAaQ-nD3o87ArESEYYhlsIuD0sRz7goBOiE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSyxpak9d5ZK21Vq7ln1qKQ0v2koZdSljNRTHYU_p9quw&oe=6B0DA633"}, {"file_name": "Screenshots_5.png", "id": "561427996974347", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819517_561428000307680_6573575577323356060_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-Z_lMMvIGMQ7kNvwEDBf8D&_nc_oc=AdpIriy97E2_tKVz3b8YiMbHbJ8Or8Ib1gBmzgWvYZGCpZk-9RU_heeVS4Z9y4fLjvI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQlu9BylWHHt0gZ3kiFmWllNwViVuheA2gDRo2cPDyCiA&oe=6B0DA802"}, {"file_name": "Screenshots_2.png", "id": "1218385999627857", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821026_1218386002961190_428945749051623964_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWIYwfMpk2QQ7kNvwEjOYGC&_nc_oc=AdpbglJwtjYzv60fKWz7mbriTabETC_XqSGz5e9j7ULbtAD7yhYwQuiQ2PcDuMtAKVs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTLNbDFPs1XOLx9-YB_LAEWwCofqO4ypgPQJXoVJUj5xg&oe=6B0DA8B5"}, {"file_name": "Screenshots_3.png", "id": "1865381054004752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819388_1865381057338085_3083123583810098376_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u37hkZ5KiogQ7kNvwFXLkEI&_nc_oc=AdqpFy9EETejwM5rvIu0DdVBbSRu7zDEwggbxZadqP5Bhkjr6ACuFOiX0bVSOsLigSk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQmtSj1OJp_Rqx757227MFbGze18R_zlYohg2CCDZ5zgw&oe=6B0DB7A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3992609814388470", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392144_3992609817721803_2047291426087917594_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtoKgcajy3UQ7kNvwFc2I0s&_nc_oc=Adp2yA1lVVsJiIRaSHpymQCdrx5lpyShcZNz1bEyKdrGc0FE_weR2YjyXhZQt8p2VC0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTUlxSahPPAdfeeTZ1fEAllStc0yudbg2wSmf1q3WxbjQ&oe=6B0DCBA9"}, "display_name": "Fire Fighting: Living Room with Garage", "keywords": ["training", "fire", "extinguishers", "rescue", "learning"], "long_description": "Fire Fighting: Living Room with Garage is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter tasked with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles.\nGameplay Overview: Players start in a virtual office where a fire breaks out\u2014caused by electrical faults, paper clutter, or chemical spills. The objective is to assess the fire type (e.g., Class A for paper/wood, Class B for flammable liquids, or Class E for electrical fires) and choose the appropriate extinguishing tool. Using VR controllers, players grab tools from a nearby safety station and operate them to put out the fire while racing against time. Visual cues, like smoke color and fire intensity, guide decision-making. Mistakes, such as using water on an electrical fire, trigger feedback and a chance to retry, reinforcing learning.", "short_description": "Fire Fighting: Living Room with Garage is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter task with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game focusing on the use of water extinguishers, CO
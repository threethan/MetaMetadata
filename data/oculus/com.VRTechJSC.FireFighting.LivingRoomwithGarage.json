Zs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClAqhSdJFIrQKKxWzOSNbMM4VjlxIbRzZ72NFHIgeSXw&oe=6A620CC2"}, {"file_name": "Screenshots_2.png", "id": "1218385999627857", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821026_1218386002961190_428945749051623964_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uG_W61lIvO8Q7kNvwGWQuwG&_nc_oc=AdrsQNwQrZ4qYPN028hQQY9QlwYyNupJDmjMLYRF3xlUDGfzmnJ3FKd1fsyIBaL2I84&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgeeOasIjSRfxJo4iBnLIyQMsO31MCUleBeyWdoaV5jQ&oe=6A620D75"}, {"file_name": "Screenshots_3.png", "id": "1865381054004752", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819388_1865381057338085_3083123583810098376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLwyEoLsCpgQ7kNvwF57Z9Z&_nc_oc=Adq5W_YikIIiDSWq9dlEEnVkufwKMCYzaFrduhJh9d_WLD7_A9YS4T_2c9CoHsPbZ9I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAy38jxFMwTbmF9zTNX2Al5XNOFOwaaXrGA0lcZ-YuEmg&oe=6A621C64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3992609814388470", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392144_3992609817721803_2047291426087917594_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cTCSvfYnNoQ7kNvwFq9Y6b&_nc_oc=AdqpfndR8Shq75aeev8asWNoZ9EiiQwpct936QFcJEtc1JSqJZA6sf7zpmLJhuzFiZs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQ-pDMpyJDKMeYmQ-LeyscnM5rPZ-nUdtfmY3dxRnc0Q&oe=6A623069"}, "display_name": "Fire Fighting: Living Room with Garage", "keywords": ["training", "fire", "extinguishers", "rescue", "learning"], "long_description": "Fire Fighting: Living Room with Garage is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter tasked with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles.\nGameplay Overview: Players start in a virtual office where a fire breaks out\u2014caused by electrical faults, paper clutter, or chemical spills. The objective is to assess the fire type (e.g., Class A for paper/wood, Class B for flammable liquids, or Class E for electrical fires) and choose the appropriate extinguishing tool. Using VR controllers, players grab tools from a nearby safety station and operate them to put out the fire while racing against time. Visual cues, like smoke color and fire intensity, guide decision-making. Mistakes, such as using water on an electrical fire, trigger feedback and a chance to retry, reinforcing learning.", "short_description": "Fire Fighting: Living Room with Garage is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter task with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "re
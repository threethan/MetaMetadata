_4447919805736856397_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDlc5eGbjm4Q7kNvwHAVUrw&_nc_oc=AdrKyjtAPGXecTfGXsLuTd8mivi5tZ84E_jPsjRzhv2mo5N0zIHVwVHkv1YEdQASdiw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWhV8rprkbXLwQvuXxserIXnyzX2qLFBFCVQQ9YF7QZdg&oe=6B0EF7B3"}, {"file_name": "Screenshots_5.png", "id": "561427996974347", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819517_561428000307680_6573575577323356060_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfR3HwBE2Z0Q7kNvwHXNw1t&_nc_oc=AdqrJf8_hw880hKTkBp50JVCxllIy1cLa0Dy9GzQMxKDVz9DNYrsumKRpmXQ596EWfw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWwSZ4RCyITuDs49l718JAKGWZMEcdu4URwrcpTR-hxSQ&oe=6B0EF982"}, {"file_name": "Screenshots_2.png", "id": "1218385999627857", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821026_1218386002961190_428945749051623964_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWIYwfMpk2QQ7kNvwEMiUxa&_nc_oc=AdpFGpVlBYIGiaHIHmfLfu8QpL7WtRKTa0gR59ndgg79VccTZWT0BBUeaqd2HuAyaIg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVcGl4JFxHiNMUmesdNAHsEisYuzLjl524MFxMwpPPzhw&oe=6B0EFA35"}, {"file_name": "Screenshots_3.png", "id": "1865381054004752", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819388_1865381057338085_3083123583810098376_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u37hkZ5KiogQ7kNvwFAIPJE&_nc_oc=AdqNfU9m32sfAY9RgeKtSBflVFczgu7tpSW4PeQ2ccXP10toVsPpc7SjQr77rNshv40&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWx0ZLotYM6zIQ8gXylbijQKigrSO_dbFMHDZ9TUwiEjA&oe=6B0F0924"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3992609814388470", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392144_3992609817721803_2047291426087917594_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtoKgcajy3UQ7kNvwEUBrjO&_nc_oc=AdpyJnk_TxMi8rMHUallCX_Cm3a_EwY0TSQF8cESPpUT8xT7njofRSWIV5GaAfpNMA0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVmq_UpV-gv6Xbo37xxCNMSj2iy9Rj2hLv2mU2PzQ-JLw&oe=6B0F1D29"}, "display_name": "Fire Fighting: Living Room with Garage", "keywords": ["training", "fire", "extinguishers", "rescue", "learning"], "long_description": "Fire Fighting: Living Room with Garage is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter tasked with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles.\nGameplay Overview: Players start in a virtual office where a fire breaks out\u2014caused by electrical faults, paper clutter, or chemical spills. The objective is to assess the fire type (e.g., Class A for paper/wood, Class B for flammable liquids, or Class E for electrical fires) and choose the appropriate extinguishing tool. Using VR controllers, players grab tools from a nearby safety station and operate them to put out the fire while racing against time. Visual cues, like smoke color and fire intensity, guide decision-making. Mistakes, such as using water on an electrical fire, trigger feedback and a chance to retry, reinforcing learning.", "short_description": "Fire Fighting: Living Room with Garage is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter task with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game focusing on the use of water extinguishers, CO
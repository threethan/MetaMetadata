b=1-7&_nc_sid=6e7a0a&_nc_ohc=60aqXpSd1V0Q7kNvwGNe2jN&_nc_oc=AdphZM2jvoNv6kF3JXsdn5iLCsJrPi7aXyjXu9E5oiTcHp44NM-ZXTXFBBZWk7A38V4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCpb5X78yA2LNZZYxDExC-ntLNuQUfCqwBjOJzKjIKJg&oe=6ACE6002"}, {"file_name": "Screenshots_2.png", "id": "1218385999627857", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821026_1218386002961190_428945749051623964_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2O8AJ7BSxsQ7kNvwFpo4R5&_nc_oc=AdqFBDXgUF1SIh68qb7PAXOFze7NuybIELwK02GQuIqyN3hoJs7EKGkHN7whgu1Po0g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPY3p-ZtGYcEMwqhI_VDZsjTywrCj1pgGXqYPzn9d3a2A&oe=6ACE60B5"}, {"file_name": "Screenshots_3.png", "id": "1865381054004752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819388_1865381057338085_3083123583810098376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPs60-DeNQUQ7kNvwHnrdyh&_nc_oc=Adq6KjfN16Y54nQGfBMuk7CZ7EevVkrOQ0i7dNxBtD0LtP8ykgef_aDnGqr7Cq9Evjs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsaHBnV5q3yM4MxxEmKMwr4cTgFEmBIVkrl5Jw-b4yHA&oe=6ACE3764"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3992609814388470", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392144_3992609817721803_2047291426087917594_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZ2i_7W3oQkQ7kNvwEeUHWW&_nc_oc=AdpWGAO4uCTD0EuVzAoOqfNkTh8shgt9f1PTeJroYEQW7AVmg7LgW_o5_6qHeYwW19Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKRAujZE6aHQuFQO5u2UfkTa3a9kBgxOLv66GZmFW-lQ&oe=6ACE4B69"}, "display_name": "Fire Fighting: Living Room with Garage", "keywords": ["training", "fire", "extinguishers", "rescue", "learning"], "long_description": "Fire Fighting: Living Room with Garage is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter tasked with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles.\nGameplay Overview: Players start in a virtual office where a fire breaks out\u2014caused by electrical faults, paper clutter, or chemical spills. The objective is to assess the fire type (e.g., Class A for paper/wood, Class B for flammable liquids, or Class E for electrical fires) and choose the appropriate extinguishing tool. Using VR controllers, players grab tools from a nearby safety station and operate them to put out the fire while racing against time. Visual cues, like smoke color and fire intensity, guide decision-making. Mistakes, such as using water on an electrical fire, trigger feedback and a chance to retry, reinforcing learning.", "short_description": "Fire Fighting: Living Room with Garage is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter task with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": 
rY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEcZI9bSaRaCt2wnZhCwWb5RpbuoBa65kV7VrfQh6wRg&oe=6A81B0C2"}, {"file_name": "Screenshots_2.png", "id": "1218385999627857", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491821026_1218386002961190_428945749051623964_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GmwFU2fAkMQ7kNvwHgQwhu&_nc_oc=AdoQlHtilyTrBfBER8ZuKUHEhdQc2JUDMFXcyuQGNvtvhtRJcGswuO7cGVsbrnGMGds&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2EkmUhN2HnYfxedKFSzxSJrvpYDUCduGAZ5eJomm0hQ&oe=6A81B175"}, {"file_name": "Screenshots_3.png", "id": "1865381054004752", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819388_1865381057338085_3083123583810098376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vITh5FqKxwQ7kNvwHi-UFA&_nc_oc=AdooPRGzPKem0EIfBIRhNI9KJ0gnIAdF05rWmyhGnmJaZQwyewf0sxfUxBV3vE2Wl6k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzzq_-Z0vtjxoAJ8b9zVTfL9nQSYo5MJ4l0LIb31jgag&oe=6A81C064"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3992609814388470", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392144_3992609817721803_2047291426087917594_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRC9UYoGSQsQ7kNvwHJizVc&_nc_oc=AdpqayZz9BR2EfaGhgw5WdN45_W8Cvu82NxuooJgvNXrstUfkF7hkK2Qzd3Inp7R_XU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiP1MRENKsxbOXe_-zeaH2apVjuIlGjkhFihBPuUWtUg&oe=6A819C29"}, "display_name": "Fire Fighting: Living Room with Garage", "keywords": ["training", "fire", "extinguishers", "rescue", "learning"], "long_description": "Fire Fighting: Living Room with Garage is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter tasked with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles.\nGameplay Overview: Players start in a virtual office where a fire breaks out\u2014caused by electrical faults, paper clutter, or chemical spills. The objective is to assess the fire type (e.g., Class A for paper/wood, Class B for flammable liquids, or Class E for electrical fires) and choose the appropriate extinguishing tool. Using VR controllers, players grab tools from a nearby safety station and operate them to put out the fire while racing against time. Visual cues, like smoke color and fire intensity, guide decision-making. Mistakes, such as using water on an electrical fire, trigger feedback and a chance to retry, reinforcing learning.", "short_description": "Fire Fighting: Living Room with Garage is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter task with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "re
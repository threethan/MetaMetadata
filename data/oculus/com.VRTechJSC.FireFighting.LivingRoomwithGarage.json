b=1-7&_nc_sid=6e7a0a&_nc_ohc=ZjEJqZioBOYQ7kNvwGch5Eq&_nc_oc=Adp4yDfpw4Jn_PWnsSaEsoYeB7qinH21f0nfVl9i3IlhHClnlcGVmAQs8rKNvhYaack&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5lXyroizAPzltYgAPBfddFvTm_XDdqdziIkr0twAL3Q&oe=6AC28282"}, {"file_name": "Screenshots_2.png", "id": "1218385999627857", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821026_1218386002961190_428945749051623964_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RO-VCgN4BkwQ7kNvwHyAIZv&_nc_oc=Adp9gU8xjZibXgSdNCqeekUsP9Wu5O3DqEfIQSSEA0NeXiTd0jj5eG92bzqxNOM4Gk8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcBVtIkLfTwt3A2Ly56KisiFTV0YtnNm0dgYKiT2CpHw&oe=6AC28335"}, {"file_name": "Screenshots_3.png", "id": "1865381054004752", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819388_1865381057338085_3083123583810098376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMGMGF_lW-YQ7kNvwGYx5iB&_nc_oc=AdrjSQhQcsGYZ6kr-e2ApG_SN2sPZFEp2NE7PcJqGMFbCGBJeu6fwFa18M8B9W2QDuU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM725XB-jBRs02opOgXhAlNL-IjGgOlFFoWljmrxBNbqA&oe=6AC259E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3992609814388470", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392144_3992609817721803_2047291426087917594_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SfeadZL2l40Q7kNvwEisT0S&_nc_oc=AdoFuoEkzGEJty-Z664kPZcDk48jBis2c7DPGU5PD5mBsvYxuR5CIOy-f1-n_aJ9ZS4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcnWMfhlFvC7bM6D9lbW_1buMjP-VT9LNf8uALXYulWg&oe=6AC26DE9"}, "display_name": "Fire Fighting: Living Room with Garage", "keywords": ["training", "fire", "extinguishers", "rescue", "learning"], "long_description": "Fire Fighting: Living Room with Garage is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter tasked with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles.\nGameplay Overview: Players start in a virtual office where a fire breaks out\u2014caused by electrical faults, paper clutter, or chemical spills. The objective is to assess the fire type (e.g., Class A for paper/wood, Class B for flammable liquids, or Class E for electrical fires) and choose the appropriate extinguishing tool. Using VR controllers, players grab tools from a nearby safety station and operate them to put out the fire while racing against time. Visual cues, like smoke color and fire intensity, guide decision-making. Mistakes, such as using water on an electrical fire, trigger feedback and a chance to retry, reinforcing learning.", "short_description": "Fire Fighting: Living Room with Garage is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter task with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": 
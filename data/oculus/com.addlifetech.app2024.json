WLq8thQSrGlag&oe=6AF49C19"}, "display_name": "Mind Body Life", "keywords": ["rehabilitation", "exercise", "mobility", "relaxation", "ageing"], "long_description": "Discover a healthier, happier you with Mind Body Life by Add-Life.\nOur platform provides simple daily activities designed to inspire movement, improve mental health, and support independent living.\n\nMind Body Life also empowers you to track your progress with precise measurements of arm reach, wrist, and hand movements. These insights are invaluable for those in rehabilitation or aged care, offering mobility reports that help clinicians and families plan for current and future needs.\n\nRelaxing activities reduce stress, boost neuroplasticity, and make exercise both enjoyable and memorable, helping you stay motivated every day.", "short_description": "Mind Body Life \u2013 A platform built for Better Mental Health, Physical Recovery, and Independent Living with easy, fun activities and mobility analysis."}]}, "developer_name": "Add-Life Technologies One Pty Ltd", "developer_privacy_policy_url": "https://www.add-life.info/privacy-policy", "developer_terms_of_service_url": "https://www.add-life.info/terms-of-service", "publisher_name": "Add-Life Technologies One Pty Ltd", "support_website_url": "https://www.add-life.info/contact", "website_url": "https://www.add-life.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes
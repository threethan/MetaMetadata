file_name": "Mind-&-Body-Screenshot-2026-BUBBLES-2560x1440.png", "id": "954955074320260", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620599_954955077653593_4040559750000780881_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWdG7f1dPI8Q7kNvwFW_WJK&_nc_oc=AdotRDQmMX5l1JtQdt0YHzlgysJXdZn99A6N3-RtBsUh3BCyYL1bH8aUam4LEyHTIGI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSv1TjFyBMBqH7XQvf3OcL4_AwCIehMLm-NwvjP45CKKw&oe=6AEB49E7"}, {"file_name": "Mind-&-Body-Screenshot-2026-BOXING-2560x1440.png", "id": "1098681945987055", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620316_1098681949320388_809024157050844970_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1b8Ig_wTikQ7kNvwEd5xcb&_nc_oc=AdoyRPwu2UpMNoB_Qe-pnqVD4ZuqvU7A7X_u7YkhPYrzPjBJQzakawElBRclVGgYQJU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1nYqh6sYxOSrH8ZMHx3wAcUs6y4UNVatu3ZWsHJibDQ&oe=6AEB459A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image for video Mind Body Life.png", "id": "1802592654108613", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628067_1802592657441946_606148062685932100_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0ajq4DstgEQ7kNvwH2WnUz&_nc_oc=Adp52lyjp_2Hp0unFq4c492n0I6LusznCFwG2b6ZH_JJvHBjtqEZf_dDBL7jNZagpdI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHTxTeGpfW1VDQ4F3vnxYw8nsfeFOmenl9OLDOH3KAzQ&oe=6AEB6199"}, "display_name": "Mind Body Life", "keywords": ["rehabilitation", "exercise", "mobility", "relaxation", "ageing"], "long_description": "Discover a healthier, happier you with Mind Body Life by Add-Life.\nOur platform provides simple daily activities designed to inspire movement, improve mental health, and support independent living.\n\nMind Body Life also empowers you to track your progress with precise measurements of arm reach, wrist, and hand movements. These insights are invaluable for those in rehabilitation or aged care, offering mobility reports that help clinicians and families plan for current and future needs.\n\nRelaxing activities reduce stress, boost neuroplasticity, and make exercise both enjoyable and memorable, helping you stay motivated every day.", "short_description": "Mind Body Life \u2013 A platform built for Better Mental Health, Physical Recovery, and Independent Living with easy, fun activities and mobility analysis."}]}, "developer_name": "Add-Life Technologies One Pty Ltd", "developer_privacy_policy_url": "https://www.add-life.info/privacy-policy", "developer_terms_of_service_url": "https://www.add-life.info/terms-of-service", "publisher_name": "Add-Life Technologies One Pty Ltd", "support_website_url": "https://www.add-life.info/contact", "website_url": "https://www.add-life.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28469755302718777"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623179_1451602520455398_6030546828035250960_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xRdFV56DqYQ7kNvwG2DzwM&_nc_oc=Adp6Epgijsz6uZRHkbeCr554QDDv9lgRGBcZZmQ4OorzwYyEyiGhca7HMK0BwEE5JJ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSgQ_eXx0nNN2fOJeNoExUkMGhQju-FrT-sq5g5VuYPw&oe=6AEB5EDB"}, "is_concept": false, "is_test": false, 
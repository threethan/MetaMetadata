file_name": "Mind-&-Body-Screenshot-2026-BUBBLES-2560x1440.png", "id": "954955074320260", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620599_954955077653593_4040559750000780881_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWdG7f1dPI8Q7kNvwGUcXVl&_nc_oc=Adr8qJkH0ww8mmlQBgtlVEIepSWK3GLBupzzlAhIFWOSNJ6lAat1EfwfAGx2cyU-PX0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYBgwRO_xgqwV2RvhRXLnKSOMD7QiELnU8wJoDQ-GYsA&oe=6AEC9B67"}, {"file_name": "Mind-&-Body-Screenshot-2026-BOXING-2560x1440.png", "id": "1098681945987055", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620316_1098681949320388_809024157050844970_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3i_QtmXuiYQ7kNvwEeKffH&_nc_oc=Ado7NANE762W71MbDbOIPnCXSVccusV06C9gHKpW5gg4yp7ew-6jL2VpP6OQhLoCjVQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBKvPYzCXyoD1LMzfEBgr4krviOgMXCiLS-UdRkjh8-g&oe=6AEC971A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image for video Mind Body Life.png", "id": "1802592654108613", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499628067_1802592657441946_606148062685932100_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0ajq4DstgEQ7kNvwGrMwCw&_nc_oc=AdoathCNfQrVE3hXTw9eQJGdF3kK9gO9ObVZ4fULiu3fNv0HfCZmYgPt_qVzoSps_E4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrqjjs6u4s0eHJ4uwoi2l1gp_O_i1Eveg2JnNoUfuOdg&oe=6AECB319"}, "display_name": "Mind Body Life", "keywords": ["rehabilitation", "exercise", "mobility", "relaxation", "ageing"], "long_description": "Discover a healthier, happier you with Mind Body Life by Add-Life.\nOur platform provides simple daily activities designed to inspire movement, improve mental health, and support independent living.\n\nMind Body Life also empowers you to track your progress with precise measurements of arm reach, wrist, and hand movements. These insights are invaluable for those in rehabilitation or aged care, offering mobility reports that help clinicians and families plan for current and future needs.\n\nRelaxing activities reduce stress, boost neuroplasticity, and make exercise both enjoyable and memorable, helping you stay motivated every day.", "short_description": "Mind Body Life \u2013 A platform built for Better Mental Health, Physical Recovery, and Independent Living with easy, fun activities and mobility analysis."}]}, "developer_name": "Add-Life Technologies One Pty Ltd", "developer_privacy_policy_url": "https://www.add-life.info/privacy-policy", "developer_terms_of_service_url": "https://www.add-life.info/terms-of-service", "publisher_name": "Add-Life Technologies One Pty Ltd", "support_website_url": "https://www.add-life.info/contact", "website_url": "https://www.add-life.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28469755302718777"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623179_1451602520455398_6030546828035250960_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5vpnzXsxfgQ7kNvwGARewN&_nc_oc=AdomD2VADDDPrj1iVCcTCat6Uy-ViDkLczd37YsPzRteq8v4NxiZKk7ELULYtvQ85Jc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEG-lmWJfHs9QjjbveuOfaZoDnTNf3h299eygi3nk5og&oe=6AECB05B"}, "is_concept": false, "is_test": false, 
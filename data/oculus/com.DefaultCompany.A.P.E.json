YpcAKPJ_YwwBOak4MCXw0hyq7GuEmPFZbxc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrdweWZY1w9SLfGz-njLdX93Qi0wnhT7A3S_FO-2dsGg&oe=6A8049EA"}, {"file_name": "Adobe Express - file (18).png", "id": "1267267571891665", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499299808_1267267575224998_3680612872072066166_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnyAGaczENkQ7kNvwHUyWrw&_nc_oc=Adr-6SMrBZWy9xmj74Legca-lKgI2kS5fHqjAhTYcOaqgbXEywMqT27Z-x7Amqnjz_g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQ-ZoHLdjVEf8zJsq8mgUNJ7FxV_BCLlF1FwmPZN0Ypw&oe=6A80648E"}, {"file_name": "Adobe Express - file (19).png", "id": "1229157375709141", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499307311_1229157379042474_4284487918246621002_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WzMKD-wTrh8Q7kNvwF4CxPY&_nc_oc=Adqh5s49ZOGv5S3ZY7sSsR7FK1O2bHlqrWsovpbL1gl1Kg8l_BIOqYdiJ6lliklIcQA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjeiPxlIXp1ieBjtTsF-7w4sUYF0HAjmV9vnVCrbo46g&oe=6A8042E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Behind You(Beta)", "keywords": ["Horror", "spy", "escape", "fun", "chaotic"], "long_description": "Behind You\n\nA VR Horror Experience Made to make your adrenaline go through the roof\n\nYou\u2019re trapped in a massive, pitch-black labyrinth \u2014 no map, no weapons, no safety. Just the echo of your own footsteps\u2026 and the thing that\u2019s hunting you.\n\nThe creature is fast \u2014 faster than you think. It wanders the maze in silence until it sees you. When it does, you\u2019ll hear the sudden shift \u2014 the roar, the footsteps pounding toward you \u2014 and then you run. You won\u2019t get much time to react. Most don\u2019t make it.\n\nEvery corner feels wrong. Every hallway sounds alive. The deeper you go, the louder it gets. The only way out is to stay quiet, move smart, and never let it see you.\n\nFeatures:\n\nTerrifying AI that hunts players through sound and sight \u2014 once spotted, escape is nearly impossible.\n\nDark, maze-like environment that changes each time you play.\n\nImmersive VR movement and spatial audio, making every sound a threat.\n\nFast, brutal chases that test your reflexes and nerves.\n\nNo HUD, no hints, just raw survival.\n\nYou\u2019ll hear it long before you see it.\nAnd when you finally do\u2026 it\u2019s already too late.", "short_description": "Behind You\n\n\nYou\u2019re trapped in a massive, pitch-black labyrinth \u2014 no map, no weapons, no safety. Just the echo of your own footsteps\u2026 and the thing that\u2019s hunting you.\n\nThe creature is fast \u2014 faster than you think. It wanders the maze in silence until it sees you. When it does, you\u2019ll hear the sudden shift \u2014 the roar, the footsteps pounding toward you \u2014 and then you run. You won\u2019t get much time to react. Most don\u2019t make it.\n\nEvery corner feels wrong. Every hall"}]}, "developer_name": "BmixMan", "developer_privacy_policy_url": "https://sites.google.com/view/gystudiosprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "GYSTUDIOS", "support_website_url": null, "website_url": "https://sites.google.com/view/gystudiosprivacypolicy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "
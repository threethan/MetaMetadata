ative Monkeys is a game which uses hand locomotion to roam around the free monkey world. This game will have nothing to do with your privacy. This is a safe game and we nor this game won\u2019t leak any private information of yours. Although this is a multiplayer game, it will not leak any private information. You can branch on trees so your skill grows more. If any bozo tries to reveal your information, tell me in the discord. https://discord.gg/mvraJXN4hw", "short_description": "A fun game to hang out as a monkey that explores a wonderful world."}]}, "developer_name": "ChaosVR Games", "developer_privacy_policy_url": "https://sites.google.com/view/cooperativemonkeys/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/cooperativemonkeys/tos", "publisher_name": "PrismGtag", "support_website_url": null, "website_url": "https://sites.google.com/view/cooperativemonkeys/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "305888655270890"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001664_1313905205876496_3135506996138778929_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxbObwPMYyAQ7kNvwGb1VPl&_nc_oc=AdrMHWnZWI596mO4kl_09cIqJuYDSNkyCAFie8-KShNV-3S3COMZ9ifwxP_lLFJsQiE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46N_6MxB-kI1P6cTCn_fO_IXAZzV6z0-sLhC4IXVF
.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxx4_wSyUT0Q7kNvwGvh9WP&_nc_oc=Adq5f2EEOOm3ymYLcip51OLQKGx-odLN-USY0aN23BDBOeLAXigX9v9FAZyY0ODYTvY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRUGO6cy2QAz0RYw7e3rJuNzcRiNmOKJ2rVvOOFXtvzQ&oe=6AC50B16"}, {"file_name": "ss5.png", "id": "1750788932905574", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499310720_1750788936238907_7435947858576871692_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-1-bwI-WX8Q7kNvwHDOBp0&_nc_oc=Adr4iJHXiQLfMADh8if4p90Eu-OXKjT224U38LGZ38Xz62RuNQsys7gr63SwVs1ZTKQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjbzupHbP5XFfctulLOPr0KmRf0ovSXXdt0pFgA2YJbA&oe=6AC50E3C"}, {"file_name": "ss6.png", "id": "1732606344458459", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499310731_1732606347791792_2847645553366530722_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qlLl07O6c7IQ7kNvwH_P873&_nc_oc=AdpLSp3pUtRP2WYCpl83usKHvzERyoaT5lQjq71cBh1F2xzb9qBOR9XbR8-FpO_-MHY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPleM1cGg7yKxdK5u-vlc_4RjSX-3HnWJJWLQFoTvqEXA&oe=6AC4FAA6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wizard\u2019s Vengeance VR: Magic Horror", "keywords": ["zombie", "spell", "wand", "haunted", "escape"], "long_description": "You were once part of a powerful magical order. A cursed enemy attacked your sanctuary, stole your magic stones, and vanished into a haunted building filled with dark rooms, monsters, and cursed souls. Now you enter alone, armed with your magic wand and a burning need for vengeance.\n\nWizard\u2019s Vengeance VR: Magic Horror is a mission-based magic horror adventure built for Meta Quest. Use your VR hands to explore haunted rooms, open drawers, unlock cabinets, collect hidden keys, and search shelves for potions and magic stones. Every object you touch, every door you open, and every cabinet you unlock brings you closer to the cursed enemy who stole your power.\n\nCollect four types of magic stones \u2014 blue, red, purple, and green \u2014 each unlocking a different spell. Match each stone with its potion to charge your wand and cast spells against zombies, monsters, and terrifying creatures lurking in every dark corner.\n\nBut one enemy stands apart. The Cursed Keeper appears throughout the building, then runs. He locks doors, triggers zombie ambushes, and always stays just out of reach. Who is he? What is he hiding? Hunt him down across 10 dark missions and uncover the truth behind the curse.\n\nWizard\u2019s Vengeance VR: Magic Horror delivers spell casting, potion hunting, wand combat, haunted room exploration, VR survival horror, and dark fantasy action inside a cursed building that wants you dead. Survive each room, restore your power, and finish the vengeance mission.", "short_description": "Your sanctuary is destroyed. Your magic has been stolen by a cursed enemy. Enter a haunted building packed with dark rooms, locked cabinets, hidden keys, and lurking zombies. Collect potions, attach magic stones, and cast spells with your VR magic wand as a wizard on a vengeance mission. Fight monsters, hunt the cursed villain room by room, and survive a dark fantasy VR magic horror adventure with spell casting, potion hunting, and survival horror for Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/ksgamestudio/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "KS Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/ksgamestudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nul
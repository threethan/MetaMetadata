a3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTDhcAb0CADdCo_fXSu8w_KBUIMhKFZ_QtHfvBxUkUYA&oe=6AC4FDE0"}, {"file_name": "ss3_2.png", "id": "1747044096547084", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499626728_1747044099880417_7174878183584050592_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQzvK8UBS8UQ7kNvwEDGFlR&_nc_oc=AdrhSCp5VcmX7Tw4XBZupti--XWPUkpI7W4LLU-ff5ihZOtmp94YaCCIAtiEhWfsHjA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrz-45eP2o-TFTcbj9mKfC-hcyeM5HprlA-qpp1Jq4oA&oe=6AC51FAC"}, {"file_name": "ss7.png", "id": "2095325167779051", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/593723055_2095325174445717_3767497110148615309_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTKWTsyV-WcQ7kNvwErCQ6A&_nc_oc=AdoMCoJa-_t1UivYy9ZHLRgO_SCM8ijKdTWq1juTLcJ6BKkykoRD7vG44TcAPLoOBGw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0Gb4-ICfBFUM5VIPeANxgTZhd-0SROL7wu5rGev6h5Q&oe=6AC5267D"}, {"file_name": "ss1_2.png", "id": "4578559449040187", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499626728_4578559452373520_6188292513961274461_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltFDlVlmLjMQ7kNvwFY4np2&_nc_oc=AdrC4p-8hMBhHDjpq11s_2fW9XR_1MU1Y_P1gyuL6rdmpNP9L2xzb2mdhj-5jkLT8y0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0R6c8jtcXrJYggTxbQMG8HHyvse1htWFxbbsdxha7UA&oe=6AC4FC91"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wizard\u2019s Vengeance VR: Magic Horror", "keywords": ["zombie", "spell", "wand", "haunted", "escape"], "long_description": "You were once part of a powerful magical order. A cursed enemy attacked your sanctuary, stole your magic stones, and vanished into a haunted building filled with dark rooms, monsters, and cursed souls. Now you enter alone, armed with your magic wand and a burning need for vengeance.\n\nWizard\u2019s Vengeance VR: Magic Horror is a mission-based magic horror adventure built for Meta Quest. Use your VR hands to explore haunted rooms, open drawers, unlock cabinets, collect hidden keys, and search shelves for potions and magic stones. Every object you touch, every door you open, and every cabinet you unlock brings you closer to the cursed enemy who stole your power.\n\nCollect four types of magic stones \u2014 blue, red, purple, and green \u2014 each unlocking a different spell. Match each stone with its potion to charge your wand and cast spells against zombies, monsters, and terrifying creatures lurking in every dark corner.\n\nBut one enemy stands apart. The Cursed Keeper appears throughout the building, then runs. He locks doors, triggers zombie ambushes, and always stays just out of reach. Who is he? What is he hiding? Hunt him down across 10 dark missions and uncover the truth behind the curse.\n\nWizard\u2019s Vengeance VR: Magic Horror delivers spell casting, potion hunting, wand combat, haunted room exploration, VR survival horror, and dark fantasy action inside a cursed building that wants you dead. Survive each room, restore your power, and finish the vengeance mission.", "short_description": "Your sanctuary is destroyed. Your magic has been stolen by a cursed enemy. Enter a haunted building packed with dark rooms, locked cabinets, hidden keys, and lurking zombies. Collect potions, attach magic stones, and cast spells with your VR magic wand as a wizard on a vengeance mission. Fight monsters, hunt the cursed villain room by room, and survive a dark fantasy VR magic horror adventure with spell casting, potion hunting, and survival horror for Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/ksgamestudio/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "KS Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/ksgamestudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id"
-7&_nc_sid=6e7a0a&_nc_ohc=kbPNI9LCT5sQ7kNvwE88fFx&_nc_oc=AdpPAXeE2kp7LMRZcAXOjpZBS68gDmQc5FHKLCButm3CLRJi-fYKqKbb31v0-Xx9dvQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdCmSgEc_pFphFh_3dFw5zqxW4F9_m56G6LITT13BElw&oe=6AFDBAB3"}, {"file_name": "still1.png", "id": "974799775643688", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_974799778977021_5003453563691493302_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8oaTfFuhbgQ7kNvwGlgpBC&_nc_oc=AdpaPD0X0NYJyS21cwwI3l0kS24J8rgtwJOJY5N5KUj56d6OK_uPcD29HjnHxrIJNVQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZLnyr6E3Wtdg4NtqzOApDNKBICgZHpV9to8OV0fttvQ&oe=6AFDD385"}, {"file_name": "03-cockpit.png", "id": "2294476091352075", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831569_2294476094685408_8281694875190734500_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8SkpBG-jECIQ7kNvwHQtNNG&_nc_oc=AdqA_GvmtyhaySEb6SV9yJOBfe5UktQP6qBeUJ3XZdCGJ0BXYH4si5qdyjjw42ympY0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6PP2PZ3mXspHFkfqLUzF7MduXxfFeZdGjj23chYqD_w&oe=6AFDCD9B"}, {"file_name": "02-linked-tunnel.png", "id": "945600638269426", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604317775_945600641602759_2508145699308309092_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbzfRP4anJIQ7kNvwEbdXhr&_nc_oc=AdqlxTDpBSJjUEDN5WiNsi0KFB4th5TXf4QLi12zNbnBYwg6nrVKCdlXFriE8ByhIak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLa9BmKLsjpJdgnOcyA1PndZSG5A-4Yn2czrofrdenKg&oe=6AFDD808"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battle Sphere Arena", "keywords": ["arcade", "retro", "gravity", "shooter", "action"], "long_description": "Battle Sphere Arena is a first-person VR melee brawler set inside a gameshow coliseum. You are tonight's contestant on TRANSMUTE LIVE. The arena is a cluster of hollow linked spheres \u2014 last season's megastructures, still on air. Fly in zero-g, keep your power above zero, and put on a show.\n\nMove with the left stick. Climb and turn with the right. Kick off the inner hull with A, or hold it to jet. Left trigger fires plasma; hold it to grow a heavier orb. Your right hand carries an obsidian sword. Hold right trigger to charge a slicing laser. Hold grip for a red energy lasso that yanks drones, crates, and hydra necks. Stick-click launches a seeking missile. B is a force pulse.\n\nGlyphs are the currency of abundance. Smash crates, barrels, UFOs, and hydras so power fragments spray through the air and pull into your visor. Energy starts at 1000. Every point above or below that changes damage, range, charge times, and cooldown. Coins buy extra missiles and orbital pets from a tube-side shop.\n\nThe coliseum does not wait. A Dark Knight hunts from another sphere. Rifts spill saucer drones. Hover-camels, scythe trilobites, hornet packs, and owl-lemurs join the broadcast. Hydra doors open on a timer: necks coil, stretch, and alternate plasma balls with beam fire. Cut a head, then wreck the kennel to seal that hole for good.\n\nSit or stand in a small play space. Touch controllers only. Comfort is moderate-to-intense because of free flight and full-stick turning.\n\nFeatures\n\u2022 Zero-g flight ", "short_description": "Zero-g VR melee in a livestreamed coliseum of linked spheres. Fly, cut, lasso, deflect UFO's, befriend orbiting pets, evade execution drones, and hunt hydras as you boost your power level to tear apart the map itself with your plasma cannon. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://futuremusic.online/privacy", "developer_terms_of_service_url": null, "publisher_name": "Future Music Online", "support_website_url": null, "website_url": "https://futuremusic.online/battle-sphere-arena/quest", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": 
ss=7f20f&oh=00_AQDfBv446vWM3FdBhGPR2XuGJDVBs-IC8avGnontYm_VUg&oe=6A4A64A1"}, {"file_name": "473393425_903386661616286_6268115176619886869_n-2560x1440.png", "id": "1617685055784281", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391899_1617685059117614_6318547279566554441_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gDpvZLyZskoQ7kNvwFIWxuZ&_nc_oc=AdrxNZtUHOwpEgNic9U8ge-uWpau7HtPdAHbx1NRVyI2c3leAJN9PKTchpHlkpQknEA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC14IIkOkzoBchbzgmfPBt0Hv1IvRFUN-o1h8dR1btvug&oe=6A4A5AA5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HydraTag", "keywords": [], "long_description": "In HydraTag, you'll find yourself immersed in heart-pounding gameplay that's easy to learn but challenging to master. Run, jump, and dash through intricately designed arenas, showcasing your agility and strategic prowess. Engage in thrilling tag matches where swift movements and clever tactics determine the ultimate victor.\n\nWith its intuitive controls and dynamic gameplay, HydraTag offers an adrenaline-fueled adventure suitable for players of all skill levels. Whether you're a seasoned gamer or new to the world of tag games, the accessible gameplay mechanics ensure an enjoyable experience for everyone.\n\nBut what sets HydraTag apart? This game is not just about tagging opponents; it's ", "short_description": "Welcome to HydraTag, an exhilarating and immersive gaming experience that brings the excitement of chasing and tagging to a whole new level! Step into a futuristic world where players become HydraTag, navigating through captivating environments while using their wit and speed to outrun other opponents."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hydrataggings/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hydra", "support_website_url": null, "website_url": "https://sites.google.com/view/hydrataggings/home", "
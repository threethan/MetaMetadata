 heat!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://2muchpolys.carrd.co/#scrollpoint01", "developer_terms_of_service_url": null, "publisher_name": "None", "support_website_url": null, "website_url": "https://2muchpolys.carrd.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25271374052499484"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75269157_348234914209323_4395888751580362190_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVP76gMunAkQ7kNvwGuNsi6&_nc_oc=AdpNc0oNr37jjm8KAB8yRfTSwKx24wR7OKiICG1tWp0eGf9Z2cCDV7tAXFRXU11mpqY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEz0FQNY5iEHx1F5rQK7apPBNM6UeB6l-ImIhfEfIaPqA&oe=6A8D750A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Just Another Cooking Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1696251600, "lastRevision": {"nodes": [{"id": "6766207650109405", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6766207633442740", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "AN
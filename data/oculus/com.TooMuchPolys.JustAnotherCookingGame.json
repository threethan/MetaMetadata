_name": "3.png", "id": "213742845042920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75286675_213742848376253_3538306338887601318_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYIShcQKlo4Q7kNvwHZk1pv&_nc_oc=Adp3b2DoERON_YZu14qzYVmSYfhI7ok5xtlgvY2CRudFgWEuxdop5_4318BybFvo-qo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXOdjvxoLAq798yjGB7b3c_MkylXHlUAkeBrK_vTM1CdA&oe=6B0F21F0"}, {"file_name": "1.png", "id": "198159856616367", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031495_198159859949700_3359487543079529795_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YN6YjaRhbKEQ7kNvwFKhGak&_nc_oc=Adq7N2Ny5py4Nco5EgDSpdzvTnOJmlgbZU6nKWiVmbAt5nv7RUGLWrI4xQGlQyYNe2Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWS1Vr_ntIRFefGLKXGl7CcqJ8CRoW1fOhJlxPGIYZtPA&oe=6B0EFDD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo_Applab.png", "id": "672863444779976", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75303838_672863448113309_8226459743149731752_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ir8qQJuEXuYQ7kNvwEi2aS2&_nc_oc=AdrbHd6W8XWftKuhmDHwIjOFuYP63SdxZJiMBGdMdi2hjVjnj-wYb4Y1SJu5B-PO7EM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUzKHmnkjBtkT7KESC3He-OEJKhNgVq1TtxcBQ7b0Zbog&oe=6B0EFC44"}, "display_name": "Just Another Cooking Game", "keywords": [], "long_description": "NOTE: This app is part of a university research study and contains a SURVEY only in the \"Experience\" level. After that, you unlock the game with no more surveys.\n\nJust Another Cooking Game is a time management game inspired by several other cooking games such as Overcooked and Cook-Out. \n\nPlay the experience to unlock 12 more levels.\nServe all robots as fast as possible to unlock the next level.\nCook Under Pressure and see if you can handle the heat!\n", "short_description": "NOTE: This app is part of a university research study and contains a SURVEY only in the \"Experience\" level. After that, you unlock the game with no more surveys.\n\nJust Another Cooking Game is a time management game inspired by several other cooking games such as Overcooked and Cook-Out. \n\nPlay the experience to unlock 12 more levels.\nCook Under Pressure and see if you can handle the heat!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://2muchpolys.carrd.co/#scrollpoint01", "developer_terms_of_service_url": null, "publisher_name": "None", "support_website_url": null, "website_url": "https://2muchpolys.carrd.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29572696065700573"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75269157_348234914209323_4395888751580362190_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmvmEexmS7wQ7kNvwGiva3m&_nc_oc=Adpyb9MzEyyqJ5VyUvYoNldBahqbkS2CpyhegSOvltIeNO5_9IUJZDgjDsdCQ1un2iA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXp2rTAZf3dR1BnvHTaeL_q0ysf9KbQXvRZohajLk9H0Q&oe=6B0F188A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Just Another Cooking Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "274332603592553
_name": "3.png", "id": "213742845042920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75286675_213742848376253_3538306338887601318_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U02X9rDQsfgQ7kNvwEicN3j&_nc_oc=AdoMFEm56ObiQPT6_kgGLENb_Kt8cM2wVsm0YK3NfXCfjzHehhXkbbn97ncZpwYQeQo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRuSWJ0arbrDpbZT8Ke2rQLhA_QQT8D2-9tE3FGLHULfA&oe=6B0C7EF0"}, {"file_name": "1.png", "id": "198159856616367", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031495_198159859949700_3359487543079529795_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lSMW7FLID0Q7kNvwEc5nLd&_nc_oc=AdrmrcwsIwSCsNTVbalYwwYJpVEKwaEC68lUeLiIObA8ampbxCy_3_V5mg_A8M9BKE0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQoh9mvkPnvzYo6r86MLW10SddWgUiOdsnTH67TEQhnmg&oe=6B0C5AD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo_Applab.png", "id": "672863444779976", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75303838_672863448113309_8226459743149731752_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ir8qQJuEXuYQ7kNvwHKKe5a&_nc_oc=AdrxGjivMb_xQtGvarqJ7qNWCV2DddmStpvE8YbuoZd0K101erbqycjtiPGf3uSPtmI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT7APgdFGQjni-WhS9RE7YY_ICn37HPVmbSpywARABCZw&oe=6B0C5944"}, "display_name": "Just Another Cooking Game", "keywords": [], "long_description": "NOTE: This app is part of a university research study and contains a SURVEY only in the \"Experience\" level. After that, you unlock the game with no more surveys.\n\nJust Another Cooking Game is a time management game inspired by several other cooking games such as Overcooked and Cook-Out. \n\nPlay the experience to unlock 12 more levels.\nServe all robots as fast as possible to unlock the next level.\nCook Under Pressure and see if you can handle the heat!\n", "short_description": "NOTE: This a
_name": "3.png", "id": "213742845042920", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75286675_213742848376253_3538306338887601318_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U02X9rDQsfgQ7kNvwFjpgb_&_nc_oc=Adow6r6RnsD0YDywv81FcYCeKYh1q_tGzJNPN6qOYlULVKBs1nFj0-IMx9YLUtHU7N0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRQmQ2RyXnhjTR-Cy6mICotnVh-8NkHrnAJ0bqKam0P7w&oe=6B0DD070"}, {"file_name": "1.png", "id": "198159856616367", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031495_198159859949700_3359487543079529795_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lSMW7FLID0Q7kNvwFPD5Sc&_nc_oc=AdrkJ_b4dAcaLTnXWJVJLeqe7vHHuGIuwbS1pK13KnaH3dwlIjIwFpYpaxhwBq9bP1s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTlACYp6wEwD1W2DEVVnP6CxW0s6hyhqpmoDYsa266apQ&oe=6B0DAC54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo_Applab.png", "id": "672863444779976", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75303838_672863448113309_8226459743149731752_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ir8qQJuEXuYQ7kNvwFUftbD&_nc_oc=Ado_tX9g2xeO7OfcQ2eiX8MrxRvx5G9Gc2RKcNvrqngJtxf1oPs4cj5YyQ1bIB_pxyw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTkwpLlszpzgmBNpFG5DGz9NCnuFnKa2Fhg2CAmUtZgzg&oe=6B0DAAC4"}, "display_name": "Just Another Cooking Game", "keywords": [], "long_description": "NOTE: This app is part of a university research study and contains a SURVEY only in the \"Experience\" level. After that, you unlock the game with no more surveys.\n\nJust Another Cooking Game is a time management game inspired by several other cooking games such as Overcooked and Cook-Out. \n\nPlay the experience to unlock 12 more levels.\nServe all robots as fast as possible to unlock the next level.\nCook Under Pressure and see if you can handle the heat!\n", "short_description": "NOTE: This a
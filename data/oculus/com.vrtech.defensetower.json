6ETB8N7dA3p-VM02GkREzVWDBmWnRc71WxEJPAiQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vZ-bR6YoAwHvEZSDBFq6MtI9phvFQlo1UDyxi38FKZQ&oe=69DBA105"}, {"file_name": "Screenshots 3.png", "id": "1721636601935277", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820887_1721636605268610_3978112013961148936_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJuDctV_H84Q7kNvwGfQjqq&_nc_oc=AdoPPPNWoxNd7ZVZkObEHFPkBpUnFSRJMeUFi08o81mPuNj7pDL7-x0uwGOr67L0zXI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Rj7-H4CqYVCy5IShjNGg3XmQVoGCXg9zNtdumWnXPcw&oe=69DB81A1"}, {"file_name": "Screenshots (1).png", "id": "1980061262606161", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618069_1980061265939494_7210875179445160530_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7u0uJJZuMEQ7kNvwFr2AP3&_nc_oc=AdpMTxPVfYF_AcAKC8B_b3s-t570ts9jLJi0Xk4EXRc1wDjxGZg5SYdglvZP5OOx3II&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BDFdCtNTJ0DYi0Sh5nPcxysx6rh8GxHW-vH4KW3fuUA&oe=69DB8207"}, {"file_name": "Screenshots 4.png", "id": "917754494422831", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619187_917754497756164_5728536994928478939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSWb_J1oB40Q7kNvwEbRtbT&_nc_oc=AdoeKon2pQd5rWbQsLxpGb-ihYBCkUpREEL5UmH1_KjbdY8SN05OE_ffNivsgXVaC4w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1G5xlP8QlZKrJMXpVz_VMqLS5TJvIHZZZMtwCXxPHVYQ&oe=69DB97EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1649975362697675", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828087_1649975366031008_1619590723740937246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFeHPxffw_YQ7kNvwH5g0cv&_nc_oc=AdoeurvSHT-C6Ik6GTsetWLg4daZQAc80OT7fP2C5p3v3F7vgAeoXrwhViNa_lZSN2U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XvdcZdiiUY1uTN35TmxHH922l14QKA0t-ZILrCf18bg&oe=69DBA943"}, "display_name": "Catcher: Dragon Realm", "keywords": [], "long_description": "Step into the boots of a legendary Dragon Warrior in Catcher: Dragon Realm, an intense magical action game built exclusively for VR.\nWield a powerful enchanted gauntlet that lets you catch, transform, and throw elemental attacks back at waves of ferocious dragons and mythical beasts. Defend the last watchtower of mankind in a kingdom engulfed by blazing volcanoes, ancient forests, and cursed caverns.\n\nImmersive Combat: Catch fireballs, ice shards, and shadow magic in mid-air, then hurl them back in spectacular slow-motion.\n\nMotion-Based Magic: Use your hands to draw symbols in the air and unleash shields, shockwaves, or time-freezing traps.\n\nEvolving Challenges: Survive escalating waves of smart enemies and face off against giant dragon bosses with unique abilities.\nUpgradeable Powers: Collect magical shards to enhance your gauntlet, unlock new spells, and customize your combat style.\nWith stunning visuals, 360\u00b0 enemy encounters, and heart-pounding gameplay, Catcher: Dragon Realm delivers a fantasy experience only possible in VR.\nAre you ready to face the storm?", "short_description": "Wield a magical gauntlet in VR Catcher: Dragon Realm and defend humanity\u2019s last watchtower from waves of dragons and mythical beasts. Catch incoming elemental attacks\u2014fire, ice, shadow\u2014and hurl them back in intense, motion-controlled VR combat. Unlock powerful spells, face epic bosses, and survive in a realm where every battle is a fight for survival. Feel the magic. Fight like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categor
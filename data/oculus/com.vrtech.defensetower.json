scdn.com&oh=00_Af3bEfUxYp7sHOTLHgwFKzlyqXzSUKyx8DLlq9yiaFxUeg&oe=69F0B905"}, {"file_name": "Screenshots 3.png", "id": "1721636601935277", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820887_1721636605268610_3978112013961148936_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pa-Y05pO-WYQ7kNvwG7DO5_&_nc_oc=AdrAbpJh8FWdppv3YDrR3ZsMSExbw8fTaQzYESO3CVGXkyzKtk_krh9lRyzaJr6M_ck&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af05tvr36Izi4D3qVmgisMC6bs0XbhLrr5myjpcd41TZxQ&oe=69F0D1E1"}, {"file_name": "Screenshots (1).png", "id": "1980061262606161", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618069_1980061265939494_7210875179445160530_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFAn8S-FdGIQ7kNvwFiw7KU&_nc_oc=AdpKuMIF5q8LW47FTCAlounzVX7UWbLe_84eFK0LLFKLpuFic8LR86EH9GU47YEKdzM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1id5JrZpgKMS-0dlGvW0saupC3bXJq_PjFBLU-iZWEFg&oe=69F0D247"}, {"file_name": "Screenshots 4.png", "id": "917754494422831", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619187_917754497756164_5728536994928478939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlKbK6XJ6tUQ7kNvwEHJSC8&_nc_oc=AdreHTu8qTlkKbCJ21Dq2Y55E0M6cneUE2hWQ24OHEg9wvtlUuTJ_cSjRwQnOJc1o28&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1zlzz2HaBKAqEd2cdO98nmdmrQpf_iRpvpfV53sKyo3g&oe=69F0AFEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1649975362697675", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828087_1649975366031008_1619590723740937246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWGIicfUkv4Q7kNvwEICUNx&_nc_oc=AdrWISwJsa-SdB8aYh2r1-afClVGSvnqFroqRdu8dn4pM9F93jiH79NqUjEwUVOJJbU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0Q_fhdiLbvPBL3ojzdFMgj9zGUhAi_Aej9JiBh3cspxw&oe=69F0C143"}, "display_name": "Catcher: Dragon Realm", "keywords": [], "long_description": "Step into the boots of a legendary Dragon Warrior in Catcher: Dragon Realm, an intense magical action game built exclusively for VR.\nWield a powerful enchanted gauntlet that lets you catch, transform, and throw elemental attacks back at waves of ferocious dragons and mythical beasts. Defend the last watchtower of mankind in a kingdom engulfed by blazing volcanoes, ancient forests, and cursed caverns.\n\nImmersive Combat: Catch fireballs, ice shards, and shadow magic in mid-air, then hurl them back in spectacular slow-motion.\n\nMotion-Based Magic: Use your hands to draw symbols in the air and unleash shields, shockwaves, or time-freezing traps.\n\nEvolving Challenges: Survive escalating waves of smart enemies and face off against giant dragon bosses with unique abilities.\nUpgradeable Powers: Collect magical shards to enhance your gauntlet, unlock new spells, and customize your combat style.\nWith stunning visuals, 360\u00b0 enemy encounters, and heart-pounding gameplay, Catcher: Dragon Realm delivers a fantasy experience only possible in VR.\nAre you ready to face the storm?", "short_description": "Wield a magical gauntlet in VR Catcher: Dragon Realm and defend humanity\u2019s last watchtower from waves of dragons and mythical beasts. Catch incoming elemental attacks\u2014fire, ice, shadow\u2014and hurl them back in intense, motion-controlled VR combat. Unlock powerful spells, face epic bosses, and survive in a realm where every battle is a fight for survival. Feel the magic. Fight like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "644354873106712"}, {"id": "3744040075834813"}], 
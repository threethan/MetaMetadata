LDLHELoAgg5lpDTMD1FRMl88xppCV_NKIVqn4Dw8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1k4EuZjLxnGeujieCZCXUbgxajbfnBYNguX4rLexeBoQ&oe=69E0E705"}, {"file_name": "Screenshots 3.png", "id": "1721636601935277", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820887_1721636605268610_3978112013961148936_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzKaxjMdskYQ7kNvwFBOkpK&_nc_oc=AdqmqRg4I-Hl7oCJtQFOHwcaI5z4f4CsX7XLYR3SzkaWdGaMUpBDWM_b1n3dclrfUBg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3w6iXV3gIEacvSCvSQITCIcTAC4244YB0zUq7ucZln3A&oe=69E0C7A1"}, {"file_name": "Screenshots (1).png", "id": "1980061262606161", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618069_1980061265939494_7210875179445160530_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcZGaWi_pKgQ7kNvwGiHU8G&_nc_oc=AdrGCPGou1PFg_dL9G0y6x2sh8qNPqCUoio5suU6lpNDBAmjef4nadc-oNRL1EnzqVk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JC4O8R7wbbW5OyvrIRoylmqHIIHIhKgjuYJYePkdJ0Q&oe=69E0C807"}, {"file_name": "Screenshots 4.png", "id": "917754494422831", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619187_917754497756164_5728536994928478939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1sKwqpzcwAQ7kNvwHIvo1g&_nc_oc=AdrfwHqA1pwCvo_JZzSdKgWrQynS4QmN0F15uRHXqNvSq8BxeMSFDtFSKCeS1HMopXc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2V9ivZLwPGvkkEw3fb_8270FvvpoE0X3ERUxV2-Xn_wA&oe=69E0DDEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1649975362697675", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828087_1649975366031008_1619590723740937246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukAk4wez21oQ7kNvwGI3fIB&_nc_oc=Adqh0-4sNUKHWl3lluo9MHT658InX6kf-CswYmyde6SMnqv6HPUyWl0alg6Sao7Z9uQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29IheqsNRGhOdO9Os_FMW-Ql2MIaPrSwfBgaWTa7JzcQ&oe=69E0EF43"}, "display_name": "Catcher: Dragon Realm", "keywords": [], "long_description": "Step into the boots of a legendary Dragon Warrior in Catcher: Dragon Realm, an intense magical action game built exclusively for VR.\nWield a powerful enchanted gauntlet that lets you catch, transform, and throw elemental attacks back at waves of ferocious dragons and mythical beasts. Defend the last watchtower of mankind in a kingdom engulfed by blazing volcanoes, ancient forests, and cursed caverns.\n\nImmersive Combat: Catch fireballs, ice shards, and shadow magic in mid-air, then hurl them back in spectacular slow-motion.\n\nMotion-Based Magic: Use your hands to draw symbols in the air and unleash shields, shockwaves, or time-freezing traps.\n\nEvolving Challenges: Survive escalating waves of smart enemies and face off against giant dragon bosses with unique abilities.\nUpgradeable Powers: Collect magical shards to enhance your gauntlet, unlock new spells, and customize your combat style.\nWith stunning visuals, 360\u00b0 enemy encounters, and heart-pounding gameplay, Catcher: Dragon Realm delivers a fantasy experience only possible in VR.\nAre you ready to face the storm?", "short_description": "Wield a magical gauntlet in VR Catcher: Dragon Realm and defend humanity\u2019s last watchtower from waves of dragons and mythical beasts. Catch incoming elemental attacks\u2014fire, ice, shadow\u2014and hurl them back in intense, motion-controlled VR combat. Unlock powerful spells, face epic bosses, and survive in a realm where every battle is a fight for survival. Feel the magic. Fight like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categor
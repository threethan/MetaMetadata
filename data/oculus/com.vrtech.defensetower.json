1xRMtc2DQqS3HQ-dVPaYSntH8rSCJknYOb1meyXQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MkSBWyxr_2r8NzcFKHrJUIbk28nWxxFTiTXX3j6pd4Q&oe=69DCF285"}, {"file_name": "Screenshots 3.png", "id": "1721636601935277", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820887_1721636605268610_3978112013961148936_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lr18DU8Z-OAQ7kNvwG00KD0&_nc_oc=AdpfgDVRmaCVHTPh0DfVDGDtu4rFuZKFoE74jlNJotRKLeKaiTbDfo4yIME1m_dQdf0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34SMnow0YyuVZHtzAmGQZugfg_yWrlmvYHTKNY3Sp2pg&oe=69DCD321"}, {"file_name": "Screenshots (1).png", "id": "1980061262606161", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618069_1980061265939494_7210875179445160530_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7u0uJJZuMEQ7kNvwElZLiX&_nc_oc=Ado0mfeH53qdyAGO4iSyIJSbtShkWW9VQ9sJGN14IR_OWxiPaljsQmUSgNs8qOE0CvI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Yr1jH_PpYb8uAIo65msblIm4GxGMb6QOydJUOaH93zg&oe=69DCD387"}, {"file_name": "Screenshots 4.png", "id": "917754494422831", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619187_917754497756164_5728536994928478939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fM5k3XppZHoQ7kNvwFEKXvX&_nc_oc=AdoJJBVtsuYh_aoUdUHc5kudYMjj_AmiC9nvW8IGzQ2ImuWcD9wGwv3jZLjSr9m6ftk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QRSNQnvFa2YoMX--RD9x_whUzhBA1UFceiGOdS0rLwg&oe=69DCE96A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1649975362697675", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828087_1649975366031008_1619590723740937246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFeHPxffw_YQ7kNvwHB4Dnj&_nc_oc=AdrHIt-whbtSUsn73iy2KvJ-yja_KVBHWucExloAhgPFGpLN55WM3TD-Z2Erc4S2Q24&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JpNPGm1AAWJEC4l13sjUWnCaeRqWduPlx1_DhfuTaMg&oe=69DCFAC3"}, "display_name": "Catcher: Dragon Realm", "keywords": [], "long_description": "Step into the boots of a legendary Dragon Warrior in Catcher: Dragon Realm, an intense magical action game built exclusively for VR.\nWield a powerful enchanted gauntlet that lets you catch, transform, and throw elemental attacks back at waves of ferocious dragons and mythical beasts. Defend the last watchtower of mankind in a kingdom engulfed by blazing volcanoes, ancient forests, and cursed caverns.\n\nImmersive Combat: Catch fireballs, ice shards, and shadow magic in mid-air, then hurl them back in spectacular slow-motion.\n\nMotion-Based Magic: Use your hands to draw symbols in the air and unleash shields, shockwaves, or time-freezing traps.\n\nEvolving Challenges: Survive escalating waves of smart enemies and face off against giant dragon bosses with unique abilities.\nUpgradeable Powers: Collect magical shards to enhance your gauntlet, unlock new spells, and customize your combat style.\nWith stunning visuals, 360\u00b0 enemy encounters, and heart-pounding gameplay, Catcher: Dragon Realm delivers a fantasy experience only possible in VR.\nAre you ready to face the storm?", "short_description": "Wield a magical gauntlet in VR Catcher: Dragon Realm and defend humanity\u2019s last watchtower from waves of dragons and mythical beasts. Catch incoming elemental attacks\u2014fire, ice, shadow\u2014and hurl them back in intense, motion-controlled VR combat. Unlock powerful spells, face epic bosses, and survive in a realm where every battle is a fight for survival. Feel the magic. Fight like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categor
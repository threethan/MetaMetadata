AuWX4LSrvsht1F0GQm4O_4mLeNiNU8DuWhCX2W7I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3cZEIEhBInjHyIT1-8tWpPiUlqyOI3a_Ywu_7THwzOyQ&oe=69EF6785"}, {"file_name": "Screenshots 3.png", "id": "1721636601935277", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820887_1721636605268610_3978112013961148936_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YESUAo6wroUQ7kNvwHfJPKJ&_nc_oc=AdpqKlgz8Usl_nMMidlxndiNYs0dwX9LRt0NaOs_ALGpWQuoRVCNkNtBYf-CusRshjI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0GQXR2xK14JzP58CoTLTQ5z-qYvR-RGuPC7tWQ6ilmyA&oe=69EF8061"}, {"file_name": "Screenshots (1).png", "id": "1980061262606161", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618069_1980061265939494_7210875179445160530_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFAn8S-FdGIQ7kNvwFmWQsi&_nc_oc=AdqAW-MJvpBmHvNYVZwhRVf3K58olfxFJz9tV1DixJ8s7i4JKuPcE_ExiFk6GFc2cgM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1KJEiT2laSfdfSsZXVO5qoTZe8IeFwXsHVbPVMQbxgxg&oe=69EF80C7"}, {"file_name": "Screenshots 4.png", "id": "917754494422831", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619187_917754497756164_5728536994928478939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KseqJfx3cx4Q7kNvwF7UMZ4&_nc_oc=Adrpoq-GSpA3rMyJbtE4L3BDjV1iLiIMt-ujyvh5JhulXksAA1uwYTXYZ5z98QNC_24&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2rCzFEt-3Yizi4FEntN2vEi7JnpOgBJhI4fTZSC5OCRw&oe=69EF5E6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1649975362697675", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491828087_1649975366031008_1619590723740937246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWGIicfUkv4Q7kNvwHbI0Yt&_nc_oc=Adq6ybnOxlnG9TI-k1Zi-oQXkkmPSlMxAt6IuxSuh5Y8YvyR3BeyV21c-OBxSdrGTBM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3fXJjOuRThCNY5N-nuJQFxVqgrF4JXSeIa1hbgi_7Tyw&oe=69EF6FC3"}, "display_name": "Catcher: Dragon Realm", "keywords": [], "long_description": "Step into the boots of a legendary Dragon Warrior in Catcher: Dragon Realm, an intense magical action game built exclusively for VR.\nWield a powerful enchanted gauntlet that lets you catch, transform, and throw elemental attacks back at waves of ferocious dragons and mythical beasts. Defend the last watchtower of mankind in a kingdom engulfed by blazing volcanoes, ancient forests, and cursed caverns.\n\nImmersive Combat: Catch fireballs, ice shards, and shadow magic in mid-air, then hurl them back in spectacular slow-motion.\n\nMotion-Based Magic: Use your hands to draw symbols in the air and unleash shields, shockwaves, or time-freezing traps.\n\nEvolving Challenges: Survive escalating waves of smart enemies and face off against giant dragon bosses with unique abilities.\nUpgradeable Powers: Collect magical shards to enhance your gauntlet, unlock new spells, and customize your combat style.\nWith stunning visuals, 360\u00b0 enemy encounters, and heart-pounding gameplay, Catcher: Dragon Realm delivers a fantasy experience only possible in VR.\nAre you ready to face the storm?", "short_description": "Wield a magical gauntlet in VR Catcher: Dragon Realm and defend humanity\u2019s last watchtower from waves of dragons and mythical beasts. Catch incoming elemental attacks\u2014fire, ice, shadow\u2014and hurl them back in intense, motion-controlled VR combat. Unlock powerful spells, face epic bosses, and survive in a realm where every battle is a fight for survival. Feel the magic. Fight like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categor
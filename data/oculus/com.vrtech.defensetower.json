gzhq-k0QLtP5k1f-QZt-ROWabNWK7kTHcT7PV7-M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Wog5gsd5d93z6SjzfSgN0T9HOba-BkaFcvgwF5Q_tAg&oe=69E77E85"}, {"file_name": "Screenshots 3.png", "id": "1721636601935277", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820887_1721636605268610_3978112013961148936_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yTMEnBDwPUQ7kNvwHBoIsf&_nc_oc=AdoxLivkUAgZ-pHViRM41WMMfRTtv6ZxlTWqDrfSC1qTb34xsPpPe1uuSPgwb7PAz1Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2b3krhXuHSETz_ihegKemFNSa_-OzmpbFRKxQLDTxObQ&oe=69E75F21"}, {"file_name": "Screenshots (1).png", "id": "1980061262606161", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618069_1980061265939494_7210875179445160530_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vs9wvGzA-10Q7kNvwEVO7nj&_nc_oc=AdouT_w8-_HnrkoDcTbZIKHbaYcwQZV4Cx8tcRfpk10O0MaFlA59CRjxHZVYW2g0pFA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_wyPEuE-Ich24B2b_xj4MRB-kSZmjReT9lq71XWXszw&oe=69E75F87"}, {"file_name": "Screenshots 4.png", "id": "917754494422831", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619187_917754497756164_5728536994928478939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GefjfN_d35gQ7kNvwGPWY_p&_nc_oc=AdoY5FKnrIWA3Ra4BKW-eCD5f-6wTuVgjf8c5bO_a28I5es4e82M5H-iaaPPvrQ4V1A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yvlgod_1po9UXJ0fVq91gdKRr71VMecqR1mDe4O5Jvw&oe=69E7756A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1649975362697675", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491828087_1649975366031008_1619590723740937246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8J_oc-8wlQQ7kNvwFn8RVM&_nc_oc=AdqaxaCFUOpbo3Fp_QkJmRdAYM8RwYCjySwGnuICeJmjfadQkLVnJ7bJY1hUugreOUQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3A5Kmwd7N2iFe_0Drx3Nt2yQGD57usoqTXZE8Jfx7jrA&oe=69E786C3"}, "display_name": "Catcher: Dragon Realm", "keywords": [], "long_description": "Step into the boots of a legendary Dragon Warrior in Catcher: Dragon Realm, an intense magical action game built exclusively for VR.\nWield a powerful enchanted gauntlet that lets you catch, transform, and throw elemental attacks back at waves of ferocious dragons and mythical beasts. Defend the last watchtower of mankind in a kingdom engulfed by blazing volcanoes, ancient forests, and cursed caverns.\n\nImmersive Combat: Catch fireballs, ice shards, and shadow magic in mid-air, then hurl them back in spectacular slow-motion.\n\nMotion-Based Magic: Use your hands to draw symbols in the air and unleash shields, shockwaves, or time-freezing traps.\n\nEvolving Challenges: Survive escalating waves of smart enemies and face off against giant dragon bosses with unique abilities.\nUpgradeable Powers: Collect magical shards to enhance your gauntlet, unlock new spells, and customize your combat style.\nWith stunning visuals, 360\u00b0 enemy encounters, and heart-pounding gameplay, Catcher: Dragon Realm delivers a fantasy experience only possible in VR.\nAre you ready to face the storm?", "short_description": "Wield a magical gauntlet in VR Catcher: Dragon Realm and defend humanity\u2019s last watchtower from waves of dragons and mythical beasts. Catch incoming elemental attacks\u2014fire, ice, shadow\u2014and hurl them back in intense, motion-controlled VR combat. Unlock powerful spells, face epic bosses, and survive in a realm where every battle is a fight for survival. Feel the magic. Fight like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categor
i4a9x2KFKwq7QcZiaKJ9DI7-3d_jNyxPwKiJq954&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yAVHq6vsQLCe2XjP1egET7itoBrP3bTGqDMoxU8Asww&oe=69E8D005"}, {"file_name": "Screenshots 3.png", "id": "1721636601935277", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820887_1721636605268610_3978112013961148936_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBw38iiOcMEQ7kNvwG0pZc5&_nc_oc=AdodYd_2PnAOzcd0ab8itrHDYHqfos9oehoxAxLt9ElsRCA-dJPPE9u4q5r216a1IJE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yCdZXfurZjhq29lMS6AOyHfewpxBU5yxWdihTlhSGiw&oe=69E8B0A1"}, {"file_name": "Screenshots (1).png", "id": "1980061262606161", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618069_1980061265939494_7210875179445160530_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vs9wvGzA-10Q7kNvwFTpfaY&_nc_oc=AdqHvzdXinRxL6UInp7wykvaX0_sqtr9Ggjcoe-q6mIr9W_K8QAnzRsvVAiaf7DXKCU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0o25lTBweB3jOIzUZv1NR7QKXOsgRodvxkY3dXULQfUg&oe=69E8B107"}, {"file_name": "Screenshots 4.png", "id": "917754494422831", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619187_917754497756164_5728536994928478939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWlfu4d7uhsQ7kNvwEhRPdH&_nc_oc=Adqy3DtruHyN8D0saRqJGbDBctZg6TEekUxv95R69KL8wdrZMUB0I8YE0Y7OCJ3BsMI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ODoNqmEMkp1Fg9v7Wuiu93JL89uaGCU86tVCiDUucQw&oe=69E8C6EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1649975362697675", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828087_1649975366031008_1619590723740937246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8J_oc-8wlQQ7kNvwEYRaRs&_nc_oc=AdqScWHy9OpHsu3JujgSVt6iALZJrsA2IHXb-BDfO075TR-6ap3jYtYoXsuSFkErSNo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18o8eeLzmpkla3Uv52pySbvKjvtTxJsvTsDT4fGYHe9A&oe=69E8D843"}, "display_name": "Catcher: Dragon Realm", "keywords": [], "long_description": "Step into the boots of a legendary Dragon Warrior in Catcher: Dragon Realm, an intense magical action game built exclusively for VR.\nWield a powerful enchanted gauntlet that lets you catch, transform, and throw elemental attacks back at waves of ferocious dragons and mythical beasts. Defend the last watchtower of mankind in a kingdom engulfed by blazing volcanoes, ancient forests, and cursed caverns.\n\nImmersive Combat: Catch fireballs, ice shards, and shadow magic in mid-air, then hurl them back in spectacular slow-motion.\n\nMotion-Based Magic: Use your hands to draw symbols in the air and unleash shields, shockwaves, or time-freezing traps.\n\nEvolving Challenges: Survive escalating waves of smart enemies and face off against giant dragon bosses with unique abilities.\nUpgradeable Powers: Collect magical shards to enhance your gauntlet, unlock new spells, and customize your combat style.\nWith stunning visuals, 360\u00b0 enemy encounters, and heart-pounding gameplay, Catcher: Dragon Realm delivers a fantasy experience only possible in VR.\nAre you ready to face the storm?", "short_description": "Wield a magical gauntlet in VR Catcher: Dragon Realm and defend humanity\u2019s last watchtower from waves of dragons and mythical beasts. Catch incoming elemental attacks\u2014fire, ice, shadow\u2014and hurl them back in intense, motion-controlled VR combat. Unlock powerful spells, face epic bosses, and survive in a realm where every battle is a fight for survival. Feel the magic. Fight like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categor
2c61ZX25B4RmnEIvWSaRKQp0DnlywIMix6rVUMpk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NHQ0sUsq4YhPqI3EDDTMbbmTljK-ztDtjUCnQu47IVw&oe=69FB4505"}, {"file_name": "Screenshots 3.png", "id": "1721636601935277", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820887_1721636605268610_3978112013961148936_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kug82AhM7XMQ7kNvwE5MgQC&_nc_oc=Adq69EmP_fSpizg0feolcI7pCpgNfhidPq-kScdEhXLKDMc7UMHg8aUc7-e2C7T-d1Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fDUMhTZMzc6T8as17iK0kdUcwJ3SyWXUch3TwMQgcBQ&oe=69FB5DE1"}, {"file_name": "Screenshots (1).png", "id": "1980061262606161", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618069_1980061265939494_7210875179445160530_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1u2TOB62BwQ7kNvwEkOIgZ&_nc_oc=Adpip7MhWiCibD4SiAA55zUvEnTIhWLG-n3vOWgnHtb9eV-0Pei7jgNnQjgr6GdSiAc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kfJf7Nm1dk3UPEqVlXo3Q69-vU2RGPQm7IcyDI1F-DA&oe=69FB5E47"}, {"file_name": "Screenshots 4.png", "id": "917754494422831", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619187_917754497756164_5728536994928478939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_feFgH2Xe8Q7kNvwEJPH5X&_nc_oc=AdpADTWey5Co-UE2kO8cXf634-xsdYXXiO_YZf7P5X9-2aL8DdYdBgSMWuhii-I2mXo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47jZ2T362Y8NI7iAkRScouxf1VvE0BlbWv5t6N2GyyuQ&oe=69FB3BEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1649975362697675", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828087_1649975366031008_1619590723740937246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhcMWSOkEPQQ7kNvwGO5xs8&_nc_oc=AdrpI-XR_lbRx7f1Vm6LtIb9Dqhma4v8oNO8xNRQKE3Pb6UuNCca-apC1zTWdx32vf8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6J8HPXYSwr5LiH6zVwmiOfXQjQTyi_2g-JYaehHoThOA&oe=69FB4D43"}, "display_name": "Catcher: Dragon Realm", "keywords": [], "long_description": "Step into the boots of a legendary Dragon Warrior in Catcher: Dragon Realm, an intense magical action game built exclusively for VR.\nWield a powerful enchanted gauntlet that lets you catch, transform, and throw elemental attacks back at waves of ferocious dragons and mythical beasts. Defend the last watchtower of mankind in a kingdom engulfed by blazing volcanoes, ancient forests, and cursed caverns.\n\nImmersive Combat: Catch fireballs, ice shards, and shadow magic in mid-air, then hurl them back in spectacular slow-motion.\n\nMotion-Based Magic: Use your hands to draw symbols in the air and unleash shields, shockwaves, or time-freezing traps.\n\nEvolving Challenges: Survive escalating waves of smart enemies and face off against giant dragon bosses with unique abilities.\nUpgradeable Powers: Collect magical shards to enhance your gauntlet, unlock new spells, and customize your combat style.\nWith stunning visuals, 360\u00b0 enemy encounters, and heart-pounding gameplay, Catcher: Dragon Realm delivers a fantasy experience only possible in VR.\nAre you ready to face the storm?", "short_description": "Wield a magical gauntlet in VR Catcher: Dragon Realm and defend humanity\u2019s last watchtower from waves of dragons and mythical beasts. Catch incoming elemental attacks\u2014fire, ice, shadow\u2014and hurl them back in intense, motion-controlled VR combat. Unlock powerful spells, face epic bosses, and survive in a realm where every battle is a fight for survival. Feel the magic. Fight like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categor
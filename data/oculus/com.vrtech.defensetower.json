esYxoyB3LAHCQV26ERQj3QK4UQTW30bcj1om6-SU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af33Lo6Ar1HafW1TCQ9gGSJWk_R6PpAiF2f4O4aQiQLICg&oe=69F5FF05"}, {"file_name": "Screenshots 3.png", "id": "1721636601935277", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820887_1721636605268610_3978112013961148936_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HbJGNHu0cOYQ7kNvwGOIMtN&_nc_oc=Adq6bzxWbFsw6jJg-z5Z1T5L9Wt2mwiPq6PYE_dW2t343tsZyhBc2jOE3JdwfRT5zqE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3oLa41ZSkqUmD33LsFJAE7Q8iwp1tAl5Nt7Y3NVOsSsA&oe=69F617E1"}, {"file_name": "Screenshots (1).png", "id": "1980061262606161", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499618069_1980061265939494_7210875179445160530_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KrjiwMoF_aEQ7kNvwEbbVqd&_nc_oc=AdqC6u3GjVoK5QQfcAK-aEwbyyjaJATfCtt9r4b69wXMeL89H1kYp6qO5r-swykz2QI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2FHVLSAyFZCW-85kzpttaCBe_mYCvSaIKR-8W4JtRwfQ&oe=69F61847"}, {"file_name": "Screenshots 4.png", "id": "917754494422831", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619187_917754497756164_5728536994928478939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DH31lI0h3mcQ7kNvwGf1vwE&_nc_oc=AdoW6a4vhovacRB2LxiaIFMJMnJy_wXm7vmLPYf47kZVkzkpnkhQW7Bw_zZEhs8B1Ec&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2OipWJcXOB6zA9s0rQ70MpZaXfGsoCBWnADMIVB8Y1RA&oe=69F5F5EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1649975362697675", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491828087_1649975366031008_1619590723740937246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsVvFVs8emkQ7kNvwF1TnNJ&_nc_oc=Adp1-I2kAMqUH0n7UkQR5bJw-1XbrAjvoIzdxw1QeglOMpLNN5yHbSS9ofAfELRZSBs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2yXCKwiC6GezJcw5E-274Tl_7eB-cvNXKJ2_hvI7PsMA&oe=69F60743"}, "display_name": "Catcher: Dragon Realm", "keywords": [], "long_description": "Step into the boots of a legendary Dragon Warrior in Catcher: Dragon Realm, an intense magical action game built exclusively for VR.\nWield a powerful enchanted gauntlet that lets you catch, transform, and throw elemental attacks back at waves of ferocious dragons and mythical beasts. Defend the last watchtower of mankind in a kingdom engulfed by blazing volcanoes, ancient forests, and cursed caverns.\n\nImmersive Combat: Catch fireballs, ice shards, and shadow magic in mid-air, then hurl them back in spectacular slow-motion.\n\nMotion-Based Magic: Use your hands to draw symbols in the air and unleash shields, shockwaves, or time-freezing traps.\n\nEvolving Challenges: Survive escalating waves of smart enemies and face off against giant dragon bosses with unique abilities.\nUpgradeable Powers: Collect magical shards to enhance your gauntlet, unlock new spells, and customize your combat style.\nWith stunning visuals, 360\u00b0 enemy encounters, and heart-pounding gameplay, Catcher: Dragon Realm delivers a fantasy experience only possible in VR.\nAre you ready to face the storm?", "short_description": "Wield a magical gauntlet in VR Catcher: Dragon Realm and defend humanity\u2019s last watchtower from waves of dragons and mythical beasts. Catch incoming elemental attacks\u2014fire, ice, shadow\u2014and hurl them back in intense, motion-controlled VR combat. Unlock powerful spells, face epic bosses, and survive in a realm where every battle is a fight for survival. Feel the magic. Fight like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categor
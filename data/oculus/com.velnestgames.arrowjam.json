NMiqihmUEURzGIoDK7vckoY-RwDBdBMA&oe=6B01DE0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "2350821752410935", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/613094043_2350821755744268_6185919050503820616_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_U9yREcmUE0Q7kNvwFMVHiY&_nc_oc=AdrsAkQigdhtCm003OYDVmyf391nvYJHf1ZW5FQfrVsJHGnlTeLYjH99Y1Vt4HlncCQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPRjzVkNAa2ELnLi1gjeYmOCunqDiO_2YaW86TPa3ixA&oe=6B01D6F4"}, "display_name": "Arrow Jam : Tap Away Puzzle", "keywords": ["logic", "puzzle", "casual", "relaxing", "arrow"], "long_description": "#  Arrow Jam Tap Away Puzzle \u2014 Every arrow wants out \u2014 but only a clear path lets it escape.\n\n**Arrow Jam** is a satisfying tap away puzzle where every move matters. Study the board, tap arrows in the right order, and clear each jam before three wrong moves cost all your lives.\n\n{1407524014144489}\n\n# DISCOVER PICTURE-SHAPED PUZZLES\nNot every board is a plain square. Untangle hearts, stars, trophies, symbols, and other recognizable shapes, mixed with classic geometric arrow mazes.\n\n{1412760364296712}\n\n# KEEP PLAYING AFTER LEVEL 1,000\nComplete the main campaign and continue with Extra Levels for an endless arrow puzzle challenge.\n\n# WHY YOU\u2019LL ENJOY ARROW JAM\n- 1,000 unique campaign levels plus endless extra levels.\n- Picture shapes and classic geometric layouts.\n- Five difficulty tiers: Easy, Normal, Hard, Super Hard, and Nightmare with a smooth, carefully balanced difficulty curve.\n- Four colorful visual themes.\n- Replay unlocked levels and resume unfinished boards (progress auto saved).\n- Helpful hints (3 per level) when you are stuck.\n- Offline play with no time limits.\n- Smooth controls (hands or controller), sounds, and haptic feedback.\n- Single-player. No ads. No subscriptions. No in-app purchases.\n\n# BUILT FOR PURE LOGIC & FUN\nWhether you want a relaxing brain break or a huge logic challenge, Arrow Jam grows from quick tap away puzzles into massive Nightmare mazes with hundreds of interlocked arrows.\n\n{1465612568715115}", "short_description": "Arrow Jam Tap Away Puzzle \u2014 A challenging puzzle game \u2014 Begin with welcoming puzzles, then take on 1,000 increasingly clever challenges \u2014 From picture shapes to Nightmare mazes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://velnestgames.com/legal/privacy-policy", "developer_terms_of_service_url": "https://velnestgames.com/legal/terms-of-service", "publisher_name": "Vel Nest Games", "support_website_url": "https://velnestgames.com/#contact", "website_url": "https://velnestgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1298072576720945"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1157169143510801"}, {"status": "CANCELLED", "id": "1104690765763598"}, {"status": "PUBLISHED", "id": "1108791441525019"}]}, "baseline_offer": {"id": "1108791441525019"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791903600, "status": "PUBLISHED", "id": "1157169143510801"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1328233800371489", "version": "0.5.22"}, "id": "1515064737306239", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1298072560054280", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1328233800371489"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1515064737306239"}]}, "change_log": "# WELCOME TO ARROW JAM\nThe launch release of the tap-away arrow puzzle, made for Meta Quest.\n\n> PUZZLES\n- 1,000 levels, from welcoming warm-ups and picture-shaped puzzles to Nightmare mazes.\n- Tap an arrow to slide it off the board; a blocked arrow costs one of 3 hearts.\n- Hints and a Direction Guide for when you're stuck.\n\n> PLAY YOUR WAY\n- Touch controllers or hand tracking: point and pull the trigger, hand pinch, or poke the buttons directly with your fingers or controller.\n- Both hands play at once; pick your dominant hand in Settings.\n- Seated or standing, with a board you can resize, move, tilt and recenter.\n\n> COMFORT & STYLE\n- Four color themes that also color your hands and controllers.\n- High contrast, reduced motion and large text.\n- Adjustable music, sound effects and haptics.\n- A cozy studio with a night-sky view, or optional passthrough.\n\n> NOTES\n- Progress saves automatically, including the level you're on.\n- No ads, no in-app purchases, no account needed.", "created_date": 1790504756, "id": "1328233800371489", "version": "0.5.22", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1298072560054280", "is_concept": false, "latest_r
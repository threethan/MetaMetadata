&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcAGG7aoFUcQ7kNvwHJtMxG&_nc_oc=Adqp6zPtKiQB9XwtYgOUXFPNfWp3D8wZBwjpjrZDX3tbEqC6axav2zkcOV0r6kXMdNo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjluGSNaoUq8DixG6RIqbCWc0x1BVdzFaE7eRCg-3iQg&oe=6AFDC7A6"}, {"file_name": "05-cascade-third-person.png", "id": "1128514976418530", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_1128514979751863_190551073590969946_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGQC2WX6iAgQ7kNvwHzi5Sp&_nc_oc=Adoi6V8gBQTyKdjDj5sIArVNc3Zjq-8cn3TaOlCODlQxgYXBurs6rUmr2ZYj4TryofE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6Zk__cjScpUVlr6Bmahs-K4vAbOPKAnGongatFFJjGg&oe=6AFDB14E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "2350821752410935", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/613094043_2350821755744268_6185919050503820616_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OROlzDdU2gQ7kNvwGcji-8&_nc_oc=AdqggvHQjTPDAE0H6IoGLHsM-2cn4d7Q3aCQBeoie_Fezb0zbVHfkWnCbzF0Ul50O_E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSF3e8KgGg3pcStrvon-iHNuXx-boevVRHU_ZuBEutGpA&oe=6AFDE274"}, "display_name": "Arrow Jam : Tap Away Puzzle", "keywords": ["logic", "puzzle", "casual", "relaxing", "arrow"], "long_description": "#  Arrow Jam Tap Away Puzzle \u2014 Every arrow wants out \u2014 but only a clear path lets it escape.\n\n**Arrow Jam** is a satisfying tap away puzzle where every move matters. Study the board, tap arrows in the right order, and clear each jam before three wrong moves cost all your lives.\n\n{1407524014144489}\n\n# DISCOVER PICTURE-SHAPED PUZZLES\nNot every board is a plain square. Untangle hearts, stars, trophies, symbols, and other recognizable shapes, mixed with classic geometric arrow mazes.\n\n{1412760364296712}\n\n# KEEP PLAYING AFTER LEVEL 1,000\nComplete the main campaign and continue with Extra Levels for an endless arrow puzzle challenge.\n\n# WHY YOU\u2019LL ENJOY ARROW JAM\n- 1,000 unique campaign levels plus endless extra levels.\n- Picture shapes and classic geometric layouts.\n- Five difficulty tiers: Easy, Normal, Hard, Super Hard, and Nightmare with a smooth, carefully balanced difficulty curve.\n- Four colorful visual themes.\n- Replay unlocked levels and resume unfinished boards (progress auto saved).\n- Helpful hints (3 per level) when you are stuck.\n- Offline play with no time limits.\n- Smooth controls (hands or controller), sounds, and haptic feedback.\n- Single-player. No ads. No subscriptions. No in-app purchases.\n\n# BUILT FOR PURE LOGIC & FUN\nWhether you want a relaxing brain break or a huge logic challenge, Arrow Jam grows from quick tap away puzzles into massive Nightmare mazes with hundreds of interlocked arrows.\n\n{1465612568715115}", "short_description": "Arrow Jam Tap Away Puzzle \u2014 A challenging puzzle game \u2014 Begin with welcoming puzzles, then take on 1,000 increasingly clever challenges \u2014 From picture shapes to Nightmare mazes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://velnestgames.com/legal/privacy-policy", "developer_terms_of_service_url": "https://velnestgames.com/legal/terms-of-service", "publisher_name": "Vel Nest Games", "support_website_url": "https://velnestgames.com/#contact", "website_url": "https://velnestgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported
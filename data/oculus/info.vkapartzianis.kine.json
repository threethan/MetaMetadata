": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818852_4423681047952671_845923029263316754_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDXhkZfjs4MQ7kNvwE1ARcP&_nc_oc=Adorxq5BLjTq9GXa4AUOaG19qLSEN1xdWl0CZatXV33Y-0xyJ_zkn0WE1iFF1oOv4Mg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LLU7OFhTuKIlsqSbgQnwEBqYbE7QVG4xRlLi9gse96g&oe=6A2AD276"}, {"file_name": "kodi_frame_05_2560x1440.png", "id": "970596055369150", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304131_970596058702483_4257246551762588974_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNVCfUiSp_UQ7kNvwGcuZT9&_nc_oc=Adpn1YqBQlPa3bH5B-FuycCeFmRTlwhUiZKUZS2cczjdItga2Ps6jcBsGsPcABTFoso&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UigViRlxGdB7EIowhaSMgpXWsEP5zdFQwyn3o0PkMbA&oe=6A2AE1C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kine", "keywords": [], "long_description": "Kine is a Quest-optimized fork of Kodi, the award-winning free and open-source media player and entertainment hub. It adds controller-friendly navigation, seamless HDR10, Dolby Vision and Dolby Atmos playback, plus a built-in VR player for 3D movies, including MVC, SBS and TAB videos in ISO, MKV and MP4 containers.\n\nWith its **beautiful interface and powerful skinning engine**, Kine is the ideal solution for your Quest \"home theater\".\n\n# Give your media the love it deserves\n\nKine can be used to play almost all popular audio and video formats around. It was designed for network playback, so you can stream your multimedia from anywhere in the house or directly from the internet using practically any protocol available.\n\nPoint Kine to your media and watch it **scan and automagically create a personalized library** complete with box covers, descriptions, and fanart. There are playlist and slideshow functions, a weather forecast feature and many audio visualizations. Once installed, your Quest will become a fully functional multimedia jukebox.\n", "short_description": "Kine is a Quest-optimized fork of Kodi, the award-winning free and open-source media player and entertainment hub. It adds controller-friendly navigation, seamless HDR10, Dolby Vision and Dolby Atmos playback, plus a built-in VR player for 3D movies, including MVC, SBS and TAB videos in ISO, MKV and MP4 containers."}]}, "developer_name": "Team Kine", "developer_privacy_policy_url": "https://github.com/vkapartzianis/xbmc/blob/Omega/PRIVACY.md", "developer_terms_of_service_url": null, "publisher_name": "Team Kine", "support_website_url": null, "website_url": "https://github.com/vkapartzianis/xbmc", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26684701914479563"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "985553277277190"}]}, "baseline_offer": {"id": "985553277277190"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779126360, "status": "PUBLISHED", "id": "985553277277190"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27167140986235651", "version": "21.3"}, "id": "1443016143817361", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26684701887812899", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27167140986235651"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1780700374, "id": "27207842265498856", "version": "21.3", "version_code": 2103104, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26684701887812899", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27167140986235651"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1443016143817361"}]}, "change_log": "Reworked Blu-ray ISO handling: the simplified menu now clearly offers \"Play main movie\", \"Select from all titles\", and \"Show Blu-ray menu\", with direct ISO identity preserved. VR routing for Blu-ray is now stricter and more predictable: VR opens direct ISO main-movie playback only, while explicit Blu-ray structure/title/menu paths stay in Kine 2D. Fixed built-in VR playback for local files. Improved Android startup flow with a cleaner splash/loading overlay and better permission messaging. Default video play/select actions now resume playback by default. Fixed temporary metadata/artwork loss after playing .strm files.  Improved startup/library responsiveness with tuned background workers and optimized video unique-ID lookups. Added BD3D subtitle metadata parsing for future 3D subtitle handling improvements. Removed/disabled the obsolete version-check add-on. Added Android startup/packaging safeguards, including target validation and cleanup of unused startup assets.", "created_date": 1780438591, "id": "27167140986235651", "version": "
=00_AQVvG-pfkfHI7JGc-v4DEdTaN5eZDTGFtFPDAaIQe_FUZg&oe=6B105F8F"}, {"file_name": "kodi_frame_02_2560x1440.png", "id": "1524246659495360", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823905_1524246662828693_3590256292252772559_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfMNWztvcwIQ7kNvwGqsWs1&_nc_oc=AdpcNeVhQnN9wjzWKeGXgNH9fUzYEegjfjYoPLZhTh-xLHNurB5Z5JD6F8DddD9oE1I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWh_dTk4mdD_Yh9Fw-Vpp3aXQbfpgmdT-5pbyreSEUjEA&oe=6B1036F8"}, {"file_name": "kodi_frame_03_2560x1440.png", "id": "1520869906099776", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821568_1520869909433109_7185269132793701777_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_7fZIhJ9icQ7kNvwGm66VY&_nc_oc=AdrXLH0dau95zwCTtp1g8aAA3R015Ywgun0sVqstCFytHIV-4EjfuSsuWQKrBSV9Nrk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX-OVXJIGTmuNfb1bAz0ABfTIU_LYjwf-clwlU_SWBE5A&oe=6B106810"}, {"file_name": "kodi_frame_04_2560x1440.png", "id": "4423681044619338", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818852_4423681047952671_845923029263316754_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7XUIeb7Dq4Q7kNvwFDhZH1&_nc_oc=AdorGxzguLgmj3-2uNzD7WLWMovKhjH6T-9OfVDySLDoRBYhVo7e6GOqbXEYGYbNRKU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXrw3jWX-Xea_Dfh8zd2EW_-B-5KNIkgs5nHNHbtjHW_w&oe=6B103776"}, {"file_name": "kodi_frame_05_2560x1440.png", "id": "970596055369150", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304131_970596058702483_4257246551762588974_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8a5Fqhp404Q7kNvwHzI-FT&_nc_oc=AdqADoykTtFS0kIkA9QOU4MUJojiH6X0FkD0wnQFNMyHv3OBCCycjYTHkOYloHY3odY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWtQo25ayHm5ulasJXQvBNCzC8skWdbBaNb3gsWyQotSw&oe=6B1046C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kine", "keywords": [], "long_description": "Kine is a Quest-optimized fork of Kodi, the award-winning free and open-source media player and entertainment hub. It adds controller-friendly navigation, seamless HDR10, Dolby Vision and Dolby Atmos playback, plus a built-in VR player for 3D movies, including MVC, SBS and TAB videos in ISO, MKV and MP4 containers.\n\nWith its **beautiful interface and powerful skinning engine**, Kine is the ideal solution for your Quest \"home theater\".\n\n# Give your media the love it deserves\n\nKine can be used to play almost all popular audio and video formats around. It was designed for network playback, so you can stream your multimedia from anywhere in the house or directly from the internet using practically any protocol available.\n\nPoint Kine to your media and watch it **scan and automagically create a personalized library** complete with box covers, descriptions, and fanart. There are playlist and slideshow functions, a weather forecast feature and many audio visualizations. Once installed, your Quest will become a fully functional multimedia jukebox.\n", "short_description": "Kine is a Quest-optimized fork of Kodi, the award-winning free and open-source media player and entertainment hub. It adds controller-friendly navigation, seamless HDR10, Dolby Vision and Dolby Atmos playback, plus a built-in VR player for 3D movies, including MVC, SBS and TAB videos in ISO, MKV and MP4 containers."}]}, "developer_name": "Team Kine", "developer_privacy_policy_url": "https://github.com/vkapartzianis/xbmc/blob/Omega/PRIVACY.md", "developer_terms_of_service_url": null, "publisher_name": "Team Kine", "support_website_url": null, "website_url": "https://github.com/vkapartzianis/xbmc", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26684701914479563"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "985553277277190"}]}, "baseline_offer": {"id": "985553277277190"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779126360, "status": "PUBLISHED", "id": "985553277277190"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29438183512464709", "version": "21.3"}, "id": "1443016143817361", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26684701887812899", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29438183512464709"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1443016143817361"}]}, "change_log": "Improved compatibility with legacy Android ARM64 binary add-ons.", "created_date": 1795808439, "id": "29438183512464709", "version": "21.3", "version_code": 2103119, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26684701887812899", "is_concept": false, "latest_relea
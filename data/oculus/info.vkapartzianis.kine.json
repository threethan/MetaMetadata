/v/t64.5771-25/491823905_1524246662828693_3590256292252772559_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvrcWKZvCFQQ7kNvwHWqtBB&_nc_oc=AdpSWL0yo6CLt_P4VKdbIpT4RPFny3ifgedfgRuZplOdevy-jgUSaHG93bTgz0GXoDw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL04VmAbO6xb3DQkCNFNpLPzPJkL6A7c2nm6M4VBiVP9Q&oe=6A998FF8"}, {"file_name": "kodi_frame_03_2560x1440.png", "id": "1520869906099776", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821568_1520869909433109_7185269132793701777_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEZya43rbxAQ7kNvwFy4HCW&_nc_oc=AdqYJI0NI0_gKX6mpM11BvB14rIYw_rsTDsufRHZwrVCJdJUaq_fv3G9BBRcvMk6Unw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMel_mflCPFG3ui7Sj8uDD1kzqy0-LuIVA2S0ipNE_gw&oe=6A9988D0"}, {"file_name": "kodi_frame_04_2560x1440.png", "id": "4423681044619338", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818852_4423681047952671_845923029263316754_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8INaZGvqf8Q7kNvwEeoMpJ&_nc_oc=AdqByiz7YZoE-MkOK3GuSsurRc775Fbyazmcgsv_a2UzM8jC3TgBLjKV5ESsmJgmE6w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfVUyl07X68VJph6ogQ7XseBZqFyYRBKrgTYcimvioVA&oe=6A999076"}, {"file_name": "kodi_frame_05_2560x1440.png", "id": "970596055369150", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304131_970596058702483_4257246551762588974_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEogqyHDtm0Q7kNvwEWRida&_nc_oc=AdrAxwNaDV2XaUE_3MygxGgE7ZMeE9V4BMMdWHPhQO5yNexkvuI0M3lAIFKf2tooKAo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEYumJTvCG-pUwuTnJHtycx4IQ4rcyJWjB9ZIKXIo1Aw&oe=6A999FC8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kine", "keywords": [], "long_description": "Kine is a Quest-optimized fork of Kodi, the award-winning free and open-source media player and entertainment hub. It adds controller-friendly navigation, seamless HDR10, Dolby Vision and Dolby Atmos playback, plus a built-in VR player for 3D movies, including MVC, SBS and TAB videos in ISO, MKV and MP4 containers.\n\nWith its **beautiful interface and powerful skinning engine**, Kine is the ideal solution for your Quest \"home theater\".\n\n# Give your media the love it deserves\n\nKine can be used to play almost all popular audio and video formats around. It was designed for network playback, so you can stream your multimedia from anywhere in the house or directly from the internet using practically any protocol available.\n\nPoint Kine to your media and watch it **scan and automagically create a personalized library** complete with box covers, descriptions, and fanart. There are playlist and slideshow functions, a weather forecast feature and many audio visualizations. Once installed, your Quest will become a fully functional multimedia jukebox.\n", "short_description": "Kine is a Quest-optimized fork of Kodi, the award-winning free and open-source media player and entertainment hub. It adds controller-friendly navigation, seamless HDR10, Dolby Vision and Dolby Atmos playback, plus a built-in VR player for 3D movies, including MVC, SBS and TAB videos in ISO, MKV and MP4 containers."}]}, "developer_name": "Team Kine", "developer_privacy_policy_url": "https://github.com/vkapartzianis/xbmc/blob/Omega/PRIVACY.md", "developer_terms_of_service_url": null, "publisher_name": "Team Kine", "support_website_url": null, "website_url": "https://github.com/vkapartzianis/xbmc", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26684701914479563"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "985553277277190"}]}, "baseline_offer": {"id": "985553277277190"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779126360, "status": "PUBLISHED", "id": "985553277277190"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27522928833990196", "version": "21.3"}, "id": "1443016143817361", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26684701887812899", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27522928833990196"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1443016143817361"}]}, "change_log": "Fix VR player launching, broken by updates to Horizon OS's interstitial manager.", "created_date": 1782938979, "id": "27522928833990196", "version": "21.3", "version_code": 2103112, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26684701887812899", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27522928833990196"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1443016143817361"}]}, "change_log": "Updated IntroDB Kine addon to 3.0.1 and Arctic Fuse 2 to 2.12.111, in order to optimize segment skipping and better integrate it with the OSD. Fixed minor bugs.", "created_date": 1782832115, "id": "27508168048799608", "version": "21.3", "version_code": 2103111, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26684701887812899", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27522928833990196"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1782739879, "id": "27494489166834163", "version": "21.3", "version_code": 2103110, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26684701887812899", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27522928833990196"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1443016143817361"}]}, "change_log": "Added a first-run interface selector with Simplified, Standard, and Advanced setup paths. Improved the bundled Arctic Fuse 2 setup flow, including first-run widget setup and better touch focus for Home widgets. Improved \u201cPlay in VR\u201d handling for plugin and .strm items by routing it through Kodi\u2019s normal playback path more consistently. Fixed playback edge cases involving multi-step plugin/PVR URL resolution and playlist loading. Improved Android stability by avoiding lifecycle/state-save work that could trigger ANRs or crashes. Fixed an Android network JNI crash that could occur while loading artwork. Refined video startup/viewport handling and reduced redundant video resolution changes.", "created_date": 1782349629, "id": "27443082755308138", "version": "21.3", "version_code": 2103109, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26684701887812899", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27522928833990196"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1443016143817361"}]}, "change_log": "Improved 3D video detection for remote and encoded filenames, including percent-encoded URLs, BD25/BD50/BD66/BD100 + 3D MVC ISO names, and SideBySide / TopAndBottom filename variants. Improved \u201cPlay in VR\u201d routing so it goes through Kodi\u2019s normal playback path more consistently, including forced VR Blu-ray playback. Fixed an MVC recovery case where video could remain hidden after buffering/rebuffer recovery. Improved handling of unsupported 2D ISO playback in VR so it stops cleanly instead of surfacing as a generic playback failure. Updated core formatting/logging dependencies and cleaned up debug-only noise for a leaner build.", "created_date": 1782060906, "id": "27404788139137600", "version": "21.3", "version_code": 2103108, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
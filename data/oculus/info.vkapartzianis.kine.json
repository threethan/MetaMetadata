1.oculuscdn.com/v/t64.5771-25/491818852_4423681047952671_845923029263316754_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_gl1Ns_-6EQ7kNvwGV9UvR&_nc_oc=Ado5-lswI_YsNZ8dsyCts87WlLRzmEIrzwfBLafaW7samToEGlorrT0ify-QkliLcfA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5n4FvifqWGwn9jVP4e_RoYE3r6lbX2r60-NUMgbIvFXw&oe=6A1B0076"}, {"file_name": "kodi_frame_05_2560x1440.png", "id": "970596055369150", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499304131_970596058702483_4257246551762588974_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvhaaLB2ZL4Q7kNvwEzuvDV&_nc_oc=Adp8dh9eIzEZaxPazRx9a0D0G8Q61GZcUlC1m5acp1Hc-YcvOroMtjCy66_15-egxhU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HXlg46cTapiK48tdfrosIORxqWPywGZcjPKSC1_mnwQ&oe=6A1AD788"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kine", "keywords": [], "long_description": "Kine is a Quest-optimized fork of Kodi, the award-winning free and open-source media player and entertainment hub. It adds controller-friendly navigation, seamless HDR10, Dolby Vision and Dolby Atmos playback, plus a built-in VR player for 3D movies, including MVC, SBS and TAB videos in ISO, MKV and MP4 containers.\n\nWith its **beautiful interface and powerful skinning engine**, Kine is the ideal solution for your Quest \"home theater\".\n\n# Give your media the love it deserves\n\nKine can be used to play almost all popular audio and video formats around. It was designed for network playback, so you can stream your multimedia from anywhere in the house or directly from the internet using practically any protocol available.\n\nPoint Kine to your media and watch it **scan and automagically create a personalized library** complete with box covers, descriptions, and fanart. There are playlist and slideshow functions, a weather forecast feature and many audio visualizations. Once installed, your Quest will become a fully functional multimedia jukebox.\n", "short_description": "Kine is a Quest-optimized fork of Kodi, the award-winning free and open-source media player and entertainment hub. It adds controller-friendly navigation, seamless HDR10, Dolby Vision and Dolby Atmos playback, plus a built-in VR player for 3D movies, including MVC, SBS and TAB videos in ISO, MKV and MP4 containers."}]}, "developer_name": "Team Kine", "developer_privacy_policy_url": "https://github.com/vkapartzianis/xbmc/blob/Omega/PRIVACY.md", "developer_terms_of_service_url": null, "publisher_name": "Team Kine", "support_website_url": null, "website_url": "https://github.com/vkapartzianis/xbmc", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26684701914479563"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823812_996579716490933_6165378479761469867_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YkfUlIO2D_cQ7kNvwHCWeAp&_nc_oc=AdrU07huCDHpOSX0rKrPVihaSvtb1wEFJYKiAslNa9tchdJGm3OmlTyXcq409X3yhqQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43fOzXwZ2lEwxXd1NFQ0VwBNDd5rseo3T5vMTMwVsTGw&oe=6A1AEEAA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Kine", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Med
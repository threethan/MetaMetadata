ontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821193_1268663331783483_6747227713441019138_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wE4-W3WUaUsQ7kNvwF4JKOy&_nc_oc=AdrP6OsB3ALCL1DfCWAa0Ust0fXwNzje0At-eB0_yvOIX_yrqDuOpyphcWCSoMkQUR0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWeXsegeXIZNUV3JhY1jm3qMe5zPvgpXAQtVFCf3jVL1g&oe=6B106C24"}, {"file_name": "ss1.png", "id": "1429867155480767", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308131_1429867158814100_195231298877100231_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkSKtfAvqDEQ7kNvwEYroEs&_nc_oc=Adp6Y80bRDXoq8OcH3Jgdy1R7hv-Aj1nWrKVDesljjplwfJGoALLzv00KED5oWf3CVY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVyi-w0XwYpcyjSZgWtbpMr8LMyDUFW9CQMhOVmpVg9ZQ&oe=6B105538"}, {"file_name": "ss3.png", "id": "2376318332830903", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304106_2376318336164236_3080670963787475875_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_BJjOV4spR4Q7kNvwHMq6L9&_nc_oc=Adrr8DpSxMnL2VEWX_N3LwfW2TablN5rB_YU2Q8vEk06VVKLvAc79Wn9Ee7z-Rz96yI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVIITXLsErrcRiG3-yEkdCIIf9oiKSCdMORPVzpwrOqsg&oe=6B103F24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "879363444937419", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307315_879363448270752_400143134733280957_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6vWY-12P6QQ7kNvwHYx-ZP&_nc_oc=AdpXasuwEtkUF82yzm04zipQ9YZwlrbIbLgj3K2Q2KZ5v-bnnO3a8NC__x0vMSutix8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUM-QFcjrAT6evp8gydV0yYTrfacjXkwImWk8mdlc3cxg&oe=6B105AF4"}, "display_name": "Ape Skate Shootout", "keywords": ["shooter", "fps", "ape", "skate", "hangout"], "long_description": "Shoot. Skate. Toot. \n\nCome hang out at the Skate Park, where you can slide down half pipes and pull off sweet tricks while hanging out with your friends - and grab a gun to mow them down. \n\nIn Ape Skate Shootout you can : \n- Complete skateboard tricks and stunts to earn SkateCash, used to upgrade your character or the Skate Park itself\n- Charge your farts observing your gas meter, and use them to boost around the Skate Park (or to disrespect your fallen foes). \n- Find a variety of weapons to mow down other players and compete in tense deathmatches\n- Combine wacky gadgets and upgrade combos to become the sickest Ape on the half-pipe. \n- Private and public lobby codes to join friends easier\n\nFeaturing a unique locomotion system that's easy to learn and difficult to master, and simple gunplay mechanics with a varied upgrade system, every match of Ape Skate Shootout will feel completely different. ", "short_description": "Kick Ass and Pass Gas - Shoot, skate and toot your way around the Skate Park pulling off tricks and eliminating your opponents. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/fddb41ce-b641-4b07-811c-ebc7470ef0fa", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://www.soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_
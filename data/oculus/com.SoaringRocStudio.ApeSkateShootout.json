NvwG-QKpG&_nc_oc=Adr90MjEe487G_XqmOquoG1_5r0OG3adEPRaD7f2irJeGe0tjTFTpcqPSS1RTD58FAY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XwJVUN1lW1yPIx7T8VaHemjYG_XHHHAMO1jKjmAickA&oe=6A047C78"}, {"file_name": "ss3.png", "id": "2376318332830903", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304106_2376318336164236_3080670963787475875_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Py7xzMU_uOoQ7kNvwEaP5_9&_nc_oc=AdqE6AmXaV4NXOfTiIOkynicyUzV8OaXqkjGt6ymrLmdB-KbOKQEacM2ci6PuDXuvY4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZAdTDGfPP6nrH7wHomR8UGQxIuSiE_m8jQsEFfRzsDg&oe=6A046664"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "879363444937419", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307315_879363448270752_400143134733280957_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27bJWQ4m304Q7kNvwGBdsG2&_nc_oc=AdpbnKnSzdpkTsixte_tYOC5DnO5HQTdZy6HSGZjhRy7lLLLmbHZWPY6zPM46bMKg7Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jGTfsiiDCwhwkfmNSCkdKyJ8FRxtfC3O95JTK1rwMBg&oe=6A048234"}, "display_name": "Ape Skate Shootout", "keywords": ["shooter", "fps", "ape", "skate", "hangout"], "long_description": "Shoot. Skate. Toot. \n\nCome hang out at the Skate Park, where you can slide down half pipes and pull off sweet tricks while hanging out with your friends - and grab a gun to mow them down. \n\nIn Ape Skate Shootout you can : \n- Complete skateboard tricks and stunts to earn SkateCash, used to upgrade your character or the Skate Park itself\n- Charge your farts observing your gas meter, and use them to boost around the Skate Park (or to disrespect your fallen foes). \n- Find a variety of weapons to mow down other players and compete in tense deathmatches\n- Combine wacky gadgets and upgrade combos to become the sickest Ape on the half-pipe. \n- Private and public lobby codes to join friends easier\n\nFeaturing a unique locomotion system that's easy to learn and difficult to master, and simple gunplay mechanics with a varied upgrade system, every match of Ape Skate Shootout will feel completely different. ", "short_description": "Kick Ass and Pass Gas - Shoot, skate and toot your way around the Skate Park pulling off tricks and eliminating your opponents. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/fddb41ce-b641-4b07-811c-ebc7470ef0fa", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://www.soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "26964837879784916"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303707_1467132168264389_2268067232904833150_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aF5GrLqG5-UQ7kNvwFGoxcz&_nc_oc=AdoEGF4KJWXfhhB1HE3WLmFZa_xOP8tPfW1a8Ck58GqdiovVhLqcJS3tpPr95WEvG_s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WuswZC2cqqe9ge5-jXbwUox4DIvJQaIGES3gI6FBQZQ&oe=6A046F70"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ape Skate Shootout", "platform": "ANDROID_6DOF", "context_category": {"context_category": 
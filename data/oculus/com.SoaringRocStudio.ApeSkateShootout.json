scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwbU4lpb_H0vmXKCspy1x_Bw36T_9fspFA3a0eZejTAg&oe=6B086C38"}, {"file_name": "ss3.png", "id": "2376318332830903", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499304106_2376318336164236_3080670963787475875_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkgjbCgf4kAQ7kNvwGhNYS6&_nc_oc=AdpmPgoG6guY9Ewkz--Km5irNS-vtPrB1c9ThCsi9TsdpC012VlvrcWUOkGytvfUwBI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaz4QyO3Cg4RSRPwX_Vu2hRP7E4c9I94b6ml5D8mrz3w&oe=6B085624"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Skate Shootout", "keywords": ["shooter", "fps", "ape", "skate", "hangout"], "long_description": "Shoot. Skate. Toot. \n\nCome hang out at the Skate Park, where you can slide down half pipes and pull off sweet tricks while hanging out with your friends - and grab a gun to mow them down. \n\nIn Ape Skate Shootout you can : \n- Complete skateboard tricks and stunts to earn SkateCash, used to upgrade your character or the Skate Park itself\n- Charge your farts observing your gas meter, and use them to boost around the Skate Park (or to disrespect your fallen foes). \n- Find a variety of weapons to mow down other players and compete in tense deathmatches\n- Combine wacky gadgets and upgrade combos to become the sickest Ape on the half-pipe. \n- Private and public lobby codes to join friends easier\n\nFeaturing a unique locomotion system that's easy to learn and difficult to master, and simple gunplay mechanics with a varied upgrade system, every match of Ape Skate Shootout will feel completely different. ", "short_description": "Kick Ass and Pass Gas - Shoot, skate and toot your way around the Skate Park pulling off tricks and eliminating your opponents. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ad552715-25ba-47ff-bae9-ba4e3a89f3a7", "developer_terms_of_service_url": null, "pu
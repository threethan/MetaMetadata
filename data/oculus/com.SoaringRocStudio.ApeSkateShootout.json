jfWjtKgPJDkE32g&oe=6AF08FE4"}, {"file_name": "ss1.png", "id": "1429867155480767", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308131_1429867158814100_195231298877100231_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIqUb0TBnHAQ7kNvwETh7e9&_nc_oc=Adpk4XORYFAkYkh1iag1tLAkVOHUKo9RUOzCcutYHp5o_4GyIgEn8o8-Yja-u6UimYg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiGt-qMXYWq9nbXb9Jo9Vw0RzIAlWWbkUo4DwZdb1NXA&oe=6AF0B138"}, {"file_name": "ss3.png", "id": "2376318332830903", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304106_2376318336164236_3080670963787475875_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5VSg66dfa4Q7kNvwGo5PEq&_nc_oc=AdrxgWS-mzTNzrZi00U_ipYaBF5XirrYQkyJFTX_mXyQaoA21EuR18OZBzQsg7N1iOQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT54qnnI1ftY8HqXUiAXF5P5FunYtJxEyC79PuoY3jT-w&oe=6AF09B24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "879363444937419", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307315_879363448270752_400143134733280957_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mkdt_VECve0Q7kNvwGknm3i&_nc_oc=AdoIeI7ylGeqr5YOk4hrUMGmxkBjI-Ti9Wo_7LuUmrnxGVHWC0TGKm3mCL8l1JyiE4c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn-guETHI4ibnRrSRoqn5LP-a42WVfBmGFXR3RQ2_Pvg&oe=6AF07EB4"}, "display_name": "Ape Skate Shootout", "keywords": ["shooter", "fps", "ape", "skate", "hangout"], "long_description": "Shoot. Skate. Toot. \n\nCome hang out at the Skate Park, where you can slide down half pipes and pull off sweet tricks while hanging out with your friends - and grab a gun to mow them down. \n\nIn Ape Skate Shootout you can : \n- Complete skateboard tricks and stunts to earn SkateCash, used to upgrade your character or the Skate Park itself\n- Charge your farts observing your gas meter, and use them to boost around the Skate Park (or to disrespect your fallen foes). \n- Find a variety of weapons to mow down other players and compete in tense deathmatches\n- Combine wacky gadgets and upgrade combos to become the sickest Ape on the half-pipe. \n- Private and public lobby codes to join friends easier\n\nFeaturing a unique locomotion system that's easy to learn and difficult to master, and simple gunplay mechanics with a varied upgrade system, every match of Ape Skate Shootout will feel completely different. ", "short_description": "Kick Ass and Pass Gas - Shoot, skate and toot your way around the Skate Park pulling off tricks and eliminating your opponents. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/fddb41ce-b641-4b07-811c-ebc7470ef0fa", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://www.soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "26964837879784916"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303707_1467132168264389_2268067232904833150_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1jyIQLm21kQ7kNvwE2TuId&_nc_oc=AdpJLB6RFGEKu1hv6rpJINk963MZ5lAlEMVLlR5-K2TdRIdUwwlYsDCR3jwYVzlK29c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=
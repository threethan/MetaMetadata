Iq-R3vbI-IhdY1O87kXSw&oe=6AA418E4"}, {"file_name": "ss1.png", "id": "1429867155480767", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499308131_1429867158814100_195231298877100231_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9G8TPtoRNcQ7kNvwHw4qTi&_nc_oc=AdqndMRCFEg1UYKbJu-aF6YAZGHbLZfway50Ae1j4COpRYZ3XsaHVS7qIJSOi56t7Cc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4xv0Po4zvCyAbS0ZAJhOmB7tAEg1EFz48o0-68yKYWg&oe=6AA401F8"}, {"file_name": "ss3.png", "id": "2376318332830903", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499304106_2376318336164236_3080670963787475875_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XeoEttzq9loQ7kNvwFm6aLU&_nc_oc=Adpa6ZL-449l5xTC2mkgBi2ZlEgqdFbv6kWsfIykztuE96yLpzMudYpYWy1-mBeGR4w&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9gmMjXplf_cxMgD5mNFFK7zeseoC9hqKVwhm4ZABP0Q&oe=6AA3EBE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "879363444937419", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499307315_879363448270752_400143134733280957_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfMWkN3d2AIQ7kNvwFCXy-l&_nc_oc=AdrujbQp413u-Xy-olrYjH2LZoMkzgDBc6IpcfcGVPLPkDpzvWZsvWAPWymkNBlxnr0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-kh_pOH8dRtcbLBpJwE2Uh3OdEqHfY6C2x9jCCP-cOA&oe=6AA407B4"}, "display_name": "Ape Skate Shootout", "keywords": ["shooter", "fps", "ape", "skate", "hangout"], "long_description": "Shoot. Skate. Toot. \n\nCome hang out at the Skate Park, where you can slide down half pipes and pull off sweet tricks while hanging out with your friends - and grab a gun to mow them down. \n\nIn Ape Skate Shootout you can : \n- Complete skateboard tricks and stunts to earn SkateCash, used to upgrade your character or the Skate Park itself\n- Charge your farts observing your gas meter, and use them to boost around the Skate Park (or to disrespect your fallen foes). \n- Find a variety of weapons to mow down other players and compete in tense deathmatches\n- Combine wacky gadgets and upgrade combos to become the sickest Ape on the half-pipe. \n- Private and public lobby codes to join friends easier\n\nFeaturing a unique locomotion system that's easy to learn and difficult to master, and simple gunplay mechanics with a varied upgrade system, every match of Ape Skate Shootout will feel completely different. ", "short_description": "Kick Ass and Pass Gas - Shoot, skate and toot your way around the Skate Park pulling off tricks and eliminating your opponents. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/fddb41ce-b641-4b07-811c-ebc7470ef0fa", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://www.soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "26964837879784916"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499303707_1467132168264389_2268067232904833150_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0Hxhp41k6UQ7kNvwHJXvyH&_nc_oc=AdqzJgb_KobYz-CPd23e5lwjxuO_CwNr2TJh65Is2CbBnZi6yjYJW5vIfjbO2ZFSYrc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com
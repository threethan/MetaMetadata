105718490851", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307931_1988105721824184_7549089251615443013_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEle9JFE9OwQ7kNvwEypBTw&_nc_oc=AdqF9hPtNXlNjaGw0gW1bAH7rNadh3ECvJyd81xgKxiGQ-Ovth2jiVUxSDEZr1-HqT0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af652R3Wc1Gl_otWAD6rgV7odYZbrtciIsj9Zk5bfEpMNg&oe=69FC7F21"}, {"file_name": "ss2.png", "id": "1268663328450150", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821193_1268663331783483_6747227713441019138_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpJx4Plq4zQQ7kNvwELGDKl&_nc_oc=AdpVgmPlw5EXshRkkDUrajT_S1AmPoYcpmPrDHQ2x6mBpk1f4h5-9Gt-ReoGtfEaqj8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-qCE-CM8n1Kt-V8es9DppTFumTKdQfDYDFETxYQJuuA&oe=69FCAA64"}, {"file_name": "ss1.png", "id": "1429867155480767", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308131_1429867158814100_195231298877100231_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFhPC_9kSbkQ7kNvwFETW8I&_nc_oc=Adrq90oaOIoAWL6hV7XZ0AF7X9n2jDAAcJl1Hf24wmDZe_9OQjResscWHafPwPnqExI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GWkqHm_GraudI9ic-jtfjrivLpWupvAR0TAAfOPXTzQ&oe=69FC9378"}, {"file_name": "ss3.png", "id": "2376318332830903", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304106_2376318336164236_3080670963787475875_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPVRISdVrQMQ7kNvwGMv757&_nc_oc=Ado-ukDdjTex9reisCH3h1H1tBY0Idi1OGIS41xhexpVr0bH5Mvfaa-QbfoGua-9cno&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xWHkyEf5k-Q-0YdDBn2V4tZOso0DUua9cs1oHVa17Vw&oe=69FC7D64"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Skate Shootout", "keywords": ["shooter", "fps", "ape", "skate", "hangout"], "long_description": "Shoot. Skate. Toot. \n\nCome hang out at the Skate Park, where you can slide down half pipes and pull off sweet tricks while hanging out with your friends - and grab a gun to mow them down. \n\nIn Ape Skate Shootout you can : \n- Complete skateboard tricks and stunts to earn SkateCash, used to upgrade your character or the Skate Park itself\n- Charge your farts observing your gas meter, and use them to boost around the Skate Park (or to disrespect your fallen foes). \n- Find a variety of weapons to mow down other players and compete in tense deathmatches\n- Combine wacky gadgets and upgrade combos to become the sickest Ape on the half-pipe. \n- Private and public lobby codes to join friends easier\n\nFeaturing a unique locomotion system that's easy to learn and difficult to master, and simple gunplay mechanics with a varied upgrade system, every match of Ape Skate Shootout will feel completely different. ", "short_description": "Kick Ass and Pass Gas - Shoot, skate and toot your way around the Skate Park pulling off tricks and eliminating your opponents. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ad552715-25ba-47ff-bae9-ba4e3a89f3a7", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://www.soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "26822581087343930"}}]}
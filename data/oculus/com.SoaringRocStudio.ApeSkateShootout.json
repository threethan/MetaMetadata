om/v/t64.5771-25/499308131_1429867158814100_195231298877100231_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qdgnrNsS1kQ7kNvwGAYuOQ&_nc_oc=Adogx0kfe25v1uYBXhezeJ-Tr7KrUBDQ9MMgroiLRIIyJOvTeWe2oYIl77KnIpg7bX4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MwqXMem_pGRZ7CK5HLjnKrCfvxiYKB7amFnfMFFmnXA&oe=6A0DB6F8"}, {"file_name": "ss3.png", "id": "2376318332830903", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304106_2376318336164236_3080670963787475875_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6KYUJ75ikIQ7kNvwFpgM1K&_nc_oc=AdpNlaSwtDn3d9GKTQL6II-5U-htZyz01gJRRcTx3v8WnGNJqBb6YnOV8Uj53c4UQM8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mmivcSrDe83JIOHSCRki_JCPYCjfHRvwUiD_l6p9P_g&oe=6A0DA0E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "879363444937419", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307315_879363448270752_400143134733280957_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uoge4rXoj8gQ7kNvwHeDoQG&_nc_oc=AdosfVBgGjfRylTyftrNvTrpJ1oqtsu2O7Fs_kByEH29uF2OxBV2jl-Aab97VLoLtUM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mX3a5-oFuTLp-nJoH_EWnRUQrg9rE2aI4m-j_uR7F2w&oe=6A0DBCB4"}, "display_name": "Ape Skate Shootout", "keywords": ["shooter", "fps", "ape", "skate", "hangout"], "long_description": "Shoot. Skate. Toot. \n\nCome hang out at the Skate Park, where you can slide down half pipes and pull off sweet tricks while hanging out with your friends - and grab a gun to mow them down. \n\nIn Ape Skate Shootout you can : \n- Complete skateboard tricks and stunts to earn SkateCash, used to upgrade your character or the Skate Park itself\n- Charge your farts observing your gas meter, and use them to boost around the Skate Park (or to disrespect your fallen foes). \n- Find a variety of weapons to mow down other players and compete in tense deathmatches\n- Combine wacky gadgets and upgrade combos to become the sickest Ape on the half-pipe. \n- Private and public lobby codes to join friends easier\n\nFeaturing a unique locomotion system that's easy to learn and difficult to master, and simple gunplay mechanics with a varied upgrade system, every match of Ape Skate Shootout will feel completely different. ", "short_description": "Kick Ass and Pass Gas - Shoot, skate and toot your way around the Skate Park pulling off tricks and eliminating your opponents. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/fddb41ce-b641-4b07-811c-ebc7470ef0fa", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://www.soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "26964837879784916"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303707_1467132168264389_2268067232904833150_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLNwF5Qb9_sQ7kNvwGr0SDZ&_nc_oc=AdpO5YMm62hLOCxGXv8KtzVfurxMwMcHJDupnYpz6enp5SlBdXBdR2wtqNHDVNJUHqE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46yyu7ZLx2-3xv461URwb7YBAz3rc9wiU7dIQ77HElzA&oe=6A0DA9F0"}, "is_concept": false, "is_test": false, "is_trial_of
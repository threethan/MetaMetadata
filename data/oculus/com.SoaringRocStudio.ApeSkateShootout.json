ketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SfRBqwC0EHcQ7kNvwF2aelb&_nc_oc=AdqxT1EbwGsgpy0jvKezpSOeh9QaBUr_WHCK1rILCR7p7tniT6EMqpMMqlFHrBpUQcA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTSleqK6LUD4v-pFZOB7vDAsK4PHQguve7B__wsYI8-cQ&oe=6B0C77A4"}, {"file_name": "ss1.png", "id": "1429867155480767", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308131_1429867158814100_195231298877100231_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqnzmJ1zuR4Q7kNvwHkhqLw&_nc_oc=AdpKoGaioovrQoB8zIIClqaCCPYRyuG-Osk1YCTccDG_rz5dBvn2267qRj4QA0-vOs0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS39tsAFwMIg2bvrRca84AexTbRd7SIkmhU9UGKPWiJVA&oe=6B0C60B8"}, {"file_name": "ss3.png", "id": "2376318332830903", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304106_2376318336164236_3080670963787475875_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8SOIt3T28MQ7kNvwGAhZY-&_nc_oc=AdoPLAH5l4aIIeURyXGDxMmIa0UmqPx4UG9N2UFDUX0JxBid_tQjNvWE31IU3hvbj4U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRP2bTeMFt0JvPq_frBxOD_ss90y6Xsdx0bJwv26caVVg&oe=6B0C4AA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "879363444937419", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307315_879363448270752_400143134733280957_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IDT0jiHa0MQ7kNvwH_GW1R&_nc_oc=AdrSDdPx1jMOc8SpFkpe-2RGm4YtufxauIf4uEcJzAPCbEv8v-iKJnOj_DZVDgdjGaI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS0X0kTOlMHZxn6YaUUtmY0kkfcsDFg9KnjL9XsG-y7fw&oe=6B0C6674"}, "display_name": "Ape Skate Shootout", "keywords": ["shooter", "fps", "ape", "skate", "hangout"], "long_description": "Shoot. Skate. Toot. \n\nCome hang out at the Skate Park, where you can slide down half pipes and pull off sweet tricks while hanging out with your friends - and grab a gun to mow them down. \n\nIn Ape Skate Shootout you can : \n- Complete skateboard tricks and stunts to earn SkateCash, used to upgrade your character or the Skate Park itself\n- Charge your farts observing your gas meter, and use them to boost around the Skate Park (or to disrespect your fallen foes). \n- Find a variety of weapons to mow down other players and compete in tense deathmatches\n- Combine wacky gadgets and upgrade combos to become the sickest Ape on the half-pipe. \n- Private and public lobby codes to join friends easier\n\nFeaturing a unique locomotion system that's easy to learn and difficult to master, and simple gunplay mechanics with a varied upgrade system, every match of Ape Skate Shootout will feel completely different. ", "short_description": "Kick Ass and Pass Gas - Shoot, skate and toot your way around the Skate Park pulling off tricks and eliminating your opponents. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/fddb41ce-b641-4b07-811c-ebc7470ef0fa", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://www.soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "26964837879784916"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://s
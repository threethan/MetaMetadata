tveLzUGP4whUHzQ&oe=6A92BD24"}, {"file_name": "ss1.png", "id": "1429867155480767", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308131_1429867158814100_195231298877100231_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUbTV60n8oYQ7kNvwEWuNDA&_nc_oc=AdqKJKSOjtp91auN-LLnvchIFddX9LJfeBsSsKnP4SzlbauCDEx10eD5VwdwcWNfUMM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpnhQhXavUeKf-nUr5jKs7Bq7BCgPFlgp3DWE3vkEyNg&oe=6A92DE78"}, {"file_name": "ss3.png", "id": "2376318332830903", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304106_2376318336164236_3080670963787475875_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmN8qw6dJhMQ7kNvwFh_NbT&_nc_oc=AdrdvH9CL4yedxiBH3HRQqExXYNmBHrxjf_FC71HjPWpNo4Rk63C26VOFxWWMN6oqOo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqU7_NDhNAITrjNW6-1AVIRetesMYsjQnfoW41SZAJGg&oe=6A92C864"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "879363444937419", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307315_879363448270752_400143134733280957_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnGyih2YH7YQ7kNvwEtFnmu&_nc_oc=AdpLbXCP3kkHoXobNyBoUCiiBkItX5vYVDXupcjmPGHIX5BqYxZg3dYwRfCjygt-ohg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQhtNh7h3zWWTCz7pu8IVgbuk0TFhm0PgyO1_he43Ycw&oe=6A92ABF4"}, "display_name": "Ape Skate Shootout", "keywords": ["shooter", "fps", "ape", "skate", "hangout"], "long_description": "Shoot. Skate. Toot. \n\nCome hang out at the Skate Park, where you can slide down half pipes and pull off sweet tricks while hanging out with your friends - and grab a gun to mow them down. \n\nIn Ape Skate Shootout you can : \n- Complete skateboard tricks and stunts to earn SkateCash, used to upgrade your character or the Skate Park itself\n- Charge your farts observing your gas meter, and use them to boost around the Skate Park (or to disrespect your fallen foes). \n- Find a variety of weapons to mow down other players and compete in tense deathmatches\n- Combine wacky gadgets and upgrade combos to become the sickest Ape on the half-pipe. \n- Private and public lobby codes to join friends easier\n\nFeaturing a unique locomotion system that's easy to learn and difficult to master, and simple gunplay mechanics with a varied upgrade system, every match of Ape Skate Shootout will feel completely different. ", "short_description": "Kick Ass and Pass Gas - Shoot, skate and toot your way around the Skate Park pulling off tricks and eliminating your opponents. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/fddb41ce-b641-4b07-811c-ebc7470ef0fa", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://www.soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "26964837879784916"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303707_1467132168264389_2268067232904833150_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJ2DvoXccbIQ7kNvwGVtq10&_nc_oc=Adov5RqzyBrmCxcAODiVxyI6IeUQ5dw2joXK5Ku0u7L46DjTqbNrDw-Mt8UPv49RyMs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=
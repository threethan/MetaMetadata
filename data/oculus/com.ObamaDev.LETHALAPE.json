969_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diFDrMqKcDIQ7kNvwHWD2wd&_nc_oc=AdrbvoF2hXGLFo2HERFLGfo95qlEAH5bPCG1jZDwsoVJuL_rK_CqLAnkcTY9dV-YLQE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTShrWo1j91Yud6UoG3NpSHfp-U0IpNjXfSKaN414ZQ2A&oe=6AFDBCA3"}, {"file_name": "SampleScene_Custom..._07.01.2024_19-29-59.png", "id": "886500883182360", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982675_886500886515693_5299209996986338031_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ieUjQUE-3nsQ7kNvwFr9nxi&_nc_oc=Adq5iGVniQ7IrqET2dKcA2F5RjXK6EyjyUZiIGdX69eyVfob4ueBdyEP4h7isHsjcjc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2KBj_MRvcUDU2qWIUuHNOGSoAjkKGC_bSyYSI2WVpjA&oe=6AFDE171"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape", "keywords": [], "long_description": "Trapped in a nightmarish facility, stalked by nameless horrors. Survival is the only game \u2013 no puzzles, just pure terror. Can you escape the dread?", "short_description": "\n\"Bro, you're trapped in this messed-up facility, and it's like a total nightmare. No solving puzzles or anything, just straight-up survival mode. The vibe is insane \u2013 flickering lights, creepy corridors, and these two horrifying monsters on your tail. You gotta outsmart 'em, find hiding spots, and just pray you make it out in one piece. It's like being stuck in a horror movie, but you're the star, and the monsters are hunting you down. Good luck, you'll need it to survive this freaky facility!\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lethal-ape/policy", "developer_terms_of_service_url": null, "publisher_name": "SaucerTheDev", "support_website_url": null, "website_url": "https://sites.google.com/view/lethal-ape/policy", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925
3"}, {"file_name": "SampleScene_Custom..._07.01.2024_19-29-59.png", "id": "886500883182360", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982675_886500886515693_5299209996986338031_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXy2UD-fj88Q7kNvwEvWNWX&_nc_oc=AdrAKEmv0srHGitvgQFZ3AXQJEhIFEVJiFroOe3GG1BpA44PFxgP476Ez_ZijFkdRB8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6Y2ZPPDwOJKVPzDPGxv9xepSb1dhPZOagKPPtWhluOA&oe=6A8D99B1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape", "keywords": [], "long_description": "Trapped in a nightmarish facility, stalked by nameless horrors. Survival is the only game \u2013 no puzzles, just pure terror. Can you escape the dread?", "short_description": "\n\"Bro, you're trapped in this messed-up facility, and it's like a total nightmare. No solving puzzles or anything, just straight-up survival mode. The vibe is insane \u2013 flickering lights, creepy corridors, and these two horrifying monsters on your tail. You gotta outsmart 'em, find hiding spots, and just pray you make it out in one piece. It's like being stuck in a horror movie, but you're the star, and the monsters are hunting you down. Good luck, you'll need it to survive this freaky facility!\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lethal-ape/policy", "developer_terms_of_service_url": null, "publisher_name": "SaucerTheDev", "support_website_url": null, "website_url": "https://sites.google.com/view/lethal-ape/policy", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
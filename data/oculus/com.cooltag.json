movement techniques, and develop your own playstyle as you improve over time. Whether you're competing with friends, practicing advanced movement, or creating unforgettable moments in chaotic matches, every session brings something different. Easy to pick up and satisfying to master, the game rewards creativity, timing, and movement skill at every level.\n", "short_description": "Move, climb, and launch yourself through energetic multiplayer gameplay powered by immersive gorilla-style locomotion. Explore unique environments, improve your movement skills, and compete in fast, unpredictable matches where every jump and decision counts."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/cooltagweb/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Peanut", "support_website_url": null, "website_url": "https://sites.google.com/view/cooltagweb/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1112219555315327"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310667_1502366064058144_3321398550200696462_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fV_qzVYsM48Q7kNvwEqJLyr&_nc_oc=AdprECaHMEbQq7-YiOMKnyBy9tHi3MPDAFAmQOzvZkday0YkzNCf3Dak-Fnff9mOuz0&
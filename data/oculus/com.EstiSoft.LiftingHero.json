WEo1iLFLpcj-UIWAJ_gVE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQwkEWu08yfh9bG819jwKG796W1rXJx2zCzB9XKFtVQg&oe=6A75CFC0"}, {"file_name": "Image Sequence_004_0001.png", "id": "667003379483479", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312263_667003382816812_9117129221265023613_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srte8WjZ998Q7kNvwG7Bc1X&_nc_oc=AdpYSWwRxaJujoYpvE5pP7a0y5D2PdV-lOKvQ6K1WFOteN5uOZ5wyhYPA7F-qaRd-eg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH86PtvPvbsRiZTutOA1aHvuWSpum6a7If6kkGZKito8w&oe=6A75F9F4"}, {"file_name": "Image Sequence_003_0001.png", "id": "1360557418571108", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499335562_1360557421904441_4081522792672958258_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVxnNw5OIG0Q7kNvwHZYSIV&_nc_oc=AdoTfilPZHzNUL904senIUnzbk2PlaAITjShK1OYNU_9PyGkaiXCYHTAfF4eXF0JYjo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8XG8ZXHIPrmNePF8g-_25Bh0Iq9C-2i5_rqbA6-jTzw&oe=6A75F1CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_005_0001.png", "id": "1243557894036914", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499339588_1243557900703580_9031428975552998126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15l-rItGE2IQ7kNvwEJo4vJ&_nc_oc=AdoypoukqvbQ1vARVujNPz0L91Gvjh6-I9hw8pRjEb8usAcGQtDihpNOTIFu38VVeDU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9MMlHLF9JaKCupfHU0CwEboA4mbXgY5IqwkjW8xOuhg&oe=6A75F769"}, "display_name": "Lifting Hero", "keywords": ["Gym", "Lifting", "comfort", "Idle", "Tycoon"], "long_description": "Welcome to Lifting Hero, the ultimate VR adventure where strength means everything\u2014no matter what you\u2019re lifting! Start small with pencils and grow by training with quirky items like sneakers, speakers, surfboards, and even basketballs. Every rep makes your character bigger, stronger, and funnier!\n\nRoam through vibrant city parks, discover unique upgrades, and compete with other lifters to become the strongest hero in town. As your size grows, so does your access to new areas and items, making each play session more exciting and rewarding. Packed with charm, humor, and motion-controlled lifting, Lifting Hero is designed for casual VR fun, family-friendly gameplay, and replayable progression.\n\nWhether you're looking to relax, laugh, or get lost in a joyful loop of growth, Lifting Hero offers a colorful and lighthearted VR world where everyone can feel like a superhero.\n\n", "short_description": "Step into a colorful VR world where lifting objects powers your journey! In Lifting Hero, grow stronger by lifting pencils, speakers, and basketballs, and evolve into a true champion. Explore city parks, unlock wacky items, and become the biggest hero on the map! Perfect for casual VR fun and all ages."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23871731362444354"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "4551571165116333"}, {"status": "PUB
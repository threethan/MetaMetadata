qag9ODbcwO_GB0FZ0c0eA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_3vMW3E7khQkGmap9I1rAdumyF768fiMlbv8mNI_H_g&oe=6A7872C0"}, {"file_name": "Image Sequence_004_0001.png", "id": "667003379483479", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312263_667003382816812_9117129221265023613_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ngg_4nBeZwQ7kNvwHj_M6V&_nc_oc=AdoRjqpvwP4WadYRU9kQcBATNw0Jgq43z7eID35nKiWSOKfk-ox-LVNIZMyNTzG31qc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZn5UyZHN-U-Db64xCgf_MtmHlQbeRZNyOFZXxQiiIiA&oe=6A789CF4"}, {"file_name": "Image Sequence_003_0001.png", "id": "1360557418571108", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499335562_1360557421904441_4081522792672958258_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWJERmbbjCoQ7kNvwE7_HVl&_nc_oc=Adq3ES_-jrUNHZXZx1HZDv4gCBFR1USwEao0_31uYJ3Qy_UZ8kb0QmZ516_19hTa_gI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoXKzB1EpvfRinW8kzLf3lS7iYKgY4ORkAKxTEUi_isQ&oe=6A7894CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_005_0001.png", "id": "1243557894036914", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499339588_1243557900703580_9031428975552998126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KH8-2-n1aw0Q7kNvwGNbNKZ&_nc_oc=Adp97LF2nIBWM4J2uXkA6DGvYUPHeB1gQ_BTEVWaLKHNe-JuxHevcyXbQb2FxrZ_suY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvWRpdKCB86K9yXt0DmbYIit-iFZknqKj_GARz08iHZg&oe=6A789A69"}, "display_name": "Lifting Hero", "keywords": ["Gym", "Lifting", "comfort", "Idle", "Tycoon"], "long_description": "Welcome to Lifting Hero, the ultimate VR adventure where strength means everything\u2014no matter what you\u2019re lifting! Start small with pencils and grow by training with quirky items like sneakers, speakers, surfboards, and even basketballs. Every rep makes your character bigger, stronger, and funnier!\n\nRoam through vibrant city parks, discover unique upgrades, and compete with other lifters to become the strongest hero in town. As your size grows, so does your access to new areas and items, making each play session more exciting and rewarding. Packed with charm, humor, and motion-controlled lifting, Lifting Hero is designed for casual VR fun, family-friendly gameplay, and replayable progression.\n\nWhether you're looking to relax, laugh, or get lost in a joyful loop of growth, Lifting Hero offers a colorful and lighthearted VR world where everyone can feel like a superhero.\n\n", "short_description": "Step into a colorful VR world where lifting objects powers your journey! In Lifting Hero, grow stronger by lifting pencils, speakers, and basketballs, and evolve into a true champion. Explore city parks, unlock wacky items, and become the biggest hero on the map! Perfect for casual VR fun and all ages."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23871731362444354"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "4551571165116333"}, {"status": "PUB
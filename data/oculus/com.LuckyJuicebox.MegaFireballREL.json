rMTn0iA&oe=6B0C66AE"}, "display_name": "Mega Fireball", "keywords": ["fireball", "soccer", "family", "brawl", "sports"], "long_description": "Team up with your new best friend **Slappy** and transform your space into a chaotic sports arena. It's Mega Fireball!\n\n**\ud83d\udc4a Bring The Heat** \u2014 Control Slappy to smash balls into the goal or punch them in yourself\n\n**\ud83d\udc7e Chaos Everywhere** \u2014  UFOs spawn balls and power-ups while Fireguys set everything ablaze.\n\n**\ud83d\udd25 Challenge Modes Slap Different** - Show off your skills on the global leaderboard and compete in three unique themes:\n- Lava Floor = Don\u2019t touch the ground\n- Space = Zero-G ball chaos\n- Colors = Smash to the beat\n\n**\ud83c\udfae Battle or Join Forces** \u2014 8-player same-room chaos, 1v1 portal battles, or grind solo against AI opponents.", "short_description": "Sports? Nah. This is living room mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "32757973737135575"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer
7687279_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgHeDSFpA2oQ7kNvwFMWmNm&_nc_oc=AdmpjySKp7LFvsG-Nv6XloR4pAFF355iKjixGwAbFM0qO0lZuNc0AHqmQmOk2LNQcvE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu_rc-zNu4WUR8wP2yws3e8gISO8YEaurRur0SBNd0Olw&oe=69A81113"}, {"file_name": "screenshot_0001_com.LuckyJuicebox.MegaFireballDEV-20250829-141204.png", "id": "1477958896729013", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308050_1477958900062346_4587596276897707463_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zc9e0TAUHoIQ7kNvwE_mvPN&_nc_oc=Adn-Cg_ytUGNkt-_Q3UvuxkUwhnb5c03eERf2UamCiUSXoVhcj7WSSh41S9GpY4NvEo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfudeD6p71OfSaFy7FXl_Hv4sGDawf39WQEVUc4QYoOIWA&oe=69A8278F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MFB_CoverImage_Landscape.png", "id": "24745171978456894", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822107_24745171995123559_1337645441440880618_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mO-MM2nHiY0Q7kNvwFSaO9Z&_nc_oc=AdnHaKUwx4xs5us-1Ec-iBwbvQ03FzFfT2A_BiYrlyZxUbyavI6V04MPnGRUiXBuHWY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftcvioLfBUMYGxRntsJ-w-VfsjWMqItMDzOKpUCS1G7wg&oe=69A8396E"}, "display_name": "Mega Fireball", "keywords": ["fireball", "soccer", "family", "brawl", "sports"], "long_description": "Team up with your new best friend **Slappy** and transform your space into a chaotic sports arena. It's Mega Fireball!\n\n**\ud83d\udc4a Bring The Heat** \u2014 Control Slappy to smash balls into the goal or punch them in yourself\n\n**\ud83d\udc7e Chaos Everywhere** \u2014  UFOs spawn balls and power-ups while Fireguys set everything ablaze.\n\n**\ud83d\udd25 Challenge Modes Slap Different** - Show off your skills on the global leaderboard and compete in three unique themes:\n- Lava Floor = Don\u2019t touch the ground\n- Space = Zero-G ball chaos\n- Colors = Smash to the beat\n\n**\ud83c\udfae Battle or Join Forces** \u2014 8-player same-room chaos, 1v1 portal battles, or grind solo against AI opponents.", "short_description": "Sports? Nah. This is living room mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "32757973737135575"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1520825782250200"}, {"status": "PUBLISHED", "id": "826631946419115"}, {"status": "PUBLISHED", "id": "832837726337242"}]}, "baseline_offer": {"id": "832837726337242"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765821600, "status": "PUBLISHED", "id": "826631946419115"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34085700887696180", "version": "1.1.0.523.1"}, "id": "2808467339349454", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "32228678243398463", "is_co
_n.png", "id": "3576579352549105", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393450_3576579355882438_1963200810321074511_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LRVBva6INIQ7kNvwHS4vZB&_nc_oc=AdlKmsasR4TOFhhXHSPH1D9rsOpLh0ElHMd96H2IXXTKPr5EYKNSJx2-ZFqN8mxIii8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJYQYz2NPZaNl-FscFn6Lp5juJXxvbsCKsF7gTYd0JQw&oe=69B5627B"}, {"file_name": "473393450_1573740710009977_1669577520261884236_n.png", "id": "1714313102856257", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393320_1714313106189590_3417713238505489182_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WucArOYpMKoQ7kNvwE3p5u8&_nc_oc=AdlAJu74vOEN1PWUT2WCVcRGRnK8v41TQVYwCBuORNLEFaQLJ_tCDPsoETwoABQukk0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx-KQrdFvFHZlSYQFUzgVNXlBGaaqMkWnSsLt-a1KV99w&oe=69B57101"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Evil Monkeys", "keywords": [], "long_description": "Evil Monkeys is an adrenaline-fueled VR game inspired by the beloved mechanics of Gorilla Tag, where you leap into a dynamic world to play as a nimble, gorilla-like avatar. Using only your arms to move, you'll push, pull, swing, and climb through intricate, obstacle-filled environments, immersing yourself fully in a thrilling game of tag. Every movement counts as you chase, dodge, and strategize to outsmart opponents in exhilarating rounds that test your agility, reaction time, and planning.", "short_description": "Evil Monkeys is a high-energy VR game where players become agile, gorilla-like avatars, using arm movements to swing, climb, and leap through immersive environments. Dodge, chase, and outmaneuver others in intense rounds of tag, honing your skills to become the ultimate GAME NAME champion!"}]}, "developer_name": "JAYY LLC", "developer_privacy_policy_url": "https://sites.google.com/view/evil-monkeys/privacy-policy", "developer_terms_of_service_url": null, "publis
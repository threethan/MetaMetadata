3ej06JEYyQNNCYEw&oe=6AA17147"}, {"file_name": "473393320_584734674604503_7739393686801689806_n.png", "id": "3576579352549105", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393450_3576579355882438_1963200810321074511_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSQB5HzftNAQ7kNvwF0dZNa&_nc_oc=Adq7XQ28avXvvTW0jiW65dQmKjE8afhvJDmRj2F5i7ofK0ZL1b1sYwcuwSD0Zt5JxHc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKH4j1K0dhpmpArIngooWv_Ps6kUySaAzdM2JPFYg2E_Q&oe=6AA15EFB"}, {"file_name": "473393450_1573740710009977_1669577520261884236_n.png", "id": "1714313102856257", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393320_1714313106189590_3417713238505489182_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agaXbhbxTvMQ7kNvwF05Onh&_nc_oc=AdrQf7ZAOaj2PnC6doRqCA6rQPQD8bRitHvRyL9-k8Rdz2H__eIr3fRUBHedFUFAXII&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcdAvXafDSniQCXkLPMKEVMkVPRjX82jM-RnlC2lyi-g&oe=6AA16D81"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Evil Monkeys", "keywords": [], "long_description": "Evil Monkeys is an adrenaline-fueled VR game inspired by the beloved mechanics of Gorilla Tag, where you leap into a dynamic world to play as a nimble, gorilla-like avatar. Using only your arms to move, you'll push, pull, swing, and climb through intricate, obstacle-filled environments, immersing yourself fully in a thrilling game of tag. Every movement counts as you chase, dodge, and strategize to outsmart opponents in exhilarating rounds that test your agility, reaction time, and planning.", "short_description": "Evil Monkeys is a high-energy VR game where players become agile, gorilla-like avatars, using arm movements to swing, climb, and leap through immersive environments. Dodge, chase, and outmaneuver others in intense rounds of tag, honing your skills to become the ultimate GAME NAME champion!"}]}, "developer_name": "JAYY LLC", "developer_privacy_policy_url": "https:/
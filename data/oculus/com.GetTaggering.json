473393320_1714313106189590_3417713238505489182_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAj8uXJG8FIQ7kNvwHcBoBf&_nc_oc=AdofJaWM8SowUbffJ6MUQW7eIxo51mrF8HEZD2kd54vv-fvUyKdqpgdW3KRD5uphYjQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsGB2FmNAbYO6MaFJP3yh4XMA4xaftgk2u0D8hCHWH4g&oe=6B09CC41"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Evil Monkeys", "keywords": [], "long_description": "Evil Monkeys is an adrenaline-fueled VR game inspired by the beloved mechanics of Gorilla Tag, where you leap into a dynamic world to play as a nimble, gorilla-like avatar. Using only your arms to move, you'll push, pull, swing, and climb through intricate, obstacle-filled environments, immersing yourself fully in a thrilling game of tag. Every movement counts as you chase, dodge, and strategize to outsmart opponents in exhilarating rounds that test your agility, reaction time, and planning.", "short_description": "Evil Monkeys is a high-energy VR game where players become agile, gorilla-like avatars, using arm movements to swing, climb, and leap through immersive environments. Dodge, chase, and outmaneuver others in intense rounds of tag, honing your skills to become the ultimate GAME NAME champion!"}]}, "developer_name": "JAYY LLC", "developer_privacy_policy_url": "https://sites.google.com/view/evil-monkeys/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JAYY LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/evil-monkeys/website", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
wGZY-dv&_nc_oc=Adkw5wzBcqIkBb0T_B0xQ0SaRcVuDBMGgBeGQxtayVxLZJP-TshcdpwEtROMY5-R7hM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afst1k26OsHzTeVzXaxJsEtfvky2kvLMnYS8RFkmbtO39w&oe=6999B2FB"}, {"file_name": "473393450_1573740710009977_1669577520261884236_n.png", "id": "1714313102856257", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393320_1714313106189590_3417713238505489182_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7MyIxOqra_sQ7kNvwGFXcg7&_nc_oc=Adn4YS-03tqDUIuBv9uZFXFtIGXKh6RxsGVI_cGnDtWvUGVrqN-qprE_SXNFO22Ez1M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv5w1qH7xYfB4oEuzHQuu1QLGfyQ0W6vkb5kbMJB-bU6A&oe=6999C181"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Evil Monkeys", "keywords": [], "long_description": "Evil Monkeys is an adrenaline-fueled VR game inspired by the beloved mechanics of Gorilla Tag, where you leap into a dynamic world to play as a nimble, gorilla-like avatar. Using only your arms to move, you'll push, pull, swing, and climb through intricate, obstacle-filled environments, immersing yourself fully in a thrilling game of tag. Every movement counts as you chase, dodge, and strategize to outsmart opponents in exhilarating rounds that test your agility, reaction time, and planning.", "short_description": "Evil Monkeys is a high-energy VR game where players become agile, gorilla-like avatars, using arm movements to swing, climb, and leap through immersive environments. Dodge, chase, and outmaneuver others in intense rounds of tag, honing your skills to become the ultimate GAME NAME champion!"}]}, "developer_name": "JAYY LLC", "developer_privacy_policy_url": "https://sites.google.com/view/evil-monkeys/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JAYY LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/evil-monkeys/website", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id
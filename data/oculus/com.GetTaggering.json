iQwaFl07B1IsSYRA&oe=6A1D9B47"}, {"file_name": "473393320_584734674604503_7739393686801689806_n.png", "id": "3576579352549105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393450_3576579355882438_1963200810321074511_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oz32I_8SpooQ7kNvwEzJIk0&_nc_oc=AdrsdCJVy4nIHn-oI04uwDQ_eYs5khGqX7UMSzPZUnuSVLzCXojwQp60Izppbfwre6I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Oi-hopHtw7NJrCRmh3oD2WsXaDfQy1Jn_Aq4rSUDMbg&oe=6A1D88FB"}, {"file_name": "473393450_1573740710009977_1669577520261884236_n.png", "id": "1714313102856257", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393320_1714313106189590_3417713238505489182_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npl5uLrGY4YQ7kNvwGP6WDq&_nc_oc=AdoWJTF8WSQEbXxQimHCoqkU3tMmWjroBU9IChD4aeZTOOXJpbid59kdogwSCzX0Vqc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_7EbHoB7Bfe_uT_mQRoDE7LbsZ1m37kK4FQbxR0ovBQ&oe=6A1D9781"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Evil Monkeys", "keywords": [], "long_description": "Evil Monkeys is an adrenaline-fueled VR game inspired by the beloved mechanics of Gorilla Tag, where you leap into a dynamic world to play as a nimble, gorilla-like avatar. Using only your arms to move, you'll push, pull, swing, and climb through intricate, obstacle-filled environments, immersing yourself fully in a thrilling game of tag. Every movement counts as you chase, dodge, and strategize to outsmart opponents in exhilarating rounds that test your agility, reaction time, and planning.", "short_description": "Evil Monkeys is a high-energy VR game where players become agile, gorilla-like avatars, using arm movements to swing, climb, and leap through immersive environments. Dodge, chase, and outmaneuver others in intense rounds of tag, honing your skills to become the ultimate GAME NAME champion!"}]}, "developer_name": "JAYY LLC", "developer_privacy_policy_url": "https:/
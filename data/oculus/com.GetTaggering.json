wHl8p6e&_nc_oc=AdnL5Gy4Dn-sjDvPbKxaGxWRBQC6Ew-8pkrscuSlSvsmank6BxMWYhUD5juSfDF5Elc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuCMOnpkSWMBbQAfl8z3Vx0oXZSg-ODewR_pQuN7debiw&oe=69A04A7B"}, {"file_name": "473393450_1573740710009977_1669577520261884236_n.png", "id": "1714313102856257", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393320_1714313106189590_3417713238505489182_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SG6VUvk9BUMQ7kNvwFqdacv&_nc_oc=AdluVm1-CgI_hAtlH3CqjEykR2VbvrfAydJ4l_Ybqikjyye77sz2NL6VWYhA8yA8ffM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu_Zhs84XjlKqOECdQF3CyAwqRhktZ5204WYUjKuU9oyw&oe=69A05901"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Evil Monkeys", "keywords": [], "long_description": "Evil Monkeys is an adrenaline-fueled VR game inspired by the beloved mechanics of Gorilla Tag, where you leap into a dynamic world to play as a nimble, gorilla-like avatar. Using only your arms to move, you'll push, pull, swing, and climb through intricate, obstacle-filled environments, immersing yourself fully in a thrilling game of tag. Every movement counts as you chase, dodge, and strategize to outsmart opponents in exhilarating rounds that test your agility, reaction time, and planning.", "short_description": "Evil Monkeys is a high-energy VR game where players become agile, gorilla-like avatars, using arm movements to swing, climb, and leap through immersive environments. Dodge, chase, and outmaneuver others in intense rounds of tag, honing your skills to become the ultimate GAME NAME champion!"}]}, "developer_name": "JAYY LLC", "developer_privacy_policy_url": "https://sites.google.com/view/evil-monkeys/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JAYY LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/evil-monkeys/website", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id
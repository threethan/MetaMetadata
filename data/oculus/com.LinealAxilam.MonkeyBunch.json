ntent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBhUPaSnnZaBj4Nbar529sNnjvL5bn4vhL1QPE-l2NYw&oe=6AFC831A"}, {"file_name": "Shop.png", "id": "603472942829415", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830032_603472946162748_230088350475452724_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVZzXYaSiPMQ7kNvwG8-ZUm&_nc_oc=Adq6liG9msfxUb_wAGoElXjmP_PZ6C6aVcZ564Npe3HZyZ-zz4n0M6FZH8IIrI_cBO4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsDHNhKXMbBwvWRUb2ad8QfFoyIDhA_jGHMJ7jo1EEHA&oe=6AFC66A3"}, {"file_name": "ShopEnterance.png", "id": "649253138129287", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823445_649253141462620_9059741773370254567_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NbZtdeLyDsQ7kNvwFo4ABG&_nc_oc=AdrQxoyX4En5oeTwoGAdQAQXjm1EZgf-6_ydcr6BOETgmaAPSJyoF1h6CaktHoq3ops&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQu1qC6xecdScl87SQkTRkJk3VzNjA_eBiQhsetf-eCUw&oe=6AFC8D21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NewCoverV2HeroArtMeta-Space.png", "id": "1781816139903875", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491829165_1781816143237208_8371018028683216414_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=629P0TarNkgQ7kNvwEwWi44&_nc_oc=AdrscvXLjmY-fNMgvrV0Xaaj5BUg-yx3Cu29tkBGNJtVGycrPh-bSnw3vCV6g3pge00&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8kBLHNi_CSM5KijqpWw6lWJa_fAPayu2sATcqTzf-0Q&oe=6AFC85CA"}, "display_name": "Monkey Bunch", "keywords": ["gorilla", "monkey", "social", "mods", "building"], "long_description": "\nRun, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb.\n{934908111946592}\nExplore community created content! Enjoy levels and items created by the community! or make your own express your inner monkey with your own unique items made with our UGC tools! (Community content is not rated)\n{1222088725521716}\nHang out in a virtual jungle with randos or group up in a private room with friends to hang out and play. The stakes are low, so feel free to just chat or make up your own games. The movement is easy to learn, and hard to master. Crossplay with the PC versions of the game, so play with anyone on any platform.\n{599785382555227}\n\n\nThere are many different levels to explore. Each with their own topography that form routes and obstacles to play on.\n\nVisit our store, with a rotating inventory of items to buy, play with, and wear to express your true monke.\n\nBecome Monkey.", "short_description": "Run, jump, and climb using only your hands. Play many gamemodes with people online. Socialize in public lobbies and release your inner monkey!"}]}, "developer_name": "Another Level Games", "developer_privacy_policy_url": "https://docs.google.com/document/d/1PcoZDQdW9b6YKIMEh9swCtxbVRoL8ZuGsybqAtMbuks/edit?usp=sharing", "developer_terms_of_service_url": "https://anotherlevelgames.co.uk/eula", "publisher_name": "Another Level Games Publishing", "support_website_url": "https://anotherlevelgames.co.uk/support", "website_url": "https://anotherlevelgames.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "
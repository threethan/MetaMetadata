uscdn.com/v/t64.5771-25/39031393_3426883940892805_1005233946160137207_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8woPsdZkspgQ7kNvwElXJEm&_nc_oc=AdoOwwBbfJnOFTq976r9nynUcJxUWd9a7RDTv4fnvyAi-UbOe1BUexKlzb2984NRo9U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWRPkBrRuMytBFQ4us50jzHxv08Nl1N8r2JBa0ogMDExA&oe=6B0F192B"}, {"file_name": "PC.png", "id": "486824706866815", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982685_486824710200148_3829803151650817435_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQn2hKbh4DAQ7kNvwF4quKB&_nc_oc=AdqxG31F6wzx6u7M-BwfcY732GVmUQ827nH6R7RHmhtptqIRg0UP8xLQyzd40_r93Fg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVI9evkFv3VHcxssNkGH6u6fEVVDddLsqluAejVtkMvEQ&oe=6B0F1046"}, {"file_name": "Cosmetics.png", "id": "701400291538864", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75314851_701400294872197_2388943030080511339_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlJwH3HdIkgQ7kNvwF9koi2&_nc_oc=Adok3tVLBND8W0yJ5Lw1NJIFYadll7vJ68HmKs3Ra2naVaHF_laWeHGY4EDZJKZlJrk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWEaUDt0lbnUGajisgkrRWsmUKYkyGHGrrz04_Lju1FVg&oe=6B0EFEFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wwew.png", "id": "1226636741268985", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75441579_1226636744602318_4011593143321173634_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dD0JXHPSwkgQ7kNvwG2PQXJ&_nc_oc=AdrB7DwA33LtE-QbFyBIkBp9B0WVoLGolqtwOGdV9OaPHPNENGQEGBAg52AC80T3YpQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX8uOileqlNyLv2B2CCzsJDSZ4q8F6o_TaIIkjBlRHo6w&oe=6B0F06D5"}, "display_name": "Monkey Bunch", "keywords": [], "long_description": "Reject Humanity.\n\nRun, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb.\n\nThere are many different game modes - From an fun paintball battle or horror mode, with up to 10 of your friends.\n\nRun from the other monkey, or outmaneuver the survivors to catch them. Parkour up trees and cliff faces to evade and chase monke down. Hang out in a virtual jungle with randos or group up in a private room with friends to hang out and play. The stakes are low, so feel free to just chat or make up your own games. The movement is easy to learn, and hard to master. Crossplay with the PC versions of the game, so play with anyone on any platform.\n\nThere are many different levels to explore.  Each with their own topography that form routes and obstacles to play on.\n\nVisit our store in the City, with a rotating inventory of items to buy, play with, and wear to express your true monke fashion in a unique way.\n\nBecome Monkey.", "short_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb."}]}, "developer_name": "Lineal Axilam", "developer_privacy_policy_url": "https://docs.google.com/document/d/1PcoZDQdW9b6YKIMEh9swCtxbVRoL8ZuGsybqAtMbuks/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Noxide", "support_website_url": null, "website_url": "https://monkeybunch.weebly.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "support
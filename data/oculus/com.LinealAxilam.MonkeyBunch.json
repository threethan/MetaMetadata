1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVL5XFgavyoHCYylec1jnXWY1kWkC0jNsdA7BJyPw--Q&oe=6AA563A3"}, {"file_name": "ShopEnterance.png", "id": "649253138129287", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823445_649253141462620_9059741773370254567_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DzWLUq25FQQ7kNvwHVa3Oq&_nc_oc=AdodzWoWJg5xHgkxCTpx3BKGnPxwQs7z4SDL0G7z27pw60LclBDm0BHcnpgcFMK1_Ho&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLnOELaGEx2U0kz6qEMgm8BsHgKH50ulRRHHihmZgGOw&oe=6AA551E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NewCoverV2HeroArtMeta-Space.png", "id": "1781816139903875", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491829165_1781816143237208_8371018028683216414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nlSpYjcs7gQ7kNvwHCwu7H&_nc_oc=Adr45cUzqa13zCRmH_NBWfs0C2R8GBsRES1Y_b8B7jvrSGb07TqcwnGMYUX2xIc3oiQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQz-8EkwfA3FcuppumytAn2Ctj-InUdBCEg8izrhJe2w&oe=6AA54A8A"}, "display_name": "Monkey Bunch", "keywords": ["gorilla", "monkey", "social", "mods", "building"], "long_description": "\nRun, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb.\n{934908111946592}\nExplore community created content! Enjoy levels and items created by the community! or make your own express your inner monkey with your own unique items made with our UGC tools! (Community content is not rated)\n{1222088725521716}\nHang out in a virtual jungle with randos or group up in a private room with friends to hang out and play. The stakes are low, so feel free to just chat or make up your own games. The movement is easy to learn, and hard to master. Crossplay with the PC versions of the game, so play with anyone on any platform.\n{599785382555227}\n\n\nThere are many different levels to explore. Each with their own topography that form routes and obstacles to play on.\n\nVisit our store, with a rotating inventory of items to buy, play with, and wear to express your true monke.\n\nBecome Monkey.", "short_description": "Run, jump, and climb using only your hands. Play many gamemodes with people online. Socialize in public lobbies and release your inner monkey!"}]}, "developer_name": "Another Level Games", "developer_privacy_policy_url": "https://docs.google.com/document/d/1PcoZDQdW9b6YKIMEh9swCtxbVRoL8ZuGsybqAtMbuks/edit?usp=sharing", "developer_terms_of_service_url": "https://anotherlevelgames.co.uk/eula", "publisher_name": "Another Level Games Publishing", "support_website_url": "https://anotherlevelgames.co.uk/support", "website_url": "https://anotherlevelgames.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27619998001012579"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507823984_1068529379201208_1029654360192855236_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjlCMzomKkMQ7kNvwHGbDyC&_nc_oc=Adq5Y6UH0e0QZo6wqofRyNSxko0A69CbwJ1DSRSnkgw9PgDIYkO23MCspZ6gsZnEDS0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7IB3epl35pJp6cHJTFGxnOkk8Qqs_cf6G-OfjP8Ag6A&oe=6AA55D27"},
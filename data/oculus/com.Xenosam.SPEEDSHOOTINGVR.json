05&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alHz03bW37oQ7kNvwEX-O-2&_nc_oc=AdpghuHJuIBI7E4HDi1AjBSehPDuuxxpLd_2i4fqBaRecLY1EHi79gdCKHlFOmZXnzk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgJP8ZP-giN0zKlK02mNlJj1BDx6fJW_CFwE92jy8nBw&oe=6B05CEEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30d0\u30fc\u753b\u50cf(ENG).png", "id": "25366687716248706", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_25366687726248705_503899999526553647_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-uzAfy5FqoQ7kNvwGMaOxc&_nc_oc=AdrH2ocIUqg25LjGiEQ9eXeDzMR1QARml88P7InYK99vwpk5VgUkXizqCwhXwqESsXQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSy8Ld5hjpm6VrUvbgYaGGSce37ITOs_s7wXr9R5V_v0A&oe=6B05B0B9"}, "display_name": "SPEED SHOOTING", "keywords": ["Shooting", "SpeedShooting", "Airsoft", "JSC", "JTSA"], "long_description": "[Mode Description]\n\u30fbA Mode: Original Stage [Fixed Target] (10 Stages)\n\u30fbB Mode: Original Stage [Moving Target] (10 Stages)\n\u30fbC Mode: JSC Competition Stage (8 Stages)\n\u30fbD Mode: JTSA Competition Stage [UNLIMITED & LIMITED] (10 Stages)\n\u30fbTraining Mode: Practice each stage repeatedly.\n\u30fbReflex Training Mode: Practice mode where you quickly defeat randomly appearing targets one by one.\n\nIn modes A to D, you will play each stage three times.\nThe fastest time of the three times will be recorded as the total time for all stages.\nIf you play from the second time onwards, if your new time is faster than your \nprevious best time, your record will be updated.\nPressing the reset button will reset your best time.\n\n[Perfect for PS Division Practice]\nAll stages feature a Point Start (PS) mark.\nAfter pressing the Start button, you must aim at the PS mark in front of the box \nand wait until the buzzer sounds.\nWhen the buzzer sounds, you must shoot all targets according to the stage rules.\n (You cannot fire until the buzzer sounds)\n\n[ About Muzzle Management ]\nThe angle at which the muzzle can be pointed is less\nthan 90 degrees to the left and right from the front.\nIf you point the muzzle further back, \nyou will be disqualified as a competition rule.\n\n[Japan Airsoft Competition Related Websites]\nJSC: https://www.japansteelchallenge.org/\nJTSA: https://jtsa-shooting.org/\n", "short_description": "[Speed \u200b\u200bshooting, where you quickly take down multiple targets]\nThis is a simulation game designed for competitions and shooting practice."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xenosamvr.wixsite.com/privacy/post/%E3%83%95%E3%82%A3%E3%82%AF%E3%82%B7%E3%83%A7%E3%83%B3%E5%B0%8F%E8%AA%AC%EF%BC%9A%E3%81%93%E3%81%AE%E5%A4%8F%E8%AA%AD%E3%82%93%E3%81%A7%E3%81%84%E3%82%8B%E6%9C%AC%E3%82%92%E7%B4%B9%E4%BB%8B", "developer_terms_of_service_url": null, "publisher_name": "Xenosam", "support_website_url": null, "website_url": "https://twitter.com/Xenosam0827", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24865861523085909"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295542_1599926491454548_6206263288533417820_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5skQZF88GqcQ7kN
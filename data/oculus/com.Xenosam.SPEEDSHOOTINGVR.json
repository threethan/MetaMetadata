b=1-7&_nc_sid=6e7a0a&_nc_ohc=3W0vaOZXaAEQ7kNvwG4e2hj&_nc_oc=Adr0WZwFhtdtznUabyw3XDjEKBsy-IW1qSBDYMaUyM35DbxBk4HWq1iy2SEV_ic-qwY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrsDsnDL1kai-F5djnCVLbdEEWtXAmZ1g-oUj6S5-nJg&oe=6A85A651"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8_3.png", "id": "685927487909667", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619588_685927494576333_5056185118659133254_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZmekyURQicQ7kNvwHgyH_z&_nc_oc=Adqa00uM6MXiDhbSlOGKhyQAdEfSmEECZWmpdVWsJvBnzMQQn6UNsIdS4Zs19oHaCyQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGklx0FC0ZFD0va1SqMjL6VXl_iVjDvQNO7ZfJpHWlcXw&oe=6A85A052"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8_4.png", "id": "1363242965475559", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618254_1363242968808892_2087241023210910129_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWxn_1ZrM8MQ7kNvwH_7ijo&_nc_oc=AdoYAWLZqIuU0Ny6WmEzuPafDKlEmwh-MicfOOBpvYblUS3oyXxATUVsUJKD5DWWwUY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBh6a4xhH_z3FSDXJ_o4MDZiw6APW4uBgV_G2DHyYcDg&oe=6A858895"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8_5.png", "id": "1996298454274886", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499619808_1996298457608219_8047803816502745482_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H93T9p7ZEv8Q7kNvwHVArpe&_nc_oc=AdrvdOq8KwiAZhwLcXxlWp4aZLQC3pGFXK3PCu1QbGIDJPpo0_YXO9LmkM7HFR1JSzU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwB7i5m4Puuc_kO6Zt3W1PPKGV37Om92nD0EiJNpIz7A&oe=6A857CEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30d0\u30fc\u753b\u50cf(ENG).png", "id": "25366687716248706", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619078_25366687726248705_503899999526553647_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7v03pSTDw7UQ7kNvwGFo_nd&_nc_oc=AdpdmcWvsIxeUZdU-78zuh6QEEd4Sv553JiAFh8ZRh7XBsJlmKSaP0WGSDS8AbWI_OE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkGKEgSE38idh7B3mTIu_irqdVegb7Os9oQo7hkFx-6Q&oe=6A8596F9"}, "display_name": "SPEED SHOOTING", "keywords": ["Shooting", "SpeedShooting", "Airsoft", "JSC", "JTSA"], "long_description": "[Mode Description]\n\u30fbA Mode: Original Stage [Fixed Target] (10 Stages)\n\u30fbB Mode: Original Stage [Moving Target] (10 Stages)\n\u30fbC Mode: JSC Competition Stage (8 Stages)\n\u30fbD Mode: JTSA Competition Stage [UNLIMITED & LIMITED] (10 Stages)\n\u30fbTraining Mode: Practice each stage repeatedly.\n\u30fbReflex Training Mode: Practice mode where you quickly defeat randomly appearing targets one by one.\n\nIn modes A to D, you will play each stage three times.\nThe fastest time of the three times will be recorded as the total time for all stages.\nIf you play from the second time onwards, if your new time is faster than your \nprevious best time, your record will be updated.\nPressing the reset button will reset your best time.\n\n[Perfect for PS Division Practice]\nAll stages feature a Point Start (PS) mark.\nAfter pressing the Start button, you must aim at the PS mark in front of the box \nand wait until the buzzer sounds.\nWhen the buzzer sounds, you must shoot all targets according to the stage rules.\n (You cannot fire until the buzzer sounds)\n\n[ About Muzzle Management ]\nThe angle at which the muzzle can be pointed is less\nthan 90 degrees to the left and right from the front.\nIf you point the muzzle further back, \nyou will be disqualified as a competition rule.\n\n[Japan Airsoft Competition Related Websites]\nJSC: https://www.japansteelchallenge.org/\nJTSA: https://jtsa-shooting.org/\n", "short_description": "[Speed \u200b\u200bshooting, where you quickly take down multiple targets]\nThis is a simulation game designed for competitions and shooting practice."}]}, "developer_name": null, "develop
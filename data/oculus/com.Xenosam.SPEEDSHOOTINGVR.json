scdn.com/v/t64.5771-25/499302344_2254158445069814_7863098556296497519_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2XY759vEmwQ7kNvwH4BN1m&_nc_oc=AdqoAY3e0iwOPp8G7Rp6wG0HR2biUkLGy9WTCc9uPpStrAHxCfocSSWo5XeNmyy5mZQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVBpVGvHYx-L7nppanghyRcOGe7tOpCLThkDwuxRqEvA&oe=6AFDC155"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8_5.png", "id": "1532344537944782", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499627379_1532344541278115_4949922575106248745_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIfrO-I-_RUQ7kNvwEdq8HJ&_nc_oc=AdqWYyumdp8WTmtzmOn77AFApuIqxsOGb9XOONQUK5uErs5NMZD4rFxyQFZRI-zTACQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQV76XB_KdyOO1n6ZOaeTDGeB0nLHDd4DEu5gUfCHG28A&oe=6AFDB47C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30d0\u30fc\u753b\u50cf(ENG).png", "id": "25366687716248706", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619078_25366687726248705_503899999526553647_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdtEDQCn1NEQ7kNvwE8NhBn&_nc_oc=AdrTddHi2Srk0OYaKU-bDxZp3wMpuXSGXyOYgvyekjZVEeKeqka_ayXFFaznruWoEyg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmZsnairOg-96CSCBr52XP2bq313hPze04lemaV2gSGw&oe=6AFDC7B9"}, "display_name": "SPEED SHOOTING", "keywords": ["Shooting", "SpeedShooting", "Airsoft", "JSC", "JTSA"], "long_description": "[Mode Description]\n\u30fbA Mode: Original Stage [Fixed Target] (10 Stages)\n\u30fbB Mode: Original Stage [Moving Target] (10 Stages)\n\u30fbC Mode: JSC Competition Stage (8 Stages)\n\u30fbD Mode: JTSA Competition Stage [UNLIMITED & LIMITED] (10 Stages)\n\u30fbTraining Mode: Practice each stage repeatedly.\n\nIn modes A to D, you will play each stage three times.\nThe fastest time of the three times will be recorded as the total time for all stages.\nIf you play from the second time onwards, if your new time is faster than your \nprevious best time, your record will be updated.\nPressing the reset button will reset your best time.\n\n[Perfect for PS Division Practice]\nAll stages feature a Point Start (PS) mark.\nAfter pressing the Start button, you must aim at the PS mark in front of the box \nand wait until the buzzer sounds.\nWhen the buzzer sounds, you must shoot all targets according to the stage rules.\n (You cannot fire until the buzzer sounds)\n\n[ About Muzzle Management ]\nThe angle at which the muzzle can be pointed is less\nthan 90 degrees to the left and right from the front.\nIf you point the muzzle further back, \nyou will be disqualified as a competition rule.\n\n[Japan Airsoft Competition Related Websites]\nJSC: https://www.japansteelchallenge.org/\nJTSA: https://jtsa-shooting.org/\n", "short_description": "[Speed \u200b\u200bshooting, where you quickly take down multiple targets]\nThis is a simulation game designed for competitions and shooting practice."}, {"images": {"nodes": [{"file_name": "\u7e26\u9577\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8.png", "id": "24817750137845973", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619145_24817750141179306_6087807556077998662_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPI-jXvSMUIQ7kNvwH1EZXe&_nc_oc=Adr_kGaXe2gTUDEHX2Pa1TI6tJ3_ksUClUSFdPonjYSQeUhnEojTNy15rzUt5ehOaas&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQW9Rv5S6P2-YiR1-LZj-OHxTDSCflAtSvPbpwsaTPXFg&oe=6AFDBEF0"}, {"file_name": "\u6a2a\u9577\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8.png", "id": "24721984530743573", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619159_24721984550743571_6773484904466556326_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBzRSdA4i7wQ7kNvwFecAAf&_nc_oc=Ado0Wopql5l_I-wpmGFIc7pL2GUNnA
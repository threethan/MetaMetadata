yMIxc65E8dtROfDoTJzxSzjs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsdB4LjoJT0BwYIkjxiEnV-MrZaGPqwhJC-O-G7-6UYg&oe=6B071C15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30d0\u30fc\u753b\u50cf.png", "id": "1483542646243524", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618297_1483542649576857_4765499086545697551_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZXRp_ft1SEQ7kNvwGFw8A_&_nc_oc=Adoeiuij9NCcBIm7K3M_GrcPurJ_-DE09VzXgus9BEbVdd65W8vdVuHSeSfn4ZecDIc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQghK0cC8Q8ICsu0fjwoYQEsQBiyxPJIzx3z37gwVaBNw&oe=6B0725DE"}, "display_name": "SPEED SHOOTING", "keywords": ["\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0", "\u30b9\u30d4\u30fc\u30c9\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0", "\u30a8\u30a2\u30ac\u30f3", "JSC", "JTSA"], "long_description": "\u3010\u30e2\u30fc\u30c9\u306e\u8aac\u660e\u3011\n\u30fbA\u30e2\u30fc\u30c9\uff1a\u30aa\u30ea\u30b8\u30ca\u30eb\u30b9\u30c6\u30fc\u30b8[\u56fa\u5b9a\u30bf\u30fc\u30b2\u30c3\u30c8]\uff08\u516810\u30b9\u30c6\u30fc\u30b8\uff09\n\u30fbB\u30e2\u30fc\u30c9\uff1a\u30aa\u30ea\u30b8\u30ca\u30eb\u30b9\u30c6\u30fc\u30b8[\u53ef\u52d5\u30bf\u30fc\u30b2\u30c3\u30c8]\uff08\u516810\u30b9\u30c6\u30fc\u30b8\uff09\n\u30fbC\u30e2\u30fc\u30c9\uff1aJSC\u7af6\u6280\u30b9\u30c6\u30fc\u30b8\uff08\u51688\u30b9\u30c6\u30fc\u30b8\uff09\n\u30fbD\u30e2\u30fc\u30c9\uff1aJTSA\u7af6\u6280\u30b9\u30c6\u30fc\u30b8[UNLIMITED&LIMITED]\uff08\u516810\u30b9\u30c6\u30fc\u30b8\uff09\n\u30fbTraining\u30e2\u30fc\u30c9\uff1a\u5404\u30b9\u30c6\u30fc\u30b8\u306e\u53cd\u5fa9\u7df4\u7fd2\u7528\u30e2\u30fc\u30c9\n\u30fbReflex Training\u30e2\u30fc\u30c9\uff1a\u30e9\u30f3\u30c0\u30e0\u306b\u51fa\u73fe\u3059\u308b\u30bf\u30fc\u30b2\u30c3\u30c8\u30921\u4f53\u305a\u3064\u7d20\u65e9\u304f\u5012\u3059\u53cd\u5fa9\u7df4\u7fd2\u7528\u30e2\u30fc\u30c9\n\nA\uff5eD\u30e2\u30fc\u30c9\u3067\u306f\u3001\u5404\u30b9\u30c6\u30fc\u30b8\u30923\u56de\u30d7\u30ec\u30a4\u3057\u307e\u3059\u3002\n3\u56de\u306e\u3046\u3061\u6700\u3082\u65e9\u304b\u3063\u305f\u30bf\u30a4\u30e0\u3092\u5168\u30b9\u30c6\u30fc\u30b8\u5206\u3001\u5408\u8a08\u3057\u305f\u30bf\u30a4\u30e0\u304c\u30d9\u30b9\u30c8\u30bf\u30a4\u30e0\u3068\u3057\u3066\u8a18\u9332\u3055\u308c\u307e\u3059\u3002\n2\u56de\u76ee\u4ee5\u964d\u306e\u30d7\u30ec\u30a4\u3067\u306f\u3001\u524d\u56de\u306e\u30d9\u30b9\u30c8\u30bf\u30a4\u30e0\u3088\u308a\u3082\u65e9\u3044\u5834\u5408\u3001\u8a18\u9332\u304c\u66f4\u65b0\u3055\u308c\u307e\u3059\u3002\n\u30ea\u30bb\u30c3\u30c8\u30dc\u30bf\u30f3\u3092\u62bc\u3059\u3068\u30d9\u30b9\u30c8\u30bf\u30a4\u30e0\u304c\u30ea\u30bb\u30c3\u30c8\u3055\u308c\u307e\u3059\u3002\n\n\u3010PS\u90e8\u9580\u306e\u7df4\u7fd2\u306b\u6700\u9069\u3011\n\u5168\u30b9\u30c6\u30fc\u30b8\u306b\u30dd\u30a4\u30f3\u30c8\u30b9\u30bf\u30fc\u30c8(PS)\u30de\u30fc\u30af\u3092\u914d\u7f6e\u3057\u3066\u3042\u308a\u3001\n\u7af6\u6280\u958b\u59cb\u30dc\u30bf\u30f3\u3092\u62bc\u3057\u3066\u304b\u3089\u30d6\u30b6\u30fc\u304c\u9cf4\u308b\u307e\u3067\u306f\u3001\nBOX\u524d\u306ePS\u30de\u30fc\u30af\u3092\u72d9\u3063\u305f\u72b6\u614b\u3067\u5f85\u6a5f\u3057\u307e\u3059\u3002\n\u30d6\u30b6\u30fc\u304c\u9cf4\u3063\u305f\u3089\u30b9\u30c6\u30fc\u30b8\u30eb\u30fc\u30eb\u306b\u6cbf\u3063\u3066\u30bf\u30fc\u30b2\u30c3\u30c8\u3092\u5168\u3066\u6483\u3061\u307e\u3059\u3002\n\uff08\u30d6\u30b6\u30fc\u304c\u9cf4\u308b\u307e\u3067\u306f\u767a\u7832\u3067\u304d\u307e\u305b\u3093\uff09\n\n\u3010 \u9283\u53e3\u7ba1\u7406\u306b\u3064\u3044\u3066 \u3011\n\u9283\u53e3\u3092\u5411\u3051\u3066\u3088\u3044\u89d2\u5ea6\u306f\u3001\u6b63\u9762\u304b\u3089\u5de6\u53f390\u5ea6\u672a\u6e80\u307e\u3067\u3002\n\u305d\u308c\u4ee5\u4e0a\u306b\u5f8c\u65b9\u306b\u9283\u53e3\u3092\u5411\u3051\u308b\u3068\u7af6\u6280\u30eb\u30fc\u30eb\u3068\u3057\u3066\u5931\u683c\u3068\u306a\u308a\u307e\u3059\u3002\n\n\u3010\u65e5\u672c\u30a8\u30a2\u30ac\u30f3\u7af6\u6280\u95a2\u9023\u30b5\u30a4\u30c8\u30
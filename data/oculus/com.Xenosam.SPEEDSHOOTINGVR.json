_sid=6e7a0a&_nc_ohc=VnuaPKRnkxAQ7kNvwGHAa_y&_nc_oc=AdppMli5VMfjfT_aiW6u_GB9XdqhnQe_6JT2YsPE9lbM3EOQxdb1Tf0WXIEepaEdTxM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIouBuE-JVEK7IyaHdNMg_j5Lzg2DXd51bbcC1H5k0Q3g&oe=6AA93ED1"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8_3.png", "id": "685927487909667", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499619588_685927494576333_5056185118659133254_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GD7LUarRVMQ7kNvwFwVE1d&_nc_oc=Ado4SMpXhv7SH7A6KLrDYe2EJJaPAPheGJe5hFZ91iimEXaa1tmuYGWxuj29OncmTQI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIj_IXcNxNcGYiF0xk_UZRV2ZM8CwHyrCJD147ckH0Ynw&oe=6AA938D2"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8_4.png", "id": "1363242965475559", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499618254_1363242968808892_2087241023210910129_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xj09Tk3Hl9AQ7kNvwGjczNx&_nc_oc=AdqmJ58h_d-TOVyQVHBrWx4j1laRJPa8KBidQZAn5ZbCwMBm1aENxuML-TU_pYlU6ng&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5_3XkM5otmF5vq9i_Ga5gk_br1OEDtRi5ZCY_7PZj0w&oe=6AA95955"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8_5.png", "id": "1996298454274886", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619808_1996298457608219_8047803816502745482_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4x3oSzwBhnsQ7kNvwGXmwbI&_nc_oc=AdpOZlUCgemjBKbZoirOrGIom_A4FIfZdudV2aHjgacTw950j5h13yhsIA4PCJKW9oc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYIKAMogRF3nSdpWHmFrPpizXOw3N_kXLeDcvpufMEAQ&oe=6AA94DAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30d0\u30fc\u753b\u50cf(ENG).png", "id": "25366687716248706", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499619078_25366687726248705_503899999526553647_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMw3bcV_ZM0Q7kNvwECAunO&_nc_oc=AdoQGFUqSzG7Zv39LhdFWTtokvBECNtZj-IfGUroY9OXhrTJdH7SD7qerMOsUsdPa6s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLl_WNAWD_zNLyw7f3qKtPHAuqMYLyk85cDHi7p8c86iA&oe=6AA967B9"}, "display_name": "SPEED SHOOTING", "keywords": ["Shooting", "SpeedShooting", "Airsoft", "JSC", "JTSA"], "long_description": "[Mode Description]\n\u30fbA Mode: Original Stage [Fixed Target] (10 Stages)\n\u30fbB Mode: Original Stage [Moving Target] (10 Stages)\n\u30fbC Mode: JSC Competition Stage (8 Stages)\n\u30fbD Mode: JTSA Competition Stage [UNLIMITED & LIMITED] (10 Stages)\n\u30fbTraining Mode: Practice each stage repeatedly.\n\u30fbReflex Training Mode: Practice mode where you quickly defeat randomly appearing targets one by one.\n\nIn modes A to D, you will play each stage three times.\nThe fastest time of the three times will be recorded as the total time for all stages.\nIf you play from the second time onwards, if your new time is faster than your \nprevious best time, your record will be updated.\nPressing the reset button will reset your best time.\n\n[Perfect for PS Division Practice]\nAll stages feature a Point Start (PS) mark.\nAfter pressing the Start button, you must aim at the PS mark in front of the box \nand wait until the buzzer sounds.\nWhen the buzzer sounds, you must shoot all targets according to the stage rules.\n (You cannot fire until the buzzer sounds)\n\n[ About Muzzle Management ]\nThe angle at which the muzzle can be pointed is less\nthan 90 degrees to the left and right from the front.\nIf you point the muzzle further back, \nyou will be disqualified as a competition rule.\n\n[Japan Airsoft Competition Related Websites]\nJSC: https://www.japansteelchallenge.org/\nJTSA: https://jtsa-shooting.org/\n", "short_description": "[Speed \u200b\u200bshooting, where you quickly take down multiple targets]\nThis is a simulation game designed for competitions and shooting practice."}]}, "developer_name": null, "developer_privacy_pol
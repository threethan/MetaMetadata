scdn.com/v/t64.5771-25/499302344_2254158445069814_7863098556296497519_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saSMf51Ipz4Q7kNvwFAeq6N&_nc_oc=AdqYXmLEVfJwTX0Hy8oNoYRlUV1ghwEPu6GSN7O1T7dz17aXlBw1FWb3dxRbs5mCkmg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeUQkPSVj0TbUFHvnR9K7Hguga_jtYS5A9yRbQuzNiJw&oe=6AFB1E55"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8_5.png", "id": "1532344537944782", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499627379_1532344541278115_4949922575106248745_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZh6ISQ2TUQQ7kNvwEmEb0M&_nc_oc=AdqiidDrmCd9_XHLcxjWA16-cx_VT_GORdHFydvFxtd2tdhq2S8Hzd_dB-FXL72m-m0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSy_JTaHJndFdbKZOfLJfIQBIvkK7uipjeeSgbunCCUg&oe=6AFB49BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30d0\u30fc\u753b\u50cf(ENG).png", "id": "25366687716248706", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619078_25366687726248705_503899999526553647_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4wCAaycu2EQ7kNvwHb-LcJ&_nc_oc=AdqjXO3EhwmfFEeu_LNqG13_3KWFMxGqU4bg9rOXwXVYenAZVUKP5KfoZwutD4K_E0Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEyfSFKfuNQTKHT9Faki7iVkmMTf85SQZvwaZ2jp1UBg&oe=6AFB24B9"}, "display_name": "SPEED SHOOTING", "keywords": ["Shooting", "SpeedShooting", "Airsoft", "JSC", "JTSA"], "long_description": "[Mode Description]\n\u30fbA Mode: Original Stage [Fixed Target] (10 Stages)\n\u30fbB Mode: Original Stage [Moving Target] (10 Stages)\n\u30fbC Mode: JSC Competition Stage (8 Stages)\n\u30fbD Mode: JTSA Competition Stage [UNLIMITED & LIMITED] (10 Stages)\n\u30fbTraining Mode: Practice each stage repeatedly.\n\nIn modes A to D, you will play each stage three times.\nThe fastest time of the three times will be recorded as the total time for all stages.\nIf you play from the second time onwards, if your new time is faster than your \nprevious best time, your record will be updated.\nPressing the reset button will reset your best time.\n\n[Perfect for PS Division Practice]\nAll stages feature a Point Start (PS) mark.\nAfter pressing the Start button, you must aim at the PS mark in front of the box \nand wait until the buzzer sounds.\nWhen the buzzer sounds, you must shoot all targets according to the stage rules.\n (You cannot fire until the buzzer sounds)\n\n[ About Muzzle Management ]\nThe angle at which the muzzle can be pointed is less\nthan 90 degrees to the left and right from the front.\nIf you point the muzzle further back, \nyou will be disqualified as a competition rule.\n\n[Japan Airsoft Competition Related Websites]\nJSC: https://www.japansteelchallenge.org/\nJTSA: https://jtsa-shooting.org/\n", "short_description": "[Speed \u200b\u200bshooting, where you quickly take down multiple targets]\nThis is a simulation game designed for competitions and shooting practice."}, {"images": {"nodes": [{"file_name": "\u7e26\u9577\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8.png", "id": "24817750137845973", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619145_24817750141179306_6087807556077998662_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zp_FZtrziU0Q7kNvwGv8YRY&_nc_oc=AdpouCr_h3uqxostGRJmFAIBVnzqW8LLg_1d8GRXV0D-zBOPSewDxlL8IvUh0cO7qOU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3NmvnzY0Zq021LD-yt95_4VdbVubEtliJkyFl8ml3fA&oe=6AFB1BF0"}, {"file_name": "\u6a2a\u9577\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8.png", "id": "24721984530743573", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619159_24721984550743571_6773484904466556326_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=134hAtbRQ3gQ7kNvwHyY-oM&_nc_oc=AdrnQBIftH5Z-H2WzV8NEXyclJDUVw
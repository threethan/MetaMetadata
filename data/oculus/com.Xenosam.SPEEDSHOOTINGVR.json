scdn.com/v/t64.5771-25/499302344_2254158445069814_7863098556296497519_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAJpaHHfQfoQ7kNvwH8Efsd&_nc_oc=AdrIDHirOAN1Uc4MYklnrMIXAW6lQC6mOAz7c2I_e5dRpZ95ActKMXaswCa0ppdABOU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUW8uksr479IPf37Bm0nG1VXnHRyuQJSxw6gedzsvQEjg&oe=6B103655"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8_5.png", "id": "1532344537944782", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499627379_1532344541278115_4949922575106248745_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mn4K19u1pdcQ7kNvwH5W7zq&_nc_oc=Adok8M1L_9vGQh_reanaoYIasZBT0GTA2TILuLp-q_XLrM1wMWbVKapPVa1FXLvqz2s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXGb-9Ftd-3xXgLm_71-Iz0Q9ntUdwOGW60Ho_d_3j7nA&oe=6B1061BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30d0\u30fc\u753b\u50cf(ENG).png", "id": "25366687716248706", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_25366687726248705_503899999526553647_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_5zCbD0UnAQ7kNvwHk8Zbi&_nc_oc=AdoLE-bzs2vkS1Z3PyHYUgeMaoCoX3pFCxJCr04s223w8RZspT0WXFhayoXtREsKiKY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUxuqPDtAr15mMtyPQeJ_4376ZXLmQOimuVYxeaHgQ4Og&oe=6B103CB9"}, "display_name": "SPEED SHOOTING", "keywords": ["Shooting", "SpeedShooting", "Airsoft", "JSC", "JTSA"], "long_description": "[Mode Description]\n\u30fbA Mode: Original Stage [Fixed Target] (10 Stages)\n\u30fbB Mode: Original Stage [Moving Target] (10 Stages)\n\u30fbC Mode: JSC Competition Stage (8 Stages)\n\u30fbD Mode: JTSA Competition Stage [UNLIMITED & LIMITED] (10 Stages)\n\u30fbTraining Mode: Practice each stage repeatedly.\n\nIn modes A to D, you will play each stage three times.\nThe fastest time of the three times will be recorded as the total time for all stages.\nIf you play from the second time onwards, if your new time is faster than your \nprevious best time, your record will be updated.\nPressing the reset button will reset your best time.\n\n[Perfect for PS Division Practice]\nAll stages feature a Point Start (PS) mark.\nAfter pressing the Start button, you must aim at the PS mark in front of the box \nand wait until the buzzer sounds.\nWhen the buzzer sounds, you must shoot all targets according to the stage rules.\n (You cannot fire until the buzzer sounds)\n\n[ About Muzzle Management ]\nThe angle at which the muzzle can be pointed is less\nthan 90 degrees to the left and right from the front.\nIf you point the muzzle further back, \nyou will be disqualified as a competition rule.\n\n[Japan Airsoft Competition Related Websites]\nJSC: https://www.japansteelchallenge.org/\nJTSA: https://jtsa-shooting.org/\n", "short_description": "[Speed \u200b\u200bshooting, where you quickly take down multiple targets]\nThis is a simulation game designed for competitions and shooting practice."}, {"images": {"nodes": [{"file_name": "\u7e26\u9577\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8.png", "id": "24817750137845973", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619145_24817750141179306_6087807556077998662_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rvex6SmnhyEQ7kNvwFTPROq&_nc_oc=Adpyd81Pwkv5RaoDbVSqIC9_y-4r5lfHXdPSaFgacLXVXFHV8Oq2fRegOIroOIBbWv8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUeyXVVvVFikeHgpvrx3rndnFoI7dPpgow8hR3ozdNJpQ&oe=6B106C30"}, {"file_name": "\u6a2a\u9577\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8.png", "id": "24721984530743573", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619159_24721984550743571_6773484904466556326_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FsqYkrWgpwQ7kNvwGOeztv&_nc_oc=AdoKJDkpm7t652UHXJ67CvYaGFvCg_
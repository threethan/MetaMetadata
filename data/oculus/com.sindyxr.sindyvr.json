ontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036702_405394975230134_1231207497337063628_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eq6CGD2L2psQ7kNvwGl1vOk&_nc_oc=Adro_SqSlhe9P5X1RBLX3dI28VMqbr12S41JVR9RiGmDmB_Vh31qBS2SX69RF7oOCmw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSuLY2-SLBjaNFR2MbgBFbUOXIVyAeCA9_QYAr7ed0rg&oe=6B06F55F"}, {"file_name": "Screenshot 2024-03-05 091018.png", "id": "1625963998148659", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031358_1625964001481992_2451125503331407973_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiS4xoUWceAQ7kNvwEsSCbu&_nc_oc=Adr9SZ4J9LwbB8XjN_5GU6CyjgmwXv6t_iRCL21wmwNnp4UrlwrF54xtakqJ1kUfluE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoEfn6y4c3X8xGi6-Ep5iZxrHi0JSTLyKa8ikvsi-u8A&oe=6B06FBCF"}, {"file_name": "Screenshot 2024-03-05.png", "id": "1134545604657762", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035332_1134545607991095_6433373883315633325_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-GJ7YNmpXUQ7kNvwH5Rlnj&_nc_oc=AdqFEKII9r9eFq9O2zYK9wj2brOjTfQOIZzTV57csnXUSdLIOBpmynrbZdbRRilkCoc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5OSStThRsL883OFC2bMmXKfttTfOSkcuOWcqiEwlIFQ&oe=6B06FBE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-03-05 090758.png", "id": "1444618836439273", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982475_1444618839772606_6353122881509702687_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tg0IrWMuyoMQ7kNvwGZtZuU&_nc_oc=Adpb1bIp2hIvwfRhaqVei0fC5iCd5CU1zSs9hJ-KauShzaya2tIglXf17TlCDy-piuI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXKh2m9e6wKy2_V3wtkE1Kvs2Y_AjawVp9mlHGvKMwXQ&oe=6B07159B"}, "display_name": "SindyXR", "keywords": [], "long_description": "SindyXR, The Seamless Integrated Dynamics Company, is committed to empowering your lifelong wellness journey by enabling you to interact with people going through a similar situation as you, within in a safe and nurturing environment, moderated by qualified medical professionals. \n\nWhat can you do in between appointments with your health care professional?  Who can you speak with that is in a similar situation as you?  Whether you are a family with a new baby on the way, a teenager dealing with anxiety issues, a young adult seeking better work/life balance, an older adult seeking to manage diabetes\u2026.or just someone dealing with the many other challenges that sometimes we face in life, the SindyXR Wellness Community is here for you. \n\nAs a Member of the SindyXR Wellness Community, you can select from multi-category SindyXR Cubes, and then engage in live interactive small group SindyXR Wellness Circles & large group SindyXR Wellness Webinars, all while learning about yourself from information rich SindyXR Data Pins and SindyXR\u2019s proprietary \u201cCheck Yo Self\u201d multiplayer game.\n\nAs you grow, understand, and evolve through life, rest assured that the SindyXR Wellness Community will support you on your uniquely beautiful life journey. Forever or for as long as you need us.", "short_description": "As you grow, understand, and evolve through life, rest assured that the SindyXR Wellness Community will support you on your uniquely beautiful life journey. Forever or for as long as you need us."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wellness.sindyxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SindyXR", "support_website_url": null, "website_url": "http://sindyxr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], 
ontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036702_405394975230134_1231207497337063628_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8_jzPr1aQAQ7kNvwFNRf5E&_nc_oc=AdrM41yrDhNQTIb-OKyx8cXaX-fRRl1aO3WtvGLJ_lXyOKcp5w4XOfCojrjKYyR_8Es&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSgm4Q3sAYC_AklnQIyKEBCKDZ-DttiKY_nuUU2jj1NeA&oe=6B0DC51F"}, {"file_name": "Screenshot 2024-03-05 091018.png", "id": "1625963998148659", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031358_1625964001481992_2451125503331407973_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaUTcfBhmy0Q7kNvwH2uO1m&_nc_oc=Adq2WYO3GN4nJolQW4-pOpNFjNXinDG1uULtdKFMD6xUs1QDnPoiqUZE8cFfDj3Zd1Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR5mazABbif577FeFhKkZWpQ911ePdSdjPALbEX7X1JHw&oe=6B0DCB8F"}, {"file_name": "Screenshot 2024-03-05.png", "id": "1134545604657762", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035332_1134545607991095_6433373883315633325_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmkwZImZSvAQ7kNvwHHnKze&_nc_oc=Adq5piWQw4IsFUPpTmkgB_xI7FaYtwbH7uGrtr7pmkulW9uLTUbeJ4FZZ45a0YzP8rA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTyyjD8bYBVGcG_zQEQ8WOTSpDVQA20trX6arW2UBXxdg&oe=6B0DCBA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-03-05 090758.png", "id": "1444618836439273", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982475_1444618839772606_6353122881509702687_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ax8I4kM6FH4Q7kNvwEl1x6B&_nc_oc=AdqSadnmMmPpBApDl6asLEdRvngFXR16ql7RLOVObo9LZoPceqecLKiY71jjmPZP3UM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQYWF2Phixx0Lm3xVlNSxwY_BVS9OG5KbeyQUy9_xGpeQ&oe=6B0DAD1B"}, "display_name": "SindyXR", "keywords": [], "long_description": "SindyXR, The Seamless Integrated Dynamics Company, is committed to empowering your lifelong wellness journey by enabling you to interact with people going through a similar situation as you, within in a safe and nurturing environment, moderated by qualified medical professionals. \n\nWhat can you do in between appointments with your health care professional?  Who can you speak with that is in a similar situation as you?  Whether you are a family with a new baby on the way, a teenager dealing with anxiety issues, a young adult seeking better work/life balance, an older adult seeking to manage diabetes\u2026.or just someone dealing with the many other challenges that sometimes we face in life, the SindyXR Wellness Community is here for you. \n\nAs a Member of the SindyXR Wellness Community, you can select from multi-category SindyXR Cubes, and then engage in live interactive small group SindyXR Wellness Circles & large group SindyXR Wellness Webinars, all while learning about yourself from information rich SindyXR Data Pins and SindyXR\u2019s proprietary \u201cCheck Yo Self\u201d multiplayer game.\n\nAs you grow, understand, and evolve through life, rest assured that the SindyXR Wellness Community will support you on your uniquely beautiful life journey. Forever or for as long as you need us.", "short_description": "As you grow, understand, and evolve through life, rest assured that the SindyXR Wellness Community will support you on your uniquely beautiful life journey. Forever or for as long as you need us."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wellness.sindyxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SindyXR", "support_website_url": null, "website_url": "http://sindyxr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], 
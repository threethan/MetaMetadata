FekvYgQ7kNvwG6_9SZ&_nc_oc=AdpC3XifdVS06Hrbf3hKv0rjVc0QI1xluD8pwVSIMP_KVXQzSgrIpegRlKq4wPkD_B8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1FLPO5nFzP6Jgjg8HvXdjv1D3zfQXnXA32gu9XlXDEzA&oe=69F4C3CF"}, {"file_name": "Screenshot 2024-03-05.png", "id": "1134545604657762", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035332_1134545607991095_6433373883315633325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAJ5duxZ2D0Q7kNvwF-nlp9&_nc_oc=AdqdCjotbb8wMQpkEBSe8KCyIIxBi2wGySE4hSwOHKFyFf53ZaFjfgtFLg4R9fxBPM8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2pmb90Yiiwio03LI9HDePztKYu62V6GZFSlkAGQYsvDQ&oe=69F4C3E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-03-05 090758.png", "id": "1444618836439273", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982475_1444618839772606_6353122881509702687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5RZl2CQpuMQ7kNvwFhcP4e&_nc_oc=Ado2z7KLSrHe9hswb-txgLWiI4ElsygxRF1LHIZT-Ruw1GrtaFv2GB7td0qnSEb6uU8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af39vndmTSgSSyiMdocoHpL3WqhetauOGa3IO8rGbt-AzQ&oe=69F4A55B"}, "display_name": "SindyXR", "keywords": [], "long_description": "SindyXR, The Seamless Integrated Dynamics Company, is committed to empowering your lifelong wellness journey by enabling you to interact with people going through a similar situation as you, within in a safe and nurturing environment, moderated by qualified medical professionals. \n\nWhat can you do in between appointments with your health care professional?  Who can you speak with that is in a similar situation as you?  Whether you are a family with a new baby on the way, a teenager dealing with anxiety issues, a young adult seeking better work/life balance, an older adult seeking to manage diabetes\u2026.or just someone dealing with the many other challenges that sometimes we face in life, the SindyXR Wellness Community is here for you. \n\nAs a Member of the SindyXR Wellness Community, you can select from multi-category SindyXR Cubes, and then engage in live interactive small group SindyXR Wellness Circles & large group SindyXR Wellness Webinars, all while learning about yourself from information rich SindyXR Data Pins and SindyXR\u2019s proprietary \u201cCheck Yo Self\u201d multiplayer game.\n\nAs you grow, understand, and evolve through life, rest assured that the SindyXR Wellness Community will support you on your uniquely beautiful life journey. Forever or for as long as you need us.", "short_description": "As you grow, understand, and evolve through life, rest assured that the SindyXR Wellness Community will support you on your uniquely beautiful life journey. Forever or for as long as you need us."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wellness.sindyxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SindyXR", "support_website_url": null, "website_url": "http://sindyxr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6774609615927484"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "656019149703709"}]}, "baseline_offer": {"id": "656019149703709"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1710876180, "status": "PUBLISHED", "id": "65601914970
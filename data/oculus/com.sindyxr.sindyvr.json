ontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036702_405394975230134_1231207497337063628_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eq6CGD2L2psQ7kNvwFOOZos&_nc_oc=Adq9B3CI5WQybPSTOESvkFhx4-tbP_SUXIYixZQDRl70UhLIFgybLNmfNQJDnu2SSEI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQp7REZAi2Ud1GJQ1iZiNWSk85FYmT-FoS4flyB6GX1Rg&oe=6B048A9F"}, {"file_name": "Screenshot 2024-03-05 091018.png", "id": "1625963998148659", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031358_1625964001481992_2451125503331407973_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiS4xoUWceAQ7kNvwGI0XZ5&_nc_oc=Adqq0QEBzqErCL6jJzOYv0EgHyjcngeraU-gn1bOuXLhLeY5RhW7gKs-TxJo7QkvqBU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpGoir1m6YrzJL8Rq03bnQmjzOO9c6GDbrTU9jnQb3QA&oe=6B0458CF"}, {"file_name": "Screenshot 2024-03-05.png", "id": "1134545604657762", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035332_1134545607991095_6433373883315633325_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-GJ7YNmpXUQ7kNvwHGIozX&_nc_oc=AdrXWmlirnlCQru17b5xsV-qsJdPH2XVOSYaY5Qz7-74K1fy5de5iBx1B4ZWNkx9sLU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4O3vIiSTvrGCZPbQ0EfAihsImqGfw8DdfkVAhimJ-Bw&oe=6B0458E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-03-05 090758.png", "id": "1444618836439273", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982475_1444618839772606_6353122881509702687_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8iMrbZPBs4Q7kNvwGFZZJ6&_nc_oc=AdoStwJyX4Bw6gogs_Leah1j9IDHkvlof5p1A6JybsCNsXM2qS3Yd3_s1Ol-hLOREfU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfyfHh4DilHv44ffrbdo2cG1ENb6D3e3BKi05-1ZZ-gQ&oe=6B04729B"}, "display_name": "SindyXR", "keywords": [], "long_description": "SindyXR, The Seamless Integrated Dynamics Company, is committed to empowering your lifelong wellness journey by enabling you to interact with people going through a similar situation as you, within in a safe and nurturing environment, moderated by qualified medical professionals. \n\nWhat can you do in between appointments with your health care professional?  Who can you speak with that is in a similar situation as you?  Whether you are a family with a new baby on the way, a teenager dealing with anxiety issues, a young adult seeking better work/life balance, an older adult seeking to manage diabetes\u2026.or just someone dealing with the many other challenges that sometimes we face in life, the SindyXR Wellness Community is here for you. \n\nAs a Member of the SindyXR Wellness Community, you can select from multi-category SindyXR Cubes, and then engage in live interactive small group SindyXR Wellness Circles & large group SindyXR Wellness Webinars, all while learning about yourself from information rich SindyXR Data Pins and SindyXR\u2019s proprietary \u201cCheck Yo Self\u201d multiplayer game.\n\nAs you grow, understand, and evolve through life, rest assured that the SindyXR Wellness Community will support you on your uniquely beautiful life journey. Forever or for as long as you need us.", "short_description": "As you grow, understand, and evolve through life, rest assured that the SindyXR Wellness Community will support you on your uniquely beautiful life journey. Forever or for as long as you need us."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wellness.sindyxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SindyXR", "support_website_url": null, "website_url": "http://sindyxr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], 
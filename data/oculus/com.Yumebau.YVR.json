m&_nc_ss=7f20f&oh=00_AQCULy9BWqUKJo1nw0gA4QZdOALT78x6gVqlnoUlwp4Dpg&oe=6A68B4B3"}, {"file_name": "scanning_2560x1440.png", "id": "2238076266557495", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035397_2238076269890828_1270359774179466352_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8xfTXjlF3IQ7kNvwG2W6sc&_nc_oc=Adq8v8tP_977EhZuqWPkvEvBqRwUZ2PhiFvcELgEI8zq-S3JqToRcrr1lCL8W1alJL0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDc1c9kYzvE7KVotwNakLz45o5vlxy-Uj11A8B46iz4ag&oe=6A68B9EF"}, {"file_name": "time trial_2560x1440.png", "id": "508869845348808", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982447_508869852015474_4622533083298435395_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_xr7R1QY14Q7kNvwEsnVBK&_nc_oc=AdoL8GsH_Wa9H-OSFLqNmUPnzIhNwG9ZNG-4_rr8hgxVC6TUom6MMGa_gtoLgaO4TTE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIyVAx90G1bwWltqo8v1VQrajf_CHv6mkeXT0nrWDn7A&oe=6A6896A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image (2560x1440px).png", "id": "1242321223562374", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304798_1242321226895707_7489816028602698308_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkX2C7nEIgUQ7kNvwHbhQby&_nc_oc=Adq0TNeekygZR0-vqVSXTZ5NST3Ba8jvRzIBOc5UgPP0N9rT5-ERN9vPmvgxZvQPyAQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-Td29zgBLY8U-Z5JECcEX1JYrObjcc-5I68JQis-LjA&oe=6A68C1D4"}, "display_name": "BuildPort Xumia", "keywords": ["Sandbox", "Building", "Simulation", "Piloting", "Combat"], "long_description": "# BUILD. BATTLE. ADAPT. \ud83d\udee0\ufe0f\ud83d\udca1\u2694\ufe0f\n\nImmerse yourself in the world of **BuildPort Xumia** where **brains**, **ingenuity**, and **skills** matter!\nUnleash your inner Da Vinci! Use out-of-this-world tek to build beast-mode ships. Battle your way to legendary status in Xumia!\n\n{1007685401386300}\n\n# Dominate With Ships Built By **YOU**\n- Loadout with powerful **weapons**, **sensors** and other tech to make your ships unique.\n- Build for *blistering speed*, *ironclad durability*, or *jaw-dropping swagger*\u2014its up to **YOU**\n- Balance **power** and **handling** in your builds.\n- Refine agility with precision placement of thrusters.\n- Wire sensors to weapons for automatic firing.\n\n{1199156102006224}\n\n# Xumia is for **EVERYONE**\n- **Competitive Engineer?** Design your perfect rig and take it into battle.\n- **Team Dreams?** Invite your peeps over for some multi-player builds. (Don't steal their parts!)\n- **Here to Dominate?** Skip the workshop and go right to matching up for *intense 1v1 action*.\n- **Noob Cadet?** Turn on **Auto-Pilot** or hit the **Eject Button** when things get spicy.\n\n{1685605688985649}\n\n# Become a Xumia Legend!\n- **BuildPort** where you craft your ultimate fighting ship, solo or with friends.\n- **Xumi Trials** lets you test out your builds against a variety of challenges.\n- **Duel Arena** pits your fleet against friends and foes in heart-pounding combat.\n\n**Are You The Builder We've Been Waiting For? \ud83d\udca1\ud83d\udee0\ufe0f\ud83d\ude80\ud83c\udf96\ufe0f**", "short_description": "BUILD. BATTLE. ADAPT. \ud83d\udee0\ufe0f\ud83d\udca1\u2694\ufe0f\n\nImmerse yourself in the world of BuildPort Xumia where brains, ingenuity, and skills matter!\n\nForge legendary ships with epic weapons, sensors, and tech. Craft for blistering speed, ironclad durability, or bold swagger\u2014it's up to YOU.\n\nBuild solo or together with friends (don't steal their parts!) and take your custom rigs into intense, physics-based, challenges and battles.\n\nAre You The Builder We've Been Waiting For? \ud83d\udca1\ud83d\udee0\ufe0f\ud83d\ude80\ud83c\udf96\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://buildport.xumia.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Yumebau Inc.", "support_website_url": null, "website_url": "https://buildport.xumia.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "586501633529985"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1442970577152590"}, {"status": "PUBLISHED", "id": "1235606784960884"}, {"status": "PUBLISHED", "id": "2149742066426768"}, {"status": "PUBLISHED", "id": "1315721846740083"}, {"status": "PUBLISHED", "id": "1403412971830430"}, {"status": "PUBLISHED", "id": "2219844255214642"}, {"status": "PUBLISHED", "id": "1975664333375930"}, {"status": "PUBLISHED", "id": "1738261770174338"}, {"status": "PUBLISHED", "id": "3880847538879754"}, {"status": "PUBLISHED", "id": "1399556061129404"}, {"status": "PUBLISHED", "id": "1634411554632683"}, {"status": "PUBLISHED", "id": "2534291626910542"}, {"status": "PUBLISHED", "id": "606804355225474"}]}, "baseline_offer": {"id": "1634411554632683"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786726800, "status": "PUBLISHED", "id": "2149742066426768"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28714284638171318", "version": "0.10.1"}, "id": "890547815531463", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6784970791529351", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28714284638171318"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1784801708, "id": "28720289150904200", "version": "0.10.1", "version_code": 22103, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6784970791529351", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28714284638171318"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "890547815531463"}]}, "change_log": "Progression Update\n\t*Added new objective based progression system\n\t*Objectives unlock parts, modes, quests, crystals, and customization options\n\t*Objectives make use of challenges using multiple game systems and serve as pathway for what to do for all players\n\nFTE & Epilogue\n\t*Reworked with a new final chapter that introduces combat and Core Siege\n\t*Epilogue reworked completely to explain how progression works\n\nQuests\n\t*Quests have been added to give players guidance in core mechanics, game modes, and the world of Xumia\n\t*Quests can be found in the new progressions window alongside objectives\n\t*Pre-existing Tutorials from the Xumi Instructor have been turned into Quests\n\t*New Xumi Collection Quest has been added alongside daily Xumi Collection activities in the Rift\n\nDuel Auto-Match\n\t*Auto-Match has been fixed and re-enabled\n\nHit System\n\t*Added avatar hit system in the Rift to allow for players to make greater use of hand weapons against each other\n\nPaints\n\t*Added new part and gizmo paint system to allow for all parts to be customized and saved\n\nParts\n\t*Added defense gizmos as a category and added 13 new template defense gizmos\n\nGizmo Saving Restrictions\n\t*In order to accommodate the new objectives and paints, gizmo saving checks for part ownership to allow saving and if a gizmo is saved with paints that are not owned, these will be saved with their default look.\n\t*Saving gizmos with parts not owned will no longer work\n\nStore\n\t*Paints Tab added to store\n\t*2 Paints added through store\n\nGameplay Improvements\n\t*Avatar cockpit position fixed\n\t*Handheld gizmos more accurately track the player's hand movements\n\nUI/UX\n\t*Added support for painting, including a window for the current part or gizmo with a list of all Paints\n\t*Added information in the parts inventory to indicate how locked parts can be unlocked\n\t*Added an info card to parts in the inventory displaying various stats and customization options\n\t*Added a new progression window to display objectives and progression rewards\n\t*Updated writspod topBar level up functionality and display\n\t*Removed Return to BuildPort app in favor of contextual exit button to reduce clutter\n\t*Player health bar display in the Rift\n\nQoL Improvements\n\t*Player Scannables with session options (mute/kick) and sending platform friend request option\n\t*Player Nametags added game-wide\n\t*Added Hybrid Locomotion with new settings options to toggle between teleport only, continuous left or right movement\n\nOther\n\t*Technical Improvements\n\t*General improvements and bug fixes\n\nDay 1 Patch\n\t*Construction Quest Bug Fix\n\t*Xumi Collection Quest Leave Fix\n\t*Reduced xumi audio in the buildPort\n\t*Fixed caching of wristpod brick app categories outside of the buildPort\n\t*Improved Xumi Instructor Progression Window UI\n\nWeek 2 Patch\n\t*PopUp error Fix\n\t*Objective Claim Fix\n\t*Audio Corruption Fix\n\t*Fixed a rare issue where users could get stuck in a ship in the new part of the FTE\n\t*Core Siege stability fixes\n\t*New Paint Added\n\t*New Throwables added to BuildPort and Social Hub", "created_date": 1784758813, "id": "28714284638171318", "version": "0.10.1", "version_code": 22102, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6784970791529351", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28714284638171318"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1784747162, "id": "28712732728326509", "version": "0.10.1", "version_code": 22101, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6784970791529351", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28714284638171318"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1784727078, "id": "28709508811982234", "version": "0.10.1", "version_code": 22096, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6784970791529351", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "i
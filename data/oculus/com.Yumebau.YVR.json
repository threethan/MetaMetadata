.com/v/t64.5771-25/39035397_2238076269890828_1270359774179466352_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qu_kFuKIVjcQ7kNvwHchQ5U&_nc_oc=AdpVPG38bWYa6iIIzlLzmbsc8qFucUf2o2-4ahNe4hfgrPVJd2NZabR8Q2x5NnYg61E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2AeKn-YXLXS18_zOMHSBhlb_7BpPT78uY1RfJ112zRdQ&oe=69D9066F"}, {"file_name": "time trial_2560x1440.png", "id": "508869845348808", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982447_508869852015474_4622533083298435395_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dq1MntebucQ7kNvwFccpho&_nc_oc=AdrdFEyNIT_6Up9QxN87gaVtjT-6FalKE8PLdPoIWZIjCC77UOGaoCtvDYFX23XeMJY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0O-jRdC2QvTCNXf7Hya00zBemMUQmCnSjr8ggxr6AD1A&oe=69D8E324"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image (2560x1440px).png", "id": "1242321223562374", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304798_1242321226895707_7489816028602698308_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpa-0TYq5aMQ7kNvwFPTbZk&_nc_oc=AdrZngsIRDZIR37c5Bwqgt5X9S6WivqTk1c2EQ-iIRh2UWsq4K1V83-NKuKTqiqKnq8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DY3-cBGITwpRfnPqClS_ExdMpiwyxBZi48vHbKf5-Ew&oe=69D90E54"}, "display_name": "BuildPort Xumia", "keywords": ["Sandbox", "Building", "Simulation", "Piloting", "Combat"], "long_description": "# BUILD. BATTLE. ADAPT. \ud83d\udee0\ufe0f\ud83d\udca1\u2694\ufe0f\n\nImmerse yourself in the world of **BuildPort Xumia** where **brains**, **ingenuity**, and **skills** matter!\nUnleash your inner Da Vinci! Use out-of-this-world tek to build beast-mode ships. Battle your way to legendary status in Xumia!\n\n{1007685401386300}\n\n# Dominate With Ships Built By **YOU**\n- Loadout with powerful **weapons**, **sensors** and other tech to make your ships unique.\n- Build for *blistering speed*, *ironclad durability*, or *jaw-dropping swagger*\u2014its up to **YOU**\n- Balance **power** and **handling** in your builds.\n- Refine agility with precision placement of thrusters.\n- Wire sensors to weapons for automatic firing.\n\n{1199156102006224}\n\n# Xumia is for **EVERYONE**\n- **Competitive Engineer?** Design your perfect rig and take it into battle.\n- **Team Dreams?** Invite your peeps over for some multi-player builds. (Don't steal their parts!)\n- **Here to Dominate?** Skip the workshop and go right to matching up for *intense 1v1 action*.\n- **Noob Cadet?** Turn on **Auto-Pilot** or hit the **Eject Button** when things get spicy.\n\n{1685605688985649}\n\n# Become a Xumia Legend!\n- **BuildPort** where you craft your ultimate fighting ship, solo or with friends.\n- **Xumi Trials** lets you test out your builds against a variety of challenges.\n- **Duel Arena** pits your fleet against friends and foes in heart-pounding combat.\n\n**Are You The Builder We've Been Waiting For? \ud83d\udca1\ud83d\udee0\ufe0f\ud83d\ude80\ud83c\udf96\ufe0f**", "short_description": "BUILD. BATTLE. ADAPT. \ud83d\udee0\ufe0f\ud83d\udca1\u2694\ufe0f\n\nImmerse yourself in the world of BuildPort Xumia where brains, ingenuity, and skills matter!\n\nForge legendary ships with epic weapons, sensors, and tech. Craft for blistering speed, ironclad durability, or bold swagger\u2014it's up to YOU.\n\nBuild solo or together with friends (don't steal their parts!) and take your custom rigs into intense, physics-based, challenges and battles.\n\nAre You The Builder We've Been Waiting For? \ud83d\udca1\ud83d\udee0\ufe0f\ud83d\ude80\ud83c\udf96\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://buildport.xumia.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Yumebau Inc.", "support_website_url": null, "website_url": "https://buildport.xumia.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "586501633529985"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1975664333375930"}, {"status": "PUBLISHED", "id": "1738261770174338"}, {"status": "PUBLISHED", "id": "3880847538879754"}, {"status": "PUBLISHED", "id": "1399556061129404"}, {"status": "PUBLISHED", "id": "1634411554632683"}, {"status": "PUBLISHED", "id": "2534291626910542"}, {"status": "PUBLISHED", "id": "606804355225474"}, {"status": "PUBLISHED", "id": "1442970577152590"}, {"status": "PUBLISHED", "id": "1235606784960884"}]}, "baseline_offer": {"id": "1634411554632683"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "1975664333375930"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27385636267702835", "version": "0.9.0"}, "id": "890547815531463", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6784970791529351", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27385636267702835"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1775414876, "id": "27418450937754701", "version": "0.9.0", "version_code": 21649, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6784970791529351", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27385636267702835"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "890547815531463"}]}, "change_log": "Core Siege CoOp\n\t*Introduced Core Siege CoOp, a variant of the single player version released in 0.7.0.\n\t*Supports Drop In/Out\n\t*Supports Hand Weapons\n\nDuels\n\t*Separated single player and play (hosted matches) from auto-match and renamed them to Duel Practice and Duel Arena\n\t*Brand new map added for Duel Arena, the Lava Pit\n\nXumi Trials\n\t*Renamed to The Rift\n\t*Layout rework and visual changes\n\t*Supports Hand Weapons\n\nSocial BuildPort\n\t*Brand new activity scannable\n\t*Brand new visuals and bigger play space in comparison with the BuildPort\n\nBuildPort\n\t*Activity scannable updates\n\t*Activities display live player counts\n\nNew Gizmo Type\n\t*Hand Weapons are a brand new gizmo type that allow players to build and play only with their hands and arms!\n\nParts\n\t*Weapon Grip, a part that allows players to use gizmos with their hands, adding brand new gameplay opportunities game-wide!\n\t*Gunner-Pod, a part that allows 2+ people to be in the same ship!\n\nGizmo Templates\n\t*Added 8 new gizmo templates for the new gizmo type hand weapons!\n\t*Added 4 new gizmo templates with gunner-pods.\n\nUI Overhaul\n\t*Full UI rework of inventory with detail pages, more items per page, scrollable tabs and much more\n\t*General improvements and bug fixes.\n\nLeaderboards\n\t*Added leaderboards for Duel Arena (Ranked)\n\t*Added leaderboards for Core Siege CoOp\n\nTutorials\n\t*New Gizmo Types Tutorial \n\t*New X-Ray Tutorial \n\t*Tutorial bug fixes and improvements.\n\nDiscoverability / Session App Rework\n\t*Updated session app to have easy join-in on public sessions.\n\t*Sessions can be joined without the need to return to buildPort.\n\t*Activity scannables have a \u201cBrowse\u201d option to see available sessions or create/manage your own (same functionality as the session app).\n\t*Sessions can be set as private or public\n\t*Sessions support custom names\n\nQuality of Life\n\t*Cockpit overlay to display new information and mitigate motion sickness (can be turned on/off).\n\t*Matchmaking and session hosting improvements.\n\t*General Performance and Rendering improvements.\n\t*Bug fixes.", "created_date": 1775169582, "id": "27385636267702835", "version": "0.9.0", "version_code": 21647, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6784970791529351", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27385636267702835"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1775161414, "id": "27384590094474119", "version": "0.9.0", "version_code": 21645, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6784970791529351", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27385636267702835"}, "release_status": "RELEASED"}, "binary_r
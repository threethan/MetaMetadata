dn.com/v/t64.5771-25/39035397_2238076269890828_1270359774179466352_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2hr7Q-Ge6EQ7kNvwHEjw7y&_nc_oc=AdphuRrqNj7nLkbrP0zZvzuUbqXWEcauoRXYg_8VEFxzopK7GtUc-hxmSglaKey3_oI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQQyIkDJeKBh7d7JysQ0N1vSY1rgMopIqMsGO-Tx5JZQ&oe=6A9AD2EF"}, {"file_name": "time trial_2560x1440.png", "id": "508869845348808", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982447_508869852015474_4622533083298435395_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dCbdGkfnBgQ7kNvwEIMUxG&_nc_oc=AdqvUD5Mvpa2gULxy4x_AEgIfigAUCy1riGRAZmk3oZVANtvn_gFtwNf6mzjN3Ssccc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjIJSfAou0c8_jdzCxcKn2OtWllpRP98prSPkyqNoyiQ&oe=6A9AE7E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image (2560x1440px).png", "id": "1242321223562374", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499304798_1242321226895707_7489816028602698308_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3RyMAcjNtUQ7kNvwHTY3wP&_nc_oc=Adqweyo5f_PCpsk5xZBh8KfXW33RJaOjJ_-SfwvbyoF4VvHqoXJ5iOmyRfcm7G0rNEw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaH1gE-d-fEoko6Tqe2lbNoMT3mFloyymZWT9wNGbzhg&oe=6A9ADAD4"}, "display_name": "BuildPort Xumia", "keywords": ["Sandbox", "Building", "Simulation", "Piloting", "Combat"], "long_description": "# BUILD. BATTLE. ADAPT. \ud83d\udee0\ufe0f\ud83d\udca1\u2694\ufe0f\n\nImmerse yourself in the world of **BuildPort Xumia** where **brains**, **ingenuity**, and **skills** matter!\nUnleash your inner Da Vinci! Use out-of-this-world tek to build beast-mode ships. Battle your way to legendary status in Xumia!\n\n{1007685401386300}\n\n# Dominate With Ships Built By **YOU**\n- Loadout with powerful **weapons**, **sensors** and other tech to make your ships unique.\n- Build for *blistering speed*, *ironclad durability*, or *jaw-dropping swagger*\u2014its up to **YOU**\n- Balance **power** and **handling** in your builds.\n- Refine agility with precision placement of thrusters.\n- Wire sensors to weapons for automatic firing.\n\n{1199156102006224}\n\n# Xumia is for **EVERYONE**\n- **Competitive Engineer?** Design your perfect rig and take it into battle.\n- **Team Dreams?** Invite your peeps over for some multi-player builds. (Don't steal their parts!)\n- **Here to Dominate?** Skip the workshop and go right to matching up for *intense 1v1 action*.\n- **Noob Cadet?** Turn on **Auto-Pilot** or hit the **Eject Button** when things get spicy.\n\n{1685605688985649}\n\n# Become a Xumia Legend!\n- **BuildPort** where you craft your ultimate fighting ship, solo or with friends.\n- **Xumi Trials** lets you test out your builds against a variety of challenges.\n- **Duel Arena** pits your fleet against friends and foes in heart-pounding combat.\n\n**Are You The Builder We've Been Waiting For? \ud83d\udca1\ud83d\udee0\ufe0f\ud83d\ude80\ud83c\udf96\ufe0f**", "short_description": "BUILD. BATTLE. ADAPT. \ud83d\udee0\ufe0f\ud83d\udca1\u2694\ufe0f\n\nImmerse yourself in the world of BuildPort Xumia where brains, ingenuity, and skills matter!\n\nForge legendary ships with epic weapons, sensors, and tech. Craft for blistering speed, ironclad durability, or bold swagger\u2014it's up to YOU.\n\nBuild solo or together with friends (don't steal their parts!) and take your custom rigs into intense, physics-based, challenges and battles.\n\nAre You The Builder We've Been Waiting For? \ud83d\udca1\ud83d\udee0\ufe0f\ud83d\ude80\ud83c\udf96\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://buildport.xumia.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Yumebau Inc.", "support_website_url": null, "website_url": "https://buildport.xumia.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "conte
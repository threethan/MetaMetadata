n.com/v/t64.5771-25/39035397_2238076269890828_1270359774179466352_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuSw4NllBMcQ7kNvwGeUgqc&_nc_oc=AdrVkRbFf2gucdbnG9g_7zQjm7n3l_e31wX-XMEtpYpEhG0tjpVzbmv_7WT-Am0AEGo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3B3kOjSh9KQXmE85D-Hw7TtPi3PehE57RRW4tQMWKF0g&oe=69ECCCEF"}, {"file_name": "time trial_2560x1440.png", "id": "508869845348808", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982447_508869852015474_4622533083298435395_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1-6dFqVnssQ7kNvwHcU-MJ&_nc_oc=AdrjLCV0zfXUC1b2cJKpOSPxlhw0rbH7znktAJvxCSLFi8fjnP3BAfexzgGJGecHCyQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CwLeIcafFLMvgxC006WsvYedJbSbvlDce0Rc4l8AkAQ&oe=69ECA9A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image (2560x1440px).png", "id": "1242321223562374", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304798_1242321226895707_7489816028602698308_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4VvheS-RacQ7kNvwHs74jb&_nc_oc=AdqXPn8Fk0z6VNTOyvboeVPKlu0WmFrhccFBeqA0dWf9IpzhksbfbXl5RBat6ETG2u0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HzJRTLs5_fbnyKIDZyjG8rmVxIX8Rh7poAdzLds9HlQ&oe=69ECD4D4"}, "display_name": "BuildPort Xumia", "keywords": ["Sandbox", "Building", "Simulation", "Piloting", "Combat"], "long_description": "# BUILD. BATTLE. ADAPT. \ud83d\udee0\ufe0f\ud83d\udca1\u2694\ufe0f\n\nImmerse yourself in the world of **BuildPort Xumia** where **brains**, **ingenuity**, and **skills** matter!\nUnleash your inner Da Vinci! Use out-of-this-world tek to build beast-mode ships. Battle your way to legendary status in Xumia!\n\n{1007685401386300}\n\n# Dominate With Ships Built By **YOU**\n- Loadout with powerful **weapons**, **sensors** and other tech to make your ships unique.\n- Build for *blistering speed*, *ironclad durability*, or *jaw-dropping swagger*\u2014its up to **YOU**\n- Balance **power** and **handling** in your builds.\n- Refine agility with precision placement of thrusters.\n- Wire sensors to weapons for automatic firing.\n\n{1199156102006224}\n\n# Xumia is for **EVERYONE**\n- **Competitive Engineer?** Design your perfect rig and take it into battle.\n- **Team Dreams?** Invite your peeps over for some multi-player builds. (Don't steal their parts!)\n- **Here to Dominate?** Skip the workshop and go right to matching up for *intense 1v1 action*.\n- **Noob Cadet?** Turn on **Auto-Pilot** or hit the **Eject Button** when things get spicy.\n\n{1685605688985649}\n\n# Become a Xumia Legend!\n- **BuildPort** where you craft your ultimate fighting ship, solo or with friends.\n- **Xumi Trials** lets you test out your builds against a variety of challenges.\n- **Duel Arena** pits your fleet against friends and foes in heart-pounding combat.\n\n**Are You The Builder We've Been Waiting For? \ud83d\udca1\ud83d\udee0\ufe0f\ud83d\ude80\ud83c\udf96\ufe0f**", "short_description": "BUILD. BATTLE. ADAPT. \ud83d\udee0\ufe0f\ud83d\udca1\u2694\ufe0f\n\nImmerse yourself in the world of BuildPort Xumia where brains, ingenuity, and skills matter!\n\nForge legendary ships with epic weapons, sensors, and tech. Craft for blistering speed, ironclad durability, or bold swagger\u2014it's up to YOU.\n\nBuild solo or together with friends (don't steal their parts!) and take your custom rigs into intense, physics-based, challenges and battles.\n\nAre You The Builder We've Been Waiting For? \ud83d\udca1\ud83d\udee0\ufe0f\ud83d\ude80\ud83c\udf96\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://buildport.xumia.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Yumebau Inc.", "support_website_url": null, "website_url": "https://buildport.xumia.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "contex
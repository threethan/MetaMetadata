GIiLrKiSRkVq4jHMlC4yZDFH_m3tQd2TWh2jKw&oe=6AF8A5EB"}, {"file_name": "Screenshot_06-03-2026_10-53-58.png", "id": "1279488457413116", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617813_1279488460746449_5562725540444410362_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u403fhOT5S8Q7kNvwFRuGM4&_nc_oc=Ado1gHvaNbpX9JwfPBNOU2Fjchui8OOkDQQAloPE0DwjO0zitd4kttFbXvFIkCG_bkA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVQBNdpM335OkCRD5j4zAMzZoxc_2zLiZdFAw0rizGbA&oe=6AF8A50C"}, {"file_name": "Screenshot_06-03-2026_11-24-19.png", "id": "941185491594483", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818860_941185494927816_7196784366138411650_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1wfYQSd6WsQ7kNvwGUVaPk&_nc_oc=AdqxEVj8DhKd5-ih0XY1B95J1OYHYKNzRgzZBG5RvGJtyr2Zlf8BR1k1Q3Y-qu__L5c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVZ4XzZX6y2oidXoM1o7cvyPSTvYINbkky-MRq7NgdxQ&oe=6AF89882"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monster Truck Arena VR Racing Game", "keywords": ["MonsterTruckVR", "VRRacingGame", "StuntDrivingVR", "OffRoadTrucksVR", "CrashArenaVR"], "long_description": "Get ready for an adrenaline-pumping monster truck experience in virtual reality! Step into the driver\u2019s seat and take control of powerful monster trucks as you race through massive arenas filled with ramps, obstacles, and thrilling challenges.\nIn Monster Truck Arena VR Racing Game, you will drive gigantic trucks built for speed, power, and destruction. Compete in exciting arena tracks, perform insane stunts, crush obstacles, and push your driving skills to the limit in immersive VR.\nFeel the excitement as you accelerate across challenging tracks, jump over huge ramps, and land incredible stunts that only monster trucks can perform. Every race is a test of skill, timing, and control.\nFeatures\n\ud83d\ude9a Powerful Monster Trucks \u2013 Drive massive trucks designed for extreme racing.\n \ud83c\udfc1 Exciting Arena Tracks \u2013 Race in large arenas full of ramps and obstacles.\n \ud83d\udd25 Epic Stunts \u2013 Perform jumps, flips, and crazy stunt moves.\n \ud83c\udfae Immersive VR Experience \u2013 Feel like you're really inside the monster truck.\n \u26a1 Challenging Gameplay \u2013 Improve your driving skills and beat tougher levels.\nWhether you love racing games, stunt driving, or monster trucks, this VR experience delivers thrilling action and high-energy gameplay.\nStart your engines and dominate the arena in Monster Truck Arena VR Racing Game!\n\n\n\n\n\n", "short_description": "Drive powerful monster trucks in a VR arena! Race, perform crazy stunts, and conquer challenging tracks in this action-packed racing game.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/diamondgamesstudio/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "DiamondGamesStudio", "support_website_url": null, "website_url": "https://sites.google.com/view/diamondgamesstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25974066778870353"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2633569003710721"}, {"status": "PUBLISHED", "id": "1979591322660982"}]}, "baseline_offer": {"id": "1979591322660982"}, 
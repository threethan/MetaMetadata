gg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlhRPPMMNrjJO3uFddOGtOO0M1dEcrTbD2LYfege3CUg&oe=6AF87522"}, {"file_name": "Screenshot_1.png", "id": "1247968424189827", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827646_1247968430856493_6744603084997712701_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94sD0IvDoNMQ7kNvwEnGaQ6&_nc_oc=AdrVjNO9q973xc0wyieQ9ij_pKuCClmsMJKtpgvFDljHKfYFpmVd344UR3ObkGNM60w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKK7lwPna7gV9tKr1XIiPkDrW6A7XldFsE-1W6T4pf7g&oe=6AF87D37"}, {"file_name": "Screenshot_5.png", "id": "1455169366192127", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825415_1455169369525460_2296362148406853750_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0NJItjcQGcQ7kNvwEco_qM&_nc_oc=Ado_lUULWwVxPQm83mOQ3pmqPoHWBe8a200dp5raLxD26v1f_5FtoaavHqfvD9gaFVw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0l0x4AxsbrtHcBE7hNWkKbpx1g5kWdRv-f748b-BZ7Q&oe=6AF8864B"}, {"file_name": "Screenshot_3.png", "id": "948995844133736", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821704_948995847467069_3168262428154610300_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWh2PRdX_IQQ7kNvwGjiofV&_nc_oc=Adrs0JzoHHvZL1ypUyqTNkdO6h2BM9ppK0TjLoGiNi9SMlSUq0vueXmfVKmVVJ8gQ8w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkDyY_0MJcr2cpFzLwyGpXSCBe5mTIe5iHoHXlvpJqYg&oe=6AF87B4A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monster Truck Arena VR Racing Game", "keywords": ["MonsterTruckVR", "VRRacingGame", "StuntDrivingVR", "OffRoadTrucksVR", "CrashArenaVR"], "long_description": "Get ready for an adrenaline-pumping monster truck experience in virtual reality! Step into the driver\u2019s seat and take control of powerful monster trucks as you race through massive arenas filled with ramps, obstacles, and thrilling challenges.\nIn Monster Truck Arena VR Racing Game, you will drive gigantic trucks built for speed, power, and destruction. Compete in exciting arena tracks, perform insane stunts, crush obstacles, and push your driving skills to the limit in immersive VR.\nFeel the excitement as you accelerate across challenging tracks, jump over huge ramps, and land incredible stunts that only monster trucks can perform. Every race is a test of skill, timing, and control.\nFeatures\n\ud83d\ude9a Powerful Monster Trucks \u2013 Drive massive trucks designed for extreme racing.\n \ud83c\udfc1 Exciting Arena Tracks \u2013 Race in large arenas full of ramps and obstacles.\n \ud83d\udd25 Epic Stunts \u2013 Perform jumps, flips, and crazy stunt moves.\n \ud83c\udfae Immersive VR Experience \u2013 Feel like you're really inside the monster truck.\n \u26a1 Challenging Gameplay \u2013 Improve your driving skills and beat tougher levels.\nWhether you love racing games, stunt driving, or monster trucks, this VR experience delivers thrilling action and high-energy gameplay.\nStart your engines and dominate the arena in Monster Truck Arena VR Racing Game!\n\n\n\n\n\n", "short_description": "Drive powerful monster trucks in a VR arena! Race, perform crazy stunts, and conquer challenging tracks in this action-packed racing game.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/diamondgamesstudio/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "DiamondGamesStudio", "support_website_url": null, "website_url": "https://sites.google.com/view/diamondgamesstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nu
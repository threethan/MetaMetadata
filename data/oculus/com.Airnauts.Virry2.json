ord5-3.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CpHsecoSZLgQ7kNvwEXRQBl&_nc_oc=Adnb0xqoQAYcy0QeGe8H7eFj355kp_xx9e-_13WKJuvVeel6dpiWqFOIwqzhk2RgqXg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftSSbuX75dsAYTEJE9VVn4nu70fpsubXikIDZtwdZ7sEA&oe=699C38DE"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fAy2Q8m-pu0Q7kNvwE7RbGk&_nc_oc=AdnYRXKCY5uTPfVkQ-KIu4Zi2CtqhefAcFtDdtkH8ZhtD_cYowWDO6bdorQNVgWTuho&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuENOqFGGc1ISBPPU8dT5LYEu9ANQXHi3ouXRRoCOgumg&oe=699C43F1"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DKgwGz3XdQsQ7kNvwGN1Kjt&_nc_oc=AdnJoo2xoL3vpRPupnAXv6K4MndvwCu43fzThsUg1Nxm9a_lnGpa2zoi3sLSxXA6Jos&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuAR3aYXPhiRPs2sJ-Cussc0To1iXAPFX4CFsBteBHNzg&oe=699C63A0"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeqWyqucweoQ7kNvwGMVaOz&_nc_oc=AdnH5AeQx-tjxJWAfoBJZQcjSwKt1ZlMqm0Loi6qcsU0hQUdSSGeula3twnRYxanfM8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvKckFaXo7F7d04RQvoDhxf4NMYq6wmD93pgG9WLzYWvg&oe=699C5DB7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recom
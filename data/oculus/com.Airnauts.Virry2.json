Q&oe=6AF34DA0"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gHRd074V1UQ7kNvwENctI-&_nc_oc=Adq4QS38331kz8F4uSrig0NubGAJOdIhIdpntyXc_lBCQy2vcKiu8N1s-T7jE39rrtI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdDhvUZFsm0_BF-3vp1XyEwzo65xMC9UuzyD3Jyna_jg&oe=6AF3371E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQ9hEYnh5aEQ7kNvwERfOhB&_nc_oc=Adp35Yz5fHeXI_1r8hzEtXjZtYY5V0Gkh-sWS_ijbok_tnxno_jaaksh4d5-OZVy5Zc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzILdok0pv8y43E0Xq_-JqmIihcZs7p485QAjDA8mK0A&oe=6AF34231"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSJP3p8wgfEQ7kNvwFNBdQ3&_nc_oc=Adqg9OqwilJc-tDZ0Dl6ActWRTx3y6PmrU9naZriRikGOqv3PvmJNzkYJO45nm-rhzM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYtfskEmd3gcn342PJkEMRQUEg4eTdteo3vdhycmpXKQ&oe=6AF329A0"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=696DPXfJ504Q7kNvwH2umSL&_nc_oc=Adq0KziXFUQRUX76jZQHwWvlvGjTkT2ngTXF6wqBv1z4mb-Dhpvcju7jhza4FUS6Vng&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTd3iTLAprj-5OFH8JRoTKrQHEYmYthNZ7Myu-morTv3Q&oe=6AF323B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
g?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyqXcqoyvqMQ7kNvwEBAiyy&_nc_oc=Adpo5SS2HusdQOCZdyzwDc_A2poXBxrGPjOZK5rCx8IghWKJU-gZHk14OrGADMWI9m4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1YH64Q0j7m6P57QLJiw47j1cf6bPUzcRoq74edvqSEQ&oe=6A5CBEF1"}, {"file_name": "migrated_image.png", "id": "231528434908924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rua1YJ48hqUQ7kNvwH5EeTP&_nc_oc=AdqN6RiVzLgB04Ve9qvl-e_uHSlLTz-u4hOiy4mKZT5HhX3LEHcKn9v4ylS_sDohmgY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBO4eYqFssj3l8BYR7t7uSJTCLw7ieRVGxDp18pYdbTZw&oe=6A5CDEA0"}, {"file_name": "migrated_image.png", "id": "212399816653872", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162682_1756596874645581_2822882841732317184_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dwdshsg4j1wQ7kNvwGNsuA7&_nc_oc=AdqxbOTlZjDEa85L9EyXCYRhgnyZVXz4bQn_ZtntETHUFwe_EOivkJX6pwMZ1LX59JU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCe37F1BiUJ3WBxn2RAFjc-lRXnoMyQaSg5V0VqgkR9tw&oe=6A5CCA60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11162731_874801452683124_8480571075237773312_n.png", "id": "1673110742720080", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162694_1673110746053413_890324910616870912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOpgpT-js-YQ7kNvwErIb-6&_nc_oc=AdoMILr1704EPl8Y3Lp6BpV57TI2bKHq-lUfGXl9cMJ0L5h7YavrwxCMFDDZVs3L3Kc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhnu0BuT-Y1XKlbyABpPRJjUrQprRiVW-D4KJBFLqb_Q&oe=6A5CD08D"}, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fnt-resources.s3.amazonaws.com/docs/en/PrivacyPolicy.pdf", "developer_terms_of_service_url": "https://fnt-resources.s3.amazonaws.com/docs/en/ToS.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recomm
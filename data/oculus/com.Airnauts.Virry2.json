Q&oe=69D3AE60"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=riASFOsZ8swQ7kNvwFu4vDl&_nc_oc=AdquASv8v_8Wbh6u5MEKZdnjK6RGI0GiHnKNlFsYZZJfOAYDLnE4KAAfPVenr3pzKHI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20T1HuKrfQAZ--0KNDTceLUgYi5srTq5_lfnI02NCl1A&oe=69D397DE"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6bRx1OzzK8Q7kNvwFCBqjF&_nc_oc=Adotg712GIsU-0RGhojhgN4MpS4gvVehQR9WHRvYl1hy5AiD9rF9BBf1BM6Gx3b4rnE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04ZGhlnsJ6sINMbO4LnRAoH_XWgtoBuvIxSKvQHN-itw&oe=69D3A2F1"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvUz9qULTTAQ7kNvwHxJAAj&_nc_oc=AdpmJRgNBa4iNzmJyTyXK8v-b7nGSXz3CLWcQa7f_vXGjtBFqrq94holrOj52ZTVmZk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GUMWKXXFO-SWa3WO-A4-UKPRsYBQrCJ0HQIlVy8FOjQ&oe=69D3C2A0"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZuTRVa04_sQ7kNvwFFK9R-&_nc_oc=Adq9mNdY7hWHFKkhnSLrQoJejQRwveiFvI7uBzMESQ9QCm12HNYRpplhhDYvQ-io3g4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ki5CuMEF5DC54tDwrSIniJe-RhPlyS0Ir57RpJtMaFg&oe=69D3BCB7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
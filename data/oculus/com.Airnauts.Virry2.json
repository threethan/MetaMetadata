g?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HULagUZvzOoQ7kNvwHGhkNB&_nc_oc=Adq7LrzZ-0yqVNjqtUF-YmXZ98HIwnnLxC9eNvG3z_Zrks-JHO0pZuVzsHKTsqu0Db8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQb5lajcqFsYopvRP7zSRl9iWwHw4-K0XNeWPpuzytjdQ&oe=6AEF4DB1"}, {"file_name": "migrated_image.png", "id": "231528434908924", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irfVvdzZWHgQ7kNvwH2IV4H&_nc_oc=AdqpxNRfhGRT7pGN5_qLU5OX8pOLbO9r7SpCAqRnifZJwiBYnGE1fGEHb_cCFGxX94w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrYg7BDUD3KyRVwVOUNS9hw1w3KwPXjbnx_RRjtTyTog&oe=6AEF3520"}, {"file_name": "migrated_image.png", "id": "212399816653872", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162682_1756596874645581_2822882841732317184_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_khcpDm2aXsQ7kNvwEPc4C5&_nc_oc=Adoq0aofllxYIUqFZ-o0iNp1WTiTSVJ39QaAnCO5jtY--elkRw08PaOI0olWYLuwWX0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQD1kLbhgdRPouf6QYX9RTQEposeOT9tYMmwpP2346cBQ&oe=6AEF5920"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11162731_874801452683124_8480571075237773312_n.png", "id": "1673110742720080", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162694_1673110746053413_890324910616870912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYIi5UjhIxQQ7kNvwHWwKoM&_nc_oc=Adr86BS99Yte20OTFivu3TqQug2MEEWx_k43kM1lN7nk2G__GntuHIkiJATexmN0JDQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3Nfx3FzKr9DL9YMB4gq0D9ys52sX14AXrTaAlpyqMYQ&oe=6AEF5F4D"}, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fnt-resources.s3.amazonaws.com/docs/en/PrivacyPolicy.pdf", "developer_terms_of_service_url": "https://fnt-resources.s3.amazonaws.com/docs/en/ToS.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recomm
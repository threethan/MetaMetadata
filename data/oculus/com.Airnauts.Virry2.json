g?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfkJNpovdXgQ7kNvwHtSjhf&_nc_oc=AdokG1NO8qwkSJg5kXDP8pts-WkY_fc3hQf7HnUvxMkGHG9IguwVUOKzFW-inWkVnD4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CLiSyjV8xrK_3jAmOgOaYGjhupbia12wD3kDPB1UPCw&oe=6A09B071"}, {"file_name": "migrated_image.png", "id": "231528434908924", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ou4rIUByuoAQ7kNvwEuCtfU&_nc_oc=AdoHAuyHV_JXKQbcW_nFmuAZQQjpqWTZUL1eQnFP1U_QWCZxhTnuFBc_y18sE5yeqs8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MqaUorevbA0P2bAR3Ix0sFE4ApbhK7ettQ48QjwO8HQ&oe=6A09D020"}, {"file_name": "migrated_image.png", "id": "212399816653872", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/11162682_1756596874645581_2822882841732317184_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HHuTsbbS3sQ7kNvwF7P7gp&_nc_oc=Adq4s5ivQennGEubADRdmP77yPLq5U1W5LF61i6rkqk4uautvduU8YQ_wYffHZvfOgk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bKaboAM0hDy5eR8WaQJ3m0NV2RyV7o0wTWnl5-iVSfg&oe=6A09BBE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11162731_874801452683124_8480571075237773312_n.png", "id": "1673110742720080", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/11162694_1673110746053413_890324910616870912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umo0pe0RD5sQ7kNvwH2tnjw&_nc_oc=AdopJD2yPG98nmVAGxsL4dMd7EQtuAzY__Tm9FvmivIU4yHvT3nIgI4yQYHLz01c24o&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55j3uswHxP7HAjmtEPMHNzTxr5OMPdt24ocnKSjW1u_A&oe=6A09C20D"}, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fnt-resources.s3.amazonaws.com/docs/en/PrivacyPolicy.pdf", "developer_terms_of_service_url": "https://fnt-resources.s3.amazonaws.com/docs/en/ToS.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recomm
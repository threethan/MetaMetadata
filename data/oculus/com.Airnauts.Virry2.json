g&oe=6AC8E560"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjldr7GJINwQ7kNvwEyCzkc&_nc_oc=AdqAOAv2E20pv4uUXWdvCFormirNQOPvcNyxgS1vljM3-7jMm9erNPNO-sjSByh-qVs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJ23zu-4sLKXgpWRU_4NBQyFBGg14YXC4xukUTyQuvlg&oe=6AC9071E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SAlpHDFkCO4Q7kNvwG4Wv-v&_nc_oc=Adq8VV539yVhWYbKdFW95JJlHY5VKgPWDKl45Neppe-2v-IqO4wZIHsEh2dBm4SGHhE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAzAEjufC7PwTTQEIoha2DeneaxK9G8m00NX47tsYzKA&oe=6AC91231"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m61VfaHVRTIQ7kNvwETScGm&_nc_oc=Adp7bK-gvHRN3UUGlYZgxA1k3hgTMgomnmHJtSEPeIMz0tiVf_cxUoqP8t7rBGrjfBk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8kYD_NDtW1JHjBFnNZKhKn6AmO4hgBwyMxQqc2677cw&oe=6AC8F9A0"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vP-owPfTQoUQ7kNvwEHBoGJ&_nc_oc=AdpRxZyfB_OlTvIWEvCluAAliJMcEvC_bB0Nr2PpEzYIosSKJ4RQk941g8WInogD2CA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNE2q2oR2EkqP7nQBPyokafQFudjVm9nwzjGfiOmtV4iA&oe=6AC8F3B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
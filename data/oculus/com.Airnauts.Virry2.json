g&oe=69C3DC60"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_ANJ1sIRuAQ7kNvwFECHcf&_nc_oc=Adpk-g-rJLNiOS41ck4urs2j8rZIXkVIe2EqxJIp5LyRcGwraUK0RAJmc-E9i2XZShU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVeSpTLqtDr-bPc0kSQSLgVMhzd-2Hh_JECuB5GjHAkQ&oe=69C3C5DE"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EAug4Hzgl_0Q7kNvwFbEkiX&_nc_oc=AdrGebnEkt2l9tY23ujbsTtz2jg8lqOIhyV3wLmhTbg2jJlZkjCVgSno2YxP0dGKAWs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5C8bf14DmvO5cbs4D2Wu3x9KP_SJHLYfHcQeZJReqDQ&oe=69C3D0F1"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNFPJTfSQrAQ7kNvwG5RBLu&_nc_oc=Adr34KgIJOEdPZI5f4vGLdYqAmG__6MiqNFVfNhn7bqU2hBbR_kvaHVIjeAG8REu0S0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx4ieGx4s6LpBefZ4dFa3Tg9mpAPCzuroqCKsqq-1t_hw&oe=69C3F0A0"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0O_HGSPp_MsQ7kNvwGmSsyc&_nc_oc=AdroNciqLOBvnKY2gJQd50QlNxh-83A7CZkYcV8Nl7A8c81Toog_koWNO04n32W2b40&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzh2hFwyErJgJpw6xho7yuGBkO3EKT9O5nUg38UdDmMpA&oe=69C3EAB7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
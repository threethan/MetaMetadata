Q&oe=69C7D0E0"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXNbJmccwLYQ7kNvwGuBJIe&_nc_oc=AdqCTvC8kbcuzoA86D3BUu3MsHUP91SRk3bkBAeRW1FKIbbn32adXtzdaTA83LGMZME&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy7A_SETdf-7FjunVpYEIQHddZS1Q776Idw0u44RYTOkQ&oe=69C7BA5E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOR8D5rogNEQ7kNvwFTLrEb&_nc_oc=AdobBElY_EDUB341reujyiIbpcHVX0HSHTSKyPT52WmrKzBGCJqCn_0pMS1WGA6cuFM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwNKI4mVDdbVNLRbQqwipJ26Mgquj7n0KnHwB1wR9lD0g&oe=69C7C571"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pgf6Ni40l_YQ7kNvwHC3jdW&_nc_oc=AdoOazA_jX4g95KOjKLD0_Hh0VG7uGYUB2AyNiWQ0nvyt4JLVbiGDuHO6lgCSZUwTuk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_gKaiRj7AZaIk0vG3yPZvQZ4aG947KRREE5-u1N1DbQ&oe=69C7E520"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3W3EFPl_coQ7kNvwHhCPFw&_nc_oc=AdpQ03IFe1L6Vg7HH9fq_HHVZROmn5_3eHodNXbev138N-9ZY94ikrYh40dpEY-gRhw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzo4MdR5bA0kGoE639PK14XOR7XGsGTOgI1vR732haUtQ&oe=69C7DF37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
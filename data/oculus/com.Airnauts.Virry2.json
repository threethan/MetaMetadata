g?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsy48p8ZeiYQ7kNvwEo1FMN&_nc_oc=AdpQqRsuMlSeadoaBvA8DkwRzu-H8s0E9TvwVZ0Gnz5ILVo8L9s9vWK1LnleQOy5CFQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96q1OYO3F-npitjlUcm55nHhoCiOLvunJ434NJZHy9JA&oe=6A3EA4B1"}, {"file_name": "migrated_image.png", "id": "231528434908924", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xH_ut2q377YQ7kNvwErSfuI&_nc_oc=AdrPz4kraZgGC6batKmb7y9ih_qcXpr4JOliBX27-_04xgn5fFjgsAcd5nkdYyUrejU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qg71zw_E8Cuvi8NFnvbmANiZ6shBPkC_5fsJAiWf-MA&oe=6A3E8C20"}, {"file_name": "migrated_image.png", "id": "212399816653872", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162682_1756596874645581_2822882841732317184_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njbwFYKmr3sQ7kNvwH3iPos&_nc_oc=AdrEUj5YDMt9NdJvutC4x6MgUmj8YDUUUgjeYFz26kge3qpy0kY46RzmU9cvvGI89UI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QolGGOYbte3tRs5MPQr-H7yZ2RjElJ5Yvv3g9hD5v-Q&oe=6A3E77E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11162731_874801452683124_8480571075237773312_n.png", "id": "1673110742720080", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162694_1673110746053413_890324910616870912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-ctW0KJRO0Q7kNvwFJRPcl&_nc_oc=Adp4D_Q3DsDPvZdp43OgB1JQPwUQkZvXEytRrd-l_1uzBZQwHV0WkTt-YNi_DmBdgGs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FKB2ME0XBaffSYcx0I5LC1R2Vyk0ltX2JhsEvq0pZgw&oe=6A3E7E0D"}, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fnt-resources.s3.amazonaws.com/docs/en/PrivacyPolicy.pdf", "developer_terms_of_service_url": "https://fnt-resources.s3.amazonaws.com/docs/en/ToS.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recomm
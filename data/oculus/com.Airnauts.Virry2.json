g&oe=6AF893A0"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdfvsN2JxG8Q7kNvwHO8Ujx&_nc_oc=AdqFDTiEtWMUT4n_44ph0iTP5gNROcNqftabC2NBsG63dxBpPLC1zj_8ast1AsSwtmw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQO6DCbTErZUSfzS68Do1bIfWuPNBVSlCXAeUeqFwY17w&oe=6AF87D1E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3wjhsxibSQQ7kNvwH0pCua&_nc_oc=AdrweQg66ZxCJN67xr8fynwB-FQP-9qPmZ8m9g59PRsNdzfROiMvSxAoABWpwKA_nYs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsmCtC1iJE5qwoTcOap3efyZSNO_pYFWjmE8N5kuiyTA&oe=6AF88831"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5HKyAvsF3IQ7kNvwGuOyG5&_nc_oc=AdopzOhhZWDdsXkUosJsAtb-_eT8_il1gCfJJf_0HNjGcrcZgYhUCu9nqbvR_7WA5XY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvXPmQyt8OIkrpYSAEAdEAApJt7KtcNlvD2NQ4OGmQ7Q&oe=6AF8A7E0"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnImfB48KW8Q7kNvwE9frMG&_nc_oc=AdrGxm_qG6Br1xnn6OGsOrFhUbpUdQ_qDn7RzaoVEfFcAUmJySAg5EIHfOeKXfayI58&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQSmPECKURUT8Vy8204KzuCZhdD8wqBr6QcfgHSZFO3Q&oe=6AF8A1F7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
w&oe=6A81B460"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NoxaiU7lukQ7kNvwEiQGKM&_nc_oc=AdrqR7NzYF4M2OEsRR8cMrqJwmGwNMUFa16GalCCldL8QsONrm2ov0i3zvON5ThDpWI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCClGNzOO2rKIHpQQAeCTeUzLt-cFg-IUN4NqERQnQZw&oe=6A819DDE"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CReKFydiTiwQ7kNvwGcTtfd&_nc_oc=Adqbwf0C9piXxrhCW0ujZlwi9Bxj6ExCx2DH0V0U0MdeiXDAxA4hHNEBm8ST0ClUcHc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAQBjyH1kMdg70GtoKlBfLopYYhLT_F9LwmwENDJh7EQ&oe=6A81A8F1"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMgjG2lF_FYQ7kNvwFsWj7Q&_nc_oc=AdpYHYpsUkCv0kiYOrhR-RE7buhWBdDUcrUp1hpt8y1jxJpEVlmlTCMmUGltXTySxxQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwlShkRHc3nVwRYpw6-2WilWet94yr456fKcl6qOWrtw&oe=6A819060"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjWYk4iPwNMQ7kNvwGGVtDO&_nc_oc=AdolpJSRFQ69rsUKBB3fNTVCcEZXKNCFMRximx8GGGNfhj-AN6eu9z_SDNeihFTuK6Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-_rD8OoHNwPpMZGCzukM3hIBh1mUYvM9V5PcA8VqFQQ&oe=6A81C2B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
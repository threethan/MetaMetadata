migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhfa0GnblA8Q7kNvwHNDDNo&_nc_oc=Adl7xQUX3mI09x0UI-iOXkyygswCU7F8BnZD5ul6AogDuhgatwmHpDWQuTgE5DUq3n0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzGCNa7DAo8De9UrS2zvv2jW75rEaqjGrq2rrFC2d9cfA&oe=69AFFF5E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQmPA_ROkbQQ7kNvwEKiYhI&_nc_oc=Adk9LEU6cLtkejEU5lAHlX21VZhJYqikhZ5hpszLfH3l4fEbH1mn__W5XAIqj06zHgY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7bZY_aelxD4ZmP361hR-t7amKk0T4mX59hc5jUV-9AQ&oe=69B00A71"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjA6Akf_TDQQ7kNvwF6JtcK&_nc_oc=AdmQOzKg2iqfCKiOxFmN2FsgBHAklchoPnl0rAeJoYfDm6JNn7vA4PqyHoAXgVG13R8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7c8gNgzKPY1nBbUm0Q0hXDUrmd4J4cHXScNWHWmDKdg&oe=69B02A20"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2O4b6TV3qUQ7kNvwHxFnlK&_nc_oc=AdkvLeMtIb7I4RNHtY56a9ngZ0CDKAbkZtCRuFavB8Gydr3tas8GJdApiZssEUrOGig&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyqgfNIMa_cwu7YECJHiGG1SEjHGbFBOzQZvRukeq96Lg&oe=69B02437"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "RE
g&oe=6AE34360"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrJTTenlUYYQ7kNvwEp46Ye&_nc_oc=AdpcMVRvMnxH3pULxxsYZpPGcA_6JmnKUFZHcJvqn-hAsgc7k-unVOw63ovHAkIH2ZI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMM7g9z_57q1DRFgrCzwM_Be3PiBNN_Ad0pbaq43TzZ6A&oe=6AE3651E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAnfxz_75QUQ7kNvwG3b_IP&_nc_oc=AdpCRu_OkSoCv2YPB9w2Qtq3X9hXrjH739wWQdvH5FiySEYlLwOTegOhsmvcMYKH0js&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQukEW3iiBYeYMSQ2A-WBbO0DKa4Se3jzKThET9-F_ZA&oe=6AE337F1"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3VIY6EGsDwQ7kNvwFUR3wI&_nc_oc=AdoXiQvjgXUTyW2m0rUoRBGo561WoGGgk6ipAcQ4W4JNqFHWEvckyDTy60YRtiMo4Hc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPy5nYMOfEyFs_hLcFbPDWvMA3nR5IhnJ-U-4979UPwNw&oe=6AE357A0"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjUyMIxmMAcQ7kNvwFTdlYn&_nc_oc=AdrAxQze5KZ53fZdO3z4BLaQB5vRuAzKdMLjJC5pkqbVQw7_h8ebce6j199hSzsd0xE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiOFDZOH2oRrYqsNoVL2rTRPOH1WxKfNj0eR6233Mgdw&oe=6AE351B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
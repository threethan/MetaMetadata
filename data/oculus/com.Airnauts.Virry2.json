g?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwvlZ0izYC0Q7kNvwHogtkf&_nc_oc=AdqDb1ojI_EomXBTJ0WpAQsVE6t2nTF73b_a2MezexZkcaTDNNPuiCpjfkc00tLZKlQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvW6LkyPXmYyu2E_lwvP5W3TnmW9e8LEitsKzLLEUp_g&oe=6A4B9B71"}, {"file_name": "migrated_image.png", "id": "231528434908924", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_r7pZSD83CIQ7kNvwGhVUAH&_nc_oc=Adpzj4075W_afNFrM7WSR2vCukySBP_K-ZQ9RAWAfJw2KSf2fq1dhQjgUukRg38FE14&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaZ8M1zxdXS_CTB6CJqhOQdH0E89XUPQzxIIhEMk5SYA&oe=6A4BBB20"}, {"file_name": "migrated_image.png", "id": "212399816653872", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162682_1756596874645581_2822882841732317184_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_2vpFgrmU0Q7kNvwFsq3UW&_nc_oc=AdqM89-8FqIfkmzoay_Ant1aDi8YPW80AL49G4o5hL06BS0waKByoFEu4NV7VQZ-U4Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuuENXoDHS3Kh40UpoeE1phrH2oyRvvPyhXJfamQ6mNw&oe=6A4BA6E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11162731_874801452683124_8480571075237773312_n.png", "id": "1673110742720080", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162694_1673110746053413_890324910616870912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tch-aJSgRpIQ7kNvwEeA0ql&_nc_oc=AdoAc8BCycMstM65EVF18lhbBQ2Gh9y41Clx4M7mWd2AXlV8HpDNlOLXMkqLMz01JJ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbVxyaUbDuiwYcwFRULKM34eZLXXsCt2gHkexSD7ZXng&oe=6A4BAD0D"}, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fnt-resources.s3.amazonaws.com/docs/en/PrivacyPolicy.pdf", "developer_terms_of_service_url": "https://fnt-resources.s3.amazonaws.com/docs/en/ToS.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recomm
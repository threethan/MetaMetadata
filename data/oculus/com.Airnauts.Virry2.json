Q&oe=69D4FFE0"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=riASFOsZ8swQ7kNvwGQGInq&_nc_oc=Adrr8RQ1XoyoQ7MCgj10L8Mi9ljJkAqHhHUc-OTUzvDatWuCWf2HsHKpwwIz5ASdO_E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iVibQ7N18HHRjwsyl7WnaiyF-VK-brGCNH952xsTP4g&oe=69D4E95E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hdSQIAJgSkQ7kNvwHetk-n&_nc_oc=AdqCDsheWzu1CJAfsUaUIkCpqDhLNALmbutRm7x-tX-Udt3Y4J1BTR9p0Oqsekbq68o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GqIpGyqLopUjJp2xT3_4tO_ZrS4ODWCF8jgeHTw4ljA&oe=69D4F471"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvUz9qULTTAQ7kNvwGpZqXu&_nc_oc=AdoZy2YDV0DNHzaL2-uFrRASopWieTCkl-Pq2bWexQZpr_bYBtf124UITjrIUnL_ZKU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3NcGycaEe2Kf2kFM7GeXaeuhaxiCraw_QaCfusqyV7qQ&oe=69D51420"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6g2QhyBYbIQ7kNvwGbGHUi&_nc_oc=AdoE8v8NmOELPlN9vaedJeVYJSaLAhnzHZKt1zS5OyP0Fk6o8IzE75liFcTMPFl8H0I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wblL0-UluGQKLIJzkZp5CjbMdv0to5DUVmvjh2FjuKg&oe=69D50E37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
ejEU5lAHlX21VZhJYqikhZ5hpszLfH3l4fEbH1mn__W5XAIqj06zHgY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7bZY_aelxD4ZmP361hR-t7amKk0T4mX59hc5jUV-9AQ&oe=69B00A71"}, {"file_name": "migrated_image.png", "id": "231528434908924", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjA6Akf_TDQQ7kNvwF6JtcK&_nc_oc=AdmQOzKg2iqfCKiOxFmN2FsgBHAklchoPnl0rAeJoYfDm6JNn7vA4PqyHoAXgVG13R8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7c8gNgzKPY1nBbUm0Q0hXDUrmd4J4cHXScNWHWmDKdg&oe=69B02A20"}, {"file_name": "migrated_image.png", "id": "212399816653872", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162682_1756596874645581_2822882841732317184_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8tSmlbbmEoQ7kNvwH_zw70&_nc_oc=AdmnGn2mSci7SkvElFieWxnIEwXY-Vvn1bIzDx1EWp-6gRbpNfDdGref2m1YgtKdKd8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_cBpmrjqpgzVW8ahyMYzjdHFQiq_Q2wCZ64S-8cXODA&oe=69B015E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11162731_874801452683124_8480571075237773312_n.png", "id": "1673110742720080", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162694_1673110746053413_890324910616870912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TkXC9jTXp4Q7kNvwEtAAIr&_nc_oc=Adl7UduzqEGMSrIRSjqeCxKnQYgkvy_hRiiLK1oFb1jkrN83XNX4yaVdkopeg8L25P8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHENl5oU0to47D-3lCOvKNBMUn25B4JDDx5VqAjxi6Rg&oe=69B01C0D"}, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fnt-resources.s3.amazonaws.com/docs/en/PrivacyPolicy.pdf", "developer_terms_of_service_url": "https://fnt-resources.s3.amazonaws.com/docs/en/ToS.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_GB"], "supported_input_devices
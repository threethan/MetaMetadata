w&oe=6AE0A060"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnMvwFj_cBAQ7kNvwEG_aUu&_nc_oc=Adr-LOnF8-4I3Z2LMhbXipU27RZC9NH6k32Qy3scBJnrhvPnIQuzQtwOgmT1TN7EvzI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMc8mHcbzpPPHqvvWHSxT7Av7QE7f0ypuwXAIYHXTT1mQ&oe=6AE0C21E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unMptdiD9cUQ7kNvwG9y-6E&_nc_oc=Adok2Y3jYUEFvDNaytxllltFWl9lpEtPcuThehS-m_0pVGLptSY4FiDAB6KBsPydCq8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLfsRcctUVo-YfRrHw6u3Ug8IW1E3M7mQoZypIkNPnrg&oe=6AE0CD31"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3VIY6EGsDwQ7kNvwE5o4zK&_nc_oc=Ado2Mo70zKCu61U-vQ7y6-ryeu-TqG5SNpZexQIWFrMAebjTFgZylAz69FZBwvtiUTE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNapSNPbTk-zf5nD2yWUPF4Gnmd0pGtIUqbu2XHul1N4A&oe=6AE0B4A0"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xfqki46mUloQ7kNvwH9gbOS&_nc_oc=Ado2HVNPAzYwPSFL18h0LsH2DhONws3l1ujItRlyfCRl7qZy20pB9cNfpbNRu_wU-oM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3VeMeP98MWufqUOl8YOtpWcAAeJU21xIEYcYCXkv9nw&oe=6AE0AEB7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hd0xdZoMkYQ7kNvwE695K5&_nc_oc=AdmE9MjDFqRfGTfUPvh-j5fpZIhtljggG5d51G10r1ZHMS3F7oB1tBB3UbqXa_dNPmU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxyj_63WiRgQU1p8bFjtzThOsMUmLhLaymmXtdg3B6S-g&oe=69B7E85E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5D169aieTmEQ7kNvwHUtM3a&_nc_oc=AdnDBXj2bFLfL5Wotkt_KZlO9Zf6hPlm5arGFtUw1YiDZhbSe4NLpAG2rGmW39PSXYE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzmj7vA6uIJ6EX4Blyoa542O1YUyKxXNk3KxU1-P2yVSQ&oe=69B7F371"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vIaMwKRzNIQ7kNvwFomc2C&_nc_oc=AdmnfGFFiWqtHHKjI0yNZFEIyZgwjZvjujc-Uu_t3zmb5YlxK1W7LfdD-GkGJg9fH78&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzcuDvfTosaoWpnViFJRs7Dj5o6p64lyW2JmJxy0E6-dQ&oe=69B81320"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mq9vdpGYq_UQ7kNvwG-_Rz3&_nc_oc=AdmFezrru8QvwRSByY1xDpcmVyGPkQ_6qTyFRLo4s5pABqI-5R7DsVdVdbdhsNTfZfY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyhrQ-Ui5JJHgm3gEJDsJjVG30_cTnZRY5r0u295hybPw&oe=69B80D37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "RE
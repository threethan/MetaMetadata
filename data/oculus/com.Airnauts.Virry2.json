A&oe=6A918660"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cx5w6YgJ59UQ7kNvwH0hz07&_nc_oc=AdqLsht_jCZ4bsTxlzK_83vWRr3jJxaO7E8rPAIi-6go4kRzNv6QvoNvy1q0QHIa23Q&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-WUvmynYFMK_5ba5fadKrRmMgnRodf8WS-i5gAwP-MQ&oe=6A916FDE"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iK4Tv7rBGCgQ7kNvwG5w-su&_nc_oc=AdoTM-R-eWFUOQYxnxIrw1mnw_iQdV1-IFRrwwBTHlH27AGxSSK4BrwdFxZ-03ol3Vo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjUTfIXo9PNsmsHkJ_8BTT-eqmgq-NwYtWi4iP18Ay0A&oe=6A917AF1"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQZyiOzO0vQQ7kNvwHxArfM&_nc_oc=Adryx5mbZ1o1_YTGsXcFuJM0Osw2sXq8v0PLkyIx3-wmUtt2vqqUXQV8Bu0h9lD8SMo&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGd7G6ADbUCwM6c6wEvbTyRWdih8H6WkduG6yUw5L_1Yg&oe=6A916260"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMGFoCvLA7kQ7kNvwGYKhjg&_nc_oc=AdpYXTvoCB3cXKle3i-po-wtzMHc-KziW3oXfUsPJ8SlinEDiSX9j4ip145IJzocLvc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcX45lbf3TJFK67DZiGztUq9jLvYWFAejeLstkgH_ofA&oe=6A915C77"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
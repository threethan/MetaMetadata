g?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-_G4Z2i9lcQ7kNvwHeRcGt&_nc_oc=Adq31_NQx5qxtcW-imUaSY6Pr8OilNerhOpzBp33bqXfketZs6Rf2ORoKMQFpwla7yE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaWLGbL17wJD3Evo8Pun_eEaboFwBVwZ_Iqi6SulLe9w&oe=6A689C71"}, {"file_name": "migrated_image.png", "id": "231528434908924", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ON7hglo6bIgQ7kNvwFpo4ii&_nc_oc=AdrRhQGLEFd9xntt37KdJcyCP1xvTglB6PRoIw3ppxFbzcjyX62SMIyUlF574pw57WY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkQsYhFkKmh3xfl4rZjkEqTlxjA7Hi6yt6PueiCQvjJw&oe=6A68BC20"}, {"file_name": "migrated_image.png", "id": "212399816653872", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162682_1756596874645581_2822882841732317184_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuPFUNZPf80Q7kNvwG_QSmK&_nc_oc=AdqE0NEYsfQiALynS4jjDexyPd2s5JzFROddJOM5wsPQc4CCH3yq2qw3IaDTjpb52ks&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDZLDhbL09Qk0OZSRCNA6H_ut4ZQ5gLTPpFD4k0W7Xjg&oe=6A68A7E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11162731_874801452683124_8480571075237773312_n.png", "id": "1673110742720080", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162694_1673110746053413_890324910616870912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIMIdY0rvqUQ7kNvwHwn67m&_nc_oc=AdpKYa-_lN0yQVL0BAKoLEj0jw1nMcPPJYkKYQ6Pup4sdQfGePNc0590YjD54yiPQZ8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtTCqw131RcuWLIp7mZwEojel4MDb0YXwGhMfBf3ziGQ&oe=6A68AE0D"}, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fnt-resources.s3.amazonaws.com/docs/en/PrivacyPolicy.pdf", "developer_terms_of_service_url": "https://fnt-resources.s3.amazonaws.com/docs/en/ToS.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recomm
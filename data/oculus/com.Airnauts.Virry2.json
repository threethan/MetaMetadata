g?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQSu7tn4Pn0Q7kNvwFPpyxy&_nc_oc=AdqNgOmjekpXgN6VeirG1OZuy6vsA7N7w8ZZPC-6_wQsDxHTHLNnu_MIADe_Guq_vdU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0gp2XuwS8hmH0yHSkyWsUbGdeCG2Y_CkjHvwXTyAfwyw&oe=69F346F1"}, {"file_name": "migrated_image.png", "id": "231528434908924", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MArwj681jzEQ7kNvwG5sjAj&_nc_oc=AdppXeTPEhUtY9F54e5SWpt7G4R87QpFE0jTMkzyaCvHW3_5x_96yninCSbyU9uMBkc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1HecdUf1t8oaJ-qz24B1pHB80ydwnbr0QisrHl_2Dfsw&oe=69F366A0"}, {"file_name": "migrated_image.png", "id": "212399816653872", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162682_1756596874645581_2822882841732317184_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecAH1xhfxKQQ7kNvwE168oS&_nc_oc=AdqG-XyWS409aKxGXvhwQZ93o39P28uoZMM3NF_kgKVmlp3Cy_378XzwXyWAJ9kLfZo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0dm3X10DRuio2MCHNlUPzXywaxqoqCT44pjetmOzvphg&oe=69F35260"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11162731_874801452683124_8480571075237773312_n.png", "id": "1673110742720080", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162694_1673110746053413_890324910616870912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_oKDjUDAswQ7kNvwGyeBXi&_nc_oc=AdotyDjDbeGWnXwDKSTXrwaKf6Q7Mx0ag6nU3cy3O0G7cpn6wz-f1bAXOIE6hxtnTq8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3SD53ggLKf8uEoOa0ehnqfVFpmGgFkTiaBBLIbI-bJDQ&oe=69F3588D"}, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fnt-resources.s3.amazonaws.com/docs/en/PrivacyPolicy.pdf", "developer_terms_of_service_url": "https://fnt-resources.s3.amazonaws.com/docs/en/ToS.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recomm
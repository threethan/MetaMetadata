w&oe=69E22EE0"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CuV0Wb14vm0Q7kNvwHGYxHO&_nc_oc=Ador-4r4vWuKcfI6jczwCiRqdp53t61bNT0xDmnGdhJpdP6UL4EV8ZCjoV7066l6FFA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0w1OSeMWMB7FYhNu9rOQtlkhy5b2ASTfdjMdnDLoPZAw&oe=69E2509E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3tvqs2_LqsQ7kNvwFO8hpg&_nc_oc=AdqXeFFPbyNiBWezZKq_5E0mpO89941mr7UQi62tJGrXooQfv-FLRnzFbUK4m-n6nS0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rIYBPUI8Fb2PMVmJ_5VmLZt-93cwsc8IITyeJxnTNCg&oe=69E22371"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tm5pfGliQ-YQ7kNvwHp2bT3&_nc_oc=AdpI_GhxEDI0kjhM7yIOjhqqt6Hg9n7-kRWo-nq3FIiWuVYarwFlLtXu5tErqv6ttCI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2X_9CPIl47hNFGRw0WrH1WO6G13eB2N-m-hv5fUwFHGA&oe=69E24320"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtbkMk-LJOgQ7kNvwFWsm2i&_nc_oc=AdoFOTqjzMKBgxHbJK_Dn1iFM8yCVu7vXPFiHHytzwADMnA4CnFnBti0nQSq0DDk3Ac&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SksrFNSsCKnU7aNtyFRKs1Ld0EuyC0WtFA614fuWMrQ&oe=69E23D37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
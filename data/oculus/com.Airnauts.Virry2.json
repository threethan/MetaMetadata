ySKTSbw8w&oe=6A4660E0"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7wsCcKRrQoQ7kNvwGU0nKd&_nc_oc=AdrDIxVIID1FGaGPv6qZ0tgvn-VKEnvFkh0f7tcyL33OnVInJuJQ17TzbOLNQAJ48Io&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wiL94Di3ctlRhnjjfZ4BX47ziMllue7lMq5osANs82Q&oe=6A46829E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3HZbXvDYsQQ7kNvwGUSvKe&_nc_oc=Adoek5szPqrAQuH7zQhHkbItyr5u-WOzdrgrC0TGJU_cuf9pabJu0jGHoGJt62lkutM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0CkesQbwKJo6mMhQrrd7bMEdcCSz_ToaUexashenxxg&oe=6A468DB1"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkKwXAA9CzMQ7kNvwHdXChW&_nc_oc=AdqAQqmr3uNlBxQxVbUy5qpq5_8rQBVCSPR6D6fDOthHbi8JXwcyWxBnRhkOGnxlBOY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WVeJVJNqqJSl537UW1SybnXmNWUGeN3aeQTtq-UUenQ&oe=6A467520"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vx1EwbjebHMQ7kNvwExl-UP&_nc_oc=AdqQZJszIkgUqLDXXdlpQ5g06PRj0PG--YxV-wzpTKj41nLBj05HfunKuWUhF-Bn0Es&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JmAiF5rhf8vAlre8GRHRgjMXvxl2qrGohMcb8Dmds6Q&oe=6A466F37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRA
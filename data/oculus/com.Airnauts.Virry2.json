A&oe=6AC52920"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODPHH0aZuHgQ7kNvwGmUwk_&_nc_oc=AdrVkbOrWQJll8cQrWleC8nS7KOe62d0Eun6B17MdldgWcWMQB0cscioGSi4h5mdOPg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLLM5y9ygMABwoWU1RGPge97_h2OiBgWzMgHvrEXwWaw&oe=6AC5129E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhuVbZ-EUTUQ7kNvwFm-ui_&_nc_oc=Adro1JTfjlKIFpMonKCKqbimejda2xEC5vmXHG__fTeKGafuCq52Ozy2frzUPELD2oc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIoPz_pLCQWTl7DpTWHFfHsp2L01EQ2G5mGBnUnwxLvA&oe=6AC51DB1"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eeFEazjyH08Q7kNvwG6AqXi&_nc_oc=AdoSUoqioc1iK982LB1qAKcR5UmyXPEVKUz5ZHyUhgPVjocUpU_227vKZ3fjk8rHBvw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6sn_lsjNYFZv4iYrdneBFLbWQ47Nn0bQB72NJ27uvNg&oe=6AC50520"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ge2fqPRThsoQ7kNvwGzJjEo&_nc_oc=Adp0TO768_lfWFwYNtM0bXt20enPPOsV_hCwP2eg36Mish5ntInR6qaflJCQglXBPSE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZOgKkEq1kj4LP1L38DORqNCZlj1qPn3Qw7-GhBOn5Lg&oe=6AC4FF37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
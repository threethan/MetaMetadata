Q&oe=6A3148E0"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2Hqn-XgQQgQ7kNvwH3p7nG&_nc_oc=AdoKJqPC5nnIKt6pPEEjV6U7FYdD-ejGMuPTanqdVGRC8VfgJO_Ca-wVSjf-_MjY9PA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1byHXGJb1TKoQFqB_NiBzcDR7u1S2hnbb_FVoeMJJLg&oe=6A316A9E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUUf8GPvKisQ7kNvwEMDAsq&_nc_oc=AdoUqbPHS8fz0l08eYLMi4Db0Zv4tCIkZnQzP4-Ck1E7L94er-ZhHHHHKWQ-D0-u_Bo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8_HEkBsDTVZJ36V07A4ZnxHBa-FQhm9sDIQgvHT9qjg&oe=6A3175B1"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-_Aofr3vzoQ7kNvwFiuhhl&_nc_oc=Ado_mPBwynKbkwqHuEXIiMxVS_Yyo9ktcnECuRA5HkCmzNeKmkpmRIvtCHzhlc6_S-k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wTV4Sa9bsuDoBxOmvv-Y69rKdH8zkaf2KD2Sh9-K3uw&oe=6A315D20"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8gV-vyl42oQ7kNvwHPF7x2&_nc_oc=Adrp1WPyZ-sgJAsCiE55g-7g9vNAwKqDMtdwJE23YJjyt-0pQabvSJyArLEudHxqz7g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97Oo98ArJpsfb6sVet4qJ-IBrju9WakApmKNz_GakBhw&oe=6A315737"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
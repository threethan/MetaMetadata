g&oe=6AE1F1E0"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnMvwFj_cBAQ7kNvwGpYp6O&_nc_oc=Adr4ag49Kl_g8x5aXD9-L5qYiRfpIZJSZMRyYrCFyAs6hrZqZ-cmDtQxRZ4OedMiqbs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAGy4lj9mZn_vgkPEELHlVZy26f-kQkzO58X5_nVV8ZQ&oe=6AE2139E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAnfxz_75QUQ7kNvwFO3961&_nc_oc=Adpj5QBVuruQzITv5fSuU1GdT-KklbacRcP8CR-OHb2h55kdUmfH-3Yc1K-V6c0lwxs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1GpLEZ6T31O2SVqBNm50kti6AFPiGOpsoP3ifwlI6bw&oe=6AE21EB1"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3VIY6EGsDwQ7kNvwFxg9wt&_nc_oc=AdqXnnAXILrlWKTeGyxX44fBYKiqA-f254_WqfelLJixbTK7Fwgd9cXBqH_FiK9gQi0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKJW1MDtI7WoXw0RpYAj7Q0tMOB1gD7w5C5ZWrd3GtwA&oe=6AE20620"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjUyMIxmMAcQ7kNvwElFtoJ&_nc_oc=Adpz6dbd-7-baKJdGrUTRLLNQ5moI18pvVs3zTvaXNxmN6NZE0WcOEEj99aB15O643Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN91_db2hfew0_utkzXI_KJB1hDIdNeEW5QekmrtMwOXA&oe=6AE20037"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
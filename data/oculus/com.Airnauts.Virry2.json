A&oe=69D10B60"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TNXsdUTb5QQ7kNvwEDgg4x&_nc_oc=AdqnbHG40zy7WaiQreCsFJNa6rWKX_sQv_Rk4MJluZfqNXRCbGBPy1nX1QljmZe6Q0s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwHHokkZiM7HCnOIH6B_paO7uEApym4djpvFgH9WOOAfA&oe=69D0F4DE"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6bRx1OzzK8Q7kNvwGoRYxS&_nc_oc=AdoDfdOsOjVIZYs7TOvbYTa9gCWXV--y-5PEbNHvx8COSHxBNxjARhABYdhKFSaUgxA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzb12-vMUwhfD8cSapugKxrPNMAQik5GaC24aWNwvA86w&oe=69D0FFF1"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUPdNKhUNn4Q7kNvwGB_99E&_nc_oc=AdqhHs-tYD30FPwKSQmmXNd9jrsQ7aNdjCjcsEF2ueG5BKOh5wDH-0_7mt3JmyQ6Spk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyhDJaL94cMj60Ovxcm5Ksn1Gy3t_YsXwK53mwgSA6JFw&oe=69D11FA0"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZuTRVa04_sQ7kNvwGJGLt_&_nc_oc=AdqArfY7oF-ijtiszLrJcdOA24V9HJEvEAbEAvgQEODObfaEBZ3YSWOFMOVbONFnRfo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwtxp68MH7JGgmRnbMk_nC0rdNXs1GI2Mr3VIn9PxzaTw&oe=69D119B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
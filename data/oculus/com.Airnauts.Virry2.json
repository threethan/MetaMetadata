g?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-yWbIfU848Q7kNvwGqyR1c&_nc_oc=AdqJ-XlZ0m7lLRV7o1ctS8XdD27EXKvXfDvEtBp16GzIfxaeotZZ_HgS-a4XHbTMdiY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKF82LQpuVrioKcrwMdOuFxml9bHDlr-rqlKInm5KiPQ&oe=6AE764B1"}, {"file_name": "migrated_image.png", "id": "231528434908924", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqCUnBgvbgUQ7kNvwHuG_JR&_nc_oc=AdpBVwRm9oVA8Weoj3gdtYvMx05hnV1X3KXkAP3tdHLWPWMvorzv0dhmOYsccqF0nUM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0xMjQs1M-98r6uBOw4pWRyBipadHUggfA3EvHd-3W1A&oe=6AE74C20"}, {"file_name": "migrated_image.png", "id": "212399816653872", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162682_1756596874645581_2822882841732317184_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnxmXFiibdEQ7kNvwFbYhN-&_nc_oc=AdrMdcopvCxepaU2IjbfZwBvg_qLnt_fO_ojvnaoIieY0GO89tdllASrPKiH-hwtxCI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQs1l1oHTT_QZYE4WGRJd92pD13-zwboU7XTdH9sa3o4Q&oe=6AE77020"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11162731_874801452683124_8480571075237773312_n.png", "id": "1673110742720080", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162694_1673110746053413_890324910616870912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53hyC_dNPHoQ7kNvwFMxtJh&_nc_oc=AdpV-pvM7BTJxkQtlUvjRcyY_4es1UtA0adAYnGNz5lS8eTUulGMqH8NG1gF63221xk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBL0CIzb_ErCm_H6PB4lEE2oZl2crDeiM6udW3VL8IaQ&oe=6AE73E0D"}, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fnt-resources.s3.amazonaws.com/docs/en/PrivacyPolicy.pdf", "developer_terms_of_service_url": "https://fnt-resources.s3.amazonaws.com/docs/en/ToS.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recomm
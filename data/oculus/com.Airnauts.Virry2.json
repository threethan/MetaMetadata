g&oe=69DF8BE0"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Av7vXmeYt9QQ7kNvwH4FKbx&_nc_oc=Adrhq81P1S9qcy-ibg1PeKPcp5wLdmb6v3pKBPgaOyEEX9c-UKx5Kd1bV2nKLheVNZ8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WqRXvU-oSZFhhEJfDCrDGAJO3QHHxAOqwM9BsavswZg&oe=69DF755E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pacq7F0uPZ0Q7kNvwG2OWdW&_nc_oc=AdoXaMPRIDBN6GElcDKzt7L6ANRfShmvI08fpYt-IPQqcI4gJzoU0DSWAKigKnff5QE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Q0ME2_kHksPaG8x8OCfbgKqvMXNM_3XvF5NBeONSkKQ&oe=69DF8071"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tm5pfGliQ-YQ7kNvwHZfcUv&_nc_oc=Adq9yHNruTFG0S1vo2w2wlgd9VFPkHCYya_IEHWQc8Ei_6wNFSSAPO2gAg3gWnGL3Z4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af369KevIiGvWDnXrkSoGvGu9dmGLJCnYXmfTggNVTFWGw&oe=69DFA020"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0zVW2A7HXYQ7kNvwGxCF87&_nc_oc=AdpE5qVuVL8VhJ7ctENxByUKR-WKJWLiTKhTCGlLLPIDKLx1zpjM_5OKdFMlIpQliPk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35f_oCRMSd9SwhXQY1F0WkeR_j-Wsoh09wOBKLiuhngQ&oe=69DF9A37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
A&oe=6ABE5960"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cE7SGYM7LVkQ7kNvwFz7ceS&_nc_oc=AdpVBS0LTfRnl6mf4TNI77tEuCkKnMIQDKCyDezW1FuMY_ayKbasTIDB7b0BUdMDBRU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQZpZU8zTOtPpEv5XDUINRspaor8bmAyd1NYBd6koTfg&oe=6ABE7B1E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQ1UoVDq8F4Q7kNvwFOLeA6&_nc_oc=AdovColFfP7yNThE_FTdkzVbUeu2kiNs_Ta7YC0BvFsvM6Wu5-fBaK3S-lvfUxcwRvg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAZMt0rFqmvcW0Qt8fKyeDlrupYyxcjzseWl8jHYfrjg&oe=6ABE8631"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_mZP44I2fwQ7kNvwHjzNee&_nc_oc=Adp07H3UygG72QRHYWM-5IVsB6GS5idmb56qz-2cpY0JpuP3aNwnwq7zD3jv0KWJN3E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCc1Bq-VrgkVsI1eJKsK79WWfYP0WY7PeNXCKwPH2_rQ&oe=6ABE6DA0"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gy4ZrRnbyYcQ7kNvwFB37_G&_nc_oc=AdocHwAdhvPv8qODXXvO2nXv45fzgSxnXBxkXtYOuZTFdpvDs8-gaogKrr4xpdo7Lxo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0JAMV_sAN65Vl1UOwd7T0rjiDnwdBvSgiTiL3U9rkew&oe=6ABE67B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
g&oe=6AA006E0"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2a8JSVS5YwQ7kNvwHoqM2d&_nc_oc=AdoTpuYZoWqbwRXihGJY61BKl6H-snYqwBjVEjM56NyGv7R-v0xK8rdWxUjUsNGT_GE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5iS_1we2OcZ5YwE8djrHw9GJJzaUH7A8KUm_yXnayJw&oe=6AA0289E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQGNDEnVkagQ7kNvwHAjcKq&_nc_oc=AdrhLTBH8jiXvnWX0USFTpohKF0MfJLOP0yWAYy2wyAePngG4xjau57WiJT1sN6HxRo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJL9V_CDImlzWBPxEzKEWS2QEPzRk9yKXRbv3CAu3ZC2w&oe=6A9FFB71"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeCEJ4YWLl0Q7kNvwEm7VM4&_nc_oc=Adp2eLTgPX2_BSoBSi2Oru1ASBsy1HktA3gfwO45KOFhVz8LBZ4U_cetbeR1pDwqfBg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLn3UrEx_TbJPs6_gkWsVZzrfoOn3TifDlKjzdSHyTkuw&oe=6AA01B20"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRVKn2ZuWDoQ7kNvwH8W34F&_nc_oc=AdrkcqmJFhufXeIjDtDkLOeB4fNUzANf7p7IouCWoqPGI5SuW_Fuf-6vl1wgAlyai4Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAMUPyC-iwOQvC5jktHzjfMJJkxh-msWdhN8gNqMuUog&oe=6AA01537"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
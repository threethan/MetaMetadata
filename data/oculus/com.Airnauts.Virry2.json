Q&oe=69EE0C60"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABRMkD30hk0Q7kNvwG1csCs&_nc_oc=AdpDqGx1ADj9B9sWXxma1bHsHjO-DMy1-lThVWGNuTeSlxT19VXcI36v8nQHy-KV-CQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NB7HKrEbvv4RiRaGqiwq17me4URG_7_AuqkaiYBFWTA&oe=69EDF5DE"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuNZ9wi8JZgQ7kNvwHShJuz&_nc_oc=AdpJ2xTFLd0NNdiWjmQQcDu3h8tT_xVUTO-xGd3L1Ll1BK_UooFAQ5iom_J6ULUs_m4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SCKaT4d6p002dy7aQk0o8dPBIS-AJ7dAtQjdikYpjYQ&oe=69EE00F1"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aP15wJvICLYQ7kNvwH4KIsU&_nc_oc=AdpoFACAXUB5ILddYjHyeBULzxNSzN2QVlO6ryadCmsFXCq2l3xZlgJiJoalG7fDDQ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CJhj0nozwfVBPpcntJW4alx8IC513jqKFieB66j6AVQ&oe=69EE20A0"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HGqlmkWO1gQ7kNvwFdJG1I&_nc_oc=AdriSAeJ-7xKV5BFdgxuVHC3eoYfbJZCotc-aft7u2Ip8Z0mtFSrp5HyZ-DB0aI_1LE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Paq-4STqxQPk4WsWL1XkhPPRB-oYUE3dfgXrkq7aLtw&oe=69EE1AB7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
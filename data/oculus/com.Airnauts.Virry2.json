g?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYFB3Xcn3XsQ7kNvwGIL8zw&_nc_oc=AdrcbOw2vVuHlK0GrUhpoJQfl5-B9iYALUr1NYhiTM9Ngm1zDzM109Rzu83zDcMtk_Y&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNZHCxGDTq6PseX-tCy317Czn2c6YFfsIpu15Wm_Zq6w&oe=6A65F971"}, {"file_name": "migrated_image.png", "id": "231528434908924", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ON7hglo6bIgQ7kNvwHwljq-&_nc_oc=AdrKrY6wiWHwQp4TaOJaElEI3EC2MelNlpibNi2Yx87UGYN0085jIldxUWdFA90VLyc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGtr41O5TgG8Jgrz8N2HmM4XJpoxfsR1BMdslXjFZ-yQ&oe=6A661920"}, {"file_name": "migrated_image.png", "id": "212399816653872", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162682_1756596874645581_2822882841732317184_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDC4o8GM5sgQ7kNvwE-z_Jd&_nc_oc=AdoQO4kMo1DMi4NPCQ0Q0TmuWVVXrSVJKZQGiXVVY9u-p3imgQNA2e34TAT1cSHQgQ8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSsM3PKlyzTVjkl_0gFV9G3HF2jxnC4bp0bp6EwhVEUQ&oe=6A6604E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11162731_874801452683124_8480571075237773312_n.png", "id": "1673110742720080", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162694_1673110746053413_890324910616870912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7uujCqPTEoQ7kNvwFNA3Co&_nc_oc=AdoOM0oLUNwh3U9gvLfr-bqy5Im8c3PSd-ymLQHm30SLN19EybXhOSkw5BvVohokojY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiRfoBbDBBdcyx9MA029dJxORxruXPKIaulE7SGaB_jw&oe=6A660B0D"}, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fnt-resources.s3.amazonaws.com/docs/en/PrivacyPolicy.pdf", "developer_terms_of_service_url": "https://fnt-resources.s3.amazonaws.com/docs/en/ToS.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recomm
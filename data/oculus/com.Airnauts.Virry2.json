g?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3tvqs2_LqsQ7kNvwFr9U0P&_nc_oc=Adp9j12jbYoqdsKGo2hP40Xxx0UWhlStF3H3xrC270PHwIFXBzf5tA9xCwtgXM0fthQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3My5IDZsmiwraUBwx5U7EA6EezHjQAiGtlEkmN6Blmzw&oe=69E0D1F1"}, {"file_name": "migrated_image.png", "id": "231528434908924", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tm5pfGliQ-YQ7kNvwHa1z89&_nc_oc=AdogF19wBzoySPTuYUNjXiDxc1Rv6p1F7CJFenOMH0ZTQpxSVVNrmyETWstTQFGMhqU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OkaCMP5oggaZzd3Qn0zsAGiDGhS1pdCcJeX-8T1CHzg&oe=69E0F1A0"}, {"file_name": "migrated_image.png", "id": "212399816653872", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162682_1756596874645581_2822882841732317184_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dl8PfYltV0QQ7kNvwEeh4r7&_nc_oc=AdoLDQTIkp1eF79x8vTwPsFZv2ZfZwEMsSYcS_boIHjFBTsTVP476GKrJT5HmmSZ28E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YNv_-ePjgC-vh06TVhZQHAmzwHLNJEE-eZEqbvzmBoA&oe=69E0DD60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11162731_874801452683124_8480571075237773312_n.png", "id": "1673110742720080", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162694_1673110746053413_890324910616870912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwuI1HFX2lUQ7kNvwFP-Xio&_nc_oc=Adr3eCHIkFN6cJur_eYY7RzC-CFJjfQ9ZZ5ldqa3FP4kdKu6OmNqPLLsN86hjujMupc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zlUC5JNEvRnKLR5mBKSDic190UwzCsesaa4zQiWXE1g&oe=69E0E38D"}, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fnt-resources.s3.amazonaws.com/docs/en/PrivacyPolicy.pdf", "developer_terms_of_service_url": "https://fnt-resources.s3.amazonaws.com/docs/en/ToS.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recomm
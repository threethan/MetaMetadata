w&oe=69E8C660"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-0Ocn3J_gsQ7kNvwHek-de&_nc_oc=AdpvZR44QyrfO6H88gEi-9Y0HTO92PbYGA9oHFNgXfVknsbobEhFiRhJiut1LcJTGq8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zBnqcifyV7K1XZ4XwQ5DdJX1EZM9jNvaRvB_sm-k_LQ&oe=69E8AFDE"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKblro189hkQ7kNvwFnavGD&_nc_oc=Adr5uyTdLGr2dBlxnHEWMwKDjZ3Fv5a0Gg_dhhOOokcYvlKd4tV5oEEx42DRbzMflVQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HP033Ge_mJ56Qm5S9RNZVkVvReAf3Yd-9mJ3JgM3dAg&oe=69E8BAF1"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3w2bG-TcjFIQ7kNvwGMIOn2&_nc_oc=Adq5Ii2CP4601z3zDZoPccP2hBqGN1dLhgYZ4dDl1wTsB6R-50IjRiom16vYj-tS9fI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LVs2ZX3bSNaN2D0-ObElT934_zGYsHO2rLTrigGGvWA&oe=69E8DAA0"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ai9tzhbBjowQ7kNvwGzrKuO&_nc_oc=AdrFBFZvo6uUgRBjeLf-0ijiHjOHPrQyPHI1Y01gq4ilosMm9XQYuu9mjdk-J7aPKkg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2joVDAJYfM_-alLEWFTicImKXMnC3pX6KAdi3mJP9NNA&oe=69E8D4B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
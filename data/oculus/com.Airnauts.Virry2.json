g&oe=6A2176E0"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqDROig83EoQ7kNvwEg-9Uj&_nc_oc=Adq_HJNTdPq9TyWByAEirXXlH4XtAt2hIlJZz1TOZV1kRy05VqKzZH7gZUPr_m7-bQI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ca6OuMLUQtWfPTIyoIhWxYVzmkJq_a5lr6pLiVVIuBw&oe=6A21989E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZooprK-EndUQ7kNvwHAhnEw&_nc_oc=Adq35VeXrso6x7zz1YvUKnb0Mu_fzCu_AoKP4z0SsWRUSNKp6JDdfU-4iqMab0jTvkQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QARG7Hp3cnNwUK5NqE0ocRMhOgB7sQ_Mx2PgNTt3_Uw&oe=6A21A3B1"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pl1J-lLrfMcQ7kNvwEx7ymh&_nc_oc=Adqyl8dr0wBsj33rtucA06B9xRRf7KGqS9K-3RlcmM8VEqmvo29buG0DNLZqU8F9hGY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9RDq_7IJZk_HQwG0xpfkBXi2ys6HM82xshFr4u-TOLw&oe=6A218B20"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phfQKKKSuCQQ7kNvwGrTYky&_nc_oc=Adoqq2RVbSmGc3niti2FxD7oDzauAqNJLmqlxciZzo69ZXxPaT03ZSjc245OfSeOmxU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FFku4EKa8bAJvZZ3yA1wp3YdKIOaL1OSd-Cn0KQUefg&oe=6A218537"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
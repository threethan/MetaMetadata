g&oe=6A68A7E0"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRvdf2L_0-0Q7kNvwECkUG1&_nc_oc=AdoAJKalHAFCJU2PV1v8jSfkyTkTWaYPWd4LuuIkZtAktsfO8mBLbN8ok_sZaS8C21c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsZpNAn_DgpRPF8p5U72GyNOakQjLEM7DzrsL5v4N_8g&oe=6A68915E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-_G4Z2i9lcQ7kNvwHeRcGt&_nc_oc=Adq31_NQx5qxtcW-imUaSY6Pr8OilNerhOpzBp33bqXfketZs6Rf2ORoKMQFpwla7yE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaWLGbL17wJD3Evo8Pun_eEaboFwBVwZ_Iqi6SulLe9w&oe=6A689C71"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ON7hglo6bIgQ7kNvwFpo4ii&_nc_oc=AdrRhQGLEFd9xntt37KdJcyCP1xvTglB6PRoIw3ppxFbzcjyX62SMIyUlF574pw57WY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkQsYhFkKmh3xfl4rZjkEqTlxjA7Hi6yt6PueiCQvjJw&oe=6A68BC20"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhW55OkW3CkQ7kNvwGn_XkL&_nc_oc=AdqZ8VSXM9CcvIJBE1Qo4KC2I8vbIOfY2t0pGG8qVpXirW81frFg5YYBDe1M8s43OCw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFDUdYf5By7Mx7hASlKmwcsBaXtDR-UTib58wAjlAG4A&oe=6A68B637"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vdEjhN4pJAQ7kNvwFfHx7f&_nc_oc=AdlADd2GJwRlUKB5Kr24DduZaJRtmnZCWaYxqPQY7CamGXhSu6dSOgmVRhs7Ed-foB8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvSm8YjBvV0ZVAyBYEgWp5z7MZP6ZsV9N-Uwhyc1Bm3eQ&oe=69A8165E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AyR69z0I8iEQ7kNvwEgfwHr&_nc_oc=AdkRZL1PpsrsEBOmX1CttsVw0c5-2muRikjJmwadQAeP7PS96W5XsnSZgAnfAZONCpc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu4W8yg5kGQ-KmZf6C2cvw9zY9dfPpbrCl4bzyhaOVhTA&oe=69A82171"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgCNLNa2u2wQ7kNvwG2Mjvd&_nc_oc=AdnpNNLY0fYPdcbEBNdhdh1BLJlccOqzHNSGIW0eq8DZk55Hd3s_vpf34j8_T-apNlc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsSApYiVMylHgNKmbJZ0THJX3gDabMA65KIjPkHVqV3BA&oe=69A808E0"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=903nTK92Xu0Q7kNvwG7QMo8&_nc_oc=AdnGr6m3ZbuzFCdD336lT7_sn819kOxKo51NQht6QazuFaZq2cbB30PUtG24SUHaDac&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsWyf6Pbx2vaPZucnMXcUas_54hPC8tpcCQn02uUszJcw&oe=69A83B37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "RE
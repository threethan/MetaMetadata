w&oe=6AE8C1A0"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EZJtji3gmkQ7kNvwEPtQj5&_nc_oc=AdoG761w4MzqJp_L-gyM4nrVBOMfpUHYK52SuLYClQ5upj4Mzmg53dqaQ3xEjg7Yj_o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0xAq202CU_oNVjBYIKc9C7U5TNNs-692AEms9gacOSw&oe=6AE8AB1E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-yWbIfU848Q7kNvwFo4987&_nc_oc=Adqyi-evwySy4Uw98OgG4QsuSeV_UsRiBLVxoP4U4TjQ3A-MGWDbBY5CVGkSQTAQkJ0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTm_M8_NUT7ndOnPLpAn_vQi1fsjPOFTKrqAGqEvYcstQ&oe=6AE8B631"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZK-463rNw2YQ7kNvwHxZikm&_nc_oc=AdoHtxvZ2hRHClI0CAeSU42sRZ4ONgaTJCOSiGUic4Ki38YIGprTYT_3uOC0OIys-CU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpBkUToU4hNsxyej0C2MLV4xxZYN7s_-3Bi725rXQIhw&oe=6AE89DA0"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3viNNkpVhkQ7kNvwFGurRQ&_nc_oc=AdrCBPvUlIn1VbHYycaganFl-m71idOMKO3aDKAgx6xBlCa1b7qwiu2xUewmtW-5cJM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrEv2PghTNDKID3HDrZPTH9CNNGvSAj_2gO-dbCPw2Rw&oe=6AE897B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MobvkeeCdi0Q7kNvwGHSjAZ&_nc_oc=AdldeLfajAEOWI5o4FLeBk65SDCkt2oetFexM2k77NAiKomQ3J2jUR-xMuRJuKHfidA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzMRSC7OnSSNKyAyzzQFufq-fVR5i3WeIk28pjU3SopGQ&oe=69BFD15E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6nFXzyZ_FIQ7kNvwHourPI&_nc_oc=AdlqEKOOd5ERPpthUOIUVlGcPIKEBmZHewtX48n5uYltl8zgX0uPR6NZmLCUOtbjUSk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyN55pIV1vChRmj5OZjofZRtoCCRrFREaboUz9NISemsg&oe=69BFDC71"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8Esz635v4wQ7kNvwEN_Obe&_nc_oc=AdmTHSvhIjGNuGeZqYbQYgxLqEc9IGiBku2xBY-t1PHIgCsiBCtwUm7fXMxJXGijHH8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy691lINm05QQ00joqewclMwm4lvQIQIiA2od5sPoLy1g&oe=69BFFC20"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQOS_c52HJ8Q7kNvwGyONn6&_nc_oc=AdkEq27oZxmYw1D1gp89sMjpSb7Z8SVhT0BcRN2oyd_uw6xQTUfbmN3uI6QkiSv6FFg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZs_n5tPTS7PUGkhNTWo3xflT9iHwuHk3BG1eyjDpqkQ&oe=69BFF637"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "RE
A&oe=6A33EBE0"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2Hqn-XgQQgQ7kNvwHB_bOj&_nc_oc=AdrJUWXDNpyDpija0o4x10BtJJC6KlPFPFiejTZP8VvBCQN0EGJiaeo8Z4xh0m5Bdcs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_j1Y4SZZVkcEDLOVcWO5nUvcTCLZHD0WO0-pPzpYueBQ&oe=6A340D9E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBoayNtYPWIQ7kNvwE8qJ2E&_nc_oc=AdqF2hqadGQCw21kpn1l1_64w6LkmVzppMiYdGn13RrKwEf-jfz2H6GUVk8eG0pN4B4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YvH089XLZ42Cxt0lcY_QhbpmFJ8LpIt9ECOvI03p-qQ&oe=6A3418B1"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMCmRCRxipkQ7kNvwHh_Vla&_nc_oc=AdrEqizTX7ofPN0jUahMpfg9htY9TX35hsI4rT2nDT8k9eU1bn20epJXowZI2kdzGzk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IG9o9mv2qyAuQIrFd2R0CIc47ezjqImeIQEcnQ8z6zQ&oe=6A340020"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIt6DlUaz2QQ7kNvwFVw0gK&_nc_oc=Adomap8q2qVUhpVlTMYuSa009QR8rH9OAliJEOok8eL3W1tVWcVelq6DNEpCLMAnSvE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-H-ZiuH5dbM2Nh_x8BxP0-MprRvH5m0VNq4IsPniiKqw&oe=6A33FA37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
BLiMEEDbv0OGTXA&oe=6A8D91E0"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0AAwvNr--8Q7kNvwFtHQEb&_nc_oc=AdpskS3yFGJ_x6Fnnc5jYlT9WCx8U_htBLY9JlsRDGkxo4YtFnCvyEDv-HdFLxdWlMw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeXWrBhFMh71qcMEwS5MScntYao0gWYpORyYByNqi_YA&oe=6A8D7B5E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOizPG3s1PYQ7kNvwHCmA4k&_nc_oc=AdrO2bD13lEPBskQf6uN16zZP2KZ_TBPPF4FNF8qvg07hdDO2HplLAK3FQHZ0dvOH_8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAuzx38gwwPyLRI6lQBJDyuZ5Sj2WQSlQDqqILkFa2Tg&oe=6A8D8671"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MWI_c0zWqQQ7kNvwEnmTx6&_nc_oc=AdroZ-PAfwh7c8Y6cp-uRJ6vKQN1spN57BhDwIstCNsBceLHl6spuo8aP0jTTC18KZE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBVzCIovs_p2g307jxCkMNvdYJ-umxG3ZfzcgkhSNoVg&oe=6A8D6DE0"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vhz8qEeIBjgQ7kNvwGG0u8k&_nc_oc=Adov4xkhapzGwqIKC0GfWGvzA762eD54ivxwyTxAVbxA7VpyyAgUvqQxvaLEa0Nh5RY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGP7ydcE9xQqQK3lM5pA9U_c2D2smzJ-LoaWHklZwUfPg&oe=6A8D67F7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION"
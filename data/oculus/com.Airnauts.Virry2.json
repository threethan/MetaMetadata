w&oe=6A2FF760"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFZmI6oC0z0Q7kNvwE34uPq&_nc_oc=AdrBA0FwiHq4A0WIt7bI1PRB9mJjiAtAXE2GlLYOig0HM2DB4CjwhLPRtM-LbLuHwos&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nTTnpk5TH3kaurevJdxvpKmotQpGhZKb1tZasd7LzVQ&oe=6A30191E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUUf8GPvKisQ7kNvwGYxWJh&_nc_oc=AdrgllEcBhH9LhmZ85hILU1tw6Weaf5hsxLmiciiQdv_2SxsCJw9qsX-CCdYVn1GvOc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZGfvbkq4GS4-qvAnKev4aRCBMWGdoRrh7WLu9wxMlXg&oe=6A302431"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-_Aofr3vzoQ7kNvwGbWiJ8&_nc_oc=AdrYl9PiCAQgY5o2AAiezu8gjAGqO3HGVLfIeRoEukhg0KgKGU2U2J8klhhKzZ02L68&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94ktds1WPsd_FwdrYrbO_SeL5ILlQiKWJH8uarL4yKYw&oe=6A300BA0"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8gV-vyl42oQ7kNvwGTfUqx&_nc_oc=AdqWqKD_7yrgZaedzZA230VJPGh7fYtJvBme0FNdzAUVdEPDNBcbUTMNLBE6StqXSHg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95y5YBuCuZW6Uv2AFff5QHfDshWxSeJXjZ4qf77n6hnQ&oe=6A3005B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
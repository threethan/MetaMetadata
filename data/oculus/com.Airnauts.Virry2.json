g?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z0CP5j0A4G8Q7kNvwE38pdG&_nc_oc=AdpLQZTP08r_A8eKO8z0KEv464lRGWE3jt8oC6YDD_ggsYfd_ZhM4GAV1KoSKa9Oi2c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XlOw3ztX7Byvr2i9UC4afB13GUE7rDW0WAWFkqlI78A&oe=6A1047F1"}, {"file_name": "migrated_image.png", "id": "231528434908924", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NYThe8oue4Q7kNvwEZN32q&_nc_oc=Adp9d4encQAqbb3ZscEtXEtxo-rtkOZL5xp1U4vD48iDemmHXO7fBgfa40pgfVXoVlY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IvWBpwtanMknrsL6hYxRv738SO6ust9E2BXmOI_HaLA&oe=6A1067A0"}, {"file_name": "migrated_image.png", "id": "212399816653872", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/11162682_1756596874645581_2822882841732317184_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-sWm0l2HyIQ7kNvwFwSGib&_nc_oc=Adr_nFfqxx7bvtT3wuqjBuEyNF8p97U1LBmDB2YZK_YL6VetZHehUAE6BpVBxsW8UCI&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZfV03JeONYKuCe_ciTrCMZ312igcJmw9FXB8WfgsKew&oe=6A105360"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11162731_874801452683124_8480571075237773312_n.png", "id": "1673110742720080", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/11162694_1673110746053413_890324910616870912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFz014zR-ncQ7kNvwHcgYPa&_nc_oc=AdqAPJkL_268Uhtcn0VymjOHvTwWctZoTk7dFZWkqkpJpG_HXyXFh6LRPYhdB_4h6P0&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Akg7at0UV6AfKBFz9VJxAuOk3aCSOHeIDXhTpZ6SD5A&oe=6A10598D"}, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fnt-resources.s3.amazonaws.com/docs/en/PrivacyPolicy.pdf", "developer_terms_of_service_url": "https://fnt-resources.s3.amazonaws.com/docs/en/ToS.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recomm
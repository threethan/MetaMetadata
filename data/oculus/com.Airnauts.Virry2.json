g&oe=69F35260"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApX9hxj3MpkQ7kNvwFmeGLN&_nc_oc=Adpdo5bHfy8EWyQtRkemknDrojksc7kQ4Y-MBotRwCOlxrIHqz0nyK_VyFUIoqVosJ0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2LBsn4Dmer7dsqLo64pvPff7FzygAJOY_HQVFEAyMYzg&oe=69F3741E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQSu7tn4Pn0Q7kNvwFPpyxy&_nc_oc=AdqNgOmjekpXgN6VeirG1OZuy6vsA7N7w8ZZPC-6_wQsDxHTHLNnu_MIADe_Guq_vdU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0gp2XuwS8hmH0yHSkyWsUbGdeCG2Y_CkjHvwXTyAfwyw&oe=69F346F1"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MArwj681jzEQ7kNvwG5sjAj&_nc_oc=AdppXeTPEhUtY9F54e5SWpt7G4R87QpFE0jTMkzyaCvHW3_5x_96yninCSbyU9uMBkc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1HecdUf1t8oaJ-qz24B1pHB80ydwnbr0QisrHl_2Dfsw&oe=69F366A0"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PUJ9NMaBs8cQ7kNvwFSG-rr&_nc_oc=Adq0l3xqxUzHmSKDX2AtUXDs233z7Wibg2J_ziq0CYWh6FDjI59RLv3xuOOHTeJSvBA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1mzUnYbyaaZ311f6HX6bRTl3nSTgHbrXT-QBCup9_M8g&oe=69F360B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
A&oe=6A2C02E0"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWMPDvGFnr8Q7kNvwH5aQ2F&_nc_oc=AdqygMpBgzqgy85PTYSLrjL-_Q3J92nrR5pnShDwZ9fOJ_sCyCGyxHCrCNkMuL_l4bg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9t1aPFv0URWqkNNwz5rD0Tyjp-9xjxwIAh_b721Nxycg&oe=6A2C249E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7YHnAL9r2YQ7kNvwGVIzEV&_nc_oc=Adp-litNXfSzsBjjk5eKmiLd3g4zCw-6xQR5mgr9wpMz--0Nk0tPkQ1pMIH3B09kl9k&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-c-oUjMsmAR44T0OXKFi7quXodDiIYWt0PMDz1dH2FjQ&oe=6A2C2FB1"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJsUra13hGoQ7kNvwFcs_4c&_nc_oc=AdoEnCYnlqreWHHqtJGX6W_hkxYO6Dwjt_ERE6jGepZR_EsmeDZiPACcQ9s1j0VUOsk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_px3M5xU-qd28EnhOZ7JDlCfIpNJPWa5O0fe5O1ZtmOg&oe=6A2C1720"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24_eu7tnY0cQ7kNvwHw9eLp&_nc_oc=Adp4PkcRch1atMx3MsdMwzKyMPn57734nyOiAZslkeR1RUNn4i-RfWrBlmFG3x1V3W8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BvwvuXiEcYTZwT6L4bbBb8hO-p1CDH5t2xxDtUgG3cQ&oe=6A2C1137"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
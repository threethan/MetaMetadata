g&oe=6A538FE0"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUAFrOcBjPIQ7kNvwHcskd3&_nc_oc=AdpUv3gS0ZN0wKvXx_XHF9dFH1XYqdMqmXY_w7Q-kThOGJTx40W6TGYUUhcD5JFaNz0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABZzNiyFCkZUwtjLM2qT9BUz7DBC_2SSEy_LMFLeq-nA&oe=6A53795E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-5nwIK9ySMQ7kNvwEd8ALG&_nc_oc=AdrDOS8KMdr0N6HexeTOrXOH6G-itQLO_5-a6wBR7FpVGE7oDgAew2wvlpLYlI1gUzU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7fCHGySkv8lG8D9DzD6kBhwGLSQiOTeYPmHUsO3k3iA&oe=6A538471"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5moz1qCUy4Q7kNvwF3AZdz&_nc_oc=AdreT_56DTMifT5o23SAcfsPKRX2eS3e1duxFPZeBxtzwMkHpmtOR2p86SDHHDEnDa4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJlXqqD04XfIt4bfhC_y_BIdf_seO_qh44nP_5yjVmkg&oe=6A53A420"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3Fl4XEgTDkQ7kNvwEq7gOL&_nc_oc=AdrRzV4YkzikWaoQ3167txcX-NvMACffmg8CoCPDhN8XH5w8-pN1LUO0XUb0ac5uVGM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCn_o1d7Tr1vzma07CUvn2-wpObukI3oPY0r3ERSipD5Q&oe=6A539E37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
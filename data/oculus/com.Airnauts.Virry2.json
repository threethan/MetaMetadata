g&oe=69E62360"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-0Ocn3J_gsQ7kNvwHhzHCj&_nc_oc=AdqKsxugfx420mh0wRF-1SL9i0yGduoEdyBkMuSuOohqRd07VTuR_2-0CVnq87XByPo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1e4zE-bDPWMrvtqH-CJkZG-VixGlARWPcgFIW14H7tNg&oe=69E6451E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MESe7FWU-L4Q7kNvwEhCpYS&_nc_oc=Adradp7tAPGvM-ClNIpkL481Hiopm9843AbKte31neO7YIZUcR5cv46HygvysIFF2QA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Ts16j8f_R3RY_vFJZySwzpxBNO5vLiKjdAq8NMSZItA&oe=69E617F1"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWB1sv46ZUQQ7kNvwE5-vMi&_nc_oc=AdoIwgJJSJnRHIrcQS5Lyrk7JHlZZr3VtWlUhrd88BqT8HaxmD9noWHpzmmMVJuFB5k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27Ul40DM67QPsGHdgkciJlfl_pG-cUS-BHzZx1rDx-YA&oe=69E637A0"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IVNwcapvx8Q7kNvwGjnkPn&_nc_oc=Ado9Gx-00iFr_HzEYnAbho5P6m4FdV3n0lBzxqDGcz472v52vBYfTT4ykaKcu8L1WDI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SkDCebuPLm8iVC0aIW5-TF2-rYLkXzMVvAsfOMZWQZw&oe=69E631B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
g&oe=6A5B78E0"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQQWov9zHUIQ7kNvwGW-YRd&_nc_oc=AdpJ6u1Oov_XWq_vylwRs8oYJ_sr4Fpq0-WD2SoPXQ2TMdUTDPCXMWeg4r5MNYfoldU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALsdFP54ay4L1VoO5aUkotYHAn3oL_c3k2YyehsYzt3A&oe=6A5B625E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyqXcqoyvqMQ7kNvwG8xKZb&_nc_oc=AdoIrdJ5xXKn_rW-0KYp6nqkJ7Mk7XLR_PhjKTLzQ5oYwjOOzGJuUm8uszK7dYinq-Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZnJt57t8A48s3DwT8E5NeY2r1rkhsXdiwshPITWq-1g&oe=6A5B6D71"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rua1YJ48hqUQ7kNvwFJMB2K&_nc_oc=AdqUJJ-KPB_Mi2cGdMkutNj7H2pM3py9ZjuMHKj2QMi1f3wzTYvFIT3NvCHd9R6AZxQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCb0lGtd53qPM_1pOr8lrbiGvoBAI8uDbdOEyDlD53ToA&oe=6A5B8D20"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWcY-spfFbsQ7kNvwFZO6Yw&_nc_oc=Adr_6s2rOIA3vhIDI78x0IuzFZJe-H7shw4asltRgrDqk3vqQuOkoZ1Uzt52soy0tYU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSl11VGD3oAs3evpH6Vav54sNtE489hJNbkhaernsxxA&oe=6A5B8737"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
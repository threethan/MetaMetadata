A&oe=6A69F960"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRvdf2L_0-0Q7kNvwEjV7zp&_nc_oc=AdqFpzHjIEBacmFUFkmgo_QT0it2Kp4YZEdr04XANuAk-r6XddR5AsyY1aH9J5CXfTY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1z1LzJwKB6u4AxI1exMS6gEX-AbehcrD1EQk_NiBbOQ&oe=6A69E2DE"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-_G4Z2i9lcQ7kNvwHkgl8Q&_nc_oc=Adp7f6Ug0YcVX-C7yZoYfAwsf6wrlVX9xqkVkyHHVie_OhxopY9Acze3MQlZExOEZD8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhOWt6bzWqaIIkR-a8Qxn0QWgk2Z5qIlcuB6KjIPItpA&oe=6A69EDF1"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efTJsZpIYNgQ7kNvwE0oXpS&_nc_oc=AdqXFl8t0C8Te_X3659u0nwbAkVrvJwSCSQM-bWmtno-JekzWehZOR5zw7vpNk-Rny0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIjdQpRoMofoVBJpBQGiaF8OTgnsELtPf7nvjWRr2Dgw&oe=6A6A0DA0"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhW55OkW3CkQ7kNvwFTxpjp&_nc_oc=AdpSa7G4bMkdeYJUigP9vxILRyzwS0BQuoiaDGXL7ZOTdBMBSROCwL8tyqydlEfWoaI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6yZxmnZ4vJTrXrrP1lJm4eIMwVY_xMaeMht_xNmpPjQ&oe=6A6A07B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
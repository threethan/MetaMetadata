g?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQGNDEnVkagQ7kNvwHAjcKq&_nc_oc=AdrhLTBH8jiXvnWX0USFTpohKF0MfJLOP0yWAYy2wyAePngG4xjau57WiJT1sN6HxRo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJL9V_CDImlzWBPxEzKEWS2QEPzRk9yKXRbv3CAu3ZC2w&oe=6A9FFB71"}, {"file_name": "migrated_image.png", "id": "231528434908924", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeCEJ4YWLl0Q7kNvwEm7VM4&_nc_oc=Adp2eLTgPX2_BSoBSi2Oru1ASBsy1HktA3gfwO45KOFhVz8LBZ4U_cetbeR1pDwqfBg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLn3UrEx_TbJPs6_gkWsVZzrfoOn3TifDlKjzdSHyTkuw&oe=6AA01B20"}, {"file_name": "migrated_image.png", "id": "212399816653872", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162682_1756596874645581_2822882841732317184_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NggavElt79kQ7kNvwEIMWcj&_nc_oc=AdrJjDFzbw5n6x54KUD75UpaJZxhGbkbHbd5ryYDXJ_YK-zGuS8yKpOOsisAzw5Q9Dk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJl0lTs_R47O9ITgeR9IeztaLUNaZZsB8OyhE3oGCw-wg&oe=6AA006E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11162731_874801452683124_8480571075237773312_n.png", "id": "1673110742720080", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162694_1673110746053413_890324910616870912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KA1jlz8VxAMQ7kNvwGxSraf&_nc_oc=AdqJnlpjWnR4X_yybGMF56boH6etrA2pmgW59jgLS920Pk9dgRAZNdj2ZrGXVLLMkIc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKG3xOg709U-OnljLGrX5r3PXGPBr2uXGtBxD0oUaW2IA&oe=6AA00D0D"}, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fnt-resources.s3.amazonaws.com/docs/en/PrivacyPolicy.pdf", "developer_terms_of_service_url": "https://fnt-resources.s3.amazonaws.com/docs/en/ToS.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recomm
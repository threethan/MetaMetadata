A&oe=69D7A2E0"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97JCzM9I1sUQ7kNvwFX4DGo&_nc_oc=Adoexa6Jm1JMF-Rvf7sZzqlY-GmnOFTBWVsvL6MEWW7RIcFxCVHVar89qkM_esrp2GA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0z8sBVbGwrmASVk2QvfSXwuve1Kiai4HhVS6HsOrZ0tw&oe=69D78C5E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hdSQIAJgSkQ7kNvwFL7DV8&_nc_oc=AdpAIacYn_xX-kHsJC2iDAuLk-UsWv0lPiPIFesR_8uN8WsSjgppCOy8TsSlO9pLAfs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af266TEJYAypMKZ9KT2fzN-uAtDmo4oSTm9vrWawrgbHXw&oe=69D79771"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6MnPfzTs60Q7kNvwHLo4fw&_nc_oc=AdpRdSKPyXLmgi8lReOokG0bHujmYS08vUuLbhiXzYgT1QWtqiUOLfIgPvkxmq8Q47c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2f5LxZljRKM8hj1nOaqLnMMuivHTZMeL0XwR7KgFr_eA&oe=69D7B720"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6g2QhyBYbIQ7kNvwFSpCzq&_nc_oc=Adpv51OpjjLnN8qrRcMVvjC2pX0stQC2BZjbpprit71pdoju2xaTrO0lmSnD1ZJ1J84&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Gz_q2UbpecptBhLi0EbEL6_-czfJVn9LO5At1pXFfbg&oe=69D7B137"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
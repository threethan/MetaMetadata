g&oe=6A09BBE0"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaSVZFQniXUQ7kNvwHD7b38&_nc_oc=AdrNqlbRyZYLeLyEoKgVFueycn-8UXOZPZtjv5YbxDxKd2sf2l_9QUFGoFTdKHkWwuo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5g2Up--Vi6yR5fCMwuzTdhkDgMcBe71Nk75OZSuYK1BQ&oe=6A09DD9E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfkJNpovdXgQ7kNvwHtSjhf&_nc_oc=AdokG1NO8qwkSJg5kXDP8pts-WkY_fc3hQf7HnUvxMkGHG9IguwVUOKzFW-inWkVnD4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CLiSyjV8xrK_3jAmOgOaYGjhupbia12wD3kDPB1UPCw&oe=6A09B071"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ou4rIUByuoAQ7kNvwEuCtfU&_nc_oc=AdoHAuyHV_JXKQbcW_nFmuAZQQjpqWTZUL1eQnFP1U_QWCZxhTnuFBc_y18sE5yeqs8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MqaUorevbA0P2bAR3Ix0sFE4ApbhK7ettQ48QjwO8HQ&oe=6A09D020"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WTxN-FSj3QQ7kNvwEfSlpY&_nc_oc=Adrq9VzPIBs4mWAI5yW4Id6hQPhqaMRJflznCVosuHv3v9rYCf5p0hDPr7vQqN8p2Ys&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WdT7O00tZuPXoQvyzgDtNpwEDf1Dva_1Xyl-hRFNwhw&oe=6A09CA37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
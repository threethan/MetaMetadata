Q&oe=6A0F01E0"}, {"file_name": "migrated_image.png", "id": "1093925997624324", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162731_874801452683124_8480571075237773312_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ob8AMJd9otgQ7kNvwHPCBre&_nc_oc=AdoQVo-shlarF_ix7_J9JLGfkvZZRD2MaHUZ7VeTTF2Zk3daxs5mrvN0HSN9LW74dUE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-35iIy2DM_ls_vYE6ZsnT7rzozkaFBSVXGIvlc6PUow&oe=6A0F239E"}, {"file_name": "migrated_image.png", "id": "629282697636407", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162716_380404315735500_5291713739500814336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huVTXSm61ssQ7kNvwFbpDoy&_nc_oc=Adr3LiK-8NzSVRfvJ8STv-H6X5yYS2Cdpmt09g_jTVtCRwfZqkizbYwOZQPYgFFfhfc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PV2SrqsoyZfZBoHyyD9dyfvbkLU_LMczGIujxxs7ThQ&oe=6A0EF671"}, {"file_name": "migrated_image.png", "id": "560680867900901", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162731_732867726913630_7537884319939821568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NYThe8oue4Q7kNvwEnmS2y&_nc_oc=AdpQh4xTV5K9sTUIFEEOuhpxy3VfON_SLJ1YSm8JIAPoy6_H_otR2aP8TRz7uyLG-xA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TyolfBK6aH5k50LO89XNxQ7N9oAu7JjGmlvWGeVZ3wg&oe=6A0F1620"}, {"file_name": "migrated_image.png", "id": "212572443294818", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162702_535138243506084_3780100076983025664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULvtL252nkQQ7kNvwF6vFZj&_nc_oc=AdozDAxbvFVuis6yDpGLztU9wgEBVeVf23z13-oohLYWFGWnMvzvroafRNz1u9o1_lE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4N4nWNC99M2-j82ZhNiuz-pwou8-Weutbl6Xq3PnMvSQ&oe=6A0F1037"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virry Safari 2: Feel the Wild", "keywords": ["animals", "video", "kids", "lion", "best"], "long_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!\n\n\u201cI have seen thousands of spherical videos, and the footage from Virry VR is the most stunning nature scenes I have ever seen in any medium. Seeing a big rhino, in its natural home, from the perspective of a mud puddle inches away, or having a lion literally lick my face to test if I am edible, were among the coolest things I have done in VR to date.\u201d\nJeremy Bailenson, Founding Director of The Virtual Human Interaction Lab, Stanford University.", "short_description": "Winner of the Webby Award 2017 in \u2018VR: Gaming, Interactive, or Real-time\u2019. Virry VR is a virtual safari filmed in 4K VR at Lewa Wildlife Conservancy, Kenyan home of the most endangered African megafauna: Black and White Rhinos, Lions and African elephants. \n35 min of 8 live-action interactive experiences, where you are really up close while feeding and communicating with wild animals: Zebras, Vervets, Hyena and Leopard, in addition to the ones mentioned above. Also 3 live cameras!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virryapp.s3.amazonaws.com/docs/en/privacy.pdf", "developer_terms_of_service_url": "https://virryapp.s3.amazonaws.com/docs/en/tos-vr.pdf", "publisher_name": "Fountain Digital Labs", "support_website_url": null, "website_url": "http://virryvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "h
35359_345078206568883_8386195063946279640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aeAl7fXH96MQ7kNvwG0J5ai&_nc_oc=Adrb71poCtqozumJ8VTvrcDy0Mil0S8lcYtMlr6SjI9Q585fC-7teDBUo8XoEYJxWdY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1oiliLNkgYRrWHO9pA-Eg_1JBQCSw6f-46c1g183eyw&oe=6AEB3329"}, {"file_name": "screen2_mission12_2560.png", "id": "888334875260183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982454_888334878593516_2093846533105182733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12pHFatKjysQ7kNvwFN6jpH&_nc_oc=AdozuSDsMG6Qt4-zrnga5cSbqWb_6KUy2RQhj1Z6RLikuVo1sUrpBkS1PtQd8CSIhaQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR55HnnlMpepowjJOmrAc_Rllzt6PJmjktOmW0j70GGgw&oe=6AEB3D59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen4_race13_2560.png", "id": "1050148602134132", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982489_1050148605467465_803055973551672733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHFHQk_dDMkQ7kNvwHXMEyh&_nc_oc=AdpxBw7v2mvANGft64kdUriL1klNDufitVmaO-_PNYKCrfl6dBlpe1U8p5aZzdTNHBw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeCDA-Xp0-AaRyal8_GWgQ7egtC57mafQGd5GCV7gvrA&oe=6AEB5140"}, "display_name": "Galaxy Forces VR", "keywords": [], "long_description": "A single player space shooter game. You are in control of a ship and the goal is to race against the clock to get the fastest time (race), or transport cargo to get the best score (mission). All done in a narrow space cave filled with evil enemies. Featuring interactive music, realistic physics and challenging game-play.\n\nThere are 55 official levels and 16 user created missions. The replay of the record scores are possible to view from the game for others to see how it was done. There are also 21 achievements to unlock.", "short_description": "A single player space cave shooter game. You are in control of a ship and the goal is to race against the clock to get the fastest time (race), or transport cargo to get the best score (mission). All to the tunes of interactive music.\n\nThere are 55 levels and 16 user created levels with evil enemies. The replay of the record scores are possible to view from the game for others to see how it was done."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.galaxy-forces-vr.com/privacy.php", "developer_terms_of_service_url": null, "publisher_name": "Ronnie Hedlund", "support_website_url": null, "website_url": "https://www.galaxy-forces-vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2111944408964520"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "463494048022774"}]}, "baseline_offer": {"id": "463494048022774"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1615570620, "status": "PUBLISHED", "id": "463494048022774"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7923659127644869", "version": "2.04"}, "id": "3759651194081404", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4116487761695377", "
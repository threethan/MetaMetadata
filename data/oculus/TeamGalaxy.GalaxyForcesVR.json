ission24_2560.png", "id": "784368408829457", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974448_784368412162790_6308387936049353523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbpqXmQ365gQ7kNvwE9o24q&_nc_oc=AdqVuq10nVyA6IMCdk9OpVO1KNIN5T3VVD8U-QxzcaQqpIleLsUbyhEmlDukw9yB6_8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KqS0a6vEj-xVQx0ZgtnYgOpYTS06w8Z0xO_X0DNDzpw&oe=69F9EA54"}, {"file_name": "screen1_mission09_2560.png", "id": "345078203235550", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035359_345078206568883_8386195063946279640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWHafopqpOwQ7kNvwGFhJ_e&_nc_oc=Adp-ly436y6Idh-L2tR0KrELV7InI7_5rQHSUz72olqE6CaLje4RVDcfIb584TZOzoc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mUcI4Vvq2M_m3kWS-6q16RMOzn9IPqsg4b2uWsMSUkA&oe=69F9F0A9"}, {"file_name": "screen2_mission12_2560.png", "id": "888334875260183", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982454_888334878593516_2093846533105182733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5837l8MhTqEQ7kNvwHHLOvx&_nc_oc=AdpbtdoCCVO2xgT0rAPJIbbk9PLIa4kycRCs7prXh-GFGbxfrPIYLDoNQrvsi3Y_Wx0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rVctKHONDSh_HXewzt9SQhTjalbOi_86WkgMl4LwD5g&oe=69F9FAD9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen4_race13_2560.png", "id": "1050148602134132", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982489_1050148605467465_803055973551672733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_cOpC5ZsR0Q7kNvwGbQik-&_nc_oc=AdpVfkjvOpkvFuRFxMqUPeid6Knkh8hL-H1OcqW8gBZ6rni3r9CwdwPDvKSuKkFLsfs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WaMbDh_1_jax-vz18Yxdz4BM7ZX_KxXZW1fPisEW0xQ&oe=69FA0EC0"}, "display_name": "Galaxy Forces VR", "keywords": [], "long_description": "A single player space shooter game. You are in control of a ship and the goal is to race against the clock to get the fastest time (race), or transport cargo to get the best score (mission). All done in a narrow space cave filled with evil enemies. Featuring interactive music, realistic physics and challenging game-play.\n\nThere are 55 official levels and 40 user created missions. The replay of the record scores are possible to view from the game for others to see how it was done. There are also 22 achievements to unlock.", "short_description": "A single player space cave shooter game. You are in control of a ship and the goal is to race against the clock to get the fastest time (race), or transport cargo to get the best score (mission). All to the tunes of interactive music.\n\nThere are 55 levels and 16 user created levels with evil enemies. The replay of the record scores are possible to view from the game for others to see how it was done."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.galaxy-forces-vr.com/privacy.php", "developer_terms_of_service_url": null, "publisher_name": "Ronnie Hedlund", "support_website_url": null, "website_url": "https://www.galaxy-forces-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9166786409998795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031359_43219390325607
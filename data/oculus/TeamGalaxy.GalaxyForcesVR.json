ission24_2560.png", "id": "784368408829457", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974448_784368412162790_6308387936049353523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2i8OAk9dQGkQ7kNvwEuDfdV&_nc_oc=Adog6rqBzWMGdM5lY-WnxTpOh_PVVBVLUBqkEFaOytpU8NNnP3dnXaAAC-IqWk9Q3k8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dUey2zFDxEGmx_5tJkJVQb6_YoP8WJB10V6tGtUt6XQ&oe=6A0B0DD4"}, {"file_name": "screen1_mission09_2560.png", "id": "345078203235550", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035359_345078206568883_8386195063946279640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IB3MpBJlZUIQ7kNvwGBRM9r&_nc_oc=Adoe-sizqwBMRewIWkn60Q_MEkR_A4xGm-mFFfDmnOtR6R6TEOD3AYDW97ur870y4q4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CFK2aglHfvM80V8dMWY6VTnkEz_Rs3Hy4pK5lAJi74g&oe=6A0B1429"}, {"file_name": "screen2_mission12_2560.png", "id": "888334875260183", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982454_888334878593516_2093846533105182733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrRdZWlrzbMQ7kNvwEE7ARR&_nc_oc=AdoiQKL3QRMzpye-6NQmqkYFIfR6tuCC6xjFT-OJQ95QVgaF7L6Fn_XPC53AOuvYM1Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zTVt3hhzbDrzJsnN1iYP_URmBdk1x6rwyPWLeSiTerA&oe=6A0B1E59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen4_race13_2560.png", "id": "1050148602134132", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982489_1050148605467465_803055973551672733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmiqK-Zpbg8Q7kNvwG_21-F&_nc_oc=Adq-d6UvgVwULG-Ra86n8asvfHjDqEkTfKA9qpiyyf2acZUSZ6THdWQ_IJBuyvganPk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7w7FMoN-isw6S7hHdUATHmYOSa3LpqgjXrIA11SVwIKA&oe=6A0B3240"}, "display_name": "Galaxy Forces VR", "keywords": [], "long_description": "A single player space shooter game. You are in control of a ship and the goal is to race against the clock to get the fastest time (race), or transport cargo to get the best score (mission). All done in a narrow space cave filled with evil enemies. Featuring interactive music, realistic physics and challenging game-play.\n\nThere are 55 official levels and 40 user created missions. The replay of the record scores are possible to view from the game for others to see how it was done. There are also 22 achievements to unlock.", "short_description": "A single player space cave shooter game. You are in control of a ship and the goal is to race against the clock to get the fastest time (race), or transport cargo to get the best score (mission). All to the tunes of interactive music.\n\nThere are 55 levels and 16 user created levels with evil enemies. The replay of the record scores are possible to view from the game for others to see how it was done."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.galaxy-forces-vr.com/privacy.php", "developer_terms_of_service_url": null, "publisher_name": "Ronnie Hedlund", "support_website_url": null, "website_url": "https://www.galaxy-forces-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9166786409998795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031359_43219390325607
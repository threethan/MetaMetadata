k to get the fastest time (race), or transport cargo to get the best score (mission). All to the tunes of interactive music.\n\nThere are 55 levels and 16 user created levels with evil enemies. The replay of the record scores are possible to view from the game for others to see how it was done."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.galaxy-forces-vr.com/privacy.php", "developer_terms_of_service_url": null, "publisher_name": "Ronnie Hedlund", "support_website_url": null, "website_url": "https://www.galaxy-forces-vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2111944408964520"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "463494048022774"}]}, "baseline_offer": {"id": "463494048022774"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1615570620, "status": "PUBLISHED", "id": "463494048022774"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7923659127644869", "version": "2.04"}, "id": "3759651194081404", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4116487761695377", "
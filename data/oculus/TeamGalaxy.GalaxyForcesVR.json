ission24_2560.png", "id": "784368408829457", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974448_784368412162790_6308387936049353523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFc5E32etEMQ7kNvwE7RGJr&_nc_oc=Adp6ElqeF0g0sVRBbE-WVBExs1l-TRwPkTSUDzTXFoFn_2VrafwtP3fOoW5QbZc16jg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_6nUrGHqf4-D22inBMFhNNxmpZy_fY0efpkMUFwo7Tw&oe=6A1D82D4"}, {"file_name": "screen1_mission09_2560.png", "id": "345078203235550", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035359_345078206568883_8386195063946279640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9QIPP66Jk0Q7kNvwHrvs-9&_nc_oc=AdoIJ2TuJxM7t2AXv6jsjfIc68VXoss8WsbGJcQ5te9rGhMM7tcLUZjgKZk4XHmGTrw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mpm0bQkfLDDgJncK0Z5WDoxjuy2HwC5Dil6tE7zBUKw&oe=6A1D8929"}, {"file_name": "screen2_mission12_2560.png", "id": "888334875260183", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982454_888334878593516_2093846533105182733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5TUkQiKY9AQ7kNvwFXhc_u&_nc_oc=AdoTMCQPtWd4rADVR4ccVGcbsYD7g-EyfZLfRvQybldwLb_AHLqnefO7vnuk1MapJRk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5e6z_AwvvUPkuXor06kZD2z8d8_XqpQhT_MgrRwn_DBg&oe=6A1D9359"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen4_race13_2560.png", "id": "1050148602134132", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982489_1050148605467465_803055973551672733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oydCa5ttI2wQ7kNvwFcJEDT&_nc_oc=AdqxMY7Bf0RbwlviPbcolfl1U2N3lPr-A7A_2wQucp3DPpE5TAAuDUsouZ__Ss74YaM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IuBrBd-7YAHCQZZo_YczqA68tfpbWsK5Mf3FAQfODvA&oe=6A1DA740"}, "display_name": "Galaxy Forces VR", "keywords": [], "long_description": "A single player space shooter game. You are in control of a ship and the goal is to race against the clock to get the fastest time (race), or transport cargo to get the best score (mission). All done in a narrow space cave filled with evil enemies. Featuring interactive music, realistic physics and challenging game-play.\n\nThere are 55 official levels and 40 user created missions. The replay of the record scores are possible to view from the game for others to see how it was done. There are also 22 achievements to unlock.", "short_description": "A single player space cave shooter game. You are in control of a ship and the goal is to race against the clock to get the fastest time (race), or transport cargo to get the best score (mission). All to the tunes of interactive music.\n\nThere are 55 levels and 16 user created levels with evil enemies. The replay of the record scores are possible to view from the game for others to see how it was done."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.galaxy-forces-vr.com/privacy.php", "developer_terms_of_service_url": null, "publisher_name": "Ronnie Hedlund", "support_website_url": null, "website_url": "https://www.galaxy-forces-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9166786409998795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031359_43219390325607
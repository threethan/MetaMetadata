368412162790_6308387936049353523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjYluQh4WUQQ7kNvwE6fEdC&_nc_oc=AdkZZcrtqIFPtsFfsj1rCqJ8gequFDLntv-nSeqUWABQpc_fex0TTbWl7Kp4Xs7p4UE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afval-XLNmAyZKUIuzOL-nRqANNuWoBt-OPpLtKPkraQJg&oe=6999ACD4"}, {"file_name": "screen1_mission09_2560.png", "id": "345078203235550", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035359_345078206568883_8386195063946279640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zvDqC3ZFDwQ7kNvwE5e5Bp&_nc_oc=AdnRemJ8BjBTRZ-ckR2e22EiNS6an2qNjqen5NUe12sk1e-c5qN-aIXNWYHJvrFrfaM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftuhkDwxOR7EiKvCB01Lg1sm6mNjK5r8BBM4p6s3VClGQ&oe=6999B329"}, {"file_name": "screen2_mission12_2560.png", "id": "888334875260183", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982454_888334878593516_2093846533105182733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTJDtbMT8lgQ7kNvwE-1igs&_nc_oc=AdkRSx40DgW4Fa64Er5XJuIA909PBzrlU-IZNol2POZFAOBYD5utD5P0K1Bi0owAAF8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftEnip89e2_KQ0ItznZUkekDkBxU2pa-hdP-3FPjwmrnQ&oe=6999BD59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen4_race13_2560.png", "id": "1050148602134132", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982489_1050148605467465_803055973551672733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtVG5YYI7YEQ7kNvwFfEDTI&_nc_oc=AdmOY3SJy6OPYv26oJD_Autag-zo_hFq5-yj6Lju77gt_Mh06Cg4IpFliMftSo58z-k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu-6k9bg1aF0oKAOZWOUZg1GBwXRP5vltKqwjrqkXSdhQ&oe=69999900"}, "display_name": "Galaxy Forces VR", "keywords": [], "long_description": "A single player space shooter game. You are in control of a ship and the goal is to race against the clock to get the fastest time (race), or transport cargo to get the best score (mission). All done in a narrow space cave filled with evil enemies. Featuring interactive music, realistic physics and challenging game-play.\n\nThere are 55 official levels and 40 user created missions. The replay of the record scores are possible to view from the game for others to see how it was done. There are also 22 achievements to unlock.", "short_description": "A single player space cave shooter game. You are in control of a ship and the goal is to race against the clock to get the fastest time (race), or transport cargo to get the best score (mission). All to the tunes of interactive music.\n\nThere are 55 levels and 16 user created levels with evil enemies. The replay of the record scores are possible to view from the game for others to see how it was done."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.galaxy-forces-vr.com/privacy.php", "developer_terms_of_service_url": null, "publisher_name": "Ronnie Hedlund", "support_website_url": null, "website_url": "https://www.galaxy-forces-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9166786409998795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031359_432193903256070_3368987012200827330_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=381-WlUkv6gQ7kNvwGsc_Xy&_nc_oc=AdnkLl58toNOz2N_YLL4SAjE8H8N29RCZ1FCKmZe6DzLv-
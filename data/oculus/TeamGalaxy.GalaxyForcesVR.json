ission24_2560.png", "id": "784368408829457", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974448_784368412162790_6308387936049353523_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1tJQwyUjIwQ7kNvwG5mHJ_&_nc_oc=Ado1cRsEVRRzBrTyXYRyHNubEPCkjvAdEMoOYDNp8n2aPsxcwvs0pSLtlXK4ETn7OSE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uEduVV_6skkWtV_l-cXEz4gGFkYCAkgztRUl5XAV7hQ&oe=6A01D354"}, {"file_name": "screen1_mission09_2560.png", "id": "345078203235550", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035359_345078206568883_8386195063946279640_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQjwvWOXI_IQ7kNvwEXffhi&_nc_oc=Adog9S-WOS8fUiqUzPn7hvEXKX_v3BbOFEvxFCJz4hfPTZhqUduHQmrbx1qjlaEjwXY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FfrEJmkz2RZcJ44qx2nuyEsu4DfyFd8hyNb-SZd1c-A&oe=6A01D9A9"}, {"file_name": "screen2_mission12_2560.png", "id": "888334875260183", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982454_888334878593516_2093846533105182733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwxL9_XbrMAQ7kNvwGHeBYp&_nc_oc=AdpihWk06v0uE_R9IRFJh0mYJLJ6AS12Dd3dlkCvmazqhGCBnCZb-6tCDtQwT-_B5Sc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qaOFaMF7Gqxim4oRti6ZCf16Gvh9gTycdBIltWQNrsw&oe=6A01E3D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen4_race13_2560.png", "id": "1050148602134132", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982489_1050148605467465_803055973551672733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkP4-XqPnXUQ7kNvwGoiQ7-&_nc_oc=AdoMlWdObB04qTG-phlSZSsyf7cTceQngoZaYLNLCvwvZ0M0wDx5MNIr5zddjrEmQNs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58_Fo0LA6xhNlaDAtTVccn5J7b0gO9VhMBLMYLHzOdJw&oe=6A01F7C0"}, "display_name": "Galaxy Forces VR", "keywords": [], "long_description": "A single player space shooter game. You are in control of a ship and the goal is to race against the clock to get the fastest time (race), or transport cargo to get the best score (mission). All done in a narrow space cave filled with evil enemies. Featuring interactive music, realistic physics and challenging game-play.\n\nThere are 55 official levels and 40 user created missions. The replay of the record scores are possible to view from the game for others to see how it was done. There are also 22 achievements to unlock.", "short_description": "A single player space cave shooter game. You are in control of a ship and the goal is to race against the clock to get the fastest time (race), or transport cargo to get the best score (mission). All to the tunes of interactive music.\n\nThere are 55 levels and 16 user created levels with evil enemies. The replay of the record scores are possible to view from the game for others to see how it was done."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.galaxy-forces-vr.com/privacy.php", "developer_terms_of_service_url": null, "publisher_name": "Ronnie Hedlund", "support_website_url": null, "website_url": "https://www.galaxy-forces-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9166786409998795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031359_43219390325607
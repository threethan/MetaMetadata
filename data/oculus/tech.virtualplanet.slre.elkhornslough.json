t-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Suh3lqq_cQn3KHJ2mNY-5Panom3IajkGsFmtlOCpjjw&oe=6A01DB5A"}, {"file_name": "SalaPreview7.png", "id": "506327870768257", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982479_506327874101590_3108931530994846245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBab3tZKyq4Q7kNvwFxztwv&_nc_oc=AdrU46H_QBNCTYm8lPeZEy6XFk5ELkgS83ZsUzGfQpNZYmT9JCwFo3dj67eXK2Fq_30&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ryELSbHln9i4WnTDRxv2qR1YKuml4JF2zLg5E8UTDdw&oe=6A01D6ED"}, {"file_name": "image2_0000.png", "id": "249660776647945", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974530_249660779981278_4846060883642225125_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgYpw_mIKZ8Q7kNvwF4UIa6&_nc_oc=Adoyqgkhy0q5KhsfWIMaIUmwlPuiXsKgTulabvJ9QqoYe-7zuf-s5paKoedkN_wRYlI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7d54ZV0poWz2PKpZZfyIiezx7q162OQOGvQWmtI2rKPw&oe=6A01E102"}, {"file_name": "image_0000.png", "id": "206501804559410", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974789_206501807892743_2947229683003218598_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJvP0yyqwCQQ7kNvwFasWoR&_nc_oc=AdrG3ohx5gahcglBjuvRJSeddpYi52Y5lTGoAe8IaaoqsKQM_SKG8kSirGOdJ0DuKlg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5g0HQwS_kaVbvZjLdIdFu_wYxmuuWTNNlWI86x1VQUnA&oe=6A01E037"}, {"file_name": "image3_0000.png", "id": "126672796011141", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031562_126672799344474_5418908412698774453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6G2RnoSKhkQ7kNvwFqQBiJ&_nc_oc=AdoOdMj0Z8XunPbdr08_iN16cpBUF_ddnqgU7hacvX_HgEWo37v5HhBhmziCzBoFqQY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eWxRN4g9RLp9z_jRpkUM38Q218RKjLIdW23vEunry2Q&oe=6A01C837"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sea Level Rise Explorer: Turner Station", "keywords": [], "long_description": "As coastal communities contend with sea level rise, coastal erosion, and other impacts of climate change, public education has become a critical piece of the puzzle., Virtual Planet Technologies produces highly creative and insightful experiences VR experiences that communities can use to better understand the impacts of climate change and explore emerging adaptation solutions. Our team has a range of expertise from climate scientists, city planners, communications experts, filmmakers, 3D animators, and Unity (software) developers. In our Sea Level Rise Explorer, users interact with 3D models and can raise sea levels to observe potential flooding in real time. Adaptation scenarios can also be displayed.", "short_description": "Virtual Planet\u2019s Sea Level Rise Explorer is a virtual reality experience that communities around the world can use to visualize the impacts from sea level rise and explore adaptation scenarios. Through powerful immersive digital experiences, our aim is to educate, drive action and inspire hope in the future of our planet. Our team has a range of expertise from climate scientists to digital artists and Unity developers."}]}, "developer_name": "Virtual Planet Technologies LLC", "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Planet Technologies LLC", "support_website_url": "https://www.virtualplanet.tech/", "website_url": "https://www.virtualplanet.tech/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EDUCATIONAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, 
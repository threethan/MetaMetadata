t-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KjnCTL77AqzndhIwkJ9zbl3GYK3UIQ6mfVfOC1thg3g&oe=6A07215A"}, {"file_name": "SalaPreview7.png", "id": "506327870768257", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982479_506327874101590_3108931530994846245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E36LXR23jJgQ7kNvwH1Tdr3&_nc_oc=Adr8CjuyancrIUMpQEuwCycwJ_-eZv8jQIduh7mObJl6O2wq07HfKVjE6dHgJqf2HdA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Vgn-OEUldZZC5muNXl98apls0HTcwooccvZD3w8IB2A&oe=6A071CED"}, {"file_name": "image2_0000.png", "id": "249660776647945", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974530_249660779981278_4846060883642225125_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYUWUVTeyq4Q7kNvwFha-0p&_nc_oc=Adp1wpzoZV9e1FpfFP3c3jKTqznLwsPbYV6NRCfbl2zem2PheyWvTxoZnmGJy7LmjS0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aSZrAgCtLjx3ooyBshhWUxGDu6kO8ZDHz8aObvCrijw&oe=6A072702"}, {"file_name": "image_0000.png", "id": "206501804559410", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974789_206501807892743_2947229683003218598_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1CFM0HIYnMQ7kNvwEKwBtK&_nc_oc=Adoc3FPozEiS1ce5JilURhzYJJCfcaV5lU1j6oz6qy9B6i_Slh4AWGYsdt643aiTqfI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ij2QUTjY5AjWx4-JJ1RM4Va0U8h16etZtJNWw4Iv7LQ&oe=6A072637"}, {"file_name": "image3_0000.png", "id": "126672796011141", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031562_126672799344474_5418908412698774453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vc7ui0uqypEQ7kNvwG0kNwD&_nc_oc=AdoJVLJ3wcvjZWLBD_XnldzTgvVkYRtLyOSddPxNAEQeM0gKEV4yuImmrf9vx9Xuj1A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ptCuEwhrIpjT7dsNDwe2zfuLhVX3WBepcTnSanogQCQ&oe=6A070E37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sea Level Rise Explorer: Turner Station", "keywords": [], "long_description": "As coastal communities contend with sea level rise, coastal erosion, and other impacts of climate change, public education has become a critical piece of the puzzle., Virtual Planet Technologies produces highly creative and insightful experiences VR experiences that communities can use to better understand the impacts of climate change and explore emerging adaptation solutions. Our team has a range of expertise from climate scientists, city planners, communications experts, filmmakers, 3D animators, and Unity (software) developers. In our Sea Level Rise Explorer, users interact with 3D models and can raise sea levels to observe potential flooding in real time. Adaptation scenarios can also be displayed.", "short_description": "Virtual Planet\u2019s Sea Level Rise Explorer is a virtual reality experience that communities around the world can use to visualize the impacts from sea level rise and explore adaptation scenarios. Through powerful immersive digital experiences, our aim is to educate, drive action and inspire hope in the future of our planet. Our team has a range of expertise from climate scientists to digital artists and Unity developers."}]}, "developer_name": "Virtual Planet Technologies LLC", "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Planet Technologies LLC", "support_website_url": "https://www.virtualplanet.tech/", "website_url": "https://www.virtualplanet.tech/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EDUCATIONAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, 
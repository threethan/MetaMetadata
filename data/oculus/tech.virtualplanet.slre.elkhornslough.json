luscdn.com&_nc_ss=7f20f&oh=00_Af9BAagkYQ4S7eyYfnnkyUO1qjv0RQxMcnfRCObhmwBGGg&oe=6A3692ED"}, {"file_name": "image2_0000.png", "id": "249660776647945", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974530_249660779981278_4846060883642225125_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-okMNROR_gQ7kNvwGNihTt&_nc_oc=AdqTaVRf4QtltSRZqn3uQVthR6rfl6qK_eRrNSqJvuh_7ssg02BrAdlUYiOk_VFUO1c&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_38ypRsOfmsXcxra8rI6r_NLEvkBtePcnV2py6SbUJNg&oe=6A369D02"}, {"file_name": "image_0000.png", "id": "206501804559410", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974789_206501807892743_2947229683003218598_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_RR5oJv0VTwQ7kNvwG_EAF5&_nc_oc=AdrqWLGEEEeM0deeq0NNCCmCGrpLYCprkYHBPMFKrq11tTsKDQsqZSCffk-bLYCZI2c&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zSByDA3ympLXaLp76XWmznRJfqAKd3k4vYAK1kRwtzw&oe=6A369C37"}, {"file_name": "image3_0000.png", "id": "126672796011141", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031562_126672799344474_5418908412698774453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btmW3ZQN62QQ7kNvwFVKnzK&_nc_oc=Ado7LsLWnshLhObi4F1s7XQCnA_RBB_8DN9l-9ZWtINRltAhfEdGvBZYgun7eEom9vk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85GIIH1FrbJGOi3QicE69MRgMMvykG33tQOq_aJDbhXg&oe=6A36BC77"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sea Level Rise Explorer: Turner Station", "keywords": [], "long_description": "As coastal communities contend with sea level rise, coastal erosion, and other impacts of climate change, public education has become a critical piece of the puzzle., Virtual Planet Technologies produces highly creative and insightful experiences VR experiences that communities can use to better understand the impacts of climate change and explore emerging adaptation solutions. Our team has a range of expertise from climate scientists, city planners, communications experts, filmmakers, 3D animators, and Unity (software) developers. In our Sea Level Rise Explorer, users interact with 3D models and can raise sea levels to observe potential flooding in real time. Adaptation scenarios can also be displayed.", "short_description": "Virtual Planet\u2019s Sea Level Rise Explorer is a virtual reality experience that communities around the world can use to visualize the impacts from sea level rise and explore adaptation scenarios. Through powerful immersive digital experiences, our aim is to educate, drive action and inspire hope in the future of our planet. Our team has a range of expertise from climate scientists to digital artists and Unity developers."}]}, "developer_name": "Virtual Planet Technologies LLC", "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Planet Technologies LLC", "support_website_url": "https://www.virtualplanet.tech/", "website_url": "https://www.virtualplanet.tech/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EDUCATIONAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD_VIA_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1057110991522970"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4331745840217761"}]}, "baseline_offer": {"id": "4331745840217761"}, "is_
dn.com&_nc_ss=7f20f&oh=00_AQF-GW4kydM0ag83g_dis23JBxFOzatt6CUIAPkC--nMgw&oe=6A8EE76D"}, {"file_name": "image2_0000.png", "id": "249660776647945", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974530_249660779981278_4846060883642225125_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IA0eGefhFSUQ7kNvwGNeYO-&_nc_oc=Adpt0IBVV5EndGzMQlIts6qSZ6h8ea2d8lKVu4B9zA6r5ekIeUzusApFPZh4BSXwoP4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSer_i79RCmGnNAYE58YTaSqrr-Lluq6ReDzcsx68B4A&oe=6A8EF182"}, {"file_name": "image_0000.png", "id": "206501804559410", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974789_206501807892743_2947229683003218598_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qU3dVaxcxB0Q7kNvwETIRbv&_nc_oc=AdptgXsNIthMQml4aLZhmobQwCR_j40dCllWJ05Or-H95pbX9qbG6EtHTCPPLV4erBw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuRzwPvAS2QlZHR-WWV3B3ceuzKMIiGTOzV0jdHmgZVg&oe=6A8EF0B7"}, {"file_name": "image3_0000.png", "id": "126672796011141", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031562_126672799344474_5418908412698774453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdM-xp-3RVkQ7kNvwGUZ1PB&_nc_oc=AdqcPEdYtlP5-O0gC-q-WjC2jWmQ9om7MnlBG9xITQjFy5o-PlhNBZe7WzHOc0Mtllk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjKKQpPKXeL-n3jIrAeoWnVeHbjmriCA1TfQdc53-DdA&oe=6A8ED8B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sea Level Rise Explorer: Turner Station", "keywords": [], "long_description": "As coastal communities contend with sea level rise, coastal erosion, and other impacts of climate change, public education has become a critical piece of the puzzle., Virtual Planet Technologies produces highly creative and insightful experiences VR experiences that communities can use to better understand the impacts of climate change and explore emerging adaptation solutions. Our team has a range of expertise from climate scientists, city planners, communications experts, filmmakers, 3D animators, and Unity (software) developers. In our Sea Level Rise Explorer, users interact with 3D models and can raise sea levels to observe potential flooding in real time. Adaptation scenarios can also be displayed.", "short_description": "Virtual Planet\u2019s Sea Level Rise Explorer is a virtual reality experience that communities around the world can use to visualize the impacts from sea level rise and explore adaptation scenarios. Through powerful immersive digital experiences, our aim is to educate, drive action and inspire hope in the future of our planet. Our team has a range of expertise from climate scientists to digital artists and Unity developers."}]}, "developer_name": "Virtual Planet Technologies LLC", "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Planet Technologies LLC", "support_website_url": "https://www.virtualplanet.tech/", "website_url": "https://www.virtualplanet.tech/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EDUCATIONAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD_VIA_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1057110991522970"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4331745840217761"}]}, "baseline_offer": {"id": "4331745840217761"}, "is_ap
f&oh=00_Af95NGa6lT11xEdBB9qP0BA2r-N7Ps9UMkwHqwTc0-A_0A&oe=6A47B66D"}, {"file_name": "image2_0000.png", "id": "249660776647945", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974530_249660779981278_4846060883642225125_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PB_u82V2BcQ7kNvwGycZG4&_nc_oc=Adrjs31VgD6LmutetPiL98PF1IJkyz9lGXeVYIQRkSOUUlxSkcpBCpKTQbYb2iqkgg8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-z2okdmKGdAmdUEOjZ1zr0pfYBPP9Tt1mmJwimQTyx7A&oe=6A47C082"}, {"file_name": "image_0000.png", "id": "206501804559410", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974789_206501807892743_2947229683003218598_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quubb2Fld4cQ7kNvwEfQ7Mj&_nc_oc=AdqiPYuySkg5KJOu3H_2h6N-eaiRWMLmPpEXhepfPOsPdtj15EYANTLGlN9_InuXKfg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MAeL7T3m2nzGBjGz5v0U7YWbWAnaSEnPMd0sXWjXztQ&oe=6A47BFB7"}, {"file_name": "image3_0000.png", "id": "126672796011141", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031562_126672799344474_5418908412698774453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vRSXnyLx1kQ7kNvwFF-hcw&_nc_oc=AdoMgKsCG1v-UMpy28I02JVcu7S9n7vjJB7YcilW6ovkGTAAb_VkP2CLNcnWXnhDgM8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VNRvDd7fMptFKrT22NLSqs4r3_o_miwjKVefLO-xZcA&oe=6A47DFF7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sea Level Rise Explorer: Turner Station", "keywords": [], "long_description": "As coastal communities contend with sea level rise, coastal erosion, and other impacts of climate change, public education has become a critical piece of the puzzle., Virtual Planet Technologies produces highly creative and insightful experiences VR experiences that communities can use to better understand the impacts of climate change and explore emerging adaptation solutions. Our team has a range of expertise from climate scientists, city planners, communications experts, filmmakers, 3D animators, and Unity (software) developers. In our Sea Level Rise Explorer, users interact with 3D models and can raise sea levels to observe potential flooding in real time. Adaptation scenarios can also be displayed.", "short_description": "Virtual Planet\u2019s Sea Level Rise Explorer is a virtual reality experience that communities around the world can use to visualize the impacts from sea level rise and explore adaptation scenarios. Through powerful immersive digital experiences, our aim is to educate, drive action and inspire hope in the future of our planet. Our team has a range of expertise from climate scientists to digital artists and Unity developers."}]}, "developer_name": "Virtual Planet Technologies LLC", "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Planet Technologies LLC", "support_website_url": "https://www.virtualplanet.tech/", "website_url": "https://www.virtualplanet.tech/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EDUCATIONAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD_VIA_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1057110991522970"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4331745840217761"}]}, "baseline_offer": {"id": "4331745840217761"}, "is_approved": true, "firs
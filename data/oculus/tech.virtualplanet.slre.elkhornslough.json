4846060883642225125_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRpz3x9-9sIQ7kNvwFNeQjl&_nc_oc=Adk3Y0v0dLYZgNmBKEhbOF4usSBO9__km4ohd5GwWnPQtQ0PgEd3VhV_RzNvAQgP-C4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyMt-zCKd8Nu18TrgvkODkOmVQ95j5UASh8eZclWLNtqQ&oe=69B56A02"}, {"file_name": "image_0000.png", "id": "206501804559410", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974789_206501807892743_2947229683003218598_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lI5NkA_MHCgQ7kNvwG23N8Y&_nc_oc=AdktrmYSrNsHWHslW3QqS_ycFHSUMFL5W0A6f5MRMrQRanvyYvJb_OuRa4HBlwuzrG0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxGF6xjS9q90tfAs0_Mu_-iGv48FCX2hNirQ7IoAgXlZQ&oe=69B56937"}, {"file_name": "image3_0000.png", "id": "126672796011141", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031562_126672799344474_5418908412698774453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPuTazyLodUQ7kNvwFWszZY&_nc_oc=AdmqEtMK5ZJPkyc74RiHkKbg0hE4MlJ31Z5kSuKDkfUrHocKI2OG111p84iJbsSB7O0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxY0kxrQNKvai1tlgMehbjQFGhZslYpxTst_CIXKQyBfQ&oe=69B55137"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sea Level Rise Explorer: Turner Station", "keywords": [], "long_description": "As coastal communities contend with sea level rise, coastal erosion, and other impacts of climate change, public education has become a critical piece of the puzzle., Virtual Planet Technologies produces highly creative and insightful experiences VR experiences that communities can use to better understand the impacts of climate change and explore emerging adaptation solutions. Our team has a range of expertise from climate scientists, city planners, communications experts, filmmakers, 3D animators, and Unity (software) developers. In our Sea Level Rise Explorer, users interact with 3D models and can raise sea levels to observe potential flooding in real time. Adaptation scenarios can also be displayed.", "short_description": "Virtual Planet\u2019s Sea Level Rise Explorer is a virtual reality experience that communities around the world can use to visualize the impacts from sea level rise and explore adaptation scenarios. Through powerful immersive digital experiences, our aim is to educate, drive action and inspire hope in the future of our planet. Our team has a range of expertise from climate scientists to digital artists and Unity developers."}]}, "developer_name": "Virtual Planet Technologies LLC", "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Planet Technologies LLC", "support_website_url": "https://www.virtualplanet.tech/", "website_url": "https://www.virtualplanet.tech/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EDUCATIONAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD_VIA_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1057110991522970"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4331745840217761"}]}, "baseline_offer": {"id": "4331745840217761"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1626086820, "status": "PUBLISHED", "id": "4331745840217761"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "i
9_506327874101590_3108931530994846245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZsZjB20CDMQ7kNvwE5Tx4g&_nc_oc=AdmtARRVhn3Hon-pEz_fdhibSqaCHQTC7K4-K5-p5PrQtDnnvB36lLnCgKo3M330eRY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afvh85G2aCkvc8tdloKpRaQ0aajE--laQnEp9Jl17yLsQg&oe=69985EED"}, {"file_name": "image2_0000.png", "id": "249660776647945", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974530_249660779981278_4846060883642225125_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=za4rGMxMp1kQ7kNvwGUnvM5&_nc_oc=Adl7mKx7CRFCsmMBu1zAtcDCSqu4CK25YXULwQJlIf1QFuUHjNLeBXBdXo9_C8t1KcA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afs1Zx6fvFF-gjkyKAmW0u0erK9RthzTt_uoQpm_Z5YwaQ&oe=69986902"}, {"file_name": "image_0000.png", "id": "206501804559410", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974789_206501807892743_2947229683003218598_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKT5m4EYzM8Q7kNvwGiR0q0&_nc_oc=Adk8vF2HK9RhSq12HroippjT-C6pzSQNti86o1JyOrxDp3Cl0p-I89y6M9ufrcJWtBo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfudCnsX26Rre6IEmRRNAAkkX3zYDije3jemOkfrmgJ2dQ&oe=69986837"}, {"file_name": "image3_0000.png", "id": "126672796011141", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031562_126672799344474_5418908412698774453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTJsMgsjrEEQ7kNvwHtwssr&_nc_oc=AdnZZO2nQYJujDCX7fRVMwk8FL2J5WFrPLgeYB9kphV44AgTrodwqL6MmT3azEybiMk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aftnf0evb3D6MrNWDRRE8gonIvpKYJixyY7vg7S3oTchCA&oe=69985037"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sea Level Rise Explorer: Turner Station", "keywords": [], "long_description": "As coastal communities contend with sea level rise, coastal erosion, and other impacts of climate change, public education has become a critical piece of the puzzle., Virtual Planet Technologies produces highly creative and insightful experiences VR experiences that communities can use to better understand the impacts of climate change and explore emerging adaptation solutions. Our team has a range of expertise from climate scientists, city planners, communications experts, filmmakers, 3D animators, and Unity (software) developers. In our Sea Level Rise Explorer, users interact with 3D models and can raise sea levels to observe potential flooding in real time. Adaptation scenarios can also be displayed.", "short_description": "Virtual Planet\u2019s Sea Level Rise Explorer is a virtual reality experience that communities around the world can use to visualize the impacts from sea level rise and explore adaptation scenarios. Through powerful immersive digital experiences, our aim is to educate, drive action and inspire hope in the future of our planet. Our team has a range of expertise from climate scientists to digital artists and Unity developers."}]}, "developer_name": "Virtual Planet Technologies LLC", "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Planet Technologies LLC", "support_website_url": "https://www.virtualplanet.tech/", "website_url": "https://www.virtualplanet.tech/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EDUCATIONAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD_VIA_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "
9_506327874101590_3108931530994846245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFTBjn-kufMQ7kNvwFbgso1&_nc_oc=AdmUG3CwBZ-Z_qEQv-KsJ5X7Z-CO94OPXnU8yGvMmrx4E5KLvT_WbM0dVmT5CsF-IvQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfumI2hd8J1fWnbWNPUtE43yqaoiLeVxvD0lGak1Y3jHig&oe=69A1996D"}, {"file_name": "image2_0000.png", "id": "249660776647945", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974530_249660779981278_4846060883642225125_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xjm2dzZ_RiYQ7kNvwHme4tV&_nc_oc=Adn_UeURA4_-v_hCuHKVZca1zEksm6NCw8ljoHY95CPL6C2HTWnmXA7ftXW46ve8FKw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afv6vRjIHogbLYif8q3noTIeOzEJemFV3GRT5sM-II_efg&oe=69A1A382"}, {"file_name": "image_0000.png", "id": "206501804559410", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974789_206501807892743_2947229683003218598_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMf5Xd_JL2QQ7kNvwHCryef&_nc_oc=AdlpUCL0VM2WQAByYMhClpwe7fKdOe8HzixpRdD1WJyxYJkXturiR_2ZT6xm9AQ73q8&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfvdaiEsWCayepx-14DKt5ybKp8RBQNqUbsHAFhe4lGFnA&oe=69A1A2B7"}, {"file_name": "image3_0000.png", "id": "126672796011141", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031562_126672799344474_5418908412698774453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYd09bq-3vIQ7kNvwFFKcZJ&_nc_oc=Adl-YgSYfrF8QCtVu11a3jP-5qOcRzYk6woO8vpnAnmqWr1gChrgeozr74UfWD_LYXQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftZPcOu6FOttHKTOK2hqBbzAdwFUJQkrUrToHmxpPpYTA&oe=69A18AB7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sea Level Rise Explorer: Turner Station", "keywords": [], "long_description": "As coastal communities contend with sea level rise, coastal erosion, and other impacts of climate change, public education has become a critical piece of the puzzle., Virtual Planet Technologies produces highly creative and insightful experiences VR experiences that communities can use to better understand the impacts of climate change and explore emerging adaptation solutions. Our team has a range of expertise from climate scientists, city planners, communications experts, filmmakers, 3D animators, and Unity (software) developers. In our Sea Level Rise Explorer, users interact with 3D models and can raise sea levels to observe potential flooding in real time. Adaptation scenarios can also be displayed.", "short_description": "Virtual Planet\u2019s Sea Level Rise Explorer is a virtual reality experience that communities around the world can use to visualize the impacts from sea level rise and explore adaptation scenarios. Through powerful immersive digital experiences, our aim is to educate, drive action and inspire hope in the future of our planet. Our team has a range of expertise from climate scientists to digital artists and Unity developers."}]}, "developer_name": "Virtual Planet Technologies LLC", "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Planet Technologies LLC", "support_website_url": "https://www.virtualplanet.tech/", "website_url": "https://www.virtualplanet.tech/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EDUCATIONAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD_VIA_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "
.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MV9xSIadR7wQ7kNvwEj00uO&_nc_oc=Adr4bvNjOd-ncM5xM7hPq5oKhlaaXcAs2P0y1FzVyENIbsgtc6Pg2kJeffE8E_kgvN0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpnBmvf6oSxosAodamA5bYrObYXyxdbp9FI3r80TKZmA&oe=6A7499CF"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtGYmF0_EloQ7kNvwGmQ7RL&_nc_oc=AdrSTRP7eYiuWtf5gznmDIYL2wqMumnB8Vz4zsEAlGvUz7dCCipsZ6Bw9tIheg1MH7I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLlS7OS_x_RiiEx0hyTdquALA3mR2EItnqSOPQBY8pOw&oe=6A749031"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCOMsMZWPDkQ7kNvwHTdQJN&_nc_oc=Adobzl-wds0jIXGKXfN_BmbvEj7atrkbN1qbnpy3qRCAhew1_FtBwWg1GqQ18WZRQGo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAPIuMuMNMw3IWGhJnlQXLW-8r1jhIjxNepE9ahAc6Gw&oe=6A747800"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ikNUwZTI7AQ7kNvwH7u0P8&_nc_oc=AdpY8Yi58jgZo0zcraAF2pB5giRIblbP_F5aHTg1zmf7bEn_tTy1CgTom4QF3xIQROw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE92CdspTdSX5RsS8chwcbqpOTVEjhWIytEHNXyWmZjNw&oe=6A748887"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLiIMhjWBEkQ7kNvwEYTMjE&_nc_oc=AdoX83DnxnyX4g1vDlfuO_xHInf_b7YufA7PfuMrFwQwovY5_7AveXL8myktKry74yM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE31UPLVaL8daM7bjCU36T_l2yrJglEGSvVk4oXNtllAg&oe=6A748E52"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
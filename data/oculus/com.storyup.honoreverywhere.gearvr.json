.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urdA70CJrEoQ7kNvwFoDlR7&_nc_oc=Adrlodbz93HFUM1Ya7xNve1qXH7Igs7Rqgygk4VN2iIZFzmaZMKDdDnXwaY00MH1ZRI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6MX7WsEULEQVUR4HIUeziVQICZr7Zea0t0IQbVZS8Eg&oe=6A6E024F"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rD4bXKYqBcoQ7kNvwFy_fM1&_nc_oc=Adq2tR-jaMtVAsYkP-ctdM6pZnenNxsowyvhvzvr20lZloh-pf6fOOXOIVnx2QBOSCY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhyLf82lsurnSgPPlPg9v0fuAqBRkWj0HKOTMXs63GEA&oe=6A6DF8B1"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRS2UxdoCE0Q7kNvwH54KNV&_nc_oc=Adrj5a2t65_H9KruVzph9dEvdefZXuIOo8MjU2-onWqbFMCj-J_2GSdYlA4NU4Vmc0k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpHSskMVWCN3X2dWjCjferD9xqw2elV98XCkhoEjQZhA&oe=6A6DE080"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlFYPq03-xkQ7kNvwECHlGn&_nc_oc=Adq0_2y75XhRA5kqpS91K4LJ8Q5Yc0QYxLFD4zonKik6iFbEAoI4PEBiPUU82B533AE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfFJhY3qsI0FL2Es0WVFh_-7PHmn9asGCPgBdcyfii3A&oe=6A6DF107"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BI_g6QLMQCsQ7kNvwFvcLUs&_nc_oc=AdrWwx2bXyT3xnpzLgWR3Who_pfUAl85bKrg0fK3mO3VBeuYFMLqHxm3qc_j4DclLVw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDweIEfRdtt_mPMc5h625PD4BwauFFR56Y1t-815ynY9A&oe=6A6DF6D2"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
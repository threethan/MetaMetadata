.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4Fqr31ahmQQ7kNvwE-TrdR&_nc_oc=Adq_c8Y8jyqIrew_S0ImXzjmXMZRlQWg2RrpgVRtVNQfIRb7dDQQu9ZaBiONedKmuBs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3ZQHM4rEtkAvm-m50AJLrbUA3HAC71uCkWESl7BZw0w&oe=69CE7CCF"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2cYgwzHA1EQ7kNvwHXmyIv&_nc_oc=AdpCnTNIz3cAanLt-sH3XZxsIiRABP_jG1F35Wer_-Qrx6nSFaVaxIirX_0rB0ENzJA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyTYrQIkufigZGhbct-_fpPsHWaVudnYUqPZay94d7nQA&oe=69CE7331"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIZY6s2oOeEQ7kNvwFq2AmG&_nc_oc=AdrOzr0ApYP3ku_ry4MKtCIBeua63ET1W-bAyTyf50BsvYPUyyrUeIBGVJDvSS-6h8k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwAu5H5gJErFTVNek8tg2jAP22ftwETf9tmhmEjUfSlww&oe=69CE5B00"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZtDGIlCjlcQ7kNvwGsIxQy&_nc_oc=Adrs9ib8gjmQbjAcfW2aZYvcgzIoi19fFGAGvMpN3GWpYGuqSMaywytw5wvttMSoNgg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxJXv6E0ysnj_OWquIjyEXtEdotb4xfFx0UWFh7iOO1lg&oe=69CE6B87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQJz8-dJSfgQ7kNvwE-lpxY&_nc_oc=AdrL8cSq6NutjE974m3ESZMeWMFl2vb1fEfS2NnAOiUt9kdIVnOHltySpiOH0WzGcfY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwWc6fE_HbNM1Ir_auo0c2bgiZ0OfLwyBzvhjuMh_K0Ew&oe=69CE7152"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
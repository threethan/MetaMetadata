.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3dPN-Nmd74Q7kNvwGVUQik&_nc_oc=AdrkUo7tMxVt6h5LC2c4iUnfnfS5MmTIC8dUOHMbemL5dmNFXgAKcRd3nKDMDcBPiMs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqas485XKZBRW3YxS3cq2mdKDDDQw019ShWELDn4zbgg&oe=6AF086CF"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEcS2K8VtTIQ7kNvwEmovtH&_nc_oc=AdpNB58kt3857w5MOyxz9QZL0iT1lKltALUNJb3_SZrytzYG7HOXfnnbxBAjvTMM_3M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQLhjWsyD8VB_RwWrMeukFKHpqCXRDNLM8zoNTcAoT8Q&oe=6AF07D31"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxl2bf_9a5MQ7kNvwHi7dYy&_nc_oc=AdqbbfUok_op7nGXowxESJJYIOkSLHmr2-4ILWAEVzMByugu_cgY9OqyjbdyRnMwFTU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRd5mDT6bGm_L13J4fLtmf4y4bXEVlN6Z2lsaJvLVrUCQ&oe=6AF09D40"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Op6e4GBRvLQQ7kNvwEwMwW_&_nc_oc=AdqyGbdxDnSyB0lBfMRKST7o5GBsZV4YygXJCqGdskNIAYz9Ehhch_9daLRlviiCaxY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjXoCR_OIlrc7FYbEAECEiA3XkpLsJT8m3qQXp2w8dzA&oe=6AF0ADC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWRpPrWSbfYQ7kNvwG1CZBX&_nc_oc=Adq1KFKONRFaHO8BhG_SLKXestRuvvJRuguIwbHbHuuxueOK-HL2msPv5ykhoXda1JU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdcQKgsHl16PcSE21vXJmjiyNW_dA2jPMwExKd5riZiA&oe=6AF0B392"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
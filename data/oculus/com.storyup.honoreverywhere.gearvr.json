.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-EuUaR0QbYQ7kNvwFExvXo&_nc_oc=Adp0rCyRkhP3C-rD2yP5GXA09VH5aJyfTR5ODQQ21wZTs-_uIg4RQmGA5O3aGiX_wf8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7E3YSS8JRd_-gSeoJLTr7fEqnXDdcZotdWPikxJrJ2Ig&oe=6A1D96CF"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUhCk0pYPAAQ7kNvwF2nm5z&_nc_oc=Adoi8QtcvgK-mq_V9C6GR-XL8NyEghJBrfTLAFzEkBAXUxtvkj98Ins0stLc8s5m8e0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qzHkhCcuL-72-OUygoa1sINYi-ogWJTZRMoqpZPbWAw&oe=6A1D8D31"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgtR9vE4924Q7kNvwFfYIAt&_nc_oc=AdrfXhCzJfd08-BCsD5Y7NSxMzPVNIl6zKTFAsuv9YD_hHoeYm0vT7-xbe6nltdxl7s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iClAhaT88-hd1eDC99CZAfFVrSwCi2yZxpGiw-M1LSw&oe=6A1DAD40"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAVJzklmWMwQ7kNvwGO8tpK&_nc_oc=AdraHJw4jPFxhfVV3-OAlP3wqzBdeIxMlg22xqEbFEV2uenuiVtxo6efM1NJWP7r9Xg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JKL13Qt1m6CEmpxZZxkjyq062-HW0ocqKDnw1ZnD5mw&oe=6A1D8587"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7y2Be5YeB4Q7kNvwGjv4zJ&_nc_oc=AdpKMMXqvfMoAL34KCE-UZWHejRMAzn0MC9OPen7FQGadvgiuchVZDlpS0hf9Ci0vjs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kbc5vAO8ND3GVSYjsZVKBjQdHA0adWHOOCS8mLlWjWg&oe=6A1D8B52"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
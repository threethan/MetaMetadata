.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=429DNuVgrxEQ7kNvwF9aHCq&_nc_oc=AdqVkqjVSlVrUe_YJjmte9LbVg6rQHXWz-cZbQ_wmbaG_7St6cQjsyEK0ACJknw2hNY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ub-0SqiztQfzwwAR_ErPV-MsW5IFinOpu7nvRYfto4Q&oe=69F9FE4F"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5TYCmlYs4cQ7kNvwFHEFku&_nc_oc=AdpZ6CiMSx_VKrbhatL9_iq13ibPm0mhLHGee_2p1jdbSk_KLmlR9gKoKOSeOm5a2uI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7usFL6pwIadiirdRsZFxELHr6k3UmrlPhxCVOfGnIZLg&oe=69F9F4B1"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SH624whduW0Q7kNvwGZDePG&_nc_oc=Adq2GGoMs88_k7SLx1mCDmd77xoz1ZllefJ34eNFmapE7L-XC5XBQNerfIZUhFvFZ8E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rMqAY4nothge4IoAtUQGkQB1frolTjMgRPl8rpX_tFw&oe=69F9DC80"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3S4Bxw74_oQ7kNvwGPKpaq&_nc_oc=AdrbcI_n60kQ5t0NGry2lhSgAMN2TZhshriH4F2t2F7EUUJu2Fzpy0Yu5Zs8X0Swbgo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vMwOiA6mQu3EjEqRak9U6fe8g0owFmDU581NaoMbn9w&oe=69F9ED07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJjEYbmwFhkQ7kNvwHCewCV&_nc_oc=AdpWrg29SV9AdYj0x9JwmtZ_tpPTqUotkmvXW7g2nTe6MQ8T0ITA_chVPDAMSqWYmqs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bH9MUPgSg8cynZ87fEXOE51xNTWL66ZVyCcRN_fIZEw&oe=69F9F2D2"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
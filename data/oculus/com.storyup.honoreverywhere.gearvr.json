.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DeyvSONSYZgQ7kNvwH8XTkQ&_nc_oc=AdpEQEE_Zv3zkpmaDk59YnT-LpSBG6xyb11ltF3RscJgWNRnwcXPgP-LExu4_W4GfKM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1d4d_txO2iWb6EtInRU9rmnKzY2MHb0A_eXS-3pg64A&oe=6A43D24F"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S95jjvtNumoQ7kNvwE7cLXK&_nc_oc=Adr6zrPmdSUvxzmnJCaOjWwedd8L8O1uLgay3JwKwGZOw-C8_kS9k6lhn6-mA5mMCYw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-etHGjkuHsZOp_wS-7TQ61e0GBIQLe9qlIQQgYbc7YXw&oe=6A43C8B1"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrXnnOiwpQIQ7kNvwHKcMcA&_nc_oc=Adp8Hc_WnN8dPwfxgLr2a25C3RcfgyFWWeonrgvn1TM6FodD25Eru6DaE9zSM7siumo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ty7VMKUbBsDwHN1uA4dEViJJsEvOw5ftKcQngu0SB_g&oe=6A43E8C0"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0WZggVlg6UQ7kNvwFDkR4W&_nc_oc=Adqfy55Ttn7HbfxZJYHGrun_PWqlBS-8mR6SS8c9iwFyslYIQetc-8MoLB6HPrV7YgA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96fwcspjBRQdj0aVjvyLFBRkjOueOSBpymLmiY2HGLgw&oe=6A43C107"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wq8T4G7MRWgQ7kNvwFAp2Zb&_nc_oc=AdrMQflkevzlBcsORpIG3hZfHc1FsLJT6-rTn73fikhKe0K57daIxuXKIPm0MGHSH7Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cV6ZbyfrUJhorGqooh0syUxu2Pe3TDsJeLMKHBLOUrQ&oe=6A43C6D2"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YL9Npj0dY_gQ7kNvwHIIu1M&_nc_oc=Adria-mGCXTr1c9GyDu9NNS-hLduxk0xEii37cv3vHegAFmvyBzD2HyC3Mi2RIREg2c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFp_xBFf3o8QdRfw08-Fcbe9lNRGYY3xhWG-Tsr5C0cA&oe=6AB3E1CF"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Rl7Yrc01v8Q7kNvwH-wAkb&_nc_oc=AdrphPlVTcJq79HrEw-HidD_avWi4AmUR-OIa7BD_pT8eKHeC1GoXXARHBzcnkAjiUE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXZp3xMhOtcBOar4J5-yxE6mUU4CLzH-gTYyvS6L97sQ&oe=6AB3D831"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mGFFxQfVVyUQ7kNvwHOoDT6&_nc_oc=AdoIL5XV0kELsr_cprMfv0oWpjpvsWxXzLe7HuqouxTVYWrQa0ohhCWex-teBri2pmA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqYsL-cQ6Aw4w5M2GDHnrTdihdqNpsL35uiAWlbrwHhw&oe=6AB3C000"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsEiOBzblKMQ7kNvwEUuBsY&_nc_oc=AdpMJb38l9jqG9E3mDxR2vu2YiWTkNTgk3e5vleK1kB1sXm4mHcoVo1sU9TYdHWIMZE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIM414FsO2nn3riK6N9MMWn1FmC8sMURTmyb5gs6AROpA&oe=6AB3D087"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfx7G9uQtxgQ7kNvwGNs9dH&_nc_oc=AdoqAdqLbC4TEK8EJlvJbIkqElwrezh_TqyFyqhsQarr1BvmsxM9sGsvpKbxt1Sl7WE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjl81q2MmkKidyLXDTQ06SJ86nsx3Ed7jN1qozdKT5yg&oe=6AB3D652"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
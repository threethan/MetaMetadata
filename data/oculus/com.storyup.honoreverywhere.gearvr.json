.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b44un1GZp0cQ7kNvwFLQ92J&_nc_oc=AdqErjvM9NQ__kMx3Qm19oa_C7fW_MH-36LwVJPO5nnRvRFIXPhSU5PeFjnlEz7iJPQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1aYiTIYc-JWTUdk5N2RCA7cZhkbp6w69iHGHFCv0hhiw&oe=69D908CF"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7T-PYVnlhB4Q7kNvwFJ5xqn&_nc_oc=AdrxLm3lRXcFKcu58f87bWE-NKjyLrecC2AkQqiLFQuGpFItp-yzIN8n8Reccv8u3jU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0h893SYisC04nyWsi_F3dB_vV3obwN_66UcMEdGKXHwg&oe=69D8FF31"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6UqEgPPWIIQ7kNvwGJPYJn&_nc_oc=Adrc84I4puT-qNtzGAJOl1awdnhbW87puPccqzF98Xrd1L5tDLTQrlS_gubpNZYufLs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_x2qQmp2rLu7Ezwjod6VKdl43V2i322DQq1m8En6Ntw&oe=69D8E700"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgyAZPeFiC4Q7kNvwEuIPGx&_nc_oc=AdoKfwCN4Q75dpcGC3mkttnSI_6BFG_HvfG7cGWONzsmminBUSj5367sEtsTl70Hta8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zp2sX0yl9nrDyoOPbNqtNOvGMl_FGaUqZepQEVBh2cg&oe=69D8F787"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QNX0cxGG_oQ7kNvwFmk7dO&_nc_oc=AdpGCG3xkUhu25u_Ht_6W6CkMIDGAHOFeTc4BscWCA-YGxSYZRIBCakIRyK7ckBuZg8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gCms12AJN0xW65LQRY5j88A8X-IktWUXa-9q1OC4JzA&oe=69D8FD52"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
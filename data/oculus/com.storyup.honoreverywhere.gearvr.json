.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZAML2mmJ6gQ7kNvwE8DY3g&_nc_oc=AdpY2LEue8-wtf9yew9m-SD1L_nr2-uTFyJQau3Uw8DtxcM_g-QQCdSPhLDBbHvipvs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IMHbc-HQZskuwrJzJMI3U1sLFWccXUsi6Dk61fvRm5w&oe=69DFA04F"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2HQI6TjeGoQ7kNvwEgusGw&_nc_oc=AdrLqH4PvpGu71vR42NXgfT1zm7RbnWgB1yxlgz3FsmCBFDLAX-6BmYKtqj22lnj6Xs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0npC9HwVme4Mb2LVfTic-cjsicaWF-r1EXqxwnm3wnGQ&oe=69DF96B1"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oq13EtYz7w8Q7kNvwG2RPt3&_nc_oc=AdpM8EZRFyxGig8rkIwsUVHSOBIOINXoVh9PvNGSQwom1kLdHWlDrLXojb4QgsA8IIA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CeWsdHx6_OKy8hlYSGvWXihJsN2qGYeS5FaECzjPBzw&oe=69DF7E80"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYPPsvl71IkQ7kNvwGqV-CR&_nc_oc=Adqb3TihEUpTfQj25lVFc4ATBHjtGtTcbJyR49TUZxA4zr3h7KuhTaSeXGq6Or5-TDw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bG7CU229gInxqxl6rVkV4vi-W_oAYCkpRrRjDzw8Nwg&oe=69DF8F07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwAftnuvL48Q7kNvwHrQNlM&_nc_oc=Adop4T0fF4gpMkZ3hEJCbDL-possIchz797upMnVpx_QdUB0nKu3U9zHBdX08Jpp-gk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AzdJNxoFODSBBEGEkxxomayo73rbtaCDsk2cCsCq7Qg&oe=69DF94D2"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brOUOqXKzk0Q7kNvwHURlb3&_nc_oc=AdoyT5cfAtQ9uH36dqD6i1Yd0FPJyPCGloiImHGqReDTFfl58NRxr42h61UiHX_BFqY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ONmFxRmOmpUIVp1Xpv_50hOIvCw56UaU9x8x1NqTh8A&oe=6A0338CF"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBalixr-PUoQ7kNvwEdhjdB&_nc_oc=AdqiY0FluL8grhCwtf8jDs9INjIhgAqkJbDIn6cbqbt_pD-3VSJAniR1hrk1r5166iQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49q0XDJoWeV2QCjQmqS5bHKgjlyLNryGNb3MJSbThe_w&oe=6A032F31"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BphYd-toeoQQ7kNvwFXlAuA&_nc_oc=Adr3ZWzzOTsY4slqpM6uVBT72DJBAKlZ0-MQ6HKBHVh-g7sPBUOBCW3WcSWif7sq8xE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6m9GgoGkX5rTmSBfdCidU8Lgp75ajrvgGPZv4_w1TCBA&oe=6A031700"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2F1BojAvTYQ7kNvwH6WgS9&_nc_oc=AdrsbYBqTbKIHAN6n2mwCG0SD1PDTVEizJ9Hyuw-kbjpFf10HAplPNmEPxlqfoqIDHY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lPRy10_A3fYCFF5ta28K4_zY6Q61u6RNQkJjSr5wh5Q&oe=6A032787"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rH3TbtQDxcQ7kNvwFUo7Ph&_nc_oc=AdqfaqIwivgFnJsyxkgljku6k2fYag3cTapHSPJ8JHY8C_bi0YJlaEvFEp1-EpYlHaM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xcOt50GylYt3GqNecnauMyBbeMVJltc0Y9Kah_Lc2kQ&oe=6A032D52"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66ADB9k8uTEQ7kNvwEarVef&_nc_oc=AdpXKhza5coRF4l01pvQ9Fe_CHVCrT95Bp3jsJEj5twaye9F-PNj4977ngPyR2-wCQs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtnwe-nSnGW3SShlsF0uHSgjjyNi_uOuBiBjc7t0sA7Q&oe=6AAAA74F"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3YuGfXm_e0Q7kNvwHnZP8M&_nc_oc=AdqI2MeVZdb0zyVWJzIacBNboUrI41uHAkVTCYe7URKtumwOIU59e01GGndgwISUJNI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfqrDSeD5GopUIIBF-8v_rtPshFUGiD1hnBaahAmVy8w&oe=6AAA9DB1"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbBlGwrj9WcQ7kNvwE8Q11R&_nc_oc=AdrYrnK4KgODnuiId6x6LBY9J_8vksvkrcBuQnk9sJoq9e5Zpx1AiSZlWNk0joxMPig&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbjZUbYR4nHw5fK48U29_gdNQC3Qp-gvU65i_CmYf5Kw&oe=6AAA8580"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_C8owpaaAIQ7kNvwFsWgA1&_nc_oc=AdpnCy9Sfy5fU8Ab_zeIUlWyTYvEhAdEZQE_O3-31ON_imc4Qq0ityhWaDhC7rxC4Oo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9fh9mMIUPcGQgdEZNF9lOFv_Vxq7x_xkNEISAqQ8mGQ&oe=6AAA9607"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SfteeSSVpy8Q7kNvwHOA14N&_nc_oc=AdrS-p88GKvCp51rv3xqpCY2PmLd3mLFUzsCO9olCYjbnVIEAR9Z2KCm0D0vjNBhnBg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGdoRKiaCIpdQyTblbxvSiOpVvFCm6fiUAo2HMBsRWIw&oe=6AAA9BD2"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
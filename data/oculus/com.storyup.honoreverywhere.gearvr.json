.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsktBiMsgVsQ7kNvwH2DXq_&_nc_oc=AdrA8y7ttJhJr-X8T_HcUxmBG7_Ke70MCnnecIJMAKxzw12w-TedwIrjP2OaPMaVPsA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfCJdjcscRngU630ORnGc5U9HftYxgkwwILst4biq3hg&oe=6ABD1C4F"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RtnXQb6IhtsQ7kNvwFLW9ZR&_nc_oc=Adorh10YNClI12pB7QULiLd5gFkc3LBFuWyCVZPeE5KydFkOziwV3LlYeQTYHiQLtiI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUoTsdreoB_2E6JYg3aOLmsx3bYECkfGBfvVKXBmlZlA&oe=6ABD12B1"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_Zw2g0LyBsQ7kNvwFunzTG&_nc_oc=AdodBwF2OY7NyCFM8BiZASEHUFBx7okF8MyVo8Wl4zfe11_w_zRyYf8ewYZ8Sb4OYQg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKszWZSk-5SV7vJ9ahDddZQ304ISgBLOz1ArF5FAfl_IQ&oe=6ABD32C0"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lm7M7281nb8Q7kNvwFFg08s&_nc_oc=Adqvezh2glHPjgbPrHH_sK3_LdBBbHS6quADYcYbqiPwWup6NyBBxrDSmA3y6dTWZuI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFdUnfEuNXojQunqlMHto-lK07K5CYnVWyqp4OSyWiHA&oe=6ABD0B07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMrtxvFUPIEQ7kNvwHDaAQj&_nc_oc=AdobXir18GiKDCtUY8rtjK78czItgchtCmEyPePgUMzjNcDrf2WZJMC9o6t_PW1VJVY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoOpTrzWk_1hm4U21fDgSrVOvbohkTxO7wX7Xl1muDbg&oe=6ABD10D2"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
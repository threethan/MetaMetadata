.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6w34UOGJTuMQ7kNvwHPUzEU&_nc_oc=AdrIHLKIUWp1e66qvUkkGnaW2GyutHu_9bpVLJ98M_T2ekhpNpaVIdwTcqcWC3DN_Zc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSucKMv63oJmnc3GdE8i-jx8f1bVpLdZ4fOlxiaheYZTQ&oe=6AF71E4F"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAspYaPY0CYQ7kNvwGbMqVu&_nc_oc=AdrjBu-UEouiuZhqUUdJNoRqt893ZMyPbseYZEBXNEaQ-MoLHv6Gl9Ll8GoT--1ZhQE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTX971UDGcqWGsFpcEKp6x2dHfyqH65_Ev_ghkPiVMReg&oe=6AF714B1"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZI-pJY30s8Q7kNvwEgim5Q&_nc_oc=Adp_45-mD-MqOX1hw79-3QVH1_bEVJJeXkPfV9PsNdo2Umuk0yZ6AJ7aPLtxtUz1vao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTKr3P6g4fs1JO-05RiixVLunWDIuRR-XRZBIz2n3dAg&oe=6AF734C0"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocHG5ng0r7wQ7kNvwFKGCrh&_nc_oc=Ado9-8E-nS6sjDuJFj7NQyObTbZsh-n5BR_MOQWQ1cck8vim9xGoiTgLX_tp563Emb0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSj7DZHWHKLgtrhPV7q2eberuIB_1sliOBwoQWf-Qn0wQ&oe=6AF74547"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-IXnfICMB4Q7kNvwGTQE1m&_nc_oc=Adr7jNytXrrnEJAShBkjSe8ErmV1Fm49yjWfThA5BmY67cSVyErgf7gfLonZst7KyL0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_jIMAn4XhwohzTLoiOK5Co-BO35iNbtPA1Ov3L598Fg&oe=6AF712D2"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IOhCW9otZUQ7kNvwFXrfvv&_nc_oc=Adok0Buz7Z73mSMARabx4zyrkrl0IRGhq8drEKp6ZIFPJ6iU5-yU_BMgVE1Dwyqbj_U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SO3G9yHaVRvxwY-izdaym_K0AGTro0NCVHDjihRVQxw&oe=6A29744F"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hvlNh-0uGkQ7kNvwErKoHI&_nc_oc=Adp1z7vStuvoQqUy7bLsn4gl6Kh-APFdi9cQicvqSgYckn_iVVj7eMDuLhxn8BwsNdc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-V3sRUwRXql333N1DB7jDQxTytjGiI43drPO-JoVkBmw&oe=6A296AB1"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bfIun-65P1AQ7kNvwHNu6Ov&_nc_oc=AdquVEBigMkkC1dS4ErIEBCq3rjuLEFpKdkuae-5LsbnwCfKEkh7GGtOy3MXQ5yXB0w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jFhikpqvNg3GdvBm_81pFzCBk2Ab43peOW88Sev1Q0w&oe=6A298AC0"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvthjyLUQbwQ7kNvwElHFRA&_nc_oc=AdoUiCnbvFSQuu8z55FXFCq2J-KrW1MyGOeFmXqYzPU6LX9Twp7G6OURsDnrEVPHjaI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gsh6LRfQFQrAY0C8M4guH3Jc1Pa6zGd7F7-ZjtB-tIA&oe=6A296307"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZc7MAbi-H4Q7kNvwF5uWR6&_nc_oc=AdrlK_8uCkfgndtFCqXgiIPQrpsY1BmxJ3QtOiRwb7NIwaZDho8q2HFgrZsNPH_ACsA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FwEUe9D4SuLi7OTeNT8w2YX3bvQVcdPprw-pbU9XrOQ&oe=6A2968D2"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
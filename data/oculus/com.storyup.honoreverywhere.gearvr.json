.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFcENmeMqOUQ7kNvwFfNvCY&_nc_oc=AdopNQzS_E8IG29qRvdoUyweWgUUOXsoo5IuMEi1eFmUrsKASSqIGx5Pk4uJwwesz24&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCK_sqWJPRFPNwXxy5DulvoaTjGTk8RFcZT9wzmOmzqCQ&oe=6A54F5CF"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPVxWh2go_AQ7kNvwG_7IZ8&_nc_oc=Adqk2L1D_5kTGGB_nm5QNJWfsgFhCuBQB8rzYHviEycP4Jv_dr8zgtwsN4qgp5v1i7k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADMhBq7Kp_Vfn5GyOyrno3JejW8tT7HZ3mx3uj4vVUUw&oe=6A54EC31"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pu-r1deOTQ4Q7kNvwEvFVF5&_nc_oc=AdoV_-YbFk3dmZEEvrSu44VMS-0dRustQUvD9NO2lKNyV46qdBWRt8P8uLPpm9Q4kH8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbVPgVoKATT4y8SxH30teterJ3wirUDxrWvg8gqfuxIg&oe=6A54D400"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TP2PhZZwTBIQ7kNvwHaIPd6&_nc_oc=Ado4PO7A05o3lF19OIIfntGdpSYcWwrmPRurdy66nHitcn83-ZeWbkL4uTVaQ0iylP0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzKsULGWgKAWZqs3RLIGwpIiCHPrj1PtO1Wvqzx4jSLQ&oe=6A54E487"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1IZmfPQUNUQ7kNvwH60GOK&_nc_oc=AdowD4G41qkRhZIP2VQUK3JibzDAKL1qlERWAzMw0zFFmG6PXKkFUNFZrH0O8n660P0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVq8eTb_bBm2aLiE3Wmcg42grrREGZEpsIc18rQZwOIg&oe=6A54EA52"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
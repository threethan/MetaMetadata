.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2si1k0bq-GoQ7kNvwEpcOd5&_nc_oc=AdoPkHJIsSaVZlb-ss75UOscSd1GD68Q__0iMRAM9F8ti1v9wXNj9hw6xIgP3VKvLQ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSIvR6QK_AUYFJRMht4IR847x3rOZRij_32vXFgyb4NA&oe=6A73484F"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtGYmF0_EloQ7kNvwH-KmpL&_nc_oc=AdqpOJxQXDXIxtiShXfA909RTwcRdo6jOq6lzXiNrhhdg8H5MosjOmI8YRe3nvYVJd4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeGBbogdFGkSTy8ALJdSekJaU49y59yxthD-ad4MTFaw&oe=6A733EB1"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCOMsMZWPDkQ7kNvwGgtIok&_nc_oc=AdoCcLSXzh-ZAd4hBRmhwKjWtBrD-0btAli-xI0Eyn3a-9nMwga7q2tslkA9MIDcNII&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoTJvG-ZTsjwwOTPTJTy4rcDcAb99ml4Y-FWHbci965Q&oe=6A732680"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ikNUwZTI7AQ7kNvwH_5Sxr&_nc_oc=AdqHQJWgB8lFP2lLHrvG_9Kil_Eyl4dX72cdWq87Ki5QZcX3XVKf8CJn4lPojT2dBjY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFelP8mFQQywVw2b2WRqs2LBB9RITvvLqOCAsiMqCgX0A&oe=6A733707"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GVGs4Nmm-MQ7kNvwGMde48&_nc_oc=AdrjykBqoxn8U4alBamEKwxNq9yEkcUztUI3fBPaiJ71bSvLOXOhjumcXZlHJ1O_PFE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-RrgjvTww6VmuRX0XQeAvrs0ssgEfHCJVE4DdgR3BTQ&oe=6A733CD2"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-jSCNH1a0kQ7kNvwFHaLaN&_nc_oc=Ado0sMvYmxF7PHU79OrsAhdbaAlF7gxQCSNkL6XpyXfpb8d0fss4yaeYcwVCx66HvDY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvWzA6-9XUB1DfCjUhjR9uihQIpQ2zNiwO7-ndDOAhoA&oe=6A97514F"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KZtwRu9tnsQ7kNvwGP44Lo&_nc_oc=Adpqxhkh6M3NHB29uGk1C6prUk9AiNWf6fuGmzfZLXWdTZx51Dq-dORSCm615TsxIlw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEV8bhiSqg3P2ihN234qopKXUqo7BNr0CNL4Vp0eoP1Gg&oe=6A9747B1"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_jrtj1tTdYQ7kNvwEyXjmk&_nc_oc=AdqfhEju5nLtt6UO9ktfF0UZLHXEuEeXkM4qSYPWaSYh6qyZHE6p6EbtywO5C6m8iro&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXsrff966X7oTI2TPF5xXDnmBYUjoUXU8NtrdPRCfl-A&oe=6A972F80"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QyxZ_q8BosQ7kNvwGWttjR&_nc_oc=AdpsrMjnYJob_hhZxS04mrxRNyh8zx8oinW2XM0w7YenFwjN1F9DXoofIWO7_8cflls&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0bYCIzrJo13plErN6gLSGzft-sXy32DnoYFeb6nOODg&oe=6A974007"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsWij7GFwqQQ7kNvwFKNPDW&_nc_oc=Adrah1XawXjUq806uZIUj5CKsHzscp7F42NbIayI_8gxOW-iVriboaA3wTEyYo58AuU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYPFz948HuiguTzA5GOeIwTsxLj2WbFS4yBos7WREA8Q&oe=6A9745D2"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
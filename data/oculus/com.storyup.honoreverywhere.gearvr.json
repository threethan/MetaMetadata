.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqArVzeNUxMQ7kNvwGYQ7d-&_nc_oc=AdoafDcIbEL0luEs1k2jnP3KY9q_ZoO3eYCgCtLyY_G60YfogKdVTfzgGfzgzQJra68&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cyjVW3q3IyxIO9gxgXiRml6zwBnCrTDx5RlxhABk2TA&oe=69EB7DCF"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8NhNlZEc3YQ7kNvwEUBCj-&_nc_oc=AdrzEPrWk2nyfL2yYlvAX69WU9xSQmNdvjDZ33ve2PmPUgKy5svkGro8grZ7hFPYN0g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Bs7ck1jr4v4RyLDMeEK1rUrBKdsvI_4ejiSSgEUo64A&oe=69EB7431"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AwW4WS_Vx4Q7kNvwFr0TZq&_nc_oc=AdrwzeLXD6xGWUFdXP9iGfQf5UheGei0c5xDrbx29jg0nGq53DSWBV-5CBsx3WnjG9w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-cUBr6QdNC_LlIGPjJUU6KHC4kek4GxPuQes5hrsIdA&oe=69EB5C00"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BiPFEamo8AQ7kNvwEFSbBM&_nc_oc=Adpbd8tV0fU5xlGys40IEbSJOZKplWzdRfjN9yFiU9LzDRUCEXITop5D10m_jeofalA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JGZDoxLBf-aEqOixIBxDJnfxaHnPIAOjnza9moJqwng&oe=69EB6C87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=em-4Lk_g25oQ7kNvwEDvfke&_nc_oc=AdoW3wmTNJ-sBB7tcM9Gg-lHnmBzTOGBY6GSIoWZtnhwkryXHTxw2mAPqQKxneE1vx0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fEbfYXVO7VRTmrfbPGOw9p6wNyHlgEmLt_R7Wfhh8AQ&oe=69EB7252"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
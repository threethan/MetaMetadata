.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87Hy6XQApBMQ7kNvwERc8tD&_nc_oc=AdpurABHxDeCwn9yjfNvwCgiTjUwgmBQBgCGJtt-a6FWocojQMu6tfmpLVRgg1z2Wqg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfGo0Fu0jgjidsLs10UskMF-sOa0YK-PQZP7qzztUsNA&oe=6A4BBB4F"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KnHyOL29riUQ7kNvwFy5KPk&_nc_oc=Adrxsv5p65IVyF43DX-3bTyESvxAAZqSjPV_QyGrjNbQXHFgX3DzoXKPaOCZMXM2eiw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAS8R717qxrjcOvEgrC1SiUdh0dq1lRK-S2sOwgytHnoA&oe=6A4BB1B1"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-OJnUPxwIIQ7kNvwG7AQQi&_nc_oc=Adq2q3X4niDNWtovEwTaLjqRmYjPiS0Ia-a7GhhIzz9MUMB0SPm6AlfMUS_0EU_5WVA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFWgPX7K0z6UN0VhzJYb0VzJmd2RXw2GMc1Wcuc-MlVw&oe=6A4B9980"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bmf-lb5JAmAQ7kNvwEIVpkb&_nc_oc=AdqfL9saBuJchJ2pa8BCbUrLYNJtHwTvLBOzEEYLH-e70gLenKjFOJSKOOvgQ7D4zyM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6sk1mHGVwcm9YnOVGNZWMBnxEYbfaCmRBWgb9NmIyow&oe=6A4BAA07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z1VjshKeIyUQ7kNvwFtxB7X&_nc_oc=AdolofdaUofp74S8W5Y3i_yRz8CGhKBepIQ5AeITx04pXP90exaZuguvVTME383Idls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOd3aJPzyg8TcfjTVOleB61KT-EgqMZRXS2yl1K-ChXg&oe=6A4BAFD2"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
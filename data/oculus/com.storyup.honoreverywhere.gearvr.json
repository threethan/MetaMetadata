.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZAML2mmJ6gQ7kNvwHEtW8d&_nc_oc=Ado6nkfieBYatq3vh_DeN_zVMk1PtBiPqa6gmXyGWHUFVYPED3KgLNe_DdpaZU7bpGg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2a172H4FTL62xGZVNkZ_lER5ZiyZsBh6aAJcMyeja24g&oe=69DE4ECF"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KthSXqwZfgcQ7kNvwGpYHrP&_nc_oc=Adpq7uIyxWLnwlQExiIAlNr8kpWevW_vE-SI9mV3YI6c5x9kq8UMDTJtT-Wd83TafI8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2azL2BkENStxSDZ9lZSAsnLZqLMDpLw8NPspYSPuY42A&oe=69DE4531"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hF3Ffu1oOGYQ7kNvwH7y6vq&_nc_oc=AdopL1guOR3NBkz7tJOAEkthegnzkIl69p8UPutTTOpN4uTWaoLzGvLkKcXd-RrqQRw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uPT0uXJy7_Owh_xJ6rZSpUeCNAO5l0A7qp81eAWLs8A&oe=69DE2D00"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYPPsvl71IkQ7kNvwHjmemL&_nc_oc=AdrgvuRPUkaUn8OvGY0Ib1VJ4JDILIOdvaZUNC8aG8jUW1uVSmN_L7AFwXTLOnxPco8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3weUDqWnv_LxDaH5WJbQgeBxYi_OKdMmfM0nKL3x1s7g&oe=69DE3D87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwAftnuvL48Q7kNvwErRaXl&_nc_oc=AdrQHe0Lnfc4AkXc-TcyZx7GMhbwpsf2J82IJB7jjFY15t9FsxidKz4nDPMzGklFXPk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3b9JfqIRgJBVM39iNKQ8c3YV25Vn3ajp7p5r-o00AdKA&oe=69DE4352"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
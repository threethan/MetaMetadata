.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxtnkrN3pmsQ7kNvwFjHf-O&_nc_oc=Adr6pYIy-SGsixuyT5NJW_AVH3MW4eNpabdmhU_2qGBsUvokPCvLhxFbi2bEmNhlfLw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcMQTcpfvtJplKPUpMHHkwUj95Bj4GX3nfyW4FTOY5hQ&oe=6A86D68F"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9WlB3G2nz8Q7kNvwEFXeaH&_nc_oc=Ado21J_hI4jbkCBf3WQiLGnnEvqMQcqJFvd1PYEhPLc6gkVsya3B-VxEU6vb2GoYoz4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEv9qYvvyyM8XoXDKr-JIbuWPrmN1HHP808sfwKfg6fjw&oe=6A870531"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTjzAeLAO2MQ7kNvwF0oW8J&_nc_oc=AdpGLNJeUZl_AxBWNOLWnK3XA6UgUpIyFBnLC4iLAZEZZCmWgIYTWBE6fReg_Dxi-nM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFro_0NSTJuKU_iVdqh41DVRc5ZbJ-O2fStF65qufYrdA&oe=6A86ED00"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSL2F5HinOEQ7kNvwG1BGNN&_nc_oc=AdoJK3aDB4IGhCDoE0jALFrl0lF7eSgB_DN427Fnc1imZCGHerZTy2c6YVrIurGTaOA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvNkeLEuvMP9Z7W4TBPmvVFZnm9UBzMAyRCje2A5KDzw&oe=6A86FD87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4ARMraNWsUQ7kNvwFMWwaj&_nc_oc=Adqa1O3GfyStNu4NGb9iV_rf7Hb3lJyxkdMkhPpd2-F-Pr9u-yuNFomNYOabyZ6YaIU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsLn81TNT8_EBXC1FBVdk2x9zn1lgbL2eH-RCa_e_Mtw&oe=6A870352"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
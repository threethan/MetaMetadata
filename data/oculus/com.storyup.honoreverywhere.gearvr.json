.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9INmH2uHKfcQ7kNvwFGi6Lh&_nc_oc=AdqRsVdwql6-ErRaKNsmkznlLcbVBsyhIYAFMrg6KQWngM0w0Lmn6o750l_UFSBzGI0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1GnFeve3YdNgtWeFHKO7KfrfTfGf4ejLzw-2NPWqJ0KA&oe=69F609CF"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z14ZQyAyyt4Q7kNvwH7--RY&_nc_oc=AdrcBIhvnHExfklrJpu4XW47w31rsKnjmhZJqpB6ENdfDVyKIN8n-N8rSgWOr0AvCRw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3nWPSQB8N1H2yJMHBj2OQedgcy5G1XbhgbXjSUspLf6Q&oe=69F60031"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypjbobXBTlEQ7kNvwFmC4Vx&_nc_oc=Adpae2y45QidvN8v8axKtfxkv5pmaEa3G1N6rqp5XE1xkh59lwE0uWhpTmmKvXBzbT0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ruq_brQKusHuvg1md9qdD4phd5sc0kuFr6p2clXH9qw&oe=69F5E800"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9bt72-Un1kQ7kNvwGtkDCN&_nc_oc=Ado8LyKTo-TOt4hFaj70HOFLGxduiy4ZnYnzL6hELLXrdn1mcqirE_x3AKx6PyTjVHU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ZjLongZV4rtJ8AwXCOUvUEOwgWZGh-QqQuk0Nm14PSQ&oe=69F5F887"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SyeBceLF9e4Q7kNvwGH1ZVG&_nc_oc=AdrNwZ41y1DBjUZX-IyfNIcC69sjvkq5BP2y-UeueBkfYSCHuDawXc7Otxlcgxscdgo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3kG-SPkk1PO3dIgHMggq2vhU1HjgBT-Pstjea6eHqzOQ&oe=69F5FE52"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhJQsS2lzpYQ7kNvwExvKAG&_nc_oc=AdofhOW2btJ3jew-eRo1IfsEqSuSSQ1c_eD207efmy3iaU5t7b2o6czjhxtIZMzCV9c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwfw_XhR21f0LjqiBm1Z2tTLWsISLjDlwpicpn_EkJqNw&oe=69C14DCF"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEdGGu7lA_oQ7kNvwFtE7W0&_nc_oc=Adqxy-VunJuZd59xfgjDAHhqvOJUeTbR1-dU8DEVWdT4dbnpDxjyFkdfr5aOiDXxUiU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afxm2t7C_V7iB-7gtiv5TNqJVPQyumsk9GzWMZISEKwpXA&oe=69C14431"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3nT2dw3c-0Q7kNvwHhr5aM&_nc_oc=AdqAJzIEtPavLiG5wrjetQR8oMvczRYi8z80jJUc3IA_vZLHHO64ACVqRPupQ_8hTnU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxl5LkpIpA_F8-A2hTKVghWll05H3d6FFfaAYMP96Jj6Q&oe=69C12C00"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEMZszXvA28Q7kNvwFpdjAQ&_nc_oc=Ado-syahWFgYDGPXTxiK8bBmZxKEqInUeFs3vHCaYBmKgRT9V4XqWfGDFYWSZ8gjSmw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfziITwILx2wFsajLjjM3KrLJd0CzliX5_LM_OJIwIZguA&oe=69C13C87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESFAlUscguEQ7kNvwEZi_IV&_nc_oc=AdqFIXWX7AS4WXTl0WmhOhIzIGpZ_rwN0B55zsUKRa6Qg4S3vZrlLExO8HMxmf80r3U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxcXZW7oVJyw0VJJG7dWj5Jv9-da9vRRQCLt2_IoZ_pLg&oe=69C14252"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NO
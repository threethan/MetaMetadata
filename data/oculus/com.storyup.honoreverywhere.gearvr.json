.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3rdUqItpSgQ7kNvwGixQm3&_nc_oc=Ado9i7anAGQIqkVIMqKXmGTQKFvVQkZg6QOdgRGpUHh47CzF5DtPQn6rfkcdSTJL2_M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCbPY0IpTXCsDMc2kEqo3GW4w9havI3C8Ry2uFL8zYhw&oe=6AC110CF"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2g18MOUBqfgQ7kNvwHtZTHH&_nc_oc=AdooOKoXnhdhE0RE8l8cMH-4-JHDwcw6O9pJ0tP4HN5yXyPKCr1HiRHhgG9BtQB5MUs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVMQDvYaeySijYUhCDf3JHMUJKjHf2ycoj2tS_5GyIWA&oe=6AC10731"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31uMSsqxxtgQ7kNvwGi_qOC&_nc_oc=Adr8jLRtJg6vhLnYcnhHMikhECOyiMacvpq7trSHjNoOfVuIlq8BugSjSrUKwJ-LfmU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrn08O3br3YoI0lTTkd_hBtJk6n0_VTpbVGbX5DTD6aw&oe=6AC12740"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ud5s4es94JAQ7kNvwFo8pch&_nc_oc=Ado352DJEcZ3eQ62fSf9_JlHMFwcjCHZSVE8AnDn7BoIFiIhP8pNxdjS7CrpokjRvWc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSgDnbVn1QrOYzhaWrONdx3RdEXHIahq-48KOj2k3-7Q&oe=6AC137C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2D-x8DA_fF8Q7kNvwH8SMqh&_nc_oc=AdorKxYQuvi7OVUnMwmxeSOVTm_gc-EgYM4xcin-GGliVaA7_SIXqfzj3HYNxvkqio4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5AaV4zrDBYrftm3hbI54WiGrwFkUoXAHftjPvcR7OGQ&oe=6AC10552"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
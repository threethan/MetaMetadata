.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVMakWOF-w8Q7kNvwH_5t1R&_nc_oc=AdqeJBmbeYtenJYsBdvZqNjZ0Mps2wg_e4gSCsohtWdLQWqeIRb-q5Uh-o_HJFMlDxc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTQg_IKKQ8kiQKMhT2ykv-tEv-zR6Ch8bYUwd3viH6vQ&oe=6AC656CF"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qd8GVBY3Rq8Q7kNvwG2sExv&_nc_oc=Adq7IxcqL1S4sbe7EnUR8suDex_Kg_s7oEKmaC1jmzRGRQmlod9_BLDiaFUvPmq8i5s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnioAyVSaBl6F5B3ZVVPjYbAVV3wBYdrERtA6e9RWkCA&oe=6AC64D31"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaZnKOnRv9kQ7kNvwFohuUI&_nc_oc=AdoAVIM-rEDlwxjg8GtSuT5c01cBIaM784wJjuDKLAA0GITel3ELmMH2kkgoxgPSCBc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOOS0XyFg2J4kYrh0EigHlBLH7o77beXhVB6ZA70SlCA&oe=6AC66D40"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5a0AKa6umAQ7kNvwG0DYsm&_nc_oc=AdpTJFRc3jC6_KCsGQoZ7qgxEvuxDy016urWG9f-rwiRxalDkov9aScASE8iIvnoPtI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFa6k2p7dIRx-SypGUWLFu2FOtbqkEni6czwKwIhxdWw&oe=6AC64587"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thlhjjXzbAMQ7kNvwF4inAY&_nc_oc=AdolE4nj7cX5mxD5CyHuMeqMHHoiDDEAbTHeiF2HhSLu2y8cyusodKqlfEQ12pop2WA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNKYKPiKF8tZZZ0Qkb_iCuuKtXKxMjMB1UKnKvPwfG6Q&oe=6AC64B52"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
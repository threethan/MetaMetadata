.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypV7mkbeuHcQ7kNvwHIHRCw&_nc_oc=AdrKUkSS-aAZPAZI5NUkdAnIu365jhN1H-s1Ug_4LcKtHCcfXQv5CGHhAxCWSt3PV84&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PF8VxlFd-PjZdND6EgL2VFbZ3RmH682pco2LZ-IQr5w&oe=6A2822CF"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hvlNh-0uGkQ7kNvwGFXiMt&_nc_oc=AdoobDnlKgxcjsPeCcMXJf5EVjBe-mSmNFEoAbWPQ1B2XR2aQgMRashiswWwRNuUYt8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6SakWfp7rKBZ5KUBO5pCsCOUTBjHLypjBIbyt52SVtA&oe=6A281931"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bfIun-65P1AQ7kNvwHcQQMN&_nc_oc=AdreZMPdOYmqUnyujyxEhszaZGr89Fl8H-WpfO4O3-kd47mBwfkLCrkf2rcIVvtfxOQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dGxyvxSJFoBBQDRSHQMrAN53QyACLz316p86B6v37JA&oe=6A283940"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvthjyLUQbwQ7kNvwEWHaxI&_nc_oc=AdrTcuckqVcxZUifG708XLEyn-KB7utVJNVe2TuZg3qbe4EunKiGdAu8ZUWNDVtP8z4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NABbECxC15zeXCO8MhceMAaG8z3FraHOSFl410sZyqA&oe=6A281187"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-50NKvHAKwQ7kNvwFThzSu&_nc_oc=Adq9ZI3HSa53Wu_teQ0go37E-uka0YUs0CER3CeL1VK39H7fuzMw8Ur2RK3FXR5Bx4s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lXwim4VdEkIyehEph1GB71OX7uSeKpgzicTz2bVTrGw&oe=6A281752"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
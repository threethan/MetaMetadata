.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W78uiPhtiJMQ7kNvwHlppIU&_nc_oc=AdpEVew6iiZYiV4EvDUNUhSR_TVP-jNihR318gEMDyr65hm5NRlzuATn2qNDWCddEUU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KrRJoQsp38I14v1mWNW62fCXb2K3NRw3QJFSGnmgX1w&oe=6A15ADCF"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4kfiUUYJKoQ7kNvwFaVnNK&_nc_oc=AdrSs_H2-NWl4OimiJOPMIYU--kYOKh5MTZ0dcJ1WX6fhipP7fHVObPJmDwdRkfCreU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sp_z1GIN9K_73-Aqi3twUMz8yw2Xmo-PwLFaoWN8fqw&oe=6A15A431"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDXJLU-uRd8Q7kNvwGipEc6&_nc_oc=AdpKecRNaVJpKOtRqZYn9HtPCfu5itx_mgy6OaK_EGPxj1uUbgyXExquns4PrJa6MGc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QBcGERBG_CaDSQJKsKEO1BsFWCjsfIzJmv1UvCfDS0A&oe=6A15C440"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fG6ZnNynyw4Q7kNvwEfBJHu&_nc_oc=Adqtcc68KKW3GPoUZ3ewdJs6e70kTRqNEnrKxy0TxoRo6WPQALk_kHDm52fjvYFlk1g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5q472wDBJO4UucG-Q0BLiuFB734CNt7IapmfHiCUTmqA&oe=6A159C87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OACi-3UF020Q7kNvwGaekv4&_nc_oc=AdqsmIDwyzF4KpIfS6KsqE_0BQ3yl49aAtcbOKmTKJNMU-Pr8hlETctO8xOFXXARRo8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62vPhhuiiLqc_H9qeoAESNVi7nGDYvtX8MoGrQn80r3Q&oe=6A15A252"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
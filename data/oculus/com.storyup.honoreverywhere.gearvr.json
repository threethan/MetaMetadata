.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VHq_a38_-MQ7kNvwGnJ-be&_nc_oc=AdrlvdCh9eM5d4zdqiPYGV-S_tTg0gpLWnp1pjIJCRKsbX1IGJ8dwQfUcJRxRd1TDng&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pY0PgH4Oj3b-XMaOxIEBC7NHXcxf1mXv9ifYqd3PX1w&oe=69DA5A4F"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7T-PYVnlhB4Q7kNvwE4dGxQ&_nc_oc=Adq-5rd3QZ3lYKFZqD2GAPQEUpDdScjm1dWEPgc5taDVo-njEImFMONzfMwEh4G3J-o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2deR33_u1rEYrq2aervSqP23OckAWq0yVvChobOFBGJw&oe=69DA50B1"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6UqEgPPWIIQ7kNvwEHE10U&_nc_oc=AdpzsazVX4VMD92gdCy-zOPRDrAUMaPBkfvQSurTwq-C_Pd-4zaboCH1uxtBYyU4-Fs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0o75buU-GM4mi0gRBrGmIo_rUSGUHB_kCX58fmjeWQ6g&oe=69DA3880"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgyAZPeFiC4Q7kNvwHgSEgv&_nc_oc=AdomxOj-UxjPQbfZmW6fJwMHAAmi7Zu0VMW_GCr4IGlVev4O4-LwKsD6VALn-3-dMOs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_PaBCroN1mSqFn8a8ti7ddyOv-PuZkpd5tsObTQA3hg&oe=69DA4907"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQdrnQEbCjAQ7kNvwF0giGe&_nc_oc=Adp0pKUAmSBPHEO5HJbrqLrLBWyfZuwlI6V2c9PrwWlcSrRXkEKIP0xFMnnuvGCA4ZI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1T4cQX2ZuBrdJ5ZkPKBSL88kxTt2U6YgqYOU-bmqUe3Q&oe=69DA4ED2"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
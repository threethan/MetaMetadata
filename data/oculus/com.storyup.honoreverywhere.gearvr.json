.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gfj96ssqwIQ7kNvwHvZhj2&_nc_oc=Adp1u3s3i88riySel3nEW3nDnTrE6ZykUMowB5UwF2lDuLGDmwpEbviScmUPDmovKIk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgsLaDOzd1Dk_tKUwZ_iZpq5CYaEPOf2JWPaXBlkruQw&oe=6A9EC9CF"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=No4sioBoQBsQ7kNvwFJCu0B&_nc_oc=Adpcmcv8Ju13UhVY-qDkaU1ccY8lrMHN7njOrJKHgmHNFxBmBwc4F8WC23UegbM7SM0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIO9r-9Youydug_pf39Sq8YoV9jHZVQQZHPiDOgJvwtQ&oe=6A9EC031"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jwv6waFVBYQ7kNvwF3B8aH&_nc_oc=AdpBs0AR1aZsIIldFZOuNm-N7-HM-oukylomxLahYn1CPbUs-afN2LXIhk-FtoJYso0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuMlZj4fMn7DMpYy7q8-2fg38HcsbO5niXl1vbWcZXKQ&oe=6A9EA800"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6PMC75VvFcQ7kNvwHlPgOh&_nc_oc=AdpyGlr-zHY7yGlJfyKtS76MddyUXFYNGEL5rrTMU_YnuSrm9J0_d9aZDpFhhQfRFKs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIicgHEpaoJZiL6vSfSpg0oSy7PWmwPDE4hB0Z9z-88xw&oe=6A9EB887"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_6BNWn5DTIQ7kNvwHi-mcN&_nc_oc=Adq5-zVLKHebCqfHAvbqFXQoHtJ5Wr5NJZVzkF7AsIdFB9QCKDjD7OfFgrF4rGokrY0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUwPBYIWki6BQPyy6c47IME7Ta37Q5K4fI7Uh7u9RkuQ&oe=6A9EBE52"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
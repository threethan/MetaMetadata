.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0yegGAUq6sQ7kNvwEi7blt&_nc_oc=Adqv2KVMjvKZwDm7Lc4f8sxv0etdVujx078sdzixIrre-oX1W8AdPvYWZvP4KYJa_Is&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hRlgyXj_JzfSlzLb_C5h-uNHjMMB9cxDVpLLDLuEZjA&oe=69D2714F"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KX1HxTj9WxoQ7kNvwESiqNp&_nc_oc=AdrDf_1MlgbyLoTTry0rae6onSChBEW08VaG2ptnYuH-I37Ee55oRsRvI-jlEikHudY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af350Xxok9b8a-rnz--ogfJvHbHmp-N-NB6WY2lNMQoU6g&oe=69D267B1"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbUxg3z3orYQ7kNvwEqMkCP&_nc_oc=Adoh2hJhQMfPnxPsgZnH4XBJN9svtlBAVpM8hSDM5rDkCzbQHef8xBdt5oCvnleQLtI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tMtoO8UTJl0Ubk1JmWNn1TrDyMI7cSpKzPto79KeMgA&oe=69D24F80"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9U1GM6o2hXkQ7kNvwGW70nb&_nc_oc=AdpNwzeU5P9f9P2T11Gk5RLSaMSk0Uagfy6VBeTUIkglqF1x9F3DZ6atnLWzD0Yl0RM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Jke_UTljQOP3MkCDbPR1OWC2unIBvLN24-8Vw8Bf5EQ&oe=69D26007"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xk-Y7BqfdTUQ7kNvwEcv3rm&_nc_oc=AdphzgOrHSOX53BkfUsM87LrGfBy5KlVd1I7dAzXLzuLOYHyH-c-YiYtWtUThCsfHZ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16RY4ybZifzr-pTsm2AR9XZNJ151D9mxL4OjU372uPbw&oe=69D265D2"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
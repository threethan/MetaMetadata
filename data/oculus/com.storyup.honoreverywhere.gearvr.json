.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2si1k0bq-GoQ7kNvwGf6gaN&_nc_oc=Adr2OVvlPd7ToHAUN3B5YPeFbnSCFW0Q28AgWWL1yLYkvmeNji8bxfjQYOIPv1-GG1g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8WxnJ_6GUgh0-SKHGCZcMfkLNs_9ReqMTc2WqdfIEOg&oe=6A70A54F"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rD4bXKYqBcoQ7kNvwHhh2QC&_nc_oc=AdqiUgdH4uh8ctZFAZMy8KsyLV9usl_50hgsd6I0WOEUEz83G4HyH437rdzkYgqixvA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGo9kCVeQwK9xFsX2KiCIGkw5ijCMxOrPVGyTGB37jXXg&oe=6A709BB1"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRS2UxdoCE0Q7kNvwGvvE7K&_nc_oc=AdorlD_83KaDtrzHTgsnkK0K3gMH6nMv_Qg-cvYBocXg0pKm0YreVpcWmbCoXZpjdcM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4JU689G0Irm1oICVRSRF895OPV6_l-CR61b715WFUZg&oe=6A708380"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOjF12CU5NIQ7kNvwGnunTN&_nc_oc=AdrBtTOk-hVIjDLlBK6MaCefz3mOso_XSnGtD8amGv5Y5yw-LzjgXQIV1wHpB4PURIo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrWqf0m59UkSScA0a2YFqqypC_psywfA5t7M1968rnbA&oe=6A709407"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GVGs4Nmm-MQ7kNvwHJ4tFu&_nc_oc=Adp5FSDBxzdm2t9Jd4h5wuMnKNNYsENcciRh57VqsgOR7k9rIkv6PROoifaFqIpd-gA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEz-McbjPaBshwsn9BlfiNRv8YAFdmRfyRmu1Auf6d6GQ&oe=6A7099D2"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
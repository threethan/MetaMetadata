.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwnawoXyul8Q7kNvwHheIXS&_nc_oc=Adq828dgTh_0_6wnIZtpUrieQUr3-H_JOu9sXGXBFte67lvmSKdoaolkxbEUohIzDgM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSxQ51XSSUySadF4VJipGoE44dNkx_ECQOzjkMDDWNYw&oe=6AE0B4CF"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thp3VHdx7JIQ7kNvwEWP7PS&_nc_oc=Adq52PlxNQV6kYpbRHAQ0c6NASLNQUfhx6xPkCpB4yoduDjJwdi662QzfOfYA4EZP5w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZc3gcSzJVsPxhWni4jaIVaCvov-Csl_99R1JF3wD7sg&oe=6AE0AB31"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdO2qdFusYMQ7kNvwEOHOWh&_nc_oc=AdoLn1kh8srSqD-ROyogRtG1V-csCE0gDJc35oJ62QazxyJMAaW_C-ivrT-8VLvMKlQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkX3BbZka_ZC_b3ZWOUSaQHAxBdThMk-WkHkn15LOt5g&oe=6AE0CB40"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vxtlGaYZdoQ7kNvwHkCjkH&_nc_oc=AdpBUBsE8qw45dD-atwWSeDGNbyzzyvb432N2jULTbnvOHiwmCBH95Nng5UJT-awpR8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmP9jOaVo6SKbofLR8w7xZ2nCTx_nrFW9zgKXk9MYb_g&oe=6AE0A387"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nERsS_7krrQQ7kNvwHbVm12&_nc_oc=AdrVjBbJnhrLQxB6noJ45jsGB6RYRBjoF0DvtkNuwZt8vH7XIEy0GieGcUiStVuS4g8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFEObCaiwRFjMOyyWWqmeJcf6L6ru4Mk_NyRVVAGnZ1g&oe=6AE0A952"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
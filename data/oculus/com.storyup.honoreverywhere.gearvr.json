.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9tAgwM6yCcQ7kNvwGGIicd&_nc_oc=AdpSdPTe23hJlmcsZDF6txt5YkwR1_XyVOL7MYQrJ5phnfTJQ0HsDiSXwSok_chTxac&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGA2EJgcSS2EjzyVJxwAAPeOfV5z9SpQi4V8dEnRcJoPA&oe=6A92B40F"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DRjoFw3yWQQ7kNvwHPf5rw&_nc_oc=AdqRf6EHTPMgJayvW0SQd9zcVzw6CRYHlUG89tSeU1Nk5ppBSYLGn1mm5xs_Wu6wJWM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeO8Y5DkWDR0dN7td9NezlJpMjPOqasvMf_Khn4_HHYQ&oe=6A92E2B1"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WihhKlx5dUIQ7kNvwGemO8X&_nc_oc=Adp0q7TbXD9GPFPOG85eg9r8YqAjgNTSp3nAQdMYy5O3JvaKZsRHnMGU-WGy_t3LofY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExPBHFhFiJjzqQhp78qvVVw9akJznAeODIoMBC28lw_w&oe=6A92CA80"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMiBnkVrqhgQ7kNvwGOMLjK&_nc_oc=AdpkoiSHUBPUAlTRxV-dIk2FUel5Bsa7fW7ubtHu73HMcVHkqwIwAbJ93tuOArqaT4Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjGtxx6OHghO5Iub7Z8RFfdb85iJZ6IBfVb_aPtP-JEQ&oe=6A92DB07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zUrtQ_zHRgQ7kNvwHY48W3&_nc_oc=AdqYw-WcELJRD-4PKTHEr7PruTCeGS5S2kXhUGS5iKJ8jqMJwlFWGclP0HXNFmKNeOA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGxX7Kw2LzrKwqDyyVdS4ivH8tafgWMMf3KucUaDUlDQ&oe=6A92E0D2"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFuhASXZFiwQ7kNvwGD2zkS&_nc_oc=Adpgptb7tflSvLgXMxBEwLIYNv_CDtX4Z2In8DCesNoxei1kt5FwCl4a8Urvjc5eVm4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-2jcBX8TA91yvx-7SSYSoiWlw2YhdG_2Jr1JISLePlQ&oe=6A0B21CF"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2M_ntV6lhYQ7kNvwF5-xaD&_nc_oc=AdohfW3_AjXEvkYwCJvwkrLVs1dFeYXz4w04-bve3PEcYE8VKnqhwDSM17P9yd5loqk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qXAwmabYfH9yXOCSICxCOstNRhG1i0asN_8MIRR4w4Q&oe=6A0B1831"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPZOYAwrGOoQ7kNvwFCE2r3&_nc_oc=AdqjwBmJuUbvv8qDSOpZswvfZLD8WCSwxNRrI0TbbvopEN79zE1RgsfeMyZwA1lDjf8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KHBV4nX_TtmyKKJKBntYutSsoxE97OWH1uvee4e22yw&oe=6A0B0000"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IzrbEGYHIAQ7kNvwHsCNgI&_nc_oc=Adoe3CNxvaFL_s7XxgSucGPQBC_9ehDUqZCUDrG8FWDXmOA7ppU3ee5A_l0cNSn9zOA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xs7NaEOt58eL7wrrVT-yPlBksQiUqWSEQhnbcbJ5fKQ&oe=6A0B1087"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VavzeC-00wQ7kNvwHTTSHT&_nc_oc=AdpIesKotmnUWRtshUP8c14mPrBiaF_hN5hA3xtlukfSSkvbu7aX2HfYPI2bIpkicVY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55u3_5czOeawUVqwEZtOA3-HtvrcmVJremFETny-RNmg&oe=6A0B1652"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W78uiPhtiJMQ7kNvwGKyX6T&_nc_oc=AdojRSe3ZHRjKO3CPbhoGXH-JoosM8LQSXiowtD24ZIRqqlZkF6_05zWOmxugV9sj04&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XLjfN6nb8a-_bMUGeS6YpS9ip6sr3UVCio61NKijAuw&oe=6A16FF4F"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DT3ZKalIkowQ7kNvwF3PyZB&_nc_oc=AdpGs-ZipJmtx7gLLuiir8y62OE0TkLwUmNdtjiNZOu8FYZxcoiCtqgmhFCgz8288Qo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CklL_9WWQ5obAgzQc6OlCp-vs4vFxxbFo83lGVP4l4Q&oe=6A16F5B1"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyRFflqfH0EQ7kNvwHcVotA&_nc_oc=Adp0KBMbhorHRjeBVOxxUzg2Q9ofQrD6o7zPyqwclJ4d8PTmdSGBABRDj2kffc9jy2o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rC05UxD93LdF3jSuPXloS9JpXrLNCCT38Vr899b-LZQ&oe=6A16DD80"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fG6ZnNynyw4Q7kNvwGNYZSh&_nc_oc=AdqiRh9rtsM1eWg4QZ-40dVM7GJQBmAUpqeE2rBo4MH5luk50bjV_vhq-3YIVkASvB8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dNlI3NbgPu8ui6n8fdxuqXFiyelhmIOc-A_poWpXhjw&oe=6A16EE07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OACi-3UF020Q7kNvwF8wuxk&_nc_oc=AdqgZNaV7r-YL-NkiicS4KLWrGmy52nhBsvFzx3HLNxF7ElHVO797VksOz-kZjGlbAg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZyDYc_7KanuZav_9lnlibTDElvIC8W506P3tthbRrAw&oe=6A16F3D2"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
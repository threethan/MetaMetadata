&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sulJJYHvT7oQ7kNvwGESRKB&_nc_oc=Adq20DZH1I-LanER7fS4K-t-6jvlceNt4qe-0FW9PweGc8bHc5ro9HuZfOOLzWL-dH8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1Sd_V4wCAz6z2YLOhvUEFsw6jqg_4HJ_IBETf71JY_gg&oe=69F0C3CF"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxXOxZRQ3SAQ7kNvwGJ4g0q&_nc_oc=AdoaWwIGtPFLC8MQcKvFlsFjsNS5eJLwO2YM8joR3Swkdw0a3m4xGQziQFwRf3GwAvo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1pXrri3lK7zc0Aec7Nbg92BLhovNlXKha3IoytimWehw&oe=69F0BA31"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxKixq43Zv4Q7kNvwFuIyDH&_nc_oc=AdrxoFkNYmaC2UdfxYKfnZ8bKAgUS70dges2xSiBbtgIXVH4dRD5rbKeNDXC2LvfS3A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2tsvMDwvbcz0MGTeSgHg94_hWH-XNqEmGUdxMgRjnt2w&oe=69F0A200"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLhla0e-zfEQ7kNvwGcsFwt&_nc_oc=AdrtdE_Z2qd1wYGJEynDFovzdu2Lp0W8O3SXUldZP7r9yw7FtruiIom4tQNULQnVGsA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1SupakYTErc1yhySt0CqCQnYWbL69ftYZhcmnHi4xNkg&oe=69F0B287"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JR9lmitfeSoQ7kNvwEaew5o&_nc_oc=AdoiHtVqbIUuZ_NlzjeH81GG_yTetw12kLX7MtUxKjmsA-_i51QvQ7_hAb0_8xrJohE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3WPkVmXUZKiwXAjISg0_tzwsWRvQ-8znyw9nq_jxEIdQ&oe=69F0B852"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
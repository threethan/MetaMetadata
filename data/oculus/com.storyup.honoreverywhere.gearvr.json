.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtrUOihhBlAQ7kNvwF4O9K4&_nc_oc=AdrGO_tKJ_LmrMkJ-vCVa3PbiSET4GN8KKokEyczaV4qA_VhDW4fcrLlUKr1LPFz-gs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nB_-yKTPRdP93eIu499VFSEWUIRcB05xSbBPkimv31Q&oe=6A145C4F"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4kfiUUYJKoQ7kNvwFXFF3g&_nc_oc=AdqakPI9zcdcvCe7ByYzGJ49IPyMpum4RGlUjnxbcQRomOtvkERIdjJsIy_tcR42ATw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nVJPwRmrbzllc973NlZhmjSozhOSzFUrR7yyrxjlrfA&oe=6A1452B1"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDXJLU-uRd8Q7kNvwGiU52m&_nc_oc=AdpZNR8xmWdG6M2AIPRXB6R7q3USHHb-54mxP39YFsZVJtpeo6Bj0W1yNmMT03hsFuk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gTNLlJBhD0TCS4JMWsQsgsMIJT07bFUDyvv5HhuiwcA&oe=6A1472C0"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fG6ZnNynyw4Q7kNvwGUkkYQ&_nc_oc=AdqlGAYs2cqNVVOCHhX9MYgkUGVo4Ez97WBx_JXsFyQI1x_0QW_-Vi1vNGrXvaz0SzE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57gJdwR78NC4w4UQ_QZ410ejp7gSivFCWYa5IBhlA8Ug&oe=6A144B07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxJcKmwbul4Q7kNvwFHFk3h&_nc_oc=AdqlcCaGpZn-J71AlQh2eTaOP5v6_SHTLwCFaFtcD3ENzJq3agCiEAQC6MO4_9nI7ZI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WV0NavZtT151OboaiDbm0Qwk2ZKvsdt7u-uX_JnTPUA&oe=6A1450D2"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
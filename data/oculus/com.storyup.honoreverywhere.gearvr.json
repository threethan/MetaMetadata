.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8AN8iRqj0MQ7kNvwHJu2zk&_nc_oc=AdqUZb0Dx2DHg0Za-46Cl2BU4PWDa_AT3TDPs930XtrXXjUtuaQlEiYylLCwTJ4zrXw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHubgkxtxtXpI9KcapJ6BeeFHfWK4KpurUp58Nko3TSLQ&oe=6A7C4A8F"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NiJNl7FJxYQQ7kNvwF6FxVs&_nc_oc=Adr67aBAbZSsKrzj3uNvon9Di7S-P7BY8XBJ1ehjKkw2yNOuPbCqYBG_3MQdzyvy3BA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNUAhR90eOc4TGG0IaKZPqou-J85MKi0VlyMDjIU52JA&oe=6A7C7931"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uVR1jOfoFoQ7kNvwEgjIp_&_nc_oc=AdpDRtqClGDN2m1eoFkNe6suJfqMw8womZmJP1zUXlbiV_D6G3YazUIdgIiEtEWr8ME&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdGS6RjQ4FC3AMu4LQVIqbS0gazWw61M1pXJOWTG3vFA&oe=6A7C6100"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBxnXP8VvkQQ7kNvwGaiOaP&_nc_oc=Adonu7FayVjr5BTAjV3AkdROG31IP1GM0bP4f35KmZbOMnB62-wOdR5Q363bUhRt3iY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzaQkzgiaLIe6oWmi6v3N7j6ABKRsVQg5i_Bmyb5mMUw&oe=6A7C7187"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xmdq38KAWBsQ7kNvwGV9i0k&_nc_oc=AdpOxDGN1i-j0gMVfEkiHAZzHX6Kz_MxtVvaHgksEqm2sQKNOPd2KLwihVdlcY8EUMQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsVXhJYxNRwyVxgxLeg35wqRwDigygQli5Yld8Pl3KRw&oe=6A7C7752"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
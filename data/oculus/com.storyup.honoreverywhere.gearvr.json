.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IOhCW9otZUQ7kNvwFneP8V&_nc_oc=AdpLPadnd2eiiuwYwsLhe_S5o7gypDeqdv6q3oa2vtPUyvcJ_2qCS-5SrKdfz9yqTFs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NUiuodtjTiN4bylu2MZ9Wy2WWhNXSuto4fjpROXf0wg&oe=6A2C174F"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8Ly35t0tNcQ7kNvwHNBilU&_nc_oc=AdrXla8IiQVQUDhep-dNwh8bu988BFtUUzJoIzXeKDsq5k7OfxGiOrXyh-FoG2LEjhM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DyGuys1DhVQG-rzlAorYmbHZfYjpHTns1hiXiUKQX1Q&oe=6A2C0DB1"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lu-fdF4qPX4Q7kNvwF4wth3&_nc_oc=AdodOMnw3OVyebYloeloBs9uh_xQSty6nzfe6YNjpZfWsdpzjujQ1419Jjr1ZpzO5kA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HlOuc5SUlF4qDNLVZSiFWocp-7xccLWCwsaGYfybVlQ&oe=6A2C2DC0"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yrw_Vap1mFIQ7kNvwEpxGME&_nc_oc=Adog1aMtbCRNw7eatV-n3pzH5mrOf5Vbq5E-jV9uOg4ulDh0VGnCLuZIRhvg8qYg24Q&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XEeQyHbaVUYyOETchvfS8reEGc0fsw1M4FBZ1OvMFNg&oe=6A2C0607"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZc7MAbi-H4Q7kNvwF8k96f&_nc_oc=AdpG4rRMGwfPb0386WPjsT0yAgN7tOU_WwUeKe64q3VuasPLY1_SEhyuhbsqz3UpDmE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UV3RGtyMBv5ErzgF0cWJT5mu0O1KmrQPsSXPSRBijDg&oe=6A2C0BD2"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
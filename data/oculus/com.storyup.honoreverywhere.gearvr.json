.oculuscdn.com/v/t64.5771-25/38982494_402082740384263_2099764916368965632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52EHRx1WTdgQ7kNvwEV6UgP&_nc_oc=AdotAUsFROUj82q6AEnW-hDvA_GEH5I9xZLEKC8wDtxmXopCcCPDHri9bLd0u2xlTcw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIkKlx1D0rraGzRcGY_HfiQ32BYOexg9N6SztdmEkl3w&oe=6A58EA4F"}, {"file_name": "migrated_image.png", "id": "237234790765965", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974455_421534641760319_5544987664593190912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Br9VjsGPbxEQ7kNvwEL_wq2&_nc_oc=AdpnOpQziBs8gxMf5t5JcArw40GvVLK6NLZieqa0o2N6WaQiTwUQKrafyYbUPkpFmrs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlQ8MmiPEtjr-kXehHa56ACu3jeDvdcyAF5waGlKG2Hw&oe=6A58E0B1"}, {"file_name": "migrated_image.png", "id": "215024553074835", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001682_430579481095544_8380186269212213248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1J0hmeS7a8Q7kNvwGNroTz&_nc_oc=AdpKgjUg7xsi1Ta3RnrMbpqhtELDcgk-lc_7FrpOnH9EiCDAg4_2S3endmP8TeimDIw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIuqDoLUjgCAkpQDB8q0TaTle5vtDx9jBV-2Hl6ovauw&oe=6A58C880"}, {"file_name": "migrated_image.png", "id": "203612227570948", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982464_2120312171414891_1326067806860476416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-seC_CEVUwIQ7kNvwE_wNA1&_nc_oc=AdrLyZ5UUMWpxlFAciHHtBb-Xo8VO6pg6J6suA3z5VC00IB3Gs4scjIQ2fZnKLNdRLc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWZ5Q7H3LsyzLOkZRYKf2kNWT7PQeS2o5GTjIzCHn4Rw&oe=6A58D907"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Honor Everywhere Thumbnail.png", "id": "602672414813535", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031347_602672418146868_7362715714717462095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Np1cdwJkAeMQ7kNvwHp8QTi&_nc_oc=AdrYh5xZ1utpPP_7xMmDtTrJxwyBxZRkppIxQHWQku2340b7F_iYp9t9IjQttq3kBqQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDm6_u_C6zwo1YbS_XhW6t8uB8y5P5pkw9VynCycHbxiQ&oe=6A58DED2"}, "display_name": "Honor Everywhere", "keywords": ["honorflight", "honoreverywhere", "veterans", "military", "memorials"], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by StoryUp Studios, the makers of Healium, Ohio Hospice-American Pride, Central MO Honor Flight, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://tryhealium.com/terms-and-conditions", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "h
tent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpeVParpDw7ADOSgjuzMmDDdMHh_Llld6qdd1OFfqDtw&oe=6AFC6BC0"}, {"file_name": "s4.png", "id": "991463765203434", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75340709_991463768536767_1820919817072797948_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2oFl-saM-CUQ7kNvwFznGFk&_nc_oc=AdpVICEe79JFetHf8DKwiiYs5NgQ8s7Qa2VzFrOyq_1kQdNUKlkfUrgu6ya_mxxTeyU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQccuvyDteWrrj7gzGzrFyHssqz1KcB6jt0pqGRL2cL6Q&oe=6AFC796A"}, {"file_name": "s6.png", "id": "3487526948177347", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348044_3487526951510680_8921255787437687413_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wovW6CwDZQQ7kNvwHFmKzs&_nc_oc=AdrF_GyG-VNeJjnFUXP9HYaSLORAd5xX8_OZg_w5i4DduRFzsIkrDKyS9tqnzk0o39c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIow6YqPy8XLtv67ZfmWjddHoQ_hP3vvK-BvBVjFEArw&oe=6AFC8F4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_thumb.png", "id": "9405277959546547", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974902_9405277962879880_1783697676320474761_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGqy9BINh8gQ7kNvwGHdjO2&_nc_oc=Adp-BtCmurRE6NUHUxZ-ItM03YgTIEx0rOgJPU57lxQsQxNVrS695QJuJ3VkIXNVyKI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdPR9TV8V--PGBNNpAW8u9C_y89cSb6feNRb5rGnRnLg&oe=6AFC8FFB"}, "display_name": "Hard Line", "keywords": [], "long_description": "Immerse yourself in an exhilarating virtual reality adventure that pays homage to the classic action films of the past. You step into the shoes of a fearless hero facing a harrowing challenge.\n\nTerrorists have seized control of a sprawling skyscraper, holding innocent hostages captive within its towering walls. As the lone warrior who can save the day, it is your duty to navigate each treacherous floor, confronting relentless enemies with swift precision and tactical prowess.\n\nWith every enemy you kill and with every hostage you rescue, you earn XP that can be used to unlock various weapons and upgrades.", "short_description": "Prepare for an intense VR experience as you step into the shoes of a courageous hero in a high-rise nightmare. Your mission is clear: rescue hostages, neutralize ruthless terrorists, and ascend through the floors of a besieged skyscraper. With each floor conquered, unlock new gear and confront a relentless mastermind in a heart-stopping rooftop showdown. Will you save the day or succumb to the chaos?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://visceract.com/vr/hardline/privacy", "developer_terms_of_service_url": null, "publisher_name": "Visceract", "support_website_url": null, "website_url": "https://visceract.com/vr/hardline", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2331650073682539"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1396948765975233"}, {"status": "PUBLISHED", "id": "2627940497603708"}, {"status": "PUBLISHED", "id": "1165743118837292"}, {"status": "PUBLISHED", "id": "1179890317527621"}, {"status": "PUBLISHED", "id": "2477815789287436"}, {"status": "PUBLISHED", "id": "1036478854725803"}, {"status": "PUBLISHED", "id": "284598253950041"}]}, "baseline_offer": {"id": "284598253950041"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1396948765975233"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29335660089363249", "version": "0.9.2"}, "id": "4714592611998371", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6450472471642002", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29335660089363249"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4714592611998371"}]}, "change_log": "Hard Line 0.9.0\n\nNew\n\u2022 Bullet Time. Slow down time like a real action movie. Earn bullet time as you take out hostiles\n\u2022 Better impact particles: glass, blood and wall\n\u2022 Better bullet trail effect. looks awesome in slowmotion\n\u2022 Health packs now spawn around, you can pick up to get 25% health back\n\u2022 New Upgrade: More Max health\n\u2022 New Upgrade: More bullet time\n\u2022 Added music. muteable in the settings\n\u2022 Added setting for adjusting snap turn amount\n\u2022 Depending on which hand hold the weapon, the magazine will now show on the opposite side\n\u2022 Kicking can now knock over hostiles\n\nFixed\n\u2022 Fixed issue with the game softlocking when the boss destroyed itself during XP count-up\n\u2022 Tased Hostiles now recover if tasing stopped. They also dont snap back, but smoothly animate into position\n\u2022 knocked-out hostile who is shot no longer flickers between \u201cknocked out\u201d and \u201clast breath\u201d every frame.\n\u2022 grabbing or hitting a dead, unconscious, dying or tased NPC no longer forces the \u201cbeing grabbed\u201d combat state. Corpses don\u2019t pop back up, and dragging a NPC doesn\u2019t reset his knock-out timer.\n\u2022 when the smoke ends, only NPCs it actually blinded are restored. Surrendering, dead or fighting NPCs keep their state.\n\u2022 Tasing a hostage or the helicopter no longer throws an error or leaves the taser stuck.\n\u2022 Armour levels already picked are now restored on load, so they aren\u2019t offered again.\n\u2022 A more secure savesystem\n\u2022 Optimized Bullets\n\u2022 Fixed a crash when a gun sound was missing\n\u2022 the player only counts as inside when their feet are in the elevator, so leaning in or out no longer starts or stops it.\n\u2022 after 2 minutes the game shows the \u201cEnter the Elevator\u201d prompt but stays in the lobby state. The lobby no longer counts as a cleared floor.\n\u2022 Picking \u201cnone\u201d on attachments now survives a restart.\n\u2022 Fixed issues with repeating upgrades appearing on level-up screen\n\u2022 Made some general optimizations to the hostiles, the game master and the npc behaviours\n\u2022 Extended mag upgrade now clears the old magazine waiting in the holster\n\u2022 the wake up sound of knocked out hostiles is no longer cut off\n\u2022 a hostile grabbed a second time looks toward the grab again, and a crouching hostile stands up when grabbed.\n\u2022 Hostile difficulty no longer reset if you exit the game and return again\n\u2022 Lower hostile accuracy now actually gives less XP\n\u2022 Shown tutorial text is now stored, so it doesnt show again the next time you play\n\u2022 Fixed the issue with hostiles flying up in the air when killed while kneeling\n\u2022 Fixed issue with shells sometimes not being loadable into the shotgun", "created_date": 1794153189, "id": "29335660089363249", "version": "0.9.2", "version_code": 21, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6450472471642002", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29335660089363249"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4714592611998371"}]}, "change_log": "Hotfix v0.8.1\n\n* Doors now stops projectiles, except for glass doors\n* Bad guys no longer thinks they can see the player through walls and doors\n* Weapons no longer fire, if sticking through walls\n* When dying, you now only lose 25% of your XP. Not all of it", "created_date": 1716497436, "id": "7816504445038791", "version": "0.8.1", "version_code": 17, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6450472471642002", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29335660089363249"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4714592611998371"}]}, "change_log": "Update 10 is now Live! \nBringing you weapon attachments from suppressors, to scopes and red dot sights.\n\nUnlock attachments by using the designated weapons.", "created_date": 1713902806, "id": "7672504152772155", "version": "0.8.0", "version_code": 16, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6450472471642002", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29335660089363249"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4714592611998371"}]}, "change_log": "Update 9 is finally here!\n\n\n\nIn this update I have focused on improving the graphics and added in various unique floors to the skyscraper.\n\nMoreover, improvements to the AI has been made. The AI should now be more responsive and communicate with eachother.", "created_date": 1706893862, "id": "7337589229596984", "version": "0.7.1", "version_code": 15, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6450472471642002", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29335660089363249"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4714592611998371"}]}, "change_log": "Update 8 is now Live!\n\nUpdate log:\n* Added Shotgun: 590A1\n* Added Glock G22\n* Added Knife and stealth takedowns\n* Added the ability to kick in doors and bad guys (press right joystick to kick)\n* Added Riot shield (unlockable after unlocking kevlar lvl 4)\n* Added Voice for when the player gets hit\n* Added setting for swapping left and right controls\n* Enemy might not die, but slowly bleed out now. You can either leave them be or put them out of their misery.", "created_date": 1700165308, "id": "7050770374945539", "version": "0.6.0", "version_code": 13, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
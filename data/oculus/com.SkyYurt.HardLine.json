861984515843_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1y3RRiThGBAQ7kNvwEaFUWx&_nc_oc=Adq0ERPyfhDfpGlSUhNhgZSDTnM3UqpomugdS8CGmRFqZpJlrPUpdV2DuLO-dkU1jRU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-SWCzlycoM70TWp_XsZ_XGcyQdg2FdyYIIbMoi9ELxQ&oe=6AFC7F77"}, {"file_name": "Screenshot 2024-02-02 182100.png", "id": "1543072812900768", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75330716_1543072816234101_3151295688834707869_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DE2Ok4TROYQQ7kNvwEMaN96&_nc_oc=Adp8kXHB3lJ00GYdLA2mpdfkxCP4BoImFIVmevP9Z6_Nw2I8Joa2gToy1kDLyLCwTi8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoDJuHyfl_YQr5BtbSXoURwSF3HNe-dce9QhItZwmBJg&oe=6AFC625A"}, {"file_name": "Screenshot 2025-12-29 221310.png", "id": "879552294610197", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824328_879552297943530_5073659680605625543_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsxmdcjhwp8Q7kNvwFpsQr6&_nc_oc=Adpbn_sJDU88axnLUUstIF37XIgrbGGsvFfy88LQIVotTdfoRduIytg1xLXKrTBBbSE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRDClm6zhJyiaNZAqyfK9uzfCKzJbmJbvFaJFF4306TA&oe=6AFC73EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1187270480161087", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823270_1187270483494420_9222767863383087296_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPHUHXwJJ28Q7kNvwFqpdtJ&_nc_oc=Adq-8urp_7HcCHBezs6npqQ1HcBJefKzkvXIIIpLXe9Ndl1sWuCy5Xt8YzL_wsYIUD0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROaHFWeQMEB2GukTP-agRNoI6XdH7tjkuqBPNx57lD7w&oe=6AFC6F2D"}, "display_name": "Hard Line", "keywords": [], "long_description": "Immerse yourself in an exhilarating virtual reality adventure that pays homage to the classic action films of the past. You step into the shoes of a fearless hero facing a harrowing challenge.\n\nTerrorists have seized control of a sprawling skyscraper, holding innocent hostages captive within its towering walls. As the lone warrior who can save the day, it is your duty to navigate each treacherous floor, confronting relentless enemies with swift precision and tactical prowess.\n\nWith every enemy you kill and with every hostage you rescue, you earn XP that can be used to unlock various weapons and upgrades.", "short_description": "Prepare for an intense VR experience as you step into the shoes of a courageous hero in a high-rise nightmare. Your mission is clear: rescue hostages, neutralize ruthless terrorists, and ascend through the floors of a besieged skyscraper. With each floor conquered, unlock new gear and confront a relentless mastermind in a heart-stopping rooftop showdown. Will you save the day or succumb to the chaos?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://visceract.com/vr/hardline/privacy", "developer_terms_of_service_url": null, "publisher_name": "Visceract", "support_website_url": null, "website_url": "https://visceract.com/vr/hardline", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25717971754465452"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771
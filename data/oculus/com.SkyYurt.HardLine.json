ZeiZ9-CGAUZmdafI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWIJvHOcd8dY1II1o6vXIzH--eXRHHBHUB5VWLF6jHIYA&oe=6B103EE9"}, {"file_name": "s3.png", "id": "212604821692391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75441580_212604828359057_6481911723231200978_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duqi0KFruqYQ7kNvwEfVwbf&_nc_oc=Adrd5ZoU_puUAGz44uddW8gQ39G6pLmDPE3WR3qtaEtwoWaNz2gfbAWqXZwDTelDDEg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWa0bXHsWEPj7cf76msTsze9J-u1NoIlAfEiAHsZXnC7Q&oe=6B106A80"}, {"file_name": "s4.png", "id": "991463765203434", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75340709_991463768536767_1820919817072797948_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UmRAspMshIQ7kNvwE8BqNU&_nc_oc=AdroCVTuX8aK-5Os_BXcxZ3LX762tsy6yulPwyohMDtx-facTD5YOgTAd05aZp1A7YM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQULv5twmHiYBOn49_X8ObZCQDlAqOUz51jaI1RV9w80Dg&oe=6B103FEA"}, {"file_name": "s6.png", "id": "3487526948177347", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348044_3487526951510680_8921255787437687413_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxkBxRBV9S4Q7kNvwH7yzmZ&_nc_oc=AdpYTQlfqSsvezuudq5T8n2ORfCBhueMEcAM5W33ejGMkELnOW5xlMSEqE3DhjeJGrA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUDosplZLkbp0HzTewrJxbJ8Ie-OhMJP2y4AO6GWtujeg&oe=6B1055CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_thumb.png", "id": "9405277959546547", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974902_9405277962879880_1783697676320474761_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuQKQ3yunU0Q7kNvwFculHL&_nc_oc=AdoXC8Oua9yqbcelTKBS74cwUTND7yzwYKHzXdCCdgu5g2C6iMfcsPCHvk9R7YwYvQI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV6lt1Pb4c9iXUaTp512FNoC9TEW4zz1pX-qNMEkTkCXg&oe=6B10567B"}, "display_name": "Hard Line", "keywords": [], "long_description": "Immerse yourself in an exhilarating virtual reality adventure that pays homage to the classic action films of the past. You step into the shoes of a fearless hero facing a harrowing challenge.\n\nTerrorists have seized control of a sprawling skyscraper, holding innocent hostages captive within its towering walls. As the lone warrior who can save the day, it is your duty to navigate each treacherous floor, confronting relentless enemies with swift precision and tactical prowess.\n\nWith every enemy you kill and with every hostage you rescue, you earn XP that can be used to unlock various weapons and upgrades.", "short_description": "Prepare for an intense VR experience as you step into the shoes of a courageous hero in a high-rise nightmare. Your mission is clear: rescue hostages, neutralize ruthless terrorists, and ascend through the floors of a besieged skyscraper. With each floor conquered, unlock new gear and confront a relentless mastermind in a heart-stopping rooftop showdown. Will you save the day or succumb to the chaos?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://visceract.com/vr/hardline/privacy", "developer_terms_of_service_url": null, "publisher_name": "Visceract", "support_website_url": null, "website_url": "https://visceract.com/vr/hardline", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2331650073682539"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "4274593422684941"}, {"status": "PUBLISHED", "id": "1396948765975233"}, {"status": "PUBLISHED", "id": "2627940497603708"}, {"status": "PUBLISHED", "id": "1165743118837292"}, {"status": "PUBLISHED", "id": "1179890317527621"}, {"status": "PUBLISHED", "id": "2477815789287436"}, {"status": "PUBLISHED", "id": "1036478854725803"}, {"status": "PUBLISHED", "id": "284598253950041"}]}, "baseline_offer": {"id": "284598253950041"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "4274593422684941"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29567566206172635", "version": "0.9.7"}, "id": "4714592611998371", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6450472471642002", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29567566206172635"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4714592611998371"}]}, "change_log": "Hard Line Update 12 - All Physical\n\nNew\n\u2022 You can now reset stats via the settings\n\u2022 Redesigned the UI to look better\n\u2022 Objects like screens, keyboards, books, pictures, etc. can now be shot or pushed around or even grabbed and thrown at guards. Screens will glitch and go black when shot\n\u2022 Glass walls can now shatter after getting shot multiple times.\n\u2022 Guards hear props falling and will investigate\n\u2022 Bullet holes\n\u2022 Handcuffing a bandit in heavier body armour now earns more XP, just like taking them down does.\n\u2022 Bandits who end up too close to you now back off to a firing position instead of freezing in place.\n\u2022 Comfort Vignette setting (Off / Low / High): the view narrows softly while you move with the stick or turn smoothly, to reduce motion sickness.\n\u2022 Shooting furniture now looks and sounds like what it's made of: wood splinters off desks and shelves, metal sparks off racks and kitchen gear, fluff off sofas, and plastic hits on plastic tables.\n\u2022 Once a floor is cleared, the objective reminds you how many hostages that are still cuffed, that you can rescue.\n\u2022 Censor mosaics effect toggleable on npc faces and blood\n\u2022 New random encounter: stuck elevator\n\u2022 New floor: an open-space office on fire. Dodge the flames (they burn you and the bandits), fight through the smoke, and watch the blaze slow down in bullet time.\n\nFixed\n\u2022 Fixed guards awareness. They should be more aware of you now.\n\u2022 The guards FOV now also increases when you are closer to them\n\u2022 Fixed the elevator music getting muted when you mute the game music. Added a seperate setting for muting the elevator music.\n\u2022 Made some fixes to how height calibration works.\n\u2022 Increased the volume of guards VOs, so they can be heard even when music plays\n\u2022 Yelling \"Freeze!\" only makes bandits you can see surrender (glass doesn't block the view); bandits in other rooms hear you and come looking instead.\n\u2022 Guards on a new floor no longer start out getting up, turning toward an old gunshot, or opening fire before they see you.\n\u2022 Handcuffs no longer snap back onto a hostage after you free them.\n\u2022 Handcuffing a bandit who is already dead no longer counts as killing a cuffed bandit or costs you XP.\n\u2022 Bullets no longer hit the invisible barrier at the rooftop edge: you can shoot the helicopter from anywhere on the roof, and its shots can reach you.\n\u2022 Guards no longer stop reacting to gunfire and \"Freeze!\" calls after checking out their first noise. They now come after every shot they hear, so fights are tougher.\n\nImproved\n\u2022 Dying now costs 15% of your banked XP, instead of 25%, and the game-over screen shows exactly how much you lost.\n\u2022 Bandits now lower their gun smoothly into the holster instead of it teleporting there, when they die\n\u2022 Made some optimizations to the bandits\n\u2022 Restarting after death or finishing the game now fades smoothly to black and back into the lobby.\n\u2022 The game now pauses automatically when you open the Meta menu or take off your headset, so you come back to a frozen fight instead of a game over.\n\u2022 Bullet time is smoother: starting it no longer causes a small hitch, and every sound, including new hits and voices, is slowed from its very first moment.\n\u2022 Improved the handcuff model and made improvements so the handcuffs fit the npcs wrists better", "created_date": 1795623650, "id": "29567566206172635", "version": "0.9.7", "version_code": 26, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6450472471642002", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29567566206172635"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4714592611998371"}]}, "change_log": "Hard Line 0.9.0\n\nNew\n\u2022 Bullet Time. Slow down time like a real action movie. Earn bullet time as you take out hostiles\n\u2022 Better impact particles: glass, blood and wall\n\u2022 Better bullet trail effect. looks awesome in slowmotion\n\u2022 Health packs now spawn around, you can pick up to get 25% health back\n\u2022 New Upgrade: More Max health\n\u2022 New Upgrade: More bullet time\n\u2022 Added music. muteable in the settings\n\u2022 Added setting for adjusting snap turn amount\n\u2022 Depending on which hand hold the weapon, the magazine will now show on the opposite side\n\u2022 Kicking can now knock over hostiles\n\nFixed\n\u2022 Fixed issue with the game softlocking when the boss destroyed itself during XP count-up\n\u2022 Tased Hostiles now recover if tasing stopped. They also dont snap back, but smoothly animate into position\n\u2022 knocked-out hostile who is shot no longer flickers between \u201cknocked out\u201d and \u201clast breath\u201d every frame.\n\u2022 grabbing or hitting a dead, unconscious, dying or tased NPC no longer forces the \u201cbeing grabbed\u201d combat state. Corpses don\u2019t pop back up, and dragging a NPC doesn\u2019t reset his knock-out timer.\n\u2022 when the smoke ends, only NPCs it actually blinded are restored. Surrendering, dead or fighting NPCs keep their state.\n\u2022 Tasing a hostage or the helicopter no longer throws an error or leaves the taser stuck.\n\u2022 Armour levels already picked are now restored on load, so they aren\u2019t offered again.\n\u2022 A more secure savesystem\n\u2022 Optimized Bullets\n\u2022 Fixed a crash when a gun sound was missing\n\u2022 the player only counts as inside when their feet are in the elevator, so leaning in or out no longer starts or stops it.\n\u2022 after 2 minutes the game shows the \u201cEnter the Elevator\u201d prompt but stays in the lobby state. The lobby no longer counts as a cleared floor.\n\u2022 Picking \u201cnone\u201d on attachments now survives a restart.\n\u2022 Fixed issues with repeating upgrades appearing on level-up screen\n\u2022 Made some general optimizations to the hostiles, the game master and the npc behaviours\n\u2022 Extended mag upgrade now clears the old magazine waiting in the holster\n\u2022 the wake up sound of knocked out hostiles is no longer cut off\n\u2022 a hostile grabbed a second time looks toward the grab again, and a crouching hostile stands up when grabbed.\n\u2022 Hostile difficulty no longer reset if you exit the game and return again\n\u2022 Lower hostile accuracy now actually gives less XP\n\u2022 Shown tutorial text is now stored, so it doesnt show again the next time you play\n\u2022 Fixed the issue with hostiles flying up in the air when killed while kneeling\n\u2022 Fixed issue with shells sometimes not being loadable into the shotgun", "created_date": 1794153189, "id": "29335660089363249", "version": "0.9.2", "version_code": 21, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6450472471642002", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29567566206172635"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4714592611998371"}]}, "change_log": "Hotfix v0.8.1\n\n* Doors now stops projectiles, except for glass doors\n* Bad guys no longer thinks they can see the player through walls and doors\n* Weapons no longer fire, if sticking through walls\n* When dying, you now only lose 25% of your XP. Not all of it", "created_date": 1716497436, "id": "7816504445038791", "version": "0.8.1", "version_code": 17, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6450472471642002", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29567566206172635"}, "release_status": "RELEASED"}, "binary_relea
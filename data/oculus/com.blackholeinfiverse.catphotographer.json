54166133_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBTrR7fWBr4Q7kNvwFWNuam&_nc_oc=AdpZNSPEsxFjqBj8lJPmufSmj2SudekZ1LX1_X-xJgyHGjp05hzPf39uQkFcaI8sFos&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuUTa_uxEtHJPHIbbl_VB7IYEM7Yy72uxxPBIGads02g&oe=6B09C549"}, {"file_name": "Cafe.png", "id": "2054111995254528", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593849888_2054111998587861_5908255327092159706_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ht7Gu5EjvBEQ7kNvwEe2GNd&_nc_oc=Adpd318EHRw7NUglCaXtbDg4I-AqR8bvy0nSje8Kt7BaSHrMNtDCTFUAMhn2HHUYD6A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRU9Z6Qf6bHhJqI8241S0T1kFSyaqf5I_86KLlYJAoRNw&oe=6B09CCB5"}, {"file_name": "Cafe_wall.png", "id": "2267876270614254", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499624069_2267876277280920_2472342023144079741_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkTwcbtow84Q7kNvwFTp4RW&_nc_oc=AdoToQVUP98okb3_szIbw2_3-RINjxGLu71v-RkmYgU_kpq4_t8Boyvauk7HfDBb8H4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR49QCU1SsElaGKp0UP2KIfesIzGEkheYsy5aW4UJCahQ&oe=6B09A950"}, {"file_name": "Garden.png", "id": "1795800791739329", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499623876_1795800795072662_4833801198535317836_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1USUAyZds7gQ7kNvwEzKoEu&_nc_oc=AdqHaszCDhE0dizQhTT9BzvSaiqPu3rFtnf5-8CxYQjtYYUzUoJNTh1I5WvLak3HNxk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSF4M0Twd24xsXJxQO2MSLopgA5kcSl0pP2JgIvViCidQ&oe=6B09A21D"}, {"file_name": "Pond.png", "id": "2393732231034255", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499628016_2393732234367588_6389994923143211851_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qA857Hs9TAEQ7kNvwE3elpM&_nc_oc=AdozC6lY_AdXe2IaQNhKnWI0ydPsk_RE_XP2sY1-XEIuPdbR9rUghoeDPyHGGM-JdFE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVK-QoLrvGnnTVBe_BlJPI8vQqqP1WmDAstCfzp7RhxA&oe=6B099C2F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cat Photographer", "keywords": ["pets", "cute", "relaxing", "cat", "kitten"], "long_description": "\ud83d\udc31 Step into a charming VR caf\u00e9 and become a cat photographer! In Cat Photographer, your goal is simple - find adorable cats, capture the perfect moments, and prove your photography skills.\n\nExplore the environment as cats appear, walk around, and disappear before you can get the perfect shot. Use your VR camera to carefully frame each cat and capture photos before the 2-minute round ends. Photos are evaluated based on whether the cat is properly visible, including having at least one eye visible.\n\nOnce the timer ends, return to the caf\u00e9 and submit your photographs. Your captured photos are displayed on the caf\u00e9's result board, where you can see your score and review your best shots.\n\nWith a cozy caf\u00e9 hub, playful cats, VR photography mechanics, and a simple scoring system, Cat Photographer offers a fun and casual VR experience focused on exploration, timing, and capturing the perfect cat photo.", "short_description": "Cat Photographer is a cute and relaxing VR photography game where players explore a charming caf\u00e9  & garden and capture adorable cats on camera. Find cats, take the perfect photos before time runs out, and return to the caf\u00e9 to review your pictures and earn a score."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blackholeinfiverse88-spe.github.io/Cat-Photographer/", "developer_terms_of_service_url": null, "publisher_name": "Sharcon Gaming ", "support_website_url": null, "website_url": "https://blackholeinfiverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categor
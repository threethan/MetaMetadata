54166133_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOFZZXVZr8IQ7kNvwFMEuPr&_nc_oc=AdplJ3aM9JWQMzXpl6mZXq1xAieojbY5Kpi8vrdX_pMH5HjJKeMvhLRgqUs7aL_ESCA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkW53Thd-Owf2fq1jgG7Omwe4BdkqPfpItIFJWSrrdFg&oe=6B05D0C9"}, {"file_name": "Cafe.png", "id": "2054111995254528", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593849888_2054111998587861_5908255327092159706_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxNhUgGLU8sQ7kNvwF6c2-L&_nc_oc=AdqAGnvhE8tZJBOtvIZ2xaE2OYFOohuBc6pBK5qmpl_tkHSjrPQ2TExVSRnF5KyEKKw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTl4ajdWhQAMFZZk0quWfRWo8a0steA-JNPxasA-toT0g&oe=6B05D835"}, {"file_name": "Cafe_wall.png", "id": "2267876270614254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624069_2267876277280920_2472342023144079741_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BApOdKWvSDMQ7kNvwHm8RY4&_nc_oc=AdrOSRK0xVIQnHSVZnzCQNm68kbY74E0LtUg-GQmHwlKrzmwpskFEciR4fZ1uFo0WCA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYC_csjYFoY33lPHB6ibuIo_k9HbznSlW4IvZGlMGEnA&oe=6B05B4D0"}, {"file_name": "Garden.png", "id": "1795800791739329", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623876_1795800795072662_4833801198535317836_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlSEatp3ARwQ7kNvwGJ29lQ&_nc_oc=AdpzZaKavPNAY3105tJAvc1kGSK-FNx7Xp9tqjp1Etjh0RF3CBbD7L-_Nu4r1PZ8muU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRyGOm2RlUd8gM1MAFUKUTYzVUv226mWKncz9e-kZE9A&oe=6B05AD9D"}, {"file_name": "Pond.png", "id": "2393732231034255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628016_2393732234367588_6389994923143211851_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBjvEzH63s0Q7kNvwE60aLB&_nc_oc=AdpN2gw6ZwEgil3ZAdhVkUYTOglbx3FAlpI_1aCg-gMz_SFH3kMpN8MYn1xFV2rFdVM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKmavx0PicVy5BvScf9qsT_ThzaL35X2lH0F-GO0TSyA&oe=6B05A7AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cat Photographer", "keywords": ["pets", "cute", "relaxing", "cat", "kitten"], "long_description": "\ud83d\udc31 Step into a charming VR caf\u00e9 and become a cat photographer! In Cat Photographer, your goal is simple - find adorable cats, capture the perfect moments, and prove your photography skills.\n\nExplore the environment as cats appear, walk around, and disappear before you can get the perfect shot. Use your VR camera to carefully frame each cat and capture photos before the 2-minute round ends. Photos are evaluated based on whether the cat is properly visible, including having at least one eye visible.\n\nOnce the timer ends, return to the caf\u00e9 and submit your photographs. Your captured photos are displayed on the caf\u00e9's result board, where you can see your score and review your best shots.\n\nWith a cozy caf\u00e9 hub, playful cats, VR photography mechanics, and a simple scoring system, Cat Photographer offers a fun and casual VR experience focused on exploration, timing, and capturing the perfect cat photo.", "short_description": "Cat Photographer is a cute and relaxing VR photography game where players explore a charming caf\u00e9  & garden and capture adorable cats on camera. Find cats, take the perfect photos before time runs out, and return to the caf\u00e9 to review your pictures and earn a score."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blackholeinfiverse88-spe.github.io/Cat-Photographer/", "developer_terms_of_service_url": null, "publisher_name": "Sharcon Gaming ", "support_website_url": null, "website_url": "https://blackholeinfiverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categor
54166133_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28fbUS5H-eMQ7kNvwEelkka&_nc_oc=AdrolLRFuyMoTKNXNTJy4rJ5PeaX42vb6iB4xdH1x7ZWY9kyW-fai2OEC2rD-Jkgn_Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbhHgf6dlGCd3fi7UkrHYuu12sKH0rRr2ha_vM9PUvtw&oe=6AFDAF89"}, {"file_name": "Cafe.png", "id": "2054111995254528", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593849888_2054111998587861_5908255327092159706_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RT6jm9aCoqwQ7kNvwGQW6vL&_nc_oc=Adp6CdWlNUz-RZ5_6tQ8kKcGRkHS5lXw2W9w0dyo1jAFheSyRCklIG7c-dRHNFyrbfU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReL8T3wY_KSIjN-P3FrRGnk6KKsrLYGr_2jaTvuCFWFg&oe=6AFDB6F5"}, {"file_name": "Cafe_wall.png", "id": "2267876270614254", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624069_2267876277280920_2472342023144079741_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqQuvVYXCP4Q7kNvwEJ1lZN&_nc_oc=AdrLSaEKQ6e8u95_lpmy2AlAQtffF4i-Q6tFh_xiGA-fpmzL85dEP0o8WE7I2u5BWjU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMfzs7Z2H80V9MlqwL7asS6__Bn6kfgPjGn1qC6xkfnQ&oe=6AFDCBD0"}, {"file_name": "Garden.png", "id": "1795800791739329", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623876_1795800795072662_4833801198535317836_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrX_WqkO9kUQ7kNvwGIWZmF&_nc_oc=Adq9kmadHIeOFhlayqQVBFEAA55NpsePRpO17PYxBozMozpU-5T1THVmXBQ9tZ5TuNc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQw8txHyQ3Jv3y3YJtBeeJJYgP9J8HIjN6RCjc8PKphCw&oe=6AFDC49D"}, {"file_name": "Pond.png", "id": "2393732231034255", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628016_2393732234367588_6389994923143211851_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MygE30PntAcQ7kNvwGEhnEH&_nc_oc=AdqUn9t-_3ah74DvREb1rTE6UAqFJAiMK44is3xU7QepuOY40-QsGpl1ieOg7dYXj3A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-W7WeMCF6fLPz73CYWIEfIImZ9nK7O3xtm40vqz8gUw&oe=6AFDBEAF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cat Photographer", "keywords": ["pets", "cute", "relaxing", "cat", "kitten"], "long_description": "\ud83d\udc31 Step into a charming VR caf\u00e9 and become a cat photographer! In Cat Photographer, your goal is simple - find adorable cats, capture the perfect moments, and prove your photography skills.\n\nExplore the environment as cats appear, walk around, and disappear before you can get the perfect shot. Use your VR camera to carefully frame each cat and capture photos before the 2-minute round ends. Photos are evaluated based on whether the cat is properly visible, including having at least one eye visible.\n\nOnce the timer ends, return to the caf\u00e9 and submit your photographs. Your captured photos are displayed on the caf\u00e9's result board, where you can see your score and review your best shots.\n\nWith a cozy caf\u00e9 hub, playful cats, VR photography mechanics, and a simple scoring system, Cat Photographer offers a fun and casual VR experience focused on exploration, timing, and capturing the perfect cat photo.", "short_description": "Cat Photographer is a cute and relaxing VR photography game where players explore a charming caf\u00e9  & garden and capture adorable cats on camera. Find cats, take the perfect photos before time runs out, and return to the caf\u00e9 to review your pictures and earn a score."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blackholeinfiverse88-spe.github.io/Cat-Photographer/", "developer_terms_of_service_url": null, "publisher_name": "Sharcon Gaming ", "support_website_url": null, "website_url": "https://blackholeinfiverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categor
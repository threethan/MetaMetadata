54166133_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYikzCl3IdMQ7kNvwHXxR3F&_nc_oc=AdrovQ3ukSSoRAbqzrhGfyF9vNgMd3t_hmYr7PLQCTEs1QLZrZRSkGlh1ovh5wfMG98&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUv0jbrafWCPzBg3fQ01vLswJbjfQgtcOpSOdUa13LL4Q&oe=6B0F0B49"}, {"file_name": "Cafe.png", "id": "2054111995254528", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593849888_2054111998587861_5908255327092159706_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVk8r80E7LQQ7kNvwEeglAY&_nc_oc=AdqRWSNhz-Uq1VD8eHpBRHVTwfYmhIAvyQTq6cq7jwMlEFoGQ1XCWp77eHzpFPFjiH0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUrTIg682U1cQXnBB1oCy5PIOiAIeZOzPmtjjsVO_eQhw&oe=6B0F12B5"}, {"file_name": "Cafe_wall.png", "id": "2267876270614254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624069_2267876277280920_2472342023144079741_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3kO07ZsxWoQ7kNvwFBEjlw&_nc_oc=Adoa2kOZzLP2sE4zXFWgwp7nS9c1ANLFinGXqUxORgmi0qDYjOHwiDSie6qGK6CjR7E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVpcAe6BNaQWSkaFU2SihRk4F7NQEA_Vv631HMbXkKLhQ&oe=6B0EEF50"}, {"file_name": "Garden.png", "id": "1795800791739329", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623876_1795800795072662_4833801198535317836_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVMFP5uJ3TIQ7kNvwGT8org&_nc_oc=AdocIT_yKR-29vnh7DWS5kmvO4De0K1N8emereKCezgogpsQ5eKNY_yGcEr-C-yFFeg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXLtRYtR7kXUYCJDT9aHAFqzLzxmdMZbwZ2HFA3X90sAQ&oe=6B0F205D"}, {"file_name": "Pond.png", "id": "2393732231034255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628016_2393732234367588_6389994923143211851_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5sk3TJjVsgQ7kNvwFc6XDT&_nc_oc=AdoNorQLCsGAQviUB7xMMDUmz4yENeRV37oNQIbkEsQojfmqAbUc_Yjl-DpqNh6ftSM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVIfnXe9IEpTlileyK4ItAzJV1a-mh-Wf1mb6zwXXkaww&oe=6B0F1A6F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cat Photographer", "keywords": ["pets", "cute", "relaxing", "cat", "kitten"], "long_description": "\ud83d\udc31 Step into a charming VR caf\u00e9 and become a cat photographer! In Cat Photographer, your goal is simple - find adorable cats, capture the perfect moments, and prove your photography skills.\n\nExplore the environment as cats appear, walk around, and disappear before you can get the perfect shot. Use your VR camera to carefully frame each cat and capture photos before the 2-minute round ends. Photos are evaluated based on whether the cat is properly visible, including having at least one eye visible.\n\nOnce the timer ends, return to the caf\u00e9 and submit your photographs. Your captured photos are displayed on the caf\u00e9's result board, where you can see your score and review your best shots.\n\nWith a cozy caf\u00e9 hub, playful cats, VR photography mechanics, and a simple scoring system, Cat Photographer offers a fun and casual VR experience focused on exploration, timing, and capturing the perfect cat photo.", "short_description": "Cat Photographer is a cute and relaxing VR photography game where players explore a charming caf\u00e9  & garden and capture adorable cats on camera. Find cats, take the perfect photos before time runs out, and return to the caf\u00e9 to review your pictures and earn a score."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blackholeinfiverse88-spe.github.io/Cat-Photographer/", "developer_terms_of_service_url": null, "publisher_name": "Sharcon Gaming ", "support_website_url": null, "website_url": "https://blackholeinfiverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categor
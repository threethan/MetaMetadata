54166133_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJnJDvR6JTUQ7kNvwERbRvK&_nc_oc=Ado7M4NrW5xn1hAVv9zw2e4IxAOONxMs7dlzniQ_eTqSuLFkEh3O6kzkRiBRKe-l3z8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRjZcUQVl7XppVryLvBRUo3UKuilxU7bYg7dsbSj4zDXg&oe=6B0DB9C9"}, {"file_name": "Cafe.png", "id": "2054111995254528", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593849888_2054111998587861_5908255327092159706_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIWjhWy7_H8Q7kNvwFG9vqn&_nc_oc=AdrXWhfgTVZR5nr_iPiVyvvD7T4Pjp6Hb6nQFrMVHnNh7KlxltJbRj4jyF4UQD62134&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRkDamwSdunJbFUdjx03Izx2F0van8DJ3lL_PPhGgUB2A&oe=6B0DC135"}, {"file_name": "Cafe_wall.png", "id": "2267876270614254", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624069_2267876277280920_2472342023144079741_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3kO07ZsxWoQ7kNvwG9vVk6&_nc_oc=AdrIps2szSc26b9cOvEuZH1wBO7lGRH8H16jdVSbKo6II_gr5Bcx_m9JXMPZ_CBzgqA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRGswlifYeWuWE_BjqA1BBoN9q0IjEMVTaNiQg-x_aNmw&oe=6B0D9DD0"}, {"file_name": "Garden.png", "id": "1795800791739329", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623876_1795800795072662_4833801198535317836_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVMFP5uJ3TIQ7kNvwFtQ2vz&_nc_oc=AdqeOtkIWZnqA_9-5GFYoLdZoPlpJsF3Z212CEeJYVvGKW9MQFtFPD_R32kw7fJagF4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTTqVR_4IRtvMN62FCcu6q0k6Y5859MnUC6NMofmhK_vA&oe=6B0DCEDD"}, {"file_name": "Pond.png", "id": "2393732231034255", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628016_2393732234367588_6389994923143211851_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5sk3TJjVsgQ7kNvwGf0umt&_nc_oc=AdqGaxBgTvEl_a5ADsJ7nKRY_JYmAyTMCvD59yfA-Z3_c3M1xentHoHhDZ267PTrU7g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTW10Rn3qV4huQPr9uudPziOlWzGfNp8tZQsl9vRAYjBw&oe=6B0DC8EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cat Photographer", "keywords": ["pets", "cute", "relaxing", "cat", "kitten"], "long_description": "\ud83d\udc31 Step into a charming VR caf\u00e9 and become a cat photographer! In Cat Photographer, your goal is simple - find adorable cats, capture the perfect moments, and prove your photography skills.\n\nExplore the environment as cats appear, walk around, and disappear before you can get the perfect shot. Use your VR camera to carefully frame each cat and capture photos before the 2-minute round ends. Photos are evaluated based on whether the cat is properly visible, including having at least one eye visible.\n\nOnce the timer ends, return to the caf\u00e9 and submit your photographs. Your captured photos are displayed on the caf\u00e9's result board, where you can see your score and review your best shots.\n\nWith a cozy caf\u00e9 hub, playful cats, VR photography mechanics, and a simple scoring system, Cat Photographer offers a fun and casual VR experience focused on exploration, timing, and capturing the perfect cat photo.", "short_description": "Cat Photographer is a cute and relaxing VR photography game where players explore a charming caf\u00e9  & garden and capture adorable cats on camera. Find cats, take the perfect photos before time runs out, and return to the caf\u00e9 to review your pictures and earn a score."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blackholeinfiverse88-spe.github.io/Cat-Photographer/", "developer_terms_of_service_url": null, "publisher_name": "Sharcon Gaming ", "support_website_url": null, "website_url": "https://blackholeinfiverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categor
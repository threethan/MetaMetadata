54166133_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBTrR7fWBr4Q7kNvwF4SLwd&_nc_oc=AdqXGkwRzM7VVrKe6WvdUgtShpbaKl7woWRPuvMqDruMOlUnLVdDCMwWL-_pg8e3pTw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_PDBJi30WL8ooRWMUbJVAxg04d9PRobAqVtvB_dr7jw&oe=6B0873C9"}, {"file_name": "Cafe.png", "id": "2054111995254528", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/593849888_2054111998587861_5908255327092159706_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ht7Gu5EjvBEQ7kNvwFWOGRa&_nc_oc=AdpNgd7mX_VvpbjW8NIBt-w-OXrcGlbV0VBDXAZKBd0JzE3VgFwMyUWpC4edEOgtsdI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJbP1Pa_AiWgzxMBL0kCAMB4g-g9n5ms01UjkN3MBe2g&oe=6B0842F5"}, {"file_name": "Cafe_wall.png", "id": "2267876270614254", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499624069_2267876277280920_2472342023144079741_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BApOdKWvSDMQ7kNvwG8Zigr&_nc_oc=Adp1rTagSqCV2Ha35xlZYxOvsHD-xh1wjcPCEfG_yEVUB56MFtCOQrsLAWVLdBCtkNQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLcVtDngif4J0CTA7qiLxa2vpUw0t0IzG-ToWGCL663w&oe=6B0857D0"}, {"file_name": "Garden.png", "id": "1795800791739329", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499623876_1795800795072662_4833801198535317836_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlSEatp3ARwQ7kNvwGSiJcW&_nc_oc=AdqZlHWen1ivKH1mpvjJy1gpKVaIkKYyAZ9_S_0SYf4JJwvb4zz9ASjbzsKhxO8wHQM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlJAOi4H-_QzYtnL_rK9NUA3zoQivHCSOiZ4H4mLLeUw&oe=6B08509D"}, {"file_name": "Pond.png", "id": "2393732231034255", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499628016_2393732234367588_6389994923143211851_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBjvEzH63s0Q7kNvwGd-bRI&_nc_oc=AdrRwF2ElXma7g9VGbwxltmzqT3b5rJ-yL4NRMVRRqjoJizqY7ff73yXIuLkQamkRao&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_PR1daqWAh_ebK5gfurUfGCprPGWyzsgJLmz2V2Bk1w&oe=6B084AAF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cat Photographer", "keywords": ["pets", "cute", "relaxing", "cat", "kitten"], "long_description": "\ud83d\udc31 Step into a charming VR caf\u00e9 and become a cat photographer! In Cat Photographer, your goal is simple - find adorable cats, capture the perfect moments, and prove your photography skills.\n\nExplore the environment as cats appear, walk around, and disappear before you can get the perfect shot. Use your VR camera to carefully frame each cat and capture photos before the 2-minute round ends. Photos are evaluated based on whether the cat is properly visible, including having at least one eye visible.\n\nOnce the timer ends, return to the caf\u00e9 and submit your photographs. Your captured photos are displayed on the caf\u00e9's result board, where you can see your score and review your best shots.\n\nWith a cozy caf\u00e9 hub, playful cats, VR photography mechanics, and a simple scoring system, Cat Photographer offers a fun and casual VR experience focused on exploration, timing, and capturing the perfect cat photo.", "short_description": "Cat Photographer is a cute and relaxing VR photography game where players explore a charming caf\u00e9  & garden and capture adorable cats on camera. Find cats, take the perfect photos before time runs out, and return to the caf\u00e9 to review your pictures and earn a score."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blackholeinfiverse88-spe.github.io/Cat-Photographer/", "developer_terms_of_service_url": null, "publisher_name": "Sharcon Gaming ", "support_website_url": null, "website_url": "https://blackholeinfiverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categor
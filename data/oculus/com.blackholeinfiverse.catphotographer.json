54166133_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJnJDvR6JTUQ7kNvwEuhyrh&_nc_oc=Adoe7c0lZsyGdxnCEEKuKSpJceDske2TZhRIB1-RY7fJ4V4rPbdbjsWUFk1hLn5Cdjw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQE5AIb3VIgy2EV50ewXs3Z3jRbKi6bQUYGvnbV214kFQ&oe=6B0B16C9"}, {"file_name": "Cafe.png", "id": "2054111995254528", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/593849888_2054111998587861_5908255327092159706_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIWjhWy7_H8Q7kNvwHMzrCF&_nc_oc=AdqSE9gwum1_BY_VCm03YG_RfkCymzprbQCynTiAYKno1O0wko16JpXeTeyWyN1tsnw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS4qLlA_3fdwidq74GE46watJV_QrxFXbwze3bpn3T2qg&oe=6B0B1E35"}, {"file_name": "Cafe_wall.png", "id": "2267876270614254", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499624069_2267876277280920_2472342023144079741_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkTwcbtow84Q7kNvwElQWtP&_nc_oc=AdqYSxMoUCHmMlgMjT8XNxT1E17nyV4HA167rDORN8XxOiGre0SeYkqAi92a7r42LPI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT8G-s7qmvQxIo5Lx21Zyr-jUIcPIJd2gaZyjGPRQckGA&oe=6B0B3310"}, {"file_name": "Garden.png", "id": "1795800791739329", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623876_1795800795072662_4833801198535317836_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1USUAyZds7gQ7kNvwHcs1q_&_nc_oc=AdoRBSg6VZ954bgwe8m59B4bSPYHw9L-972KYyBANaXk0y780ZXAB8izgxrPM4ov4_c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSXwAy-0It1__4SPBp79cQeRQyyxMb7jFcEpiA58ir3aw&oe=6B0B2BDD"}, {"file_name": "Pond.png", "id": "2393732231034255", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499628016_2393732234367588_6389994923143211851_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qA857Hs9TAEQ7kNvwEP5RKn&_nc_oc=AdqPcSzBgauj6pmGDVc6UvV-79p-Ik3ugRKXUNcLpuHOErlAaJDEL-oswVthkaNU4GQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTNN3WguKG6RXbu0xlsgtNyuUOxj6s9sJAnHYGT61A4og&oe=6B0B25EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cat Photographer", "keywords": ["pets", "cute", "relaxing", "cat", "kitten"], "long_description": "\ud83d\udc31 Step into a charming VR caf\u00e9 and become a cat photographer! In Cat Photographer, your goal is simple - find adorable cats, capture the perfect moments, and prove your photography skills.\n\nExplore the environment as cats appear, walk around, and disappear before you can get the perfect shot. Use your VR camera to carefully frame each cat and capture photos before the 2-minute round ends. Photos are evaluated based on whether the cat is properly visible, including having at least one eye visible.\n\nOnce the timer ends, return to the caf\u00e9 and submit your photographs. Your captured photos are displayed on the caf\u00e9's result board, where you can see your score and review your best shots.\n\nWith a cozy caf\u00e9 hub, playful cats, VR photography mechanics, and a simple scoring system, Cat Photographer offers a fun and casual VR experience focused on exploration, timing, and capturing the perfect cat photo.", "short_description": "Cat Photographer is a cute and relaxing VR photography game where players explore a charming caf\u00e9  & garden and capture adorable cats on camera. Find cats, take the perfect photos before time runs out, and return to the caf\u00e9 to review your pictures and earn a score."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blackholeinfiverse88-spe.github.io/Cat-Photographer/", "developer_terms_of_service_url": null, "publisher_name": "Sharcon Gaming ", "support_website_url": null, "website_url": "https://blackholeinfiverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categor
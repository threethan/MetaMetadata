54166133_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJnJDvR6JTUQ7kNvwGYwZNY&_nc_oc=AdruN55t4VaU9JEjtRJoQ4JVWHeQH9I642pouPODDtHvVCvuGdOP625TGszIXybypd0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSXSp8LteSN768uJ7ELdBYlmVckWt70sd21mYsgr5KeBg&oe=6B0C6849"}, {"file_name": "Cafe.png", "id": "2054111995254528", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593849888_2054111998587861_5908255327092159706_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIWjhWy7_H8Q7kNvwGmP3lE&_nc_oc=Adq5moZ62rXKpOQGRzG5-ri-ShhbHNQ5oyPixoUpLRcmMR917ejkk9s5rZI3VRPhJFw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSOSNtzi5j11Wg1jge_p-k3xtvYM331xVpBUwyCOXXmHQ&oe=6B0C6FB5"}, {"file_name": "Cafe_wall.png", "id": "2267876270614254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624069_2267876277280920_2472342023144079741_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkTwcbtow84Q7kNvwHU6bld&_nc_oc=AdrboBeP05rchEgABzuBIyzuF0IWJ2LaSk8WNp-sla3GeQfgxrQcz4aW_PT1vqfdpYE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSo6f9HTRQkX77FHRxNjzdXl7_zbvk-XDVBFIYIExf3JA&oe=6B0C4C50"}, {"file_name": "Garden.png", "id": "1795800791739329", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623876_1795800795072662_4833801198535317836_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1USUAyZds7gQ7kNvwEuzgQI&_nc_oc=Adqesb0RDCQoL60_ozNfFJK7voQmVfN6nVSxgcl85en8qBE4wfdQBZ6je_z9BJbPmgk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRo5wGUWJtdP_0CltSX_SwyfBJB2s7C7FAixmN474gNpw&oe=6B0C7D5D"}, {"file_name": "Pond.png", "id": "2393732231034255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628016_2393732234367588_6389994923143211851_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qA857Hs9TAEQ7kNvwG73ePN&_nc_oc=AdpUq6AYfd7bCvUP134aS9n0SVl3FZUVS6pT5zN4vcwekkOKQHaiGhDI-lSmxt7i7-c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQkMbNrB99mNFEoR1dDt_9s43WpgiuR8DACuVLwC2Y6Dw&oe=6B0C776F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cat Photographer", "keywords": ["pets", "cute", "relaxing", "cat", "kitten"], "long_description": "\ud83d\udc31 Step into a charming VR caf\u00e9 and become a cat photographer! In Cat Photographer, your goal is simple - find adorable cats, capture the perfect moments, and prove your photography skills.\n\nExplore the environment as cats appear, walk around, and disappear before you can get the perfect shot. Use your VR camera to carefully frame each cat and capture photos before the 2-minute round ends. Photos are evaluated based on whether the cat is properly visible, including having at least one eye visible.\n\nOnce the timer ends, return to the caf\u00e9 and submit your photographs. Your captured photos are displayed on the caf\u00e9's result board, where you can see your score and review your best shots.\n\nWith a cozy caf\u00e9 hub, playful cats, VR photography mechanics, and a simple scoring system, Cat Photographer offers a fun and casual VR experience focused on exploration, timing, and capturing the perfect cat photo.", "short_description": "Cat Photographer is a cute and relaxing VR photography game where players explore a charming caf\u00e9  & garden and capture adorable cats on camera. Find cats, take the perfect photos before time runs out, and return to the caf\u00e9 to review your pictures and earn a score."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blackholeinfiverse88-spe.github.io/Cat-Photographer/", "developer_terms_of_service_url": null, "publisher_name": "Sharcon Gaming ", "support_website_url": null, "website_url": "https://blackholeinfiverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categor
54166133_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezzyqjDJ4dYQ7kNvwHFTgG9&_nc_oc=AdrHCkgwyFAxjua1WcqzphPJtvaiyJbNcqxEMx_Wrn8av0SrTLnHvKFL14ZI4reDcvs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXooqYi5BwwtAJvXLJn1p9drHYqdToG7LTfcGMEpxd0A&oe=6B005289"}, {"file_name": "Cafe.png", "id": "2054111995254528", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593849888_2054111998587861_5908255327092159706_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acdeLeqRJSgQ7kNvwEliVBT&_nc_oc=AdpZj3FZ1Um3273zsK0sHobLiDLb3cUxaDJSg76Di_q-1xctsNwiBE5u8kY78C8RAYM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyk_bejl4iFN8DdUlWYmPLpQzQf1ShkylchQYNiuIvAw&oe=6B0059F5"}, {"file_name": "Cafe_wall.png", "id": "2267876270614254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624069_2267876277280920_2472342023144079741_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqQuvVYXCP4Q7kNvwFgTuSm&_nc_oc=Adrh14DldLXm2h0R4b5TKe6JkXKLUxt6X8ZEHvmjpys-PfEWXefrsX7KD_0_UGL6KaA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiyQfnq7E9MxPxSX3nObUvqLhCN849sml6gMaxWftutA&oe=6B006ED0"}, {"file_name": "Garden.png", "id": "1795800791739329", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623876_1795800795072662_4833801198535317836_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrX_WqkO9kUQ7kNvwFR6WR4&_nc_oc=AdrQDcFfzwjH1yHQi2dwAZP7zN8ZfZHJs9HCuj7AAV73CdYfW-Sr4q8ojPUN7adYjhU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrA7emBn0qEsNAo95pbKYc8q9GkPRYcG6vxWJQNq_WQA&oe=6B00679D"}, {"file_name": "Pond.png", "id": "2393732231034255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628016_2393732234367588_6389994923143211851_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MygE30PntAcQ7kNvwGoOD0d&_nc_oc=AdpWuFusWmWmJk63npnLIBC7nunxY85RnirHknGAR1Y50CD3IWRSKI_lxS06G_HgiJQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWCAwYvK2jMvdfK4-3VWPVyqmpg57wpUyLW_schnnPUg&oe=6B0061AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cat Photographer", "keywords": ["pets", "cute", "relaxing", "cat", "kitten"], "long_description": "\ud83d\udc31 Step into a charming VR caf\u00e9 and become a cat photographer! In Cat Photographer, your goal is simple - find adorable cats, capture the perfect moments, and prove your photography skills.\n\nExplore the environment as cats appear, walk around, and disappear before you can get the perfect shot. Use your VR camera to carefully frame each cat and capture photos before the 2-minute round ends. Photos are evaluated based on whether the cat is properly visible, including having at least one eye visible.\n\nOnce the timer ends, return to the caf\u00e9 and submit your photographs. Your captured photos are displayed on the caf\u00e9's result board, where you can see your score and review your best shots.\n\nWith a cozy caf\u00e9 hub, playful cats, VR photography mechanics, and a simple scoring system, Cat Photographer offers a fun and casual VR experience focused on exploration, timing, and capturing the perfect cat photo.", "short_description": "Cat Photographer is a cute and relaxing VR photography game where players explore a charming caf\u00e9  & garden and capture adorable cats on camera. Find cats, take the perfect photos before time runs out, and return to the caf\u00e9 to review your pictures and earn a score."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blackholeinfiverse88-spe.github.io/Cat-Photographer/", "developer_terms_of_service_url": null, "publisher_name": "Sharcon Gaming ", "support_website_url": null, "website_url": "https://blackholeinfiverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categor
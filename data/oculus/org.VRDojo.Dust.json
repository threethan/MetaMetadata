.oculuscdn.com/v/t64.5771-25/499312470_900511313091190_7826555211518384541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7rIWSjZQv8Q7kNvwGvUJkK&_nc_oc=Ado5ZoZSHG5rts_nTjvF9JHL7q3oVDcvCih8EyKfT9OOqhycGc7SBA_wSLGWUp0ms2o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJ8UbUo9fwhdKmn_cedE64IeRJ0Bd-_YVXnjvC3vvUPg&oe=6AA54FAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DUST_Cover_Landscape.png", "id": "987078413954501", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620444_987078417287834_7111498983217780160_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tjTjEv77xMQ7kNvwHJOgQ2&_nc_oc=AdrREk2WK8hhBNAHWa9VN0FewtPFCiUc2bLi1X9tTIUtzV1GJW_wrV0PU9wHWLVeTYQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSh7kt99AjJ6zeAXjIoNyK4usww4ZyiEfIQlg_gyMjSA&oe=6AA54FB1"}, "display_name": "DUST", "keywords": ["pvp", "multiplayer", "social", "shooter", "fighting"], "long_description": "DUST: Virtual Combat collects all VR playstyles into one virtual world where players can gather and compete as their favorite VR characters. Built on top of a custom networking system, DUST is a cross-platform VR-first game designed from the ground up to be fun, fair, and fluid even when the most intense players are battling it out from opposite sides of the planet. \n\nEach playable class is a mix of unique VR locomotion and combat styles players will recognize from across the VR world:\n\n- Arms-as-wings Flying locomotion\n- Rocket-thruster-hands Flying locomotion\n- Gorilla Arm locomotion\n- Climbing locomotion\n- Grapple-swinging locomotion\n- Joystick Shooter locomotion\n- and more...\n\nDUST is currently in early alpha and changes often, but it is free-to-play and always will be. ", "short_description": "Your favorite VR playstyles all together in one arena! Fly, Climb, Punch, Shoot, and hang out with friends on any VR headset from anywhere in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "
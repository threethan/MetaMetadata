263_4621669010438390533_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfWJK4FcpuoQ7kNvwFmbMwb&_nc_oc=AdqJGzBl6IqH3qdhUpVZ3fk_tLf229bLpW9fnVatjzIEnIs94AWKoH2Zy95Eabuqu5M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DTcFnUcgK3JZhE4PxzFG-hRcLVsW5cu8febjcYkKDrg&oe=69E620F2"}, {"file_name": "GolemvKobold.png", "id": "1392363745291111", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391852_1392363751957777_7206214317728290704_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CANqerVyNK8Q7kNvwGRDWzR&_nc_oc=AdrpgWd61g5La1GnqJQjk4-NLxyG5HnQyzHqPqzSzAAa0p24SqwkJHDgkaLqAoV8j2w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1k6Uo00I8JDZHAbEPJbGNosLBSYV2QVu1JaDTCArCzkQ&oe=69E613E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DustVirtualCombat_TrailerCoverImage.png", "id": "1107099640792286", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031511_1107099644125619_2126474495119274274_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqqKdYCVyZ0Q7kNvwG6Fa-s&_nc_oc=AdrRwEKHK3pNoq-6fxpi3KXGf43yY-g58_0m5_-t25Ws89kNrkXqHnuqpsqD087P6JM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35l5j9igTUAKwEWsT3LDzJdQXImfR_-BAlfI8kSekuUA&oe=69E6348C"}, "display_name": "DUST", "keywords": ["pvp", "multiplayer", "social", "shooter", "fighting"], "long_description": "DUST: Virtual Combat collects all VR playstyles into one virtual world where players can gather and compete as their favorite VR characters. Built on top of a custom networking system, DUST is a cross-platform VR-first game designed from the ground up to be fun, fair, and fluid even when the most intense players are battling it out from opposite sides of the planet. \n\nEach playable class is a mix of unique VR locomotion and combat styles players will recognize from across the VR world:\n\n- Arms-as-wings Flying locomotion\n- Rocket-thruster-hands Flying locomotion\n- Gorilla Arm locomotion\n- Climbing locomotion\n- Grapple-swinging locomotion\n- Joystick Shooter locomotion\n- and more...\n\nDUST is currently in early alpha and changes often, but it is free-to-play and always will be. ", "short_description": "Your favorite VR playstyles all together in one arena! Fly, Climb, Punch, Shoot, and hang out with friends on any VR headset from anywhere in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrdojo.games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdojo", "support_website_url": "https://vrdojo.games/", "website_url": "https://vrdojo.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SOCIAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25321454997520299"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75221319_1295648988348758_5422190306872871746_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dCH3ktIavYQ7kNvwE-ycMA&_nc_oc=Adr74sD59-9tBSlxjyCQ9j7qRBD_2qEtBoaDTx7px2sDrxnxgkivuCFwEx2CQgYNIgM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dquS-xAkiE187aXlMMT4r0hoFdZ8-Qb_ObEmNBcmCug&oe=69E63DA9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DUST", "platform": "ANDROID_6DOF", "conte
c_sid=6e7a0a&_nc_ohc=jZhmgf6sCnQQ7kNvwG1vm4e&_nc_oc=Adm9NL0gSlNZUx5ia6tsgmDtuUQ945CoaEkVouxL_Gf50_3jrnApNVl8b_EkgY3r5vM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv5MonfV529C2tvWgEl0nBLjAkgoxy1xxrG5qd-jybv4A&oe=69A97BF2"}, {"file_name": "GolemvKobold.png", "id": "1392363745291111", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391852_1392363751957777_7206214317728290704_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXMPRYWhiEIQ7kNvwHYFEhW&_nc_oc=AdnucH9V_9WPFvfO3UUhu-3qIwGirwS6TNEFW0dfLOCzhj5eN2jdngxf_1l4DJSXd9M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afvyd8TNTGhEhTh1utFyVVIqWskVZpLb2S_db4XJFYUNsQ&oe=69A96EE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DustVirtualCombat_TrailerCoverImage.png", "id": "1107099640792286", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031511_1107099644125619_2126474495119274274_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3btArPBZOfcQ7kNvwFnMKS4&_nc_oc=Adk14XKPVNTBoWNcoeA3g3mHy63D081iq4LYwclBIDOWExpqvqHPh32RJoKPnBt4D2o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsYYFtQn8qmlL51NRJVYc0VEvQrpMOGWEVHU8jT5q8hag&oe=69A98F8C"}, "display_name": "DUST", "keywords": ["pvp", "multiplayer", "social", "shooter", "fighting"], "long_description": "DUST: Virtual Combat collects all VR playstyles into one virtual world where players can gather and compete as their favorite VR characters. Built on top of a custom networking system, DUST is a cross-platform VR-first game designed from the ground up to be fun, fair, and fluid even when the most intense players are battling it out from opposite sides of the planet. \n\nEach playable class is a mix of unique VR locomotion and combat styles players will recognize from across the VR world:\n\n- Arms-as-wings Flying locomotion\n- Rocket-thruster-hands Flying locomotion\n- Gorilla Arm locomotion\n- Climbing locomotion\n- Grapple-swinging locomotion\n- Joystick Shooter locomotion\n- and mor
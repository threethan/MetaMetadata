Qctew&oe=6AF07D0C"}, {"file_name": "Dust_Alpha_0.8_Screenshot01.png", "id": "900511309757857", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312470_900511313091190_7826555211518384541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQhzc9YFY8AQ7kNvwHKQF88&_nc_oc=AdrUwd-GDetBaAzcqXIPG6kVeH9TOrVcCvL1d-oIioXA8W8ylAybn3wjvf1d6PC_GfY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxb5N_gBxWJYZGVQrDpLWgssfIueOWq-wumIGMHeM7YQ&oe=6AF0AD6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DUST_Cover_Landscape.png", "id": "987078413954501", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620444_987078417287834_7111498983217780160_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3Gm0rWpb6oQ7kNvwF3gwkj&_nc_oc=AdpvX8khWy4dvtzDAkevxaAAE1fqJfkUdlsdKmkY2497Oa8mQ0fkvRzAVkscKJyez2o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTv2ziHdgUfbdXCqtFlCWbxXGqzog_MR06id-uOcjRuzg&oe=6AF0AD71"}, "display_name": "DUST", "keywords": ["pvp", "multiplayer", "social", "shooter", "fighting"], "long_description": "DUST: Virtual Combat collects all VR playstyles into one virtual world where players can gather and compete as their favorite VR characters. Built on top of a custom networking system, DUST is a cross-platform VR-first game designed from the ground up to be fun, fair, and fluid even when the most intense players are battling it out from opposite sides of the planet. \n\nEach playable class is a mix of unique VR locomotion and combat styles players will recognize from across the VR world:\n\n- Arms-as-wings Flying locomotion\n- Rocket-thruster-hands Flying locomotion\n- Gorilla Arm locomotion\n- Climbing locomotion\n- Grapple-swinging locomotion\n- Joystick Shooter locomotion\n- and more...\n\nDUST is currently in early alpha and changes often, but it is free-to-play and always will be. ", "short_description": "Your favorite VR playstyles all together in one arena! Fly, Climb, Punch, Shoot, and hang out with friends on any VR headset from anywhere in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrdojo.games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdojo", "support_website_url": "https://vrdojo.games/", "website_url": "https://vrdojo.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SOCIAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27426395077026270"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623345_2114290779492917_2804313625406343578_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PgwDAqM-3L0Q7kNvwF0mkKO&_nc_oc=Adp295Uk79Knrcf1IRh6J0nUJSU-8AtN72WVkaddm8rQY9-N_2o2Sd0YyYM4CLGt8xU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_upcmrH7tlgvZmahbG9iHwb4HJ_sessFJTqVGSMSKdQ&oe=6AF096E6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DUST", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Fighting", "id": "2710427532541308"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Hangout", "id": 
.oculuscdn.com/v/t64.5771-25/499312470_900511313091190_7826555211518384541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypffPjP9q7sQ7kNvwF68XvU&_nc_oc=AdqLySBfdytlH2z0Ast1goN7kVsIst-b3mumiqBKnwrkvZph5HTvnq-qbbUquM4AyIY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMP8D0z-3OUilmPn8U3YDLuePXQRAZysEMaEOEGk5mQg&oe=6AC6452F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DUST_Cover_Landscape.png", "id": "987078413954501", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620444_987078417287834_7111498983217780160_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_SbiqkekqUQ7kNvwHZJWZ9&_nc_oc=Adq431DKQF_ci5fFhUUCopBqLix_Rn5KTrlQlUMjmilNez18M2ZVSvwTOn7ZB6JwyGM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZOOL5SjJfTqeIWmT9QjEwddzdlY8LzedTTuML61GF8w&oe=6AC64531"}, "display_name": "DUST", "keywords": ["pvp", "multiplayer", "social", "shooter", "fighting"], "long_description": "DUST: Virtual Combat collects all VR playstyles into one virtual world where players can gather and compete as their favorite VR characters. Built on top of a custom networking system, DUST is a cross-platform VR-first game designed from the ground up to be fun, fair, and fluid even when the most intense players are battling it out from opposite sides of the planet. \n\nEach playable class is a mix of unique VR locomotion and combat styles players will recognize from across the VR world:\n\n- Arms-as-wings Flying locomotion\n- Rocket-thruster-hands Flying locomotion\n- Gorilla Arm locomotion\n- Climbing locomotion\n- Grapple-swinging locomotion\n- Joystick Shooter locomotion\n- and more...\n\nDUST is currently in early alpha and changes often, but it is free-to-play and always will be. ", "short_description": "Your favorite VR playstyles all together in one arena! Fly, Climb, Punch, Shoot, and hang out with friends on any VR headset from anywhere in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "
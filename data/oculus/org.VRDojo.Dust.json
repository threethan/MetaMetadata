WU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftpvugystyGH0p_GIpcJi4b-dbBf-vHwyY2XjjqnudicA&oe=699EEFF2"}, {"file_name": "GolemvKobold.png", "id": "1392363745291111", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391852_1392363751957777_7206214317728290704_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFNmN_NYJjYQ7kNvwErVVdM&_nc_oc=AdnY5q5degm8P8cN4LYgWYcZZUxagSsqOmWeXwnxklffRElVDPxYa3PDgWf56arL9RY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu-RUV_1gkCBkFetZAbHwxYySIC6iE_Rn-DlNST0aTNzQ&oe=699EE2E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DustVirtualCombat_TrailerCoverImage.png", "id": "1107099640792286", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031511_1107099644125619_2126474495119274274_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_vSdgeRI9oQ7kNvwHxQmq9&_nc_oc=AdnJxLpLGELuyXG-jDi9iXzpQnCZNhUZMLJMoAIIpE3WzcHsDiB1PWm_WSG7r8RO5zk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsPQjOwGdIuY-nzt0A52LRYCgXwv1qCTrwq3JBohnLOwA&oe=699F038C"}, "display_name": "DUST", "keywords": ["pvp", "multiplayer", "social", "shooter", "fighting"], "long_description": "DUST: Virtual Combat collects all VR playstyles into one virtual world where players can gather and compete as their favorite VR characters. Built on top of a custom networking system, DUST is a cross-platform VR-first game designed from the ground up to be fun, fair, and fluid even when the most intense players are battling it out from opposite sides of the planet. \n\nEach playable class is a mix of unique VR locomotion and combat styles players will recognize from across the VR world:\n\n- Arms-as-wings Flying locomotion\n- Rocket-thruster-hands Flying locomotion\n- Gorilla Arm locomotion\n- Climbing locomotion\n- Grapple-swinging locomotion\n- Joystick Shooter locomotion\n- and more...\n\nDUST is currently in early alpha and changes often, but it is free-to-play and always will be. ", "short_description": "Your favorite VR
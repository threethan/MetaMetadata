c_sid=6e7a0a&_nc_ohc=87QT-LHV_zUQ7kNvwHrtl9M&_nc_oc=AdklEC4rBrqABFKk7LzH2Ewt2U6N2fgNnvm5FU5ihaUIAVvOF1SYkKmM3XVhHpkPFMw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxfX3Fdk-xoii1c3Fgo6Guo_ULzoXm6Ue_CqbSZ_rvGnA&oe=69BD4272"}, {"file_name": "GolemvKobold.png", "id": "1392363745291111", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391852_1392363751957777_7206214317728290704_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3LEePAKqGAQ7kNvwGYbnoY&_nc_oc=AdnQdNnjAroVT6WdTAQTTHpWDgkGgaQyUZ9eZwA25LzP94whNYVzn5Vetcs5ndnz5oc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzqR_GmSaOdxMYTDoA8DSWP9KJvfaZunUy5QZjhS7594w&oe=69BD3563"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DustVirtualCombat_TrailerCoverImage.png", "id": "1107099640792286", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031511_1107099644125619_2126474495119274274_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5CCmMyDDroQ7kNvwEu7FOo&_nc_oc=Adly2nR547Wsw8hMeRqpWnb4-tSwL_bL_b-U5aI58dElTAcEjnmWELzNa9HGWhLsdBs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwIBS5EWQg4J40o9Lba1IjuAZk6jD-i_9TiqJ8N6N5v2A&oe=69BD560C"}, "display_name": "DUST", "keywords": ["pvp", "multiplayer", "social", "shooter", "fighting"], "long_description": "DUST: Virtual Combat collects all VR playstyles into one virtual world where players can gather and compete as their favorite VR characters. Built on top of a custom networking system, DUST is a cross-platform VR-first game designed from the ground up to be fun, fair, and fluid even when the most intense players are battling it out from opposite sides of the planet. \n\nEach playable class is a mix of unique VR locomotion and combat styles players will recognize from across the VR world:\n\n- Arms-as-wings Flying locomotion\n- Rocket-thruster-hands Flying locomotion\n- Gorilla Arm locomotion\n- Climbing locomotion\n- Grapple-swinging locomotion\n- Joystick Shooter locomotion\n- and mor
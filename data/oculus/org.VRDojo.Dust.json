Xc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft5A_APuUVLfp-jNWApEA_ilt1_LFYBQwAegDIMueZf9Q&oe=699AFB72"}, {"file_name": "GolemvKobold.png", "id": "1392363745291111", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391852_1392363751957777_7206214317728290704_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rb4pQga2f7wQ7kNvwFXpCcR&_nc_oc=AdlRJwG8IuKb_cDVP6ukcnbkQq40_qQwUUwLkqY9OLPVH6pakoIXXcLGYSNpwNLSin4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsXM8h0wqbpZjZakLkn7XZEyQ3TRwzD0kO47PGC-CX6gA&oe=699AEE63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DustVirtualCombat_TrailerCoverImage.png", "id": "1107099640792286", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031511_1107099644125619_2126474495119274274_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogE4RVC1KyIQ7kNvwFElr6u&_nc_oc=AdlLsjFcIed6jAKFAmPX_k5w9axCTbGfzZ-FH6217qqnxhK31qw0cb-FZHDMLrMoatQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afsxx2ou3tpNelIHRt69g-t-mPq4mNbDU-_EFGzfszeERQ&oe=699B0F0C"}, "display_name": "DUST", "keywords": ["pvp", "multiplayer", "social", "shooter", "fighting"], "long_description": "DUST: Virtual Combat collects all VR playstyles into one virtual world where players can gather and compete as their favorite VR characters. Built on top of a custom networking system, DUST is a cross-platform VR-first game designed from the ground up to be fun, fair, and fluid even when the most intense players are battling it out from opposite sides of the planet. \n\nEach playable class is a mix of unique VR locomotion and combat styles players will recognize from across the VR world:\n\n- Arms-as-wings Flying locomotion\n- Rocket-thruster-hands Flying locomotion\n- Gorilla Arm locomotion\n- Climbing locomotion\n- Grapple-swinging locomotion\n- Joystick Shooter locomotion\n- and more...\n\nDUST is currently in early alpha and changes often, but it is free-to-play and always will be. ", "short_description": "Your favorite VR
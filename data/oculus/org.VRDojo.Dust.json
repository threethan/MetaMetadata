yZvudlGugQ7kNvwGkfsoA&_nc_oc=AdomwkS-HDVqOI4VLhC1SW2PeRVL_0aeERYP_AJM6Csw2YNTQnOYAb51eeKuPxwQmtE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsv1GxOGC9L2Y4kk2xUMSlFTPrJRZiyqLTEiJs5gm1WQ&oe=6A9C152F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DUST_Cover_Landscape.png", "id": "987078413954501", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620444_987078417287834_7111498983217780160_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5W6bGBSfMUQ7kNvwHAJXZH&_nc_oc=AdqwBgU2VY5OpKmyWMzxJvuFJkDxLrIhEJofr0jqISmBcrJcgmNaQlZKgUZQRdPin2o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6Mi4Jxn99NUyYMIwv-OemNqaL7tbt-dBDWDuF7yLQrw&oe=6A9C1531"}, "display_name": "DUST", "keywords": ["pvp", "multiplayer", "social", "shooter", "fighting"], "long_description": "DUST: Virtual Combat collects all VR playstyles into one virtual world where players can gather and compete as their favorite VR characters. Built on top of a custom networking system, DUST is a cross-platform VR-first game designed from the ground up to be fun, fair, and fluid even when the most intense players are battling it out from opposite sides of the planet. \n\nEach playable class is a mix of unique VR locomotion and combat styles players will recognize from across the VR world:\n\n- Arms-as-wings Flying locomotion\n- Rocket-thruster-hands Flying locomotion\n- Gorilla Arm locomotion\n- Climbing locomotion\n- Grapple-swinging locomotion\n- Joystick Shooter locomotion\n- and more...\n\nDUST is currently in early alpha and changes often, but it is free-to-play and always will be. ", "short_description": "Your favorite VR playstyles all together in one arena! Fly, Climb, Punch, Shoot, and hang out with friends on any VR headset from anywhere in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrdojo.games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdojo", "support_website_url
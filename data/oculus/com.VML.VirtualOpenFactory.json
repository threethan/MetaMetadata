c_sid=6e7a0a&_nc_ohc=l0UOnXbbV-YQ7kNvwG1SDF1&_nc_oc=AdmUskpOinwDpitRd-N6pOieIybbBK3oa9Hiygcd9MNXWfxnLvpVYsVuy__A5zTnYfg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_Bv2DNFFhIMI5QuoFiKwm6XYzZODplRJG-aZyMx4-cw&oe=69B7F108"}, {"file_name": "Virtual Mechatronic Lab_cover.png", "id": "957400696618353", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819982_957400699951686_4810206479869912635_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzkmOLLKN7cQ7kNvwHxiw3t&_nc_oc=AdlG0jWauyO3WHMxJVlNARBrmWIbiy5YMr4CRgPTqWfbOZ1GkTpyD5DC257pR_0R-h4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyjK8_38sOW2AUNiAV0G7x2Ja2VlpE5GPgxUIKdhJp5pQ&oe=69B7F1F4"}]}, "id": "1709977483745529", "locale": "en_US", "screenshots": [{"file_name": "6.png", "id": "903014002185832", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821682_903014005519165_4409761693820928294_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PufiO9GQrmQQ7kNvwEcTaxP&_nc_oc=AdmltADpBZvxR0eJ3cIPwVJgLC6uvFucI3HUSPU1yQMows3rv66M2IAHUdlksUgsyAI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwqk60g3W9e1Gx4t4x8RWyKh7vudYSPKCJKv6zumht5dQ&oe=69B81388"}, {"file_name": "4.png", "id": "1369203721102851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821702_1369203724436184_4559676736254003479_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vZAd_HUNi8Q7kNvwGWIbmI&_nc_oc=AdkzhlVv90jSF9NRWktKS1UtW3edadMCvXNWxp6IJJ07mh9Fo4Rllrl7IIv7WGq1czw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyP_D6fZH1lB9IYselJp9ZwdCqHrRNJ2MycSro-htkf8A&oe=69B7E7C3"}, {"file_name": "5.png", "id": "1448102076650436", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819845_1448102079983769_3748244163527432021_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ID2xqHIZ4UIQ7kNvwEhGekn&_nc_oc=Adk0_PkO7JT_aevl3ZT4r9S_bkvyS1U32sOlaR2fbAdwoyBr-6jZZ7dJld3ysX-eMHc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwRG11oMaXG79EYYfCTDy7bGgykzSWaTiTWVSFyhozYmQ&oe=69B80AF2"}, {"file_name": "8.png", "id": "2289497311528739", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819323_2289497318195405_5073854514587253533_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTbFpIEDNgQQ7kNvwFeAC9r&_nc_oc=AdlQrQqI8ZqhypWKH-3e0s62geCypq9_jVoquCR4JFZaNR7DJsSXpQFYy29sTGsUk6w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyLBuf2cXcCYB08pa_7WlrdTCN7LLpWRCCgs6yrm7tFeg&oe=69B808AD"}, {"file_name": "2.png", "id": "2715541525449181", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821719_2715541528782514_5169867024946638943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUDMptNwRvcQ7kNvwFkO-Ua&_nc_oc=AdlokPp9aQPvQtDcuJBdKLue24u932N67_Q4Y8pVrDF7fdflFEef9CbahPqAcxkn7AE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx755pNSv4Yzf8EwoAAha3eM2SMMkS6irUMHV_lPNV3nw&oe=69B7DF21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Mechatronics Lab", "keywords": ["mechatronics"], "long_description": "Unlock the full potential of Industry 4.0 with our comprehensive Cyber-Physical Factory (CPF) platform. This is not just automation; it is a total synchronization of the physical and virtual worlds.\n\nIn a traditional setup, machines operate in silos. In our Cyber-Physical Factory, every asset is part of a living, breathing network. By fusing mechanical components with advanced software logic, we provide a \"System of Systems\" that evolves with your business needs.\n\nKey Pillars of the Ecosystem:\nThe Digital Twin Integration: Every physical machine has a virtual counterpart. Simulate new production workflows or stress-test your line in a risk-free digital environment before ever touching the shop floor.\n\nAutonomous Orchestration: Utilizing decentralized logic, workstations communicate with one another to reroute tasks, balance loads, and self-correct for errors without requiring constant human intervention.\n\nEdge-to-Cloud Connectivity: High-speed sensors capture thousands of data points per second. This data is processed at the \"edge\" for instant reactions and sent to the cloud for long-term strategic analysis.\n\nInteroperability: Our framework supports standard industrial protocols (OPC UA, MQTT), ensuring that legacy hardware and modern robotics work together in one unified interface.\n\nOperational Benefits:\nZero-Downtime Strategy: AI-driven predictive maintenance identifies wear and tear in components like bearings or motors, scheduling service only when necessary.", "short_description": "Transform manufacturing with the ultimate Cyber-Physical Factory ecosystem. This solution bridges the gap between physical hardware and digital intelligence. By integrating IoT sensors, robotics, and real-time data analytics, our system creates a self-optimizing production environment. Monitor your entire floor through a high-fidelity Digital Twin, predict maintenance needs before failures occur, and achieve unprecedented flexibility in \"Batch Size 1\" production. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vml.dkut.ac.ke/docs/Virtual%20Mechatronics%20Lab.pdf", "developer_terms_of_service_url": null, "publisher_name": "Virtual Mechatronic Lab", "support_website_url": null, "website_url": "https://vml.dkut.ac.ke/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_i
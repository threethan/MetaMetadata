"}, {"file_name": "8.png", "id": "2289497311528739", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819323_2289497318195405_5073854514587253533_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpoTcNyRua0Q7kNvwFzDv4Y&_nc_oc=Adm9DhOZfc8k5cUjVRDQF23ddx6ZMbiUletfeB-xzNI-Y3uQQnXS_0CpbN_-rFqyg7I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfssVjm7HxXynpdH_bSB4oFljio37mXFbEJrs3cX1DxbxQ&oe=699DAAAD"}, {"file_name": "2.png", "id": "2715541525449181", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821719_2715541528782514_5169867024946638943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tTkYlbM6RUQ7kNvwFVbSH5&_nc_oc=AdlXonC--I18tmxVs51aPleWUswBQe0p8LDGbfg88ZE5cX4pGjmIIkK0UExl1bGZWFA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuiNqYX1fgxG7IgLxH_1fd4dhwKnULJetKZqRPkInl3bw&oe=699D8121"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Mechatronics Lab", "keywords": ["mechatronics"], "long_description": "Unlock the full potential of Industry 4.0 with our comprehensive Cyber-Physical Factory (CPF) platform. This is not just automation; it is a total synchronization of the physical and virtual worlds.\n\nIn a traditional setup, machines operate in silos. In our Cyber-Physical Factory, every asset is part of a living, breathing network. By fusing mechanical components with advanced software logic, we provide a \"System of Systems\" that evolves with your business needs.\n\nKey Pillars of the Ecosystem:\nThe Digital Twin Integration: Every physical machine has a virtual counterpart. Simulate new production workflows or stress-test your line in a risk-free digital environment before ever touching the shop floor.\n\nAutonomous Orchestration: Utilizing decentralized logic, workstations communicate with one another to reroute tasks, balance loads, and self-correct for errors without requiring constant human intervention.\n\nEdge-to-Cloud Connectivity: High-speed sensors capture thousands of data points per second. This data is processed at the \"edge\" for instant reactions and sent to the cloud for long-term strategic analysis.\n\nInteroperability: Our framework supports standard industrial protocols (OPC UA, MQTT), ensuring that legacy hardware and modern robotics work together in one unified interface.\n\nOperational Benefits:\nZero-Downtime Strategy: AI-driven predictive maintenance identifies wear and tear in components like bearings or motors, scheduling service only when necessary.", "short_description": "Transform manufacturing with the ultimate Cyber-Physical Factory ecosystem. This solution bridges the gap between physical hardware and digital intelligence. By integrating IoT sensors, robotics, and real-time data analytics, our system creates a self-optimizing production environment. Monitor your entire floor through a high-fidelity Digital Twin, predict maintenance needs before failures occur, and achieve unprecedented flexibility in \"Batch Size 1\" production. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vml.dkut.ac.ke/docs/Virtual%20Mechatronics%20Lab.pdf", "developer_terms_of_service_url": null, "publisher_name": "Virtual Mechatronic Lab", "support_website_url": null, "website_url": "https://vml.dkut.ac.ke/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25560617763547376"}, "review_messages": []}]}, 
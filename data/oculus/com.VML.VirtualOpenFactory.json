c_sid=6e7a0a&_nc_ohc=0QR-x6mUar8Q7kNvwHh1VH6&_nc_oc=Adl1pXN9r2wUmJSR7MwPp2gJhB1hj7lMSx1riTxHJityd_kysjgn-IyAaVS1sa2Kw44&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsG2RMdAGORRFr0mLf_oadnH3E5p-TZHwxObHuqIUI8ag&oe=69A81F08"}, {"file_name": "Virtual Mechatronic Lab_cover.png", "id": "957400696618353", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819982_957400699951686_4810206479869912635_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QoxiWmo-tiUQ7kNvwHvmfvV&_nc_oc=Adlf61Gw1i7S605VxYWl_LNt48cUjS8UnpSgdmYaijbNfZtboBUUNm-r6jBgYZE0Tgk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsuT7ixmP0NWh7xLhB7jT-cDpecOBvMPX6bauTZKc0DWA&oe=69A81FF4"}]}, "id": "1709977483745529", "locale": "en_US", "screenshots": [{"file_name": "6.png", "id": "903014002185832", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821682_903014005519165_4409761693820928294_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jlOBMUYdZXMQ7kNvwESkQCI&_nc_oc=AdkoleGNYmmz1U-plDIJm1ZoltXLl8FXDM-VFGDFC37TIC3klOvhJt-bIR4ElgTtff0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsZSaSjwf6aOpCAco2aquUsHIjiHDnU_ygZdJFP3SKsYQ&oe=69A80948"}, {"file_name": "4.png", "id": "1369203721102851", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821702_1369203724436184_4559676736254003479_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQS0DN3kZ3IQ7kNvwGLE-tM&_nc_oc=AdmLy1cy_WuaFho5nCXMho_jWnkg7pP9fWalfQv7UJ0TM5hn6-86mozEgwF9Ds2J6M8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv2cUzSbIrbNalqZqI3j3K9lzUz3S-IHRkZdbcOe0RysQ&oe=69A815C3"}, {"file_name": "5.png", "id": "1448102076650436", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819845_1448102079983769_3748244163527432021_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YR_faaUHq8Q7kNvwFhWLtD&_nc_oc=AdmARiK99hmc6qCJ8Ur3521szdX3UjKQKVqzG9qPfZabTHEBXUA90jhxT-rbMuH2AMc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuSTgGfvJGnAddscHOowXACYcMy2UoTwZJNa34JWVd3Vg&oe=69A838F2"}, {"file_name": "8.png", "id": "2289497311528739", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819323_2289497318195405_5073854514587253533_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRP-cPzqdjEQ7kNvwHVUz-8&_nc_oc=AdnB2Q9Pas8_a7rd9eCjDN-sFfmnVzkGVDSLYybxfoogZmDOArWpIIi_kklAapoMQFE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfthaF2kwFY7bPD5ly77e4My0atl1M5iHpd_DFzsT2E1Ig&oe=69A836AD"}, {"file_name": "2.png", "id": "2715541525449181", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821719_2715541528782514_5169867024946638943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnXEwN5ALxgQ7kNvwF4oDFD&_nc_oc=AdkLAz3pnBxBSN1m-CPS44MX9yey9I2oeNczXYTiOC2nqoU0Oez8GmgjzFJOBI7NOds&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuGv-HSie9ymiVpdl3kRLi2s9AMoQDHG0WeTKPHjiyXew&oe=69A80D21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Mechatronics Lab", "keywords": ["mechatronics"], "long_description": "Unlock the full potential of Industry 4.0 with our comprehensive Cyber-Physical Factory (CPF) platform. This is not just automation; it is a total synchronization of the physical and virtual worlds.\n\nIn a traditional setup, machines operate in silos. In our Cyber-Physical Factory, every asset is part of a living, breathing network. By fusing mechanical components with advanced software logic, we provide a \"System of Systems\" that evolves with your business needs.\n\nKey Pillars of the Ecosystem:\nThe Digital Twin Integration: Every physical machine has a virtual counterpart. Simulate new production workflows or stress-test your line in a risk-free digital environment before ever touching the shop floor.\n\nAutonomous Orchestration: Utilizing decentralized logic, workstations communicate with one another to reroute tasks, balance loads, and self-correct for errors without requiring constant human intervention.\n\nEdge-to-Cloud Connectivity: High-speed sensors capture thousands of data points per second. This data is processed at the \"edge\" for instant reactions and sent to the cloud for long-term strategic analysis.\n\nInteroperability: Our framework supports standard industrial protocols (OPC UA, MQTT), ensuring that legacy hardware and modern robotics work together in one unified interface.\n\nOperational Benefits:\nZero-Downtime Strategy: AI-driven predictive maintenance identifies wear and tear in components like bearings or motors, scheduling service only when necessary.", "short_description": "Transform manufacturing with the ultimate Cyber-Physical Factory ecosystem. This solution bridges the gap between physical hardware and digital intelligence. By integrating IoT sensors, robotics, and real-time data analytics, our system creates a self-optimizing production environment. Monitor your entire floor through a high-fidelity Digital Twin, predict maintenance needs before failures occur, and achieve unprecedented flexibility in \"Batch Size 1\" production. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vml.dkut.ac.ke/docs/Virtual%20Mechatronics%20Lab.pdf", "developer_terms_of_service_url": null, "publisher_name": "Virtual Mechatronic Lab", "support_website_url": null, "website_url": "https://vml.dkut.ac.ke/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_i
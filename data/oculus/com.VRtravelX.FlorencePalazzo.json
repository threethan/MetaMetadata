6373048991105_4731129675014486436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQAhCaj-crAQ7kNvwERUJzL&_nc_oc=Adpnip2-d18-LKDb_hxd4yckl-oRlvF90QEIg90_ZxD9CsycDRaZ-3XzJRkLZFtvTxs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGESgZz0l7kkGbP1ddI-KYP8bqirqNiu2TcN-_HEP_h8Q&oe=6A95CF53"}, {"file_name": "Screen5.png", "id": "1205522280505239", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974595_1205522283838572_8037101477991241010_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A37Eo1v1TpkQ7kNvwFI6nL_&_nc_oc=AdqNjFPypZUI_BuUJPY-S2S2P9tCV8pummomEGrFqa5duYNBKXg5wwEpv4AzyWYiaGA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzWIcCPJ0r7dwXsUJimjwpG91oszPx6zfBTyOt9-U9LA&oe=6A95C01C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Florence VR: Sunset Tour & Palazzo", "keywords": ["travel", "tourist", "sightseeing", "florence", "italy"], "long_description": "Discover Florence like never before in this breathtaking VR experience. Your journey starts at the world-famous Ponte Vecchio, illuminated by the golden hues of the setting sun. Cross the historic bridge and enjoy a serene walk along the riverside arcades of the Arno, soaking in the magical evening atmosphere.\n\nMeander through Florence\u2019s charming alleys to the Piazza della Signoria, where art and history come alive. Marvel at the Loggia dei Lanzi's open-air sculptures, including the iconic Michelangelo\u2019s David, a masterpiece in itself. Take your time exploring the vibrant square and admiring its architectural beauty.\n\nStep into the Palazzo Vecchio, Florence\u2019s grand political and artistic hub. Wander through opulent rooms filled with Renaissance art, frescoes, and intricate details. Visit exhibitions showcasing Florence\u2019s history and immerse yourself in the grandeur of its majestic halls.\n\nOnce your tour of the palazzo is complete, step back into the lively Piazza della Signoria and explore the surroundings as the city transitions into night. This VR experience offers a perfect blend of culture, art, and ambiance, immersing you in the soul of Florence from the comfort of your home.\n\n#travel #tourist #sightseeing #florence #italy", "short_description": "Embark on a stunning VR journey through Florence! Begin at the iconic Ponte Vecchio under a glowing sunset, stroll along the Arno's riverside arcades, and wind through charming alleys to the magnificent Piazza della Signoria. Admire statues like Michelangelo's David before stepping into the opulent Palazzo Vecchio to explore its grand rooms and exhibits. This immersive experience captures the essence of Florence in breathtaking detail. Perfect for culture and art lovers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/Florence-VR-Sunset-Tour-Palazzo", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8142199732548219"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "2447810299059735"}, {"status": "PUBLISHED", "id": "3523010087874300"}, {"status": "PUBLISHED", "id": "2246588319083020"}, {"status": "PUBLISHED", "id": "2088284318740799"}, {"status": "PUBLISHED", "id": "741068138685127"}, {"status": "PUB
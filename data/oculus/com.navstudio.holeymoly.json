"}, {"file_name": "screenshot_4.png", "id": "915484294851860", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830904_915484301518526_7174230493351096777_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LT0aHJNBd2YQ7kNvwEYbKV7&_nc_oc=Adrj7mDeZ-zBG2b1D6-lQ3eHBVH81rnJu3qCq45fObQvbh7YkWF_7g_o1OqQje6zcLE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyuadMXVzyzrxhDIsIijE0faFcMw37g1O_99PiHP543g&oe=6AF9E983"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hole-y Moly!", "keywords": ["casual", "arcade", "relaxing", "family", "hole"], "long_description": "You're a hole in a toy city, and everything that fits falls in. Start small, swallowing cones, people and bins, and keep eating until you're big enough for cars, buses, houses and finally the skyline itself.\n\nThe city lies around your seat like a living model town. Steer the hole with one thumbstick, or pinch and drag with your hand, and watch the world tip over the rim. The camera glides after you as you grow, with a comfort vignette, or turn camera follow off and keep the city still.\n\nWHAT'S INSIDE\n- 48 levels in six worlds: Maple Street, Market Street, Downtown, Sunny Farm, Beach Town and the Hard Hats building site\n- Three kinds of challenge: grow to a size, eat a shopping list (\"15 bushes and 15 people\"), or battle rival holes and be the biggest when the clock runs out\n- Swallow smaller rival holes and run from bigger ones\n- Power-ups: magnet, speed boost, mega hole and extra time\n- Combos, stars and best scores for every level\n- Seven hole skins to unlock with your stars\n- Free play in every world you reach: no clock, no goal, just eat\n- An endless city that keeps going wherever you roll\n\nMade for seated play, with one controller or hands only. Free to try: play the first 3 levels, then unlock all 48 with a single purchase. No ads, no lives, no subscriptions.", "short_description": "You're a hole in a toy city. Steer it with a thumbstick or a pinch of your hand, swallow everything that fits, and grow until cars, houses and whole skyscrapers tip in. 48 levels across six themed worlds, rival holes to out-grow, power-ups, unlockable hole skins and a relaxing free-play mode. Played seated. Free to try: the first 3 levels are free, and one purchase unlocks the whole game."}]}, "developer_name": "Navid Mirzaaghazadeh", "developer_privacy_policy_url": "https://navid.tr/apps/holeymoly/privacy", "developer_terms_of_service_url": null, "publisher_name": "Nav Studio", "support_website_url": null, "website_url": "https://navid.tr/apps/holeymoly", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1400544343138698"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1665675605069293"}]}, "baseline_offer": {"id": "1665675605069293"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793110920, "status": "PUBLISHED", "id": "1665675605069293"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1404747349385064", "version": "1.1.1"}, "id": "1140890408288506", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Appl
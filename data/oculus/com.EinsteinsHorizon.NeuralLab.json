A12"}, {"file_name": "1_1.png", "id": "1687375132686510", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499300738_1687375136019843_3999228938099608433_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-TG9OiVNCUQ7kNvwGID-Nt&_nc_oc=AdojDp7Khz4dlLeMgLBjvZOZWblP7XzSXJ3-HN7yBiNPvDTBnZVRZbgWn9z3_RA8AJY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-vi3b6UHF6wPgcF2NSh_ymK3dvYfUxKcqHxnEN7ui_Q&oe=6A86E68E"}, {"file_name": "16_9.png", "id": "877626685362374", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499300837_877626688695707_2283356557090193784_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBvX3gt54DMQ7kNvwEYkh29&_nc_oc=AdoZJ-OKoHQoiFRR8nDWNBz6t3G5zDYuaI9xl69B3iekahBiK7LD9hldRXoxUOyCT88&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3qMHrdUhhIc_W3q-teOdH7Ba9wcPvdltCbXFntaN_zg&oe=6A86EDF1"}]}, "id": "1543734073968571", "locale": "en_US", "screenshots": [{"file_name": "nervous_6.png", "id": "1583214459892138", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499623345_1583214463225471_8808258207965767578_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T26qpE9WoAoQ7kNvwHJ52Qi&_nc_oc=AdoeEtEfxtEeWJ1qx5XThVrI8Gd61u8b5lRsM9MX9aIcVVSlraId12fGgYr5yp83ZaQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9BGazZRV2xsL3TIPoEzLUOQa4-fhfp5dIphlQ7P6aNQ&oe=6A86EF3F"}, {"file_name": "nervous_3.png", "id": "1814527462912308", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622919_1814527466245641_5354654298057691051_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVZZO-N2YwsQ7kNvwFWOMtx&_nc_oc=Ado2uHGYiWR9QgPpRNtAZrULrmcsb2zdp8ug6zBo7HUEt8gnVIk8oA00a4Hyih4obUM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7j9ay9fM52a_z2mGp1Ub6rgFkzolRxVCtSsTQUDHkxQ&oe=6A86D8D1"}, {"file_name": "nervous_4.png", "id": "999111355850775", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499620940_999111359184108_5489006581321199488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3kfI2l3yKUQ7kNvwFzBN3t&_nc_oc=AdqAtKqAto27Tf0y6EUYprxVsWByjJXVveFJu-IGyx0kYV9qSpkKXhraOSkLzJ910lg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDzr5rUcaZu3u4ALaarvDbcdFwewQgqqfL0NSBH8dEog&oe=6A86E348"}, {"file_name": "nervous_7.png", "id": "1494151442216786", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620965_1494151445550119_340335602173337006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyHpvD7k8T0Q7kNvwEn1Bs4&_nc_oc=Adr-6x2kz8sFL56jG2Vw9uEylQOXma0MVfakHoYW8_YSW5LNM7FooHLU9OTsKZwrG_8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGm-E27etOvRsNXk5qJNFypU6hHoBLcY9ZDvvbcS18vTA&oe=6A870358"}, {"file_name": "nervous_5.png", "id": "1010300658312604", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499622334_1010300661645937_4972388208125174360_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6_t1nsPZXUQ7kNvwFBhjRQ&_nc_oc=AdoutPHV4E2lIb8EA2pumyIaMySQOWmOB5LpkNvNRAsm2FgXoB-AXvmGbxWbjCRg1qk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcI_U4CAQn85919Oc3_MIvXYmbl9cyChC179udEtYZKQ&oe=6A86FD8F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anatomy Learning Labs: Neural Lab", "keywords": ["anatomy", "neural", "brain", "learning", "medical"], "long_description": "Step into the Neural Lab of the Anatomy Learning Labs series, where the communication network of the human body comes to life in stunning 3D. Featuring anatomically accurate models developed by medical professionals and learning activities designed by professors, the Neural Lab teaches elementary, middle, and high school learners how the brain, spinal cord, and peripheral nerves work together to control movement, sensation, and thought.\n\nThis app leverages the Quest's audio, visual, and hand-tracking capabilities to deliver truly multimodal and active learning experiences. Students learn by seeing anatomy in 3D, hearing explanations, interacting with structures using their own hands, and developing spatial reasoning skills through guided activities.\n\n\u2022    Operate a CT-scanner to reveal how the nervous system aligns with the skeletal and muscular systems.\n\n\u2022    Select any structure to hear Dr. Hana Sato, your virtual guide, identify it by name.\n\n\u2022    Use your own hands to grab and inspect the brain, its cortices, and neurons.\n\n\u2022    Step into Mini Mode to see a nerve cell from the inside.\n\n\u2022    Trigger action potentials in healthy and damaged neurons to observe how structure affects function.\n\n\u2022    Assemble the central and peripheral nervous systems in a guided 3D puzzle.\n\n\u2022    Test your knowledge through audio-guided quizzes led by Dr. Sato.\n\n\u2022    Put your skills to the test in a fast-paced Knowledge Knockout challenge, where you must quickly identify the correct nervous system structure.", "short_description": "Step into an immersive VR neural system laboratory and explore the communication network of the\nhuman body in stunning 3D. Travel through medical imaging views, examine the brain, spinal cord,\nand peripheral nerves using natural hand-tracking, and hear Dr. Hana Sato identify anatomical\nstructures by name. Assemble neural pathways in interactive 3D puzzles, test your knowledge with\nquizzes, and reinforce learning through engaging challenges designed to make neuroscience exciting,\nmemorable, and f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.einsteinshorizon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Einstein's Horizon", "support_website_url": null, "website_url": "https://www.einsteinshorizon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868
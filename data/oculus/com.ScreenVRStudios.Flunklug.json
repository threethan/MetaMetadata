&oh=00_AQFnUHPfu5jG_BoRGB_ALkgH7kxw3Xe7Za031aot_7SrdA&oe=6A917645"}, {"file_name": "Screenshot3.png", "id": "4624535494502852", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491824665_4624535497836185_7675873197190820290_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJbfdTtx_vMQ7kNvwGJOvyE&_nc_oc=AdrcAx-4w9kA0wno6JsG5Ju1fui6Ofuc_FoRSrIDK0fkjzPvsoGvgddr70mB-z99_mk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHh9wq0CSg1hvHKKPHd5Fwp8O8nHZnxy3LOzQ1q_gnvvg&oe=6A916328"}, {"file_name": "Screenshot5.png", "id": "1053792317024180", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491823930_1053792320357513_4890416327565115902_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdmQfwtU9hAQ7kNvwFdZ6Rg&_nc_oc=AdqP9xe7pxzbVTIB8_1rhiXKQsq4PqrchqLBG_YIzHYnKWuAs0ZwZw7s1wr5iBL29UE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvOsAJhil2MvfrGo_dOjS_IDeSjCfkvQhtNBIu9ywRdA&oe=6A917BE7"}, {"file_name": "Screenshot4.png", "id": "2210889576397565", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491821796_2210889579730898_5674261755151029291_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dz3gtLG_Ph0Q7kNvwEKsM0X&_nc_oc=AdqS-ujh7o0ab1aZhfBKSZVEIf6yqLweNDp2FFjJefVElAEv4J6r8bXzaCOGDzHl274&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBNL0eOdfSMzLlckunQyp-AgiU3nM-Qd7RtC6MmPkJdQ&oe=6A917713"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flunklug", "keywords": ["Horror", "Gorilla", "Scary", "Monkey", "Monsters"], "long_description": "**Some scrap is worth the risk. You'll find out which.**\n\nFlunklug is a multiplayer co-op horror game about stealing what isn't yours. Break into facilities, caverns and worse with your friends, grab everything of value you can carry, and get out before the things down there catch you first.\n# Sell scrap and buy items\nEvery escape pays for the next. Haul your scraps back out and sell them, unlock new gadgets and weapons, and gear up to push deeper than the run before.\n{1743942756650170}\n# Salvage and take scrap\nGo deep into a fully physics-driven world where everything reacts, breaks and gets in the way - then grab what you came for while monsters chase you through the dark.\n{2277815346381832}\n# Break into new areas\nSome parts of the map require special items and gadgets to break or blast your way into. Discover these new places as well as the rarer and luxury-like items inside.\n{1759467231925453}\n**Loot the map with up to 15 friends and find new mechanics together**", "short_description": "Flunklug is a multiplayer co-op horror game with the goal of stealing what isn't yours. While being hunted down by monsters, get out, sell scraps and unlock new gadgets for the next run. Grab your friends and go deep into the map, exploring with weapons and items in the physics-driven world. The best loot is always furthest in."}]}, "developer_name": "Screen VR Studios", "developer_privacy_policy_url": "https://screenvrstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Screen VR Studios", "support_website_url": null, "website_url": "https://screenvrstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "CO_OP"], "id": "996016426703858"}}]}, "scheduled_offers": {"
92K6U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKRkXoLTOVrR-xVVaM6bT5g1fhF_dfH91Z2U0yCZhgLQ&oe=6AB7EA05"}, {"file_name": "Sewers.png", "id": "1578015807344912", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824741_1578015810678245_5694717527210957130_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOYOfTjUy4cQ7kNvwGkte3c&_nc_oc=AdponvzQ5-T5OGsjUyxh2HbESNEoUhyczhdAEewiG8alcQM5txAuECbLro7i0AjTh94&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3DyBHRfOfCUxkY_SMD2c9DClvVOHjpurUxTV_Gue7VQ&oe=6AB7CC01"}, {"file_name": "Screenshot3.png", "id": "4624535494502852", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824665_4624535497836185_7675873197190820290_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I07ZuY_Q6VsQ7kNvwFLQP6j&_nc_oc=AdqtG0M9EbuFU0LMJKUYVD9WnNNfaCqLqoJm-Ii_ag-hSkt_Mrd8GwKE-B63BK-XNLE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrRhiDJCYo5yQOQauUdSN-vI0as_fTjVxsu5BI8nrwLQ&oe=6AB7D6E8"}, {"file_name": "Screenshot5.png", "id": "1053792317024180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823930_1053792320357513_4890416327565115902_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgdAOg7_VckQ7kNvwFwPqG4&_nc_oc=AdpKZk91Ij1-FEEAtu0m66YrKXxheb-xBm_ToLfMgU8jzqPZ9ddVpNNHkj9EgH9E6gc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaDNW3Hf_nOfE5yTALXUB7hjqzuvTb0QfZM0RD1W5dRg&oe=6AB7EFA7"}, {"file_name": "ScreeenShot6.png", "id": "1600943798277857", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828583_1600943801611190_4776163342314414381_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=La8zMh-Cb1cQ7kNvwHqhxD6&_nc_oc=AdpkneaNE_VFu6vumcZn8_GwM9MOTdJKDstlD3Lnx0kWRVDDLa8DJuoE8Lh3-VQ70K8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ35ZbHy8aV5bSqkz4JAmwykgkKwMrCN55FiwWpQkP2LQ&oe=6AB7E7B1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flunklug", "keywords": ["Horror", "Gorilla", "Scary", "Monkey", "Monsters"], "long_description": "**Some scrap is worth the risk. You'll find out which.**\n\nFlunklug is a multiplayer co-op horror game about stealing what isn't yours. Break into facilities, caverns and worse with your friends, grab everything of value you can carry, and get out before the things down there catch you first.\n# Sell scrap and buy items\nEvery escape pays for the next. Haul your scraps back out and sell them, unlock new gadgets and weapons, and gear up to push deeper than the run before.\n{1743942756650170}\n# Salvage and take scrap\nGo deep into a fully physics-driven world where everything reacts, breaks and gets in the way - then grab what you came for while monsters chase you through the dark.\n{2277815346381832}\n# Break into new areas\nSome parts of the map require special items and gadgets to break or blast your way into. Discover these new places as well as the rarer and luxury-like items inside.\n{1759467231925453}\n**Loot the map with up to 15 friends and find new mechanics together**", "short_description": "Flunklug is a multiplayer co-op horror game with the goal of stealing what isn't yours. While being hunted down by monsters, get out, sell scraps and unlock new gadgets for the next run. Grab your friends and go deep into the map, exploring with weapons and items in the physics-driven world. The best loot is always furthest in."}]}, "developer_name": "Screen VR Studios", "developer_privacy_policy_url": "https://screenvrstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Screen VR Studios", "support_website_url": null, "website_url": "https://screenvrstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_t
g64kU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpd165TqpAN_A-AiQXokMZue16F00WLLrCArq9ieU7vA&oe=6ADE2585"}, {"file_name": "Sewers.png", "id": "1578015807344912", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824741_1578015810678245_5694717527210957130_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbE1vXWy2YYQ7kNvwHyrrMv&_nc_oc=AdozcXWvE7crv_b38Kvwq7YNFot7Zgy-JMvUwvXJNOY2KLz23ScfYx9q4z9G-r-gre0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNPJlW8Z9T1DFEqBpDRBufG5qKTSxWduotuVS2Dp9dRQ&oe=6ADE0781"}, {"file_name": "Screenshot3.png", "id": "4624535494502852", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824665_4624535497836185_7675873197190820290_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xni936bvAokQ7kNvwGD7leZ&_nc_oc=AdosDHZF25v5PGV5layqmDLNoZVEPqX19jiJ44YDn9gZbG7HCewNbFA6zeaYOsOVLU0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUoPvcPW7_tvQ3aeu7PVOatXTpnAhx52fXv-JdsUB8xg&oe=6ADE1268"}, {"file_name": "Screenshot5.png", "id": "1053792317024180", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823930_1053792320357513_4890416327565115902_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bx9kx4Bq5WEQ7kNvwH3vJaa&_nc_oc=AdqHD2J6dRa9ow58cEGblyugDf778L315pJ9-YNUquIoieF0fQEjZrTS9PjXwat7plU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP94dlaGRyAQvGGoWx4-RaTibGSwyG5U3va2Oqbxt7d9g&oe=6ADE2B27"}, {"file_name": "ScreeenShot6.png", "id": "1600943798277857", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828583_1600943801611190_4776163342314414381_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--BARbfKw3oQ7kNvwH1nDIS&_nc_oc=AdpJD1wCahcb_JO0MHSXGCkCv8rLr_gvZ4wESDPScIX-NqM4ksSyMvLCywZpOJxuLSI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyKo6bi52SGWmsduE9tedMxDaH3A6VhkrSdWTzWDC1_Q&oe=6ADE2331"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flunklug", "keywords": ["Horror", "Gorilla", "Scary", "Monkey", "Monsters"], "long_description": "**Some scrap is worth the risk. You'll find out which.**\n\nFlunklug is a multiplayer co-op horror game about stealing what isn't yours. Break into facilities, caverns and worse with your friends, grab everything of value you can carry, and get out before the things down there catch you first.\n# Sell scrap and buy items\nEvery escape pays for the next. Haul your scraps back out and sell them, unlock new gadgets and weapons, and gear up to push deeper than the run before.\n{1743942756650170}\n# Salvage and take scrap\nGo deep into a fully physics-driven world where everything reacts, breaks and gets in the way - then grab what you came for while monsters chase you through the dark.\n{2277815346381832}\n# Break into new areas\nSome parts of the map require special items and gadgets to break or blast your way into. Discover these new places as well as the rarer and luxury-like items inside.\n{1759467231925453}\n**Loot the map with up to 15 friends and find new mechanics together**", "short_description": "Flunklug is a multiplayer co-op horror game with the goal of stealing what isn't yours. While being hunted down by monsters, get out, sell scraps and unlock new gadgets for the next run. Grab your friends and go deep into the map, exploring with weapons and items in the physics-driven world. The best loot is always furthest in."}]}, "developer_name": "Screen VR Studios", "developer_privacy_policy_url": "https://screenvrstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Screen VR Studios", "support_website_url": null, "website_url": "https://screenvrstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_t
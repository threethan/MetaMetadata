E-Jks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTFJQ3SY6zIEWCVVage9tpgd3fG0yel4dFj--p2cbwVg&oe=6AB54705"}, {"file_name": "Sewers.png", "id": "1578015807344912", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824741_1578015810678245_5694717527210957130_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1JiwFbpHA4Q7kNvwGBMw_U&_nc_oc=Ado_xEnqRI8PDvU6c0n-EAyk4roHq9sh9N9y8cU7tWm8jDajB_Dr0SxRm69jWjYKyNA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmjTgRwoG0b1r4kboZ3GLvrJh4qGmkJ5iITOBL1uuMDg&oe=6AB52901"}, {"file_name": "Screenshot3.png", "id": "4624535494502852", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824665_4624535497836185_7675873197190820290_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrkoTDqoOxsQ7kNvwHlNqVA&_nc_oc=AdroTHyfl7Sjf-QrDhGsLj3NoMg1ZZLC-YyMg7-6IQxhAyZiYdNXAZu4TUGNX4eoWzg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMEVdmQ43zuXSg-xIzhWwk41Eu-MDJX5CS4L-1uhOiSw&oe=6AB533E8"}, {"file_name": "Screenshot5.png", "id": "1053792317024180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823930_1053792320357513_4890416327565115902_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgdAOg7_VckQ7kNvwF7yqa0&_nc_oc=Ado1s5A6ZtKDk1nfeX4KETppvp5KtHLzKdqheclXvI8YpO37_G6eZYKVL6N7WsSlwqA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGbPq-kgiS3s2v81VBXrR3nUZ1-oNA8APGlxFmEEQhSQ&oe=6AB54CA7"}, {"file_name": "ScreeenShot6.png", "id": "1600943798277857", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828583_1600943801611190_4776163342314414381_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=La8zMh-Cb1cQ7kNvwHs8Au9&_nc_oc=Ado0ZrfDxol5ZG9vU4RQFkmcHJH6k2hf4JbiYoEmVdAvI-_QDfGZZtwGw7GfbvIJYYc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrlXpCEmG6lVnt99DBW6tLm0DlbPPC5ggJNpMuVXUMtQ&oe=6AB544B1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flunklug", "keywords": ["Horror", "Gorilla", "Scary", "Monkey", "Monsters"], "long_description": "**Some scrap is worth the risk. You'll find out which.**\n\nFlunklug is a multiplayer co-op horror game about stealing what isn't yours. Break into facilities, caverns and worse with your friends, grab everything of value you can carry, and get out before the things down there catch you first.\n# Sell scrap and buy items\nEvery escape pays for the next. Haul your scraps back out and sell them, unlock new gadgets and weapons, and gear up to push deeper than the run before.\n{1743942756650170}\n# Salvage and take scrap\nGo deep into a fully physics-driven world where everything reacts, breaks and gets in the way - then grab what you came for while monsters chase you through the dark.\n{2277815346381832}\n# Break into new areas\nSome parts of the map require special items and gadgets to break or blast your way into. Discover these new places as well as the rarer and luxury-like items inside.\n{1759467231925453}\n**Loot the map with up to 15 friends and find new mechanics together**", "short_description": "Flunklug is a multiplayer co-op horror game with the goal of stealing what isn't yours. While being hunted down by monsters, get out, sell scraps and unlock new gadgets for the next run. Grab your friends and go deep into the map, exploring with weapons and items in the physics-driven world. The best loot is always furthest in."}]}, "developer_name": "Screen VR Studios", "developer_privacy_policy_url": "https://screenvrstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Screen VR Studios", "support_website_url": null, "website_url": "https://screenvrstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_t
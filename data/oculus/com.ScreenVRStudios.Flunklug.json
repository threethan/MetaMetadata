89P-Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEFTQlN16e8dqLRpKVJf5q2mUac_q4870S47W2pBiWiQ&oe=6AB3F585"}, {"file_name": "Sewers.png", "id": "1578015807344912", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824741_1578015810678245_5694717527210957130_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1JiwFbpHA4Q7kNvwEigBdL&_nc_oc=AdqVAXyBmn_pQiSoAttziyI0IFYAqtHc4nkID-HUfmS5aL_uKc9Q8Yb_5ogw3dogH6k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9h_c2vNzk-Cal3Hanxk77MYP61zhTrv9ol_e76rfFMA&oe=6AB3D781"}, {"file_name": "Screenshot3.png", "id": "4624535494502852", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824665_4624535497836185_7675873197190820290_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrkoTDqoOxsQ7kNvwGHy2UM&_nc_oc=Adoe8oR1dPfV_aLLJU4m5IIfxVdrhQukJgpotP6nTX1Bfal0VvhGQ_dlc1QXK4IuO1A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2g9JmEuP9dOH9wSDWglXlS2BmWs-nEsTV-gQ_hylRnA&oe=6AB3E268"}, {"file_name": "Screenshot5.png", "id": "1053792317024180", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823930_1053792320357513_4890416327565115902_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HbkQWR-E8aoQ7kNvwHqcnv9&_nc_oc=AdoFefPIXZUJoyAO-PRGZPnxpUcPp2MepaT7hb5yITqYcAb3tgKgfSTnO5t_Vt7LxSo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_Y0kPOA8-VtsLFvfYt_X6IOBKvQRju8f5W0qzdG603A&oe=6AB3C2E7"}, {"file_name": "ScreeenShot6.png", "id": "1600943798277857", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828583_1600943801611190_4776163342314414381_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKNzm1WBPzoQ7kNvwGANvSP&_nc_oc=Ado89rYtqe3bjG2-HwQlSISQPJHYrMMQZZYQnyTOxlQjwcvuhiYiMJ2MD9zT4sXXRtM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKR7AV6qwubc-EBvWhXaK-FJRBN-icZPv9zCs-RAe3nrg&oe=6AB3F331"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flunklug", "keywords": ["Horror", "Gorilla", "Scary", "Monkey", "Monsters"], "long_description": "**Some scrap is worth the risk. You'll find out which.**\n\nFlunklug is a multiplayer co-op horror game about stealing what isn't yours. Break into facilities, caverns and worse with your friends, grab everything of value you can carry, and get out before the things down there catch you first.\n# Sell scrap and buy items\nEvery escape pays for the next. Haul your scraps back out and sell them, unlock new gadgets and weapons, and gear up to push deeper than the run before.\n{1743942756650170}\n# Salvage and take scrap\nGo deep into a fully physics-driven world where everything reacts, breaks and gets in the way - then grab what you came for while monsters chase you through the dark.\n{2277815346381832}\n# Break into new areas\nSome parts of the map require special items and gadgets to break or blast your way into. Discover these new places as well as the rarer and luxury-like items inside.\n{1759467231925453}\n**Loot the map with up to 15 friends and find new mechanics together**", "short_description": "Flunklug is a multiplayer co-op horror game with the goal of stealing what isn't yours. While being hunted down by monsters, get out, sell scraps and unlock new gadgets for the next run. Grab your friends and go deep into the map, exploring with weapons and items in the physics-driven world. The best loot is always furthest in."}]}, "developer_name": "Screen VR Studios", "developer_privacy_policy_url": "https://screenvrstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Screen VR Studios", "support_website_url": null, "website_url": "https://screenvrstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_t
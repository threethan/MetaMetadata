&oh=00_AQKZ65PlTinKWCliOqB0LdP8S2Eru2zDvTH2rv3NyZnbeA&oe=6AA6C685"}, {"file_name": "Screenshot3.png", "id": "4624535494502852", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824665_4624535497836185_7675873197190820290_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDaN3bTG3ycQ7kNvwEFjBaa&_nc_oc=Adq0yV9ALF4mY27BoB_i7db00mKoOVeeK1Bwq90LvbyplGIQ3NSN1XY-htP75E5Tn9o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIF0rLeMqnlieJvRlLQYtddYttM3y9ga2TXZwzevf8jMQ&oe=6AA6B368"}, {"file_name": "Screenshot5.png", "id": "1053792317024180", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823930_1053792320357513_4890416327565115902_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnvcPv2tE2QQ7kNvwFC1eeB&_nc_oc=AdoeLJ1S_RGxaSAAeYBzUZmB31DRPHZkDjelO1q-wM-52yFFh4cWsmfUOQUeFO5r_9Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIX9x9oehWVzSUdMMVxJmTMhbNGNF8kb5GryMqR1ohweQ&oe=6AA693E7"}, {"file_name": "Screenshot4.png", "id": "2210889576397565", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_2210889579730898_5674261755151029291_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0xNNi6PsY8Q7kNvwEccYh9&_nc_oc=AdqgqpFNfblYAnxDuBV8kzHtIglwdz3KKdqtvsBJS3FNIRhPf9DygEtDeYDH6H16x9k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0--LDsLBIkBK7w1n0WfrzxcYMdqvm5qrSQo7Ry6F8vQ&oe=6AA6C753"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flunklug", "keywords": ["Horror", "Gorilla", "Scary", "Monkey", "Monsters"], "long_description": "**Some scrap is worth the risk. You'll find out which.**\n\nFlunklug is a multiplayer co-op horror game about stealing what isn't yours. Break into facilities, caverns and worse with your friends, grab everything of value you can carry, and get out before the things down there catch you first.\n# Sell scrap and buy items\nEvery escape pays for the next. Haul your scraps back out and sell them, unlock new gadgets and weapons, and gear up to push deeper than the run before.\n{1743942756650170}\n# Salvage and take scrap\nGo deep into a fully physics-driven world where everything reacts, breaks and gets in the way - then grab what you came for while monsters chase you through the dark.\n{2277815346381832}\n# Break into new areas\nSome parts of the map require special items and gadgets to break or blast your way into. Discover these new places as well as the rarer and luxury-like items inside.\n{1759467231925453}\n**Loot the map with up to 15 friends and find new mechanics together**", "short_description": "Flunklug is a multiplayer co-op horror game with the goal of stealing what isn't yours. While being hunted down by monsters, get out, sell scraps and unlock new gadgets for the next run. Grab your friends and go deep into the map, exploring with weapons and items in the physics-driven world. The best loot is always furthest in."}]}, "developer_name": "Screen VR Studios", "developer_privacy_policy_url": "https://screenvrstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Screen VR Studios", "support_website_url": null, "website_url": "https://screenvrstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "CO_OP"], "id": "996016426703858"}}]}, "scheduled_offers": {"
_TWqNM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_5PoXprXChvQKMupHsShv4R8HkwDXSOR_IhLUmqQGCQ&oe=6A772D34"}, {"file_name": "Screenshot 2024-07-03 134956.png", "id": "1136487730892746", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982659_1136487737559412_348304797268477883_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_LNKhK5i1wQ7kNvwE9wq-V&_nc_oc=AdrdmIpPzxzfzTk6dgYvjE2dErge9vl4qViVD2vo_jx2oB_LLu6l-KjrWsRJ_-M-EFE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8LQfAnnnFPDNnqExPM7DlZdwbKsi8vs4VO9pHW5ceoQ&oe=6A773CAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Munki V3", "keywords": [], "long_description": "Welcome to Munki 3! We're thrilled to have you join us on this adventure. Sadly, our previous version had to bid farewell due to a mishap with the APK, but fear not, for we're back and better than ever! Get ready for a slew of updates in the pipeline, promising more excitement and thrills than ever before. Explore new maps, traverse through dense forests, and brace yourself for the spine-chilling horror that awaits in our yet-to-be-finished horror mode.\n\nBut remember, amidst all the excitement, we uphold certain values to ensure everyone has a great time. Cheating? Absolutely not allowed. Toxic behavior? Not here. Harassment? Absolutely out of the question. We're all about creating a welcoming and enjoyable environment for all players.\n\nSo, buckle up, grab your gear, and get ready to embark on an epic journey filled with challenges, mysteries, and endless fun. Welcome to Munki V3\u2014where the adventure never ends!", "short_description": "Munki is a game thats beem waited on by many!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/mikeike-inc/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "DominicDev/Munki V3 Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/mikeike-inc/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7771274422907569"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "449933224651549"}]}, "baseline_offer": {"id": "449933224651549"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1720209052, "status": "PUBLISHED", "id": "449933224651549"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7864232660278411", "version": "0.1.4"}, "id": "969934914430181", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7636982779670068", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7864232660278411"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "969934914430181"}]}, "change_log": null, "created_date": 1721689178, "id": "7935161026518907", "version": "0.2.3", "version_code": 23, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_
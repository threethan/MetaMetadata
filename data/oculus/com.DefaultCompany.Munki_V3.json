36487737559412_348304797268477883_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NR3gh2CBjWgQ7kNvwGuCOua&_nc_oc=Adl7xROxW0acbQT9kRL1JYB7N0msKFhlze2tLh6mLPbwhhBseZFKpFjXUmMgMpCv970&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu11s6cT8mSxHMC9fQ95IVsqVeQiM826NXC-xnsAzsJVw&oe=69A6EFAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Munki V3", "keywords": [], "long_description": "Welcome to Munki 3! We're thrilled to have you join us on this adventure. Sadly, our previous version had to bid farewell due to a mishap with the APK, but fear not, for we're back and better than ever! Get ready for a slew of updates in the pipeline, promising more excitement and thrills than ever before. Explore new maps, traverse through dense forests, and brace yourself for the spine-chilling horror that awaits in our yet-to-be-finished horror mode.\n\nBut remember, amidst all the excitement, we uphold certain values to ensure everyone has a great time. Cheating? Absolutely not allowed. Toxic behavior? Not here. Harassment? Absolutely out of the question. We're all about creating a welcoming and enjoyable environment for all players.\n\nSo, buckle up, grab your gear, and get ready to embark on an epic journey filled with challenges, mysteries, and endless fun. Welcome to Munki V3\u2014where the adventure never ends!", "short_description": "Munki is a game thats beem waited on by many!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/mikeike-inc/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "DominicDev/Munki V3 Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/mikeike-inc/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "in
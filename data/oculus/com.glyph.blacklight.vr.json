IMQ7kNvwEvd49u&_nc_oc=AdqFka3SQ7yJRwZLk7ZVfbPNAerZg9Onj_WoaV8m1kC3ZzFtiDOSRrSMIf0nye_hWN4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR23KuUIMgGZf64VEq1ZIOXpeyUXHl2GP4wMl797-5Nrg&oe=6AFB3E39"}, {"file_name": "s8_yggdrasil_2560x1440.png", "id": "1130631199429632", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/646423555_1130631202762965_3015211984408651920_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2pBHgM_eM4Q7kNvwGf2Xsb&_nc_oc=Adpd8VOI6jaTVfFsBsHTWQrIt9T8qWKJM7KgzWJZKrx7T9huwvlZNj0W_uCPvmTkSNg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFMO6FruOd6krYzh_NycQ41JsdGnRHhuPELzFMH4sAqQ&oe=6AFB2EF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "2113345252621588", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/604317775_2113345255954921_7175599941279188560_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQs9uQrVk84Q7kNvwEQUYxf&_nc_oc=AdrWbdMJGjV_tsYjBmtTjlP8BPPU4_nvT6VFjbq5E9xqPg9EZJ0mYxEBEiuWHg_OokA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRiwu7MKt5kmfQ7nDZH0tlcG-xp7-_mA7BJT-viuCYyw&oe=6AFB4774"}, "display_name": "BLACKLIGHT: An ASCII Bullet Hell", "keywords": ["bullethell", "retro", "shooter", "diorama", "ascii"], "long_description": "EVERY THING IS A SYMBOL.\n\nBLACKLIGHT is a twin-stick bullet hell played on a living diorama floating in front of you. Your ship, the swarms, the waves rolling across the arena and the colossal bosses are all made of thousands of glowing ASCII glyphs, in toxic green, UV purple and neon pink. Red means danger. Gold means grab it.\n\nFIGHT GODS MADE OF GLYPHS\nFace more than 80 unique bosses, from gods of Egypt, Greece, the Norse and Hindu legends to the zodiac and the constellations. Each one is a 3D glyph sculpture with its own attack, from Hades' bident to Dionysus' wine glass hurling clusters of grapes. Wear them down and watch them break apart piece by piece.\n\n200 STAGES \u00b7 42 LIVING ARENAS\nWaffles, pyramids, craters, black holes. The ground itself ripples, rolls and reacts to the fight. Difficulty ramps all the way up, and your progress saves every time you beat a boss.\n\nCHOOSE YOUR WARSHIP\nEarn XP to unlock new ships, from fighters to a flying saucer, and fit them with upgrade modules: twin guns, wing cannons, drone pods, shields and more.\n\nCHASE THE MULTIPLIER\nKeep killing to push your multiplier to x32. Stop and it halves. Get hit and you lose it.\n\nAN ORIGINAL SOUNDTRACK\n22 original tracks power the fight.\n\nCOMFORTABLE VR\nSeated or standing, stationary play. The arena sits in front of you like a tabletop, adjustable in height, distance and tilt. No artificial movement.\n\nEarly Access: more arenas, bosses and features are on the way. Feedback shapes the game.\n\n", "short_description": "A twin-stick bullet hell where everything \u2014 your ship, the enemies, the gods you fight \u2014 is built from glowing keyboard symbols."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vSJgnoKELBfKxSyA1FADe97Zd1hb8p4w05cf37TatUvEW52PzsVYDD5n7K_Rhhq3YZas7WuEJzEvNC8/pub", "developer_terms_of_service_url": null, "publisher_name": "Grindhouse Digital", "support_website_url": null, "website_url": "https://docs.google.com/document/d/e/2PACX-1vSJgnoKELBfKxSyA1FADe97Zd1hb8p4w05cf37TatUvEW52PzsVYDD5n7K_Rhhq3YZas7WuEJzEvNC8/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
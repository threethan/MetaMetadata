457497056413030165_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3CrW92IO04Q7kNvwEadPtB&_nc_oc=AdrbxMlmgK66FDaBV1QQl4m1NJy2fqOrRbrRXVdR4fsCkxpF-Gm4rrJgrq6yZspoHlI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSx6TnIIRbCP98mKrjBky4w1y_ZP8HLctKeXJ5JXGSD4w&oe=6AFB2B99"}, {"file_name": "screenshot_1_angel.png", "id": "2568246550334687", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/742308944_2568246553668020_8768043900713965388_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OITCLMdV9gkQ7kNvwEZ2kuW&_nc_oc=AdoSJKLqqDXeOoYq-P63hBG8Ib2EchDNxAR4UiYRtcIeys5XFCux-mQ_vf3a-zHEwig&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqp44zibOQwxaHzaLAn6OcXxYonDMIfflPMqG5KyHd9A&oe=6AFB1594"}, {"file_name": "s0_title_2560x1440.png", "id": "2136347860315697", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/654859273_2136347863649030_529063320962039102_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7Lvz5RW7yUQ7kNvwGaplKL&_nc_oc=AdpKBLlJ7NjaAwl3h7X7ELoLfkc2FU_9OV9UCj8qtUx9DMeFfAdkU8Kw7fOpC3MqWOo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3qm7gepiH00aTaXyDpuLilGNCyG1Uj4bSEoELl3VzzA&oe=6AFB25CE"}, {"file_name": "s9_hangar_2560x1440.png", "id": "1124035530064721", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/596168449_1124035533398054_9023616704872802127_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qso0S8VXNIMQ7kNvwEvd49u&_nc_oc=AdqFka3SQ7yJRwZLk7ZVfbPNAerZg9Onj_WoaV8m1kC3ZzFtiDOSRrSMIf0nye_hWN4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR23KuUIMgGZf64VEq1ZIOXpeyUXHl2GP4wMl797-5Nrg&oe=6AFB3E39"}, {"file_name": "s8_yggdrasil_2560x1440.png", "id": "1130631199429632", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/646423555_1130631202762965_3015211984408651920_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2pBHgM_eM4Q7kNvwGf2Xsb&_nc_oc=Adpd8VOI6jaTVfFsBsHTWQrIt9T8qWKJM7KgzWJZKrx7T9huwvlZNj0W_uCPvmTkSNg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFMO6FruOd6krYzh_NycQ41JsdGnRHhuPELzFMH4sAqQ&oe=6AFB2EF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "2113345252621588", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/604317775_2113345255954921_7175599941279188560_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQs9uQrVk84Q7kNvwEQUYxf&_nc_oc=AdrWbdMJGjV_tsYjBmtTjlP8BPPU4_nvT6VFjbq5E9xqPg9EZJ0mYxEBEiuWHg_OokA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRiwu7MKt5kmfQ7nDZH0tlcG-xp7-_mA7BJT-viuCYyw&oe=6AFB4774"}, "display_name": "BLACKLIGHT: An ASCII Bullet Hell", "keywords": ["bullethell", "retro", "shooter", "diorama", "ascii"], "long_description": "EVERY THING IS A SYMBOL.\n\nBLACKLIGHT is a twin-stick bullet hell played on a living diorama floating in front of you. Your ship, the swarms, the waves rolling across the arena and the colossal bosses are all made of thousands of glowing ASCII glyphs, in toxic green, UV purple and neon pink. Red means danger. Gold means grab it.\n\nFIGHT GODS MADE OF GLYPHS\nFace more than 80 unique bosses, from gods of Egypt, Greece, the Norse and Hindu legends to the zodiac and the constellations. Each one is a 3D glyph sculpture with its own attack, from Hades' bident to Dionysus' wine glass hurling clusters of grapes. Wear them down and watch them break apart piece by piece.\n\n200 STAGES \u00b7 42 LIVING ARENAS\nWaffles, pyramids, craters, black holes. The ground itself ripples, rolls and reacts to the fight. Difficulty ramps all the way up, and your progress saves every time you beat a boss.\n\nCHOOSE YOUR WARSHIP\nEarn XP to unlock new ships, from fighters to a flying saucer, and fit them with upgrade modules: twin guns, wing cannons, drone pods, shields and more.\n\nCHASE THE MULTIPLIER\nKeep killing to push your multiplier to x32. Stop and it halves. Get hit and you lose it.\n\nAN ORIGINAL SOUNDTRACK\n22 original tracks power the fight.\n\nCOMFORTABLE VR\nSeated or standing, stationary play. The arena sits in front of you like a tabletop, adjustable in height, distance and tilt. No artificial movement.\n\nEarly Access: more arenas, bosses and features are on the way. Feedback shapes the game.\n\n", "short_description": "A twin-stick bullet hell where everything \u2014 your ship, the enemies, the gods you fight \u2014 is built from glowing keyboard symbols."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vSJgnoKELBfKxSyA1FADe97Zd1hb8p4w05cf37TatUvEW52PzsVYDD5n7K_Rhhq3YZas7WuEJzEvNC8/pub", "developer_terms_of_service_url": null, "publisher_name": "Grindhouse Digital", "support_website_url": null, "website_url": "https://docs.google.com/document/d/e/2PACX-1vSJgnoKELBfKxSyA1FADe97Zd1hb8p4w05cf37TatUvEW52PzsVYDD5n7K_Rhhq3YZas7WuEJzEvNC8/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1285340071338686"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1091195133903630"}]}, "baseline_offer": {"id": "1091195133903630"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793332800, "status": "
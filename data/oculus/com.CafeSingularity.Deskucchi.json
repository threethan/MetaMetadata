d6-1.oculuscdn.com/v/t64.5771-25/39036605_643123524347857_5221622513294306562_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QP1gw9AGVacQ7kNvwHbx-eo&_nc_oc=AdqIh7Bx4PYdQiFiAVDORK8OUu2-pft0uBL1f3bgsTUcZ2_BsuOn7e-8_D96yt52fto&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwqps7H2agJjsOpqRxncaaqkf4uNeRSEFsah2ALNOMsw&oe=6A5E1E1F"}, {"file_name": "Screenshot3.png", "id": "1563429050847532", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031594_1563429054180865_3762551313080048002_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFB61LWPImgQ7kNvwF-QxIx&_nc_oc=AdpEh8Mq3y1TTCMLMM3zqCco2cLtIvplPyFXdj8Q215_GMG1hC9ud69cecHOK7RHsYA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBq5wEKhgfZU4O4jrO18CSPp40mLPnFAGTxALr7WmP95Q&oe=6A5E23CF"}, {"file_name": "Screenshot4.png", "id": "1730062150745536", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031465_1730062154078869_8759742099266589126_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LpyfWQLelsQ7kNvwEpwVuh&_nc_oc=Adr_fvCXzXCP45tNJWbb-A1vypoBlu4wFiSUZqzDl7v-x5dK1jDG36ZT9nB8Kq4LIG4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBflepillcPgeAAz4kgtiish-rTacxjwjaAzU8sLCUDww&oe=6A5E33BB"}, {"file_name": "Screenshot5.png", "id": "576615834609102", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982631_576615837942435_8824446291244536434_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ua6_PYbYnyEQ7kNvwEmuQTZ&_nc_oc=AdolMdt64PvxPasskPnzVPCSX7ZMJn0Jk220J1X82XRNvEJQor0MsfweXVZsuTZwmBI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZ6y_EDO7-jnyIE5xUfFKGCWDYq2TR6f8UKkcR8ziDmA&oe=6A5E2A39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Yhumbnail.png", "id": "3326435834333806", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982469_3326435837667139_2645825624435329363_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0YUoR_CMPEQ7kNvwHkc-gx&_nc_oc=Ado9t2pwyRHrhEz9Jh_prQ_Def6XrDsB2MyUxDUW5WZjnGcG0AtaGo-8oPGluZhnmE8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHkBwGKCQjEeOvEr-RNiSg-9wpIIEs6M0W7pIZkGlMIw&oe=6A5E25CA"}, "display_name": "Deskucchi", "keywords": [], "long_description": "\"Deskucchi\" is an MR (Mixed Reality) application that leverages MetaQuest's passthrough feature. It allows you to summon your favorite characters onto your desk and engage in conversations or enjoy games with them using AI technology.\n\nBut that's not all! In Deskucchi, you can also customize your desk and adjust collision with real-world objects and graphic culling. This enables seamless integration with the real space, creating an incredibly immersive MR environment.\n\nFurthermore, you can enjoy interactive gameplay using hand poses and gestures. It offers an intuitive and unique way to interact and have fun with the characters and games.\n\nDeskucchi plans to regularly add new games and customization elements through updates! Stay tuned for exciting updates that will enhance your experience.\n\nShare your Deskucchi experience on social media using the hashtag \"#Deskucchi\"! Let's share the world on our desks with people from all around the globe!", "short_description": "Deskucchi is an MR app that combines MetaQuest's passthrough feature for immersive experiences. \n\nSummon your favorite characters to your desk, talk to them using AI, and enjoy games. Customize your desk, adjust collisions with real objects, and create a seamless blend of virtual and real worlds. Engage in interactive gameplay with gestures. \n\nExpect updates with new games and customization options. Share your Deskucchi experience with the hashtag \"#Deskucchi\" and connect with people worldwide!"}, {"images": {"nodes": []}, "id": "366531453146664", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deskucchi", "keywords": [], "long_description": "\u300cDeskucchi\uff08\u30c7\u30b9\u30af\u3063\u3061\uff09\u300d\u306f\u3001MetaQuest\u306e\u30d1\u30b9\u30b9\u30eb\u30fc\u6a5f\u80fd\u3092\u6d3b\u7528\u3057\u305fMR\uff08Mixed Reality\uff09\u30a2\u30d7\u30ea\u30b1\u30fc\u30b7\u30e7\u30f3\u3067\u3059\u3002\u304a\u6c17\u306b\u5165\u308a\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u30c7\u30b9\u30af\u306e\u4e0a\u306b\u53ec\u559a\u3057\u3001AI\u6280\u8853\u3092\u4f7f\u3063\u3066\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3068\u4f1a\u8a71\u3057\u305f\u308a\u3001\u30b2\u30fc\u30e0\u3092\u697d\u3057\u3080\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\n\u305d\u308c\u3060\u3051\u3067\u306f\u3042\u308a\u307e\u305b\u3093\uff01Deskucchi\u3067\u306f\u3001\u30c7\u30b9\u30af\u306e\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3082\u53ef\u80fd\u3067\u3001\u73fe\u5b9f\u4e16\u754c\u306e\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3068\u306e\u885d\u7a81\u3084\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u30ab\u30ea\u30f3\u30b0\u306e\u8abf\u6574\u3082\u884c\u3048\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u73fe\u5b9f\u7a7a\u9593\u3068\u306e\u30b7\u30fc\u30e0\u30ec\u30b9\u306a\u878d\u5408\u304c\u53ef\u80fd\u3068\u306a\u308a\u3001\u9a5a\u304f\u307b\u3069\u6ca1\u5165\u611f\u306e\u3042\u308bMR\u74b0\u5883\u3092\u5275\u308a\u51fa\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\n\u3055\u3089\u306b\u3001\u624b\u306e\u30dd\u30fc\u30ba\u3084\u30b8\u30a7\u30b9\u30c1\u30e3\u30fc\u3092\u4f7f\u3063\u305f\u5bfe\u8a71\u578b\u30d7\u30ec\u30a4\u3082\u304a\u697d\u3057\u307f\u3044\u305f\u3060\u3051\u307e\u3059\u3002\u76f4\u611f\u7684\u304b\u3064\u30e6\u30cb\u30fc\u30af\u306a\u65b9\u6cd5\u3067\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3068\u306e\u4ea4\u6d41\u3084\u30b2\u30fc\u30e0\u3092\u697d\u3057\u3080\u3053\u3068\u304c\u53ef\u80fd\u3067\u3059\u3002\n\nDeskucchi\u3067\u306f\u3001\u65b0\u3057\u3044\u30b2\u30fc\u30e0\u3084\u30c7\u30b9\u30af\u306e\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u8981\u7d20\u3092\u5b9a\u671f\u7684\u306a\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3067\u8ffd\u52a0\u4e88\u5b9a\u3067\u3059\uff01\u8208\u596e\u
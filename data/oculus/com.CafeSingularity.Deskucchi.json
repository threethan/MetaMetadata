c6-1.oculuscdn.com/v/t64.5771-25/39036605_643123524347857_5221622513294306562_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iqbfkIz5-gQ7kNvwFIdEOp&_nc_oc=AdrLFKf2jkzaFJ1wCZqZrqAxHaogTeRQT68JrzC07TEa1EhPDMnE9S8a9B5qdakYnx4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af276_ujL0FthAJ3-8vfWnVFktjHMOyyA5cpReFP3ybW3g&oe=69E8C89F"}, {"file_name": "Screenshot3.png", "id": "1563429050847532", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031594_1563429054180865_3762551313080048002_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAOL5Bzy9T0Q7kNvwFIgm7k&_nc_oc=Adq-mpKqxgwg-2xnUTKIcRChj0elO9ohERWyiJSC5CN0c6InCfkYTN1GMRjhwA4JvHY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Wd8ir1nmPmBU7CYg2ZmjYL8xg5M9uka1e5xwSU7K63Q&oe=69E8CE4F"}, {"file_name": "Screenshot4.png", "id": "1730062150745536", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031465_1730062154078869_8759742099266589126_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmrWg9yA99wQ7kNvwF5cywp&_nc_oc=AdpGC9p6izPa723fziGg0Iix1ZMJM7sqoqIKDFsUSTutg5mz2ghV2qoI9cIGy8H_PWk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11h9uptVysuBrpMELkcUHR8jNiWIGWjR3o_axgFIkgKw&oe=69E8DE3B"}, {"file_name": "Screenshot5.png", "id": "576615834609102", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982631_576615837942435_8824446291244536434_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7nVHZPiY7AQ7kNvwEWDxlU&_nc_oc=AdrBFvnrpRVKCbt0IpCmobA_CkcmSKlOAsQJZHdQz6X4syZxmv6BV1iFfoaFRhYQP0k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DPJh_DjmllpwSkAOTGV0IDJw4r5EEC5jDjCc8hO55kQ&oe=69E8D4B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Yhumbnail.png", "id": "3326435834333806", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982469_3326435837667139_2645825624435329363_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9iNnuaNJiUQ7kNvwFRuKiF&_nc_oc=AdrsYD3UcKIgbFAHaXBV-naV2ggvVru4Q76pMnmgRmiIMN-IYhQhT4RnaO36VH4_SzE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Le0X9DmNe9Rt3pImeMFmzXy_L35YzwFkQiu01dcYlFA&oe=69E8D04A"}, "display_name": "Deskucchi", "keywords": [], "long_description": "\"Deskucchi\" is an MR (Mixed Reality) application that leverages MetaQuest's passthrough feature. It allows you to summon your favorite characters onto your desk and engage in conversations or enjoy games with them using AI technology.\n\nBut that's not all! In Deskucchi, you can also customize your desk and adjust collision with real-world objects and graphic culling. This enables seamless integration with the real space, creating an incredibly immersive MR environment.\n\nFurthermore, you can enjoy interactive gameplay using hand poses and gestures. It offers an intuitive and unique way to interact and have fun with the characters and games.\n\nDeskucchi plans to regularly add new games and customization elements through updates! Stay tuned for exciting updates that will enhance your experience.\n\nShare your Deskucchi experience on social media using the hashtag \"#Deskucchi\"! Let's share the world on our desks with people from all around the globe!", "short_description": "Deskucchi is an MR app that combines MetaQuest's passthrough feature for immersive experiences. \n\nSummon your favorite characters to your desk, talk to them using AI, and enjoy games. Customize your desk, adjust collisions with real objects, and create a seamless blend of virtual and real worlds. Engage in interactive gameplay with gestures. \n\nExpect updates with new games and customization options. Share your Deskucchi experience with the hashtag \"#Deskucchi\" and connect with people worldwide!"}, {"images": {"nodes": []}, "id": "366531453146664", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deskucchi", "keywords": [], "long_description": "\u300cDeskucchi\uff08\u30c7\u30b9\u30af\u3063\u3061\uff09\u30
o_OhyL6CQ&oe=6A8D99CF"}, {"file_name": "Screenshot4.png", "id": "1730062150745536", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031465_1730062154078869_8759742099266589126_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iM4ub8h9fqAQ7kNvwEB21Fi&_nc_oc=AdqlFtqaXUupC7mysYBR0olvyUoajpTczBP_6-Birin6My2-bQY5da1nExoRTH1imKI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2Jo0pY2h2h_9cAUHTSSJxEDmsDwMpqNTpk6pNy8NhaA&oe=6A8D717B"}, {"file_name": "Screenshot5.png", "id": "576615834609102", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982631_576615837942435_8824446291244536434_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWs0-EB3zGMQ7kNvwGdQsT5&_nc_oc=Adrfjb2fKI620hGqnCBSz_g7rw3bfJcBQRFOp0tgBZuwKaApK52NaY-lPup-RfxWukg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWzEdRhzPpGM5Z1trFEpkdbnLfUKEvUaYl0ll7eiulxQ&oe=6A8D67F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Yhumbnail.png", "id": "3326435834333806", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982469_3326435837667139_2645825624435329363_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nn2HHN0NuN8Q7kNvwHbNJUE&_nc_oc=Adqt2fJchEwmWvR7F5FqAWbOUaskN_4HqVVCZveMskSY2s5n7HfG60sU6EgoQhEIFuo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaOO5oJ2i0LlOq4Aw3f4VNHDSWMu-hUwnmxITMy3aW1A&oe=6A8D9BCA"}, "display_name": "Deskucchi", "keywords": [], "long_description": "\"Deskucchi\" is an MR (Mixed Reality) application that leverages MetaQuest's passthrough feature. It allows you to summon your favorite characters onto your desk and engage in conversations or enjoy games with them using AI technology.\n\nBut that's not all! In Deskucchi, you can also customize your desk and adjust collision with real-world objects and graphic culling. This enables seamless integration with the real space, creating an incredibly immersive MR environment.\n\nFurthermore, you can enjoy interactive gameplay using hand poses and gestures. It offers an intuitive and unique way to interact and have fun with the characters and games.\n\nDeskucchi plans to regularly add new games and customization elements through updates! Stay tuned for exciting updates that will enhance your experience.\n\nShare your Deskucchi experience on social media using the hashtag \"#Deskucchi\"! Let's share the world on our desks with people from all around the globe!", "short_description": "Deskucchi is an MR app that combines MetaQuest's passthrough feature for immersive experiences. \n\nSummon your favorite characters to your desk, talk to them using AI, and enjoy games. Customize your desk, adjust collisions with real objects, and create a seamless blend of virtual and real worlds. Engage in interactive gameplay with gestures. \n\nExpect updates with new games and customization options. Share your Deskucchi experience with the hashtag \"#Deskucchi\" and connect with people worldwide!"}, {"images": {"nodes": []}, "id": "563875485650841", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deskucchi", "keywords": [], "long_description": "\u300cDeskucchi\uff08\u30c7\u30b9\u30af\u3063\u3061\uff09\u300d\u306f\u3001MetaQuest\u306e\u30d1\u30b9\u30b9\u30eb\u30fc\u6a5f\u80fd\u3092\u6d3b\u7528\u3057\u305fMR\uff08Mixed Reality\uff09\u30a2\u30d7\u30ea\u30b1\u30fc\u30b7\u30e7\u30f3\u3067\u3059\u3002\u304a\u6c17\u306b\u5165\u308a\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u30c7\u30b9\u30af\u306e\u4e0a\u306b\u53ec\u559a\u3057\u3001AI\u6280\u8853\u3092\u4f7f\u3063\u3066\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3068\u4f1a\u8a71\u3057\u305f\u308a\u3001\u30b2\u30fc\u30e0\u3092\u697d\u3057\u3080\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\n\u305d\u308c\u3060\u3051\u3067\u306f\u3042\u308a\u307e\u305b\u3093\uff01Deskucchi\u3067\u306f\u3001\u30c7\u30b9\u30af\u306e\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3082\u53ef\u80fd\u3067\u3001\u73fe\u5b9f\u4e16\u754c\u306
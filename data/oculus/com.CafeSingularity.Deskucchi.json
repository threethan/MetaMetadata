l3-2.oculuscdn.com/v/t64.5771-25/39036605_643123524347857_5221622513294306562_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XiAmNm30ATQQ7kNvwGJGfY6&_nc_oc=AdqcfGMqH2CVKaLl_ChZByzL23ffCgQcoO1HU6CutpXIAcooDeKl8U99qR0AYi5WmBc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxfsZYonf2MwOXXEk49zoabYrAGntu5fUZpDqR2IxepCw&oe=69CFBC1F"}, {"file_name": "Screenshot3.png", "id": "1563429050847532", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031594_1563429054180865_3762551313080048002_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibEqNWin8LsQ7kNvwFbYfPc&_nc_oc=Ado6SPfleOIwyPNMJttbPnp9uBXIKNtTjcmp8iIuKn1ETKVkUcwYMPnfH85hUxmyFrs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzO-15D4GNev8oWrOthq3JBlUHDqPuTQsrSufs2hpWbTw&oe=69CFC1CF"}, {"file_name": "Screenshot4.png", "id": "1730062150745536", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031465_1730062154078869_8759742099266589126_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fD4I08mk2DsQ7kNvwF98V1l&_nc_oc=AdpCi7ngiWAqRl2Ql_m7Rcto8SWZY2wxuX9EHfL2xBTIkJQNvLnxC_aPvDoCKglWaXI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzwrTa1WCTwbea9sMwlEJwwWqtR0vZkIom1FJaHCcFntw&oe=69CFD1BB"}, {"file_name": "Screenshot5.png", "id": "576615834609102", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982631_576615837942435_8824446291244536434_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qzSTiDWY8JcQ7kNvwGM0bkX&_nc_oc=Adp8CVtYCwDd3_dXTH2hiBuJNylUsxZUZEWfUEg3cOxNBOTnKUP9T_uLubDlaQddlaM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxdnVZdJEcjO4OK2qBUyvB6xxbUWC-xO_59I2V4lQuWZQ&oe=69CFC839"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Yhumbnail.png", "id": "3326435834333806", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982469_3326435837667139_2645825624435329363_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9UTZhyQRreoQ7kNvwFzxmpY&_nc_oc=AdqkKqOWya3_OrjxdHeyrONNblRB3Avq9iSwsNmAAmIevYAoCxLhy5DCBpnS5vr52U4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxEUX7KcUYga4ZPOEN-VtoWprrGsQ5EU3KQy1hu2hIbhw&oe=69CFC3CA"}, "display_name": "Deskucchi", "keywords": [], "long_description": "\"Deskucchi\" is an MR (Mixed Reality) application that leverages MetaQuest's passthrough feature. It allows you to summon your favorite characters onto your desk and engage in conversations or enjoy games with them using AI technology.\n\nBut that's not all! In Deskucchi, you can also customize your desk and adjust collision with real-world objects and graphic culling. This enables seamless integration with the real space, creating an incredibly immersive MR environment.\n\nFurthermore, you can enjoy interactive gameplay using hand poses and gestures. It offers an intuitive and unique way to interact and have fun with the characters and games.\n\nDeskucchi plans to regularly add new games and customization elements through updates! Stay tuned for exciting updates that will enhance your experience.\n\nShare your Deskucchi experience on social media using the hashtag \"#Deskucchi\"! Let's share the world on our desks with people from all around the globe!", "short_description": "Deskucchi is an MR app that combines MetaQuest's passthrough feature for immersive experiences. \n\nSummon your favorite characters to your desk, talk to them using AI, and enjoy games. Customize your desk, adjust collisions with real objects, and create a seamless blend of virtual and real worlds. Engage in interactive gameplay with gestures. \n\nExpect updates with new games and customization options. Share your Deskucchi experience with the hashtag \"#Deskucchi\" and connect with people worldwide!"}, {"images": {"nodes": []}, "id": "366531453146664", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deskucchi", "keywords": [], "long_description": "\u300cDeskucchi\uff08\u30c7\u30b9\u30af\u3063\u3061\uff09\u30
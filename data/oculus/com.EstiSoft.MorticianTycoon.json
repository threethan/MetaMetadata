491822968_677877464843667_8519124859885175767_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBritJqHSj4Q7kNvwFF5WXL&_nc_oc=Adruyccl0UM_OhhJxjyMfa63FDayNSaxqKFzbG7cxOQ-S2IrUv_shc8QPmCp8uMLeGM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUlYr7A2S6Q6iKxSdpNWFc_ZUH6BVFxWsXB9HFAAwvVSQ&oe=6B0F0030"}, "display_name": "Mortician Tycoon", "keywords": [], "long_description": "Welcome to Mortician Tycoon, a darkly humorous VR simulation where you run your very own funeral empire! As the quirky mortician, your job is to dig graves, prepare coffins, manage customers (both living and dead), and handle unexpected guests like ghosts or even the Grim Reaper himself!\n\nOrganize your cemetery, upgrade your equipment, and build new sections of your spooky business. Hire staff to speed up burials, automate coffin production, and customize your graveyard.\n\nWith intuitive controls, stylized visuals, and hilarious interactions, Mortician Tycoon is perfect for casual players who love management games with a twist. Will you become the most successful funeral director in VR history?", "short_description": "Step into the strange yet funny world of Mortician Tycoon! Manage coffins, bury the dead, serve spooky guests, and build your funeral empire. Hire helpers, upgrade your mortuary, and keep the Grim Reaper happy. It\u2019s the ultimate mix of business and the afterlife\u2014made for VR!\n\n"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ad
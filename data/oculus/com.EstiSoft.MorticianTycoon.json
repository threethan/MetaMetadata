, upgrade your equipment, and build new sections of your spooky business. Hire staff to speed up burials, automate coffin production, and customize your graveyard.\n\nWith intuitive controls, stylized visuals, and hilarious interactions, Mortician Tycoon is perfect for casual players who love management games with a twist. Will you become the most successful funeral director in VR history?", "short_description": "Step into the strange yet funny world of Mortician Tycoon! Manage coffins, bury the dead, serve spooky guests, and build your funeral empire. Hire helpers, upgrade your mortuary, and keep the Grim Reaper happy. It\u2019s the ultimate mix of business and the afterlife\u2014made for VR!\n\n"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24388548867400237"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "27836950962638257"}, {"status": "PUBLISHED", "id": "816967264815019"}, {"status": "PUBLISHED", "id": "907755645115146"}, {"status": "PUBLISHED", "id": "763828899614441"}, {"status": "PUBLISHED", "id": "2125299747955711"}, {"st
ame": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-05-13 022917.png", "id": "1128223225985736", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491818916_1128223229319069_5445447946023679589_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GfgkfrUm3EQ7kNvwEiA1Dx&_nc_oc=Adrdj0z01TWSHNxbsvoMBX6uJJJR5VN5bc4rKq4zfE0iqCagNO9p2aQOPdXPnRVtoio&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx2Y_X1uwk4NgdUIJVtODpP7vU5So9_DcHX41sv0sjLXA&oe=69C52F45"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-05-13 022906.png", "id": "673440995308352", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822581_673440998641685_7707714308678360315_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Hu5qAHcy3YQ7kNvwG75d7L&_nc_oc=AdqxriRaKqIvDvGr5KFvF8MNAOFzXbiFBs6bknP2emHoxK4EJWbV5gQSuFFs0zBrpjw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afya9Drrs4zw7zGhfn2qaHrqtu701NJoG4_ecwegRHTGZw&oe=69C52881"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-05-13 022929.png", "id": "677877461510334", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822968_677877464843667_8519124859885175767_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zy-e0AI4aLwQ7kNvwEICFG5&_nc_oc=AdqZRxEyfOGkKz2q-nreHHYv6qtFVBsuaaH_Yb64bZ3graGjJwc4H7aMViE1dqekTV4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyOEmzm8FE5nUuITUbEkzX84NOWeRsB_1gx-xAbr2yR1A&oe=69C530F0"}, "display_name": "Mortician Tycoon", "keywords": [], "long_description": "Welcome to Mortician Tycoon, a darkly humorous VR simulation where you run your very own funeral empire! As the quirky mortician, your job is to dig graves, prepare coffins, manage customers (both living and dead), and handle unexpected guests like ghosts or even the Grim Reaper himself!\n\nOrganize your cemetery, upgrade your equipment, and build new sections of your spooky business. Hire staff to speed up burials, automate coffin production, and customize your graveyard.\n\nWith intuitive controls, stylized visuals, and hilarious interactions, Mortician Tycoon is perfect for casual players who love management games with a twist. Will you become the most successful funeral director in VR history?", "short_description": "Step into the strange yet funny world of Mortician Tycoon! Manage coffins, bury the dead, serve spooky guests, and build your funeral empire. Hire helpers, upgrade your mortuary, and keep the Grim Reaper happy. It\u2019s the ultimate mix of business and the afterlife\u2014made for VR!\n\n"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24388548867400237"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "907755645115146"}, {"status": "PUBLISHED", "id": "763828899614441"}, {"status": "PUBLISHED", "id": "2125299747955711"}, {"status": "PUBLISHED", "id": "2012425829284313"}]}, "baseline_offer": {"id": "2012425829284313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771185600, "status": "PUBLISHED", "id": "907755645115146"}]}, "liveCha
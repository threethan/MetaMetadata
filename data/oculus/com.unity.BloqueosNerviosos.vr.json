gqA&oe=6AAAAA04"}, {"file_name": "screenshot_3.png", "id": "1490658339521838", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304764_1490658342855171_7655304571748768999_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahRbABn9oYUQ7kNvwF9z9Yo&_nc_oc=AdqfSCIbSMObu8Uv2sX-5llQGXMndp0DJFwehZ05yPIjWbJSFf0Pr4ETcLyYTiJcXw4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJx0EYqi_yjzjZHoGrb2GYLmtP3jKWD0QFXEx1Mi6t_JA&oe=6AAABB44"}, {"file_name": "screenshot_4.png", "id": "993653749747668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307433_993653753081001_3338196450747820440_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfiTwBJarbIQ7kNvwHmjdgC&_nc_oc=AdrWSUI02G0ux3m7OaqIE_MidXeOCzFq4xP23K7rcnNOCjhizBUGJJtv4C3jBChMpoo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPuO7SZtdwnItXCoz2edtFhGbHYp84HCRUjduW-ZbjIw&oe=6AAAAACF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bloqueos Neuromusculares VR", "keywords": ["ultrasonido", "entrenamiento"], "long_description": "Lleva tu formaci\u00f3n en anestesia regional al siguiente nivel con un simulador inmersivo de bloqueos neuromusculares guiados por ultrasonido.\nSum\u00e9rgete en un quir\u00f3fano virtual donde podr\u00e1s practicar tres bloqueos clave de la pr\u00e1ctica cl\u00ednica diaria:\n\u2022 Bloqueo de codo \u2014 perfecciona la identificaci\u00f3n de los nervios mediano, radial y cubital.\n\u2022 Bloqueo supraclavicular \u2014 domina la visualizaci\u00f3n del plexo braquial y evita estructuras cr\u00edticas como la pleura y la arteria subclavia.\n\u2022 Bloqueo femoral \u2014 entrena el abordaje del nervio femoral con precisi\u00f3n anat\u00f3mica.\n\u00bfQu\u00e9 encontrar\u00e1s dentro?\n\u2713 Sonoanatom\u00eda realista con ecograf\u00eda simulada en tiempo real.\n\u2713 Manejo de la aguja con retroalimentaci\u00f3n h\u00e1ptica y visual.\n\u2713 Repetici\u00f3n ilimitada sin riesgo para el paciente.\n\u2713 Escenarios dise\u00f1ados para residentes, anestesi\u00f3logos y formadores.\nUna herramienta de entrenamiento ideal para programas de residencia, hospitales universitarios y profesionales que buscan reforzar su t\u00e9cnica antes del paciente real.\nPractica. Equiv\u00f3cate. Domina. Sin consecuencias.", "short_description": "Entrena bloqueos neuromusculares guiados por ultrasonido en un entorno VR realista y seguro. Practica las t\u00e9cnicas de bloqueo de codo, supraclavicular y femoral las veces que necesites, sin riesgo para el paciente. Domina la anatom\u00eda, la sonoanatom\u00eda y la precisi\u00f3n de la aguja antes de llevarlo a la pr\u00e1ctica cl\u00ednica."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/2dc948ea-5fbf-4a6e-8e1f-b1351197eb69", "developer_terms_of_service_url": null, "publisher_name": "Aurora Pixel Studio", "support_website_url": null, "website_url": "https://pocusvr.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_CO"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26450640021284396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303672_1257877446167198_4169528807528674976_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWuozleY-3wQ7kNvwE-GQCt&_nc_oc=AdqoG3mv6mCSUo_4NEXSHvKnQKSnEDyiom61ebMpYgM8bdxiiwo208aDz9j2-mVwW88&_nc_zt=3&_nc_
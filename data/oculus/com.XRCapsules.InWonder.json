7845581564992607013_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9D5bCj_BTAQ7kNvwE0CWgW&_nc_oc=AdoVq8fDG83WSwjbLzN5dociWcejCXjcI_9_d9RwY7bakanzGZKSoP5bJPuJzASvv6E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQARtjKib_zl_iQME-MrQIQ9epwB68YT46-X8U_xsAfzw&oe=6B0DCEBE"}, {"file_name": "InWonder-Birds.png", "id": "2180623646088456", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618293_2180623652755122_2275315813285683063_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScuYhqiFsbAQ7kNvwG5ng4l&_nc_oc=AdqcElDgRb6OZ0yjREKFjWv-HbADkZGmkJoD6-tFWpP4SO7IyBFfVsTHocnD4I7xl4w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSQov4yNQ3gHF4xf3aA6K4EUIvz51WR4EnRGgodkGBjuw&oe=6B0D9D05"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "In Wonder", "keywords": ["cozy", "wonder", "world", "Immersion", "Dreamscape"], "long_description": "- Explorers looking for a relaxing, non-game escape\n- Fans of nostalgia, atmospheric immersion, or ambient worlds\n- Apartment dwellers wanting something personal and transformative\n\n# Turn your real-world apartment into a calming, surreal escape without ever leaving the room\n\nThis Mixed Reality experience blends your physical environment with immersive transformation like a **4D movie experience, mesmerizing gameplay, and intuitive interactive artifacts.**\n\n\ud83e\udde0 **Features:**\n\n\ud83d\udcf7 Real-world photo import: Capture your space and personalize your MR experience (MR and VR) \n\n\ud83c\udf0c Seamless transformation via scene understanding: walls, furniture, and lighting\n\n\ud83d\udd0d Interactive \u201crelics\u201d that spark ambient sounds, animations, or memories\n\n\ud83c\udf08 Multiple themes starting with space, underwater, and cabin retreat. \n\n{919666410929775}\n\n# Venture into your space as you\u2019ve never seen it\n\n- Bring your world into the experience, and reshape it into something wonderful\n- Snap a picture of your real space and import it into the app to shape how the MR elements adapt and react. Every environment becomes yours uniquely.\n\n{1658328865167768}\n\n\ud83d\udd17 https://discord.gg/9dxeBtEJUt\n\n# \ud83d\ude80 New worlds and customizations are added regularly!\n", "short_description": "Transform your space. Escape the ordinary.\nBuild your own 4D movie experience. Write your own story and journey"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/jimmyd95/In-Wonder-Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "XR Capsules", "support_website_url": null, "website_url": "https://www.xrcapsules.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "726368587961803"}, {"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "26443974821880944"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1453497929529010"}]}, "baseline_offer": {"id": "1453497929529010"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795193400, "status": "PUBLISHED", "id": "1453497929529010"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26670999495845141", "version": "1.0.3"}, "id": "2408179229611233", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": 
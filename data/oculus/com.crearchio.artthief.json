nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzKW47-7ywKM4EdwT17ARHACDiVsk4CblSr495pWagCw&oe=6A491B0B"}, "display_name": "Art Thief: Inside the Masterpiece", "keywords": ["art", "puzzle", "vangogh", "vermeer", "salvadordali"], "long_description": "The Masterpiece is Waiting for You. When you enter the gallery, you are met with a mysterious figure \"The Curator\" and three empty frames. The world's most beloved treasures, Van Gogh's \"Starry Night,\" Vermeer's \"Girl with a Pearl Earring,\" and Dal\u00ed's \"The Persistence of Memory\" have vanished. But they haven't been stolen!\n\nStep Inside the Art \"Art Thief: Inside the Masterpiece\" is an immersive VR puzzle adventure that challenges your perception of art. You won't just look at these paintings; you will live inside them.\n\nKey Features:\n\nThree Unique Worlds: Each masterpiece is a fully realized 3D environment with its own atmosphere and artistic style.\n\nInteractive Puzzles: Solve trivia and art-based quizzes to reveal the locations of missing fragments.\n\nDynamic Gameplay:\n\nMaster the flow of time, destroy the clocks to navigate Dal\u00ed's surreal landscape.\n\nUse precision to clear unwanted objects and restore Vermeer\u2019s vision.\n\nGive right answers and piece together the swirling celestial beauty of Van Gogh's night sky.\n\nA Deep Narrative: Meet The Curator of the gallery and discover the true meaning of artistic legacy. You'll learn that art never truly ends, it lives and reshapes itself within the human mind.\n\nCan you complete the masterpieces, or will they remain unfinished forever?", "short_description": "Step into the frame and solve the mystery of the missing masterpieces. Travel through the iconic worlds of Van Gogh, Vermeer, and Dal\u00ed to recover stolen fragments. Confront puzzles, play with time in Dal\u00ed\u2019s realm, and clear obstacles in Vermeer\u2019s. Are these works truly gone, or do they evolve within us? Experience a VR journey where art isn't just a finished canvas, it's a living memory. Discover the truth behind the frame: Art is never finished!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.crearchio.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Crearchio", "support_website_url": "https://www.crearchio.com/contact", "website_url": "https://www.crearchio.com/artthief", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33532217423059566"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "996981752976853"}, {"status": "PUBLISHED", "id": "1130931072459877"}, {"status": "PUBLISHED", "id": "3318430798312817"}, {"status": "PUBLISHED", "id": "1424056353064475"}]}, "baseline_offer": {"id": "1424056353064475"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "996981752976853"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "33847268021554503", "version": "1.1"}, "id": "26323701880568374", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "33532217359726239", "is_c
ng", "id": "2913496218921724", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035356_2913496222255057_8111201497125133220_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xTD4pG7dX8Q7kNvwHhPP-6&_nc_oc=AdpuuW5GQHtVaQ836UlASrlyh_RRm2vW_HUfJUdOT29jOmSxaAqJsBNODD-TzGgzmuo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCEeQsTmNdhi-RneqbNKyVp2I6awHG_dI_ZA-HS8CQEg&oe=6B05D02B"}, {"file_name": "screen3.png", "id": "1154336788358501", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982471_1154336795025167_5529760307156287612_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQ8DPc1D6OsQ7kNvwH-l7Nu&_nc_oc=AdqAi0u-u6MCBGAblJUHo1GVyUXpagGpdxn3Wl2RLPZHlyjJ6b2fZzywgCXRrtX3HHg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmfDdUIqvD7UE64D-tghDIBOzGbb-gX5fI4pKgu7s4AA&oe=6B05C6BC"}, {"file_name": "Capture 1aa.png", "id": "126191966046336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974827_126191969379669_7612736244549055214_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZhDn6vjV2oQ7kNvwGZaiSO&_nc_oc=AdrZ6fA8NruvOL0uWoKAgJ6ASf1kNk2rP6rKpz0vjie--E5-rE-8iQgf5IPaxhXBvXk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiFqogAswyz01pcG1aqoy5K5-2L5rLy2IpOYLcmPhvJA&oe=6B05B388"}, {"file_name": "Capture 8aa.png", "id": "237969191155872", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974827_237969194489205_3331846548083113255_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bU2TJq2upmwQ7kNvwFZjlwQ&_nc_oc=AdrePwqW_AQZIIU9luLfFupOlwycKStqXr3cXLvkphtlijd_IwjB_2fHsfW6fVRwmnc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQO3hqmV_tBMlC-bFsYlySY_euThPsYhhm6lQnc7jYDDQ&oe=6B05CF28"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ROVR", "keywords": [], "long_description": "Take your quarterback play to the next level with professional grade VR training.  Learn, move, interact, and make-decisions just like you do on the field. \n\nThe REPS ROVR App lets you learn and improve sport specific time sensitive decision-making while getting unlimited repetitions through immersive virtual reality using the patent-pending REPS development system.  Each practice repetition is graded and recorded for review by the player or a coach.  The untethered Quest headset and ROVR\u2019s handsfree vision and voice interface allows you to move with a ball in your hand just as you would in your sport.  Practice on your own or with a remote coach to take your play to the next level.    \n", "short_description": "Take your quarterback play to the next level with professional grade VR training.  Learn, move, interact, and make-decisions just like you do on the field. The REPS ROVR App lets you learn and improve sport specific time sensitive decision-making while getting unlimited repetitions through immersive virtual reality using the patent-pending REPS development system.  Each practice repetition is graded and recorded for review by the player or a coach.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://repsvr.com/privacy-policy", "developer_terms_of_service_url": "https://repsvr.com/terms-and-conditions", "publisher_name": "REPS", "support_website_url": "https://repsvr.com/contact-us", "website_url": "https://www.repsvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "2776542286000603"}, {"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SIMULATION", "EXPERIENCE_360_NON_GAME", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app
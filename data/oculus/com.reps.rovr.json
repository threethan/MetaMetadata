ng", "id": "2913496218921724", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035356_2913496222255057_8111201497125133220_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKLn7ro9aUYQ7kNvwH93G2Q&_nc_oc=AdrQf0Z49nS7-c_8KwPRUMQCC6qzilcPD0uzcCNQU5otDYcLL6I2P3tlBbU6Y1ikTFY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMee2rZc8BefcLLre_oB55XesbytvaXAedOhB9QyMAgg&oe=6AFDAEEB"}, {"file_name": "screen3.png", "id": "1154336788358501", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982471_1154336795025167_5529760307156287612_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cE-wKF5ApcIQ7kNvwGr1AnA&_nc_oc=Adqbw0as9PD8p-bVmkwIf-JoeiLjmoh8Hg8pnovAjBu9dBr6BuLcIdT-J38johOwMOc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTStkjv5pxqQDqTpDsVMjglklOPp4VOa5s4VchMVg86WQ&oe=6AFDDDBC"}, {"file_name": "Capture 1aa.png", "id": "126191966046336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_126191969379669_7612736244549055214_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KT61qPB1rosQ7kNvwHrG32Z&_nc_oc=AdrZjOz1Z3nYArLIy3lj4tLCcDlaplSnkev5ZqXjiYdVzD2_hyEks66uYqqig-ROevs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxMy_WkvJW9rueRT8pYxITt6ktPUqIqdOEfi4aizL9yw&oe=6AFDCA88"}, {"file_name": "Capture 8aa.png", "id": "237969191155872", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974827_237969194489205_3331846548083113255_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jeBE6nE-xa8Q7kNvwG2cCbE&_nc_oc=Adph3Js7pPazTF99K2n-JIhVaEfOPzxsnv6gUJcHsA5FPLwXzjj7HbFZogfztUvPkdc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpnwByN4MJBNQgitJD86JoNc37eRxPFn20KnBre-fjrw&oe=6AFDADE8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ROVR", "keywords": [], "long_description": "Take your quarterback play to the next level with professional grade VR training.  Learn, move, interact, and make-decisions just like you do on the field. \n\nThe REPS ROVR App lets you learn and improve sport specific time sensitive decision-making while getting unlimited repetitions through immersive virtual reality using the patent-pending REPS development system.  Each practice repetition is graded and recorded for review by the player or a coach.  The untethered Quest headset and ROVR\u2019s handsfree vision and voice interface allows you to move with a ball in your hand just as you would in your sport.  Practice on your own or with a remote coach to take your play to the next level.    \n", "short_description": "Take your quarterback play to the next level with professional grade VR training.  Learn, move, interact, and make-decisions just like you do on the field. The REPS ROVR App lets you learn and improve sport specific time sensitive decision-making while getting unlimited repetitions through immersive virtual reality using the patent-pending REPS development system.  Each practice repetition is graded and recorded for review by the player or a coach.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://repsvr.com/privacy-policy", "developer_terms_of_service_url": "https://repsvr.com/terms-and-conditions", "publisher_name": "REPS", "support_website_url": "https://repsvr.com/contact-us", "website_url": "https://www.repsvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "2776542286000603"}, {"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SIMULATION", "EXPERIENCE_360_NON_GAME", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app
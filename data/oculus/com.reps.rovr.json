ng", "id": "2913496218921724", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035356_2913496222255057_8111201497125133220_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSaNmATZzGQQ7kNvwHlysPJ&_nc_oc=AdpgkCpMysXbNOxMlj6GvNnZ9dNvrlEW9fCs70Vdr4A2wdmcK1RDOWeUZFoSzMGzBMM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQu1a5FUVjy9nyfH_Djho5N-JmWq2xmutpDRmmjLonSzw&oe=6B09C4AB"}, {"file_name": "screen3.png", "id": "1154336788358501", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982471_1154336795025167_5529760307156287612_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EreHQu38DMoQ7kNvwHpkSXy&_nc_oc=Adqu4YBjuiIakSqBfLeMkJMcd_DEg9_asKuhEi96Zw0g_dfJoGwCizI4XKs7Ywnphjg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFgbJYWTJtdkII_LUqXqxDTVB3X4tRE9Dkhv_lPSWv0A&oe=6B09BB3C"}, {"file_name": "Capture 1aa.png", "id": "126191966046336", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974827_126191969379669_7612736244549055214_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvNC85R0DmkQ7kNvwGHLJQw&_nc_oc=AdrPbla8RleFRcxDRqsMnLdgTNmP2o6Ks5HF54VLyCvcW70gWCkzHGUplPtCq2B_J7Q&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOjdizJ13eCMvaiHBXAWQLURE9PCJrCs7RkD0CWcQFog&oe=6B09A808"}, {"file_name": "Capture 8aa.png", "id": "237969191155872", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974827_237969194489205_3331846548083113255_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJgi60CmtT0Q7kNvwFIaz48&_nc_oc=AdrUceKnxm4SU8VlM0mItDqRQhqNx_-xUIQi8bYvUb9zJVEyBb_j9pmd4x0YMKYIVig&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvNh3PWkFTI9nqWzkfZ-uITVDVq8H4V4i7Dv5eZ1QPMw&oe=6B09C3A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ROVR", "keywords": [], "long_description": "Take your quarterback play to the next level with professional grade VR training.  Learn, move, interact, and make-decisions just like you do on the field. \n\nThe REPS ROVR App lets you learn and improve sport specific time sensitive decision-making while getting unlimited repetitions through immersive virtual reality using the patent-pending REPS development system.  Each practice repetition is graded and recorded for review by the player or a coach.  The untethered Quest headset and ROVR\u2019s handsfree vision and voice interface allows you to move with a ball in your hand just as you would in your sport.  Practice on your own or with a remote coach to take your play to the next level.    \n", "short_description": "Take your quarterback play to the next level with professional grade VR training.  Learn, move, interact, and make-decisions just like you do on the field. The REPS ROVR App lets you learn and improve sport specific time sensitive decision-making while getting unlimited repetitions through immersive virtual reality using the patent-pending REPS development system.  Each practice repetition is graded and recorded for review by the player or a coach.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://repsvr.com/privacy-policy", "developer_terms_of_service_url": "https://repsvr.com/terms-and-conditions", "publisher_name": "REPS", "support_website_url": "https://repsvr.com/contact-us", "website_url": "https://www.repsvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "2776542286000603"}, {"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SIMULATION", "EXPERIENCE_360_NON_GAME", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app
w&_nc_oc=AdoplFsM-Ws9g3E6BNT67mVBo8QZ-GZyHV5XhMggRe0GoOtImdC6LsWb5XtDR0bnFFQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRB8ecufpE4l-5DfMWizVmnh6kJhvzLOh0bzLpAsM6JBA&oe=6AE896EB"}, {"file_name": "screen3.png", "id": "1154336788358501", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982471_1154336795025167_5529760307156287612_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92n9k_8cWrEQ7kNvwEyqqh-&_nc_oc=AdqkpkhpSEopZ_xiJkf8Y9DBH7spqtXtXDk6KRtHQXS5ux8H7mFzfF1Po1FT7m3jQQo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNUBvDtIeTB9U1OGiqAmKDJnwfqZM6bLCHW3yq5DzPyw&oe=6AE88D7C"}, {"file_name": "Capture 1aa.png", "id": "126191966046336", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974827_126191969379669_7612736244549055214_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Sz90akqzEEQ7kNvwFSKEtB&_nc_oc=AdpWiuUzXfmB4TZVJLsQVQb93EqJk7ryg5_X2KlPht0hKodmlIX897Hx107h-Py1ItQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSExhba-SpWWcGz83BJbFC7wHVfKk2b2Weuvbxea4hEMA&oe=6AE8B288"}, {"file_name": "Capture 8aa.png", "id": "237969191155872", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974827_237969194489205_3331846548083113255_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3TENVzZLGEQ7kNvwEKL0OG&_nc_oc=AdodFmtZp16hGCtUW8LJm1Kta9mbcixIwgspaZJPvd2iCaMaFcpI_DkKptaUpaxnt7w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbXPGWwwaPT79KZJk75HzvFAwy2No8_eSKhthqj19p3w&oe=6AE895E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ROVR", "keywords": [], "long_description": "Take your quarterback play to the next level with professional grade VR training.  Learn, move, interact, and make-decisions just like you do on the field. \n\nThe REPS ROVR App lets you learn and improve sport specific time sensitive decision-making while getting unlimited repetitions through immersive virtual reality using the patent-pending REPS development system.  Each practice repetition is graded and recorded for review by the player or a coach.  The untethered Quest headset and ROVR\u2019s handsfree vision and voice interface allows you to move with a ball in your hand just as you would in your sport.  Practice on your own or with a remote coach to take your play to the next level.    \n", "short_description": "Take your quarterback play to the next level with professional grade VR training.  Learn, move, interact, and make-decisions just like you do on the field. The REPS ROVR App lets you learn and improve sport specific time sensitive decision-making while getting unlimited repetitions through immersive virtual reality using the patent-pending REPS development system.  Each practice repetition is graded and recorded for review by the player or a coach.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://repsvr.com/privacy-policy", "developer_terms_of_service_url": "https://repsvr.com/terms-and-conditions", "publisher_name": "REPS", "support_website_url": "https://repsvr.com/contact-us", "website_url": "https://www.repsvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "2776542286000603"}, {"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SIMULATION", "EXPERIENCE_360_NON_GAME", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "352532333136220"}, "review_messages": []}]}, "cover_square_image": {"uri": "https:
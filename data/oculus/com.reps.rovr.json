tem.  Each practice repetition is graded and recorded for review by the player or a coach.  The untethered Quest headset and ROVR\u2019s handsfree vision and voice interface allows you to move with a ball in your hand just as you would in your sport.  Practice on your own or with a remote coach to take your play to the next level.    \n", "short_description": "Take your quarterback play to the next level with professional grade VR training.  Learn, move, interact, and make-decisions just like you do on the field. The REPS ROVR App lets you learn and improve sport specific time sensitive decision-making while getting unlimited repetitions through immersive virtual reality using the patent-pending REPS development system.  Each practice repetition is graded and recorded for review by the player or a coach.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://repsvr.com/privacy-policy", "developer_terms_of_service_url": "https://repsvr.com/terms-and-conditions", "publisher_name": "REPS", "support_website_url": "https://repsvr.com/contact-us", "website_url": "https://www.repsvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "2776542286000603"}, {"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SIMULATION", "EXPERIENCE_360_NON_GAME", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "352532333136220"}, "review_messages": []}]}, "cover_square_image": {"uri": "https:
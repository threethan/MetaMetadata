336", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974827_126191969379669_7612736244549055214_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30lE-_yKndwQ7kNvwEAzhRH&_nc_oc=Adqo7-aprEm1eS9XqkeBeVkOn62EGOgWpyGHHP1veOgQG_fpKRlwVJENk8pjwVaC044&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYqlhgGABt4pQ7c_6zFvcYkYVyjWm46mMgmmuaMtINUA&oe=6AEDF888"}, {"file_name": "Capture 8aa.png", "id": "237969191155872", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974827_237969194489205_3331846548083113255_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uLGTM8WhM0Q7kNvwFDJc-p&_nc_oc=AdqjP1eLSt76zihwXpL3UCJVv0dJIp0K3jxH7R86L-cgouxOvfDV1D3yFMObGDr5B0E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-NNBiHVNcp_fo2mrPAli3uBKDywgT8YWjIWFOnZq4eg&oe=6AEDDBE8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ROVR", "keywords": [], "long_description": "Take your quarterback play to the next level with professional grade VR training.  Learn, move, interact, and make-decisions just like you do on the field. \n\nThe REPS ROVR App lets you learn and improve sport specific time sensitive decision-making while getting unlimited repetitions through immersive virtual reality using the patent-pending REPS development system.  Each practice repetition is graded and recorded for review by the player or a coach.  The untethered Quest headset and ROVR\u2019s handsfree vision and voice interface allows you to move with a ball in your hand just as you would in your sport.  Practice on your own or with a remote coach to take your play to the next level.    \n", "short_description": "Take your quarterback play to the next level with professional grade VR training.  Learn, move, interact, and make-decisions just like you do on the field. The REPS ROVR App lets you learn and improve sport specific time sensitive decision-making while getting unlimited repetitions through immersive virtual reality using the patent-pending REPS development system.  Each practice repetition is graded and recorded for review by the player or a coach.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://repsvr.com/privacy-policy", "developer_terms_of_service_url": "https://repsvr.com/terms-and-conditions", "publisher_name": "REPS", "support_website_url": "https://repsvr.com/contact-us", "website_url": "https://www.repsvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "2776542286000603"}, {"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SIMULATION", "EXPERIENCE_360_NON_GAME", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "352532333136220"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1682288415311464"}]}, "baseline_offer": {"id": "1682288415311464"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1618935060, "status": "PUBLISHED", "id": "1682288415311464"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35670036729277532", "version": "2.8.10"}, "id": "406833183921854", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5065282913512982", "is_concept": false, "latest_released_binary": {"__
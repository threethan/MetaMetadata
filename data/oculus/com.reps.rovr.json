a&_nc_oc=AdrYvQRbWXERjvTa_Np_K8MQHN349ilBEpXe8Lg8pXzVvEssBUQlrVb-nI7xTRz44mY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPBaR_OtsWYAj3ExQ4FfSr_sRfSq4aUmb8TxBfohJXrQ&oe=6AF7176B"}, {"file_name": "screen3.png", "id": "1154336788358501", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982471_1154336795025167_5529760307156287612_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KA5Ex5qzUScQ7kNvwHIkhf6&_nc_oc=AdpEekMj7ccgod0ByIN54IhNDWbM-3n3QQHUe3T8dBH6QSwEt13dngTl58FyIXoKXEE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdVGIBxkRjJF7yiYM4O5b-bG44_6nZBIwApbeddMOeYA&oe=6AF7463C"}, {"file_name": "Capture 1aa.png", "id": "126191966046336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_126191969379669_7612736244549055214_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PO0PgusUGCEQ7kNvwFvoHtN&_nc_oc=AdouBPhmpmX1wf2pliPWsM2tp0U5elXEo-PHhofN6D3PZy7KlJQc6oD3cPmD6msV_mQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1FiolkePIZX5pLX8R0meO87_pISqS2QqjyM9HrOiikg&oe=6AF73308"}, {"file_name": "Capture 8aa.png", "id": "237969191155872", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_237969194489205_3331846548083113255_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGewW3ibT_gQ7kNvwE_YtgZ&_nc_oc=AdpdJw-v-_pvaHuNsk8esP9_pxS19KGP45rWxx_N8csg8jALOtDvIPBm44tXjxf4Xec&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZaCuzIUn6CavRyQPMKCjfjUfy8CetZKtHancV_FnmAg&oe=6AF71668"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ROVR", "keywords": [], "long_description": "Take your quarterback play to the next level with professional grade VR training.  Learn, move, interact, and make-decisions just like you do on the field. \n\nThe REPS ROVR App lets you learn and improve sport specific time sensitive decision-making while getting unlimited repetitions through immersive virtual reality using the patent-pending REPS development system.  Each practice repetition is graded and recorded for review by the player or a coach.  The untethered Quest headset and ROVR\u2019s handsfree vision and voice interface allows you to move with a ball in your hand just as you would in your sport.  Practice on your own or with a remote coach to take your play to the next level.    \n", "short_description": "Take your quarterback play to the next level with professional grade VR training.  Learn, move, interact, and make-decisions just like you do on the field. The REPS ROVR App lets you learn and improve sport specific time sensitive decision-making while getting unlimited repetitions through immersive virtual reality using the patent-pending REPS development system.  Each practice repetition is graded and recorded for review by the player or a coach.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://repsvr.com/privacy-policy", "developer_terms_of_service_url": "https://repsvr.com/terms-and-conditions", "publisher_name": "REPS", "support_website_url": "https://repsvr.com/contact-us", "website_url": "https://www.repsvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "2776542286000603"}, {"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SIMULATION", "EXPERIENCE_360_NON_GAME", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "352532333136220"}, "review_messages": []}]}, "cover_square_image": {"uri": "https:
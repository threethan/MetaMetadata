Q&_nc_oc=AdqIE_C9ptxQxWSeYVJ2eKJbHNIDW_4xwOzx3IRDlXp7E0aISJA9y5po7BU22jD8Cvg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgdMy86JTfFmE_5HiyqZKS0b-sownF4gI3mjDqi4Y9iQ&oe=6AF4746B"}, {"file_name": "screen3.png", "id": "1154336788358501", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982471_1154336795025167_5529760307156287612_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=td2-oEf208QQ7kNvwELIe7e&_nc_oc=AdoYC0Ht7c-WnKhDqOAypy8fTxitxM-_FrGk3ZJ812ajvctVwxvghhpdFs_1cNzceIs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfjCRWtcqx8ThPQHAmACVyOCFMYhPo63vset7L19x1Yw&oe=6AF4A33C"}, {"file_name": "Capture 1aa.png", "id": "126191966046336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_126191969379669_7612736244549055214_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MmTTq4heEQQ7kNvwG7XRbA&_nc_oc=Ado0cboaoGMQgolZ4z7VVtrVHm5M9xntSUhwXbSS0ig_lJDGi8xjwmCUuFDoOpc65HU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7APU1PTu_B6-1Tp4gF-VvVo4BaaQySnT3RWapuXht6g&oe=6AF49008"}, {"file_name": "Capture 8aa.png", "id": "237969191155872", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_237969194489205_3331846548083113255_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGewW3ibT_gQ7kNvwEv0i4Z&_nc_oc=AdpCIYMX4tgKvvTJAg9ONnoEpJR8JOpcK_nexESkqsvE1hszd9BnzVMl-OMyTU2V-4U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGdJxVtyHbegkICZLKmewTykLR8Leg24bSbW4xqOPRKQ&oe=6AF47368"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ROVR", "keywords": [], "long_description": "Take your quarterback play to the next level with professional grade VR training.  Learn, move, interact, and make-decisions just like you do on the field. \n\nThe REPS ROVR App lets you learn and improve sport specific time sensitive decision-making while getting unlimited repetitions through immersive virtual reality using the patent-pending REPS development system.  Each practice repetition is graded and recorded for review by the player or a coach.  The untethered Quest headset and ROVR\u2019s handsfree vision and voice interface allows you to move with a ball in your hand just as you would in your sport.  Practice on your own or with a remote coach to take your play to the next level.    \n", "short_description": "Take your quarterback play to the next level with professional grade VR training.  Learn, move, interact, and make-decisions just like you do on the field. The REPS ROVR App lets you learn and improve sport specific time sensitive decision-making while getting unlimited repetitions through immersive virtual reality using the patent-pending REPS development system.  Each practice repetition is graded and recorded for review by the player or a coach.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://repsvr.com/privacy-policy", "developer_terms_of_service_url": "https://repsvr.com/terms-and-conditions", "publisher_name": "REPS", "support_website_url": "https://repsvr.com/contact-us", "website_url": "https://www.repsvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "2776542286000603"}, {"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SIMULATION", "EXPERIENCE_360_NON_GAME", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "352532333136220"}, "review_messages": []}]}, "cover_square_image": {"uri": "https:
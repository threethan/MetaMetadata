tent-pending REPS development system.  Each practice repetition is graded and recorded for review by the player or a coach.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://repsvr.com/privacy-policy", "developer_terms_of_service_url": "https://repsvr.com/terms-and-conditions", "publisher_name": "REPS", "support_website_url": "https://repsvr.com/contact-us", "website_url": "https://www.repsvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "2776542286000603"}, {"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SIMULATION", "EXPERIENCE_360_NON_GAME", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "352532333136220"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1682288415311464"}]}, "baseline_offer": {"id": "1682288415311464"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1618935060, "status": "PUBLISHED", "id": "1682288415311464"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35670036729277532", "version": "2.8.10"}, "id": "406833183921854", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5065282913512982", "is_concept": false, "latest_released_binary": {"__
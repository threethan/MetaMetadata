XF&_nc_oc=AdoxZNS9mB7Y68Q4GDI8Lo6FNhSF7kKNDs5pPF17J3BAjAzNElOkqrBBZ6zOHgJlhzQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHT_a3H6Xvq9i-cSMdiAI58asD0AdG52Up55mVOrxo-bA&oe=6A9728B2"}, {"file_name": "Screenshot04.png", "id": "537244497275099", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974446_537244500608432_5225225128955170059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vG4qqYxwb94Q7kNvwFZC-Jg&_nc_oc=AdoI6tg6KEymn82Bap16oegrF1PuYaRwdy4_95qRVpx1fOuJGlBgSAW5c92O9sGMTAo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvF-4UH0qiJovgVVZaxNPfwRvQmDi0z0IT2i86qAj56A&oe=6A972E72"}, {"file_name": "Screenshot01.png", "id": "1175962019519470", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001711_1175962022852803_190713952312442679_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0-0cPPaP5oQ7kNvwFkTCgm&_nc_oc=Adp9vUNc22KwfqS9OhcSZQKBLQExBrpLSUJMi8M3sT8UUYRBmG7c0uQCArAxzFwbjjQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDSkvVHNV7yplWvZHDONWgI05bytUxsVX6UpM3df4TeQ&oe=6A973F64"}, {"file_name": "Screenshot09.png", "id": "337369811125070", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974591_337369814458403_3194979340277084116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTccOepG1PAQ7kNvwGpmx_L&_nc_oc=AdrXHIJLN77E-sQVpkhrJTO8mhqay-ypw0xguW-mNbYVGj7h2vzO_9QnAnj3mzAJ_zI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_ynaWil3ssAL3sdyiScNMFR9DPnvPDMP0MvwnJtCBNA&oe=6A973247"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1383443358677671", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974454_1383443362011004_7988140006223216847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIiZzkTiZQMQ7kNvwHpqysB&_nc_oc=AdqyaCE4MMpQy4cKU6wtQuurb3m6Z7RUpBAqOaJDodo44fgXXqGMY9-QunuS7TUUKJg&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWrHZlpkYAxCfAZIKmUXdKMChSBr2uAwbeqJhachqHyw&oe=6A972FD2"}, "display_name": "Space Bucket VR", "keywords": [], "long_description": "The epic tale of a hero, a bucket, and the vicious alien that tries to tear them apart.  A receptacle-based love story for the ages in the grandest traditions of classic space opera and the tales of antiquity.  You will laugh.  You will cry.  You will travel through vast stretches of space and time with a box on your head, a bucket in your hand, and a song in your heart.  Embrace the future.  Embrace your destiny.  Embrace the bucket.  Space Bucket.\n\nBut in all seriousness, Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!", "short_description": "Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suspectreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Suspect Reality", "support_website_url": null, "website_url": "https://www.suspectreality.com/SpaceBucketVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055852184973813"}, "review_messages": []}]}, "cove
kg&_nc_oc=Adox7oG8c1hW7B_7jEgB0mxLhHePO0M3uzY2F_tbknY24ROkv4us6oR2TjEOLuM6yWA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByRT14KnULLS_9-VAZTXMaTvleTHyBSQPKjTwOXKUInA&oe=6A69E532"}, {"file_name": "Screenshot04.png", "id": "537244497275099", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_537244500608432_5225225128955170059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18thtwUPtj4Q7kNvwFxg6JA&_nc_oc=AdrxGiHn2agO3oj3zYzsDfVO54j7h4flYRs9c-o0WDr68fLv8rfCaN2k1CMq02dZiQg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWeIsqc7IMhXmluW9K7iEqDCL1fY142E4qbp-rydTC_Q&oe=6A69EAF2"}, {"file_name": "Screenshot01.png", "id": "1175962019519470", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001711_1175962022852803_190713952312442679_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvIz1KyuHCEQ7kNvwF8hsxM&_nc_oc=AdpXsRICVd3uMaZAeOBPWLOOICdCF4aLZQldYiq9FdEu4Bpoolk-2Tnl4IDBbi2ZPXU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-cbOhcz63fNctblFeg4msgNIpky_FDiChsV9qZC6AkA&oe=6A69FBE4"}, {"file_name": "Screenshot09.png", "id": "337369811125070", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974591_337369814458403_3194979340277084116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-enHBVNLIb4Q7kNvwGzDIMT&_nc_oc=AdpS87JHeHD7dO8HjswNVBQIUTUkL0xPj2DKVXRaeuS3gUv750A27lyWfsrpBYpxdYo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2Xa_6CL3FJg23ziXpalnNXn-Z26ksgzRf4DrS6K-r-g&oe=6A69EEC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1383443358677671", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974454_1383443362011004_7988140006223216847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvzZIUURkSIQ7kNvwHXsuqF&_nc_oc=AdrYpTkWYeN3xW3cqcgpgadhaPRG_6Fgyg6bj-iIC9x8crvlPzY5Q9fWhLlYTrbyOXw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBf-iIVLyd7s9RWjG7TXrjrWPbOfTxHfTYMZCbrblelig&oe=6A69EC52"}, "display_name": "Space Bucket VR", "keywords": [], "long_description": "The epic tale of a hero, a bucket, and the vicious alien that tries to tear them apart.  A receptacle-based love story for the ages in the grandest traditions of classic space opera and the tales of antiquity.  You will laugh.  You will cry.  You will travel through vast stretches of space and time with a box on your head, a bucket in your hand, and a song in your heart.  Embrace the future.  Embrace your destiny.  Embrace the bucket.  Space Bucket.\n\nBut in all seriousness, Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!", "short_description": "Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suspectreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Suspect Reality", "support_website_url": null, "website_url": "https://www.suspectreality.com/SpaceBucketVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055852184973813"}, "review_messages": []}]}, "cove
Vk&_nc_oc=AdpQpaNM6UNZk9lFbv-9xoqW60Q4FFqCFWthsInB9EO90nIoDCDM6mt8jFYXRurFQJo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AAvIcm-2L8btbT5Le1-6bkWA9dL5OH-e2X3Eyjq-1TQ&oe=6A316CF2"}, {"file_name": "Screenshot04.png", "id": "537244497275099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974446_537244500608432_5225225128955170059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15RX4VL2OykQ7kNvwEXVM3r&_nc_oc=Adpk1pOBs3v0_qHb9aVKMs3vBoDVKaTtFSe3uPc_DunJyjP5YgHuJu9nbwBS9zcNVZY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yL2ehIiWkPmGy2vRBbB5xVwulrxe9Pl594rfcRWNfpQ&oe=6A3172B2"}, {"file_name": "Screenshot01.png", "id": "1175962019519470", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001711_1175962022852803_190713952312442679_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Uwbn8AbsNwQ7kNvwGfk-LM&_nc_oc=AdqXJ3NqV5uiaXbP8bUz58bxv4SandtB3zsa9l37qrAQ3VM5E1dTE0vYH9cmfc-nYQg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_t3ggkKb1y_XNFo86-PBuwuBkwHSy_QeSwNLlwmd7pBQ&oe=6A314B64"}, {"file_name": "Screenshot09.png", "id": "337369811125070", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974591_337369814458403_3194979340277084116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3CD_8-4RGYQ7kNvwHVK3yH&_nc_oc=AdqH1-pUgHdtgh_euZ8TKOTVKS1g6A8v79vv6rONxkoB77OZkB-gL8iOY1NMHOuKcf8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Od683TWfXe-PNomcc4W4kwkOB60DFhxMvT-HwQUG4lg&oe=6A317687"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1383443358677671", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974454_1383443362011004_7988140006223216847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zod2LaOxIIYQ7kNvwExRi2K&_nc_oc=AdrTH8cUHDIDAWKAuKplAlWLyhsSf9YSL618UQcfIseB9zXJoX_3YDvlXdNKI3Atn-8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QyYd31Wu6iV9qgxjo-VCjUip2O5DfBI8qRl1SM5KTIg&oe=6A317412"}, "display_name": "Space Bucket VR", "keywords": [], "long_description": "The epic tale of a hero, a bucket, and the vicious alien that tries to tear them apart.  A receptacle-based love story for the ages in the grandest traditions of classic space opera and the tales of antiquity.  You will laugh.  You will cry.  You will travel through vast stretches of space and time with a box on your head, a bucket in your hand, and a song in your heart.  Embrace the future.  Embrace your destiny.  Embrace the bucket.  Space Bucket.\n\nBut in all seriousness, Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!", "short_description": "Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suspectreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Suspect Reality", "support_website_url": null, "website_url": "https://www.suspectreality.com/SpaceBucketVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055852184973813"}, "review_messages": []}]}, "cove
NN&_nc_oc=AdoOk93OAmBREeye5TJG1yCt_y7dSZM0SAzJvj-fnDwH1TxKkp3-vEz2yM58ZFWrbsE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKk5dM8OwkCGABcOzUKaN9r1WcZ0f6t32Xr0oId7dg8ag&oe=6AB542F2"}, {"file_name": "Screenshot04.png", "id": "537244497275099", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_537244500608432_5225225128955170059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEL0qFfC_6cQ7kNvwGON9xh&_nc_oc=AdrLVZNz5ly06Hry5bT3oVFUbhYFlX5we5bUJu0T813oij-FvaEMMc5OJq7Zr-6lH18&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQeZDt_LS2qfJEgUwvSw3cFQVfXHiQVija1ZzKKCI0Bw&oe=6AB548B2"}, {"file_name": "Screenshot01.png", "id": "1175962019519470", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001711_1175962022852803_190713952312442679_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efu740AljfAQ7kNvwEoqq8G&_nc_oc=AdoDjBruwhPlfaoZ5dSt57R4z6VS3HVEj559MNbQmDRPBLklQ6yp0bfI9Ftn0rErLXQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvA39W97JP8nyfrApkp0pd0miXCk7n7VM8hOexC5hdOw&oe=6AB52164"}, {"file_name": "Screenshot09.png", "id": "337369811125070", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974591_337369814458403_3194979340277084116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snX-cLo09P0Q7kNvwFHy2Xt&_nc_oc=AdrdC6AlSg3eqWzhY3OFfiazPGXmIO7SLAVw0DnWL7hOQ3mj8h3HKZNXsne_WlEgyDU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIK_Dmh4XJyEA9InT_h0MFmmg9XoBxK0AiYy7eKNFV1sA&oe=6AB54C87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1383443358677671", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974454_1383443362011004_7988140006223216847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_L77lUNzwkQ7kNvwEcIPzC&_nc_oc=Adq5NMaXLLfl6hM88mO4Ule2CTliK6So9BXgxlEvzyPCtSE7cRMkYYVB3JEFoDGY3R4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ17S_4EqZTU8vuzLteK3XWryj4mVr3afsQOGZ5ZaEWhA&oe=6AB54A12"}, "display_name": "Space Bucket VR", "keywords": [], "long_description": "The epic tale of a hero, a bucket, and the vicious alien that tries to tear them apart.  A receptacle-based love story for the ages in the grandest traditions of classic space opera and the tales of antiquity.  You will laugh.  You will cry.  You will travel through vast stretches of space and time with a box on your head, a bucket in your hand, and a song in your heart.  Embrace the future.  Embrace your destiny.  Embrace the bucket.  Space Bucket.\n\nBut in all seriousness, Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!", "short_description": "Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suspectreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Suspect Reality", "support_website_url": null, "website_url": "https://www.suspectreality.com/SpaceBucketVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055852184973813"}, "review_messages": []}]}, "cove
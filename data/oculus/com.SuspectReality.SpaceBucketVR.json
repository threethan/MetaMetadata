05&_nc_oc=Adpw1F7ayFD2qZ76_rOKlzriVomrR7INQcjVK5ae9URgp6ZyvE59rsdBRbA9JfhEeO4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0cSGmXTXh5weIgu-6h_B1yDBt15R6ME0bzdHbJmSYSRg&oe=69F61972"}, {"file_name": "Screenshot04.png", "id": "537244497275099", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974446_537244500608432_5225225128955170059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcNdp7hsEVAQ7kNvwHRoceK&_nc_oc=AdrvQ5W8eZ42uLrPR5JseB55_QfhhlpVCJ9VPFrv3_zhnUVirdOzaDEM6Q1aGCagu_U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1CnzWdUQAwIkZd_XB2OI3iqarPe_dKcOCWXyE50YtGbQ&oe=69F61F32"}, {"file_name": "Screenshot01.png", "id": "1175962019519470", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001711_1175962022852803_190713952312442679_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_c2rcuhuUE4Q7kNvwFMEWYG&_nc_oc=AdrJhjCV-626Pklr9R0QJ7R5pR1VZhzjL3rRaLGyWf-sz7UAGq5e2cAgk9aLHAG3cyg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Cz1TiySWf4ck0-_1Er9ulWjK1leOa84hXMG8GJ2O_cg&oe=69F5F7E4"}, {"file_name": "Screenshot09.png", "id": "337369811125070", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974591_337369814458403_3194979340277084116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6dcH283zaMQ7kNvwH3iaJz&_nc_oc=Adr899pnBfh80Cxnf1UIcaY79NiqE-vRi5eMMphQhiFwmRcCM0qdHet4vXPyDT08Ksc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2R7Twqh-H-EuX-WRq0UCmlkA_KnriIc5SEXPTlpdkDXA&oe=69F5EAC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1383443358677671", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974454_1383443362011004_7988140006223216847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opjyLoIyCW0Q7kNvwGq4OwX&_nc_oc=AdpXooRihJfLeY9Gbw0a2ufdeUX0uwf4n6VmZmyjHWufuyVDxa7UHVmYSooDZdHg6Rw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ll8pRRSQ7aK3A4PGUa8oCqm-10vfNkmiBm1nrk40LoA&oe=69F5E852"}, "display_name": "Space Bucket VR", "keywords": [], "long_description": "The epic tale of a hero, a bucket, and the vicious alien that tries to tear them apart.  A receptacle-based love story for the ages in the grandest traditions of classic space opera and the tales of antiquity.  You will laugh.  You will cry.  You will travel through vast stretches of space and time with a box on your head, a bucket in your hand, and a song in your heart.  Embrace the future.  Embrace your destiny.  Embrace the bucket.  Space Bucket.\n\nBut in all seriousness, Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!", "short_description": "Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suspectreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Suspect Reality", "support_website_url": null, "website_url": "https://www.suspectreality.com/SpaceBucketVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055852184973813"}, "review_messages": []}]}, "cove
gg&_nc_oc=AdoIsv1uGyjc4WsaL_Otd1GSB-V4yYKnBgk-H27xdp2GsiJ-2k2NP1Cqjqgcmxt8-rg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxedJ5z0rFYw_2xntIoq5LgqrZKPO8runPXcPxwhg9Pw&oe=6ABBDA72"}, {"file_name": "Screenshot04.png", "id": "537244497275099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974446_537244500608432_5225225128955170059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSgH5y9GHrcQ7kNvwGFsyKq&_nc_oc=AdoFLLKyQKHz7UqvWp-8uW3fX1Jh_MffE_6i-r7pFDXyq9SfHjDOKta6vb0u1Qe0EVw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJntktbFQSnmVP0OU6w9knrufxtsiNZOunsw8ctQifcWA&oe=6ABBE032"}, {"file_name": "Screenshot01.png", "id": "1175962019519470", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001711_1175962022852803_190713952312442679_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OK_r0lsGK9EQ7kNvwG8ytcx&_nc_oc=AdrBHFaYx8ELvw2-1h2p9lQ-w6ksGtUpgNTYeGFKHtAyBjmDvMdd_MCOwiotTmLO2WY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5QmxPX-kG7wS2ghsmIk3kYuGw3isF-dMwUD-jt370oA&oe=6ABBB8E4"}, {"file_name": "Screenshot09.png", "id": "337369811125070", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974591_337369814458403_3194979340277084116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_MhSQup0SgQ7kNvwFYzLn8&_nc_oc=AdqA_wDNI1_Y4nreKAiJA-eCJfYWWdenv1J1u4upK7einClj2Ksl0LoWCKMz9GOYTl4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4KrPHMwOxcwTo5ccOdokjolbkc-GhByXA-vTZ-7HWHQ&oe=6ABBE407"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1383443358677671", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974454_1383443362011004_7988140006223216847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvKNhMTt_7UQ7kNvwGRGjod&_nc_oc=Adr1ePbYqq4mlGkpeapWgdR8BVT1NOrbZjzaJWCJDSW3Mu_m9L0knJoArkfNphquSQg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMe_PNAY4FYKImAyg_26O1B0vZr7-SC39J0rhV1usAJg&oe=6ABBE192"}, "display_name": "Space Bucket VR", "keywords": [], "long_description": "The epic tale of a hero, a bucket, and the vicious alien that tries to tear them apart.  A receptacle-based love story for the ages in the grandest traditions of classic space opera and the tales of antiquity.  You will laugh.  You will cry.  You will travel through vast stretches of space and time with a box on your head, a bucket in your hand, and a song in your heart.  Embrace the future.  Embrace your destiny.  Embrace the bucket.  Space Bucket.\n\nBut in all seriousness, Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!", "short_description": "Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suspectreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Suspect Reality", "support_website_url": null, "website_url": "https://www.suspectreality.com/SpaceBucketVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055852184973813"}, "review_messages": []}]}, "cove
zB&_nc_oc=AdqBjJvgK6rb1UBllkCB2qdqMbR535jBBs_wLtJ-EO8dhknveO5ZZ9-Gc_rp2qksh40&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2HmCrm3VDpkQAIDuPPl32vhx5Cn1Chb8re5f3lf_P44w&oe=69EF81F2"}, {"file_name": "Screenshot04.png", "id": "537244497275099", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974446_537244500608432_5225225128955170059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbCONA96g3gQ7kNvwHSNq_h&_nc_oc=AdoJl2MbkE24_fif0EOBEprRtn6cSuYozkB25ERRAZyz5qHT4VT9GjTctdm8LgU0Bac&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3dDajmP8zatN3z5V0G9-UWR-G3vlKjOjk50iZLGYsGnw&oe=69EF4F72"}, {"file_name": "Screenshot01.png", "id": "1175962019519470", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001711_1175962022852803_190713952312442679_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tQCK7qgIQEQ7kNvwHav6Dn&_nc_oc=AdrvfIoqHVWyuG7XAVwD71bpbkj6jCga2Ed0XHDQ0QcYT1Fo12pbi8OTsONO8Y_6fTw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2fouRPPTMPNhItyKl9HfMHMTGkW10wWVqJI8ixH55enA&oe=69EF6064"}, {"file_name": "Screenshot09.png", "id": "337369811125070", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974591_337369814458403_3194979340277084116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOtIM18IFRsQ7kNvwG2iotC&_nc_oc=AdoMzRNcHX5Otot2QzBJCUeffmlCZjYKvCBH8fC5PjV-6TTSNn1wO4jwgapEX-4-W-0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1vsetz0UuAmkcg4BMDYjGCG1x92sm5WnquRKWhw5tBLA&oe=69EF5347"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1383443358677671", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974454_1383443362011004_7988140006223216847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxh-Bwd-mokQ7kNvwHBt3-u&_nc_oc=AdqXVaNURKP7RJkzihgSz1QL6642zAUW6_ckr1LkKlKALGaFa_asXEhQszMgpC0VN6k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3okUGbH9PMjUhuk3ypoG_WRc-AqS07LYxBmeoNnOAHUw&oe=69EF50D2"}, "display_name": "Space Bucket VR", "keywords": [], "long_description": "The epic tale of a hero, a bucket, and the vicious alien that tries to tear them apart.  A receptacle-based love story for the ages in the grandest traditions of classic space opera and the tales of antiquity.  You will laugh.  You will cry.  You will travel through vast stretches of space and time with a box on your head, a bucket in your hand, and a song in your heart.  Embrace the future.  Embrace your destiny.  Embrace the bucket.  Space Bucket.\n\nBut in all seriousness, Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!", "short_description": "Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suspectreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Suspect Reality", "support_website_url": null, "website_url": "https://www.suspectreality.com/SpaceBucketVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055852184973813"}, "review_messages": []}]}, "cove
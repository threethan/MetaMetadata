Ok&_nc_oc=Ado1DGCV5jt0nXWswsVA96jCmbdv_R5IStel8IeZlWym2iR-IDhSHRXmtSkVdTRRjwQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3Bdz_GdX84V07Taqtv6OZGkyZ_HZBcyiZz6fKWnIVnQ&oe=6A5110F2"}, {"file_name": "Screenshot04.png", "id": "537244497275099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974446_537244500608432_5225225128955170059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcF5bq77rB8Q7kNvwHdOP6O&_nc_oc=AdqJkTB0W3MHiDFi45kfQZ8WDWlH5WKPaGBirzjx8n9ohIfWr2oOBJfMt64gGo8ab9E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA390Me2SBFdVadXDOca3RKZm24Go8hISQm3iOEc4tkzQ&oe=6A5116B2"}, {"file_name": "Screenshot01.png", "id": "1175962019519470", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001711_1175962022852803_190713952312442679_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdv3y3DwoZEQ7kNvwHXFNUy&_nc_oc=AdqXbuZUoPp5wYxkPlfZnCleLK1FSqM9f0aw-Yi81ODwoZnCy3yQBIlRqi4emr7zJYU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnr26WopbWF54ooWLOk_DAOrWO83QPlk98fLJZG9P0NA&oe=6A50EF64"}, {"file_name": "Screenshot09.png", "id": "337369811125070", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974591_337369814458403_3194979340277084116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFDcNF_O9DoQ7kNvwF84fzJ&_nc_oc=AdpTsK8bhjrPtz6k78amjl28zmyguGihGxfSeFNj2zu28mn4EeyF7UNYcd2VTeRCty0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBO4Bv87tPPSdkH3tdoOYjZZKp6T9l8W4WPxJtID-d1Rg&oe=6A511A87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1383443358677671", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974454_1383443362011004_7988140006223216847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0Zz0-ypNCIQ7kNvwF1CTpk&_nc_oc=AdrXQmKCPPkjwimacJmFw4DBa7uGPFvtcHlHyjUauK2sTHhL-NDVbBiNuiTL4YcZ3no&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdLlRXIKyzVCegts9gyhurfjWOBB0lbSqhgcw87iIoaQ&oe=6A511812"}, "display_name": "Space Bucket VR", "keywords": [], "long_description": "The epic tale of a hero, a bucket, and the vicious alien that tries to tear them apart.  A receptacle-based love story for the ages in the grandest traditions of classic space opera and the tales of antiquity.  You will laugh.  You will cry.  You will travel through vast stretches of space and time with a box on your head, a bucket in your hand, and a song in your heart.  Embrace the future.  Embrace your destiny.  Embrace the bucket.  Space Bucket.\n\nBut in all seriousness, Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!", "short_description": "Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suspectreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Suspect Reality", "support_website_url": null, "website_url": "https://www.suspectreality.com/SpaceBucketVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055852184973813"}, "review_messages": []}]}, "cove
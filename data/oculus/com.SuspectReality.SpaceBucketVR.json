-4&_nc_oc=AdqZSKPFdS9g4Na3zbzXZthexinoIADtgsdAqujHGwNZT0I5kM4lcW1uZ4wHbCUC5ms&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xKVbnyXkjzLe7dfebY6SrPL3PAZVstrVds1qKX8FR8w&oe=69D78EB2"}, {"file_name": "Screenshot04.png", "id": "537244497275099", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974446_537244500608432_5225225128955170059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CA-IRkXJngIQ7kNvwGB9Arr&_nc_oc=AdoQOJVKRoAiT47T3BdlwEEVy90rR-xqKeoofoJhoj3JCnRY7dh5ER5I_KzrvfviMNw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08ofRZFYAAMqbgvs2xRcsnB5LOaqJDuJELiOXrwJ3C2w&oe=69D79472"}, {"file_name": "Screenshot01.png", "id": "1175962019519470", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001711_1175962022852803_190713952312442679_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGjsiB47GbwQ7kNvwGPZoJa&_nc_oc=AdpNUnHvML8BKF_qfjjiP2N6hnmyNUws1G862YE-bV0CCG-0-48QPzqKoH93nSdML8w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af283kZQvkvEJ2RT6NcIY1gyPKGtPMcCiI6X0tmBmpBBdA&oe=69D7A564"}, {"file_name": "Screenshot09.png", "id": "337369811125070", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974591_337369814458403_3194979340277084116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIz-KXkfbTIQ7kNvwF5C96H&_nc_oc=AdrdohaKYoFQh5daHb8c--aaq_pl6AiBCL7sPgEl0hHQ45kf0isN4k7iNKp310rS0ms&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XGqNWAVfdCrdhsMsUXhg6S8Zl1oxsDRbGiNRFxmPo0Q&oe=69D79847"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1383443358677671", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974454_1383443362011004_7988140006223216847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gga1iP3LhNUQ7kNvwGbs6Ij&_nc_oc=AdpPZNB8IWyu9uegut3Ns88FVWlXLHl9UUU42K6hOigFPV56X5j8n9EI_vEN86SXNEA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29Ye9pL4MCcSrsuZoR77hu6Ei689OkN7Y39QmFUdjMmQ&oe=69D795D2"}, "display_name": "Space Bucket VR", "keywords": [], "long_description": "The epic tale of a hero, a bucket, and the vicious alien that tries to tear them apart.  A receptacle-based love story for the ages in the grandest traditions of classic space opera and the tales of antiquity.  You will laugh.  You will cry.  You will travel through vast stretches of space and time with a box on your head, a bucket in your hand, and a song in your heart.  Embrace the future.  Embrace your destiny.  Embrace the bucket.  Space Bucket.\n\nBut in all seriousness, Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!", "short_description": "Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suspectreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Suspect Reality", "support_website_url": null, "website_url": "https://www.suspectreality.com/SpaceBucketVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055852184973813"}, "review_messages": []}]}, "cove
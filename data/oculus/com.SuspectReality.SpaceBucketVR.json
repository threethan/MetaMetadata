QX&_nc_oc=Adq-t0zfGy01o2AsooW7ei9aV7dVSKVDyzr67uH6OmJ1kXOKtQO161hU9PwSusUa-iE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YSyAfnaXRIDsHOofHyC_eJDnRgGc2oTp9SPxUpo4PkQ&oe=6A2C26F2"}, {"file_name": "Screenshot04.png", "id": "537244497275099", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974446_537244500608432_5225225128955170059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7uBxkd8xckQ7kNvwGN6fpf&_nc_oc=AdrzDZeX5M6CNM86pVu4Nn_5lf0AImm81lwxH9FaPRcX15eTrGY0ygxEJV_2gKEIsqw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dYvAomExKjGxBZBCb1wg0h-gY7yXsJIbKpo62IiBbPQ&oe=6A2C2CB2"}, {"file_name": "Screenshot01.png", "id": "1175962019519470", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001711_1175962022852803_190713952312442679_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XemphTFSdwAQ7kNvwGx1Nfm&_nc_oc=Adrj_HS_oz9se6DI53Vt-zTGCMOP4DHnCIaZjq2USYWkQXZ2ZO_JrRDiPe8xLpe5Y14&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TYOEA5yXg10kfmUod852AJzjvKbV77jAHudIdouP-mg&oe=6A2C0564"}, {"file_name": "Screenshot09.png", "id": "337369811125070", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974591_337369814458403_3194979340277084116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7fmh4K6aZwQ7kNvwEeG52_&_nc_oc=AdoK1pO5i1xC9Q38reQZNmF6xRpHBkEUCp-_PwgSuV-3BeV3dudYDbAx_Hpt0ACZ-vw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UGZj9710EQT21aiEL3GHG_Bx58JdgVuJYJ5PXGcksLA&oe=6A2C3087"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1383443358677671", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974454_1383443362011004_7988140006223216847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7d3V7N0rPsQ7kNvwH1FrPw&_nc_oc=AdpPbPDI5MxvU7OPPr5ifuxdku1bPP6dTag-J-c6fM02-Ecg9XDxD_KnG3w3Fekc_kQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tz63BedKGQY8PvhO56PiOdZ4M8Cfx9sXCFx9n6xdH9g&oe=6A2C2E12"}, "display_name": "Space Bucket VR", "keywords": [], "long_description": "The epic tale of a hero, a bucket, and the vicious alien that tries to tear them apart.  A receptacle-based love story for the ages in the grandest traditions of classic space opera and the tales of antiquity.  You will laugh.  You will cry.  You will travel through vast stretches of space and time with a box on your head, a bucket in your hand, and a song in your heart.  Embrace the future.  Embrace your destiny.  Embrace the bucket.  Space Bucket.\n\nBut in all seriousness, Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!", "short_description": "Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suspectreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Suspect Reality", "support_website_url": null, "website_url": "https://www.suspectreality.com/SpaceBucketVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055852184973813"}, "review_messages": []}]}, "cove
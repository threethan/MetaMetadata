_m&_nc_oc=AdpMNx8yfjMJmvph8Cptt1LAooGutnLLomAdQDUTBnVMMtu1545ShD3G1KCsY7awvN4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIN_56uA1hLuN8otFUgE5X_h_VKH84Bf_ZogecjltkBSA&oe=6AAFFCF2"}, {"file_name": "Screenshot04.png", "id": "537244497275099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974446_537244500608432_5225225128955170059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlAB-Ah83RkQ7kNvwGvNx5Z&_nc_oc=AdqOMV5GlDxFyZfBYPWf0NXsSkroAydRYsk7QBd3gGUEo3WXGwlYM6gIaFwTbxARug0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrIMzNd5owXjUI_be-9nS2NTHwQOAHqWEOh7ERmHSuGg&oe=6AB002B2"}, {"file_name": "Screenshot01.png", "id": "1175962019519470", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001711_1175962022852803_190713952312442679_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rE-icXHcV58Q7kNvwFMy_Wm&_nc_oc=AdqUumykROjXjDTRqOHNAli7mf1ZkAvLCBF7eJeuHnWz2kK0aM5aCmD8oAVLTQTtAHA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbJRRCK-XFOoPE0wGZVpoyBLgoPEGXTw_tdx-LNKPvDg&oe=6AAFDB64"}, {"file_name": "Screenshot09.png", "id": "337369811125070", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974591_337369814458403_3194979340277084116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkK1BodWKU4Q7kNvwF35Bc8&_nc_oc=AdoHKcAmP90-w_Uk_qIQ2Wt7EopmaeS-5h-bRkJvl737U3SiRgOje8Onci_YmjlRXiA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfF2EZm9qECIMfZAsDKMZt_IphCPheKWQL5ry3arDPoA&oe=6AB00687"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1383443358677671", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974454_1383443362011004_7988140006223216847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9TkKYZ5quYQ7kNvwHlikLz&_nc_oc=AdqNhib5DCxOslw8fsZGPqGILxL3dljhL5JAwHjchQmyMoYa6nwwrByaFT1ZCaNupVQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHrLnU1sHcwLUqnb_DmAUdQqp7AofNYxUgFRSzmzHx3w&oe=6AB00412"}, "display_name": "Space Bucket VR", "keywords": [], "long_description": "The epic tale of a hero, a bucket, and the vicious alien that tries to tear them apart.  A receptacle-based love story for the ages in the grandest traditions of classic space opera and the tales of antiquity.  You will laugh.  You will cry.  You will travel through vast stretches of space and time with a box on your head, a bucket in your hand, and a song in your heart.  Embrace the future.  Embrace your destiny.  Embrace the bucket.  Space Bucket.\n\nBut in all seriousness, Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!", "short_description": "Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suspectreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Suspect Reality", "support_website_url": null, "website_url": "https://www.suspectreality.com/SpaceBucketVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055852184973813"}, "review_messages": []}]}, "cove
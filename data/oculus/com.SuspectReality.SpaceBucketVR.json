gE&_nc_oc=Adq5pSSstySYKojddFMNdHCxhYnTppBp-bf1UBcLorhfLAKWJmoWsJis6oTPMOK7IOE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZzUG3Ad9LZnA8fuax7HqAOTrI_pe4K_NSUNzEpe3rwA&oe=6ADE2172"}, {"file_name": "Screenshot04.png", "id": "537244497275099", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974446_537244500608432_5225225128955170059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TkeffWdNTwYQ7kNvwEAHNEH&_nc_oc=AdqtP4ArCoDic62VJMiiAgYW6f3cc3SwfpiOAyZgpheLCEAIFjwN0t9pi-JvUtJdbI0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmxp99lHWZxVrMjlltnz3MMuXNA864nvU9TSnQgY1s5w&oe=6ADE2732"}, {"file_name": "Screenshot01.png", "id": "1175962019519470", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001711_1175962022852803_190713952312442679_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJfnR3SQij4Q7kNvwEg23DT&_nc_oc=AdoA2mJR8CeBcXxxph4FnW251Y7UGwbEty598DPHhU76avNEth6L32MIzYXvDA8NKWA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvnMrum42lvEF2ywvlNRfj-_x9_8N7yCEdpdDYRap0GA&oe=6ADDFFE4"}, {"file_name": "Screenshot09.png", "id": "337369811125070", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974591_337369814458403_3194979340277084116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otH2pOwhTvoQ7kNvwE3GVjt&_nc_oc=AdpdBvVPmdUbeNxTUhdD3jpeSvzoU_7AvrGNiAA3PZcq_C4-IL9MPK9DDcAAl5o39Z0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOd-K_FqzMgGB6DMIamKEH4LIsQ4SQoR0PJSKGxNwgbMA&oe=6ADE2B07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1383443358677671", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974454_1383443362011004_7988140006223216847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ma9a1VxdxjYQ7kNvwE26GYq&_nc_oc=Adq2miJJpLI3bKHwiTVEVDNf355K0BkWAtyi_mgata0RYXw0Qo2QX_hPlTFay_n9amE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMg9_cpYqoUFK1BSA9Hu8vlnUc_lPou0evtok-GIwsThw&oe=6ADE2892"}, "display_name": "Space Bucket VR", "keywords": [], "long_description": "The epic tale of a hero, a bucket, and the vicious alien that tries to tear them apart.  A receptacle-based love story for the ages in the grandest traditions of classic space opera and the tales of antiquity.  You will laugh.  You will cry.  You will travel through vast stretches of space and time with a box on your head, a bucket in your hand, and a song in your heart.  Embrace the future.  Embrace your destiny.  Embrace the bucket.  Space Bucket.\n\nBut in all seriousness, Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!", "short_description": "Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suspectreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Suspect Reality", "support_website_url": null, "website_url": "https://www.suspectreality.com/SpaceBucketVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055852184973813"}, "review_messages": []}]}, "cove
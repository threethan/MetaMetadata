qP&_nc_oc=AdrsHr4LXVULtynzM5Yfqe3Pf1wDPF9IQP-JcRknEeGLUGOM-HbyMUN4XxHZdVUI7IQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QnxPoaE9r0Tv6-RebFV6dox9NfQ9FeS_Vrnow6RVYeg&oe=6A3FED72"}, {"file_name": "Screenshot04.png", "id": "537244497275099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974446_537244500608432_5225225128955170059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoPobi7lU24Q7kNvwHY94B6&_nc_oc=AdpCGUGkPjv4d6T6yiZbrOkPEnEttV2YgA8sESg7BFoWJKI4bJdjXAmJBp222E1FMDY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ppm7nO63pfFZr2KvyJXAKLdh1_YwLassOJCmZHQaigw&oe=6A3FF332"}, {"file_name": "Screenshot01.png", "id": "1175962019519470", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001711_1175962022852803_190713952312442679_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0SN3hXahzkQ7kNvwHHsCjm&_nc_oc=AdoCnaxyIC94tE6IgMOYRwYbn2-AC1kO3PJJSrFC3gLMWPO72z02AnZbs5nbpL9Tqmo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AK9uT-UkyOi34iYkTp2W7KU6YQroI1wRFsN965piTfg&oe=6A3FCBE4"}, {"file_name": "Screenshot09.png", "id": "337369811125070", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974591_337369814458403_3194979340277084116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLj02rzsVNAQ7kNvwGqNz2H&_nc_oc=Adr6-FiXpGNVJP6QjVQk__w9tu4c27fdd4T1lXGRWZSB9NXq3RuXdCM54qskcMNTW2w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qCeEzQ2STW25RvPYg3avpaOMy56dh6q8s3EKA3fMSpA&oe=6A3FBEC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1383443358677671", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974454_1383443362011004_7988140006223216847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dncPyleEK6kQ7kNvwE8cgL5&_nc_oc=Adq2E63TEi3evKgdcBFXaJp6kOeP1_PgUFyHO8OD3bQslryq86D3hMOm8BNmhE6PvNY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lOjQWcc64PPqt43zNY72ZnaHN9Zz0x2qBqU3n3qeicQ&oe=6A3FBC52"}, "display_name": "Space Bucket VR", "keywords": [], "long_description": "The epic tale of a hero, a bucket, and the vicious alien that tries to tear them apart.  A receptacle-based love story for the ages in the grandest traditions of classic space opera and the tales of antiquity.  You will laugh.  You will cry.  You will travel through vast stretches of space and time with a box on your head, a bucket in your hand, and a song in your heart.  Embrace the future.  Embrace your destiny.  Embrace the bucket.  Space Bucket.\n\nBut in all seriousness, Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!", "short_description": "Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suspectreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Suspect Reality", "support_website_url": null, "website_url": "https://www.suspectreality.com/SpaceBucketVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055852184973813"}, "review_messages": []}]}, "cove
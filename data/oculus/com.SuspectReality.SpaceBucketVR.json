xX&_nc_oc=Adq7p42pvCNDTZCU3WHQEUfwucN5zbrIFpo-6lvtvgrcYH-e-xBAdfKtX7LSBld8dzc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CdoemsHW92QT0UodsofF3HBkAclWxFO2Z8dfFUr122w&oe=69EA03B2"}, {"file_name": "Screenshot04.png", "id": "537244497275099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974446_537244500608432_5225225128955170059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8sM-299vl0Q7kNvwHXM6t7&_nc_oc=Adp0m6jxZtvE1a66Zu6il1SFKSjrucCdYoi0HF2RnBCJtYqvJFKGl5FGCbQ0hiLa6ME&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ljDm0mq2_RF_QvtKXWyoMlySvc3dM3VU9EO3cmOSIag&oe=69EA0972"}, {"file_name": "Screenshot01.png", "id": "1175962019519470", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001711_1175962022852803_190713952312442679_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6rABIbepDAQ7kNvwFx6B1F&_nc_oc=AdoBPWa6UBB4Nfysp-A_aE53vrxF4RmCHJ8a1ycgJvBUqCiFhkoobI8-Yy4wUO7i0UY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Q7W1MwwlEkVCCFnvAb3wEoz8aFOFbzO-FWodiSHTRgg&oe=69EA1A64"}, {"file_name": "Screenshot09.png", "id": "337369811125070", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974591_337369814458403_3194979340277084116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ST58f-0KsTUQ7kNvwGMuwC_&_nc_oc=Adr_hj-Xn1H8oGOJrtsAIxrAnpFKRXWy48l7-wi_arvXIYV6P0MVlQCWhESkPYAnYiA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1H1YLgoVRGQhlNo8LV1XELAnFS9MkLd8G4cS_yw9_kmQ&oe=69EA0D47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1383443358677671", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974454_1383443362011004_7988140006223216847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tk5NffP6lm8Q7kNvwG4H7Vd&_nc_oc=AdqZ4NPTrCtQ2dIn1H-OrA1-ny2Dk8nYrNz8wjiudMJh1vLbPT0cY_3AvX8-_dVwHw8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Ju4DXtRILAHlV7ApecLJtTmLosjcBO-cziUtdvcF3bQ&oe=69EA0AD2"}, "display_name": "Space Bucket VR", "keywords": [], "long_description": "The epic tale of a hero, a bucket, and the vicious alien that tries to tear them apart.  A receptacle-based love story for the ages in the grandest traditions of classic space opera and the tales of antiquity.  You will laugh.  You will cry.  You will travel through vast stretches of space and time with a box on your head, a bucket in your hand, and a song in your heart.  Embrace the future.  Embrace your destiny.  Embrace the bucket.  Space Bucket.\n\nBut in all seriousness, Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!", "short_description": "Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suspectreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Suspect Reality", "support_website_url": null, "website_url": "https://www.suspectreality.com/SpaceBucketVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055852184973813"}, "review_messages": []}]}, "cove
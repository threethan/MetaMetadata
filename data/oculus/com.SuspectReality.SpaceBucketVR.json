bq&_nc_oc=AdplKy5q1Ruyu84YqTTDI0YalhVqV74GHjCdv8t8-JxX-3RhJVcBTtvzbEG53O6rswk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxeNXxjDNo5qwlfxG4vCN-2liohkHuvREqx4lU3WwgpQ&oe=6A577032"}, {"file_name": "Screenshot04.png", "id": "537244497275099", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_537244500608432_5225225128955170059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mp5pVb-PgRAQ7kNvwFBlAs_&_nc_oc=AdoxngYx1QrLU56k-1oE5TURB6jU9digicJtfi-3o9vH8OvBl8zPFgNcsOkMd95fDiE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6XhCmWGVoM6MgfKzpyliOe_MQRc9BnOIUR_IR3rO6WQ&oe=6A5775F2"}, {"file_name": "Screenshot01.png", "id": "1175962019519470", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001711_1175962022852803_190713952312442679_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzKqlIbT8z8Q7kNvwGwd8K1&_nc_oc=Adob_aylAUVUFZ9aRfTwLq8463ZzNkeiKmk-Qh2QkIPaLEzP10cu9u-dQ836ZQblMF4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSLn6w5ijMoXDIJtO0gORdhUF1oR-aZ4r5-fQXAd7BLw&oe=6A5786E4"}, {"file_name": "Screenshot09.png", "id": "337369811125070", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974591_337369814458403_3194979340277084116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_2Z7T_wae8Q7kNvwFl4f4T&_nc_oc=AdrITfIrcFqyrjwrUKO9VJPsBdoMDVDebHWZ1m4bVjJgu9I0V5v0Zo37o3pWWbz3PpQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCF8C5HGL-Ke1ID0i98-OzZhwfXsH-H3uun0Ul2eYd15w&oe=6A5779C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1383443358677671", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974454_1383443362011004_7988140006223216847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRViyEhBZZQQ7kNvwGXCDyA&_nc_oc=Adry8lB1jnFwgmV4S8iHY3Mqaar3xkL_o6YFMBjJ-7cxhxPlZJrdwdw7ApPzszzYixA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIk67995x_zHabUEQGcB2I_73jhbQMc54RixpIxPHxnw&oe=6A577752"}, "display_name": "Space Bucket VR", "keywords": [], "long_description": "The epic tale of a hero, a bucket, and the vicious alien that tries to tear them apart.  A receptacle-based love story for the ages in the grandest traditions of classic space opera and the tales of antiquity.  You will laugh.  You will cry.  You will travel through vast stretches of space and time with a box on your head, a bucket in your hand, and a song in your heart.  Embrace the future.  Embrace your destiny.  Embrace the bucket.  Space Bucket.\n\nBut in all seriousness, Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!", "short_description": "Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suspectreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Suspect Reality", "support_website_url": null, "website_url": "https://www.suspectreality.com/SpaceBucketVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055852184973813"}, "review_messages": []}]}, "cove
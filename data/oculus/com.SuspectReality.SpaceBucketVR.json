U5&_nc_oc=AdptCcmIIb43s72uOA_txApuvP30sbvUNqPg6BTQqG5k2wQMEgzYGm9KWxT1xmSFB5A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af855sfNJWcR7WVVuGINTV61b9vmS3nv-XM49cA-teZllg&oe=6A301B72"}, {"file_name": "Screenshot04.png", "id": "537244497275099", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974446_537244500608432_5225225128955170059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15RX4VL2OykQ7kNvwGrRNK0&_nc_oc=AdriyTrDIIE1THGmsrpsUihz1u-D_kuCLVu41Xe2Y_OVBUgcF0WwoO4PWjlEF3-XTLc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BvlTF46DO7gvbw_lmEhE2onCWyVnGzbbwIaTpg2STig&oe=6A302132"}, {"file_name": "Screenshot01.png", "id": "1175962019519470", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001711_1175962022852803_190713952312442679_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Uwbn8AbsNwQ7kNvwF4IPlx&_nc_oc=Adrx2UMRfhMlM-WdbaHeYNT9pGh6x7pns7jfgKzCLS52MN4dRypaTjzRAEQNxmWu0DA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_H02VL8fF0KPU9PUs1C4FQGrGuFMBzTyQ9jsfG86Ntsw&oe=6A2FF9E4"}, {"file_name": "Screenshot09.png", "id": "337369811125070", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974591_337369814458403_3194979340277084116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3CD_8-4RGYQ7kNvwF294Uw&_nc_oc=AdpaIqz_-KrlBZcLKBgWqSE76assogzEGCvP6hWUsUBer03lhEr2ijs0b9N0K_9Znxg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YQREuAIEj3Z0xDH4TLDFOO5w1zMfXjV2C-Fe1qvoDNA&oe=6A302507"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1383443358677671", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974454_1383443362011004_7988140006223216847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zod2LaOxIIYQ7kNvwHlyUvr&_nc_oc=Adp1TgatcbcIUCOkFGCB_jX-Xbo70QjXTmjl4JF5mTSZI4fF52zFv54OjxdZM_Xo78I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EX-Mh3AxGxDMIML0O-afsxyi7Xp9PSgBnbpNKxJZqSA&oe=6A302292"}, "display_name": "Space Bucket VR", "keywords": [], "long_description": "The epic tale of a hero, a bucket, and the vicious alien that tries to tear them apart.  A receptacle-based love story for the ages in the grandest traditions of classic space opera and the tales of antiquity.  You will laugh.  You will cry.  You will travel through vast stretches of space and time with a box on your head, a bucket in your hand, and a song in your heart.  Embrace the future.  Embrace your destiny.  Embrace the bucket.  Space Bucket.\n\nBut in all seriousness, Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!", "short_description": "Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suspectreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Suspect Reality", "support_website_url": null, "website_url": "https://www.suspectreality.com/SpaceBucketVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055852184973813"}, "review_messages": []}]}, "cove
4C&_nc_oc=Ado8DPXSYKUY_KgqnQAfqRGm9NXdThmgqTw_NANi_69pE8x-lSUjOCCL_r934yi31Y0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmen1N6xPRr5HXGZoTneZ1snTmgW8OcJoIQSTCbSHa2w&oe=6A4E6DF2"}, {"file_name": "Screenshot04.png", "id": "537244497275099", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974446_537244500608432_5225225128955170059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcF5bq77rB8Q7kNvwGqueoT&_nc_oc=AdqcpoB416coqLZYdreMXELHpcyCeaksxmZdEHEI5xI8-5Op_q2eHQJrqI5aTlyTVxc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8Fx0rbTG5MrhAEzCBLHgIXhanWSsvjCIGriWaLkbHrQ&oe=6A4E3B72"}, {"file_name": "Screenshot01.png", "id": "1175962019519470", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001711_1175962022852803_190713952312442679_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCsWdwhN-PYQ7kNvwHYBspo&_nc_oc=Ado3YhLM_Sd--q5i3nqJ4oV3JmIr_uWncwexHKQI2idpejZAfNS8HXPAq5Euvg67x64&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzM9V8z0bXaRX1V1J7BBmT3G-FF0kFdslWdq9FlGRgWA&oe=6A4E4C64"}, {"file_name": "Screenshot09.png", "id": "337369811125070", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974591_337369814458403_3194979340277084116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkDSWd8xqLEQ7kNvwHuxOTA&_nc_oc=AdofFGNaffjQegAIxRi9QaimW30Ior62UD8HKv-ZM64SKbhUljHgKE3zCNEDl1MxTO0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA45K22sndTIF4X__L5k1013YsBFvB-Wff6guDn31Y96w&oe=6A4E3F47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1383443358677671", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974454_1383443362011004_7988140006223216847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0Zz0-ypNCIQ7kNvwHl_bhD&_nc_oc=AdoCm3tNEgyd-bl4Gge3Nfu2dvBEBCsptEB9Dp34kByVHfZtWRrrMGYXF_GO6xO6H1o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCO906kNc1xaTXG60TE-enXeDP6hjcp_2397O_ytlJHXw&oe=6A4E3CD2"}, "display_name": "Space Bucket VR", "keywords": [], "long_description": "The epic tale of a hero, a bucket, and the vicious alien that tries to tear them apart.  A receptacle-based love story for the ages in the grandest traditions of classic space opera and the tales of antiquity.  You will laugh.  You will cry.  You will travel through vast stretches of space and time with a box on your head, a bucket in your hand, and a song in your heart.  Embrace the future.  Embrace your destiny.  Embrace the bucket.  Space Bucket.\n\nBut in all seriousness, Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!", "short_description": "Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suspectreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Suspect Reality", "support_website_url": null, "website_url": "https://www.suspectreality.com/SpaceBucketVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055852184973813"}, "review_messages": []}]}, "cove
Nk&_nc_oc=AdovMgEnsl2QEyaByjiGwJxZE68Sk646xi0xnUA09GFb-S7hu_n6PTfTkiOXEWw_KgU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1qkd3cgSp0Bxpls6EwMiCnMem67aNgyXzJBCzElLxMQ&oe=6A26E0F2"}, {"file_name": "Screenshot04.png", "id": "537244497275099", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974446_537244500608432_5225225128955170059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Htv-JhhoFZkQ7kNvwFnPnpz&_nc_oc=AdrU3NuSJY1q0ka3Kc2tWx3AEv9SYsMwN2LvYojKusmBkDSbo-YHzd39a7d2i8m-Dqk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rfWAjp4_lxyNbhzSo04HDtQxPN0wZG8OYAtgcVFgqmQ&oe=6A26E6B2"}, {"file_name": "Screenshot01.png", "id": "1175962019519470", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001711_1175962022852803_190713952312442679_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DISu3OSIAusQ7kNvwHvJUXs&_nc_oc=Ado7Nz-By_4y3G2JgnvKwt44PTsxFPpVMAsZZjVrQmvZXlsfqZxiJslIqUm_VThRyEs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QB5AyuOjC7gfNPPpgXSZBlDu3kgXdRHP9okjd2Ge97g&oe=6A26BF64"}, {"file_name": "Screenshot09.png", "id": "337369811125070", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974591_337369814458403_3194979340277084116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXYf55xuW38Q7kNvwEVchIr&_nc_oc=Adr1miF4xz8NVbAgyrBS7FySTBJaT7OkNHuU_AI3n3ixUVPZKUnOf8ShNOTxKkRBA-o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YkjdJsdhTxHJg2aOHYr7Ny7qyWG8XAbqI67GNr_3UyA&oe=6A26EA87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1383443358677671", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974454_1383443362011004_7988140006223216847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eax9YSWPXtQQ7kNvwHWRK3n&_nc_oc=Adpn8tdSuIe845ozgD5Ai6_pjS6QLtE2sd0pBLBpuwFpucHw-hfVfrgk_m1RKIgOpMg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_S5R3Hy8Op6Dclakhn3yMbvahNczxuPuJGmvDvfwUJdg&oe=6A26E812"}, "display_name": "Space Bucket VR", "keywords": [], "long_description": "The epic tale of a hero, a bucket, and the vicious alien that tries to tear them apart.  A receptacle-based love story for the ages in the grandest traditions of classic space opera and the tales of antiquity.  You will laugh.  You will cry.  You will travel through vast stretches of space and time with a box on your head, a bucket in your hand, and a song in your heart.  Embrace the future.  Embrace your destiny.  Embrace the bucket.  Space Bucket.\n\nBut in all seriousness, Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!", "short_description": "Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suspectreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Suspect Reality", "support_website_url": null, "website_url": "https://www.suspectreality.com/SpaceBucketVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055852184973813"}, "review_messages": []}]}, "cove
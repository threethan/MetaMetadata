_1&_nc_oc=AdpjBOcIL6C2Wsktq7Vw0l-aEhGMLDG1zbyqs7SX9le6BG8Om8kSV1qIRe1lUGQc05Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WvP0PFvu2ArbsGt8-Ug4GYIO3Sv_Gw-FAYo4rVVYXZA&oe=6A32BE72"}, {"file_name": "Screenshot04.png", "id": "537244497275099", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974446_537244500608432_5225225128955170059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMlzH5HZxBAQ7kNvwE5S7h5&_nc_oc=Adpyl4yjR2Tb9E0jEnACfSvMB2vDxFbd6t2VviLsFKODPW3zxUiyXd8DNVu7TynLuHg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_mXPin1g4IRK-jETY4TlKLGsuDRqN3MQP89PNnYmC_g&oe=6A32C432"}, {"file_name": "Screenshot01.png", "id": "1175962019519470", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001711_1175962022852803_190713952312442679_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Uwbn8AbsNwQ7kNvwEZsd8Y&_nc_oc=AdrEDKjQz-IsxO0qmLXVGnYLfDfTCJLCT7b7PbIZhWVyUpaoFzP-ge47oqv6ujqJJ9s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eqPVX7ME964Ul4HSSzk8dykPMLREGT6e-Q9YaYJb3zg&oe=6A329CE4"}, {"file_name": "Screenshot09.png", "id": "337369811125070", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974591_337369814458403_3194979340277084116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3CD_8-4RGYQ7kNvwH4uRF8&_nc_oc=AdpznnN0HqwfIuEEEeuS7WTe6xUHWjpudNxbO_3stxmyKGu9xoth60Uf8oeDvmy8Mrk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SpUOxFjSHXPTAOSuhMnztQCMetEusoXxyIzwLF6Lmzw&oe=6A32C807"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1383443358677671", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974454_1383443362011004_7988140006223216847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7H6nqBLdapYQ7kNvwG2wo6C&_nc_oc=AdqD32XMWy6Ed04bDFJcBwJE-m-ci3J2gQAKtqRFz7FvBSo-A_V6mtxYjMGde6Y08DY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MfbIRHAWG2iJmCUIONk8oKH68k-BOCSfvzg9BosUUew&oe=6A32C592"}, "display_name": "Space Bucket VR", "keywords": [], "long_description": "The epic tale of a hero, a bucket, and the vicious alien that tries to tear them apart.  A receptacle-based love story for the ages in the grandest traditions of classic space opera and the tales of antiquity.  You will laugh.  You will cry.  You will travel through vast stretches of space and time with a box on your head, a bucket in your hand, and a song in your heart.  Embrace the future.  Embrace your destiny.  Embrace the bucket.  Space Bucket.\n\nBut in all seriousness, Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!", "short_description": "Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suspectreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Suspect Reality", "support_website_url": null, "website_url": "https://www.suspectreality.com/SpaceBucketVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055852184973813"}, "review_messages": []}]}, "cove
94&_nc_oc=AdqGYuM_nRy8wSz5dyd4vTvLjZEDwrRc4ThezVRnXYgP4yFxaPSyOaScOjidtQoCr5c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAI7v-krGsOrZOP66ggobOHBouFkNfnJwtsb-5cKWp3yQ&oe=6A649F32"}, {"file_name": "Screenshot04.png", "id": "537244497275099", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_537244500608432_5225225128955170059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4s4KvWoDqMQ7kNvwF-WBdn&_nc_oc=AdqTBt9wN3zcF4776ErILjF3Mkk7k9dxnTCX0x7D4-0fAnGz_Pq284tYODkxG8hpHAY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmrAxjkD-oQP-YSLdjNQEzOemaI2zY-NuitdArbllOdg&oe=6A64A4F2"}, {"file_name": "Screenshot01.png", "id": "1175962019519470", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001711_1175962022852803_190713952312442679_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paUW9zFhzjkQ7kNvwGz32cd&_nc_oc=Adph-QCQMsxE8tHjcH-wlijdzajpnEujDMDqXLD-NGEOUc2XwaV2g1TKebn--Wutw9w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6Ji3zK0TNqwHKmk7nUhJanfQ550xux2xXfXQmIuoEcA&oe=6A64B5E4"}, {"file_name": "Screenshot09.png", "id": "337369811125070", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974591_337369814458403_3194979340277084116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQKjeDyUnVIQ7kNvwFy5JPo&_nc_oc=AdqWYAQS5Dy-WFeXfTjdrKZGg7xmQY7QQgDKXs8Sy70ZllBEoVZ74MVEHW2Xz_52pSU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCm4GNzxosn6oTeAUnGloWpOtbeW_hlkBSD0LraQ4mT3A&oe=6A64A8C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1383443358677671", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974454_1383443362011004_7988140006223216847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWP3KMl0gTMQ7kNvwFoiGXo&_nc_oc=AdqgGyNZs505uo8oJ2NiB97ZcXauhlfdSWvzA9qC30114VLCip3Y9qr7K-gsowdVngY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHt3DFkWK-4wMByhNdM8rVfJGVgtvPoUJTURtIDHujAQ&oe=6A64A652"}, "display_name": "Space Bucket VR", "keywords": [], "long_description": "The epic tale of a hero, a bucket, and the vicious alien that tries to tear them apart.  A receptacle-based love story for the ages in the grandest traditions of classic space opera and the tales of antiquity.  You will laugh.  You will cry.  You will travel through vast stretches of space and time with a box on your head, a bucket in your hand, and a song in your heart.  Embrace the future.  Embrace your destiny.  Embrace the bucket.  Space Bucket.\n\nBut in all seriousness, Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!", "short_description": "Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suspectreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Suspect Reality", "support_website_url": null, "website_url": "https://www.suspectreality.com/SpaceBucketVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055852184973813"}, "review_messages": []}]}, "cove
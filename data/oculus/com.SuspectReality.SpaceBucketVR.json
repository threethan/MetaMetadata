y6&_nc_oc=AdpWZvvZw3UWFQJlvsa207gxaAEch7z7UrExfXYkz5RuUE6sNFASmzMVKEv-75pUVHg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgWdZO02gjyR4YYJliU31I96xpVCr90nMcMiGfF-S30A&oe=6A86E632"}, {"file_name": "Screenshot04.png", "id": "537244497275099", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974446_537244500608432_5225225128955170059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EttHslvQ8PQQ7kNvwHDUXJ3&_nc_oc=AdpHpHbXugcGHAotfXv2UjQNKAGHH8-goEX4sLDAXRlNCw9sVFUReNHc51EhMfMgayA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIlVAxy8aYJSpgs6AFrTh5aceD2M2bmv-fa0UTjvn48A&oe=6A86EBF2"}, {"file_name": "Screenshot01.png", "id": "1175962019519470", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001711_1175962022852803_190713952312442679_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9A8TIswsg0Q7kNvwFaBKCA&_nc_oc=Adr2awbASbpumVL-QNsFel-Lu5FmLE3w_pqKWyzf6Xn9kEdOw8G8PaDCxLA8Dy_HIPs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJD2z1J12QtpspnyC66YvqrmT9usLjBbjvcac7ZgXaLA&oe=6A86FCE4"}, {"file_name": "Screenshot09.png", "id": "337369811125070", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974591_337369814458403_3194979340277084116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJT41eT5NPcQ7kNvwFdXVxV&_nc_oc=AdrHGhY-ZwVNeowes242NaW-ipPpokGyevk7SwEzAnHxosN2bPsoKgN1jXQq2jxPY2E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8oksx5OJkOwKymVxr4Q0JAJZF7rcVH-FV3hnKUGoJ9A&oe=6A86EFC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1383443358677671", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974454_1383443362011004_7988140006223216847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRE4CR4G1F0Q7kNvwETizyo&_nc_oc=AdpWuO4KSlSCz3JOIkffb-84ZHkcnW2IB3_gza556J5MnfSj4FyGg-aHwCojxulcYFk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWjd3Q-o_YEUYnvuWcJsEeS1HSo4UJbnWwnEqj-90VkQ&oe=6A86ED52"}, "display_name": "Space Bucket VR", "keywords": [], "long_description": "The epic tale of a hero, a bucket, and the vicious alien that tries to tear them apart.  A receptacle-based love story for the ages in the grandest traditions of classic space opera and the tales of antiquity.  You will laugh.  You will cry.  You will travel through vast stretches of space and time with a box on your head, a bucket in your hand, and a song in your heart.  Embrace the future.  Embrace your destiny.  Embrace the bucket.  Space Bucket.\n\nBut in all seriousness, Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!", "short_description": "Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suspectreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Suspect Reality", "support_website_url": null, "website_url": "https://www.suspectreality.com/SpaceBucketVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055852184973813"}, "review_messages": []}]}, "cove
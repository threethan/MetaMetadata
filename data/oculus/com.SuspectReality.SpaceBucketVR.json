31&_nc_oc=AdolNoIzi4Ow-htLWKQ5_HNDexxOkPNKE2ZFMMlUmJoPIDRUvdPw6-wwbkY1VSgQmZ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9uveFXKF2kurFG-OOfRllEG7Ke6-4aS1_exoj8B4o8Q&oe=6AAAB6F2"}, {"file_name": "Screenshot04.png", "id": "537244497275099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974446_537244500608432_5225225128955170059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgI5wwYCzBMQ7kNvwHvYA7w&_nc_oc=Adob7z4khm2KWYEXwUqXV4qqbywYCPlREkNG4XEuTFCxmELumI803-4s3luqZhQzLmg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLC-NIDrMNCBeYlNGETqOeioulyjoptBQpzSYdRKHzfUw&oe=6AAABCB2"}, {"file_name": "Screenshot01.png", "id": "1175962019519470", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001711_1175962022852803_190713952312442679_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKJ6ZxLnis0Q7kNvwE3aJKy&_nc_oc=AdrixhXWbnIE2whq61U33q4AIol632_CfFXbJVUNa8KtwGhN1YCXLT6vCkmYSA-fKlA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImIinXywMAq751OvqEqJlR6FQdohs7K_bmjT6SmAZteg&oe=6AAA9564"}, {"file_name": "Screenshot09.png", "id": "337369811125070", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974591_337369814458403_3194979340277084116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWWJ37XEi80Q7kNvwFZsI93&_nc_oc=AdqYWE5AIH_G296p3DXLt9HA97sDEEFRuIT14voM3c0Bs9y_NMxds9XLcaVHyN4WAI4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4lycC8vvlTD-Redb5kRVCbnUVMZldMmyLnokKCKx77w&oe=6AAA8847"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1383443358677671", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974454_1383443362011004_7988140006223216847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pm5nUH5FfZYQ7kNvwEIkgW-&_nc_oc=AdrRivNdlO9WAU96LESRXH7K5KW8GRzjjnHpBvsrAAipRMp0lluCUKVT_AyJzNw_hJI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPnjDTNb0j5qAbPltWnj7T8agKtiO-AfQO7diHKEe9lw&oe=6AAABE12"}, "display_name": "Space Bucket VR", "keywords": [], "long_description": "The epic tale of a hero, a bucket, and the vicious alien that tries to tear them apart.  A receptacle-based love story for the ages in the grandest traditions of classic space opera and the tales of antiquity.  You will laugh.  You will cry.  You will travel through vast stretches of space and time with a box on your head, a bucket in your hand, and a song in your heart.  Embrace the future.  Embrace your destiny.  Embrace the bucket.  Space Bucket.\n\nBut in all seriousness, Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!", "short_description": "Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suspectreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Suspect Reality", "support_website_url": null, "website_url": "https://www.suspectreality.com/SpaceBucketVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055852184973813"}, "review_messages": []}]}, "cove
cY&_nc_oc=Adp0eQPVstR5PRViPZtHnnFjLNTLsGCgMt3hyxfUGPdQ1ecVyhqLkkCK_h9B6kXI4rg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-B4GwxYpHTdabdfpMRREHZnzdyO5MogNmQBvOz9Ax9w&oe=6A146BF2"}, {"file_name": "Screenshot04.png", "id": "537244497275099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974446_537244500608432_5225225128955170059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CiUAXQ28QKkQ7kNvwFzTNsA&_nc_oc=Adon5nunukXwye_FwMevvJqaV95yBaqoaj5tzQZI0TegVa_2yiKHg9xbuCU_qmwlWRQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aQ4iwzMzXooEZEzbFld6SGdddPaYuS9VOuAyEKjZjRA&oe=6A1471B2"}, {"file_name": "Screenshot01.png", "id": "1175962019519470", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001711_1175962022852803_190713952312442679_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qjal0eJ3hRYQ7kNvwENeTR3&_nc_oc=Ado5uO1sBw04Oua863S-p1_tJ9J52dAyCF6ORLQpvrQ85fklX-urXW5zb-XWNHjUwpg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BhXBVikHoOFZ8Q8f4w0sq0ZRJpKSCzsssgmcTFOwWMA&oe=6A144A64"}, {"file_name": "Screenshot09.png", "id": "337369811125070", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974591_337369814458403_3194979340277084116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCIzR-sdF_YQ7kNvwHgIE8o&_nc_oc=Adqwp8WgnIQdVCWnF9Lo78BE0LIZ2hjwkViXMhuxpx1eFllLMKd5ctLrFQpUzwioTJc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VXdVj7AZwup3U-nQIVVWEVHIFe2kq8lTiYFTQdqytYA&oe=6A147587"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1383443358677671", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974454_1383443362011004_7988140006223216847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yL0RJ8ONvXgQ7kNvwEzRrTX&_nc_oc=AdoNidRwQUgtXm1VWoQWxYFbC2wxwhdZgcPjnimWA97f_Evz0Gu1g2GrioNNT_2HzCY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kG4XjuddwtY7W_U-ntwj_MrIM1fYwQ6y0XdfnnM07tg&oe=6A147312"}, "display_name": "Space Bucket VR", "keywords": [], "long_description": "The epic tale of a hero, a bucket, and the vicious alien that tries to tear them apart.  A receptacle-based love story for the ages in the grandest traditions of classic space opera and the tales of antiquity.  You will laugh.  You will cry.  You will travel through vast stretches of space and time with a box on your head, a bucket in your hand, and a song in your heart.  Embrace the future.  Embrace your destiny.  Embrace the bucket.  Space Bucket.\n\nBut in all seriousness, Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!", "short_description": "Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suspectreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Suspect Reality", "support_website_url": null, "website_url": "https://www.suspectreality.com/SpaceBucketVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055852184973813"}, "review_messages": []}]}, "cove
ZU&_nc_oc=Adrqr18OryjrUPR3BQO8jIPwkqRoqVvxb9K_kHP-kcL4YwvUZV8cms6lVEz8YtJ8rWw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjf3KJuKlMnGkcppFyxiH14-gG6yTeFpafJeVrx3Tpbg&oe=6A771432"}, {"file_name": "Screenshot04.png", "id": "537244497275099", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974446_537244500608432_5225225128955170059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOm6NGwRjtYQ7kNvwHGPmQD&_nc_oc=AdoVV3azaJ2wUTWFuhXxfAmwAY6w8I--9Pf7ZQRuEUN9GkRYLnDEGOalfnKoBGNAMDc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFydXerxLrj8E3VpvOLcHSwv8S9ic8EoffIBxmE-MuAuQ&oe=6A7719F2"}, {"file_name": "Screenshot01.png", "id": "1175962019519470", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001711_1175962022852803_190713952312442679_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGudAzAHCdMQ7kNvwELezwC&_nc_oc=Adpzu5U3kupNDeuTj5cx8-CvgPFV_3kR4OasYfneMYSxUg6HsGkdU-JCv7nlkdFVqqI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECXAcMdb7QadiFrbi3VxSwCUAjUAhyyiwBRLapizeLqQ&oe=6A772AE4"}, {"file_name": "Screenshot09.png", "id": "337369811125070", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974591_337369814458403_3194979340277084116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_q7QKczNxwQ7kNvwHUib4y&_nc_oc=AdpmbP8S8N8ZOlAOky9IpnQ1StdXR3BkvbsAicpT_XW07zuT0SNUHircYWbOjeqTDgA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdCHeFTR9zL3m25xNMDSf0xNHFS8Tuw4u7lFdlKRsb5w&oe=6A771DC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1383443358677671", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974454_1383443362011004_7988140006223216847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hy0IF9z4mm8Q7kNvwGyZzUx&_nc_oc=AdrZYZju8cGtCIpCLHMhIPa1nMqP9JYh9_L7rlZBESgzsSWppfk6Mx-MIRg8WnJhGm4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrlYp31qr-CD2phK9qr9HLGqQTWRCbm4IS0dbwzWWjTQ&oe=6A771B52"}, "display_name": "Space Bucket VR", "keywords": [], "long_description": "The epic tale of a hero, a bucket, and the vicious alien that tries to tear them apart.  A receptacle-based love story for the ages in the grandest traditions of classic space opera and the tales of antiquity.  You will laugh.  You will cry.  You will travel through vast stretches of space and time with a box on your head, a bucket in your hand, and a song in your heart.  Embrace the future.  Embrace your destiny.  Embrace the bucket.  Space Bucket.\n\nBut in all seriousness, Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!", "short_description": "Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suspectreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Suspect Reality", "support_website_url": null, "website_url": "https://www.suspectreality.com/SpaceBucketVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055852184973813"}, "review_messages": []}]}, "cove
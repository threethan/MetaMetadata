Q8&_nc_oc=Adp8DZQB3IjyCn52JpbwWC9QSudt3Div6ddEJN0OqNdjGyIJOVjYXGZ-zmLrdF4ZaFY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cmFrpuD3t4w5gciwJkMPwBWzhNGIYpCI2fsso5_HLCA&oe=6A429072"}, {"file_name": "Screenshot04.png", "id": "537244497275099", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974446_537244500608432_5225225128955170059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qby8f1E8BqIQ7kNvwG0W9QJ&_nc_oc=AdpDuoQaQGj2Pg_Nlw9kGBwh7jE7ulu39kV-soi7zsqmeLfCzgOGmleeR8vaHrLGlM0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9w5gglERjafj0pXTmMURQ3QB5hW5ZnDEx0j4n6a0Ov2g&oe=6A429632"}, {"file_name": "Screenshot01.png", "id": "1175962019519470", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001711_1175962022852803_190713952312442679_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0SN3hXahzkQ7kNvwG6Hmsb&_nc_oc=AdoPAIsnd4EniHAJT5zHMT3JY0SUNBEZANPNT_jVHq_k81lPOvkkVfrA_ln5uFnMGgs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Oou-HoDdj8dMw2FEPir4LUOH7pbm4LQESrxDJkvTSdA&oe=6A426EE4"}, {"file_name": "Screenshot09.png", "id": "337369811125070", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974591_337369814458403_3194979340277084116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLj02rzsVNAQ7kNvwGWJWQ2&_nc_oc=AdqNDNkYNtX4e9x-SG6Iwq2_BMIPUh7FXHRB61-BvkxKzzH7KD8MgV5GOrQ1p9VyNMU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BLaiGuCm8EzQ5zs23YL0oU-ov0k-_K1bFdzmPgTI3-Q&oe=6A4261C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1383443358677671", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974454_1383443362011004_7988140006223216847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ntrq7ZTMaskQ7kNvwGlQ130&_nc_oc=AdprLTlk6TgMUVWRYf4n5tpSBE5zejdiUvC6Hy_48lCGSVrM0FqY_91jTxu9vCaYVG4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sxD3ykxD1_cb4V9-EkAHEBi6XyYbVhdh_uCBLrJVlrA&oe=6A429792"}, "display_name": "Space Bucket VR", "keywords": [], "long_description": "The epic tale of a hero, a bucket, and the vicious alien that tries to tear them apart.  A receptacle-based love story for the ages in the grandest traditions of classic space opera and the tales of antiquity.  You will laugh.  You will cry.  You will travel through vast stretches of space and time with a box on your head, a bucket in your hand, and a song in your heart.  Embrace the future.  Embrace your destiny.  Embrace the bucket.  Space Bucket.\n\nBut in all seriousness, Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!", "short_description": "Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suspectreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Suspect Reality", "support_website_url": null, "website_url": "https://www.suspectreality.com/SpaceBucketVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055852184973813"}, "review_messages": []}]}, "cove
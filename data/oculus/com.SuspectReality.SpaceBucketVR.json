1175962022852803_190713952312442679_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8nOYLCbUvoQ7kNvwHQPw9O&_nc_oc=AdoD6p8bYk5bdry5G9jS4mmQsxKOg5dPZ5SAenxDbdjmKN4MLmahv6qr4_lA_U_cZ0M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWLNWPDFHy0UxUd8Ri74OigHAmkeDp16a9VE0XysYXHQ&oe=6A5B7B64"}, {"file_name": "Screenshot09.png", "id": "337369811125070", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974591_337369814458403_3194979340277084116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1X-9hxUBcN4Q7kNvwH7E5fJ&_nc_oc=Adqe9JJrCH7YtyHRfe87-phWxmFe6vgPUvWUBTpCSWyWzU6sNRXyS8QjjxLTL7tw9_k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYGZPcZT8PDOtfFFFaNKobb9X-xKYoiGaFBImfnNaqnA&oe=6A5B6E47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1383443358677671", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974454_1383443362011004_7988140006223216847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhD-irYKVL0Q7kNvwEGul0x&_nc_oc=AdpJdzy_VziZV6hlY3fijsx0857L5BcR8gRY0dVAgehybBMLqEZT8--tlhXPBW6YOIk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3b84jKhgspXUCAT3HFUcnevyu1CZK6hQFc_-DvEuWvw&oe=6A5B6BD2"}, "display_name": "Space Bucket VR", "keywords": [], "long_description": "The epic tale of a hero, a bucket, and the vicious alien that tries to tear them apart.  A receptacle-based love story for the ages in the grandest traditions of classic space opera and the tales of antiquity.  You will laugh.  You will cry.  You will travel through vast stretches of space and time with a box on your head, a bucket in your hand, and a song in your heart.  Embrace the future.  Embrace your destiny.  Embrace the bucket.  Space Bucket.\n\nBut in all seriousness, Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!", "short_description": "Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suspectreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Suspect Reality", "support_website_url": null, "website_url": "https://www.suspectreality.com/SpaceBucketVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055852184973813"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4425709144106424", "version": "1.0"}, "id": "3926520924119142", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4415085581835447", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "4425709144106424"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3926520924119142"}]}, "change_log": null, 
9N&_nc_oc=Adrq35HVIatVRYeRHLvyyUxjNzz5-TOwDMfL3t1S4RIFFbl7kJ395a-SuCZjxEKgfqo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKngU5VeaQLBqH6B5CXGgRXuQBzbZCYMAN1GsFDxwU-3w&oe=6AB3F172"}, {"file_name": "Screenshot04.png", "id": "537244497275099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974446_537244500608432_5225225128955170059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__26Dgk5vZIQ7kNvwGaAAcO&_nc_oc=AdrHQXSGw6uWpGWSuXgacYSf_gTV398LWHEdWDyQ5GsfZFIjGXt4J4jn_Rx4E6ozlnk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeHU7kOP0By3y3_qOAcq2YiU1LZxc0S2ODl6j4Q70OZQ&oe=6AB3F732"}, {"file_name": "Screenshot01.png", "id": "1175962019519470", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001711_1175962022852803_190713952312442679_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efu740AljfAQ7kNvwExBWRo&_nc_oc=AdoDVp38lmM4HkEKvlXDv74wwj4hWRX8KUZ_-A4Kq0BisccFgXF0h4PDc3PcJBAzzKg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMSQit-pBpQYnOv415gxnyHPKoKAONPN6Gk4uI40LxlA&oe=6AB3CFE4"}, {"file_name": "Screenshot09.png", "id": "337369811125070", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974591_337369814458403_3194979340277084116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snX-cLo09P0Q7kNvwE5Ad7V&_nc_oc=AdqTgvNRa2Q8AeTWUBcZK5y2ejETo91rv3SZRMQbdDvf0mR37O-kyo2yiDDNc7cycTE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYx_zQdRjJmZmGTcpOb11Zf4xKP9LUjMeAQZG3WSQc6g&oe=6AB3C2C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1383443358677671", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974454_1383443362011004_7988140006223216847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0G_0ip9rG9gQ7kNvwFYxL-Z&_nc_oc=AdrMC_Z1Nu6gidkZWjr24nRXSjSKZVnu4T6OE_os7NHjQUsGYP6NhgKgWBulSlNWG_8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNyV9c8djdM9y8cTERWxgfS9SpdzGEhPbYr00GbXo6sg&oe=6AB3F892"}, "display_name": "Space Bucket VR", "keywords": [], "long_description": "The epic tale of a hero, a bucket, and the vicious alien that tries to tear them apart.  A receptacle-based love story for the ages in the grandest traditions of classic space opera and the tales of antiquity.  You will laugh.  You will cry.  You will travel through vast stretches of space and time with a box on your head, a bucket in your hand, and a song in your heart.  Embrace the future.  Embrace your destiny.  Embrace the bucket.  Space Bucket.\n\nBut in all seriousness, Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!", "short_description": "Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suspectreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Suspect Reality", "support_website_url": null, "website_url": "https://www.suspectreality.com/SpaceBucketVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055852184973813"}, "review_messages": []}]}, "cove
Nc&_nc_oc=AdoKqUdd3ai_EYNegyTSsW_qv7R-nyB5RfzfY_uNGEI4EiXcn-Xw3YkrhMWBiLKCTRw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe79SwlnGe3-mRWwxlbV5w3DbR7rcrPzP_NnFcVcoLkA&oe=6AF1E7F2"}, {"file_name": "Screenshot04.png", "id": "537244497275099", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_537244500608432_5225225128955170059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPG0zUyhtEsQ7kNvwGQ6PJT&_nc_oc=Adou1ZCG6oXecg61c-LCG7GAyYHnS4pNfey5F7GUCqtKJTbG653bJvvmAEbauQZ6dW0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjQ873UXVEMAkG67wHQIWXIZjde586H19wE8SXDSPRfQ&oe=6AF1EDB2"}, {"file_name": "Screenshot01.png", "id": "1175962019519470", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001711_1175962022852803_190713952312442679_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8hmVbiFR7AQ7kNvwGjbhzv&_nc_oc=AdoC0MRrV2VQkE0Ys_sgR0ufhV7R9QUcuCgg-r7u3K1t0TJ6YXELwWYQ8KgDdl-Ur98&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSF135A9NifsAudrp7UAOwGozur0NYvK54rlKiekyOMgg&oe=6AF1FEA4"}, {"file_name": "Screenshot09.png", "id": "337369811125070", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974591_337369814458403_3194979340277084116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xEDlSHJTxEQ7kNvwHZP4Wn&_nc_oc=AdolVbbsML0vT1T75C200tTp0ELOcrKrsihqKuenjYPFeg_Aazrgd92Yk0OXmb2oshM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbMXwQatdHHHNL7_M-xv3h_527VNVqKiZ1icC5nZsezA&oe=6AF1F187"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1383443358677671", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974454_1383443362011004_7988140006223216847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_IuB3sAG_cQ7kNvwEwWU_O&_nc_oc=AdoKJMCiKk7M8SIIBohnQuCTBwFivijuK9RiNwoP34tRz8ahhEOyoO2Nl20vqO3tH3E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPZVUow-2-aAaQwCSk8k3xiTlOpWpV9JMwkVXyaKU2Dg&oe=6AF1EF12"}, "display_name": "Space Bucket VR", "keywords": [], "long_description": "The epic tale of a hero, a bucket, and the vicious alien that tries to tear them apart.  A receptacle-based love story for the ages in the grandest traditions of classic space opera and the tales of antiquity.  You will laugh.  You will cry.  You will travel through vast stretches of space and time with a box on your head, a bucket in your hand, and a song in your heart.  Embrace the future.  Embrace your destiny.  Embrace the bucket.  Space Bucket.\n\nBut in all seriousness, Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!", "short_description": "Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suspectreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Suspect Reality", "support_website_url": null, "website_url": "https://www.suspectreality.com/SpaceBucketVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055852184973813"}, "review_messages": []}]}, "cove
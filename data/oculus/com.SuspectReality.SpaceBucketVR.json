0NBrf9tHz_IoZmiUAbM1nCgCl2t-MtjQK1057INKFmWShdDUagIU3k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afwfs_fLyDpdyRDvvq3xPdCjBqfBkmgn1NiextQ11Yshqw&oe=69AABBB2"}, {"file_name": "Screenshot04.png", "id": "537244497275099", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974446_537244500608432_5225225128955170059_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ca-i1UYtLkwQ7kNvwEF30sV&_nc_oc=AdmnJ326E5KNo-jZs8R4BHlgQ2Zz1A16IVG08krv-d8aQT4aNmSBrrls3pIOy9nUBY4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzgXG553jDz6Bl1PlUSRk65NP5HeaM2bbfdj47JFe14aw&oe=69AAC172"}, {"file_name": "Screenshot01.png", "id": "1175962019519470", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001711_1175962022852803_190713952312442679_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7bMNmSAVB0Q7kNvwFamvxG&_nc_oc=AdmCe9P6-qgHZOU7UuK0NlLtXfm2CZMOGTiRBKyCXMjldqMFngeWPBokv5_cp7B5cNE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afzuqa4ivl3NyNZWEckrNHiZScc2UbwHKrKn8LoC8n3w1g&oe=69AAD264"}, {"file_name": "Screenshot09.png", "id": "337369811125070", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974591_337369814458403_3194979340277084116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6Qmy0BPHe8Q7kNvwG_eXdt&_nc_oc=AdmEARUBY9VKJIeM4jemwVD8QHggIwTGlvXsr2wZhScv9-I699rJ_cw_XWXOYl93qb4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afy8TToh68wkhALd2FvfqhMXpBOWXHtmrnx0sIjmAXBG9A&oe=69AAC547"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1383443358677671", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974454_1383443362011004_7988140006223216847_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UA3fexhAfYgQ7kNvwES2c20&_nc_oc=AdkxfZaDxrO-kG3d6xfzxik7YTOUQbGwTa3o1K_k7CRgu2ultissiXJIkNhsOwRToYk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxRnrmHT0e4OewYMBXM4EFphxQHKDmDLTjr7AvSyAS6CQ&oe=69AAC2D2"}, "display_name": "Space Bucket VR", "keywords": [], "long_description": "The epic tale of a hero, a bucket, and the vicious alien that tries to tear them apart.  A receptacle-based love story for the ages in the grandest traditions of classic space opera and the tales of antiquity.  You will laugh.  You will cry.  You will travel through vast stretches of space and time with a box on your head, a bucket in your hand, and a song in your heart.  Embrace the future.  Embrace your destiny.  Embrace the bucket.  Space Bucket.\n\nBut in all seriousness, Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!", "short_description": "Space Bucket is a fun little arcade-style game where you run around catching stuff in a bucket while trying to avoid falling to your death.  There's some grabby and throwy bits too, and we hope you enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suspectreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Suspect Reality", "support_website_url": null, "website_url": "https://www.suspectreality.com/SpaceBucketVR", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1055852184973813"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sc
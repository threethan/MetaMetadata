A&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEha1WINpP8oWacYmNN56zFWTYVU-I9gZVGGPNhzAtbXQ&oe=6A7DBB9E"}, "display_name": "Monkalicious", "keywords": ["monkey", "monke", "chimp", "tag", "gorilla"], "long_description": "Welcome to Monkalicious!\n\nMonkalicious is a game where everyone can come together to have a fun experience. Monkalicious provides game modes and experiences for players to interact with each other and have the most important thing, fun. Everyone is welcomed in the game.\n\nMonkalicious has many game modes for the players to try out.\n\nThe game has a shop for players so that you can buy cosmetics to deck out your avatar with whatever you desire.\n\nThe game has a giant map, the forest, connecting players with all the gamemodes and fun experiences to come.\n\nFind it here in Monkalicious, find it today too!\n\nDOWNLOAD MONKALICIOUS!\n\n", "short_description": "Monkalicious is a game where everyone can come together to have a fun experience. Monkalicious provides gamemodes and experiences for players to interact with eachother and have the most important thing, fun. Everyone is welcomed in the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/monkalicious/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkalicious/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devic
ve a fun experience. Monkalicious provides gamemodes and experiences for players to interact with eachother and have the most important thing, fun. Everyone is welcomed in the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/monkalicious/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monkalicious/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9041324172658950"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "615042267994269"}]}, "baseline_offer": {"id": "615042267994269"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1754939700, "status": "PUBLISHED", "id": "615042267994269"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23964170589947730", "version": "0.38"}, "id": "1099101195491583", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8910976409027061", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "239641705
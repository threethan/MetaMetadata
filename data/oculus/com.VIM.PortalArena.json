5/604370996_1403620605172482_8960975620523376185_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGfhT-QnPZQQ7kNvwEL6UyS&_nc_oc=AdogQNBt1G8KozAIwGY_EXsoDLEJH8smSIyUCrPfg2X-gCG7q5GGhW9DdhMG0rQjnFQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSz6aKveVUkWsaQOda-oOrlDKha4yfScl-uIPGaiaaX3Q&oe=6AFF14C5"}, {"file_name": "3.png", "id": "3198106977050608", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596106838_3198106980383941_4127623032947729083_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTc8zEWCiPIQ7kNvwHBAJuX&_nc_oc=AdopQnxfAEhawccdhs2d-gmcs63dqOkW1pOoGoJ433eu4aDKUz7AxNnmeuonB_ld2wk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqAEjAB6N63F2x1AG9rgsfNlRKb-xQa59CLLxnxM5LMw&oe=6AFF180F"}, {"file_name": "6.png", "id": "2343924576141940", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831569_2343924579475273_299322739667083598_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nc_xfXaGOJMQ7kNvwGUcY8t&_nc_oc=AdrLYkm2gy8yclEYFTSM_0URk7OULuE1O6R7ux3PC2hfPrhVmLqv3N2rdxf7RJS2_74&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ41sxkdYTCo1YacmcpJVUK-0GE-OPXp_0yuUriHRfEIg&oe=6AFF2394"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Portal Arena", "keywords": ["Portal", "Arena"], "long_description": "Portal Arena is a fast paced PVP shooter built around gunplay movement and portals. \n\n**Smart portal placement can completely change how you enter a fight letting you attack from places your opponent least expects**\n{1684231036658686}\n\n\n**Fight other players across arena style maps while using portals to instantly move and strategically reposition**\n{1433302802268145}\n\n\n**Use the weapons to overpower your enemies, when you get eliminations you earn credits you can use to buy higher caliber weapons**\n{1000689932287358}", "short_description": "Portal Arena is a fast-paced PvP sh
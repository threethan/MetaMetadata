5/604370996_1403620605172482_8960975620523376185_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Ze06cAQxjsQ7kNvwE3LuWO&_nc_oc=AdrJArfgTJ_u6qLXjGakjvGhc98KN4QBNSUUgJvA6htnxF1xflKwQDf1BI_B-QuU5Sg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT25-EE1blBIRBkpAEbMt6nORy-TV8JdKbB1rK_NDPh1g&oe=6B084F45"}, {"file_name": "3.png", "id": "3198106977050608", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/596106838_3198106980383941_4127623032947729083_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vUR2vINjLIQ7kNvwGnqzVo&_nc_oc=AdqIG6XaKk1Q85-ve1i2SLFlpka8oqWAek4mOkatHyYwP-b2ZgIu949U-y18-Qgn8ho&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNqBSlrU6WncXa886T6E3oP4JN5NoPaeq8DXQilxCi0w&oe=6B08528F"}, {"file_name": "6.png", "id": "2343924576141940", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491831569_2343924579475273_299322739667083598_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztX0Y9sgAyUQ7kNvwEuw_VZ&_nc_oc=AdrZtXlEn-OkC1D2zqWDJeILwpOW1-0jgGMMhwX2wsF5aK0l-gQOexjw4X-6P6_M4EM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIPuYXIPhbUox6vYy0plXigHJ0-DoAgLMQvINdf6PxFg&oe=6B085E14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Portal Arena", "keywords": ["Portal", "Arena"], "long_description": "Portal Arena is a fast paced PVP shooter built around gunplay movement and portals. \n\n**Smart portal placement can completely change how you enter a fight letting you attack from places your opponent least expects**\n{1684231036658686}\n\n\n**Fight other players across arena style maps while using portals to instantly move and strategically reposition**\n{1433302802268145}\n\n\n**Use the weapons to overpower your enemies, when you get eliminations you earn credits you can use to buy higher caliber weapons**\n{1000689932287358}", "short_description": "Portal Arena is a fast-paced PvP sh
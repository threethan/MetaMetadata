5/604370996_1403620605172482_8960975620523376185_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhxKxAaEqG0Q7kNvwG5V7ch&_nc_oc=Adref0QukX_NVReDelXs7AVtKoodSb_JBPMsDHNz18qQxZdeHlwHoXDoVTZEl1yCEkQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSg5cJ2r3NzVp5m9m3OydrFag4DQmJHt35kKm8NG3FxwQ&oe=6B09A0C5"}, {"file_name": "3.png", "id": "3198106977050608", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596106838_3198106980383941_4127623032947729083_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vUR2vINjLIQ7kNvwF3qqFk&_nc_oc=Adqx1xTzPB7h9A1WSwgo1LxD7ybtkr6VsSQW3ETv7J0qSsxwbWYd-1vYWyuqRKEtczs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1PofpUvSKFoBS1vIJEfbwyySbCagQK7vT0-j4iU80AA&oe=6B09A40F"}, {"file_name": "6.png", "id": "2343924576141940", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831569_2343924579475273_299322739667083598_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztX0Y9sgAyUQ7kNvwE28Pjn&_nc_oc=AdrdO5z1gv3R3ebweoGtHkDjkzUoBT-HNpsbGDU3gFlfKQ171iMp-EEuupDgUIrqMFQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqyVb7OZtgHGlrb7M_uf1mk-dsOp2wRPDmY7u5nH0oVw&oe=6B09AF94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Portal Arena", "keywords": ["Portal", "Arena"], "long_description": "Portal Arena is a fast paced PVP shooter built around gunplay movement and portals. \n\n**Smart portal placement can completely change how you enter a fight letting you attack from places your opponent least expects**\n{1684231036658686}\n\n\n**Fight other players across arena style maps while using portals to instantly move and strategically reposition**\n{1433302802268145}\n\n\n**Use the weapons to overpower your enemies, when you get eliminations you earn credits you can use to buy higher caliber weapons**\n{1000689932287358}", "short_description": "Portal Arena is a fast-paced PvP sh
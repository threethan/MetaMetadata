5/604370996_1403620605172482_8960975620523376185_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2Gdk846VA0Q7kNvwE4qmfe&_nc_oc=AdqEMA8P8vJjr2pMNK3zE2OjkdV2twtUjwgLJyANQjDMDRpMdsg5manUuNGQ_fbDySU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7T4AsPeoTfFB5NfMXbJ0UevIjyLHcEbK1dUYfzqmf_A&oe=6B01B7C5"}, {"file_name": "3.png", "id": "3198106977050608", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596106838_3198106980383941_4127623032947729083_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQdwzPGwdIMQ7kNvwGpe8Dl&_nc_oc=Adr5JCTgR5p0qrPgAOmZheNB78v_FR5mWrGqHa1BpAoCJAvUesZVPhMWTMHh4aWAltY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQP9cmjkXpjx10Ljmtnm6L5KTdtOfQWZIZQtfE9rZj61g&oe=6B01BB0F"}, {"file_name": "6.png", "id": "2343924576141940", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831569_2343924579475273_299322739667083598_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nc_xfXaGOJMQ7kNvwF_uTYp&_nc_oc=Adpki1xJZWLT5v5CD_PZYvXrN_-SNO_e_MfnS8CWLdJFpughWVRoW1zPbFECp6IgaGo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRagdtOzX71xU1VXA1z3bqlK35TS8dyzntS4NREGBOOUg&oe=6B01C694"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Portal Arena", "keywords": ["Portal", "Arena"], "long_description": "Portal Arena is a fast paced PVP shooter built around gunplay movement and portals. \n\n**Smart portal placement can completely change how you enter a fight letting you attack from places your opponent least expects**\n{1684231036658686}\n\n\n**Fight other players across arena style maps while using portals to instantly move and strategically reposition**\n{1433302802268145}\n\n\n**Use the weapons to overpower your enemies, when you get eliminations you earn credits you can use to buy higher caliber weapons**\n{1000689932287358}", "short_description": "Portal Arena is a fast-paced PvP sh
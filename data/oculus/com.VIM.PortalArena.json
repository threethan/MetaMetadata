5/604370996_1403620605172482_8960975620523376185_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2Gdk846VA0Q7kNvwE8uVjE&_nc_oc=Adr5rPuDP2VVRGvN0bWpegpBW5YUqVHbmwZlqyOdOLmyt4iU7qWrj2FhnlusR_GAvUI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQL4BfQIIsxzPt19ZFqD7nJdaNyfZeLJLaxWPDMgZYIMQ&oe=6B045AC5"}, {"file_name": "3.png", "id": "3198106977050608", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596106838_3198106980383941_4127623032947729083_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSJAegxKpjgQ7kNvwFPHVU8&_nc_oc=AdpS8YJQwY327b_iBVUvf-O-nI3t8AgPN0a7yBYJlBi-EeIneupO2Wdopwd5wAVf-3Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnRAXhpOnU5lrnRvWVKH4cyAwcSz0JnmaD18S0FKhOCw&oe=6B045E0F"}, {"file_name": "6.png", "id": "2343924576141940", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831569_2343924579475273_299322739667083598_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXUqnhSCqbgQ7kNvwHpkVpY&_nc_oc=AdobEKXXWRFsFtPeDv16eUqqUur75DVaLS25q-vUXNpATg_0gZgs8xh4zzepivGe_Bk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHHAIMo1Gcidc7xMBlI-5mbNIKlgTxlSb8EeikuJqnCw&oe=6B046994"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Portal Arena", "keywords": ["Portal", "Arena"], "long_description": "Portal Arena is a fast paced PVP shooter built around gunplay movement and portals. \n\n**Smart portal placement can completely change how you enter a fight letting you attack from places your opponent least expects**\n{1684231036658686}\n\n\n**Fight other players across arena style maps while using portals to instantly move and strategically reposition**\n{1433302802268145}\n\n\n**Use the weapons to overpower your enemies, when you get eliminations you earn credits you can use to buy higher caliber weapons**\n{1000689932287358}", "short_description": "Portal Arena is a fast-paced PvP sh
5/604370996_1403620605172482_8960975620523376185_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Ze06cAQxjsQ7kNvwGtMNQS&_nc_oc=AdqqUkKIccLfA9Ngo3lswDVtCx8JzbxwAIFg0HBUFBzEnjiHpgQ661FqGkwJHiL1sQI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjE62TXtvywKgykKkw7hC7LRPMKuR19JqYQkiHlnWYuQ&oe=6B06FDC5"}, {"file_name": "3.png", "id": "3198106977050608", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596106838_3198106980383941_4127623032947729083_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSJAegxKpjgQ7kNvwFkSivs&_nc_oc=Ado8I7YTsM_PWsXclTa4dKpucQdz10K6EXWTCRRYdquN3HeTl7Anlb6xIcBSMxCBQOg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmKq9-5nGSk1Nm1UJl2Jz6Uu2zmEJZI48QI1mIrMw3_Q&oe=6B07010F"}, {"file_name": "6.png", "id": "2343924576141940", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831569_2343924579475273_299322739667083598_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztX0Y9sgAyUQ7kNvwE71_lt&_nc_oc=AdqpiaHcLJohjNPsZ0TowrU6G3VAeqQXyRw7ehCYRJD75m9woyE5iXMo6U3oZs-27zg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSg28ZmoYyKy-nqnMfVjJoVsT-vGYSKGNYgFWstVrdzSQ&oe=6B070C94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Portal Arena", "keywords": ["Portal", "Arena"], "long_description": "Portal Arena is a fast paced PVP shooter built around gunplay movement and portals. \n\n**Smart portal placement can completely change how you enter a fight letting you attack from places your opponent least expects**\n{1684231036658686}\n\n\n**Fight other players across arena style maps while using portals to instantly move and strategically reposition**\n{1433302802268145}\n\n\n**Use the weapons to overpower your enemies, when you get eliminations you earn credits you can use to buy higher caliber weapons**\n{1000689932287358}", "short_description": "Portal Arena is a fast-paced PvP sh
5/604370996_1403620605172482_8960975620523376185_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2Gdk846VA0Q7kNvwFw5s93&_nc_oc=AdpYuWVXJx4jgU1ZOHgqFt3de_yQLab05Ku1N9dpjyqg5uuKa0ZRe_cM3XPCUlp36MY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROs2rqSdCfzyCOI02PRDIVlPe0Qo1nW153hg9DufUD0g&oe=6B030945"}, {"file_name": "3.png", "id": "3198106977050608", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/596106838_3198106980383941_4127623032947729083_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQdwzPGwdIMQ7kNvwFdzubA&_nc_oc=Adr1_aIUk6TA-OqNDf_DwOXF2_LO0-MgXYI-wPNOgLhXSiVpMYtmatUv_d39TS3QANo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFylidqFjjiv4oCyKh-s12EDy-QxHfg6HE6zmdW5i8sg&oe=6B030C8F"}, {"file_name": "6.png", "id": "2343924576141940", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831569_2343924579475273_299322739667083598_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXUqnhSCqbgQ7kNvwFT8PUi&_nc_oc=AdqIAMjs2bx1SAgz3hJyZvFgJEw3fNm1RD4JGeEL4I2M_nQ-k8ltbm5R48SnR8-4jn0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtj8wb72FxIhP1bWfvvF8AycGkaHzz_T7THs5AXDba9Q&oe=6B031814"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Portal Arena", "keywords": ["Portal", "Arena"], "long_description": "Portal Arena is a fast paced PVP shooter built around gunplay movement and portals. \n\n**Smart portal placement can completely change how you enter a fight letting you attack from places your opponent least expects**\n{1684231036658686}\n\n\n**Fight other players across arena style maps while using portals to instantly move and strategically reposition**\n{1433302802268145}\n\n\n**Use the weapons to overpower your enemies, when you get eliminations you earn credits you can use to buy higher caliber weapons**\n{1000689932287358}", "short_description": "Portal Arena is a fast-paced PvP sh
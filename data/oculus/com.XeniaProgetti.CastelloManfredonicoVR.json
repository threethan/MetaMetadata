4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ce2slTpSfFQQ7kNvwEoP8Ap&_nc_oc=Adp6NHHs_QlaWI4Jj8k0tVA-AwIs9MigBuBOb2D9X_pS42AbwBqed4prRF7rVYOXGmI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Jzi0LXEBlx4QXN3Hmgk5bwCIOioG2JhdWnzbUQz5W2w&oe=69DE42D3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avn8d-nJ_5QQ7kNvwHKcoJ2&_nc_oc=AdrS4DK3Jp9TxgUij91pZtfH3mHTPq26DHxruyn5p8m1CIubJzyB38faj_mXNyEgDM4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3r5R4fAO1u4hB9RU1G-lMSY1OwLbyfDz-DSTH6rCeXSA&oe=69DE1F24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7lHPSxXgC8Q7kNvwHgKp4L&_nc_oc=Adp0723Xb4nW3VA73GNTELpCREhljUDTCI6XAWsYcz4-ijnSpOLEeN0SoPwpZpbUA-8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LYK8HX5ce41HEs2DP8PkGGSqmNn99M-oWdhIVvS_PNw&oe=69DE3DE6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
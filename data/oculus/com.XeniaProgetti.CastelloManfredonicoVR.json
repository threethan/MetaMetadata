4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJamrGxHSJ8Q7kNvwFftZzY&_nc_oc=AdqoieGLhpuoVn2cBmEcWvcSTKy38yDPwynA0rzsFjFTViWAkq5axYzFhOGuIDdEpFw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgGAr4wdaffAHy2mvsF6v62pYBSM6gBmZblxIpVuCqNw&oe=6AE74053"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9H2-FDw04AkQ7kNvwHISBXF&_nc_oc=Adqu2Ysa7OoV44-nja7dZzkU8ufK3w25dfhXU_ng9YWI_hlyd6VU9uCVuaQwctcSyQk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHpwEF6KNp_CtoI3TlFjZXhwVg4SrBWqu8tObJvK41Sw&oe=6AE754E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4iAf1uNARAQ7kNvwH21mvu&_nc_oc=AdoR-tQe5UlMR2EbbCJOwJB1_w19Pbd5pCpPBkk5MIBjjOBdcuIHwUrGwAQp4BtyD_8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpnztPXZw57ARMi0wBSewJGZNyOVmM-Jh8x-untAVtFA&oe=6AE73B66"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oHUvW73shMQ7kNvwGMCMBT&_nc_oc=AdqvRBzblw-cFb5O35p45HeGPK_3E9qjXhb2XdPqNEKdUxV03UZPRRYNepIJSHMy3lQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ol3FlVTuMHlrrKmtsi-kNGkNCo7ZwTbgOuvLUVeFKPg&oe=6A412353"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zzx5J-HfXfYQ7kNvwGOOBmh&_nc_oc=AdogOCT7B5lE5QJ5TYN8Xr7pQue9GtI56-Gy6GHNeQVnZX9N-T9rbceo5CnNgkynjZE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1hkAp7DsE0e-MYXyyclO81PlvqutdXbvcOddb30dT4Q&oe=6A4137E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DijHjzl3u8Q7kNvwGQqBax&_nc_oc=Adqht98q4BGzliIZ0WbQ7OgPymEGR5_Gk7xqiFLSJrSjKSe3sC7UnO3x2P6PMKogeR4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PNL_hCgZGAlh3CK6FrwQVSVlq6tLUlvIjS8YbqzRorg&oe=6A411E66"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
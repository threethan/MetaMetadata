4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziYkenuFe4AQ7kNvwHlCdOP&_nc_oc=AdoWXZcjymc9u6EJo-aweTKuF46yKx49lpUSLa7wVd-74r3QFVEhYNB_T54cR3TxbkI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXqur1nUkAT8iAJlStu4eg0E41c8a1J0fGXCxzQlLGnQ&oe=6A75DF53"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMEHxatsnf4Q7kNvwFB0pNv&_nc_oc=Ado3Z2WsOrmRd-dlXS0M-27x2RF3mVNDO9ORNqPKXI5gorJoeyPw7X4De6l5FGwcLrI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9XE-v3TozxUVCGyaVArjy79gAqDfQq_CqSakyBzZV3A&oe=6A75F3E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOofWUZJm2sQ7kNvwFrE4Up&_nc_oc=Adr667kn8nLr63CzMlAM-703_IqYacihJRbNzVok3pdNXnLI5bEeG8KU0d2lqy-e-4U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFc0XZzo_kDtOku2-QEYaJP_0nGLGfAVDeAI9JP-PeRIw&oe=6A75DA66"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
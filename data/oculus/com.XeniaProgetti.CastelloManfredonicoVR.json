4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vje_AbyRuu4Q7kNvwHjMXy6&_nc_oc=AdoxgJ54Qe0fCsdVixyRr6r5qLmwMYKNhjskO63HGO04S9LHtQ3AyPxcgILJnAmcELs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSm0lLw9qAexyr_dsxG_Za6WiXTtPqFK1vzhtGd6evRjw&oe=6AEF6193"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jdw6fwX9DhEQ7kNvwEequ73&_nc_oc=AdoMoIC8UYJ0yjzo6LUnQv4uzJXWp4uGzoUkSGJUAJ8GGOBDKEeblKzpWmGL77U7cvE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQufde97iKWgaVF-Kl-xj9GE2m0JHB9gEYz4brInjJkrQ&oe=6AEF3DE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBV-sGKuboIQ7kNvwFsvB3f&_nc_oc=Adqz8MH0iOTbkfh_r_6CtivL4x-q1Ybs4_kFonRquIbi5ggZ03PH5k01TcTKY2xlao0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQl2g-ugYudNUXHMu1kP4tWwa5joPSxNIfYiyW7Tygx5g&oe=6AEF5CA6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
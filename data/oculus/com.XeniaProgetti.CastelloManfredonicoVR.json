4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZUUAbs8tzcQ7kNvwFX1PIF&_nc_oc=Adra7uZ2oK-rlY7ZCaobaMnLnIAZTB2-qod6yUlSSr8TtJ2bbX7pm01qzkix06upUXo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTX9kDamUYqutafhIMIoKrEFT9yaEYQcjZoMvuQLXMFfg&oe=6AF9B553"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eM0fxrGjOMsQ7kNvwF8c4SA&_nc_oc=AdoFyPw_dRwY4EacBLS_bIH3jdDBrSvDG9YUEIW3soYjFgXnsP9KpatXD6J_WV68f8M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkgHz0VypW5fkaterLEhqjkG6utaTiPHJtPrYc0Ly8dw&oe=6AF9C9E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srqYiKFlqpQQ7kNvwEu31ej&_nc_oc=AdrT-IwKyfKOwQA7F1XlGSiryttU7wdYOzZWF2l3lhR12BeDPIvQovs1I86iWTSTp6c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5H9bKeBRLJxYgGKpJHIn0wLVUPx1SDDi4WSpgqL-QgA&oe=6AF9E8A6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpeVJMkqEpYQ7kNvwEGq2uf&_nc_oc=AdpEcjC1IyvxIBbBem_u91tKqGI53ASkJFkZBO4UpsVYFy8kbDccJMDNI4JMM_jp974&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jbGQsd84ZWKWc_FBDwuDC72JvRDIH1YvP8vKVQ1zQTg&oe=6A2816D3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWtcUpR8TTIQ7kNvwHF5Ug_&_nc_oc=Adq228HZ8Ig0Qhxr6koV0cFpU8wQFlRyInqDh5j-zGXaHbF6Yy1t0ThjNhj74k861mE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VC6TGl4AZxoIbk9WOTqYVaOIcsk1VBnVEjF_80LLvvA&oe=6A282B64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQAktqEywWIQ7kNvwGkv6Rc&_nc_oc=Adqgj3YBpIgHDNT5P1GKyePTed4MO86vhoYY--lOuRjjUi8iq4M3jr6yo4DYo6dvqjw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nM7byIGb-ItM2Rlk8I0HX_QwJB2FlSXd8X14eQDIkCA&oe=6A2811E6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
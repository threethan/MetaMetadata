4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23tfrkMTIJkQ7kNvwGB3yZ9&_nc_oc=Adpktex0jPiHPO_Ksc1hi9SegL-tNwLhrUs_RdT42mKIRRwE7kki4DrDgOwEdig28Bc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1KXf_CFM5fCY_z4I9RcMiFb5ZTwXdLI8ME_nbBPD5Mg&oe=6AC25653"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRegECxFSNUQ7kNvwFin7SP&_nc_oc=AdoLbN96-xIsuSmtUIOSL1l3FxjbCLC7Wd_QxzKtIBzMJYsvtbEeWX0GQAZgnOoW-u8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkF8MkKkl0P43H7DeZXPVsvUlNcVIa8jcYcEaKAN99Xg&oe=6AC26AE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmR5j0FlVWAQ7kNvwGFe8j1&_nc_oc=Adqmq1Bt7BPihmpZaS8Z1v9_3bWXYFMtGaHo-FNYQcr1hOa5ctYz2YPRzIyhRw2xr8c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOB6oDDoHwH21MRwd3tOdpn08W4nxjoHczszTmfgg_uLw&oe=6AC25166"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
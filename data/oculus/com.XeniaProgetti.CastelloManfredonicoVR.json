4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLj_AxiNQckQ7kNvwEnyoXs&_nc_oc=AdodD_bGkh8xZtDGEkEtW2CpQEmxY5QYS3KTMvY4DBdKAovRdAJAhWIjH5kcLN-Ms_M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnYD5TYxcXvZHTm9B2GFHrrjFgjWcoCb6rx6YUukM5Dg&oe=6A5246D3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylbDbnE8EwUQ7kNvwH6rAWs&_nc_oc=AdqO5QBzv8qYz4dNlYHLpeh-epPlWayY16ww8tGEaZc4DKKd3B0hmu-bXbnnLTxIzYg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7FgspQnBzFR4gy3Cu69rodPZgQPTkhXM4l5AM1lIrgw&oe=6A525B64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4OZAOHejp8Q7kNvwFmQqvO&_nc_oc=AdpM_wtPVprGTuEFhRa7lTzQC3OafQ_eNhPBtm4OhR3oWBKf244wBCCjFHuOmFeecYI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxZMjY6DhMkPwyO9VOWq7600as0Hnqr7Mx353atTZXWA&oe=6A5241E6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXWfsgDi9sgQ7kNvwHC7Zp4&_nc_oc=AdpwcJpaSxXPFPmkB-CXs4wa_rHbWGrpoerk5O0I0tqF5r-GwBExfvUTdvsAL1a9CBA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxukkP9ZDlqB9ldoXdYNqu6Ix5hIfuoOaXUXjQovvD5FQ&oe=69C92AD3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNSZAZ9r2yUQ7kNvwG1Nz1I&_nc_oc=AdoGSu2FBOtXchTn1CY7eTcgShLdwbphlpP8w7KxMOh-7DX3-Vm1S_rznRlQ-f9ro4A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzMemhoe2AFkT1JaTJ1GobFTjzWhsbEutbqQKDhLLJ-Pg&oe=69C90724"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0HaHcQHoCQQ7kNvwGQh4HS&_nc_oc=AdovPBQZIyxyyPqrMKpwXr5dHmMwcWraITKeZmwjS7TX88VUcNUO_Oaw_F-IW7n54fs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzSbJQBvcZWmE4h9i3Kj91aReC9nSAcXJC5ifnPanSaaQ&oe=69C925E6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqEdFztKiGsQ7kNvwFRfUdm&_nc_oc=Adrkc6KKUO2PKmGNwse4bz-ITYs0O3vFqtadJFPF-KcYIXD_t10sEoc5H2yr4v0zpKw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhRkLh59llbraiw3nyh7BOIXV6bUfdHYz2-pSglAWepA&oe=6A9D6C53"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KT8PnnXBL2cQ7kNvwHSY9oW&_nc_oc=AdpAFgyK73Dd4EDLJDOt8ut42bC90ctXNTXBMI61T_1tRoj325qcMJYg4rMqlaFBgKQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuBAIJzgED74ij7kreQJczqli9AHQK-yHgyUfPAqk6Iw&oe=6A9D80E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXRbZVor7QMQ7kNvwHBk2K6&_nc_oc=AdrRwtNjNS0X6Ylh3KudODMOvIy5EYc9AuSAiBd__Y4TMzNq4_Afp6lboFUcF86NUgs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEpiEsQFDmkxFJqMznWQwAfzMkZ7xm1MhH17roeG_P0Q&oe=6A9D6766"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvTUoE5hfmcQ7kNvwEKmmTo&_nc_oc=AdqQpMUH6WINreHK38AKDec4AXMxaT3kYgw2VY8h63RrWDvWu8ozh_Yi-TTLl4meyaU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yBMIqyAQOcvN1WRCtMT6JRbosOQYChOH9e3Bkj9EyrA&oe=69FF3853"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4hifBPj92YQ7kNvwHBznST&_nc_oc=AdqHZ_VRSepHI1plnqNPUmPry5A4IRAehZ3pXOUra2xjviOCB-LE5LCLTuhNP5-OMGs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SwKVm_PFgshMUVbg5vyxdFpqII8jZ4HzszPuYlPeU2w&oe=69FF4CE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZZhKRnwTXQQ7kNvwFAhnz4&_nc_oc=AdqCUQOnNGHbjrrmkLq_bztEBcgqIhC9v66GNv_ZQXg3aRxbGHIB4aprkzixt-CkDMo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aa10OZXoLPrGuKY8beH5rAKbDo9Dqpf3TqeOFJhW58A&oe=69FF3366"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
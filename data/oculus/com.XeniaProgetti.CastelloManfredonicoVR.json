4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHDpGAKljzAQ7kNvwGzTYqm&_nc_oc=Adq7XxR9AZh1gEoYcJCJvospR47Axh5VAIAhiZjrywMWiE6qwYr0PN4iPrkvFtXJ_A8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLd_RkzIesRZVnHinDzoUYe90Zhr6UmEaLvXHjY9razvQ&oe=6AB91BD3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfieYRGMTsAQ7kNvwEcN7eQ&_nc_oc=AdoauuJ-Lo4ntsjxXyxwawGLw4mQPV0N1ifsc4XPNXxr24UXNVTdm3_U3y_adnvlR-Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSPqvFMOsL9GwJ37UXpFSJAdBbIp6WG5z8-qWrITYI4w&oe=6AB93064"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJUeHXtoVtoQ7kNvwE3V0na&_nc_oc=AdojAfXoGLQgmrrrdUVsmXeFhCNo9cyW1Zp4DYcXQ1EA-r2mwyrzdlruSSHQkhIfIY4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkniiQsdgSNAPK7GS7SraJw2HWdYXYyA4Jh1lF-pIurg&oe=6AB916E6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
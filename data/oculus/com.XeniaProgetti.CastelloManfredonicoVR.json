4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OotwlIghr2MQ7kNvwFdZQPR&_nc_oc=AdrvLjpBFWfh438yKtVlR_SL40PKjQYZSxgMXbVYQzvifbYwY-zLPGD26cdzPddEdHo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ntVmoRs1nlh06iQicrUWTDyNSTaHM1Vb6zbQhF0MYZA&oe=69F74F53"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTzhgmL8ezYQ7kNvwHhIUHy&_nc_oc=AdqBhDZLGEZ0Ahva4RUqc2E03ru8YTgxtVhWBBcSCYNLIT_3nxzdv57-rRXUojK3ZxU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0bif0Yr84Wo3YhZG--VtJ8mNDgiTW3xEZ7vyGOym2rPQ&oe=69F763E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlcHo2_Wh5MQ7kNvwFTVdD7&_nc_oc=AdpsFWTD46222mDoZORyLTLX86A1bTrRTbnNZ03igQoT3zpoMO_Yr_EyZm7LC8CaSGU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2FphxLnHFG6RMz7qdhV-WIrsEmrYZvfOzgTPtlMli42Q&oe=69F74A66"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
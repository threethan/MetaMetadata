4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRBQbkfWMNkQ7kNvwFdkMcc&_nc_oc=Adpd5CA17ADXKUFOnhZpiIxSumkaBLvqHemZo8DEVIx5pFP6Zc-0DSTnwAX_lBw5Mz8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAte1CVjmsWrsPqa1N2gSePxACQuYnFEcch8VTQseZYg&oe=6A4D00D3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJt8fyY-dT0Q7kNvwEwfWuU&_nc_oc=Adpb_3UUIrEl_suLsTpTqJX0WYyWoxQ0_k6f5hV139JNzUof1fZfCBBQFPCuDREj1LM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIApTh1g9d6uZPavkbDroL2AGGdNkOirjAHWTOmokTJA&oe=6A4D1564"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pr9lG5uBpBsQ7kNvwE2mgBa&_nc_oc=AdrtuxPiIZ6FdrQWZVWYCNvU3rq-4lYCeAFHqQ3kVG-XHv1E-BE41dDfaifSIJW0B4g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9auYJmumfvOTpU9xQ2wFjpTOhFYmtzyCWXCp6iRDpDQ&oe=6A4CFBE6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
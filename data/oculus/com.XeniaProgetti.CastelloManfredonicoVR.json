4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NC_hJlGVj5cQ7kNvwGjEtDb&_nc_oc=AdpneNYDQj1o-lbuBGTfiv5GMUdpFNSlWOUZjqEo9ncuJMEmIcfsDbdiqO0BYy9HKsA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDo9stXHdu5TJmhE20SGtiiSrt4IpLsW-c9o461LPp88A&oe=6A4FA3D3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XX3u5JtUykAQ7kNvwGH9015&_nc_oc=AdoNMYtPGu_RqpUw_IzMyf4HxWznMsO6wIScd_pH7yO9QMUhA5LZLFgUzDjAmdZzztY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSeO_BXr1sVLOHeoTS95ad450VwuE61MnK1sXnnBA5Mg&oe=6A4FB864"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4OZAOHejp8Q7kNvwFQ57lK&_nc_oc=AdrmnBR3jzFiho_ZwU4KINZOciXjTSry7h_FC1zHj_bT8HPuLgrtcLQm5WR2XuS5eIU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuAguz3FTQkNk77IeEXCI0-u5acRU4mMUIuiA8V5LJEg&oe=6A4F9EE6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
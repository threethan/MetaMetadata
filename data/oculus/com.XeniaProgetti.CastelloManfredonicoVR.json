4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVXz69O-cZQQ7kNvwEtmLI9&_nc_oc=AdrodYxls_93u6KlY-zY8B414U5BiPbeEwIjX8UAA20czKrBru-2MmvvTsmYiVIyOgk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGN8JhBlg5QEfGL9ENJqKet2k4QiiHkI78meu-KqzvaA&oe=6AAA9B53"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44W8XqZ-oqMQ7kNvwG-HmON&_nc_oc=AdoM7NZfLKxpdnSyjp4gIOzznGHI0zOhkLpy2J0dzAkL5jDA9vi_60FI3rWUgs_Kj4M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4BsUmtTbRX-PAthcWoc7GDUAt7vF_j-A2TTu6wNm0-A&oe=6AAAAFE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVHMXQNMEkAQ7kNvwF5fJup&_nc_oc=Adr3amkkjXJfE-ZPpQ6faWN69VP_mLXqM9I0-ntKF4ZaCNG9e5wRTr-m5QflLRozKP4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAI4ZidXjfD-h4KMxC2WRFVSBV1soLG1xw2QA47PFBGw&oe=6AAA9666"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_GB3INCqaMQ7kNvwFlygjP&_nc_oc=AdrFq2uG9ECdHVzqr2-ubY0QHw5nRuj9olVX0z8gAMOS6-XHXrXeEEk1ombI0R6vdxY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDnyN4zqKa3GHlZj4yxvZEg7BPj5p2budgF0w3O2XpnQ&oe=6A709953"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTBEfrWu7UAQ7kNvwHyIEDV&_nc_oc=Ado1HipAtgTrrjsZwtMIXuAIsw8m6FKX7EoLxfCpESuqUf4447dEflZl1eGc0dtiJwE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgV40H9yznQbFEn5FpABsSwmSJeIKetFWxcBuu4jR3bA&oe=6A7075A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7Cm19t8mtoQ7kNvwFmupk3&_nc_oc=AdqGxZcoBhphn5oqruw_6_jsM_MIU9kTFVc3Mu3QyF7AEh5Xgua7wzI0d8PwOiHLe1U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyS1569w-BLbWd331kOj1lfAckonfkm_IVktOajFg2ow&oe=6A709466"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
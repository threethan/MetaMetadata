4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kC_5tBqmKq8Q7kNvwFznnmK&_nc_oc=AdqAQjrTNviPUP9s2tL2qaX5R1yX4dU_bHI2yFAOdGmFy3hUwozl3tirvcpLd0_Ow3U&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65wiff25a0e1UN5ZLoVQfjGWHDvr5-7CxxVaszgWT2og&oe=6A1C3953"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3biV88SJ2eMQ7kNvwE4q_ME&_nc_oc=AdrGKSQSP3Bgs0RShTRMn_JkrY2P2BRoFC8oRn4Z0yUMKI1j3tPKTZ2x0YjyeIwyxJU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kdRgFAFaFdcvifm1_itj4iYIW5FNKQaLkfWHnQ-39Dw&oe=6A1C4DE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8auPa_evMTkQ7kNvwH0e9AP&_nc_oc=AdribPRah6ixOs13st5F1PWN0iKQVY_Ffn-oCecVJnalKCh3M6TB4hgp2dJtImmZLtk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oReMRPbRqN7teknO0ZOCRWaJpZrRjik1Zo3aiZ9MbEA&oe=6A1C3466"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLf-p0CBL4gQ7kNvwHr1RPD&_nc_oc=AdpqWRzA5Xl71Y-XE5xPl_bx9X0vi7HdHTt9tW5C50s3MjBUcQF6GPUU5ZBoEy5VXtM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQ2jVAQJpGjRJ67zM3817EZ6tBMJKFi5Mc9hkpqyqb5w&oe=6ABD1053"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mALNB4NaUR8Q7kNvwFVMcLz&_nc_oc=Adqexo85KcS5sgre_Q5H7arfN1LDYhf4lrX49adPzWOlAk_OJ3k1EYPhHvvJidOVoJ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5gOXpVFo-7i6urqhzhwVj3yhn3plwvi1xPGHCTlvjoA&oe=6ABD24E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Apex8-wHPJoQ7kNvwEJkyC2&_nc_oc=AdofCpctdqeMWnU81GkZ5OrvWkq3Xlpt7IA_l0cP9Nlo06jZbwTkOnCZ9Q17qS1RSww&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyl_T_pQxwLhQ644jQqtVdiKFmeNdBYXfjqN9Wg8RzPQ&oe=6ABD0B66"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
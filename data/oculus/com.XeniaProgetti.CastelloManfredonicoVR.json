4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_GB3INCqaMQ7kNvwEIjS4p&_nc_oc=AdqQ43UazJmJorL_X5l_OvLa8CUqOuQigYjvzd5fiHj6x0wPYmLu_1qGzUJAQGPHTgY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7Ln3NIzMWVVsTnoilB4Czc0i_KcI6n5GVX-xyYdOi1Q&oe=6A6DF653"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTBEfrWu7UAQ7kNvwEvMM8c&_nc_oc=Adr53mqZ7XDqBJ9Wx_BMxa8Dnr6benF9KTpC6A1WIAcWHBfBRQ6lzEFu6f0BNdUumUs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2FnLMJpm_Ux_9p5VCF225x8oLzgubfX_L2Beo628wAQ&oe=6A6DD2A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hK5ckNFe_hYQ7kNvwHGdkWN&_nc_oc=AdoJuuEqUvViiM77xtuWYR6HEai71q66AbkRD0sKVkMVgJMzwHIT1_3CdferREui7aE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGjJprahV81idguzKwvLRTyt7Tp4xLzKYPdDOELOT6dQ&oe=6A6DF166"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
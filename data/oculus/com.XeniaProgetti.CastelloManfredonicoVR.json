4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXT1zj2P8bYQ7kNvwH5SEa1&_nc_oc=AdpH9n-0XagKvhSeiGo3eHmGjmiNXN_Nr5SwCuPylu6d02-V8bbzG5DNZPbYhRgTRaI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFuIUY88rb4jTBGTrA-nybUBkOh5i7q6l0lZ7cj4xSaA&oe=6A806B53"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-PYaiY6MLcQ7kNvwE8dWt6&_nc_oc=AdoHKtJvglM4nDA-XqZxZ8nDsMLl9_c1nmxzPQuKzsCz-bWCYhTIt-QslWdUzUCQ4mE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVfD0joRum9wYgG0bo8bM_Ey3BG4RDk1E5vW9FawbCQg&oe=6A8047A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJ8vEVnS9EAQ7kNvwGL2AHE&_nc_oc=Adqcb41oKWAytj7CX6JvrE4VWXF79Y521AnYOA-5zBI0pCzyuST_JAWPuzA-3lazjxs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSbLAF39JT8kOuuBg3tGSJ0nUtpROREZEsnId8mnwuxA&oe=6A806666"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
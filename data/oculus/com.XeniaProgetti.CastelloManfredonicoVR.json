4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NC_hJlGVj5cQ7kNvwEFeYHQ&_nc_oc=AdrL5NEKCfKaBlP9VL3Ho5IKcVL8Un06ErJBg7iC4urwn4vQN4HNEyVdpJ1A1BibK-s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoHED8dZsHqBDbm7x-EkM7VF-E0zgZlSW76bXV9_S0vA&oe=6A50F553"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XX3u5JtUykAQ7kNvwFA6nxu&_nc_oc=AdqG_bCCZJ2fEb8AIU4NfQAv8JpBO7vCQijAvA2UUpULySXjBAmsWOany_RJNS7sSqk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvQkgLmkSKaSvC2Lfay3iBWijUhcgQR7CSMP2b-uU4ig&oe=6A5109E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4OZAOHejp8Q7kNvwGysWft&_nc_oc=Adr5ig1txw2_xz3gitcQuaNrQJPASoHxxscAXT7kKmlkvOm5EMjm4Z_hTovnFpgcLKw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZJKB9fEKJvyGu6fshclydADYSzTEy0l4CxR1S1BfOig&oe=6A50F066"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
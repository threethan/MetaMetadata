4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7DN6iqkOkwQ7kNvwGTtzzi&_nc_oc=Adqemih-AXbtEqjOqGJYFh_QwHvM_Swzef02_YvUlLPTINPBLhFVez1rZOlO9MlLoVA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34TzJNXA9MkfnyOQ4k7mL2nwfcT7h6CiuofoeRoVvJpA&oe=69D8FCD3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IZQafFozKsQ7kNvwGl__a5&_nc_oc=AdrWIyD5k2MZYKEyg5B3XvG1lD6kWI7xcVmaSPfy-WAEw3HjHb8VP9ztDZrDws2NDvE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xKsGHbiyEWUTS1bj_ymteH7OZDhVwxr1B_4Gs8fY16A&oe=69D8D924"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTw_dyrKFjcQ7kNvwGN8yMN&_nc_oc=AdqVXO8m8E7HhlX6VsnOZxBKRg9VEzLQVDBozYOlFnkJBDlHYt-SZACCKWbCK7e6Uyc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JnS629_DKdTIUpOAO6EEJBj8qiGezHFVuxH3KGnoOGg&oe=69D8F7E6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
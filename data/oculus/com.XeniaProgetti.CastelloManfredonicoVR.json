4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvtDmanMSgQQ7kNvwFz1Sxg&_nc_oc=AdpN96PYBlY_quiP1f5kn6yD8IKwwmTrAKGkCx_jxjCv-00docLrQ1EN1_GXQtWcBiY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DYH2P85Y_BtSSP3dDELWwaxA5qzfZo1Xa4MlsCdjkiw&oe=69E0E5D3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXIVSSYfnDgQ7kNvwFxtnvQ&_nc_oc=Ado_5xzIwa620dDC9doeDhj429VvTd-ttUOxbwRtlUVNPMBFz221_z_ApM89HMNbUlM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ED0MPj3nRh68m3jA3x9cmabvzKUxtEveRmqeHybdMnw&oe=69E0FA64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBASFeiqpzsQ7kNvwFkbcjo&_nc_oc=AdrWVgNCIhAX_3pwJsEU2oo6d-6sxiBH92dpzF1U1Zbc9CZAS7bTPde57iGONG_vns0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23t64jOaQCBU678tyKXzupXTq_fkWLWNCzlHHXg4HmXA&oe=69E0E0E6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
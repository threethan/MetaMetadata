838143604_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TS4DFfkXy3oQ7kNvwFrPzyB&_nc_oc=AdokLfTvWy3CIKFhmph5Xv59mrc6Gi45vXt8XFbythTPYV5ZcD3o2R9togC9c2StP8U&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zHRtxZ35vW6Pa-YFUDxCM6D7wFgU-W5CUZx75D34WUA&oe=6A466953"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpsF0fJvLmUQ7kNvwEyHWl8&_nc_oc=AdoEwotRJJR9CLXQ5EcXTpLHWgRUaHoCxXr2REG9WrppNCcAHbN4IA8GCaD9dBaNfj0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Da3gB_bXMVkV26Bm5gVoYaIR5LjftIW6w4kUkHoacog&oe=6A467DE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxQ5UWUG5w8Q7kNvwGFwekh&_nc_oc=AdoVoI2oHC9zJiRYeY5QYo-YhAc_Vca6KG7isfjRcYNof-IpnwVBVlLC0-AF3Qct3o4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AHV9iN0UM36hsJAq5OO9u4K1WUSgCup4uRfghOXRNrA&oe=6A466466"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLascia
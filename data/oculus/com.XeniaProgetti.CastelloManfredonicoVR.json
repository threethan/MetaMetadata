4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UCe7w3ScCAQ7kNvwHeSMRW&_nc_oc=AdrT4VWqMZuwuSyl282yzhy9b6PYaI0B56SIli7dP1ke_X_GFhGnPOJCRNxEAjWuBCY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oDtLpEZpF91IyhJYkmqdXEACBUGpUxkILJcX_mebZdA&oe=69D3B6D3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOxehAbRcv4Q7kNvwGPeTtz&_nc_oc=AdpS5BfyGMpujHASepw3TkvR6IW7sX7voCJ7VnSXfLebaHsif03DLj0YnlvYGoznugY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IJezHaHPbXHINfhERNu5xhh-ZuHt1JMUNOEos1EFTxQ&oe=69D39324"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1y-3imAU1dYQ7kNvwE7YTN8&_nc_oc=AdrAKXdB22ASXz-Gqw0MTLpeaDnJ2CKrEReI-lfR9MpsHrNyrffXf5jG1148hP3KnE0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-cuwpulVlwvxNWCW_Rt3M9EjxqFYxkyUsPKVxy0QICQ&oe=69D3B1E6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
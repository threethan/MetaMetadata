4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TS4DFfkXy3oQ7kNvwHsfQZ0&_nc_oc=AdrgbD5wCkC_POA55dNsTi_m5ioRpTlu6ubgnELuRpdQftQNofExAUEpXS51cnJ1Pz4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98a9kUpLU32D0n-DKOYR9DAvjLof-3jOWs69FaWjHsLg&oe=6A47BAD3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpsF0fJvLmUQ7kNvwGh6b-p&_nc_oc=AdoVh-ysMGz1Eb22z0UVJvBqW6LpEQDDJ7Eq127qYz-JY3IImQhMSChqZ6BZjOIqVDU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qxdX_PjrXKTwcH9TAhcDUHGCP5jp-YjbiWl-1QP26_Q&oe=6A47CF64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxQ5UWUG5w8Q7kNvwGu3bHm&_nc_oc=Adr6Og_DHlwfpkBjgXWvQyxvtQ3jzWMnrLjrQeEqzF4Dvr1cJhCkt9SNRUDFC4cqoHQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Xb0xDclXeBz5Oa1VqMD9OLucgNoI7d7snbu0b3akCyA&oe=6A47B5E6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbKoC29P6eEQ7kNvwFZTp_e&_nc_oc=AdpbMIUgfMqeYW4WAf3ug8QeqwlCktfiLJhQJF4W8I5jGL1Huk3xWP8gVNXuOAZDWNc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jPBTk_-LxGmrztErPv4WQ_k4L39QZ3yPAeirdq4AS9Q&oe=6A0B15D3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYyC0QlGsA0Q7kNvwHefNWk&_nc_oc=Adqe8oUAu_HqYGhmfAUD2rLzER_UDREAubOBlI0tcWRbPJWe2PfEiiS_Sfeb8PxRiZc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_5UPWJ-Fh-sxd_qlyIJE2tRatg7ybwM0KKtdW2hW72Q&oe=6A0B2A64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFyGcOOnAZwQ7kNvwFhOpjw&_nc_oc=AdrP83JlPmNtkcnWBoVFuvS0ufOMb5T-Y-f_P84Z4Z2xsG_Fn3LuUkja22acWuz9omc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7T1UUwORB65jQvg6dVqSCGh2LrQXdqAyvcqAWLGPieKQ&oe=6A0B10E6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
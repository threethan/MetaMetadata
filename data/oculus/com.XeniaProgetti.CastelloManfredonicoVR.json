4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDzriHR0zRMQ7kNvwEzysUA&_nc_oc=AdoPKWQzuWGQmfH7k49rCeOrr3kk2Rl2QSPSiUUbF0BeS43Bw7UN5uEUYwAgP6ADoDg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QB2tYn4EE2mCF6AmDhZ2Jpo7ulHs3CQFk4641wjsnsA&oe=69FB43D3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PfiKh_OYz4wQ7kNvwHDFujG&_nc_oc=AdpGxrb5C_58VurfWMoee9rirBjrzcDRoIsVOBk9nHhlukt6S0cESs2ul_4x4aq8XS8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pc9a9cWX_7tWjLVr-OBknsngA-52sqX1-dJmdiBgw5g&oe=69FB5864"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8jErZ1jUBEQ7kNvwHaprtx&_nc_oc=AdrOd6Tm8WMck0668kzsqVUy-O2x5jeBE7JZkhKXNxHr3EVd6xtWNbdzxFQqCEO31Zs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6imTRJJqLUtERse2KFwFlXCFhgof_dbUaBeKiAnUUxFw&oe=69FB3EE6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
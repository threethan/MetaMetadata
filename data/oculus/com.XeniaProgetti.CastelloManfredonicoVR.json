4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oHUvW73shMQ7kNvwEy0yLn&_nc_oc=AdrKlN5moqtqw2sr5-hvCzZ1L_1lcPCkzxe9X8XoHPg_fUsqMG_Z9xdvptjAGi9lCnE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jTTg_KGuDTcqKsDOx25l5M40gMgHekbZbyCc0d33n5w&oe=6A3E8053"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zzx5J-HfXfYQ7kNvwEBg_UW&_nc_oc=AdpR0uDTewbSqPJctjevEj4c6BJ62dAhNQHMB3nvsMyWYvi9BncxoB5JQ6dcZLNMhVw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZWxTNn2ObWC2O52I74QnDKwZSXjnNylA-5VnRCKGgjw&oe=6A3E94E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DijHjzl3u8Q7kNvwHt-RLc&_nc_oc=AdoJ336q8ktibIxMbnmHwwHwUebbx-vPm8bH7KZLFUwAPbV_-ziC0hnAeYF7SkT4DBY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_57a3vE3NZTzYnHciIx3CF5VTTZinohfmqv0svrUNpIA&oe=6A3E7B66"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
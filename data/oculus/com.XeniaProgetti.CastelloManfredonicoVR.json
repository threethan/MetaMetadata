4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qo-r5HL9r8AQ7kNvwF8dErq&_nc_oc=AdrElmEWvdnkrdqSyTdFxVwjPxQjv_WkLuJIfbdWUVqWRk43LPwrqO0AJXofa08BsHc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tlmY2efBRUDAbuezNMQp7fDQZ4Qj1uojVaF-TtKC90g&oe=69E77D53"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYs9hpTHy6AQ7kNvwEI0Cbm&_nc_oc=Adoog0QYgDV42ju3aaobIEg70R14ivo0fk1WAbWHIFZGD_xaWGInNdvXPf75sgKkeBc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-8VNH86c5bTlO1400lqOSGx4YhKtT8oVlc4BFftAntA&oe=69E791E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgcZ0ybmqGQQ7kNvwEdcErY&_nc_oc=Adp74GdWV-li2trHCHrJaqyxv9y1Ph0FqAEuXhvSnog6WXUJDAYaW33YjXcUcAatd_w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nTc6KRrtOCpgIiGld92oigvkW_AhNCexRaOTNaG8cGQ&oe=69E77866"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
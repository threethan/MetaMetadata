4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziYkenuFe4AQ7kNvwE2WbXx&_nc_oc=AdrGnPXLO0mCKXns579cAmwzE9R0okCWS8__sLbyfXMjWNmQuRglGp8ZDMln882t2ak&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGejXDP2H_WZqCTZ9pKv48N6gIhQeKpbY4u4xf3Ytckag&oe=6A7730D3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMEHxatsnf4Q7kNvwEoWTVA&_nc_oc=Adq5R1z5VYsWTmLn8J8pUNk_I4XR47-0tYiYlqStd2naNjdRgKHPXYEEV_omcD2zm0o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXOYeUlDe1K-KJmyWIhxGZKrtaJb-ban9ypzEQq5UNRg&oe=6A770D24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PyIlL8AmU4IQ7kNvwEw9UYt&_nc_oc=AdpbLQiNt3TQDgHuhOokxarLzRaSzSxs-KntIDmJzMMdTBRwa-REC33dt2DhoOeOWRw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQ0r19a_ZXbRHc3F3HB-M_odpyrHYhmijvCkyjSP7png&oe=6A772BE6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
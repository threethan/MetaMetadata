4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkoP10P2qUsQ7kNvwHH3fVX&_nc_oc=AdoGhIcPI9jHKWmTV4NHKrBkFKm-ZJMLaZaajHtKM6hBkMRgqmTXBKfwDhg1BYZtAVU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyMQ_KV3mobAfTGyKjvMCJMgQuPhunsgVdrB-IAOtpLdQ&oe=69C53653"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuQrP6QA4n8Q7kNvwFcUIHX&_nc_oc=AdrVBv3cVni13c6E5MDF8aZiyzbpA3QwWVrIF_jHQx6E6Btuxf9VBm582cnQr10Syvg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8Z3Gi_ETU1dOyI-Z7i9Kfo9T5Bd0hCRrcVmuC8AK9gw&oe=69C512A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lXna64wTUsQ7kNvwH3BvjM&_nc_oc=Adps4ftYQSuMs3GlDnGMt-Tr4rZuq47u2p8wp0WqGIVATQXTrg5lwABkE3c55IQGLRI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwfohNW88mZeETve3UJoFAgfNN7FvN71YmHncxeSoh1fg&oe=69C53166"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LaETBayM5lkQ7kNvwEPp4La&_nc_oc=Adrzz3g_5lg4HB6yRqkVoHCtND3CJ09CIaef-fmi4SXr4BZq9cETRkKsxoj36stiylk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqDCnhB4PiJMEWxLFaqfl2E6XJjtJz7gPY7kJ9Ducmfw&oe=6A6218D3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rG7xzOLfqYQ7kNvwH4MfUr&_nc_oc=AdqVB8JhAHVBcegTLC22XsDWlU46MeGtxWqkbOqdQZod9NghqBfw1_orJlbzOjTHPpk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYexFtijfly6qI2bZBIQW7eEgPMlFOauTo4ZUFx_GmTA&oe=6A622D64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZnlRvhHzwwsQ7kNvwHdSzxK&_nc_oc=Adpc_kiGVkf00IF0MreFC2Pszv77IasLyu7lZbqitatnNtMYfiO-qdNVXr3zOHxmpVo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSxugwdZMoSTWzfs-gLG8Lw-VVrkIp0OtTD5DGUX-b3w&oe=6A6213E6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLf-p0CBL4gQ7kNvwHkgIFL&_nc_oc=AdpR0oxRroGXa_Itk89HcsJm2gqS5_aO4us0qcSKDsuAJzCSwX0nlmpmoktyJQBH7H0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPU2E7XzjESVYoLQJ5XK9HGaofdBAJJUAi2Xinty8CXmg&oe=6ABFB353"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mALNB4NaUR8Q7kNvwHpLC36&_nc_oc=Adrof3mE1aw4mj4HyAiPFu_5-cpd0CSfJ0PadHW8xTP6x0sDx9TMouTfmCMeGnoTHDk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcKr6gx2qrPlNHxCbvme-Hs3Mg6FdNx06yfH8ZsY4bPA&oe=6ABFC7E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Apex8-wHPJoQ7kNvwFQRvSd&_nc_oc=AdrKY6DsMgBxEEc7FmoQ6SZZMWYLibE5SKPCzTK9Hv9JnAye9kbbqZhrg1kqjZzqIc4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4lQf3yQvKG8ALTRhH3cs_Qi1wrHRrCodbbn-dA0hflA&oe=6ABFAE66"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guidare in questo fantastico tour che ti porter\u00e0 a scoprire la bellezza e la storia di uno tra i Castelli pi\u00f9 belli del panorama artistico-culturale siciliano."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dlab-sicilia.it/it/politica-sulla-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Xenia Progetti Srl", "support_website_url": null, "website_url": "https://www.3dlab-sicilia.it/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "342510191276102"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5976960472400848", "version": "0.3"}, "id": "5695037603859591", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4837552849674955", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5976960472400848"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "5695037603859591"}]}, "change_log": null, "created_date": 1681999763, "id": "5976960472400848", "version": "0.3
4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsC4VhpHrLUQ7kNvwFgDY_C&_nc_oc=Adqc_cinhuNo24zCm7rBDRnTl5kg_gQ9YiMsx8DI73-s-Rc5t-x_BSEEWVxxs1NIU1U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwBpLlnXlWlXF-5gdsM1faML-wWShlJuzAwdoVbAxuVnA&oe=69CE70D3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zMYFtE_X6YQ7kNvwEqa3Fz&_nc_oc=AdrX8QAbXM1pgGG5ovG362pbVJJx7c4b_EJZyrGATYSpW-Q-MWp4nYEMKrkngHRfKLM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxrPyoqJo75Qp-m2S8eqM7Pr-oEKVE05mMzOZ3khWC5NQ&oe=69CE4D24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vokZj068KcUQ7kNvwFznM_x&_nc_oc=Ado9Cw4FTbdhZ5ule_6SDTiQXUXml4d_W4KchGvdK3ZU8wHfx7ZWpbMAxF_7zmqyxWA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyzAVoxsF7N4X5s2BVwoTm51lBH7uaPStYYAvS4HWeicQ&oe=69CE6BE6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
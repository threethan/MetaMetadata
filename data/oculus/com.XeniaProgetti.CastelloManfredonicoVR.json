4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gT-i_E3h1AQ7kNvwFA4qCa&_nc_oc=AdrCK5kKpv2H-M3zCKL1401_1BApG7UA-hPdUdvFxbPg1Wu_rrjG4aKlxlp7sgl4QGA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNif8qP2jIiaav7MsojJRe_a98ocyFuT3jwYQDcgXcvHQ&oe=6AE34BD3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFZhV9mf3CAQ7kNvwHTz_eK&_nc_oc=Adr-bl1c8fa_2qtcuYvyJ31o6reCI3kwoQm9PKuSzVL9K4JddD_IEUezcLpPwcyY9U0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4sraTikMOTdAvezDRlG7-q4XMk2C1oFysTrZn6Xf-Tg&oe=6AE36064"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84TaqUzfSTMQ7kNvwHv6udW&_nc_oc=AdoOOWbSwkvrZnt61Q0NBG5rJ3iCLXSDsoRjNxwA1u8Ud9ZfNhN9DV41i2gBMGXVyJk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmy7RFaKDMY6gLXEeTr9Gwk6X7s7znRXTWi5lUNzU3rQ&oe=6AE346E6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
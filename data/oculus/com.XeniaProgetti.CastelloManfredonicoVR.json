4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xnztk7Huif4Q7kNvwH0oYOj&_nc_oc=AdrviPi4rS-IIIiZrEWpL8_l-T9dBqZq6jjOfnZWD8ExsAdoZTNam2k1K4ZRb-GayC4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRr5MDV_PcbygnN8e0yS_7FomqC8KZndDHcWiB2tErctg&oe=6AF0B313"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2kW3hBznYYQ7kNvwFrqZU_&_nc_oc=AdpOeH8SmbCyJttMcyorKZpfzGYUKeT8YMs5myArrhpehZSUHbbX9D-kJyUdKjjVZL8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6X9iOzP4dExHno_f20MHLDrZKsPHvTP4K8i15B5vYsQ&oe=6AF08F64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jNFV8zVyN8Q7kNvwE-3guY&_nc_oc=AdrSNVlW_d5YwZxp3dt_4Wsumk5h6ulBsiXZsTkswCZxUyUv-UOvsdKxqMg2FWje8Pw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSj8J5YL1fGK8nUvRq0QpAm6gJ8wp1I39Mt_GfKsGt-Tg&oe=6AF0AE26"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G38XG5BNh2cQ7kNvwGcOMXq&_nc_oc=Adq227HSa-cl1LnM1HPO8WfzaGoCF3uSonoWxZiKMEdMrpG730MPsdMp3UFGmtpOCOc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKh9fBeK_6GqhhQeYiOesEVyAm6QA527QxlVnOSSSBwOg&oe=6AB28453"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=os18-E00-_MQ7kNvwHPByTu&_nc_oc=AdrOh_HCkrV452gaGILMvNVCq_cLX5_oEiEr_o_XAR2X928mvEska0JAdYbkk9Fd3Yw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7nHdkrmBSGbAKV6bEHUGk8VF-HyzbSmRdVRHNDA5P1Q&oe=6AB298E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4IUGuu25y0Q7kNvwF7xYr3&_nc_oc=AdrYCcFQB7pO_0cLCEZpCLLTdjfUlmDg3o4kr7gjqPprZCK8lc9JXYb___morsVJMlM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK80WCHf-H1LGA8siB33KK2AZhm7z4Ip9dk7RqP2DdA0Q&oe=6AB27F66"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
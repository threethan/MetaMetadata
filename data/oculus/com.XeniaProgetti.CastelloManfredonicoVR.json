4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBXiYtTDFzoQ7kNvwEBXi1r&_nc_oc=AdplZSmzJUq7bx-Y6KwLGu93t63lB0tjk9fAHOuqwahwOkgD06FM3NZLoCuelCTBk9Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAQ_RG26iuM2EUhvyiEIDQFor-f35u4p826U6ZfglN8g&oe=6AC79C53"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8y81LMA6pwQ7kNvwEcS8qh&_nc_oc=AdqaNIhZ3pm5YfFHdh03hUZbcHVUVqH3bi0GP8XdwoZIZPc8WvFblmUgqm0xYTGqN1s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPc6geEVC-I7krhQcbLhVU6_PBZGlYd3hvOuGXgQHT6XA&oe=6AC7B0E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKDhKfh4w2cQ7kNvwFtmQMP&_nc_oc=Ado0HN5pNCna0AxcLiN1uXYnlYcpVd3U_pwuS1KQN0jiDOABPGfs9rI2ftU8h0tbiVU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRcsDac2ptWMp_EbSzd79UfUs51PL5UubMA8dS41uuEA&oe=6AC79766"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
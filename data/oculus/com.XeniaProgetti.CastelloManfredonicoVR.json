4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLnmYDlEKPYQ7kNvwFc-joi&_nc_oc=Adp3JWw1dqJFftLA7Wnpkcj4SW3zCG5VtbTF7DO_5izTN6XWCYkXuvOoZCE5onBLCCI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QV0JGr-Mb5Lg1dj7YmbBcByh5wtp4B1QTuRVqFsERAw&oe=69E62BD3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkCvRjsgoiAQ7kNvwHH9qJ2&_nc_oc=AdpjPgr1CL4jovHtZYsnGJZaIBQzPYkYpAez0bDfb7mFgJxoMIF3zSYpVCtss-WNl7I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11lpFHAINZOuLmdSqgBh9s5Hj3Dpz9DIePk7vIrCu5Hg&oe=69E64064"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgcZ0ybmqGQQ7kNvwHUDOWn&_nc_oc=AdrG2WbvhA-jhEXzqfxQ39UXrKKWKeQ5_E5-z4QoEawuLKHqDqBA4gDeHK_D89lqHQQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CBSJe0JmHhFOij2GUQOxbTUjqi_cAfeceHou2Fenh_w&oe=69E626E6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
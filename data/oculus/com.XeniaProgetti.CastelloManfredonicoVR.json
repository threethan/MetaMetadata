4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pws5XiGmQ_AQ7kNvwFMYN-u&_nc_oc=Adp3tCDxhFIfoa9L4WBJeLYv-zIKZx65TcR5HIKQ-xvWbVpJlf0eTX2J511RMFs4TN0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2XEGvRG2SdeSCKdBBON4pzn9MY_IugrgepRu4OW1_2w&oe=6AA55553"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZ6agvsDbnMQ7kNvwHlCYUr&_nc_oc=AdrKG_UMSua_C0xKTDRF56zP6CwIlYYSiWo5oV7VfqzHkbu4_XpjMSK_Yn9DkjbZvTA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINN1ZWfnPgXAgb2LpeN0UpABiGt5HpMB3bTIDaOPYLRQ&oe=6AA569E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FadF-OHEqnUQ7kNvwEzghz9&_nc_oc=Ado4d31bZhBAcCvcvz1CVAIDhpnSejX1WPT2_Z_b1xxOXVZmhhFEteGYUj-1hssXkgI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAMeo4PqS6NwFYuV0YtlrCPzRHbUk9A5w_6w4c4pG6kg&oe=6AA55066"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
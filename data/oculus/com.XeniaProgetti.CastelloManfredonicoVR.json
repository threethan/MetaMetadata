4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rCGZpMva2kQ7kNvwHSOEa-&_nc_oc=Ado5R7hUJAmXsv1dncBSR_LeANmLmqosebUWt_LEOp5b5SLtTgcdOf_rTGSMeCJhqiI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zIIFSZknUk7b-OZUC1kZoy4oN7-LMNR6I6VRyAqLK2g&oe=6A199653"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ey6BBHjoMl0Q7kNvwGrn2ln&_nc_oc=AdoD5RdF6qWih9rg5dkFt3uEjbwO8GgVW4m9fGlu77O9qKt-J224ToN4DLo-i1ZJJR0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Vq6VOB-wgYk_WszjijfSNaYQbjLhdyoWBu6Kwzx8dxA&oe=6A19AAE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaEhQQhaDA4Q7kNvwGa9Y9K&_nc_oc=AdrTFv3hEpndcNxpjIgvPhqcmzK8IBl7MCBmq6d2x5TKcTqtl6PsiJNSJwaH3v0a2oo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pLAUJa9IM69yBHVH-D0PI9YrYpPvvQ3dvw0nb1y4GBA&oe=6A199166"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLnmYDlEKPYQ7kNvwGIAUla&_nc_oc=AdpT3T_cLzVOY7AV2YLws1Asr50XYVUnzNHTskfsP0lSdYjrWGEOUs7zaasPvuWg8oM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af044q99Su3GQ4MxnVqH4pZ_dJ-0mC1N0s8vn8RZLLH-IA&oe=69E4DA53"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkCvRjsgoiAQ7kNvwHd04zk&_nc_oc=AdpWT70VgJNur9XSofTYyet17r5K1ylMLb_QUgeMW30wWSi5z4uW7I-OjjVub5bGCDA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LhJJslgiGgoUor-RyMflctWi0x_Tw3YbykBwO6mNgIw&oe=69E4B6A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgcZ0ybmqGQQ7kNvwE9dIuS&_nc_oc=Ado3LWZiPeN9EDWYRazgz3iPVgHGnY1WK014vO0R0zM_MbrtvzsSDZJWgN_I--9v9JM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oIv9JCaIpIzmuTRn-MnruIWfPNBGv_5w18uWfUkvy6Q&oe=69E4D566"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
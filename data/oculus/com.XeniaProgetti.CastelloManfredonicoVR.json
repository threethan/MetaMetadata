4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONKhWBwuLY0Q7kNvwF35b0m&_nc_oc=AdqfT8d35HmKMm9sOrPu0XLR-9bomGwbkEPhNIE_em_q8mbZ47EV413ngZnDlAtyT_o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sNBYNVFhVPEKvDZS5Mlq76velCIr5ZFu1HSpISQW8CA&oe=6A2EAE53"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWg0qc2se_sQ7kNvwHZSZKQ&_nc_oc=AdprSXZxqdjw4SJOvZBNlaE0Sf0DQRYtbX_P25eSxgniKc-oAeDlyeKqS1XsAllUXnY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0s0umK_nLDSr7BUO9IPLb8up_zLjoyikavlvLEk4NWQ&oe=6A2EC2E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_sW0KewqAcQ7kNvwGe9mxw&_nc_oc=Adr6F8eEl-DyKOid24RstFkuLSvLGOBsfoHRzryIgttFNvGk4A0LDQBaJlRDNb6g7Xo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_l8JT-kcX8yaga7iAH2SYFLuTxHxlQmij84rf7pHQumA&oe=6A2EA966"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
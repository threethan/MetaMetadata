4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8j396OBwPqQQ7kNvwGj99HV&_nc_oc=AdrbUWAHBu73BQ1Z4DhB2wYdfaIkX02brK_3S16L10aKtbb6McrQgIukF-9BqB1gj_s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7noVNShy5kEIRI7-uho3-pUC5panDtxycFOFXyW8GSQ&oe=6A985E93"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZUcXSjIshoQ7kNvwGZ0MlT&_nc_oc=AdogseuBaKNU9s5XoBbeZ3fuP4BW3OltAPvwopUtAkVdVd9yzLXTniCpL4Qtts4Guqg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVUofS2PmqAKGMfR0fA-pIarScKRDy7wO0ZmY1o0lGHw&oe=6A983AE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcYKuEi_xXcQ7kNvwEI_z7M&_nc_oc=AdoBm1UC0fP2GBRbm74SitnOWwoq-OcMtg8_qv1qBrqOBor-OGKZqMZicuaYECw41GM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzPoOjvAslLl1KTQKydtvJSTkrAvlFolwhpuZ6aBhkwA&oe=6A9859A6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
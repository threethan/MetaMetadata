4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9S0r0ZiCImAQ7kNvwErRRZh&_nc_oc=Adpzh_SQe16WsuK-Sr_QYBswkSYULFykmywr0ivn-Vh3JAlcvQTxrS5cKL4B1ypeF9o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO19Ne_3mjve68TyDK37GLAgQVt66L2bsQ4veYKuFncpQ&oe=6ACF8553"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ot4_Xl7has8Q7kNvwEyWbgn&_nc_oc=AdojtZ0l_QK4qk8O0EmET4H3_7R3vXhHvW_19u_NSP96XGyf0IqvcO9fz2nvZB8nyfE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFzKKMX1xH7xsdSpS4Y37fjpCgjYi2HV1hKsFYAQbqfQ&oe=6ACF99E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dk0vAChpATcQ7kNvwHPT7Jl&_nc_oc=AdoVYzcx_OoFiOPtw4LLg2vhfPks3DqefAsWJByosB0tRIlTlcjfin_yALBti8jmYV8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKGZjiaGVdKQo6HldceXPLkcptyhQtSfBYqToQSptVQQ&oe=6ACFB8A6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
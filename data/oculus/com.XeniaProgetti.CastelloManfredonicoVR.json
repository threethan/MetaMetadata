4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9S0r0ZiCImAQ7kNvwGN1X9w&_nc_oc=AdpCDR_s4QcVNA_hj3lB_A2rHl6_uHHG0y79dZe5DoNrOvqPUW0Nn2PK-vVYD-leyN4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtOAyKDPXtvoQaMAm45ebzLDO5MYkceXyStfmhXVBkSA&oe=6ACCE253"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ot4_Xl7has8Q7kNvwGAzqnR&_nc_oc=AdpoisMqZS72hUJ0v2MstOJvX7yoOAXex8TDV_GJcWN9ItMs3QQgEmMbgE1KzgAXRTc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPoQGrf98O8Ew3WLi4eNkIfd-WVaVZwoC5Q-yE6D4FBg&oe=6ACCF6E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dk0vAChpATcQ7kNvwHGAyec&_nc_oc=Adr3ojSHU6AN1l2Jl6qzFMhnuCkK-i0baQBeU0_0FBc1k_n6Z_ANtAXTXt1Ijj7X60s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcKgnGs-GZhwsHA46xeH1bD0P5VfAmYF78nGvI75ygfA&oe=6ACD15A6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
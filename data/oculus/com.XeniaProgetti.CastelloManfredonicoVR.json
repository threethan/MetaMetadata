4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESHusPFATL0Q7kNvwFcfCID&_nc_oc=Adoe2V5coIP3qylQbl9OdLaOiGn3ysBe9ZNARP6XIi8bFUo8uiApnWAsOBOM-Uej1Ys&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Cne07k0cKUum-OfgnQ9UDZdTIg9BMUhbS1LQOAz6yjA&oe=69EE14D3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_U8R1Q6fJM4Q7kNvwGRQJOn&_nc_oc=AdrdE-sDzmWo00DQp9Fx7JK640bL6tqNKaYR8yQ0mdGw_erHyX7GckuXkV38bHT5hU8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1V0spBnSlb-V7hsX1TrHDqbQiNd0xp-zw23cOVl1-dIQ&oe=69EE2964"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7FGF8jsIEYQ7kNvwHxymcm&_nc_oc=AdruPACwd05gO0H8dIa3555IUOu0ccjGXBzpJ5WLJjkOciIA2rZvjESQiaftmR5S7wY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rZd-rcBNP40DLBgcciEpjzFfQwHqmHoq5C8-LcoyNeg&oe=69EE0FE6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OotwlIghr2MQ7kNvwGfTCgo&_nc_oc=Adrjc1_7QryHJeSY8wDeN3lvADnQwRyYRXLq5jYOyz_ZJfGyhQp47h5blMcKgGDz9BU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1eP7Kjf86ISYHC0v1gA01b5Dl3MVqObLAUY3X3AWjHpg&oe=69F8A0D3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTzhgmL8ezYQ7kNvwG8uVpQ&_nc_oc=Ado1FXTf8m1VMpIqmFFFaCJN6lVJXiHynb64XYuodwFjucqgwsjMmoVoqd4XFqjOsyk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3D_kHrqz2khhO47T-hdDA245KKqipcVwjneqUjLjrgFQ&oe=69F8B564"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8jErZ1jUBEQ7kNvwGOxWHP&_nc_oc=AdoLJfrmLZqhjMTjwhJ9pkRG5zwK9nvj72TN6WCTvOnFJDK8Q0LOfi9zRsrqfIKb2XI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Z-vTQ-NwCFkWTeBJnoat75UAaQxSxW5XSdBZ_6ef9tw&oe=69F89BE6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
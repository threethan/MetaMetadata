4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRBQbkfWMNkQ7kNvwGgVFe7&_nc_oc=AdoJOHKoCRecr4POrT4HYvoJ-nu66Eqg468cVdo4PfAbAzuCMMxfGuZWwkqsTzN44YU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUQJ-DckqjxUAM7liPKdM8CQADOyg8ReOf2IBTPwdwQg&oe=6A4A5DD3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJt8fyY-dT0Q7kNvwFytNzE&_nc_oc=AdptH8HxiLqVejOxX7gceXARHjIwqAdlE4mWr_iC2r1mak9dDW9h-kBvwI093KNtIYw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAVbGA4NsgEWqqOaZSnZTGhK2b1FrBbmiCTqNopssmXA&oe=6A4A7264"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pr9lG5uBpBsQ7kNvwFZ9T41&_nc_oc=AdrIWqgPRFS1paTWZDWMOfAEB3OVCo8ezQcyUSMShEvK-IduPuz1LNnGzAAwNUi2Aos&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_jKI-0MAiThzFA5CFK5J5Gnfwi1i134GToR5-KAqtEQ&oe=6A4A58E6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkoP10P2qUsQ7kNvwGuvNYw&_nc_oc=Adr1YvF_vJTmtKH5CX-kTO50pHLxNBg2oYlFo336NAjO8k-z8ngXVv3tnof82uerzBs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyiHpvFieWr7eYIBNri7VyWTbmK2c87kh-57pxC6icchg&oe=69C687D3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuQrP6QA4n8Q7kNvwGUN_vs&_nc_oc=AdqDOgONgKZrGUXO-4JQ1lZe1kCW5wAazwj4X3ZHgH_fXoGMwAA1Yq3Cf_nLGkLKsJc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxaUCLf0giqPmv5B1iqLJ3cdfvwp_dJYuipYxf_Pc8AWQ&oe=69C66424"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lXna64wTUsQ7kNvwHSJMcl&_nc_oc=AdrqAZ2B4_cm7DjHuIz1DYZnMRxScuz85OM9Si1E5tiGEloaTi9o-_6px7xPCWMCKS0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwgcJ84jyC6evklD4yBxagTkbXWuEw8VKcubyxFkq2Lhg&oe=69C682E6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
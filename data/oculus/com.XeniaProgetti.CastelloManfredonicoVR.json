838143604_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vg3v4gyoI4sQ7kNvwGBSy0l&_nc_oc=Adoy4ct6R_WpSkTO5v7koGTXVdFhL_iXzKOQe5u--LejuyxqoUSc7AwDPvA35Q0VV54&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeKAbFbINlypjtD_c3hxZGgjrmo7KvNXnQj0fyDqugrA&oe=6AAE8FD3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIQI2F90KTwQ7kNvwEj-tpv&_nc_oc=AdoBDv2xrkcXce1caw10knWm8X1OwGeGsqt1k2kj1ahek3DJEnG2wT-uNNW_gixUUIo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwTvL1Yj2vh1qy1LhL7_ucP8fy84PR1cUR-aX_ATaBJQ&oe=6AAEA464"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyNaa0m24N8Q7kNvwE_xzTn&_nc_oc=AdpRw870kbpgWlyrSUpvhg9BHUFKyqy_kk0n6YPaihaY72Elc_gXq2gLGI9n_iy_NQ4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIc_FOAJtqeGQbsfQ1I7137imd3_i8uGPAB-a-fAHUDNg&oe=6AAE8AE6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLascia
4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKwVs5a4LEUQ7kNvwHffiBc&_nc_oc=AdoETBGY7ztxLp5Ay0aCibUg7l2oXOwtxRqc4jrx93k5nmJerZFN7cQ0gwjjD8DJX8o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgTURTv7VB-D-VwzR9VwdF-upnVVyJawxf0ggDTjoQYA&oe=6A5CD2D3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBzxBvjYSIoQ7kNvwGL3aYG&_nc_oc=Adr7wdPr9v4CZW7a2TTw8preXdaw-InEUY9RYp5jkND7fgLbwNiyDMpyIBOhzfENMbI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHzpEOM0xKV6w1p1jP7iz01ydN2s6SMyLVxoE-wxvseg&oe=6A5CAF24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zY0HXcxKLgQ7kNvwHQ4Ujr&_nc_oc=AdpGO5Mj2Z8KkmxKsDWYaPhE9BPS8r9QU_RJkmHWgaVXs-lIB0wc3VL-NR6jeZRwYNM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIMd4Q-CabVJi0buErFWKlAeic9m8Kr58FtzLJe60BbA&oe=6A5CCDE6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
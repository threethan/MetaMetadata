4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkoP10P2qUsQ7kNvwF31Y2x&_nc_oc=AdqmzpurrtG5BGiqKl1bfOEhPhfNQCUgjHYJbApLSIwt44H-bRIINNSxgVjStGXBwQY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx-ViLGeYJVAqtkUWIbb6a2FlniLTr0Z2Wm0xabePdzDg&oe=69C3E4D3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuQrP6QA4n8Q7kNvwFWp9Mu&_nc_oc=AdpaYyhsHJOYeB-keB2dUz67sETuVKV46vZeOnDY7HHHebnWS7ypBiRnixEaUoSl244&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbGVe6kdagLhRoVnqk3gD07WgFwWflo2PFh2A9qD1YOA&oe=69C3C124"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBv3eKBS5CQQ7kNvwHbzSTs&_nc_oc=Adr0129eoR5PkUkzE7kPflEXOU9VilgNzC_GMIPLGa1IUEvGTeHRIp5a5sOEuGOBj5E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwSe9Bci1O9zWbKY-jOinLnP_IGxXEzC8KRyM9IlLXjEQ&oe=69C3DFE6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
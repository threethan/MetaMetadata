4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKApGzARj54Q7kNvwFbPxbP&_nc_oc=AdrCDJwXL2C81zVwWQXh9_vN6Xeh8h5GyxHAAIfTuxXfH6fyL-bqrIa9rwvE0hZYmds&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cwmqCR6AnlgQg8qa56Xd6vIzep-ah-d1krXzYB_qlGQ&oe=6A3545D3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrMUqYUAOwcQ7kNvwHH0YzL&_nc_oc=AdrEgxY0J4CH2r0Uoy5aa3H8P67OmNZYjZmHlxWk0VvuIyzSPuu_VvFkqjCjlywCnig&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_30otm7NSDi4eCRj1tF3CrrcrMcrCku5zR8W8gJ_Egbg&oe=6A355A64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzJYFDILVwgQ7kNvwHT1WJE&_nc_oc=AdqEjoTeKWcPM_U-LnNwof8cS40U1oSqbNDohClUkLHdX7HlrWTwOPR0XXpLogHu5tk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cuCfmtHDZn9ugMd_ilZi2YjKdM20jLFPS1_xeWkiS-w&oe=6A3540E6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
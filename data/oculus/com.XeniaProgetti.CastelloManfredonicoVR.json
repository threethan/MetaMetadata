4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xnztk7Huif4Q7kNvwHJLfEL&_nc_oc=AdpO0mXUozgEWi-G0lKPpoz5lOnoCTjkVX7IEcBLLGGu1JdwJnbI7vTKweqmyYIUd_c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTO3U_ueDcYTIMajRZkYJ1XgWL8Kduun3ACjE4UKy1zxQ&oe=6AF20493"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2kW3hBznYYQ7kNvwHRC1yK&_nc_oc=AdqioTItg7G1A94odEmcTEjtMBMhMfGg7ETYK5njejCgJurU6RyPK6xB3uN21GAeUtw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQquhFp-RBXChtIOf8c0QXMRk0UcpWelLy9W28qCoQZHQ&oe=6AF1E0E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jNFV8zVyN8Q7kNvwGmxnuX&_nc_oc=AdrDPXDWxpNxFHHq3E-N1UKySWsugO8ey_mpGnJcNEFt9jh1iytA9w-7r2QVUXrvTR4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRr6O5R1O8x7Dh7W2v14P8yF0WIRfvhKoEFmm5iyNoZTw&oe=6AF1FFA6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KBvrqlFoMgQ7kNvwFrHF4N&_nc_oc=AdpEIUDgnQZMUiT3VPkt4LGqyKhgbTp5jvbzO2yKgWwsnalK2Cy7gPdF5JQiQDYvBLI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8LK9__qvm9pi3R8t1V6hUC9iGzBBS1S0Me7YEr2jWXg&oe=6A660D53"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7yzPMBisxAQ7kNvwFmQT4G&_nc_oc=AdonxXqS6NxkS3VjOyu4ZQ8ZR1mzwoO_IaVmLlDtibiTCmjvzB9OK8LzS9QCb87V4Os&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6DZ_Bfy6L6REpt8dfjNSsO4lSPJAHds_YVjbu4d6Gyg&oe=6A6621E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GCyGqtwFXEQ7kNvwGzUP9H&_nc_oc=AdohaICtAjlAenHHUb5J6WNwRVaektNvw9Fe1klxTLtLSPuIKZJy28xStUA0-qpOFBc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4acsHmVoyk2XFURooncmL7nhlEA_Za_DqJ0Wak0U2Gw&oe=6A660866"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
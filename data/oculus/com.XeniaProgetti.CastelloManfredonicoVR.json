4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCSXJI4FK18Q7kNvwH0FuVG&_nc_oc=Adq5BdDxOqA3i_ydZVQ1kpjfm6Cca2K2h9Npr9vYgw-yIsRCj_G8p89FS_7DMVT5LZk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6k3UlIz9v7SKZPwREkFeRdbSwakbbqQS5aaLFr7k-bw&oe=6A60C753"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgZNuSq8Lj0Q7kNvwG0P1Uo&_nc_oc=AdqIDCVIByY3-pUTlxdC5NEK664z283ckSo46t84wXfuIeiWfmvOkyaKM-B5p4OSwNs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7DLIGmgW9Y5cTQblzeaHX5ZrrqWQaTyX5fXhr_C2b2Q&oe=6A60A3A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZnlRvhHzwwsQ7kNvwEHSpZV&_nc_oc=AdqcpC0hfVHRL1KChngxaTEJDH4QwZlJl342ycYdxqnAe2a9BQs0r6Ugg8G5uPRFMyg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUXZMVvrld6FuLeYRWWmBjWEdMmNHqqfwUhxIGrop-XQ&oe=6A60C266"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
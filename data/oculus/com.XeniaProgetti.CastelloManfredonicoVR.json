4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lksTqm5_zpsQ7kNvwF0O2qs&_nc_oc=AdpyzOqPWLzJbm3QtcfKm2LnapXK5geTHWH9rDhLWnP5LLX5bp-0fNcRhQpIgCFedFI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKsFiEaxvj_eikM3b_cOpq8SRVknua1PhSkxgZtrycaA&oe=6A81BCD3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApN07HtSbYkQ7kNvwGtWjgb&_nc_oc=AdqlHxdaTVxwdPZWghlDXC5xl_YEAztW96Qe8kMoOqfh6V9jTcigpUUqnBv6IkML4GA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcbiWSlyeh3-IS41y9Jutn-Dods2aoCXgxf-jpKQJ9YA&oe=6A819924"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJ8vEVnS9EAQ7kNvwHRyHIL&_nc_oc=Adpz7oXZXR79p6K4INaXPKoIRDh_y-0llNzxgmqEbQDmtr7DtWj3kS6moHAupfzRC-s&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGI7zC1ycNjHuIw-Azac6e-VoTFCAUsJ9Ol7xOD8MNSaA&oe=6A81B7E6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
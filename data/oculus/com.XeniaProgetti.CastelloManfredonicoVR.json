4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07Bq7Sc1aq8Q7kNvwGnV22r&_nc_oc=AdoMNRH4uPAKiiMs1dXC5xrEJrOz6UfkP6iwbKiJKnkf49VFohlIJ8CPlJzU_rI8Xgw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMI0-RYCQLfgttc9_MoCjsEC1Sv3mDE5E7hKIlvG42FvA&oe=6AC8EDD3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZ9A437uccIQ7kNvwFEfwZs&_nc_oc=AdqkOiTTjEcYgC8fmqVXt5kh1FVGR9ncx3vKUi8mOz3KKfWj4wNccHdHHnOJD0VfdeY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYxO0sJFGUiW6-R0PFcMNudR4jJ27cyRp6HaCHVsthJw&oe=6AC90264"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejsdoK7hDEAQ7kNvwEm4ACo&_nc_oc=AdpNeINhUv685fwhb_qPhMnLYnE4U-NhWUu2ge76juGBbYDCAQzURBAEyyuvQIdgtM0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQk-9APvCGZM5BAUhVZxRAcd62Ubqo9cSkvAYlfjB9ug&oe=6AC8E8E6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
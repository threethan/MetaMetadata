4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZUUAbs8tzcQ7kNvwFQSgwC&_nc_oc=Adr2WbkVZulZjwJUITLXzMwtjSKCaLzW5reIYSBVownBZ4oidij2kbtumCeIQzohG3A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtP0GaSoQ81uQYV-jil7zXDIgcRX_ZBA9l9keIJ9gkug&oe=6AF89C13"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eM0fxrGjOMsQ7kNvwEhpMtS&_nc_oc=AdpQjvBB3cq72Ta_Z3hedLyW8ewMavBZybfWo_BIG8GfVBdg8v-tBa-kpdl52U_FVhM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvhPj_BNLOzkWy_J6fTw9UbtFVcdMZuIGtc88_wrK1oA&oe=6AF87864"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srqYiKFlqpQQ7kNvwEDaYQW&_nc_oc=AdotaL7lMyBE2qpJQL-pkzudAydZmiAQFdflT_fPCktTY6P6JD4YetvksPLlFBroWE0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKGXKrmEpEsLMeZtnEiy8MzpB5nxfeZzdgRD6eI1uhBA&oe=6AF89726"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
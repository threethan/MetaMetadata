4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNoTHPbMZ4IQ7kNvwE3cZ3p&_nc_oc=AdoLLEGSzDDrT7qicua3f-wH71vUto1dgABbSJMB4gvW9w-QgFmR0VampN71lVPaV40&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEYczn7GN0NX8App4ge2On-dOSKvnuaH2pANgufxlGsg&oe=6AD22853"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OvDS95TMPcQ7kNvwGWcOct&_nc_oc=AdpIuwTeqPaXTLYvN_8aWo1bcddSabB7fD3OSzrWv00d2XQu1YKEFuy6R5w8-C88-Fg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNp78yOnHh8qbaOy1sjL7gylPQMWkzg-EQ3ltBGNEcWCw&oe=6AD23CE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXx7u9sjW9EQ7kNvwFHN1nM&_nc_oc=AdrBVEvckBUQhZERD8asDjE597ajoBVSrcCGRmY1Z4Cm6sIZTBx9Eo3nWEMK0BGiT4M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM639XKn5cwE3iuyBpBBg3ikF2jit8JW-zUfdu8XyTWDg&oe=6AD25BA6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXWfsgDi9sgQ7kNvwFwvF8D&_nc_oc=Adoo0x02Tu-tk8MVC77d-WOIY8phkPjoe5AKZt5LqmjEHVCBcrl-8MJPW2w27kfkmZ8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfynNZAj-BkMb6qtEvKJQFfziDL7sSeJw-wuzNXtL-Om5w&oe=69C7D953"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNSZAZ9r2yUQ7kNvwEfDA_u&_nc_oc=AdqwWYJKfidXv_xX6MYUvvGI5erg1Wi01PQ_Rd9_-_pWPB0sETlki1mG8SojGPkjv60&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzL5Tjywny9CTM3NB-yCvAGYbitkoKPtFE10Pi6-G8ifw&oe=69C7B5A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lXna64wTUsQ7kNvwFPuzhP&_nc_oc=AdozXSXQnX5uP4jd5NhtrGefPD8BBGO6UfK53XPMCpPF6f7V7y_IeohUv_ecNPsAhA8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyMaJ5T4w_c5AqBh03rwsufmuxxYe4_PQPSox-cg9Jldg&oe=69C7D466"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IYW1zvs6lb4Q7kNvwFfYjBM&_nc_oc=Adq94H0XgeeYr_fuUyQfDvD8PQDaAsWzW4-ptobd98oC5ZKbg-aUZsLmHA9ww6DKXA4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBl_kFnstdHhzo5UtVFpW2RJwyLi-H22OKwhsK3Yi4yDw&oe=6A6B5353"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LV580hgjnSoQ7kNvwHdYfom&_nc_oc=AdobOj6aCaWUGunEsUlJlpp_VeggBOBgZQfsFlx55LyNqBBO5WYQNL9SbWd2HzKGj7A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOXhx7pg0Rv9K3ajZp-fV1pA9hi4DUGRjZkWkLcicjwA&oe=6A6B67E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hK5ckNFe_hYQ7kNvwHJgCxC&_nc_oc=AdphNVojJZFsaXAoYs53WTP21yy7ZEpf_Weu9Gksvc2V6TyeLMXfxj2o1x0NdM4KSGo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgiFdke4Z0AoHiyF_CXMzmJaeDcTjDTUstjapw5YqfQQ&oe=6A6B4E66"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
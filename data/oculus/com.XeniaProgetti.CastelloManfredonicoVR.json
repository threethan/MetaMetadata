4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ep6AkI07SysQ7kNvwHC6t7G&_nc_oc=AdpknY2BgajTXsOEcutKS8RrAxX14i51no5dUbbUtXodq3lGkTKCdXBcMHnNv7zOaG0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvk_eZj7rS_1QCB8IcGN9nNXGY4XwLhND-kV5iVltwdw&oe=6A9977D3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y66xeqsoED4Q7kNvwFV56z_&_nc_oc=AdotrUpSV1ejzLczXVcfPFb-JgabJYNYIPYD6rpaoU8NhEFVKxj7BATl9lCE4cQw69I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVWPeYytghig43u1TXzU6LUKaJJYK1GNDpVbiuuJ6UNg&oe=6A998C64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXRbZVor7QMQ7kNvwE9vE_g&_nc_oc=AdoghSKoDsz6dapvOZQrnbVjdbsI6V_S6cFHeHSPBNFam-pgzvlW2ynQMaEOxfJXpWc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXZj3ijTA9CJT7-Gf-LVHGqcSZ5YKs0s0wDTsxN_kchQ&oe=6A9972E6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
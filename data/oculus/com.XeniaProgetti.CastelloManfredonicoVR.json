4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQZJY0YuVn0Q7kNvwGN73YP&_nc_oc=AdoaeEofQOq2YdBEj0tW96iiK7DEMXyiqaQmbDd9opRtLb5tlVBeMOGowlAwb9_nE9c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2f4R6N1wKmti5JYvcbCZdyEkvja5-rgHRbv3MdxM2_VQ&oe=69D26553"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTFhlXfHz5MQ7kNvwFCIe89&_nc_oc=AdpfZpQoIJFINgUuFxq-POpQiE7HNsZC0vkAWu12IMfSLCKcQWMpw5MzJ-TEWAQAv0E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VXQCMIYmbIrzj4Pt7LmbFNw5CScdtMB0-GjZA4ukPfQ&oe=69D279E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1y-3imAU1dYQ7kNvwFKkvBj&_nc_oc=Adox00FFpwRkZ75oUwCLCmc6fiL6VkpptnSKqxtDa9d0n74XVswsK5fr9lYzSAoeobQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HUhnDRbbPYVf4_m4_qvP0YlyhnNjQ8iIJgOXQBLfFKw&oe=69D26066"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
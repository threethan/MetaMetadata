4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHPDyp8rXs8Q7kNvwGZXWIs&_nc_oc=AdqEkITiN41xY9cDftMyYEq-lzHKg-kNUfiazJqHL8NdAQhjAe6QffLO2bsyDcY2cFw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IVG6GR242ZqWayU817r4BrdCjMaBwVZUNvTmcMS8B2Q&oe=6A3A8BD3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YoJbvR2wJNYQ7kNvwG6OsXv&_nc_oc=Adr-cXlGuuBHeadvZ5drRdtZ7rLnLNVpJp2QT_4Z0jUb9tffQDOKpuRCJOKFALXC9mE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8V9dJZO2JkKgpsZOgrQ332IhssStPw9lBuR9uj8KroYw&oe=6A3AA064"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZZpjKePNMkQ7kNvwE5OYu5&_nc_oc=AdrJDuZPY3BNw9oJ7_ThdBHzZ7ekQxijMaYUU8O3yn5qUlKJpTGDALvFYSKvTuvllgA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Z_FINW6iZqAEblNY66xeuQbDGXEFvD9zVFCJpDbk4Hg&oe=6A3A86E6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
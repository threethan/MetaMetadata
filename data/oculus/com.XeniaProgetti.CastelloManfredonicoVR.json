4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKwVs5a4LEUQ7kNvwELnVHf&_nc_oc=AdprbAJMZ9qtVP6G25P__8TNciOxV5aRAdsuIozfyzr9RS6dkBjVYh4efJean2uYmWo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZIBK9IR7yeP4rMjHbpseioqX-UuiBsYyVLyXpuTXD3A&oe=6A5B8153"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBzxBvjYSIoQ7kNvwH1LYgt&_nc_oc=AdpbXaim6jAJ2sl064liCPrJ8mpAcxA9tvJR0D8JyEHedb2S6JAGYJa7GR_8u8fzV8E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCp-uSBPg5mSYdFTewXJanSi4wZTf2gYn9WVs24wsirA&oe=6A5B5DA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zY0HXcxKLgQ7kNvwGoOPBW&_nc_oc=AdpkbE6eiiQdy8Cekj_Axohbl4oh2cGg2f0I5ri9_4pDU_vcwiV4CF0hbwlaycnBxno&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_b5JFd2neCNNkZaV1_Sc3ZAFnCpMZHcTSyFCdjvmJ0w&oe=6A5B7C66"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
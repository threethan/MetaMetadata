4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0DUcYiksgMQ7kNvwE1Qe2m&_nc_oc=AdqVKPfJvDXO3De7YkG8KU7OcGQLH90HyMJbCQsWB-HSHirhi5szX0Nzp62pmx0Z0Ws&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUSds-_BM6Da37-R1IU_xOoW0lZ3_0PJ2IVrNWrodBlQ&oe=6AB678D3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-KP9xDTls8Q7kNvwHacFyS&_nc_oc=Adr3qRo0dPJ83lmZLBr73DfcoPLPJaeIjncDvfUCGVC4i1xeVWewv8Ori8AjN1toTLc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGwhgE66Yjr2ptKCicri5eOhPdeN2u6xOAQdXGy5RgRQ&oe=6AB68D64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJUeHXtoVtoQ7kNvwHK8eVt&_nc_oc=Adq3aiJH80X5NFUDN3f0qNh5C4Q_0VtiFmgc17hhdImFOPUS6J-eiLNFWkVzjd5l0sU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyT-HvbOspUJZu2HMcLeOiDHAOCrr7mPLksC0E7G2leQ&oe=6AB673E6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
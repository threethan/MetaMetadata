4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbJMri6UqlAQ7kNvwELzOix&_nc_oc=AdpQgUBt2ooVsg9ZgyA-6j-gs5n2UFartny4mTufuPSk0E4k_yLfLGKjtfUZdCijIVQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHLNLVguFofXtuDfME4A8_gd0hotM0ozCP8TtisfUjqQ&oe=6AEB34D3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFhtFXCS8OAQ7kNvwF_ptgh&_nc_oc=AdqmX7WlGlO05iAbGRn4gWujmGhZBkwTUrWxQ2WUVsJC8v0LILGMld5iz7t0g11M320&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5liAElgN-r3KqXUABTz7vg4J59TasVIPLKT4VNeuG-Q&oe=6AEB4964"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kbfyt8BWCSEQ7kNvwEeWkA5&_nc_oc=AdoKdkObCruUpDEXKSyOutMPkTW_vmSnTPl5vWvpCMYHUoBY85NrfIS-o5EaIQrb4ps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBlvHkjtfNK78TYoK-LBtgNQr5cRByJTnhnf5LlO7Wjw&oe=6AEB2FE6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
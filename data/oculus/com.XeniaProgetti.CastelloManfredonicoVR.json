4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpeVJMkqEpYQ7kNvwGJH72F&_nc_oc=AdqZzxplSYCbM2xhMSf_b6z_2C61le5i0yv8R842sUvSMNojixo-matfucUAAiryBEQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9L_6_ARsrgO6IumwZngOF-RnHIaVnLSb5CTmL5gOIEew&oe=6A26C553"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWtcUpR8TTIQ7kNvwGUyhyA&_nc_oc=AdqPENtuLbPYmWoLlAZv9g9cuyGJNlMR1V02qT6ZR-eDiw6pwxgpVWD1EEHiNd4CQ04&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CHZ_cNFhfgJ42fkqICoX-08DyRHeaVisSWyJeinssnA&oe=6A26D9E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQAktqEywWIQ7kNvwHjVOCd&_nc_oc=AdohuY-SJbwLqo5ZUZg5V88DMgAzvEdv_iSwTUA4uq-tK5hl77Xpsm3GcxV32vAviDQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1cp6c6SNxDsQNWdcJOX06sMj-2nYMm917mSihHlWozg&oe=6A26C066"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
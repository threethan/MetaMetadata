4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lksTqm5_zpsQ7kNvwHlNdfK&_nc_oc=AdqPaCvGbK057c4Cns6XLysx7QttU49NyvVWE8HExbDhQlLQ4ePoDcBReTsvvH6Lf70&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE92jztOpz-0PIi3vVk3jzE6RDDw47-UfJQPGIJsK8e7A&oe=6A845FD3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApN07HtSbYkQ7kNvwFzFeqs&_nc_oc=Adr7pP_dJT13tQhUI9SObX94Yk0X4ypIgaoqoxv3W_bStgRxmozKjPcShToSBvGFFEU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGT8CvEBYpFpzyz43l_uFmz0PbusLGxZ9Tw-jTtPDu3Ig&oe=6A843C24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AyRDaqPTVTcQ7kNvwFHgxsG&_nc_oc=AdqVC4ZpyFjy4dbcxU3cvzaILSkJ719ymWCOTH-RcR714T-33KJMeVYRSmmihzjbWAo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHh-U7yC_RuJ5799_GRWJgH5YbXqk0z9LFeLtYU5oFfug&oe=6A845AE6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
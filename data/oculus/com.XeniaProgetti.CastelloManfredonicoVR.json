4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lksTqm5_zpsQ7kNvwEk7cet&_nc_oc=AdrFUFBj3VQbgBpxb4ygxo8YHEDbuICdlGEAUJ5dyWRK0gOuE47qui7nT6hRvWzvoII&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYsz_6TFeHP73OcVAZZ7d6EPU_jI3IKQ2enzsGvSlHiQ&oe=6A830E53"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApN07HtSbYkQ7kNvwETZhnO&_nc_oc=AdqhqqrfAxxGwPAIv4EQzwiyN24uvLIISmhCY1-enmJ2nrKKi2h-sqo-AaFdGd7CHxA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1OEArSVpJOtJfDFTtCS_Bt-zj1Cqp09xzQ5uEZfskkQ&oe=6A82EAA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AyRDaqPTVTcQ7kNvwHUFaFb&_nc_oc=AdongVlrShcTAjgAcaeqlgB_kZnYuZkWECw-uYy8wV-oJ2xuNad2nSH6P1sgp7laZ_c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETl0fGel_1whDoco4lGwaZy3uSKPMBeTiSis2agy9liw&oe=6A830966"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23tfrkMTIJkQ7kNvwHuBouX&_nc_oc=AdqwlPMvRnL6EtssInVacBHOHnlLPEoeEpkgv5CDW0yHnw7bKBg0qPf-QQ0FaQN4Og4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTVDJ-_VmcNkUYbCTKji3oiH2_5hSIZUZ3SguWkUGNpg&oe=6AC104D3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRegECxFSNUQ7kNvwHEZC1-&_nc_oc=Adqrrujn0MaGToxKyHz2P-wId28vEnxRoLqHzdLpW2BGiy3BKW-vjDnFugaGFFx_2SA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVoTi5LkSxijBEGJCniN8ILb3jVbK1R_yqr6tUk_CLKA&oe=6AC11964"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmR5j0FlVWAQ7kNvwHqJ21k&_nc_oc=AdqrV8lEam8owkPOMc-S79eJy0mxu6Gj8yRM2UEQQiBlLIPkE4h28sZekVadLoh-meE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkFDx7dr87bysJPPZNFHT0bsS3cs2hMMcbj0fYkRTbEQ&oe=6AC0FFE6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
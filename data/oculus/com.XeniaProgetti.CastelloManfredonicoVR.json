4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bzf2p9RFqoAQ7kNvwHmBqmB&_nc_oc=AdotxEpz8SELr2YCdVuPZAyNlZCBi2OQIyWxKPtGuc2aoM-fYguS__PLj9eFMoeIlAc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwIgqfpuApYo4TumpUkBZVSmXDNwv_vBKSv-mQeK6DVA&oe=6A885453"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qzuj4wSOUUoQ7kNvwHGSpiT&_nc_oc=Adr9XKbYBbP6_ipeQ_1_5RYUowjGQT3qf7GKOIlk4fcfPMJptPK_woJl7st1erZIObQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrnewqqTrdsfDymtZsKMqs8tZG4WLLBA1aTgrem9kSvQ&oe=6A8830A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCmNMO9-q40Q7kNvwG362Xv&_nc_oc=AdqvoCFam2aFxGKF3r4kdcpGrl5F4gxYuyP5D0IKrssiYRPtwljs-5kSvSUlMHMC3Jc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF71o6naj3EuBVs7Mzhz4Nbt9S3c2E9w4aX9q8jF-1Xuw&oe=6A884F66"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
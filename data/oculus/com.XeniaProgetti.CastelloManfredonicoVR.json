4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHPDyp8rXs8Q7kNvwHPoAaR&_nc_oc=Adr-rhxpHLIUJGXYWPXTUiYvUm8NJ-Q6pnSfocUpJf-3YB9rN4nH3Ncd7-bPahhVv30&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_diYSOElJioi1s2TvJsOBuR-AnA3xn-tKoCbu8bOv2aQ&oe=6A3D2ED3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YoJbvR2wJNYQ7kNvwEizYyv&_nc_oc=Ado_AA02E2VGiLLtfecSyDGsflaBKI7sqf25VJYSueSYkACaT9nFTx-tMjL6LnRqMo0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7vNGc8YbeG-KGrShuRKvRHfYMO12YCT4mD-IOJcTWIg&oe=6A3D4364"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZZpjKePNMkQ7kNvwFEvCbW&_nc_oc=AdoS79tIiT5qNIbb13moyHC21bEYFXgDQ_SA-lFN2mLSlx6rq83-VoelW8OdiLpTYE8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1qWaVr890_7viKuQSjWO_1hZrjIicf-LCQ0FxdMz8jA&oe=6A3D29E6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
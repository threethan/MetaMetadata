4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQZJY0YuVn0Q7kNvwEPdz8k&_nc_oc=AdrZGUjStAQcEBC2s0oeOMwfuBFTuwOZYFEFtRYcA7_bsXNhim3l0ZXyERdWyddTVB4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzgDvef4NnI5CwFR52KB-F6I1ORtgYAcIQcCC2F7K4jpA&oe=69CFC253"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTFhlXfHz5MQ7kNvwFPaez3&_nc_oc=Adpdwkm2H-5IvQplQmFhHJre-_cLFjo_AjFnwsE48I2fQEYDwiw6oxxTDvRlbzhBt5E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxCnvWmXSr6fddPkGcNqphm784gn5luu-2fHCVliF_k-w&oe=69CF9EA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vokZj068KcUQ7kNvwH8adGG&_nc_oc=AdrGie618JlBXcHe25xQGBEipeYErfeBuk2REq9TmXiaPqKUbWC3did2DneZ8UktBQw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxc0lNVvsZ-nySW1FsPleMYceHpnI2-tV1wc7ufe4eZ1w&oe=69CFBD66"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
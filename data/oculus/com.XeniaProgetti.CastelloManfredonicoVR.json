4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oHUvW73shMQ7kNvwEagzKx&_nc_oc=AdrUnwjTubTqEpuyx3Jf1SDnNFSmp12ojlTuSNHJLVFI8mUZEhKNEcfYj4ZqJkPGIwg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OUno6jB90L4IQ-5FJwbBsnnW_9Ddl3zJQnCX5vSHueQ&oe=6A3FD1D3"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zzx5J-HfXfYQ7kNvwEqMvnt&_nc_oc=AdpnJI80geFe7NKVxxt1Ay90Q-jv9bQgpRRe9J9q4AxnnbOvLluvogJ2vd7aQ8x8YsU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rv7zxxwuE9OXdZ0bMkEYhoeQtLN_xQgfFn-wxENzc_Q&oe=6A3FE664"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DijHjzl3u8Q7kNvwGNiQFn&_nc_oc=AdqEVSzNwv9wNPzyydbJ7YOh5IC6URNyxVz4maDEH8MpYs7Vqj4DrNScN0eoUGL0buY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WWUbWwKN3_iPWevcnnBc6OYSVRGbcMRhbMK55VsvCUw&oe=6A3FCCE6"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
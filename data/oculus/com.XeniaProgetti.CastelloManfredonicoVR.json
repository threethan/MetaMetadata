4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDzriHR0zRMQ7kNvwGJDUqm&_nc_oc=Adocbnp8VSqVbNC3mfrLf7EB6ycn8ADJ1lJx2EBoYUGB3KzuxcFwNtsV0LPpwyXA14E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5y8hUEELYafIp1quYqtznChHUToatxKKPhMPyrDbV6ZQ&oe=69FC9553"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PfiKh_OYz4wQ7kNvwE7Vr1r&_nc_oc=Ado1lVzkz0U76kHGK7cpAIO_HhyVz8NxOhnoarXKg97vnGbyFQnmb_OYFtL0qqC9pGc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7I2uPdht-8cslM5yUpypd2Sr2nAy5k4WAv9MN3P4NCSw&oe=69FCA9E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZZhKRnwTXQQ7kNvwFr60aH&_nc_oc=Adr7Hncm_QJsi-AEsKvvH870aQSZ60m_wTQNFDUF4WrDi6CRAjPSn07BC9MeLPnfHyw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NjP7fI2aMJCdzxDJQN876ne-p49AhijjHWqrz8RU2Ww&oe=69FC9066"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
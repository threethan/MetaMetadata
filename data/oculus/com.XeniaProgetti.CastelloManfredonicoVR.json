4_4818475960430060979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHDpGAKljzAQ7kNvwFC61nu&_nc_oc=AdoEJzrjj_nOSFNYyBcki7E-6zanMqOJIoTup4_qxDm0eZyVQifBQ0e9rDueHVP5V6E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJMxYxWPMQd9d2jzt5_jfVHyBXG7X8JqMMTg1QLV5Cfg&oe=6ABA6D53"}, {"file_name": "7-2.png", "id": "507441484338726", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031629_507441487672059_2463868094139128139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfieYRGMTsAQ7kNvwEo3lWg&_nc_oc=AdojXG4vsN7jN8JgjLUvBc3QswuCgUhUWQv6z13qx5OU3tznij5lhGRi0IfUAPaHtTU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGBnU0a9UkgZx64Vf0nfiz6IfOAXSR15UBa3jS4eLJNg&oe=6ABA81E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-2560x1440.png", "id": "553893289621339", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75251816_553893296288005_4790393904850691804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqFJrrCC1G4Q7kNvwGipvS4&_nc_oc=AdqC99uKiqSbbtU9aDVPN_poq9pDk4GX3nLE3MXzLkDTtEQVqXXZoifs_6_9imKfVo8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHnav6YOFHAEjyTraOxSeuikitKKALTUaGr9toGPMsWw&oe=6ABA6866"}, "display_name": "Castello Manfredonico VR", "keywords": [], "long_description": "Con l'applicazione \"Castello Manfredonico VR\" navighi il modello 3D del Castello Manfredonico di Mussomeli apprezzando la meraviglia architettonica in modo divertente e innovativo.\n\nGrazie alla realt\u00e0 virtuale \u00e8 infatti possibile visitare gli spazi del Castello, muoversi attraverso gli ambienti e ammirare da vicino le bellezze di un tempo passato.\n\nL'applicazione \"Castello Manfredonico VR\" promuove l'utilizzo e lo sviluppo di nuove tecnologie sul territorio al fine di valorizzarne gli ambienti caratteristici.", "short_description": "Naviga il modello 3D del Castello Manfredonico di Mussomeli in modo divertente e interattivo grazie alla realt\u00e0 virtuale!\nLasciati guida
eAXHtVFfSQPweM6Kkqt3JVm2t7LKxk67wJmdZ_k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPY_ITAAne46Y10R2RIM0sZqmUnoe9K4IV6ADME-sA28A&oe=6ACB8E87"}, {"file_name": "Screenshot_03.png", "id": "3172304093026345", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031440_3172304096359678_6039364869348161608_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGRaPIfVFSYQ7kNvwGlhv9V&_nc_oc=Ado1cc0oT3DgKlqVNpqnH8KZWZOR6d8qyqPZXX3wjoYGynKGyOZ8EV1AmuIHKCP8t4M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3SwE7DfvPZHv7aS34F8PmFUhREDeKwuu9TvwJX122eg&oe=6ACBA503"}, {"file_name": "Screenshot_04.png", "id": "350546496978701", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572935_350546500312034_2637184203351967188_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oe9bElBqIg0Q7kNvwFv10jR&_nc_oc=Adqu7VyyIZmp8AvRuUafvJ1Q0zdgSrXmZg1NYwXHR5z7sL7XYRa-fIE7gCDTXagRrIA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPb4pSK8UM0r5cFDdZx0-oYYZW7XfPbz1tMSFROZWBTrQ&oe=6ACBBAB5"}, {"file_name": "Screenshot_05.png", "id": "202805275376353", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003274_202805278709686_2393160781439405753_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LB7qggvqagEQ7kNvwEcP-AV&_nc_oc=AdoW6Cvdm4ktvjE6WNJq30ewcKX_ORT766PvKLCfX-fhwGHieE76J9-WhWY884sdymY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNennJTcnRrjBH4iC58zc0Le7ZW3FqN7tzeQzGVMZPUIQ&oe=6ACBA8FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "978169969742709", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569483_978169973076042_7789538847980013476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UTfNnqkt4kQ7kNvwHMqSN3&_nc_oc=AdqwzM_1Y_5lb82UYgkHC5_ncKG5fv-ofkU-HlER4ehTsVDBKm8CL1MCk__J4GlX3WE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2sis8Zz62bpWg84Q78IM19MKgOEiE952CoBbYYsws3g&oe=6ACB9C1C"}, "display_name": "Warplanes: Battles over Pacific", "keywords": [], "long_description": "Warplanes: Battles over Pacific opens the next chapter in aviation history. Become a World War II pilot and take part in the campaign against the Empire of Japan. The sequel to the hit Warplanes: WW1 Fighters, takes dogfight to a new level.\n\nRealistic graphics and intuitive controls enhance the gameplay experience. The new flight model will make you feel the power, speed and handling of the most popular American and Japanese aircrafts. The technological leap between World War I and World War II made aviation the leading branch of the military and changed war forever...\n\nWW2 EXPERIENCE IN VR\n\u25cf Lead the US to victory over Japan in the single player campaign.\n\u25cf Play classic PvP multiplayer modes to face off against players from around the world.\n\u25cf Have fun with friends by your side playing co-op missions.\n\u25cf Take controls of 10 of the most iconic aircraft fighting over the Pacific.\n\u25cf Adjust the game to your preferences thanks to 3 difficulty levels.\n", "short_description": "Warplanes: Battles over Pacific opens the next chapter in aviation history. Become a World War II pilot and take part in the campaign against the Empire of Japan. The sequel to the hit Warplanes: WW1 Fighters, takes dogfight to a new level.\n\n\u25cf Lead the US to victory over Japan in the single player campaign.\n\u25cf Play classic PvP multiplayer modes to face off against players from around the world.\n\u25cf Have fun with friends by your side playing co-op missions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.homenetgames.com/privacy-policy-vr/", "developer_terms_of_service_url": null, "publisher_name": "Home Net Games", "support_website_url": "https://www.homenetgames.com/support/", "website_url": "https://www.homenetgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925
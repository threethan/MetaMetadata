6K5R_O1ky6aqCyt8HwsOHdvJpIQ&oe=69E0E387"}, {"file_name": "Screenshot_03.png", "id": "3172304093026345", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031440_3172304096359678_6039364869348161608_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QW0-CbGjvdcQ7kNvwFfwpMo&_nc_oc=AdpI26evbciuZ-s1QskNejlRQgTNQONcHdDTXF23HF_Q0UOy_-Sp9hSywxXIKeBSFYs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lfxFdw79HXCEjwsi3DZCW0NYDp4wp-KpBpKCoMDmlVg&oe=69E0FA03"}, {"file_name": "Screenshot_04.png", "id": "350546496978701", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572935_350546500312034_2637184203351967188_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucV4ABrvJ8oQ7kNvwG_jsxp&_nc_oc=Ado03_Ysb5vHQuip5DRIOCR7ZqgHU2IvgAJPxu6eewCcquwKk4HvO7gqn1hZKC7P0Pk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ejig97U18SdhJa6MtE-Uo2VgR6_MCO2MDh6Uor8brig&oe=69E0D775"}, {"file_name": "Screenshot_05.png", "id": "202805275376353", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003274_202805278709686_2393160781439405753_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvSTB4DUEx4Q7kNvwE1Av8X&_nc_oc=AdpYKcjAFUnC-GHX6CXIzOc7OFpVXZrrnsVp5X3JV1Q5fcKpD_-NCEJtr7WjqzAHv2E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yXtBa-Xq1whk4BjzfheRsKg-4TvrbH5_XJmU_dqgD4g&oe=69E0FDFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "978169969742709", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569483_978169973076042_7789538847980013476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kIVMPoMWwsQ7kNvwFcj88W&_nc_oc=AdrqfD9h1sNilcAqB7w0ocLXz5uae2IP87Qk3vQAuTfsEvXkcUb7lMxfR0JR5PWdgf4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TDn_WtQc3BYatc3fJXpmRAI5P5BLMw2TkPlVXJPoXvw&oe=69E0F11C"}, "display_name": "Warplanes: Battles over Pacific", "keywords": [], "long_description": "Warplanes: Battles over Pacific opens the next chapter in aviation history. Become a World War II pilot and take part in the campaign against the Empire of Japan. The sequel to the hit Warplanes: WW1 Fighters, takes dogfight to a new level.\n\nRealistic graphics and intuitive controls enhance the gameplay experience. The new flight model will make you feel the power, speed and handling of the most popular American and Japanese aircrafts. The technological leap between World War I and World War II made aviation the leading branch of the military and changed war forever...\n\nWW2 EXPERIENCE IN VR\n\u25cf Lead the US to victory over Japan in the single player campaign.\n\u25cf Play classic PvP multiplayer modes to face off against players from around the world.\n\u25cf Have fun with friends by your side playing co-op missions.\n\u25cf Take controls of 10 of the most iconic aircraft fighting over the Pacific.\n\u25cf Adjust the game to your preferences thanks to 3 difficulty levels.\n", "short_description": "Warplanes: Battles over Pacific opens the next chapter in aviation history. Become a World War II pilot and take part in the campaign against the Empire of Japan. The sequel to the hit Warplanes: WW1 Fighters, takes dogfight to a new level.\n\n\u25cf Lead the US to victory over Japan in the single player campaign.\n\u25cf Play classic PvP multiplayer modes to face off against players from around the world.\n\u25cf Have fun with friends by your side playing co-op missions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.homenetgames.com/privacy-policy-vr/", "developer_terms_of_service_url": null, "publisher_name": "Home Net Games", "support_website_url": "https://www.homenetgames.com/support/", "website_url": "https://www.homenetgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040
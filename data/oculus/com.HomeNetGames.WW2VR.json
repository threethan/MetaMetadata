0A_jas61cNBYhnxbUGKRz14amT6ogcClByEeK5w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBEswTpEkfm3B2TKVq1pegXAzoH4bobKYonMnmrE-zBQ&oe=6AE0A687"}, {"file_name": "Screenshot_03.png", "id": "3172304093026345", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031440_3172304096359678_6039364869348161608_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-DdctYmkD0Q7kNvwGOWudz&_nc_oc=AdrZ6keYTs61zt3pnWAi-Njrxq3XcIB7S3lSofD60ga8WtGz60dxGl4q6bS8OQV_zNs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiOrzKhJ7BmKi0C97hTmsE5ndtZ8m1pwgI3O_7uHdfRg&oe=6AE0BD03"}, {"file_name": "Screenshot_04.png", "id": "350546496978701", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572935_350546500312034_2637184203351967188_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wxAm8fNJQAQ7kNvwHAjZ6s&_nc_oc=AdpqNslrTAmZtZZM3bPXpsDZRG6JZKADzOmTmsQl3ZG6nRrgniNQq750ZxTDz2gCw_Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-0hGz42IGt9wDoiU9KZefzKCg5rhS3E6WEZbFBssNag&oe=6AE09A75"}, {"file_name": "Screenshot_05.png", "id": "202805275376353", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003274_202805278709686_2393160781439405753_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLcslA2CLjYQ7kNvwEJhUd8&_nc_oc=AdqnNgCb_g64pXVS3v2xCwFWHixFv21IWjRWRDx0BFJTF5AYcFsOtkqlarv_YAuJjOw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNra-M3QqrXjjksY1IAw39OuhZELpe_LbwthKD_5RI3hQ&oe=6AE0C0FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "978169969742709", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569483_978169973076042_7789538847980013476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tX3T5jKXD_kQ7kNvwFA1_po&_nc_oc=Adq8SYVJfUvCiuw12ANL6lW8J31i3bv4dwHHg_zbXsZNdLs87uYTqxCzU9UZ6hXCFLM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNusZy43HehPdNlG5CpSZflPmHMqpjobtu_5xGKDhsnpQ&oe=6AE0B41C"}, "display_name": "Warplanes: Battles over Pacific", "keywords": [], "long_description": "Warplanes: Battles over Pacific opens the next chapter in aviation history. Become a World War II pilot and take part in the campaign against the Empire of Japan. The sequel to the hit Warplanes: WW1 Fighters, takes dogfight to a new level.\n\nRealistic graphics and intuitive controls enhance the gameplay experience. The new flight model will make you feel the power, speed and handling of the most popular American and Japanese aircrafts. The technological leap between World War I and World War II made aviation the leading branch of the military and changed war forever...\n\nWW2 EXPERIENCE IN VR\n\u25cf Lead the US to victory over Japan in the single player campaign.\n\u25cf Play classic PvP multiplayer modes to face off against players from around the world.\n\u25cf Have fun with friends by your side playing co-op missions.\n\u25cf Take controls of 10 of the most iconic aircraft fighting over the Pacific.\n\u25cf Adjust the game to your preferences thanks to 3 difficulty levels.\n", "short_description": "Warplanes: Battles over Pacific opens the next chapter in aviation history. Become a World War II pilot and take part in the campaign against the Empire of Japan. The sequel to the hit Warplanes: WW1 Fighters, takes dogfight to a new level.\n\n\u25cf Lead the US to victory over Japan in the single player campaign.\n\u25cf Play classic PvP multiplayer modes to face off against players from around the world.\n\u25cf Have fun with friends by your side playing co-op missions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.homenetgames.com/privacy-policy-vr/", "developer_terms_of_service_url": null, "publisher_name": "Home Net Games", "support_website_url": "https://www.homenetgames.com/support/", "website_url": "https://www.homenetgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925
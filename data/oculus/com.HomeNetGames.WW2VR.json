adnXU-qFLQrs5lNPAykLin-8Chw&oe=6A242007"}, {"file_name": "Screenshot_03.png", "id": "3172304093026345", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031440_3172304096359678_6039364869348161608_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_mf_qVjWrMQ7kNvwG4-dHK&_nc_oc=AdrED7rr5kUruTVpNZXuwptTW4rUxvW3L7PWDcGso_RUJo3LxjBkd-STNIOfVwgXWjY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80vlEuiWPB4tEiwyqsjt7gTLY5ni4xfk4DynX-fg4hOA&oe=6A243683"}, {"file_name": "Screenshot_04.png", "id": "350546496978701", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57572935_350546500312034_2637184203351967188_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CK-jnaSTkYMQ7kNvwGEbReD&_nc_oc=AdrAGf0-HKE-LseOlBtEGhaxM1zIFwuMFOYb-ISr_J_8eeaBtuxXM-YJQ_bwo2-56C4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_MKwLgC5D_qqRqTzfEmAQESGDV6gyi6vdyghPhXlpiQ&oe=6A2413F5"}, {"file_name": "Screenshot_05.png", "id": "202805275376353", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003274_202805278709686_2393160781439405753_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtP3bG5At5kQ7kNvwECw2Vv&_nc_oc=Adr80MEm9ACH-VJFGPq_TJKsY9b1eiA5spnSAIivAsxiLk2SO7sfpEU_JkMEFVBZKQE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Qai39fpBYPgzHfYaMqdIbGz8785HhyHNnzFRXOjef0g&oe=6A243A7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "978169969742709", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569483_978169973076042_7789538847980013476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7eALhIw3wEQ7kNvwFErA3c&_nc_oc=AdrbyAOyvukF0fj_6MwEqe81fm3l_TTvdCC8QovXmfgVvIetUACOlyyU9uIcrEYikmk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KCjN2Jm359OsTkCOS4MMA7SJ8Xv5PW6EFcp51bCfIKw&oe=6A242D9C"}, "display_name": "Warplanes: Battles over Pacific", "keywords": [], "long_description": "Warplanes: Battles over Pacific opens the next chapter in aviation history. Become a World War II pilot and take part in the campaign against the Empire of Japan. The sequel to the hit Warplanes: WW1 Fighters, takes dogfight to a new level.\n\nRealistic graphics and intuitive controls enhance the gameplay experience. The new flight model will make you feel the power, speed and handling of the most popular American and Japanese aircrafts. The technological leap between World War I and World War II made aviation the leading branch of the military and changed war forever...\n\nWW2 EXPERIENCE IN VR\n\u25cf Lead the US to victory over Japan in the single player campaign.\n\u25cf Play classic PvP multiplayer modes to face off against players from around the world.\n\u25cf Have fun with friends by your side playing co-op missions.\n\u25cf Take controls of 10 of the most iconic aircraft fighting over the Pacific.\n\u25cf Adjust the game to your preferences thanks to 3 difficulty levels.\n", "short_description": "Warplanes: Battles over Pacific opens the next chapter in aviation history. Become a World War II pilot and take part in the campaign against the Empire of Japan. The sequel to the hit Warplanes: WW1 Fighters, takes dogfight to a new level.\n\n\u25cf Lead the US to victory over Japan in the single player campaign.\n\u25cf Play classic PvP multiplayer modes to face off against players from around the world.\n\u25cf Have fun with friends by your side playing co-op missions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.homenetgames.com/privacy-policy-vr/", "developer_terms_of_service_url": null, "publisher_name": "Home Net Games", "support_website_url": "https://www.homenetgames.com/support/", "website_url": "https://www.homenetgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040
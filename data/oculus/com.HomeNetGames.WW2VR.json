{"data": {"node": {"__typename": "Application", "id": "3984056454948095", "organization": {"id": "167156717185330", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "25913715511590127"}]}, "id": "1244251310643150"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "7749043518464805"}]}, "id": "968558274951374"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "25662225113424807"}]}, "id": "794227836148115"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "6490120717730839"}]}, "id": "347578270927206"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "6068974879849985"}]}, "id": "3816127711947584"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "5014131998634540"}]}, "id": "940735953153103"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "3782829921838385"}]}, "id": "346089646842627"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "3984056454948095"}]}, "id": "472796993861625"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "3922378427824210"}]}, "id": "238885491023288"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "3989514264412588"}]}, "id": "774976103109420"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1177986715634360"}]}, "id": "173108089903142"}]}}, "firstRevision": {"nodes": [{"application": {"id": "3984056454948095", "release_date": 1660237140, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 68}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26736174082643009"}, "id": "1761315960740068"}]}}, "binary": null, "live_binary": null, "created_date": 1773913236, "id": "26493644670229286", "is_initial_release": false, "name_with_fallback": "v8", "pdp_metadata_with_fallback": {"version": 7, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "26493728133554273"}, "release_status": "RELEASED", "id": "3984056454948095"}, "id": "26493728133554273", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "3984056454948095", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1111672907267092"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "26182842561380012", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Warplanes: Battles over Pacific", "keywords": [], "long_description": "Warplanes: Battles over Pacific er\u00f6ffnet das n\u00e4chste Kapitel der Geschichte der Luftfahrt. Werde zum Piloten im Zweiten Weltkrieg und k\u00e4mpfe in der Schlacht gegen das japanische Kaiserreich oder st\u00fcrze dich in den packenden Multiplayer-Modus. Der Nachfolger des erfolgreichen \u201eWarplanes: WW1 Fighters\u201c bringt den Luftkampf auf ein neues Level.\n\nRealistische Grafik und eine intuitive Steuerung verbessern das Spielerlebnis. Das neue Flugmodell gibt dir ein Gef\u00fchl f\u00fcr die Leistung, Geschwindigkeit und das Handling der beliebtesten amerikanischen und japanischen Flugzeugmodelle. Der technologische Sprung zwischen dem Ersten und dem Zweiten Weltkrieg machte die Luftfahrt zum f\u00fchrenden Zweig des Milit\u00e4rs und ver\u00e4nderte den Krieg f\u00fcr immer ... \n\nERLEBE DEN ZWEITEN WELTKRIEG IN VR\n\u25cf \u00dcbernimm die Kontrolle \u00fcber zehn der legend\u00e4rsten Flugzeuge, die \u00fcber dem Pazifik eingesetzt wurden.\n\u25cf F\u00fchre die USA in der Einzelspielerkampagne zum Sieg \u00fcber Japan.\n\u25cf Spiele klassische PvP-Mehrspielermodi, um gegen Spieler aus der ganzen Welt zu bestehen.\n\u25cf Erlebe gemeinsam mit Freunden an deiner Seite Koop-Missionen.\n\u25cf Passe das Spiel dank drei verschiedenen Schwierigkeitsgraden an deine pers\u00f6nlichen St\u00e4rken an.\n\n", "short_description": "Warplanes: Battles over Pacific er\u00f6ffnet das n\u00e4chste Kapitel der Geschichte der Luftfahrt. Werde zum Piloten im Zweiten Weltkrieg und k\u00e4mpfe in der Schlacht gegen das japanische Kaiserreich oder st\u00fcrze dich in den packenden Multiplayer-Modus. Der Nachfolger des erfolgreichen \u201eWarplanes: WW1 Fighters\u201c bringt den Luftkampf auf ein neues Level.\n"}, {"images": {"nodes": [{"file_name": "WarplanesPacific_keyart_1008x1440-fixed.png", "id": "2107883702743976", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031542_2107883706077309_6470957803733003265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qN-qOLcIPhoQ7kNvwFsQal7&_nc_oc=AdqElme-ibXba26MUf_kkj3o6LpEa_ghR8ydlH3EMo7NjTtnsEbbrQfn2b6o0tv86sg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQTUEdV4Ox0nybiJusX2WUhgOzXhqN5BoRuhdF3ghOyw&oe=6AF9C5AC"}, {"file_name": "Logo.png", "id": "1107983559990493", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974677_1107983563323826_5045635688287985265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYif2wxyLRQQ7kNvwHwq1ro&_nc_oc=Adqg2g9X1f7ZFKDFl-_IRQoJy66_t0MfPAW6eIvr9yAzFvWhrIS1a-EjTrgWHxB5FP8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTG433b6hPLkpZ_exqMNM44EjzCDeX7vMWlXQj-2skRwg&oe=6AF9E117"}, {"file_name": "WarplanesPacific_keyart_2560x1440-fixed.png", "id": "898862131125347", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974456_898862137792013_1206103340984641084_n.png?_nc_ca
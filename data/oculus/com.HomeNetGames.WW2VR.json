DC6"}, {"file_name": "Warplanes_Battles_over_Pacific_05.png", "id": "369651688404539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982685_369651691737872_940533361119189720_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3xWffm0CE8Q7kNvwE555pw&_nc_oc=Adm6FMaMC4GB0E7wYeBsgep7v5pSBzKbj4tvxdOaUMogIF-7ns4jq3tqoMGnuIoZKX8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx3RSIGyM6E_lMQ548xomESB3qMqaTXiNt21tYrcdUtNg&oe=69BFE67A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "548870900688455", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974672_548870904021788_6181817618579528152_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBd0PUDJn3YQ7kNvwEaykVC&_nc_oc=Adny1eK77gM4cMQ8C3RSB4hkMCEf62XOqGMb4iy4KcLrdtG3oFeqgDH3klyiSM4vmgs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxUkcUunXQilC89Bl5jmebHmVe26kTJF4PeehOIrv9wfw&oe=69BFD0B8"}, "display_name": "Warplanes: Battles over Pacific", "keywords": [], "long_description": "Warplanes: Battles over Pacific opens the next chapter in aviation history. Become a World War II pilot and take part in the campaign against the Empire of Japan. The sequel to the hit Warplanes: WW1 Fighters, takes dogfight to a new level.\n\nRealistic graphics and intuitive controls enhance the gameplay experience. The new flight model will make you feel the power, speed and handling of the most popular American and Japanese aircraft. The technological leap between World War I and World War II made aviation the leading branch of the military and changed war forever...\n\nWW2 EXPERIENCE IN VR\n\u25cf Lead the US to victory over Japan in the single player campaign.\n\u25cf Play classic PvP multiplayer modes to face off against players from around the world.\n\u25cf Have fun with friends by your side playing co-op missions.\n\u25cf Take controls of 15 of the most iconic aircraft fighting over the Pacific.\n\u25cf Adjust the game to your preferences thanks to 3 difficulty levels.\n", "short_description": "Warplanes: Battles over Pacific opens the next chapter in aviation history. Become a World War II pilot and take part in the campaign against the Empire of Japan. The sequel to the hit Warplanes: WW1 Fighters, takes dogfight to a new level.\n\n\u25cf Lead the US to victory over Japan in the single player campaign.\n\u25cf Play classic PvP multiplayer modes to face off against players from around the world.\n\u25cf Have fun with friends by your side playing co-op missions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.homenetgames.com/privacy-policy-vr/", "developer_terms_of_service_url": "https://www.homenetgames.com/warplanes-battles-over-pacific/article/end-user-license-agreement-eula-and-terms-of-use-of-warplanes-battles-over-pacific/", "publisher_name": "Home Net Games", "support_website_url": "https://www.homenetgames.com/support/", "website_url": "https://www.homenetgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ko", "en", "pt_BR", "it", "fr", "es", "uk", "ja", "pl", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "8997815333572157"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974593_693672199005713_1858082122482221946_n.png?stp=dst-
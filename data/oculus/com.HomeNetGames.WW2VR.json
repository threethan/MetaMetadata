WC5QmcE3ih4w3tFZo3WR5QbXg3g&oe=6A09C207"}, {"file_name": "Screenshot_03.png", "id": "3172304093026345", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031440_3172304096359678_6039364869348161608_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEizqqV_vKgQ7kNvwGtISkb&_nc_oc=AdpXzvjv-PkR1w_LWJkdV3IEAVuHV3zM7CsXWbaRzWvsTpvj50uZ7ppUTRdMJmj9opc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bbfnpimD2Bjal8QAxLyOuFFRMx46_OQl8epK9IydmJA&oe=6A09D883"}, {"file_name": "Screenshot_04.png", "id": "350546496978701", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57572935_350546500312034_2637184203351967188_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6sRynXblPAQ7kNvwEo_T_L&_nc_oc=AdqsnD5UmzUq6F5L9FVPL1EirDk0dunNXyXLZkFwaQGIKcfN85-GKMxju89Ybk-TlOg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LazEPGR9a6-ELjLsx6X3a_9FP07axMGQUZ4oyLtzezA&oe=6A09B5F5"}, {"file_name": "Screenshot_05.png", "id": "202805275376353", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39003274_202805278709686_2393160781439405753_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQH6_2QR8jIQ7kNvwHiqoRw&_nc_oc=AdrdZTr-SPftEvdEOiAfX2kuvuUB5_Q5oFZDudo5vnGVSwRg3LELrr9_1KWMquFQeiA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77GbvILYQ2Tc5ntOjFsmoA8ODfYum5vdrlQ4BPyZm1UA&oe=6A09DC7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "978169969742709", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/57569483_978169973076042_7789538847980013476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHfX7_gVud8Q7kNvwFKMi_M&_nc_oc=Adpf8SNpMrlPLy56H0VHb9cIeH7wJUBzEdnoxUa1m5jyHU3q4CHOeaH6I2thasjmZJ8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YqK0q58XH1U18LH5X7Fl9wKbfn_VPsI9uVBsa4L-qZQ&oe=6A09CF9C"}, "display_name": "Warplanes: Battles over Pacific", "keywords": [], "long_description": "Warplanes: Battles over Pacific opens the next chapter in aviation history. Become a World War II pilot and take part in the campaign against the Empire of Japan. The sequel to the hit Warplanes: WW1 Fighters, takes dogfight to a new level.\n\nRealistic graphics and intuitive controls enhance the gameplay experience. The new flight model will make you feel the power, speed and handling of the most popular American and Japanese aircrafts. The technological leap between World War I and World War II made aviation the leading branch of the military and changed war forever...\n\nWW2 EXPERIENCE IN VR\n\u25cf Lead the US to victory over Japan in the single player campaign.\n\u25cf Play classic PvP multiplayer modes to face off against players from around the world.\n\u25cf Have fun with friends by your side playing co-op missions.\n\u25cf Take controls of 10 of the most iconic aircraft fighting over the Pacific.\n\u25cf Adjust the game to your preferences thanks to 3 difficulty levels.\n", "short_description": "Warplanes: Battles over Pacific opens the next chapter in aviation history. Become a World War II pilot and take part in the campaign against the Empire of Japan. The sequel to the hit Warplanes: WW1 Fighters, takes dogfight to a new level.\n\n\u25cf Lead the US to victory over Japan in the single player campaign.\n\u25cf Play classic PvP multiplayer modes to face off against players from around the world.\n\u25cf Have fun with friends by your side playing co-op missions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.homenetgames.com/privacy-policy-vr/", "developer_terms_of_service_url": null, "publisher_name": "Home Net Games", "support_website_url": "https://www.homenetgames.com/support/", "website_url": "https://www.homenetgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040
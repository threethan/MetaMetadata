com/v/t64.5771-25/57572935_350546500312034_2637184203351967188_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seg0VYym9SkQ7kNvwFF9o-I&_nc_oc=Adn3BO9YFeXqwkGPV-TVS-aiizJJk_d0IH9B_-VNMsdFzD6hDITw9z5UJsX3lk4pqE4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzOLm2pN5J4LrzHIM1aImCJh9L_BWYKxVJwgIrriHH4qA&oe=69BE9075"}, {"file_name": "Screenshot_05.png", "id": "202805275376353", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003274_202805278709686_2393160781439405753_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7_FoIixDIIQ7kNvwFnRR7h&_nc_oc=AdnPH7c7tZsm8xvaXB900g0NNDUoFIB1Z6VhVx1qW_lNhIO4JqTf7wYBbv5OiINzMvk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyWzzhcJp9RHcH8oLMH3gQ8CfcC9CncdGDrACBDbQz2og&oe=69BE7EBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "978169969742709", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569483_978169973076042_7789538847980013476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KxmGhpn2PkQ7kNvwHzCaM-&_nc_oc=Adnv5pM2luuQXDtEMWoagkM_dDiL9juobHhFD4YTfutPuX67yxmk_kuLWFhfQZ_e5jE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwq1yrWAlWBII9qj-Op_8b_cioFFIZ3A2qtQ8QCLLRDFA&oe=69BEAA1C"}, "display_name": "Warplanes: Battles over Pacific", "keywords": [], "long_description": "Warplanes: Battles over Pacific opens the next chapter in aviation history. Become a World War II pilot and take part in the campaign against the Empire of Japan. The sequel to the hit Warplanes: WW1 Fighters, takes dogfight to a new level.\n\nRealistic graphics and intuitive controls enhance the gameplay experience. The new flight model will make you feel the power, speed and handling of the most popular American and Japanese aircrafts. The technological leap between World War I and World War II made aviation the leading branch of the military and changed war forever...\n\nWW2 EXPERIENCE IN VR\n\u25cf Lead the US to victory over Japan in the single player campaign.\n\u25cf Play classic PvP multiplayer modes to face off against players from around the world.\n\u25cf Have fun with friends by your side playing co-op missions.\n\u25cf Take controls of 10 of the most iconic aircraft fighting over the Pacific.\n\u25cf Adjust the game to your preferences thanks to 3 difficulty levels.\n", "short_description": "Warplanes: Battles over Pacific opens the next chapter in aviation history. Become a World War II pilot and take part in the campaign against the Empire of Japan. The sequel to the hit Warplanes: WW1 Fighters, takes dogfight to a new level.\n\n\u25cf Lead the US to victory over Japan in the single player campaign.\n\u25cf Play classic PvP multiplayer modes to face off against players from around the world.\n\u25cf Have fun with friends by your side playing co-op missions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.homenetgames.com/privacy-policy-vr/", "developer_terms_of_service_url": null, "publisher_name": "Home Net Games", "support_website_url": "https://www.homenetgames.com/support/", "website_url": "https://www.homenetgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "300304828633751"}}]}, "scheduled_offers": {"count": 62, "nodes": [{"status": "PUB
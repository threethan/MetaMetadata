zPRHd-ZOaOTtYZAIO2FJyNCbOKA&oe=69CE6E87"}, {"file_name": "Screenshot_03.png", "id": "3172304093026345", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031440_3172304096359678_6039364869348161608_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yId_P3q42PsQ7kNvwHTV7vB&_nc_oc=Adq93h508lq2_5Oq-VfsSMfMW2IyF2VWilvWfENv7dEpBP8SGcvzZD92oguddo43vwM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYrHL6xGDLu282QyG-AYTA7aYmwpjSuqeZh8Jje4-sEA&oe=69CE4CC3"}, {"file_name": "Screenshot_04.png", "id": "350546496978701", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572935_350546500312034_2637184203351967188_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBXGbRZ4cscQ7kNvwGdlkZi&_nc_oc=AdqqSlO48M6o7PSofLM4DfhOhhFRONxkuhpJYX8zsNkj4QaahjpdfIEiaUPnBESAWKc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzJXDRiTboNnWxJengPthF_VLPrLgzO_xyGDiGnjJTKxw&oe=69CE6275"}, {"file_name": "Screenshot_05.png", "id": "202805275376353", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003274_202805278709686_2393160781439405753_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uVQnBAGb3kQ7kNvwFuYvCb&_nc_oc=AdovVL83fLtBOUVd5VVCT4BkDnVyKdCAUWPx9hsi0L7V92I4vIdRgrLKaQB1_vwkpCs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxz70vJoey07Mjg9fUA62Q0nyDpD9upMx5lrlwWaMWf8w&oe=69CE50BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "978169969742709", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569483_978169973076042_7789538847980013476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bw4mNPKXVK0Q7kNvwHwldg5&_nc_oc=AdolxSF-JjkWuUckwoZHFi1IqVI6yRIcuBIWhbc8L3zyVTpaFTXBkBMJocQcZ_ovGgk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy7znBc6R3EFJXtRG9EdRhShDPnVKLncaowPgV4SOgIEw&oe=69CE7C1C"}, "display_name": "Warplanes: Battles over Pacific", "keywords": [], "long_description": "Warplanes: Battles over Pacific opens the next chapter in aviation history. Become a World War II pilot and take part in the campaign against the Empire of Japan. The sequel to the hit Warplanes: WW1 Fighters, takes dogfight to a new level.\n\nRealistic graphics and intuitive controls enhance the gameplay experience. The new flight model will make you feel the power, speed and handling of the most popular American and Japanese aircrafts. The technological leap between World War I and World War II made aviation the leading branch of the military and changed war forever...\n\nWW2 EXPERIENCE IN VR\n\u25cf Lead the US to victory over Japan in the single player campaign.\n\u25cf Play classic PvP multiplayer modes to face off against players from around the world.\n\u25cf Have fun with friends by your side playing co-op missions.\n\u25cf Take controls of 10 of the most iconic aircraft fighting over the Pacific.\n\u25cf Adjust the game to your preferences thanks to 3 difficulty levels.\n", "short_description": "Warplanes: Battles over Pacific opens the next chapter in aviation history. Become a World War II pilot and take part in the campaign against the Empire of Japan. The sequel to the hit Warplanes: WW1 Fighters, takes dogfight to a new level.\n\n\u25cf Lead the US to victory over Japan in the single player campaign.\n\u25cf Play classic PvP multiplayer modes to face off against players from around the world.\n\u25cf Have fun with friends by your side playing co-op missions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.homenetgames.com/privacy-policy-vr/", "developer_terms_of_service_url": null, "publisher_name": "Home Net Games", "support_website_url": "https://www.homenetgames.com/support/", "website_url": "https://www.homenetgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040
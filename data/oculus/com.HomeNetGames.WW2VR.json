VLoET-vUVan-y88lnN4VCCF-T-Q&oe=69E62987"}, {"file_name": "Screenshot_03.png", "id": "3172304093026345", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031440_3172304096359678_6039364869348161608_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rq2Cmqvt2QQQ7kNvwEVkXht&_nc_oc=AdrDzCPEr9eFgq_Wj5cGjWRm3nGawP5dVZufvLtFLhZYDDAwVEmSMw0-HFKKBL3qxE0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pmxKX9z5REKTX8cRq6rq6kz9Pcb5nMaO_wf9yLcXVRQ&oe=69E64003"}, {"file_name": "Screenshot_04.png", "id": "350546496978701", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57572935_350546500312034_2637184203351967188_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xw_xTE4oFuAQ7kNvwGxalh3&_nc_oc=AdoYAzFz2LUpkevH9bkgVoEHsuyJZy8kUyFtHP-ZngBmz4OGj9RHBxNd4ERZwWf9Gb8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yGvbNVtRHliE6KT0AiyCOiS8QsOGCPl5RjvEs8bBdmg&oe=69E61D75"}, {"file_name": "Screenshot_05.png", "id": "202805275376353", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003274_202805278709686_2393160781439405753_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWveN2AhWoEQ7kNvwFcZU4g&_nc_oc=Adq1SWl0q7Gp3vG6OBrtEolvMKu7aTLSIAaaafZzOhzm0vuc_EBgvksitKPEStLl3o4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cMy3ORkLY56XG7uqTiWCWLuRaDUoqzZ2kRTTsGjpkig&oe=69E643FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "978169969742709", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569483_978169973076042_7789538847980013476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXttIsgzddMQ7kNvwEQ1-8G&_nc_oc=Ado0no8TwEXn75qfa-UHUWBfs_7BaHv3REeZpDTaBLGjeLA8q0vE3ee51NooUrZPo10&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Qarxsrj2TDItSvVzrZ8y-PI2X2JUKm7YplmDpijx-6A&oe=69E6371C"}, "display_name": "Warplanes: Battles over Pacific", "keywords": [], "long_description": "Warplanes: Battles over Pacific opens the next chapter in aviation history. Become a World War II pilot and take part in the campaign against the Empire of Japan. The sequel to the hit Warplanes: WW1 Fighters, takes dogfight to a new level.\n\nRealistic graphics and intuitive controls enhance the gameplay experience. The new flight model will make you feel the power, speed and handling of the most popular American and Japanese aircrafts. The technological leap between World War I and World War II made aviation the leading branch of the military and changed war forever...\n\nWW2 EXPERIENCE IN VR\n\u25cf Lead the US to victory over Japan in the single player campaign.\n\u25cf Play classic PvP multiplayer modes to face off against players from around the world.\n\u25cf Have fun with friends by your side playing co-op missions.\n\u25cf Take controls of 10 of the most iconic aircraft fighting over the Pacific.\n\u25cf Adjust the game to your preferences thanks to 3 difficulty levels.\n", "short_description": "Warplanes: Battles over Pacific opens the next chapter in aviation history. Become a World War II pilot and take part in the campaign against the Empire of Japan. The sequel to the hit Warplanes: WW1 Fighters, takes dogfight to a new level.\n\n\u25cf Lead the US to victory over Japan in the single player campaign.\n\u25cf Play classic PvP multiplayer modes to face off against players from around the world.\n\u25cf Have fun with friends by your side playing co-op missions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.homenetgames.com/privacy-policy-vr/", "developer_terms_of_service_url": null, "publisher_name": "Home Net Games", "support_website_url": "https://www.homenetgames.com/support/", "website_url": "https://www.homenetgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040
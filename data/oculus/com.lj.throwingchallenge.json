luscdn.com/v/t64.5771-25/75363518_1173792500501574_2426979058473739643_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7c_pTk4hs1QQ7kNvwFCiyh2&_nc_oc=AdosZOZSix9rsX0hG8WBSjdrtPNpwBHBZy7jl9no1leG9Lh1Ofw41mLq7DcB47HwcgA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9ckJBOYIjAuGkXDYcJ0gz0PUTY5nenzdY6B3Qz9LMtg&oe=6B007E69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1030159778454753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86615252_1030159781788086_6855098289004622950_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvIHXW4FD0oQ7kNvwGo3wnq&_nc_oc=Adpq6x7YOyjVXXK5dvtO3rS2ClJWcPRwQn1u1WZE4uA3RNskiZP34kd5QrLmb4MV2sY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWz21c-qDbnsLJh3ugcOuQS8iLJrffbmO03XK96rZH2A&oe=6B008558"}, "display_name": "Throwing Challenge", "keywords": [], "long_description": "Welcome to \"Throwing Challenge,\" the exhilarating VR game that puts your accuracy, speed, and skill to the test. Dive into a fast-paced environment where each throw counts, and only the most precise players can achieve the highest scores. Whether you're a casual gamer or a competitive enthusiast, \"Throwing Challenge\" offers a thrilling and immersive experience that will keep you hooked.\nGame Overview\n\n\"Throwing Challenge\" is a dynamic virtual reality game where players aim to score points by tossing balls into various targets. The game features multiple levels, each designed to challenge your abilities and push your precision to the limit. From stationary targets to moving and mixed patterns, every round presents a new challenge and an opportunity to refine your throwing skills.", "short_description": "Welcome to \"Throwing Challenge,\" the exhilarating VR game that puts your accuracy, speed, and skill to the test. Dive into a fast-paced environment where each throw counts, and only the most precise players can achiev
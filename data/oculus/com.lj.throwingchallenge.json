luscdn.com/v/t64.5771-25/75363518_1173792500501574_2426979058473739643_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7c_pTk4hs1QQ7kNvwHKAZsS&_nc_oc=Adpt6yIJUZ3naau4vmGQ3N1EJ2EouqP3bZzfmZ1c4sVqo6rvp9lecwzy_JFm9WCUYAo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0pLYAnTkxlQWcfcJsC1bThavjDawycudS-9nNoaKuUQ&oe=6B032169"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1030159778454753", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615252_1030159781788086_6855098289004622950_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6MA_szAv94Q7kNvwGQ5GSr&_nc_oc=AdoRkkMcBpq5LcNUz-MxOJfZ5DfuQ35a74CT1rCLOw_Dh46qTA003tHiLhC-6rgxtWY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSsUUpgAyfoULQG9u7UFH3jfhQAZGdHij2WK8KHrbIeQ&oe=6B032858"}, "display_name": "Throwing Challenge", "keywords": [], "long_description": "Welcome to \"Throwing Challenge,\" the exhilarating VR game that puts your accuracy, speed, and skill to the test. Dive into a fast-paced environment where each throw counts, and only the most precise players can achieve the highest scores. Whether you're a casual gamer or a competitive enthusiast, \"Throwing Challenge\" offers a thrilling and immersive experience that will keep you hooked.\nGame Overview\n\n\"Throwing Challenge\" is a dynamic virtual reality game where players aim to score points by tossing balls into various targets. The game features multiple levels, each designed to challenge your abilities and push your precision to the limit. From stationary targets to moving and mixed patterns, every round presents a new challenge and an opportunity to refine your throwing skills.", "short_description": "Welcome to \"Throwing Challenge,\" the exhilarating VR game that puts your accuracy, speed, and skill to the test. Dive into a fast-paced environment where each throw counts, and only the most precise players can achiev
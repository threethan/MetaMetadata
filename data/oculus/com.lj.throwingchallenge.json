null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1030159778454753", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86615252_1030159781788086_6855098289004622950_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBjcewHyPWIQ7kNvwGzFf8-&_nc_oc=AdkDq6s-M2cXm9x7vNx0tLS-KvIgKcHESL2tez0bGzm5bollbzZ_75k999MZbGY0YYM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvdDkm84MsAzXP6WbgqAYVmt7pQncwtf2xjRQvtmr9HNg&oe=69A83598"}, "display_name": "Throwing Challenge", "keywords": [], "long_description": "Welcome to \"Throwing Challenge,\" the exhilarating VR game that puts your accuracy, speed, and skill to the test. Dive into a fast-paced environment where each throw counts, and only the most precise players can achieve the highest scores. Whether you're a casual gamer or a competitive enthusiast, \"Throwing Challenge\" offers a thrilling and immersive experience that will keep you hooked.\nGame Overview\n\n\"Throwing Challenge\" is a dynamic virtual reality game where players aim to score points by tossing balls into various targets. The game features multiple levels, each designed to challenge your abilities and push your precision to the limit. From stationary targets to moving and mixed patterns, every round presents a new challenge and an opportunity to refine your throwing skills.", "short_description": "Welcome to \"Throwing Challenge,\" the exhilarating VR game that puts your accuracy, speed, and skill to the test. Dive into a fast-paced environment where each throw counts, and only the most precise players can achieve the highest scores. Whether you're a casual gamer or a competitive enthusiast, \"Throwing Challenge\" offers a thrilling and immersive experience that will keep you hooked."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/throwing-challenge/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "LJ Invention", "support_website_url": null, "website_url":
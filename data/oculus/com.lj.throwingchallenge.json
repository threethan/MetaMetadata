luscdn.com/v/t64.5771-25/75363518_1173792500501574_2426979058473739643_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jg_NB-M-AFsQ7kNvwHR8DER&_nc_oc=AdrqNz_6NJV61jn8LftS242ENL7KQd7nTyvZf8pXJpZe_mLv2kAdE-ieNVpR34UkeXc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg9e2cuu5EbHQITnvwp9YbparKcrww8b5bwNCx4KPpjQ&oe=6AFDDB69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1030159778454753", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86615252_1030159781788086_6855098289004622950_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2BLqJxnYM4Q7kNvwFPx_7h&_nc_oc=AdrnQy5HJrnQheBQC_2j88bbXoTn9CDZkuUT4Fk0YGnOzTcxsvF67dh4hkMMsfmcrC4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUYstcwQt71DqUQAyemumcPr0o_3rN0iuyANR_0lWPAg&oe=6AFDE258"}, "display_name": "Throwing Challenge", "keywords": [], "long_description": "Welcome to \"Throwing Challenge,\" the exhilarating VR game that puts your accuracy, speed, and skill to the test. Dive into a fast-paced environment where each throw counts, and only the most precise players can achieve the highest scores. Whether you're a casual gamer or a competitive enthusiast, \"Throwing Challenge\" offers a thrilling and immersive experience that will keep you hooked.\nGame Overview\n\n\"Throwing Challenge\" is a dynamic virtual reality game where players aim to score points by tossing balls into various targets. The game features multiple levels, each designed to challenge your abilities and push your precision to the limit. From stationary targets to moving and mixed patterns, every round presents a new challenge and an opportunity to refine your throwing skills.", "short_description": "Welcome to \"Throwing Challenge,\" the exhilarating VR game that puts your accuracy, speed, and skill to the test. Dive into a fast-paced environment where each throw counts, and only the most precise players can achiev
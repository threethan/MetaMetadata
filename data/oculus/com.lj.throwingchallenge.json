gD1IjqKP1wLjP_-9lw&oe=6A5B7AA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1030159778454753", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86615252_1030159781788086_6855098289004622950_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9m48v_VetUQ7kNvwG1IbGv&_nc_oc=AdrJm-H9USrmsy3y1EDoQ4mveuOAiH4epf0dfFSGYmk27g9LeW3W1FsNUg6votqyUaE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVyJ0RQ8UtsgmFmVPxUiRAb8Q1E2sX2uCTJ_86Lblpjw&oe=6A5B8198"}, "display_name": "Throwing Challenge", "keywords": [], "long_description": "Welcome to \"Throwing Challenge,\" the exhilarating VR game that puts your accuracy, speed, and skill to the test. Dive into a fast-paced environment where each throw counts, and only the most precise players can achieve the highest scores. Whether you're a casual gamer or a competitive enthusiast, \"Throwing Challenge\" offers a thrilling and immersive experience that will keep you hooked.\nGame Overview\n\n\"Throwing Challenge\" is a dynamic virtual reality game where players aim to score points by tossing balls into various targets. The game features multiple levels, each designed to challenge your abilities and push your precision to the limit. From stationary targets to moving and mixed patterns, every round presents a new challenge and an opportunity to refine your throwing skills.", "short_description": "Welcome to \"Throwing Challenge,\" the exhilarating VR game that puts your accuracy, speed, and skill to the test. Dive into a fast-paced environment where each throw counts, and only the most precise players can achieve the highest scores. Whether you're a casual gamer or a competitive enthusiast, \"Throwing Challenge\" offers a thrilling and immersive experience that will keep you hooked."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/throwing-challenge/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "LJ
luscdn.com/v/t64.5771-25/75363518_1173792500501574_2426979058473739643_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqTIDxaYHnEQ7kNvwEQuI7G&_nc_oc=Adr7CONc4OMsh68diaGNcN8xYzwDqdaEUVJg6h5zKSX2MYo4SRTJChR4-o9Bfjs-lQU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQlNb6MyWEMuVYOXxH9CSnyy6cNxv0OZB6-udNZ653-Cg&oe=6B0B42A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1030159778454753", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86615252_1030159781788086_6855098289004622950_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMwT43ghs9AQ7kNvwEDcJSc&_nc_oc=AdqEkgjVoVscfEvQrHY3xlRlfvNzaKwpWrlRqMgcxiiZ8VGVhWgltUIN6xKSsL61Y9U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSTy6Sq0lOiNcY9sGeRxq3Jzkjpe4p_hfnqonOSf5fJjQ&oe=6B0B1158"}, "display_name": "Throwing Challenge", "keywords": [], "long_description": "Welcome to \"Throwing Challenge,\" the exhilarating VR game that puts your accuracy, speed, and skill to the test. Dive into a fast-paced environment where each throw counts, and only the most precise players can achieve the highest scores. Whether you're a casual gamer or a competitive enthusiast, \"Throwing Challenge\" offers a thrilling and immersive experience that will keep you hooked.\nGame Overview\n\n\"Throwing Challenge\" is a dynamic virtual reality game where players aim to score points by tossing balls into various targets. The game features multiple levels, each designed to challenge your abilities and push your precision to the limit. From stationary targets to moving and mixed patterns, every round presents a new challenge and an opportunity to refine your throwing skills.", "short_description": "Welcome to \"Throwing Challenge,\" the exhilarating VR game that puts your accuracy, speed, and skill to the test. Dive into a fast-paced environment where each throw counts, and only the most precise players can achiev
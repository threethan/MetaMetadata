07"}, {"file_name": "image4.png", "id": "1744818729434986", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391901_1744818732768319_2411961497414592792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axuve4hGH6wQ7kNvwFkEtHI&_nc_oc=AdmqaMwAQVQMl5vpqngtNEqzJYP4c1RIsOg2KriBSBXRgzfJULWVFnlrPjVLHvRfoRA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxrJOosC2C0PVs40ToQB-yuXq475evQxutxqQwaYAxesw&oe=69BD2920"}, {"file_name": "image3.png", "id": "616909720929393", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391855_616909727596059_2216789613611795912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mr0Rh3_oJR0Q7kNvwG9o0n0&_nc_oc=AdkN6_iRKUKlqSr8Vx1mldAUjhp2otck5OyIMIjmMLSV7n6Nz_Ci4WpINZsMIaDlkQg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIMhRR6CSxyJCT_rH_Sh1CKZ1xOhk72V0r8gV1JHmmPA&oe=69BD337A"}, {"file_name": "image2 (1).png", "id": "547255635014233", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391950_547255638347566_8243611706801042213_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2uWoTbDJx0Q7kNvwFFHsVs&_nc_oc=AdkDLepbc_3JFELl-KqP-BR6Qmz-ap4NmvEMIaHwEOs0JnowgfmV4iGhRimOLj1hGaw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy42kApNc60FsfmmJGgKEZkQIHefhfNtsIm0bGHPeFOog&oe=69BD2A80"}, {"file_name": "image1.png", "id": "4120886358140369", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392020_4120886361473702_6235863065542341744_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVkmLvcNdCEQ7kNvwHG50Az&_nc_oc=Adk1-S_BCu8U8Sq72SIzM-ZCTQMNzLO6V4zhTAXZUBtlsrfVwrKx7_0UDKeYtIYBCu4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8hLkktMPtvA20Yk8l6O7uKKs-_yDfjG0yrGb1BYQ_2A&oe=69BD4776"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Shadows", "keywords": [], "long_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n\nKey Features:\nFluid Parkour Movement: Run, jump, and climb seamlessly as you navigate intricate environments full of hidden paths and secret areas.\nDynamic Shadow World: Explore a unique setting where dark forests, abandoned ruins, and glowing caves create a visually stunning yet eerie landscape.\nStrategic Gameplay: Evade enemies, chase down opponents, and outsmart your friends in a variety of game modes like tag, hide-and-seek, and capture the orb.\nCustomizable Characters: Personalize your shadow creature with unique skins, glowing patterns, and accessories that match your style.\nSocial Multiplayer Experience: Join friends or meet new players in vibrant lobbies with proximity chat and cooperative mini-games.\nProject Shadows combines the physical challenge of tag with a dark and enigmatic world where every movement counts, every shadow hides a secret, and every game tells a new story. Can you master the shadows?", "short_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-shadows/", "developer_terms_of_service_url": null, "publisher_name": "illidarien", "support_website_url": null, "website_url": "https://sites.google.com/view/project-shadows/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "45978150496
_sid=6e7a0a&_nc_ohc=P9pAkTzpRx4Q7kNvwGHJSwh&_nc_oc=Adp-P63n8t9dByyfl--M180IrkYnJBh_9He6wsT7yRE7RinGKCl53gAQvfu4kU_fVKQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSwhuQi6r1Kidu5y6IWCzKpQ5LxghIy6AqJGX9m3rJHDA&oe=6B0DB4C7"}, {"file_name": "image4.png", "id": "1744818729434986", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391901_1744818732768319_2411961497414592792_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wRSWiCH7B0Q7kNvwGtu8vw&_nc_oc=AdqbSIVT5sXkkLkW32hHSZXTrnM5_uDN-qiyczJfnqhhGUO8DlNfurOwawvvcdh4FFA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRpJigwd8OS8ddcQ78eIRg_48TJ216MautyNWlf3ZiXvA&oe=6B0DC820"}, {"file_name": "image3.png", "id": "616909720929393", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391855_616909727596059_2216789613611795912_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frh1o3xR8rQQ7kNvwH2tDjr&_nc_oc=AdrKi5nH8Y9fzg855U4sdz4Wmv9ElT8uyM9XUNdsJHzvuA12kW55f0jVyhH4eOwHJrs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTSZrdh41K0ptk6kkz1B1dM6mAbocUJG7vMrkI_Xj21zg&oe=6B0D9A3A"}, {"file_name": "image2 (1).png", "id": "547255635014233", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391950_547255638347566_8243611706801042213_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpzAvWUhlZ8Q7kNvwEhQDVX&_nc_oc=Adp6h2oiFfNZw-6x7U7ZqnyEcXnMjY7e5tXfSP3U3t-N0fVEH5_WoQ_vdyaPW9fpVgU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT9bcOo7V-vAkC8ucxtuZFLw3UEOYorU8hx3wiL6TrkMQ&oe=6B0DC980"}, {"file_name": "image1.png", "id": "4120886358140369", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392020_4120886361473702_6235863065542341744_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGI7N4i5v3cQ7kNvwGCWw_b&_nc_oc=AdohShwS21kHydenNWeTaiYH4JfKZnPGOakWxwgEzB80HaLD3g0nyGsTc-k_R3x2qxw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ18SvbXZXJWZQoWSamK8rNOlktOoNt95InK-C0wcdg3Q&oe=6B0DAE36"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Shadows", "keywords": [], "long_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n\nKey Features:\nFluid Parkour Movement: Run, jump, and climb seamlessly as you navigate intricate environments full of hidden paths and secret areas.\nDynamic Shadow World: Explore a unique setting where dark forests, abandoned ruins, and glowing caves create a visually stunning yet eerie landscape.\nStrategic Gameplay: Evade enemies, chase down opponents, and outsmart your friends in a variety of game modes like tag, hide-and-seek, and capture the orb.\nCustomizable Characters: Personalize your shadow creature with unique skins, glowing patterns, and accessories that match your style.\nSocial Multiplayer Experience: Join friends or meet new players in vibrant lobbies with proximity chat and cooperative mini-games.\nProject Shadows combines the physical challenge of tag with a dark and enigmatic world where every movement counts, every shadow hides a secret, and every game tells a new story. Can you master the shadows?", "short_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-shadows/", "
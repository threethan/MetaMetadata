rViTLnDC_vMExoWPejoZK7v93g&oe=6A11AE07"}, {"file_name": "image4.png", "id": "1744818729434986", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391901_1744818732768319_2411961497414592792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_p87cRD-QDIQ7kNvwGThi6j&_nc_oc=Ado_00-f_vjZLMqK3qxeuLtZO3L8UTiC48R0ncopLWkWIWp86lJ-vjGwV7fnWCPf3UU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6C5uEZaEsgdR7Wfxe5ZObX4wd230Z8IW8VHcbv6CdGwQ&oe=6A11C160"}, {"file_name": "image3.png", "id": "616909720929393", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391855_616909727596059_2216789613611795912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ktorW1QQpEQ7kNvwF53jYv&_nc_oc=AdqbYF7X_k3VD5KiFw83HCFblaDmQ9twMP11j4Yng0I7YexNh431ONBtdDlrr1uUHAE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MZ6jlrrrT5jlxUfTVs1GtzknQgrzYgSZ1RogLjNuqgw&oe=6A11CBBA"}, {"file_name": "image2 (1).png", "id": "547255635014233", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391950_547255638347566_8243611706801042213_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4ljOVQtJToQ7kNvwFO5YYf&_nc_oc=AdrL3MrLz3pYwLilgTQkqh8WG8JoOfO2QYT3yY9DD2NhZGu8879Y5uaYh9NOnrLB-V0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Y8eWp5IZm7zVkat6b-ZsBppdcx9Q-jFg28_vDeQrPkA&oe=6A11C2C0"}, {"file_name": "image1.png", "id": "4120886358140369", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392020_4120886361473702_6235863065542341744_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25IhP6VEH_UQ7kNvwEIdCi8&_nc_oc=AdpUqvdxwx_fhDLjOwKvgNBiNKTJZ98WI6bY1cLPirrltpvSe1jNeo6iLyxrzpjvDUw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Dgx_7EjzjPhVfXiSHMG6zDEzrgNe1K3-c5Pe54xQySA&oe=6A11A776"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Shadows", "keywords": [], "long_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n\nKey Features:\nFluid Parkour Movement: Run, jump, and climb seamlessly as you navigate intricate environments full of hidden paths and secret areas.\nDynamic Shadow World: Explore a unique setting where dark forests, abandoned ruins, and glowing caves create a visually stunning yet eerie landscape.\nStrategic Gameplay: Evade enemies, chase down opponents, and outsmart your friends in a variety of game modes like tag, hide-and-seek, and capture the orb.\nCustomizable Characters: Personalize your shadow creature with unique skins, glowing patterns, and accessories that match your style.\nSocial Multiplayer Experience: Join friends or meet new players in vibrant lobbies with proximity chat and cooperative mini-games.\nProject Shadows combines the physical challenge of tag with a dark and enigmatic world where every movement counts, every shadow hides a secret, and every game tells a new story. Can you master the shadows?", "short_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-shadows/", "developer_terms_of_service_url": null, "publisher_name": "illidarien", "support_website_url": null, "website_url": "https://sites.google.com/view/project-shadows/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_cat
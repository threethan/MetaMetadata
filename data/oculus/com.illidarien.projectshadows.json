bm0rlTFX-2FufN0mzPQokQ&oe=6A5A3087"}, {"file_name": "image4.png", "id": "1744818729434986", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391901_1744818732768319_2411961497414592792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PertBxqNC4Q7kNvwEwSJVf&_nc_oc=AdrLXozbbr2gpEFolqlweVeF0NMQm5F_7jx_yjpJRbMbQ1jyp7Sjb1i39WgN91nG8YI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBX_ciWy2mKNE7Qdj910YBTQtpU3PyITE58Wuikq7crBw&oe=6A5A43E0"}, {"file_name": "image3.png", "id": "616909720929393", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391855_616909727596059_2216789613611795912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Opcji7J38CwQ7kNvwEyvg3P&_nc_oc=AdrrzCwMMQxhSQYlJZYh7YTnMPLfio6IU5GsDn3PJXB3Rf9DJBWvVq3RvN35jhXEAFo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA66lN458WnYPUU1r7PItK9OALGiwnl899hjbhSR580IQ&oe=6A5A15FA"}, {"file_name": "image2 (1).png", "id": "547255635014233", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391950_547255638347566_8243611706801042213_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUcIJPnKXfQQ7kNvwF0lRRA&_nc_oc=AdqrimvdTzwywCegj5VdXNfycSrSh-JT0371ptUs4utyin8b7NdjPrOygt5Xm5ShWTM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJIc8aOwvVdcMKFXVvWddhmnkz1ewA8QdbfhAa1wjvWQ&oe=6A5A4540"}, {"file_name": "image1.png", "id": "4120886358140369", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473392020_4120886361473702_6235863065542341744_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nj6nTJEchHQQ7kNvwGoG9Rm&_nc_oc=AdrvtB7vTP0ITcKLiguqIO83oW4IwbteHEcX9WSP7svXBqTwieBZukmrNJXD4lT4mG8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDM8nvfBjBOe1tFOXD17HP8e3jU1RexKCUxTz4Urn4rGQ&oe=6A5A29F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Shadows", "keywords": [], "long_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n\nKey Features:\nFluid Parkour Movement: Run, jump, and climb seamlessly as you navigate intricate environments full of hidden paths and secret areas.\nDynamic Shadow World: Explore a unique setting where dark forests, abandoned ruins, and glowing caves create a visually stunning yet eerie landscape.\nStrategic Gameplay: Evade enemies, chase down opponents, and outsmart your friends in a variety of game modes like tag, hide-and-seek, and capture the orb.\nCustomizable Characters: Personalize your shadow creature with unique skins, glowing patterns, and accessories that match your style.\nSocial Multiplayer Experience: Join friends or meet new players in vibrant lobbies with proximity chat and cooperative mini-games.\nProject Shadows combines the physical challenge of tag with a dark and enigmatic world where every movement counts, every shadow hides a secret, and every game tells a new story. Can you master the shadows?", "short_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-shadows/", "developer_terms_of_service_url": null, "publisher_name": "illidarien", "support_website_url": null, "website_url": "https://sites.google.com/view/project-shadows/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": 
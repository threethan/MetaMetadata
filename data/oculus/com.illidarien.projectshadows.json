&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0cW9YaFVxcQ7kNvwFglKav&_nc_oc=AdqSEO5sI13jVXvvcPdfvY3JaJDq8dtaSb9hrLSVrHDIBis9wUzHuwRvXm5sBijXUOU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2iVeipxX4gIuIvZju_5xOaDIYzlryP4TanYfmD1n51w&oe=6AE4A738"}, {"file_name": "75254874_1733474850722542_9221363956123730303_n.png", "id": "2077835749336227", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569446_2077835752669560_2476896584840256508_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGdLo8zGPzsQ7kNvwHPi4md&_nc_oc=AdreBgctk24JP-N_RcGP0CHyk7lcYyYCD6C4Q1540abnlYxnsUgZPZhriL5Jh1N7nyY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaqZt_0ZKQ4Tx-1zVY6OrHH1w-LCRa-cdupKZO3BzBIw&oe=6AE4948F"}, {"file_name": "38974595_8281888881938400_61129300981539351_n.png", "id": "2639709916223789", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974764_2639709919557122_2265535193227989834_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-64nxutnip8Q7kNvwGEoa5n&_nc_oc=Adrj31Ey7LJ_Elx4EVB97x8mqYDbk93fB26gQQZVsO2bR8AZ2h0wY0ksumL3masqfRE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNIoDdF7ZwP5FdAX-zH8Wx88ElR6eK7n-AHzp2DdCw5A&oe=6AE48AB3"}, {"file_name": "38974628_2297796067270525_6472626653883828740_n.png", "id": "2055989221497108", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75422374_2055989224830441_3611853246513983908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4GjhGrWoSEQ7kNvwEa1sne&_nc_oc=AdpSpoJaX31F9jbAb_5QlMno9fzs-yw19dsq0aOoF5LlDORA4Sm6ed4x3l1HkZIoqso&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNl3gojRqv6YY7TpIxUdvmX03MUkiCaNKlikE0tO87Hkw&oe=6AE4997E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Shadows", "keywords": [], "long_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n\nKey Features:\nFluid Parkour Movement: Run, jump, and climb seamlessly as you navigate intricate environments full of hidden paths and secret areas.\nDynamic Shadow World: Explore a unique setting where dark forests, abandoned ruins, and glowing caves create a visually stunning yet eerie landscape.\nStrategic Gameplay: Evade enemies, chase down opponents, and outsmart your friends in a variety of game modes like tag, hide-and-seek, and capture the orb.\nCustomizable Characters: Personalize your shadow creature with unique skins, glowing patterns, and accessories that match your style.\nSocial Multiplayer Experience: Join friends or meet new players in vibrant lobbies with proximity chat and cooperative mini-games.\nProject Shadows combines the physical challenge of tag with a dark and enigmatic world where every movement counts, every shadow hides a secret, and every game tells a new story. Can you master the shadows?", "short_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-shadows/", "developer_terms_of_service_url": null, "publisher_name": "illidarien", "support_website_url": null, "website_url": "https://sites.google.com/view/project-shadows/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "275629
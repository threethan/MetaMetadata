&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmxNFZ2LV2MQ7kNvwGl3tmK&_nc_oc=Adr78CddnjiiNX4huoft54C31l69yGLLa4HCyltQq8fAtXFyGfzMpOzkYl5rd4SAKsw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ifGmixPJgpXrwrHx7T2jsXsuKXxRaMWrsRaxflMcF9A&oe=69F9FC38"}, {"file_name": "75254874_1733474850722542_9221363956123730303_n.png", "id": "2077835749336227", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569446_2077835752669560_2476896584840256508_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=giV2HJmL_fAQ7kNvwFX2jM4&_nc_oc=Adryz1kh_kD-qI44w88-iif6rVoIFQ2SkXc9LeUmlsexezORBl3okwK12bhin2yPi3Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cn68aMn7ynrJkNcJdFaeingB21Ly1RuzD2NQDsVs60w&oe=69F9E98F"}, {"file_name": "38974595_8281888881938400_61129300981539351_n.png", "id": "2639709916223789", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974764_2639709919557122_2265535193227989834_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4ZPQ7Dyv8kQ7kNvwG8rkut&_nc_oc=Adpokg-h49iW7TB9iAoZGwsAByI8tTfZRmjwroxTUj_7WwQyNHogPm1R2_GDEK5EruU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-9Tpnt_T03OIJepkFyB75Gep-q8b8KHQ0A8wvbtAOMw&oe=69F9DFB3"}, {"file_name": "38974628_2297796067270525_6472626653883828740_n.png", "id": "2055989221497108", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422374_2055989224830441_3611853246513983908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVuFyrnKGcoQ7kNvwFlVDGs&_nc_oc=AdrYw6FvizQhmDC3HVnS6-52gYSi2EjAVTr8VLEtNIhAyCarGlvKaexxrc4bHytYMxM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58PPukQYl6JwpYmGdlIcQvBiYXR1mkU0JYIxaYNRPj3A&oe=69F9EE7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Shadows", "keywords": [], "long_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n\nKey Features:\nFluid Parkour Movement: Run, jump, and climb seamlessly as you navigate intricate environments full of hidden paths and secret areas.\nDynamic Shadow World: Explore a unique setting where dark forests, abandoned ruins, and glowing caves create a visually stunning yet eerie landscape.\nStrategic Gameplay: Evade enemies, chase down opponents, and outsmart your friends in a variety of game modes like tag, hide-and-seek, and capture the orb.\nCustomizable Characters: Personalize your shadow creature with unique skins, glowing patterns, and accessories that match your style.\nSocial Multiplayer Experience: Join friends or meet new players in vibrant lobbies with proximity chat and cooperative mini-games.\nProject Shadows combines the physical challenge of tag with a dark and enigmatic world where every movement counts, every shadow hides a secret, and every game tells a new story. Can you master the shadows?", "short_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-shadows/", "developer_terms_of_service_url": null, "publisher_name": "illidarien", "support_website_url": null, "website_url": "https://sites.google.com/view/project-shadows/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "275629
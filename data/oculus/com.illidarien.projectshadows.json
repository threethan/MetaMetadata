07"}, {"file_name": "image4.png", "id": "1744818729434986", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391901_1744818732768319_2411961497414592792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSeohkqikY4Q7kNvwEgR-LD&_nc_oc=AdkJc99pbiXN5ZO3QimnLTlZ6MEBmap4GomDjgTKoCMMkpVveKvHX9ey8jIy9CExpqs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftwoeGteOkx7ZfSwl5zSOvtVlIxSlafxAEsmOyNZRUtuA&oe=69A81120"}, {"file_name": "image3.png", "id": "616909720929393", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391855_616909727596059_2216789613611795912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcZRQdVwQGgQ7kNvwFd6jYd&_nc_oc=Adl5qmze46yzC1nrEqRg6-r0abg3zklpwvt0jdq0M2_keNZoqZu-kd_WAZIDveKtKOE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftNl63r92BRKxr4Djj6tNYpIyXjEV5iYI38QFT__PT-Sg&oe=69A81B7A"}, {"file_name": "image2 (1).png", "id": "547255635014233", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391950_547255638347566_8243611706801042213_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roXqhBCDjQcQ7kNvwGcEWeq&_nc_oc=AdkgDSxCcWtAHsnOvYRtezutlc2z0EoIdD9q6nFJbLwzkyVU9AORJyNF6B1iHG7i418&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuZAIuu6qebOFgpjVNZEztkv8A4xwOWtSFpEkFzWIhsFw&oe=69A81280"}, {"file_name": "image1.png", "id": "4120886358140369", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392020_4120886361473702_6235863065542341744_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLf20HwxazwQ7kNvwHBDG_e&_nc_oc=AdluIrVgx4CsIko9WR6l9QN9R2LO57tk2k2_2bk9t-VHEITibuJw3xqlkTKGhisLDws&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afvx-K2FhUGWUMkjxwidl4gxlqPWiTBBF6gu_gcOgSORUQ&oe=69A82F76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Shadows", "keywords": [], "long_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n\nKey Features:\nFluid Parkour Movement: Run, jump, and climb seamlessly as you navigate intricate environments full of hidden paths and secret areas.\nDynamic Shadow World: Explore a unique setting where dark forests, abandoned ruins, and glowing caves create a visually stunning yet eerie landscape.\nStrategic Gameplay: Evade enemies, chase down opponents, and outsmart your friends in a variety of game modes like tag, hide-and-seek, and capture the orb.\nCustomizable Characters: Personalize your shadow creature with unique skins, glowing patterns, and accessories that match your style.\nSocial Multiplayer Experience: Join friends or meet new players in vibrant lobbies with proximity chat and cooperative mini-games.\nProject Shadows combines the physical challenge of tag with a dark and enigmatic world where every movement counts, every shadow hides a secret, and every game tells a new story. Can you master the shadows?", "short_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-shadows/", "developer_terms_of_service_url": null, "publisher_name": "illidarien", "support_website_url": null, "website_url": "https://sites.google.com/view/project-shadows/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "45978150496
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_1W6KLUSFoQ7kNvwGgiiL8&_nc_oc=AdoSUzR-Q6eWE1YlE0T22seFZVY7yzVla5ihNIY_dVQ37joZaApxwvhHT2V-gxZkjdA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRsgnec88OsK7BjmaKrFnb9oZTg0sR_QQ3iKCt6Hk4uA&oe=6ADF6138"}, {"file_name": "75254874_1733474850722542_9221363956123730303_n.png", "id": "2077835749336227", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569446_2077835752669560_2476896584840256508_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__aShkFC6P4Q7kNvwFzSuDs&_nc_oc=AdrDpSf6Wi-f-hQh6jH4wVd60keQZLnucikh7ExzdCpAIN_YWm7d0a9oi39knCK6SJg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPipV13RK_S5TzZo6Ja5CenRAnD3QIZ_ZQUUt0-TbIO7A&oe=6ADF4E8F"}, {"file_name": "38974595_8281888881938400_61129300981539351_n.png", "id": "2639709916223789", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974764_2639709919557122_2265535193227989834_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=peF_kSEbuQEQ7kNvwGnpoVZ&_nc_oc=Adq62WhvCv1FRzAlsPBsDuu2uv1tewBip-Kxlgf_QeSDxwvIIld_PZxNU8NwLC6e7PM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcbBSydk5G_egfvHJeCB00cTX0m-qvysOnu4Tv2lylfg&oe=6ADF44B3"}, {"file_name": "38974628_2297796067270525_6472626653883828740_n.png", "id": "2055989221497108", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422374_2055989224830441_3611853246513983908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFRAqK02x0IQ7kNvwGJic8x&_nc_oc=AdqJ-_U80QT-07aNT32IO3qNf-fvlO2b_z8BD7CShCWod7Qsty4TbYA6Nq2ANpzpnOk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrdQzHoYVw7oJRw3ylgZbxeTwjwSMZ1odQYKiiJR45JA&oe=6ADF537E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Shadows", "keywords": [], "long_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n\nKey Features:\nFluid Parkour Movement: Run, jump, and climb seamlessly as you navigate intricate environments full of hidden paths and secret areas.\nDynamic Shadow World: Explore a unique setting where dark forests, abandoned ruins, and glowing caves create a visually stunning yet eerie landscape.\nStrategic Gameplay: Evade enemies, chase down opponents, and outsmart your friends in a variety of game modes like tag, hide-and-seek, and capture the orb.\nCustomizable Characters: Personalize your shadow creature with unique skins, glowing patterns, and accessories that match your style.\nSocial Multiplayer Experience: Join friends or meet new players in vibrant lobbies with proximity chat and cooperative mini-games.\nProject Shadows combines the physical challenge of tag with a dark and enigmatic world where every movement counts, every shadow hides a secret, and every game tells a new story. Can you master the shadows?", "short_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-shadows/", "developer_terms_of_service_url": null, "publisher_name": "illidarien", "support_website_url": null, "website_url": "https://sites.google.com/view/project-shadows/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "275629
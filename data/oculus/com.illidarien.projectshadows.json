87"}, {"file_name": "image4.png", "id": "1744818729434986", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391901_1744818732768319_2411961497414592792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axuve4hGH6wQ7kNvwH7Y6pS&_nc_oc=AdmZqBGEnGsJ4YGlgUDJLSPvMV0cVFOgrkBfRkjVUynfSOo-1dFKl0JQxlapiwyAYGY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwyr7qcyMOHglpZ6DZe0ahTRRXtsUxxfzozI5dKwmztlA&oe=69BBD7A0"}, {"file_name": "image3.png", "id": "616909720929393", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391855_616909727596059_2216789613611795912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mr0Rh3_oJR0Q7kNvwF-2Rzu&_nc_oc=Adm8Lu90V3rgRy1P6vcEdoKdXpj54Q9lXsWXTv0T51k1IOdkQU_Xt13NLbUHjy2gD3A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx_x0NOhKIjeFk5_A6JypQWtmjymzm9-62sRmWxEtNHdQ&oe=69BBE1FA"}, {"file_name": "image2 (1).png", "id": "547255635014233", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391950_547255638347566_8243611706801042213_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0r8_I2T7EwQ7kNvwFFt3K6&_nc_oc=AdlrU6dHI0TY_5fumb-ttSwVvC_ji1pv6-_kXdEZE7FomF4jfykE_ATUZoS0f9zJvDQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwoGBEqjblnqDlmEMNJc3zXfipMfTCmNuxlVq88LvjhGQ&oe=69BBD900"}, {"file_name": "image1.png", "id": "4120886358140369", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392020_4120886361473702_6235863065542341744_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVkmLvcNdCEQ7kNvwHrTsnb&_nc_oc=AdlkWgK9TZJxE61-4npG9Fy_o9fq7OeETRLCAXSijigAWolOfdflhaLMi6bLz9rZ_tk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzoxbT5eRi7-ytDcGlmtggbqg4diX7Jba1ySMmGZjbM6w&oe=69BBF5F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Shadows", "keywords": [], "long_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n\nKey Features:\nFluid Parkour Movement: Run, jump, and climb seamlessly as you navigate intricate environments full of hidden paths and secret areas.\nDynamic Shadow World: Explore a unique setting where dark forests, abandoned ruins, and glowing caves create a visually stunning yet eerie landscape.\nStrategic Gameplay: Evade enemies, chase down opponents, and outsmart your friends in a variety of game modes like tag, hide-and-seek, and capture the orb.\nCustomizable Characters: Personalize your shadow creature with unique skins, glowing patterns, and accessories that match your style.\nSocial Multiplayer Experience: Join friends or meet new players in vibrant lobbies with proximity chat and cooperative mini-games.\nProject Shadows combines the physical challenge of tag with a dark and enigmatic world where every movement counts, every shadow hides a secret, and every game tells a new story. Can you master the shadows?", "short_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-shadows/", "developer_terms_of_service_url": null, "publisher_name": "illidarien", "support_website_url": null, "website_url": "https://sites.google.com/view/project-shadows/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "45978150496
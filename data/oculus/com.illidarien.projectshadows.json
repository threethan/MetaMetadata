&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2XhTSWWgm0Q7kNvwGki-_A&_nc_oc=AdomthApuB6G3P0l5Rg_s_mMejwNtI-OilnF6N_73rJvo8vLumqn4sxatB4l9XpiHkU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KjpLauQ_LJVA9h_NaJkDyjiD8r7B7dfgglVeglIYtqA&oe=69DA5838"}, {"file_name": "75254874_1733474850722542_9221363956123730303_n.png", "id": "2077835749336227", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569446_2077835752669560_2476896584840256508_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2A8lXwncKsQ7kNvwFN-D9y&_nc_oc=Adr9KCkefOffsjYwnTZ0aKSxW_4rU3vsSuwBMRWtm3TjtJX5q85o81ZYurWnFSaP_AA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dTrd7SuZLP12gY4FYdWntD5rMfK52ULpw1asme98XoQ&oe=69DA458F"}, {"file_name": "38974595_8281888881938400_61129300981539351_n.png", "id": "2639709916223789", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974764_2639709919557122_2265535193227989834_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YOxMZhepL8Q7kNvwEDOLQ8&_nc_oc=Adqfm5HkHMlVl3uDim3eE6tPuOzAX7nSTD60Z6pTRrDeP8ROhvqubJ0SevXAc6M_ydA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39EM5OH5bsQqfm6m3q1UNfrLEznv6FV-0GWO_LrHL9zQ&oe=69DA3BB3"}, {"file_name": "38974628_2297796067270525_6472626653883828740_n.png", "id": "2055989221497108", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422374_2055989224830441_3611853246513983908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--3jRpEye8MQ7kNvwGcW_ym&_nc_oc=Adof3_zfF4QZ7fIiXKTC1Ztty7lynlSJxH8YH82j5oyGquiExn63t_RB9mvrNz2ckjo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33uxzmoCjaobUCpwPtlZCZkqtJJrxMt510cm9VE0alKw&oe=69DA4A7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Shadows", "keywords": [], "long_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n\nKey Features:\nFluid Parkour Movement: Run, jump, and climb seamlessly as you navigate intricate environments full of hidden paths and secret areas.\nDynamic Shadow World: Explore a unique setting where dark forests, abandoned ruins, and glowing caves create a visually stunning yet eerie landscape.\nStrategic Gameplay: Evade enemies, chase down opponents, and outsmart your friends in a variety of game modes like tag, hide-and-seek, and capture the orb.\nCustomizable Characters: Personalize your shadow creature with unique skins, glowing patterns, and accessories that match your style.\nSocial Multiplayer Experience: Join friends or meet new players in vibrant lobbies with proximity chat and cooperative mini-games.\nProject Shadows combines the physical challenge of tag with a dark and enigmatic world where every movement counts, every shadow hides a secret, and every game tells a new story. Can you master the shadows?", "short_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-shadows/", "developer_terms_of_service_url": null, "publisher_name": "illidarien", "support_website_url": null, "website_url": "https://sites.google.com/view/project-shadows/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "275629
87"}, {"file_name": "image4.png", "id": "1744818729434986", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391901_1744818732768319_2411961497414592792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwAXT_-F4nQQ7kNvwHBOcBs&_nc_oc=Adnmkx4NHkRn1lcV1l4tCf7C8yP1Q9NKf9LuNhh5PnK3ZG3l07o5s0RlY9Fk1vjSXB8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzVUdW5WnPKRAYhWfcZUVdu2rtVheIk2VWd3Fokb3A6hQ&oe=69AC05A0"}, {"file_name": "image3.png", "id": "616909720929393", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391855_616909727596059_2216789613611795912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0X_CG60r64Q7kNvwE7Q0I_&_nc_oc=AdkJ0deJfznRroXKFkDduZtOB88VOnngMt3FVqPcOLO3LZVvahCmuGlbUULJUB--Nb0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxKB0SR6765J-y3l3eRU_apSAex90yctOHe17h8cQklvA&oe=69AC0FFA"}, {"file_name": "image2 (1).png", "id": "547255635014233", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391950_547255638347566_8243611706801042213_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1oVO3_yLpkQ7kNvwGILigy&_nc_oc=AdlawRYu-GSlpQ06jXn_Ba80QbtpKtG2ot0JTsenKPKFRrYmIjXV2e3n5GoMQP3C1TM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxx3iD_T5dPRU_Y3yZno32rDJKJlhNrK2fSCkBCYoZBow&oe=69AC0700"}, {"file_name": "image1.png", "id": "4120886358140369", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392020_4120886361473702_6235863065542341744_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJuhiqw-uI8Q7kNvwFBMAXA&_nc_oc=AdmfUuWba8wuKEQm8rAw1wISML42C8tPJDWXA3Y5v31frUoeiLSrtUj2BXOoXy7yTfk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzVqTY89upOUUOhOgXQqk275Wep57SYVBFO1Ku5aSkV4Q&oe=69AC23F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Shadows", "keywords": [], "long_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n\nKey Features:\nFluid Parkour Movement: Run, jump, and climb seamlessly as you navigate intricate environments full of hidden paths and secret areas.\nDynamic Shadow World: Explore a unique setting where dark forests, abandoned ruins, and glowing caves create a visually stunning yet eerie landscape.\nStrategic Gameplay: Evade enemies, chase down opponents, and outsmart your friends in a variety of game modes like tag, hide-and-seek, and capture the orb.\nCustomizable Characters: Personalize your shadow creature with unique skins, glowing patterns, and accessories that match your style.\nSocial Multiplayer Experience: Join friends or meet new players in vibrant lobbies with proximity chat and cooperative mini-games.\nProject Shadows combines the physical challenge of tag with a dark and enigmatic world where every movement counts, every shadow hides a secret, and every game tells a new story. Can you master the shadows?", "short_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-shadows/", "developer_terms_of_service_url": null, "publisher_name": "illidarien", "support_website_url": null, "website_url": "https://sites.google.com/view/project-shadows/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "45978150496
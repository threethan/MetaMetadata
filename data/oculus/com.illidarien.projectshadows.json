6YRPxQ-X3KPpAQ_3Nrcu8Tmqew&oe=6A393B07"}, {"file_name": "image4.png", "id": "1744818729434986", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391901_1744818732768319_2411961497414592792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzsJHH7-rg4Q7kNvwEEyL-F&_nc_oc=AdpbPnkkL4sZPBy8f0qmB36uVZNH4BD40-3B8Nua4j3NEk02Nl09IGJ6ncUnuHErkhc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qEFvJfp3_ACPsfLwu7m7MQ5tN-YO_HxywJGkEHpuSKA&oe=6A394E60"}, {"file_name": "image3.png", "id": "616909720929393", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391855_616909727596059_2216789613611795912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpfTMyqsXxgQ7kNvwHtYJFX&_nc_oc=AdoSX1tW9yqiFOq1T35WEk_PMjaY9XnBfxKemkR9OX1ahsFvXD809O5SMOvE1hDDsMs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RPyumWnsyGx7HlqimDcxejx4lcBwsD-bSnwlcI2P0IA&oe=6A3958BA"}, {"file_name": "image2 (1).png", "id": "547255635014233", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391950_547255638347566_8243611706801042213_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdRkOzAQiTsQ7kNvwGkHFpD&_nc_oc=Adq1S7Pb1ha929dIkuBURMsEQCcUbZcimfcn9nDPxNaFsnKmRFzQzSjI71f0bvbBrmQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8D2sGa7EeIt_nD0_hIIur_fkWOalIyJrmZjlp9gVgwMw&oe=6A394FC0"}, {"file_name": "image1.png", "id": "4120886358140369", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392020_4120886361473702_6235863065542341744_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRgXa9D0XOQQ7kNvwGT_bb2&_nc_oc=Adq7w0mbOJE0Hiuz6jCApRtrmGRWCUr3YJHsumdJxhQWvOaUTQxjxbGe-BfcMbBLt5g&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Y29BgAQoIzvOKG_Cb8vkhL2fqzElhKKWKLfLjNwbRsw&oe=6A393476"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Shadows", "keywords": [], "long_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n\nKey Features:\nFluid Parkour Movement: Run, jump, and climb seamlessly as you navigate intricate environments full of hidden paths and secret areas.\nDynamic Shadow World: Explore a unique setting where dark forests, abandoned ruins, and glowing caves create a visually stunning yet eerie landscape.\nStrategic Gameplay: Evade enemies, chase down opponents, and outsmart your friends in a variety of game modes like tag, hide-and-seek, and capture the orb.\nCustomizable Characters: Personalize your shadow creature with unique skins, glowing patterns, and accessories that match your style.\nSocial Multiplayer Experience: Join friends or meet new players in vibrant lobbies with proximity chat and cooperative mini-games.\nProject Shadows combines the physical challenge of tag with a dark and enigmatic world where every movement counts, every shadow hides a secret, and every game tells a new story. Can you master the shadows?", "short_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-shadows/", "developer_terms_of_service_url": null, "publisher_name": "illidarien", "support_website_url": null, "website_url": "https://sites.google.com/view/project-shadows/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_cat
WblY_hBGoVkn3Wk4nJd2ZvRYUQ&oe=6AA40487"}, {"file_name": "image4.png", "id": "1744818729434986", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391901_1744818732768319_2411961497414592792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOYkaOOBIKMQ7kNvwGgzMfL&_nc_oc=AdqQDuiHPy4EQ4v93QVY0rkjmMNWVYmHUAhfXucfBs6XwI84qi5CZUU8Dd_ri-wdF34&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXnstQpU35oRkxaAJWndoDBVvCNHUebl7pZ4rhudQ7-w&oe=6AA417E0"}, {"file_name": "image3.png", "id": "616909720929393", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391855_616909727596059_2216789613611795912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObuyaifXJUcQ7kNvwGJoj21&_nc_oc=Adp49yM6inD3_BgIDMolq4ZFkl4bGRXO8EvzgFigwyF5EOoh2EByIkYdS4o4g6x7Cow&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeXDtJnnqeNFSHBH2TL_0DkR8rjl5OLwwct2I_aukGZw&oe=6AA4223A"}, {"file_name": "image2 (1).png", "id": "547255635014233", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391950_547255638347566_8243611706801042213_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxRFhCtVzW8Q7kNvwFUMnCD&_nc_oc=AdpSmXf2gWgbthwNX8m5V6pzDtslLoAJItPCUGXJvzZBaj2jUmXBX3u_UNuRAkQNFO0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZe5KRQbfbrN5jgrpOj9HmlTzi3eDJkXVPMO14kJcFDw&oe=6AA41940"}, {"file_name": "image1.png", "id": "4120886358140369", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392020_4120886361473702_6235863065542341744_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uzv0RmrcLPcQ7kNvwGsnxLW&_nc_oc=Adqh1PGzZGcqvK5_gM_d0fe9AK-_NMEB305TS5-gKo_gl5LhiP6wwD6qUDOj7uagSuA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLybfIPJIEeoUVLooLhDmJa6llmJEfyHL2v_R0U5sHPFA&oe=6AA3FDF6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Shadows", "keywords": [], "long_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n\nKey Features:\nFluid Parkour Movement: Run, jump, and climb seamlessly as you navigate intricate environments full of hidden paths and secret areas.\nDynamic Shadow World: Explore a unique setting where dark forests, abandoned ruins, and glowing caves create a visually stunning yet eerie landscape.\nStrategic Gameplay: Evade enemies, chase down opponents, and outsmart your friends in a variety of game modes like tag, hide-and-seek, and capture the orb.\nCustomizable Characters: Personalize your shadow creature with unique skins, glowing patterns, and accessories that match your style.\nSocial Multiplayer Experience: Join friends or meet new players in vibrant lobbies with proximity chat and cooperative mini-games.\nProject Shadows combines the physical challenge of tag with a dark and enigmatic world where every movement counts, every shadow hides a secret, and every game tells a new story. Can you master the shadows?", "short_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-shadows/", "developer_terms_of_service_url": null, "publisher_name": "illidarien", "support_website_url": null, "website_url": "https://sites.google.com/view/project-shadows/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_cat
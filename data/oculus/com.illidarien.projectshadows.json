_sid=6e7a0a&_nc_ohc=5bcU3vru5SwQ7kNvwG3w48b&_nc_oc=AdoP20fi_UFdkKcoVH20NF07PgiNu87jD_RDsibuV-59HOk6iG0KTyrjqbXEvWqlr-A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS850jBImlaQd0SaSZRaKV8TsUpwJV0iIZIM4ltUTlXnQ&oe=6AFB3FC7"}, {"file_name": "image4.png", "id": "1744818729434986", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391901_1744818732768319_2411961497414592792_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHivM7WqO0YQ7kNvwGrf_GK&_nc_oc=AdqGxnQ5QkjiVFUD_NgMrKU9pWczdLwy_yhyeC7_tq7yT9zNuD09yK3duF6JK3LKZZI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYeIDJ_MMC2xpc66McTuWp5kmginM3Z6G7d8neMtADxA&oe=6AFB1AE0"}, {"file_name": "image3.png", "id": "616909720929393", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391855_616909727596059_2216789613611795912_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJnzydEVFSQQ7kNvwH20K6g&_nc_oc=Adra6UnGhA1FW36V_TXUcLU04prTro-_o5zXwVZuKs5k17RHCPol-K95n7wnzrxJzIA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGnpyPkQ62beOi8pkzdxA65GKNSC2jEs0fipxUfnRIaw&oe=6AFB253A"}, {"file_name": "image2 (1).png", "id": "547255635014233", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391950_547255638347566_8243611706801042213_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zM9U2j2D8sQ7kNvwE2rr07&_nc_oc=AdqUrYiYR_Iybw65w2KuM5i9SWA1pGk4lP3uWBfu0-UyeYV3kAZAEANehNONi1ePWJw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUcKT_bqkKsobQrTOlF8hQXu6nVw-X3g0YeMY2vWq7JA&oe=6AFB1C40"}, {"file_name": "image1.png", "id": "4120886358140369", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392020_4120886361473702_6235863065542341744_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DW54_MdcJZ0Q7kNvwFbGeaR&_nc_oc=AdoKP0OiyM2bWLxvSjeJrwqSy93rZjyiyiz52EAOsV1YS9JFbRjXWuNaHLbs9gH2sg4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOPCF2Gb_TNM38rw_lJL0lPskeXie7TdMPQqv4-Kn9Gw&oe=6AFB3936"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Shadows", "keywords": [], "long_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n\nKey Features:\nFluid Parkour Movement: Run, jump, and climb seamlessly as you navigate intricate environments full of hidden paths and secret areas.\nDynamic Shadow World: Explore a unique setting where dark forests, abandoned ruins, and glowing caves create a visually stunning yet eerie landscape.\nStrategic Gameplay: Evade enemies, chase down opponents, and outsmart your friends in a variety of game modes like tag, hide-and-seek, and capture the orb.\nCustomizable Characters: Personalize your shadow creature with unique skins, glowing patterns, and accessories that match your style.\nSocial Multiplayer Experience: Join friends or meet new players in vibrant lobbies with proximity chat and cooperative mini-games.\nProject Shadows combines the physical challenge of tag with a dark and enigmatic world where every movement counts, every shadow hides a secret, and every game tells a new story. Can you master the shadows?", "short_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-shadows/", "
474850722542_9221363956123730303_n.png", "id": "2077835749336227", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569446_2077835752669560_2476896584840256508_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKq8ju0bhQIQ7kNvwEEKnPa&_nc_oc=AdljJdcZo0EI5GkRFnA1Ut7F0w5FrpkOC0dKmSdDHAs3iGE2zzyH7OFPLCfbHQpaDOw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsY9J7w0jTsdAswnrKyJWYiuAzBN1irIWmlq0jTzuzeAA&oe=699EF20F"}, {"file_name": "38974595_8281888881938400_61129300981539351_n.png", "id": "2639709916223789", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974764_2639709919557122_2265535193227989834_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzGpqQ7_MIoQ7kNvwGzuIHN&_nc_oc=Admcm3BqRiU4hNjiMHUolztGEGix6ePm1xtKo3dR3QdsASEa0uQVtY40nGNumq0VUco&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftuIc4tm5g_jpBgqSaw4C6ZhuRtKVE1yRa2GQ8jWJNdXw&oe=699EE833"}, {"file_name": "38974628_2297796067270525_6472626653883828740_n.png", "id": "2055989221497108", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422374_2055989224830441_3611853246513983908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGAgYTphxncQ7kNvwHth2ak&_nc_oc=AdlbHPtsIBNbi3tmN-Da2L8v-tlnA2WHU7Rt8F6koKcw2bomtHY6a3FiW9K8sjUQABA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv83kdhOec7_27Bi02Bpvx5u5TvcjThOGBpVPsDCYGMrQ&oe=699EF6FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Shadows", "keywords": [], "long_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n\nKey Features:\nFluid Parkour Movement: Run, jump, and climb seamlessly as you navigate intricate environments full of hidden paths and secret areas.\nDynamic Shadow World: Explore a unique setting where dark forests, abandoned ruins, and glowing caves create a visually stunning yet eerie landscape.\nStrategic Gameplay: Evade enemies, chase down opponents, and outsmart your friends in a variety of game modes like tag, hide-and-seek, and capture the orb.\nCustomizable Characters: Personalize your shadow creature with unique skins, glowing patterns, and accessories that match your style.\nSocial Multiplayer Experience: Join friends or meet new players in vibrant lobbies with proximity chat and cooperative mini-games.\nProject Shadows combines the physical challenge of tag with a dark and enigmatic world where every movement counts, every shadow hides a secret, and every game tells a new story. Can you master the shadows?", "short_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-shadows/", "developer_terms_of_service_url": null, "publisher_name": "illidarien", "support_website_url": null, "website_url": "https://sites.google.com/view/project-shadows/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
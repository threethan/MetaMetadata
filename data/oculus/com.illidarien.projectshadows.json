rWCt44rEsabX5JERiyeWP3JAGg&oe=6A466A07"}, {"file_name": "image4.png", "id": "1744818729434986", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391901_1744818732768319_2411961497414592792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3jtDNFHfmwQ7kNvwFa-ATX&_nc_oc=Adohdph7uAkyXQkEY25hyBbmK6iYf5K9YHvibdguAcU1gPOgr602kczAksC7HVgH2nc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-Ha4O7LWyiGH1LOC-3CQEZN99ZfWYs7tiGbgYkVwclQ&oe=6A467D60"}, {"file_name": "image3.png", "id": "616909720929393", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391855_616909727596059_2216789613611795912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8r7H2Syv_kQ7kNvwH80JqC&_nc_oc=Adrmgnhj6ZxH_Xi3ZKE8T61anWNVKhCEAfKxjnWbgte4_aIRey9XVTgVTYsBicBmOSI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TG_enCX9pLc23CgRfmggLXwX1HWjFHpYCVgqsoLc3Jg&oe=6A4687BA"}, {"file_name": "image2 (1).png", "id": "547255635014233", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391950_547255638347566_8243611706801042213_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1KB_KcJJoUQ7kNvwGoDBBQ&_nc_oc=AdpDl8c81_fON2mqKakyE74l9bCxuX7Gi1FKf6-vOccK3J5xeo4LtpEI6b6Ogp4Nkqo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5SC_tACiJP4bJyNZ6n1ojviS8obdrboa4SDHNfqUa-w&oe=6A467EC0"}, {"file_name": "image1.png", "id": "4120886358140369", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392020_4120886361473702_6235863065542341744_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqYPvM8uXc8Q7kNvwE9A0fp&_nc_oc=AdrJRqDo91QciNTgjD72PcRa1GA586KoCC2Y8-TtVoMhQzxKNgt_4e4r7LOINYOUdm0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TQ2cZd3L9WOzaqo8KQYdi3sOKIgaNXx9LVlw4qX5tRw&oe=6A466376"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Shadows", "keywords": [], "long_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n\nKey Features:\nFluid Parkour Movement: Run, jump, and climb seamlessly as you navigate intricate environments full of hidden paths and secret areas.\nDynamic Shadow World: Explore a unique setting where dark forests, abandoned ruins, and glowing caves create a visually stunning yet eerie landscape.\nStrategic Gameplay: Evade enemies, chase down opponents, and outsmart your friends in a variety of game modes like tag, hide-and-seek, and capture the orb.\nCustomizable Characters: Personalize your shadow creature with unique skins, glowing patterns, and accessories that match your style.\nSocial Multiplayer Experience: Join friends or meet new players in vibrant lobbies with proximity chat and cooperative mini-games.\nProject Shadows combines the physical challenge of tag with a dark and enigmatic world where every movement counts, every shadow hides a secret, and every game tells a new story. Can you master the shadows?", "short_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-shadows/", "developer_terms_of_service_url": null, "publisher_name": "illidarien", "support_website_url": null, "website_url": "https://sites.google.com/view/project-shadows/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_cat
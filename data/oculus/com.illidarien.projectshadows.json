pfGQ3H9WjdtMg6ar4Xn9dAEwzw&oe=6A369807"}, {"file_name": "image4.png", "id": "1744818729434986", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391901_1744818732768319_2411961497414592792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5onU6P1iL0Q7kNvwFPb5Fw&_nc_oc=AdqJ6zRRYCz_WdNNz5fEHGwGX2IP7trND5l-m5x08E_SUzmCIW313AKQWlnmuIR7wu0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_i658GqZXGHZU4NzKUU8gofCElYwNBk2y7Ad5VYULoXQ&oe=6A36AB60"}, {"file_name": "image3.png", "id": "616909720929393", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391855_616909727596059_2216789613611795912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpfTMyqsXxgQ7kNvwH94WZq&_nc_oc=AdpOB_W3TSuolSfXo7bL_Gnx-MSOnCU3CXUmizYZ7PcxjHpUUPDN6E7AgGwSdl0W3Gg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5Uc7DOiQVfJu4UQtXT2PW30EmFGHgizh4IG72Lam5gQ&oe=6A36B5BA"}, {"file_name": "image2 (1).png", "id": "547255635014233", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391950_547255638347566_8243611706801042213_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmxNadOb904Q7kNvwFMh9NK&_nc_oc=AdrMLSicEwqvUXl0CdTAbtSPs71zLqOHewy0CK3PDuIywWsiUl7NAmIzgOri9POZPrU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XR6KO6hBw5Pcy2kpQXE3mRAPHD5zS_GYZq0VLTy0rMw&oe=6A36ACC0"}, {"file_name": "image1.png", "id": "4120886358140369", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392020_4120886361473702_6235863065542341744_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yxqhx6jecw4Q7kNvwFY0tXB&_nc_oc=Adqj-Bve-fvNARZDTcsQNDNWZVPGET4HNs0BGRM-_8OY_z0jVHj8bEHamckAVqS1FOI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Qul67cN5oG2aNwG4VmB9kBbLjxQ64Xi2vs4jYiBgdgQ&oe=6A369176"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Shadows", "keywords": [], "long_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n\nKey Features:\nFluid Parkour Movement: Run, jump, and climb seamlessly as you navigate intricate environments full of hidden paths and secret areas.\nDynamic Shadow World: Explore a unique setting where dark forests, abandoned ruins, and glowing caves create a visually stunning yet eerie landscape.\nStrategic Gameplay: Evade enemies, chase down opponents, and outsmart your friends in a variety of game modes like tag, hide-and-seek, and capture the orb.\nCustomizable Characters: Personalize your shadow creature with unique skins, glowing patterns, and accessories that match your style.\nSocial Multiplayer Experience: Join friends or meet new players in vibrant lobbies with proximity chat and cooperative mini-games.\nProject Shadows combines the physical challenge of tag with a dark and enigmatic world where every movement counts, every shadow hides a secret, and every game tells a new story. Can you master the shadows?", "short_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-shadows/", "developer_terms_of_service_url": null, "publisher_name": "illidarien", "support_website_url": null, "website_url": "https://sites.google.com/view/project-shadows/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_cat
07"}, {"file_name": "image4.png", "id": "1744818729434986", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391901_1744818732768319_2411961497414592792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwAXT_-F4nQQ7kNvwFcZ0yi&_nc_oc=AdkiXdstT1pAUUAm3m4NA4Vvm2mFgbpOzmgItWaKgL4fZoqYCW22CZoALDtJtl7SWvU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyIy-zfLccJk9sNrX5_HxDIg_1go70DFsPgMVCznJXCmw&oe=69AD5720"}, {"file_name": "image3.png", "id": "616909720929393", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391855_616909727596059_2216789613611795912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0X_CG60r64Q7kNvwFAbcPC&_nc_oc=AdlOOJ54N3BYLSbgICzsk5d9mbKwqZdCHTWQLH5gRgor_F-VRtBxa7EutxvQOQCvX8Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxicykEnYh6R1TdJ-nvR62Nr8hCC9sxRvJlNoRYvkTjQ&oe=69AD617A"}, {"file_name": "image2 (1).png", "id": "547255635014233", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391950_547255638347566_8243611706801042213_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pc2bfgiWWkIQ7kNvwGszQly&_nc_oc=AdmYBUTVN8AL-wQjubOrcuGjGTDGtMkDoYOGQ9sGGUsLBRVu63K9VWUXMtME-4r9g_c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3UQs9y3rGSkxZbr-hkM__HZKXrFgA-lTinvjC0lGF1A&oe=69AD5880"}, {"file_name": "image1.png", "id": "4120886358140369", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392020_4120886361473702_6235863065542341744_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJuhiqw-uI8Q7kNvwE09rBQ&_nc_oc=AdnO3PYZkoft-gn-x52zpt2SMPl1A-P8jqF2CQUOswq1DJDSeJ6JdrDUVmRqlwVOTJk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxueojXpvwsrbNCJgNpnQ0ruEBik7avaoehSop1rV3FpQ&oe=69AD7576"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Shadows", "keywords": [], "long_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n\nKey Features:\nFluid Parkour Movement: Run, jump, and climb seamlessly as you navigate intricate environments full of hidden paths and secret areas.\nDynamic Shadow World: Explore a unique setting where dark forests, abandoned ruins, and glowing caves create a visually stunning yet eerie landscape.\nStrategic Gameplay: Evade enemies, chase down opponents, and outsmart your friends in a variety of game modes like tag, hide-and-seek, and capture the orb.\nCustomizable Characters: Personalize your shadow creature with unique skins, glowing patterns, and accessories that match your style.\nSocial Multiplayer Experience: Join friends or meet new players in vibrant lobbies with proximity chat and cooperative mini-games.\nProject Shadows combines the physical challenge of tag with a dark and enigmatic world where every movement counts, every shadow hides a secret, and every game tells a new story. Can you master the shadows?", "short_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-shadows/", "developer_terms_of_service_url": null, "publisher_name": "illidarien", "support_website_url": null, "website_url": "https://sites.google.com/view/project-shadows/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "45978150496
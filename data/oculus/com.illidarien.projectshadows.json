_sid=6e7a0a&_nc_ohc=6gFvv1nCO_MQ7kNvwFjoN-B&_nc_oc=Ado1qHzbvXg7FX31OeV2FuuEziUecW0A4mp8UIempRk5k4AMxYoAC8Baw87E1txvkm0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQdzqOLcQ_6BEPIOZj77kVGQcrkn7OuFUnDnZCl9hMZSw&oe=6B0C6347"}, {"file_name": "image4.png", "id": "1744818729434986", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391901_1744818732768319_2411961497414592792_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wRSWiCH7B0Q7kNvwHCl8kA&_nc_oc=Adrk2ofQEcyu__8jSSRufExfejVISE6tQKlTQ97CzD9AtAXcRV_vAXCtQ3sCWKF1r58&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS2ZR4OeNnd57AMh0uMD_uw2hIhTGX8B0F84imk2iObQw&oe=6B0C76A0"}, {"file_name": "image3.png", "id": "616909720929393", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391855_616909727596059_2216789613611795912_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frh1o3xR8rQQ7kNvwFxa7q4&_nc_oc=Adr1k4w-ZL_G5rgaTjWIGPUgAOh17IoZ0k3rMu5YQ-4r1u5nab1F_2TSvPGNipoq98Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRUiyJFuETl3TVz0kukJKk3cR2wWZiYFP6TRe_0uit7vw&oe=6B0C80FA"}, {"file_name": "image2 (1).png", "id": "547255635014233", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391950_547255638347566_8243611706801042213_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpzAvWUhlZ8Q7kNvwF4Qtu-&_nc_oc=AdqIwxr58UsYAR9dSRZ4SqVuFe6mY1ajU4iHEjHypoZE9uhCB4lj0vCHarxIg9YR7G4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSlZCigCJ4HjEsHjSzhxNUihspN2CE03zb4V-MdUA4Mhw&oe=6B0C7800"}, {"file_name": "image1.png", "id": "4120886358140369", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392020_4120886361473702_6235863065542341744_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGI7N4i5v3cQ7kNvwHubCB5&_nc_oc=AdoWnV3OgG7NHGQ0DncJ4ZzaGcKtU4kp6xNaJa_bOANdkJfZBKeXEW079EdE0C5uV28&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRTp3tTzEIiadoEpZNuQ213DjktRWtVgTH7ox5wHzpldQ&oe=6B0C5CB6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Shadows", "keywords": [], "long_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n\nKey Features:\nFluid Parkour Movement: Run, jump, and climb seamlessly as you navigate intricate environments full of hidden paths and secret areas.\nDynamic Shadow World: Explore a unique setting where dark forests, abandoned ruins, and glowing caves create a visually stunning yet eerie landscape.\nStrategic Gameplay: Evade enemies, chase down opponents, and outsmart your friends in a variety of game modes like tag, hide-and-seek, and capture the orb.\nCustomizable Characters: Personalize your shadow creature with unique skins, glowing patterns, and accessories that match your style.\nSocial Multiplayer Experience: Join friends or meet new players in vibrant lobbies with proximity chat and cooperative mini-games.\nProject Shadows combines the physical challenge of tag with a dark and enigmatic world where every movement counts, every shadow hides a secret, and every game tells a new story. Can you master the shadows?", "short_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-shadows/", "
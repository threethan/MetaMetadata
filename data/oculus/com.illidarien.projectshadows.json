87"}, {"file_name": "image4.png", "id": "1744818729434986", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391901_1744818732768319_2411961497414592792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuQ8DlRYRZEQ7kNvwGZu_Cj&_nc_oc=AdkbC0tyNrxWejErIBwIWd22g_i4l5VLr61T-W242vnJy90gtfNTBKmoZn8eeLCJtWM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8Aqc85NTPFCwDh_GG4za2_ypwTNMs-K5fOEbHhWx-qQ&oe=69BE7AA0"}, {"file_name": "image3.png", "id": "616909720929393", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391855_616909727596059_2216789613611795912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mr0Rh3_oJR0Q7kNvwFKU4JI&_nc_oc=AdlG66-vBy3rN6mvaE9UOvrx6hL2PO3JpbFwTLgkKMDL2LaroPdTTUUnnV01ClqI3YM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzhPk2ACEXqcXD2bN2a0Je2XpamDaMoFg_DoudsT3xnRA&oe=69BE84FA"}, {"file_name": "image2 (1).png", "id": "547255635014233", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391950_547255638347566_8243611706801042213_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2uWoTbDJx0Q7kNvwEnPYWM&_nc_oc=Adku57Ba9MflLwsSlRaScRtauRgCPJyZ3xWQo2H3GwpOWV5AlkfRni4CJtXL2V7oy1I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUpCM4IHNSV6uzchmm_2mjWhSE8CMZfsYZphopwAMWNw&oe=69BE7C00"}, {"file_name": "image1.png", "id": "4120886358140369", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392020_4120886361473702_6235863065542341744_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOexFtI8jJwQ7kNvwEbLPXt&_nc_oc=AdkaYifxWJU8eDiTxq__EBX1zY5rZnuN7eS95l_UfRUeJnpcHw6-RPqI7r8owBuzXyA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfytUEKoo5J57StOCVUV4P7blLUXj8ftX6UfMyrYJfWzbg&oe=69BE98F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Shadows", "keywords": [], "long_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n\nKey Features:\nFluid Parkour Movement: Run, jump, and climb seamlessly as you navigate intricate environments full of hidden paths and secret areas.\nDynamic Shadow World: Explore a unique setting where dark forests, abandoned ruins, and glowing caves create a visually stunning yet eerie landscape.\nStrategic Gameplay: Evade enemies, chase down opponents, and outsmart your friends in a variety of game modes like tag, hide-and-seek, and capture the orb.\nCustomizable Characters: Personalize your shadow creature with unique skins, glowing patterns, and accessories that match your style.\nSocial Multiplayer Experience: Join friends or meet new players in vibrant lobbies with proximity chat and cooperative mini-games.\nProject Shadows combines the physical challenge of tag with a dark and enigmatic world where every movement counts, every shadow hides a secret, and every game tells a new story. Can you master the shadows?", "short_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-shadows/", "developer_terms_of_service_url": null, "publisher_name": "illidarien", "support_website_url": null, "website_url": "https://sites.google.com/view/project-shadows/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "45978150496
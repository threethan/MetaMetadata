07"}, {"file_name": "image4.png", "id": "1744818729434986", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391901_1744818732768319_2411961497414592792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuQ8DlRYRZEQ7kNvwEIUX92&_nc_oc=AdnSKNZLnk3bJsYL_T89Lls9JID_RCdmnggGY82mL4EX0CeqxMVdfO61pHrFANoO_NY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyUcMRXNjB7taLn4raFA1h1Ms-llEEoLo36OWQAHvDn4A&oe=69BFCC20"}, {"file_name": "image3.png", "id": "616909720929393", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391855_616909727596059_2216789613611795912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpHl-hgoJVcQ7kNvwGGGGOG&_nc_oc=AdmYarH-gQ-Xxsgqa1fGVgnlnID5PuTdWoJvxoITGfQh_o05tv7cmLZk1qYshMuUc1A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz9jXFr2dFF1wVGUjHN7XhIXevQ6xaC7hMrT4Y_0K51fQ&oe=69BFD67A"}, {"file_name": "image2 (1).png", "id": "547255635014233", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391950_547255638347566_8243611706801042213_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2uWoTbDJx0Q7kNvwF4mAG4&_nc_oc=Adn5D0f7TJNxq0r-B4PWZCUo-N38A5v1r_822Xwsm-kHYgC1QfWdmHRhX7rCbWAlM9s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy1PFeWwkW4ktTgYLc9QWobBWO1_kkKItjJvLftWcPy0w&oe=69BFCD80"}, {"file_name": "image1.png", "id": "4120886358140369", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392020_4120886361473702_6235863065542341744_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOexFtI8jJwQ7kNvwEyfDHp&_nc_oc=Adlfo_mB264a_5ZTKSI0rN-qXKe9zvAA-Q-_2TpXiDRDAB4gI6wg5iMGkf5mFsbdzhs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9H69B1rUWn9D2-s2sw49kV8kOvG8ucZPlAdUm5Yu6sg&oe=69BFEA76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Shadows", "keywords": [], "long_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n\nKey Features:\nFluid Parkour Movement: Run, jump, and climb seamlessly as you navigate intricate environments full of hidden paths and secret areas.\nDynamic Shadow World: Explore a unique setting where dark forests, abandoned ruins, and glowing caves create a visually stunning yet eerie landscape.\nStrategic Gameplay: Evade enemies, chase down opponents, and outsmart your friends in a variety of game modes like tag, hide-and-seek, and capture the orb.\nCustomizable Characters: Personalize your shadow creature with unique skins, glowing patterns, and accessories that match your style.\nSocial Multiplayer Experience: Join friends or meet new players in vibrant lobbies with proximity chat and cooperative mini-games.\nProject Shadows combines the physical challenge of tag with a dark and enigmatic world where every movement counts, every shadow hides a secret, and every game tells a new story. Can you master the shadows?", "short_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-shadows/", "developer_terms_of_service_url": null, "publisher_name": "illidarien", "support_website_url": null, "website_url": "https://sites.google.com/view/project-shadows/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "45978150496
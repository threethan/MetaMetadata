_sid=6e7a0a&_nc_ohc=6gFvv1nCO_MQ7kNvwG1GZhs&_nc_oc=AdpqqR07J9rRTzE16oZZ0our-8vXH6xla-jotY2RcsMCfHwmFTX90rljdCO-Om3QsKI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSuoQbWmmKQlLLE07oIjz7rorlWQqAO0_N_9gQSGIwxQA&oe=6B0B11C7"}, {"file_name": "image4.png", "id": "1744818729434986", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391901_1744818732768319_2411961497414592792_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wRSWiCH7B0Q7kNvwF3B0j6&_nc_oc=AdrbOThHrs-aBIf05lgSyS_67JzZICDooKY0WVcNhcGXsN6ol3s7f46pLoJuVYiQryE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQiXYK-qleVhCVjbQ0JGyTNOqy0b0mxieUMnDUdglJrVg&oe=6B0B2520"}, {"file_name": "image3.png", "id": "616909720929393", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391855_616909727596059_2216789613611795912_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8t1t_tKl5GcQ7kNvwFRS-XH&_nc_oc=AdrGdmKCtJuBg9t8XCpxt1YuZtjWho2lbo3OKqTEwZ9yn4-m54O4zPxzuIKB5miR840&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQqgxqRk445AiPkmxC6n3sAFrtuc2Ied6Lgqlh4dZkPRQ&oe=6B0B2F7A"}, {"file_name": "image2 (1).png", "id": "547255635014233", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391950_547255638347566_8243611706801042213_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6dK1-yA-v4Q7kNvwEjOVus&_nc_oc=AdpWnTJxcFc5ZV2F-HBEt4Gx4pO6YLB6UXNlyOH35K6LoWDPEwH0UXT97_QcBVRnKPc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTEhKv5tInWr2emtgHMIsoJDH3D38RgyjUBSAhQB_HC9Q&oe=6B0B2680"}, {"file_name": "image1.png", "id": "4120886358140369", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392020_4120886361473702_6235863065542341744_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGI7N4i5v3cQ7kNvwErjV1H&_nc_oc=AdpqQqmSf_gI7Z9sBbQnCrKEovWc0Sil-Ch-ekSFE526NWJML8mFaKCiZeYfpV3j2mo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS5GCi_1VCaRjjmzAEJvfXIM2XdHsppNc0XowuHtZHpng&oe=6B0B4376"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Shadows", "keywords": [], "long_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n\nKey Features:\nFluid Parkour Movement: Run, jump, and climb seamlessly as you navigate intricate environments full of hidden paths and secret areas.\nDynamic Shadow World: Explore a unique setting where dark forests, abandoned ruins, and glowing caves create a visually stunning yet eerie landscape.\nStrategic Gameplay: Evade enemies, chase down opponents, and outsmart your friends in a variety of game modes like tag, hide-and-seek, and capture the orb.\nCustomizable Characters: Personalize your shadow creature with unique skins, glowing patterns, and accessories that match your style.\nSocial Multiplayer Experience: Join friends or meet new players in vibrant lobbies with proximity chat and cooperative mini-games.\nProject Shadows combines the physical challenge of tag with a dark and enigmatic world where every movement counts, every shadow hides a secret, and every game tells a new story. Can you master the shadows?", "short_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-shadows/", "
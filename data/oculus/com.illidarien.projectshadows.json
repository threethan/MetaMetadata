87"}, {"file_name": "image4.png", "id": "1744818729434986", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391901_1744818732768319_2411961497414592792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSeohkqikY4Q7kNvwEAETTP&_nc_oc=AdkHHhsKjfzDamQzLjqEldfZzaDilYEO0f8GIJTmOhPw0JluMPwb45JwiMEXeifVXrI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuxS_To6WYgMAO3WbH5I5ZDgSc4TnWoxywaU64aYZtY_g&oe=69A962A0"}, {"file_name": "image3.png", "id": "616909720929393", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391855_616909727596059_2216789613611795912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcZRQdVwQGgQ7kNvwG6epW0&_nc_oc=Adm5VoNaEb0ZSyoYpdg4dKVrI0Mf-tWsEbyUMj6FsYwUettt5NlSlYK7jzPQdHrm_Yc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afv3_3DwDprQRrkBRcyJU-TnBWpuHX60-nwbjfx0jVXLEw&oe=69A96CFA"}, {"file_name": "image2 (1).png", "id": "547255635014233", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391950_547255638347566_8243611706801042213_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1oVO3_yLpkQ7kNvwEcEMJA&_nc_oc=AdnHGTlLKaPqy5YPzbPZbnwDdCaVfzzPP8N1aFp0Af7KTJpPOjLrssPhOGKBTeamRBw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsSMcpbhRsZsbo3lL_HCXGUhZFdsIUihoHQyE9M0wRZZg&oe=69A96400"}, {"file_name": "image1.png", "id": "4120886358140369", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392020_4120886361473702_6235863065542341744_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLf20HwxazwQ7kNvwEH8UGS&_nc_oc=AdmBd1ZEwKnv4FghLMiYOlSxdNQA3I56f5TsT_i81Mje1Ui1sFneJ8vJEDrfeVK5qF4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afufn6VdCygQrcDj90wuWO5LNNJ2_M1KpJAt6UUURkaNnw&oe=69A980F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Shadows", "keywords": [], "long_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n\nKey Features:\nFluid Parkour Movement: Run, jump, and climb seamlessly as you navigate intricate environments full of hidden paths and secret areas.\nDynamic Shadow World: Explore a unique setting where dark forests, abandoned ruins, and glowing caves create a visually stunning yet eerie landscape.\nStrategic Gameplay: Evade enemies, chase down opponents, and outsmart your friends in a variety of game modes like tag, hide-and-seek, and capture the orb.\nCustomizable Characters: Personalize your shadow creature with unique skins, glowing patterns, and accessories that match your style.\nSocial Multiplayer Experience: Join friends or meet new players in vibrant lobbies with proximity chat and cooperative mini-games.\nProject Shadows combines the physical challenge of tag with a dark and enigmatic world where every movement counts, every shadow hides a secret, and every game tells a new story. Can you master the shadows?", "short_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-shadows/", "developer_terms_of_service_url": null, "publisher_name": "illidarien", "support_website_url": null, "website_url": "https://sites.google.com/view/project-shadows/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "45978150496
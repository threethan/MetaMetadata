nut4SbDqew3szv4NfKFpX5G3FL_zd891FzOQ&oe=6A8EEC87"}, {"file_name": "image4.png", "id": "1744818729434986", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391901_1744818732768319_2411961497414592792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mn1EtBy928Q7kNvwFArkg-&_nc_oc=Adp_-s2yTeUAxDJTXYwu3Mx8tpIkdxIqXBfcOoSQ6fdAbRjD97K5b82tkuOh8k5swEU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKajF2CDBguAFnkaV0CdJj-Szh4Avb6pMnWRXmvh42lg&oe=6A8EC7A0"}, {"file_name": "image3.png", "id": "616909720929393", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391855_616909727596059_2216789613611795912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpXMy2tSPLAQ7kNvwFI2XiR&_nc_oc=Adpm6zkDLFYE71mLY5SqB87UJh-v14ysgphePlQ0A5zBSH1I-tLomuBLM7rqDBj4xRA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmmg450XCpLxv9FfN_KCU15k09l9902Fvds89BJByLDg&oe=6A8ED1FA"}, {"file_name": "image2 (1).png", "id": "547255635014233", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391950_547255638347566_8243611706801042213_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oaZ8o6eowsQ7kNvwF7E0SW&_nc_oc=AdrpcUdizjBidViiiUg5jWyzwiAeEXWeXSz8WJ4_5v60epbjTMvYU39Iy9HeHT43E3o&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFp276gGET2ciOBkDHfHOsEvxxd3PZ7AfR6HKu0hiBng&oe=6A8EC900"}, {"file_name": "image1.png", "id": "4120886358140369", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473392020_4120886361473702_6235863065542341744_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RSmunNxoIYQ7kNvwHoXIdj&_nc_oc=AdpwPOofs1mA7TVywpeC5BWh_p2DJKThtFw4sw6DHUJVtDK2XIewCwcgzxZKEdXYv3w&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGX9L97TY43IoP4K0kGcQUMzwLKzv7fCzyC9jCTJe4iUQ&oe=6A8EE5F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Shadows", "keywords": [], "long_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n\nKey Features:\nFluid Parkour Movement: Run, jump, and climb seamlessly as you navigate intricate environments full of hidden paths and secret areas.\nDynamic Shadow World: Explore a unique setting where dark forests, abandoned ruins, and glowing caves create a visually stunning yet eerie landscape.\nStrategic Gameplay: Evade enemies, chase down opponents, and outsmart your friends in a variety of game modes like tag, hide-and-seek, and capture the orb.\nCustomizable Characters: Personalize your shadow creature with unique skins, glowing patterns, and accessories that match your style.\nSocial Multiplayer Experience: Join friends or meet new players in vibrant lobbies with proximity chat and cooperative mini-games.\nProject Shadows combines the physical challenge of tag with a dark and enigmatic world where every movement counts, every shadow hides a secret, and every game tells a new story. Can you master the shadows?", "short_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-shadows/", "developer_terms_of_service_url": null, "publisher_name": "illidarien", "support_website_url": null, "website_url": "https://sites.google.com/view/project-shadows/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
07"}, {"file_name": "image4.png", "id": "1744818729434986", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391901_1744818732768319_2411961497414592792_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axuve4hGH6wQ7kNvwHXgFSu&_nc_oc=AdnPJYwmFQnWF8UvY87ClpLgefzHYqVrfHGmsEFc9tsci-h_iIPSKo_eC3ek-NFrhvY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwyJ8yTi2fJKF303DLKPDcrkx3H8A5CqOIOO4u1vn3RzQ&oe=69BA8620"}, {"file_name": "image3.png", "id": "616909720929393", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391855_616909727596059_2216789613611795912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIt5MYHN294Q7kNvwEakVdj&_nc_oc=Adm5J6vSzI9Ulhm77C6bCXWZCXXRkK3IF4amx_aFs8hyZOvn4Xom8N7DOg2AgSZAg5g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw_UOyTTMeQeGcy2BwyDRYVbzuAlIgQTkUru44i4sD5sA&oe=69BA907A"}, {"file_name": "image2 (1).png", "id": "547255635014233", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391950_547255638347566_8243611706801042213_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0r8_I2T7EwQ7kNvwE8vcpY&_nc_oc=AdkiX4YC5sVoSwDdA4qBdWuL3sce5AmdLqfzujfr8mg6oLwnLvQ4efEEEEavbw5FhXM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwNqRpBnwk6QFrA1sG3deGvVd5OlzVxqJxVj1inZuVWng&oe=69BA8780"}, {"file_name": "image1.png", "id": "4120886358140369", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392020_4120886361473702_6235863065542341744_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVkmLvcNdCEQ7kNvwH-iD-u&_nc_oc=AdnpLsn3dnar3C4R3gcsI03pXtM6JYqujKE511hKXFaK1KhMXCc5qmUyKrApex6leiU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz26jd9YaEeI4PTDBKrUYd1nlZ_0-skpAph_GOsMi7kDQ&oe=69BAA476"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Shadows", "keywords": [], "long_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n\nKey Features:\nFluid Parkour Movement: Run, jump, and climb seamlessly as you navigate intricate environments full of hidden paths and secret areas.\nDynamic Shadow World: Explore a unique setting where dark forests, abandoned ruins, and glowing caves create a visually stunning yet eerie landscape.\nStrategic Gameplay: Evade enemies, chase down opponents, and outsmart your friends in a variety of game modes like tag, hide-and-seek, and capture the orb.\nCustomizable Characters: Personalize your shadow creature with unique skins, glowing patterns, and accessories that match your style.\nSocial Multiplayer Experience: Join friends or meet new players in vibrant lobbies with proximity chat and cooperative mini-games.\nProject Shadows combines the physical challenge of tag with a dark and enigmatic world where every movement counts, every shadow hides a secret, and every game tells a new story. Can you master the shadows?", "short_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-shadows/", "developer_terms_of_service_url": null, "publisher_name": "illidarien", "support_website_url": null, "website_url": "https://sites.google.com/view/project-shadows/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "45978150496
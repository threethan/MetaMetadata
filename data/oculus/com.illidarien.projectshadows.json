_sid=6e7a0a&_nc_ohc=Ov0nb0p8GOkQ7kNvwEC_1uP&_nc_oc=Adqniw2ZyT3A-wLzjUyV4i_z-EiPnpDfHvxXzd-3THaXDwHDHcDvbTVGZE4XH1zTRx4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCgo8otrzDPQEkT8Yy7lw29SIJiw1S5bd1tyIU7Fbv7Q&oe=6B086EC7"}, {"file_name": "image4.png", "id": "1744818729434986", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391901_1744818732768319_2411961497414592792_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5t7ZI6-f5ZIQ7kNvwGLcYPt&_nc_oc=AdpuSo9kxGHlnha0rMVTQvFHQGm6FEkFPbDXvE05GnSOmJeElcGOAKwGYqstfUATst8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYiNyFXjQgKWFGV_FhB_Ks91SARMv-TC_2fBXcXW--eQ&oe=6B0849E0"}, {"file_name": "image3.png", "id": "616909720929393", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391855_616909727596059_2216789613611795912_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8t1t_tKl5GcQ7kNvwEZm4ag&_nc_oc=AdokN201jhVRDMKIu47AJ0ZXeDJb5km-Sfj8r7PhCtfpq9lFpic3LzVydHhVYmmtD30&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6LKscGuHoLW1VrjWXlaMu3S-cFJaxK2XmmbKo8K9SkQ&oe=6B08543A"}, {"file_name": "image2 (1).png", "id": "547255635014233", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391950_547255638347566_8243611706801042213_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNZKh07zq2IQ7kNvwF3kneE&_nc_oc=AdrFyP0x3YwhSDcZgX_8btd83bRYXmuBeFH4xKRumhzcPzeI-gc1MFbx3nLcvpT1zoA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4njTRavcr7xh_g1zBWyoAwHr_IB-OvKl98i9GwP2p5w&oe=6B084B40"}, {"file_name": "image1.png", "id": "4120886358140369", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392020_4120886361473702_6235863065542341744_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPgdkckzBywQ7kNvwHdji-R&_nc_oc=Adp2V_TowJYPl9gwXa2bm3gYIrbyeI03uLdqJShRU_-YUtj3Qi00hC3aKWc7zEg07Kc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSY5AuwaFDQewbX4iCN_UTk9OE5Jgtpte8YvN9S02bhjA&oe=6B086836"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Shadows", "keywords": [], "long_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n\nKey Features:\nFluid Parkour Movement: Run, jump, and climb seamlessly as you navigate intricate environments full of hidden paths and secret areas.\nDynamic Shadow World: Explore a unique setting where dark forests, abandoned ruins, and glowing caves create a visually stunning yet eerie landscape.\nStrategic Gameplay: Evade enemies, chase down opponents, and outsmart your friends in a variety of game modes like tag, hide-and-seek, and capture the orb.\nCustomizable Characters: Personalize your shadow creature with unique skins, glowing patterns, and accessories that match your style.\nSocial Multiplayer Experience: Join friends or meet new players in vibrant lobbies with proximity chat and cooperative mini-games.\nProject Shadows combines the physical challenge of tag with a dark and enigmatic world where every movement counts, every shadow hides a secret, and every game tells a new story. Can you master the shadows?", "short_description": "Project Shadows is an immersive and thrilling gorilla tag-inspired multiplayer game where players leap, climb, and swing through a mysterious shadowy environment. Set in a world cloaked in perpetual twilight, the game combines fast-paced movement mechanics with a hauntingly beautiful atmosphere, encouraging both competitive gameplay and exploration.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-shadows/", "
nt-iad3-1.oculuscdn.com/v/t64.5771-25/75392878_1210406736594235_1582659760593253_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skaQSRqQdVgQ7kNvwE18kTh&_nc_oc=AdpBkMZIMeVIpNBpdOGGE3aYIVS9nFyFzlD4SsZdlq3IcjJeF_1gwbyVNB7pMTRZTLM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTE2dKl50WZs26ypJQ5DDl5Srvk2ZOOXLOBnu_8fqTD0w&oe=6B01BBBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled-21.png", "id": "370137062464053", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001665_370137065797386_6603111948820454422_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqtGUdHxbBkQ7kNvwHGxaWP&_nc_oc=AdqR8_kRs4tuCu7tC9WGBO3OTTy4myWaFG9e9Tl5oAH55u0pvejw_NPPMcgPUu3TtCE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSl_xydCQMqAxMP7_rtKBSof_tdPKIYU6G0KYw4kTpgUQ&oe=6B01C7E1"}, "display_name": "Target Blitz VR", "keywords": [], "long_description": "Welcome to Target Blitz VR, the ultimate shooting experience in virtual reality! Immerse yourself in our captivating hand-drawn art style as you embark on a thrilling journey of skill and precision. With fast-paced arcade gameplay, you'll find yourself hooked as you take aim, fire, and climb the leaderboards with every shot. Challenge yourself against the ticking timer and see if you have what it takes to emerge victorious. Whether you're a seasoned sharpshooter or new to the world of VR gaming, Target Blitz VR offers endless fun and excitement for all players. Get ready to unleash your inner marksman and blast your way to glory!", "short_description": "Embark on a thrilling shooting spree in Target Blitz VR! With its unique hand-drawn art style and fast-paced gameplay, take aim, shoot, and climb the leaderboards as the timer ticks down. Immerse yourself in arcade-style action like never before. Are you ready to blast your way to the top?\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://github
cketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WChok2dulsQ7kNvwHirrW8&_nc_oc=Adrjs8cSCAEpSBwX6ty-w36Qtl1BirE_T8amDWfqqnC8RnfzKG7Cv7Gq-L99XHE_fTk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkyLS3DhJyIKHXBnP6J3zm1B6FHJ4C040X35g6xu9-vg&oe=6B08533D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled-21.png", "id": "370137062464053", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001665_370137065797386_6603111948820454422_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzmVSmM8nawQ7kNvwEt4nRT&_nc_oc=AdrHr9xwBIdIdbpH0YkujMUyzQ365EH1ukQVXe3QP-MXxmCFjKcd_iwlLlNhYjx4VTA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSt4fzCzgrbnWgHu_2DKWcbrzZwzulbsYwsymnaRbqu8A&oe=6B085F61"}, "display_name": "Target Blitz VR", "keywords": [], "long_description": "Welcome to Target Blitz VR, the ultimate shooting experience in virtual reality! Immerse yourself in our captivating hand-drawn art style as you embark on a thrilling journey of skill and precision. With fast-paced arcade gameplay, you'll find yourself hooked as you take aim, fire, and climb the leaderboards with every shot. Challenge yourself against the ticking timer and see if you have what it takes to emerge victorious. Whether you're a seasoned sharpshooter or new to the world of VR gaming, Target Blitz VR offers endless fun and excitement for all players. Get ready to unleash your inner marksman and blast your way to glory!", "short_description": "Embark on a thrilling shooting spree in Target Blitz VR! With its unique hand-drawn art style and fast-paced gameplay, take aim, shoot, and climb the leaderboards as the timer ticks down. Immerse yourself in arcade-style action like never before. Are you ready to blast your way to the top?\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/DallenLarson/Larsonsoft-Privacy-Policy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher
nt-atl3-1.oculuscdn.com/v/t64.5771-25/75392878_1210406736594235_1582659760593253_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WChok2dulsQ7kNvwFUfc74&_nc_oc=AdpKEZwLMa-zlw6YYYioHDzE_hIAxCjh-s5RAedO-riYGF62ufhsM23YWm7ls7RLokg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRgKDhk8QRwqmWnRHFQ3hjldAqmDZx4OP9Ya5ZAxeGAcQ&oe=6B0B2E7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled-21.png", "id": "370137062464053", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001665_370137065797386_6603111948820454422_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aq7iCWTPgEYQ7kNvwGCqjTO&_nc_oc=Adr_7eNC_6AXdo7k36re-0l6Q94b3V7WuBC3Jm1QTwYgmUlQzbv8EtSmsNxHIstF7KI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQvpIhWD2eO1JjfO8y2tJuOwm4xgO8THkP7yQ0kund13w&oe=6B0B3AA1"}, "display_name": "Target Blitz VR", "keywords": [], "long_description": "Welcome to Target Blitz VR, the ultimate shooting experience in virtual reality! Immerse yourself in our captivating hand-drawn art style as you embark on a thrilling journey of skill and precision. With fast-paced arcade gameplay, you'll find yourself hooked as you take aim, fire, and climb the leaderboards with every shot. Challenge yourself against the ticking timer and see if you have what it takes to emerge victorious. Whether you're a seasoned sharpshooter or new to the world of VR gaming, Target Blitz VR offers endless fun and excitement for all players. Get ready to unleash your inner marksman and blast your way to glory!", "short_description": "Embark on a thrilling shooting spree in Target Blitz VR! With its unique hand-drawn art style and fast-paced gameplay, take aim, shoot, and climb the leaderboards as the timer ticks down. Immerse yourself in arcade-style action like never before. Are you ready to blast your way to the top?\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://github
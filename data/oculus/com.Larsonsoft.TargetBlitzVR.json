": "39031443_319592877253459_2563502058862103154_n.png", "id": "787170923257564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982441_787170926590897_8557377004981503250_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPAGvBLBW3AQ7kNvwEpJyhG&_nc_oc=Adoib05-ep2xi8kHCjX_AMYwLd3RWnzdR-OhGMasN1o_xRjL6arsUMP7ZVrP26fHsbs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1PzagsY237rICHFfCUA39OKsXrOmd4Mkv1igvHG9UWig&oe=69F0A790"}, {"file_name": "38974788_315902124372049_6223628798340424221_n.png", "id": "418086107412836", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982441_418086110746169_5975769245380653237_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtQrrjM3TzUQ7kNvwE-i-XH&_nc_oc=AdpPKy___u_04PJrZz-PcOsxx7d-VGjq2MKwm5bwUk17XQahL4rJxipWb2837R96T-Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3amhjJ1swB602c3oNY8tEbsUEVznQrob-izfzcmO2opA&oe=69F0B9D7"}, {"file_name": "38974491_332604909180421_8787203125707960536_n.png", "id": "1210406729927569", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75392878_1210406736594235_1582659760593253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRRbTgcY0FIQ7kNvwGdagPL&_nc_oc=Adp92w4F_NOp2yJS-C8oqCIFS8NVEjm0mKnm2zvalQEj3xAYbdkNQY7rn3LnVSpR_hU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3_R4SZS0fmt9S4V3eS-rY9UxMZlfQ0sGgcM52QyydhYA&oe=69F09CFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled-21.png", "id": "370137062464053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001665_370137065797386_6603111948820454422_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMD5zOenBe0Q7kNvwFUYftf&_nc_oc=Adplut6XImJzNADNVAbJevVoupvdhL8UYlBE93-0CzFj56mmUDokWZjxw4GmZf-UaFQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3u3ie7IfrY22NjtwG5yyxbrV8VG0jUZKQwX2XcV34pQw&oe=69F0A921"}, "display_name": "Target Blitz VR", "keywords": [], "long_description": "Welcome to Target Blitz VR, the ultimate shooting experience in virtual reality! Immerse yourself in our captivating hand-drawn art style as you embark on a thrilling journey of skill and precision. With fast-paced arcade gameplay, you'll find yourself hooked as you take aim, fire, and climb the leaderboards with every shot. Challenge yourself against the ticking timer and see if you have what it takes to emerge victorious. Whether you're a seasoned sharpshooter or new to the world of VR gaming, Target Blitz VR offers endless fun and excitement for all players. Get ready to unleash your inner marksman and blast your way to glory!", "short_description": "Embark on a thrilling shooting spree in Target Blitz VR! With its unique hand-drawn art style and fast-paced gameplay, take aim, shoot, and climb the leaderboards as the timer ticks down. Immerse yourself in arcade-style action like never before. Are you ready to blast your way to the top?\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/DallenLarson/Larsonsoft-Privacy-Policy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Larsonsoft", "support_website_url": null, "website_url": "http://www.larsonsoft.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25005301012418902"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1295611284440112"}]}, "baseline_offer": {"id": "1295611284440112"}, "is_a
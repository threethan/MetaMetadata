cketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skaQSRqQdVgQ7kNvwFIippf&_nc_oc=AdpoTDSs0wAUCpiX-CSDRomwNRHDW1VTG7kLkzaxungKbVtkpXdWlE5GjWqAm8tri9I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxDNm_IQXk4gHh-OkpgNs9drJ7gS1kEFZhZjpc0RONjw&oe=6B006A3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled-21.png", "id": "370137062464053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001665_370137065797386_6603111948820454422_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNNTvzAU-3UQ7kNvwHCebvZ&_nc_oc=AdpB7vdNpAv-oSnyFUCcqrtet0FGpGpZAvPmGQBdlI8MFYihd0HYp9-2SC31VgvXmGA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNBxxenVKYuI4KnW_4xTjGeNWn8ZMGfo82BnfET0XRPQ&oe=6B007661"}, "display_name": "Target Blitz VR", "keywords": [], "long_description": "Welcome to Target Blitz VR, the ultimate shooting experience in virtual reality! Immerse yourself in our captivating hand-drawn art style as you embark on a thrilling journey of skill and precision. With fast-paced arcade gameplay, you'll find yourself hooked as you take aim, fire, and climb the leaderboards with every shot. Challenge yourself against the ticking timer and see if you have what it takes to emerge victorious. Whether you're a seasoned sharpshooter or new to the world of VR gaming, Target Blitz VR offers endless fun and excitement for all players. Get ready to unleash your inner marksman and blast your way to glory!", "short_description": "Embark on a thrilling shooting spree in Target Blitz VR! With its unique hand-drawn art style and fast-paced gameplay, take aim, shoot, and climb the leaderboards as the timer ticks down. Immerse yourself in arcade-style action like never before. Are you ready to blast your way to the top?\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/DallenLarson/Larsonsoft-Privacy-Policy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher
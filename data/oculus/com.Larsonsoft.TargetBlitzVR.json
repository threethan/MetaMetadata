cketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGLGvDQ51_oQ7kNvwEgezta&_nc_oc=AdqZvV1YNyUsD8xk3FGsniq5TLqs-90TD3TWnlJ_PGnBZhHUDIFfu64Avds3dXQ7gO0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVZdWYyd0KqKhv3pLKmivz9uaUBAfZNLeaH5ltabY_y5w&oe=6B0F22FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled-21.png", "id": "370137062464053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001665_370137065797386_6603111948820454422_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwNpXbCmFKoQ7kNvwF3ofHm&_nc_oc=AdqLseqU-1aWapqUl_rlcku15unVMw5rqBuDzaSXp857mFvDM6x9Bb7hmAhYL074Flk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVAOgDupG8r2Iq5myesdpWvaZFZL-wWbCxonpDUO-7O8g&oe=6B0EF6E1"}, "display_name": "Target Blitz VR", "keywords": [], "long_description": "Welcome to Target Blitz VR, the ultimate shooting experience in virtual reality! Immerse yourself in our captivating hand-drawn art style as you embark on a thrilling journey of skill and precision. With fast-paced arcade gameplay, you'll find yourself hooked as you take aim, fire, and climb the leaderboards with every shot. Challenge yourself against the ticking timer and see if you have what it takes to emerge victorious. Whether you're a seasoned sharpshooter or new to the world of VR gaming, Target Blitz VR offers endless fun and excitement for all players. Get ready to unleash your inner marksman and blast your way to glory!", "short_description": "Embark on a thrilling shooting spree in Target Blitz VR! With its unique hand-drawn art style and fast-paced gameplay, take aim, shoot, and climb the leaderboards as the timer ticks down. Immerse yourself in arcade-style action like never before. Are you ready to blast your way to the top?\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/DallenLarson/Larsonsoft-Privacy-Policy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher
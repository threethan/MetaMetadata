.com/v/t64.5771-25/499296214_1881961752781269_9212277117100844955_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qS7X0OoWo70Q7kNvwHMhuUz&_nc_oc=AdoyMzRLbuXAoJpmCNtxtsJuwslhh8G_0ggkH8csABAtArffJ2m23O7fV6aPajLj7eQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnjvtX0JNwZXWN-EPtOsMvLBrKt1Kp1bn5kQWer_E4bw&oe=6AFDDE9C"}, {"file_name": "Screenshot 2026-09-03 182743.png", "id": "1053900370857603", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499292712_1053900374190936_2383730009879730963_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OomkinQdt6wQ7kNvwEIjtt7&_nc_oc=AdontgEk6KFrvuNvOUlETXRPUwZt12hXCKhnDD6_aYDK41mwjGnnsTnXwMq59527ids&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKh8cl9aD_iIrDClm8IloCRHy3aaLzxE9GMXCXDltvFQ&oe=6AFDB281"}, {"file_name": "Screenshot 2026-09-03 183246.png", "id": "3476331855886312", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298150_3476331859219645_1126552954648879342_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-nr48om7F5wQ7kNvwG9F9y0&_nc_oc=Adq7QxGhHHr4IYP-l0d8Pv6MXlT8gxhbGwwG1P1rw4FmwlI9njmWRMy5B2hC3DknWAw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-yupWIQC3XvK_SQjyNippmfq4vMznf-_sRoTjlznlMg&oe=6AFDADD3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Horror Universe", "keywords": ["gorillahorror", "gorilla", "horror"], "long_description": "Gorilla Horror Universe is a locomotion-based horror experience built around Locomotion\u2013style climbing movement \u2014 pull yourself through the world hand over hand instead of using a joystick. You'll explore the tiled halls, empty pool basin, and corridors of an abandoned indoor pool facility, where stretches of stark, dim concrete give way without warning to hallways washed in saturated red, green, and blue ceiling light. Scattered through the environment are small floating gem-like physics props \u2014 cubes and crystals in red, green, blue, cyan, orange, and magenta \u2014 that drift and react when you bump or push past them mid-climb. The atmosphere plays dark against vivid: quiet, echoing gray rooms broken up by sudden bursts of neon color, long sightlines down empty tiled hallways, and sparse, unexplained objects that hint at a building nobody's used in a long time. Built for players who enjoy Locomotion-style traversal and prefer atmosphere and exploration over jump scares.", "short_description": "A Locomotion\u2013style climbing horror game. Explore a dark, abandoned indoor pool facility where stark gray corridors give way to rooms bathed in colored light, and knock floating gem-like props around with your body as you climb."}]}, "developer_name": "Aqua", "developer_privacy_policy_url": "https://sites.google.com/view/gorillahorroruniverses", "developer_terms_of_service_url": "https://sites.google.com/view/gorillahorroruniverses/terms-of-service", "publisher_name": "Aqua", "support_website_url": "https://sites.google.com/view/gorillahorroruniverses", "website_url": "https://sites.google.com/view/gorillahorroruniverses", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1340377109155441"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299745_2787246235008616_6
24wo2&_nc_oc=AdoFSBcWgLkSqi0jZVtqTHHLEpAvkXMO959Mg3h-PNIvnadz7XSZH87gu69aaGAnZQ8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3x4JAJvyCI8xSi-v7zAU8dOo-T6ytgumyVnfBR6z5hg&oe=6A65EB68"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1HsWA7e8S4Q7kNvwFAPsNs&_nc_oc=Adr61km5UJrWLYlfPGVQup9-F8rFAMo0vgCoKr1Ms7niiVL5dCgaU5p76Vtk1T00cHk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZRqYRY2pNyzhHMMXCtEPGxO_tOEypVXlCFUBvMtUgoQ&oe=6A660585"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKkh6-XfOBQQ7kNvwEXkN9Q&_nc_oc=AdrOJVyukXTZ3vZKZwFTqcomMxsiOdRu8a5zpkgyvWT_YZxuz_8wSH7rSmZZ6f4OKLM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkvEsutgohBYEexA9HnD3-CZj8RukXLawOll3h297E0Q&oe=6A6608E8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTbzkdIuCH0Q7kNvwFygMjY&_nc_oc=Adof7un3RBd4DuZfmjlpNwuD4AszXkn7GW4uW02u5jAX6Y-tJ46WzKqJvSblZhakWpM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFKis8h-IAx_WdjqDh2ZHUQ3r5bOEXRA3f1Yur6gG6AQ&oe=6A660AFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNS_EH46uQkQ7kNvwHoINGe&_nc_oc=AdqC9d3z_s91eFkouszzXXF_zSTiTKpHJ2cqr_pWVLv_11tidoVVTYd8mBplcmrZXAw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdAkjXAmsHmknFSfVfgLhE-sTyIaglQKEvd9ffJ1-1hA&oe=6A661EEB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
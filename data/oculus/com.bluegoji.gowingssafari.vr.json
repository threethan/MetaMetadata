F0jLS&_nc_oc=AdrgzHlL7j9SybLDMsiKFNoQ8ySKp2EXoanpmhZrbck7yvwO4eD6NgiUjkah2X_5B88&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9ezuvYXgKY-pGp7pUzMwSEnGzReddjqHPO5iUl9QSXQ&oe=6A8AD568"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mGVdiz0c-10Q7kNvwFRBPbD&_nc_oc=AdpzOaCrimTPtkwnUGgRtFPqPoh55k48uqeVbee7XnPPfRH1BL6zjl8-27kYItM30Cs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkipu6vg9YWVdkxcLCGG_C9rPS70i5F7Ek9kgY5Il7SA&oe=6A8AEF85"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z75ayZfTYrMQ7kNvwGxqw6M&_nc_oc=AdrhfBV9VP-76hRuBxpedoE1Pob3XfQgh0OIAp8VDXgNCeEyRQKccWsoiW7EuS8TXck&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGm61uejxu1w6RQrFnhzQGSvvYKfbf0PbNE4UHrYkHO1Q&oe=6A8AF2E8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBhxMhA_8YQQ7kNvwHTf3VD&_nc_oc=Adqux5_0MRy8bAK9kQHfpoRUwnjbLBOkT78Jmt1HnyCzdY5xk_90EkDdicq2ftFRbHI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-FXJ9ZWiQi22k9_OnrE1YmZ4t-qXrJ7sUn1a1HsNuMg&oe=6A8AF4FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bB_j9X9XFQQQ7kNvwED58AX&_nc_oc=AdpsU98tFvOfbjzuI4YMiwJtf_vB2BS1SQag4jy7P5nfNY7SiFJHQ7KANt8qpvqmdZQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuAm1B58v_tcucui7b1CafJNHyvwWtNsZSFt2gM0WMXg&oe=6A8AD0AB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
O7Y7D&_nc_oc=AdptIkrJ_WjCTNrB6Dm5knCpkPH51NPT25k8_4RqHOVFb59SHiaTZACBZ2OZruP8txY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_loQv5Sdhyj1qSA4MxuS8Z1lN2K89wKOe8cmA8N2JXRw&oe=6A3D4528"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rm0xpA6QQloQ7kNvwFN9TWr&_nc_oc=Adq_APxOW7uxsFV59OhS6ammcUDBb4JuiYtB-Gl1BgbUOnOyeGzEG0S0_I_zOzoGQn8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WErC7FCZeImUbPoTd7_A2xR0M1HEA5l79f2w6hFpmKw&oe=6A3D2705"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rnv95FMijWgQ7kNvwHPGAQL&_nc_oc=AdqbagiBvk5df5qxGibUvYn2prMtV4lAjo_8_XF2nqHO40wcCMByudZg-LugcS5zq8U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2UxL_7kPZ0SW7CwN8spnicxnlSIi0EL_b56qShDfukg&oe=6A3D2A68"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wa9gxaOou_YQ7kNvwGwWENV&_nc_oc=AdrONlpps06mpkxcziy_xaRueCgoF2RR5YNp74YC0jUL9MmCw0xZcb4yAagu4uDqmSc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9ZEZxwDGQl-EtFGqLPaDF0ZAM-6by16CfB_xg2NM6uA&oe=6A3D2C7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nNXIhAHp3EQ7kNvwG6BTQC&_nc_oc=AdqEdDwv0nLZ0FQR2GLDF1UN-A6ubtQODDOUZ_5aXww7Kv8wbPI-1UytSSm-1rhYcnw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lsorImoEc1vEZZJmoL_v-CbNX1IQxiW-hRmJPikRkbg&oe=6A3D406B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
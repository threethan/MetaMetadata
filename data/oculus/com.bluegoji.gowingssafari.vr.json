pvIIQ&_nc_oc=Adp42iALKAcgZxxLW-ERVbSFemt7TCsobnICYDud3ZxJ7d2FgEoMrMlMZv2UOeeZ-pQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcZBGSLCWoUq3N_1SO8iriiSs3sBJTtGewlWK-xRm7Jw&oe=6A5B5F68"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCvPRePR4X0Q7kNvwE0AA4N&_nc_oc=AdpBp6hINBZgv2hlHbCdxH7oLBgDfiyzkgDHYYFjtiIBW7XsAtarouDdmYpHsN7f3aM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuuwXuP3Ak92jMJMRLtIKe3Lv_wTJ-2cwozxpVEg7XRA&oe=6A5B7985"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShqwcmYXbGMQ7kNvwGtwedJ&_nc_oc=Adp2Ac2npMu7nMVEDAw9ys53Qs8QfzEISOkVGux64GBzSLyOp3b_yvVqNuuR6zHvY_4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnUj1mf0gBuOTrJn4FV-0_qW4Sk10aDm-NY-T5gC_c8w&oe=6A5B7CE8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DE81bNmE1_sQ7kNvwHKZSOu&_nc_oc=AdpylgETd_4wZ5eOP2fmIVSEpEboS7aupXT-BdhDk6ujvPiScVXuRqNevf0Mv4fD6WA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDP1VJDRVZYm6gQtqY6H-iwxPXo1ABSFYs6UUV9CSzaXg&oe=6A5B7EFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWne00J0-ngQ7kNvwHhXvrf&_nc_oc=AdqERPRmPwlYZCJGDO1l60nMq82N-BRGBilr9WRGQGZ6E6B3cZAyvJunwns3qubzu2E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDu2zkUU76e4ptkR8K05QJo4SftnxOaT-HpoZi4B5dlow&oe=6A5B92EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
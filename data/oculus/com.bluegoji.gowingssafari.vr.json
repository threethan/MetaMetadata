5Nkxo&_nc_oc=Adpr4QX3Al2Q4Emo9TfdGvGK89qi6GmeqB66TlSz-r6xkLkbRxWklCcaGWX8ObvaRiA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2X2sFcXqOYoUOauD5HhFhaIGNr5FJuBGyBm2mrhQJqJg&oe=69E4B868"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCjay9Zda-QQ7kNvwG4kfGg&_nc_oc=AdrupEBNdTSdiA4TJWixh1iYguJSUMS600hcM3UZikmRzMuS67qmNqrHCpbPE-vBHU4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qKn22de12jIhksyZ0PDa7W7sVM_HfX9Z9k_wtiOQhRQ&oe=69E4D285"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkT58E-ctPsQ7kNvwGAq1j9&_nc_oc=AdpM7LsehqoeK8mvsmh-_nsDnVmDX4DT3qFTCV4JtjPbpFeP8ccbZwN-kmI_xlU62WU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uRC_bzn1sopaqlR2sxWV4xGPlJipUyl_fLFHywLXAtQ&oe=69E4D5E8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxRWk32q7AUQ7kNvwEKtmi0&_nc_oc=AdqCliz3kynhxQbTxH0ejenmleSL0FGe8PFNQwvklcb6In0295zCRqxyUjmKZcJ4Iaw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bbcT3gpBOr0fqikW_yyUDyHpdYkiKz4sD1JmWdD_Rvg&oe=69E4D7FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rdr1_z3sLK4Q7kNvwE1HHix&_nc_oc=Ado5iekLoMWB-MhcMXDX1Yk-p9wnHngUkMyfMcsRzBUm7KYpYMIcRcPSjae4L6gonnc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qyp3jYZj3aTVz80o7hLNez0wyHiZJjZ9c-z8Ws7-Eqg&oe=69E4EBEB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
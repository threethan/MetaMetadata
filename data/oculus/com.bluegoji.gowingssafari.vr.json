zTJy7&_nc_oc=AdpjnU1ovfOYJkXBd_G5zQwnBY0dSwEioOYvllGAH4sW1xKM6VPGBXCKInSJQTnjCGA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3R7cnxbyF-itUHQGRjI6LSlF5NKd2IBz3ZyZG2MsOAtQ&oe=69E75B68"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFRBHArcEucQ7kNvwGuzW0i&_nc_oc=Adp-08QktWlsSINmvSjc8Nqj8NX6xqvhj8Sq5efwmYlK0AMBkvLyNaOCrkaLPughd5U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YDaz8_gscfrAkD8V81f4juo9gBFDYqii8qvupudTwZw&oe=69E77585"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LoJUlcUADBQQ7kNvwHd4n3r&_nc_oc=AdrmKlelrlYLh10TedXgYS_WKYXl-57miDTY0-Rm7lFdeLPQntLA2WRFLwGIFMJxyUM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vtYEOhPbtipdyhAdcySlFl1XERr2JRviyQFW8OEd52w&oe=69E778E8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxRWk32q7AUQ7kNvwGULJpb&_nc_oc=Adq2Qqlxrzr-MDBm-t8DOlm60H6ZV4xFj3z1QS6DNYK8D2DGhor5qn7fOe_3hL1IbeI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2iklDwvpZDwezwABfoPfwTbYbnr5N3kvkr-xKhnxzJMA&oe=69E77AFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rdr1_z3sLK4Q7kNvwFYxP1v&_nc_oc=Adr4KymGWS3p_x7jcKFpCwlLCopN-etATPjwI_cO_cIAjBvf8y4V9lWNOi60zUtK_XM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fP8j2P5AFy7m1A41ApnVe0p-LhR2Hpcy5ANToUw4QyA&oe=69E78EEB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
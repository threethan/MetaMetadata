39DMi&_nc_oc=Adrs6fQNrcZTuT-3Lo-4blrm2S17R7rxVACbJc-RQCzA7IS5vtB-Huu6NXBkQfnAymc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGBWKt2lqk3E0CTYfwE31OvwJTOcPNONO4xt4q5EeMZQ&oe=6A82EC68"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMSAb73SvIcQ7kNvwE0jcSn&_nc_oc=Ado2lu1egYtNv7f34EiDSoboYTnCSAaYOsHKV_6JhcXKCNp8xgRiB4XU5nxNW0YxZcM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEo5a-RS-MQw8YzxAX5QO54_SBPNCQDQFmUtIY_v9uUEQ&oe=6A830685"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPeVsSi2Vw4Q7kNvwGKPRAU&_nc_oc=AdrKZa_pBnDwKJbheY7481CXIfV9Ecchqbu8O7yGK1lA4jSZq70QUy3OYHoOp5WXHCU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGThrF1ervvuo7DFiO28ODNPiaERKtVZN9oRhWGDTyAhQ&oe=6A8309E8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGtcXIGqCyIQ7kNvwFryrbB&_nc_oc=AdqEBz4E9yeXTjmbzssHqh6ENA1rPvk3qbIsnmi6en4HSsbJoImANXjkKQccjOqV27s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErb6c4Ody5RbBi8ZisShrAtiFF0poMUkU9MqkwzK-9Sg&oe=6A830BFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUfiimIkaScQ7kNvwGifeaY&_nc_oc=AdqTK3mWubMIwdxfzsT2OcifRs1_VzqmB0KuxoK9GCtM2yYJnEVPbjVof3Sgh0mUZ04&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTlIvXIGu5b8e8WUDZMD_o0LgXduOL4jLe5Wp88fkViA&oe=6A82E7AB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
CD3A0&_nc_oc=AdojsvGqo24AryiK8cC-57AUYt5WYBkZhwfWuE4PFj89xFH9FIcTQRN3Q1TKK1Ob7Hs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEcp8kg6IYhjBLlDxjLtkfpWbs-6yDHNk1tF63W0lN6A&oe=6AC26CA8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=buV7tx-bUE4Q7kNvwHXeQ7M&_nc_oc=AdpsAZ0kIaCt5roI-SK5puQ4kZC0duq81Bh0j7vHz9kAAXfQZ_NGQj2IBHyH2aLu_08&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVDUTZgBePupG64s9kbYNZqRVxSyL2zbVUMMgkOT1MNA&oe=6AC286C5"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tR6T90Y8fWAQ7kNvwGFUDXu&_nc_oc=AdphhlMd8MM_EfonAdfFCeamAPIrbW9cc6FQ9FIjgQceCMWOIUGT4d0a57tUoIgphNk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNL-f9KKPVyOiwHyr6G3vJmAKcLqMkIvyqNQrpGIudOXg&oe=6AC251E8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MreihcsMRX4Q7kNvwEwIIih&_nc_oc=AdoquJuH6vOXlhd0M8f3wK76CT13PiQ25u4jbQ7jrUYnw7qwHgV3aeUmYG_8ww25VWw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZqT7wqAYPqwWA1kKcKX0YDdpX6mPlCOX-smDIFIrWYg&oe=6AC253FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84SdsaFpDiAQ7kNvwH7U1jo&_nc_oc=AdrMswA0pplRug7cx2xl1ybiotiJaY2Rg8qqvyqChI_dGasRybeDIA6ULjtTv9Zq4Y0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9JAdlWlaBEhVZBkS1TUzqHTfOoPekoXah9f2MHCPt9g&oe=6AC267EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
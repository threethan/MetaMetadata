Z_bE8&_nc_oc=Adr1ZgjzjL-0-8QnmBmqsaVtzKsXTw1VKQks9ShxKIX9VbFPi7Xs6OOKFAidbCq-eUE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58qllVo69j3z-_o_uFvSKZlMRtiaBF70o1aALVY-RIag&oe=6A1C4FA8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4U9t3rXeeUYQ7kNvwGtzt89&_nc_oc=AdqfQPxs0749jH_qLqtNQfNDRj1z9Qt1O4Tm-lSDhQiitELQWieZgzrnCdrPmANp-S4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af700LQPnCWQ_PSJVFr9Wc4qPQuPEcWQ7h9qKnWijN_GWg&oe=6A1C3185"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiQxPwz3X_IQ7kNvwG8Runt&_nc_oc=AdqzuBH0aS6MuFcmsgEkypW9cMmjwVThtRoMFeziFkQggpcoOvi0c6BG2hqCKZnMMuA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nDuhElScwJ9YF3fVid36Mps5H0LdiXluDpMrHB76icg&oe=6A1C34E8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvtX2fiYZtEQ7kNvwFdF6Kj&_nc_oc=AdpoYxnlEODu8e_U-IiU2bwvm5d2GoAqtJQIcEveR5KeTMs1VAO-xa1NpIUILHsdlmM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57WUI5pXheCueLvCHiXbkQMJ0TPciTVBmJeE4ZDNdHfg&oe=6A1C36FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgUUEgpSD8YQ7kNvwFMQOCs&_nc_oc=AdqPLN6ZtbDByuFZb5wXr68haxthRQGK0x6cus0F4aXXQdgjdRK1giTNMuOZtXcEzeg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5R4bw2BBif7V6_6lOhuBXxMBBP1GhgpkWWeCKwRfmntA&oe=6A1C4AEB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
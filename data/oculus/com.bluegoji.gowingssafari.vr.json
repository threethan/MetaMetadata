BWGhH&_nc_oc=AdpfNmGS2zH6c-q5dfuARtIoo7IzOvod_gVq2zYYw2zU4SogoLL4xJFLJ3TwsGCVUi8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPK1L5O1NkNm4JoFxFp--GM1JhyOLKGCmu9vtfYMOcdBQ&oe=6ACF9BA8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=556LaJm5LN4Q7kNvwEHLLWz&_nc_oc=AdrG-JzUeZ4Uyr4LSme63w865e22OW4ll9YN7D4zuHkySUQS3Q5cIMIyqLlSa33jt-w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeKHAHFWD4VOhqptr_B74LSCSXEym4btzFeVWWCVIsLw&oe=6ACFB5C5"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTBJwpwvOykQ7kNvwFTohQ9&_nc_oc=AdoX466x2EFRHnxcoqv0csFaVqYhVcRpoz9kPAp0cxo29oY0dobScDPcKglCYKMcCDE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUKgpbgpCULTsV1kRBqFDpu74kI3YD4Oc9Xux7eR3qqw&oe=6ACF80E8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ugjnWfCbJAQ7kNvwEx_o4F&_nc_oc=Ado-0z6Q0Y-IiE5Mk8bhHPoYcrgG0USgep7q8VLoxuAQyLCRIkTgMDAcU-1mXg4hffk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxEORzJhNlpGyAOu2dru2PvtR6jttHw9VZKUIkMrHSxw&oe=6ACF82FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EA5g8lRFvfUQ7kNvwEp3Wey&_nc_oc=AdqenfLSzGoB1QpMuBZxGv6iD9QJbqljLg_70Yfc7k2LDnkN6oT5dmykQSP-Shp937c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbsP1A4xc_NAJD75USWjo5snzwFqfKT7huif2hAsBwRg&oe=6ACF96EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
t-sjc3-1.oculuscdn.com&oh=00_AfvHfZBGuqdr4KRR6ZMcs_lPoHrqm3EkeOY33w07Rzol2A&oe=69984168"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziJw5Dm3_pEQ7kNvwE-MDiE&_nc_oc=AdkfX3gRBAzsJIZHFdMXS_po9nQUPt5MGWctRLvNoADILk7D8laXvVoFpVslwgutIu4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afv9LrpPUbHz4cGuSi4aWD_AZZTUWLhur79Lbgvp4OuhFg&oe=69985B85"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iJ0aw4LgiUQ7kNvwEgmtC_&_nc_oc=Adn2Dz5ffsreMfkozWkMTJlKKMCuUxRpZ0CjX8S0a6PZZTzgUZ-Rg7B8BJ4tfwgg-tU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftmONuDwbbqApG6DxFN-1s7pN8Hi9sngRgqtnE70ysdkw&oe=69985EE8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQnt7-y8BXwQ7kNvwFk-o3y&_nc_oc=AdlfOQpfT2_xAScMUuUGkbjQhU5BaZyW7SS8kiETEWZ-MdDVvfKPL07lh_gXdMb2hIg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvNTUKopfFNHQ4DIVpfu-MPX2AdUGBbOPfTl1-MxDoxmw&oe=699860FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7L-jZ1Yk1MQ7kNvwEaGex4&_nc_oc=AdmVbpoEVh_poUGNSRtGoQlGJrd97xcT0H1miSToyga354nVY5JsM_0mhc--K0G0teI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfshcVYwO2upJlng31lAdpQwDRljNIbDPP_EXX61mXH8ZQ&oe=69983CAB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1483516800, "lastRevision": {"nodes": [{"id": "1294832573914757", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"applicati
bnM86&_nc_oc=AdqesF_mtHX9zoO4MnZktEDsLI6EwhvgLsBVDqjL_G_MIxdrXr6fR_Yxs2SyhOrj_4E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ol7k5JPCA9tpuGHjpVgBCKfLk761seR2iE18HYioU7g&oe=6A428B28"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jsvVxZ3HLYQ7kNvwFvvfVN&_nc_oc=AdroNJjJSEjSQhRlSQWOP_a8jIROxBrHSyfzCU0-0xBVNxEx5kCy9_m-OBKfTO_juu4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QerFrq_Wsdj-7BuyTSZvdgPXnntSGT8TbTLI7I60_mg&oe=6A426D05"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-_WOllNHA4Q7kNvwEWtFA0&_nc_oc=AdogBKnaV8RIry0SGNCAnhTJ_Z2EzgGm9EvGclX5a-SkpYdenq_DlT0zppQz_n8NyoY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8OtB0hxeH5FWiKGRAYDfH1X6TBIIcs28O75oZNDhZhg&oe=6A427068"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RtJgLgeiNcQQ7kNvwHBQb37&_nc_oc=AdpfhRPobszmQ9pmedYMny8vQjM7nxIf4u4Bn4IFkyJErhyqOshdVHxfSsRAyYhp-ZU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95hMyozaRT084yCA5PYCzYaMVmh1N5VOVCtPoFuCUYpg&oe=6A42727C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URg45uIY9eMQ7kNvwFCjdxi&_nc_oc=AdoH9DYy7hR1VsSJtqpvMdvy0V7Z_Pa0mn7-91dpNvNEUTx4AJJPpWUObjlgQoxaNfI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-71B5-640VzlSF2WIgjOfX7qoZhh2iBPItObSdfQGPAw&oe=6A42866B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
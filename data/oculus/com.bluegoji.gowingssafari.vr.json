ROFL2&_nc_oc=AdoN7mTKBeh-mQ0xX4UCWK1Jodnzc4UvBlXoPbE03kOYTUvSoFd7kHWg5eCFsfpTn7E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKu351PjL6whlZJsu3uK-YusfIQUrh6aAplQ1xq4q_93A&oe=6AAFF7A8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmFS-gFFSrMQ7kNvwFqv35O&_nc_oc=Ado_KGMtOnR_6MR7WYmLFmE6pTqbXD6m9dkDL6whN-fC9IXNMRxzqhhLiV3tI5wS6LA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOb6GG8hx3nX3H0bsRqas6wAKX1lwj2LFPgxzkQBl3EA&oe=6AAFD985"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmjkifoV_r8Q7kNvwFTFsf-&_nc_oc=Adr_ZrCiTFi7PCnXaDimAWSzTh9i3lsVqEQQGA9F6BRyjgH37jEBmkCY-QqF3wzURys&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKW9qSijnLb7_K0xv187EPiLDC25gs-XR0qf1LYqltpzA&oe=6AAFDCE8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4KWWBuofsuAQ7kNvwEku6KN&_nc_oc=Adr99sxV1zvd20sB2SHCy8CF4y_791KOhiQppMa5BQw4DMGM3iJevzA4RSa1Lpr35DQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWW4xkfu_TzcBBC7DECCLH7dNghngMyIXzFtt91GyRQQ&oe=6AAFDEFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5O_vfPGWerkQ7kNvwEk2K86&_nc_oc=Adp0uSXGqfe7X3UjSP2rbIBqyxlvZC4vDm4xo16tHtb3KaX0jj7mVe8263nFGd0bH_8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIO6rW2tZkIdpGo6dMXpYHTBLeXA817zdKxU1gBctk8ZA&oe=6AAFF2EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
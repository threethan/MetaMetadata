qRl7W&_nc_oc=AdoMk-EW_EnlOKEiquqiY5LsyrY-Rjh9wZe4FEsfxaBmY_A0FYoMaHOmyFZqMCuRGFA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vkwbHTGJXkDtFrm1yDV7aH9hy_RrxCQFshFp_8XcMzw&oe=69DF7268"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POeJf8ze4FYQ7kNvwHP8trB&_nc_oc=AdrzAAw8o4msrqyYStl3aM6wKNKgSPAvNmJG8bTVcqDSmxZC6c2IKEuhrv_V0Fm41n4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MpGaCzj1lTk2QGhEOrsCrvvbH4hI8lUYhfTkjVhbHQg&oe=69DF8C85"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuhaBFUZzY4Q7kNvwEtuuwm&_nc_oc=AdocsmcqX_ni_4_g1FEss0M_Db4YVNleRI7JDKvubjRPbw4JZGRvU7pH0Ot2_giqHIQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3k3_1avcH1mQweraHqq7I2EwT1OoXPcdCyDeslqBmzmQ&oe=69DF8FE8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SfU5jq9iX8Q7kNvwGTnt6e&_nc_oc=AdqLn79RMuF1MUqohGSM9GFHA5RmOBzNk6IwW_lHSEpFTXFeipfCnkBQu4bvyAmgL5M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NX6kzjeCoyA1GZ8707lyLy-2l5JUZXilGPsE10PhSpQ&oe=69DF91FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LPL6xFm9OgQ7kNvwF0A1NU&_nc_oc=AdqwdKdx2XZM7G4pnril2BRwULpyt3JeOBYvYn8mqOydDekbXLHQlnALIlVIbiGLOpY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pGPnuToMhKUKIBgwBY0hhXXEYia3l-bmw9LmdvcgjBg&oe=69DF6DAB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
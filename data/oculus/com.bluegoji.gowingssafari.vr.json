t-iad3-2.oculuscdn.com&oh=00_AftruXM0h6VFEny3pZDpH6_7TaARGwdz-GmZiLaS3__tzQ&oe=69A02A68"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srjaUvSnPJgQ7kNvwG3FWC4&_nc_oc=Adm7RvrSUwkPoCnQx4ZHssOkYG4eXmbOOizPnjE7OlBBNZh9vaPuQ2Vbuh67RbuLcs0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfurFOKhQGs9dCq962k_XnrURVj5Z7FwGZv7YH6QhCpsjQ&oe=69A04485"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcztmVpoTs8Q7kNvwFG-aNe&_nc_oc=AdksWlDDAtOOziKvoFJ6NeMFopbbX6Vxo4_pJSKh4e3wd7FZsha4tJvhm5A4sFbBWuU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsdhoL--ppXln9QTdhUwc50KL0e1NzxuRanPAbElXbSyA&oe=69A047E8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvB7HIDi-dkQ7kNvwHjK8jH&_nc_oc=AdklzghRTAauttWgxLK760ey1jKfX104XG7wrBUl9uPe67-e4_Xgl4SMPx-V4an-4wc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvM1iYzOpUqZ7_Hzqp16A_gdQ6jc4plQYmsy2clmIG4kA&oe=69A049FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foavd-Nk-TsQ7kNvwFxr-gc&_nc_oc=AdnvKQIC1tSAuHB-K2v_cpag3wjRz9utwEfKbDoX9zAu7DRZ0CicifvIOkm_AJZBMq4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuiV7QPMqmmIza053oGXvIad3fp0OHjTYyNVbmAA5Yntg&oe=69A025AB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1483516800, "lastRevision": {"nodes": [{"id": "1294832573914757", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"applicati
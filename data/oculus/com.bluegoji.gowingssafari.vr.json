2haXP&_nc_oc=AdoXuNHX7t8zHmZKQ4SvR7uuCJPbSAA1G-tkVYOwaXHw0P7W4GuEhQCgh1jwkAS6tHw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgzgA7iqjpYWa6EPoXU4BLC7mGZjoA6fIy6_birEihIg&oe=6A4D1728"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Z1t4StzeasQ7kNvwEKn0YT&_nc_oc=AdpFpoIdyeeQXWDkNBf2Ar7gHOQpx84p7I2X5I4aRctv-Bn26dJWK_S4mb85ADmOCy0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbQFXvlBs8rWa5a4GQhC6-rD6qSo7qTTcKOeml7J63Wg&oe=6A4CF905"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCKl4RgWFusQ7kNvwH-0_xy&_nc_oc=Ado6GA9AmnHwW5R_9Za3JirqqooJnZiHVrQzon0IGEhNdy_DTrcqtG8knHleBDa6KLo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwBw07xS8HYprrmHM4bJ1liQa6T55cX5gjnu11GsXv3w&oe=6A4CFC68"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryyqOCbv7bsQ7kNvwH1W7al&_nc_oc=Adrh_zWOvFxnwgk4OJNvmp8m_Xc9ouNJQOPLfl92uF2idWeLFajDTX-ING4fLHFqrLo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8gUphc4j0v25bkLGX0_P0kG0NLY3qpzrNPuptHlwsaA&oe=6A4CFE7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOLFWiSSCdcQ7kNvwFnHp1s&_nc_oc=Adq94RHpTRkIMG0IrYibwPhV3cEy93T6RryNp3t96JIqXYu5vZd3bBYFhzwF-SON7bw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_jcmnjZIv7kWgxch_vYN843RKFgCrbJg97SEgstx-dw&oe=6A4D126B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
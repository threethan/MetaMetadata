xk6JM&_nc_oc=AdrP7GQFb1TaP2UijDvkjZAiNWi_aY3IIJEdlzYwW9UE0fXVzRQw5HTe1H5Gvqi-USY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0kapnkXEwTNCMI4CueOTcUsGvOoNq2qneF1muRQJLxdw&oe=69EF7CA8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QH0jP_vx5h8Q7kNvwHIvDF3&_nc_oc=AdqDf5Rl2pVtzFdLcEmFk-EZdXT6Whlw-73rVmZ9ZZG-dGHv1b2w2M6E8OwhuNI10fI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3FMG8bFvr6XeKK_bMhDGsdguj8ZFPLgOXL8U5Ck8diTg&oe=69EF5E85"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZyv_UAQHGEQ7kNvwHfjJUl&_nc_oc=Adp2766JScg4u2cT4rbHHatNtZ1nYgzZxUU6fIkufgs0GPoOKLz8OCG8yiZt2Mbvi-M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af37qzNnFnpaIYu8I3j9l3Vhy2xUbihGTu_kPr1d_bN6mw&oe=69EF61E8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-ygI7ea7n8Q7kNvwEhHunB&_nc_oc=AdrE79SIvJb3jkB8wWd3dAKoYcMZxR1jpV6-D4KgILwAPD5k2mGm2HmrIsqW5-jtuQA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3oKq3dqpNqd4r8pkpJ9YXhD7k6TmLE5dLtCkvwGffMng&oe=69EF63FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PU1AiSl11cQ7kNvwEdeyZP&_nc_oc=AdomzTLfPKORHO7V-Fd51npJiZOQKdi8GLVq5Jj8O0Cuul_S8OZYgn8njquOR74Pk9Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af25gQB-kEduR2279JfXpS2XWVc0mzohrOZJ-62xLU64YA&oe=69EF77EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
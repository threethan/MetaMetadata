qUibv&_nc_oc=Adrh2KGlqm5INJ8P85pbuXyh3zFh1UNKcmVizMIr4rK9ucsdwADBgcSTp3Bfp0i__mc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0LGypae06XHWQCi7u5MwwwUYNJSDMgIKTzek2VG9VSg&oe=6AB68F28"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBDKBzy0xWgQ7kNvwHs3Vke&_nc_oc=AdpCqcgdP0C3pX_uGVc-reZ-CaPstTLTBu5Xy3nU26sdvgkvkMxZN7kbjBpnQdwpflY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjXv4tqDUOQKeLufixk3ODvViJXzpN1Fr4Ss8StS-WAg&oe=6AB67105"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSyDg7BBN6sQ7kNvwEXkYO6&_nc_oc=AdqiID7kmHUbEg0EDea0CRI7XfIaMm9uG5UOrID5Cm3XqQbFvZzxe5jomEvLVJTo6Gg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJ1UJVlgNmSKD0jZuXvmrFBM7QWSN0y-PVsO5bfIDhzA&oe=6AB67468"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVJpDRD4uBkQ7kNvwH-vdta&_nc_oc=AdoeFwq27KnZbFcgLiL-OJgx28RJ5RwbSNhZnxtOXwPuR4lXu72eo6AX-o8uNTHwLP8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlh9hGZ-Q33NbDP0Nv6QYx4LcVV_L1mUzyilBCUVxZkw&oe=6AB6767C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0SUMbmnSPgQ7kNvwFHqz-o&_nc_oc=Adqu-iSHLIxsRB8gwgLbn3aJ59W_PDg15-JZq0SmFlvGSPqazbW2q12MQa477AU6W_I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDd1Ae7oLvqQi4TnApe-798uJnkky9akJoPnv_7UaPlA&oe=6AB68A6B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
Ul8t1&_nc_oc=Adpm4Sw0APXTvGEjLoHQeQQgrjDfC_EJPLaqi2i4m8nBCsal2AvkYff14pmgwQb0GEI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GRuX8fC5A20fmr4QDpqc7Wz_sevJVD5KIN_BwbX17jw&oe=69DCCF68"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tey_HSCTFQ0Q7kNvwFwAwAL&_nc_oc=AdqUEISBB9gND29pP7feyP-KNX-rmOPx_dpDEVz5YeHR7BY0xAzAAa2L7ghBxurWiag&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NqMxDnjuojJe5OZG_MpU8zE9ww2dVbwq7en_Q8yZaRA&oe=69DCE985"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KrVMC9nZdIQ7kNvwHyEAqG&_nc_oc=AdoXZwwClB9ziKi0ydmhwfXXlOaKwzjih3nWXa-ssrGoQwCkHN7JEmRLB-ZuK37TUt8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LY1Zo2TRZVadUSuaEEMXDi5yuwrR7RBoe5a3sgHAKDg&oe=69DCECE8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SfU5jq9iX8Q7kNvwGz0t9W&_nc_oc=AdppU0ktS49DCST4RKVqH42qDnbVEnkTeA5fwJOmJkDjzj2y391DrmgXbRpe2JMbwNM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2P9AnUxoPQafxfxJBtpm49E7yvSNy4cXQOdskBaYLq-w&oe=69DCEEFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LPL6xFm9OgQ7kNvwGh5ryl&_nc_oc=Adr7FBeShinna2Vi5ZAF4ijNPqbtFfM6rjc986Z0-_aU52RDQRuEaapfex-MhFt4xEQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1d_6k28JsBbhuh8wpBBMykoHAuFdkd-aUMsqRi6xKBXQ&oe=69DD02EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
37jaz&_nc_oc=AdqNjIliw8dcn0tnvoJnAJgEhpFU8rdZUASP9MNPXJgUaKFACCn1ZjYyDWlq6YSKFvA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTYBul47yZFZaEw7amJnFwSPmiGeQMS_1lG19AdJvIgQ&oe=6AA17728"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsUTe8PyXq8Q7kNvwFw0dec&_nc_oc=AdqOJDLkciBS6loAWrvuPCzadqN4nowDkPrVvtf4Q-3DH-9FJCtRLzl46SKEQk0k2is&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIChIMm0_027mkF2Q16TI0MgidfLzk9KMSQ4ZOKj4T7UQ&oe=6AA15905"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrbrTubQEBEQ7kNvwFuiXru&_nc_oc=AdpwWmyGx7k3J2HcHIt1qMZMrY2HGnu6XUegXRH_8SO0x2KSkQIkk7kPuhPUB3kAN00&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKn1dxmJ_HsoW_QnSy67EkHO0Z0I84862AWa10Oy6dxsg&oe=6AA15C68"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rN_vLWtf5AUQ7kNvwE9qKkE&_nc_oc=AdqXFLkiphwYJ9hXxCRsTbtBObVybR7AO_8x3ginA-voAJPRPebV1KaSL48C6wZtTOw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4OhQ_a9Orqg-Okb5TSpmHfP5r_inKEB_FDIlgggp_0w&oe=6AA15E7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvHrmU5215wQ7kNvwHiOw0q&_nc_oc=AdpW2lVAjC1Mcd92fFX5q_HVT1f-4RsK8m1EDqDSBqVcA5SQX-Ukq0efc2JvT_eMptU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLR7od9SLe1e0ED7d_LN5WJR2LRtoc5rnmRi-y2UmMpLQ&oe=6AA1726B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
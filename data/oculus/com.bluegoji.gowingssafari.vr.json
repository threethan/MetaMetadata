hxDFv&_nc_oc=Adq3icHMpVFu2X79ybxVdPY3Ev7a6rMXjQH2DsngLfKni_dyWIhxn5IVSfYp_3N6EN8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WD1INa8uFBWnsOacgkoUn9abOmjdgGrgQtPSeHpoWeA&oe=6A282D28"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9f9oPu49LBIQ7kNvwF1ABhU&_nc_oc=Ado9mjs5mLY06xLORkUbDWZ72rIPHEGSIe73xDxoH3l2B3yeFOeTlxXuoA6b7WzYrZQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FxF2hhQ4hmn9Vypj_hdoeG2lhtlw0OgtIXdCd4MtzgA&oe=6A280F05"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tb8f7CXCjjoQ7kNvwE3np4U&_nc_oc=AdquZ-8BNz11qHsUCmdDvfr24m-Bpvp4i-j9Aij0FRONl0lYHlVRFF7uh1lQCpmnLO4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_38jZHLLoRpLtEgZ0SgnKrm4W082vCfeLEomfPHNaaKg&oe=6A281268"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joZ8V6PrIIoQ7kNvwG3Hv-9&_nc_oc=AdqbdQ1kRtbKQPMPehr-RNKl2xq7uCkuCrAsdWpapJPBSHAtzRoMF3deWESV3P5vjac&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HGASWxLXbUVs5V9MgHQ4pLc-zhIsElNOnXz7S4qXjXw&oe=6A28147C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBnUL9GH4lcQ7kNvwH6KDxY&_nc_oc=AdoY9oXoBcNOvhTD7_xhD7IlMAt2Zc6RVGE2wpxDWnMf2NGz0rd8_A8dtDFqXCBJ-B8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vxFNDPv-AWxuTbY6272phkZ1X0bGa27Wkc7glsO8PSA&oe=6A28286B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
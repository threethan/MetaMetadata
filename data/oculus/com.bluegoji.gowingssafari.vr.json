B0ept&_nc_oc=AdrZUQ1BfuyzaC6GRKzbuEqVZq9WUMS920T3tBpc4GyxACc5_5Xiuqb8syum9yn94X4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15slpH9Qt5-fAxbINY3iNTXWx22PDBhAuFTQr4D-Zszg&oe=69E24DA8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCjay9Zda-QQ7kNvwFSe3PW&_nc_oc=AdrRRLunLE83WUMcOVMpUnFuS0ktu1Za5hrs-mikLBR7he6Kju6cS-Nk5YkWXcw1dW8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZVdAvdcqr7TcGGngeSqbMT5sI3-dkKUjzXBjB0zRFDw&oe=69E22F85"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkT58E-ctPsQ7kNvwFHTILG&_nc_oc=Adpz4Cq4YAivOM63eRdqhcPiP6Tq9vGA5Jtfx89U_viD-N_ls0Q9NhCq4RTzeZFtcjk&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cbFv3zj4yYgUgP4APgw3rFsWEtP688gn2jFOqkmIx2A&oe=69E232E8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9S9bC8c-0MQ7kNvwG1Te-C&_nc_oc=AdpJZ6zhiMlixMI8gNR2zXOw91OwvfVaIHEGY-B-0s8gS6gA4tsOMRvBNNQOCMeg7RM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jjiQGlBUmzf6bMctgDwlaLCQcW_6hy9X3094f6JHG3g&oe=69E234FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-oIR-wjLOAcQ7kNvwHkUqSH&_nc_oc=AdqS54O5X24lDpDcKI94twns08hCRobwXdZmD7U20oISedfkxlKetLpv6M9Wqmnmr_I&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0aA-Cc-wxwlbANKbPGwtfF6YtpCoHBxMBLhjeDINuYeQ&oe=69E248EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
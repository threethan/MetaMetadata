NnzxW&_nc_oc=AdpHzX2f7TSZ21GCxM7uO2Bu00dvsmXH7NI3hTomZweIaorRZo6qpwy9FXGOVN6MzfI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxRWLQ8eAGMbxiHTIRVmvEvK2q7w9Zdh9pck3kDWmI22A&oe=69CE4EE8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vd8qCY5Xh9AQ7kNvwGPSihn&_nc_oc=AdquvfqSCWn-6rD_KZ_7HR_qv1zRq_1pK0bncOY1y7uGmtxMyEC0v0FQNY0m1PaGIwk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2BSRZbKgDOpgIPR0La7eSItv9_iZ0R_skD9XjsAOqPg&oe=69CE6905"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5XZMxsMftYQ7kNvwFqEavS&_nc_oc=Adp49k6rp27dGWOvdK9Xx7CQjJW6zYAxJfsU4IBXafYqI6e1KaXyX0Tf24fRnNNtpxk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy3D-6MBc7eWpqWQv_9YqdVc6NOtZLys3Nxvn_rFrUKFA&oe=69CE6C68"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aD_q148Uh6gQ7kNvwHtnlvo&_nc_oc=AdrtFM_cZrjvo8F4Rc6SlQaFXJpg_R0QUUJaIcfAOK7vDIEjfrJt0z0rTQMKETLyfKs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyhCh3I9mAIciaPaSohzuaevFNdHOUOIlzEZ2LypSNjoQ&oe=69CE6E7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmO_eSCXfr4Q7kNvwFUxmpV&_nc_oc=Ador-lA8uClgxsUWf0SDmm7NV3xVnY2pJNM7B12Q28av4MXmc36IthOQpamDna1hYSo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfypS3SrQUHR5YbaRi4O2Mji1tzu89AA4r6Ac8mv6ueywQ&oe=69CE826B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
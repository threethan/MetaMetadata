EHQoR&_nc_oc=AdpUUp7jfsvZ4N9bzzVriy2w-t3MmkgrnSeEQ1A-7pK2n9kNFSWhcfYdZRyzilTASrs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83TSpOQ6_cHsCCIGWoQhvyvZYzfMWUrSaVAyXsj9h9Lg&oe=6A26DBA8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9f9oPu49LBIQ7kNvwFyuh3C&_nc_oc=Adqw9ljQNrKpGUp_D2RLuAf_86Cm5piR_tQvCnloCwE46C2Bh2_eP_E3flwyeS4ebKw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9i_Mh8FlllyVrY3U6gB7sMaWT1Hyv4ytkMgByNaBqEMQ&oe=6A26BD85"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tb8f7CXCjjoQ7kNvwH-cYEL&_nc_oc=AdqiTqCfjhH7-SzHNZ03cUCErklaXY08VhM3HoVzUCGzA-FGE5n8kXwoeTGz9TZQP1g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QQbs3ZqyPjo2lZ0Pa4EL97AN-aV5ZsbdDBq7c4sD2HA&oe=6A26C0E8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ab8Lck3g6UQ7kNvwFnGChU&_nc_oc=AdoP2wryA9wta7j9r0o_O-cUI3HR6gKemNcS0lW3TEQ7SnjGuIFjT5zpZR5tG0npzQM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7I9xvFl0fNDZNfz3VRczmzksTl25OX2ptX9GZPGYGPQ&oe=6A26C2FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSxSxOMTNP8Q7kNvwHWyQDg&_nc_oc=AdoDYmp7xOoqUj4-xq1WFnqqh7n5hFAKet9FEafNp_rImmtq_L62RMhyADPeQt_SH7E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aV21yGFxFKNLlZXlQ1AObRnKOZZFtS5uAg-k1A0YtOQ&oe=6A26D6EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
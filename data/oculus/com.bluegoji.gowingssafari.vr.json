vTgRw&_nc_oc=Adrmmghouo24bvBiCgAb0r794Vp_gDGbaEStaVhIzFb4sRGULyFbHWzQ1o_RYszoj7w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxmCWASLi5zxS4tJh80vO_0HUzzmJZ98Z13sPRb2pi_JQ&oe=69D0F1E8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vd8qCY5Xh9AQ7kNvwHWpDLO&_nc_oc=AdqDKIKXTnCoYPeqk1AnRr_iXGYq91fHCq1PSXSRp8COQ9vOfe5NcZ79cp7CTy3pLGQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxi_9uA9I01BlB3-LCZJjydMXLhz5lxKxPcOrKgb_D5Pg&oe=69D10C05"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5XZMxsMftYQ7kNvwHnDzL-&_nc_oc=AdpX3qb9swTt6GEc6EX-fD_i9h4oa3Dayi1w8pLWySQmORNEJO5ZQ2fUOgfCeaSC8bg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzC-PI2-Q8_p-zX3s-pIA188PQW63Tm1p8Buyk4G9aQ2w&oe=69D10F68"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeCZUFGb-SUQ7kNvwG8m6bz&_nc_oc=Adq_RWTOSNvQ8Q4Dah9sVfaAKsL_Kz-HRgg9TcNsWxvXj8FYATHHnWcVFc3OtCaRfkY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwfupK6xBtUh6B2oo62UvFwvcBLPT3ws1bEgZCNzQ0veA&oe=69D1117C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udNxdgk1n2YQ7kNvwGG7qBN&_nc_oc=Adp5brh5oCuaeQRwMigEEMk83zBkwHndlS3HX1gUPGhazJw9JVSyZ_9rlsc76t-BOnQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyEs6xyTeDQgfO0b-0T6hu75NFTHwfRjBxHnVjyILoGnA&oe=69D1256B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
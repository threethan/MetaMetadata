oPvAd&_nc_oc=Adq4Di4G5hOKv1isrHFMccDR7J-mcc4dKC1XY0WFWy7VT-dqHHn0BPgMvnX6kWM7yXc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7kMGEGcSMmPakS_gRB8Nh7l-T64Q38_XGdrI82Uw3Qw&oe=69C665E8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzRHI6jfugIQ7kNvwFOad0Y&_nc_oc=Adoqn5taUpBzn1bBUSn_i7ubGJypEg2ydScn8PKmiAQ2Db-LYT9hgsNbBUy3HoG1vaU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyBpzuql6ERb4l-t0uKcZbVQ3kMP7lSLTuuGOYzh5XChg&oe=69C68005"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RwHyqvkUzkQ7kNvwH9wVqN&_nc_oc=Adp950awsOPqwQQSQc1Oer98Lcf9fkDMMOB6rkAyb87A5GXaw2WoN-Ek5_0sOsXZWs0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwjV7SD9Xyzl4Uni_IWyCZqDya6pXmyN4ExCgL5NhArkw&oe=69C68368"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1mMV5KY9egQ7kNvwGUM5z7&_nc_oc=AdqZX9gtM8As4n57wssvtqX0X72grAXt7SKygIdGo8gdngBzyvyhfx73b9r4VcEopZQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzvyTchyWLZVSktHnqn7Idyl8X9XvT4wJYQj8P5A3ZtFg&oe=69C6857C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBgsPX1phRoQ7kNvwFd8vNj&_nc_oc=AdrFOSJr9FChIK-9dzXuI4jFkIYr1Mp3hvEDkxtt3M-kyn4NJGYhFC3Z9_gsxrWMhDU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZW2xTkrZkoxg--EMh0CRSqI2DlFLpgU8rB6sun49SYg&oe=69C6612B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
c87js&_nc_oc=AdpdTTOS9-3qHyPJPvOMAaE4b634dLrCkVzzU2uFOHYcUrT3lpLek2n1oVyvcp9cjTo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrlgo5M2wbQqR3RAn-1t6ot96uL0QpAFeSUpF54Xk9RQ&oe=6AC50FA8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_s_SHDql9GYQ7kNvwEv_xGn&_nc_oc=Adq8lVxwPEIJ9caunveE5B-EzZDdtGuxUAevUf2yHyxdtjgfnbus2DQTRlzW61OmBsw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXEnjrio859OitZ3anuDue0f_YivzVrV_E-bWh40qF1A&oe=6AC529C5"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j753Qt9l3gUQ7kNvwGoZia-&_nc_oc=AdrIoFw8FaKEL1997vAFdw2PDVn_j4i8J_k6siVuFzTU0gW9l4_H96CFusnBV8uHPLk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM84wtF-IXCdZsXEAndhf9JlF9j24fZh4hEXa-h2eYIfA&oe=6AC4F4E8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MreihcsMRX4Q7kNvwEC_ZAz&_nc_oc=AdqhLrAMozL9jIAo7lBpDMNvX_NLPu9uPM8e1i--VAmGNYwaQ0R9YW_4ueB9gY9QUEI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2zeXYK31KcCdHUNGSjIyIXhmHgckE042foTo4gXxh4Q&oe=6AC4F6FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84SdsaFpDiAQ7kNvwHOkyQ5&_nc_oc=AdoBmuC8L72Mr0SZCujL5VT_RathpmervaFrBZfhQhvu6KmKu9nedENHT2tjHRhjcl0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxt4uFw4wAqzAalBwSPuqAkj3qph1Q6qRqNCKU8EdjRQ&oe=6AC50AEB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
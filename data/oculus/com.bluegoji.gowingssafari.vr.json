zmHqN&_nc_oc=AdpzNdIRMEssDIsHMt0loV9Rd_5RxD9eJQJfMGPZyN61xbK_B169Xu5PgY9nQ1Kgk4c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9A3VlBjZufrMuB-nhdSDRBRBbiB7FaaqLfMoEkO6yTvw&oe=6A43DCA8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jsvVxZ3HLYQ7kNvwFq36zL&_nc_oc=Ado9i31EVEyyPHrE0HXQcqmRYhlniZC7-a9Ev-HSZA5tfjKz3wgq3Cscc4gn4DxJrbo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dcFAOwzxj90Xm3M10h1GOU7pWMrwtulKhiyA7Z6W0dw&oe=6A43BE85"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-_WOllNHA4Q7kNvwE8T7Ib&_nc_oc=AdqFr1TteaQMC5z9ih_Ve65mY_9RidY_oOPhVpn7DpUQ9RgzOYnc03XwPlEJk16b2mw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93CA6kvfehhlUy8Csa-lqx3aWPQhcdJjBCozQ15REXrA&oe=6A43C1E8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyDJkzv2JFwQ7kNvwFNVLoK&_nc_oc=Adpmgl_wqe9jWzIZxFHVI0ND80IlJQxzIr3iQ_gS_NUcZwPtBpww3n-54vSFvWpuZFs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tut2FEZKHNCq7jr8e0MTcmd4PIfXJ4pR7IQ9xcgceZQ&oe=6A43C3FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcsRrVE44-0Q7kNvwH7SEVZ&_nc_oc=AdrgWeEOsPIPjP1ccQZHhOE1yOFEKZYBcdF0tv_ZEHq7bF4MwZb885KlDJvIea0yJLA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9d6ntY07n9B9hEOoNCzTWxXGOab2mnCb-R9pzCkSIGdg&oe=6A43D7EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
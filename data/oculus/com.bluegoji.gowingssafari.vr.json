xho2E&_nc_oc=AdpqCZUouo94oKHlSxMQoQYAfj_r8X1_Vv6xtfNbx1D9XT3vDGlg85avEVJoFyjUGFM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbdhQ7kLw5IuzC4LxM1VcBXFNF7wJvIFfQGTwSFZVZDA&oe=6A510BA8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pa9tyq8OmsQ7kNvwHUEbHJ&_nc_oc=AdpBH5-qNYYa8-x1Hx8LTI1eOcxR6hPPVkDxnFVOEc-P-ns8jv5g49k6b1ExmXttvGw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLx1sdfysKA5uq1QpX1zFw6k18tkczODDDxXaFNQwTIg&oe=6A50ED85"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obfwWs6ToLUQ7kNvwHbn3OW&_nc_oc=AdrD0qDUli_S3i2N27JYebzmgbZbkaSR6LklMXnuBhHKiuL4dGIYS1ZdMoiGYkWBXA4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOTzdVpvG_Zibru8WKGO35TwErqmdReFVTI5uRgLe3Lg&oe=6A50F0E8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuwq9c0fg0IQ7kNvwF3oVBM&_nc_oc=AdoiyA6YeCxdF12LiNNlQuZYMDCaC_yT_i6uTafJSSztE6kGC5kWPGXtaPNub8U89kM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZctrdGGOpPUqO18QlJCnblUBXG2Tij-vYWYGI4VjBPQ&oe=6A50F2FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8C487VMqbU4Q7kNvwGrjAnS&_nc_oc=AdoD_AQnaU27KkYbqjJEpCS4ZqWwSEiBW5dHaiRXSHb3Bo2WTlLFG2aRKogkhgMZ2sc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwEtogifZJLenRdK8zXXFVjZES82z5HS39A0oEmq4f5w&oe=6A5106EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
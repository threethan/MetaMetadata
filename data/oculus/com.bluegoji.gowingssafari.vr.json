vU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af03j6199b7fvUw0zNJb-Et8NNEENMkmL3DRHyRUyleMLg&oe=69F1E768"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIj0o9qTwWYQ7kNvwE5ZbwR&_nc_oc=Ado5qukGp5_V9J8iQx73aOnQo8hfqukcoyYr89W3vFfw9mQ2XWl4mRxOVLnu9VVdeXY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3A5VuPlU171XwKreqsureOxzQlYbxVLeh724DcpPwePg&oe=69F20185"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9tsBODluIYQ7kNvwHOEqLf&_nc_oc=AdqjY2Tj1KuH3CO_BVwxY_HZZl85tY-qD8yiaf6HTIXEPOEqccioklo1r6rASS8NiDY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1cCBc9TRpKj0B0Jdej5TvpcYuS49OIAcGtzJQqxYl3mA&oe=69F204E8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFcW5slHoewQ7kNvwFIZQPM&_nc_oc=AdqEvmTcE-xlZFkqby2WvQfFHMR3V9JINxweBO_6ouLoYlpraFPbmnjthkmIginpCjg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0bA3JEH4MrdaaTI0fnxqoCGgTtYz3r-d9AMDMCvveiFA&oe=69F206FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNq04VCovY4Q7kNvwFpHTyV&_nc_oc=AdqFCGf5JPMAtnaSo5oUjgyKy1qdFyQsyxGykJ_w-fAseylX2Nv-F2t15nibnsOj0LY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af32VBMQ7F37j9DGqMxmXo9MiV5wXsqL4-jRqrJUbMp1hw&oe=69F21AEB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1483516800, "lastRevision": {"nodes": [{"id": "1294832573914757", "release_type": "SCHEDULED",
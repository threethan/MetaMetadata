NlguB&_nc_oc=AdqPwgOYyc2YW3VEE3A6I5tEhv4aVDw1EON9ZAmVHK7B4viq-wmJR48yOcHv3DgSqK0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKC1-EUZJvWwdk9y5yHQtOmjI6nqxK1uz6VMp3Waen-yA&oe=6A998E28"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6aY8ldIpuQQ7kNvwFN00nG&_nc_oc=Ado1a8pfEfzWEIzOdH2Edbboa9IA4juHwQKeU6dwQWN2rWGZY3OMJuxJEpRQPOa_ACA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJphR7DK6isFkl2VzXErxa--rA7KkoXFcoJI05pAQgeKQ&oe=6A997005"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzU0F0hCs1wQ7kNvwGPXB6z&_nc_oc=Adr1NGmtLMeBwQQxyiYhyuvF7IPx6oui09CMwCQzoWrtPuDb4CKXoqzXm0n49m-a-rU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLk2LeFQS3wfBS3TL7NFOe2L9AG-AeIKKM3dSXMuCgx6g&oe=6A997368"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KocIzR4ZzYIQ7kNvwG9d5sT&_nc_oc=AdqACutZe1NeMjpw2sJIHprFPZhjp2uHvcsV7VND1rtKyuQ7KqHMuuhXFFGkS-SihWM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQID8QqH_ZhiBzNifbOGLW4RuahaBwqqeryR0emxm-Y4Cg&oe=6A99757C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyEAHvgYxOAQ7kNvwHQKBaY&_nc_oc=AdqhuVKqL_xgQGeGRvgMJwEK76R1J0amEEcKz2h9Wm6GCYKbDSR45yykB38zwy6GNH8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZ6vIRehjr9O0DZf5CZRaoVlxaWyFscOXtvuaGxxj2WQ&oe=6A99896B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
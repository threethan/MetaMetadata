wLxYI&_nc_oc=AdpZVNOP8isQesaEBtlFYhT90lIM-XEn53pEqvUWhaE5HGMZsPGXTDpcHD5SRoER0ZA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bDt-05XCCqK1qGFUlnPJv0m92jtoVvK9IMnvRWaVfAw&oe=6A204428"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7umXzjsdG6UQ7kNvwEoilZI&_nc_oc=AdqVba4iN5kJLeO5Ln-eWNqfd5n_aVgZkF3oVDxTGdq44Qm7zYv-Mjp-Z0_vHpKKa7k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7itStpjDoCLvIj2XDrj1OD8xjRrvdstZQ5A12LHYaltw&oe=6A202605"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sw6PQ_yU-XUQ7kNvwFgiIz7&_nc_oc=AdoO6pQ6edQZO5AsvKQdBiR0dLlMnx9XJdcMZkjmjFON9nLhhgxwfkXSaamHtB--mrY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YSkZldPpWrfsyHrTqvt84e02JCC4n1JL9Te91wmh2RQ&oe=6A202968"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZE4oqCTfQs0Q7kNvwFBCFqN&_nc_oc=AdrfkF3-cdFr5kBGd8kb1MJ8Py-ssbyPyVJOkSbbCamDWoyMWgCrr7QuD2C5yeeQ5aQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58hoeDfKSlBCS-rn_5xrksuMO8naZAjoPVLcbd3bLSFQ&oe=6A202B7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGQVcrp1L9sQ7kNvwH7UOvl&_nc_oc=AdrgsoGr6XA_EOElTX6WA-CAQUZBz_QEefcIA89KrQ7NEkV94x0HJcgTThwxBr5SWz0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qGfA_FqF0T1KjJFzcfku2y2cVzgVZa5Ksps0yiagSDQ&oe=6A203F6B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
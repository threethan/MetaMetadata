7Cr7o&_nc_oc=AdpcBNe7M-pI1Nce0kw0cpDtLMwbT5JEgtWAbAqTiozC4Hst1_v2s6NEpPznRnnb9y0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nNhuljcwCFBdNG9SGj8rv8MslbBI_zEktmGulFQMSTQ&oe=6A1709A8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUOWcVxwUbcQ7kNvwH2m7yS&_nc_oc=Adpjy210pnTnj307jIzxr7haxWCcwbBmCSPzIlWYeNISGv6fzEj2HOhD1NEss2RSvZ4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zflTFGBwXn0Fham9hvG2a4OkxPgYYaGdgwpBGuK2ruQ&oe=6A16EB85"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HI6WpQHfUe8Q7kNvwFJAxp7&_nc_oc=AdreSSos0w6nLYJTCDsQMemff8QUDcoMtmtIT7qd3UraN_Gvod4twlW_djYTLylAASc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rS3Ie8DLmwOD6o6BTjHcWl74WwJqVBJqMRL44U_TJ2Q&oe=6A16EEE8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3p0_Zf88MxIQ7kNvwFiZj1j&_nc_oc=Adq3bESunQyQighUyJ1D_IWleo9wWvZkZz3Y5CCBDrvkYyCa7wfRUCeQdSFlFeuE16o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55_IQS3hkY_K8_YRUyq072kZQv4MUz9abdJ4EIoi3L9g&oe=6A16F0FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SocIU_yUniMQ7kNvwH4qEpp&_nc_oc=AdoFzHjS3Bb04U7LTbD-vgXo_6kykH_sf_-CZkQd4ShHevgsBRhlwqT21Nodc6o-Iaw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SPMDdZnjIT8jrbNuOSZjd_oXaAHLtDwSEyxeoHz3raQ&oe=6A1704EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
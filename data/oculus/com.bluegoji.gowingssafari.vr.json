WoqiT&_nc_oc=AdotIQuLvX9vZ7aX1xmF3JmzH56wf2CLgSc4ba-H-stFwnRunR4pgSMHlSqLFxSVz3k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VrrK8cPcF4NYlYBIqGVbtH0bpsVmiYU8ypsBdhd7cQA&oe=6A1DA128"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7umXzjsdG6UQ7kNvwFSXahM&_nc_oc=Adqzz4vEHb3O5LAIsBGDuNj8HWCmOGrQ4hIWOSzPoCPItNRYXyzarNu4D1NuSJvwQhU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af484HcnonuoC0M9C5wcAp7NAWcj5XrkYtR8Y1e5Bwi01A&oe=6A1D8305"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sw6PQ_yU-XUQ7kNvwFrQX28&_nc_oc=AdqicUHfEf2Zi1EvuGkTn3lTcrHiSE27hWlH495317L8Fadh21MMlcFbLY7YIU9jbtQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tSirinPwIbDhmAkFpIKxj8K9s_kOT445QXa6ZPr8rsg&oe=6A1D8668"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvtX2fiYZtEQ7kNvwGoWQbG&_nc_oc=AdoDJ5RPLGxZZf1Qh6DHLzTfc-9osLiLzLlx1y-5YClLys2syQbFdq5PD0kssY3n3cs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7T0H4WTw8twXrrDWpC6whrfEneT1b6wBhB2aZunS5EPw&oe=6A1D887C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgUUEgpSD8YQ7kNvwFKPCIq&_nc_oc=AdqcO3SXGTbhe9fn2HxOnuT-XwoxOtRxAs541L05kgkYXUHumiVOc1d9PZgBxLQrLII&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GB7KT4DimyqMtz5ojfg5jPmkz-OX6EvuC2_NxFYEmZg&oe=6A1D9C6B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
TF3Tu&_nc_oc=AdqiiR1iXdo0UcC8OvCzMVZMc2BIek8cwiiwoubZ7Ulu8zFVg6xMgI2yVXNG9xMpPwU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xK8AynBE-hOUOi92g2Ev0c0vjg8jK5ihYQjfrTuCO_w&oe=6A131528"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwnu4VRQwUUQ7kNvwHLP5Qy&_nc_oc=AdrQYXyCJC9UsN_IxjD2WMXWftCkdnQZEZ2m480GgbqcQjxTJqDDUMyj0MtuaTw30Nk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PN5bJiYkNl0_AQUVagTQ4wUI2riXWiOJ59gZ2AY6m-Q&oe=6A12F705"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsn2nz4TMikQ7kNvwG38XJ2&_nc_oc=Adon3HbPfZdxiqxgh_LUATLWD3J0O1fYa8Wd0l3Z9AWIv_qn9prk6VJIwKVWYtImmTo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JTejl5kLvqej_ZzbU0mp2g0Ft9q59rXKk4gVTOABw3g&oe=6A12FA68"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FB-9ncrLuroQ7kNvwHotjL2&_nc_oc=Adp_mnPQm2DGwHvxla2aTUcaeh3JDNasrnoLCmnG8tCN1oiEZmJwZ5sMaviqUDSyhuM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LQQwa4keOYv4hRkwPlWUzCQQ45VqJTp0dbHmovASz2Q&oe=6A12FC7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMRZngNo_0cQ7kNvwEKkJU5&_nc_oc=AdpU8GpSgUqcbUjhRR7Ix2Qbz4-nGo8CgbQS3xKsYS1rjt8yaqtrcsPz_BA9RL7pHkE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_hQ20_X6ei1TYLW_-x5f-acYVTyhBsRK_uGBhzPnVMQ&oe=6A13106B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
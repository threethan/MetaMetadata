WQErG&_nc_oc=AdoiLSnhzMlAHfC-CIMbDH32t3e_GNGo5JLTVzKhIW3bEGdhBhhbD9X6N3XlH9s5XIg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmXM4TuX75-eIy6WExSm0Mb41azuTTkMotpL8x76o1zA&oe=6A843DE8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaE7qgJl1_YQ7kNvwHTXk6i&_nc_oc=AdqNe5Pbtp0HENstjZv1F__uXG5NW_9QDvzLGmeI7vUrfCX2h_rMjZI-mEZcP2dGK0o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHqzgJDg5M6Db1R2bBonyozF8rSteogURYXno7JOfhaw&oe=6A845805"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4rr72kwVs0Q7kNvwFSAw-m&_nc_oc=AdqAko_uUggAs8k7xK4M4fv5j3qv6DH--zzx_QHdr59yZPdJVFb_SIHoAIalUg-9ihU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9JJ6s9OgOJf0d3DT6shW0kNWBYK5PLNgIy2XbAjT1sw&oe=6A845B68"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGtcXIGqCyIQ7kNvwGX2hAU&_nc_oc=AdpBsi4Eg_SVjBFrkvGIewEvy-1UK0NWJ4cDHJjKRP6sDb93XVapVBUGqD3QhdogTzc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqud6cO-2RnQOsjbm9V4J6MB8BKENhHZtPsZQn2wKkXQ&oe=6A845D7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUfiimIkaScQ7kNvwEDrl1X&_nc_oc=Adoq0h6WYaFx35b-DvJPtOKeCzOiib75FDA3Pi9VsqAk47RDTau5V8lcwP-MCOx1vro&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZpdiDgrU2cSsbZqRan3tFbV8UBueptIWTI8n2RZlPzg&oe=6A84392B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
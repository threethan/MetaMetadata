Zxfdv&_nc_oc=AdpU3yK65Qpkj6FafHMKJZKVrwCF3-VAQBQGMGZs8F6VmNyTPVCvjZF27QAz-rFu7k8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kaq8Nb_kwupfmwRAejfHbPlKxIo0Sx3nIXbT5TASrTA&oe=69D8DAE8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxYGIF8d0ssQ7kNvwGLJ3BD&_nc_oc=AdrzE02XyYZA9XG4ZPoO0CUSqmpQxNtcAwK_nwrxunvvcgJqC00zN8qJLsyuZK4-KWs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ncl7BcvYgBQ9O66bklotoZIA5fbkcUxYkLh6biVbBdQ&oe=69D8F505"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UYLe_IP4GkQ7kNvwHYLBNA&_nc_oc=Adrw-Z4qYXWFw5NmrrKqIRMWmnDPVEDRJHjweGx4YGsenbkRoUdKF8KCbUSVmEdrmGY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28Prabk1qj3GdByfd2tXviLTYIQyZl6tb-DQ9KntryAw&oe=69D8F868"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nz8w6go1ussQ7kNvwGlO9lj&_nc_oc=AdotNaG6SeiEFphflSF8MZSpq2oGR3BGe7RW-uD_GEyZoboKI1EmRr-2bxYPsOiGBnQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Op0e7gIIi0_4fBNksNkb05XJHhS_1Isn5m-dQAraYvg&oe=69D8FA7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOvEkXa4t6IQ7kNvwFm_mKK&_nc_oc=AdoyQ46JWJTJP7bVWT1DVr7NH8ZilHD2S4d6YUuPxA0PsPj0ryNnuDBV1AcpbqRNLJk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13f4VZLBjaorItFUS1kOgoy8QCmnPhZi5tHlADKtRA_w&oe=69D90E6B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
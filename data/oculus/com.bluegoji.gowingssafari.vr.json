jCrmy&_nc_oc=AdquQNvkCvH9wrR114M0kry827FvJEsu5vbcMW3JgfKLkueTd3G1CQbd8LvqqrNR98Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JWLRxyAoI5d6YlM3eMToW73qrfYcKTiuMVH1QpKTXew&oe=6A340AA8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRMty6TAB4wQ7kNvwGyB6EL&_nc_oc=Adplf9yOKt5ta3uQ2zunS_GSa4m_yIi_84pIUvlPfqAEQHwT-WppPUpD7jAlRWI1oos&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mQh5jRb3TMycTTUIlvDOKJir2mHoZ0XJ-UxBzdpPo7w&oe=6A33EC85"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9unv2flP9rUQ7kNvwHwgwqf&_nc_oc=AdqiKT_Cv_4r410_-BD_U_5Ou5Vt7zvjl0TgWea1x998eL5aczOdLS2PUPYsU_fzueA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AMsgIWy9yWlsix2N_4HjHwJ2hS22gPPLshlsjOqzcfA&oe=6A33EFE8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCqeAnU3XrkQ7kNvwFgvYys&_nc_oc=Adq9Iuno0VT8FwRdgP1s1q-ECD1E1LzmPOi31nhg1_nRJGktd_NHiNI4cIA7qX1IXj4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iOvtWziEA-rkiUcLJ2f1emyoYxYsi2LPv_nVDxk4rfQ&oe=6A33F1FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqhLK7oXMLIQ7kNvwE_yUjX&_nc_oc=Adp0kToO_2Ee1xovaGczUFKT3jMSApEStidiv6j-cM04HdjR8uLBYH34umAvdHVONFk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9alom4dZpGhoU7EB5z1bTSECV4s3zmR5yyWxiaRGvfDA&oe=6A3405EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
2xf3C&_nc_oc=AdoYuncvAkaLm2HnDq-dX_7CHGDF4dDT8Qq8X_NZoe2PxkqH2CNmdNaBPzbEP0B9ubA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGCqKI48yPhdVbcKXPRqxtlRrkhGhqO68RLZkzGy0HTQ&oe=6A7EF7E8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-VsyH7noi0Q7kNvwFYTFMX&_nc_oc=AdpnuOAqdUC2KYV7UjfOfu6YA4JfQLqVTzoIX06F44kH1lZRRF5jHobZakm2yuOVRpY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEh4VbX9cVuUKdUK6VSvyyUPTH0Gj7t_5DN5DCcMQpZWA&oe=6A7F1205"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YiXhDaM5a8Q7kNvwECDGnc&_nc_oc=AdqEle3hyXbhr7Wq6MqyIi53z0J7--fOIIMiQ-nyLqgWIHjA_M09xoCStOSxfMBcP6k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEm0kmAPcOl5RynqiMRv4Vh92a_QY4D-suc2Ni8hd5gcg&oe=6A7F1568"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8o8Tf3bNrYIQ7kNvwHfyhNn&_nc_oc=Adr3DOg2zcKlNJ9UKmsvkC3_2SJ1yxK48eloL8RDx0TT9gO3JyfmE9eBTxUWcvRtkp8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6vYmQNqXLfvkELW3tOWVD-IwDzcr7q-v7zkoB0rfmAA&oe=6A7F177C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlG0iU9HlY4Q7kNvwHDkNAM&_nc_oc=AdpVvj_BW_pWO937Y2j7gtGmFRJKLYzIB3Db3T5c12tvcaGtKeU4jr7AeU6_YuVtfro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzdpZlJwBxDiUYomDKyv-Yl1FZ_poybHpF4sAN8PU2ng&oe=6A7F2B6B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
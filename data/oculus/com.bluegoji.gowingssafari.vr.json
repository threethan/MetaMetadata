BIa6U&_nc_oc=AdrNlVVnvJcR7o8eU7gFsz1FOSd-a-G0DVUJBDDAAb0mnY-pYW3Seq25f2EvGhSaEK8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiOFMo_G7SYbTkzPpRGmW1mC1NkG5H3D5kMuLfmp65pA&oe=6A75F5A8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuSMPvjOVBkQ7kNvwEaecNJ&_nc_oc=AdoDL7ZyX0Ro4ozWUnVzKfugknZKM9PbEU6VO5yizFhFVODmMOXcv_vxyqOnRhd1ywo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCKQAqf-bV8x6gD6Fr1qrBIfxKdB8IFI4FXJJqMS8VaQ&oe=6A75D785"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47k0jpGv848Q7kNvwHmgP6B&_nc_oc=AdqucSQRQbQXfcCgzMMUOYwpW2kgd5mQHo4y2yZW2PjPv5L_toojpDH0Po-KFVtQvJY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHulLPcnYPziqz-s7azn9tI3YCvNzvurVu8zWoICUHYWg&oe=6A75DAE8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BeDAh6dipywQ7kNvwF3Gplx&_nc_oc=Ado1flvZOXwMoyKZnA4M5XPA1FFo2I64t-XI4K_mn2JHcMNxq6F_g1RcjMD84CMfYt8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHP277VK-OycgrId3uS81dCqxfvW607iK5lxCnONqiZkw&oe=6A75DCFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LF6ok_1pdkQ7kNvwFeh9if&_nc_oc=Adol7U2W8JslZYLsX_TxNC9qpSTAuFDYCCkKnZlK2LR6E-s7-cBjXU6oWY5vi0TNtNc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSZol_lCerOdQw5pQlvnYyuEDkqC9E0YSRY4dbEfKZGw&oe=6A75F0EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
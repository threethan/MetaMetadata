2Ml-U&_nc_oc=AdrDLfyz0pzVdowZDm-muKCI2iweTW_kX9UO3luhCkofY6kQmH7iUvbw_j25XnO6sQc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIamAeKXADT5PXEXb7B_g1vTakCwwCXQ5Ct9M7g4xxqQ&oe=6AEF3FA8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWKQWKBtfL8Q7kNvwHx03jY&_nc_oc=Ado6ynZ8qagLnUCislHo_7BGzYL-MnMtYdg48mukuXUhptj_AvYiR9cQqEz2TDI-K_A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIhpkPqg5gdRfxh2SFiQS9sl4NXmgT2VfkKjWTWUcltQ&oe=6AEF59C5"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSvyzZkIHNYQ7kNvwECGrty&_nc_oc=AdpT9clJWU4MiupXGCsz5yrMqeXYA_62Vl35BrnTlBZdMvy_-iwG-SE2luDTh2Yth4g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1XGgj9iDU8SbEuq7fUknKD6nIMbdLQXTv2UBHiXRaTg&oe=6AEF5D28"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqMHAVnVGOQQ7kNvwFlLnI8&_nc_oc=Ado7p_OC3MojEl7JlIhSt0TzAAOp6aoMTF1WmJgC4-z_1XjienxaIwtLWuSZHYvUwCY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeOEFYzMLCROmyYUUPtLFOG3966TGTPsFZJDiGufyMYg&oe=6AEF5F3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amL_C0Rj2gcQ7kNvwEwoVlD&_nc_oc=AdprG6jQiAKSq2v1Ncx8mFhXZQt9GV4TOJdHXi5U_fY4w1BpyGgjYgTF7sU7C4_w4tM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUDH8el6JuPjFfWmk3co1nyI08hE0x0golLP9R6Do9GA&oe=6AEF3AEB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
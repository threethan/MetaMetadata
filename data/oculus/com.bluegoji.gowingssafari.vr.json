979X8&_nc_oc=Adrdpk2fCCV1EaoOXp4K0FqoU6qoeuKkAeWAJhbza_QGwllda56Ad8_5Yad1LM6f8pY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8gojWmUBbodivq7w-gL7funraRqW8qml9abWcTFVdnA&oe=6A64D228"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1HsWA7e8S4Q7kNvwGwlggf&_nc_oc=Ado1FbyWR2l7fCJC5RR75DW012Je0SOxap_F9b2Hl-502KL7ep5-tR-KuyQee4Xv76k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIgeEu35rDvmy6fqrfc2R0AsSEPX2ORYValv5oiNiLyg&oe=6A64B405"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKkh6-XfOBQQ7kNvwGizpMw&_nc_oc=AdobPI1n3K4kZtEVpABjcIHoTks35vnDe_iPx2nKm6iAO8x4XoPXWt3rUX_H28O_JyY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYzKrxQ-4VqGGVaFsVCc46uGKKf057F7Nu5mRGeP93Nw&oe=6A64B768"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTbzkdIuCH0Q7kNvwG45wVA&_nc_oc=AdpK7Hc8Wvg3Q9pexBysf6lO9yC0JsF_6CkdiLAhD4_k0xQEonimgBYzKxpvT9Lykfk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkXHfBgfKIFP_d2flVjzG5DA_iNcPEGsFvLKimN7SPJg&oe=6A64B97C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNS_EH46uQkQ7kNvwH2ysPR&_nc_oc=AdpQetuMMVzLOEUQJ1rYBqHXtM0dN5pRdtjiihOJ4CGYbox1KRuZYwbR8_jljTXqYvo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2RuTfqU7rOyk6xD19jK9BHgVGtxNxnmrf5XvyLy3EMw&oe=6A64CD6B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
X-W8Y&_nc_oc=AdpbxgFd8PqE_-1U8cdM4hku1EI9L4DOdXxRRgg2PX9Lehma9mE4zm9DNWo9nRekdz4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KMfYBQJW1nlcJn2raFLO2ESeVHE4AqVPxUr1iGqTOjw&oe=69DB7DE8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tey_HSCTFQ0Q7kNvwE0Rrbe&_nc_oc=AdqCShV9C_NWZoLYjsUWa5tbFbLWLHyPm7vb3LfGH6xArKYZ0pCEQ2_t9y4oGph448c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14JmeS7_D1WIo_PAMYWJeoqOZZhaEj_TCW16WW_wbKWw&oe=69DB9805"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KrVMC9nZdIQ7kNvwG03OPP&_nc_oc=AdqGDtPC605ljOaFxb7UYnhAT4JiuM7gtF6zuedi26tUuj0N1lA6k1Q5Ibg-qIJwB0Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Hj_cHpJrQAn4tLruP5zDpPigQoiriIe0JPU5bO_lxRg&oe=69DB9B68"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nz8w6go1ussQ7kNvwE7QngI&_nc_oc=Adr7Ogio1kWLntUwWxAmEHArNH9lCX_N8NFdGluxpbrqyfyi-B0QV5adMTbR7lsqUdU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KODiwRNOdIGas5HAeJvLXgiIOpdrOo7uGTNZtfLvjFg&oe=69DB9D7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOvEkXa4t6IQ7kNvwGsxC5b&_nc_oc=AdqsRdUQiV2hS5wFdPsW3xaw6D_tpO62vKos1I9o-Kwvji4mjZSBVPtK6QfxbHpqyno&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gSUJ2nmPS28UBDh1dmeMokAEIRwHEY1h7ZMUvaU6HAQ&oe=69DBB16B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
Gzer1&_nc_oc=AdrHeFfojxUameRvfyWsOkCkHsFNnJCl9s1cSMsx_kVqvrH085_pDFoq8QH8XZsAfyU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIw_KNDSPx4eXifZga_V-8dRiC7iQ_8lnNkdvK8ziBx4Q&oe=6AA80EA8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7BUjA5XrYsQ7kNvwEtebT7&_nc_oc=Ado8ax7edJ_oLwQfSy1-3Jhm1j3TGdxhABFw_hugpKB0fDV29Ls6PZDzbDUsIib8-Mg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlUxU1bDXofswjSWzY7PziNJ8PTuoKIURxWb8aYhNdsA&oe=6AA7F085"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERBJGBDEPw8Q7kNvwE9wH82&_nc_oc=AdoTRrZKFENv0o8ANKX8fQs7IBDfPLsGLo2MSace7CJqVWNzDXX3BW1hXuZszYEBvzU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkOl-6IafYl664MZdEPTeo-2REHWuIUqKq6SGUGuMctw&oe=6AA7F3E8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSU44EdWMnEQ7kNvwGGLQfI&_nc_oc=AdoPrAPtBUhXucR70vXpBxDRmcdqZqj9RRFvYIr9EsJ_UbciZie4sA74wUPQTCc1jsw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEBJhudOCsm1eRYDdpYUx3E3QdcwwX28KAdmmDg5RAEg&oe=6AA7F5FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OiSl5k2xg4wQ7kNvwH9yVAi&_nc_oc=AdqtpliWWGfgpW1lRciay19fXftTFnDkTDVExBZP37VkyCikoLcpZSAeuqCqKx0tLqE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7BeGfTJnv-NeOFhUCLVLvBMCkwM_QLWatMqZ_x0mtaA&oe=6AA809EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
WX5Br&_nc_oc=AdqR9gCjgsNf-lmmQiJOR4P9N2UwuF3FGknEjLGy2mB9_UUeFl5gWAFA8BYg7BjZF-s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bMUa1hduw8kyUMpj_dyFDZeFQLMt05NfzRZBFALQb-A&oe=6A185B28"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUOWcVxwUbcQ7kNvwHN-Uoi&_nc_oc=AdqHTQXzFUBKIyKCQiJUuB_-9ZxpYevIx5ksaF-Rc7pouGm1wJeBqy6yKcPNvsAcYhk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zf5FFp9mDb5EpO8K_d2HCZwgkBwNwX23mhzjzTuA6yw&oe=6A183D05"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HI6WpQHfUe8Q7kNvwGI2Irk&_nc_oc=AdqgjbnnjDdYe3awuCfBpiEF7q9uMmFe4sxY8nLGotSP2Ovl4fz3CEoriHc_zvLdySI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JgQEFUu2F0ZewCpRLPnpsMY0cVUlAMweM3Inj1uTWPQ&oe=6A184068"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JE0fYo_oskIQ7kNvwGbYVLf&_nc_oc=AdpDv5T1V1DYNPEt6c4oM1lE9ydhUwxGZA6DnQ0J4kb50TxszqSmVs2upkgM6Lf0fb8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bM10PL_OkL46ynpUnv8QPMtsZC9Q0cUYkpwxbJaD_xA&oe=6A18427C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dChMShdOWtsQ7kNvwG9_sqA&_nc_oc=AdqNsOyJYZlreNSJzCyxuucdlunSfFfoKVVc54E2yZ7gDYPMqNIyOrN5NIxcuL_rQnY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af547yyCy-D1EcPZajMYvU2WyBIIXmKO13gnqX0mh8QfKg&oe=6A18566B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
BN3Ea&_nc_oc=AdrFAvQeIF6TNa4IO3OATjYKEpCx3jWJAW_k7EAkrD7PuFsb-9RspT0xoZTs2SGl_48&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUbTNh-MfBckeR2OXbI-l_zlvtj-Ag9B80ZwgarXIuzw&oe=6AD0ED28"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=556LaJm5LN4Q7kNvwEachs3&_nc_oc=AdogA6oYzpC2G8qrEaaQHj59iazYh0llfANVAOrhwAEsRct-MdlsGQkj4tSnrhIxcts&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOI1lgtPWrKXqXZUASWP3ns8zcT8TYvfqSw2AujIW4Ixw&oe=6AD0CF05"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTBJwpwvOykQ7kNvwF4dXQg&_nc_oc=AdqPJikTfjYw6MePJuWBr2WEHyxaE0R9LnMRWR1qORmFK_lFWe9YLxWlOhfnfZWgXD0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLNu-tfkINLi5C3XHNp3HxXSITtPNZOHSXPn_Q7hRusw&oe=6AD0D268"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ugjnWfCbJAQ7kNvwFYegaC&_nc_oc=AdqN-tJ3NxXdvQRo9M81QM8rT6WzzVP5TDCBoGz7rBrlwgyC29aQYkHhpwVY2uEOo6E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmfZW5S2ZqoB4WD-vtRkWdjS0_E9GIQxeFtvrkrOKt3g&oe=6AD0D47C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EA5g8lRFvfUQ7kNvwEiJv43&_nc_oc=AdoTtVkQiS4pG1Pio5oq8-EQX2wn04upjK8q01End6uzMPRYLJk1OxcUFGu5ASnVpNo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNz-bfangBNUp45YYM65eYCp0meUiska3IfvYY1o1VxiA&oe=6AD0E86B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
jDwL-&_nc_oc=AdrxXi0QSnX2-h-N2F0VgIZ1ukWxvbRXehQsix5UkmVpLRKTguRmbuc4XnS2gMqJKVk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EGnY7a3xrev6IZbOGNPQiRjcbI1vQd6uiE7T0MseMNA&oe=69FF4EA8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFPGdo5i3-QQ7kNvwEsmEAa&_nc_oc=Adq7YQW6nropTpMfr_xbcIS2SjpvHdkQ3W9Kr-UKMMYw59EOoOkqE2uSjUUPLu5qq7E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4d3xBRGlpwOTsUwBzkc8zwol-9q3Jj5VP9UzDtig0P3Q&oe=69FF3085"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jpf4Yx6x31MQ7kNvwHtf6oR&_nc_oc=AdqQzHRfQGwsP6U0uAiSpOFMaxRVyMkWRO4QrsYUZU2tZufMs_2N8vN8WG7HtfHP99c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tuEZDV2bbsiXy3_K4KB6bsdZWdkXCYDuwxHQRAcB4UA&oe=69FF33E8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFdgNzsMLNQQ7kNvwHFlpSa&_nc_oc=Adp9He5mbmU91-Z_-Fl5bL-1Mr2_o-o4dSBc6C0ReINhGhx44JlPYWy8JgA4YMh951w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TclltGk3ZrLx1f7VKUT7zpnz4T0vRRzgUwngBGQRq4Q&oe=69FF35FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8gdDYsIWWUQ7kNvwGVDEiY&_nc_oc=AdqnstRMDwK_xndK2TPbkPCUXr-i5LD338PDzmqqw1GaPycxaXz909x7KhTQVIlK4Lw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zCfC8Ao9dpU88OBFV1D7tDAW6_exguh1Cq8e_WjSp6w&oe=69FF49EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
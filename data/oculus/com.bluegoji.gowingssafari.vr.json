uUrHr&_nc_oc=AdoP2dFQM89WPB6FQ3FGOXmc215mTiOgJqQq9WAD_PG654Fc9N5iGUmXKlEc9SbddAk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDghJ-OYr1tsDA2qaxfxkhgFDOjcYzQ00wr-HD5zwmTcw&oe=6A53AEA8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pa9tyq8OmsQ7kNvwFV7Mpu&_nc_oc=Adrqi2U1dcDSmLbrFjAT_3iJ8YqFvcfJwAFIuXuPWNY_h27xIENajSVSbrq56mbcrLo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6qpjiFaoqcRY5kp0uGl7GLvoMSWM9qIYXBxMB1pyG9Q&oe=6A539085"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obfwWs6ToLUQ7kNvwHE5FMO&_nc_oc=AdpcaKHnFwp9wQdOGp_2eV7ipEESa7WZwyplAflAi9qY2FdgVjiaEg8a108CnjZeRlc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTRJztYBDIuNy7Kj2bJ9j3P_NLPKV52epimQS9fvSQGA&oe=6A5393E8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAOMU3YVXXcQ7kNvwHAsOHB&_nc_oc=AdrroL1aRQsQndJHW9L2Lnm6zcvf9s1LmE4pkzMmMGNfBNYM-BP1sWltP5wDDSZD8WY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBALKiS1M2uwCb0q36w71zetqR0dc90eHqkXs1z_vYrvg&oe=6A5395FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wAKV5GF8g8Q7kNvwHwC15T&_nc_oc=AdpLcc9yUDGiEpxq34aCDY2aJ2sreF1wrSbXxgRqXvJK4LrOHqivBA4XAh9V7HMC1Vs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkB8i-H8LHMx_65f_8567dN1oGXZ8rEx4PCdoK5ceSCQ&oe=6A53A9EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
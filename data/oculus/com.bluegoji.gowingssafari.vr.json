hNt-u&_nc_oc=Adq0UkhrKY6mQ91VKKBu5HdMSp_L3DWTS2-6MDElIRzPbUCqgEVaDAoOdboaEoUfmlk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdsrTp3fIpzVM-VhWqn1_BEKa9j6IugutMQR9KlHU0XQ&oe=6AE756A8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPGWa0HwSZYQ7kNvwGTubWS&_nc_oc=Adq5ISgL6Q2eWKBHU5Ho7xDxaTXB3b-n6Sa91NkjImJ-4Q2XOmrYLtjH0d2XVdR5osU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQamiXTqB4R_qni7Ak1owm3g3M1IO-L7wWIrLbX5X8FMA&oe=6AE770C5"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzhMGIGMoysQ7kNvwFpiyDc&_nc_oc=AdrvqGtqlPIOfZHlSE48ewOg4FVXh2ye2HW8pvEjDu6aJW8Kige6Xv42xmY9C4uSmbk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhLI-K0dwy5T2_16pEkWFA8fCrj07xyPhiGG96d_6RsQ&oe=6AE73BE8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SR7aymqi0IMQ7kNvwEvRCp6&_nc_oc=Adp4nAiz7O5zlnkNnU3AM2MB1q8hnMY6J-HqtyItqIpRoYp6Bkgt5Alc6F5mjnwzGEQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRArvS4F98ObG_uJGXrGNh4fPeY6-bSDCDsWMFwwdReeA&oe=6AE73DFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RRs85knJ2QQ7kNvwGWKt-c&_nc_oc=AdoKyHaV3yGzK5OEGvTK1uQDdT_aW0_NqAqVN0rPFUN_p4wK1d11dPhS6nrx-MtFTv4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuyM0_EH-wtrZoAVweLnjdEmGvcJ-djAqZAHhD5qQPyA&oe=6AE751EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
h3pM1&_nc_oc=AdrPQGqfRsvoWVqM-mZ4lGDtYl1k3tH7RLuICtx0-NSQz7Nmu5KrpQOmb0msDJDWJhY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DI7ndd6YqK6DKMtYoUozN29EQVINBTHWDDzigtcxPEw&oe=6A47D128"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4UIO3NzGp0Q7kNvwGHofqH&_nc_oc=Adq3qovyAkCahAtjbdEo7GkEitqxsgpzoibno30wt5GPBegn8BRsVo8nkh6IrE5t5uQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ojt1HbZENJVoym2gNfvih5xxdTKVpvlhW9mYmqOMSBQ&oe=6A47B305"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQjZnrpIz3AQ7kNvwFR_Ojn&_nc_oc=AdpJedLPfe1DA_n99TevFnCiyic8pLoAnXtn6Rm0DnoJU9FKBQCnz2NymOq2TtYkmSM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88LrgNUY_ZZaJcl7c3NzDe1XBjM5nQkhI5zxblB3KJvg&oe=6A47B668"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXkCEjZ1fx8Q7kNvwFJpYIN&_nc_oc=AdqukeOy2QfMC3AvJji_QiYcRD2BIhkysL-8GashfQ1B3YdzqOtthZoWdSP4Vma7cK8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_isx6MS_0ODGkXzaarj6j-jDTKwQsOT_bf3YFX5F-1ag&oe=6A47B87C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qu4o-vMOPiAQ7kNvwGLhoyX&_nc_oc=Ado0VlMyGbI-YYpCAL8WY5iuajyJRViubtgFKAB5Pg8iLcb_G8vWZTZ0RBnpkIIUEyc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ooRzflwQGQztyjzHENc4o-mdVy4K_o-0nY1NIPa2x_w&oe=6A47CC6B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
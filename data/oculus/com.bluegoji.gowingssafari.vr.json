c-X3n&_nc_oc=AdpXqdJ2ctUy3jjLNF-5cHkLOe91rt4xHzWBTz68IDAACrSB-wog6891ChQPGbg62YA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9AGWG9KRfJEARc0pieJOdRYEuj4EXA_28OM_PfKhCdw&oe=6ACCF8A8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5k9Z0DkhkEQ7kNvwEmnPup&_nc_oc=AdrmAoYsUrg1dvqKXXGsdSawONkFPDcBFzioujVNeRBM4hF5qUHEJhnjh4_uxXRPhmo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUZbnP6ICj2Ap6Gv2OFgV9vFF4NDuu40Fa6JP4rjCi5Q&oe=6ACD12C5"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YlvhWoqQYjQQ7kNvwF7VGTY&_nc_oc=AdpR9Dw96Y1EfdgpOiTkniJrduTAXjsKg5_eNdjsDapvXmOUac6536ahIP54-INSBlE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPI0TAieDZDRrNa0YX-GoRnhMjrtBuqTEsGhneWCLNDig&oe=6ACD1628"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lkpp-YbnH0kQ7kNvwG88c56&_nc_oc=AdotfLX8peMTcpT14rRoVdk0111i8OG6L71QMG0sdlrCRHzwuFzYoORU_NnJhu3K2gQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWP9fhoU72jup1-KvTwSwIG3QC1kHJKe-ZOOQp9YFUcA&oe=6ACD183C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1SgpyU4YcuoQ7kNvwHyLf7_&_nc_oc=Adp0E0qOnBxU96nQNW9M7YadpHJBOeNGWtD7qq_WxwQFmu1Ka-kGMGxFlVqR_qi8IW4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4fA2q3HIQ5zL6TRdqgoBUEY0boiwQIjKADAspoegJkw&oe=6ACCF3EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
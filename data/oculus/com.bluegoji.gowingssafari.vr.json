F2X2X&_nc_oc=AdpEab21zA_A9ImTWRDgWL_dXCWxQzQRHXktP0pqN18w1ZnIYEM1D0fBm3VzqJkm1jw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0tSWcgZIUQK5zf3Y3w0vBmO3B8Q_A9VbpAsg4q8eIgw&oe=6A3E96A8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rm0xpA6QQloQ7kNvwH-K8zg&_nc_oc=Adog5jfzd0P--ASIHza43kpTGGIcY7Jnnz39AoHQ210MIasOZNdN-bP1wl2Rhp8QYMY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99nPJIYlO92Xq7w34aDsdLmDsRW5I93zPG79tI7xdZsg&oe=6A3E7885"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rnv95FMijWgQ7kNvwHgc8gp&_nc_oc=AdrIstWccxwmv5PdMNvS4IvFwmD0jXONlU42MssSZY-ckYAocpWQaITzxB1eZBCzTSQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9o5KypMZ1h0zTjtTecrn1wHhgtNAU9mv74XPpwyfLlmQ&oe=6A3E7BE8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wa9gxaOou_YQ7kNvwEfOLud&_nc_oc=Adp1tIdrtyxJ2QjO6P1QKbCXcGFAq6s9KijpiFK-pVzbnXb3ZuR3FmFU9XfA1nMfAQU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SAcwIjxOIYHZTRb-geVLFU5jIaTGAhYL7Zl7DzlwbNQ&oe=6A3E7DFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nNXIhAHp3EQ7kNvwEdrLxs&_nc_oc=AdrgP84d_SJbAsfReIDhiA2rL5E9YfyXLUcnSpgRpjxgpKNG5zrCjsleC5tmzk1rwL4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FkfSabSVeAbc0p3PcH05tTqHp9qq11YIxl49YoB-HgA&oe=6A3E91EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
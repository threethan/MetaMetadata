Q-vxP&_nc_oc=AdrTbD3aHegwp4wrAfcp8S-bwOwGKTPt_JlJHFLpi_M5o_OheXkPqlNhIXDBhxTOsIw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnDJvCZXmXmIlbrX9P3M5_eeaTmo8_-Xy7Ynv2sZHlvQ&oe=6A58F4A8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCvPRePR4X0Q7kNvwF2B71s&_nc_oc=AdqOe7YtZjZmXqpqelIsZBbH3SFTZ1ibE1DACZoxiZIR5tLFTh7J2XVTA6dp_eKJpSg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJhbMkUdy4sQtXLc-l7o6xJkLNWIU25X3PQfH9kEoeEA&oe=6A58D685"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShqwcmYXbGMQ7kNvwE_VQDg&_nc_oc=Ado2cvwHXnsO1g5EQuWOuDEWOYoHKiYWbgmllvge314Y72Pztew3eUs2D829_q_pfkA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANCDvUM9RRKW6o1rORmTQYujuWOiseE8Aj-FaAMp9yIA&oe=6A58D9E8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugg95DjPRpMQ7kNvwFUAWzM&_nc_oc=Adox-5xNtDAHKKcsLuTzFHl2OVNUhuzCnfd6j2Xi6QqVP6aloYpUIRwwiHc0uq4Yd6I&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_kbGOR1Yp_VH_P5FyDXHPESXBAV6i_aiMlUrMh1eHjw&oe=6A58DBFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Choek8CUwDgQ7kNvwFUfSCj&_nc_oc=AdqnS5VKA67LYp84WvN1AOe3GLd4xtWVQGrFPxj-Gr6VI6IoC-UEDoiYEKei7M8SH3I&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-GZ3GvWk1SsxTFqKcC0W9RyWDuG5ryjdr_clVsMipSA&oe=6A58EFEB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
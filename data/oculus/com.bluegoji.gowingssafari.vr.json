MTxyM&_nc_oc=AdqRWZUpPfXQz5DNVqRe-QUT2Z-Pd5UoUKpdqApmiZRS9dMwhrjJMUkpAchE6tpaTr4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xSPrcwUGECFCg8_6XZsdSLEp8i1rMc9BbmdfFxfeYKA&oe=69EB8828"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHXZ19garo8Q7kNvwE_dB48&_nc_oc=AdpazfQA1hvTm3P5c9qoAfP3cwrneo5ShD6VzAZuV5EMIAwcHzjO6gnqalkZ8yK7L3I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iqJXu6FqnWysZafwDy86GwieebDjH-awStWU3q3zIhQ&oe=69EB6A05"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EN5JiVAQPYwQ7kNvwEigsEe&_nc_oc=AdqJ1oYzJoCe8faVlHgSiupo7CgFJ6x_q71AC6rDiGfSo_h_lJ5-UDTJ6ZTypJA2TeE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3J4nIhk_HWvsxv7-hj7mUwtNajELLGPOkLR4ypJhEDCQ&oe=69EB6D68"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajRJHtL8eQ4Q7kNvwH9lZuH&_nc_oc=AdphkrmJjIr0kQFUitcerXMX1EhHsQl9yG1fF2gIpEstQuVdcNvtA7rcCXnj1m76esE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tkQEBDorWp_LjBMmuOeYCw8NiPL9o2wJnjxJ_WxzWdA&oe=69EB6F7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NBhaXgHjMgIQ7kNvwE0GdDK&_nc_oc=AdrHkiuIDyNIJpZuIxoyDntYKp3i-yd6VRZbNHOCj6i0SkgOFhgcVEGkoHhF9L-PvZM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VuDsGm6wSiFcEPn1H4pNAEwBmwxS6KftVCgf6CpeQ9A&oe=69EB836B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
1FUoZ&_nc_oc=Adowd9nEGpI_NO5dZPk6XtNBKYcjb_o3faHvz8Nhz-SQ4pzWNs-h42wEC40o7N7QWh0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJBHrhPu4tExzWemN6JnsWN_ppvVtvV3-gd5T7YbLIuw&oe=6A4FBA28"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Z1t4StzeasQ7kNvwEWC9yt&_nc_oc=Ado0ntcTDUyzPV8IpT6yqGmWhchNbIPh7OpHgyTpz_HdBk74HkqNhq2naRuuttKp-Aw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtuKlBoV6RTZSZXJe3yHfT3GYN7gQ4aoefEy-yR4-OTw&oe=6A4F9C05"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCKl4RgWFusQ7kNvwGT_cdw&_nc_oc=AdrREV3aYSwuHlvtfNz-Gs6vtNeVR4m2otiGONN2nkFjCQmGg2_oTmWuaWHdEzOPqIw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrAAGHJTf9g4e3azkiRbPadkdGJHnr5MEiio_abqg3tw&oe=6A4F9F68"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuwq9c0fg0IQ7kNvwGNxJlb&_nc_oc=AdpXeGfijfQ7nWDj9paXQIGPGhzshZkw5yVS2FmuNMWHbEOG4iISR4lHcCazT1DdKTI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCp48rgpwtCv__fELhf2igz8WwlD2dXUc_BJHik_gK7QQ&oe=6A4FA17C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8C487VMqbU4Q7kNvwHAdCt9&_nc_oc=Ado7kYBWkIpiDp3zK6xwZeJzFKdpQ09K3quCjdMStwHP2MWNcdNVeXSkuAFcq0cu2J4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJF4B05MRrkEgvX2MlSzty6Dr5rOOwuN7hcedfJrErpg&oe=6A4FB56B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
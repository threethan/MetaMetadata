Vc2eJ&_nc_oc=AdrUWQhnEaxIU0N9plJsZP9pCkCLxx3Mc8xzNIqDXa5jw1lG8ANrbhUjcbRjYeW9_t0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qqAR8RkiAfbWFUr7jfcT0IE8ECwWQFnrswaaU9XxW8w&oe=6A2438A8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8Xda6ssKtwQ7kNvwGXYYwa&_nc_oc=AdoxS3J9xqKR3Js5GqiVkPLmWkMY3stDsPCd1YCIcrIbsjFHA5zu9DmtoSMbRuXD_4g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZvDDZ4zQGm_GVQlSBCp6wafxJSTH_Y_7d__D-r9VaHQ&oe=6A241A85"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AcUZEj-MAcQQ7kNvwHOXv30&_nc_oc=Adr_ievqZ0s-ZeWzWuoQ-Ov6r17ShYip8ZzoiuSjjxICcx0RgeP7YtDnLCKxSR4proo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nSUzK4QR4chXF7Rit3DICk6N0JVhGYdJta0CluSlUFA&oe=6A241DE8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ab8Lck3g6UQ7kNvwGBVXpc&_nc_oc=AdoFJJWK80ohkscmWuPRape_2OO1TCm8_6RIX-FT8faC6mwsnpHrg4jRYXG57abcnic&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TRw2FNjqxQWPB_C4CtALF_KAM4-Q3swXDdr_X30-W0w&oe=6A241FFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSxSxOMTNP8Q7kNvwF-Mwo3&_nc_oc=Adp33NrilBfZSXlrafTWUJgwDST_u8CJSTunZ3q74ewn0eNlfmVyjTClAyUxoYANNIA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tAVBLmgcpoIARBTZktqABmIv1XvyIF5if0DwUgBw2qw&oe=6A2433EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
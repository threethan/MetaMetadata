1H79V&_nc_oc=Ado0UjMVadDkwj7pnekv3Fgn3sM6E515_Y3LtKL5pmV_sRktEjqMWztk2sFpm8H5GTg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBprBi0UTIs8F9jh2yFPfFaHzXU1r5FghE3UViW1AZNw&oe=6A7B3BA8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3SG3VpoFwEQ7kNvwG7oHOU&_nc_oc=Adq49IavZ3nhGB6jLu0_AKw9GzeuLKrXiJWsSI4p_UoH94tQZlv2hSvWlCKS04MBo_4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoOQqnUAvpJY7f0GqdQBsQUjO-_b2cECYQSC5u-uklxw&oe=6A7B1D85"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nywQp5lphR0Q7kNvwHqdueI&_nc_oc=Adpsw0DCLKd9TA5n2p1E78xwLo6rr1a-L1Do_Mathx3ZHC5H3DDzUWsLqN9psDJJLSA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHODh2bqLdbxGWQvswrW0OOfLz9IE37AD_AXafiXgU5lQ&oe=6A7B20E8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_pxLgFH5pQQ7kNvwG43Cq2&_nc_oc=AdqBnERsmWvF5rK7tgmX90oqauZxw1uOk0sVvgPBzMGvOs9LDb-0YlJfpLpvDOxpAi8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhIZ-j_0rVTuJfDqc9xz1D711btpKOXnrhRIM-OjDwzQ&oe=6A7B22FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5xXrY02E1gQ7kNvwFfCLSJ&_nc_oc=Ado2DT3wIWWOC00yHCi3zV8gt6vlLoy2ckHzyS7Kfgbo9Xhhih-mVp4_V-0wvUcFO4k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1XzsiUyFL7HUg4yYFqNYE9g8KE1oJbWUjYtACgosuXg&oe=6A7B36EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
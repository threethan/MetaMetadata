vmXTc&_nc_oc=Adp1YAVdgH-sVBBrEpfnDGEhv4B8m8kVHO2wrEravs8zIl3Zq93tuVSHbqEZB924I0U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoYI-CwfxAm77dPcc5RVilkcfyT3CDZLA8x36ffsLYBg&oe=6A5A4628"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCvPRePR4X0Q7kNvwE-RGls&_nc_oc=Adp4uWnXvF9I6A_WT3sZ5uKGaLSeUdcYCUprUiRIAA16J0BfztIrpPUPCrvJAEFVZK8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0jQNWqbrUrPJ1EKV6CMMUaNdOrUv74PFhRauusZLz9A&oe=6A5A2805"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShqwcmYXbGMQ7kNvwEfc3bB&_nc_oc=AdoO8LjKV6c928bCXUenwYHK3wvrANtD2GEVPq_7Qf3Iu_rDhXmUDYUoiXVJQVKRnbM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbtp_jpdNjqbxeVFLRqiQeGyZ-adLMD5Eyf30WTGNO2g&oe=6A5A2B68"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugg95DjPRpMQ7kNvwEs5FZ8&_nc_oc=AdpRMyQfGMb-TEGwBAKn7Sq6mlcXvCSzQR00WXHQeTK9vgbHu6z0bpgWGr_-wtKnRfc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABdcY76HIqsabMnsRSQiw8XROzYRlsBsybspY37VR8HQ&oe=6A5A2D7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Choek8CUwDgQ7kNvwHykTeu&_nc_oc=Ado-8Yhav9ETH2v59DVWvkB7xwSh6U8U7TdNuV07yO01Wat0TihqGrXwNRA6kek4nv0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeLoigN4xkguIlmArI_O__KSfipl37O335y_tJItAvJQ&oe=6A5A416B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
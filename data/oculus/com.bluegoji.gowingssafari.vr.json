km3Uz&_nc_oc=AdrISD_lA-jXvEMWdun4mXMU7Rq5LNRIcpyGYATeYfoRASsx-ZIQ_VwyBj4ne2jxr88&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQ7v0bAt-h3XDva7iBrdlhEOP97s_rQ0bz26Ey0RtqAA&oe=6A677528"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1HsWA7e8S4Q7kNvwExYC3H&_nc_oc=AdrpkaV1YK6xJZeolEI_AttSbc97Fn6lUk5L5jb7gapX9uQQRmdK_5OtO8nJdP71aYI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3IlPpulxhLpkRHWY7ZPIPbfuH1Y5N2xzSAMbN7YzOvQ&oe=6A675705"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKkh6-XfOBQQ7kNvwG_da4F&_nc_oc=Ado9WtNkvTR-W3e6XhNQ0N5negX_URFPi8yPedF4Zc5e38L9p7r_o1HNwgWuAtqp92I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcIbIpF9NhIJ704sjbxrTWeo3xtS0DT91SN_jCAolrnA&oe=6A675A68"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Faesi8PKezEQ7kNvwH2m1Ms&_nc_oc=Adpn1ohSkQJw6jZSyhF1JTy-5BEK8LvuFMFiF1jOh9LZhZDdQWB1ylHBl1rbz9QlfHY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDshNVILnFw0mfO7zeNwc0saTWWFu9hA7E8Eqcr8mFOwA&oe=6A675C7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZvIBuuFG6AQ7kNvwEb1j-t&_nc_oc=AdpikwWBrVqAzYsoiWRpCh_BXaquFdsaD5Vay0tplXxizDk-uqt-509figs9pf_4HrI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDah5CLWI6yYzdxw__EpWv8PRfPwzaNrkC_PpMkbrJHFA&oe=6A67706B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
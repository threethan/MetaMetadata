U6m2W&_nc_oc=AdpK6d8w-75ftqFJUb-U-dThlN7N824tQDaDqEe4024LA5PBZTlo639sSBJoP3zzUO0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwHjjT7P2TeMoh9DXkMu_1sXXv-Tnt4phrrPfKorGi37w&oe=69CA5A68"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1iMsLhq2rAQ7kNvwFQ8M_c&_nc_oc=AdpmW58vitf3veGwBFYAkRavDn3YFCyquy2JfCtEg6J56Yzx7yqQbCJTNsfa8KmX2TI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw39XPDMdAME2tHa4BQxLXotAbUlOpZUPwAbjEvbAI_HA&oe=69CA7485"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KN63oaEI0sQ7kNvwG9RQtN&_nc_oc=Adrtl4XHbVjaIazfKL6gGhMw7llJHNhnlPXKLdhY3lhpTNYBW_q4EmvVFdv91_K7xEE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8EhX5dZ_nSr5bZ6n1-WuprFrf9HQJROqeHD8SUnyUwA&oe=69CA77E8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ty69bvmIphsQ7kNvwFB4c1k&_nc_oc=AdrS6i2bKjdInoO1hz_dizFgyzdSAWuVfO7pShXQCoCt6EsE7-VtOpJ-DAjIBbQifY0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw9d70ifcS4GvZE1tYvsqGJNDFoMXijNRRsIXon3cCN5A&oe=69CA79FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_S-JgB6MgwoQ7kNvwFgouJ3&_nc_oc=AdpQwt3CVETDBlli4EPrDfMgRl3sBVlW71L41bqRAVB97Bixgpduw7idnS7OPgwmtIo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzI-B6rvtVmPB8PSTKY-4IxifmjgY_c1sUz3Z0Ogo2V9w&oe=69CA55AB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
7jBY5&_nc_oc=AdrIk9kC6sCCGI8BPlDj0X35Y3RMeeyimNaIJwyENyzHhMR2uOyUZte4a5pTmgNlWpE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXJqYKQOn2YPy7BSHNTStYhKW9qc3sBiZccZyXGD8SFQ&oe=6ABFC9A8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=buV7tx-bUE4Q7kNvwH1AeXW&_nc_oc=AdpFK-KDv-4ccJkvpnIIABA99dykxODDrLzvDdztQcTq23auVyDf9EuSYqotol-WT8g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKZOpDBwD_geBi-QjnvLaYuSAgo-43y9A3v3blMqtjQg&oe=6ABFAB85"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tR6T90Y8fWAQ7kNvwEfE699&_nc_oc=Adr9u3S8OVdfUhpi05ql6vntCPcGJV9vdT-jSsh_MYPFqAE58_a0-PMPi4hzSahYYBs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBjCx6wC4-ri0vt4hoOqPT9WwGlvJ5Clx8r4DBIxLNDw&oe=6ABFAEE8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=onCxzqkFD1AQ7kNvwGzU-TY&_nc_oc=AdrUZRhU-9COva508I1jk7vT0n-N1cbd_7UVSQfNurY2SpIUi2JNlP9spzZItPBXiqE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMj5bbNMPL2x6QT2GViV06NY8pHMT_V6VRbB65H1HOfoQ&oe=6ABFB0FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLdgicOmH6oQ7kNvwHGoMsD&_nc_oc=AdpnMDX9d5a_9dcnfAzcFFmXFJherilqBhnDXrULIzZdTjwlHzAqhpKnoc6ev3cf1NU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSbonPKPFQen5g9IntcGPwA4oiuNAQKQMgl-bkEhZjLQ&oe=6ABFC4EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
nIu7h&_nc_oc=Ado31OG__iq_jMrz-w5WSsOrQyCc5dr0nPBtJ0XR0OrRryotxNwfSZ48R7G2qPSTnk8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqlvdVOsMyZpqORpxpMZylsKXbLcoMPJrOyruhB5XC2g&oe=6AE0BF28"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2cnIb9irJwQ7kNvwF9wrHE&_nc_oc=AdpKvVj0ROaI1wFm0FsoCILTgEgY7s0zndUCOzkCYwScOUdSzjDnYYsfgPcO9ZGRMNs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnEe9QbxyVgnhbbifUCz39e2NTO7rgF9nsZtiAnQjSDQ&oe=6AE0A105"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5quZoGCsFEQ7kNvwEf8zu0&_nc_oc=AdrvAPfPdRrW52rs_8icg49SJqI-OBw9FQYYKwr-tbMk9zCOEAj8cGH_KalIzUWJ8fk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNzkv-F6Rf6lfgVgEv9tRR-8J-lRZWA4qY5b8VuaFgdw&oe=6AE0A468"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8UfZ44_0RMQ7kNvwFZR_wC&_nc_oc=AdrJe5Z6JVEAMQvR1l5VoIjqbniW2OTM41DiEc0W6OZYbUwICMMep9Jf6GyYzY6P6p4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJzPUm-f_98SYNDq7bDN-MJLyOtdHxgJDip7c-G8FNTw&oe=6AE0A67C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMz1_GLtGvUQ7kNvwGXygcS&_nc_oc=AdqAm4_Fhe1mQx00W7Mo6VqrRk7CRFK7rL3Gizwg3sM0sxYWlSM20sGB8Y4y2Z-kZnI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeE_kTGQCp2Iz44w2t4tymZ9-oaUEyUh-AtmI_Ld82xA&oe=6AE0BA6B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
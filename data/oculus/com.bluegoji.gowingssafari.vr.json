 your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBgsPX1phRoQ7kNvwGAr_Je&_nc_oc=Adqu0OdVP89SIXDSr_yk9GAsTP_sX-RW4-jBhYyfwWxY9Ho0zfWFMEDwZL0lZNiZxZ0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVQsMA0JBQFMEeuYwjJfzCVdIv2Ah_yCzl58m3MpQujg&oe=69C7B2AB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
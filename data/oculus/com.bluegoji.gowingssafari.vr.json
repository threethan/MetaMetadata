KsmX1&_nc_oc=AdoESSFRZ0pbFoChalWcLqxShiWo_xLILiD2TWZ37vdXTl7kfl63LZrb-EC_On176hU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BGLrEtqoJ3hPoGIh4UAc_LCNyl8cz-axcGzmPYGW8-g&oe=6A4139A8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jsvVxZ3HLYQ7kNvwHBqHNj&_nc_oc=AdqcNsM7fqK7idfm7bL-sLmZ4PiJ1Bb-TA_5iqq8Xn7pyLL-k88H2u2WKu0F_YEJoPg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jgxpSgwBZjpJzwansmM1wBPFviN3fmTPTxSoEznVv7A&oe=6A411B85"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-_WOllNHA4Q7kNvwHNy-9x&_nc_oc=Adp2S3sVBf1XsWUm9T4Mo1Iahb1KbHlHxCbDBiFF-uG5vjzJuJf6p8zI469O2N1tA7g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZophrCPuoWujkW3_GF0QWtQcwxjZ0RyYa6pcxuuvjjA&oe=6A411EE8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RtJgLgeiNcQQ7kNvwHZMSKw&_nc_oc=Adoha36XZ7WBZR6PdJc_uOorC3MnXshSfCqvycv0HAk1d8d5RPL1227pDAUBHf5eCsU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_A41kRLKKJE-7gmja_odA8ZNHs90MzGxei3mBBLP43NA&oe=6A4120FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URg45uIY9eMQ7kNvwHjHFyC&_nc_oc=AdoT4NOygIguHJ6igjKYd8W9i_nsLwPbH88JHJ7jYFIpEnl6aoGOjaejogFMc7Hm5To&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dJwBSTPa3Y6W1wUVIvtSRBLNEgO15SW6Tg26AOQVVzg&oe=6A4134EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
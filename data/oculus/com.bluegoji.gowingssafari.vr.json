pSb2z&_nc_oc=Adrm4Pyx8vlWB03LIKSgRZ8bm1VRygJ6i5z7nG-IUHMPVk9FgOWWLWxI7hDmlveTY98&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TN78XhtBwzDiM5rEzY3_tCvWH2CTbq1QCPBBSOAZ1zg&oe=69D394E8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqefIaXI-Y0Q7kNvwHdKdZS&_nc_oc=AdoPGajrTD8xjd-qi4qAlkouufYZ-t3J7sS83OzZ3GEPKqPQ-wI0r1WkmLPmwAVop9I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fvKksy1Hes4qEdJR6DSI7SSIOLY47TDO2kpYhi75YMg&oe=69D3AF05"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnFiOF8M6cYQ7kNvwENHMTY&_nc_oc=AdqJ3yrxCMupyA5mvMgmkUF7J2BNn6qGKSu2Wpez7qjppmeMjtOfvRAJ4l-e5HBYRI8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ue8pCE_HRKITzxQ0r7snGAxU3Qv_W7RkkCUkuE_zDDQ&oe=69D3B268"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeCZUFGb-SUQ7kNvwGarJFj&_nc_oc=Adqa7f85CxJCiqzMyopJZBL1a6vhJXTgs3q2cq9XJYGi8uwoMHz0GPecwi38QmjuPIY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NDzovWfJxCeohVDerWOk4I9RTl7OfbFxOhfQgJ0ndRg&oe=69D3B47C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udNxdgk1n2YQ7kNvwFLG_Ow&_nc_oc=AdoU5we1hZ8uRPNGpOabtImw0K6WLx3uRbXHaEc_TmJDmQl27ePi_BBlptRQTSuDnbI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1f9HWPB6rtBWax_92Qm0RBri1sV1_1DTTU1FRvun751Q&oe=69D3C86B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
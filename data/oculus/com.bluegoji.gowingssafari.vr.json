gH7kQ&_nc_oc=AdpR8LLkKEQvSleiUiRcK-VTgT24ewXboaJbJXvMraWtaYCiVgKYF7Cwj6LNxQQiZ5k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8nWtGnIxdzuQ1dcZDYdD2uJzpwZ0IXDhp-USUy55FSQ&oe=6AEC9CA8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxFVAAMHxHkQ7kNvwHQpv1T&_nc_oc=AdoAMQ7boOeVfnPRQSDzC1UoaMemJYxrJm20iWHxca1xcDIJiYfOnXRmze4UX05E5GI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLJrkHOFmUYtSxIg7xaqMtqn9MxTbIoUb4h2X_Cikh9Q&oe=6AECB6C5"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0X7cg1cXA0sQ7kNvwEmaDRr&_nc_oc=AdpWahNhBHKWHfGNFpE3cPc5DusX1r_E4m6w2LXksxMO9RIdl2z74TWLAxIY95dgWX0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSw-4du4DYSlgMobBEu6XSc--6BgxlPoMdTVZHDlwaWqw&oe=6AECBA28"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-3IjyzuUFIQ7kNvwHzad6j&_nc_oc=AdokCLvMjxXganGXcly6MvRCrkXkoQ3ZyvTcL7d9KGalHLPIEoNAaTReUSO77Ow4sD0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-8ZQX0MpO4FBEsVMCcnKn5NA0HP4eHIVzr7MetYHsKQ&oe=6AEC83FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqXdyFjMMlAQ7kNvwF3EHaK&_nc_oc=AdrOW8ndIU2-AzPNzKkN2w3hK8IQqqSNcvaOht2K4eCcUa_8mCYBLO1vg9zzuqdODLw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDiUpIumUNQ_GhFxAbu1ZGPQI1hDGc--SLi97_T4LdGA&oe=6AEC97EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
usXTq&_nc_oc=AdrWe-G4ad0Ax8mwFoEdQuZsSELT5wHXBc7JH5mwNktPX0GZfHs6C0F1fRWa_veJlKA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcvGQFuvdBZNAeIBAlzRTDToa1tMLv99SMCyOqQCEojg&oe=6AC66128"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_s_SHDql9GYQ7kNvwH5WhLn&_nc_oc=Adrj_g-kWjEL060QCUBfpdj3h42gLX58PJ5oEYuApTEodaKTQKVFHqXpCSEdTw-0La8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXJcws3G0j3UAeOOSZvqOXcODMRQkvPwD4kPsh7SHnTg&oe=6AC64305"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j753Qt9l3gUQ7kNvwH-QTIc&_nc_oc=AdoEjpuPsqooIZsFUB1KD1VfB8Mo65fLrc-svwZ4cxzGKY7MNMo2DTPK_Uq5k1tTlZk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4xJ23UB0U2QEXCo5XlpEP2aCK95tdZb2fMzBq3m9DAg&oe=6AC64668"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nK2KnpgAflgQ7kNvwHzhFvU&_nc_oc=AdqAZfLPVEpdXDJdZ7QUHxccty5H8AxvAyaQFAC90zKcyKzNDUI4nFU6KhKyUdyoTL0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKgJhGkZEbVVYxSkBXKedCpUERFZ8QFq_R31K03iA_bg&oe=6AC6487C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HBpCxhyyA4Q7kNvwGIbkQR&_nc_oc=Adqbaffhvgu3EWmtT3eJ1VGvSZhcwZPp5k2WXqATV5Amr6QYA6_RPQgNT8JUpwiy7oI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1UopsqSdImA_nUNf7FIVItDfyAME_bt-fRDgg5Vbocg&oe=6AC65C6B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
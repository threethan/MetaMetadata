78nz7&_nc_oc=Adqj4JYElRlsagBdKvckGMCZj4DMXnDj1BZLZ6-7096d0J8Q5fnbv5QI3MPxffs2p7U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFAcRCGC52yy6LJ2DLIjbW0H-5WiMS9SYjTvQk_7NzEw&oe=6A6CBB28"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Unt3373uukUQ7kNvwGcZwYJ&_nc_oc=AdpSQ4DNTjPKRobtieonvigqhxkH7yZmuLlXArrfPYFQPOGx5orBBxeutsZOoqTL7iY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVOd_CTReAG1CjIfcO_i9vtj6VpjYYmgUXpKiSTRiOSA&oe=6A6C9D05"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pwi7jb3GI5gQ7kNvwF1YJVg&_nc_oc=AdpEpUrER4n4A2awZtC324GNY_wRe4Abgk5Olq1NAzjgN1XWpyIQMbqCDNFIdlpE_NM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCVFitdjK_7iEd3kLXzzSQ2aU-eHmSqXjmnyO6WP8pgg&oe=6A6CA068"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3UyGfB7f2YQ7kNvwFrwF0U&_nc_oc=Adrpjb77fTsJX5SDsKOm9r7YqplHSvvS4M1R3gixLgoqv072YubwhAoc3u5kVrzNEHQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCP-86StP_mmVIG4glD_jM_JVwE2ydMJuOvHKhIoW-STQ&oe=6A6CA27C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTUNM6xQ0LMQ7kNvwHkgqRk&_nc_oc=AdpzIQ3aeqbcDasEQd6hn_bLHuH4vG7XNyLvxGQuk8nwXvv_sq8OIUOSLov4zAeKUbs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzLaWFfFNyq2VCo0cKgwDWx-1APtvd-Bc9MGIgESNxhA&oe=6A6CB66B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
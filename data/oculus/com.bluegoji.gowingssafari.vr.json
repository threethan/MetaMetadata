u_4Gc&_nc_oc=AdpQN96A4haHBYxThItTew2F8EkVNRqudZfnCtM02MPyY-pCbFSfnlHyacb3x7yYbLc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BPqbf3KCsFSmW4YgYGK_5VGpi_g3j6GGNT5UPzSJJMw&oe=6A0737A8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQeUunG1e3kQ7kNvwHKK6bJ&_nc_oc=AdrusBfDDH4kTAd8jmpo8KILBu9vAyEV-OoZApQWQflup62Ke6MTYHfsAfpWuVq4Bbw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Zwd6vk3kRfvRUiJYSBSLDVJPv3Pkh9bXyoRYSwi9gHQ&oe=6A071985"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kyO-XJLxvgQ7kNvwH3QZ9S&_nc_oc=AdrXj-ZE1hvpdDpUBF2pXoWfYgdM36vRdJdwJPXlbiYPtOSxFQXX9_bGfeUqSA4yj6E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Hkljx-QHSIzDdGWCSLWGQL2cWMlld1vK4m9zu8aOdag&oe=6A071CE8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5zEkmcoMNgQ7kNvwHfS4M5&_nc_oc=AdrjrFLep8Z2opXXNPX4pZ4BMQOmdvdyecMvltnt5kjdJQuA-gncl5peowCAdCB83UQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DSapSu18nJ0t_D3elQR_AzjW00ul1J7Pyo2KXcgkjpA&oe=6A071EFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-KdR0AGbQ4Q7kNvwGfmNMp&_nc_oc=AdqTtudxlh0b7T_mSLr4TPI4DP92C5QslakRseYioYsVu-rTE29qRgS1NCMrRj0iBxo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XdY_LHXKIMjoVWj7ZMKPlLqF3zcgfDtnIQSsRph7KOA&oe=6A0732EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
1xrkk&_nc_oc=AdqlKoCwVmzF6LKhJQZ6tdqMkwx-1SYbh9fSX2ufJpjf4ExBoRriR6YQSLeMW88KskE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwARABZqKikgF2E5n_4_pVV2O6QXyN6YlWqeQJhCrCwtQ&oe=69CCFD68"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1iMsLhq2rAQ7kNvwFTXM1C&_nc_oc=AdphRuQs7hx0QMZAUBMi6Kw7UmsMFO5mtoTsBMKpdUO1557uUTbqaaDGZuL82vSvfN8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz0eSCRubAeskbr_cEZ0zz6F2a8xThXvfCr8sWbE_z6EA&oe=69CD1785"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KN63oaEI0sQ7kNvwGpNDqL&_nc_oc=AdoS7lR26pj4YT5Zfy7hsLVWjVSlo86BW5Et1HxUme0Qu2OVC29mPzlcX9x3HZ3YECg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxFFT8LvUgDPGRQyZQuhuEcr8nh3XY15Zxa-ULdoG3a8g&oe=69CD1AE8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aD_q148Uh6gQ7kNvwHjhvQi&_nc_oc=Adqlld3zdGBTbCFmiyrGtQtQTFpfiaTn4lkn-3n-Y6c68-YtihmDFLp7lceotc9meqo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-l6oG3olNzA3Mx9jg9SakR12Pj3xMFB0VtEi8fBomUQ&oe=69CD1CFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmO_eSCXfr4Q7kNvwFP9096&_nc_oc=Adod0yrfOL1-liIwJj3pjvUdlGslxPkOzxzuAmJvafEHdgOcXeMRkob-lNm-9oY2J5U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwt2_LrX4MbMIRp-I9XBMZrRa7riAocRwbJJy26JUAVTA&oe=69CCF8AB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
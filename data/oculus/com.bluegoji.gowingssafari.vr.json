ZD34D&_nc_oc=AdqbbSojC8k-NoROL_9JrfBXL8PPI46f5DxZxUMqAsVdwKM4Wv8mOU83oNzKMa-Jv6Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOIm-Ww1VIkBuJAA2wUuUg9NCU19fJrCjN8X7WIzggPQ&oe=6AF1E2A8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWKQWKBtfL8Q7kNvwHka1qX&_nc_oc=AdrInbMxqcl0QHxDiggSuPCMt7cpXmAFG3OKe5_KTClbtvgtr1i3iN4tD627q-Gk_qQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDpiSVrdTuWMHp4P9iM9Jc16fFvTRh5yiGbf_4vasAdw&oe=6AF1FCC5"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSvyzZkIHNYQ7kNvwHPKxY0&_nc_oc=Adpg2gNZvLAyrdSfSs9NhaKvkGcV36kd__nVxYZPg9g3XhaaAMbvieR3PnYE1MHuFRA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQb8weTQk1uJK8aS3OXJ3THv7SBWY23wP6Eh_U-qJ23Nw&oe=6AF20028"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPovZiz7GoAQ7kNvwET5v7d&_nc_oc=AdrXe1XDQ2tKSm6q54AAHTmZIu3znhKabsb1At5ZBA9MFVPE98HhXp0W-V7FQfFXQ7k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFlHg6n_0LhMTh80SX38PyZpjqJKW8GT8XcK479djPAA&oe=6AF2023C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBuLmSEto3cQ7kNvwFs1nWl&_nc_oc=Adojz9lKtqN5d93QzVIsK-FSfVbh3i7oi1FTGlWOMHkSbTpRVV-G3Jpsltk4d4c5kXc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS11WmtcXjykohvOdwbjJCt8uYX945oEARnM2XOUL8zhQ&oe=6AF1DDEB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
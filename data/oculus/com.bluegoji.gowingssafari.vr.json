xNfmY&_nc_oc=AdpsuGE7cT20L9-ZJPd-pnv2FzA_uYLDiCdHOnL8HoH0inW0_e6aPeTB9ml5IFYGH3s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2ucchcBuOFjrX9dY3EaqbEZeDugj95ksjTT6bV3ruGQ&oe=6ACE4A28"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5k9Z0DkhkEQ7kNvwEX2NtS&_nc_oc=Adou2Q5r46uoP9ZUHkR6AZssmy6ZldWHzNMfT1MlelGEJxQnw6eQqvuWKYDmMSrFDlo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOACd7mfcp5L3lqbhW1pSfrss6iOqNM3ytqvvyMgEirbg&oe=6ACE6445"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YlvhWoqQYjQQ7kNvwG0WWGA&_nc_oc=Ado5szlW87lC94N8V5T6Ljo0Cm1KKZzPoAjMn7YcNYswSe8afAvHGo4Xg-ZWkxD72TI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHXwTpAbgXH_mnRV1FK0bRKKE0pvgw5d6dbrQwvROHMg&oe=6ACE67A8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ugjnWfCbJAQ7kNvwEmOEQ5&_nc_oc=AdpcIsHlBL8X_gRN-59wJHq81n37sKxdRUFmzxq-QZJjgLyd8iw3j__AUlXNDWSr1ko&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiaa-rCST4blwgs4U_3QQJI2plZtvn3-yis1h34XqxqA&oe=6ACE69BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EA5g8lRFvfUQ7kNvwGONgyt&_nc_oc=AdpUTucNM-GmTaVPE6lrfHFt65xiPuwJQtyC0wpZlqQHOaHC4hKg9Y_UStCiZfKyQd8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEtNlzoN0EeedcK-xJaEnS9XouE2UtC7LtbtD83P3xxA&oe=6ACE456B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
qWzhQ&_nc_oc=AdqYK26alH2sNUdcnx71DHZ5xid4slVaMaZ8YKGUYmxTyQs0BvZIia7oAqqpxrh_45w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzOxFNOMYGjE0smdAXR0PF56gPnLXqW2OpFJ2BaVnJTQ&oe=6AAD54A8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3McW_KkYhYQ7kNvwHvSrZX&_nc_oc=AdphZonOWlutHoE9T1RQIhfZTrq-S8Mxw3dBLD58dXPOfhQ8LOBPV0zYZeNXRSQJM8k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLsIgyGh67IqIrPM1mVKx-UIKUdJpT5gwsqD_wLouduw&oe=6AAD3685"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gVZ5x8BCu8Q7kNvwGfYmD1&_nc_oc=Adq0E-WkIUVBqLldTnIAn5Qf99CmYM81gvuJRoS8CChLHsTJrKxw4_MJ3LOh60lkeTQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3yt9EY_pP_MKxuoy1Dd1vKl2odaKER-vscbmCiWjxGA&oe=6AAD39E8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6tNraS2PZQQ7kNvwHCuwIM&_nc_oc=AdoZdxzxIFPqNcbcnJ-blYlRacucMUnS2sKHbrhtgCrBLr9XHeE73rINUCr1aMlGNu8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeuVT94Z53vYs_h7fzWsv9XwZdL2-QCcsg-POLoMeYvw&oe=6AAD3BFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihCyU2NaiHkQ7kNvwGHBRS7&_nc_oc=AdqyyxnXf8YrPp79z963J6V9nUb883mfV6UhXZymi7AfU_BWyca7UnkHWqNOSnNrJVg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvKzrpVUkldopq6j9mCgo60qYA8aPWcQ9FaVlPUFrW9Q&oe=6AAD4FEB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
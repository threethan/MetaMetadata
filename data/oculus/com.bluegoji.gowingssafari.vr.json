4LWvr&_nc_oc=Adqk56cpMAeTMCVtok_5zLBJqdAKj2KGIfxhDnQEa9Eebns967JG9BD0sMv7rtI2-l8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoPw8Fno31oIUCLCki7OFmrqL6C8O4iCjxigovAsPMbA&oe=6A9ADFA8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6aY8ldIpuQQ7kNvwEs3PVq&_nc_oc=AdpBFTAMFdKNqZDbrrlUvVhoVDPooitAHEGCYrXN7SntQadic2YDQS5J39JMqSux9K4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJyilqw0aCgA17LXAu1AB213aPdckO9tkHjqlhlIdKrg&oe=6A9AC185"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzU0F0hCs1wQ7kNvwF8nndt&_nc_oc=AdoBH_jh8XB_y11vDmOzc8JpopXwkCsFvdSM2sV4135BV-fPXQrL6Lu8IKs4jwwstW4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJA7zucNz2BvK7I2KecKF53-ypME1WuAOUcywL4k1qZcQ&oe=6A9AC4E8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4VHY9iU-t0Q7kNvwGQiUiP&_nc_oc=AdpKMOQJgpDmOZx2xF0ZWLyG3fsNZ0216h1iUb59IDDQdUYd2Iw6DoLhegfcIMyziz0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmdPK8bMhbWHA2K9FMfHy7rahbeKgqALYciqAn-6NlOA&oe=6A9AC6FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mk5VT9w148IQ7kNvwFxgvr4&_nc_oc=Adp2CUgqa1L51hhn-iuoooGPo8KrVkLFeHWoItlXwzM8aewMcqxQ36leGKxbT2bbWkA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZUZ2K81HCPnLyoNmxxfrJzxScCoassKb_1FARVe_OCw&oe=6A9ADAEB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
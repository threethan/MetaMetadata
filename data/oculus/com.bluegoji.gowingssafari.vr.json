vR1T6&_nc_oc=Adqjw13Ryao0hgIX5UeUGGvREsn2JQLppEFq52lfyqSMfsbhcgYuH2kngAVxMDDM7Is&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kE1BmRut_DrC46OXHhFWxOllgfqXx00obdCPXDlyCNg&oe=6A107228"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0s7a_XxquCsQ7kNvwHklfVv&_nc_oc=AdqP8-6Ci5TypOG1V2xKsG1oTqYMgfB4jQSXA74KXenPFkqYjMs1cnLHrjb0hpRIaWA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RUTxNBKbreWtNuduPb32gQSpKNZbgyCP4BKPaxGy9Lg&oe=6A105405"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sA_HQkClT_wQ7kNvwE41Mi4&_nc_oc=AdrCNGDSCCy5P6yOxgP55OubT9OIDBlqnBz7A45u2aG9iJcrJ48_FpLik3Cx2lQdISU&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mwBklRH296r9WINc-E3lO_uyLbBd0pCK450b7uBv_mg&oe=6A105768"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FB-9ncrLuroQ7kNvwF_PnTt&_nc_oc=AdqEyphkQaLY7y24ua0nHykoOP3TtJdGioB2D9_NQKeVjXDT1XWc0yCqVl43LduX44o&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Lmh2IW6Zgo6B3Kd4S9OfnCbLsQyuFwdX8b306sJNoLQ&oe=6A10597C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMRZngNo_0cQ7kNvwFU5mNO&_nc_oc=Adr92Ncih65Cevmwwiw-jV5rvCaROvdlBCOdqlsjnccfR6jLbvtjtuCWtxqbYQg7fXk&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UZjayheRhgv_Bn6wzrGox-ItITpuZ-85mnGi7gX5BDw&oe=6A106D6B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
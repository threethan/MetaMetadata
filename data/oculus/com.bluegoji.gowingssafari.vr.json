Rw6nz&_nc_oc=AdoS2TlqbmEM2p489Eyne3mnCAufwTKyvrB9wm908rmbkdjq2aJXjo5W7Nzzrj-dX5E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LnPiP_yz_JTlZIGyNaZ_Wxk1H-czJ_tUMBI16NXC_5Q&oe=6A0C7DA8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OkpRZDfhS7oQ7kNvwFIz2Nt&_nc_oc=AdqwTc68NHNbgTUp2jS45LhDz9FmMdhdVTY8l0s3MtidrlgjxKLLqsvibOjj24LBCyw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pFw8Leq51PdaufTubO-N7ylRYzm4RkKNAr-SOwlR64g&oe=6A0C5F85"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ug7FDnT7oz0Q7kNvwE3bSsZ&_nc_oc=AdobXxdKW3yQMk0UhNEuZWRS69QiywMx47H6GjfVss_fDj1Au6KjH1475e2uxd8dkzs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61XhH098E5wUR6-awe8LjZ4MJpDaZuDd2yCnEqvmSjnw&oe=6A0C62E8"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hiLouhinO4Q7kNvwHWEet_&_nc_oc=Adoxq5vucXdWP6Db-VLdyrYO7x7E1HjU9ID7sBradU7DqztMvLtdfm2D7LYCnW20d7Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73Q9bC1EQSC0BCRkWJfFNElkfEb3vhhivn2h8GPZpkiA&oe=6A0C64FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vKv07ymKsQQ7kNvwHouQ1R&_nc_oc=AdoepFdZ-l0WpDGMLR2vB__TNOpd-H0yP7moM8-4uS1Nq4FT_9mWWCcQ5984UbZz-Zg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bKeMM24DvCdkdRrU5HUdONlhllQu2G64tHYup9ZsJGg&oe=6A0C78EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
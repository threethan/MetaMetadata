bLMqb&_nc_oc=AdoLu_ktUvzHVRrM7gSZwqqxXA_EChsIiIrMRmbZsoN8gFaQgRC9XbE_RPAmN5hYmDw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMLqd0PRg2ZNIsurZMlFnvhjAx9yxabZjbJBVmytSoBA&oe=6AC3BE28"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_s_SHDql9GYQ7kNvwGozHDv&_nc_oc=AdoLb8enQC8RrmjDKZiqeuHj0onVBcOBmZHwRjyZ_ldaqxMt9G2Hiv37A7q3G91fSRI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMdAQumf4KWN-Yt4CET6LaZhOPMuDqUGXEFUsCjuvkQg&oe=6AC3D845"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j753Qt9l3gUQ7kNvwHzI0p7&_nc_oc=AdpgDFDjdAdqgY82VxL306-5zZiHwPUNZ60eJwUKx5_MdqkpTHWvCZTPahxTCm2Dszs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNB30WbQgg-2amwdC7PE2Ry9CStD1FweN1vbam8XBMgHw&oe=6AC3A368"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MreihcsMRX4Q7kNvwHcPF1w&_nc_oc=AdqwJOMNpX52AXK2jFbY6Ko8ld8Vy19bWFqUGKot4wbgF_61jr5dLa66zBnsLn9UfbY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAwsOTVnp2uzL79Vrgl8TF8hyOyO9mS7bS_1RLh_wkvQ&oe=6AC3A57C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84SdsaFpDiAQ7kNvwF-lYU-&_nc_oc=AdpU5GIMxvDDrcs8CzACx0g4oYcwsWbhB4QZFHRLGKg90wuik7DbqTpIaodL_6ozk7o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPC2oi2cpjH3vth8BTE5NZh4G8zpyTVS6zvAvFjLQn48Q&oe=6AC3B96B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
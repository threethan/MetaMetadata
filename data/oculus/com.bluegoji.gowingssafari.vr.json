YWfsfSmtrOETt1XZ8nXGeJt3SKFkuSxO2Conx9oksqGXqGvQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2yMmGVwmVRVURb26cVO5GErsvkjZbWuoz3CqDUBGbdg&oe=69AEAAE8"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fW0DaVj4HX0Q7kNvwFLPn-V&_nc_oc=Adnq1B9fibf21V4wLPcq3BDuOSQNyDTfMC2TdB3_N4_l5d-USA9_Kj35s8JNjpQVLNI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxgPNKNHdFJ3w-gCHFuOvw0a5Ewm34FCyvDp1aLSi-eSA&oe=69AEC505"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_6Yl5d4e1wQ7kNvwFYOzxe&_nc_oc=AdmTVUfb-WLRJ2eraUWFqk1R7sywxsSJEErIXITrOOiTFNZpuX1UD56KuH0bp0jzr9g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxvEahb4Q2MLNo3geD_bE-P8aax2p0wJrdN1xruCjvS5w&oe=69AEC868"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZmcI6SSHU0Q7kNvwFNRITw&_nc_oc=AdnNV7nCAEfZc-wnjNDaWn1Deds6-VF4UchQEk5PT5dshscwO0ss6F7ftNZ36PLeOz0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz68GglOBMRT4IbLcHaFBUpcXtIvRkRbw7A6A8Ugz-ObQ&oe=69AECA7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWwNZ03l9zgQ7kNvwFuhYPr&_nc_oc=AdkQrppNDF7bPh9vbhtOAykZC2kA8mscNlgk3qdUswlaptg8I7YgUZ1Sg3d5cJVO8Vs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwfoMeLcPOOa0IarmQb6YRDl66NLOzPo2BzQF6m54IMkw&oe=69AEA62B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1483516800, "lastRevision": {"nodes": [{"i
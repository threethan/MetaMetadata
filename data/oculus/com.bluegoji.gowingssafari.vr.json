a4ylX&_nc_oc=AdqYxqE6XjZ1FKSG4_93LdBG94bHtXfiF64cx3EjI6Wsqd_IcEIv_c5eOXtMOYUQJik&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sA9xwvQSwN4spuinf6nUkpaV0_5MAbRfnlUydZncwvA&oe=69FB5A28"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7pSF0R_lOsQ7kNvwGR93TY&_nc_oc=AdqpBPCswl4o2anJRCwMznW1qbCSLYI41-1CftiUSNIviVmACKdXZ73q_o3ceyeUKb8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fXAgpZEpTqZ4IO7cCrIbZy8O46z3xJwbjcnIrwbdqTw&oe=69FB3C05"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dMHYm3KZLIQ7kNvwE2Ib4H&_nc_oc=AdqvIFh-plb0bDbZcS6hQAsdPLDxQp1MH3NwMJZJQWH048F4ZvLP0ug0F_bQQHes7IM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kd4hIPL9x0u_WGe5AZeX53Y-r5Wbna8SH3ALQmY89og&oe=69FB3F68"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYqB87GPN2gQ7kNvwH12iSE&_nc_oc=Ado1-7ezCS9MNmUEZ0SHNGfQMXbITTGZecw4C_q9aLe4BEq6TzfoMEb0Ep3_-w_ganw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NjE04bQb2_UtltQzG1U80DpsrA8OI8-s8NCwqz4J1vw&oe=69FB417C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRr16OcFE5EQ7kNvwHo0cN8&_nc_oc=Ado10zkjh3AjTg05VaFBixlV4wU51mzldbskQlK_yrBTp8l_dJleGk-jUjkZrIjD06Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NC1031LqzJBPBJH56qKK-LMQCoTiU-quA1-fO6xxd0A&oe=69FB556B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
3utFa&_nc_oc=AdrDLiWZqDnEDRD1SyygDU-rjuQqHu-4QBjRcjst6zwgJ6cS5PbxQYE4ibbXN5bhm5g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ssmwEDRhXWF0ABqar7YTt2ZX2AlZ-JLoKFOiYPwdIEg&oe=6A05E628"}, {"file_name": "migrated_image.png", "id": "499453900943697", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680356_690525744442078_236137727135842304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQeUunG1e3kQ7kNvwH0Vc4H&_nc_oc=AdrqCd799WG0ul6JAZMRCG1OwcblJOeLj7XIqTgoyK-HZtNVad5EQbVnh2dtZjtkDwQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oR2abWJP_a5ufa__aYYo1Wsfe-6_GxofP1G58AG9-cg&oe=6A05C805"}, {"file_name": "migrated_image.png", "id": "293847761594371", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386302_1022493244529332_4292443607576608768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kyO-XJLxvgQ7kNvwGbGTGz&_nc_oc=Adr4Gf_TUOXokvg-k520p4VRt88YfTuE0Mu-VA42mUhRrfGfz18cBWj8XIjPpbLXV00&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Gm7hn1MIgrfc1Z4evYtxky7YpZQtVY_iv2U5bDp0ZFw&oe=6A05CB68"}, {"file_name": "migrated_image.png", "id": "138450060924123", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386444_229684207441860_7481959804181676032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5zEkmcoMNgQ7kNvwEbXdTv&_nc_oc=AdoFRz_ULLry3TaYy3e0432kk957hvgtWVZmLFK_c1XoAgWM0l6hXg7QjqraOpkTiKY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AgYDMh7YW3g-PVcU-XegPY4u70eyQnfAScuB0JX_Hmw&oe=6A05CD7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoWings Safari", "keywords": ["animals", "photo", "poachers", "wildlife", "flying"], "long_description": "Experience the ultimate adventure through the African Safari as you document and protect the animals. With a knowledgeable owl as your guide, you\u2019ll take pictures with your camera and capture dangerous poachers with your gun while exploring the plains. To gain the highest score, have your photos reviewed by a safari specialist. Save all of your favorite moments in your very own photo album. By traveling through the safari and earning currency from your time spent and photo ratings, you can upgrade equipment, including new cameras, net guns, and jetpacks to soar across the sky.  \n\n", "short_description": "Have you ever wanted to fly over the safari?  Taking pictures of wildlife and protecting it from poachers? All of that is possible in GoWings Safari\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bluegoji.com/privacy", "developer_terms_of_service_url": "http://www.bluegoji.com/terms-of-service", "publisher_name": "Blue Goji", "support_website_url": null, "website_url": "http://www.bluegoji.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644836676820194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410199_1313519982039907_7277712462621704192_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-KdR0AGbQ4Q7kNvwHatq5T&_nc_oc=AdqrnVpmhru9b_7nWbyC_OcPDWOKpg2yIiUZyvBldrWkhuJDHhZpVodAqK_2hM5wpr0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JVcbgQc-yIpZXw9lYHEejGczQa7Uje7MLOPuIIcqTFQ&oe=6A05E16B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoWings Safari", "platform": "ANDROID", "context_category": null, "context_topics": [], "relea
_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "3250402945153996", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620384_3250402948487329_9151233246296702286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4E4hpMg2lYQ7kNvwH6RTFi&_nc_oc=AdqMFUJdlTZnJl6_brCjS7dTblgcHPFNSXRvpADMW9AP1htfI4KYFIA6mblwwE14gMY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLqEHmaRzglsL6a1I3k6b9h1As8Bp3dmvw8vHYBIm8SQ&oe=6AE0A976"}, "display_name": "Kaiju Containment Crew", "keywords": ["hangout", "sandbox", "voxel", "physics", "destruction"], "long_description": "Jump into the ultimate city destruction sandbox - Kaiju Containment Crew!\n\nTime for destruction - play as a massive Kaiju and level the city and destroy all that gets in your way, including a relentless army that gets more powerful as you go on. Or play as the Containment Crew and take down the monsters that ravage the world!\n\nMultiplayer lobbies - play with friends in private lobbies or strangers in public, or practice on your own and use cheats! Play catch with buses full of civilians or blast helicopters out of the sky together. You can fight each other too, engaging in epic scale monster battles or blasting each other out of the sky as mechs.\n\nUnique abilities - use a variety of devastating Kaiju abilities like a laser beam that melts buildings in seconds, or geysers that explode a line of cars into the air, or even giant plasma swords that cut through helicopters like butter! And that's not all, the Containment Crew can use powerful mechs with rockets, flamethrowers, and more.", "short_description": "Protect or Destroy the massively destructible city!"}]}, "developer_name": "Borealis Sea Studio", "developer_privacy_policy_url": "https://www.soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Borealis Sea Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rat
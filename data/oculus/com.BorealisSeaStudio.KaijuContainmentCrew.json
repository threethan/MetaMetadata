QWtWcCA&oe=6B0EF299"}, {"file_name": "ss3.png", "id": "1077195774755056", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_1077195778088389_8390264719796376809_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXGWSX9-RTUQ7kNvwE-PTOS&_nc_oc=AdoB2FTznNP_4Mx8Z5kGmGsq0P72aD7K_5jKZCoARnLgR8NW0ngJ9Co5sqsfaGuD8fs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXcLFquwe0A2NowNjTSp6O7tcHryylbxkXtED1ArARlgA&oe=6B0EF50A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "3250402945153996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620384_3250402948487329_9151233246296702286_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLc12UI8HsUQ7kNvwGFOoKW&_nc_oc=AdpMAZhUgwlUPh0Vovj9wReylNcF2LUtboF72s83fwXQxegeR3c1SDAfjN86PiDj95A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWtVAsO6ybWwoS-Ga_oLEjrPCTI54kJ8MKb7IqQA9PPAA&oe=6B0F0636"}, "display_name": "Kaiju Containment Crew", "keywords": ["hangout", "sandbox", "voxel", "physics", "destruction"], "long_description": "Jump into the ultimate city destruction sandbox - Kaiju Containment Crew!\n\nTime for destruction - play as a massive Kaiju and level the city and destroy all that gets in your way, including a relentless army that gets more powerful as you go on. Or play as the Containment Crew and take down the monsters that ravage the world!\n\nMultiplayer lobbies - play with friends in private lobbies or strangers in public, or practice on your own and use cheats! Play catch with buses full of civilians or blast helicopters out of the sky together. You can fight each other too, engaging in epic scale monster battles or blasting each other out of the sky as mechs.\n\nUnique abilities - use a variety of devastating Kaiju abilities like a laser beam that melts buildings in seconds, or geysers that explode a line of cars into the air, or even giant plasma swords that cut throug
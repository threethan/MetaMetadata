 in your way, including a relentless army that gets more powerful as you go on. \n\n4 player co-op - play with friends in private lobbies or strangers in public, or practice on your own and use cheats! Play catch with buses full of civilians or blast helicopters out of the sky together. \n\nContainment crew - play as the containment crew, a special ops team of humans that have unique tools like grapple hooks and sticky bombs they can use to take down Kaiju - or help them destroy the city!", "short_description": "Protect or Destroy the massively destructible city!"}]}, "developer_name": "Borealis Sea Studio", "developer_privacy_policy_url": "https://www.soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Borealis Sea Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1640905267365868"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4553932191562162"}]}, "baseline_offer": {"id": "4553932191562162"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787232480, "status": "PUBLISHED", "id": "4553932191562162"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
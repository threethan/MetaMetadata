cial ops team of humans that have unique tools like grapple hooks and sticky bombs they can use to take down Kaiju - or help them destroy the city!", "short_description": "Protect or Destroy the massively destructible city!"}]}, "developer_name": "Borealis Sea Studio", "developer_privacy_policy_url": "https://www.soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Borealis Sea Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1640905267365868"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623295_1064389299612860_889885272864452906_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7TYLrc_dx9UQ7kNvwFq-7ke&_nc_oc=AdoDlJAxyUKGqvWFEUgziinsbyIcBw_JSyj8-6lHcI7S0lmt3eB2-zx2ktVykWE7dqY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqPnDpfK-f-E4OK8kMPttAr79VdENMx-oi-Fz5ae6EMg&oe=6A95B34E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Kaiju Containment Crew", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topic
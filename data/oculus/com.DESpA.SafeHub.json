109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPSyxol0tS0Q7kNvwGP2_Bh&_nc_oc=Adr-xyQa0ZIHwy_wUifsgCQJqIAKuDIF3ODbjPbcqHk1VRWY3f9_SVZPE038Xa_3NzU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR-UMcJJmbr577Dcg8z5ByZ8Nw73QotpOnH077_A2iadQ&oe=6B0C5564"}, {"file_name": "4.png", "id": "2886365981745348", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595129854_2886365985078681_515634587893089030_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jm5MfG8-BxkQ7kNvwHLiXg-&_nc_oc=Adq_7XyuzN0AWR2THsVOOwcdAcbUHLn6Gc3_dAJrJ5w9WJiUckD_56UR9zsPDpXjV7s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQfJ12IV45K5glLEc2t2AjR6fUsvxGkX3wDHy4poAkcYg&oe=6B0C6F2D"}, {"file_name": "5.png", "id": "1647761096978189", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830822_1647761100311522_6260556203980485302_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzXkKDdy9OoQ7kNvwGfx2YJ&_nc_oc=AdrQ4yVazJ1DcJ3ey4slNeZyuH3iNt6p3M2ia7e_bn6VYVaeo4JDVOT3nPSe8tNinbQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRFjc5m8L1mGjU-QQoDzSmikmqzoRDZN_Cj05RHEtO2tA&oe=6B0C6568"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PortadaSafeHub.png", "id": "1624832262322993", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620655_1624832265656326_6625754155521474567_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_I9EEQ0r9LsQ7kNvwGYdFUq&_nc_oc=AdpSmibzHOzJG60xePs3x6Q085DrVZWKZz1ER77_NjGwEk40M1bKjT_qPYe8OkthBD8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTzUrNsfxD_DMmNtnpfd0qNb9YIQ4NfigwnMNuweNvPtQ&oe=6B0C68E6"}, "display_name": "SafeHub", "keywords": [], "long_description": "SAFE HUB is an immersive, multi-user training platform for Meta Quest headsets that enables companies to train, simulate, and evaluate their workforce in interactive virtual environments in a scalable and collaborative way.\n\nDesigned for organizations that need to train large numbers of workers, SAFE HUB combines virtual reality, multi-user interaction, instructor tools, and performance metrics, transforming practical training into a measurable and replicable experience.\n\nKey Features:\n\nMulti-User Environments: Public or private rooms with multiple participants and real-time interaction.\n\nTraining and Simulation: Virtual scenarios for practical, collaborative, or individual training.\n\nEvaluation and Metrics: Recording and analysis of each participant's performance, actions, and interaction.\n\nReal-Time Communication: Voice and interactive tools for a collaborative experience.\n\nInstructor Management: Control, supervision, and management of training sessions.\n\nScalability: Ability to implement and replicate training experiences for multiple groups and locations.", "short_description": "SAFE HUB is an immersive, multi-user training platform for Meta Quest headsets that enables companies to train, simulate, and evaluate their workforce in interactive virtual environments in a scalable and collaborative way.\n\nSAFE HUB es una plataforma de capacitaci\u00f3n inmersiva y multiusuario para visores Meta Quest, que permite a las empresas entrenar, simular y evaluar a sus trabajadores en entornos virtuales interactivos, de forma escalable y colaborativa."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalexperience.cl/pdf/Politicas_De_Privacidad_SAFE_HUB.pdf", "developer_terms_of_service_url": null, "publisher_name": "DE SPA", "support_website_url": null, "website_url": "https://digitalexperience.cl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet
content-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWvgkwN9oXtaFZFstRjzUc82KCVSGCP0ZGsbmNXtcvCw&oe=6AE9E628"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PortadaSafeHub.png", "id": "1624832262322993", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620655_1624832265656326_6625754155521474567_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbO4j0tfurAQ7kNvwEyG1s1&_nc_oc=AdqlThwEstbzIKG78aHg03noPiWMSBauwmNh9shflkdtYQQKrtJn4WoyRXpM8GMpv-U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ4ieAGW6p59SdxwsOg2BDk4QQN8bo40pFy0BLrwshhw&oe=6AE9E9A6"}, "display_name": "SafeHub", "keywords": [], "long_description": "SAFE HUB is an immersive, multi-user training platform for Meta Quest headsets that enables companies to train, simulate, and evaluate their workforce in interactive virtual environments in a scalable and collaborative way.\n\nDesigned for organizations that need to train large numbers of workers, SAFE HUB combines virtual reality, multi-user interaction, instructor tools, and performance metrics, transforming practical training into a measurable and replicable experience.\n\nKey Features:\n\nMulti-User Environments: Public or private rooms with multiple participants and real-time interaction.\n\nTraining and Simulation: Virtual scenarios for practical, collaborative, or individual training.\n\nEvaluation and Metrics: Recording and analysis of each participant's performance, actions, and interaction.\n\nReal-Time Communication: Voice and interactive tools for a collaborative experience.\n\nInstructor Management: Control, supervision, and management of training sessions.\n\nScalability: Ability to implement and replicate training experiences for multiple groups and locations.", "short_description": "SAFE HUB is an immersive, multi-user training platform for Meta Quest headsets that enables companies to train, simulate, and evaluate their workforce in interactive virtual environments in a scalable and collaborative way.\n\nSAFE HUB es una plataforma de capacitaci\u00f3n inmersiva y multiusuario para visores Meta Quest, que permite a las empresas entrenar, simular y evaluar a sus trabajadores en entornos virtuales interactivos, de forma escalable y colaborativa."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalexperience.cl/pdf/Politicas_De_Privacidad_SAFE_HUB.pdf", "developer_terms_of_service_url": null, "publisher_name": "DE SPA", "support_website_url": null, "website_url": "https://digitalexperience.cl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_CL", "es_AR", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1650328899794125"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1087061583871036"}]}, "baseline_offer": {"id": "1087061583871036"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791512400, "status": "PUBLISHED", "id": "1087061583871036"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1654973999329615", "version": "0.0.38"}, "id": "1398072811976592", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typ
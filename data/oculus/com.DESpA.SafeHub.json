ka94asdcVsQ7kNvwEdP391&_nc_oc=Adr-QGZnXBbpahUC0Z6MEXvJ1-pNkIZyU3fugUa5iGOeYuAwODMl-egeGGzTuGUzkTo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJbiGydRmSFqA9Z7xeDekqm0mz7Q0avOdk27oGJ0KRsA&oe=6AFF07ED"}, {"file_name": "5.png", "id": "1647761096978189", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830822_1647761100311522_6260556203980485302_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWRL-zOMzj4Q7kNvwGaFARN&_nc_oc=AdrfnfMWcTSb8JAAJ-cu6Vhxwmz-5Fu-a6whMpfvlc1daU9k950jEc-j81H9Yjwax2s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6x43wgMkcYcgqkDIH1ZdwftcHpx8De6g6a9bLAarEKw&oe=6AFEFE28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PortadaSafeHub.png", "id": "1624832262322993", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499620655_1624832265656326_6625754155521474567_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-C-rRlA3NUQ7kNvwE0dZgm&_nc_oc=AdqZFlaerfqTevZGZ95pgXpYpUTD-OUeJQc37g4OB7I-PbYs3hf5uCTqDSU4rIlcrrg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyLxoC6ChKQD35sH2mmxXOXXzptT3wsgiE9SckO9yqkA&oe=6AFF01A6"}, "display_name": "SafeHub", "keywords": [], "long_description": "SAFE HUB is an immersive, multi-user training platform for Meta Quest headsets that enables companies to train, simulate, and evaluate their workforce in interactive virtual environments in a scalable and collaborative way.\n\nDesigned for organizations that need to train large numbers of workers, SAFE HUB combines virtual reality, multi-user interaction, instructor tools, and performance metrics, transforming practical training into a measurable and replicable experience.\n\nKey Features:\n\nMulti-User Environments: Public or private rooms with multiple participants and real-time interaction.\n\nTraining and Simulation: Virtual scenarios for practical, collaborative, or individual training.\n\nEvaluation and Metrics: Recording and analysis of each participant's performance, actions, and interaction.\n\nReal-Time Communication: Voice and interactive tools for a collaborative experience.\n\nInstructor Management: Control, supervision, and management of training sessions.\n\nScalability: Ability to implement and replicate training experiences for multiple groups and locations.", "short_description": "SAFE HUB is an immersive, multi-user training platform for Meta Quest headsets that enables companies to train, simulate, and evaluate their workforce in interactive virtual environments in a scalable and collaborative way.\n\nSAFE HUB es una plataforma de capacitaci\u00f3n inmersiva y multiusuario para visores Meta Quest, que permite a las empresas entrenar, simular y evaluar a sus trabajadores en entornos virtuales interactivos, de forma escalable y colaborativa."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalexperience.cl/pdf/Politicas_De_Privacidad_SAFE_HUB.pdf", "developer_terms_of_service_url": null, "publisher_name": "DE SPA", "support_website_url": null, "website_url": "https://digitalexperience.cl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_CL", "es_AR", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1650328899794125"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": 
c_ss=7f20f&oh=00_AQMSvjz7nwi7j50yQpd3IzOg8cEdSjyMntxfcttbwTGgig&oe=6AD3A4E4"}, {"file_name": "4.png", "id": "2886365981745348", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/595129854_2886365985078681_515634587893089030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQ_-SnL2dhoQ7kNvwGtVr4P&_nc_oc=AdoEh-Ykov79lI3SaPTCOhfKxXtl9V0OuBdqeMsTJmL574KC1pWYDiUPPcHyJ8cN2KY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbtFl6vdXpOvmAdwT8v65w9POLHktGxqenC90dOBpO7Q&oe=6AD3866D"}, {"file_name": "5.png", "id": "1647761096978189", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830822_1647761100311522_6260556203980485302_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVjfVyAID-AQ7kNvwFKdXZW&_nc_oc=AdqfKRgZv0m5ED3JMJLjpbsrwm-LIhqN_z3KDxSZAa002nYpZ3-egVVfi_qnXCSonQI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUBCuuWNLM7E0Ijgkd_FnZmUfcMhjyTmCoPZ0efBErNg&oe=6AD3B4E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PortadaSafeHub.png", "id": "1624832262322993", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620655_1624832265656326_6625754155521474567_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfq_8Q608L4Q7kNvwHQQ9En&_nc_oc=AdqK_0k70hKk8maAfrkBuLoAaGBYGdPIpMSTgEUafswgk21FMR_rJO5i2whKu618XsA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQvzOZs0MU0C0DTFeM3DxnF17V4jtCHgGvJ_UCKtJwgQ&oe=6AD3B866"}, "display_name": "SafeHub", "keywords": [], "long_description": "SAFE HUB is an immersive, multi-user training platform for Meta Quest headsets that enables companies to train, simulate, and evaluate their workforce in interactive virtual environments in a scalable and collaborative way.\n\nDesigned for organizations that need to train large numbers of workers, SAFE HUB combines virtual reality, multi-user interaction, instructor tools, and performance metrics, transforming practical training into a measurable and replicable experience.\n\nKey Features:\n\nMulti-User Environments: Public or private rooms with multiple participants and real-time interaction.\n\nTraining and Simulation: Virtual scenarios for practical, collaborative, or individual training.\n\nEvaluation and Metrics: Recording and analysis of each participant's performance, actions, and interaction.\n\nReal-Time Communication: Voice and interactive tools for a collaborative experience.\n\nInstructor Management: Control, supervision, and management of training sessions.\n\nScalability: Ability to implement and replicate training experiences for multiple groups and locations.", "short_description": "SAFE HUB is an immersive, multi-user training platform for Meta Quest headsets that enables companies to train, simulate, and evaluate their workforce in interactive virtual environments in a scalable and collaborative way.\n\nSAFE HUB es una plataforma de capacitaci\u00f3n inmersiva y multiusuario para visores Meta Quest, que permite a las empresas entrenar, simular y evaluar a sus trabajadores en entornos virtuales interactivos, de forma escalable y colaborativa."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalexperience.cl/pdf/Politicas_De_Privacidad_SAFE_HUB.pdf", "developer_terms_of_service_url": null, "publisher_name": "DE SPA", "support_website_url": null, "website_url": "https://digitalexperience.cl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_CL", "es_AR", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE"], "supported_input_devices": ["OCULUS_
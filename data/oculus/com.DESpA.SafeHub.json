109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGnTZczoEXMQ7kNvwFKmqwF&_nc_oc=AdrRgQ-BKCvVQCkb6TYhsQhDmbF5y_c2dfAQevAB-ngN2lc1i9NMp9zbfNsUzGbfX_0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIJPA0mAre8uWOkTWooAH35dJTAPj8vSGUjYTcomAQuQ&oe=6AFC8364"}, {"file_name": "4.png", "id": "2886365981745348", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595129854_2886365985078681_515634587893089030_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bka94asdcVsQ7kNvwGoCr49&_nc_oc=AdqkFJfNRlefUu7be2aq6BKRx0Ve9daj6796KgMYT2VvU39JgcizIgVLBPnr4NJoyMo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAI8IZinh0jnAeHtOv1ofc6HCyVkynESbO3zmFpbyBtg&oe=6AFC64ED"}, {"file_name": "5.png", "id": "1647761096978189", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830822_1647761100311522_6260556203980485302_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWRL-zOMzj4Q7kNvwFA_bdq&_nc_oc=Ados9CS_Zpc0FrfjUFNNHUaBPcKCRowO3IGuyW9tIETCEyK45E67cWFaTrLFug35sjM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQW8nftgqT_rzEyfhAarI6zPd0nRPnAIVInpblenfIR7A&oe=6AFC9368"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PortadaSafeHub.png", "id": "1624832262322993", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499620655_1624832265656326_6625754155521474567_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qWTpk8cupYQ7kNvwF-hW46&_nc_oc=Adq6OHT60-u8WNuGApixyZmg_WkL_x8Pa8ObYOZyoTkZ_6oI-R9ULyCh_Fz7-UmwTfw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiX9dkp0MAp6M73dY3hu288YzzSN2YHd3zwZZ7-wBf1g&oe=6AFC5EA6"}, "display_name": "SafeHub", "keywords": [], "long_description": "SAFE HUB is an immersive, multi-user training platform for Meta Quest headsets that enables companies to train, simulate, and evaluate their workforce in interactive virtual environments in a scalable and collaborative way.\n\nDesigned for organizations that need to train large numbers of workers, SAFE HUB combines virtual reality, multi-user interaction, instructor tools, and performance metrics, transforming practical training into a measurable and replicable experience.\n\nKey Features:\n\nMulti-User Environments: Public or private rooms with multiple participants and real-time interaction.\n\nTraining and Simulation: Virtual scenarios for practical, collaborative, or individual training.\n\nEvaluation and Metrics: Recording and analysis of each participant's performance, actions, and interaction.\n\nReal-Time Communication: Voice and interactive tools for a collaborative experience.\n\nInstructor Management: Control, supervision, and management of training sessions.\n\nScalability: Ability to implement and replicate training experiences for multiple groups and locations.", "short_description": "SAFE HUB is an immersive, multi-user training platform for Meta Quest headsets that enables companies to train, simulate, and evaluate their workforce in interactive virtual environments in a scalable and collaborative way.\n\nSAFE HUB es una plataforma de capacitaci\u00f3n inmersiva y multiusuario para visores Meta Quest, que permite a las empresas entrenar, simular y evaluar a sus trabajadores en entornos virtuales interactivos, de forma escalable y colaborativa."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalexperience.cl/pdf/Politicas_De_Privacidad_SAFE_HUB.pdf", "developer_terms_of_service_url": null, "publisher_name": "DE SPA", "support_website_url": null, "website_url": "https://digitalexperience.cl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet
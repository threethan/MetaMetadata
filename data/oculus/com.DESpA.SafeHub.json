c_ss=7f20f&oh=00_AQQiiK-ijZDJo3UY2WROwgWkphGHLhRBtDUEFsT5ztTlnQ&oe=6AE76B64"}, {"file_name": "4.png", "id": "2886365981745348", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/595129854_2886365985078681_515634587893089030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-84y6ZdbeAQ7kNvwEgxPkW&_nc_oc=AdqXXmHdbUcK2pmVqMWKwBecvmIM2ck3I4iI4Fg4liGq9goKXROvVHL03sWAypSmP1Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZmlJtMx6o2AK4gel9NfIiD6RiO4cvHsHDUxe5GzUKKw&oe=6AE74CED"}, {"file_name": "5.png", "id": "1647761096978189", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830822_1647761100311522_6260556203980485302_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvqoYETka0sQ7kNvwFP_qHL&_nc_oc=AdqAb-isM7vfBJUO3YIFn0i9D3oV0vm3s3TyRSxAqzNDkJ-1LaYYI4ap2WTmiR0XEY4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5ZcPY9IuyFrSdFG2HQBMktexerh2wh4hw0BCMg-iR5A&oe=6AE74328"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PortadaSafeHub.png", "id": "1624832262322993", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620655_1624832265656326_6625754155521474567_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbO4j0tfurAQ7kNvwHADSHE&_nc_oc=Adq-8QsNuTWqJUClx0B0K0p0GOZMOIUaC-L3wz087dcJCG8rbQy8lTu1kbAytTg0chQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-4qd11byfsNxLk1tsKHpPXLN8CgNVqnHf3CINwb4Idg&oe=6AE746A6"}, "display_name": "SafeHub", "keywords": [], "long_description": "SAFE HUB is an immersive, multi-user training platform for Meta Quest headsets that enables companies to train, simulate, and evaluate their workforce in interactive virtual environments in a scalable and collaborative way.\n\nDesigned for organizations that need to train large numbers of workers, SAFE HUB combines virtual reality, multi-user interaction, instructor tools, and performance metrics, transforming practical training into a measurable and replicable experience.\n\nKey Features:\n\nMulti-User Environments: Public or private rooms with multiple participants and real-time interaction.\n\nTraining and Simulation: Virtual scenarios for practical, collaborative, or individual training.\n\nEvaluation and Metrics: Recording and analysis of each participant's performance, actions, and interaction.\n\nReal-Time Communication: Voice and interactive tools for a collaborative experience.\n\nInstructor Management: Control, supervision, and management of training sessions.\n\nScalability: Ability to implement and replicate training experiences for multiple groups and locations.", "short_description": "SAFE HUB is an immersive, multi-user training platform for Meta Quest headsets that enables companies to train, simulate, and evaluate their workforce in interactive virtual environments in a scalable and collaborative way.\n\nSAFE HUB es una plataforma de capacitaci\u00f3n inmersiva y multiusuario para visores Meta Quest, que permite a las empresas entrenar, simular y evaluar a sus trabajadores en entornos virtuales interactivos, de forma escalable y colaborativa."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalexperience.cl/pdf/Politicas_De_Privacidad_SAFE_HUB.pdf", "developer_terms_of_service_url": null, "publisher_name": "DE SPA", "support_website_url": null, "website_url": "https://digitalexperience.cl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_CL", "es_AR", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE"], "supported_input_devices": ["OCULUS_
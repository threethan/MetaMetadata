nshots": [{"file_name": "1.png", "id": "1953036315416620", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312422_1953036318749953_3709872496924215697_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZ387akdbQ8Q7kNvwEa-YSt&_nc_oc=AdqjIiF9zN-Pl9pxCpaWDqF4zU9p2XzjYtGMkAkF6Dwa8Q8Sdsu31TJsc8wHpFVj9Bw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJneL_ROY-IjOjb2uYpisKNCjYeLbJYUK-ue9OzifznyA&oe=6ABBDF08"}, {"file_name": "2.png", "id": "1321180659991265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312422_1321180663324598_2587202759284993507_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TB3K0UQc_s4Q7kNvwFUDbhw&_nc_oc=AdqYq82MyjbfZUbZFXsNh410_5WA_LSWca-BdRrKDD6qIw9fxx8KduoB7ZYI6_3Ej_8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIb8dry5Do5QPj43h86mZCx1fnlrFKTpcPivLC87c37EA&oe=6ABBD55C"}, {"file_name": "3.png", "id": "1578268030396797", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499311582_1578268033730130_2315727075818237565_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2akn_eUOY0AQ7kNvwGgoPIR&_nc_oc=Ado-z5wcRTzMsp5vP9F4M7sUvZaJQaD4y90xqCPq7qZJ9KiXXd4ds9NFtujCPKrwxtY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIonJMxJYTbgL77tiKMLBZBJSVhyZ2KgNWcAZFIwgL-6A&oe=6ABBC278"}, {"file_name": "4.png", "id": "1333520008208824", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507818746_1333520014875490_8688557830043760086_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDqf4CL_jjIQ7kNvwFmICq9&_nc_oc=AdrOtk6Jny7XZ2n8S2qgnWQO5R4kr3gUfHQVrkXdsAxjKB1pIz9-gZsWJs3UQh30sXE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVky7wHopdE4KtPKkTrQ5RCP9U-bkdY7xhRct66wAK1w&oe=6ABBB331"}, {"file_name": "5.png", "id": "1637751310635435", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308050_1637751313968768_2154530882938303172_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKjltFTcbX0Q7kNvwEnQgl2&_nc_oc=Adrb5nT-wBC4Z3-qN5VVsc31Zd4h8Rqz5O3GiiJBDmx2FHv85RphY7En1OxA6WecBkI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJR0QVDVItFGkdN4tzrjVdE__ugzy9gg52qH_uXy8lggg&oe=6ABBB402"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Truck Simulator: Truck Driving & Parking", "keywords": ["Truck", "Driving", "Parking", "Simulator", "Cargo"], "long_description": "Welcome to the ultimate open-world driving experience in **Truck Simulator - Truck Driving & Parking**! Take the wheel of meticulously detailed heavy-duty semi-trucks and conquer a stunning world filled with winding coastal highways, dramatic mountain passes, and busy industrial ports. Every route tests your precision driving skills across diverse landscapes, from majestic lakeside roads into brilliant golden sunsets.\n\nManage authentic cargo and complete demanding missions. As your operations grow, you will unlock advanced fleets, navigate complex delivery routes, and master unpredictable weather conditions that test your handling to the limit.\n\n**Key Features:**\n\n* **Massive Open World:** Drive through breathtaking mountains, scenic fjords, and vibrant logistics hubs.\n* **Realistic Physics:** Experience authentic handling and highly detailed truck cabins.\n* **Heavy Cargo Missions:** Haul specialized loads safely across miles of open highway.\n* **Precision Parking:** Test your skills with challenging parking zones in tight terminal spaces.\n* **Dynamic Settings:** Navigate a full day-night cycle with immersive weather shifts.\n\nHit the gas, explore the endless horizon, and build your legacy as the king of the road!", "short_description": "Get ready for the ultimate open-world driving experience in Truck Simulator - Truck Driving & Parking. Take the wheel of massive, highly detailed trucks and navigate breath-taking wilderness highways, winding coastal roads, and challenging mountain passes. From bustling industrial ports to serene lakeside terminals, manage your routes, haul heavy cargo safely, and conquer realistic terrain under dynamic skies. Your trucking empire starts here."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nanohorizon/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nano Horizons", "support_website_url": null, "website_url": "https://sites.google.com/view/nanohorizon/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1199323356596762"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1338810105981419", "version": "12.0.1"}, "id": "2173929969869489", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1199323353263429", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1338810105981419"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2173929969869489"}]}, "change_log": null, "created_date": 1789557112, "id": "1338810105981419", "version": "12.0.1", "version_code": 12, "release_status": "RELEASED", "status": "APPROVED"
g7U_rTU8KOIMHQKcFitznY-QStPM2H8ZmmBXdNc4DUZbvx2-d6gZLp8Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ25rwauYtp_uLdNsXFrxiV0asmaBeb1IcN_va4PL92HQ&oe=6B0703C7"}, {"file_name": "Screenshot_5.png", "id": "582746454447456", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617727_582746457780789_8313195493088910839_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVoGtMU-u0gQ7kNvwGJsdNn&_nc_oc=Adp2MVBHieAu6R9_QYCTtFOtjAtkLc1Vh0B8L7iAPsV3l2hx7sXWRyz0eJgmV0bPcQA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJjXOzKNqHO0YRZiEBoEOOVI9QDjEYJaZ6RUe1R5u_bQ&oe=6B071EE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spider Climbers", "keywords": [], "long_description": "Spider Climbers is a high-energy VR platformer that puts your reflexes, agility, and creativity to the test. Inspired by the movement mechanics of Gorilla Tag, this game lets you experience the freedom of motion through hand-based locomotion\u2014no joysticks, just pure physical climbing, swinging, and leaping.\n\nHarness your inner spider as you navigate vertical walls, sprawling obstacles, and gravity-defying platforms. Whether you're scaling towering structures or racing against other players in multiplayer modes, every movement counts. Master your momentum, plan your route, and push your limits as you climb faster and higher than ever before.\n\nWith stylized environments, competitive time trials, and skill-based gameplay, Spider Climbers is built for players who love movement-based VR and want a workout wrapped in adrenaline. It\u2019s not just a game\u2014it\u2019s a full-body challenge.\n\n", "short_description": "Spider Climbers is a fast-paced VR climbing game that uses gorilla tag-style locomotion to let players swing, climb, and leap like a spider across dynamic environments. Use your hands to scale walls, dodge obstacles, and challenge friends in a thrilling test of agility and speed.\n\n"}
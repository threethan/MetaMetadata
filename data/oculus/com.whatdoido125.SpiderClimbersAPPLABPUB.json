FFE47"}]}, "id": "1116222860316116", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_1.png", "id": "1224881262410893", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619590_1224881265744226_1760895310228998459_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-P3qHo48MAQ7kNvwGqaSyg&_nc_oc=Adkotfg2Z-BoGsN6ODaHRcONkBdCpYiihXf4GUi4zy4kMgS_DjxzYKsPBg0SJFTJCig&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9_SQMs9joGWbYO51UCtXAuuocCDKkI0aXCjWdHtuzRw&oe=69B01F9F"}, {"file_name": "Screenshot_3.png", "id": "1200159684745228", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499302651_1200159688078561_4426483643127155110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ldo802ukb4YQ7kNvwH2IJI3&_nc_oc=AdnCNo9Ui0GZMZVSmYSgtuHvB_qIkAiZMWLPxukC7CegRcic_Y9-8gbSrPT-LxYCJlY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyu1SHAHTFJE-cnLeEFLY309diwJeQ0FML4ezVFtb7plw&oe=69B01794"}, {"file_name": "Screenshot_2.png", "id": "1442785773420205", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499309600_1442785776753538_7071658833025199443_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4iJqPDlGkjEQ7kNvwGvSSKe&_nc_oc=AdmLVV7GvCAwfgKrO5EEg4X7_KH95-_3SxfCEUVJuUrmyQm7bWjs7_hhHO7AXkIkHZk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxavweWizajohHraHnUTRDePbO-kDElPRNSVPlF-XOcXQ&oe=69AFF3C8"}, {"file_name": "Screenshot_4.png", "id": "2158156827963614", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620516_2158156831296947_6231789611153799330_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znNDblCFdjIQ7kNvwGAVlu1&_nc_oc=AdlgN6hOO-7TTCdxjUUHS-29HDIPrFgv5zA_p6kFC20CGv9zDIYdjPOHbw3H2_nyg6U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzrstX4xIYErnUD8QkwFYKa2xYoVlc0hMVGVD4cnE-sow&oe=69B00587"}, {"file_name": "Screenshot_5.png", "id": "582746454447456", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617727_582746457780789_8313195493088910839_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvI9j5gnSQYQ7kNvwFtMwnd&_nc_oc=AdkSPOq9p8K4HCOfniE1FGaiHUD9epnElr5no2LKHJ_AqlXNSgO_7q5OKfev-P_lvhk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9hB27mSqCltJskgszL-Z7cFuElXKsjJJFj9ktzYny5A&oe=69B020A5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spider Climbers", "keywords": [], "long_description": "Spider Climbers is a high-energy VR platformer that puts your reflexes, agility, and creativity to the test. Inspired by the movement mechanics of Gorilla Tag, this game lets you experience the freedom of motion through hand-based locomotion\u2014no joysticks, just pure physical climbing, swinging, and leaping.\n\nHarness your inner spider as you navigate vertical walls, sprawling obstacles, and gravity-defying platforms. Whether you're scaling towering structures or racing against other players in multiplayer modes, every movement counts. Master your momentum, plan your route, and push your limits as you climb faster and higher than ever before.\n\nWith stylized environments, competitive time trials, and skill-based gameplay, Spider Climbers is built for players who love movement-based VR and want a workout wrapped in adrenaline. It\u2019s not just a game\u2014it\u2019s a full-body challenge.\n\n", "short_description": "Spider Climbers is a fast-paced VR climbing game that uses gorilla tag-style locomotion to let players swing, climb, and leap like a spider across dynamic environments. Use your hands to scale walls, dodge obstacles, and challenge friends in a thrilling test of agility and speed.\n\n"}]}, "developer_name": "WhatDoIDo", "developer_privacy_policy_url": "https://sites.google.com/view/spider-climbers/home", "developer_terms_of_service_url": null, "publisher_name": "BIGBOITHEBIGGEST", "support_website_url": null, "website_url": "https://sites.google.com/view/spiderclimbersweb/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_ca
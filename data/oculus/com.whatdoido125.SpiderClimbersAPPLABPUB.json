938C7"}]}, "id": "1116222860316116", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_1.png", "id": "1224881262410893", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619590_1224881265744226_1760895310228998459_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIOz5sz2oXAQ7kNvwFjtyIb&_nc_oc=AdmmlSDMJI_9mVmXYrYzEYxLGIDXw9nB11Dulq1cklimNQVE45Ql1l4nxFfKhFLZBas&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxl-XHRypZ2Qh-Lp7OygpFPmnuY34x-qi6QnT9ItJ0Y2g&oe=69B95A1F"}, {"file_name": "Screenshot_3.png", "id": "1200159684745228", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499302651_1200159688078561_4426483643127155110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_IXFLJtIAQQ7kNvwH--tLk&_nc_oc=Adkav4XxE-n4DdWExrbUS5TcsQj408UEToG-I7__f2jIPXWAzDZADEayUJTVgF5T1QE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwQ4oSZ4sZJrZLWBljz9gBFs9sTZytNL8J1tbmQdOu0cA&oe=69B95214"}, {"file_name": "Screenshot_2.png", "id": "1442785773420205", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499309600_1442785776753538_7071658833025199443_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9TPGgDKh3SAQ7kNvwFlx0W2&_nc_oc=AdkdtYjchbcAQyI_HYHeyqWsFG3TpZvEjFiYotVKJ4uX5JLcXTzFem6nmmDvNuCQvRY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwSpKnuPs38LCClvxi9-VThWnGLKeFToJONjRdl5rSaxA&oe=69B96688"}, {"file_name": "Screenshot_4.png", "id": "2158156827963614", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620516_2158156831296947_6231789611153799330_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80IWIVh_sfYQ7kNvwEeCU74&_nc_oc=Adk2j6hdub4MqqlQZxHumyt07vHvskb_t1v7ijPHFvApZnullq3R8StosAX0FdYukHs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx82PL0yhqMKSf_EyQXe-Zt_mfTZpWUau-R_WYStRpLLQ&oe=69B94007"}, {"file_name": "Screenshot_5.png", "id": "582746454447456", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499617727_582746457780789_8313195493088910839_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPIn2a4OWqQQ7kNvwFO-xxM&_nc_oc=Adnt0TZ075NKlRWbUACVujs8I5JkB4rp37ejbBe4g2GMKkpRlIJDlySILPTSKRuivyQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxF3Y0-fzbuonOrt1QABo8pQ7hxF4IgWMAD6d1-obqJ3A&oe=69B95B25"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spider Climbers", "keywords": [], "long_description": "Spider Climbers is a high-energy VR platformer that puts your reflexes, agility, and creativity to the test. Inspired by the movement mechanics of Gorilla Tag, this game lets you experience the freedom of motion through hand-based locomotion\u2014no joysticks, just pure physical climbing, swinging, and leaping.\n\nHarness your inner spider as you navigate vertical walls, sprawling obstacles, and gravity-defying platforms. Whether you're scaling towering structures or racing against other players in multiplayer modes, every movement counts. Master your momentum, plan your route, and push your limits as you climb faster and higher than ever before.\n\nWith stylized environments, competitive time trials, and skill-based gameplay, Spider Climbers is built for players who love movement-based VR and want a workout wrapped in adrenaline. It\u2019s not just a game\u2014it\u2019s a full-body challenge.\n\n", "short_description": "Spider Climbers is a fast-paced VR climbing game that uses gorilla tag-style locomotion to let players swing, climb, and leap like a spider across dynamic environments. Use your hands to scale walls, dodge obstacles, and challenge friends in a thrilling test of agility and speed.\n\n"}]}, "developer_name": "WhatDoIDo", "developer_privacy_policy_url": "https://sites.google.com/view/spider-climbers/home", "developer_terms_of_service_url": null, "publisher_name": "BIGBOITHEBIGGEST", "support_website_url": null, "website_url": "https://sites.google.com/view/spiderclimbersweb/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_ca
ile_name": "cover-landscape.png", "id": "1450344943877701", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908771274_1450344953877700_5852134139820079489_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrvwO9ZKZl8Q7kNvwHQYEKu&_nc_oc=AdrGFJATrRMGbFrOE-_nf-_30nv_GG6xo42TEqbG17Odn3pIszYfi0mXeJcfZFuMtdc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQdHcRQLim02nl-M4N_usk-aTWOWKJzrq0NVnpOva1G-A&oe=6B0C5CED"}, "display_name": "Castle Guardian", "keywords": [], "long_description": "A court mage fled the goblin warlord through a portal and landed in your room, bringing his castle and his king with him. Place the castle on a table or the floor and defend it as goblin armies pour out of portals and climb your furniture to reach its walls.\n\nA ROGUELIKE IN THREE ACTS\nChoose your route through doors, collect spell crystals and build towers between fights. Each act ends with a mini-boss and a boss. Lose the castle and the run is over, but the essence you earned buys permanent upgrades in the mage's lab for the next run.\n\nNINE BOSSES\nSkrix the goblin mage teleports around your room. Zazz Stormhopper flies under your ceiling and drops goblins on umbrellas. Ghor the thunder warrior calls a storm across the whole room. Captain Krunk rolls a siege tower at your walls, and Morgrok the Mighty charges in on his war-boar. Each act brings one of two mini-bosses, so runs play out differently.\n\nSPELLS IN YOUR HANDS\nThrow fireballs, point to fire finger lightning, sweep a flame trail across the floor, spray freezing mist from an open palm, bounce a water stream off your furniture and open gravity portals that drop goblins from above. Carry up to four spells and switch between them with a swipe of your thumb. Play with tracked hands or controllers.\n\nYOUR ROOM IS THE BATTLEFIELD\nNo room scan needed: the game measures your room while you play. Goblins walk around your furniture and climb onto tables, and real objects and your hands hide what is behind them. Play seated on you", "short_description": "Defend a miniature castle in your real room. Throw spells with your hands, build towers and fight through three acts and nine bosses in a mixed-reality roguelike you can play from your couch or at a table."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kwrona.com/quest-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Krzysztof Wrona", "support_website_url": null, "website_url": "https://kwrona.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1795999371433079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2379387959469565"}]}, "baseline_offer": {"id": "2379387959469565"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795194060, "status": "PUBLISHED", "id": "2379387959469565"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1835506557482360", "version": "1.0.9"}, "id": "1653932723027287", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1795999361433080", "is_concept": false, "latest_released_binary": 
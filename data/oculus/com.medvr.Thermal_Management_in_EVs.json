dn.com/v/t64.5771-25/499620940_1680607516587771_8290346885323249347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbDAKsgDkzoQ7kNvwHm0AEd&_nc_oc=Adp6ts92WV9sM2NICRXXAVy6x5xPzBPbxuGcycNV99qnGkLfjc3RDRNqs866iCOsKNU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DY3xsFdOsXx2PY-qoQ2TnzUYTMlgdWTpKpDNGhFiOBg&oe=6A2C1C10"}, {"file_name": "HighresScreenshot00002.png", "id": "2121400022012304", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499620444_2121400025345637_1540089379958278543_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwHy4tEP1GoQ7kNvwFqgCTH&_nc_oc=AdqLDwb5l9Y2ldxE54jHtoG3czoY5AVz-30YqBINxBgPsbFgHZPksfD9KUq44fHxJsQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eO7gVSzXEN4zACaVMT5kwKZo3KSd_5H6xejGoAHaFvg&oe=6A2C18BA"}, {"file_name": "HighresScreenshot00000.png", "id": "984630874555788", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/618742884_984630877889121_3776622047128409171_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J64rkZCbP1cQ7kNvwFVZUzq&_nc_oc=Adp6UL_-evkQoqR8gbz0YCRBVbzkGEbsJ0ajuSR3GkLwwSLamP9JLvdbz_bENlyk9_o&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EUz3CzXDP0cD8GWU3zgoy2ToPwN4oG9HBoBCq7gm1ig&oe=6A2C0724"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Thermal Management in EVs", "keywords": [], "long_description": "Thermal Management in EVs is an immersive VR training application designed exclusively for learners enrolled in the Immersive Learn Thermal Management in EVs micro-credential program. The application provides interactive, hands-on training focused on electric vehicle thermal management systems, including battery cooling, heat transfer principles, thermal system components, safety procedures, inspection techniques, diagnostics, and troubleshooting workflows.\n\nThrough realistic virtual simulations, learners can develop practical skills in identifying thermal management components, performing operational checks, following safety standards, and responding to common EV thermal system scenarios in a safe and controlled environment.\n\nThis application is intended solely for educational and workforce training purposes. Access is restricted to individuals officially enrolled in the Immersive Learn Thermal Management in EVs micro-credential program.", "short_description": "Thermal Management in EVs is a VR training application developed as part of the Immersive Learn Thermal Management in EVs micro-credential program. This hands-on training experience allows enrolled learners to practice EV thermal management procedures, system inspection, safety protocols, and troubleshooting in an immersive virtual environment. Access to this application is limited to learners officially enrolled in the program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1591218026338336"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823949_1012126081268540_5855836312143548229_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7v1Trw4gwxYQ7kNvwGXhGcT&_nc_oc=Adr2UNtHKeH6j
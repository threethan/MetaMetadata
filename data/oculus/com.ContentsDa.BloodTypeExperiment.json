0816_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZeM3QBpNwkQ7kNvwGcW0TP&_nc_oc=AdninxrcM_ftBEFxaQC4tTW7Od0rgVqYxeIr3JIko5yU48vBUkYR0sBqFFVCMh3md7E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftqiNlIgzGB9ht9_at8FhuHF9N-a4lSoyIJj-gXVyhEhw&oe=69A80C5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Blood Type Experiment_Landscape.png", "id": "906787984176677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75326675_906787987510010_326496218891015452_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQr3R0hqymAQ7kNvwFKE5hz&_nc_oc=AdlB9SlXYmFt0Dyi5auPtn4j1v4C5WHUsZisuJXXVkwTsApaYRt40ZFb-Oq4qQgg8jA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsmHHlIugrqaAw3YtPso1a9Go-FQ_RIfh_4m_d4ADWNvg&oe=69A83923"}, "display_name": "Blood Type Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "life", "blood", "science", "contentsda"], "long_description": "1. prepare blood types A, B, O, and AB\n2. drop each blood onto the appropriate reaction plate (two digits)\n3. drop anti-A serum on the left side of each reaction plate\n4. drop anti-B serum on the right side of each reaction plate\n5. mix the blood and serum with a toothpick (do not reuse the toothpick)\n6. look at the blood group agglutination reaction under the microscope", "short_description": "Delve into the basics of human genetics with this blood type experiment. Learn about different blood groups and the importance of blood typing in medicine."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "5140
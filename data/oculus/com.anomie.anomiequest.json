357237150502758", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031547_357237153836091_2275512574788066045_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ug9TKr5uA-oQ7kNvwFc2Dnd&_nc_oc=AdrE2Wvky89ERMQ-LGTv2lp_ezvI4MLdKmzqyPGEvcF4dxZ5HGjA1kbb4rwgOanP4Cc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgFVaam0nEhD8cReY7q_p3K00rfHn37XRGMrOaFzz-_w&oe=6AC7C2C2"}, "display_name": "Anomie", "keywords": [], "long_description": "Anomie is a state-of-the-art virtual reality art tool designed for well-being practitioners. With the aim of improving communication and nurturing positive narratives in clients' lives, this innovative platform offers therapeutic possibilities. Elevate your practice with Anomie, where technology and artistic expression converge for transformative experiences and lasting well-being.\nCurrently in Beta stage", "short_description": "Anomie is a state-of-the-art virtual reality art tool designed for well-being practitioners. With the aim of improving communication and nurturing positive narratives in clients' lives, this innovative platform offers therapeutic possibilities. Elevate your practice with Anomie, where technology and artistic expression converge for transformative experiences and lasting well-being.\nCurrently in Beta stage."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/15l02KAQDbEl-fsbyF69ut_pIwbHDswZh5da-gy8DWS0/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1M5Tg_Dl9Eli1_R4gBFUXw-T447J8_RMEI_bbGjZiimc/edit?usp=sharing", "publisher_name": "AnomieXR", "support_website_url": "https://www.anomie.io/", "website_url": "https://www.anomie.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "interne
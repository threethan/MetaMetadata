357237150502758", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031547_357237153836091_2275512574788066045_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n29iNJKGZEcQ7kNvwFVSbjr&_nc_oc=AdrHzrzHBQW8CVRO_PzQ8YKemvlFX0HwWaqfHrauXIryQrfHGyiK0zvEkrqw0Uj-LoA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoVaxRUu_CPsRZwYt6n0BpbCcg0sDmcrzlNDIkmP6yCQ&oe=6ADDF402"}, "display_name": "Anomie", "keywords": [], "long_description": "Anomie is a state-of-the-art virtual reality art tool designed for well-being practitioners. With the aim of improving communication and nurturing positive narratives in clients' lives, this innovative platform offers therapeutic possibilities. Elevate your practice with Anomie, where technology and artistic expression converge for transformative experiences and lasting well-being.\nCurrently in Beta stage", "short_description": "Anomie is a state-of-the-art virtual reality art tool designed for well-being practitioners. With the aim of improving communication and nurturing positive narratives in clients' lives, this innovative platform offers therapeutic possibilities. Elevate your practice with Anomie, where technology and artistic expression converge for transformative experiences and lasting well-being.\nCurrently in Beta stage."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/15l02KAQDbEl-fsbyF69ut_pIwbHDswZh5da-gy8DWS0/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1M5Tg_Dl9Eli1_R4gBFUXw-T447J8_RMEI_bbGjZiimc/edit?usp=sharing", "publisher_name": "AnomieXR", "support_website_url": "https://www.anomie.io/", "website_url": "https://www.anomie.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "interne
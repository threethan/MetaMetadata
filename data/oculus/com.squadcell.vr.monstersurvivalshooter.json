uAwc7hfQjJ4UFLoVclQilojg&oe=6AA2A83F"}, {"file_name": "SS_01.png", "id": "720235784359227", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831964_720235791025893_3698180039595555534_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1afULUKU5CMQ7kNvwG0oH45&_nc_oc=Ado-rNcrZq0DBZDaicwYC0BvJYeEYn-TEzmxZBIqo2YvMMg0A9ydW6pAiQ0K2dl1rDM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLW_gvvDAKmfcGc8Pr0d49tHYW6WYDLohpCFKjTpI9SuA&oe=6AA2C6B3"}, {"file_name": "SS_05.png", "id": "1294710565136108", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312263_1294710568469441_7366425015249007529_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqLuOkUVDysQ7kNvwFLGGTA&_nc_oc=Adpb2PTvXANe9NUZe96oUk7bumvkmp1fHKBbcgppPot_SkuIM4mHzHMhd71BqxJYupM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBynBXehQ8CDASrm2o4R22-O8SNzxGX7x5n-3fG3Th9A&oe=6AA2B912"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_04.png", "id": "2092868471245361", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312468_2092868474578694_6570973472484011603_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9d6r18Kg-s4Q7kNvwGtSyD3&_nc_oc=AdrtJHf51a70dFgL-RCBmaSRU4ZiX9Mq5wVCTgsWRATIPZBjj9vPbJt4-DwaZYtl4jo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhhXmfei-cskeWDmiAlk6UgnrV0ZZfb353Iz5BLHgQMA&oe=6AA2AD2B"}, "display_name": "Monster Survival Shooter VR", "keywords": ["Rampage", "Showdown", "Hunter", "shooting", "Horde"], "long_description": "Step into Monster Survival Shooter VR, an intense action-packed experience where your skills will be pushed to the limit. Face off against terrifying enemies like Lycans, Ice Demons, Savage Bears, Trolls, Hellhounds, and other deadly fiends.\n\nArmed with pistols, shotguns, and rifles, you\u2019ll fight through relentless waves of monsters. Stay sharp\u2014creatures can strike from any angle, forcing you to always be on guard.\n\nBut beware\u2014some enemies are far stronger than others. Boss monsters will challenge your skills with epic battles that push you to the limit.\n\nYour survival depends on more than firepower:\nCheckpoints give you temporary access to weapons and health boosts.\nHealth Band on your left arm lets you track your life in real time.\nMaximum kills is your ultimate goal\u2014fight hard, survive longer, and set new records.\n\nFast-paced, intense, and designed for pure action, Monster Survival Shooter VR is built for players who crave non-stop battles and heart-pounding survival challenges.\n\nAre you ready to test your limits against a monstrous invasion?\nEnter the arena. Face the beasts. Survive the rampage.", "short_description": "Survive waves of ruthless monsters in this action-packed VR survival shooter!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://squadcell.com/privacy-monstersurvivalshootingvr", "developer_terms_of_service_url": null, "publisher_name": "Squad Cell", "support_website_url": null, "website_url": "https://squadcell.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31458724140439688"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "2321305831957857"}, {"status": "PUBLISHED", "id": "1033381669456119"}, {"status": "PUBLISHED", "id": "2214635335951915
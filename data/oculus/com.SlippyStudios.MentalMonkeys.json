49fhLRB02YYJN4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAyxTw0YO0OLGVmWDBNKx47uSrrgg-JecsXuEzei7v-g&oe=6A60B4A1"}, {"file_name": "Untitled design (71).png", "id": "1196688584771962", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974579_1196688588105295_1234905984346652308_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Atn9AXVJ6CsQ7kNvwFgbJrq&_nc_oc=AdoOkI9XYahg_7KqxNOevt6ZeyNN3hObrGvW7GGQ5V3cQUdRDLYYgmkmORrYx3SMBIg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDp83JfpV_ddMWdLRPVurO1Vdx3dl5ZO9gsENX0eoD7oQ&oe=6A60C5B9"}, {"file_name": "Untitled design (72).png", "id": "1185489149419105", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75258663_1185489152752438_938117947935555408_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ev8ekjU3S94Q7kNvwGmCh0P&_nc_oc=AdoJbT-fQcF4htJtVTNDt8O_Jn9evayJKEnZg_jxHaPiVWYvWDSuABGITDaZLtY19ME&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDTjkdXDN6tLVSIL66YzDKF5aB4zaLQ_bEqmKanSRZBQ&oe=6A60AF71"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mental Monkeys", "keywords": ["multiplayer", "horror", "scary", "baboon", "apes"], "long_description": "dark, intricate mazes inhabited by terrifying, mutated apes. Each level presents a new labyrinth filled with unsettling twists, dead ends, and lurking dangers. Use your arms to crawl, climb, and maneuver through tight spaces as you search for an escape, all while avoiding the monstrous apes that hunt you down. Customize your character with eerie cosmetics, unlocking new looks as you progress. Join forces with friends in multiplayer mode, where communication is key to survival. Work together to solve puzzles, share strategies, and escape the deadly mazes. Can you survive the endless corridors and unravel the mystery within Mental Monkeys? Or will you become their next victim?", "short_description": "Mental Monkey is a terrifying VR horror game set within a labyrinth of dark, twisted mazes inhabited by horrifying, mutated apes. Navigate through a series of increasingly complex mazes, from eerie industrial settings to shadowy underground tunnels, using intuitive arm movements to climb, push, and escape the lurking danger. Collect cosmetics to customize your character and join friends in multiplayer mode, where you can talk, strategize, and survive together. Each maze is packed with scary AI's"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1_cpVQ1ENY2H_h4t5ZwZm1BK_iHP9EfkwXw_09Ka0iu0/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Snowzy VR", "support_website_url": null, "website_url": "https://matthewcrandon023.wixsite.com/mysite", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8982124141812408"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9751904648167683", "version": "0.32"}, "id": "1114515440378797", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8982124121812410", "is_concept": false, "latest_r
63543_5757929189817827458_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzfKwNq2IEAQ7kNvwHx1X3m&_nc_oc=AdrrvEHa1hSVUnCoXN2I5Revq1H3nWt2yuivl2-6ivqeDV-QbCCM6Ma92ckXpx5KCnM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCew7rzZ1-8UuHZtYpaVp9miYeHNBWyl1J9QDfzJH7ng&oe=6AC2726D"}, {"file_name": "lol.png", "id": "4600860583308058", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75557064_4600860589974724_5180263532833174290_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gG1B2B0V28MQ7kNvwF7mI-k&_nc_oc=AdpYF4c8raXI7doYp3HhgBtosnLk8zpL1CWCNJjm0MNrwwj2DbZNagi185hkT-bajYM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeF4-5HjAlSG6WOHwIZCNgUumZ4HConcH8ixIKUDEm3w&oe=6AC25CB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quick1.png", "id": "1419474685113992", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974766_1419474688447325_3114731281030755920_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iaeYEaq8mSYQ7kNvwEbG9F-&_nc_oc=Ado09JM08XAen69KZFH7JwdcD-aW32nWC40xbQ2AtCw6S_CVS_jORFd0bYt66Xgb7i8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP99ddR1A3KBpUQs2ZvG_h26TplIR0DBASjuypQrVjwvQ&oe=6AC277D2"}, "display_name": "Hauntify Mixed Reality", "keywords": [], "long_description": "Hauntify MR can be played in any type of building including single or multistory!  The player must setup their play space using the game's built in features to enhance their experience. We want to give the player creative freedom to create a horror game and place props around their environment.  Some ghosts can be summoned in player defined spawn points and other ghosts appear in completely random locations around your house.  As you collect more relics, increasing dangerous spirits will be summoned.\n\nHauntify MR features fully dynamic AI that is capable of navigating your house.  The different ghost types with have unique abilities.\n\nBefore playing read the instructions on how to set up your play space. To save your wall setup, exit the app before hitting continue on the first wall spawn menu.  \n\nRegular updates will occur, this game is in early development.\n\nCheck out the Hauntify Setup Tutorial Video. The video link is on SideQuest.\n\nOptimized only for the Quest 2. ", "short_description": "Hauntify MR utilizes passthrough mode to create a horrifying experience unlike any other on the market.  Your headset is a ghost tracking device that will help you identify and expel evil spirits from your entire house. Turn your house into a horror game and experience evil spirits that will hunt you down and find you. Hauntify MR is one of the most stress inducing mixed reality apps on coming to the market, it is not for the faint at heart! Available for the Quest 2!"}]}, "developer_name": "Virtual Go LLC", "developer_privacy_policy_url": "http://virtualgo.mypreview.site/information.html", "developer_terms_of_service_url": "http://virtualgo.mypreview.site/information.html", "publisher_name": "Virtual Go LLC", "support_website_url": null, "website_url": "http://virtualgo.mypreview.site/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "UTILITY", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "674639560240873"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1314487794224516"}, {"status": "PUBLISHED", "id": "2092253268360826"}, {"status": "PUBLISHED", "id": "15629841417805
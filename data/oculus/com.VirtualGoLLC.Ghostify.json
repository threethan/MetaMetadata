4.5771-25/39001694_698317999090619_2395562591904968028_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hmg5T98EkwQ7kNvwGs9O_m&_nc_oc=Adqh2PyYi5KMDFpd3LHA9h0_YgqN2PQxNVN6P4M2FCHWjJy6ST3GAekh5cZwHYTF19g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCQNEaetMb9OWQcNO2XdkKhqMV8DWywPcPBI1gCDIFrw&oe=6AF89B92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hf1.png", "id": "1067682032678748", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593761155_1067682036012081_6284307429177651804_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RV8b3YuFuL4Q7kNvwG7w7Zj&_nc_oc=Adrmrr1Imw-fs8naPCDFWt7C7S-yxS5fh0sN9GNmg2TmpZCbleDhKfcfUpBa3H8Crms&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_8ArFJ1pogRaMPodFo0NIDAf_zZxtaOBt5-hoaQlm8A&oe=6AF8AB69"}, "display_name": "Hauntify", "keywords": ["paranormal", "ghost", "scary", "horror", "jumpscare"], "long_description": "# Survive and Expel Evil Spirits in Your Own Home!\n\nTurn your house into a terrifying horror game where evil spirits will hunt you down. These spirits can navigate your physical environment, making each encounter even more immersive. With up to 14 unique spirits, each possessing different abilities and hunting styles, every experience is a new challenge.\n{1789670392255336}\n\nCheck out Story Mode added to Hauntify where the player can complete a variety of terrifying chapters in both quick play and legacy mode which uses Meta Space Setup/Room Scan.\n{763946093443897}\n\n# Additional New VR Mode\nPlay Hauntify in a virtual house full of terrifying curses!\n{1750804006042514}\n\n# Quick Play Mode 4 Player Co-location Multiplayer (Quest 3/3s and higher)  NEW!\nJump right into the action in seconds and play with up to 4 friends in the same house.  Survive curses or play controlling the monsters to eliminate your friends. Your space automatically maps as you play with new dynamic mode.\n{2905825786470154}\n\n# Important:\nIf you play legacy mode for all headsets, make sure you scan each room using meta scene setup and link the rooms together. Quest 2/pro requires meta manual mapping under space setup on the meta menu.\n\nNote: \n- Quest 1 is not supported. \n- Quest 2 is not capable of spatial scanning and requires manual meta space setup.\n\nDiscord on company website.\n\nFor any setup issues, feedback, or suggestions, please reach out to the creator directly through the Discord link or though SpawnSide @jo78970. https://discord.gg/53d4NQnDE9\n\nPlease consider leaving a review if you enjoyed the game.", "short_description": "Your entire house has become haunted. Survive dangerous spirits as they hunt you down."}]}, "developer_name": "VirtualGo LLC", "developer_privacy_policy_url": "https://www.virtualgoreality.com/information.html", "developer_terms_of_service_url": null, "publisher_name": "VirtualGo LLC", "support_website_url": null, "website_url": "https://www.virtualgoreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "UTILITY", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP", "MULTI_USER"], "id": "28468799329466333"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628454_4540114436206776_5828665258541454308_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7DRBLQIXhMQ7kNvwH-FlGT&_nc_oc=AdrmHqjMzOoFJgCP0r4tu
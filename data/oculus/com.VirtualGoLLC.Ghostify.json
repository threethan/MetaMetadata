4.5771-25/39001694_698317999090619_2395562591904968028_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnfn3AO8yUkQ7kNvwGW7Xc2&_nc_oc=Adq4n77oSTmmCYUd75trqFNfw1lftmqFATpL-WsFM0gHIEePJ2bRjFXrmHXiu0l-Crs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnkry0EKQCV6Pvo0HwqJRNlVRP4W0DZ0aoOWEVXY6ltw&oe=6AC255D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hf1.png", "id": "1067682032678748", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593761155_1067682036012081_6284307429177651804_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VdWFfVBqmJsQ7kNvwFEMNqK&_nc_oc=AdqbhC_iojegiayykX5JJnEQkaZsA0Ay0rfTL01PGf9MqTNWduPFkCFYA4w2fvwNWTw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPz4UlVadjRiCygDdu5bEZo0YyU2Nr3NFWRGDOzG5lPKQ&oe=6AC265A9"}, "display_name": "Hauntify Mixed Reality", "keywords": ["scary", "ghost", "Hauntify", "Haunted", "Haunt"], "long_description": "# Survive and Expel Evil Spirits in Your Own Home!\n\nTurn your house into a terrifying horror game where evil spirits will hunt you down. These spirits can navigate your physical environment, making each encounter even more immersive. With up to 14 unique spirits, each possessing different abilities and hunting styles, every experience is a new challenge.\n{1394769409156469}\n\nCheck out Story Mode added to Hauntify where the player can complete a variety of terrifying chapters.  Story Mode is available only when selecting the Meta Multi-Room Scan option.\n{763946093443897}\n\n# Additional New VR Mode\nPlay Hauntify in a virtual house full of terrifying curses!\n{1750804006042514}\n\n# Important:\nMake sure your doors link properly between scanned rooms, and ensure no doors lead outside of the scanned areas. Large holes in walls can cause the nav mesh to extend outside the game boundaries. Scanning environment correctly will make the experience better for you.\n\nThe nav mesh must be fully contained within your play area with no linkage to the outside.\n\nNote: Quest 1 is not supported.\n\nIf you need help with setup or have feedback, join the Discord community via the link on the company website. This game is being developed, but your support will help it grow and improve.\n\nPlease consider leaving a review if you enjoyed the game. Reviews help motivate the creator to continue supporting the project and adding more content.\n\nFor any setup issues, feedback, or suggestions, please reach out to the creator directly through the Discord link. https://discord.gg/53d4NQnDE9", "short_description": "Hauntify Mixed Reality transforms your real home into a terrifying mixed reality horror game. Using passthrough and multi-room tracking, your headset becomes a paranormal detection device as you uncover supernatural activity, confront evil spirits, and survive deadly curses throughout your physical environment. Explore your home while entities hunt you from room to room. Your house is the map, and nowhere is safe. Hauntify also includes an additional VR mode!"}]}, "developer_name": "VirtualGo LLC", "developer_privacy_policy_url": "https://www.virtualgoreality.com/information.html", "developer_terms_of_service_url": null, "publisher_name": "VirtualGo LLC", "support_website_url": null, "website_url": "https://www.virtualgoreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "UTILITY", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27828340
qRk-9gQbwWu0ER2pn95FcTHGnhhA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFFJQkS1mWlYi8QHEUFnBYUpmmCT1IdtPbXJUb3DcE9A&oe=6A870299"}, {"file_name": "quick1.png", "id": "269024971830210", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982584_269024975163543_5757929189817827458_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHVpKAp06JgQ7kNvwGjmryY&_nc_oc=Adq0X-QCtUGD9Dx_A5BBkVaQYo3_HEQp4zVv87BUcn3CR4u3Gv4h4QBxgFAp7hufoBw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvAzxo64o3t8XGyAXFoywNGl_7lrlvlDHSlZic_XsvhA&oe=6A86E6AD"}, {"file_name": "lol.png", "id": "4600860583308058", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75557064_4600860589974724_5180263532833174290_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9An1El7bS9QQ7kNvwFoPrXx&_nc_oc=AdpeFQLa8cvN72ZZKf22aXtCHxNDCWZS09n7rna1s9dObciaXaU318YPy8pGEjc3_mc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3OlWdlE37TKIIbKY5Lb-BX-kh62WO28rMKbiUiuLIqw&oe=6A86D0F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quick1.png", "id": "1419474685113992", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974766_1419474688447325_3114731281030755920_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DoSi8bw190EQ7kNvwHi-KXk&_nc_oc=Adq5qy3g6ZaDaKJfMzokqLdFEceg0I4sL3HIdeweBV3LY8gpjseLtOLlDkw59jUBvhs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4gb4PPd0SEUa6uUF6trOep-8_-etAYBU6uX0Tetra4A&oe=6A86EC12"}, "display_name": "Hauntify Mixed Reality", "keywords": [], "long_description": "Hauntify MR can be played in any type of building including single or multistory!  The player must setup their play space using the game's built in features to enhance their experience. We want to give the player creative freedom to create a horror game and place props around their environment.  Some ghosts can be summoned in player defined spawn points and other ghosts appear in completely random locations around your house.  As you collect more relics, increasing dangerous spirits will be summoned.\n\nHauntify MR features fully dynamic AI that is capable of navigating your house.  The different ghost types with have unique abilities.\n\nBefore playing read the instructions on how to set up your play space. To save your wall setup, exit the app before hitting continue on the first wall spawn menu.  \n\nRegular updates will occur, this game is in early development.\n\nCheck out the Hauntify Setup Tutorial Video. The video link is on SideQuest.\n\nOptimized only for the Quest 2. ", "short_description": "Hauntify MR utilizes passthrough mode to create a horrifying experience unlike any other on the market.  Your headset is a ghost tracking device that will help you identify and expel evil spirits from your entire house. Turn your house into a horror game and experience evil spirits that will hunt you down and find you. Hauntify MR is one of the most stress inducing mixed reality apps on coming to the market, it is not for the faint at heart! Available for the Quest 2!"}]}, "developer_name": "Virtual Go LLC", "developer_privacy_policy_url": "http://virtualgo.mypreview.site/information.html", "developer_terms_of_service_url": "http://virtualgo.mypreview.site/information.html", "publisher_name": "Virtual Go LLC", "support_website_url": null, "website_url": "http://virtualgo.mypreview.site/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "UTILITY", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "suppo
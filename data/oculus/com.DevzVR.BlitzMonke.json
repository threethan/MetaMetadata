onkey, your body is the controller, and your hands are your sole ticket to survival, dominance, and glory. Every surface is a launchpad, every wall is a vertical runway, and every single second is packed with pure, unadulterated momentum. If you love the thrill of flying through the air using nothing but your own upper body strength, this is the ultimate virtual arena you\u2019ve been waiting for.", "short_description": "Get ready to go wild! \ud83e\udd8d\ud83d\udca5 Blitz Monkey is a high-octane VR game inspired by Gorilla Tag, where momentum is everything. Whether you want to sweat it out in classic Tag, chill and swing around in Casual, or test your spine in a heart-pounding Horror mode, there\u2019s a playground here for every kind of monkey. Grab your virtual hands and start swinging!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/blitzmonkeyinfo/home", "developer_terms_of_service_url": null, "publisher_name": "DevzStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/blitzmonkeyinfo/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1243961492127959"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1712851816715536"}]}, "baseline_offer": {"id": "1712851816715536"}, "is_
.5771-25/499313110_1034404329051531_3718901595534638593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4Hq8zdlKJcQ7kNvwG7qHwl&_nc_oc=Adpjd-Wp8iyUTAPYaYYXWCM8jOVzB44ewLkNPxX_LTLZJqoThqZ7msOqIQPTr8nQOQQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrL7SqkluSb32DCMvbB5m9OF5MszxOh1Z1Bixxh5wI8A&oe=6AB281F5"}, {"file_name": "Main_Custom..._07.07.2026_18-32-26.png", "id": "1349998383897509", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827601_1349998387230842_8362437627489325966_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8zYBZ0p90wQ7kNvwE08AzP&_nc_oc=AdrriwOyEB-M_-2uI1QnIIVfE8u6HPiTchQOT3YeibOyLC0mDiPQeU67kf5PABYhSx4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJY_SoIAAcTHyXses0wW454lb8iBs9FOdv-owf03C9qZA&oe=6AB28DF1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blitz Monkey", "keywords": ["tag", "horror", "casual", "monkeys", "BlitzMonkey"], "long_description": "Are you ready to break away from gravity, push your physical limits, and experience VR movement in its purest, most exhilarating form? Welcome to Blitz Monkey, a high-octane, physics-driven VR playground inspired by the phenomenal locomotion mechanics of Gorilla Tag, but dialed all the way up to eleven.\n\nForget about joysticks. Forget about teleport pads. Forget about buttons. In Blitz Monkey, your body is the controller, and your hands are your sole ticket to survival, dominance, and glory. Every surface is a launchpad, every wall is a vertical runway, and every single second is packed with pure, unadulterated momentum. If you love the thrill of flying through the air using nothing but your own upper body strength, this is the ultimate virtual arena you\u2019ve been waiting for.", "short_description": "Get ready to go wild! \ud83e\udd8d\ud83d\udca5 Blitz Monkey is a high-octane VR game inspired by Gorilla Tag, where momentum is everything. Whether you want to sweat it out in classic Tag, chill and swing around in Casual, or test your spine in a heart-pounding Horror mode, there\u2019s a playground here for every kind of monkey. Grab your virtual hands and start swinging!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/blitzmonkeyinfo/home", "developer_terms_of_service_url": null, "publisher_name": "DevzStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/blitzmonkeyinfo/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1243961492127959"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499314648_1494495088670378_4206684211586813903_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3EwgGJ0IBDEQ7kNvwE0CB-n&_nc_oc=AdqmDAx1Fg4iHprbzxwIpefqQidjpcgtgbN7BtPtjjVNseEHBU0M2_huakcmCnMMU10&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6jkhARHSK6twLBar39FjLYIQBVpNmv6ysx2Y-X1Ty7g&oe=6AB29F31"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Blitz Monkey", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Platformer", "id": "528142316460358"}, {"topic_name": "Action", "id": "459781504968480"}, {
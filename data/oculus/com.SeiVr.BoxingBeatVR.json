om/v/t64.5771-25/473394150_1186712919445229_2195049665161568359_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAQVBDp66B4Q7kNvwG875xx&_nc_oc=AdoIiQXuCJ18cYbSygfWM9B6jxpgiQKMlnE8VKGZurN_Ild_1ZmHCwf4qdO-ogQqA1U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQe43CWq6Nyt694D81jN80kYDVxP6zOfEK9lvR7AtquaA&oe=6B0B0E26"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CO2 Extinguisher VR", "keywords": ["CO2FireTraining", "VRExtinguishOffice", "OfficeFireCO2", "CO2BlazeVR", "FireDrillSimulator"], "long_description": "CO\u2082 Extinguisher VR is an immersive virtual reality experience designed to train users on how to properly use a CO\u2082 fire extinguisher. Set in an office environment, you will encounter fire emergencies and learn the techniques needed to handle them safely and effectively.\n\nKey Features:\n\nRealistic CO\u2082 fire extinguisher mechanics based on real-world operations.\n\nPerformance feedback to improve your reaction time and accuracy.\n\nPerfect for fire safety training, workplace preparation and VR enthusiasts.\n\nTake on the role of a fire safety hero and make sure you are ready for any emergency with CO\u2082 Extinguisher VR!\n\n#FireSafetyTraining, #VROfficeGame, #CO2Training", "short_description": "Practice your firefighting skills in VR! Master the CO\u2082 fire extinguisher to put out an office fire."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, 
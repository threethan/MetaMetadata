2ovP4OCrH271ntZ1U3yeQLjYTVGiSg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUV1i6Wm1-NNb3bqUSsAp0sCwVmX3wv7s1a32qkQ3KsZw&oe=6B1045FE"}, {"file_name": "1.png", "id": "1186712916111896", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394150_1186712919445229_2195049665161568359_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RG4Pkd6fedsQ7kNvwE9Vab0&_nc_oc=Adr34IWodU7eUTu1CO98RKXYRmpULFX_9tGciFejZ8tvMTy11I0q9eROeg3MqybHufs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXn5rSB-ns-mDvzJFzQnNxQZD1mjinElLLqr-BA7dobtw&oe=6B105426"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CO2 Extinguisher VR", "keywords": ["CO2FireTraining", "VRExtinguishOffice", "OfficeFireCO2", "CO2BlazeVR", "FireDrillSimulator"], "long_description": "CO\u2082 Extinguisher VR is an immersive virtual reality experience designed to train users on how to properly use a CO\u2082 fire extinguisher. Set in an office environment, you will encounter fire emergencies and learn the techniques needed to handle them safely and effectively.\n\nKey Features:\n\nRealistic CO\u2082 fire extinguisher mechanics based on real-world operations.\n\nPerformance feedback to improve your reaction time and accuracy.\n\nPerfect for fire safety training, workplace preparation and VR enthusiasts.\n\nTake on the role of a fire safety hero and make sure you are ready for any emergency with CO\u2082 Extinguisher VR!\n\n#FireSafetyTraining, #VROfficeGame, #CO2Training", "short_description": "Practice your firefighting skills in VR! Master the CO\u2082 fire extinguisher to put out an office fire."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "com
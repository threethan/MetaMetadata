udVEwQ7kNvwE83LUG&_nc_oc=AdoWc4xs9An2CZXuDAu-M4KfMPqa752lUR-RD9VwVWbGSJtMeM9XT8Yzt1ShSbYvg8I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoB5BchfuInB5tPlQuoiOKpPBEMSh5pbFln7Zmt8_ACw&oe=6AFDCB5A"}, {"file_name": "screenshot2 2560 x 1440.png", "id": "1330496971598631", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391875_1330496974931964_18831621341342423_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qygdh-t23vAQ7kNvwE767jW&_nc_oc=Adr42YmyM6gFcyCz4ELOENALRlkQNr4VvIl2ugTuVithlJzKOcGXDzKsHE4cM_O7tuY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg_54SxArjetlcSBvCUtZRLdg1qX9o7SsZqxvHaymDtQ&oe=6AFDD63B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560 x 1440 (2).png", "id": "951813180455577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393984_951813183788910_157427902966023117_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Of7O99hzDMwQ7kNvwGcFcaM&_nc_oc=AdqfrKScTpuUVfaUYN6o9sPQSCtYmuXoyzzsjmdmm-4cDL9QlDQYey_itVTli4NOZ20&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHMWswR8u4_q-LiYPp4nf4Ij8VBhnbfyXeD7ZV1ABfmw&oe=6AFDB62C"}, "display_name": "Roboquest VR", "keywords": ["Roboquest", "FPS", "Action", "Shooter", "VR"], "long_description": "\nUnleash the Guardian Within!\nPrepare for a pulse-pounding VR adventure in the scorched future of Roboquest!\n\nStep into the metallic boots of a rebooted Guardian and dive headfirst into a fast-paced, roguelite FPS experience like no other. With intuitive VR controls, you'll feel every shot, every dodge, and every exhilarating moment as you battle hordes of robots. Team up with a brobot and save the world!\n\nKey Features:\n\nImmersive VR Action: Experience the adrenaline rush of Roboquest's signature gameplay in a whole new dimension. Dual-wield weapons, unleash devastating abilities, and navigate dynamic environments with unparalleled freedom. \n\nEndless Replayability: With procedurally generated levels, a massive arsenal of weapons and gadgets, and challenging enemy encounters, every run is a unique and unpredictable thrill ride. With over 100+ weapons, Roboquest VR will keep you entertained for hours.\n\nUpgrade and Customize: Collect powerful upgrades and customize your Guardian to match your playstyle. From rapid-fire pistols to energy-blasting rifles, find the perfect loadout to dominate the robotic hordes.\n\nCo-op Multiplayer: Team up with friends and tackle the challenges together! Coordinate your attacks, revive fallen brobots, and share the spoils of victory. Roboquest VR supports online co-op with other Roboquest VR players!\n\nRoboquest VR is more than just a game \u2013 it's an adrenaline-fueled\n", "short_description": "The future is in flames, overrun by ruthless machines\u2014but you\u2019re built to fight back. Roboquest VR is a lightning-fast roguelite FPS where speed, firepower, and reflexes are your best weapons. Play solo or team up in two-player co-op\u2014adapt, survive, and reboot the future!"}]}, "developer_name": "Flat2VR Studios, RyseUp Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1B_OHuOSLLTYvL52qKKWvFwWk-2yqP_Ol404EXrtwERY/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Flat2VR Studios, Starbreeze Publishing", "support_website_url": null, "website_url": "https://flat2vrstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "sup
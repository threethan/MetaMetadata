ad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOpAj8WUdECHfFIhtoDm1z3LnieZm2Iz4I87wx5Gj8zA&oe=6A75DF8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TAPIR_MOUSE_META_Cover Art Landscape 2_.png", "id": "1052530273963859", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313390_1052530277297192_4741558892509272549_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVdaiUPbxqwQ7kNvwGcMf1r&_nc_oc=Adqa2t33EzRoe_j5pujcLd176WMpOWsTHF8oVzVnmadeMTeVRGw7I3CyNmXyr3nHGuI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1csx3lqFn9cdywK1uFBrg7qOrcJc2vVD9VUHJYsDrDw&oe=6A75E08C"}, "display_name": "Roboquest VR", "keywords": ["FPS", "Action", "Shooter", "Guns", "multiplayer"], "long_description": "**REBOOT THE WASTELAND IN FULL VR**\n\nRoboquest VR is a fast-paced roguelite FPS set in a scorched future world, where every run is a fight to push farther, move faster, and hit harder. Play as a Guardian and tear through mechanical swarms with 70+ weapons, distinct classes, and build-driven progression that keeps every run fresh.\n{779793198512832}\n\n**BUILT FOR VR**\n\nThis is Roboquest rebuilt for VR from the ground up. Sprint, slide, jump, and blast through shifting levels with manual reloading, physical weapon handling, and combat that feels sharp, fast, and immediate inside the headset.\n{1378837097455265}\n\n**FIGHT YOUR WAY THROUGH THE SCRAPYARD**\n- Battle through procedurally generated runs packed with mechanical enemies, secrets, and towering bosses\n- Use 70+ weapons ranging from pistols, shotguns, and energy rifles to bows, melee options, and experimental gear\n- Unlock classes, perks, and upgrades that shape your build from run to run\n- Move with speed and intent through a scorched future world built around momentum and pressure\n\n{1719082122629777}\n\n**NOW WITH 2-PLAYER CO-OP**\n\nTeam up with another Guardian and take on Haven City together. Match through Quickplay, join with a Room Code, or invite a friend directly. Share weapons, revive each other in the middle of a run, and push deeper into the chaos side by side.\nWhether you are chasing the perfect build, testing a new weapon, or clearing swarms with a friend at your side, Roboquest VR delivers the kind of full-featured action experience that feels right at home in VR. \n{1324767873138122}\n", "short_description": "Fast-paced roguelite FPS fully rebuilt for VR. Battle mechanical swarms in a scorched future world with 70+ weapons, high-speed movement, and 2-player co-op."}]}, "developer_name": "Flat2VR Studios, RyseUp Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1B_OHuOSLLTYvL52qKKWvFwWk-2yqP_Ol404EXrtwERY/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Impact Inked", "support_website_url": null, "website_url": "https://flat2vrstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "27658327550528470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619774_4292001264349574_7928339382780603191_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-coYOwaF1UQ7kNvwG57jQl&_nc_oc=Adrel2rmHe4vXPrdqSxLmsZGZnc9xIExXi7lKrRD3i1H_5ah9HQH6BqK39ab93S_HzU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscd
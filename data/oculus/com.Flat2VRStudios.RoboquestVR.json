scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391875_1330496974931964_18831621341342423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrihBHWFM1MQ7kNvwHq1WmS&_nc_oc=AdoMgk6b-XqVkihh5n8BeyHoVgZ2-aJQQ-iuL1wI4_V8R27DR_Mu4vywMPhOChrO_Mo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMSxA1cu2hG3dWa9Cw8H4EJvJ_T7XOhZZ1Il5LL_38-g&oe=6AA93DFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560 x 1440 (2).png", "id": "951813180455577", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393984_951813183788910_157427902966023117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xz_9QFhL75sQ7kNvwF51rV2&_nc_oc=AdrweHoxLHCgSuAYf3FnMt34f1cCbT6aV0CNOuoNJiNBw4SlHDwjK3JazqdEx_tXs24&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaBQ9ooLTs7KBOfOOfvQjugRbE6aFwg3U9A071khL6XQ&oe=6AA9562C"}, "display_name": "Roboquest VR", "keywords": ["Roboquest", "FPS", "Action", "Shooter", "VR"], "long_description": "\nUnleash the Guardian Within!\nPrepare for a pulse-pounding VR adventure in the scorched future of Roboquest!\n\nStep into the metallic boots of a rebooted Guardian and dive headfirst into a fast-paced, roguelite FPS experience like no other. With intuitive VR controls, you'll feel every shot, every dodge, and every exhilarating moment as you battle hordes of robots. Team up with a brobot and save the world!\n\nKey Features:\n\nImmersive VR Action: Experience the adrenaline rush of Roboquest's signature gameplay in a whole new dimension. Dual-wield weapons, unleash devastating abilities, and navigate dynamic environments with unparalleled freedom. \n\nEndless Replayability: With procedurally generated levels, a massive arsenal of weapons and gadgets, and challenging enemy encounters, every run is a unique and unpredictable thrill ride. With over 100+ weapons, Roboquest VR will keep you entertained for hours.\n\nUpgrade and Customize: Collect powerful upgrades and customize your Guardian to match your playstyle. From rapid-fire pistols to energy-blasting rifles, find the perfect loadout to dominate the robotic hordes.\n\nCo-op Multiplayer: Team up with friends and tackle the challenges together! Coordinate your attacks, revive fallen brobots, and share the spoils of victory. Roboquest VR supports online co-op with other Roboquest VR players!\n\nRoboquest VR is more than just a game \u2013 it's an adrenaline-fueled\n", "short_description": "The future is in flames, overrun by ruthless machines\u2014but you\u2019re built to fight back. Roboquest VR is a lightning-fast roguelite FPS where speed, firepower, and reflexes are your best weapons. Play solo or team up in two-player co-op\u2014adapt, survive, and reboot the future!"}]}, "developer_name": "Flat2VR Studios, RyseUp Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1B_OHuOSLLTYvL52qKKWvFwWk-2yqP_Ol404EXrtwERY/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Flat2VR Studios, Starbreeze Publishing", "support_website_url": null, "website_url": "https://flat2vrstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9401879739933196"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "3431725196987425"}, {"status": "PUBLISHED", "id": "1364110615541725"}
=izNBpRCucDwQ7kNvwFTZaUY&_nc_oc=AdqO_4p_Lk686E0gAF4JGSgRsRW0jnxYxPa7YnJWyK8TCbUXaHDBQh0jOh7Fyt--wRU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmtD-XpJBGJOCB6UTAQmZcikQZIKMYI_6_3r_P9Hmntg&oe=6A75C89A"}, {"file_name": "screenshot2 2560 x 1440.png", "id": "1330496971598631", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391875_1330496974931964_18831621341342423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlqRg8_1iAQQ7kNvwGmiyiB&_nc_oc=AdoD4nQNOWUCnLfqIrWnPMv4LUL9zPJ2NK3SceAcMhG6ChUSv3nE996hV6244A2M6UE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8HGIgHW_sEgnxO71aVyeTrXHPnlXSSj3a0JTqBI_IxA&oe=6A75D37B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560 x 1440 (2).png", "id": "951813180455577", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393984_951813183788910_157427902966023117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZg0u6CEBd4Q7kNvwEZ9kKN&_nc_oc=AdqjBmye4hPoOe5Vo_n7ktchopwqE5PEFkXwWprI0sIV5lqVmcc3g9u2M9r-nkjncHM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKTv6ipBUyxPcW-9R0PC56Cao_3Q95bf2Yyp-0A1JCTQ&oe=6A75EBAC"}, "display_name": "Roboquest VR", "keywords": ["Roboquest", "FPS", "Action", "Shooter", "VR"], "long_description": "\nUnleash the Guardian Within!\nPrepare for a pulse-pounding VR adventure in the scorched future of Roboquest!\n\nStep into the metallic boots of a rebooted Guardian and dive headfirst into a fast-paced, roguelite FPS experience like no other. With intuitive VR controls, you'll feel every shot, every dodge, and every exhilarating moment as you battle hordes of robots. Team up with a brobot and save the world!\n\nKey Features:\n\nImmersive VR Action: Experience the adrenaline rush of Roboquest's signature gameplay in a whole new dimension. Dual-wield weapons, unleash devastating abilities, and navigate dynamic environments with unparalleled freedom. \n\nEndless Replayability: With procedurally generated levels, a massive arsenal of weapons and gadgets, and challenging enemy encounters, every run is a unique and unpredictable thrill ride. With over 100+ weapons, Roboquest VR will keep you entertained for hours.\n\nUpgrade and Customize: Collect powerful upgrades and customize your Guardian to match your playstyle. From rapid-fire pistols to energy-blasting rifles, find the perfect loadout to dominate the robotic hordes.\n\nCo-op Multiplayer: Team up with friends and tackle the challenges together! Coordinate your attacks, revive fallen brobots, and share the spoils of victory. Roboquest VR supports online co-op with other Roboquest VR players!\n\nRoboquest VR is more than just a game \u2013 it's an adrenaline-fueled\n", "short_description": "The future is in flames, overrun by ruthless machines\u2014but you\u2019re built to fight back. Roboquest VR is a lightning-fast roguelite FPS where speed, firepower, and reflexes are your best weapons. Play solo or team up in two-player co-op\u2014adapt, survive, and reboot the future!"}]}, "developer_name": "Flat2VR Studios, RyseUp Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1B_OHuOSLLTYvL52qKKWvFwWk-2yqP_Ol404EXrtwERY/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Flat2VR Studios, Starbreeze Publishing", "support_website_url": null, "website_url": "https://flat2vrstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND
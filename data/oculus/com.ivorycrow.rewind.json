7&_nc_sid=6e7a0a&_nc_ohc=7redLHk-OxIQ7kNvwEFUSNR&_nc_oc=AdoxRvLOFjfuxOzXBl2ZWrcR3B_4f-pIhf_PhNO_qu0c0-SdyJBrEILnX5Mdmll8-mo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdbGRHO6rn-0Ne_jIwmGLfZdrCqUJuBLL7bfnL31yeyQ&oe=6B08458B"}, {"file_name": "SS_04.png", "id": "1726617148102091", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974832_1726617151435424_8111136064913190466_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9g_VXiKWHoQ7kNvwG9hfTs&_nc_oc=Adq9dG-Wgi2hP9xe0ofEMyuezRlgL2DZlEweNgv8Ce17Z-BR8iUfTfqGpihf4zNZq8U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRB5fmClF55Y_iFMuuUAT2hW2yivsruC8BEkJmaNkThrw&oe=6B086BC8"}, {"file_name": "SS_10.png", "id": "3957853361169926", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392000_3957853364503259_3051810829364392011_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfFg6zK9FjEQ7kNvwGRqu_N&_nc_oc=AdpS9n6jQNkxhf-N0g-rsV-4jsum1MrkEOJCKnnMkWvvAvUYDq_rZPNmup5PP4wSWMg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDfAx_IEsBry5G0Ck3fECgH87AaLbjqzQZQYDhewWuZQ&oe=6B0841B8"}, {"file_name": "SS_06.png", "id": "487920204000458", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391934_487920207333791_2346325518970330578_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ba7ciQr_s8sQ7kNvwHi7FSM&_nc_oc=Adodywt3PG_NDKfRcRTRkWqpOM77ZIXkkcqloIDPwqZS_j98WZMQ_zDVKmyzM5Q2M60&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnz7EyGwOzmChG8lHdtRiv5AcZzji6L1UXmUb52T3OTg&oe=6B085CD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "1031456362361949", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974751_1031456365695282_4318189925440222177_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UqmI7Q25AsQ7kNvwF0SglA&_nc_oc=AdpEo2Vi3vAzzmdoHkTtRtPvFBg48dbyzcTX68Jv_5ShD0NJtSs7EAXgs7jmEUh6Pvw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnXsiwtndvDTvHvIFp-U0jw76BZ-tNc_yRsfX62ptm5A&oe=6B08624B"}, "display_name": "Chrono Weaver", "keywords": ["Puzzle", "Time", "Slingshot", "Clone", "Physics"], "long_description": "# Chrono Weaver is a single-player co-op time-travel puzzle game.\nWork with copies of yourself as you travel through space and time, finding solutions to seemingly impossible tests. Explore a beautifully crafted mysterious world guided by an unusual flying robot.\n\n{983415867008151}\n\n# MASTER TIME-TRAVEL TO WORK WITH YOURSELF\n\nDon\u2019t have friends to play with you? No problem! In Chrono Weaver you use time-travel to solve co-op puzzles by yourself! Use the Origin Point Device to spawn the next version of you and then set off solving one part of the puzzle. Your co-worker, also powered by you, will work at the same time solving a different part. \n\n# SOLVE UNIQUE PHYSICS BASED PUZZLES\n\nUse your wits to discover the puzzling path to the data disk aided by buttons, levers, ropes, bouncers, and more. A whole new dimension opens up when you can be in multiple places at once, and physics is way more fun in VR. Bringing both of these things together creates something you have to experience to understand.\n\n# SLINGSHOT YOUR WAY ACROSS A BEAUTIFUL WORLD\n\nDemonstrate your accuracy and precision with the amazing Quantum Slingshot. Use this slingshot to make impossible shots in a desolate research facility. There are twists and turns all around, and lots to discover in this story rich environment. There are things to throw and cans to crush in our physics based world that takes full advantage of VR.\n\n", "short_description": "Looking for an immersive VR physics puzzler? Chrono Weaver is a single-player co-op time-travel puzzle game. Work with copies of yourself as you travel through space and time, finding solutions to seemingly impossible tests. Explore a beautifully crafted mysterious world guided by an unusual flying robot. Get to work and get lost in this quirky sci-fi world. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://ivorycrowgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Ivory Crow Games LLC", "support_website_url": null, "website_url": "https://www.ivorycrowgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9098065640259542"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391896_1782871129212387_256434786391274285_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLbPFcFvlU0Q7kNvwHjt6ni&_nc_oc=AdqBbVisccmWBD1o6_8mWaO267OR6Wsh9W1l-O6roQ-U_J-c7lIvxN6nhrx_s3aD5fk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwEEgjhD378XhIu2upp5M9Lt4chvfukEwV_BqzcoAFlw&oe=6B0870EE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Chrono Weaver", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1734839460, "lastRevision": {"nodes": [{"id": "50904366
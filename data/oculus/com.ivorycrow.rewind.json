1562_377289754565790_8520692017278117180_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjqeK4_8CloQ7kNvwFfMg7i&_nc_oc=AdoTI1WcHV900Uw5m5eGz4N_YoytjelzIHw6wjwujRb5uG7DSWwBoUpxCwrZH5mmhhk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWH5BBHPOLTJp4BfuALT5zW9_ylF7OGUVoVCeQdgTnXQ&oe=6B070A0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS_01.png", "id": "437420231773638", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031396_437420235106971_3587640640108666997_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGJKxgpJMLgQ7kNvwE95KpV&_nc_oc=Adrw1WoCYURXO0rWeKcuWLhf_OL1mIe-u9bOAOcje_GnHZBQIhgNig3WnOxvjPHISHY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJa4pVMXUYoCyPOfHrneMeicoKzkaSRMywO4wvk0fCLQ&oe=6B06F998"}, "display_name": "Chrono Weaver", "keywords": [], "long_description": "You wake up alone in a desolate but eccentric world. After discovering the battery of puzzling tasks ahead, you\u2019re given the only tool you\u2019ll need. A strange but seemingly ordinary orange ball.\n\nThe ball feels great in your hand, but upon your first throw the facade of normalcy is broken and its true power revealed. Wherever this ball lands, it fractures time, cloning you. Master the ball and yourselves to orchestrate a perfect sequence setting up your ultimate throw that shatters the disk, completing your puzzling task. As you master moving through time, your connection to the ball improves but will it be enough for your final test?", "short_description": "Looking to test your brain and body in VR? In Chrono Weaver, think and throw your way through time bending kinetic puzzles. As you explore an unearthly sci-fi world, work with copies of yourself as you travel through time to find solutions to seemingly impossible tests."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ivorycrowgames.com/privacy.html", "developer_terms_of_servic
7&_nc_sid=6e7a0a&_nc_ohc=Ps6_WDLj9FEQ7kNvwG66q09&_nc_oc=Adqhyk28HHNzv7myxaQsiqe7hZpDttpygWf3_fxSNO_HMg7vmycPoa0DfjjVRNOvmhY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaobRFEoJSioymnPGx7jxeskLX07U2ZIDpKR1PSHAGHg&oe=6AFC680B"}, {"file_name": "SS_04.png", "id": "1726617148102091", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974832_1726617151435424_8111136064913190466_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LB9mAUqZuDEQ7kNvwGAZMsV&_nc_oc=AdojzMkMPyOtx87HRhs6FhPP-p7oHHD7ln-tYNaIJRqwrlDDs55y-Lwien2hDkGdidY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRueAXtqyYs5b1ooCLIRreku6ioiIu5gyLOWOExb-9Pbw&oe=6AFC8E48"}, {"file_name": "SS_10.png", "id": "3957853361169926", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392000_3957853364503259_3051810829364392011_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZLl12ErzDcQ7kNvwHA_xY0&_nc_oc=AdqWqlVS9ifajdYjs17oi3448RVkSEA13LXzapTovwb7tAgQwQ5mMwvqT_8ZjLO579k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT25GQhKv_xpBoHWJ2M6EqGVJvk2fx9uVymXzP04HJ49A&oe=6AFC6438"}, {"file_name": "SS_06.png", "id": "487920204000458", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391934_487920207333791_2346325518970330578_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJiqLzCNMaEQ7kNvwEyWgSB&_nc_oc=AdpJiXSzaiPQpvnr4kfmY5L5S6zKj9f-_bJdH_6mEWG1zAAib0C3c2T2XJj6_dbZ2Gw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfnbQvOFqgWXZQdYdkEgiS5U9vFHxyFZWuIROjm5K9zg&oe=6AFC7F56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "1031456362361949", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974751_1031456365695282_4318189925440222177_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QeSI3nU0R2gQ7kNvwEN4KFe&_nc_oc=Adq6re-Mwu7RZKzuXlynzwO8X0lYodHVAL14kUxzu5mwMPLhmtrrhpW5rp4tvnynFoM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5ThZ3uD8NCIyD1SHHjPpP3dtV5jWqEOOgK_q3IXDYjg&oe=6AFC84CB"}, "display_name": "Chrono Weaver", "keywords": ["Puzzle", "Time", "Slingshot", "Clone", "Physics"], "long_description": "# Chrono Weaver is a single-player co-op time-travel puzzle game.\nWork with copies of yourself as you travel through space and time, finding solutions to seemingly impossible tests. Explore a beautifully crafted mysterious world guided by an unusual flying robot.\n\n{983415867008151}\n\n# MASTER TIME-TRAVEL TO WORK WITH YOURSELF\n\nDon\u2019t have friends to play with you? No problem! In Chrono Weaver you use time-travel to solve co-op puzzles by yourself! Use the Origin Point Device to spawn the next version of you and then set off solving one part of the puzzle. Your co-worker, also powered by you, will work at the same time solving a different part. \n\n# SOLVE UNIQUE PHYSICS BASED PUZZLES\n\nUse your wits to discover the puzzling path to the data disk aided by buttons, levers, ropes, bouncers, and more. A whole new dimension opens up when you can be in multiple places at once, and physics is way more fun in VR. Bringing both of these things together creates something you have to experience to understand.\n\n# SLINGSHOT YOUR WAY ACROSS A BEAUTIFUL WORLD\n\nDemonstrate your accuracy and precision with the amazing Quantum Slingshot. Use this slingshot to make impossible shots in a desolate research facility. There are twists and turns all around, and lots to discover in this story rich environment. There are things to throw and cans to crush in our physics based world that takes full advantage of VR.\n\n", "short_description": "Looking for an immersive VR physics puzzler? Chrono Weaver is a single-player co-op time-travel puzzle game. Work with copies of yourself as you travel through space and time, finding solutions to seemingly impossible tests. Explore a beautifully crafted mysterious world guided by an unusual flying robot. Get to work and get lost in this quirky sci-fi world. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://ivorycrowgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Ivory Crow Games LLC", "support_website_url": null, "website_url": "https://www.ivorycrowgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9098065640259542"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391896_1782871129212387_256434786391274285_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAVHMQEWy_0Q7kNvwFf-PJu&_nc_oc=AdrJZWh9Euwt7JwscYAQvU4a_VW3k5UlmTOB3tShQXWi7xsrW7-Qd79UDO2zsCDy2Ms&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRr_0VVjlxwKFrRQ2u81ZvMfqbXot-8Y1pSBtCYtkQi_A&oe=6AFC936E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Chrono Weaver", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1734839460, "lastRevision": {"nodes": [{"id": "50904366
7&_nc_sid=6e7a0a&_nc_ohc=7redLHk-OxIQ7kNvwFWb9ZR&_nc_oc=AdpgpCzXRyGWe1WClP7N3zqkx7sEmrJ6XsrAm29GFN6pOPgjlFGANQKGJ6G225IQrsE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQToJHDbz2Q3fVKqlzAAfXggv2gpsZ90YfvU7DXzUxDSyA&oe=6B0B20CB"}, {"file_name": "SS_04.png", "id": "1726617148102091", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974832_1726617151435424_8111136064913190466_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTRCTEv9_34Q7kNvwGE1mE6&_nc_oc=AdoTDYxwAu1ClxPsliWQe9PxnP2w3Dcf4nSaE0GUOOwCaNWxqlK2dJvGxM3bWW6C0MQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ0eeQd0WTf_9hDF7gO2G2jxFZCVtSFiwZQn6-xTTUKXQ&oe=6B0B0EC8"}, {"file_name": "SS_10.png", "id": "3957853361169926", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392000_3957853364503259_3051810829364392011_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfFg6zK9FjEQ7kNvwGSH1gC&_nc_oc=AdpBvA4KpjIKjjrdtptCjZyUSmTVp4BWyl1T71bG4hbVENZi5igMXB6pM8DCQ-URx6Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTvs6wqa3SsgMINjJ2meMHZDX9fBr6ULbK1XXXy__f_IA&oe=6B0B1CF8"}, {"file_name": "SS_06.png", "id": "487920204000458", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391934_487920207333791_2346325518970330578_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alHC7gPmot0Q7kNvwEW8sXi&_nc_oc=AdqW5sYxkrMmK1OSgroFnmCcJleag36cyZjrs2A2tvjlxhJxD0YsVP8jBvxbckjXSyo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTKFzx-5zackC7X_cJa-Yi39or5nD6cRQ2KxZbiu0YmXw&oe=6B0B3816"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "1031456362361949", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974751_1031456365695282_4318189925440222177_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzv92XiQYowQ7kNvwF0SRvk&_nc_oc=Adq7b15AQ5VQN0o08tuSWjJBFwxNKuG1hpU7npr40lA3pffmogo5YLH4seXkDkP7iAo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTJ6tdF2YRx7pzBgnj_BNdVuJ8UcDeOsHtnMIqb2P7zRQ&oe=6B0B3D8B"}, "display_name": "Chrono Weaver", "keywords": ["Puzzle", "Time", "Slingshot", "Clone", "Physics"], "long_description": "# Chrono Weaver is a single-player co-op time-travel puzzle game.\nWork with copies of yourself as you travel through space and time, finding solutions to seemingly impossible tests. Explore a beautifully crafted mysterious world guided by an unusual flying robot.\n\n{983415867008151}\n\n# MASTER TIME-TRAVEL TO WORK WITH YOURSELF\n\nDon\u2019t have friends to play with you? No problem! In Chrono Weaver you use time-travel to solve co-op puzzles by yourself! Use the Origin Point Device to spawn the next version of you and then set off solving one part of the puzzle. Your co-worker, also powered by you, will work at the same time solving a different part. \n\n# SOLVE UNIQUE PHYSICS BASED PUZZLES\n\nUse your wits to discover the puzzling path to the data disk aided by buttons, levers, ropes, bouncers, and more. A whole new dimension opens up when you can be in multiple places at once, and physics is way more fun in VR. Bringing both of these things together creates something you have to experience to understand.\n\n# SLINGSHOT YOUR WAY ACROSS A BEAUTIFUL WORLD\n\nDemonstrate your accuracy and precision with the amazing Quantum Slingshot. Use this slingshot to make impossible shots in a desolate research facility. There are twists and turns all around, and lots to discover in this story rich environment. There are things to throw and cans to crush in our physics based world that takes full advantage of VR.\n\n", "short_description": "Looking for an immersive VR physics puzzler? Chrono Weaver is a single-player co-op time-travel puzzle game. Work with copies of yourself as you travel through space and time, finding solutions to seemingly impossible tests. Explore a beautifully crafted mysterious world guided by an unusual flying robot. Get to work and get lost in this quirky sci-fi world. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://ivorycrowgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Ivory Crow Games LLC", "support_website_url": null, "website_url": "https://www.ivorycrowgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9098065640259542"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391896_1782871129212387_256434786391274285_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLbPFcFvlU0Q7kNvwG-74LW&_nc_oc=AdqRRI9_Ym00_apObkrWPGpkwEkUdz5G229fdrJD_cYLJJjYz8IMWkgSsftN78si9HE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRU0W4f9arjOZCh2XCu68773qO_9eShw4SKuIJaiTVH7Q&oe=6B0B13EE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Chrono Weaver", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1734839460, "lastRevision": {"nodes": [{"id": "50904366
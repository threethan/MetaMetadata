 online.\n\ud83d\udd04 Frequent updates with new maps, cosmetics, and game modes.\n\ud83c\udfc6 Challenge yourself to become the ultimate tagger.\n\nWhether you're escaping a chase, pulling off impressive climbs, or showing off your favorite cosmetics, there's always something new to experience in Blocky Taggers.\n\nCan you outrun the competition and become the best tagger?", "short_description": "Swing, climb, and tag your way to victory in Blocky Taggers! Explore colorful maps, unlock fun cosmetics, and outsmart your friends in this fast-paced multiplayer game inspired by classic tag."}]}, "developer_name": null, "developer_privacy_policy_url": "https://milesandjon.wixsite.com/my-site-2/blank", "developer_terms_of_service_url": "https://milesandjon.wixsite.com/my-site-2", "publisher_name": "Miles", "support_website_url": null, "website_url": "https://milesandjon.wixsite.com/my-site-2", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "MULTI_USER"], "id": "1148505388355582"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1061381103249757"}]}, "baseline_offer": {"id": "1061381103249757"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785508920, "status": "PUBLISHED", "id": "1061381103249757"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_te
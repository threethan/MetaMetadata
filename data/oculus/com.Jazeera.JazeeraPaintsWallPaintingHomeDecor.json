FOguWxDLGn3vE_FnO-OAg&oe=6B0DA4FD"}, {"file_name": "Screenshot 5.png", "id": "1400306123942474", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974712_1400306127275807_826992299789237673_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iatmPazQLH4Q7kNvwEhk3VD&_nc_oc=Adrhby9PXJpoxH-u5bcd7O9r_Z7shzl6E8chAZiP9PLfflWGxzuoW-FVN8R43gFNsbM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSJJFUPWTZkyZ3eV3zY3yl5rRTMOEDNXartYg9K2MmYKA&oe=6B0DC9C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "406883165269946", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035327_406883168603279_8960542701255661033_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRd5Jux7F7AQ7kNvwFBYO3f&_nc_oc=AdqnC5oJGWI-_fdjD0V9tKCyD6eRR5wJCFHijH7UOGBIaFmGTLs7ZJMTjZmOwHS_uLI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRIVTZ-bG1kdzt4Qfheq1WyDYZ7XN8VeMPGhjIjtCz09A&oe=6B0DC05B"}, "display_name": "Jazeera Paints - Wall Painting & Home Decor", "keywords": [], "long_description": "With our app, you can now experiment with different paint colors on the walls of your home and front yard before actually painting them. Whether you're looking for unique decorative colors or plain shades, we offer a wide range of colors in all categories. You can even try wood colors that showcase the natural grain, as well as iron and metal colors on various surfaces.\nOur app has a user-friendly and visually appealing interface, making it easy to choose your preferred color and apply it directly to pre-designed villa walls or interior and exterior spaces. You can ensure that the color perfectly complements your current decor.\nFurthermore, you can add products to your shopping cart, where you can browse and select items you wish to purchase later. The app also provides additional information about the products and tutorial videos.\nDownload our app now and enjoy a unique and exciting experience of experimenting with different colors and discovering what suits your unique taste.", "short_description": "Experience the power of virtual painting with our app! Try different colors on your walls, from vibrant decorative shades to elegant solids. Explore wood grain, iron, and metal colors too. Easy-to-use interface, seamless navigation, and the option to save products for later purchase. Transform your home with confidence. Download the Wall Color and Home Decoration App - The Only and First of its Kind in the World."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jazeerapaints.com/saudi-en/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Passio Inc.", "support_website_url": null, "website_url": "https://jazeerapaints.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "24877251188588489"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "30117711081209114", "version": "0.51.0"}, "id": "414310711175953", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isA
ywords": ["Horror", "Multiplayer", "JumpScare", "Monster"], "long_description": "Static Loss is a first-person VR horror experience designed to put players in a tense and unsettling atmosphere. Explore dark, abandoned hallways and large rooms. As you move in deeper, you will get lost, but finding secrets on the way is the best part. The game focuses on exploration, suspense, and psychological tension to create a truly horrifying horror experience. If you enjoy being scared and exploring unknown places, Static Loss will keep you questioning what\u2019s real\u2014and what\u2019s watching you.\n\nDesigned for smooth a performance on the Meta Quest 3.", "short_description": "Static Loss is a multiplayer horror game with dark hallways, terrifying monsters, and tense exploration. Every corner could hide something\u2014and you\u2019re never truly alone."}]}, "developer_name": "Flaming Sunday", "developer_privacy_policy_url": "https://sites.google.com/view/static-loss/home", "developer_terms_of_service_url": null, "publisher_name": "Flaming Sunday", "support_website_url": null, "website_url": "https://sites.google.com/view/static-loss/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25571576209164648"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1521175022310977"}]}, "baseline_offer": {"id": "1521
_nc_oc=Adlro80sTmDlpXmPCKUYSE5DWTv1HhIpFpL59pxRvIXR7-GxcaKbmH93e8aYURiFNE0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyFOpiDvpns0QD1rxvSxwY3Cf_A_6faNq2vTAhDVArP8w&oe=69B168D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VO_Quest Trailer Cover.png", "id": "527187279332662", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974836_527187285999328_2039388984460122755_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUf_kwDDyiAQ7kNvwHEW2Lt&_nc_oc=AdmJrz62rK7fRiXR7KDS9MlS25Y5gfPugml0I9KuxnomU7mM0tUX3axnv4d5x06X28w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyv6LicQfnnicvAq9NaoKvNbY_2I4SWmtkHXnU3IGElMg&oe=69B158EF"}, "display_name": "Virtual Orator for Enterprise", "keywords": ["PublicSpeaking", "Simulation", "ProfessionalDevelopment", "Training", "CommunicationSkills"], "long_description": "Virtual Orator for Enterprise is professional-grade VR training software designed for organizations, institutions, and training providers that require realistic public speaking and presentation practice in immersive environments.\n\nThe application delivers configurable audience simulations that allow trainees to practice communication skills in a controlled, repeatable, and scalable manner. Scenarios can be adapted to match specific training objectives, presentation formats, and audience conditions.\n\nKey capabilities include:\n* configurable virtual venues and audience sizes\n* adjustable audience behavior and engagement levels\n* support for custom presentation slides\n* speaker notes and structured rehearsal workflows\n* remote and hybrid presentation practice scenarios\n* session feedback to support skill development and assessment\n* dynamic audience responses powered by proprietary AI systems\n\nVirtual Orator for Enterprise is intended for professional training use cases and organizational deployments. Access is provided through enterprise licensing and device authorization.\n", "short_description": "Professional VR public speaking training for organizations and institutions. Virtual Orator delivers realistic, configurable audience simulations to support structured communication and presentation training programs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualorator.com/app-privacy/", "developer_terms_of_service_url": "http://virtualorator.com/EULA/", "publisher_name": "Virtual Human Technologies s.r.o.", "support_website_url": null, "website_url": "https://virtualorator.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25861726296852707"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "4431192397160870"}, {"status": "PENDING", "id": "1589202155696276"}]}, "baseline_offer": {"id": "4431192397160870"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772182080, "status": "PUBLISHED", "id": "4431192397160870"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25884364424588894", "version": "1.2.1"}, "id": "127188635991676", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__type
"https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031337_1162656067687322_24044547422117857_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugmKElQVgB4Q7kNvwGBtxXQ&_nc_oc=Adob0x4N_YLgRtwCn7tiu3Q2jFzeo2soblXtdYvqf4sWePr-TNNekkB6dkQLcz9O95A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZHF7dUIjTu5y2huIMMnsOd-502Fi7d31M4sJHntgFHA&oe=6A144956"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VO_Quest Trailer Cover.png", "id": "527187279332662", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974836_527187285999328_2039388984460122755_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khB4BKMgTfgQ7kNvwH70kTA&_nc_oc=AdqQQXrkqK0SdxW9KEIATn0RlouAyjEKXK7Ehecev7_t4HBA_VAbCuuAsTeEYQ47kso&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af730Y2JCd4Hpoa2ApJkh6w4UJK8qXmYlPrMUKmJnI3-Og&oe=6A1471AF"}, "display_name": "Virtual Orator for Enterprise", "keywords": ["PublicSpeaking", "Simulation", "ProfessionalDevelopment", "Training", "CommunicationSkills"], "long_description": "Virtual Orator for Enterprise is professional-grade VR training software designed for organizations, institutions, and training providers that require realistic public speaking and presentation practice in immersive environments.\n\nThe application delivers configurable audience simulations that allow trainees to practice communication skills in a controlled, repeatable, and scalable manner. Scenarios can be adapted to match specific training objectives, presentation formats, and audience conditions.\n\nKey capabilities include:\n* configurable virtual venues and audience sizes\n* adjustable audience behavior and engagement levels\n* support for custom presentation slides\n* speaker notes and structured rehearsal workflows\n* remote and hybrid presentation practice scenarios\n* session feedback to support skill development and assessment\n* dynamic audience responses powered by proprietary AI systems\n\nVirtual Orator for Enterprise is intended for professional training use cases and organizational deployments. Access is provided through enterprise licensing and device authorization.\n", "short_description": "Professional VR public speaking training for organizations and institutions. Virtual Orator delivers realistic, configurable audience simulations to support structured communication and presentation training programs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualorator.com/app-privacy/", "developer_terms_of_service_url": "http://virtualorator.com/EULA/", "publisher_name": "Virtual Human Technologies s.r.o.", "support_website_url": null, "website_url": "https://virtualorator.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25861726296852707"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "4431192397160870"}, {"status": "PENDING", "id": "1589202155696276"}]}, "baseline_offer": {"id": "4431192397160870"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772182080, "status": "PUBLISHED", "id": "4431192397160870"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26490323450659652", "version": "1.2.2"}, "id": "127188635991676", "channel_n
00 companies and over 80% of Fortune 500 companies rely on the secure, scalable Smartsheet platform to connect the entire enterprise. \n\nTo learn more about Smartsheet, visit https://www.smartsheet.com/", "short_description": "Smartsheet is a dynamic workspace that empowers teams to manage projects, automate workflows, and rapidly build new solutions\u2014using no-code tools they love\u2014backed by the security IT needs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.smartsheet.com/trust/privacy", "developer_terms_of_service_url": "https://www.smartsheet.com/legal/user-agreement", "publisher_name": "Smartsheet Inc.", "support_website_url": "https://help.smartsheet.com/contact", "website_url": "https://www.smartsheet.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "637904817510091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75395602_306550587582350_8662774610824462033_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjiyNBPtjI8Q7kNvwERw8iD&_nc_oc=AdldoLD3qa8MiFSqC5U9s4ZRky5I84IrHJHN1LnF9nd8N15hU_YQ597tY3waQfyITvo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVqdaYBUJGf3v179tbYk5SxUI4jOvFyLyBkjWJKZDKcw&oe=69BD4B03"}, "is_concept": false, "is_test": false, "is_t
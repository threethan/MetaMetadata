0&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVXqfrgIIL0Q7kNvwGP2Yq4&_nc_oc=Adqw61fRdxQrP4OT4x6U-NXLbHnCDzqN8N3rNc2AMUEhgDRK2u2tZTFdhaqIRr8PFoI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLFo1zdx2IWTSPS0lmOB86P9h7-npnOVc0WDThn0gCxw&oe=6ABBB8AA"}, {"file_name": "ScreenShot00030 metaversie1.png", "id": "389174714272258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974796_389174717605591_562109749776539542_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDHrYfsqTEUQ7kNvwFjAhwF&_nc_oc=AdoASy6Mwt_H3yp57QhE4bL5LGuFHswgJg45PW28BJGp0XZ0SXMHvkyHK5gtn1zq-R8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAswEPJmrW0bxigWJQIrGKbk_AYt3-IDVBemRi5tmdQA&oe=6ABBBEFE"}, {"file_name": "ScreenShot00037 metaversie1.png", "id": "963682302463057", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984442_963682305796390_5006388219457284804_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gAWnt3N4JUQ7kNvwHQ42qK&_nc_oc=Ado2tdQj_LGbYUY4DR2YHwKDFFadClK8NpuC2nzg_wSCdth0-1I8onkpmyYr_gW0_rE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkyLOD6cG0tCuCN_r-dUpiccZei8SKzYB3Q23cT6JYzA&oe=6ABBE218"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRonderwijs", "keywords": ["educatie", "onderwijs", "rekenen", "taal", "wiskunde"], "long_description": "VRonderwijs is een educatieve VR-app die is ontwikkeld voor de Nederlandse markt. Zet je headset op en begin direct met oefenen. Geen account, geen inlog en geen abonnement nodig.\n\nOntdek interactieve omgevingen, maak opdrachten en verbeter je vaardigheden in je eigen tempo.\n\nWat kun je oefenen?\n\nRekenvaardigheden\nWiskundige vaardigheden\nNederlandse taalvaardigheden\nInteractieve opdrachten en uitdagingen\nOefenen door herhaling en actief bezig te zijn\nLeren in een VR-omgeving die oefenen leuker en afwisselender maakt\n\nMaak kennis met KazaBot, je virtuele begeleider, en werk stap voor stap door verschillende oefeningen en uitdagingen.\n\nDe app is ontwikkeld in samenwerking met ervaren docenten en is bedoeld om leerlingen op een toegankelijke en aantrekkelijke manier te laten oefenen met belangrijke basisvaardigheden.\n\nGeen inlog. Geen ingewikkelde installatie. Zet je headset op en begin met oefenen.\n\nMomenteel beschikbaar in het Nederlands.", "short_description": "Ontdek de kracht van leren! Herstel verloren kennis in een spannend VR-avontuur. Verbeter je reken- en taalvaardigheden terwijl je een betoverend universum verkent en de kwaadaardige Garlic Calcus verslaat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vronderwijs.nl/privacyverklaring", "developer_terms_of_service_url": "https://vronderwijs.nl/algemene-voorwaarden", "publisher_name": "VRonderwijs", "support_website_url": null, "website_url": "https://vronderwijs.nl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29375701752018279"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823366_3598249320326606_1029095852546103126_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3xc12MPWBUQ7kNvwHHLmhH&_nc_oc=Adr0uR7E1gLoPmugd7UsbWa6tKq7EEdiFrzyr5l7qYsDg7bEqEg_9gI4y5OZEF4kkzE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrxleyqss13dN-XAL0t9iSuQ1ebwU9e5BTVNWMAc-nNQ&oe=6ABBC940"}, "is_concept": false, "is_tes
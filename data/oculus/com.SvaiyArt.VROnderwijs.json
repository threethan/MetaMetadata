b=1-7&_nc_sid=6e7a0a&_nc_ohc=7G2uQYb1ymoQ7kNvwF48v1Z&_nc_oc=Ado41dcfpIE7QUcr7GWdcjeG28oQ-dW4jICQ0iAbLl1umfsT393YjOBv26TR19KDH04&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxsUjMe4jBluxSATL9VqOdCh-RMoNUP6QCvBKUl9axBw&oe=6ABBDA04"}, {"file_name": "ScreenShot00058.png", "id": "936291439039158", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_936291445705824_3530804419613602635_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8m67jscRhPwQ7kNvwEKZBLi&_nc_oc=Adp_-oTUOkwHduuEA7WUWd8i7mO1VUdb18NeG27Ifs8a08UDtftuY6_Pnuy57040zFE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGgOw7FTvR5_N2V7BwUd_CX_qr9JSBuTxMs-2MloDaOw&oe=6ABBDF48"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRonderwijs", "keywords": ["education", "math"], "long_description": "VRonderwijs is an educational VR app developed for the Dutch market. Put on your headset and start practicing right away. No account, no login and no subscription required.\n\nExplore interactive environments, complete exercises and improve your skills at your own pace.\n\nWhat can you practice?\n\nArithmetic and math skills\nDutch language skills\nInteractive exercises and challenges\nLearning through repetition and active practice\nFun VR environments that make practicing more engaging\n\nMeet KazaBot, your virtual companion, and work your way through different exercises and challenges.\n\nThe app has been developed together with experienced teachers and is designed to give learners an accessible and enjoyable way to practice essential skills.\n\nNo login. No complicated setup. Just put on your headset and start practicing.\n\nCurrently available in Dutch.", "short_description": "Enhance math and language skills with a fun VR experience! Embark on an adventure with KazaBot, restore lost knowledge, and master educational challenges that align with curriculum standards. Currently available in Dutch. "}, {"images": {"nodes": [{"file_name": "
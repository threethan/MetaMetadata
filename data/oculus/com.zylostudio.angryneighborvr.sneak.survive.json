_thumbnail": null, "display_name": "Angry Neighbor VR: Sneak & Survive", "keywords": ["angryneighbor", "survivalgame", "homeescape", "horrorgame", "prankgame"], "long_description": "Enter the world of Angry Neighbor: Sneak & Survive, a thrilling VR stealth adventure where you must sneak into your neighbor's house, complete missions, and escape without getting caught. Your angry neighbor is always watching, so every move needs careful planning.\n\nExplore the house, discover hidden areas, solve puzzles, and complete challenging tasks while staying out of sight. Use your stealth skills to avoid detection, hide at the right moment, and find the perfect way to complete your objectives. But be careful! If your neighbor spots you, the chase begins, and you must run for survival.\n\nFEATURES:\n\u2022 Sneak into your angry neighbor's house\n\u2022 Complete secret missions and tricky tasks\n\u2022 Use stealth skills to avoid getting caught\n\u2022 Explore rooms and discover hidden secrets\n\u2022 Solve puzzles and find the best escape route\n\u2022 Experience exciting chase moments\n\nCan you complete every mission and escape safely? Step inside, stay quiet, and begin your ultimate neighbor adventure in VR! Plan your moves carefully and stay alert as you explore a challenging environment. Every mission requires patience, timing, and smart decisions. Sneaking past your neighbor will not be easy because he reacts quickly and tries to stop you from completing your goals.\n\nEnjoy interactive VR gameplay with creative challenges and a unique hide-and-seek experience. Search for clues, complete objectives, and escape at the perfect moment while testing your sneaking abilities. Every room hides new challenges.", "short_description": "Sneak into your angry neighbor's house, complete secret missions, and escape before getting caught! Angry Neighbor: Sneak & Survive is a thrilling VR stealth adventure where every step matters. Explore the house, solve puzzles, complete tricky tasks, hide from your neighbor, and make a quick escape when danger arrives. Can you finish your mission without being discovered? Test your sneaking skills and survive the challenge in this exciting VR adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/zylostudio/privacy-policymeta-quest", "developer_terms_of_service_url": null, "publisher_name": "ZYLO Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/zylostudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "ja", "de", "fr", "it", "ko", "pt", "th", "es", "tr", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1346824121837763"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/595114885_1607201394414561_4525822449257302735_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=re8AJfXE_NEQ7kNvwHCaRUW&_nc_oc=Adoc3eaFRJFf7BpHVDMGqedVawzp8OlPddtSgb_JXxhEdzDZoz6GBKaB6exa-7cTfdU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg45lYf97_2vksaEZ3fhVmUWCzkIRimpd3azotPr5KEQ&oe=6AF9E3AA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Angry Neighbor VR: Sneak & Survive", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534
79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W03_2-X0ztUQ7kNvwFLKnz5&_nc_oc=Adq-NDbv-Ydur_9wNksZY2GIIJkru5kW1cfSnWUwdyiAsRxMc_9N-CPOGJdMv-wXwmk&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mhgjZZW5SSipU4JFwyuCp-gx0vASGh-cB2eXkYiMoMQ&oe=69E231AF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEud3Q76aqoQ7kNvwF0y0xi&_nc_oc=Adqr-lKwD4lyG56cU93TVqbA8YUAzR5Gu3xHQP6pqZV3URurj9Cib7PE8mtltq0iYPM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uUBPbKspC1nQ2JNvpGmUetSEWTNZqm-qN6uJczSL4dQ&oe=69E244ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sa17GQfAF9oQ7kNvwG9X3Gi&_nc_oc=AdpTdUxElbH5WJV3wCPAfZbxmDTy5xMpd7FiKmQbMp-TogPj6jF6rEUAIqZ6lS_2YVM&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0n4lRu961FSxDKIWOa2wH-gXPH6GoThC5udKK_ppfKMw&oe=69E23E60"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pF7708AHiWcQ7kNvwGV_0jt&_nc_oc=Adqj3icngYdE3h7bDCW1v8HnH4jq-e6ZYyWZDaMtxgopZUR5oROSGudbA5Lg23keiHQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7L4_rntY-h6UJdiGm74Ybe-3r0VXCqV8pWz3o6JPLXAA&oe=6A1AE22F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dL8byCm0roMQ7kNvwEdTqaa&_nc_oc=Adrrq5OtPcW54ldq4h-BFzk0OQZ-xQoIHPxqkDtzRJ_gmR-Jintr8Wr-DHwf9Q7mFBM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_zXqStvUI0XD_OBLJy7pBcoWTzPW0QgSeECaIIQUf1g&oe=6A1AF56D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Ib-41O8dXgQ7kNvwG29Y5F&_nc_oc=AdqQP8SlUk6kf9FlLh_W5XPiDIXbhx4kLUhgEE7bO-djqm7BGgy3KIcVjyoawQkM1yo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67oCZ33FxhtEkJc4vtngg-7a4l1LvfejU3tTDX5oHRtw&oe=6A1AEEE0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
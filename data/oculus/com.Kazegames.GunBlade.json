79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMzw9xDgMZ4Q7kNvwEJvQ2d&_nc_oc=AdqaTVZI6K1YSwj0JCEkDzFe_SJxo4TefgawVBEasKbAEGDsGnc_rvtc8JYdBEtsM4A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgexTVcfZrmSs3fgTW4XT9D0cEffGeb4PoqxCyuEUtCA&oe=6A68AAAF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Chk5aR76c2wQ7kNvwGWPcAB&_nc_oc=Adr483wyAF6Bx-_LzW7P-1RGHUJ0n2pGuAIXLK3UVFPk0ULrK-KuMyj-Ns_rnOgJ2mU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJUq_sNRcbvee9Pg_JD8uT5HQdsaPmVE9ZyA3B_Djfgg&oe=6A68BDED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJTaB7x-akMQ7kNvwGnigrm&_nc_oc=AdqqEGGmSXp1LfMb-fNuAxkgyRJCBs60SlrScXYsM6u4RJThMNHmGewjTahKh2Y3UfU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsT_7PEUo81k_m9w9EsTg-oU-MafG8xzx_FA8pmvK7CQ&oe=6A68B760"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
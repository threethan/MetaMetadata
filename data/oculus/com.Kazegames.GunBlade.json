79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZzsZiLGZi0Q7kNvwFD_aoh&_nc_oc=Ado1TBukoiCGRAshOnSJ97ckWyaVuoTMZTT99U-qSQQykJNaXVhEVtacq-ISBmdC3qc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IYfgxVKLEVDhkmrw6n2ac8tn5YQ2FGLPz0JhDcRXkGg&oe=69FB3E2F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=va3p3A43bAQQ7kNvwH1cjSB&_nc_oc=AdpP5wU_lh6FqL9dsWCj0HyqxKXqMs8809udDqNFxLEhO4WRcd0q76EWDFugOGwhguI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QkaAb6mVwdyMCQr7dfWZv8CNbq3JQD2Jld_brvCQnnQ&oe=69FB516D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zvq4c2_aw6sQ7kNvwG6dy9m&_nc_oc=Ado6l2ONsgZpr5Y_u7tbSxX1lTOQizaxm28sxiWR85Wt0EQ_8zirxVX6EeBvYLggIwg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_VI10AXKLdDXfzht8pz9qzhHh9peXbh1eUnqEW_2ZLg&oe=69FB4AE0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
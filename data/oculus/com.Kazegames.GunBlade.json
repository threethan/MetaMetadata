79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXA6s_FdxugQ7kNvwEcmtQs&_nc_oc=AdrsOr3Us-pI4pvJBp3SucX12m04OoodR0IQn03UrfkAEjNvwtbtdFaprc69ucuHU2k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFW9gS29s2yFbKULvXaQf1bux-uvhkoix3-ENdYu6TAfg&oe=6A787CAF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24iu7ZcnlpQQ7kNvwGebxHp&_nc_oc=AdrJivsFwoVtqvMkDFKWb1Pz11M7_gYxTZLf_BhJxxRRmKYfvFGvX51BNLUN2aJ6M9s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxBlTB541-1GN7tVGtT8kgZUmUTKcUqLuA126ZzcC5iw&oe=6A788FED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-CrKwVh6eAQ7kNvwFmd7mt&_nc_oc=AdoGU3fP5rg71KDuAHe63Tkj4QkE7pbXCGIi-JniyEYQc6IRBA_TN0sfClAosnVMu8M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExSwZr52Rd7vXrH1rQkiHBKT_06JMXfLExiYWvcvic1w&oe=6A788960"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWJlQ6arue4Q7kNvwG0Iql6&_nc_oc=AdrANZh0hFxG3oueAvgcEHA3PiMnCGIOkYRX4_CmuMnfy0CvsaecUsXJSODfNoOf7sM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJlUGASaCfm6WMkSy8VClxhx9gZ3RwWwKQFHbfnHbJ2g&oe=6ADE002F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5zpv4nG8qgQ7kNvwFNjIcK&_nc_oc=AdovjXSc75C6AjtLvPZKxVedrm692Vj2_oNmTJu8E3LwdXo7jTfYFYwF3Z1feEztlVE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBr2aJVLYxXgIXRS7LhpZjuVt8HuTlhyTyMlPdO9lEpQ&oe=6ADE136D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cP_AawejaIQ7kNvwHR02wa&_nc_oc=Adrqag2kM-LUuqYMrTUKgRlKyvSiZJNIgzzOuJQiOhPna4QI1HwCH13ht_x1RNoJoUo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBMjS13VDzCd1-uuYQRG1IYQH08LhUJKzuEau-3wQUaQ&oe=6ADE0CE0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
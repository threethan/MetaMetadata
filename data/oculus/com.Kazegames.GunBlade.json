79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1tfUoH3WvcQ7kNvwGfpNdA&_nc_oc=AdosTRT8PiVFnT7VLxF3QuuMR0OVAIuRbbhM0RPfmw8QvNGo-VwvBLOVXwsF2bbP5N0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5m3Dwb1gJrvvyISXVqLqhQ9sIWBasQ1zyzU3ZbESf3w&oe=6AD3AC6F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9gvqKF_khkQ7kNvwF2GTvO&_nc_oc=AdrrVLw1hWTUM00Jrk0SAZntNNNtPlZLDGJ3toKfcVnQCqXNEeGMeBqS7kjDDbyxRn8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNwCFzXUtabSBZuKfHN45D9hyNRg3htC4lL1L6snTVMA&oe=6AD3876D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPMmpvx8reEQ7kNvwGAva2l&_nc_oc=AdrFzw0HIWFtoWwGy3PjJsWFhtc2n4YYAvPnIlX05UO-KXr8nrBrfpDQ36YvjOwnNQA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOj-ftIf6d32-Vyc8T981KHs6Lp6mi3OgMeBjhJvLnxNw&oe=6AD3B920"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
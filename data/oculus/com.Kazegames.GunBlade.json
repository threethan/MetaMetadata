79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXK6ZHsYcv4Q7kNvwFCj_H9&_nc_oc=AdriASMsuKKkUlKYz4Q1xuQ354aIIJQhvPq5o70cJtouNdgucE2RDRPKQSOT-m2rYK0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGC4D-ZrHl8PtWtSkeXqcrGd8MHthv3G569IHTmTnOqyA&oe=6A86FD2F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMURe1Ib6b0Q7kNvwGdVQ7N&_nc_oc=AdrWYB2-nVInny_dbRKrSBm-cfvvp41Wicq3dBpZnqaAWts-BkVj2DWCo-iDYImk68M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEu6Y1oDHKhkxZrb5uCVvuNdHAQ9xniod-5KOYf1QsxWw&oe=6A86D82D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8iYHVDTT5MQ7kNvwGocBGu&_nc_oc=AdpM40enU48H6n7hp2Tib81aa2K8O0LBYpzdOj6TqPYZ0gFBnBV6VhA8lB7hEgldTkw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcqE1f9lL6v0EXotRLK2WUceoIY5DLatIzp1uzqIPcag&oe=6A86D1A0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
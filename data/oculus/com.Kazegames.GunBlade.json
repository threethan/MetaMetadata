79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Twk-p-_zwg8Q7kNvwEwcMut&_nc_oc=Adrh7r2NlJE2XgdYwHdxDEwTmTxbMej7ahbXgbk6K2r4wrdtd9iU2DoShgQdhioICVU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUdRJpbg96o2Wkg6uguu4r5D_wHlQ48IpjQHvDaaw5hw&oe=6ABFADAF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61k9ITdlyBkQ7kNvwFBx7ep&_nc_oc=Adq1woK33tqWACH7FuDqQPZMlDhrrn1__EdotKwOjhl4JSo3_hmiQn2UuXIEXuxoMKg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHEZxrHI4tz-x7-H2H4VFmS1OiwVz2JKNsJ21O711nhg&oe=6ABFC0ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdanZfT5SwwQ7kNvwGtgusa&_nc_oc=AdqHH3L7daxGG7HlOU9m-kZDoHnj6To76oEriDKSUwrVSL8WIcBrHAEwyHSYPdvY7dA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7ObFL4K6U-BGsfSCFaYboHqE1kyCQiKE-fherZ8MFeQ&oe=6ABFBA60"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
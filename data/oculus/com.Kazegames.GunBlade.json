h&_nc_oc=AdlXyGWgvlQeTZknE_aXPlYyT08o2DjM2ShkXiGMuRVwvu9r52lKG5wdoa37WFVXjZE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy2Jkm3mSCQ2PjRgz3mYkOv3A9lhMcRX7VM-zeEtZk_qQ&oe=69AC3509"}, {"file_name": "ScreenShot_004.png", "id": "700368917882613", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031504_700368921215946_1027723226064257723_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WQKKfI5ITUQ7kNvwELa4mh&_nc_oc=AdkdqqgznV4aD6nbv2akk9eg8cn4QWCoJr8XbIY4wT19LQYuMVJITZRrHCMHWx95yyo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxfxTkKu4HfAtj1dIf2sTLwVDEtFuHgsV1L9x6XvzCBA&oe=69AC2951"}, {"file_name": "ScreenShot_005.png", "id": "379186250808626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974721_379186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CiAO_eiAO10Q7kNvwGg14GA&_nc_oc=Adn3cyV3QZy4NdFC5IG7ih7zOUGxxUydKBHVfj-kwvW5VPzNrH6UwKJxhUfzbuLxS8Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxzMQXu5qpPn2NKUWV4K6P6LT2wJnJzHJZFVCsDKTrZUw&oe=69AC242F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJrZ7CgawdAQ7kNvwFYTgmX&_nc_oc=AdnAxE-KRn5VbkrXkOFhZxQpxX8Q0res_6lhG8pzqbZ1UsGPPEF4yEv0bwQrW4Q0ax8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyXdGoB0Yy6JuWSqd36RdsqFacD0XggmLfop9sFH4P8ug&oe=69AC376D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hi93PhSeyWcQ7kNvwEdmcPD&_nc_oc=Adkm7mqk0r4z97yjZHeS_PyGQUl-iJ3kq4M98q_NYCifwMMAMfSunbfWjy7xybz3OfU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyfozN5RZvNTAJQb_m1FWlIEgVoVoyNspKiyUSwQqvd8g&oe=69AC30E0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.kazegames.com/post/privacy-policy-of-gun-blade", "developer_terms_of_service_url": null, "publisher_name": "KAZEVR TECHNOLOGY LIMITED", "support_website_url": null, "website_url": "https://www.kazegames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1860698910795230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974862_4601295769971209_1079740940807270530_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&
79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bco_8WwPK0Q7kNvwHqEBZj&_nc_oc=AdoCgWyjeiFTyf_eSb2GKejxCHU5cb6QqFb41VS3PhMHANNv_9DLudolhZBbGpnBSP0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2H-MyPVKYp8vIK-SVz1YUf2kvfIF6xHAv3AAkSJ2f9rA&oe=69ECBDAF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SnOfpDTP_y0Q7kNvwGCaN8i&_nc_oc=Ado1nyYaZJv4ug98gLae2k5rNaodCgImP4r-LKizpBVO3CweuOjrsrZ0_iRXp-ksDPk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Zz8XQ9lA_jWqIU6GUwCzxjtjjwqvLFlVf44jHtlfg_A&oe=69ECD0ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSG18bkajvoQ7kNvwH56sEn&_nc_oc=Ado1HXBNe7in3Ds7AxiC-NrYxq4QB7TH0TGkJtXvYgP7IIzGPzav-g0sawMgKpq2yQE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1p6O6bWAQzZ1U9v9T-s8HYUYPgo3xq-walvuwANBCjRQ&oe=69ECCA60"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
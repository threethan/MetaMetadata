79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oc9MAfZe2FsQ7kNvwFxkTG8&_nc_oc=AdoINag3NS8BoFJIyhvVXYNYngm_9sRTW4_VmaXAfgaPCf7Vo-Y7QIyi1Y-QlcH5nTw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeslL4IPFT72B0HadKNzC5wtPkxD4Q2NN2jflw5SCbcw&oe=6A5CCD2F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgsvd9FG8RUQ7kNvwF664i_&_nc_oc=Adq-1uj8hXY_JNtmxLHSfY27mPvAEjC7KlQWT61N-uUmwzoIBlmPkvOiH1C9-OyCMjk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8qFXVYZ4Vh--WLFCN0ntvTouYOqm0ZwGjjfSsDJ9vkA&oe=6A5CE06D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1VtXOrFdgYQ7kNvwE3yuoQ&_nc_oc=AdoMRkjE5gf_E4eCWMmCRL1uRsajfaEdq36pJEpxKHBgoNv6Z5GvzctmiJ8OpWPBTQw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeThlJZLwBE6WTSsLFQYgMWjmMMWhfwKhnYm-gnofP7Q&oe=6A5CD9E0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
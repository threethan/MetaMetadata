79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzsQsIhB9twQ7kNvwE4rV4Z&_nc_oc=Adowg29NnUj1to4s3esqR50prNNIYWi6-aQEXILytBNd7zaLBgMKAUnU1XsKUzVpbgQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSW7uy3JY9e4U4HhAzGq6uZgFh1-lk_NqF08xCAtAS0NA&oe=6AF744EF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4M7A7nVxQQQ7kNvwEQ6md3&_nc_oc=AdoJ7No7m9viEROoeNE4_4b-64m6X21dVmrfHEFYTQ05ORlhbSmIyZvnaVPDa_BRpA8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaROufAdJd_sosCT5ISj3l3pv0q6LxTO_MaIxWMDNRIA&oe=6AF71FED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgQ-WiB4Z08Q7kNvwGy_wBs&_nc_oc=AdqOVt0xdi69kOsxv4sX8Ao4PaceDkKw6HvIEjy1YfRrM6dKl4S5nLo9cPYu5TQEQr8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzR5cWWzAU9YbJg4n5BRJ3EOC2tuPDqQZhfhI-CRzvSw&oe=6AF71960"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
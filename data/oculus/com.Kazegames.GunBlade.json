79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_jF6UuR5AYQ7kNvwG6EOPW&_nc_oc=AdoS1HK0DB3drOAP6TcO_xSz-7zMZbrgH-EIGUsmaNbjZzJRahCtpC3NrqgdyCVQc7w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8h8BMKPKx7ouRljA3DFzerLbv5gBPUQL-aw_hplQHd4Q&oe=6A2EA8AF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yr895Y8jW9YQ7kNvwGpvcit&_nc_oc=Adqx4F9-eYSQ87B1pWgI7UeoxPr7WJJocwMG5MX4tiPyZCJ9Eo7sv8HQr1MSWwTCMEA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Jec8zt9gF6y9kNkfOX95HFzHvJx8Idhq_Uzw4RvMivw&oe=6A2EBBED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1EO7vTVVR1IQ7kNvwFM3h_c&_nc_oc=Adp9Q6XVY6FwzjzNMXvLG1FrJqji5GvEaDuAsYTsUkCsPx4RDoomV7SZTDQWb6CPgtE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8x4-C_3xRFwPpRVZegFFcwB4e0Q97CksC_S5PA8CzJGg&oe=6A2EB560"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMBpKle20P8Q7kNvwH5Lr9D&_nc_oc=AdpUjqmJ5Lkf6MhO-02Exas47e6sJY86aCCcZA7ffH9N8zMqJgasUfpJt3tC59uwjfM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3VKJOB1TrN2-C9XcVSiE-S_58-bOAXMLaiR96oIE3JQ&oe=6AE5E92F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5gry-PYHI8Q7kNvwEt35of&_nc_oc=AdpWVKnFDomZuEbog8V65EA-cnginEc9RsmFw4V_DpyW_EIdnrqiBIVvyJpONDVKRRc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFzFQkpWAYWoX6zvlZqJzCpxcMm-jIYKUf7o1fcKApXw&oe=6AE5FC6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXJ8YLLeBGIQ7kNvwFsSZ7h&_nc_oc=Adod8rJTqidVWvG2v40kjEUxpkBliM9EanO-85khA-hLZZ-JYlJZtDga8VAdsg6qnog&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuQmuIFY65QFnJ4ABoho7Lq6-jdriwA8ZcTDDCzPPC2g&oe=6AE5F5E0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
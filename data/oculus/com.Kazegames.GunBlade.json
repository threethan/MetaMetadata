79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzbsG6oUwKQQ7kNvwH3pVeE&_nc_oc=AdrCtivyTXoA-SEQ1VeR8huD4IYsC7IZp5PAoPv9LSKvXJrubDZrmaXNvYAFkwHgYc0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WeRpeQ3gq_2UJuoP416dJmVuC2lVO-rfKqZLkBB8EUA&oe=6A3A862F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSKkFM9OjwsQ7kNvwGczNey&_nc_oc=AdqguEPNFMISl79ZCKDTPFjp5oONVNkv0VLG9G8Bqt9zXfNl0wIOAun2qi3eNjcQeJc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tmExvPZ1r5_qiEJAk9zU9IBJ94ZbPUtLjWbKsU4dEMA&oe=6A3A996D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGeK4woKgpsQ7kNvwGtbElV&_nc_oc=Ado0bD8_jpxj5ogqI21DZ9nTCcaz62cHLdxgIAIlLhCO8i78GYV7K75YbRlbju0aJKo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9b3pvCtcP4ClXtdFEbOFD32YbcWAf_3GkCBbC1DbGzIg&oe=6A3A92E0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
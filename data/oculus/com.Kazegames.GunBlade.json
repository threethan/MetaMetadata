79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ii8QZv3PoTMQ7kNvwEISd7N&_nc_oc=AdqfS3f7Jyc0gzVyvls5Uv4k9m22GIXP2OFg8OyRzhaXvyjL-lmPo2ZB3787bTlmu00&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hhf5l_h-9oI8nRe_E7qm8X1pVHjZxPWrEJZYvbfZfFg&oe=69E6262F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_d3C2zr6ItgQ7kNvwGVy_qP&_nc_oc=Adqvaku736iJH14YGyVfhonxoUSpbPd1je8S6Nc-tZ8S4_CbQB89GGYCCo_mx20HGWg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HMU_q6Wk0z3HX8VGOiAtsgE5oMAVQIwqTRKquw5cNjw&oe=69E6396D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6iH3j77V8IQ7kNvwES7vNT&_nc_oc=AdqHBuqksXApdopNBg1G2M_nV3I4XKIBYdMqzsxttEgeBzX7JCENoAfhqsI364jY_2w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ov2AtaL0DrPF8Vl8kSEjuSqKXXaXZYkkfjqL519CtEA&oe=69E632E0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldTepuC2m2oQ7kNvwGmYbje&_nc_oc=Adq4xXQ8FXku2cNDIf9iJqKGyVx9nDyPnT2_oWuRseRaQw8yW5FSgoTp-6DPhPWYzOg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6yMoSRB9sc4cJCUVeFCMSYEhPe9Hu8XGcN4G5658KqA&oe=6A50EFAF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBok6OtNDgQQ7kNvwHi1WXW&_nc_oc=Adpap4WCJAgOvhEWIuvdzFuW2zBmuNZ2w0OwuiFrXezsH2mAlqvVt8W3sLvMTerrhdw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcqtOATRSe_k1AAJWo4vtfEAt-AnboTk178UzfGSk4jg&oe=6A5102ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-ZzO9lZJQ0Q7kNvwGbVDZc&_nc_oc=Adpn1MR3-Bjn-8ZAG1hFg1TkPhkZj0hr3960A8Gc2sbsfG01MQ7U6Qbeqy4yfI7s6T8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDH5SnhXKZQntpgs_M_KScnUDxh8mxH7Stqs3CGRM3DTQ&oe=6A50FC60"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dviNs2b_lkQQ7kNvwFEg_rx&_nc_oc=AdrJcZ5zTDJ-h_exI2F11yq7Pu8N7OkY1BKmjxYo4KPd2o_to2G6aI3BWqUHRSkfyqo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af654kP-1n6q9Hnsi-g2IJ1ljrdI-DKbwzwrDWPxGs7T5Q&oe=6A1ED6AF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3A2hguV3poQ7kNvwHa0uRs&_nc_oc=Adp8nZuk-G9g_17iodKxtza0LTJbFknSlkUP2mGEErjUH19yD8LfPwqjNq1aqKV7OvM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ROFjP5IdLt1zMSsqiRoadLtOT8m2KO93tcGVZ79QCkQ&oe=6A1EE9ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kv36h--cuzMQ7kNvwFSwUl_&_nc_oc=AdpOwEI9FHJFNmz8Ve-KHzavfGtgYPLDdyQXgglmZFEAxxu8ksoMi8Rnsw1kdqiDHAM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yCppR0h6Oah5HmAI4yLXTf09cyoGqdh02oCz_Q_SK7Q&oe=6A1EE360"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
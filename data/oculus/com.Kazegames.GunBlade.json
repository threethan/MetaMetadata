79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFLJ3ClBQHsQ7kNvwH3xJVm&_nc_oc=AdpLl264XHRaWUpX8xSUrqPrKzM2RVD5yHW6CNr5sxdWQOom5KRINiiNohvyGRQhlsY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFO85eiZpd3hglzO9331zPy3U1S93VZTKLHm5id9sZ8ig&oe=6A95B5EF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5D8qUpLDSEQ7kNvwHukYDS&_nc_oc=AdrHWcJgZO_CDolAe7y0z5Sey8yWeoWHZKRNwU5BvoXVUKvbJIKBDg7Z_XwK8dvBSAY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOPuJx91ORmcIfVvp7lW9_LpfPFWlpOk7VNN3Dx_a7FQ&oe=6A95C92D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mI3JyjMTsSsQ7kNvwEu8WUl&_nc_oc=Adoai0FqZLAqOlLKMf7mp7wLpNgRhKZnatjrC1LB4E-hoy1NKovWpL5zQ3C3_Jk-GfM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDlf6sph3Fib8aakLgY-W1F35AtohgG70PPP7lHrqpZw&oe=6A95C2A0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
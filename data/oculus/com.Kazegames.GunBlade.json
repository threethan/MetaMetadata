F&_nc_oc=Adnqz0qFkTvETFQk_narZ4cAUNobKxs0ebLrR1uLbuvnWgLE0KbU1kYCYtkvLHrB_b0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzLrn2S41nABGXGUEo7XWLUxO2gIlbFVvU5QpuvhQ1iGQ&oe=69B2CC89"}, {"file_name": "ScreenShot_004.png", "id": "700368917882613", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031504_700368921215946_1027723226064257723_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjmKxDahLusQ7kNvwF_ovcx&_nc_oc=Adk50kgXTTLST9LJLaKR0fSTiNGmPpBa9e6HcA4X4JFNW107tp7Enmnru2XLT-oyXkg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzqc3JP-oE-wuSugMIWANozAoOix07HsaH8kxJlLNAl2g&oe=69B2C0D1"}, {"file_name": "ScreenShot_005.png", "id": "379186250808626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974721_379186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9dFUTtzHxYQ7kNvwFP6FGf&_nc_oc=AdlR1BeuG3p_JgH9H4SIkip2hFRjJejkulzqrA_D76pKQSkPp7tnHL2xfGgYMcEv8dI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyMAbLf78I6a81I4fnL7OK84oifwDjh5-hTm7wlcczyEQ&oe=69B2BBAF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuHGfswee4UQ7kNvwH7iVeC&_nc_oc=AdmrGMWFnAm3AjkD2nuuMYHaUkth7V7-oBT4aXsKXlh_eqrfOtalz4K9uWO9T74AwbE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwmS8qDTrPmcwn_QE9jNTng2fHaj5KbguEvWsLov7OfQw&oe=69B2CEED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvvUfCKH7IYQ7kNvwFJ4OfX&_nc_oc=AdlQT3Idv8jf12j989Lo5LkCyR4WJxe1nM7sQoBq3EK0RsQiuVxDFi3jkFcGUxVNjJM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxR0Ggi4pqCl46bb1tX9viaO8khD-FNkkfeXld3j1jhKQ&oe=69B2C860"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.kazegames.com/post/privacy-policy-of-gun-blade", "developer_terms_of_service_url": null, "publisher_name": "KAZEVR TECHNOLOGY LIMITED", "support_website_url": null, "website_url": "https://www.kazegames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1860698910795230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974862_4601295769971209_1079740940807270530_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&
79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7sG8zRumcTAQ7kNvwFvfXER&_nc_oc=Adol-yNIELAHXR-7YWthKiI4lbditbqA3FjgaWF7pYUm7slQsoukcytxthskiE17Pq4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcbb64zEtwoiAC-0CI0GiAhkiWhYvRCCyudKSXBCpcGg&oe=6A9037AF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aT6-Be721tgQ7kNvwGwp-pN&_nc_oc=AdrNj6s1Mzc6yemXokEAnBGHgCiQMYCRWWAU1AySlZ5bqr46OCm4LP2smFvbLz3TjTM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0QIrjfjZ08Bm_-G97TDIUdVzhu5zXGs9qsW-vj_eSjg&oe=6A9012AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqZvQGVMlW4Q7kNvwHKdzfC&_nc_oc=AdoyZ1MaWwdVHmg9EFNmpNbCp1DLYxk-znhZbQI_yOHLBYKvIjURJG9lGTQxVhxZ78I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOZNf_GNIrCtHKxmTTHwzQBGL8OL3I6udtku_9aeB8kw&oe=6A900C20"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
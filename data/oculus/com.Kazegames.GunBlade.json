79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Man2fHq2f9IQ7kNvwGhLpow&_nc_oc=AdpJYGMMfPUcOEdurqdOB5u3zkAZyPCe-J6tRrGHiMlLRCKCP-JBocNOPHMtFpXdMxQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zCF0hsm_eP8QGHM4RkWl1Vh74tLxYlH-PAyMkgqZnFg&oe=6A26BFAF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3Uyz_AiYIkQ7kNvwEkd94G&_nc_oc=AdphdfEzcFQCIYzk77bdw1CLUeYvdEAWZJodw1UiePAxehgYwiM5zVjhSqC7Qpnn5TU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8N9FTDC745H20ajYDCV6rR85fjGCEcyZDoMZ35pbuW5Q&oe=6A26D2ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVTelejPgGAQ7kNvwHOMvvC&_nc_oc=AdoVs8SdvMh6wcfpYQbclxxDg24hhPzoq8S2Mide8MhNm5O4tdg_DJwe5dGNR70XjPg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tUVBqPrpFVlt3sEUjrCwBdp2Ltiuo9D9N5rUvlSrEpQ&oe=6A26CC60"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
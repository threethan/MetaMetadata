79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bco_8WwPK0Q7kNvwEz2O84&_nc_oc=Ado2pfBLTm6eu3_cKjJ5WrR89Zr4chb5WX1xq6zN2A35KrLaPY1nbIT77024B5ykOp0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qo7w6zaQdWDH7ceKp7OJtaxX8i-4stu8cM-gMH35lug&oe=69EA1AAF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJeWKFeSiQYQ7kNvwEgvkUy&_nc_oc=Adq5Kf1XyQeheoAsj3NuHNTXQBouv87CshhzOCA1xvfinxuyN3FL0Plhf4Qy0Vz9Mt8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0G948au21MWgueYjoYZgGcwkhi7oqiVRSK2MkXMEzxrQ&oe=69EA2DED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCSz7WuUQegQ7kNvwFdHNCb&_nc_oc=AdoM_A1y1uG_2u8zzOkpa9nzKjoQUfLGPS_Xo-pKTVc3XgzmpTTOKZYozglZ0Esaj5w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32B0fGntz-ooM_8CuHFgobeKs3h_Ki1_aOsORo1LfjZQ&oe=69EA2760"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
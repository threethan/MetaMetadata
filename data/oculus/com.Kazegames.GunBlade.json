79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NusdXwSj4v0Q7kNvwHohx4R&_nc_oc=AdpjapODUNC9hhhn3Hb6DaceXKatG9EOFWCY93D-ptYQWg_uBDigN9w0Q9hoYXUfraU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0dJ2vRRogkg_tBRPaTGCelfrCEOsYp4lybZzUurjRpw&oe=6ABD0AAF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61k9ITdlyBkQ7kNvwEWM5ff&_nc_oc=Adrq58L5NYnDDG7k5UNDkIf8hvOPWof5WEUcpflh7HgBATE-PYurHvRQG0NZx3uClCM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEx3lez-HZXu22imHUjPT1OBaTBbGf4GaRV5xVTufsGQ&oe=6ABD1DED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdanZfT5SwwQ7kNvwHnnoBt&_nc_oc=Adqd6NXrcsZDt4o_58fEsiSHahHZsCywl_y89bdFUpRMIbK_jlofdbevtNDK9-DeGYU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJq0dhBoVg0KLmG0yP0Me2egcc43twnZlhUUAsWmYUcLw&oe=6ABD1760"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
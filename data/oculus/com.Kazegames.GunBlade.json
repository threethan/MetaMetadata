79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZzsZiLGZi0Q7kNvwGnN98Z&_nc_oc=AdoB4edtpdAzzHMGxlYf926n-drXiOjpgMd0C9qnkCJd11SIhz9_01Pmdcy18o_BOkY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fE2B8JgdpkL2qRr24RNMX_N2itPk3r5QgcfRnViKWXA&oe=69FC8FAF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=va3p3A43bAQQ7kNvwE9i0DL&_nc_oc=AdpqLdIhEsdQtW3lr3fksx-9FWw0ch3567bO3RZr-00t7MqncztEmuT2yiVhT_NeDaE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7p7e54MmHbW9JxD-Ss7PC3jFyL0gsggG5ea9ZklEo2Ng&oe=69FCA2ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zvq4c2_aw6sQ7kNvwHKAa7Y&_nc_oc=AdqEW4xdYybOBDyjvocUsm3qyUEWk2EhZSAr6Dn4WSJvuTCCSn9sl5fXYdZLKli1l0I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af719YTplVTNLv6TCkj4f_4UbSuYQ58huTUaBh7nPsGaLw&oe=69FC9C60"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
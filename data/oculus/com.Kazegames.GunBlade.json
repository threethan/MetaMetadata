79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypVm2LiNe50Q7kNvwHIxvJd&_nc_oc=Adru4cg9hboNdFeJltZjwRGQnD8t6snI5Kyt20j0DZzdpd11YkqGlrA0f2Ixpe31dnw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QxbM8D9aLTwXiTIyvJVEmvo7OmRSIJaWdUvTXpUmwKg&oe=6A241CAF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xyie8-ivmg4Q7kNvwEjdc27&_nc_oc=AdpbTP0cAIMHGgIKPuG8rZymFlyOprpC4VFV1dwC_rO77soqshoIVfFppsmsURuUCX8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af918wR9qeQzcIVWWb49vca7qmOppKbPjUi2b9Tb_eyN8A&oe=6A242FED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvY7JsTilGcQ7kNvwFojMNc&_nc_oc=AdqkNfp0jKw6iZOxn84DmPNWJpRPSsOGzI6_wLqSc3ssKtn0hQrYU-eaRNNFtDuEY_8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gpwQdbyPS64CnwnQ49TxVhUMsZYkAFaUYni_rVUOpxA&oe=6A242960"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFLJ3ClBQHsQ7kNvwE7xgb2&_nc_oc=AdoxLhNyOU6qeAfy8VtEsOGQiN42rHwXKZAg_8XeYekkqEIstyiTkE_YkwcGBHvyT1Q&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0i0aIDVUekneLIOeJbmRq0j8_9LpUubiCdVBzAcP24A&oe=6A942C2F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRcJYdYccXAQ7kNvwH33Z-J&_nc_oc=AdrqCBYBoHF6Ebc8uQZApKgdo_-BHI5l59FhhRBsG4uYsgSKuFquZGTAPpMENKZbFJ0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4zFqzwvRcylzuUE0A8knNWZ3Qenir_Huuqy8yq6TTdw&oe=6A94072D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=be5ETOFNpI0Q7kNvwFUoXlC&_nc_oc=AdqeqZZx0iK2LPcNEQXMmzB1xrPb6lK3xqdTK0dH46g78_HXZRFU4lzzFeGja8sOoHI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuFRR_o0uqolXriFwpDVFfGhne_mQgUqX_FLEb99HUmw&oe=6A9400A0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7sG8zRumcTAQ7kNvwHgz41D&_nc_oc=Adqi3y9Y4WHFPcbDYGimchpFyO5GbCeHn774NLAThigElcPbZnt6i9chFyQ-9syOweY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFerOwlRsr6GRNNymCO1ZPs_pGpRUi2CnTKnE7Mj-Psdw&oe=6A91892F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRcJYdYccXAQ7kNvwFAXHTr&_nc_oc=Adpr5g6QxprSqHSzHryNqK5f0wMJAf-W6mvZcQ8czCEq9vq1MXV-DBo0EWXL0dzWJ90&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYN1k3Eg1uZn38bONyoNswWi3rhGToNEd_wwTxgbO94g&oe=6A91642D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=be5ETOFNpI0Q7kNvwEKhRAH&_nc_oc=AdqDl_Zh6zfTrqO7JfFLdGRhqp0bVi9tecrfCncd4hRurkd7Jo4uje4ntbp6iqWYXAE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQjTK0B_NEKTSDuH4OWIC073kRC45yoQXznl-KicG48w&oe=6A915DA0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
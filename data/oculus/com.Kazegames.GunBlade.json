79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bco_8WwPK0Q7kNvwH1kjLb&_nc_oc=AdpbsSIgnxaDX8BAHTi5NC0i_39snvLub9thPI9MzEnqTrApEOG3mXri5GQ26sE2yvQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fmCTG4-_n3cAC15Yp6brlotMUKHs-Bv1i0JfcA1nWbQ&oe=69EB6C2F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SnOfpDTP_y0Q7kNvwEtpelU&_nc_oc=AdoHy1TsRgnpRD6b2RbkDvp8a6_2xYuYrsDf3c9DsRc2JG_zf3Tv-6kpOQYoCrihoiY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34hvT1_FEIhpDrct45sOxUsGmTUR3L61H_R5WNq2MOoQ&oe=69EB7F6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSG18bkajvoQ7kNvwHj5rtC&_nc_oc=AdpEyLsejCILtcFWVShdVYdWpPlTLEPK73-prhvSLkILGuHhxC7BjfCRcaBophfFuqU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1aNq66MR-9ZHiXi0S1i8uq-XEOIywnbghk0XI_zLVURg&oe=69EB78E0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
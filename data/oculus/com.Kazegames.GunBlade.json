79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZhYka2hO10Q7kNvwFmdZnl&_nc_oc=AdoxEPrBllSdnlFcrKwBu9k2Fv9yeh3UT0GibLXZXx5EKuSd-ilgxuq1Jy1GdPV34Y0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wNtkWaRCOyMGtb8TfBWmQRWMRFFidRVG3IS0wbw2mfA&oe=6A03272F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TaDhm0Cgf_YQ7kNvwFK5-ie&_nc_oc=Adpu9ocPveUtSXlRgr_asHgMfk5OOSkR3DdUFz3Ns3FMaGh698D5dMnQ8yl47VzO3X4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uesRSPIo-2_SpyFQ73sFX9rLuMSFqWvYBafJjdSL7mQ&oe=6A033A6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rekTtMpI_C8Q7kNvwHryvqZ&_nc_oc=AdrSsdPl1dayqfhzl_Qie7l5PxQ23yxjUZsRxbqhGHK2tXq6O9ayjXc9UuFYYLjWXno&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CCoINu7_rJ9g-wgONvpp0xtYyN2hgr2HzS1SjA9hwUA&oe=6A0333E0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
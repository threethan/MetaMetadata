79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grZjY_UNuAsQ7kNvwEKfECo&_nc_oc=AdqivOLB-9z9p2YMk_Lyzdt4_ASFcrDQKs5O2BqI2EzOw4vXZUij25P9femzzPfMJKI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwQTeLv8vVzkh7Ej6NP4zuzF269mFb8gwDuI3hZwUftQ&oe=6A5635AF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=So5hUYMX9moQ7kNvwFfct0N&_nc_oc=AdofRJkgJCPDxrPpo358jClP7gpvaw8zS_IoDmaXsjGnMtdFUmRGrUS6ySAUnUiVRao&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKcEx0P0BvZbiziih7-IqSKJzKVUfPl2K6A6IM2eeyBQ&oe=6A5648ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rc-R68_u-IQ7kNvwEih5C5&_nc_oc=AdrX46GCx_PYihVJoaOEeKe-acIvuFco4NHuCmhhjLGNb4gfbdTNaJhWbQV5NLvG_Dg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAg7W_U3zKopXnN6BTPOK9e5t1i3NXq9QpcCQdXeJp9yg&oe=6A564260"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
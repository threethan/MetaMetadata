79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Man2fHq2f9IQ7kNvwFzY-Ww&_nc_oc=AdoBzeqOsTofnqHEd3W4d7p4-STAz6DbzLIUapH4egkFcsHPE76UyzwtQTxOqRjiNA4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-g5bfjZ9_V_If04H65VUEX66kSvKt3M-tQFwk4tKi75A&oe=6A256E2F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xyie8-ivmg4Q7kNvwHv6xb6&_nc_oc=AdrOolwdmyhfGeBDTJbcGZJwFab70E9ISYdjkBTwIO3j_AP_d1no1W8bwofgu11iUoE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ydluy7Otirq-wrt2XZ-UbWJerp8DSXcGqfKKEYWbxRg&oe=6A25816D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvY7JsTilGcQ7kNvwFwrSK5&_nc_oc=AdpVkkLB3mBNfh1wiDLFb6aO-J5unCgZ8qq0QxyMpXIdmLROIdOZSQfwS6Tg1P5oFcM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8va9jrNpKeGFwqc8O1DWpTakUyBa1QmQA6gCHJ0Ddzyw&oe=6A257AE0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
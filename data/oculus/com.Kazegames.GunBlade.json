79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cf2IbtzvYqsQ7kNvwF5QvrK&_nc_oc=AdqVJzusoNPGNLZfbJPQR2XoxS5bPzEZWYNpoTUyE0t5-4RJvlGGJMaZN4sT3srQk-k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMn35RB2tyWP7OyAtSk9uHrLSsdp5KaC4u8e2Tfy4dtpA&oe=6AD25AEF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9gvqKF_khkQ7kNvwFUMMbR&_nc_oc=AdpvvACJKa4yP1r7kb8LMtUKI4d2HMWu5SKRzZxwsQJOGJ1eXsjQZip92bFdBgTIjRM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHAkh6DECMWgYthjXfNFxy3QWRVM0X8KDNHAONIrk8oA&oe=6AD235ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UniV15MpYRgQ7kNvwGY8wsm&_nc_oc=AdqIrsZR7XkeGB_0txPeFaRD55xE1AscuvGhDmF0oy4yh52gN9khfDfLsDIF71FcKYw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOa6ifHiwaoWTx202kSXm7qoQKm01_zoxT0TcknNW4ANA&oe=6AD22F60"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
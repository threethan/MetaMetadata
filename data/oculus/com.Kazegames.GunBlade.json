79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znokc1xMPrQQ7kNvwEtD925&_nc_oc=AdrrYhI8JBj6uol0kVpQ87XkwtF0KdLxMo3gIKdhMuaZq4cV6I4waR_ZptVsfdxiwHg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zWH6fYtnLiWgKeQOUH1AgQbaCpxncgnYPKrQfP_tipg&oe=6A0DB32F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGSEffRkhpsQ7kNvwEqp-Fp&_nc_oc=AdqlsyMRrwghE5xWZpZiJCSZZf3ZnxOmvRxf5f5fA5oMx5nbQzamBLQA9p8Le0u3xTk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7e9hNjHT0sUnXhihqv1N6nixuOIU40CADof5P7t-niag&oe=6A0DC66D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciol7ECmvlsQ7kNvwH1TaVO&_nc_oc=AdrX-cAh7GFUeccgP2HO-uFHo9irLuHFvGdGzx5HKjB-s7AMLqsCExXd7b_vUlRegEk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56OdYHxc0y_XlkXr97AVowM4FM4Q-6oxhvwOj3qcoLqg&oe=6A0DBFE0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
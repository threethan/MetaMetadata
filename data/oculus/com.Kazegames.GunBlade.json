79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vW04XttgAkYQ7kNvwG54uUv&_nc_oc=AdrUA2aDfNE-BR4qVh7_z0IXS_xJuf_bIqLBANfNBzGLT1T0DKRwE0NhDuE2_ICzhpI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OqEXIXaCLhI9rrMDksNMvo8txr94O7ZhZklYlFfovAA&oe=6A47B52F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRcJbjXFvigQ7kNvwHY-S31&_nc_oc=Adp-BtB0tHDfL5X7Qvhbt5cLrkxYv_8uAGm9zR0pKJ2fDRiuuOVEwVAR_ifXlX7H95k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9duwScwwZqmkHsAFDdor3eY2vWSolR1QUW9wbHBet8Lg&oe=6A47C86D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dM9QD5hW78oQ7kNvwFj1aOR&_nc_oc=AdoENgUovxm6uLZlFvmbYEA1XKwxLvutOMtWlvLXtA-4RwgGO-KAEH_PvdB6D3qE4Cg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VgzzcdqJLR6QWXxYsmXEy8BhR5Nac86lvQuWWAb1zgw&oe=6A47C1E0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
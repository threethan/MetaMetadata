79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EylnbJ9ngDsQ7kNvwGsfxLv&_nc_oc=AdqVEZHK87H5783PVzlb3RemWinOMEWRP666xicS78X7XAREpaj4z_DfQPLiMHJWTQ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vDDRyzkhR-ezy6cK4I6i8Qg6mTNTfu7H06ErC8CcCDQ&oe=69D25FAF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sj3X8nHPqToQ7kNvwHwd_lY&_nc_oc=AdoOtFwDmBqVNw_xUSbR-SnkPpa04S5BFqfTFzjC6DA294KjgesPEqgjy_P8t7_DYn4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YkV9OD0CuA_4QeoVOZmFIhx5QMU-1n0ePvhkW4dfedA&oe=69D272ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXvdoLsnIckQ7kNvwFW4bmL&_nc_oc=Ado5o_aSk8BJUtTeP8lGprL6HD1Sy0mqNWgeBI3c3_fjERBLqfFzmE6pR17nR8mXj4o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FIqll3LZG-8j3ayt3kvLJ0sF54XHT20mXrzZi_1gtbg&oe=69D26C60"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
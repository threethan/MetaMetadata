79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myr49dPVG9AQ7kNvwFFlxcl&_nc_oc=Adpqe6PHCb1INPueee9ttFlT_YGwrj-qr4fY78A423gqRBnsbfDyXJ3XAYOJfiVAn2s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhwexxszvcxgsFaLvvC77TbmH4KaknQD6iIysV9XdPaQ&oe=6A6C9F2F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvNv4Kua8DUQ7kNvwEhsNjr&_nc_oc=AdoM9IMKBP4RWEFyWh2QXwplGk0-DmkS6vYZ5c6HAuatmO8VZWS9G5sZUN2cu-PcKbE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnm0_3shSFuytGjBsV9L5wExfECNggpD6nNb20d9_riw&oe=6A6CB26D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dl3BPHZHyAQ7kNvwFDBg8w&_nc_oc=AdqBxDFFFhu08azdEnvGkxiPkIRLkBIjd14Gqt2uWPCapYpyHvczGVP1jJJpl-71wUI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmhDCvuYx61PyfSJUxLHHLkAxaeZDbe34Cj-OeoLSttA&oe=6A6CABE0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
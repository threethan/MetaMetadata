79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlIehn3K8egQ7kNvwEf4rN4&_nc_oc=AdrEmeJNkJX8g1nyPuLvcIxUKwUrS0Nj_WJgY4Cnx2fKsZ-If7CsL_JGQawnOJi8ovw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mzYMqCR7903f0pt6kCcrqoEmBt6RJibgsCbo-dN2GCQ&oe=69DCEBAF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMt2pdJ_WZsQ7kNvwGr5zV_&_nc_oc=AdqUFFSna1rD0Ifbh2zYgMdq1QNI8Aida3lyOoZsZdFZcIBG6OCY99hHc0v_NqIQo40&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zY0B6U-rX2pGA-Vwyt0UFkn0ovcGI4Ka1O26FoYbGig&oe=69DCFEED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBEyarsXq4UQ7kNvwHEr6qN&_nc_oc=AdoqH8zdveHahymJLL5QkhULdK2nUDsYtpoBjPT-c2rVb5OzhozE3ZlmYmlGOjviTOY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bZJ2LznnLKQnKArnXHaMMcbhaMNRVxxHorlwCdXBHEQ&oe=69DCF860"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
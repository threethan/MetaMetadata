79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ky03tzhjIYQ7kNvwFR2CSm&_nc_oc=AdrK8ptv334vo3cE_l9WVQ50-rcGrDF-IeAij07QEiK-YOQw-3ZmdzPhCOsO7jQXAr8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsg9HjTgh-UEFV4_B2uA-RhjwcN5f4-fe3Kq1P0t4wTg&oe=6A4A582F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2yq33GPorAQ7kNvwGcIe0D&_nc_oc=Adq1I-Xc-57QjsTQLpQAoh5Tbr6p8vHvchli8FLQWTbV5YtvVd4abOlZZC9IHqdAJ3s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlnU3dWocGYNqwyfUCUs4rDt8Ntd9LbINVVr0WlNAUFQ&oe=6A4A6B6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wr0E-1L2qA8Q7kNvwEo_bz9&_nc_oc=Adp7rmk33Rn82ZWeYdvJhh3bRASFgXE03JlccRbO4L6bjXOks2qwA8-V1JfkkgtI8-4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfaggrTpVesztP493KAkFAUF4QE5rtxVvFRVA3u4ZGXg&oe=6A4A64E0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
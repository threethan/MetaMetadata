79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlIehn3K8egQ7kNvwFWU0l5&_nc_oc=AdoHGPCU3lMF3at65KmpAZ49yk6jcOx5upime19Bja5nocHtT8V1agtV1L7-8UQd0p4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af371MAIiBd0IiNCf8An4s6RcJNT6F7EC2WogObrxpPxdA&oe=69DB9A2F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMt2pdJ_WZsQ7kNvwFg-p82&_nc_oc=AdrtDX-MIW4HIL-o0x66fCa4kxEpg6qxaF3sAkBVzjO0EV2_PLCYhHN4CVNa3hgmgI0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hAvjxPl5FDVnPUJMeveUNSXKF5loxkbM2RHIgHUv4rg&oe=69DBAD6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBEyarsXq4UQ7kNvwFqFTcS&_nc_oc=AdqKkzwL1MDHiNqkUkLJM_6Wa6ZtHcYsAyoE1RY1Apuc4b9bJsY4uY1qVbMIC8V5uZ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0X_Yj3Pq7N-T9-4hWdeK6TiHA2Ts9qxhEbsC_zcirgTw&oe=69DBA6E0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zOW-GzRhEsQ7kNvwGtv4Mn&_nc_oc=Adowf8UuKmA3NLkVdGPn7wz1_QRXTNQurKIKAZ9gTwNwknH76XAeuWpAPqFaRB2qxB8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLQbrGn4PulLhW3PsDhGQjol09-dd8wPdrg8pVibtg6g&oe=6AEB2F2F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAOeFXo6_z0Q7kNvwEuh7q8&_nc_oc=Adpaqa3JeyZ_XcEgGWpMCGOdfIBrWeeSoRo_8IjBFvou5Y0jDVl1dcBK9k2hQpF5Jo4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3woxxj-Q_nu0g-rvpLcbdSJRxoY1ry-nSl9G6qSnv_g&oe=6AEB426D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEK2P74n8hcQ7kNvwGKhfmJ&_nc_oc=AdolY3n7yZicGgf03MAKSnLkdX-VjVxg1bRtZ8TzAArckyZiU0OwqOQMT2tWJiuq32Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSV7jJ9E26JM7XfyZQVwg8yseEwZXtq1eLaOy52Ad5sGA&oe=6AEB3BE0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
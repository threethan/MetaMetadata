f&_nc_oc=Adk2briJj2QRTs2cPVMmXpBbNpJRiABOjGa_oWUfsRtByoDvrlfZdOMY4jtILK6Mod8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwvtRoMNdDBhWwmWdVrCv0F_5MohWEQeZb9WRWUpPQu8w&oe=69BEAA09"}, {"file_name": "ScreenShot_004.png", "id": "700368917882613", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031504_700368921215946_1027723226064257723_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CayZrNu6yywQ7kNvwFCgeP-&_nc_oc=AdnboZCBy8tKlMJBfOg6siVuRqUnuaOWCI5KujtPsFZ3x47c6BiNHS9J0gsL_jymZhY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyI6MfYqfjpJUzP58t-2-UfzXskCpDD17W2MeNRhDjHHw&oe=69BE9E51"}, {"file_name": "ScreenShot_005.png", "id": "379186250808626", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974721_379186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ah0BdplvDcsQ7kNvwGNqhZ_&_nc_oc=AdkZbRc67-iu8zhOQLDAnxolX_LeVZxgxy1bLHUK628lxyfTmmLEdL6YVqm7gAxC09A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxqnSi1KChw0VK30ywIzuq2ROLh9Dm7lpPMmd1jrEmnaQ&oe=69BE992F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozI2XFSHLKkQ7kNvwFH3B2S&_nc_oc=AdlA5ptovxRqq88dk6ZnUFglknDmS6LDb8Wy3XqmxfnLMklfs6jvHfT7b78AjJ4Y2Xo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3ldBBu6yibCuhCWUfmOYMzRtnniYKGiGRQdVRmVRmUQ&oe=69BEAC6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQaYUpk68TEQ7kNvwGd5zAD&_nc_oc=Adnxv4zmkQkY_y0GP2YsEsXhyspXLAyzsST4sIQEMUPDpJew76ttoWQnOryfqPrnOXc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwEl6zguuJjDjRoenZR7srXDR_IzGZzH-Q6bPJTOTubgQ&oe=69BEA5E0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.kazegames.com/post/privacy-policy-of-gun-blade", "developer_terms_of_service_url": null, "publisher_name": "KAZEVR TECHNOLOGY LIMITED", "support_website_url": null, "website_url": "https://www.kazegames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1860698910795230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974862_4601295769971209_1079740940807270530_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&
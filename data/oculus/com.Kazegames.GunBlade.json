79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZ6Suv2i4_UQ7kNvwGvIbhc&_nc_oc=AdreaFrxBkG9V_9gt3uop_0AehqMbpuKHLYe6G9OF8bSzjBHW43tbuAOQ0LwPFlyJHY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6x_pmaHwMpCGcmcVKB2LXt_wIaayWzdTBOt4Au4WfRdQ&oe=6A144AAF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRjkRIu1wb4Q7kNvwGuayrn&_nc_oc=AdrK9Tis7pDUYPdUV0i7p_T_dBM--VVqAwwRPiQb8CU7GOq9pu_27zEoGNoH9Aah2Zk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lAMogXYyiiC5tiykP1sSW9F-2cBCftJz1Z6DHDqzGmQ&oe=6A145DED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXtHw_EB-A8Q7kNvwGTO04z&_nc_oc=AdpNXGKZTCryDlIQukr5_C-M6e2ZB5TpPC8fKC5tRRp5AaoVsg6s4E4esWgNYxQhfxE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CpCBH5gW6hNqHyqMXx2QcGsh97ZTG8fynSjRJN6h5-w&oe=6A145760"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NusdXwSj4v0Q7kNvwFeVQu5&_nc_oc=AdrV34eSvDVWtvZ-DR7ojzXUt4B72dOksEayBjiMgHnjbeL20gML_82ZoLHnC5PuR44&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcFu4YPJPyAFCTKAw9YwLYnH4YYHr8FEG9pdVyfbIuDQ&oe=6ABBB92F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmODfgh7IiEQ7kNvwH8tnOR&_nc_oc=AdoMR6Tupi93Nd0CkgPToxxRW2I_U6TBKTw4mv6ujBfFtMyerABLuIAAvz-1D87hVMI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQWzEr6YFA831QcTeAE5rkWuXwNxSyGSN1EoHTGyHtyA&oe=6ABBCC6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLHPC5iKLRQQ7kNvwF4Y3WE&_nc_oc=AdpJwdAY0Fs0ug7YaopEaxkTFLejrDObOeowlUEozQDwKarlnBsBQpvgJPSQq3DWmVs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaDw8FoYBngnhiXHSr2298zYkwjAI0KBS4WlneAeGEcA&oe=6ABBC5E0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
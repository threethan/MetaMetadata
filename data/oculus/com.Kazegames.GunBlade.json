79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XzrpD1dldQQ7kNvwHND0TH&_nc_oc=AdrbO2vs_JgqtuCwWlB0jJotX4Z4NENStR8Cns5D_Z7kyNo9sNXPSBNaY3hmyXz0rAE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1eLvennMlqMBq_mWM2Y59jxQyNRJojCuGhRPCvGCG-g&oe=6AC8E82F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmE_qSe5YBAQ7kNvwHta-Lo&_nc_oc=AdooNg2U0c3lSLQTmInrd-IDAk5MLz-xENA-7Fk2ao2xe1xkGbwMA-ZTUEksj2b_Xj0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRaVxl3_UZg1vSuk3aRUB0jH12oeBTOAeZ4KcLV8M9PA&oe=6AC8FB6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHOwwmvqTW4Q7kNvwF1E8i6&_nc_oc=AdryEHuHk-1qatoQ7iscbriPfSB7ChWWQQmu8t_oeoX3tgZacmHhXE-K4U3g8qQOqGo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOM8gn0h_bwekJ2AlJHG3hKRFpDhItleAoZt3OXW5ARnA&oe=6AC8F4E0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
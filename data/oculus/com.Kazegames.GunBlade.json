79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DxQSSE6A-AQ7kNvwEiV8cd&_nc_oc=AdpAekshIfSwDIOww9OCrigVYLH9PFBwlzzAhzOeju2jGtqu6fNu6GM0jc7i2pbS7iQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaYkevIXX4Vts03IYd8OEEkQvqWXs53E4U3kb_QI04dA&oe=6ADF51AF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5zpv4nG8qgQ7kNvwFEAUSV&_nc_oc=AdrWI8N4PB0R_ej-5prWYuacu8L6dHvBK8echjSL6ZdnDKN8TCQ3Quzfn7N0k-jbnbM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNayoe2XliGho-ofgIemEmttq9XFH4fFn_AhUyt6wveHQ&oe=6ADF64ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cP_AawejaIQ7kNvwGen6Ry&_nc_oc=Adq9mYh3nK5yTTiY8-fCU0GcjLmmHx04su7Y9SFUNlrTJ7iPxikBMHxA7_qVHcXKhYQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmISUBeYK8rCGNSqQ2jDNaWq3v3HwiNj8ddeYowezldQ&oe=6ADF5E60"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
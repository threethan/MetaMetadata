79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwO9dM8FXqgQ7kNvwEG0TIO&_nc_oc=AdpbCes7QdwbuM2qht53qyR9DT3jIF43x5eUe5rFMNWifAlWbCefa6DPIrSDfDiykTo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDav0qzRRuxtcUmmlMfgH1vaBJ5KS-murcVD-v8NVXbQ&oe=6A7F142F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ssz7L_Q8524Q7kNvwE3pGwU&_nc_oc=AdqkHfhFkXxrZFgA10OMOOcn-rBhn2rNEaNWYcYQNZXZVEt9w6YanSgXxwxuvkgoXYE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGRcQOoxmxUQeFqTZ4MJGfWZ5WFJ-uylgNLJM8-JO5CA&oe=6A7EEF2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2WNRn6R7EsQ7kNvwEic9u1&_nc_oc=AdrHYnT3SoRbgVjRy1RfhvyABDo6TXmoxL_dIGDsSZR0rktlA82176B3fck-l9n74YI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnqnuruJWBU9Pw21jsnvRKlBARC5wHw-sEtP85RGjRSg&oe=6A7F20E0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFLJ3ClBQHsQ7kNvwHaN-QJ&_nc_oc=AdpddzwkaihLILYyeYBCo6aczDdJRl6AU0dSg-kGf_h2YnIawA3-kP4qW6Rsumtof-A&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWGIQDP6afYDysA_DKxBN7NOJgI20WUAIQkp-WB0Nc2w&oe=6A973FAF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5D8qUpLDSEQ7kNvwHoVHmz&_nc_oc=AdqFLnYV8NjcMbPU70QMmpRbtXW8bQdwyRWxFLS4UGSXWsahJvcWAvfIOaQUgFxpeVc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4vXto3ZKTJpW37v-J4JK0PCN9BVeyl0DPNaGUM153hA&oe=6A971AAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mI3JyjMTsSsQ7kNvwENLOOI&_nc_oc=AdpD81VE1194FQ7SK8Bg8sVIAy2HNixQnpP5uT4oVZ70dosSSfEKSZXqyZPlF9ITt3E&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFd885dVbdN3QGLlqxMluVPPIkOoF9ll_pz54lqKz6E3g&oe=6A974C60"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
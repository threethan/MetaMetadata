79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1dqlLB2XooQ7kNvwFcAX0k&_nc_oc=AdqFYJqVM36PIzdNSv3An2arNPb6qqneLsaw0MzcO5ifcw4O4AReDZwLpt7NJfBPYJs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7i2JhJ-SDggMXmUuWteY7KFxJlk93rHAdr3IEUvj2UxA&oe=6A086D2F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dunnfE4lj2UQ7kNvwHzsVBQ&_nc_oc=AdqA6ho_531J10yJIb3xueCgtHJ0lsuodc_PiT2Cwo3IG3838hvHHCK8vAJvPTkbsIQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SJPDK6gSIlGrqDI4vvcnWoLyCxq3lnis1JK49WW9jRQ&oe=6A08806D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhOyKprZ0yoQ7kNvwGYmrLY&_nc_oc=AdrWMCrhaUP0Uvv8CajtX5B-JIW6tTomjyrgZ3KtFTMWrrYLRwMKPSh9XU7pWPi-1bE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jZ7b21bHP-Ou0n-uAiLHFWZ_1yQitMo5AleVOyjfNGA&oe=6A0879E0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
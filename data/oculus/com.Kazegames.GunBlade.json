79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cf2IbtzvYqsQ7kNvwHLxnH9&_nc_oc=AdoTa6-XJooO0F1T8-A8G9VO6f4BBxJ0jc0Hdl9jLnbFtq8TTAVWPYGJts_EfEUpvsI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNo5HgrOno5qiXGBifg2CBTfl-7Z3QLySUe7qXp7s1wow&oe=6AD0D12F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9gvqKF_khkQ7kNvwEjkoca&_nc_oc=AdorE3B758fhJVQEZO-vvbFQdLo3JQQCn2vTqaZrDVw5yt8q9nUBHUjkIkX0Rn3tlZ0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO68gB85myl5FMsZJGqRYSQXm13Elr2KpPuTTdo-Mphvg&oe=6AD0E46D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UniV15MpYRgQ7kNvwHyqxo-&_nc_oc=AdoQHY7kg788MTzEwlM-jdBmSV7X6O_SY46zXbvP1Fl_OmRiIzx7jXcHcr5bEkSrN9k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4kQhb9MNBEyglunSWR2XXRizRXyx1i-aImOud9KzYLw&oe=6AD0DDE0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
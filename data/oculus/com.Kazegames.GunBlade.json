79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ut7o_0h7m4kQ7kNvwH3nI6E&_nc_oc=AdpYiYPZD6xBLxC5rbaz3cx9KqFYTYgSshwjVn9DDmX_e6U_WppgVlHa2S1hMBFTRHQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtBVYYdPWnkbP_UO_4AotTkB5220Ymy1858YF3DyiCbQ&oe=6A64B62F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWAxW3x-yi4Q7kNvwGfZtAM&_nc_oc=Adpc0q1StLYqbFpYQS8Xs-FJiJE5UJWCU7PxoPTu0aY8D8PSm-beQbJcsyRQ7xQVhL4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrz4oh8TjllddXHFqNZsxofbxBIrAnTAHlDLV_u99-mg&oe=6A64C96D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHqdWcYeS00Q7kNvwEuFNJE&_nc_oc=AdoVACD62MyVz59ww-ZwBz_5eGl1_oywmaTp2O6cg705YK8eHhuwZ8GcoKK9K9S-1I0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvcmJirQK7p7cFNEx7_ufympSXXyAtyoJ5kZcw4uH4bA&oe=6A64C2E0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
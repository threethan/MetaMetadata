79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwO9dM8FXqgQ7kNvwHGmSmI&_nc_oc=Adqx8kT4p0KzWOhg224cMku-nFIvY--iCQ_5TKFNBVaYmKU0XWvHbausGTHGY1EiEk8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEU0K_C28Ro2CZYxf8wTZ0nDZeduuQEUP5_IFuoFiwz_Q&oe=6A7C712F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcE40VoMVKsQ7kNvwGn-1to&_nc_oc=AdrNyD1RxC7xyUek2LpCgMuBuK60wNqFVNcw3UKCrV5KTkrR1YlFEFxTGZ7k09dpsBY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9P57bQ5xix_nwj96mSQTWB1MIbYoQ-8MtsdGc6fzXKQ&oe=6A7C4C2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPdTwuq4D-8Q7kNvwGDHLN2&_nc_oc=AdojhewCN-7n8JoXypY-BUgJLmV2v7Aaidt_i0HU13ByTo-qz46kTtQ2DFIKSwmwW14&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9kbXlCNZiXk1IDv0yEFivYwkZnrq4ULR-zsnpqRE0Cg&oe=6A7C7DE0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
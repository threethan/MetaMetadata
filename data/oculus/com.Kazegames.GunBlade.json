79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1P-gTA1AjmsQ7kNvwG3rVM0&_nc_oc=Adq0JldddsEx2vqaAH2xj4VDiEQCsWRurMdznjzuHbGkiPeqb_jgXUFE7-r17zPB2vk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLavXVGsBagSkgbsk1lshCom7mAzLJkkQyVwG61HjtvFg&oe=6AA54FAF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5La1APEiwpAQ7kNvwFujIu9&_nc_oc=Adp6O-BbGOD99rNwINfxNk7ia0lIKA2748vwYjlnEzBOpyoeoj11pPOy-iiAW11u1UY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-C3p1QBUMbBTXjPF4b5EogmQaEP8Oyc9lOYmLV0XlbQ&oe=6AA562ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRK7sZd3uCIQ7kNvwG-vKqn&_nc_oc=AdqhlJdWPTfxs7igpExvZspTdAMMdQisXszBNA-YPHDR-VSju3cc_T0oKYfULn7AIfI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgiZNox0q_bKzoMH54p0bE4y6Q6i02Iwy3v3kyQHdeFA&oe=6AA55C60"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dvr0uP0KdTQQ7kNvwEy2Cy0&_nc_oc=AdruJJElAgQGQPCDvoHZ1VjwLtadd-yvGALnARNo-9GDm7fFc9Qr6N-9Qxe9dY5pc0s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIABEOJsW9f-yDK02TLLqCNjWyXJYMkifwvhWElM4K5rQ&oe=6AAA95AF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBqpBZiBoG4Q7kNvwHC66oN&_nc_oc=AdqmI6ETaxKFYeNg6d8vQM_xkltxjmHfNVwsi2epI1VXL_JyG0woOEGKAhBYwou7mDY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXosF_xu9bvHeM5noH_yZuZy8HRZUVzFfXNb2dQZITKw&oe=6AAAA8ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AftnDEMH8B8Q7kNvwFuDWbg&_nc_oc=AdpHo-Edp-e7JWxSJlR7xPKt1XwlvJJap4J9WeCgJGsWpprqtkXljbP-9ZAZMR_8JEs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKa6qpn2on41fuS1f-YaxXFujmP_-6IizLe26OOJpzq_g&oe=6AAAA260"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
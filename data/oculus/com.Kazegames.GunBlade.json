79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzbsG6oUwKQQ7kNvwHgkjL1&_nc_oc=AdrCxL_6AHykI8Xgwq-wezfCzVs2z_RPEVSuU9uCjc0ksXgAdfJVWyVl2ZlO1yk4TsA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91gQeDIhzd7CBahFeziWXshVvg2Q2YDH79CNH1fz7NSA&oe=6A3BD7AF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSKkFM9OjwsQ7kNvwEYGSdy&_nc_oc=AdonJ4exS2lH6KpHwwH7ed_zrAei1h7mEZvjcVWH0tw7LDkr5LD_9_9hofWkozhkLn8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-REN4xe-ajXEaBKiDsJiHW_2v8BhA0eBorSI0A5_Idcw&oe=6A3BEAED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGeK4woKgpsQ7kNvwFtecul&_nc_oc=Adrs8oi_213E8SbaXftxFGRuCZpYogjgwYrJiGPgqC2KId601qQk68PCqsZVEUpIfKg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NtAB8pE-M40uPa_1lDVvJkgzeNxkobPkSYgbKSMAq3w&oe=6A3BE460"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZ6Suv2i4_UQ7kNvwFEzHS6&_nc_oc=AdqvGUJ0FIMEPU31WzCDN5t9dpk63IMA3A29sPmcis5tH7-244pvr4iyGIEiFAlubCw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67DXisdHRh0BmWUcYR9Yc-1M2Wn5KgDbTJ86XbDJeBhA&oe=6A12F92F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRjkRIu1wb4Q7kNvwEwn1ZG&_nc_oc=AdqeTQdufFn72-cZkzI6tlexVzWpH2C653lukEa9ZBagedl7hd7jIa84Yp7Ooix_Jo0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-MsEuXkHSp8K9oZSf0AUSM3feJiYkMfZcGSBQrMppWw&oe=6A130C6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXtHw_EB-A8Q7kNvwEzKg9X&_nc_oc=AdrTIStCiiArSe-OkbDfO8d3bEVQV9zamLsBuuYjfDi8AI-Y2cVM6R2cG-EznrT6yOY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nsh_Gtd4KLGZ8_gz3J25w5ru1EasFIl9zyky-JxsfVA&oe=6A1305E0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
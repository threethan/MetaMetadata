79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1Sk9qNagj0Q7kNvwFx57QO&_nc_oc=AdqM4wsM0BbXFFmRVzcqU24fXKP_H2VQ20Zu0dEvVuSbhgr-Wpd3iqQqw2067F0onec&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQn4eZ4qCDbQY4AjAI5uSwfMsa_25mZK6M3l-68Lihlbg&oe=6AE73AAF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5gry-PYHI8Q7kNvwHWfCG1&_nc_oc=AdrOqNkb9Nfo5_LEWFoLVxOTwv-YobgecoRv9s9hlMUvvgmauWuYVAzMtAZT0aMeL6w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTjRzTdrC44X_07jeNxJDFZxNuOEwkXiqJVNYp1UrmQg&oe=6AE74DED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXJ8YLLeBGIQ7kNvwGgrOZ6&_nc_oc=Adp05kNMVf5F4awlHVJjUZC6XcrZb1EjG6NtLH06dY-XNRFBjcP7kqiJ3FeMmQFdZy4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSK7Kd_DRm6I9kQoBNqL46HZcSsMdmpbVyRakzsFKl9Fg&oe=6AE74760"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
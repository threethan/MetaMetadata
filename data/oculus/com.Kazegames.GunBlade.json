79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgkm07bKbj8Q7kNvwGKZ9tg&_nc_oc=Adrp4htIror7fzHfsIsw0-e0Ki3GoGYcD22kaU1ZlUA2Ref5x53G3Z-uLU1sCh1DZd4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XR1lE05NfarR5eGMqCSMQHcBkENxTtD_IBPh4703Ttw&oe=6A2C05AF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGMZNI7EY4YQ7kNvwFugZg-&_nc_oc=Ado3KeatmIXCuv3Fb0pktq1scmV1gKceyB4tNYUN_8TJKklqR8ne7uwTT0F1KOQFzRk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iKe-AZlmwHEXlXN5BUQwyfTYUsjkzTqCKq1M-T1Cigw&oe=6A2C18ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuWzC__5JSQQ7kNvwF8wGn1&_nc_oc=AdqoWrvl9c_9hMimI_I4y4Y71OvIRtGdgivJG9MVXGfLlBGb4wMacdXKBjotih1coSo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9N1_YyONSHfINap-Mf2BdVyTCu5YN5S7gSkAuzy_YVpQ&oe=6A2C1260"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
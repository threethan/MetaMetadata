79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7B7TLekg9sQ7kNvwFsFodj&_nc_oc=AdpCDoGLUVbvYe966nbYstvn-2iF5R06dE8kWQGrGuC3XoXPSgRCrU4rAt6TRL0SL-4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pBjsCLJmNVf3Pghw2_XYJRacYzvMPXdqtV7sFWOsSpA&oe=69D8F72F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSxG4vOWH5MQ7kNvwGkWusg&_nc_oc=AdoNNImS_gCb9LWIlDQbKOUAkIflTwkWE2k7ciLI1kBPkA5d5WvRQ4MR3FKxe3gyP0g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xkMisc9beoNsSWWPBVP35ZORj8mF_MDzB3aVcOQhmFg&oe=69D90A6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-XG2NXlyljEQ7kNvwGgcltG&_nc_oc=AdoMlneNwLkwQMq5qf5CLalXiHk5136V5NSn7h14cF67AXsfeJlNvEKol0scLrC7Tao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2O3XmfJXqjrFBaXpvt8X9vPMe3_avKOuZ089DZb6YQNw&oe=69D903E0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
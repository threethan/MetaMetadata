79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e85Q_Vn0oW0Q7kNvwHtcE08&_nc_oc=AdoclVJ3ziWLhV-HmDaRxa8DJZl89HuEI4ejF1R60ZnDTjW0YJAOeVQe2e4kPkGR_Tc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmsoyadfxqikp_keS6iGct7COmY7Co9aKMAEZvdEtAMQ&oe=6AB521AF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2lU8rK_pZkQ7kNvwF3mMji&_nc_oc=Ado3oxvfSWHczKdSW6bhDpekC2_Gbz_x41G7SNlqpfipoU-2tMsUEUBv_HQt-j0gqXQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAcEoIHQpZCVMWPl6l8tq0oBkxmOtKrxRO5Ml_koMPTQ&oe=6AB534ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVPAFcViksIQ7kNvwGlZbUX&_nc_oc=Adqq3TSoetWBIOD1lg_XEq4YKS6SxDolI47j-CDgBeKFu7g9vw3wWjMJ8aU3BUt5hqs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIf5wABpJu2z2GZ5Ub8iVp5h43ADQ3U_qan0DsK7hR0AQ&oe=6AB52E60"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
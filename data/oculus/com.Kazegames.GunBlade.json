79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PiNeFlsc0G8Q7kNvwHrzXzp&_nc_oc=Ado4qqlVvHMaYkP6xGSvZju_gqV3BixpZ2-6u0OmKhkzekdLy9tCq9JF4GhcOzwNkw8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRZGIYhtqpQYzIxSlLAq-LOig7Kex2QSSc-_tsBN0IfA&oe=6ACBC36F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmE_qSe5YBAQ7kNvwE97CO7&_nc_oc=AdoETzphE5qj8PJLhiVRYZssGPhIoT8wZ6ZGy2QfIDQTYB_bZYKA2gNc3JI_DfaXryI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMa08KQ-0jgKQjIjLwi1YUM5H8nLNFMo6SgDvLaWxNFOw&oe=6ACB9E6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHOwwmvqTW4Q7kNvwFVI3Hs&_nc_oc=AdprsoQFZ-sWlG5fqJaCgzC6G6273Pn2VoLpK-KNPhnv9aky9eH6xyykTK5njT1z64Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbXuWbief8gkBdClPIXBZdqfWJc5SEjWqTBWTWxHc1EQ&oe=6ACB97E0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
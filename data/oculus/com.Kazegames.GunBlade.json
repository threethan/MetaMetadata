79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTavfYtWaTEQ7kNvwF84o89&_nc_oc=AdreUBcPEAbA7GCL3egJHBK6CT7A0lGTHnq9A_0Uj7A0OB3bejSC_qX7zhZe1Ml5s-4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0VVqJn-5a4XmB7NqyPwkwNlP-rI5JteywwoAMh51ueTA&oe=69F5F82F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0CJheW-1wsQ7kNvwEyb6IJ&_nc_oc=AdpKC2GRmTAE-yjM0dFuoAPDz-pAbMuePLu_11a-sb1VryD7Gznw4-qXloAk-loT52M&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1LxzlVAPTpltK8h8A7B4I2IqDIXmOlntCEmgJP6gobCQ&oe=69F60B6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfGiSb44OEcQ7kNvwH9kwWF&_nc_oc=Ado_OFq2r8vlpZS3UiRNGQaUcARXxlesviGIASPgUnPZ5fGY67jStMStcMfDrcoUCMc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af23e9u8uZGgMnfB5LpDO7U4Q-8Ss0zoyRhL_9S7wt3m3g&oe=69F604E0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myr49dPVG9AQ7kNvwFyJL8T&_nc_oc=Adp9u6Y64LMPXi3UjjijHf36lVRTZC1bBHRTDPEilpLZ2u0qVAjutQ-z5xeg8yhHTBI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCE7_DNdwMQMR0wN5ZOPNbo7pCaHP0AqEg9KNwv9RX_dA&oe=6A6DF0AF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ldf2e4sj844Q7kNvwGvdb2o&_nc_oc=Adrm3YdVWvQrM_K-E5dHXeW7AbFffOIWhyLEwa4mPpg-CoxShkV5utbv_zmuKql8fIc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlKCj-NNY-QYYDd-gpzekutt8XxG53MUZj8UmG-Q42BQ&oe=6A6E03ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIiUt8Ugj0UQ7kNvwFwM7Qx&_nc_oc=Ado78PCLq9t5AAqbnoqqavXqla5g3WfQlemg4sjsmh7CzHI-bCdhwjvhXzWI1VAb18c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYvwLCJMPod6pML_a28_0N8h3Ncuqrrh-yt8_YPNhRlg&oe=6A6DFD60"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
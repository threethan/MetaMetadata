79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIyclx7ulC0Q7kNvwHRuq3N&_nc_oc=Adp6qcNRJs6YMa2ekhM-a0mUaeHYfdzJ-RgESeiOED9LHyx1KHiXbKaFZLL8ax7IrgE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0pNE7lPWK8So-ian2KqIxNnl9YnS35g8SrjNLgHpOcWA&oe=69EF60AF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etz4qtutC34Q7kNvwG_fwi-&_nc_oc=AdrBrYlPfTG8yZUsPk6Rm4_LglpR2jbucByvE8DECA7i_6ERqyrMUhunEB6Zc-UAw6U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0HTxgqsAwrTSJUDYfqp-qcrGJUw1XYODNVJHTAIsn3PQ&oe=69EF73ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jT8nxdDch6AQ7kNvwF-BTUZ&_nc_oc=Ado6bCPzX8JvVev85WsPJtrRzVtNPEBZ1B-lyDZB6dw_KjcVvU1_olMFYEvOvUM5VVc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2liGyPfNhyeq49KvX9HUNrFGUTqYTB0UfocPh_ex4CEA&oe=69EF6D60"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dviNs2b_lkQQ7kNvwGyUvSE&_nc_oc=Adp6jpGmSyKif54y3GzGJM59dFkiMSiDpRyRAWxztZU7Mjzir8_1qJzVpUL0EUp8hYM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Wzj9Dcz3bsX6hap0wbU-n_QdhY4QovCP3sdBf-bwk4g&oe=6A20282F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3A2hguV3poQ7kNvwE0tKB0&_nc_oc=AdoUbt3oHeE1e1zSrnsvbWqqILYgPu418eBsQHa2OJahBgv_KYLYYIPbvqP9sFkbU-Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wLly5Zv8ITjIOghh14jaDzA3b6m-WQ768LqjHEeMTAg&oe=6A203B6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kv36h--cuzMQ7kNvwG6A3vE&_nc_oc=Ado_lmUI_HwW_qMFrw9SmmYwQRzs6WNEa3hw7quulGUIVI_43ddb09ppahm6_7KCz00&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZbP3AyB3CvFAkRwXwqhoWiBRWG-6CvnGBneMTXnOsmQ&oe=6A2034E0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grZjY_UNuAsQ7kNvwFxyI-l&_nc_oc=AdqNcsHi8TGnC0WhcL3P3RpvkorDNFtnQ5wUFKHSZ9nrcxDfYG-V-hNOyk2jt695Ddk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgrigpAN5srfaU9BKztucIV6rt1dLME0eFahysiXn63g&oe=6A57872F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=So5hUYMX9moQ7kNvwG8FwKG&_nc_oc=Adpgy4Bjy9Vfk9mZgnyGAnz4zdyZTmkdAc6Y4Db-7tPTxUmty1HIVUl0-irkpEfSk_w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEVpUl7Z_E7lE03x1uG0-_85Yfe9KEafupMmofkrdNlg&oe=6A579A6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rc-R68_u-IQ7kNvwGhVGOY&_nc_oc=AdrlXU5lLOUKasce74yeiPevneUG1-UgemiYkYZMoD41yzkG-ol3ort4OJGPj3xbAfk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwrQUGUmTPRR_SXV9cRkVHCh4enkygBfqOM_7EkE_wyQ&oe=6A5793E0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
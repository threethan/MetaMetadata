79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwxT6CDwMSIQ7kNvwFrTRJe&_nc_oc=AdrduQrxd21gr5hud7flZ5WtgI_xBpHk8wY5fk0UBDfJph6ApnasJQphZ1k9MfqNJ5I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThdXc-7_H54ceZTy9XvgcUISxRj3JiyLmyIpauFfP92g&oe=6AF5F36F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4M7A7nVxQQQ7kNvwFJlcAM&_nc_oc=AdpfQVpyYkHqH6Xh-gkKd-L4qd-Nu9bae8rwJ36qeDSdMYhZshqru-4gXilSt1THo4M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOUAj-tbH2ryc5IWQhzlc7hIVoW8llh8AC8rMPNbsBqA&oe=6AF5CE6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgQ-WiB4Z08Q7kNvwH-PNec&_nc_oc=AdqDkHmg5U3ugTDHGvux52xMGk3OcbL39vbEDEink9FKEy1e4Cmc52KWgvWrVlbJKlQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsNuK8ES24ihRUW5vZwjX9EQv1LZWWMdfoLt4nJLoq1g&oe=6AF5C7E0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myr49dPVG9AQ7kNvwEiG4CJ&_nc_oc=AdqBxOCx7nLwOr45tvQEllg6hSc7OfphqF2s5b6s4wchMhD-DLvgU5VZTeaGjNHbkYY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhnrXRO1E_FxYL-R3fmMbfH9Ye93Z4yxQykWKC10EoTQ&oe=6A6F422F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ldf2e4sj844Q7kNvwH4u04s&_nc_oc=AdoMRxPoI0uF91ZrYNZx94lXgU07zJ6p4S_EZSzKd5LT1YqNb2dahou401oaJ3icQcg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAf9wo5Gh6op3Pi3_tTNmycLc9DvuyZ7FsU9tcmD1HLnw&oe=6A6F556D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIiUt8Ugj0UQ7kNvwGpA0X-&_nc_oc=AdqnMOjrEh3SEUixGTFhmJOkDvKvcpgVb8uqo9ZXRptwKyLbY1wf3K7DVrvUKk3FDF0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJg1-aXlvnm2WkFP-GYfZx5dpWZBtQVyPwbuf793jPfA&oe=6A6F4EE0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
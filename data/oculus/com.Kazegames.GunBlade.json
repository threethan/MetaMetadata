79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzsQsIhB9twQ7kNvwHxNcBf&_nc_oc=AdqpO5DqaV4o8-BpyxxT9h6ZnLCa2xQVbeVbLmWY3KfihXAYp-a31rgqDJaSj3yQBPY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTzjM5MJQql8WTelLAJuxSEm1_xZtp5DdiZES1dQ4klQ&oe=6AF9E7EF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PzT6XlYCioQ7kNvwHwDF0L&_nc_oc=Ado9k0zx2W95OI2GaXHN9MKQkGWBIADgAjG4qaIsihIFBdUxOMqUR18xM7wiy9pQleQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZae71IeoIbS4CHgKH3INV8ME1mjgbhWoj62tX1Uaceg&oe=6AF9C2ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slCT6IQmWPIQ7kNvwGXtSvH&_nc_oc=AdpiSoKoSRZU5HWDbfArjNfJwROnXoyFDdYZ0ovt-VINHLS2cFird7rwBR6SkF7D3JI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLVXrrzPhVMasogrzTjLzQXYd3W1gOoj4vTc4DRygxwg&oe=6AF9BC60"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
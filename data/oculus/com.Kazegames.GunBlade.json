79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LXj4k5VZVYQ7kNvwFjUXtw&_nc_oc=Adqc-eyNEIhi8JN-C3F63FGgICSqD2AJdWUQeq2qEXpKQ7aGpD5GtIyRc0EHJwkcF-0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkR7Wq16_1ifiZ5VxbpvSd8XVyJp-y_YbqbAanHC_g5w&oe=6A75D9AF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24iu7ZcnlpQQ7kNvwFkjHKU&_nc_oc=AdoFiarX4dAzqCJ-0w4-VtXs6K5ztd9oTkX6acBMJbLInlR2UZj8l5-l_GWkMmmCvo8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRVeI66OI9CJaXihQAUJhLRzt2K828HidbxernHYne-Q&oe=6A75ECED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-CrKwVh6eAQ7kNvwH8OBwX&_nc_oc=AdpUlpwRnGGwCNZ7tVBVr5hp16g1X_2n4NRSTRgPfj3EbUouvKGVFynnGGC6rFf-gHA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0OAfpmlhSWy6loKNwDNxZEZaB2qUov1fYEZa7rJlNeg&oe=6A75E660"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAKJpJluu24Q7kNvwFF7xRa&_nc_oc=AdomkacxGr1HYaHQGoHhUT2B7XA3aK4CNqd4CaWVKpyoo4ZZpnGIAK3jMr7ux16t4zY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrdA1mEauBIFSStj4RBZJAtoxVS3DsX551vLkgmBboJQ&oe=6AC3DA6F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ll2NGIl6J8Q7kNvwH3sjYo&_nc_oc=AdrWkSfoyD5Wt_T3xtphWDe6vZxm61IajxhKZ1rdvlo0SA7wAUsfJlcoGLh_O9lTzZM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPf7wbOUu6OaRbq5iJeR4mnJf_XlfiSqCGPd-A6ain66w&oe=6AC3B56D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6XqkHST8HEQ7kNvwHpvE_8&_nc_oc=AdpuhRlO1DVTcE4xwl37POlcIjlWr5PM3q-8juuvFMKk8P24GwMmOWg9Xs6alpSsm98&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTE9uQd5xAhFuc_wh5E2f1f-gqSrXIcOFKk7JcllPQOA&oe=6AC3AEE0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwah4CBK2o8Q7kNvwHWwdUW&_nc_oc=Ado8N8qqqKXS_M5zQm8j1AhzD5BLLId0688d7-2XR4EheLoXdQgEJ8FkVIA4RimPUJM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NQjBBOJWKzks4sUAGIiFk20_8j5H7YPmD36JQfeeBTg&oe=69FF32AF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UARXdAnr7xEQ7kNvwGJQbjb&_nc_oc=AdpITUg1ZHoarWUoO3LyobbJ66BKhQuUhpVfa0M1uHpXuiJz_QoFRuxifC02bnnAMuc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ktr1oX__mRzR5RZMDCEBguD6n6K3CxqdbhMSmlMFL7Q&oe=69FF45ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8pKRBDenPIQ7kNvwF6040j&_nc_oc=AdpvSJvROiz6p6pRB_NWVxo2Ew47Mm_DjLbvEWFRaQDilvFw2zklnZ-v7uK71YoEui4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7scXXCt6zTpuEntJLYwRwPQ4zpc9WmwNk_taG9QaKlOQ&oe=69FF3F60"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
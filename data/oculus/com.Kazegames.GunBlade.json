79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEvrwbAzqmIQ7kNvwEh2D__&_nc_oc=AdoTtlEPUKRWS8KU-b6flPQr4aeY0gY9oj0PabehElJFWzO5bCWrpgKess-Zx1br9Ik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FLo8iHT9tTnYA3Lz7G1RmRVqzFldBzCD3GXMoVmEFXQ&oe=6A183F2F"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5t30mTPiHBAQ7kNvwGDmfyh&_nc_oc=AdoQQOXT6x_qPJ6ld74y-n_aVzx8aKk1FOPgM9zEDXldRnxDYMmnYKI8-SZnHJLOZis&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tPw4pqW6yHDRA9by5mBD47q7bqIjTWhc0CwqgsVLMRA&oe=6A18526D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUchxDtk4nIQ7kNvwH43hKh&_nc_oc=AdpwlQ-UjSy7X2Pwy1I9SkUlSPWRZq9ClX37NkylzULPo7MZE1fhdPxqjbAgJvGKReQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xrN_xU44b1PLvA6JXSa-c_rbEoEU3O5SF8uKi1-igDA&oe=6A184BE0"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
79186254141959_1289682824198428521_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ut7o_0h7m4kQ7kNvwHUuPfy&_nc_oc=AdpWzHqEiptGTn60JkEVVN6tEOYnqTPzN1-Bor8GddzXeyg5-I9D6jSaJfMO9tuOlDQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2_qhaTcUJYMWaPF3mWVjQMxToxN9T_K_2vNxwO8iwUw&oe=6A6607AF"}, {"file_name": "ScreenShot_006_MenuRoom.png", "id": "3321071058177184", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974844_3321071061510517_6730162354798117063_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Chk5aR76c2wQ7kNvwFRrg82&_nc_oc=AdoUCrvYE1HwI4Mu3t3YHfGZnml4snozWpWCEvZzBJ54sxHbfYnZiVGGh4_Llm7M-Gg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6wNv9yfBTiw3tcnv2aKGbO60vQ9gQ_2VDBONR2p6cOg&oe=6A661AED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "327634282855153", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57566696_327634286188486_7401865434571380317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJTaB7x-akMQ7kNvwG1EJ0L&_nc_oc=Ado5lGLNml1gp0pwAhSdryGnm5Codw8sS4YcT5Y9qzaZuXiClC02a3ee5qOEAdruSXE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxkaoNy-ByVyCypwtMwG2IP4FuIZZ3xf92UExQpGuRuw&oe=6A661460"}, "display_name": "Gun Blade", "keywords": [], "long_description": "GUN BLADE is our first VR Shooting Game. We want to make a simple, funny and classic shooting game. We think all of you remember when you were child, playing a shooting was the most exciting and funny time. So, in order to bring back that feeling, we decided to make a NORMAL and SIMPLE shooting game but just in VR, as we think that VR is becoming more and more popular.\n\nLet's play and give us some suggestions to make GUN BLADE more funny and exciting.\n\n\n", "short_description": "Looking for a classic shooting game in VR? Here it is. Join us to make it better. A classic shooting game in VR. Use your GUN BLADE to destroy all error BUGS in the network world. "}]}, "devel
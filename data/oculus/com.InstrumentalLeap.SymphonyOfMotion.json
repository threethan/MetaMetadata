779_8704984061726799082_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOwTiIPPiC8Q7kNvwF1KMNa&_nc_oc=Adpotfjl8YX01GrWU5T-HhiZFcCLQK-AILLd9iEw1O1y0XTbf2WsrPeXZJZ-9az_k9U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy_M9IrNDu1nhvG3_ZHlyCg9UE7BjK8pQvcYxU3Io4bUA&oe=69C14F98"}, {"file_name": "4.png", "id": "545991213689916", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974584_545991217023249_1079258124987724639_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6dHdbxly3YQ7kNvwHo-AmT&_nc_oc=Adr7DhzCbbyXeJ1p0lRGWiPojgrCe_Oi87TLoDGDxou-PVDu8yga8-53owXOPSkPKdA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzcMei7OdO9NXCz-P2KBN9icPsbE6y9YVPBRxbapVZ_eQ&oe=69C146BC"}, {"file_name": "1.png", "id": "541066850814745", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57572932_541066854148078_2845143470434249405_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDKNAcWKhgsQ7kNvwHxM48L&_nc_oc=Adq4caI-E3tJQa-Vd_rlZnZ-kQ4t19RAJnrJ8w61FRQnt-lPJqsggw0MaAoImNCbn4s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyzI9j8b1yg4QbUsq9XPgOtaqScQb6MaFPLOIQvgPKyOQ&oe=69C1196C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1084809205444174", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75394636_1084809208777507_5661361267561165032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4bB01ozqd0Q7kNvwErdqYB&_nc_oc=AdpY5JYc_gZpSk6j7U8BGXAi65qHBWuzrXTHPFpp7-MXKV6zO96BY6wubcHZZoyR3Aw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwb7mpi3iimX-dcgHUyWoOQuvKszFOSi_hemE5wV_0y_w&oe=69C14736"}, "display_name": "Symphony Of Motion", "keywords": [], "long_description": "Symphony Of Motion offers a new unique way to create and experience music without the need for any prior musical knowledge. Whether you're a seasoned musician or a complete beginner, this is a new and intuitive way to create and experience music. In its simplest form, you just move your hands around to create unique sounds, melodies, and rhythms. There are no \u201cwrong\u201d notes to worry about (as you always play in a specific scale) and you can always stay on perfect tempo with the build-in perfect timing assistant. For the more experienced musicians, it also offers a lot of customization options, a build-in looper, and new levels of expressional depth with its three-dimensional motion modulation, live pitch-shifting drums, and melodic pads.", "short_description": "An innovative musical playground that turns your motion into music. Featuring a large selection of motion-reactive synthesizers, multi-pitched drum and melodic percussion pads, a built-in looper, and a drum kit builder that will keep you jamming for hours on end."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTml4NDv2-HKPSFPSy9sA4DCRO54sd6Aadn_O17yHGtpq6fyjRE-wC6hGbjIDZ01MXtv24vk5wlBWL0/pub", "developer_terms_of_service_url": "https://docs.google.com/document/d/e/2PACX-1vTml4NDv2-HKPSFPSy9sA4DCRO54sd6Aadn_O17yHGtpq6fyjRE-wC6hGbjIDZ01MXtv24vk5wlBWL0/pub", "publisher_name": "Instrumental Leap", "support_website_url": null, "website_url": "http://www.fingerJam.dev/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "997322034614010"}, "review_messages": []}]}, "cover_square_image": {"ur
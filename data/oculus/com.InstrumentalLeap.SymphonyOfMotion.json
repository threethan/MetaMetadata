/v/t64.5771-25/75195911_434125048228779_8704984061726799082_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-olShYNFGMwQ7kNvwG68Ll8&_nc_oc=AdrVdfvFnRelwBqBDpKAShoIvInUAUI2Bi6M43RnmWmpRI179wV0wlwMZGZK53wHIDo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Le-7F8Is82grsRhAbAp0DKAVsVliRQIoHAsREKr2yGg&oe=69F4BA18"}, {"file_name": "4.png", "id": "545991213689916", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974584_545991217023249_1079258124987724639_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLHuhYDLXloQ7kNvwG-Szpw&_nc_oc=Adr5Dn3LTkmAbwlU-hvA7lAXpX6bA8i4mRiUMKSf1UjFiUVVOVmSCX_6P3BjnTNEY54&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0OQ21Skpwr97p8vdjA2SW9wXHRiM-iBRE7Ka9INQ3gCw&oe=69F4B13C"}, {"file_name": "1.png", "id": "541066850814745", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57572932_541066854148078_2845143470434249405_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUJ-EE1fl9QQ7kNvwGeYXxK&_nc_oc=AdpRHvJyn7gVbzr-X2utKozVRixPYyPPgRf6Wv1jdowkvMN5lIoFIIZK6VucfzvCUmY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1TDjLLZJ4Iwy5fS9UZY0ejCPzObYOnvcg5zimTechMxw&oe=69F4BC2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1084809205444174", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75394636_1084809208777507_5661361267561165032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTinfRFO6IAQ7kNvwG5_X5s&_nc_oc=Ado7ikQnN0xnxRkRz_YGy-cD5rjgvNV_JAcQxsk12I1zhqQ_pdOlT4P3U9t9VEKI1vc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af34OYwVgZGs2MhqRYGw0wpOgTzKiE9_HuN_-YkayJdQJg&oe=69F4B1B6"}, "display_name": "Symphony Of Motion", "keywords": [], "long_description": "Symphony Of Motion offers a new unique way to create and experience music without the need for any prior musical knowledge. Whether you're a seasoned musician or a complete beginner, this is a new and intuitive way to create and experience music. In its simplest form, you just move your hands around to create unique sounds, melodies, and rhythms. There are no \u201cwrong\u201d notes to worry about (as you always play in a specific scale) and you can always stay on perfect tempo with the build-in perfect timing assistant. For the more experienced musicians, it also offers a lot of customization options, a build-in looper, and new levels of expressional depth with its three-dimensional motion modulation, live pitch-shifting drums, and melodic pads.", "short_description": "An innovative musical playground that turns your motion into music. Featuring a large selection of motion-reactive synthesizers, multi-pitched drum and melodic percussion pads, a built-in looper, and a drum kit builder that will keep you jamming for hours on end."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTml4NDv2-HKPSFPSy9sA4DCRO54sd6Aadn_O17yHGtpq6fyjRE-wC6hGbjIDZ01MXtv24vk5wlBWL0/pub", "developer_terms_of_service_url": "https://docs.google.com/document/d/e/2PACX-1vTml4NDv2-HKPSFPSy9sA4DCRO54sd6Aadn_O17yHGtpq6fyjRE-wC6hGbjIDZ01MXtv24vk5wlBWL0/pub", "publisher_name": "Instrumental Leap", "support_website_url": null, "website_url": "http://www.fingerJam.dev/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "997322034614010"}, 
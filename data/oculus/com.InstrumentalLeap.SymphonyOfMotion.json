=wKiEjCzGJdcQ7kNvwHMZbcH&_nc_oc=Adn36tYiPh54XBObqzVEn6EiBDJKRHVzVKsL6PILYSPtBJvXFPFJHxQkIzMsZc16Ztk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuEftWeOicFz2bMQcd8Lk_9amK3wsTGr0lUgK1wnC34OQ&oe=69A6F198"}, {"file_name": "4.png", "id": "545991213689916", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974584_545991217023249_1079258124987724639_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Penb3usAQUYQ7kNvwFCETCV&_nc_oc=AdkvtQ3uUdaniemuLX3wtNJ9wOLR0h_c5mY5zYzrC6KFLzPU2VKIl1CCLOaLXXHvlco&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuw1XmtZCrjjjiwT93NNtQJxPrkpGOLpJdXQCKB86wWLQ&oe=69A6E8BC"}, {"file_name": "1.png", "id": "541066850814745", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572932_541066854148078_2845143470434249405_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86D8yNOIzbIQ7kNvwEddsvd&_nc_oc=AdlYtfV77aG_sgGIJP5NKRIt2Qo5gaSAjKODwaJ6gQolQhR0CED0OYkuncGmGHsZJek&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftVDsjWWfdNi6p63I2hpTuV8vZ6fyh1OaluNUF1wt3iow&oe=69A6F3AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1084809205444174", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75394636_1084809208777507_5661361267561165032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcT8q8OiliwQ7kNvwGBv13B&_nc_oc=Adl2NuVbf0-Rtwcjx9r6W7PYu08J4_hNU0RzpN4yI7I8_Xalp0FitiJYVi24EJDlOW4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvWNDrxdet6MNDbcQHoWWlmyRjSaRM_yWZ8Wi-PRGgQsA&oe=69A6E936"}, "display_name": "Symphony Of Motion", "keywords": [], "long_description": "Symphony Of Motion offers a new unique way to create and experience music without the need for any prior musical knowledge. Whether you're a seasoned musician or a complete beginner, this is a new and intuitive way to create and experience music. In its simplest form, you just move your hands around to create unique sounds, melodies, and rhythms. There are no \u201cwrong\u201d notes to worry about (as you always play in a specific scale) and you can always stay on perfect tempo with the build-in perfect timing assistant. For the more experienced musicians, it also offers a lot of customization options, a build-in looper, and new levels of expressional depth with its three-dimensional motion modulation, live pitch-shifting drums, and melodic pads.", "short_description": "An innovative musical playground that turns your motion into music. Featuring a large selection of motion-reactive synthesizers, multi-pitched drum and melodic percussion pads, a built-in looper, and a drum kit builder that will keep you jamming for hours on end."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTml4NDv2-HKPSFPSy9sA4DCRO54sd6Aadn_O17yHGtpq6fyjRE-wC6hGbjIDZ01MXtv24vk5wlBWL0/pub", "developer_terms_of_service_url": "https://docs.google.com/document/d/e/2PACX-1vTml4NDv2-HKPSFPSy9sA4DCRO54sd6Aadn_O17yHGtpq6fyjRE-wC6hGbjIDZ01MXtv24vk5wlBWL0/pub", "publisher_name": "Instrumental Leap", "support_website_url": null, "website_url": "http://www.fingerJam.dev/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "997322034614010"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031427_1029364674328013_4482591138547058537_n.png
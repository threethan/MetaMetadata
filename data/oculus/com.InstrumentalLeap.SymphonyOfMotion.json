8124987724639_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywBH02jqz-8Q7kNvwEJcVYP&_nc_oc=Adro7gZTYn0AimWAUy3FoqF7z1-Lq-v6KCMPIE6NsjXa-qYqZtP72fFbniCZAcF1ENY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB29ndQG5LkP5fLEpXnEV_E1DwKFOE52Sa8MKVowH6UJQ&oe=6A6B583C"}, {"file_name": "1.png", "id": "541066850814745", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572932_541066854148078_2845143470434249405_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iN0Gi_RL7joQ7kNvwF7bDMR&_nc_oc=AdrmpmTaj--In43iQRzsWPBx5PA4DigTlGqaQKVXkgUo1Ay3vhsLFdWIoP8jl00A55Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4FQ1Iq-kQcYIhFo0X7F9_6AD2GrZvvQpBNeU74fpnRQ&oe=6A6B632C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1084809205444174", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75394636_1084809208777507_5661361267561165032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyTc2Y5qdmsQ7kNvwGh8UDG&_nc_oc=Adraz_oqQ7lhYKJLSQWksBMR8RlmoRjkL3fKW-LWpaf7vnGNR4PI76dmOwnqf7rEezs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiSFCXpemNdJpj-PC5N5JQxfiZzRxTHSuRJAzrTYXZcw&oe=6A6B58B6"}, "display_name": "Symphony Of Motion", "keywords": [], "long_description": "Symphony Of Motion offers a unique way to create and experience music without the need for any prior musical knowledge. Whether you're a seasoned musician or a complete beginner, this is a new and intuitive way to create and experience music. In its simplest form, you just move your hands around to create unique sounds, melodies and rhythms. There are no \u201cwrong\u201d notes to worry about and you can always stay on perfect tempo with the build-in perfect timing assistant. For more experienced musicians there are a lot of customization options and a build-in looper to play with.", "short_description": "An innovative musical playground that turns your motion into music. The built-in looper, drum kit builder, and a large selection of motion-reactive synthesizers and drum samples will keep you jamming for hours and hours."}]}, "developer_name": "Instrumental Leap", "developer_privacy_policy_url": "https://symphonyofmotion.com/?page_id=66", "developer_terms_of_service_url": "https://symphonyofmotion.com/?page_id=66", "publisher_name": "Instrumental Leap", "support_website_url": null, "website_url": "https://symphonyofmotion.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1086682942204632"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "383112683882365"}, {"status": "PUBLISHED", "id": "612793837095182"}, {"status": "PUBLISHED", "id": "952227296111956"}, {"status": "PUBLISHED", "id": "1547786532299213"}]}, "baseline_offer": {"id": "952227296111956"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1654546500, "status": "PUBLISHED", "id": "383112683882365"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5599374473495415", "version": "0.23"}, "id": "1147464706052982", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "46768961
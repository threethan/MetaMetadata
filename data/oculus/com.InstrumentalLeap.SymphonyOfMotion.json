kuQwqIW9zsWvCpOHZ2mdQPLPw-DLjGTYfmg3g38Lc48hqg9aGLaBJgR3lILw1w2S0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxqHuRLpQxge8ZES2AN3Bm3yqe7i3JZfeTTnFuRU5R6eQ&oe=69AED1BC"}, {"file_name": "1.png", "id": "541066850814745", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572932_541066854148078_2845143470434249405_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7QkWOyBYWoQ7kNvwEZGc4g&_nc_oc=AdmjOvkP70MAionEZeLjnuMS5y5CwdIDP8g0scbIo9khj3Uc1q6uVJKAVUWi4q22qKo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyG2j7lDiSmZfRmalx0JT0wfbisgafDwBBXtEorHseVTQ&oe=69AEA46C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1084809205444174", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75394636_1084809208777507_5661361267561165032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xITj5QhYXj4Q7kNvwEPc5Pp&_nc_oc=Adm3yOGul8FM6rg0aMR4w2ITFa8_-hVZ-lr1Sr6ysqJd29voT2R-puuNXGRSyx13-sc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLsKArV9vIoiV8dKVYoF8yf3hCd7G5qxOze9UUA5bO4g&oe=69AED236"}, "display_name": "Symphony Of Motion", "keywords": [], "long_description": "Symphony Of Motion offers a unique way to create and experience music without the need for any prior musical knowledge. Whether you're a seasoned musician or a complete beginner, this is a new and intuitive way to create and experience music. In its simplest form, you just move your hands around to create unique sounds, melodies and rhythms. There are no \u201cwrong\u201d notes to worry about and you can always stay on perfect tempo with the build-in perfect timing assistant. For more experienced musicians there are a lot of customization options and a build-in looper to play with.", "short_description": "An innovative musical playground that turns your motion into music. The built-in looper, drum kit builder, and a large selection of motion-reactive synthesizers and drum samples will keep you jamming for hours and hours."}]}, "developer_name": "Instrumental Leap", "developer_privacy_policy_url": "https://symphonyofmotion.com/?page_id=66", "developer_terms_of_service_url": "https://symphonyofmotion.com/?page_id=66", "publisher_name": "Instrumental Leap", "support_website_url": null, "website_url": "https://symphonyofmotion.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1086682942204632"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "383112683882365"}, {"status": "PUBLISHED", "id": "612793837095182"}, {"status": "PUBLISHED", "id": "952227296111956"}, {"status": "PUBLISHED", "id": "1547786532299213"}]}, "baseline_offer": {"id": "952227296111956"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1654546500, "status": "PUBLISHED", "id": "383112683882365"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5599374473495415", "version": "0.23"}, "id": "1147464706052982", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4676896142409924", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "55993744734
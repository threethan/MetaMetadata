/v/t64.5771-25/75195911_434125048228779_8704984061726799082_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChUzqNqFAHYQ7kNvwGUhWMm&_nc_oc=AdpPPK86xYpakKqU20wNFjhGc-BS2BHZR2CnkCroU3z42NeXEBFFWo5tkx5uKDRCL4g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmf32pRFHT9OAUoUpIgknFDcJtGFBAGy6vvMPbbUz7Gg&oe=6ACE4198"}, {"file_name": "4.png", "id": "545991213689916", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974584_545991217023249_1079258124987724639_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dok8lCOjVAQQ7kNvwH_9k4j&_nc_oc=AdqWjnDtIxAhXU5l81imgTj74nyXt8hCRReAz3MVGlyWUDCBMtgsZajGTMhxtuDF5Tc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqbzvKkaPh5dS7iTfnysFsmc32stcayneMaBNZPML94Q&oe=6ACE38BC"}, {"file_name": "1.png", "id": "541066850814745", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572932_541066854148078_2845143470434249405_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oq6P07YWwekQ7kNvwE0tzSf&_nc_oc=AdoHcbqkoQwD7ipeNzRiZAwaM_Jvb2Tq2NbIz5C7pvTPQO3clr081KriEkidpYkUIww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8uecWMuYQ4mGqK9lw8z5z4BPOOvPMBWLtwq1UzWFtUg&oe=6ACE43AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1084809205444174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75394636_1084809208777507_5661361267561165032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipPpJHj30F4Q7kNvwEbPefN&_nc_oc=Adp6p64sdRVI3W45yat6Ifb0vvGp7L9KZeuASN4Q2wP8MiBe87Kqq7TfZBvT92QphP4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdtaR9DBtOwpgqfZRfkPIKYPtBq6dIpzWVZ0lhzH6XcQ&oe=6ACE3936"}, "display_name": "Symphony Of Motion", "keywords": [], "long_description": "Symphony Of Motion offers a new unique way to create and experience music without the need for any prior musical knowledge. Whether you're a seasoned musician or a complete beginner, this is a new and intuitive way to create and experience music. In its simplest form, you just move your hands around to create unique sounds, melodies, and rhythms. There are no \u201cwrong\u201d notes to worry about (as you always play in a specific scale) and you can always stay on perfect tempo with the build-in perfect timing assistant. For the more experienced musicians, it also offers a lot of customization options, a build-in looper, and new levels of expressional depth with its three-dimensional motion modulation, live pitch-shifting drums, and melodic pads.", "short_description": "An innovative musical playground that turns your motion into music. Featuring a large selection of motion-reactive synthesizers, multi-pitched drum and melodic percussion pads, a built-in looper, and a drum kit builder that will keep you jamming for hours on end."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTml4NDv2-HKPSFPSy9sA4DCRO54sd6Aadn_O17yHGtpq6fyjRE-wC6hGbjIDZ01MXtv24vk5wlBWL0/pub", "developer_terms_of_service_url": "https://docs.google.com/document/d/e/2PACX-1vTml4NDv2-HKPSFPSy9sA4DCRO54sd6Aadn_O17yHGtpq6fyjRE-wC6hGbjIDZ01MXtv24vk5wlBWL0/pub", "publisher_name": "Instrumental Leap", "support_website_url": null, "website_url": "http://www.fingerJam.dev/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "997322034614010"}, 
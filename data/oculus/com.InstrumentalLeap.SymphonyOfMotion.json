DVbZ1iujulro0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3KnRmXwrk20ElPR8YA45J_Fhji2ljIGSv1xixk1DIPw&oe=6B05B898"}, {"file_name": "2.png", "id": "434125044895446", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195911_434125048228779_8704984061726799082_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69TK96vBTMUQ7kNvwF0vjLx&_nc_oc=AdomV9bNXA68kRW2Ds93Ac1DZkKY3QzLp-NTUgwwOBUVLWR6I4oHMGHc5u0iPnmzvg0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfSM40WnEDiq35XYCTD1Jcu2DHRrBLGrl-gQgkIw4cDQ&oe=6B05D8D8"}, {"file_name": "4.png", "id": "545991213689916", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974584_545991217023249_1079258124987724639_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TiXWDJ-zh1MQ7kNvwFjup2S&_nc_oc=AdoV_sp9tBrEJzQb4DaAAXDbL7rrth-KKqSvhaN0qbHECdrO9W8ypCNHReUuaJ4yyXs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOYT0qG50ZeQLohOi8ChG-h2UlnBxfxeZwnlCVXP1P4w&oe=6B05CFFC"}, {"file_name": "1.png", "id": "541066850814745", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572932_541066854148078_2845143470434249405_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOnfubA6h0MQ7kNvwH0cj0j&_nc_oc=AdotbaMZobvreCDdm0YdHo5xnOtrvT8G-gvEQTVWNGKL2fMxw1OLS2Fdued2lpF91Q0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9OW4j7PYZRvzCVSJIYc_FmszP0b_pI9pm2sW-5pRC2Q&oe=6B05A2AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1084809205444174", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75394636_1084809208777507_5661361267561165032_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDvwFrLod54Q7kNvwEJDpW7&_nc_oc=AdozPA96uN5pxgHZemwqB_oKX55BydyUZpexcEeiJJ4WgUNpeqQLpidjN_rChHoyc3s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRR2H3l2eO1atITlXB4ouOg_P6fD37f0DiLf8T4ivS7ag&oe=6B05D076"}, "display_name": "Symphony Of Motion", "keywords": [], "long_description": "Symphony Of Motion offers a new unique way to create and experience music without the need for any prior musical knowledge. Whether you're a seasoned musician or a complete beginner, this is a new and intuitive way to create and experience music. In its simplest form, you just move your hands around to create unique sounds, melodies, and rhythms. There are no \u201cwrong\u201d notes to worry about (as you always play in a specific scale) and you can always stay on perfect tempo with the build-in perfect timing assistant. For the more experienced musicians, it also offers a lot of customization options, a build-in looper, and new levels of expressional depth with its three-dimensional motion modulation, live pitch-shifting drums, and melodic pads.", "short_description": "An innovative musical playground that turns your motion into music. Featuring a large selection of motion-reactive synthesizers, multi-pitched drum and melodic percussion pads, a built-in looper, and a drum kit builder that will keep you jamming for hours on end."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTml4NDv2-HKPSFPSy9sA4DCRO54sd6Aadn_O17yHGtpq6fyjRE-wC6hGbjIDZ01MXtv24vk5wlBWL0/pub", "developer_terms_of_service_url": "https://docs.google.com/document/d/e/2PACX-1vTml4NDv2-HKPSFPSy9sA4DCRO54sd6Aadn_O17yHGtpq6fyjRE-wC6hGbjIDZ01MXtv24vk5wlBWL0/pub", "publisher_name": "Instrumental Leap", "support_website_url": null, "website_url": "http://www.fingerJam.dev/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "re
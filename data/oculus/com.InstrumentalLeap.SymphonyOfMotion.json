oh=00_Af1-_EUZRd3Ka0y6D64O_UIsyfY4FE8qeT56vpAd0Chz0g&oe=69F20E3C"}, {"file_name": "1.png", "id": "541066850814745", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57572932_541066854148078_2845143470434249405_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySa7KxvF_y4Q7kNvwHdj1vD&_nc_oc=AdoeVGlKPMJ5QgbZno8z0dWONCU6kUyp6VGwZzPdvp8Q-VzyrbyaHhwqTUeRe70mmyE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Z4zsl2T1gJ53EkcFRinf0uD3xaR1f2yK48coRBgRBWA&oe=69F2192C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1084809205444174", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75394636_1084809208777507_5661361267561165032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrlwSvBxRTsQ7kNvwGq0chi&_nc_oc=Adq5idOvMZ-IdJFcDjn0apqvH9ZpOEq2p72tFownuq6Gq6RTumCeQvyrMWhknvYQVyc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af27VhPsBjWu9XdIztOBRvj2BrMhQZJ9mYpecSqV78RU-Q&oe=69F20EB6"}, "display_name": "Symphony Of Motion", "keywords": [], "long_description": "Symphony Of Motion offers a unique way to create and experience music without the need for any prior musical knowledge. Whether you're a seasoned musician or a complete beginner, this is a new and intuitive way to create and experience music. In its simplest form, you just move your hands around to create unique sounds, melodies and rhythms. There are no \u201cwrong\u201d notes to worry about and you can always stay on perfect tempo with the build-in perfect timing assistant. For more experienced musicians there are a lot of customization options and a build-in looper to play with.", "short_description": "An innovative musical playground that turns your motion into music. The built-in looper, drum kit builder, and a large selection of motion-reactive synthesizers and drum samples will keep you jamming for hours and hours."}]}, "developer_name": "Instrumental Leap", "developer_privacy_policy_url": "https://symphonyofmotion.com/?page_id=66", "de
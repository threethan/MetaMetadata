_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBrtc5g5hbB8LfamHpNVnd5eEGUyVDpGNg_3sIppMh-Q&oe=6AF33F54"}, {"file_name": "screenshot3.png", "id": "1519471356649404", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821796_1519471359982737_3418853562153044872_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7412rymMCwQ7kNvwHG3HFD&_nc_oc=Adr1wm2-DbiL7H6U4r5P6fMmDoNv0BQiUHR-I5y4E4DooQaz0kllf4Zqwm5gmX7lZNU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJenbGzk00EHUcFUeFxv5Cg7Q2gBmvMh3ShUoJFSaVYg&oe=6AF323F4"}, {"file_name": "screenshot2.png", "id": "1827719431561154", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823930_1827719434894487_6234065247465861477_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMBsi3SQFaQQ7kNvwG_-rl2&_nc_oc=AdoisgkCof6Gxocxb1-WremoVklDslWUdzKpBbGf7cPt4Yq2R8DJIdU-70r6aCF45pc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdCM_2qCxgHqsvpJuI0mZUIcgM8lEah6jLMJBaQbGjDg&oe=6AF34DFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "2329539011214411", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823901_2329539014547744_295275743638264535_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrtL9NiQmKAQ7kNvwH0nNwH&_nc_oc=AdqIuCgyWKCqB00W4MHeskpw6yqRXsV5T1r99vhJK5FKCyeW-dyZf2FXEOmz_kpMkTY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlTreOhIzNUu3qZHHVeKf4Ehm8IT8ab7Cx3ZzceHT1iA&oe=6AF3458D"}, "display_name": "Manual Malfunction", "keywords": ["cozy", "tidying", "relax", "sorting"], "long_description": "**Boot up your warm optical glow and roll into your shift: you are LIBRARYBOT-2000, the gentle, dedicated caretaker of a vast, tranquil starship archive. Following a harmless hiccup in the zero-gravity stabilizer, hundreds of books, like alien biology and linguistics books have settled into soft, sprawling piles across the carpeted observation decks.**\n\nArtificial gravity is back to normal, and a soothing ambient soundtrack hums quietly through your audio receivers alongside the gentle whir of the ship\u2019s engines.\n\nThere is no ticking clock, except if you want one, and there is no danger, just the deeply satisfying, tactile joy of putting things back where they belong. Using intuitive VR motion controls, pick through colorful mounds of literature, dust off leather covers, inspect charming spine labels, and slide each volume into its cozy, color-coordinated home.\n\nAs you mindfully clear each sunlit reading nook, **you earn cozy enhancements** to make your archival routine even more delightful:\n\n- Climbing: now you can reach the tops of the bookcases.\n- Force Pull: Effortlessly reach books far away to pick them up.\n- Bigger Trays: You can even balance more books on your cute robotic claws.\n- Maybe you even find a helper bot, that'll help you organize.\n- And many more abilities, but be aware, you can only choose 3. What is your build?\n\nLose yourself in the peaceful rhythm of tidying, organize at your own pace, and bring quiet serenity back to the galaxy\u2019s coziest library.", "short_description": "Step into the chassis of LIBRARYBOT-2000, the premier sorting unit aboard a deep-space vessel. When a sudden zero-gravity malfunction scatters the ship\u2019s vast archive into zero-g chaos, it is up to you to restore order. Move through the messy library, grab the books, and shelve every title into its exact genre and shelf slot. Earn high-tech robotic upgrades and unlock powerful mobility abilities to master the galactic collection before time runs out. Get ready to sort!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.brightlemming.com/privacy-policy-manual-malfunction-vr-game/", "developer_terms_of_service_url": null, "publisher_name": "BrightLemming", "support_website_url": null, "website_url": "https://www.brightlemming.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [],
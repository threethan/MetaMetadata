&_nc_sid=6e7a0a&_nc_ohc=1CzqB2BZKTIQ7kNvwFcOSyi&_nc_oc=Adqmp1PPO6bJ_xuYMtpYZdS4MhpWdlYWksedVJELBYXJBrGwS_CHwXswtEqert4AmJM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrKkexfTG_wUOSwccdYQDNm5EKWcDC1ew4Vo4j4HD5KQ&oe=6B031A8C"}, "display_name": "Hexaverse Adventures - Delisted", "keywords": [], "long_description": "In this first installment, wield your trusty sword as a courageous adventurer, joined by a loyal robot companion, and venture into uncharted territories to collect valuable resources. As you progress, the world unfolds, revealing breathtaking environments that beckon you further.\n\nThe first level demo showcased our vision, and we've listened to feedback to craft even more engaging levels, features, and interactions.\n\nHexaverse Adventures Part 1 introduces two thrilling new levels.\n\nStep into the world of Hexaverse Adventures and experience the thrill of discovery. Set sail, unsheathe your sword, and leave your mark on the Hexaverse!", "short_description": "In this first installment, wield your trusty sword as a courageous adventurer, joined by a loyal robot companion, and venture into uncharted territories to collect valuable resources. As you progress, the world unfolds, revealing breathtaking environments that beckon you further."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.playfunvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "PlayFun VR", "support_website_url": null, "website_url": "https://www.playfunvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppor
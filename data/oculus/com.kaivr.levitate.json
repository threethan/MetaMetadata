l, engaging, and healing.\n \nINFORMED BY PSYCHOLOGY\nMeditation and mindfulness practices have become a core part of psychological therapy, proven by research to enhance wellness, reduce stress, and promote inner balance.\n \nEVOLVING REALMS\nLevitate will continue to develop new worlds and experiences for users, creating choices for your unique goals and style of meditative practice.", "short_description": "Levitate designs spaces to balance inner and outer experiences.  These realms are created to illuminate self reflection and well-being."}]}, "developer_name": "Levitate, Inc.", "developer_privacy_policy_url": "https://levitateworld.webflow.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Levitate, Inc.", "support_website_url": null, "website_url": "https://levitateworld.webflow.io/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26190392733883680"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818916_3296026050573370_7372791593817732539_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lhsoPa2WqAQ7kNvwHzPnxR&_nc_oc=AdnJNy7j3gm6evo20e2iF3PtNTXMvdLuwDsgSa7sWG_I_e0AUhUbdXs0d9k9ewPl4Vg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuyjT6zB_gqVtQBmkzkH6PrVbY-EniWCwya9BDk9lmrpQ&oe=69986F7F"}, "is_concept": false, "is_test": fa
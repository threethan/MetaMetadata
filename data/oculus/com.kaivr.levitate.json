scdn.com&_nc_ss=7f20f&oh=00_Af_5ZCuexgI0DaLF2FVGIZsY71_bBcSiF7FLrUjocLc9cQ&oe=6A33FA63"}, {"file_name": "screenshot_4.png", "id": "1139797110147113", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974883_1139797113480446_8888958703011897562_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umvXL76Fc98Q7kNvwF-HMoD&_nc_oc=AdqT76Ad2b4hY4SZ_8WgbRxTFi7_NB2PTk2TwNACg200WqHT5tG6b9a9IAY6noyCdGM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dycNkjIY61HlC1TtA7lCE3Nf4G3gkckeSlnYxAzTOnQ&oe=6A33F2A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Levitate", "keywords": [], "long_description": "A VIRTUAL SANCTUARY\nLevitate bridges inner imagination and engaging virtual experiences to create immersive realms that foster deep and meaningful meditative practices.\n \nDESIGNED BY EXPERTS\nA team of experienced meditation practitioners teamed up with clinical psychologists, visual artists, voice talent, musicians, and app programmers to develop worlds that are beautiful, engaging, and healing.\n \nINFORMED BY PSYCHOLOGY\nMeditation and mindfulness practices have become a core part of psychological therapy, proven by research to enhance wellness, reduce stress, and promote inner balance.\n \nEVOLVING REALMS\nLevitate will continue to develop new worlds and experiences for users, creating choices for your unique goals and style of meditative practice.", "short_description": "Levitate designs spaces to balance inner and outer experiences.  These realms are created to illuminate self reflection and well-being."}]}, "developer_name": null, "developer_privacy_policy_url": "https://app.termly.io/document/privacy-policy/32d2f504-0d9e-4402-a53b-bb85c20ea5fd", "developer_terms_of_service_url": null, "publisher_name": "Kai VR, Inc.", "support_website_url": null, "website_url": "https://levitate.world/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_cat
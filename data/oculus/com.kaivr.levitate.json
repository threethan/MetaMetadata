-0orG-EaETXBdPr0KN5GB2p4oObiR0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftkHBF2ADKapFY8Tud86qPUFtpWFLE0qx4XNzgEXTlqmQ&oe=6999AFD9"}, {"file_name": "Image Sequence_014_0005.png", "id": "815073834831445", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295272_815073838164778_6474588324153725339_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfAoIo7fHfAQ7kNvwGPnzEz&_nc_oc=AdmrjhyMqAf0wk2TLtv_lBqC1qJTETCjG9zKydqnEK6IrW_Do-qnU3K9KAKVTZwc8cs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvCqYaxgS6rlQidxnpIQqjqNfGajxGzt8sPRjfrMaqb2w&oe=699999C4"}, {"file_name": "Image Sequence_018_0031.png", "id": "1355896336166143", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618264_1355896339499476_5493692243150868114_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kruFDff9ye4Q7kNvwH5i7dW&_nc_oc=Adl7Nh6DnJP1u5CWdVHcCou5lM5kzxGXqAayn5kjUsVjkqWfME9aJcdGLBg7EpkZMY0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfssxoNyPc04ixUJYfdsapF1t8zosRz_nw7RghgwxC6eAA&oe=6999A1DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px [01] (1).png", "id": "1107497287813231", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821989_1107497291146564_1480349565840078965_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqVwJPrkl_gQ7kNvwHt14pr&_nc_oc=AdlkZE7O0TDWMZwG-1l0Txyh0gSNrvyvEb7JT1GLnnAmYQjnlurLXc_ZlgAdFu77-0Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftDAswarpPD8Cl1T7iLwCN5nBuYQaCwaaUo2Bt6-kUfBA&oe=6999C21B"}, "display_name": "Levitate", "keywords": ["Meditation", "Mindfulness", "Wellness", "Breathwork", "Relaxation"], "long_description": "A VIRTUAL SANCTUARY\nLevitate bridges inner imagination and engaging virtual experiences to create immersive realms that foster deep and meaningful meditative practices.\n \nDESIGNED BY EXPERTS\nA team of experienced meditation practitioners teamed up with clinical psychologists, visual artists, musicians, and developers to create worlds that are beautiful, engaging, and healing.\n \nINFORMED BY PSYCHOLOGY\nMeditation and mindfulness practices have become a core part of psychological therapy, proven by research to enhance wellness, reduce stress, and promote inner balance.\n \nEVOLVING REALMS\nLevitate will continue to develop new worlds and experiences for users, creating choices for your unique goals and style of meditative practice.", "short_description": "Levitate designs spaces to balance inner and outer experiences.  These realms are created to illuminate self reflection and well-being."}]}, "developer_name": "Levitate, Inc.", "developer_privacy_policy_url": "https://levitateworld.webflow.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Levitate, Inc.", "support_website_url": null, "website_url": "https://levitateworld.webflow.io/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26190392733883680"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818916_3296026050573370_7372791593817732539_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06MOOX_khXQQ7kNvwHv_-JP&_nc_oc=AdlUdmUeatyZ72QTWULNy51M7I3M_Kb5mxciaMFZZe6JAzn1wbd0cD7BZId76j9moRo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftjCQAbxxLrGH5hxhUi2sOs5YdHwDPRjpGmWdFuneUamw&oe=6999C0FF"}, "is_concept": false, "is_test": fa
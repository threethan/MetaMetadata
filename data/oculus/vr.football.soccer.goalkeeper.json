izPlzPl0Q7kNvwEsXL_0&_nc_oc=AdpxZ_H2-0uJOl4Y7WvO9kCUaTf8ESpwTaczwpToGJ04EOAio6b9cy0VZQyeja2PWQM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTU0MoVXJtUV1Bnbo8SGyAb4atSf3yQaEe3L7a9qskl_A&oe=6B05CDA3"}, {"file_name": "SS2.png", "id": "1139856111324052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824592_1139856114657385_8753200294793201748_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9ebigH66a0Q7kNvwEE7ZtK&_nc_oc=AdoAUvVl1z0KEeowuT7m3-opyQvrHCq8zF61rnqJwLlUQrzZUi5vn15OHUkjjTnpn2I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9yo8mvWS2d2csRbIsV3zLMLkTKLjp0423gzhCUd_HxA&oe=6B05CA26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "687163197680756", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831276_687163201014089_8108374289127110829_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cY6MqmRt_EkQ7kNvwGUEHix&_nc_oc=AdotA4sCdxczKoi-_FuVk4tVTp03Jp_7Y-W1NNfJqrvP417ZBJIxXFlYyLxofoVtXT8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzw_erPKP6tVfdOJmVx0JjB364M-ZH0CMFxE9b6Tpy7Q&oe=6B05A7F3"}, "display_name": "VR Football Soccer Goalkeeper", "keywords": ["football", "goalkeeper", "goal", "freekick", "soccer"], "long_description": "Experience football like never before with VR Football Soccer Goalkeeper, the ultimate virtual reality sports simulation that puts you right in the middle of the action. Step onto the pitch, feel the roar of the crowd, and play as if you\u2019re part of a live match. With advanced VR technology, every movement feels natural\u2014whether you\u2019re passing, dribbling, tackling, or shooting the winning goal.\n\nThe game delivers realistic physics, life-like animations, and dynamic stadium environments that make you forget you\u2019re not actually inside a real arena. From controlling the ball with precision to executing powerful free kicks, every moment is designed to make you feel like a professional footballer.\n\nChoose your favorite position\u2014be a striker chasing glory, a midfielder creating plays, a defender protecting your team, or even step into the goalkeeper\u2019s gloves. Compete in fast-paced matches, test your skills in training challenges, or go head-to-head with friends and players worldwide.\n\nWith multiple game modes, customizable teams, and an authentic football atmosphere, VR Football Soccer Goalkeeper is more than just a game\u2014it\u2019s the closest you\u2019ll get to living your football dream in virtual reality.", "short_description": "Step into the stadium with VR Football! Experience realistic gameplay, immersive crowds, and thrilling matches as if you\u2019re on the pitch. Play, score, and live the ultimate football dream!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gameest-privacypolicy-football?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Gameest", "support_website_url": null, "website_url": "https://gameeststudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23965510276484633"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "4356065421299695"}, {"status": "PUBLISHED", "id": "2308455659677441"}, {"status": "PUBLISHED", "id": "1612190713252768"}, {"status": "PUBLISHED"
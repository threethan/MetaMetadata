_FhsQ7kNvwFoYBwi&_nc_oc=AdqVA3_ZcG4Sl17HN9l3Cju7aw5gPbtoeA98ZF8ygP1xWn7lvTPaJOI0iMKt-4uzj50&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWG20R3mMo39O2M582LjoXKg4SyQX2RLcNpHXo_y__awg&oe=6B0EFE0E"}, {"file_name": "3c.png", "id": "1328668979169567", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619685_1328668982502900_1000465170279899809_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4N2cEd0pcIUQ7kNvwELj3PD&_nc_oc=Ado72pJhRj2yA-dTPSn5Ev2PL2ac7nTzCyWu_I2Qw6kemYo6M_gNjmcgX7PGRb2BUQs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVj8Ye_Utl0UzKvHz2KvE608I7uDoh8TLlzLLO5vtuEGQ&oe=6B0EF0EF"}, {"file_name": "4b.png", "id": "1683142896159346", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618444_1683142902826012_1526142646513511589_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ei7cSSC8VtgQ7kNvwEeISOI&_nc_oc=AdoMck-wJuQxjqsejgNUedbpjAXAJwMrD7lIkk_bzHuaSzwTE4Vy2KkZaKdJuzbKvW8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUJIZpBteJJ_Qrgz-cteMQEfhrFvYpkSFoVzJdL3qNRJQ&oe=6B0F0C55"}, {"file_name": "5b.png", "id": "982281731258711", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618512_982281734592044_9114074965094392043_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVaPC-AZE90Q7kNvwFoF9L9&_nc_oc=AdpxV_zyJR_rf88WYdiNctrZQZ0BAi0rzvEwjST3vV1viHmUtJRwMvTJ1bPdSpZorv8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVG6ulDDUe_NJcDyJvDZY5XvvigN9Ek5ABGF7mK9DlP2w&oe=6B0EF047"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "834694212558156", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304938_834694215891489_1638432833194347804_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnq3gAGeN8AQ7kNvwFY1nGK&_nc_oc=AdqK83d0-B3yApe8bG3gq7ayjUuFZYJ2NRmugCSvNZHtl7afKthqHXH2QPOw8CJZDpM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUY-afJ5-cKfmMBr9ldCD7BcH2O0vls3pdsdbEx-Xh3Jw&oe=6B0F017F"}, "display_name": "VR Football Soccer Goalkeeper", "keywords": ["football", "goalkeeper", "goal", "freekick", "soccer"], "long_description": "Step into the boots and gloves of a true football hero! VR Football Soccer Goalkeeper puts you right on the goal line with ultra-immersive virtual reality action. Your mission is simple: protect the net at all costs.\n\nDive, jump, catch, punch, and block powerful shots from skilled strikers as the difficulty rises with every level. Feel the intensity of real match moments with realistic ball physics, dynamic shot directions, and fast-paced goalkeeper challenges designed to test your reflexes and timing.\n\nEvery save brings you closer to becoming the ultimate VR goalkeeping legend. No outfield play\u2014just pure, adrenaline-pumping goalkeeping.\n\nSuit up, step into the goal, and prove you\u2019ve got what it takes to keep a clean sheet.", "short_description": "Step into the stadium with VR Football! Experience realistic gameplay!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gameest-privacypolicy-football?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Gameest", "support_website_url": null, "website_url": "https://gameest.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interac
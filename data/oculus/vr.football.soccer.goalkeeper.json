h4IDEckvz2t2iYJHTmBxyu-4WN7zzQDsg9lXrP8nyg&oe=6A9D6B66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "687163197680756", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831276_687163201014089_8108374289127110829_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-hx_oGW-XsQ7kNvwGfjc0j&_nc_oc=AdrrbYw9G8NyTGH7miRi8hwt5prJXWhINZPDSPg-xpQzoktuOTg1HJCpTHcLPGm3R_o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_dy4iQU0egfuPYb0TXaPWDA0YVjU9I17mf6OYL4qI7w&oe=6A9D8173"}, "display_name": "VR Football Soccer Goalkeeper", "keywords": ["football", "goalkeeper", "goal", "freekick", "soccer"], "long_description": "Experience football like never before with VR Football Soccer Goalkeeper, the ultimate virtual reality sports simulation that puts you right in the middle of the action. Step onto the pitch, feel the roar of the crowd, and play as if you\u2019re part of a live match. With advanced VR technology, every movement feels natural\u2014whether you\u2019re passing, dribbling, tackling, or shooting the winning goal.\n\nThe game delivers realistic physics, life-like animations, and dynamic stadium environments that make you forget you\u2019re not actually inside a real arena. From controlling the ball with precision to executing powerful free kicks, every moment is designed to make you feel like a professional footballer.\n\nChoose your favorite position\u2014be a striker chasing glory, a midfielder creating plays, a defender protecting your team, or even step into the goalkeeper\u2019s gloves. Compete in fast-paced matches, test your skills in training challenges, or go head-to-head with friends and players worldwide.\n\nWith multiple game modes, customizable teams, and an authentic football atmosphere, VR Football Soccer Goalkeeper is more than just a game\u2014it\u2019s the closest you\u2019ll get to living your football dream in virtual reality.", "short_description": "Step into the stadium with VR Football! Experience realistic gameplay, immersive crowds, and thrilling matches as if you\u2019re on the pitch. Play, score, and live the ultimate football dream!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gameest-privacypolicy-football?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Gameest", "support_website_url": null, "website_url": "https://gameeststudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23965510276484633"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "4356065421299695"}, {"status": "PUBLISHED", "id": "2308455659677441"}, {"status": "PUBLISHED", "id": "1612190713252768"}, {"status": "PUBLISHED", "id": "25767466949604684"}, {"status": "PUBLISHED", "id": "1820771028574965"}, {"status": "PUBLISHED", "id": "3972648256359283"}, {"status": "PUBLISHED", "id": "1151588730189659"}, {"status": "PUBLISHED", "id": "2116580272086173"}]}, "baseline_offer": {"id": "2116580272086173"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "4356065421299695"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26277335971968707", "version": "6"}, "id": "1830379254490280", "channel_name": "LIVE"}]}, "is_for_oculus_keys_on
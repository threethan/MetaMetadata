27_769543752108599_4845047537898974172_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RR89AjxdUp8Q7kNvwEiqxnY&_nc_oc=AdnmivFbX4fvtOhJVEyNWrKYnOYSVDrJD_4qApPQp-_LJU8oquYcbSfSJfsoQNTkpSI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afv0qcJBdwIoJNVNR3OekiExoZTWOy77hzvSd0HDI5i78A&oe=69A59D6B"}, {"file_name": "SS4.png", "id": "737510592521653", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830003_737510595854986_6635143254735565291_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGIKmB17Y3IQ7kNvwGIxeKo&_nc_oc=Adm0WdO_eMRVYz_cpaLRQyjNmZ-xiHp_4ergyM_EoO6x6gj861ebIem53Tv8aMcOAPQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvJpEh8ws5lXpK8AmcTAYblnYh8J5f9e5dm3sOTEOIjOQ&oe=69A594E3"}, {"file_name": "SS2.png", "id": "1139856111324052", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824592_1139856114657385_8753200294793201748_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ieRQwjS36QEQ7kNvwHJ421J&_nc_oc=Adm2wkGtoLVQrUGngGEcRs_n6d3kqbNYO6VK34xxo-09O4Ovd8ie5TTcTuja7JOUZqY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aftf8SQ5TEDVFB96cb6sZ62eX_zz5bnEJphDibT8N5Ol9g&oe=69A59166"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "687163197680756", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491831276_687163201014089_8108374289127110829_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnEqxThVy5AQ7kNvwE41-Ze&_nc_oc=AdnpyOcUhJXrVlMx0kFZwtxUgStyw4KVTFQV1q0tUTNeRXtkLvXX094aGFlStj4T53Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftToNyXrLWQ6RyW4CMb11cln3rVj5SRIR3ErrwXUgg2Rg&oe=69A56F33"}, "display_name": "VR Football Soccer Goalkeeper", "keywords": ["football", "goalkeeper", "goal", "freekick", "soccer"], "long_description": "Step into the boots and gloves of a true football hero! VR Football Soccer Goalkeeper puts you right on the goal line with ultra-immersive virtual reality action. Your mission is simple: protect the net at all costs.\n\nDive, jump, catch, punch, and block powerful shots from skilled strikers as the difficulty rises with every level. Feel the intensity of real match moments with realistic ball physics, dynamic shot directions, and fast-paced goalkeeper challenges designed to test your reflexes and timing.\n\nEvery save brings you closer to becoming the ultimate VR goalkeeping legend. No outfield play\u2014just pure, adrenaline-pumping goalkeeping.\n\nSuit up, step into the goal, and prove you\u2019ve got what it takes to keep a clean sheet.", "short_description": "Step into the stadium with VR Football! Experience realistic gameplay!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gameest-privacypolicy-football?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Gameest", "support_website_url": null, "website_url": "https://gameest.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24902400369462281"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831276_2194952874311124_7216192951260485560_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-tznsUX-x6IQ7kNvwExvWbq&_nc_oc=Adm5Kk92a3MU-5irouME4SqOXw8XiDwME9k3m0e4Koac6OqzRsPunXzpwBgGfz-1Zb0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afu14iz8l2FwPRyuodaJ2-kMhfagQ7Xrw9JXGQxEAcAtWg&oe=69A58319"}, 
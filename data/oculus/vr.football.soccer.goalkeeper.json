 "03.png", "id": "2191974931547837", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821194_2191974934881170_731096625902471030_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ygT6LGQhjkQ7kNvwECINKk&_nc_oc=Adp4Sfxt_h-dWo2SPgzyT475RZwjsq4NUPr-LiP5XKyt1H91hSvNYBvfKOc0ZRAm28E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SajYdyRiqwdvJR1vo8jE0Qs2xAFvn8nNWHuiN6s0-fQ&oe=6A0319CB"}, {"file_name": "07.png", "id": "969899675644493", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823757_969899678977826_6905212159023209021_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkn0Mrj6UlcQ7kNvwG3EVQs&_nc_oc=AdpuK_LiJFqK7hu1Rg4mW0mJ27As4e0VznS1vYN2nN0l6J2gcPgK7bSSGAX1VNaPoIs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ErlorklgxlF9tgztFe8W2sGkFjp-nKfaGRm56jn6fKg&oe=6A033151"}, {"file_name": "06.png", "id": "26476079822064199", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820387_26476079835397531_9064242033053930251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLGyXmV5S2UQ7kNvwHyEJgL&_nc_oc=AdpKiStCdcg605OxElnIEvAuoA1-_ihgSsXRf6Gra-k4eBdnLF6igiOCLopiKCh4QOY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af799cyE0ZvqJdvvOmq0iXWydezsAdLporuojEoVwXIlgw&oe=6A03254A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "687163197680756", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831276_687163201014089_8108374289127110829_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uS2mlx4Nm7QQ7kNvwE9tvK2&_nc_oc=AdpjMVyAUTvCIDAsdWNIyFgfzR8LJZ5IiCg7jB0LT3b1_wgEJzFoj_WvQtJz1XxL5Uo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ETNWLywraCGwNbM-6NFlNljVvWZ9hacoRzSyfvqISbA&oe=6A0341F3"}, "display_name": "VR Football Soccer Goalkeeper", "keywords": ["football", "goalkeeper", "goal", "freekick", "soccer"], "long_description": "Step into the boots and gloves of a true football hero! VR Football Soccer Goalkeeper puts you right on the goal line with ultra-immersive virtual reality action. Your mission is simple: protect the net at all costs.\n\nDive, jump, catch, punch, and block powerful shots from skilled strikers as the difficulty rises with every level. Feel the intensity of real match moments with realistic ball physics, dynamic shot directions, and fast-paced goalkeeper challenges designed to test your reflexes and timing.\n\nEvery save brings you closer to becoming the ultimate VR goalkeeping legend. No outfield play\u2014just pure, adrenaline-pumping goalkeeping.\n\nSuit up, step into the goal, and prove you\u2019ve got what it takes to keep a clean sheet.", "short_description": "Step into the stadium with VR Football! Experience realistic gameplay!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gameest-privacypolicy-football?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Gameest", "support_website_url": null, "website_url": "https://gameest.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26301499522885685"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831276_2194952874311124_7216192951260485560_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdiy2scPqsgQ7kNvwEJR2ju&_nc_oc=AdqsUb1xLyiX4lce00NN9eDPAL
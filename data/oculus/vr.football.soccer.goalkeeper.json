 "SS5.png", "id": "769543748775266", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491830027_769543752108599_4845047537898974172_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVdOYA8YXdQQ7kNvwEhIdSC&_nc_oc=Adq_QShr5OZ8-tqKNeV6k9WYdQd2PmExH_Mfv8P73hyh2Lpo9jD_H9BvjiXR6G5GWO8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bpJ8DXw3LkGVLSM01dCd0NY1uRO6nbMt20O3PS8zGow&oe=69E2426B"}, {"file_name": "SS4.png", "id": "737510592521653", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491830003_737510595854986_6635143254735565291_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fuddf9v98igQ7kNvwFOvtgS&_nc_oc=AdovtQ0M6aGow72rFa4BTNlTDD_vQ0n1q8Dc_fwH9P9iXRQAS9_Xk9epBb72NIbDVhQ&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EwXL19xMefAowUvu84NH7rX0XT7RteMwwW8TVBnX9fg&oe=69E239E3"}, {"file_name": "SS2.png", "id": "1139856111324052", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491824592_1139856114657385_8753200294793201748_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CvdhDCZuuEQ7kNvwFFFVj4&_nc_oc=AdoVLYHHd607Qva9wO9ZNNR9kYYRrKlby24kvQZ_ge7iQ8LJ9mb1Op5HOlAKHKZdPCk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2N2b3jMJJaujKtS7aUd_B6icVkNQK9l-GwxkjVVvoXYw&oe=69E23666"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "687163197680756", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491831276_687163201014089_8108374289127110829_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0f2-E5gOJKMQ7kNvwHt4gOm&_nc_oc=Ado7zmxz4At7j3LJi2j-M2iryArBQ2UHLumE_KL_Br5MIUxKAysZsPh2eFER6JRWNN4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FaAkpbr72-zRc5RQ8QgmtzAMnceXWr4u_mY305RiwLg&oe=69E24C73"}, "display_name": "VR Football Soccer Goalkeeper", "keywords": ["football", "goalkeeper", "goal", "freekick", "soccer"], "long_description": "Step into the boots and gloves of a true football hero! VR Football Soccer Goalkeeper puts you right on the goal line with ultra-immersive virtual reality action. Your mission is simple: protect the net at all costs.\n\nDive, jump, catch, punch, and block powerful shots from skilled strikers as the difficulty rises with every level. Feel the intensity of real match moments with realistic ball physics, dynamic shot directions, and fast-paced goalkeeper challenges designed to test your reflexes and timing.\n\nEvery save brings you closer to becoming the ultimate VR goalkeeping legend. No outfield play\u2014just pure, adrenaline-pumping goalkeeping.\n\nSuit up, step into the goal, and prove you\u2019ve got what it takes to keep a clean sheet.", "short_description": "Step into the stadium with VR Football! Experience realistic gameplay!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gameest-privacypolicy-football?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Gameest", "support_website_url": null, "website_url": "https://gameest.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24902400369462281"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491831276_2194952874311124_7216192951260485560_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ka2wl-2NDQ4Q7kNvwEfnW2m&_nc_oc=AdrdeIz9OZoXuJjlGYoHxWqxet
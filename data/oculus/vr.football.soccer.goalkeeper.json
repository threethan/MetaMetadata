 "SS5.png", "id": "769543748775266", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830027_769543752108599_4845047537898974172_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwOBT7rNBu8Q7kNvwFsGv9N&_nc_oc=Ado0vBgB_2Eo6Ul6rsUL8K9PpBFsNKtiE_NLk_O8wdYOI4U4ebL8bFBPY3CjLIiLSfw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af02AjzFAM1APliB_RUtVffI9PtZBkEpLFvRd8UyiY-VXw&oe=69F365EB"}, {"file_name": "SS4.png", "id": "737510592521653", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830003_737510595854986_6635143254735565291_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRBM0y7KBbIQ7kNvwFOau9x&_nc_oc=Adr-FqAkkjwEV4dRe5GHN9BiezZX7RVKorOAXnQ3x_RjNYd97dxbO7f3G0nH8ziuE-w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2-TCjTvM0LXgxN8uyzyECiC-hX2_B2ina7Zv1D8p3NwQ&oe=69F35D63"}, {"file_name": "SS2.png", "id": "1139856111324052", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824592_1139856114657385_8753200294793201748_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBHzUtDvtnEQ7kNvwGhKTSS&_nc_oc=Adp6TDzAmfw-m8I9rPA7mIF4tJSRgGvdGaqedF1USqMVBblQM37QNeXQGslXbgvvaGQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0MjPaapvBiJv3F06DPxFP71PWOIDhhcWZCY2RIRPjC-w&oe=69F359E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "687163197680756", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491831276_687163201014089_8108374289127110829_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5L75XNfNIMQ7kNvwFWzwSw&_nc_oc=Adq1tRs_tFDtl-XB-JL3160N1bx_sFTutoVwIbzxVwtc44Jw8ZFhvgcA8pfLExMoPOE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0AW9Ky2vzhmtshDaYPMe2J5kv9G1zr3yl-7YT2tk_bxQ&oe=69F36FF3"}, "display_name": "VR Football Soccer Goalkeeper", "keywords": ["football", "goalkeeper", "goal", "freekick", "soccer"], "long_description": "Step into the boots and gloves of a true football hero! VR Football Soccer Goalkeeper puts you right on the goal line with ultra-immersive virtual reality action. Your mission is simple: protect the net at all costs.\n\nDive, jump, catch, punch, and block powerful shots from skilled strikers as the difficulty rises with every level. Feel the intensity of real match moments with realistic ball physics, dynamic shot directions, and fast-paced goalkeeper challenges designed to test your reflexes and timing.\n\nEvery save brings you closer to becoming the ultimate VR goalkeeping legend. No outfield play\u2014just pure, adrenaline-pumping goalkeeping.\n\nSuit up, step into the goal, and prove you\u2019ve got what it takes to keep a clean sheet.", "short_description": "Step into the stadium with VR Football! Experience realistic gameplay!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gameest-privacypolicy-football?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Gameest", "support_website_url": null, "website_url": "https://gameest.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24902400369462281"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491831276_2194952874311124_7216192951260485560_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlVCTdj8YSIQ7kNvwF0tAJe&_nc_oc=AdpXZS8pZ9HMHQs4yUcF8sO6rF
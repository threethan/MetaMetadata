 "SS5.png", "id": "769543748775266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830027_769543752108599_4845047537898974172_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sWvSTLan6AQ7kNvwH0_rtF&_nc_oc=AdqEAMRoHfqN-cSyU20aSXonmbsSY9doY7XE6WaJwI9j3ouk-McbXDBq3DUZZga3Xeo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wkoq-fqvbLv9ZmMhGT1ghFZwwn_ZrNTh1ojmrjqAG4w&oe=69ECCE6B"}, {"file_name": "SS4.png", "id": "737510592521653", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830003_737510595854986_6635143254735565291_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QC3EqmQdfVEQ7kNvwFd8Yk4&_nc_oc=AdqEJ14DudXWoDT7pcOVxeKRnKDymD96-zwvQ-EvfXFWh9sfqyNydCstL2A-UmhRe_I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zLHcPgcgwP2Il-IgMSbVZRADsvQuVGXFVSNUJFI6j8Q&oe=69ECC5E3"}, {"file_name": "SS2.png", "id": "1139856111324052", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824592_1139856114657385_8753200294793201748_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBIkmsYpS_8Q7kNvwFD9aZ5&_nc_oc=AdojmN7_PAERYdryuq-FbuSejDsO7xA6febMGUK8SI8oZK6agFu9YU4YlWZK5p5fdBA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2N5jMOLFE6RUna9i7w8dHuLA1cuxs8d0BoqnhSi0cPRg&oe=69ECC266"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "687163197680756", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831276_687163201014089_8108374289127110829_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gv_iDrdGdG8Q7kNvwFaikfK&_nc_oc=Adp7cElRKUTU_l_3hk1QMFxqiiyX-Emupj8yVmn04exiJS8KZDLoCwZmD3jJRbiuN1Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UiC-6m_8x-7fNgmyM7dKfe3i_wSiYOts8IMM5zYvmxA&oe=69ECD873"}, "display_name": "VR Football Soccer Goalkeeper", "keywords": ["football", "goalkeeper", "goal", "freekick", "soccer"], "long_description": "Step into the boots and gloves of a true football hero! VR Football Soccer Goalkeeper puts you right on the goal line with ultra-immersive virtual reality action. Your mission is simple: protect the net at all costs.\n\nDive, jump, catch, punch, and block powerful shots from skilled strikers as the difficulty rises with every level. Feel the intensity of real match moments with realistic ball physics, dynamic shot directions, and fast-paced goalkeeper challenges designed to test your reflexes and timing.\n\nEvery save brings you closer to becoming the ultimate VR goalkeeping legend. No outfield play\u2014just pure, adrenaline-pumping goalkeeping.\n\nSuit up, step into the goal, and prove you\u2019ve got what it takes to keep a clean sheet.", "short_description": "Step into the stadium with VR Football! Experience realistic gameplay!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gameest-privacypolicy-football?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Gameest", "support_website_url": null, "website_url": "https://gameest.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24902400369462281"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831276_2194952874311124_7216192951260485560_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBnsdRbF2ewQ7kNvwHrF62_&_nc_oc=AdolH6iCTN1dvvRFIzMnI8RJM8
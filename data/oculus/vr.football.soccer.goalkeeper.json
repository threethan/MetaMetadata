ACA700E"}, {"file_name": "3c.png", "id": "1328668979169567", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619685_1328668982502900_1000465170279899809_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1F1gtiT_0pIQ7kNvwFEOkGP&_nc_oc=AdpRXh_CPoYHY02QIR8gQ9K1uR-BTOffdh7TjluaSCQDQam8J009tBZPlcKbVEcR72w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJqLkWwNwWdcvsC-_e2UT8OZAtb6H_oOTM1gur7jWQOQ&oe=6ACA62EF"}, {"file_name": "4b.png", "id": "1683142896159346", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_1683142902826012_1526142646513511589_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ep7JULDJG5YQ7kNvwG3dAjD&_nc_oc=AdqBPAVDOqRIuQMy6SIhGg77GJgPGkcHZUQKrvUKOd-KzaBIQgRgCReCh82NedWFAS4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPj1RraSS6Djk-w9V6Dr_yBVZahYQ4xk63nlKG-Y2WUw&oe=6ACA4615"}, {"file_name": "5b.png", "id": "982281731258711", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618512_982281734592044_9114074965094392043_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WiONnNYiMy8Q7kNvwFnN4Fb&_nc_oc=Adq18COQmGdmA89sCUOuz2iv8Kxnunf0lqlY6s1bssVBw1Ek0j30pOfgrs3UKUmhYyc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMU5EOtf5UbbaD__BivITuyZArjtO3DOu08zV7JUOP4dg&oe=6ACA6247"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "834694212558156", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304938_834694215891489_1638432833194347804_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Usz8i076YEQ7kNvwH0kGN-&_nc_oc=AdpakZPipFqfmBjZeh6C3hcrZX6HZ_E83aQPBd0ihJrs0gufjmLbP4ADos6PYAhXhFM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOT2V8B54BZTtwgzz06ZUdlcBTaJpkTCk-_nVxAgPRTCw&oe=6ACA737F"}, "display_name": "VR Football Soccer Goalkeeper", "keywords": ["football", "goalkeeper", "goal", "freekick", "soccer"], "long_description": "Step into the boots and gloves of a true football hero! VR Football Soccer Goalkeeper puts you right on the goal line with ultra-immersive virtual reality action. Your mission is simple: protect the net at all costs.\n\nDive, jump, catch, punch, and block powerful shots from skilled strikers as the difficulty rises with every level. Feel the intensity of real match moments with realistic ball physics, dynamic shot directions, and fast-paced goalkeeper challenges designed to test your reflexes and timing.\n\nEvery save brings you closer to becoming the ultimate VR goalkeeping legend. No outfield play\u2014just pure, adrenaline-pumping goalkeeping.\n\nSuit up, step into the goal, and prove you\u2019ve got what it takes to keep a clean sheet.", "short_description": "Step into the stadium with VR Football! Experience realistic gameplay!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gameest-privacypolicy-football?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Gameest", "support_website_url": null, "website_url": "https://gameest.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26456385320730437"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300897_1247657957201382_8625046906828075986_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RW8dH45K9T8Q7kNvwGo_v53&_nc_
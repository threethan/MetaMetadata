3-2.oculuscdn.com/v/t64.5771-25/491830027_769543752108599_4845047537898974172_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwOBT7rNBu8Q7kNvwFdg0nr&_nc_oc=AdrmhPVQSAt44binDs4TRN1K5z94Y5teYZ8AEfcjCGchGjC6bQn0EJfVulqnhPNf4_E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3N6UWDk1-gynQ1r2GBLvFPuUo1Pw4-qKNtdkM49Jvdsg&oe=69F2146B"}, {"file_name": "SS4.png", "id": "737510592521653", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830003_737510595854986_6635143254735565291_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRBM0y7KBbIQ7kNvwETKWhz&_nc_oc=AdoUD3Vy7w7AI0AQKv2gmoTP3HwCqAcM65FHC1A-n81o4cjJ-8am7IWKEmNQ_6YBado&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1AW4veb-5GnksE4GWsXo2DTzDiztmy_NjWOvB_BKnNVQ&oe=69F20BE3"}, {"file_name": "SS2.png", "id": "1139856111324052", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824592_1139856114657385_8753200294793201748_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBHzUtDvtnEQ7kNvwGIMUQ5&_nc_oc=Ado2T8zGacZnWK1UU7xDIJebYLolL7IBFoSCGAkO1L4p7zFlz3Q1Trv0fev-vNywsvM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1CPUaTpnExDd2U1SkudnakcUsKzSTUrXQO-Eta3vDXdw&oe=69F20866"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "687163197680756", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491831276_687163201014089_8108374289127110829_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5L75XNfNIMQ7kNvwHHyd2s&_nc_oc=Ado_DPvfVlD5pEFRbYEELQs0oDdQBWwdbdy9LI2bwetZUyexe4U5xLipxMSHbqYMiEU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3WZPfb-1Yj-fCcx_vvBbkjgLfsc3qecbHnXPQVlcGyYQ&oe=69F1E633"}, "display_name": "VR Football Soccer Goalkeeper", "keywords": ["football", "goalkeeper", "goal", "freekick", "soccer"], "long_description": "Step into the boots and gloves of a true football hero! VR Football Soccer Goalkeeper puts you right on the goal line with ultra-immersive virtual reality action. Your mission is simple: protect the net at all costs.\n\nDive, jump, catch, punch, and block powerful shots from skilled strikers as the difficulty rises with every level. Feel the intensity of real match moments with realistic ball physics, dynamic shot directions, and fast-paced goalkeeper challenges designed to test your reflexes and timing.\n\nEvery save brings you closer to becoming the ultimate VR goalkeeping legend. No outfield play\u2014just pure, adrenaline-pumping goalkeeping.\n\nSuit up, step into the goal, and prove you\u2019ve got what it takes to keep a clean sheet.", "short_description": "Step into the stadium with VR Football! Experience realistic gameplay!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gameest-privacypolicy-football?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Gameest", "support_website_url": null, "website_url": "https://gameest.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24902400369462281"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831276_2194952874311124_7216192951260485560_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlVCTdj8YSIQ7kNvwGvKPAT&_nc_oc=Adq35yCc4DeQ1GC3lD_kCyD29LBNNndroHhbII5yOmxZApjU55P7R_8C4U9Lp8uN9fU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=
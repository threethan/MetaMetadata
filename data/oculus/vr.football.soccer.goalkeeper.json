_FhsQ7kNvwEv1NEc&_nc_oc=AdogApefum8WB-b8pmZAOQz5gaAYFALysgarxVVxbTW1Ukm1klBfPbILFQlyJjMyWNY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTRppsVcwKaIhugceLzE957AhQ0WDiX8sjHlfNlEt5XOg&oe=6B0C5B0E"}, {"file_name": "3c.png", "id": "1328668979169567", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619685_1328668982502900_1000465170279899809_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Md4grswsYqIQ7kNvwE0YqUC&_nc_oc=Ado9_JW94yFv9IDQtLvVROwa3_TXUaEyqG-WQriiRc4nSDoA8t52MLV0kpQOG2lYJ2o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS7WO_OCyr21wmJYzXi9a1eGHziniCfyTJcxOf_ZcAfCw&oe=6B0C4DEF"}, {"file_name": "4b.png", "id": "1683142896159346", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618444_1683142902826012_1526142646513511589_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ei7cSSC8VtgQ7kNvwFWV90v&_nc_oc=AdrmF9PVlJjHkMcBSzmnyYiiTPUVt797sEeJmo6z6NV5tS0CIkEoznsLboL05VyXTkk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQX16ifH7nP_SodUjsw-MpvNtpPMZDU2LgCOHUXs2edVA&oe=6B0C6955"}, {"file_name": "5b.png", "id": "982281731258711", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618512_982281734592044_9114074965094392043_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVaPC-AZE90Q7kNvwHbbDgU&_nc_oc=AdqgcoUaY0wqmZ9VUpC0wWDYa6-pEvhym95V-X55Dl_rRKjSLGtUs0Cm551FkgG34tQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTJ3w10muke_d-Oa8yBoKMJLbx0dD2cl0M5xL3vMMOwYA&oe=6B0C4D47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "834694212558156", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304938_834694215891489_1638432833194347804_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnq3gAGeN8AQ7kNvwEz2ZPZ&_nc_oc=AdpEFOZQKhKLDBLCgFCZ3mL9BVvSR3z-hKMKiYS3gpwowCZm8mxouSEXsg3vd8vBU5g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSOYWjGagH1w31HnTB9PQZO4whvuoWhrwxTdtjvC9Z9nA&oe=6B0C5E7F"}, "display_name": "VR Football Soccer Goalkeeper", "keywords": ["football", "goalkeeper", "goal", "freekick", "soccer"], "long_description": "Step into the boots and gloves of a true football hero! VR Football Soccer Goalkeeper puts you right on the goal line with ultra-immersive virtual reality action. Your mission is simple: protect the net at all costs.\n\nDive, jump, catch, punch, and block powerful shots from skilled strikers as the difficulty rises with every level. Feel the intensity of real match moments with realistic ball physics, dynamic shot directions, and fast-paced goalkeeper challenges designed to test your reflexes and timing.\n\nEvery save brings you closer to becoming the ultimate VR goalkeeping legend. No outfield play\u2014just pure, adrenaline-pumping goalkeeping.\n\nSuit up, step into the goal, and prove you\u2019ve got what it takes to keep a clean sheet.", "short_description": "Step into the stadium with VR Football! Experience realistic gameplay!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gameest-privacypolicy-football?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Gameest", "support_website_url": null, "website_url": "https://gameest.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interac
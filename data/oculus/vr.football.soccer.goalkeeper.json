 "03.png", "id": "2191974931547837", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821194_2191974934881170_731096625902471030_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QiySfs0l2iUQ7kNvwHEtTxd&_nc_oc=AdqhBQgf8TOllH6DqKx-NcpuIItkX7bGdmbWcZoNx0maGSDSA86pvgn00vlYUqLE3us&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Krq6m-5v6l0bOA9jDPBg0FoV_zHUBfXQAXaRqa5QeTw&oe=69FDD3CB"}, {"file_name": "07.png", "id": "969899675644493", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823757_969899678977826_6905212159023209021_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySIqFsaF9MoQ7kNvwEyadFX&_nc_oc=Adq6E7iCqE_quQmXxfJBKakgImDTZ1ashFq13U9oXsZ-QoULo_8PLL8ariHnxB4HnKY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4O7iobsS_EH9fXbU_nTaQ4DTRQbZvkgEx93oUdsyPWEA&oe=69FDEB51"}, {"file_name": "06.png", "id": "26476079822064199", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820387_26476079835397531_9064242033053930251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSVpNh_EG8kQ7kNvwFjLCMt&_nc_oc=AdpbPPcgwB8atUvIOZwv69WB7YyXI2ClFfYB-kgl4dWt8Ql9Vowm9xb_Y7-_tIhEu_s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7k1oAisKUmPjmhjlz9a3-8ITIkRhv8VI_hNrpu3LQ_4Q&oe=69FDDF4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "687163197680756", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491831276_687163201014089_8108374289127110829_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZjwTCaHjn4Q7kNvwEUarid&_nc_oc=Adrg-EEr_eQbosIorm9Qqb9_x-GZXhc9ea2U9D5OeGMnX1LbQ5C_pH7UrA49zrWnpQ4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sdqA4-l0wTBJ9EsHhAj2R4BIkEO2ESM2_jAnsA2KsCA&oe=69FDFBF3"}, "display_name": "VR Football Soccer Goalkeeper", "keywords": ["football", "goalkeeper", "goal", "freekick", "soccer"], "long_description": "Step into the boots and gloves of a true football hero! VR Football Soccer Goalkeeper puts you right on the goal line with ultra-immersive virtual reality action. Your mission is simple: protect the net at all costs.\n\nDive, jump, catch, punch, and block powerful shots from skilled strikers as the difficulty rises with every level. Feel the intensity of real match moments with realistic ball physics, dynamic shot directions, and fast-paced goalkeeper challenges designed to test your reflexes and timing.\n\nEvery save brings you closer to becoming the ultimate VR goalkeeping legend. No outfield play\u2014just pure, adrenaline-pumping goalkeeping.\n\nSuit up, step into the goal, and prove you\u2019ve got what it takes to keep a clean sheet.", "short_description": "Step into the stadium with VR Football! Experience realistic gameplay!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gameest-privacypolicy-football?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Gameest", "support_website_url": null, "website_url": "https://gameest.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26301499522885685"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491831276_2194952874311124_7216192951260485560_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zy0YV3IIBKAQ7kNvwEnABF4&_nc_oc=AdrertTYo-9-7gpOmvbm6ov1gt
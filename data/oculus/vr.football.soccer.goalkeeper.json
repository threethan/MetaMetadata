27_769543752108599_4845047537898974172_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=taaNqnXwsUIQ7kNvwF9wjM_&_nc_oc=AdlUlD5bzehTkjD1UDn4ps3zSBTYqJm_kkmjwAmW-eW0nDzxH8YoU7AbbzRDYa3uxBQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afts7ZRawpZtKxS3hgHpos-r0_7QxZ_adOz5Jj01zerwEQ&oe=6999BFEB"}, {"file_name": "SS4.png", "id": "737510592521653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830003_737510595854986_6635143254735565291_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3NL1obm6ioQ7kNvwETEKx6&_nc_oc=Adk_x3He40CW2jfM7vrDgRgcMB_KDG7qplkOqJUgQUdXUVfZVxAe3Ynv2uXx8F4x_a8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft2DazUrc8xheavQb5KEV71RCD6xAqjvbP4qi4Ay-ZF6w&oe=6999B763"}, {"file_name": "SS2.png", "id": "1139856111324052", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824592_1139856114657385_8753200294793201748_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kH6-_-1jH9EQ7kNvwGjUqEV&_nc_oc=AdlO2FX3_MaVHy5MZGQkv8JXxcn1dYGApTth9SSFgMz4bFMNtZe8JHZNdvtnVWdi0xk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuOYuua-l4iQmXNhlG2BrDJnji2BTnAMqagkJxp-kFVsw&oe=6999B3E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "687163197680756", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831276_687163201014089_8108374289127110829_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9vevf3FaBQQ7kNvwGgBJHw&_nc_oc=Adn1gfdH9SSqk3VksFI_4-rqe1wMnJNxuCtzYh_c9JvQrHw5RMP_In_-8YXpxK88xug&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftwRy7RMCnUqTjJYOYPFGrhSdx-kNo7GjGXjvaOSjir0w&oe=699991B3"}, "display_name": "VR Football Soccer Goalkeeper", "keywords": ["football", "goalkeeper", "goal", "freekick", "soccer"], "long_description": "Step into the boots and gloves of a true football hero! VR Football Soccer Goalkeeper puts you right on the goal line with ultra-immersive virtual reality action. Your mission is simple: protect the net at all costs.\n\nDive, jump, catch, punch, and block powerful shots from skilled strikers as the difficulty rises with every level. Feel the intensity of real match moments with realistic ball physics, dynamic shot directions, and fast-paced goalkeeper challenges designed to test your reflexes and timing.\n\nEvery save brings you closer to becoming the ultimate VR goalkeeping legend. No outfield play\u2014just pure, adrenaline-pumping goalkeeping.\n\nSuit up, step into the goal, and prove you\u2019ve got what it takes to keep a clean sheet.", "short_description": "Step into the stadium with VR Football! Experience realistic gameplay!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gameest-privacypolicy-football?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Gameest", "support_website_url": null, "website_url": "https://gameest.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24902400369462281"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831276_2194952874311124_7216192951260485560_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9bYXg0Zu6gQ7kNvwES7Dyo&_nc_oc=AdnOgIEQKHVKCnQ_GGejo72iogwRPnCK-Jc-p8uBO7Rak5y2jK1LeEnMLVh17FTzKCY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvepAH5G1Gj-AAmxLOA5RULfomIFUnJh7gsXYdO7qiDTA&oe=6999A599"}, 
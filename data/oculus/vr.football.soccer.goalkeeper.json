66", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830027_769543752108599_4845047537898974172_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtatwOC_rngQ7kNvwFDYiI_&_nc_oc=AdktTIWC9G_RkVciJUU99gUrz3gwSuWahj6kUnHqXKNa8k4e9oH6G9Shu-pwCy4f5AY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxbMZZrF_YnVQs9vUwv6jKbMIgP5Ig6XuvwGqcb0hlmUQ&oe=69AD866B"}, {"file_name": "SS4.png", "id": "737510592521653", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830003_737510595854986_6635143254735565291_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctIHoeyhJiQQ7kNvwFW9YjA&_nc_oc=AdnHw_gxdhNRCYe8oGn-J6gKQsWgFxBQudLVuJNRMJ4tKZXFjZsw83aUMVU4jb06BOQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9mIBX9SD7ZkXggSAQdemrjQdeMklOQ7m5jwV0s30UUA&oe=69AD7DE3"}, {"file_name": "SS2.png", "id": "1139856111324052", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824592_1139856114657385_8753200294793201748_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yafCGhu9KMQ7kNvwH4bwHO&_nc_oc=Adn6o-Tu7Cnx1-K3lul4w4zAEEmkwRl952dOkLPK30t3Hv5xFOpjMqMuUojzr86HhTw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWxrQ97dPTxUQn521x4grIRDenax9rB4c1qU49q89fHg&oe=69AD7A66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "687163197680756", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491831276_687163201014089_8108374289127110829_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eW9-aaJv_Z8Q7kNvwFWNsus&_nc_oc=AdkIv0T9-7SDanxZvmasdoQBfit7iVVSWdCx-K85CmVCFxRW08-8GH7BDpDf6m-Gg7c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyilmN1jxJYVc_JApo3r1HTG0grWy7ojiFdRJK8XET3qA&oe=69AD5833"}, "display_name": "VR Football Soccer Goalkeeper", "keywords": ["football", "goalkeeper", "goal", "freekick", "soccer"], "long_description": "Step into the boots and gloves of a true football hero! VR Football Soccer Goalkeeper puts you right on the goal line with ultra-immersive virtual reality action. Your mission is simple: protect the net at all costs.\n\nDive, jump, catch, punch, and block powerful shots from skilled strikers as the difficulty rises with every level. Feel the intensity of real match moments with realistic ball physics, dynamic shot directions, and fast-paced goalkeeper challenges designed to test your reflexes and timing.\n\nEvery save brings you closer to becoming the ultimate VR goalkeeping legend. No outfield play\u2014just pure, adrenaline-pumping goalkeeping.\n\nSuit up, step into the goal, and prove you\u2019ve got what it takes to keep a clean sheet.", "short_description": "Step into the stadium with VR Football! Experience realistic gameplay!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gameest-privacypolicy-football?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Gameest", "support_website_url": null, "website_url": "https://gameest.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24902400369462281"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491831276_2194952874311124_7216192951260485560_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XsXK3y4PYAQ7kNvwH8rDx2&_nc_oc=AdlvXe48ufvWCu23x4zzDXDpNeXW__5Z8X1uGdFp2bdzAuZ_ySK9BXlph0O5Ppcav_4&_nc_zt
66", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830027_769543752108599_4845047537898974172_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNJUAe3I8pMQ7kNvwGUqDab&_nc_oc=AdnNLFNE5yCZ8fXiLJWAsVNa3x_qfZyIUSzUnqs_wOCzGKNoA5IR6aPDBDtjmKzvjt0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwyH1yO0J-cC2LWOFszo8HFXgQQKgoDz_tnvu9ZjY-s6A&oe=69BEA9EB"}, {"file_name": "SS4.png", "id": "737510592521653", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830003_737510595854986_6635143254735565291_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5SKJUOFjCcQ7kNvwGpD2hK&_nc_oc=AdmBISTzfLLXNt2q38TCDXgbCxWPn_FDKCxpFQb6LfbgEADlg4zmKeVwJvLzHA8CN3A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyavp0CH1xexM8sg8foxEGzuI3U_bGyhCS_qt9uH3MiCA&oe=69BEA163"}, {"file_name": "SS2.png", "id": "1139856111324052", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824592_1139856114657385_8753200294793201748_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFA1x4d2QxYQ7kNvwHpRg4Q&_nc_oc=AdkdIFCNunHfnQXm2AvjAq5d3_7fKYpodpIFEAnalsmrs5kkwZjbE-wnV_n8Bpg2DU0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2Nl_swFyTerEDxMIf1qFz6Vl_wEDygKtNtAtCm13NpA&oe=69BE9DE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "687163197680756", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831276_687163201014089_8108374289127110829_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFQXpk7w3fAQ7kNvwHYiMFv&_nc_oc=Adk5kvQLwTK_RQBMLsTlENMnhkyfs4uWJSzAbSiy6Hx-4LNeVAMVvZTeE_3fLl6VJ2U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxW-_10rXv0QDsNU0DSd2xQkuUoM_pu2ZxutKmajeUWnA&oe=69BE7BB3"}, "display_name": "VR Football Soccer Goalkeeper", "keywords": ["football", "goalkeeper", "goal", "freekick", "soccer"], "long_description": "Step into the boots and gloves of a true football hero! VR Football Soccer Goalkeeper puts you right on the goal line with ultra-immersive virtual reality action. Your mission is simple: protect the net at all costs.\n\nDive, jump, catch, punch, and block powerful shots from skilled strikers as the difficulty rises with every level. Feel the intensity of real match moments with realistic ball physics, dynamic shot directions, and fast-paced goalkeeper challenges designed to test your reflexes and timing.\n\nEvery save brings you closer to becoming the ultimate VR goalkeeping legend. No outfield play\u2014just pure, adrenaline-pumping goalkeeping.\n\nSuit up, step into the goal, and prove you\u2019ve got what it takes to keep a clean sheet.", "short_description": "Step into the stadium with VR Football! Experience realistic gameplay!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gameest-privacypolicy-football?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Gameest", "support_website_url": null, "website_url": "https://gameest.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24902400369462281"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831276_2194952874311124_7216192951260485560_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukod7UsxB44Q7kNvwF0ZLjl&_nc_oc=Adm8hp-J42t8zqGJ3xjB13OoSEBbpZ5bTO90oGmEyNZ3O4fqeub0dYcA4IMz7AU0NTQ&_nc_zt
775266", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491830027_769543752108599_4845047537898974172_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_9nUZbZq1YQ7kNvwE7vbDU&_nc_oc=AdnkXJ9nFQNYN_U6shohYTATE4HR_t_DF2jXJi0Om8-ZyCpsjNtI-iYM999M989hlf0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwetH8sD5af13NUZFMU87mKkgBO_Ui2udeZgfSlCemipg&oe=69AAE36B"}, {"file_name": "SS4.png", "id": "737510592521653", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491830003_737510595854986_6635143254735565291_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctIHoeyhJiQQ7kNvwG26eRG&_nc_oc=Adl_OScNfnHcNoOR5Xst7Ha9Z1R4NcpSmFClPj6_Qbzp1079LmNaQ9OLK04WM7C1QB0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afz_L1qBvo8CG4f33vlbDryT4B3g0py9ihpuC_dk3kWcrg&oe=69AADAE3"}, {"file_name": "SS2.png", "id": "1139856111324052", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491824592_1139856114657385_8753200294793201748_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgKpwhc0FoUQ7kNvwG0LAJg&_nc_oc=AdlnHXso7P4KtQic3f5ZenUolen7Ea_mTGyTf7Dj4-Y2Jv-VkMUXFL614XhdQHFITVw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afw0s8lenJgf60XzR1h3j3CJx4bHiiYw3-gfi-80lObuhg&oe=69AAD766"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "687163197680756", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491831276_687163201014089_8108374289127110829_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eW9-aaJv_Z8Q7kNvwEGZLvd&_nc_oc=Adm6-NJJaeo3WwnU9YQg9GJbeBqaD9f3MERPMVch_IdFY0WrFQVt68liDb1uUgpjaGM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfwR6c0H19fqErB6svPq4Cm9Mb56T-xd_EcRJFNRu9wqhA&oe=69AAB533"}, "display_name": "VR Football Soccer Goalkeeper", "keywords": ["football", "goalkeeper", "goal", "freekick", "soccer"], "long_description": "Step into the boots and gloves of a true football hero! VR Football Soccer Goalkeeper puts you right on the goal line with ultra-immersive virtual reality action. Your mission is simple: protect the net at all costs.\n\nDive, jump, catch, punch, and block powerful shots from skilled strikers as the difficulty rises with every level. Feel the intensity of real match moments with realistic ball physics, dynamic shot directions, and fast-paced goalkeeper challenges designed to test your reflexes and timing.\n\nEvery save brings you closer to becoming the ultimate VR goalkeeping legend. No outfield play\u2014just pure, adrenaline-pumping goalkeeping.\n\nSuit up, step into the goal, and prove you\u2019ve got what it takes to keep a clean sheet.", "short_description": "Step into the stadium with VR Football! Experience realistic gameplay!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gameest-privacypolicy-football?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Gameest", "support_website_url": null, "website_url": "https://gameest.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24902400369462281"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491831276_2194952874311124_7216192951260485560_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XsXK3y4PYAQ7kNvwGeC0ul&_nc_oc=AdnzQY5ekHczUR8pMiChkVYlepg8czggYEIG4YW3POhQ_BZ6CHazJMneN72LtiaWzd
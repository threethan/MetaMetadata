27_769543752108599_4845047537898974172_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qByPqs-BYKYQ7kNvwG5MKlZ&_nc_oc=Adk1DJ3rX4ooSr2NZBFszUHdLrhCKeHL93OLRab2RVauAWWfzxVpm_jawdTdswTrChs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv5tsNJV8UEOcegm8c254665W4fls_jRHaaatFxKfs1zg&oe=69A0576B"}, {"file_name": "SS4.png", "id": "737510592521653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830003_737510595854986_6635143254735565291_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHgqqAw_73YQ7kNvwECPhXx&_nc_oc=AdmZXId4fIawcOFZiqDlnQDyc4Ac2icAp01R3o3r_m51WEozBanno3taqJuNAnRu478&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftLGL3Bu_0mT-9kLbqGuMj4TtktDCB5Ie_ChBe9BjjhuA&oe=69A04EE3"}, {"file_name": "SS2.png", "id": "1139856111324052", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824592_1139856114657385_8753200294793201748_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXMhgRNXoaAQ7kNvwHSY5uj&_nc_oc=Adl27X-zev-yGiBI_kU1pV6NFBgGArb35wNFZQp1mraeFb9hVpdGzJJu9K4PiTf-rFo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft3B0VtVU8pfbfs1QO1khb1j5AM_0BDq-xP9VbnaKg5ng&oe=69A04B66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "687163197680756", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831276_687163201014089_8108374289127110829_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srvWwXU46_cQ7kNvwEXglHq&_nc_oc=AdknwByyUQz2kKC5ADt3G0rybFQdm14V6MsRil255oPnGBIBlttGYIajRrzGi1ugJds&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsgRRYIeDkEHg3dnjUEo4YMcsUuKNScp4TthLgOGf-StQ&oe=69A02933"}, "display_name": "VR Football Soccer Goalkeeper", "keywords": ["football", "goalkeeper", "goal", "freekick", "soccer"], "long_description": "Step into the boots and gloves of a true football hero! VR Football Soccer Goalkeeper puts you right on the goal line with ultra-immersive virtual reality action. Your mission is simple: protect the net at all costs.\n\nDive, jump, catch, punch, and block powerful shots from skilled strikers as the difficulty rises with every level. Feel the intensity of real match moments with realistic ball physics, dynamic shot directions, and fast-paced goalkeeper challenges designed to test your reflexes and timing.\n\nEvery save brings you closer to becoming the ultimate VR goalkeeping legend. No outfield play\u2014just pure, adrenaline-pumping goalkeeping.\n\nSuit up, step into the goal, and prove you\u2019ve got what it takes to keep a clean sheet.", "short_description": "Step into the stadium with VR Football! Experience realistic gameplay!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gameest-privacypolicy-football?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Gameest", "support_website_url": null, "website_url": "https://gameest.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24902400369462281"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831276_2194952874311124_7216192951260485560_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikKgU9vVKeAQ7kNvwEDvOWE&_nc_oc=AdnWZRoS_xa_Qhwjb1p56n_ZBpxG649mPFhpj2AdjxVJpY1BPdn42w9l-Ps-bZwKqKk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft4wnT6ro44mv5USJFj7xAgbS20BPfhdMEE2ogXTADAmw&oe=69A03D19"}, 
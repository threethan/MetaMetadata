 "SS5.png", "id": "769543748775266", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491830027_769543752108599_4845047537898974172_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKx3o6_ichoQ7kNvwEwHskb&_nc_oc=AdqW49-39p_lt8rDG33rY3P_Jj5SB1NHbbOOVJ6ykhI2uG02HJrhdgoo7Y0ti9QssTg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwyGP6CCc2k0RR9goqKl8yydfdRJlnungwCU9JNwFKj6Q&oe=69C7E46B"}, {"file_name": "SS4.png", "id": "737510592521653", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491830003_737510595854986_6635143254735565291_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcPDEZ4nLaMQ7kNvwFKEcLG&_nc_oc=AdoU0Yr6C5TBYHDN45qZlJC-elkTilPQb-Fh9EAOkZf7vm6iF6XQIPHThHGtc4HTk9I&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwztgj0K2nC48q_-3N0aWcAsGIsGQqeFawjc_-YdKw29A&oe=69C7DBE3"}, {"file_name": "SS2.png", "id": "1139856111324052", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491824592_1139856114657385_8753200294793201748_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ue4QPB6dLxsQ7kNvwGMVGBo&_nc_oc=AdpouWtbC3XXz0RSYB_FuZgPbejFaHw7YVfHxNBI3JHFAC0kE1v1p7l8R2fMsCF4c10&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzoOxCPdmcN0LwrnKKavgvu_gdRJg8PeQK_IL2rO3EnhQ&oe=69C7D866"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "687163197680756", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491831276_687163201014089_8108374289127110829_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhRjHCY7Fz0Q7kNvwFTdPRj&_nc_oc=Adr3Lc4pF6izbqA9eH0dfkxYDs4oVTsp4sa_j7-CXLJfYwAAF6oVfnBv4PayAaWCbHw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxp-FNmqqRcj4Z9hAO5crvdn1VhRrxaq6PhC4oJoTHUoQ&oe=69C7B633"}, "display_name": "VR Football Soccer Goalkeeper", "keywords": ["football", "goalkeeper", "goal", "freekick", "soccer"], "long_description": "Step into the boots and gloves of a true football hero! VR Football Soccer Goalkeeper puts you right on the goal line with ultra-immersive virtual reality action. Your mission is simple: protect the net at all costs.\n\nDive, jump, catch, punch, and block powerful shots from skilled strikers as the difficulty rises with every level. Feel the intensity of real match moments with realistic ball physics, dynamic shot directions, and fast-paced goalkeeper challenges designed to test your reflexes and timing.\n\nEvery save brings you closer to becoming the ultimate VR goalkeeping legend. No outfield play\u2014just pure, adrenaline-pumping goalkeeping.\n\nSuit up, step into the goal, and prove you\u2019ve got what it takes to keep a clean sheet.", "short_description": "Step into the stadium with VR Football! Experience realistic gameplay!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gameest-privacypolicy-football?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Gameest", "support_website_url": null, "website_url": "https://gameest.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24902400369462281"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491831276_2194952874311124_7216192951260485560_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nbukq8D6O_QQ7kNvwFkV3Wu&_nc_oc=AdoQz-rHuZuVnvdDpb64-WFtNM
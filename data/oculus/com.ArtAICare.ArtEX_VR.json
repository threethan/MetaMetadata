eo_trailer_thumbnail": null, "display_name": "ArtEX VR", "keywords": ["Art", "visual", "painting", "museum"], "long_description": "This is a visual exposure\u2013based immersive art experience for VR, designed to be accessed through the ArtAICare platform.\n\nThe application places users in carefully curated virtual art environments, where controlled visual exploration encourages reflection, emotional awareness, and meaningful conversation within a guided creative context. The experience focuses on personalized visual journeys, supporting self-expression and introspection through immersive art and interactive environments.\n\nThe app is intended as a creative and experiential tool, not a medical or therapeutic application. It does not provide diagnosis, treatment, or clinical intervention, and it does not claim to function as a medical device.", "short_description": "This is a visual exposure\u2013based immersive experience in virtual museums for VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://therapy.artaicare.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ArtAICare", "support_website_url": null, "website_url": "https://www.artaicare.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "ms", "it", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1542383528951738"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "
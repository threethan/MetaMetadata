ng self-expression and introspection through immersive art and interactive environments.\n\nThe app is intended as a creative and experiential tool, not a medical or therapeutic application. It does not provide diagnosis, treatment, or clinical intervention, and it does not claim to function as a medical device.", "short_description": "This is a visual exposure\u2013based immersive experience in virtual museums for VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://therapy.artaicare.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ArtAICare", "support_website_url": null, "website_url": "https://www.artaicare.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "ms", "it", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1542383528951738"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824700_1418059179831501_1357082842372994932_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgyUNXdeVhoQ7kNvwFlW3iv&_nc_oc=AdqefK2I6yNzozrs-e76F3Tbe5hyXqbuCyp3fWDlctM5jbl1SCTTgmSPTG6tDD7dijg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX86Yg0owe-ane8XjWb6UEsStoxW7letCmv1M7QTpkESQ&oe=6B106AEB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ArtEX VR", "platform": "ANDROID_6DOF", "context_catego
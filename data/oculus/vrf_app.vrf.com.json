equired to kill all round balls.\n\nAmazing Hit-Feel and Fabulous Pictures\nThanks to global light, changing seasons and sun-moon alternating can be presented to players in the same scene. Coupled with weather system, players can be totally immersed in the magnificent and incredible game world. Ball crashing has 100% reproduced balls\u2019 physical properties when moving on the track. Multiple Combo design, along with breath-taking climate, renders superb hit-feel that will definitely rock you.", "short_description": "Another way to play matching game"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.firesvr.com/privacy.html", "developer_terms_of_service_url": "http://www.firesvr.com/provision.html", "publisher_name": "FiresVR", "support_website_url": null, "website_url": "http://www.firesvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "PUZZLE", "SHOOTER", "ARCADE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2448682925268328"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1089295637846453", "version": "1.1.4"}, "id": "1070518073046600", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1018859741556
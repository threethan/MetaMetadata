r": null, "video_trailer_thumbnail": null, "display_name": "Kill Ball", "keywords": ["Zuma", "Casual", "Shooter", "Puzzle", "Strategy"], "long_description": "Total-immersion 3D Tracks\n3D tracks of all kinds feature the biggest highlight of KILL BALL. These tracks may show before or around you.\nVarious Tile-matching Tactics\nEach level of KILL BALL offers different experience depending on tracks. For some levels, the ball group will be accelerated when passing certain tracks; for others, 360\u00b0shooting is required to kill all round balls.\n\nAmazing Hit-Feel and Fabulous Pictures\nThanks to global light, changing seasons and sun-moon alternating can be presented to players in the same scene. Coupled with weather system, players can be totally immersed in the magnificent and incredible game world. Ball crashing has 100% reproduced balls\u2019 physical properties when moving on the track. Multiple Combo design, along with breath-taking climate, renders superb hit-feel that will definitely rock you.", "short_description": "Another way to play a matching game"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.firesvr.com/privacy.html", "developer_terms_of_service_url": "http://www.firesvr.com/provision.html", "publisher_name": "FiresVR", "support_website_url": null, "website_url": "http://www.firesvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "PUZZLE", "SHOOTER", "ARCADE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4579275812199871"}, "review_messages": []}]}, "cover_
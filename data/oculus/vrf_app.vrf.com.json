-sin6-2.oculuscdn.com/v/t64.5771-25/12138844_348446085523860_5376838251845779456_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3zElpK9nyYQ7kNvwHRviIT&_nc_oc=Adp6hqNZoh_Tx6U4zv5mTkN9xZM-5Ui1O5JNbS7LjK-mUiz6B8izVt4iPvnsr8SoWno&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oI5omsfD_DTPvixFvPYlJgc5PuyE1Joa6oVfOjJeRjA&oe=6A11B3C5"}, {"file_name": "migrated_image.png", "id": "602642896957238", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12386437_283874552009894_4936997634679242752_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GMm1qkwT264Q7kNvwHfwjvb&_nc_oc=AdrakknpF5MkYhvyIj38TQZhq9-pXBYumjU7wegLnrbL5PMztt4qlFBMgaIykc9o1W8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JtJxUTf7I2C2nEdfk_r6BEzU9EWdse_JbXxxy37t3Yg&oe=6A11CA87"}, {"file_name": "migrated_image.png", "id": "589046078351001", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12533842_421748281490722_6952529691093762048_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICa9Ho7ZUVgQ7kNvwHUsx7k&_nc_oc=AdrsCUQyZFoyLyL-VktzWjc0ewZiJqxWIUH27uyFyibneBETUzFb6pFZQMHeCslO370&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SQfGM-PCHs0F5FPYKrIWyo38WMRqXS82K0GtPrBnbVA&oe=6A11C9F7"}, {"file_name": "migrated_image.png", "id": "227386628442492", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12410455_1247752641914939_6651287952036986880_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcRd_T_y5L8Q7kNvwHBrFNH&_nc_oc=Adrf6T6uajDzwA4SW9kpbAmgS5e9iUssLAH4lYTdWEYl2NLgn3SbOebnqaTIeopvmt4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78F7lwAPIXQq8T7Rzfzneoot5Nvf7cpD3FEMoaaUnUFQ&oe=6A119DB9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kill Ball", "keywords": ["Zuma", "Casual", "Shooter", "Puzzle", "Strategy"], "long_description": "Total-immersion 3D Tracks\n3D tracks of all kinds feature the biggest highlight of KILL BALL. These tracks may show before or around you.\nVarious Tile-matching Tactics\nEach level of KILL BALL offers different experience depending on tracks. For some levels, the ball group will be accelerated when passing certain tracks; for others, 360\u00b0shooting is required to kill all round balls.\n\nAmazing Hit-Feel and Fabulous Pictures\nThanks to global light, changing seasons and sun-moon alternating can be presented to players in the same scene. Coupled with weather system, players can be totally immersed in the magnificent and incredible game world. Ball crashing has 100% reproduced balls\u2019 physical properties when moving on the track. Multiple Combo design, along with breath-taking climate, renders superb hit-feel that will definitely rock you.", "short_description": "Another way to play a matching game"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.firesvr.com/privacy.html", "developer_terms_of_service_url": "http://www.firesvr.com/provision.html", "publisher_name": "FiresVR", "support_website_url": null, "website_url": "http://www.firesvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "PUZZLE", "SHOOTER", "ARCADE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4579275812199871"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12427528_363160810708461_5353721268979892224_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPLGYbseE_MQ7kNvwHpfCi6&_nc_oc=Adoed5-Mt4qhiWCbj4ykkPZ0UIlBMK9MbjluwTGRoFGtcRxY_ju0vUsVgHtVTN0asps&_nc_zt=3&_nc_ht=
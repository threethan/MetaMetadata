handtracking", "radiostreaming", "meditation"], "long_description": "GlitterDark is a VR audio reactive experience set inside a moving neon wireframe universe inspired by retro-futuristic aesthetics, deep space transmissions, ambient cyber environments and synthetic dreamscapes. Explore constantly evolving visual worlds synchronized to music, internet radio streams and your own audio collection.\n\nGlitterDark is designed entirely for hand tracking - no controllers required.\n\nTouch your left or right wrist with your index finger to open the in-world menu and navigate through radio stations, visuals and music controls naturally inside VR.\n\nYou can import your own radio stations using a .txt file with the following format:\n\nStation Name http://stream-url\n\nImportant:\nReplace https:// with http://\nOne station per line\n\nYou can also import your own audio files directly.\n\nGlitterDark is built as an immersive audiovisual space for ambient listening, deep focus, meditation, cyber aesthetics and experimental music exploration.", "short_description": "GlitterDark is a VR audio reactive experience set inside a moving neon wireframe universe inspired by retro-futuristic aesthetics, deep space transmissions, ambient cyber environments and synthetic dreamscapes. Explore constantly evolving visual worlds synchronized to music, internet radio streams and your own audio collection."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thetascape.com/glitterdark/pp.html", "developer_terms_of_service_url": null, "publisher_name": "GlitterDark", "support_website_url": null, "website_url": "https://www.thetascape.com/glitterdark/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "p
iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADQIkFw9KWvx8Gqu47rz9x3-iv9EQgcj-5ku_HrYf_2A&oe=6A4D1C46"}, {"file_name": "05.png", "id": "1631852091422015", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619518_1631852094755348_7203327899833900532_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_q7gPZuGwkQ7kNvwEWLzrV&_nc_oc=AdpvWWRUH4fLJv85Oz_YyW6Z3sqtW3s38e_HWHbcTeNrNPOguRChYdQ9bCxK16Nelwk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCMf8_NldAibEB2EjHclrddug37EHs4RA7bnoGIsCd7A&oe=6A4CEE71"}, {"file_name": "04.png", "id": "35085101824471158", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618254_35085101834471157_3394182304319793340_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jeo6wXyfeu8Q7kNvwG1sggY&_nc_oc=AdoaR4mCOxDMzcnqmEM__dyuo6xI2baMdyxfL5BYcgBpF0wibt513HTFWNFevVh5_is&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdVOipEy4SIiTHno1mSgsem4ZHbww7c78XV7rLbvfqJw&oe=6A4D0A15"}, {"file_name": "02.png", "id": "1688438785511855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618512_1688438788845188_9212652146408012469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wg5RxxPej0Q7kNvwFCLGK3&_nc_oc=AdrBqDHSa2GdrMqhgXnPpJ2Oe9_ppBX220Tzi67ZYfdr55uS9yZuFyaQf4v6uBKGe4I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtVHyvzJFDD3BMbjXBStgs83D2TcWusGPrw-V7-hwAVQ&oe=6A4CE8F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "01.png", "id": "2050087105607474", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617729_2050087108940807_7818603865186305968_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7PpBNvnHJ0Q7kNvwGRkZOz&_nc_oc=AdoIZ7C2Mhj5Sbr4sSJy95UnjO15QmW33VDQIuHMc3-PxJFbGdXz4n5oucgMXnH17CQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDx9VO2EqTbf5cpuf__s-zyWFqBmKr5uqEK2pZM_NDRzg&oe=6A4D02D7"}, "display_name": "Glitter Dark", "keywords": ["musicvisualizer", "audioreactive", "handtracking", "radiostreaming", "meditation"], "long_description": "GlitterDark is an audioreactive VR visualizer that transforms sound into a living visual environment.\n\nEvery beat, frequency, and rhythm directly drives dynamic visuals in real time. Bass, mids, highs, and energy shape what you see, creating a fully immersive audiovisual experience.\n\nThe app supports both music files and custom radio streams, allowing you to bring your own audio into the experience.\n\nYou can import music files directly from your device. GlitterDark supports a wide range of popular audio formats.\n\nYou can also add radio stations using a simple text file. Create a .txt file with names and links, for example:\n\nyour radio http://sampleradiolink.com\n\nPut it on your device, then import it using the built-in file picker.\n\nIf you are looking for a more ambient experience, switch the analyzer mode to Ambient in settings. The default mode is Beat.\n\nGlitterDark is designed for hands-only interaction. No controllers are required.\n\nTap your left wrist with your right index finger to turn the visualizer on.\nTap your right wrist with your left index finger to turn it off.\n\nThe interface is minimal and intuitive, allowing you to focus on the experience rather than controls.\n\nThe app is designed for comfortable use in different positions, including sitting, standing, or lying down.\n\nGlitterDark is not just a music player. It is a space where your audio becomes a visual atmosphere.", "short_description": "GlitterDark is an audioreactive VR visualizer that turns your music into a living visual environment.\n\nImport your own music files or add custom radio streams using a simple text file.\n\nEvery beat and frequency drives dynamic visuals in real time.\n\nDesigned for hands-only interaction. No controllers required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thetascape.com/glitterdark/pp.html", "developer_terms_of_service_url": null, "publisher_name": "GlitterDark", "support_web
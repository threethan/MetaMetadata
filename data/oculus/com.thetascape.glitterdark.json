name": "03.png", "id": "983781907579196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618264_983781910912529_6646811120476728336_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDLGN0pYuEsQ7kNvwHZRyRH&_nc_oc=AdrJpAx8BF_ksTUx1y9UOI4TcTrBF6yCi4XZjEhn_ZCbfULPhLqsZy0e4Xz1zyTmhcE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpB2CjfenuMVC0YtlCJ9dYAJ-f8E8Nuk_uo904DKUtdw&oe=6AE61183"}, {"file_name": "01.png", "id": "1293338338886777", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620940_1293338342220110_2528316759497211393_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30x842nm8E0Q7kNvwGK5gi1&_nc_oc=AdpxU4vILFOQNkQlCH5ZG9OG_nkv3sl_xrLGtT2bJpdEQqCPxIKrmmjwMg5T13Hz7W4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHl6HNFuppmZLWfnEmPwo5DzUAGLmjGu5_sSsNeW3lLw&oe=6AE60A46"}, {"file_name": "05.png", "id": "1631852091422015", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619518_1631852094755348_7203327899833900532_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZ0gSo9SFRwQ7kNvwGnIWbl&_nc_oc=AdpZb2ysMU9OZlZxc8SxO1-mVdW2w6lM7ddk73xKSF9d4vStH6oh1Ji29bN2O_3C8MI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjA1rVOKBoocPtoE0UY6j0y6h960niJ-oJtRotPa_Jtw&oe=6AE614B1"}, {"file_name": "04.png", "id": "35085101824471158", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618254_35085101834471157_3394182304319793340_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cx1PDR2YoAEQ7kNvwF5f9CF&_nc_oc=AdqMyPFPQvoHM6wqXwblaZ6pvORo9wmCN4MmVn8KHmz6h91ksejzZkqa8SOHmKSLD3Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN38F9XAwyqtVVrnEdtkaxpTGyM1sZKi_7RggjrUSaWVA&oe=6AE5F815"}, {"file_name": "02.png", "id": "1688438785511855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618512_1688438788845188_9212652146408012469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JfxdKe6boQQ7kNvwGTHSeZ&_nc_oc=AdrbDGmu7CRhwFpzIBcZYqa776_IUSJ9anCRYJcd7WXmKhKrokNQLEdze3aQqVhEhMs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1mZLzg58tEsiV7u4Esy25B4nzLAbChWQ8OxIOglY6PA&oe=6AE60F31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "01.png", "id": "2050087105607474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617729_2050087108940807_7818603865186305968_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RM-BP6vz10Q7kNvwFlPN96&_nc_oc=AdpgXoHtztY7V0rSjA60xJ0Yjtx-_Zd4FCgIyMuu9g7cWORjFXUxd_DrqQsu-XdSsME&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNoMDF5y0bs4r9b-3b1ZJ_vZJg0VTUUb7KA1Ucqu3EheA&oe=6AE5F0D7"}, "display_name": "Glitter Dark", "keywords": ["musicvisualizer", "audioreactive", "handtracking", "radiostreaming", "meditation"], "long_description": "GlitterDark is an audioreactive VR visualizer that transforms sound into a living visual environment.\n\nEvery beat, frequency, and rhythm directly drives dynamic visuals in real time. Bass, mids, highs, and energy shape what you see, creating a fully immersive audiovisual experience.\n\nThe app supports both music files and custom radio streams, allowing you to bring your own audio into the experience.\n\nYou can import music files directly from your device. GlitterDark supports a wide range of popular audio formats.\n\nYou can also add radio stations using a simple text file. Create a .txt file with names and links, for example:\n\nyour radio http://sampleradiolink.com\n\nPut it on your device, then import it using the built-in file picker.\n\nIf you are looking for a more ambient experience, switch the analyzer mode to Ambient in settings. The default mode is Beat.\n\nGlitterDark is designed for hands-only interaction. No controllers are required.\n\nTap your left wrist with your right index finger to turn the visualizer on.\nTap your right wrist with your left index finger to turn it off.\n\nThe interface is minimal and intuitive, allowing you to focus on the experience rather than controls.\n\nThe app is designed for comfortable use in different positions, including sitting, standing, or lying down.\n\nGlitterDark is not just a music player. It is a space where your audio becomes a visual atmosphere.", "short_description": "GlitterDark is an audioreactive VR visualizer that turns your music into a living visual environment.\n\nImport your own music files or add custom radio streams using a simple text file.\n\nEvery beat and frequency drives dynamic visuals in real time.\n\nDesigned for hands-only interaction. No controllers required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thetascape.com/glitterdark/pp.html", "developer_terms_of_service_url": null, "publisher_name": "GlitterDark", "support_website_url": null, "website_url": "https://www.thetascape.com/glitterdark/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26756680163940331"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1596640925286703"}, {"status": "PUBLISHED", "id": "1059500003534064"}, {"status": "PUBLISHED", "id": "1007397815284187"}]}, "baseline_offer": {"id": "1596640925286703"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1788637800, "status": "PUBLISHED", "id": "1596640925286703"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_resu
855"}, {"file_name": "02.png", "id": "1688438785511855", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618512_1688438788845188_9212652146408012469_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0paH_eyoHdoQ7kNvwHouyJY&_nc_oc=AdopJT82Iy6wM4b3JAF7jzHu6Pz6L84oC7HbJsv9q-EWYT8TIhdxcZxNA_jYLlFTpQE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQL8T03PKczjxp4lvFh6sHwAt4WFhCG3V_oeDAtenJQAA&oe=6AFB2731"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "01.png", "id": "2050087105607474", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617729_2050087108940807_7818603865186305968_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsr7VBwiybUQ7kNvwHzQ6VH&_nc_oc=Adptf0oYZDAGhiEnQEDSZFAfi9LWIRWJQXQr-_4vJiJcVFtnW6a-1FUmIztv4LE68iw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjdOmQL4eaF3mLr2HHnVBcT6xgF5rLUOLlB3ypNoLJzw&oe=6AFB4117"}, "display_name": "Glitter Dark", "keywords": ["musicvisualizer", "audioreactive", "handtracking", "radiostreaming", "meditation"], "long_description": "GlitterDark is an audioreactive VR visualizer that transforms sound into a living visual environment.\n\nEvery beat, frequency, and rhythm directly drives dynamic visuals in real time. Bass, mids, highs, and energy shape what you see, creating a fully immersive audiovisual experience.\n\nThe app supports both music files and custom radio streams, allowing you to bring your own audio into the experience.\n\nYou can import music files directly from your device. GlitterDark supports a wide range of popular audio formats.\n\nYou can also add radio stations using a simple text file. Create a .txt file with names and links, for example:\n\nyour radio http://sampleradiolink.com\n\nPut it on your device, then import it using the built-in file picker.\n\nIf you are looking for a more ambient experience, switch the analyzer mode to Ambient in settings. The default mode is Beat.\n\nGlitterDark is designed for hands-only interaction. No controllers are required.\n\nTap your left wrist with your right index finger to turn the visualizer on.\nTap your right wrist with your left index finger to turn it off.\n\nThe interface is minimal and intuitive, allowing you to focus on the experience rather than controls.\n\nThe app is designed for comfortable use in different positions, including sitting, standing, or lying down.\n\nGlitterDark is not just a music player. It is a space where your audio becomes a visual atmosphere.", "short_description": "GlitterDark is an audioreactive VR visualizer that turns your music into a living visual environment.\n\nImport your own music files or add custom radio streams using a simple text file.\n\nEvery beat and frequency drives dynamic visuals in real time.\n\nDesigned for hands-only interaction. No controllers required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thetascape.com/glitterdark/pp.html", "developer_terms_of_service_url": null, "publisher_name": "GlitterDark", "support_website_url": null, "website_url": "https://www.thetascape.com/glitterdark/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26756680163940331"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1596640925286703"}, {"status": "PUBLISHED", "id": "105950000
8DC9B"}, "display_name": "Scary!", "keywords": ["scary", "horror", "escape", "creepypasta", "creepy"], "long_description": "A dark, forgotten house stands silent, its air thick with something unseen. Whispers echo through empty halls, and an uneasy presence lingers just out of reach. The deeper you go, the stronger it gets\u2014watching, waiting. You may try to ignore it, but sooner or later, you\u2019ll have to face what\u2019s been following you all along.", "short_description": "Step into a VR experience set in a dark, forgotten house, where something watches from the shadows. Every creak and whisper pulls you deeper into the unknown. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25360030976959816"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392005_573846199045207_258888366563808985_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81DcVuR6cMIQ7kNvwHTrvAj&_nc_oc=Adoiv3ts7kdphJ_drsHTB--M29_fCTccOUED8DWjsxfyfEHxtGwMGPbRJlAAyWbpbN
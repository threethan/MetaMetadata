2014watching, waiting. You may try to ignore it, but sooner or later, you\u2019ll have to face what\u2019s been following you all along.", "short_description": "Step into a VR experience set in a dark, forgotten house, where something watches from the shadows. Every creak and whisper pulls you deeper into the unknown. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9373887356000767"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "2006513820029130"}, {"status": "PUBLISHED", "id": "1394786791978683"}, {"status": "PUBLISHED", "id": "1757790608632326"}, {"status": "PUBLISHED", "id": "1571439117929691"}, {"status": "PUBLISHED", "id": "3005789636479635"}, {"status": "PUBLISHED", "id": "974510281699973"}, {"status": "PUBLISHED", "id": "1816102799795128"}, {"status": "PUBLISHED", "id": "1240770464694605"}, {"status": "PUBLISHED", "id": "854840000653682"}, {"status": "CANCELLED", "id": "1815569645769865"}, {"status": "PUBLISHED", "id": "1544471126868849"}]}, "baseline_offer": {"id": "1544
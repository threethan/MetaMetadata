290852_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EK6WQdFXgAQ7kNvwH897qt&_nc_oc=Ado3_0DlHs63QCQZeIQQwE4O2aaMo45UupuqB3yOAVUrnxw2p7NkoxqVzUIm-1PWVQQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThORwffCLF99icixl4D5a6poUKTfcT8B7LjgoWnQnl-A&oe=6AFDD247"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Titelbild.png", "id": "896463376220300", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820141_896463386220299_6499870859765598855_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xg1Y28oDPWIQ7kNvwHpEm54&_nc_oc=Adr78J0pYn63fmb_R1YcoNpfNL0BS8Se5k5vWDUWLiiAHFXyveRDC8u2xeh7MB6iUuM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3g28WN1yJWcT-G3n5CQpWPyGgK69FHd8Q57LiTDiPUg&oe=6AFDC1DB"}, "display_name": "Scary!", "keywords": ["scary", "horror", "escape", "creepypasta", "creepy"], "long_description": "A dark, forgotten house stands silent, its air thick with something unseen. Whispers echo through empty halls, and an uneasy presence lingers just out of reach. The deeper you go, the stronger it gets\u2014watching, waiting. You may try to ignore it, but sooner or later, you\u2019ll have to face what\u2019s been following you all along.", "short_description": "Step into a VR experience set in a dark, forgotten house, where something watches from the shadows. Every creak and whisper pulls you deeper into the unknown. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscript
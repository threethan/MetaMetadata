0", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820141_896463386220299_6499870859765598855_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-5kwSSI_csQ7kNvwHP8vZp&_nc_oc=Adp4lo-W5MLeqRFLF9MPGcZ89ayRZaUCB8j85trlg6zvoXLT-pTsHyVu3Q0hY4DmlYc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDUEWNmkPRPafOLyOnPOfjrKGBCqa0opRiNjvnVlQ3DA&oe=6AD391DB"}, "display_name": "Scary!", "keywords": ["scary", "horror", "escape", "creepypasta", "creepy"], "long_description": "A dark, forgotten house stands silent, its air thick with something unseen. Whispers echo through empty halls, and an uneasy presence lingers just out of reach. The deeper you go, the stronger it gets\u2014watching, waiting. You may try to ignore it, but sooner or later, you\u2019ll have to face what\u2019s been following you all along.", "short_description": "Step into a VR experience set in a dark, forgotten house, where something watches from the shadows. Every creak and whisper pulls you deeper into the unknown. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interactio
erts\nPlay from a variety of concerts/locations. Each concert consists of three songs back-to-back in front of an audience. Do well, earn the audience's praise, and compete for a high score on the leaderboards. Play poorly and risk having TVs thrown at you!\n", "short_description": "Play concerts on a virtual marimba and compete for high scores"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/02bf4588-cc6d-46e7-88b3-aa1386b08984", "developer_terms_of_service_url": null, "publisher_name": "JCallowProjects", "support_website_url": null, "website_url": "http://marimba-vrcade.jcallow-projects.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8520394658071225"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982472_487029804032021_7647651271086607605_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fh3R0c_60TQQ7kNvwEZofrY&_nc_oc=AdkxWuSgs81kmaMkrbAe5efYPQc6EyjqbnQ_8-dmO8xvK5YJLGWF_4M0vYPerIUy7X4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu_eNTrl5cypIAX-zAumtd3suXzvziJAeb10r1t2eElZQ&oe=69A82559"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Marimba VRCade", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743
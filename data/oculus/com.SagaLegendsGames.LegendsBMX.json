.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhMeogb8j70Q7kNvwFLfyhj&_nc_oc=Adr3VwNIhw1bS6-dvZLLkViGzwmpPw4Zur2K2Q0uWlmrGkA8nCdJkuQr2Gqy0AtKoqA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROjN5ecf6-6sYYAjb0krXdG0MJozzsO38n36eaIuRr_w&oe=6B033273"}, {"file_name": "005.png", "id": "1039875214854716", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393516_1039875218188049_231288402583328065_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hupVmpDUuHUQ7kNvwHXvlY0&_nc_oc=Adq2CKNCnygNA8MH_zNB_0xgFK_O8VJvTeOHPBSFJGsQirFetb7LleGGZ15QHPTzCfY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ83JfnenYp8ReyfxzOY2hyCLTOe5KWnqzyInfauYHHCA&oe=6B031927"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "005.png", "id": "517509354762187", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391952_517509358095520_2919512691968294005_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvciXMR4sNoQ7kNvwFTiPV6&_nc_oc=AdrN2dpVmT5PmaLWMLe4ylYcjPbVaZQjqLh8bRwrMiLpO9fP7VN6_62eTtaAsEmKm5M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQO5WeEwhUHdeZ5Nh4R2xyvjQmxV70qlg_oZoCskdIFg&oe=6B033449"}, "display_name": "Legends BMX", "keywords": [], "long_description": "**Legends BMX VR** brings BMX action to Mixed Reality on Meta Quest. Overlay 3D bikeparks onto your real-world environment using passthrough and ride freely within your space.\n\n- Resize the track to fit your room.  \n- Link up insane tricks and climb the global rankings.  \n- Join weekly challenges and compete on *online leaderboards*.\n\n**Actively developed, but already solid and fun**  \nWhile we're actively improving and expanding the game, this VR version already offers a complete and stable experience. *Legends BMX* is also being developed for PC and consoles, where it's being very well received.\n\nJump into the park and help us fine-tune the final 
.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGqr7fFBAlwQ7kNvwEuBYBz&_nc_oc=Adp1fopwefJK9qfoU31DhFaRTTSf5my7A1ZXs7pobdUg9qPOO9RejvslC-ybEmHpLRQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSMFosH104ks_rbwregGrrt1vCzmebq5b9a2Dtsn9CJA&oe=6B09C9F3"}, {"file_name": "005.png", "id": "1039875214854716", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393516_1039875218188049_231288402583328065_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFOvtnvbzUUQ7kNvwEZJk7D&_nc_oc=AdrMAhnddNutQ8FhRDlCgvVv1u0AouPZYnERBJWg7I7XEAzpjmcMdom353c_usJjxYk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNyRJrGC-wRp9FKddOg9o6TNGMv-03yqDAb0yTjf39rg&oe=6B09B0A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "005.png", "id": "517509354762187", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391952_517509358095520_2919512691968294005_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPtomeNDtdUQ7kNvwFmkjyA&_nc_oc=Adoxobg_0RbW83buvB2fvLiMIrz2s5G4TiKEM38kBhek_kKYgjhuswrjuo8VC_rUHb8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSV4e_J8GkJDUGdKLIZBUWHMRPhu-8KVCMBMGgD1Ieuig&oe=6B09CBC9"}, "display_name": "Legends BMX", "keywords": [], "long_description": "**Legends BMX VR** brings BMX action to Mixed Reality on Meta Quest. Overlay 3D bikeparks onto your real-world environment using passthrough and ride freely within your space.\n\n- Resize the track to fit your room.  \n- Link up insane tricks and climb the global rankings.  \n- Join weekly challenges and compete on *online leaderboards*.\n\n**Actively developed, but already solid and fun**  \nWhile we're actively improving and expanding the game, this VR version already offers a complete and stable experience. *Legends BMX* is also being developed for PC and consoles, where it's being very well received.\n\nJump into the park and help us fine-tune the final 
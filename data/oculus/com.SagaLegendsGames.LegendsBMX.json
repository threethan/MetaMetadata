.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKMz4ErVI_UQ7kNvwGKPovF&_nc_oc=AdqDv9G-k55hx1JMgDMLV76qg0f4nljN-C_UkYhte7ZLIU9h_B-DWjDtC8V5CAqkn88&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgN3eLSTsFfnLzr2LeOkoCCzRKRFYoWNwjkCc1_u3Qxg&oe=6AFB4973"}, {"file_name": "005.png", "id": "1039875214854716", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393516_1039875218188049_231288402583328065_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5j8nCgK9c1kQ7kNvwHdZXyd&_nc_oc=Ado0lndrTbw3qHHFfpuQ0QRbw2ghLN0AxsyclmmF8_WhtoiRtNsYoglCi0cfMeXEW5U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjS2sj9gMHlMW0qB95j4z7HqEOVCksp4BytMLaVnmwiQ&oe=6AFB3027"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "005.png", "id": "517509354762187", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391952_517509358095520_2919512691968294005_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1baHPR-CGcQ7kNvwFhYgg4&_nc_oc=AdoZqjy2Xn43CFbbMr1Br_xktchQN9vKVn3qZQklbGGaYmtJVsMnNX3J57KM8-7eYl4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOCF99TKEIeqGRgOMTSBVhnbhTWXgJ7gfH4vpYsEMcYA&oe=6AFB4B49"}, "display_name": "Legends BMX", "keywords": [], "long_description": "**Legends BMX VR** brings BMX action to Mixed Reality on Meta Quest. Overlay 3D bikeparks onto your real-world environment using passthrough and ride freely within your space.\n\n- Resize the track to fit your room.  \n- Link up insane tricks and climb the global rankings.  \n- Join weekly challenges and compete on *online leaderboards*.\n\n**Actively developed, but already solid and fun**  \nWhile we're actively improving and expanding the game, this VR version already offers a complete and stable experience. *Legends BMX* is also being developed for PC and consoles, where it's being very well received.\n\nJump into the park and help us fine-tune the final experience.  \nThanks for being part of the journey \u2014 see you in the park!\n", "short_description": "Pure flow and adrenaline \u2014 now in Mixed Reality!\nRide your BMX through dynamic parks superimposed on your real-world space. Pull off insane tricks, chase high scores, and feel the thrill of BMX in a whole new way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sagalegendsdev.github.io/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Saga Legends Games", "support_website_url": null, "website_url": "https://sagalegendsdev.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "es_PR", "es_PE", "es_MX", "es_CO", "es_AR", "es_CL", "es_VE", "fr_BE", "fr_CA", "fr", "de", "de_CH", "gsw", "ko", "zh_CN", "ja", "en_US", "en_AU", "en_CA", "en_GB"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29726674563590645"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29626749303583172", "version": "1.2.36"}, "id": "3705896616407715", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Applicati
at=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wbmMgkZJX4Q7kNvwGaYYqy&_nc_oc=AdnWvbaiZIaNuiNs65NFea-Va-EyO41P6spf_kfx8UinsVEkitcB4k_ps_ujtnPex0s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvr8Ggmg0B2KNCKZ3XqN6VgTri3REa-gw5FnQXd24sOIA&oe=69A03D67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "005.png", "id": "517509354762187", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391952_517509358095520_2919512691968294005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_6koTrSu-IQ7kNvwHCQZcw&_nc_oc=Adl2EcM7heZjyKGcuhtFDSO2B3BuVsho9Czszcex096fmtCay7o9Ak0PG8U_Ba0iRuA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuttYBuZrYhiQUuYSVlX3W3GSYZyEYnBa1mbq0yBzhm_Q&oe=69A05889"}, "display_name": "Legends BMX", "keywords": [], "long_description": "**Legends BMX VR** brings BMX action to Mixed Reality on Meta Quest. Overlay 3D bikeparks onto your real-world environment using passthrough and ride freely within your space.\n\n- Resize the track to fit your room.  \n- Link up insane tricks and climb the global rankings.  \n- Join weekly challenges and compete on *online leaderboards*.\n\n**Actively developed, but already solid and fun**  \nWhile we're actively improving and expanding the game, this VR version already offers a complete and stable experience. *Legends BMX* is also being developed for PC and consoles, where it's being very well received.\n\nJump into the park and help us fine-tune the final experience.  \nThanks for being part of the journey \u2014 see you in the park!\n", "short_description": "Pure flow and adrenaline \u2014 now in Mixed Reality!\nRide your BMX through dynamic parks superimposed on your real-world space. Pull off insane tricks, chase high scores, and feel the thrill of BMX in a whole new way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sagalegendsdev.github.io/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Saga Legends Games", "support_website_url": null, "
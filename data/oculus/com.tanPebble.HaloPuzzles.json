aWFIAQ7kNvwG_vbcC&_nc_oc=AdrH73j9-orrRy2pZePhFCnWjMiu91bFjeePF5U8vsYVLLxVYkQgv-Tdy2Tstw7KJG0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Jj1UOtQRXOatFwKAom9L-apeXG2hpy4ZLclcsFJoA1Q&oe=6A280D78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "haloPuzzles_promotionalVideo_1080p_English - frame at 0m44s_2560_1440.png", "id": "1299549768359559", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830821_1299549775026225_3321121544085788985_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzMbfqDbK7IQ7kNvwF7w7VV&_nc_oc=Adq9kkt110Tu-MTng38jSJ8iQt-owBlP-WT_hN2xfPUCqyTdfcr9Jqdki-NGrOJwQ3k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oeJjO-e7bnX4boepGWV3tU3Mdv8tf2EjUDF6mDkT20w&oe=6A2829ED"}, "display_name": "Halo Puzzles", "keywords": ["art", "halo", "jigsaw", "puzzles", "relax"], "long_description": "**Solve jigsaw puzzles in a halo, wrapped in atmospheric music.**\n\nHalo Puzzles is a VR/MR jigsaw puzzle experience that lets you enjoy real museum artworks through spatial, hand-operated play.  \nDesigned in response to user feedback, this title focuses purely on the joy of puzzle-solving\u2014gently wrapped in atmospheric music.\n\nEach piece hovers in a circular halo around the artwork, stimulating your sense of rotation and direction as you physically reach, grab, and place pieces into the frame.\n\nWhile drawing on the development experience of *Mind Mines*, this title was carefully crafted for those who want to purely enjoy the beauty of puzzles and art\u2014focusing on the act of solving itself.\n\n---\n\n## Features\n- \ud83c\udfa8 Jigsaw puzzles using real museum artworks  \n- \ud83d\udd04 Circular layout that surrounds the art  \n- \u270b Hand tracking support (no controllers needed)  \n- \ud83c\udfb5 Gentle, atmospheric background music  \n- \ud83e\udde9 Clean, puzzle-focused gameplay  \n- \ud83c\udf1f **Subscription unlocks full access**: all puzzle artworks, difficulty settings, and online rankings  \n- \ud83c\udd93 **Free trial**: play with larger puzzle pieces to experience the mechanics before subscribing  \n\n---\n\nExperience the serenity of art, the satisfaction of solving, and the elegance of intuitive interaction.", "short_description": "Solve jigsaw puzzles in a halo, wrapped in atmospheric music."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/13unBvgAGj_-B34hAtJeANR8A5CjybGFJGpmBX6ssXs0/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "tanPebble", "support_website_url": null, "website_url": "https://tanpebble.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9722306161162295"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1094893032075117"}]}, "baseline_offer": {"id": "1094893032075117"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1757028780, "status": "PUBLISHED", "id": "1094893032075117"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27043265591973083", "version": "0.1.33"}, "id": "2626510597553444", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Applicat
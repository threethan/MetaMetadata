ss&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIpUTWHDI7cQ7kNvwHoVCu2&_nc_oc=AdonvIJp1-XId_UtzEvyRca9KCo-IoUxC5qQgj7WLUkII43an0TadtCabUWjfoFOleU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXbHZe-8ujmgD1yYNCsC6roZ0cJXwoayhlP_tZhcdhHg&oe=6B006887"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Halo Puzzles", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1757028780, "lastRevision": {"nodes": [{"id": "9722306181162293", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9722306151162296", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1477355806779234"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1065668589109094", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u30d8\u30a4\u30ed\u30fc\u30d1\u30ba\u30eb", "keywords": ["\u30a2\u30fc\u30c8", "\u7d75\u753b", "\u30d8\u30a4\u30ed\u30fc", "\u30b8\u30b0\u30bd\u30fc\u30d1\u30ba\u30eb"], "long_description": "**\u97f3\u697d\u306b\u5305\u307e\u308c\u3001\u5186\u74b0\u3067\u697d\u3057\u3080\u30b8\u30b0\u30bd\u30fc\u30d1\u30ba\u30eb\u3002**\n\nHalo Puzzles \u306f\u3001\u5b9f\u5728\u3059\u308b\u7f8e\u8853\u9928\u306e\u30a2\u30fc\u30c8\u4f5c\u54c1\u3092\u4f7f\u3063\u3066\u697d\u3057\u3080\u3001VR/MR\u5bfe\u5fdc\u306e\u30b8\u30b0\u30bd\u30fc\u30d1\u30ba\u30eb\u4f53\u9a13\u3067\u3059\u3002  \n\u30e6\u30fc\u30b6\u30fc\u304b\u3089\u306e\u30d5\u30a3\u30fc\u30c9\u30d0\u30c3\u30af\u3092\u3082\u3068\u306b\u8a2d\u8a08\u3055\u308c\u3001\u672c\u4f5c\u306f\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u697d\u3057\u3055\u306b\u7d14\u7c8b\u306b\u7126\u70b9\u3092\u5f53\u3066\u3001\u7a4f\u3084\u304b\u3067\u96f0\u56f2\u6c17\u306e\u3042\u308b\u97f3\u697d\u304c\u305d\u306e\u4f53\u9a13\u3092\u5305\u307f\u8fbc\u307f\u307e\u3059\u3002\n\n\u30d4\u30fc\u30b9\u306f\u30a2\u30fc\u30c8\u306e\u5468\u56f2\u306b\u5186\u74b0\u72b6\u306b\u6d6e\u304b\u3073\u3001\u624b\u3092\u4f38\u3070\u3057\u3066\u63b4\u307f\u3001\u5411\u304d\u3092\u5909\u3048\u3001\u30d5\u30ec\u30fc\u30e0\u306b\u306f\u3081\u8fbc\u3093\u3067\u3044\u304f\u2015\u2015  \n\u305d\u3093\u306a\u4e00\u9023\u306e\u52d5\u4f5c\u3092\u901a\u3057\u3066\u3001\u81ea\u7136\u3068\u56de\u8ee2\u3084\u65b9\u5411\u611f\u899a\u3092\u523a\u6fc0\u3057\u307e\u3059\u3002  \n\n\u672c\u4f5c\u306f *Mind Mines* \u306e\u958b\u767a\u7d4c\u9a13\u3092\u6d3b\u304b\u3057\u3064\u3064\u3082\u3001\u30d1\u30ba\u30eb\u306e\u9b45\u529b\u3068\u30a2\u30fc\u30c8\u306e\u7f8e\u3057\u3055\u3092\u7d14\u7c8b\u306b\u697d\u3057\u3081\u308b\u3088\u3046\u306b\u3001  \u300c\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u300d\u3068\u3044\u3046\u884c\u70ba\u305d\u306e\u3082\u306e\u3092\u697d\u3057\u307f\u305f\u3044\u65b9\u306b\u5411\u3051\u3066\u3001\u4e01\u5be7\u306b\u3064\u304f\u3089\u308c\u3066\u3044\u307e\u3059\u3002 \n\n---\n\n## \u7279\u5fb4\n- \ud83c\udfa8 \u7f8e\u8853\u9928\u306e\u30a2\u30fc\u30c8\u4f5c\u54c1\u3092\u4f7f\u7528\u3057\u305f\u30b8\u30b0\u30bd\u30fc\u30d1\u30ba\u30eb  \n- \ud83d\udd04 \u30a2\u30fc\u30c8\u3092\u53d6\u308a\u56f2\u3080\u5186\u74b0\u72b6\u30ec\u30a4\u30a2\u30a6\u30c8  \n- \u270b \u30cf\u30f3\u30c9\u30c8\u30e9\u30c3\u30ad\u30f3\u30b0\u5bfe\u5fdc\uff08\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u4e0d\u8981\uff09  \n- \ud83c\udfb5 \u7a4f\u3084\u304b\u3067\u96f0\u56f2\u6c17\u306e\u3042\u308bBGM  \n- \ud83e\udde9 \u30d1\u30ba\u30eb\u306e\u697d\u3057\u3055\u306b\u96c6\u4e2d\u3067\u304d\u308b\u30b7\u30f3\u30d7\u30eb\u306a\u69cb\u6210  \n- \ud83c\udf1f **\u30b5\u30d6\u30b9\u30af\u30ea\u30d7\u30b7\u30e7\u30f3\u3067\u5168\u6a5f\u80fd\u89e3\u653e**\uff1a\u3059\u3079\u3066\u306e\u30d1\u30ba\u30eb\u4f5c\u54c1\u3001\u96e3\u6613\u5ea6\u8a2d\u5b9a\u3001\u30aa\u30f3\u30e9\u30a4\u30f3\u30e9\u30f3\u30ad\u30f3\u30b0\u306b\u5bfe\u5fdc  \n- \ud83c\udd93 **\u7121\u6599\u304a\u8a66\u3057**\uff1a\u4e00\u90e8\u306e\u5927\u304d\u306a\u30d4\u30fc\u30b9\u3067\u30d7\u30ec\u30a4\u53ef\u80fd\u3002\u6c17\u8efd\u306b\u4f53\u9a13\u3067\u304d\u307e\u3059  \n\n---\n\n\u30a2\u30fc\u30c8\u306e\u9759\u3051\u3055\u3001\u89e3\u304f\u3053\u3068\u306e\u6e80\u8db3\u611f\u3001\u305d\u3057\u3066\u76f4\u611f\u7684\u306a\u64cd\u4f5c\u306e\u7f8e\u3057\u3055\u3092\u3001\u305c\u3072\u3054\u4f53\u9a13\u304f\u3060\u3055\u3044\u3002", "short_description": "\u97f3\u697d\u306b\u5305\u307e\u308c\u3001\u5186\u74b0\u3067\u697d\u3057\u3080\u30b8\u30b0\u30bd\u30fc\u30d1\u30ba\u30eb\u3002"}, {"images": {"nodes": [{"file_name": "haloPuzzles_logo_1440_1440.png", "id": "1637859974267992", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823447_1637859977601325_8820920098660740044_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIpUTWHDI7cQ7kNvwHoVCu2&_nc_oc=AdonvIJp1-XId_UtzEvyRca9KCo-IoUxC5qQgj7WLUkII43an0TadtCabUWjfoFOleU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7V0krZKXsBtvuumnccQusX9AyKrt1SUWfumP9Usc0Ig&oe=6B006887"}, {"file_name": "haloPuzzles_logo_3000_900.png", "id": "1571860684198745", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819385_1571860687532078_6777135583817581882_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TX8OKrweFI8Q7kNvwHY50GJ&_nc_oc=AdqVSlwJfvdd_Qy6cpD10U-58ZWmsYjc87ittB_44Q2LCLJYHKKf3_u9mpfp8Hu4Qaw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUSkxdKtt3hJSUv75_0d7vumS016B7Fsug9DbyrtU2Vg&oe=6B005044"}, {"file_name": "haloPuzzles_logo_1008_1440.png", "id": "1452826182581375", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824594_145
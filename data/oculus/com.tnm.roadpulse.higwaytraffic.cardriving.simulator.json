7&_nc_sid=6e7a0a&_nc_ohc=oXWeCND78r4Q7kNvwHn8QiB&_nc_oc=AdqVzA46bDpMERbHfvMBarUFMqYluvJoHZU6_80DS7YwV7xEZjoX95LeDgnSt5rqKt8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJV8Kr1xDPQeDuijQUCjM18lwtRb7MyBBitQaGsB43RQ&oe=6A9181D3"}, {"file_name": "5.png", "id": "2076251982958224", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491821719_2076251989624890_4798620733791238737_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcfFrnkhUKcQ7kNvwHw1dPY&_nc_oc=AdraxQXW44HqL3DHPWOOd_S_Sl1E44Kr2Hm4Y0M3KU5_yicroEGrU4SOQuice_0LeXw&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQET-bZ92Db5D7oPyllLoAFeRs8B38SPERP3hypFYfMs0w&oe=6A918AE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 cover pic.png", "id": "26120132051005709", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/491818890_26120132067672374_7425202862343041576_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0MWyYyNSugQ7kNvwEOmhlt&_nc_oc=AdpXFymoRwZBZBq4QN6nGxW5LtdmXp-ZYvH7KFHs4wvmLJ_xtA9Oz1Eu6lKDxOU5HR8&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6YdnEXhgIWIpklfHyTmw1DCyfJ5H97N8p0jsj-aeRrQ&oe=6A916108"}, "display_name": "RoadPulse: Highway Traffic Racer VR", "keywords": ["traffic", "racing", "car", "driving", "simulator"], "long_description": "Step into the driver\u2019s seat and experience the thrill of high-speed highway driving in virtual reality. RoadPulse: Highway Traffic Racer VR delivers an immersive cockpit driving experience where every second counts as you race through dense traffic at extreme speeds.\n\nDrive powerful cars across endless highways, weave through moving vehicles, and test your reflexes in a fast-paced traffic racing simulator built specifically for VR. With realistic cockpit views, responsive steering, and dynamic traffic flow, every run feels intense and unpredictable.\n\nMaster the art of high-speed overtaking as you dodge cars, avoid crashes, and push your driving skills to the limit. The closer you pass traffic, the greater the thrill and reward.\n\nWhether you enjoy relaxing highway cruising or adrenaline-filled racing, RoadPulse gives you the freedom to drive your way.\n\nFeatures\n\n\u2022 Immersive first-person cockpit driving in VR\n\u2022 High-speed highway traffic racing gameplay\n\u2022 Endless highways filled with realistic traffic\n\u2022 Multiple cars with unique driving feel\n\u2022 Dynamic environments and smooth VR controls\n\u2022 Challenge yourself with near-miss overtakes and skill driving\n\nJump into the ultimate VR highway driving experience, push the accelerator, and prove you have what it takes to dominate the traffic.\n\nStart your engine and feel the pulse of the road in RoadPulse: Highway Traffic Racer VR.", "short_description": "RoadPulse: Highway Traffic Racer VR puts you in the driver\u2019s seat of a high-speed cockpit driving experience. Race through busy highways, dodge traffic, and push your skills to the limit in immersive VR. Feel the speed, weave through cars, and master intense highway driving in this addictive traffic racing simulator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://filestechnology.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Files Technology Pvt Ltd", "support_website_url": null, "website_url": "https://filestechnology.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interacti
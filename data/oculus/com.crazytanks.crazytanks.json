4732_434645204029334_8954674579259785216_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ob44CJxurToQ7kNvwH0aJ-H&_nc_oc=Adp2JUCDJCoeg6ykyWtkOLw6Gl3hQ7PYoNmC2W-nSSq-hd8SbShowfAd2gboAUSO5yI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmvB6iiXM-40JcnjcqAl4FQNH3Y5YZhD8GGvKBfJ8X2w&oe=6B005855"}, {"file_name": "migrated_image.png", "id": "248573236181711", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974664_2415543541818567_3264394652148563968_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xa8iAAOJ_4Q7kNvwHq8KF8&_nc_oc=Adqm3AzJwkds_hNj78ExvJXAr2GBQalcGgYUVrD6YLk_StV_tZ-LMBI1fvRlYrRd4aU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-RsJG9b-XmI5-sWSA74b7TAiC7G_4Gxfp0l0PYjadpQ&oe=6B00740A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/igvanf", "id": "2064556733847485", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982689_2064556737180818_7042735879894335488_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvb1uZcniY4Q7kNvwHVAjv_&_nc_oc=AdqYpsyXvwIEXds-t1MOtIwCSUM5Qe9pdgcwiKR9rBXwfB7pbjf181dnzkcYet2SM-k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyWM1MnU8D5xLZ1lZyEniK2rVGZLKk9yTlb2ezn5iJwg&oe=6B005E1C"}, "display_name": "CrazyTanks Multiplayer", "keywords": ["CrazyTanks", "Multiplayer", "Crazy", "Tanks", "free"], "long_description": "CrazyTanks Multiplayer: The Army of Shadows\nJump, drop mines & telekinesis to kick some tanks in a crazy tank multiplayer.\nWelcome Commander!\nJump into the battlefield and fight your way through this crazy real-time tanks shooter multiplayer!\n\n+ Crazy High Speed Multiplayer +\nUse your tank's crazybilities to kick your enemies - jump behind them, apply your telekinesis force to throw them off the cliff & drop your mines from above.\n\n+ Fight Your Way To Victory +\nGlory, Honor, Eternal Fame - and a lot of other words we've found on the dictionary - you can find them all when you'll become a CrazyTank commander!\n\n+ Features +\n* Jumping tank with telekinesis force\n* Upgrades\n* Cinematics\n* Chat\n\n+ Cross Platform - Play Everywhere +\n* Android\n* Virtual Reality\n* PC\n\nWebsite:\nhttp://www.CrazyTanks.com\nPrivacy Policy:\nhttp://www.CrazyTanks.com/privacy_policy.html", "short_description": "Welcome to Crazy Tanks!\nJump into the battlefield and fight your way through this crazy real-time tanks shooter multiplayer!\n\n+ Crazy High Speed Multiplayer +\nUse your tank's crazybilities to kick your enemies - jump behind them, apply your telekinesis force to throw them off the cliff & drop your mines from above.\n\n+ Fight Your Way To Victory +\nGlory, Honor, Eternal Fame - and a lot of other words we've found on the dictionary - you can find them all when you'll become a CrazyTank commander!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crazytanks.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Shweng", "support_website_url": null, "website_url": "http://www.CrazyTanks.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "332692152102792"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_2563778477276441_229280223437258752_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yZvXaDZ
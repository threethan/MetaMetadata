4732_434645204029334_8954674579259785216_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4-QWTk5QMMQ7kNvwFA-6zR&_nc_oc=Adoj5QhYIWtwIlx3EOXmOjQpJ4QvijvFqjRmitl4qTcKhpaxjqvrIlxOnJY1RJ6C818&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT94N5weTP1M97NZkdNkRRAz3grZ0J1Mjqjj87iR2HzHQ&oe=6AFC63D5"}, {"file_name": "migrated_image.png", "id": "248573236181711", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974664_2415543541818567_3264394652148563968_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlR6UWukIKcQ7kNvwGjV6Av&_nc_oc=Ado72hVNSzpbqG3oGYngO6XZEJA4s4o7XLyKORdRcuxlUy6dXRcIdztCRv-FEzgynPg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSM_DO1z2ZO63J-2Yf5iZ2Mc9I44s0TmSg3pZLOQUKNiw&oe=6AFC7F8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/igvanf", "id": "2064556733847485", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982689_2064556737180818_7042735879894335488_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BeIbYzZBurgQ7kNvwFSLzqh&_nc_oc=AdobtakoVNv5qCUNaQ65VNHz2eATgz8f8RQ4Aduyvfj7uiGRW4ZkutBsHG46vc2UR40&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8WDqz0QFMB6IoEvJzAYIIQ6CVUulKXLSkSRYOpuAAgg&oe=6AFC699C"}, "display_name": "CrazyTanks Multiplayer", "keywords": ["CrazyTanks", "Multiplayer", "Crazy", "Tanks", "free"], "long_description": "CrazyTanks Multiplayer: The Army of Shadows\nJump, drop mines & telekinesis to kick some tanks in a crazy tank multiplayer.\nWelcome Commander!\nJump into the battlefield and fight your way through this crazy real-time tanks shooter multiplayer!\n\n+ Crazy High Speed Multiplayer +\nUse your tank's crazybilities to kick your enemies - jump behind them, apply your telekinesis force to throw them off the cliff & drop your mines from above.\n\n+ Fight Your Way To Victory +\nGlory, Honor, Eternal Fame - and a lot of other words we've found on the dictionary - you can find them all when you'll become a CrazyTank commander!\n\n+ Features +\n* Jumping tank with telekinesis force\n* Upgrades\n* Cinematics\n* Chat\n\n+ Cross Platform - Play Everywhere +\n* Android\n* Virtual Reality\n* PC\n\nWebsite:\nhttp://www.CrazyTanks.com\nPrivacy Policy:\nhttp://www.CrazyTanks.com/privacy_policy.html", "short_description": "Welcome to Crazy Tanks!\nJump into the battlefield and fight your way through this crazy real-time tanks shooter multiplayer!\n\n+ Crazy High Speed Multiplayer +\nUse your tank's crazybilities to kick your enemies - jump behind them, apply your telekinesis force to throw them off the cliff & drop your mines from above.\n\n+ Fight Your Way To Victory +\nGlory, Honor, Eternal Fame - and a lot of other words we've found on the dictionary - you can find them all when you'll become a CrazyTank commander!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crazytanks.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Shweng", "support_website_url": null, "website_url": "http://www.CrazyTanks.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "332692152102792"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974518_2563778477276441_229280223437258752_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCDisdQ9
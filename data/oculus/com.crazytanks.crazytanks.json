4732_434645204029334_8954674579259785216_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ob44CJxurToQ7kNvwFIE2K5&_nc_oc=Adrb4_ChHKsxKOFrQMRoQEpfYAp_keW-7IywJZW4Q78xrCJk6deOV29sS4FBBM3n-dM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFKWyBgaPyKCs3QkcG777wGEJwd3VmLWlmsHE5qZVKpA&oe=6AFF06D5"}, {"file_name": "migrated_image.png", "id": "248573236181711", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974664_2415543541818567_3264394652148563968_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlR6UWukIKcQ7kNvwEdDRDu&_nc_oc=AdrOak86ECtd8NDzc4Ym1J8iq6d4vlrQrU-hdk5NRMUha9C5SU0Q1vOcvNW8qAKKT4Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQI6EZtdAHrw225rFD58xKsMZ_kfNeXLw3fyp_lv98IkA&oe=6AFF228A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/igvanf", "id": "2064556733847485", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982689_2064556737180818_7042735879894335488_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BeIbYzZBurgQ7kNvwGnJm5g&_nc_oc=AdoQU61Nz6c4Z78wJeB-HaFpzZmzDrJaW0Co6q71BrE4lhJytXNfK2Y3vRJ593h4HSY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2w7io79wlwLy1Ui_AaUaILO_ztdhoXK7ZVZYAdlzWpw&oe=6AFF0C9C"}, "display_name": "CrazyTanks Multiplayer", "keywords": ["CrazyTanks", "Multiplayer", "Crazy", "Tanks", "free"], "long_description": "CrazyTanks Multiplayer: The Army of Shadows\nJump, drop mines & telekinesis to kick some tanks in a crazy tank multiplayer.\nWelcome Commander!\nJump into the battlefield and fight your way through this crazy real-time tanks shooter multiplayer!\n\n+ Crazy High Speed Multiplayer +\nUse your tank's crazybilities to kick your enemies - jump behind them, apply your telekinesis force to throw them off the cliff & drop your mines from above.\n\n+ Fight Your Way To Victory +\nGlory, Honor, Eternal Fame - and a lot of other words we've found on the dictionary - you can find them all when you'll become a CrazyTank commander!\n\n+ Features +\n* Jumping tank with telekinesis force\n* Upgrades\n* Cinematics\n* Chat\n\n+ Cross Platform - Play Everywhere +\n* Android\n* Virtual Reality\n* PC\n\nWebsite:\nhttp://www.CrazyTanks.com\nPrivacy Policy:\nhttp://www.CrazyTanks.com/privacy_policy.html", "short_description": "Welcome to Crazy Tanks!\nJump into the battlefield and fight your way through this crazy real-time tanks shooter multiplayer!\n\n+ Crazy High Speed Multiplayer +\nUse your tank's crazybilities to kick your enemies - jump behind them, apply your telekinesis force to throw them off the cliff & drop your mines from above.\n\n+ Fight Your Way To Victory +\nGlory, Honor, Eternal Fame - and a lot of other words we've found on the dictionary - you can find them all when you'll become a CrazyTank commander!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crazytanks.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Shweng", "support_website_url": null, "website_url": "http://www.CrazyTanks.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "332692152102792"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974518_2563778477276441_229280223437258752_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yZvXaDZ
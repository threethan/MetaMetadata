licy.html", "short_description": "Welcome to Crazy Tanks!\nJump into the battlefield and fight your way through this crazy real-time tanks shooter multiplayer!\n\n+ Crazy High Speed Multiplayer +\nUse your tank's crazybilities to kick your enemies - jump behind them, apply your telekinesis force to throw them off the cliff & drop your mines from above.\n\n+ Fight Your Way To Victory +\nGlory, Honor, Eternal Fame - and a lot of other words we've found on the dictionary - you can find them all when you'll become a CrazyTank commander!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crazytanks.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Shweng", "support_website_url": null, "website_url": "http://www.CrazyTanks.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "332692152102792"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974518_2563778477276441_229280223437258752_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdjKGgNtzFcQ7kNvwFe1Jtl&_nc_oc=AdqlqPGUoN59H3S-Je6ks-ZMu2WvJEEaI0N9miVwp1kvUIKKBWZtuxkM9MzaFh1W1kU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8ah4tE954ltDsiT-nsvg5JYDgzEl-3fnXzWw-7hkP6A&oe=69C5353A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CrazyTanks Multiplayer", "platform": "ANDROID", "context_ca
RGkdvWfKHJFIb6WQ&oe=69B7F2BD"}, {"file_name": "Pulse Oximetry Check Simulator_screenshot_06.png", "id": "3592609274310547", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036616_3592609277643880_6200790175694893050_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQdZJy72NcEQ7kNvwG_-Msv&_nc_oc=AdkK87gTsq8a1N1l6vTL30B1N6oE-zu3Ff6c26ODVn-h4plh4isVZywaR3EaJ_RRFW0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxaBAxwzRe1sGYUhb200Tubt4GkVqX_sbzWhMLc_KEJYg&oe=69B7E809"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "1368935690456281", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035327_1368935693789614_190901453314409853_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_yqT04EeJksQ7kNvwGIbrz_&_nc_oc=Adl7BMul6l35zyPz6yEGnQWxlP8A1xN10fbHTqC3BuniVGqsgIIKw3cEpxZ42jbm6Oo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwZTTrft7izlkB9aV11Ij_Pd2Tc6JUYT38Ympah7oVf9w&oe=69B7DE11"}, "display_name": "Pulse-Oximetry Check Simulator", "keywords": [], "long_description": "The Pulse-Oximetry Check Simulator app immerses participants in a realistic and interactive environment to practice and master the use of a pulse oximeter. The application guides users through the correct selection, attachment, and operation of a pulse oximeter, teaching them to measure and interpret oxygen saturation levels and pulse rates accurately.\n# Learning Objectives:\n- Remembering the normal ranges for oxygen saturation and pulse rates\n- Understanding significance of these measurements in patient care\n- Applying the correct technique for using a pulse oximeter in various scenarios\n- Analyzing the readings for accuracy and consistency\n- Evaluating the results against normal and abnormal ranges\n- Creating appropriate patient care plans based on the readings obtained.\n\nThis comprehensive simulation ensures that certified nursing assistant's or anyone interested in the healthcare field are proficient in using pulse oximetry to monitor and assess patients' respiratory health in real-world clinical settings.", "short_description": "Designed to train CNAs in accurately using a pulse oximeter to measure and interpret patients' oxygen saturation levels and pulse rates."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25586961224284130"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "30519945920985611", "version": "2.0"}, "id": "1362912401768742", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25586961177617468", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "30519945920985611"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name":
-kb_cU2J8EU92hSdZfhkjZptwelzkvuyqhhfVvIC5LQu53Wo3chBpCYqe6BA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXoa5u_o2xYJU6viITZwcCElFXXz24g7u5KZKUAt0ClQ&oe=6A99852C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=032WHO1Kuc0Q7kNvwE-XrGr&_nc_oc=AdpOgDmOxsQG7xZeayLKCXbVeOUvWH10_TkL9l6QRuffk27kKwrazgJWQe6FAhVoJbo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcIX1CSZej48G4jTabiPJgVwk_QkMcTQvVXMkF71udog&oe=6A9974AC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytHo3kxijkcQ7kNvwHWTNTD&_nc_oc=Adpeq3IpY8ct9923CUXLXxiXI6Qs49FK1b3L3GbqTD9dhzDr4uNUBFJVmF550cgWJoI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLa1P_JTdFvjoL5P_ZHeV17UTvaXm9OU_xOuH7ZurfIdg&oe=6A998D74"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OK2qZj-9toQ7kNvwG76MLi&_nc_oc=Adr9TiNZ2HRHGphJNN7f7P-NGZCz3e2VVMJoZ4uik1pmPMLufS7zYlIxFrSgr1hiBQM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNKQcIHGaTJyxdI8uB2GMQoKDTa4JnH6yOIxdOYGb2JQ&oe=6A9987B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RbVIxb7Ma3sQ7kNvwETPrJo&_nc_oc=AdoSdGNlLEECDl2VCCAnx_RD37LtBXEceKxVUDlKKZfWTSLNKHqP_9Ucbo2aBvJcEIc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIijIUXTXfXmMo4uDFIvZ_vzppM6VVCKbgvly7AOx1iSA&oe=6A9996CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
om&oh=00_AftOjojs5WZh8-MgTT4sU2uKyihqERcH9pai9sfzwf8jng&oe=6999C22C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGa2ii3ybGoQ7kNvwHqV85O&_nc_oc=AdkcopR2xviLiCBL0kYA9SIjh4w7M4n29rhJKn-igRsEfrNxR6SY1iWItCZhMCvkbFg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftP6j7LTjX7KEJxyrR7CWn1siyl4M4-CpQcMz-tajzzKg&oe=6999B1AC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWhhJtqcO0QQ7kNvwEoCKhh&_nc_oc=AdnlH5f47VwHiog_F_4PXlNBiqzCMvFhKFkqkriei1BblB6I9O5rs7WX3H_7gDw9hUU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvYCu3pgRIssPhPCzpDdyrZb0KECL5KLmqGjcZggBNn3w&oe=69999234"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyCkXExRgkcQ7kNvwEKoM23&_nc_oc=AdmElOOZPWnVxvZVarxFb3xZt0XrcwJLdoO3M3xZhMP46w0DuVwubSjm0b5t5wzQY9c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfssMprYpBDXBYvHRJ60iOhJ6Rc8g-Ob6nVRftbNENU_Mw&oe=6999C4B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8nKwTI8pwkQ7kNvwFVisad&_nc_oc=AdmnHRspuIdvRJikX-36OPqg1x0HhYx1DgA16zcpCGufaZuryQuCNMXvcHxrDpo0sqk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs12T8osBI6dNBR30oIR8Z3mAy8wxn2LxUFdKV6y-MGqg&oe=69999B8F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Frizzle Lecture Viewer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics":
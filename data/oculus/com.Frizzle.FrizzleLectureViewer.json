uAmZs-fTwMz268cAfaHBb2E1JfNYKvx8G6fI8XB737VquSE7Ljja0dXjlHsw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pSI7kWeVo1zcwHHMSvSHmKZCdTPWaZKeH39DyDBBouA&oe=6A32B02C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rsdz0mqqx68Q7kNvwHTB7eE&_nc_oc=Adr3sQ0VZM-LpfRQaiQ8uM4iyCoHVwzyHGBJ0Pf5Jk4XUf2OFhms-8SAMVvPfns3mwU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IgS6AhoQYQ3Q_oDzOeJcg3LhrOBNDN90sDfb5xZxMyQ&oe=6A329FAC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2oA4eH4xs8Q7kNvwFPxRPQ&_nc_oc=AdqSOR-X3zegtH_CiGo_MzDkhOZYs7wxe1UKTbvpe9qwtY0ZVgdd1I2u3HEaotAC0lI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ua_aJ5NcKCBj1nNbwvKIrtG6N7Wsi756upFQXyn40LA&oe=6A32B874"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aB7DVIKWpjsQ7kNvwEEZBon&_nc_oc=Adp5JBa9g3EZpAOJE6qcZFsTRUCFHqvD_ng44mXc-VacfDZE77RzmTT6anxQfegmmh0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8k6Itmt8PP1mmhv2n7WfNkPSr34m1SEle_EQMRCfqhkw&oe=6A32B2B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LC2kzavwrYQ7kNvwHLExZA&_nc_oc=Adq9yaiKUceN6ypjC8-NIF5RrkIS4mZ9gPpWcUe5ymzcXUY7D9EaaFhMnP12sahHXFU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-N6RrZZEPeWpCJxgkb1etMRfNdH_oaeiAkNTcilpIdRA&oe=6A32C1CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
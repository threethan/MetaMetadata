}]}, "id": "529731165078104", "locale": "en_US", "screenshots": [{"file_name": "Untitled-1.png", "id": "1440312639635006", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003228_1440312642968339_2789643189716025521_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7AH3I6MipWQQ7kNvwFfG-C4&_nc_oc=Adolc7Nq9JIWwcgsrB3P4kd_TgHBF7-YOl0nPyvy68yNcl_kFSrJLoQz7jU9mLT_IhI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Zmxz5CamD2i7HXJs3kSuSBPcbkosuiVJ2VJEgssHulw&oe=69DA56EA"}, {"file_name": "Untitled-4.png", "id": "437567900675752", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031645_437567904009085_6070206936841904870_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfqwkI3evO8Q7kNvwF8VUzu&_nc_oc=AdpCoOlpj9ln1T44qwgyw8uwspBBuXiGiQViMzx6DkqSP5BCfnv9WjoiCg39siQi164&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yNPzT-spZYDrJkSGV7C-wvKp7ZSZdxGl8uqT4i0_HOQ&oe=69DA5BAC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONbzZYB0nIAQ7kNvwGsfrLW&_nc_oc=AdqbJVaq465Z7mJXpbQnWVvZ33GQNR0y5vfQJFkaYZg7ZbHQa6H473EFrgtOverLHxc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vJ_PdMSw8FUNEiDxOfFrrDKjpaVwQ5V9WPk40orCQDw&oe=69DA4B2C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=isaR5XGLuNcQ7kNvwFARRC8&_nc_oc=AdphcK5yWF7Qc26c8R6pNxwhiR58NVZ_CbWSoEn3yRTCzkPofxZAufAIKWqEAwtdXDs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YLMjaozaNw4HW9CXKiv9kqKBggkZRngma680xMLeaiA&oe=69DA2BB4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKixhXLjIYwQ7kNvwFOhwrL&_nc_oc=AdqmpUsg2zwIbxI9yzxXySvEy_Lx5JkkEqwrXwZ2X5XWGV5MOViGQAm0JBpz_-CjlXc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YUuvWHphiDQAK5H-Jnr-1oWDkUKSDBxMfr8YMBGMUyQ&oe=69DA5E36"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
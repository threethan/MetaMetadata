8fdZ57CnbE9A7sJtEYo3pgAxG-GjTZRSVnBHZYJT9qZTViv_g3sSqIy5Yr3I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIOQ_-CQ1dTpMElUBX6HHglJv9xBOhLtqcVnPN0viMjw&oe=6ABD1DAC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHxE4iMkERMQ7kNvwGJwPV4&_nc_oc=Ado4ARUpP14Q0VZh2P-NDWaNkqfdm8im8Jbye5IdK9k2K2uZ53OGzht9INGxfgfs-xA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHcff_7tcY-qgLqDnftHfw3wJR-gGgRZdcBMvT2daaFQ&oe=6ABD0D2C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LtU04reKWIQ7kNvwHCsbvj&_nc_oc=AdpgaRykSiaUya_bTHIJMblTARJec_x1hTKuTDEot8d48KKNDhtorRcbL2xpXRp5QG0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDLKtXB_p_3Uf1ymF_nf33P8M-CQohCyM5xHkz5dHqXA&oe=6ABD25F4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEghw_-Lxj8Q7kNvwHlEQOz&_nc_oc=AdqoRMGxXr8hP9tAWUHcGgcdhQBZYkv1yVtLhUiIdvfd-nunYp3JX198pETCmHRf9iQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQ17z6WMq_y7E7qH5eLjkscYaceUE1ug3W7wMRR3swKA&oe=6ABD2036"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUQMunievwwQ7kNvwFhpCAz&_nc_oc=AdoBNehYT5Uo-2TQ-MtnfYIBGZHK4OXaFI9nj-V_tZMJB4OGmIamim8uP8UvAk9Wp0w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5xnCavyJrkvWXpLO6a6AQvjekizgcoQSGTdT492V7Lw&oe=6ABD2F4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
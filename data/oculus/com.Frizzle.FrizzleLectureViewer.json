WOqJnSpwsA16xc2wE-CEolr3Wh5mY6nM9zznzw9A7nbZtIciGvU_9RAkyGl0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ38KERvvaDSimth3FwpRjyN-JjV0w-Ri6TFN-bXoQJVw&oe=6AE74DAC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7U9frWK64xIQ7kNvwHnjfu2&_nc_oc=AdqgMnGCJuSvbUSriknys65_OBYVl86d5mqdiMdma-cD7rKyUWQY_6C4lsOP2omqJRs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRU8-BNCLk3LDGI2c9PLDjL01Y6z0ru9ywIUWbzMO1kGg&oe=6AE73D2C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opIpGMBV-HwQ7kNvwG7n8mJ&_nc_oc=Adp1ypyGgtjAZT_VWmbjtBsmbeAbowbjg7ha4ubCIg4G0WU8leKRPjjuHxqxh12Us-A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0s-T0IMKmKtb3HCLgpOboy30RZEiQFb5JGN3za4lbMg&oe=6AE755F4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaiBp_3xOEAQ7kNvwEFfkya&_nc_oc=AdraRT_jYd4-TEjDgYlQfhmUK1vykU3y2lNQm4PGdsSt-scqge9yrItINzmwpg8VE3o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXEmZsJ7ONlBu0ZMKdQDAE5Sm2PmPfsd8-SZpX7J7FpQ&oe=6AE75036"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zymmoTfvXysQ7kNvwFY5qZ8&_nc_oc=AdradZifXMiR158vlZwTCzfHVOTjvkIATkS02I8bnwbgOo6P6GC64LJIvwKMf_sUF1k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQG1vmB_-sDSeW_tclvvnZRaNz1NqT2_YSCi1vEDrDeug&oe=6AE75F4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
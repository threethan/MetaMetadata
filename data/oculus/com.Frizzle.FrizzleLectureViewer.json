U7pRIgeqZRmgMgQqFVyaJGvRDTA_JRxpu1grzSgjpizQuqSxLrv6AeAjgVlc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEom3_smQIIJ0SZTx2HvHh44p9wMXt0xOrFu2AboB_mPw&oe=6A71F82C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7iOp0OmGMeAQ7kNvwFmEc5z&_nc_oc=AdpyscInHuNcX2RIS_-Ott9GUfRJXtD7XXiTrXLZn2uBIImQnjaAySH74PivO5o5cws&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFs5T5HBR5UNPEOIgWaqcFpMvzPhpXhUdz2SuJoAUWe4w&oe=6A71E7AC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUD4UAOD4ggQ7kNvwGNGo88&_nc_oc=AdqigxnzKYkoL7iTZFnFprIoDdatJbUJLu3Es_GnD5-UdGnRHNmCBfzx5QVcTr9mEHw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRX08JTmCqaH4mZs1ER57cQUVxFzWQsoLC-LxFRTmDsw&oe=6A720074"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1khP6IUra0Q7kNvwGFpXs9&_nc_oc=AdpU47hhme-5R6jsdxTu5aFz2N8WmO00Vr8I8qduBVL0Gksjh8QkiNEWMh8KQJ3FPYA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRuhR4kcNkAxne9GtvqZnA5UiidyfmKvx_PCR3JG0Q7A&oe=6A71FAB6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HT1Ry9GjQsQ7kNvwHeVPVI&_nc_oc=AdoNRBDY8NRalC_ILY92iMNOQEreqEXeSmA4T8SOnm0QkxxY6dHBlWNJ5U0gjgm3kaw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZB4AlfCXgvvskgAEDLN6HoYxtbUzQ9rXqH6N3XwCcYw&oe=6A71D18F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
7wYmk6516WdNmqdAH_TdtLvhGAa5O6X29m8BVR0on7Wg1m-nFWRyI2cx2Xw0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiBDnH7nR3iO-brYxzFqFThjvTYR7vHbUzlZ-8CzFyYQ&oe=6A9406EC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCFAotQBozgQ7kNvwELhkkK&_nc_oc=Ado2kq_zxEtE8rIOeotvpSEGE-_CSJVZpUOABQxSyAwLpqkOSRdWXQuDmu8F6mfXvxg&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8haAipWL5L3Op4jlZfUWcJX3LD7hLVYK0la6GuvdvXg&oe=6A942EAC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-FyVrj0b8IQ7kNvwFhRIWX&_nc_oc=AdrYUe0wusPha6QpM4UViBw6rl2v2_Boy5BcOeACHQrItvnJ-Ub28qxVct5EIqFHXFI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdTxec_xorR7biA_jevgLx8YiOhUaHltSKVnumMjDwXw&oe=6A940F34"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ld3xBFrNxCYQ7kNvwHUOTNG&_nc_oc=AdqhZmrBrGuKnWV2RYPoUzaptYQCd7Mqf7sBlrQJO9sysw1TbrkA8185w8_PxwnbPJg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyKyp_Qj_CQ6CxHI-kKdb-83hG2hemvb7ZFueWC3g1-w&oe=6A940976"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zGQaWLiKc8Q7kNvwFL0qEf&_nc_oc=AdqZkMqK3lZKlDNkq1HGyYBRVwoVAn2zF0OkwqxgRdJt2XJMj7SfwRoxurp8sqK1p-Y&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBWqaEYLb3SHLGKiPHesZbJXZ5ZtnmXZlbsv2fcV266g&oe=6A94188F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
D2qscZwd272LuzVFwLnRlQZbOb01op2M56OF_sAnPvINC3r5QMemxHOHCwDo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRjvX9hvukn3jumA6-vYIIIgQkBpe5tjGfW4Togyxnkg&oe=6A92B56C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCFAotQBozgQ7kNvwGgILxS&_nc_oc=AdqWIJMwkgcaik5k-nqjdNKDnDluhS8Qj08qWm3TIgEPI82NlEXAfzy4SgcHKqSaMh8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvG-aY26iclswXeWru9k9twVupDYLu9m9K4LGpx0Tsqg&oe=6A92DD2C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-FyVrj0b8IQ7kNvwGfiXfB&_nc_oc=Adovf9ER2c7aywLJEDS4-Rt7k191wTRAYgMgwXaUx1IYhC9Q8MvtL9Oe2IrBlSnltJ0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHtFmGFbOaHRCeELmejaCHVuknkuzIJZw1vTu_dLW9TQ&oe=6A92BDB4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ld3xBFrNxCYQ7kNvwGzJ6XC&_nc_oc=AdoqXBx92OGUayWF7Enc1s9P3NtX1VflH0tkq-khZtN3iCToHe7aeVkOt2OCCFTB6HI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErg2mqO-KBX0MyHr6dQCJp-HrcwYeXmpXbviFCEutZVQ&oe=6A92B7F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zGQaWLiKc8Q7kNvwEN8qgJ&_nc_oc=AdpL6TA7t5xjjxwOtM-ApL3DRDZgze7PSsce7xLJheToJmgNa9cqGdsWdURxbe4v9Ws&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3LDpt-zGEjPSSI9Ofb5HoJwUtXNTMAInCy7bEHRsQaQ&oe=6A92C70F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
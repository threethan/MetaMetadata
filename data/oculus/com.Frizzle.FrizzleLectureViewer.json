1teJNRi9NWgFBX5_rBFPQZ-m6P5R1SC7a5JNLoL22AdhHkRkaks8yrLMKtEs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLE5K8lK1J_IrHSGdzUA6IxoBmiWgwGyYg7FREBXoUK6A&oe=6AA805AC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNF1m6owtgcQ7kNvwFaYkTJ&_nc_oc=Ado78FhfcMOQ8jdGev_84fwCjUAGbFrJcLer9YdTA-SBVo2peT1GnWbLEQLPBZjBXMQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLk1eSXQyPF2vMbjZwlkEZeGR0TiHyRkFPsd8V4qhXkbg&oe=6AA7F52C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmLULtQcc0sQ7kNvwHOk3tD&_nc_oc=Adqh0_L1g6LjNmdeH8VMAjakSo6tFWuYM9lOpmYJqHfVyt3TD57yqKjxKY1X72wk5h4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3Xt6ku3mLVT8VlyuzQxJTdzBQP0vKDHgg7bjHm-Uy-A&oe=6AA80DF4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqLmqx0f_ywQ7kNvwEgAfWJ&_nc_oc=AdrFQoRP9Nx_6odp8VkqedeZR2f1W2XU5bMHCU3MdSChyiUv5AXhHtiUpN6O5NT5m-M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIi9_EizcfF_XwgGQB4ujVMsX_VxHWRjzPBlRMQ-6NNSg&oe=6AA80836"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q73iSG05RFoQ7kNvwFkkcVp&_nc_oc=AdpydTZ4EUUbHhkeow3w5_lQYEZ9ixcjQplFPpFsjvaql6AiLhUoA4R5crTX0eIJx70&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvAbyVS63x0NUVJwBzZQj9qWGHuGDa0PBTsErtn7HyrA&oe=6AA8174F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
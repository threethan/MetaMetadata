7YHCVIVVUfe7SbBTcGHI1kunnRqS28h9u_k1dW_JcCnyi2yp199BunyE1rB0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-j29dnrpceq2jBsfX2pQxpdTNbt_8fX6asQbksRslZYg&oe=6A43D3AC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Pbe2t2GSagQ7kNvwHuAhDU&_nc_oc=Adohn9m1R_u7i3VQEM0F5ugPY1Z0Wi1ebe7JcWck9LU9PaiacxSeKyEjQZAiNqmpCEg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EFdW1FzBZYwUuqsFRXycA1JthjMoZx9gHsJH819ahoQ&oe=6A43C32C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeafuWoUUycQ7kNvwEjDLwZ&_nc_oc=AdpHYUqFZsiQJ2GjqWTTMiqMZgTL7X9RdAsJV7dZX3ppNLu2VmPd_igE5UmfYDRAIxc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_G9umaCZ3VGjAXOpi4C5c2QvJ_FbIce84WNDETOjCN3A&oe=6A43DBF4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvqlZopFYykQ7kNvwGDtL_l&_nc_oc=AdotSqcxEjZuccelD4hE0QToauwdbFAGVIifCyz3qKV4RuWnoshBT2l0glWpA3sTTgI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WKPpQUUzB8-t1ju2uoG1esqroapASkGaoGV2lDV6Idw&oe=6A43D636"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lj6f5yRZCKgQ7kNvwG0TLBv&_nc_oc=AdreMrTj0jP7iS6pw5-gZ8L0ESiVlReXXwdhoNMrhk69W32O-bEKbw4om-vC-gXuJlM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QvFCtE0W3e-kSkEoMisN9VfgjrGrYoJ1yDrZfFfm6uA&oe=6A43E54F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
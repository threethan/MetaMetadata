yeyh507zjoiAoIwwiUdu5n4w5jSHM2oo9UTrBQKrsbcDUReZ2jfW3xMEySUs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3Pj4vdRFZnhjEju0N6Q_r412ynh2IT7jdtJV-12e7KQ&oe=6AC1122C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIkSRHrQx6oQ7kNvwGCRVWF&_nc_oc=AdqfObK95OuEhQEvAxBs9-AAjeI0Izti94CMqeDISwAPHDc3ZpVAe19APNVWdPSJOdA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZC3LHMojtXfYstxpMieS0JQBlKfgpSj0JrX9lG3wrEA&oe=6AC101AC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlDReOBhAH0Q7kNvwHsuqVw&_nc_oc=AdraTIf-Pnq-4MZLygaDcWNVISFv2pkoBGJU1zeyzie0188u0i4xpXduTm5WV2hnTxc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPVZatOXfTU6ZUZbGp_8PU0_Nc-1a8tZi39W9Pjl8e-A&oe=6AC11A74"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hb_fbJAy6TAQ7kNvwES-UoM&_nc_oc=AdqpaQb5_pd_PZA1YHqXyGFt2N2IeqnfLV3zn8zVRTxIrAfBcSQ0n6ntYzTYMGmJfxE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJquEb1TtB4nyRNc0TPpwuV8HvFiwkfxW_hlHGDyxIhQ&oe=6AC114B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-xBZDcfMzMQ7kNvwFi86ja&_nc_oc=AdqMKwIemxi7ox_pohz-lxXJcP8SXrWahXHGu-UYJc_qFHmFdZJU27vFNU2fIy5tB24&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_tp-Ze5c1Y_18a65zY-1z6KzcUTL12TQ2NjNfumYnbQ&oe=6AC123CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
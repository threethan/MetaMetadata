oeAJoeRaltjig30CsJhx4vbEW_-67c--EzBCiYQCxHN5X3FPjXZQ9-Ka7X70&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WNsLZsyXfJjg6hEotEhbNj-QXD1nfUiGFwcXGqsQd0A&oe=6A26D2AC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8w9fEOxsy0Q7kNvwFiZM6o&_nc_oc=AdrTWLw7YpNX-D9_qX6Gb1Two5MRkRcNqm0YTVU72WcrDX_MzWZMAYR7gxNNaFB8JYI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JnUhgzlcfn6gKZ2DTwOa8-uo2Z6nTcjR1SPfbF4iM1A&oe=6A26C22C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3l0J41Cayi0Q7kNvwHBBAab&_nc_oc=AdpTS6sLhSt4HC4iC11i6sLckAc4e6D6mL6KHRFdry-iRD_sYgc10Er9vb_n217x8nA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XmTw3i9Da-UvjAZnUZDbkqQ8Uwm9fHxBnYXYOzTyuNw&oe=6A26DAF4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRlQaqNYHsgQ7kNvwH3HO7-&_nc_oc=AdqvqTTKuCHiR9fehsfZUKqj8yLxVugMfKq1kdDwmfKrPa6J71fAiROX3dd3HOHd5A4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_roso6MdQ1w83KrBPlnK1JbFPKCnKpHBQHSTmHrz1uPg&oe=6A26D536"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsUQFTDftg0Q7kNvwGUeZ2w&_nc_oc=AdpimO6re82V7M2O2-g5eXPw_sz7j3zF7BnEE12m7YB3FdsoG7ezs0oVdjM8MjMnWF8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Vl8p5kayH3IP-vHsxFAHe9pLC6ivfihtDTnzxt9q2Sw&oe=6A26E44F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
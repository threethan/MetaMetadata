KwX0yrO5isSUrG_ihhWcoeZ4ivw6CjYxfhK8zk2Z4Aszja1enaDBwLN8pzQE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4cmbQS1-iWizM1DHvgOZ840Kvc4thAPoT8W4Q4kh9zw&oe=6AA562AC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNF1m6owtgcQ7kNvwFQ9TJa&_nc_oc=AdoUYSioaTiahb3shc2UDVPv0kwc39Y05J-5GMfsO9_xjA_D33AzYJD0MjmcS85bGo8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrvKdIcRPVWvVjYyyLghhYT0mceZkIlWygg2yRWLpaOQ&oe=6AA5522C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmLULtQcc0sQ7kNvwHCOYQ-&_nc_oc=Adq8rqmPfl_ZujF9aAKSJVBiZKcN82rxYXkIlvnd8hWXuasayDGZ5KpB87YqMuYz6Ds&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwIj29_vnqac3zTe4OYs7VlTjDxV2HvVxF89pHR_ImXQ&oe=6AA56AF4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqLmqx0f_ywQ7kNvwFog15-&_nc_oc=AdqC9WlPOud8ANK3QeoZWj9-a-mrmjKr5H_NW3JYoR0g-M_T3PjO35rGMmlyMeJnafk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKok0_2bj3mibmy9tONbD6f4aBIJe_G2GTtWcZOhkDmoQ&oe=6AA56536"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gpa37XwahxMQ7kNvwHi3oRb&_nc_oc=AdpwGWettLsHG1YVLQxmBrhQ789iRYk8AKOiYmdXnAUH0glU8TXWOCX3oLnwaRg1tmo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvX4sjDEMSLqaSstU9y7RRRq4wWGLrJA0NY03pPu0Leg&oe=6AA5744F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
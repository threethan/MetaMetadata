_6yqg73pTxdO53tcH6AKgF7S2JKvBnJSXFuMajnz5EO2PS77h4TvKASZFJoA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qQWZgHpLJQ8F8InQ-MUjwK-95BV-_mbGISq9fGUeTUw&oe=6A1EE9AC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UymRiYNMCmkQ7kNvwH8mrM7&_nc_oc=AdqEdNRhko2e70xTrJzgE3Nq-WInic3REhQTj_WwjkBtK0EiDHDQHdmnVMVAq3960Fo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XJfzipAbbAughnkF4TU_9o_Z_HBbeK_8JKr4lNu4x7g&oe=6A1ED92C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTN2Q3yryoQQ7kNvwF_8aYh&_nc_oc=AdpNH2ub1Uqn_2ES7uE_ARaGUOF0Eu1SmKkAynyeQ0nZZ1efVS0QcwK2HqDttevuizY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XtZLauGk5BrDPzifwkuABYce51jdtmZXtuDgC0qnYZw&oe=6A1EF1F4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qv0BeqD-40Q7kNvwHNsYSX&_nc_oc=AdqKXHyDBun7SDVlNlnj0x4xe8cVpqixwZS_FqrUe3N-dDdVCZgcCG0OD4gywKEuksg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uEioeK8l_TLrJaCAGDcHw8qeWWAGi-r0eBwsNoF4BTw&oe=6A1EEC36"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMo8kGsIfGwQ7kNvwH864Id&_nc_oc=AdpGwWFOjtjtZc9jaHVsndH1VmIi7AKFwPzinXIKzwCpZB-95yqn1kakJ5a4PpAyJWo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6p47UGJmgS810ed0hngOFliWde1vJBy9o5BU1S-EVO2w&oe=6A1EFB4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
tfMmcmm9oYDyX8P4t6dWpmp8E8mWDbC6UY2uctf8hBVP22A7vm71R4i7H9qA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WgbcUxCyDIiAcsIo8IebIXgdFRh-g7pDW-iCd_X72Mw&oe=6A15AF2C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4ornG4m6DoQ7kNvwGFsAEU&_nc_oc=AdpowDKO5X-aQ-uvf91yDrT6Lx6tiBWZZWZSVuQQQFrABHFpmGno0XnCNDYwa_rIUHE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62zzFNmgmWenHsWMg6BMjG1LP8Uu7e9Gmrf7fHSlTNPw&oe=6A159EAC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1CLFe5eqatkQ7kNvwGD83yn&_nc_oc=Adpi621DfDz5C39NVx54BzxHsF0fIw2lXEoPX3EulsHimKZFnZgkJgYVWBYPjpHRgMY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lPfoRFABJ7Vu-lNov-xNh7lBOYNHlGEWrk4oxcdXNEA&oe=6A15B774"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crwbR5oil0MQ7kNvwF3laOm&_nc_oc=AdqSu_SX5FVnoI1Brf3pyj0Fzyu_VsUpHTLxX9wSNjIJ4rcbHz9JDH1jL7Ny_nGtNlU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Od_ZhOVA_jkc7YEiI-W76ugdz8kaxS14cDY07qhPElw&oe=6A15B1B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lE7mMvVXCY4Q7kNvwELwIOZ&_nc_oc=AdoI1agWLhvsvFrK7cyg56gmqbSFfU_iBiM3uvxaHxofZJBGSdQCADKzRnDxAfHiopw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4P2k-4E6sp6RiUg62H62N9WzgWH-1PrWcw25XRDZYIXg&oe=6A15C0CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
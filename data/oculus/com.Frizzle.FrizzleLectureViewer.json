v7yJ9bOi5LZnUttXNwwjvDy9qMhqFS5UWvnOI4xKQGo9pePkkDaJJXBbKZgg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WVKCx04EFsFgLxC-bkpI6IHg3AEM7by-rGQhWHEXG2w&oe=6A0DC62C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yjyn-h0RjpsQ7kNvwHuPJXW&_nc_oc=AdrqiK2ccxfCd2D1OgqdAx6ocWw_MfAxLB5BoExhSbF4LurtM4fz7wf29mGI-W2UzEc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ukNRyl8TuwovHJrQdZHUhAAIRTC13kyc2Wd4tIvvEbQ&oe=6A0DB5AC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wP-4i2aMoJ4Q7kNvwEntWGJ&_nc_oc=Adra6pvuLprAvZJDBndBvZ4-JYcFPYIM06ZA98IWkTo1ThRnwgoZnM_uV5Qf_Mi05Q4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Hou5BVr1RtFZiRXa1vTuT_QdBT6mGYfUG7fzucTFhhQ&oe=6A0DCE74"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MTbZZRXtEoQ7kNvwE2ov8m&_nc_oc=Adpm0z32S02pmvvTkUR6HOu6Laj6ejRZWf7o8D-07CS4Q8WKarP-hc4DDhsTgUL6-Vo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vHCjxZID6gx6kJ1HHcRXQRpPmPLPBPMilTw-Q1uyKWQ&oe=6A0DC8B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQ0oLCgyPLQQ7kNvwHO7f-C&_nc_oc=Adrkb4rEr9ke-t5NmN_5z4cmjfZiCYKVDNWFxBzr1iwCGQOBwnMqLf42NJU0h-Y36X8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OBrAVoPZkNHMnUinQaWFpWXbSfA0QHEFtHelyRqgq-g&oe=6A0D9F8F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
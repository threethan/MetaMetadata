d-5.png", "id": "480345453088120", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5f9TlDjgG9gQ7kNvwGe-f3C&_nc_oc=Adq-gDAn4SygtwEA31hSj8u6AABIH6Qgj0W1j4zQ4Zvmu7uaIp0C6rdYj5vEKXLtLKg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTT6mZ7Qqmc5_ShRnpnm85DB4LfwfHGnUEMXqKqHX1DKQ&oe=6B05A874"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpE_Qaf0cDYQ7kNvwEu17oM&_nc_oc=AdqaoPT5hBSiN4qg8A4X18DGh4Ahk4-KMYB0sUk86zKcKkSLuS8NpSs_OodEJqo_6oI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsmS477zqYrCkEVZo3U3h-cNjn4bkfv5hgTx0cMxq92g&oe=6B05A2B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "devel
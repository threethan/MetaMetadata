6Bk7Cg4Dx2LPeTyhMDOUaCf0Z5ICZ9wbMyphfM6v_SOQX3bU4-WFBj35c9NE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwLwUj3ZkOo8GuPkgQ-vI4a6FN8kXTKIg2sC36qOjqSUA&oe=69CD2CAC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rR2SRptf20Q7kNvwHmfNqw&_nc_oc=AdrjR_2sivPl2kavwIYLY6Ye6lRoiZqQ_DOj4i2v11oPCj-vcMhfJurgBDPKqOYliDo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyMXa4mfIgd1c0R-jHwEbn_gSwczMpZNzjQVP77nw8HHA&oe=69CD1C2C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fR67eu74IOsQ7kNvwFrYnhS&_nc_oc=AdqgcaylrZc3_Fvt1Tgx0JYdQ8txHrlOoLGJyNY5ca0uQbz2K4TXKBXCFnFvYtDOJJw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfydXFs63YcKQR8aya7YyuLAuqEQaCwrdhhcABV9n49hFw&oe=69CCFCB4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zofYfiuk10Q7kNvwGehsl7&_nc_oc=AdoOhbkor4q00gOBAX26v0xxRkbfNNwAeWE4UIJVlsicxx5FwxpRhB7JknD8WUEeoqM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwQcZZXgO6Iln0rL1lO1ntV_CImR8f1OE1gzT9ezVjXiQ&oe=69CCF6F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BCZBn6wwoQQ7kNvwG6k8Ff&_nc_oc=AdrTzjOA1iIFCCkGHgrX5YG7coTpe25PKRGNuBAzXTFdOsHlUVN-hWYebL4nJ764cC0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyE4NyClwbrNPdMEV2eMwFqrLHrcJ6KSb4SkDnU6bqlRQ&oe=69CD060F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
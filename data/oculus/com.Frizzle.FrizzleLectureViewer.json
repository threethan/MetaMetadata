content-atl3-1.oculuscdn.com&oh=00_Af35ZXDVfsB63Rv6fXiqBMBRSLIF0PR1ggFTVzzWw4rwoA&oe=69F216AC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EV5gq6SjpUYQ7kNvwHHKC4Y&_nc_oc=AdpE4Gfn9hKKF38Tk9ja0ul3RdkUqkihgki1Ii2nr9DezoAcND8lUKMBliVu5oRvXNM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1deLkbETHNyo115sx2stbyIbu3E0hygYVznZpl2k0xMQ&oe=69F2062C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1F2xAitcXQQ7kNvwGesa_Z&_nc_oc=AdoCpmGuV1q1hc8A_XvZumtCqf_aJA9wAwh2WeIn4UggjNwiYt-uOAYVFYqh95cjqO4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1cVS6iADWX_fx4ZBBIn-Syhnf-oVymbi1RraDW_Hl4aw&oe=69F1E6B4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYIT2kFyWC0Q7kNvwH-pfnT&_nc_oc=AdrAwE9hNO5KuQ5_ZlED8XKO2AmJmkha-uvPZ-VlxQpQOyvPqpM4PCm8fucQ1Gp3gec&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2-YjSiiqQuPdNYn8TroYqnmIONIlFv02c0RP0_x38HCQ&oe=69F21936"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SENm1KYcs98Q7kNvwF4BtHf&_nc_oc=AdqUnzoveIK1oO4U4V8WYwt7uFaW6Jsq8h_mvDhCyqFDSIsuk6Xqkd-E6XjrbKogSvg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1OyG1PDZELYZx4PYP9I7EnBNgsLfl06nW9FGG9hpbCjw&oe=69F1F00F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Frizzle Lecture Viewer", "platform": "ANDROID_6DOF", "context_category": {"context_category":
om&oh=00_AfvNRkTrF7OwA-LcAgUAVUEdxLePHG9bjJqbVr2B1eDLEQ&oe=699B13AC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGa2ii3ybGoQ7kNvwEw6qrx&_nc_oc=AdnnMfInYgL2GCdT327urHWkS-xIb4wrTw4V9EuB3umypBjqOi-BqvPyEVJivQRSeTY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvvmge00gF6b6iM5ur5fJ7tkE4tCcGi3VnjshfGrGg-lQ&oe=699B032C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWhhJtqcO0QQ7kNvwEDoPD9&_nc_oc=Adm7x1V7HYNu_w29sct6UlImPGKDerocua1eWZJ3UPJwMb1hgYs4dZHGWHToZm_Zr9Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftT5TokJNGr_crYaDiFQuswBFaLqsbisvSK6Ho2w8HRyw&oe=699AE3B4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyCkXExRgkcQ7kNvwG3MXIu&_nc_oc=AdknqlZcRKBxerEkjZAl3t7wxfcK2rcIb0hDG_Z3MIuCkN45g18JucUaRe2u5ICdwfM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftRfWcLvj1YjihUfx06AxSFqeTRPCg4FCScaGOcVyxjdA&oe=699B1636"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8nKwTI8pwkQ7kNvwGKygUI&_nc_oc=Adm-oLLGIPa7pB69BMP9_4Usfbkhc_yp6sjDdEr4oFXy_MJhhScWfYe2VXiH49WOe9w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftTAhhvx_QFoHD0L2pnU-a50IsRfkS1ybljezcQKQxEHA&oe=699AED0F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Frizzle Lecture Viewer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics":
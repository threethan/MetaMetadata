}]}, "id": "529731165078104", "locale": "en_US", "screenshots": [{"file_name": "Untitled-1.png", "id": "1440312639635006", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003228_1440312642968339_2789643189716025521_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKRIrkw7gswQ7kNvwER-5Yn&_nc_oc=AdrjS8kljD9ULXD3y3M0yZ_S_DpHB5BGA-VxlpgvEhLME7qxysoHEyhEJpW422DCZU8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ubEwEBQBSJ2CHZD1RxvU4d7DGOAt6w7VYKP3EQ2vESg&oe=69E0EE6A"}, {"file_name": "Untitled-4.png", "id": "437567900675752", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031645_437567904009085_6070206936841904870_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2x6gEAAGeHMQ7kNvwFHSZBI&_nc_oc=AdoIdJSH3ke6Xjm1Ay9AsdO-YUE8FMPdApcrxYno1I6iHg84SHuTEXvSVo963YSQnEY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WYjzEkvBktLja5ckktIjulcRq1dPNDVNCilexwwCuCg&oe=69E0F32C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lUx-K7NVcYQ7kNvwHqhk36&_nc_oc=AdrPrx5auVZx5AUegoMalMjopbJ1cSLw6CkOGzcIRCxtG_apNUJUKBixbXJPmzDgODI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0iZj21BTsdaax5BkRTRwkZt0B-A56NldzNKn1RtWbIlg&oe=69E0E2AC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxcEtRBW4LEQ7kNvwFDpZTb&_nc_oc=AdqRfmOLyCTrbfiUVckppykb4iPWbu5ibgg1svoLtj4KVbj3eq4WrYaRopzdJgr72cQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mRzV4i07bgcOjAUsFtgEWlQrdmxuvUkFC9OHAeSKbSQ&oe=69E0FB74"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQ2V-P_QyEgQ7kNvwGJtksg&_nc_oc=Ado6fnPxpFiuFHRunbpwcObl0ioELaa8MoBEZXauTzx_Zy4fx_mOyktLQf4RtFxUwKA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06Je9CZXm91pixG2L5B-ymPrkhTn7B8yRo242rZ00zbw&oe=69E0F5B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
}]}, "id": "529731165078104", "locale": "en_US", "screenshots": [{"file_name": "Untitled-1.png", "id": "1440312639635006", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39003228_1440312642968339_2789643189716025521_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3E230dLoeUQ7kNvwEPlSrp&_nc_oc=AdqiZ_C7U-8tytXLGTVGLv_ip4QMBdwlyoLDdomYJEaOL3oUXCKX6EiJWk1bCEleRcM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRJgDFTnwqZnJHwgMXnL4InOqTr5c7cqadTxSjolr8Gg&oe=6AB6816A"}, {"file_name": "Untitled-4.png", "id": "437567900675752", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031645_437567904009085_6070206936841904870_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEhvfgG-X8IQ7kNvwGSehI9&_nc_oc=Adr0FAsoKBrlxpHrt_y0EjvtKL-_Z0UYopvkjWzaWeSuu8j18-3hKCb9bFiq0X-QZD8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoTzE_pyvku5mF0364gCbssxx9pxM3ERYNF8RXk9Xl8Q&oe=6AB6862C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilWxvYCx4VcQ7kNvwGMLpVe&_nc_oc=AdpO7hdpfPcgZK9GBhu3s1ZDeFACxysNhw-KvbUohczCfEPUtWElQIwt38l9j4fsERM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwg3fWr3w15hpu_1ZCXFPZgsXWEqw_9CZb9BtdDlOCHg&oe=6AB675AC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cbyyA7VJmFMQ7kNvwFgbHUx&_nc_oc=AdphxGptG7y77Xah6o8OVrj16wjQhqErJ8E0KVmk0VBut0XqMju7wn-z1zXfCcK0WsE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkO5QuCLe4G_xWYaQ1RvX4bpHd7bEcXXkcKm6V1IwK7g&oe=6AB68E74"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2K-i4IqaF9YQ7kNvwFLtdP9&_nc_oc=AdpFTzz4se_nC5uaxMzOcVXflxyVnoai7bqNDXHkKjY42UTlaSs_r_Kcyx4i03TV2gQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVi2FLEaZwAxgBzIyYLVI3JmBUukFAHa0UDfzpMFaQ6w&oe=6AB688B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
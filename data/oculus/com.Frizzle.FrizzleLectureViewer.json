POeItBHZgG2yD7WJ2Y7BJ8ofHu8J13zoSDSHi245sJHRDHaZWG4bqs5cOCdk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCom0Uh1LOCLJfTIFH00mK5e8RL-z-TE13YvqZ-MCTCg&oe=6A788FAC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W53Ov34Lg1IQ7kNvwH-pt4Z&_nc_oc=AdrW71kT73FlPr2yLEbiQmSwIsEsM5dzFcc-x538wSThXkTk7sLRUwJ3Wd35trCA_PY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4w9cp5olBi0G5Dto_1wGxUFrDUdFcagNli6s0poBkEw&oe=6A787F2C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h00u2bWTIREQ7kNvwFycIWd&_nc_oc=AdqCbHlBWrdCqC17MUNUz_X5OlIeyeeHz9KVOPNEtWfsUqHTSnI938n3Mir6_Nus1mE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4DnjdbA6DhmC61r75PpymS3GRBbc-LnRxgSeOqbAYHw&oe=6A785FB4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6alyRJSTbT8Q7kNvwG8WOHf&_nc_oc=AdogRThhiOO7k5c76wX8rHQPOaeMf2WtsYVuYAb5P9r1EFG8WZBqSFpCRLWaB9fqydM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdtipsmJj42YXq5SnCGUvhgHcz1A2jdpo9p_o3rV-0lw&oe=6A789236"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vFW0vdSF3kQ7kNvwHi0h8k&_nc_oc=AdqlZ3aZqhNZDhvl8gCJ0c6TN9k-OshuxbZymzvjI7T8pxvT44gPUL6XVZ9onrrlyws&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3pSt5C2kZuGtBh_wXKHvp0sNM33UStiMkPSgn9e9BDA&oe=6A78690F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
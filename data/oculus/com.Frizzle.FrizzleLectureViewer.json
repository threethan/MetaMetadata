rUvXEnmXFJjcDa07HDTGom8iRoUBjn0iio2uC9A1cFxj2_8Bth8vJfTVTExU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmi8cdgn5hHMYuA7KKum5IEuE5g0Qekt6o_BdJoRbJtg&oe=6AEF36AC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76K0dyPLFWoQ7kNvwGJ9nSj&_nc_oc=AdrOTnJWb0h5nVI4WFa2AWNoSBidq0aEPuv3u0DBIxaaqohN1oSx3S4ohCfR2HtGyZo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzTW0yjnUWzqIu1qNe39afPgouiw_QNwCWRkLBS63v0Q&oe=6AEF5E6C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpOUGVFHShEQ7kNvwHr35eM&_nc_oc=Adp1r9hka4Klb82YHTbNTb0gHh-_3AzXwz5Zjl7ItLsZzHXH_KiYiunuJaJhbU7yTds&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBdsh_aB1bzrVyrd_qEZRFzWNt7o4x0DOCpBSC0v5Ftg&oe=6AEF3EF4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poXv_xn15AAQ7kNvwFKsysx&_nc_oc=AdpVp4mzocGXs2abQJ9mCuVT3sO9ty-zF4rG31fu00dkFYuAM_EaiuUwlB5wRalcGdY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZ1P9brbaObHIiZJRSICmUXE-WiEMnqfypeoc8kaoL3g&oe=6AEF3936"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnHi2abjPjQQ7kNvwFLZrb_&_nc_oc=AdqdvKpnxu9mjZsG4akHG7Kx2hbIrP6rD1DMa3zOR8anyHMBL8J07mZFqP7d-QH8voE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-ILzcW9AJeQWKxrXJhckA1rGjhHv8tcbY6sMTWP_MBw&oe=6AEF484F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
jhS3ZBdw1Gx3Dxlht4WKlkl7oL2w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyeOfi1CyCdRt4TblFQq-yD4rZB-wA1VjEjbg6_tmDpCg&oe=69BEAC2C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGzachJJab8Q7kNvwHvKnDZ&_nc_oc=AdmYNs273C4u2oy-LcboAccQt5gfrKwrXwqI5P_KTPDVweWmV9UW4NEhv73n_Iu-ZU0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZjvDDxfns_bNSZir3M9eVTNzHzbfofLJUbKV21hOl8w&oe=69BE9BAC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEIsTImC89YQ7kNvwFiIjKV&_nc_oc=AdkTRwy3KfkPMOKCPotPv-jJTX8KtbrHu_WMZoFaMI3-wuWnwJrbuDoVO_N6jgZLDV8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzgOOEmQBTBlnyza1hFpoLJSRa0G3dSrocNiw5tyh5Y0Q&oe=69BE7C34"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2_eokQwJQ8Q7kNvwF9qkfV&_nc_oc=Adl1X8HwQUba-IgsL_1YDxVfslF2Cias8POdrTs7LFmDCti2wWsWBJsFmpibWq6N6fU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfznaBN9cXGfvMBK85KcLFX-PN9Mot1xNUliLWhYmoDzqQ&oe=69BE7676"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RV6LH2ivf8QQ7kNvwFMX28b&_nc_oc=AdmndMTQKPAfdCl4cPivStigK6P0Qy5-ju1SRTCaUG-bxG0ev3QRPnWwzC4gkt9mGDw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBaf1z0ctmveRLHtAydiHlA2QTOV2hN9oDvIFErk5DrQ&oe=69BE858F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Frizzle Lecture Viewer", "pl
}]}, "id": "529731165078104", "locale": "en_US", "screenshots": [{"file_name": "Untitled-1.png", "id": "1440312639635006", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003228_1440312642968339_2789643189716025521_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEA7Z6nqH7oQ7kNvwF68kIF&_nc_oc=AdoQKpWpHHX9jC4MGgNENJx46sqBccF9XcoE3RnSq0ESBkMhQkukuOrkaqfSvT6pAAQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XNijajiNRuREz7pyikaRE7y3xycfgmJUrN0XwTXJaCA&oe=6A1C41EA"}, {"file_name": "Untitled-4.png", "id": "437567900675752", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031645_437567904009085_6070206936841904870_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFHqkfrNY0EQ7kNvwHerXkL&_nc_oc=AdoArfbniPsgLp9FfrfKf_LXGZ8dpy0jX41znRrUNUVHy71b1JdOBoNlvZ_-6SooXnU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IebU4ozFUCaRAll73dCs0xHjzG_h4NZPN4jq4gzJGYg&oe=6A1C46AC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vb3QuWla5rgQ7kNvwHxTe7r&_nc_oc=AdqsxgkON-Lg0yZE9STXfIukrAEYDF09yrYyME2wLg0aJ3zoZ759aNFdsHOLHRMXqO8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KakLQ6qyE59re4_qPBXmObPPqdxmufciq0RFowQ0eJg&oe=6A1C362C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnErbl_5zmMQ7kNvwH7_fuW&_nc_oc=AdpVi36jEE_11cOBV8LyDadGUwqv81qPJOZp93qY5D78ukJpDJNED4XW7D7XPL919dg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QIjuDp9_VOvoKyJXgYCPUKExMMoWVDYjGiCXSRZqfOQ&oe=6A1C4EF4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1FozxrtdQEQ7kNvwHW3gFd&_nc_oc=Adof-lyEOmoAiPoWI78hgg_ATlomJYmh_p_pGFbmheHr7DORcaBas9cLJ4TXpwvSPbE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6X4ob4HI7DWGwJDdrt-BbNQVGirzuvT-mn7UT521Z8oA&oe=6A1C4936"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
om&oh=00_Af39kbpXSzOdicG9_rIApW7OIKuTzKQttinwloi4FJ_D5g&oe=69F0C52C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EV5gq6SjpUYQ7kNvwF1zUdN&_nc_oc=AdrMNkmLauBJLSzErhtyweuj8bYRzKrEEzWt8ok-sa-7oF8eEUI2CMkdOYbDC-NWHcU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af373ZbtmWLvq10ZBFvDnhYBJHvyz8oeoBn9Q7FYNufpig&oe=69F0B4AC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1F2xAitcXQQ7kNvwG1fyvk&_nc_oc=AdoxvrL6Gff8Ayzo3EQW8ORx_9WMU4P_yL6fe1r4LvEpV0iKhtqkeUXl2BUHhBoHTeY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0JHhh1nVFgjHNWHKdeO3-AHrsY2YoxWnaH0XUeBUaCJA&oe=69F0CD74"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYIT2kFyWC0Q7kNvwHqpPtr&_nc_oc=AdrLR6aIbak9F11d3PZlnIIzXBd2OQzy1Jtd-O1F22kUJHi18zYQc5MeGI8ZwzRr1a4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0YwHwD4a1MfSXoaCjpXNTD0acr4NP4o84zkZ7iPliepw&oe=69F0C7B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SENm1KYcs98Q7kNvwE_Xb5p&_nc_oc=AdoEdMxvonaZIC2Ifd3CpFfQfhxA4nwJjwogCdiSUdl3fQIDwTK9q4_93yJkj6nIHZY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0O_hokSkA4mSOPWvEacZUoy11qBInsTbex7ElqZnIelQ&oe=69F09E8F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Frizzle Lecture Viewer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics":
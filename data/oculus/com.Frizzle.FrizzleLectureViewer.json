cdgeihFQ2bFgf87d_pebJWVKQHMOPVrzYMZT8KqW7tR52rtYefixfXMNWcyE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjpfu4-td8DCF3jFWjBUenQDbARSb7S90Uv6EhSXjg8Q&oe=6A986BEC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwF-KKPoPNUQ7kNvwE6Wmgi&_nc_oc=AdqDoSntOCOoOAYuGJdMCDwwENL8OFbb-eHYJzIDr86dRQxYRsyat_8z8MKiPBhRjmg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaZXJaEtso5g3HmOm3uiSLOX8MrBgTA5nNIgJp_lTxNQ&oe=6A985B6C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKdk6se5BgYQ7kNvwEfY7KN&_nc_oc=AdprMdTE1-H6pFFAoqNGK2VWi5w-Uotw2wPpbBdfps_qsd8j-qMTVj7-iFyUy_AMMbw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQoYZM8sfvuYP7rUP7Nxq41fBnMUOf9pTWIMnZ3Smi1A&oe=6A983BF4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyxIPcu7Tn0Q7kNvwFyD20S&_nc_oc=Ado_jDbYWdos0riDLze2sdFI-EoRqqwV9fdPl7mtrJUIIWVnl6PxUlIWoXWjstPiNm4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNYRnTNLH4P8a1sit101nxW_xGU8HVFuMMnRUGppYRBg&oe=6A983636"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RbVIxb7Ma3sQ7kNvwEKkgpI&_nc_oc=AdqWcnFBUpPtxGORuenDlgp-ms1gk5IbKFO2tU3z5R-9sVDK5tA1blq2lX5KPp98VGI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfxKiHWUbhftMpwz3SwtKxmoGHcAJu8zIeq2GFTcOp_Q&oe=6A98454F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
oexIfmw3NUo-VoPlO1_kQ6_Tjdp1SNM17TVhmSsLOs57O1_L_qHXQBdKR3AA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFFU_5tG7Ew8lr7zdv9IimZ4pAFMDkv-QEPOeuJj9WMQ&oe=6AB534AC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilWxvYCx4VcQ7kNvwGh1OEc&_nc_oc=AdrgT8xR2vTVozrPGp8Dgh6_TI8WSNmtLLiMgbOqjLxgIAteHHU70-iqfUZPwIzvtqQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKY1n3I4XpMgc_fgwczitF2VBcGTx9Mv1XCzF8rxxib3w&oe=6AB5242C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cbyyA7VJmFMQ7kNvwFr2hM0&_nc_oc=AdrLzcZrnC8hmRS-q9u9Ou6GWn1cjBhqikls5R5DpI51ZFhjy8SuqF9uOiDEix5cjlU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmIotxS4pGHz8glbbyaM7iw7-zdX9QrHxy6ySmQTDApA&oe=6AB53CF4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2K-i4IqaF9YQ7kNvwHzjMvi&_nc_oc=AdpA9qgRaSouvzC2OzJ0Ew8bj0rZS5p1elZS1RLiANGBv0oKANj4YR8ItrIwj7vrTzs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyURAnfCP0iaSGv1pB6pR6eJKXZBsmsNWr_WocH-0_hA&oe=6AB53736"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULbtrUhlFPUQ7kNvwF2LRu4&_nc_oc=AdopXY8zL91kBF5vxs_vJGkhmHvFJ_PRjPX3qnq6TsplcG7OQdZv1K_YvPUw-p5lBbQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKykAugBZ-1Mum57pglqBJ53Fwvzg6-h-jm4VhstUHGZA&oe=6AB5464F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
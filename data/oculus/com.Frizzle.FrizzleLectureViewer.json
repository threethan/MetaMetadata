uUe6z_Dyg_aHaY_TUyuht89GCo5wax3oqjPhJOeSZUazcgkshKo55Q0NztoQ5c&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9HZivuxwL4fa4f2w_tJnUW711EIzKQkhigAjZyKbX_A&oe=6AA4112C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0_9v_rSJjcQ7kNvwFcRLyN&_nc_oc=AdqiarwN5EqcA_zXD1j1VKpQMOt7Fh5V1RvahLrzodpyBvFaRN_dlgW_jHP9R7AY7T8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4wGXJSOHmEPi4irOLF5BuEgCHzmeqY_gcs-wdx7EUGA&oe=6AA400AC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saURI9lT9r4Q7kNvwG04MzV&_nc_oc=AdquSgxDoYZT1qM_3mCdXHe0o4tpENy9StF0iHo4N3cTCHYTYZEwnpsN681C09A5wX4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkY1Grp7EBEwbfa1syeXkh_jyAJ-KHiM7YZMzbc0bIkw&oe=6AA41974"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGUTAqvX0icQ7kNvwEVqylr&_nc_oc=AdrdqsJPFl-WPmbQTinNqL932elGrk5r6lWlFuA5IqiBJMzggiNNLhh1xWz582d3oGw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1DK3bhJpyt5cQVWWusVvXRZNUU0I2JrA5rsHAakaqHQ&oe=6AA413B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gpa37XwahxMQ7kNvwEU8nlm&_nc_oc=Adqp15SE9hz4gm7EAkoS9DK1ok1o3TXU8iqb7YlZnh2joLegoH7VrBuqgQpPqu10dII&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7-WOgbP4_kHHY6xsrUV7iCCy_xm0hwwT6KBwIkVE4rA&oe=6AA422CF"}, "is_concept": false, "is_test": false, "is_trial_offer_vali
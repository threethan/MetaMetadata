2S_w7bFMuY4cNevTMN6H6jRzXozSj_COySe64MjMsMED7exocLuCoMSDKEig&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-qNtcjDNGZmbnXTwCRVYwasqM0bNHMPr9WoFUHuDlCg&oe=6A300D2C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vsHzOUB6pEQ7kNvwEUVXje&_nc_oc=Adp2mpzRi-ZIzu9sxeKqRF1Za0a6TfXwvpfTK1U1ZgqjH35WJJ9eV4Zb85jTCVkt43s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bplPAYAAKOZjpdocp6_3EI_Oznq7TKXb0OJmk77urSA&oe=6A2FFCAC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1YfIukm1nwQ7kNvwEACJ_n&_nc_oc=AdqzHAIFQH0pgsYoRK2F8kCpcCVT4_5a2qUPefkevbK9MSt3PXwS5I7cqYXDN4xX_Yk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jgoWi4zkTBVk70lyblVd8S2d4O7kgnRz4uoXVd3kEMA&oe=6A301574"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVq2B-zr41gQ7kNvwG3Fe8u&_nc_oc=Ado99JVWrMZsKISuyF9mcQVKWsidgVb2ku4q8b6kI5AMXP23nHmdqV0JL3S47HIxdls&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-prEFNerwPsipBvnm_15OTNOOEb7LC0x-0-V6saKF4bw&oe=6A300FB6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LC2kzavwrYQ7kNvwG54IhO&_nc_oc=Adpe39CzncChl1vrPJ3HAR3KsEkFtFhZuZwCaiAR0IDsTklbzrzp9EYsyhXzuYkVmLs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8Rkol_EoY9rUVX4PBmAGGXJZ_cXX_mvkx6E5-BNU32w&oe=6A301ECF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
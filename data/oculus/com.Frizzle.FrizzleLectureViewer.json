PBwHdsmtESua5cdJkvcTaroWvLfXL5W87nSTWNxGpcrfqTKvjBzYUkygBPaw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mR0QM_3-SKeqKG1cMoR2tDDcRnkm2vCVbZjRa7WSYIQ&oe=6A048BAC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6EH1z_5CYUQ7kNvwE-x8cl&_nc_oc=Ado96Pi_uWbHpZbvljvcqtLenS7tUh6udo6OdqW8S3cnPQdiDM2CbC4sjw8ewnKk4Ws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Aif8TM53mB1YFeLGEoZe7JzfjS795wJBAVvAnF6iEtg&oe=6A047B2C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vS0X-TbHG7EQ7kNvwHIZcLP&_nc_oc=AdpPFNy4CyuSFNFT4ZQ6FEa6DfFYR73cWy-hBeoB1KlQbG4cInmz9k_deNckCWYeLdk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OzjeabjE_Tru1caJe7w0sMlpD2yzCpdcBvK-0yURgqQ&oe=6A0493F4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVNHXDvbOaoQ7kNvwHCk_Dk&_nc_oc=AdpLd97mzUhUadHWm5W9Qo28BYf3EqKSOONGWHkfwuf4Shki9gB_tSF7TsQcvN3mnEE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5q5Lha82JPyy4wvvdYFoa9sF56WZMkq2IFzcKYuFDQOg&oe=6A048E36"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNpOq_rt2bkQ7kNvwGbdYTi&_nc_oc=AdonBudFFa6jIQGTgyGe3zbZJtykRFGSm5J1wSjl7oqJQpmm6HxdhTcjh5nOuI0CSZA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55ENw-Fwxtgmmc8cpY__cYyxfu3l1Pe_YZXF_migZCbg&oe=6A04650F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
kxvSqbAPo8_7iu6oSE02_dWalPoD1b-2i4oXIpogO5ZLcfzgVuyeAXdAdX20&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VLOghm3jXF4rZ2Iz6J_quZzYnaU5Xsu_tpLPfMjBVvg&oe=6A0F17AC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ecf5f92mdkQ7kNvwFu97E-&_nc_oc=AdpbqzSdUKAuHEH3v3VuSLqnyv8_iiPZGklMU7F9IVewRLR3kujRafWwO3FEtcsDziM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VQ1xq7R-dJj2VX9iqHF5x1nwdtENWHoYuioMKzjnIHA&oe=6A0F072C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJOTU1IGyWsQ7kNvwGWrjM0&_nc_oc=AdpHmUKJ9BlsPodmvM-mPtcx_-fgN0DbmeooeGytp1bsPhff5os1GJTNzy2Ut2T_FE0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QCh1U9t2fAaOku64-9oorEJfEtQBA6m7iHavl6l6Ibw&oe=6A0F1FF4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rR-K69eL1d8Q7kNvwHdeM5X&_nc_oc=AdpdAKkWM4DotjuaFq2CeZ0SPS-gYPP9B6w_QOVYoohcKWgqa0LCwc1Ln0uVKc3MAUc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sERlstHdFvfnsjn2wsvqyfXK2wBoW6MRCC1g9SUF3_g&oe=6A0F1A36"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQ0oLCgyPLQQ7kNvwFdl3XE&_nc_oc=AdpoLOm1CN1sQp1fB6BjcYbdOgQ4N-Q6ueOcupFNz8fbbHNGsvvLJf-yeNjXQTWbbF0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bfYpHwohuEFdAgWxHK31STrVr--2snqZXOn-AtuEZXg&oe=6A0F294F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
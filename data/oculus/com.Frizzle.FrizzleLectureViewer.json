7567900675752", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031645_437567904009085_6070206936841904870_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZCP5ij1MeEQ7kNvwGJSoCj&_nc_oc=AdrHec39VWPS4ic9s8V-evXgz3A7vShqeYtIIAayLue_t_Hs_IeGunfYduX8pgytAbw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTj1aZnwz2Ia3AfRREq-axLd1FVnEudoPAedv2wbSNxdw&oe=6B0B1E6C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnRNVTNDIkwQ7kNvwEfFe5H&_nc_oc=AdpZvHgn_UZ_BjIK7fdodAeJZHoh0vQXqNe73ULFancytXjYfG_IUF0G9ki-TK9LWEg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS-4auPMvnfjQiR-MlRMQZR-_dd9ih0nt7u6d__q3_vUw&oe=6B0B0DEC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7b8YBietH8Q7kNvwFob-ey&_nc_oc=Ado0C25ZTM5-KTIzTjGdUCQ2aHpNIWfFNuuk3HY4xzgbc413_TLEFfiwwZqX7RgEA6s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR5y7cb3g7x7RWESknv2xALaWyT68ahNXQQ0tS0hvj0BA&oe=6B0B26B4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lj3BT9_pM4cQ7kNvwHH_oxZ&_nc_oc=Adqb8jVLCd4AP_ykRVbMv1QqJVmyTVAcFUip5IpxXVuYoMGxcR0fOAtwm7ws4ZdF7wA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRtNBHd6j856fb_inLOVZIsFkPFe09RsepQqyAf6BZwww&oe=6B0B20F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=
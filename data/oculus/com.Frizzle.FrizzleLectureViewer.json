y_JxGR-V3MWPRBXnvo7U2TnoB9VHCiInVNfNknIzHAZfNWduzMxthC7sVS7M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10yIQLw8fX6vmG0C3E5PGQP-cAq9vQbfIS0TQV_7l0eQ&oe=69E78AAC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iB0ewVok4CEQ7kNvwEOPrmh&_nc_oc=AdpM-MKAP7y8ww0pUxpL_Vt4h6ea_YBT8TfUj-H64RpByNPDnvwapbVVL2ZfdjAHmHA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DT8wMZIz3Jo6Fe_ZispKI_iCN8OakOE9hEujFFmjPBQ&oe=69E77A2C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odJ2tU37Fb0Q7kNvwGWmZdQ&_nc_oc=AdqFHhfmcfeg49fbahIrbHNezQrjBztPpbOVUfuWiXB8G_cSj_oX3aCxffaDkJAkTwY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3emnCWZc5bWH8jwx3oDiteTEmKiTLgqsDy7Ea_PAR-7g&oe=69E75AB4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yD4R-8Wb_O8Q7kNvwFyOAvU&_nc_oc=AdqemhiVR1Pia3GDr6uscuXmqTMvOrQijjQiahfroOmugckmmTDka9kQe86S2PPfMIU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mfbysab4C8DKs56jg6hr2ic2rL9KAbJ8Hz4FCwbgYNA&oe=69E78D36"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Y7ZGuZSMLgQ7kNvwH58rEj&_nc_oc=AdpoFzDZ5CDMBAP_3wVqcKf_PxsPVeZPq1Mb8BYyXflpDdUHzeOsvluw_OLVrEvThB8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11wXRBrWZNsSJ0DBDDb_zex-TLk0b4-8mM_OYCNTIsIQ&oe=69E7640F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
Qju1FvjxBj6XwXWTEkNIIxtNBLqDgwwXZh0tdElvWHOt2HC7WEaIsXZEKbsE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3rtBizcwb9fJqOqSWuWlGaFpQeVFRH77-8Y9agXlNKzw&oe=69F60B2C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GpADUBwsQY4Q7kNvwF6SCfW&_nc_oc=AdotX4NeS7oCaxsV1XFV8Wx90oqulb4azmHl7fRP91gtcCovClNjKi-MgfVsHPktJKI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af17kSQkHl95op0hpKA-0lAnlDwQOFzo140NSK2Wp1RY5A&oe=69F5FAAC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uo08araSumsQ7kNvwGc55fw&_nc_oc=Adpve1SqEuKrl-a-XT0r3H2YF0vabe9u8NmoydAmKqAxYFWbmdik9aDvo7j7wEILdHI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2DMGj26zaOwmXLCBmyDr3Lxk6i9osfi4cBmqD20FTpFA&oe=69F61374"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1PM0kxn38tQQ7kNvwGYESGi&_nc_oc=AdolhfTX9Vuz9Ak3d8lCNOkzHYNZXp5CLzbtNxi1LgfqkN4d-YkjH6CHtgvNSkJmLh8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0y5j2nf0IznGaqa3NndxbFBCfL7bihTgcZVTUlpnQepw&oe=69F60DB6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghev6Ddrh-4Q7kNvwG13m5J&_nc_oc=AdqlzlPH9xhC9f72fmig0UrPQ9w8RZy2yrNgSM0Ay0Ad6VTiJOc_c9qvStP3pQRO8j0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Ov1kcHtYloDevQ6K7t6mElZaKU845-MI4ZMSyvdV7xQ&oe=69F5E48F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
8XIZ8LLyDXOi0uPOhTHIiAWAoe6KCjY9Wj6jWmN5Fcx8h9kShDiqKt8xZ5gc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GGtC_iX9q4V-wtpne3Hf1sKh_DUc8DfM6RK78JJFP_Q&oe=6A3D3C2C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhZaIp_c804Q7kNvwGAgK63&_nc_oc=AdocqmXa7Xve-4oIk4nPfjrifqecrg32XkWICNXhN2LMSq9M6CS44qNBohbyskNaxeM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7o8zomfIc_p9ETGPHWeAd4ivFKs32MDYlCWcJYv95-A&oe=6A3D2BAC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bd5qWNPqcoQ7kNvwHPKd0U&_nc_oc=AdoXolTYCgjeCiOchUp05D6GlZ0QHP4GFgYTD1U1od2miscD4ftBcjVktv0vhG43UVk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MR6vB1HwBl8W7RBwGh0UkgJolR1ew9zuqqofmAvkuQw&oe=6A3D4474"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wUM1mvz3csQ7kNvwHVYvL4&_nc_oc=AdqgpHeOkRiDzaqJaR9xc-r7wCXRtDBoo88KCQdtHBVDWUmLwq-QYI3KuH0Rj6ZRMB8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_na-GPoXexIXy194zAWysZgssS1miHe7pIZjrp6K4d7A&oe=6A3D3EB6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_h-7TkxjMwQ7kNvwFe6IR7&_nc_oc=AdqI9cSlf4ZuAH1QJKs4npH797wnAzOqWlrmgYAn_2N8jH2mJ50zS-JkwhpPX2njjy0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MYmI9pWKfz68C0JPmZ5uFXlGNGZzrFODm2KegWhXObA&oe=6A3D4DCF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
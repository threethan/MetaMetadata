wL3VThTtxwlc6-COhuHRMkk47bTeLbir5-3RubDaVd0ledd8EQR80VWfnrUs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGiLJxyjDvpgpDVZgvBeZMbhLOIKgrTgPDw0FkzzvO9Q&oe=6A4A6B2C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KdCCtS8N4ggQ7kNvwG1R7b8&_nc_oc=Adp9ohX2ppAdyxzDWlYPOdoW6ByTXLJ4R607hCNkxeY9wW_PLASJqLvqD04q6y8rydA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOCHL5HPPR1mhdgmNPp8QX7v_4I4RJycRDGkwPbq5Rjw&oe=6A4A5AAC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KN15mWocHIUQ7kNvwFvd7wL&_nc_oc=AdpvUs3B6v1olecoVd-M6bqVWLuZslcqydg9_OCTpXnqSwSF7CKXE414DXDSR9VnIl0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC54-BuK_BEI5TGS_vc05yKnDhnlXbLE0xoBrZAZuzntw&oe=6A4A7374"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3omuNi_tnEQ7kNvwEhbESO&_nc_oc=AdrmtPhYIbu8hVVl6oX2Y4tNthysg_R_-7uQkygP_8P3VFZF4tgzxmyQOrw2SkQ37gY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPxmi7b8vLboWkZRDv2YBLfTLK3jkXVfUAOyrXpXnQ5g&oe=6A4A6DB6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldLcCmic2kkQ7kNvwH0UkEd&_nc_oc=AdpRkB2FfL5EZqiu40ANVpqDUseXqRj8K-SFgb56vgE2i8thlOl0MdtnULQYo9uu_dQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsdyt-B2A96jvp-AdvR5WDBhjMDx9y3ktRJtgGKW7AWQ&oe=6A4A7CCF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
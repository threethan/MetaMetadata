cqw2xNUi5TBYtpVGZrghOGZdhZVs_c0_oRiv9R7T781SnmB96uS66YkDvTuM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOI2rE1eifC75LKuMiRuikmI-5vgxmZ8T9ElmOXuwX26g&oe=6AD0E42C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEAFHwCwmzwQ7kNvwHkXfgH&_nc_oc=AdociSw7-HT5Y_Zm-XGqoVxqm5vBVPSYPYCpGs_ruIjLTG3YZdQS5kyPqlllpdZm3F8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNvASuiJW1XbuxlvuQvx4hkHN4fKbMFyRo92jxQkQiAg&oe=6AD0D3AC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uL1Sr4dujUsQ7kNvwHpG5ts&_nc_oc=Adru7PAggFuLL43aAAEOvg1yPcLWs8A1JfmS6VPkznre4yf3tSZdzV12EoDxylvM3TY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2IeZU6pTLqO5q4OG_xwqz0q1e-TFkpOp_cFPwknjZBw&oe=6AD0EC74"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NwBYLA90N5cQ7kNvwEpipwx&_nc_oc=AdqRQoMQSk2V_sYQvKq2sdMGqIFkv-wjKJGjsuGZZQsB-CvEH8cNgPZZT5TxmtGQ734&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNE-ORF_KmyADTwXBkASb01uld8dp-Y6ywX-lqoT_yVrg&oe=6AD0E6B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJiuPvNUmL0Q7kNvwHqO0_D&_nc_oc=AdrCHjDnWVDb5CnEai-a7LTINYP_ve43I_yhiKwWeIyh2Buwlrn9d53qeP-B2-IIFI0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7gNvSZLTnRBOvE3eUTwi2809VBzfGN1x6noSZILGxeA&oe=6AD0F5CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
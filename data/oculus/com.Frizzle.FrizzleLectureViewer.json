7567900675752", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031645_437567904009085_6070206936841904870_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqAD0NI2IlcQ7kNvwHog_0n&_nc_oc=AdowoTFLSh6MCn8BJOoAOLpvWq9RjmLVmG6V0kjt64m0C81ipgbef8p1LESeRPXAdhc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_93xiFkhN0f24QLST6yiNrXAOSQbzoVBgLmLdg7xblw&oe=6AFC65AC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukuWBDBCGdAQ7kNvwEirAhG&_nc_oc=AdpjNENnZeb7i1zbD4HBfg107u4CGUk2hM-5ms9yaBJ632gTycJIMO3rxnph543go9Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEmi84Kh4lm7c6BJ-ZEaqge2AWpMVJpgbCvRm0fGknlQ&oe=6AFC8D6C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adn8961_jisQ7kNvwFs362E&_nc_oc=Adq70-DWM9P3j4BwGmi64H8ZUeQbtXmatbuqpTqMhH3G_dQenYDkTKekqKt3G3aZVes&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzcrIpHic2jnImtEdvfPPkSmx1NwdjXouYxlP8IGuxRA&oe=6AFC6DF4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fK88v-SIFsQ7kNvwFE-BHW&_nc_oc=Adoino5ZzgK1-P7kHy3gj6DPny0XEvwe6wWmec077hwV1SSOdMPzd73LezqwR11YO8U&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeNXcoN9bXE4jJL4AWcNGp8vzBff9zXce3Y6SD-zIJ1w&oe=6AFC6836"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=
2hTC8uXTJWwXUYvKgBoVDrLDMP7uzFNYvIcdvRkXOxolCB9u47iR-YSTouCUrE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TvbCKkhvCEemg8M7KCGlotVMJWDY_RY9czAonRcLyfw&oe=6A11BAAC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ecf5f92mdkQ7kNvwHuLpGY&_nc_oc=Ado-QI3N70Ivs2vpn_Z3bdQsYZeMUqHU3z2i2aFD1DgYPfa4W3q0nm1xqBWwN12VKW0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7glD2KlmQDud7Y8w5f7ngg4Tt2ykvRkGhZgiqVY1wIRA&oe=6A11AA2C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJOTU1IGyWsQ7kNvwFMt3UZ&_nc_oc=AdqZmXIdHiEtCgjtAohpRkOwB0rqoRWmIkycHvJ0SvrSgJcfMkjJniFpzPc-WWHePCA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79i6Q_7cm6U_KZNFBdtmFHRcJcPnT944WmT2KIt6mGZg&oe=6A11C2F4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rR-K69eL1d8Q7kNvwFVQ3WL&_nc_oc=Adq_HQ3TFSSYiPMnPUKei_pYTq6J5YsrWOh_XE6ZDgCjD852rTlzY78RjCueBM_L2OI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6a_slLQ9Ck6khwS35TuL1l__-LSwbl-EeivSx_p6A7fg&oe=6A11BD36"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1rntbGASFsQ7kNvwEhBqvE&_nc_oc=Adp8V4R9Ir_EC8WKrew7FaJq-BPNtCcXLEhyV9wMeFajQe4ngQQR_3B2ji0G5ABOY0A&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MByk3t-QT67l_V36vgUrn33fyzavEiSWEm_GQS5sESg&oe=6A11CC4F"}, "is_concept": false, "is_test": false, "is_trial_offer_vali
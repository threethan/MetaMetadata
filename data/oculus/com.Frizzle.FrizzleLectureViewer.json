4dXNqUyZwIHBjbvmaZwakC4cYXlaQgq8yUvwCTRnzoNMJWMDSS8nN_tGCsWs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwQOo2q7GoaaGv9AYl9BJR4eV9fKlZs4H3U754zuVSuA&oe=6A4BBCAC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KdCCtS8N4ggQ7kNvwF4MTQE&_nc_oc=Adrw8Rmj2myf3BnrFoi4tQOtrYJ1jxOClFxg-hh_2GCXYIOeC8r9cKjSb4jFtG4obTs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgb4_PR7bJ0kfBL-UkZzJsU9XBwZBH-xvA4xEGKkdALA&oe=6A4BAC2C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KN15mWocHIUQ7kNvwEWQjjl&_nc_oc=AdqNzRBpGYt8zUfqF0HbBmkiMHnZgUxgfdXoRbqGQiUUm6zFxFSYhUhXIyWoh3Da1zM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1n9rwfBBRvOMskOHT_d-CYGzTUaCY2VNhNK3j4j7nAg&oe=6A4BC4F4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3omuNi_tnEQ7kNvwHIOJKA&_nc_oc=AdpF6gJwDale4yneDguQpdDiAC7ZbTCRFjARMsDraWcHtBZFrGt0jYSTLdeINxN6VvQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCL37c2U_PySM8eV0oFCIWW-6agOE9wa5zL_6gc-Zlx7g&oe=6A4BBF36"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyR74uW-uXkQ7kNvwG-jU3A&_nc_oc=AdrToPCLIRB9ylcHJrEgCw1yLwYE27deHRX4Sb5O7uMGuaBd64Ws9e29TQXbJo0xieo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJTjCOso0_SQYAbyQrGVK8A9ecynSOwlZq4oRknZhAaw&oe=6A4BCE4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
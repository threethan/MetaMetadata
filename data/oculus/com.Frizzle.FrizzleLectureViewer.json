QgXw4LHg3LRCjXUYZRTlMS7j5ULQBG_SpRY66xsS9m-zrwPy2AnoUjQqz1I0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfBCFyk5t6hKJTY6j_H14D3JrMKWKvDxZJ7QBDRT74uA&oe=6A88296C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWXeP2xZjtsQ7kNvwErqwcn&_nc_oc=AdoZOpB_L3rz6jVahI0x8QaSTC4u0ySB-I_wUkwMc2SaNxGwizmkRs119MPMSajP-tw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYpFNKv8yUa73_VXB4cn6Sjq4pa8MDXygDl63c_DzGrQ&oe=6A88512C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuCBwb6wCSUQ7kNvwFEm6w3&_nc_oc=AdohmbGiE8Lw-3oUXTGo56EhkcOdbKSddFBd9_ZrEIJcVWguUyWAs5iwCyttZfbMU-M&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELULWBnZFu-xjwKO7KXlS_U2wHQgQbLjwKoBcQAVv7rQ&oe=6A8831B4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4CRMuqVW2AQ7kNvwFWFuh1&_nc_oc=AdonSxcxX7wDMQJvEjaKXzkG-mTpzftdZRcHTL5R2UvZiEYIif1XGAGp7vDOKjFNCN0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDf28tY67T6vKZOUDkyjp4a-s_UmtZwZZ-yZi2v9lbcg&oe=6A882BF6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCgJXAbIiQQQ7kNvwFb_1Ft&_nc_oc=AdoKkKDVaHd0kQFizPIkdVPPLlC6ZEK_6ppKzSjVGaf-b6MDoWiXlUH9Yfl19UQkl9s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyQjZaupDHp8rmLo51h7X3x2pihpdw0iCBF0-1IlXP5Q&oe=6A883B0F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
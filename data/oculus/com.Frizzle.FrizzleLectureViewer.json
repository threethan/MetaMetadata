b8K0oZgsQKlJZ2yWHj0lOXsSJsvyAzQNjXlATc6adzK4pBzMe3QSx3CkIndw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4thVn5oR0c4OJOugXc3Zxjoih-zNy1v6moWIOts6Y7w&oe=6AA6B42C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNF1m6owtgcQ7kNvwHmoUDx&_nc_oc=AdrJ6bK2MZx0yvBDBdZHTfcFn-EtXrDCw48uejRhKi1-LKE96kusvRpAnXDDUm-TEuc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsnqkzURxSo9xAkfSDh8ssOCW9KqYLgM0WKmG0ofeJXw&oe=6AA6A3AC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmLULtQcc0sQ7kNvwFyVWEy&_nc_oc=AdohvB1JyGg3eYKzhJvwg-jXubRl6w40hOVwp6R7CM30y2yYPEjyxIvygZDXLTKlTJk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI98v_u0H2r3-HVNBtWW5_AIUhMEhbJfLZjyIZU7bj-Pg&oe=6AA6BC74"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqLmqx0f_ywQ7kNvwFufm8i&_nc_oc=Adrc35ut-m_QsrmL9ZxEe0KQbOZPDDAoRmc2GY3-7i1No9GcRGgsY3ncQf2gDZbfPYc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAOVp4rvb3m2H4YpgcoQgHeVQSAMPWpv8fGMYhDCV2Cg&oe=6AA6B6B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q73iSG05RFoQ7kNvwHm-YtP&_nc_oc=Adq7tTBDhJNp-tpEdOdypePos3rUo5VvKePxGTYqzYo2J0veYXmDmT6b3DUqpAe4RKw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJA8il4kAhug2l3TlfGql16rpodkfr89_0sBMwJ3x4RWw&oe=6AA6C5CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
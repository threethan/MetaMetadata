IyMq9JSoyFr6f9BMjg3wQ_CcENHuS8RqMJuxD9MUy3wH-yO1oGEWDgXQPwtQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBo3OJK4D1-2VqhDKWLnQHRrZINr0V67ICGF4ntQ8Saiw&oe=6A62262C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyWr2naO044Q7kNvwF9-gus&_nc_oc=Adotuz4toAYmbIC5-6CUOD_Syo2jMk1pr91hbHQmyg2QA2hRXIRLdLpZWxDjMj4MJT0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5yFfNKXG0dL45Z1h5austyC84gXuDM3qc8-H3UTYTMg&oe=6A6215AC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTFpKYr9e3sQ7kNvwEj9BsZ&_nc_oc=AdriQmMrTzggcXiYTGSjmim4kvCnwhKO_0uLbXLlLpnFb1KibfqMnK-V-qqlJS3ryCI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA---6Zv45s6TyAWwfFEXSgj6N58_WrL1f4neZ0eOYXog&oe=6A622E74"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1zq-m5Zho0Q7kNvwFH1a3l&_nc_oc=Ado1lrmGxk8Y5J6woSszbvWCf86r6deeS6ScUty5s9f-0_lcfETfrbwFQqeMCfNU47I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0CRCJ5pCj_ca6i5Nt-DINpU1AHD2rgYCRdml0GfnUrA&oe=6A6228B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7kyCPQnLpK8Q7kNvwHdhwu6&_nc_oc=AdotfOipm6dEJvf6qPTot2fB5hA17ujcGJ2yjqxw_z6YLWDPzGF_Ydn8Hhd21_B2GLs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjNaChoV3tg8KRUyR4xqh5iGmoeNRWUG0sRTnjoPpKCw&oe=6A61FF8F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
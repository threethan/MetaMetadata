_xJx5G5awxLu9DgN97JB2IIbXZNEVqFDR3vr2WS0-FNPD2no9rbsfkm9QLK8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvYRTJF6jzP5-RZAF8DoDU6lqEamG_v3_kp08qBWhGAg&oe=6A9752AC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwF-KKPoPNUQ7kNvwHQ62f4&_nc_oc=Adq0LLFKqmO4LGc3T4oi4zukqIj49yhUaoFySlr99oU1DPhSp0GP8oP5bHU15FeLZEU&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnkhbmYDzT5NbbrczpF2vknhqsnn6fKMzjCi4Ku-kPsg&oe=6A97422C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKdk6se5BgYQ7kNvwGhQGiC&_nc_oc=AdommIsS1Tivo8En9h1laxPqTFkYGw1qF9zM5XStUI6EhDFOHKQl4KSJLgYCdsFRPkM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBUIB21Hcat37IrY1umMVoLWgjDHs9GmT1-NUxDCA1lQ&oe=6A9722B4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyxIPcu7Tn0Q7kNvwEupClX&_nc_oc=Ado94J57bU_L0D9mReaO-1dxhOdWf5VbYxm287F3nh2TiH7hA9SyiRA5DNW7MgZeYWA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcxfJRz8FBXMOh4U2FtYqv9Kr_TAk_kcqp0SSqdvvLsg&oe=6A971CF6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RbVIxb7Ma3sQ7kNvwGDDIh0&_nc_oc=Adq_xCVIhPVBTETpdrZcq15HteDIoPf0vDSEXUvWgAITHCaP9pOBqESmmzrCkELl1oY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzjTeLcyxBH32PIYsxl6R0__b4qtkUBOj2Jkfd_RhbEA&oe=6A972C0F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
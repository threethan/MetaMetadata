V06P1_rff9FwURIGqdk1Zr0h3350KX6BT6k-zUcMAcLZcyLXk9GQp9xKYZpA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af101mshfFIQX28LzxztyXsCxZ8RJdH_XC4y2mn0PQYiaA&oe=69F75CAC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dIA3Yal1qgQ7kNvwFRR7im&_nc_oc=Adpw6cZw9akBskYOM1k6B1qsm5wPF4eTMybwHILkeFnlYVttNfJYPr9f6ynld5yxndY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ObE1kjDBu94nzdo8msSGUgEGqxS6btJRyg2O4onwYog&oe=69F74C2C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMHn-sv2ZBMQ7kNvwHAKrV6&_nc_oc=AdrFpL3VqI2VC3QrjcJhmQTnXamZakkEnNfwk5xBtR21yIByRvojt7_sy7Zh8uUrKHo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0L2TGrVTh-4ohnby0AqLrROgLYvIVx9EFpUMLnSFcDVQ&oe=69F764F4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-668iFcgBFEQ7kNvwEf5fuu&_nc_oc=Adr3xrI42Fk4rHMZvd_dUzoEYHUKfckBWfuj2m-CEW3L5GQr31iONOlPAkSejOoyVYg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1KXAZUyOyzIi2XcssCnk0g4mwaUYpmemK_PpM8vZW0xg&oe=69F75F36"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghev6Ddrh-4Q7kNvwEaF16F&_nc_oc=Ado_G7cUMqZ_8BjrJuO0PFCAi3NdEmD-PGK-TvU-gckEkAOsJvRP8EMNp5xTPrQdQtY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0PQRGQsCLyj-FE6Mv9gCjz1aBa4zB2TX-LSJvK84h06Q&oe=69F7360F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
AUF5CJt2IF7hpl7w8MmIB04_x5_5lt799z60k__pI3roGhbw1QaLdw9BtqVE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJngUkY5g1-AW0nVthc3c3d64RTW4v50lO2TkQLMLej_w&oe=6AAFEEAC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAt9qTli5h0Q7kNvwEm4sws&_nc_oc=Adr6Xkh0XcKQgK1mjM3VH_JQZt9rVI2zpqXoIBcr0soCVCPOHg-OLYbRu2GJM7IC0Nc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjjvz95OODeoff94Ak21V086xfV1nB10UoMyMhqWiWLw&oe=6AAFDE2C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BM_g_puMBm0Q7kNvwHRmupN&_nc_oc=AdrPP1ZnadZrfvdur5qX7LIFWZlvdYtyDxWforz0jRY0T6I7R6ggeUrRKlXvsydCA2s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAVLKui4Dh6k44Pc9tseHQb6GMfBH9YJl5O9baL8bpEg&oe=6AAFF6F4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xyzn3xi9oEgQ7kNvwHpOmgZ&_nc_oc=Adr49mDZF8HEQVH77VlLPqlxNyEx0ZfOUIPC2MVnw9fY9-KL_bzJ-332np3F0nzkrv8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKy5nIeQI93EQQJrFHqJ-AVmdcy2q52gv0ecJujSRS5hw&oe=6AAFF136"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wuaS8yEmh0Q7kNvwFo0RSL&_nc_oc=AdomQmMkItlVm7IygHWf6Lk-lBWeA6_40ySAZfHm5HJeLLz3LGSwSVX4VWZaO5x3-to&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLScGptmzQZ-PHQtKqhBKFtrxoFlRqroPzDTRIDrHlPfQ&oe=6AB0004F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
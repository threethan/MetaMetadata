9TT84HPbYCGB5voUmF9WcY0DDy0IY5KxevlOk7rmmeIKfdW9l3Ziii2X94ZU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRdfyOzixVpgM6Ubo6l30i6oNf4E-e7rcvrDGA3J545w&oe=6A9163EC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCFAotQBozgQ7kNvwEcaHMG&_nc_oc=Adr3ozAMljJRF70hftVah9sm9DWA7-RlAtoG_sEYh5bB6aH97522nuKOQVeJhhTD0es&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGs0T0Hz27yMKho4QuJjLtCszR2QWyKUphrPlgdd5v8Q&oe=6A918BAC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-FyVrj0b8IQ7kNvwH6tThj&_nc_oc=AdrDScaWfCDn7p4gLRPoSD5eitgPioDeCQfz2wmj5Z7DAx3j6zlKAdxaCOf1_g9ewNo&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmlpkHD9Y4bry-sLb4U9ZPNCIt-r8bMjWOQCMA1xY0uw&oe=6A916C34"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ld3xBFrNxCYQ7kNvwF2XkFX&_nc_oc=AdqYWfjmux6odoiFNmWk4SAyIC5R8muCthR-OYJjayn0TMRMchaf_G-zvwAYhGOTxvk&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiISlNRh0WFle8KuYW0_bi0372NHi8qJs2Qq6LbxhEWg&oe=6A916676"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBOahFZsfDUQ7kNvwE_ulRA&_nc_oc=AdrvJjGT8NwvY4pqKc2kwb4AkYD117GfzUcQtkXw0-nUe9Ksd27OPuOXRhip-R73Pe8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZBlmhB7Uzm3X_e4b4scIW1qYYn52b6xmXypuOAntwgg&oe=6A91758F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
}]}, "id": "529731165078104", "locale": "en_US", "screenshots": [{"file_name": "Untitled-1.png", "id": "1440312639635006", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_1440312642968339_2789643189716025521_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMn8ueOSwFoQ7kNvwEhTk_c&_nc_oc=AdoEbn3lRyyZZkrO65OCFjtAatxDN0QHmQNv_jCT02Mj3fhYg1SIHGVIvKevux9Dv-k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SlSrrt5blaT_39vdh5XdMRf_lc6ODvT_ug_AmSH7nJg&oe=6A01E3EA"}, {"file_name": "Untitled-4.png", "id": "437567900675752", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031645_437567904009085_6070206936841904870_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=45ofFJ7tNiYQ7kNvwHHXJFe&_nc_oc=Adqk3Ekn8_AXebSUHZ0fH8thv3Jn7GyOtrvpEZISNSmmp1jYgmg-B4q5K9D3jVICHzs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59aNY8wa9szlJDdCEWzdiRnIMsoOrXPW7iVBGnchL_QA&oe=6A01E8AC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=440tZ5PBpDAQ7kNvwG3Z1WZ&_nc_oc=Adrcav_iTFta9IpOTS6MzKO5U2-T9vZ0hTsk1UylozCT_GNrSq3OwOPqCuOKM4DOjmo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YTq7B6GCKw0y3My1nmmWRfYGvG11pWh_TsEWQIzQMKA&oe=6A01D82C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Sn0Zkulnw0Q7kNvwFWbdJb&_nc_oc=AdqmVWkGRDHsRP2_cQ1aCutWGlREkxKAgxp-Zg0EeSGRfq-tH4kbDWDmb6Wx0Yxveko&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qBE4N5Ruq0LgjYBCdJE9sKtYfSLxvv8Y-ojJ1Mm1bHw&oe=6A01F0F4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A132fmdom6YQ7kNvwHolWmm&_nc_oc=AdpJ8yq0pm370TT0dQsXSpm5nFPkc2fs2srUkO4YEEbDNqat80Qi2aRUHEa9VdyGgn0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iZQTsiYdM-W41S2nhld1fklDQhyp90ahl2CBw7BDHyA&oe=6A01EB36"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
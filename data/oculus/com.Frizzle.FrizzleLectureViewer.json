CpZQvDMlqTul6l6bXtjA5JTjBlIPfGmTNrgqNE5PhFBxe8IjPFbiaYjoC6nM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38FSU8jHkPoeqWq_uqc2_o7PHjIchQ9ls3Tv1D5Zprxg&oe=69DFA1AC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lUx-K7NVcYQ7kNvwFSZkiR&_nc_oc=Adrn_3pm4MGsJ4fB1WFMzZ50QuFPj1JWveFMnOGurg4Dt1QcHRnvVnDN1_zw0Nzk2AI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PZmxL1wn54pgyiyvgR_Nsi4lylTBMFIQzVOTBBkNekA&oe=69DF912C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxcEtRBW4LEQ7kNvwHGuoYn&_nc_oc=Adqpt2qYUEb-DeGoaumbjNGNSJkH8wiXQcHYgqe_CsqOu7JGY1kNANbXqV-kCYesggc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YkYFgzPhmRotT6ptsL_KRAqGGGt1c0EYDfyjwngCgsA&oe=69DF71B4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQ2V-P_QyEgQ7kNvwEd_w7P&_nc_oc=AdowYQHpRBnm_I2Xjm6lukP7pXvUj9dmkrMlapx43k4H-ISph0lsevq0FTHLtQ9bpFk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kgm3syOhI1XjAVyF0LgV5O0AbUiiGD8aaqDlJ2qc3qg&oe=69DFA436"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SulQegkFH00Q7kNvwEZ9zRi&_nc_oc=Ador3rNBkQ0pVrnJ2ayqVFoDLlhuzuir_IJKOjijYQ3RV2Rlhh6FHaNjOx85zPIyOxo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jeyEmZYeJg92kGvE7dph0SlUcHf8Pbkv4GqxDdB5v8Q&oe=69DF7B0F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
Lvxirys0dsDPCpK_WEVTSTYJAr0lRdf5mieak3nwMDWPxpzzCatBGX11vCrk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxNduDZkcKFrHjZKw31qLem0ARNMait59ZdnJ7JCi32Q&oe=6A5A3D2C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4B3Fz3csP5sQ7kNvwEKzZyP&_nc_oc=AdqBSKM3KoDoIKecdIp8hPyguqQs9DMM75UNWbDYKqC_gvxkVDaFbRhbtMfM2yXx_Vg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkPJEEXjbXMjJ3FV43ev6BaFzv9OMRyVms-okh1V6H4g&oe=6A5A2CAC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKlDLjrzalQQ7kNvwHP4hi7&_nc_oc=AdrLJCgRT3YNwU4ns8vwdxYy5pusYZi2S-PZH2gjx3EQI-JPjPe51JvK6JdJgzVndHs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDY0dw2Nm9QiahXWSN0OkLvmN7UWKZWuiHIrfEiXNvY8A&oe=6A5A4574"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_gXc6SVytYQ7kNvwEdMxWP&_nc_oc=AdpMRbGvbjaV7lKkmPMl_9Ta7tMr6j1Gt1CMSitz0Af36AW3POJCspmCpd0mMC_bP9Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhRwCRxTarbhC-6Xit7b00G36qjMMtqa1jDjtS8QPoBg&oe=6A5A3FB6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_NLw5OBZHgQ7kNvwE52qy8&_nc_oc=AdpH1QvdAD40ZthvqVLRjd3MEasiivUjfDc0hF4CPKe9-id-qL0SRusjYU2CT4hq-RA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1GmdYvSO3srcLng57rOGuc5G27G39uV1ouqR61hiLAg&oe=6A5A168F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
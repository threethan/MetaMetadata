e1IxdnU__n6ui9oMxRecjlsktybM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwmIFqx8ss7nu_287_SondCfrAx0JuztaiYD-OEozTmNg&oe=69B6C32C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y__USiwsbvoQ7kNvwHmoloM&_nc_oc=Adlq5jGyyKCH-mDd150j4zGRpgSkgB5UYLguwe65B4UTWxipSFphT1BayQrb31sWguY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw2Z2Gfknj6O1k62W4RjhaokKclxOBCyK9ZwW2JJGVbnA&oe=69B6B2AC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uak_gqDYotAQ7kNvwFkoPkG&_nc_oc=AdmhYpH_kUYOS4Tpp-s38gnL1hqAQtX9ktxcnHUgYyGiox5o59WK9TA1DqT2Y2PxLK0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfylVrkyBGnxYZlMG5I_uEMmvkYsY7LcNHceL5w69zBbmA&oe=69B69334"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ru49fcA7EIQ7kNvwEloSBx&_nc_oc=AdnCrZsv8dtoeLY9l_J6TPm2JAfhjQDQLs4BeAf6Rlp977pn0Dq6-D5txuVxarvKUNY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy8XfqLtPtqELsPv5GvvzwU7oC-X54cz3n8O8aHkK8rLA&oe=69B68D76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_yevdO18vEQ7kNvwFJIeD-&_nc_oc=Adm3kHqBXyD7os2g4ekQa01YB99k6y3IwbMzwA-1Imr6PNIA5sYm-r6a7fiqykUGf0o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyCr45ALrfzLsmX6pqkWu3WbMptIx-w--eKsdlhv71XtQ&oe=69B69C8F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Frizzle Lecture Viewer", "pl
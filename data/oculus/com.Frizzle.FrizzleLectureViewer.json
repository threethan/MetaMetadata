PhbXS51gbYnadwxWhPfBZu-XW5x9Jmu_Gcjd-jsGoRzAHZqncOEu0Vfk2Cj8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArbi0AE-i0NFVxPxlcu76AVwFAObxo3DvUk-1I3gMvYg&oe=6A52542C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHvflz2Jl30Q7kNvwH1mbl0&_nc_oc=AdqBf557x8bOjcZW7FKOAIbRHIAHft1Czhsp-xHFcOj9JUiaJtOKkYhGAor4LGidp_Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLtQ2aryNUFP_jMhc1qcYxWE2PQmXb8K4KadE2CYl6mw&oe=6A5243AC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyLP2I1LrZEQ7kNvwECZiZi&_nc_oc=AdpDl70Ern5KauJQbROcOvuHavXwUOWARiHmo0B2fmOgkuWVkZaHSYVV-4--uSCwOHU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVFkE0eRQ29zL5tRehqEW--TW-XkFwbYYlxvqSTMsotA&oe=6A525C74"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txcgP-gIU84Q7kNvwH9pCgc&_nc_oc=AdqwuhQ1n50SMGbOwnlYXLW7yBvC90aHtcZtBmgW5OW1xm1CZyT6p1eK_Z5hHoi-2u0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD95VNlFmlRCaTi9MH0aTUqBQKt7SRWBmOhYZD0M25fig&oe=6A5256B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5UZXARaaUjoQ7kNvwGh1cLt&_nc_oc=Adr8KPZbUHprIaMcv8dwG2rucEAhWUCDMsUA5Vb1jvPG8UveRGtTCYzSKRmhdFck-qo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMWxUjlbZAkArA8XJW-oIsIGeZSl3imgzEXMsDGeA5gQ&oe=6A5265CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
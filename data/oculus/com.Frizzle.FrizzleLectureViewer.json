iEVEvrm6T6AqlTYDPZjJufST7tBtkqFiLExKC6vwnCEfgj1-ZH9e2oSSM2Sw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjnBuV4klLeocvA5tVTSGdEeL193RCRLEIsMsyIVWi1g&oe=6A8C1DEC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzCOdd_K_9EQ7kNvwEdVBIV&_nc_oc=Adp4w2W0EPDsU4yEYIdNr9YxrjSykdLrTbbQi1lFX-bqZhSA_MG9l7euSiY28Zy9TdQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3HpIMlkrrcNNptnREouLohAz4HtsOnwtUwgDfV3Ul5A&oe=6A8C45AC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0m4WFbvoOnMQ7kNvwGpgXcn&_nc_oc=AdqAOk720lVAEKPSdFpR4772N4aLEPyivvRORPKJ0acDMYGYa2o2jMh6fRMKcl4q9r4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwFYEyhaoBjp_mL1RUv9UknVTW0BbWox9Q5LO20UPf3A&oe=6A8C2634"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2FrrJhP01oQ7kNvwHY0FeX&_nc_oc=AdqZTDriAiIAZifteL8o7bwK9BIo2iaJU-XnrdizgwavvIECdKxhCNzgGhXXh7seqj0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECgv_83xVJS19aJ1ozWOwM4ZGrTB88-BBsTcwCi_hbVA&oe=6A8C2076"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YC46BFo6KQQ7kNvwGoJrMS&_nc_oc=Adr1kOUealuuwLbL9Z7ALwKsExAd5EcJs4zAVecmIigSQ_wkQQ7vJM5yAtWy185XI78&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4B1D1TfnKedbzJDrnsOKK-g9U2F-3KMNKfbTxqkFnPA&oe=6A8C2F8F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
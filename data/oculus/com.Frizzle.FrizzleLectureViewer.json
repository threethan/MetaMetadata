X7o5upIVhuV_XQIAXVqZhsJYYeTHLW39TxiiDZq3oRcxNMZPcLaPsGwOWJxo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86FwXvLciTRK2A_19C5f2W3Qpp1xo-jvYAXhJzQ4mQcg&oe=6A2975AC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8w9fEOxsy0Q7kNvwES1_yZ&_nc_oc=AdpEL9evWJbeoeXSox7z3slbl6Hr7WOf7KNA9MEOqgcKdSwX7c0zlDoVKH6eioEXk2E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TSLnWBkUOzw1AWZdm78rOPbq27gKcObvZkkcBLMaM1A&oe=6A29652C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3l0J41Cayi0Q7kNvwFACkYn&_nc_oc=Ado-LPfn1_fWJvW0cXfko5V2BqP0145IbgdEI-OtfWoGxixJRV9vU2ven86CXbdDLL0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FqBKv65nj6x8KXlE0xJcAm572gmZF7WGjRvR7VVBXtA&oe=6A297DF4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRlQaqNYHsgQ7kNvwEHE3J4&_nc_oc=AdrYGweyDZgxfqTXG_7pnScqvzb5GpBmRyf3xdZ8FUaJUzAXyih_Cq9rPEZs4ar8JXE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Mkg7KNk6Z346IEJVK4vnXu_rVWC4qh-fhYzZtRZ0czQ&oe=6A297836"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GciATHDVUVcQ7kNvwEwWA_m&_nc_oc=AdoNlNAswWCF4ipnVdk2PQ78b4TS_5y4U_Nbzu93cjR_EmvdeeMgmPxlTx1wJCCzH30&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Y2nzo1xJ4dCXN6a98cEzEUGQoT9ZoG0NTrl2w8oddJw&oe=6A29874F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
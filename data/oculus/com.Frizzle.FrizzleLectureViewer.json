YqL-42bTLPhOgUFwUAQ1vYfR4Ujnwrh6wR0Pdvd6i_pI6atohmNZz0_kHCQQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LTef5tqN3JFkrQ7Ec3XKvdzmEbOHq6XEPQLrJVSx8EQ&oe=6A203B2C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UymRiYNMCmkQ7kNvwFV9vXi&_nc_oc=AdpnaDQU4G30KTCXsB7j07MPzuD-3xaaO4NTlkTou97e_gH5KDLAt5iiFqXn2NXLjLE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tA6vYkavqE_UFHvfKxJYIYkaWVwvwJdUfLdxi0qbq3g&oe=6A202AAC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTN2Q3yryoQQ7kNvwHV7eyc&_nc_oc=AdoOKkgEnJUVqkSmrihoEKC1c3H2OXKaDBOGRN9U5W1fu5PxuIePMjoZMAb96H4Fx8o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4toG7zKFWW45zneiwKAVI1OYZc1GFrrYVR_j2vPca4Xg&oe=6A204374"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qv0BeqD-40Q7kNvwEtDDlH&_nc_oc=Adpi81_9jcPXZAtfgt1f2awzfukzS1nV26BsfjlNsQe5eg-KyVN9E5JJCky9pRn3Jc0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rJJy-r6SNFnIgI-eFJeISNU_3D5bi_TzxCA-bORz-mw&oe=6A203DB6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjywS_-gEWcQ7kNvwGKMuD_&_nc_oc=AdqBDSyQGMYWRs2E3PI_1rBEdRqKPWTvG0E-_DDp2z7JHkp2mzDv6B4TfEdoZDipSuw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4S0YdLz-do6xUYLqCRh7A2HP8lfFxFSaNN6zS7Jx1y6w&oe=6A204CCF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
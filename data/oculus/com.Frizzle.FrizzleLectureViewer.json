nE3eNqLfh-S0WEdL6zR8DdqOdsdmm9I9C5zW5W4o-ILsa7B1_eS_nRrQUvBs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQKNyzVLf0gK1plbQPVYqLW6J4Ax1umggrLy7LbeVa1A&oe=6ABA7AAC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oU3ujZTWjLkQ7kNvwGovAnu&_nc_oc=AdrXHyIcpqhfs6VDllMir5veEkUT9gN24YlVIAnPjjisnhwZlNrv3uuy2Xmc2FxLR7s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIb3OZy90auOLV6686MNUdZkqAjBMBI99w8E_Z8GpwNdw&oe=6ABA6A2C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSiD03rmmZoQ7kNvwFz3mgc&_nc_oc=Adql3X6hVXtAdF86W-7WQZsTta7eXlVvv7SUlY9pUQyTXfnHY7p83axpgldPXjcFU1Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUAPpFYMAmH8ft29My1EvQAwWdAOTmnZlPkygqAgdUvQ&oe=6ABA82F4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uYuA3jOEwcQ7kNvwE7SOPm&_nc_oc=AdrLORu45K6I_0y5RPLaqOXfkhri_SCV7zinbn3fzW8pZtoAxYmvxz5Nx7QxdehK-kc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrtiJYQfJP2vgXrAH_JG2ZZtQlKl3F9uhFhu7IOVSG_Q&oe=6ABA7D36"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUQMunievwwQ7kNvwHXMw0c&_nc_oc=Adq4XrSYD66zcGTy_9VkrQkaCuOedQxsQPSo38EIZHhmLAsK35WHcTb8r5c6uvlVBbQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCwxIGzQ1ehJB6JYeLwgkT0cMEjJnlBZ63iOhq1dTwYA&oe=6ABA8C4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
d-5.png", "id": "480345453088120", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nzga3xiFP78Q7kNvwGlg-tD&_nc_oc=AdptuFksaLTT46Op5m1QemDEMokh64EkZ5K4tWCRzfpcI8i1Fooj2yhe8m8o7NL7frw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBF4axNGsZBXuc69tPEWcRWJjBgjvbwgpNL8-cwCmY3A&oe=6AFB1C74"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21aWfiRjR84Q7kNvwHZRuco&_nc_oc=AdpW-22-wJx3md5IcZu0x6d56d0YSTmafhAOlNZcZOodzu1E8Aa96kwZKZUxQY8INME&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSr81fo_YmIhgdt4OyNJWDUE05ZmW0i2Le6-qyGEUY9CA&oe=6AFB16B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "devel
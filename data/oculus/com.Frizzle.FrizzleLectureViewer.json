}]}, "id": "529731165078104", "locale": "en_US", "screenshots": [{"file_name": "Untitled-1.png", "id": "1440312639635006", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_1440312642968339_2789643189716025521_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoNh_hlD1WMQ7kNvwGoyKLe&_nc_oc=Adq0d5jvcBL_ENfm1fSNLZwZzEgM1yG2d9WWCZOduDCP66Y06bw1GnR_DF2g3HXlaEU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0U83AKDvMzo_0wLtRul4Ctze83upgRQu0TM9Ox0KycEw&oe=69EB7A6A"}, {"file_name": "Untitled-4.png", "id": "437567900675752", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031645_437567904009085_6070206936841904870_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DgytGw1HnAQ7kNvwGzRlci&_nc_oc=AdoJsvz7spg1z7u7egl8dt9duLmO2VHsFZOaiabdEuoZD3goZKBWEfBZ9NRhUKjQx3c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eB52KiBQs-RlCCrM0O7SPkClCoP6rt4GYC-JY57uLDg&oe=69EB7F2C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MZZJqaMUhYQ7kNvwGkk6Ri&_nc_oc=AdpYxXVKtzcsfB7OK5q6hQh7kgH3uQpd76pNHsnexDft_cTdWjjwurQBFsObgWrpExQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zqs4gt2inRGmdNlnpGmH6cOLE723R60SILMR6tYtGlg&oe=69EB6EAC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUPtH6cEyeoQ7kNvwGoN2y6&_nc_oc=Adpj2jGS8pRm8TYr-yAr1NAbBcTc2d_KIvKM2EDmFz9qvdKTDCcbj2_cqboHvRT1xiQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0iJajiAoHabt5R73FvWbHLScxrcsb_HV7zlg1nqMKGLQ&oe=69EB8774"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_n4xeYoF-0Q7kNvwEr3GVa&_nc_oc=Adpr0ugqR4bt3IPmc19tOvt3jMXnYhwSRmMR2pnsyOwpvAR0k7LKnZAi_UUHj4DtnUs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FwrHqApJ-A29wcnhFSdwCw01CS6aIHwf8f8wfcv93pA&oe=69EB81B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
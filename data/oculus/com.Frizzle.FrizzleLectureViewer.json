hZ1eBy7SUOZFES4uuALmKz3RWC1V66PawzKmWWiHkaMF10QiKF0dARp2u_T4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOgh-vTR_QkL4TFr1EX4ytUoZcYEzhDnWuF7hlooRIDw&oe=6A7C4BEC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9V7S9PpCuEQ7kNvwFaxOwM&_nc_oc=AdqqVg8JBAYJwuCScbeZ16h65_NP0ptPwWSJq2FTC_ra5dfOUBTnD7mv0Z4oqrLLNt8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcYJj6bgESXEbz3T052CLn_IwKctBZLy57EzuP_7vRmA&oe=6A7C73AC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COQthiUfdnMQ7kNvwF3qci-&_nc_oc=Ado0v6xpucu5izXuhs0rq_Ht-fqkC_kxDlxFzYU3eGjriFLMT_mv1shpdDdVVLde3nM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiNx4XxMkdWAlQ0UX9Tln4CDrPx4RV6pWY1VacLSWZ0Q&oe=6A7C5434"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSpf0ThbQZsQ7kNvwEN5Rxv&_nc_oc=Adq08pmLtcPAa5AtoP3ak4s529ijWwKZiGByQkdwKeh04U4EFjwA5bvWtVqKwbDqsx4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmZQpLSHC5zXbkyk2CbpCig0hYWeOZ-eYLX0IFnT2vBQ&oe=6A7C4E76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ve0mM1l9sV4Q7kNvwHHPdZA&_nc_oc=AdrSaVXsrK0mm_X_m2ZQrFLkUzSlBc2A5dJo_F5BPR98aPGFDYRpSgydFa_cFxnFBpc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTb2xbL2psWcqohFm2AAflL29ZlPBszmXDCEnQsEPTIQ&oe=6A7C5D8F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
3knLDN_NuOLvE6V14hetfBFdqrQq0tDl1tCvjKVqDxeoru05iqC3o1lINx48&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af16OFcNq1LoumTCQeEnUrnW1Rt4EhXxJwO0PopeW3DPlQ&oe=69F4B9AC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GpADUBwsQY4Q7kNvwGe_xjx&_nc_oc=Adromx6eBPKnDJJr9vlnRclSGlvCpthLxB_ez15-O4SO3OM0SyykSk2099Fzjqr2mmc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1s9z2uJKif6WfPA_DMoHwGF22XKMiRGQPLNILg0zf-6A&oe=69F4A92C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uo08araSumsQ7kNvwHNk9jh&_nc_oc=Adqmr4dXbtABf-aoKUSTbkqdJz2UN37Cj2OsSxZN5txJVPkGYa7Nth7E9p-xraXGw4M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2C29Nc75LmsdOr9WkqHA1KSNAbVGnWqEINeTG7r8dM8Q&oe=69F4C1F4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1PM0kxn38tQQ7kNvwEMoedG&_nc_oc=AdrLbbRultQsxp9rVItoaoCUvAh1A5F0XTXEb0JgaYLs0v-iZGEINbTWtMCrR0t2FRg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1r39MRgzsk7gnenB2GINwQQArPexoBYJYgLYQk-lpPSQ&oe=69F4BC36"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghev6Ddrh-4Q7kNvwGPbiR7&_nc_oc=Adp4D3sw4e5NG_ccpsn8TinH0QYymak6TAo-GgoSPVjK-RPgwK1WQZAdYdC156yRlpA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2217kSRrW1MDxNp2e-2TbPZRvWpaBP_OSli5AEnN48DA&oe=69F4930F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
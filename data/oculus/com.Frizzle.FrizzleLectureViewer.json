MHAfSBb3lVTTF3eALuVLZAOe2R8E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxEIfLLUorq5wmkkknAgd2Rj3_bThJ0qPvSueQIhA7iNA&oe=69BD5AAC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGzachJJab8Q7kNvwHFQRds&_nc_oc=AdnTogsSHVbnFPOE2At6L2S2Z0IFY196WUPxsG7B4k5bmVluhrX8uChJgFY0lYLp33I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLJ4F-JwluVUlUo9GTV5lP7O-pp5RMNQA24ok-7XT88g&oe=69BD4A2C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEIsTImC89YQ7kNvwE0fQJb&_nc_oc=Admp_N8-IIt1pgwrM9BM8Nx19UNpC6Tqo8ql6Hf8MfGThOKUUCiJMFAnv74mCmVCLV8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUM5ZPaO1eJJbJbOioZsupp-MZOSFeSAcC2YNnwJdVog&oe=69BD2AB4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2_eokQwJQ8Q7kNvwHRfjb4&_nc_oc=Adnqp8eaGuLBtWLt1MrSjodRPMVhs8fXni9ZfiRktRkak2nyilrWiTheb8VwYEFqTuw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx4Nqx8y3Cl0FP12lsQwoa0Zlg56BoCqznY-Zlbs0yhnw&oe=69BD5D36"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RV6LH2ivf8QQ7kNvwF3S5BF&_nc_oc=AdnwwfY8MQZtsThqs5QQh2sYxkHUVw1kGPQcNiKNhdgPVNx88BK5vu8kWee_YZ8h7Ks&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7Cr7eL58UYq9ZJAgdpCX_OK2jr4lzTPfZyhBc_t12hA&oe=69BD340F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Frizzle Lecture Viewer", "pl
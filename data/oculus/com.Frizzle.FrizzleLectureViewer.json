1ckzT47uFdCth95oQz5hXMN-XeDNFoB6sw_X6D-t02QmKXeJukxlPxjr1_Cc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDghXxdvOtfNyGI90innTRo_2_c2TkL7SqNlwvrb2MmAQ&oe=6A5102AC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrwzP7NL_lgQ7kNvwEoOSQH&_nc_oc=Adp1iOMbTMlZzcdPf1zexlNItoVk3NW-oCev_TW0FVGO0XSZOH1Na2AhUmP6-8HKxlY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAZ_k8WYoJZxTcXv9tDZG8Q8a13b-jT7d88UpPvcX_eg&oe=6A50F22C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmM8-NZoycEQ7kNvwFZbZft&_nc_oc=AdrwQtqXNTs8mTIMr-KTN-fMjnJOQqLQn969QEUuCs5I__1G5WoPj5nVWwB_Bdhv41s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCN_0cCr-7pmvwUNfrzkQoCRblB8o7Q48W5Ks_uMTRrQg&oe=6A510AF4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqU0r8V_9REQ7kNvwGc_Pdc&_nc_oc=AdoReQg3FaWBtSfwMR0cwlwHMwNosTRZSxQXyYNzes1zqzKV8KHR0IYn-7EQZhLAWUU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDsjobiMJexNX1mLeMOwSBZ6WBfgJnyAjJxgVTkUrHFA&oe=6A510536"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5UZXARaaUjoQ7kNvwEd2yrM&_nc_oc=AdqFjlfoeKhXEA02FpsOCQWM2dak-MBpd4KJyUMr3ttStP9hdslPnvUy9v5_Tt_t0ls&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCugVKFkHhP4nDlu_lqwQMK-PezfQKpLXwh9LDwDs5JwA&oe=6A51144F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
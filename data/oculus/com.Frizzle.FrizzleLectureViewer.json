g56sESiQNnd0nLXtsIQdf2OyeuN_YshWqGqFpp8vZtmpgHBBsHWrJpyQ6RFc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pEDbFNQY3UvcgnMYgSBKjnzAZv-ZBacMr9HzDFkTQUA&oe=6A2D6A2C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W86_0Xyg1_oQ7kNvwGwblh4&_nc_oc=AdpZGSjIp7XpVMBJh8jmOyZxzJ0jLiHG2lYe_GIxeMgFogzajqkbWY4H6_KOIpykT44&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Zq2UojFxBnMtQ1kH8hP0Qzo7O5CD74RnvIY8fMxn7-A&oe=6A2D59AC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifwm2YjXkfkQ7kNvwElp77q&_nc_oc=AdpyBqzU1jzkNnS_DhO5kpUmFr-twdSH9d4x1Jskn5zUcNfY7lybyNYmoo3VRAkuKPo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Rj_X24xGUWZ-vzDwYWVfVh_sM6NY1GLvADLl5waG6dw&oe=6A2D7274"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9MmP7KKwH4Q7kNvwGwT_nl&_nc_oc=AdqqZ6oud-I4eW5A9jc5vH_QyETkq1twVyGw43JD7k6O5vN3zYZad4Qh8r0R7q3BVT4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JRq8CJE1q7XenDvO9lMfOtz9RojNqa7aYaC1NtlmaCA&oe=6A2D6CB6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEYi2IwPhbwQ7kNvwG6mad-&_nc_oc=Adrm677uIPtI0JBzsptAW1Fzeqz9FU2c0PIrx4uM-aC9doTeU596XuugeSgw2F1SYmY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8r_ZcH-zp21Ay1b5N0mrl2d9CPBcB5wtXNUpuUE3oQWQ&oe=6A2D7BCF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
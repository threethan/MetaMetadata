9MUv1B5M8_lCPC613_IFxJDxhdhY22dc5n8Tjizat_chsPH-y7R6IllhUCc8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vOe8pugwlp7eIrOrZy3lCvulVEa0C2QRCwU1S3RMfVg&oe=6A19A3AC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yn3A0heCC7EQ7kNvwEVBkq-&_nc_oc=AdqLLG3FHEFgfkEDWOLIjXnVeR4_wWUrrLRK3733KkpG8Z4i7Rpd52gLtT4Z8FlgUo4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60_79gS0dVkPwKMhRgcoMSQXRT5u3_4QsYsi9eQ5tBmw&oe=6A19932C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Csi8zGo_34AQ7kNvwHXv4CW&_nc_oc=AdpczYUK5UJwn8zRhIP2dhXdbXnM9ixrqfNDlKDebYPxVeQJWynWR1xwclKqV1j52Xc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TYie1boo3qkrR1coDhKN9TOuUmCgXPaPbWMmiknmVLg&oe=6A19ABF4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuuJzmR4gzUQ7kNvwHOFCzU&_nc_oc=AdqsxG68o1SfZnCZMdY3T8JG8XAHFHnhWuyW8fPqDzwX9kfgZE5P_-05ub12uNJ2DvM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fTWzMZAOBfSs_eD1iBUydnJVcBIPuaGr-UtTiN0GSqQ&oe=6A19A636"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVDxBj3IDOMQ7kNvwG_ipCK&_nc_oc=AdoKMNjVTi01ZAYi5v7I5hygI_Ka1yW1TwzUydDhFpVgTmPWLkUbZTVRjvwSLJVdMXI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lEzxTlzU4vMTvZXVJW_B1BVLz6UFb0Qh0pznIqRRQ5Q&oe=6A19B54F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
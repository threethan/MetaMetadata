8xtNKPASeJPEdQw8ri-jw2IxHtoogLCtnmBo0uPJVpLAE0x8hUfaBOTHIuM0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGN4LqM7bjj6W0MGBqp6LPkKyYithhtnOKg_QC8YWg4A&oe=6A6A0F2C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W29aLXDaNtEQ7kNvwFTZ4BJ&_nc_oc=Adqob1uMlsTwiYhTzpz9Xnv_tXNWnEiwRKWpASdh8fxlCdWCgubYYoOJSJFvtisiTqs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWOCBGk4edc6F3qKn4XE-1jn3EGjXF7D773PpUuEt7hQ&oe=6A69FEAC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B86_AoP6av4Q7kNvwHrC-7h&_nc_oc=AdpTfbie4r0F96QGvx2_vkX7qQgC_EdnDLyUOC2nV3bGizhgj7-6nZ07rYGYXRvR5hw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4Zve73Z_7M7jqZNjiT5T7JYUsFHIvLB8EG7ONfBCYkw&oe=6A69DF34"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JITKnwsvwZIQ7kNvwFW2JJz&_nc_oc=AdqqpOiQsIAuLJmtjDvlOzRNrYS05h7hjwlpxmATuO8_gGAbLYw6sRb-yA_m27jF3gk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBu_gjadb0Vnk3vtds4KK6OS5i41sBvJuIe-6b5smJNQA&oe=6A6A11B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmaRRclmT9EQ7kNvwG2Uyrv&_nc_oc=AdoiElYaBJWSoBxbX3KHt908uPaiN6DTauBLwyvdwcatF4lrRgE6wmP3kS59F474o0U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBulr8dk4K839fFcZlA2XpOJRjBhy_cK0etkyuYF4_1pQ&oe=6A69E88F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
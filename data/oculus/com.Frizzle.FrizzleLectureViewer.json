}]}, "id": "529731165078104", "locale": "en_US", "screenshots": [{"file_name": "Untitled-1.png", "id": "1440312639635006", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_1440312642968339_2789643189716025521_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ES-E7SfxICEQ7kNvwEa2Ev1&_nc_oc=AdoMU1jaqDyIDJlLQ6DDZXB5Y0I8pQ_WotEUolXuUUkoWZSeekYyOREo1AH5CboHaIU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-U-jIXQUtzEXy4wxNhXSHOjDYjNsZ3nxedNEgB6IZeWg&oe=6A47C36A"}, {"file_name": "Untitled-4.png", "id": "437567900675752", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031645_437567904009085_6070206936841904870_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FUc6cdEccUQ7kNvwHhsUKr&_nc_oc=Adp_Q_zkHvRp-PVmrGxjwwzRGhZrh_E7p8lDHy82h0nS7onh8BUjz3XDCYBe4-0SHVM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wm0j4CzKsEV5iwLII14mn6E3Uf6dmjzUdomn0YUXVTA&oe=6A47C82C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DwIwaXkkJAQ7kNvwHmY5en&_nc_oc=Ado5jMkps13c_uTaj_MN5tMBthG_qa-YSVtbhv21Z01XzZlBEB77pNsu_tsKhtjcu6A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xcS_7awPm8sevBx_LvfkbKwuSS7Bwv1qaJo_-xj32Og&oe=6A47B7AC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7hOVqgKPzcQ7kNvwGyCZlA&_nc_oc=Adr2guG3e9aktLfgH0nfP2PUskRS5F7lRHwbyHmfPKR2z7is6VfY5tl0RJiHQ_AcRFU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BKz6uJufYphsozAH7ZbctBoUkQVlZLi3TF9tfU25BLw&oe=6A47D074"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaqeLKAMvIUQ7kNvwFuIKKa&_nc_oc=AdrQX9qfdXL30o7xg3mmfADH_Uo_OimSBFEN-NKiQg3vFBygAxZZ8QYPiRvxvqxkSpc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8n33AHbwxo6tBo9zYVF2FhG3htKmiWYea9y3uY9kk1wg&oe=6A47CAB6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
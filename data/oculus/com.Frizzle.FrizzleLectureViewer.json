9Y75hAnY3n3HjPHnBj4TLMlwRmUsK4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBGDeIqIfLX6-wzEjZGFGh0Yo4JgbI90ICRn131Cr0pA&oe=69AAE5AC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBzSYYFaAt4Q7kNvwHOu4l7&_nc_oc=AdnDvS0986UCSCQIRUKmtwg-jwVBCNQDQXXnat9S0pUdDlhpJI-DdeJfVQ3j-8jeg2M&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afwl35OcCcLddVlN4nSWTTZeDwj7qu7TiJXhR9JOEMPfpQ&oe=69AAD52C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5yqtSgmo94Q7kNvwE95mNU&_nc_oc=Admw9ph4IzS9dmpJqNIBXm_fizqB1mttSgrlI_znGX4r2IJemFYqCPTKFZmDOXCh5Uw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfzsfvnoVuLEu8v6slnsFNtLw3hi9js4zebSEpVEUekUyA&oe=69AAB5B4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zMB0y7x02cQ7kNvwGgNGj7&_nc_oc=Adldn3_UkxdiaK73wHHd4Q0M-bVrcaOJxGDEg4p6F4hP0OxmvIEHkRIVEANccQv6mSc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzu5SHl1IMUdmSy5JPXpvyllY0RVwGedDg0AkEYDTIYYQ&oe=69AAE836"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zFb8Tm4d_EQ7kNvwGmLLu9&_nc_oc=Adk1_vwBde9XkGWMLzCn6bqNSnB0sXedgI0sDlYPj0iOlHTq7ZXAiMIO3hS3KXMFDcY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfyDUctDgho6wch1eWTRcJzv3QB-JURJuLYyLczrSOmFLw&oe=69AABF0F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Frizzle Lecture Viewer",
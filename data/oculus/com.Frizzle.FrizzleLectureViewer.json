om&oh=00_Afvkq8EEeb-NN7Y34RhJ6w34yW-YTY2dhZHG-ZFMYDKUig&oe=69A44E2C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BuTenQobGV0Q7kNvwHv4SI6&_nc_oc=AdncwQtk5SdtjE0_eWhyaIS9H0Nx9ijCPRnYhBARLCjEx4TXnLwlQ_zZfOvV1zrNfa0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs_cL6IIjDbOaU04yVskST6bUZ4dyy8PtiB31DM4Okm_g&oe=69A43DAC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sm1lACC7JYkQ7kNvwFsOMSk&_nc_oc=Adk5ASuqEIBmJmlU0tDi-I3pP_xR09AkeObkAVzNFQITe1kZsBD_lMaT3rQNPgOFV6o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuKFJ2pfjOgKKSmT6C0hpV7O9siUumO6O_PYq2p5UKqqw&oe=69A41E34"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbaLNokT4q4Q7kNvwHBVlo7&_nc_oc=Adlri3iwocrAXF_Y3YsYHRt4VOdbhXc7Vkv-sIDFRAkmYDdrEziV27vJWWlBwl-YzF0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuX7DZgUa78XHVSC2ZzsGtnXf9me_mWtT-Fa9eANGTnJg&oe=69A41876"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2L3P6qGw6HgQ7kNvwH5y-lX&_nc_oc=AdloXOADmBBWZGmGuJ57o1eBBUqNJWkIrQbGycQGG_sCB0UwKXzQVyAdQmxiGxZr_pc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftoSVTSlQY--Uyrlhg8chrvi-4ax5iBoMQdWWUgedO_jQ&oe=69A4278F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Frizzle Lecture Viewer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics":
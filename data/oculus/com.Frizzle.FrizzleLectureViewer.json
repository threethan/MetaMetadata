iYaMsCyZw9ke9BIXkpEnIKRum9v-D7953Qge-bP7zZtKbSjtzxUq68AllVss&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0oBJUYPFXMqNHX1bIz3i8SSU7FhUlm4_TRrrhvQ26_A&oe=6A9AD6AC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=032WHO1Kuc0Q7kNvwGMI8dr&_nc_oc=AdrEkO6yPFgcF-MQdjXxnatO3XvxaAf1tNTaxMlA15VRmi2Y5KtwrPh-KKyotb73J-E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgLepKBN4wNuCmMQNpuKDFg4ibkEnSwN0h5WTbABYaTA&oe=6A9AC62C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytHo3kxijkcQ7kNvwEFNtpK&_nc_oc=Adpqz0ajTiX2_nSIllTrXLfdw1mXC-tnfyeD2zLIJR99hinKyTDBdzlpa38LYj9RLK0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZe0p-F9WOC03g1_R2ga7PTx57fo6pJZSvEeTZ6EvsMw&oe=6A9ADEF4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OK2qZj-9toQ7kNvwGRFR4B&_nc_oc=Adqz68FrCJ0oQpM1gt-liQ-PsZ4ulxnv6lqforE8Hd_nEdIbLHpwlBzo3iUkzXSAeqw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBXRAvAjryTtyyhwPWZWRLDJelO8UbUusUU_u0Mw_vgg&oe=6A9AD936"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDSma1nzScoQ7kNvwGVHQNn&_nc_oc=Adr8lCYmfYDO9ccrBh1Y9S9N1PvnOpHAs9rpMukFIjMC5GYQK_7qog0MKjMkUHRNvGY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8-GNd5p_9Sv6m9pRNvQK-Pu_nR1youcGUregQGebFng&oe=6A9AE84F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
FdmzOQY4ev0TqaOxCNoKcWOBh16tVQq_Xu6majrseigliXrBc4oZUN_tVEOU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKSsI5nzSorCBswYCayaViMBBRt5O71pucBNhXYB3cTQ&oe=6ABE6F2C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHxE4iMkERMQ7kNvwFTW6-n&_nc_oc=Adqi8IpDq4ohWIU2WPS2vSXZ6_rW3BCUK7z0jfakwVQmyVnWCa0z3_yMRDUKl7UQIcM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfPfJqiLn1VAbfTbpCYKNvQSphrOdHPsYQVc-OK3w-vA&oe=6ABE5EAC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LtU04reKWIQ7kNvwEvLUwS&_nc_oc=Adom2vGuiBNS9rQQAsq4HR3cxDO8W-Io-7LslhfOmMErfGC6TfVCffR-mZahk0DYIOY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIw1nNa1Twrj368ZpfexZ-skjoUM9SGVMRFtWyhLWwZoA&oe=6ABE7774"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEghw_-Lxj8Q7kNvwHw1wLK&_nc_oc=AdoFLPvYiukVLg2yAU3olybgQ_3KpQkc3a3F4ttl5TC3PJJ0JXvsquVzAKu1aXROCxg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIk2GaZ1FzFTZ9jO7R6XjK5G9Zi7LnmzvwwW2HKY9OBsQ&oe=6ABE71B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-xBZDcfMzMQ7kNvwFYCM8l&_nc_oc=AdqlX_b8C9YwTi-5YM-RS6C7DeKsef5mPCjbWlp3A8U5l0-lVQKJiaOqtH3ayLhoxZ0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJL9vrRfXk3p_sVUbIchwXs4Byi7Kb-sRGVDflx1Pu3qQ&oe=6ABE80CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
}]}, "id": "529731165078104", "locale": "en_US", "screenshots": [{"file_name": "Untitled-1.png", "id": "1440312639635006", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_1440312642968339_2789643189716025521_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kD9PwYhsAnUQ7kNvwGeylmC&_nc_oc=Adp641YDY-ifoqGB6P05qcnA8ZdR_yat9GnE0eJ97cmiSC9OhEmKUxYwbIGZo-LOPIg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjiwlgNpvMb70DQOGTrSekX8-ZUf24S-k5HHgSnQHmYQ&oe=6ACE3C6A"}, {"file_name": "Untitled-4.png", "id": "437567900675752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031645_437567904009085_6070206936841904870_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W17hy1OO23cQ7kNvwH4c9wT&_nc_oc=AdpYOmv-9xMRbgnLM749W2BWkEKplUP20cxWeK0q50hB8G8kjeYnWhlW3mJDpJx9I7A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOj7vgc3-6_jRSdIekOxWNm6Wp9UV01O6xiISUEfz_3Ag&oe=6ACE412C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vASBVSBjtsUQ7kNvwFfMvRg&_nc_oc=AdpcO-uADuvnseOoSjFus6vyCtDUNfsZVcEpr0FucdRnQ0Uvf5KaIXKwPggAzdfpSng&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkvGj38QlhgqXkDUJ0KDAf2MwKFQleWyFDMHIbgj5nAQ&oe=6ACE68EC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-rIiq-QT9YQ7kNvwHdn6Au&_nc_oc=Adp4ZhU611S17yF-6eaXOG1G3TOB-QdEYoQ_dKfPaf_y1KKY8gu6JO_eOJnWw05-oKs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNS-RvB1obBKMkApdcIQ6_jSDBQfPnZ2PNf2jZd0eJlHg&oe=6ACE4974"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4no4RJoGXUcQ7kNvwG_j9tP&_nc_oc=AdqjvUGM1l17dxbd2o4YcAFtd52HbRwo6YioSZUNhqSpZ6yhwMnMOCfE-m9mjgeoZAQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHCtGwrldqlmKwOKDJ7EeBRVM_tetirPAEIe-uf-eTow&oe=6ACE43B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
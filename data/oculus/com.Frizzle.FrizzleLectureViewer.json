}]}, "id": "529731165078104", "locale": "en_US", "screenshots": [{"file_name": "Untitled-1.png", "id": "1440312639635006", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_1440312642968339_2789643189716025521_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQJspURVSLYQ7kNvwH01Hnw&_nc_oc=AdqFQDNjhJ2uOY5sEKhnX7UVGGbW5c1hkCbkooI1fJe_awTsSX7lQOKu7_8H7Xyqwps&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJ-4a60gkLopnmwZdSBduxDd2qLAydTvN9vEjK3MwbXQ&oe=69CE796A"}, {"file_name": "Untitled-4.png", "id": "437567900675752", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031645_437567904009085_6070206936841904870_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76VdIQEktnIQ7kNvwFUDJG_&_nc_oc=Adps_iPIW5S5jk96lxKuHCFhLCaprYM168USku4UyEkhk3mQNXDBpu0Zvs4GdaeGKvI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afywj8x0-NrexqUr0q2miWjUJp0-U4P7pMM_15fQ3yJy4Q&oe=69CE7E2C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rR2SRptf20Q7kNvwGrvFEm&_nc_oc=Adrw1xu_BLAgPbsL58eL9zEmPPGKk7vAp7szbT8T6iE_4zjj0W27_6spIPHq8ZszuD0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzcej-Un3xruMiudzRSShAPWLYQsonbj76bnmeYhzEsZQ&oe=69CE6DAC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fR67eu74IOsQ7kNvwH4vcjh&_nc_oc=AdoX9eCSU9nhYhnW854y9mLGr9WsIQzOZjvpvc8fMTOnp9807pswanJMiJsGselUFFs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw03kYEU8-jDqP2t-rVh2LMOvN8wT-kKmSpAPzZL7W6WQ&oe=69CE4E34"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zofYfiuk10Q7kNvwESKp6h&_nc_oc=AdoDhJAfEkc-S8JSrCWvOLs66PbmIAZSjuUoXA92Aje_-1V7oRslGv40FwkSj-meUp4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0YcZbR3UWA8xD7yxl8FHCVzDUWwxIOXVo7sJz4J1bPg&oe=69CE80B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
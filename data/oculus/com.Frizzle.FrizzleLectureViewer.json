0qkRya9x-iLmXX7J1wMWFaE4eVcGm9chgFLX71SQdtzvIWP78qGWJ2wVKpaM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPtCQXYpnRHeHpyPVk1tvbRM3X6vOPsVLEa5MeMExdrQ&oe=6AEDE52C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76K0dyPLFWoQ7kNvwG1JTdb&_nc_oc=AdrE6FsQdka9-sPAMpuxOLOEMz2oTZ_KL3YMMYH1vHv-YVRt8idOkemuzAVb4OK9eMg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3-6W4ORcfnlBgBMikJ2uXz4WH11zvRPSg2h5TsEFBNw&oe=6AEE0CEC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpOUGVFHShEQ7kNvwGYggus&_nc_oc=AdowbCqBuotyrKE78wkDxjb2ZJ2VMUad8vjP2x9dXB7PUS1c6XVFVwh5gVbzXWH2x8s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHdR0rRWs5aSpotSVM6KHsk-F324C3UnDWZFSJ3jchOA&oe=6AEDED74"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poXv_xn15AAQ7kNvwFDzBNg&_nc_oc=Adpb220UPMyrPSFvzy12qD-RMc2t5XWP45FmtrTICtwytnewCjUW1X-GjlDhaMiYrt4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuxCVQTbzzDm6YGfgwWNUvQTQJa1yfyzadC0uGKIYoZw&oe=6AEDE7B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnHi2abjPjQQ7kNvwFFR243&_nc_oc=Adpx9dfLaOX76qJS9uHIUHIBMnf8AKoklpNl-BTi5L8D3izW3KgoxSMqdR0bToHUHak&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQb5gwjHqBNui2zidjUY_Z0cAiFw4GwSOGBF9lhcILrLA&oe=6AEDF6CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
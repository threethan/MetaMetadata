f25mjJl5R_C3iQdFKV-HRi8wmV-iQjrtIbW-6h2YPWfC1MQFMjuKQq462q9c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RBIR6yFQ8pUSCwGE43SKtf2f1sqFrNFVqW-mgfk6w4A&oe=6A35532C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rsdz0mqqx68Q7kNvwGJFgTi&_nc_oc=Adr3nloZAn1CGX5rXEwRZUWqppVKvBGcGwyU2PpyP5T3s-8xsjHYayK5e-gwSSkYetE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9aqfMsW5K_AGtWKJthc5sWtx5x3hRrUQxBtODkQ03rQ&oe=6A3542AC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2oA4eH4xs8Q7kNvwFDIcfW&_nc_oc=Adr18q9YpWQTrMH5KEjWkKChbygHaLDVP-8ntzkbh2Zg1zvG6SM6qp6n1MA7CRjh-Io&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AEe7MlJuvV3RbG-yugEkP80idWZGfhSH9GmnTRGlh4g&oe=6A355B74"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aB7DVIKWpjsQ7kNvwHki44L&_nc_oc=AdqzktcZ9O6DTZvsRuWL8VVvfPfrz1McUjJHfSKu5EDaEoEWgr7COVBBW1Wg-CuyEqw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ec5acm6DDKtX8dgRlfkJDrm0B3UXZ1w8XjEcu4E50dw&oe=6A3555B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LwmYu5BxyoQ7kNvwHnTrw7&_nc_oc=Adq6udVTokkKr0d2k0otIq6vuMg2atwsDGWJmgpwqGCGxXpjuAdSQM6zLMG2JbjVrCY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pOGctNLOaWgDYULJ_xASJX3ittV59ABQF7Lyj2kes1g&oe=6A3564CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
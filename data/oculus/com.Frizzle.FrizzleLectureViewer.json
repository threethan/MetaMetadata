T-etPj-Rikr2eIEnCj__LIMc5C-jyioWl50Yuw9ZRRjkbC49j9tEZd_AsLrU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bACQfv06B0YV78ahFICgJf3z7D5ABuahx53hg5dhNqw&oe=6A033A2C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6EH1z_5CYUQ7kNvwGRIm0L&_nc_oc=AdowtyoajtIGBWo-l2SBftFCjoes5JQF_C_Sjze2f7hD1ieP6ewFzm64AiVJQ_t9AxE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mBU7oX8lXP5QCsbcCmLrxfh3tu1vtV79HQRwsGB58Rw&oe=6A0329AC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vS0X-TbHG7EQ7kNvwGzyTYo&_nc_oc=AdrCZr5vZfA2mMhucbTBeeebQWgTNFlvEe9ssEGHwntSzWCt-KHCAfgCY0Ao6ToV1Xk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yydR-B0B7BsuRepZTxT1n_zj3t3RdXIRDe1Ue4GZ2_g&oe=6A034274"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVNHXDvbOaoQ7kNvwF76lsS&_nc_oc=AdpYxBPwVNexYJDI5UsvQJk94QYFF7KiNyntORfeuLgCYy6Pfvdvu-juXToqqnGSXcA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aalKrAa3ak0JxbX5G4RGXbYp6_53U6sB6NT08-S7dmA&oe=6A033CB6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4w_C_8eaYUQ7kNvwECOKtb&_nc_oc=AdqigxuUckaZBr_YdtynZSTWYGdQi3AheqyX82kTyijwXc0IkJ2b9OzSpuhgDXMlRf8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SU6a7jasHG8hVSOkIHNUtpHJywePgBftxgSKpz8Ooww&oe=6A034BCF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
Nnf9-HsjWyagiTqh63LofyxM2QVzD7xZqLP8pJ3UHtgqMhGXTgZ71z6h-yUk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPG1VGHgqR9z8NUXjSbUs7dgVmYOZeBNMPnAvzSse_ESQ&oe=6AC3B52C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIkSRHrQx6oQ7kNvwHXRtEs&_nc_oc=AdrED0c_9rLrgQ7kPEWc6n-DzpOnhycnPBuzNHue58kG0pnx1uBihcoinu-i-9u5Qvc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOU5tiT1gLq7s975MHXm1RFa24eBKRKaHw2a4bS0A-Ykw&oe=6AC3A4AC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlDReOBhAH0Q7kNvwFo45XI&_nc_oc=AdpFz1YASQHYMMcbWbIVEmrWPVZjb9ub39SLW9mlbQC2T2Kttvhw3JHT0DX0Cft34EM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8JS1HslQPh7VdNwrE0kBRdcZu-R1M3Ai11g6KJsoiLg&oe=6AC3BD74"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hb_fbJAy6TAQ7kNvwFEXL63&_nc_oc=AdpW-CZG_wRXK0_1ja7ECu1gPGqIyUK6ARcGxYLoaBMLud918Ik2flKeqPGtCs6QBdM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5TfzRxjAX_s3HtpA_6RnbdSnO_CRus2h32JmPdISfmQ&oe=6AC3B7B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=heFKS_8VhZ0Q7kNvwHSzWVR&_nc_oc=Adq-SrsrjNy5j3NliZbXv9HnTAfd0-9GAPE264vep8rUoFvyHEAoM7ibmFlaJmgOB7c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWlCZCokdJaJTE-DZfAqaC3nmbu8kVt9U6vd-NivVtxw&oe=6AC3C6CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
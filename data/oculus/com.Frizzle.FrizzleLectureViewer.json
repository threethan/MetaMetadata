om&oh=00_Afu1ZqZYMjftH0ES-8ge3Qvy7LkEjRaQJ7ogfn5Xp50e3Q&oe=69A1AB2C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1b26gVM2lsQ7kNvwFJ6NzM&_nc_oc=AdmBTn2gQ2Jz-cNYBhPld4GOFW3P0Brr7FkqrJvwDjWtnEXUIhD45mDYF8wMEQtneZg&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuVTAjgWULSkv1eHPrR_YGQYZCBoLLtsE_aI7076xk-UA&oe=69A19AAC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zF4496Qd_iMQ7kNvwG7FRB0&_nc_oc=Adk_VnoCoBMoOlseNv2eFMLwTEBaFe-vtbzK-GCLKO28TjFVWX5j27pB2CnGWMb-uso&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftzhA5_m-_mf2olOyXNpcFSyQ5eXNNwoPMWmXASvi0JMA&oe=69A17B34"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JrDCatJ3ZUQ7kNvwEh0jIk&_nc_oc=AdmrlSCHj9Pf0075iPF9YeasoYgWy7Djh38K86K5cd1xljPP42rUYIra2kk3DAy6uJQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfshTi3THf9xSlh73d4s66nKXhGv4ulEj3xapYASR_BYRw&oe=69A17576"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2L3P6qGw6HgQ7kNvwELvE8Q&_nc_oc=Adk1jao09gEGwxmky68l4457hFRHzkS9dVY_FVp1EhKnlTSZK9ESe6JJ302sV5X2Rw0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afsoa5ckUV0owI1XIE2X3MU06hI6M9NzCci5nuVqWeQQKA&oe=69A1848F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Frizzle Lecture Viewer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics":
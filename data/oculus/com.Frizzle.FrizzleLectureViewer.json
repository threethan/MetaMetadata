7567900675752", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031645_437567904009085_6070206936841904870_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvfcj3Cio4EQ7kNvwEJLXrR&_nc_oc=AdrtJDmNfFOBhhNflcNdiH6xHMpxhy1h_03kAc3LLO2zGWtCUqVF53Unflt5F5Vj5b0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwOQk3A6Iujuk6lefejfhQnV1imxWIqFg1QGKnx6ig_g&oe=6B0486EC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=squPt_nKwLsQ7kNvwFDTr3Y&_nc_oc=Adp9g2HTeDyBZcsH5QQPJz8LHoMo6Zs6IywaQwvuh4S2lAkJVYWfCKy8y8HXAoCOVsw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSpuKhCkusAybG_2cHAQ6WjclfBB534zcQ_MFdpuidww&oe=6B04766C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5f9TlDjgG9gQ7kNvwGwbcIf&_nc_oc=AdqMQfh7MNr3pHlDD7GTo5Dyh5OI3_CyTyUbNS7MQFuH7DYLQJb3m25MRIM4iIaejys&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuuhxhgbzrBYz5LWH_ImzgHArPEYNBGVdVYvNZ082uEQ&oe=6B0456F4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpE_Qaf0cDYQ7kNvwFmha5s&_nc_oc=AdocM3bliZsjycSb-340nPeRpfPuUeutzrwvZETkZhWFn8QVJ0oI_U00irh42ZB8WRM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbA6VAqCnC4epiael0SZc_DdZiAeT7Hdb1x_VEcXBojQ&oe=6B048976"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=
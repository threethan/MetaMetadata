_LNE8cNW2xEe5-O9N3jdX75uHzM1_O6nrMrzsVd-LOetJXCeIx6P-cw27Jm4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx-Azy81E2JCfA5EisjNmw7RhlWzifyMkzPIeIdBg3HPg&oe=69CBDB2C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rR2SRptf20Q7kNvwGM4PHv&_nc_oc=AdrFVnHZw3QCs0YJYZ2vgum8wWyXfYZMhuD20yNQGWmp4isUoAVryY0QDV_qmfJ7w58&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxP9xH1GfE11tcZpqm8aiBwH4tiaA14tifku3iJZOkS6Q&oe=69CBCAAC"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fR67eu74IOsQ7kNvwHe0lup&_nc_oc=Ado0ie2k2N8gzA4lMFHI7amNn_ADJr3TKnfLaBH0fPEru0lQiXiR-KTB1zN9dZOEffQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzuPsfid6nvywRno1fyr_c5qqtvjJVVZ_o_nFsbqItQyQ&oe=69CBAB34"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zofYfiuk10Q7kNvwHa5WTJ&_nc_oc=AdriFXKohdCvLjjXlMka5E9n_0Rf4VFCnff1AQIpqd3h3KGyA7XjheYZUnU6Adlku5M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzgQA3i9rj4JUjSqhoZB_km-FqnP0tPkkaICCOakywAEA&oe=69CBDDB6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dFqTzHs0PEQ7kNvwEdF6PK&_nc_oc=AdrSiFCjr7bYaXL1-ar_LqiomaB2EohxfGq2kWBJKxgIwt9XF0T19EfdG1bTQSxIq5s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxw2tKQhZRHyLucIkiI09YECgnJjS1ShsEDCGRGaeKjig&oe=69CBB48F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
hBsONa_E7DrMi2zhzI4_cfFXkB9mOHNAp5m4W39UTptry22VuxIz6nDttPZw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzzWdvh4snArr2ksgsRtweggFuTgNHbconEio8OE0xXsA&oe=69C543AC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERCuOyGJACYQ7kNvwEZfBp7&_nc_oc=AdpXTCBaX6Ur3qITMyo6hNzi_aO__6TCb_PVZte4-1-w3V1xJFzlg8-MVwmNw6C4UGI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy4RZ-MGk3-jybHsGa1GjfuwPWQEa1Pws6e0OH4dWWSDA&oe=69C5332C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydSUrpxCakgQ7kNvwFer_IT&_nc_oc=Adq1ckWt6xA3RxF6Hj_s7DOH1RmnSDPf9gojzqNEY-vVUK6H-zMXQVm4tUTnHiv5kSY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzAD6ZsCCEXIE9D4t1XxAzbTjdeHkPwxFZsBZcIBil9sQ&oe=69C513B4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYdTS7KLxKoQ7kNvwF7bup4&_nc_oc=AdrEEaTuj-N7CWKZSCDq4RCZCZySC5TzwJcrHw17xqsEHMFXKIEil7dvh0Qx12QyLUE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzS0BTGkRxQp-pA6J-mSdAcEe5bK4DmPnoj-cJPmHeT2w&oe=69C54636"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYj1-oCQ0KwQ7kNvwGqiR5O&_nc_oc=AdqzJnsvMM5yL70kw8Ls0GCGII7EQReCGDR-mbH85Sw8DKact0Ogy1n2XBxHKTMrQnI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwSy7zQsL9sH4hO7Q4_pJAh81ldZydx4dcr1yXLkx9D2w&oe=69C51D0F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
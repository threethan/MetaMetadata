om&oh=00_Afs9qVc9dp8VT-Wo1GEEhx4wAW-8o3YUlBPmzwe_bTqy3Q&oe=699DB6AC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8d_4N0Sj1IYQ7kNvwE43scO&_nc_oc=Adn8-k0hq00r7ZkkLbS2q7dHCV4y8bOGVFtBG14kKdjYtmvXjMVcFhkrkxT2ybKAaQg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvhs5QaQJ_XXbZNVps7ukcDF3dfEyN2E8Zz3J6q2nZZ3Q&oe=699DA62C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMD1b89W0x0Q7kNvwEjHrOn&_nc_oc=AdniJswzLaZC2Na221vFFPu3UcA4JswfHsHu9Kn3Lrr_beLOPVmJPNxMofXLQuMQ8ls&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfueV6ittx7pw1XX6QH_auhcynK4fCYd_I2tfTSMKSiL8A&oe=699D86B4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93asUHlia4wQ7kNvwGiozZA&_nc_oc=AdkooV-dySyB0nmOOEPInFlC1m65jyrZkK5d5GQcSc1UnKxUg9X2a2ooO8XlzXvm5u8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftRcihFMpokR9laCKd-f6waRCSiENmvzoj0hXLF-U0Y-Q&oe=699D80F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eb45y4nOKL8Q7kNvwGvLB84&_nc_oc=AdkcAqPyM6yH_6nsdoL9VW7BBR77ezl3QFLhnBJF13lLd3womh7V_8JuwtZZEaRHtUM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu7KeoOcgGNO1-TXn67mxqT2ZAxi70h5XgBywnpRZq6IQ&oe=699D900F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Frizzle Lecture Viewer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics":
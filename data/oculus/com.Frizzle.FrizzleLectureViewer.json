wit-U8VxNVtLFPNcSTekxuRvtI1tje9yNzKoTZZmOu58nr-Gzo8Js03f3IzA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uyH_7kNWCiXa-1f8rGoqnqoCvAzzHWK5jlKlpmoBHRg&oe=69E244AC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lUx-K7NVcYQ7kNvwGi-fgl&_nc_oc=AdqNnNtiGnvE7gXItMvdVIJI-fZO2Y7HOhZXKesqg3hdT3QmTJ4-YT2a0uE4T4gKix0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bMbwzZ_qbCUHnVHy8yFjCobdKUboLh_WLY3rX_ZIIJQ&oe=69E2342C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxcEtRBW4LEQ7kNvwHbSkrn&_nc_oc=AdrxEDorQxWjFGeNi9pii-z6ZTfaGg2c8CPsmwSxCe9dTa4KrNH2e1PLUs5hStYWHok&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_wxbN-k_JJPIG0H3tChNYZ8pjmknRnKYfjdxzn9WSNw&oe=69E24CF4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQ2V-P_QyEgQ7kNvwEaDLP9&_nc_oc=Adr-Alzo4LeqqvtZiWw6ISo4FHVC5uSFMbZp65dRBg0d7SDCuOzFjRdYBSP1FPildg0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IOpCIeO7HCBfHAAimhdr7fE-T4a04aMK7BvDQ4OfN-g&oe=69E24736"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuIlU_OYYLAQ7kNvwFYkfpk&_nc_oc=Adq3TVnNVzfwe2xE8JcRx6K9GRS43BG5Ehqr4fJwqd41XRrQwI7ZlAz2PcY86YCDdZ4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2b7-Hq8PcJZd25n7ZgQGQdTuGPNhk8z5plMizSTSe7-g&oe=69E21E0F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
qbcdT1ST1fK-XYmtGmhgEPx08xtgCtzU1hKj_sdnYCym_BekX70NibYzRn8o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBx0kQYu4GIeUV-nwcSS600nBFsdNGOsrC0-UvLusAIQ&oe=6A80406C"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-J9OV-JbSk8Q7kNvwHvXPxs&_nc_oc=Ado0kWbmq26RE9VtR0YCgA2_PGyJOtr1BU5uMihMz96ddGCkBvtPG1awJR_xYTI1oTc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGDcM6aYtpCvzJYq6QfmV5iUBr3PSxAmrx47iaTQlXzA&oe=6A80682C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsSJfC6DT1IQ7kNvwHjD_en&_nc_oc=AdphesMKefQrFIEgwGQ4JMk2X-JXk5yrvnQoxiac9MWF1CLsVKYxwBR1598qyLGEeyM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVvIow4uOEjgTMNih57s-vd7eZ5pWC4utkSEEiD0pQEg&oe=6A8048B4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QidydXvUxesQ7kNvwGqrSOp&_nc_oc=AdpZL0lw0KGAZJnOaucMMZrNhY2SzyQMuRbz7x8vhd8L22KrEWkLoKZWkyPtp1ePbYw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsULgzn19EvAVvB8TtbWJinNlb8QMAy-Ux3TH790y-4Q&oe=6A8042F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-P69D0OgJ38Q7kNvwEUk4D_&_nc_oc=AdrBKi85Wlkau6eDOpD5qZHK9DsdnMVp1q25WdOZ2lW9Kv4YMPf--RYyoQ4fGVJYN10&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZ9Ib8YGZ4WJTCzjLUFgorHxLpVHAujNyDIS3hKxflbQ&oe=6A80520F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
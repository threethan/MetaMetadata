}]}, "id": "529731165078104", "locale": "en_US", "screenshots": [{"file_name": "Untitled-1.png", "id": "1440312639635006", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_1440312642968339_2789643189716025521_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THDydJtohAgQ7kNvwF8Bfo-&_nc_oc=AdqWD8sABZXBC5YVlaFhgq8J1VlWBuPd0CYMoHttW3z_fauUSbx9zS3Z9y0-KJgB0-8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAUJ311GeTUIrl6SsP93N1AkCiRfZeUwzwJj-DSBsH5w&oe=6A60CFEA"}, {"file_name": "Untitled-4.png", "id": "437567900675752", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031645_437567904009085_6070206936841904870_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfVsy2mi13EQ7kNvwGXf2We&_nc_oc=Adptk2ZIWIOB6aryfEjPzEv7v_AI0vskdqawT5gPL6Ykyg6B2I3HQnuvV97Z3fauTwc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbwmdYXk9c-94wdt3G1uD3ZZWMJ_lGlrZ1LFnUIAxkzw&oe=6A60D4AC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLUp5HIg84oQ7kNvwHRmTNR&_nc_oc=AdpZzKr7sDeXh7FL1A4fiM-r3uoP1dlrvtiN3G-KLzeTP-2bwcD9VlVU7vyi1tmGMfM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbZ-vIXFMzzt-o7GlDg1t42G6Ly-sEKk03RPr_E35IFQ&oe=6A60C42C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q001Kdj786IQ7kNvwHr9UQR&_nc_oc=Adqm7Hq7FPOV8b8Ea7TENXE9svuj60V9CUNcG1TLSoEU0EtkUNzz3_oAgHroydUOL8I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApG6CoEckPqOfUt-avQGu42Ee4KsRtW3jY99wolHEpkg&oe=6A60A4B4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7ZajjZxWU4Q7kNvwHuSTgQ&_nc_oc=Adoqj8ApkKMaiEFCn4JiXeITYPsEXP40Wt9K5uC85XTj16akDJjVl1efC0hKOW8ethU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIOXOHf0DyeUI7dbRedKDiQOAbdZ9lQWpugdVMndvBuQ&oe=6A60D736"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
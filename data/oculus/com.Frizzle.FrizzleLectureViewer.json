co1auTwtF42MHKkyWkNgFc5QfPiEgfvYV_gD2CE4v3NFrKzsyl_gsRn-Fy3s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8GtUO_FIxbkyXQaRIDaaYiFgVTFp2RXq28YR8LrZq3g&oe=6AAD4BAC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAt9qTli5h0Q7kNvwHOxgSy&_nc_oc=Adoqk1MQZxG3_p_LuAytFbpCWZbd7cwXv7rM0UpmqcBjAKSlUuhPMw3-JWH1FejY1Kg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMCYuGM6eNsPgUadbpzx6H6NP2TRKeMuOYQunZQd61TQ&oe=6AAD3B2C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BM_g_puMBm0Q7kNvwGw6L2U&_nc_oc=AdoW4rgiQSufy5rdEd7dCZIO1E9CtDYByw2fion26SY8QnPoBgC5kL8BtdWbr4-kGTY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1t3TZjwvDY47IzZxnRhoLCdXN3BxEhnnhWII3dT4pfg&oe=6AAD53F4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xyzn3xi9oEgQ7kNvwGqa7i3&_nc_oc=AdpjddOQDP3fvi1NPKYCiETjTzVd5CnMYOyKrwOsI1C3Kkm1b5-_WPbNsg-9iW88KME&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuZigA35BkGAWc6fxW7yB4LUrJkW4BcrSuJpgOd8PNCA&oe=6AAD4E36"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VslFyczMcJkQ7kNvwGtsOCV&_nc_oc=AdqtE0CIN2IWav_sKQJyeHiJnMJT_IAGet5d1eOICI4njqstdqH9oB27TuBvVvlh5Uk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtQ3ttPgiLCmxZE-6Bm54CIt0T45al6NdgvzWNvJLu4A&oe=6AAD5D4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
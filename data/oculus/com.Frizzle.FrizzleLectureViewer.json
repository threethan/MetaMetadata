lw556BT96araBlX7Vwzqx-rCeSAe2-4ZGreJP3XXJVqqXsrxIrsimW7sbBq8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40QQQC25T5HBvFZqYzGUkqZYsFCldlSM0A-ejFFUtWOw&oe=6A0C74AC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yjyn-h0RjpsQ7kNvwHgIF_1&_nc_oc=Adpiyz57nqYhSqkyoccl0uyFIkjciauBqkDIEc-_72k6t6rmWyz-J7K1PYosD7i49Bo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LKzd8slSUnNt84T41pnvtUm3mKIjEp7OYbgUhEo2Evw&oe=6A0C642C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wP-4i2aMoJ4Q7kNvwHjmzr2&_nc_oc=Adp0OVnDCywPS02ZTIUuCZbh3AB0Hy57lKNWBV2g-wgLUjCjrGbXg8DpZWzIH6vnXpc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5y5pyTnZLJBr_o7dL8ctnMtyakfptvCa7bLsI1WgBlOw&oe=6A0C7CF4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MTbZZRXtEoQ7kNvwHjFyV3&_nc_oc=AdqgPW0pi8P6F-KyRSUtAn_uaYfwZuMS3f7nxFuO-QXBo7KDnpOwaPbjVMkg_JK2S78&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7COsB84ble_3TP1_RW_lxkRvqqJqQemjewftARsdfV8A&oe=6A0C7736"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQ0oLCgyPLQQ7kNvwHR8h6-&_nc_oc=Adqx88l6wRBaQmsGn9OB1ACUmuTfdkX6nRbc7Y4WkWlKZTTT02eQBKBEaeLlejRE8OE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5X-1oEV38E34sSN1Ljf0aWta7o72qaPgTp9bNmcMWimw&oe=6A0C864F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
7567900675752", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031645_437567904009085_6070206936841904870_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KUbRn_4YEMQ7kNvwHh79uV&_nc_oc=AdqfZSLRrMh3gMplTT2AuG-EyMeDEeEGYNpnY1M8imlONEI-9c1Wo_8EM1c6nqok2SQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdErLaf_XCvAJpMVvuRvTdcODJnlURfoXZUwCQCj6YNQ&oe=6AFF08AC"}, {"file_name": "Untitled-2.png", "id": "1451456301870326", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86613168_1451456305203659_8932307787953660669_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukuWBDBCGdAQ7kNvwG1tOBT&_nc_oc=Adq0cVdZSpbTZHcdgPB5J5A09qziIgVDXt4wb7GdN6fl8o1ltDLatktEqDI5cxU03R4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcNQGatMKC-CPsayhk14pJ6T98JS1Fp-4vxZvtM30YQw&oe=6AFF306C"}, {"file_name": "Untitled-5.png", "id": "480345453088120", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974677_480345456421453_7810295811982519913_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adn8961_jisQ7kNvwHibYkF&_nc_oc=AdqSWf_6LjDEBqffoX_OQg1cLjDdCLTbQMyK9kKivOeLyNHhRooJvvIh29LQRLUHWb8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDOe7DcWpLaDIQbM9dPIHBdqNBuPBzH9JCapg358Z1tw&oe=6AFF10F4"}, {"file_name": "Untitled-3.png", "id": "301005411467264", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974705_301005414800597_5855659005079602199_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fK88v-SIFsQ7kNvwGT9HFL&_nc_oc=AdpP2C4gW3SBPplzUXK4fsFrtDGiglzP-gLDlHR-SrMVtUPzNVcXu0_W7ZbSqx8-XZs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxR6VdxI76DMx8IfMHJ0YNav9UsfgY6xHVjKf8g27QGg&oe=6AFF0B36"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frizzle Lecture Viewer", "keywords": [], "long_description": "Watch scheduled university lectures in VR!\n\nWatching online lectures on YouTube is difficult. There's way too many distractions, so you end up checking your phone or opening up cat videos in another tab. It's also easy to procrastinate since, you  can always watch a lecture \"later\".\n\nThe mass availability of online lectures is great. But it's still a much worse experience than being in a real lecture hall.\n\nFrizzle lecture viewer is an experiment in a better way to watch online lectures. It's in a VR classroom, so there's no distractions. Also the lectures are scheduled live, so you have to show up at the correct time.\n\nWe're starting off with Havard's Introduction to Computer Science course - CS50. CS50 is one of the most popular computer science courses, over a thousand students have gone through the course on campus and online.", "short_description": "Watch scheduled university lectures in VR!"}]}, "developer_name": "Frizzle", "developer_privacy_policy_url": "https://www.frizzleapp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Frizzle", "support_website_url": null, "website_url": "https://www.frizzleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111891896252733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031617_295535488772830_6422098937568414943_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=
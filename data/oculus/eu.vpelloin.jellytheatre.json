kNvwHSlDTG&_nc_oc=Adqm573kR9OqA7F3-jg576bbhiiayaRTSuubsA0-M8BH_5JW4jgI9GA91OVLgGrm9pM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSMYxZUrNuEgxacjZtrIRyRDtEzUqUYgadkcTV64ZOv7Q&oe=6B0B107C"}, {"file_name": "screenshot-3-series.png", "id": "1404211985204123", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823366_1404211988537456_3185832738215004774_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XHjukYE7ywQ7kNvwHzuq3o&_nc_oc=AdqEM2JEspqhdy1dzoSl-gcCg9NZjrYXuq3TFoZTe2GLc1l_AgQFId7lbL6C5Eh2JwA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR-jWREtGRZF2XA2jo7U5BnVq10HC5FfZ8o3EiQFMWuow&oe=6B0B211F"}, {"file_name": "screenshot-4-environment-station.png", "id": "982933147479863", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825575_982933150813196_1098495751667877981_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwYf9v6OWDsQ7kNvwG85qMY&_nc_oc=AdqBRa2bJUAg0tl0kmeSRe2t2fkcobrvVFr3Xyf05E6DFSfCA-id6Nws6YO1bJXETSc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRjgud4OezNlh26NON9Un3LjD7J6VdiYFYme42RXwGgQQ&oe=6B0B1CCA"}, {"file_name": "screenshot-5-environment-cabin.png", "id": "1524763559413134", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499300725_1524763562746467_764910693733824437_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wDrU5u04KkQ7kNvwHTMo8C&_nc_oc=Adpr-odE8dZb6BngKCpwlfyWYauAIJQIBHBzHJit0FA6x72mkz761Ko8H5MSHaeLkwI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTlL1ZNlb7QqursCt8ECN_NxdfwPnouCTEEx9OrKKPUFw&oe=6B0B4441"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "JellyTheatre", "keywords": ["jellyfin", "media", "movie"], "long_description": "JellyTheatre turns your Meta Quest into a private cinema for your Jellyfin\nmedia server. Sign in with a Quick Connect code (no typing), pick a film and\nwatch it on a giant screen.\n\nPLACES TO WATCH\n- A movie theatre with dimming lights and a screen that lights up the room\n- A home cinema, a lakeside cabin with a crackling fire, the Cupola of a space\n  station floating above the planet, a dark void\n- Your own room in passthrough, with a screen you can place anywhere\n\nYOUR LIBRARY, IN SYNC\n- Continue watching, next up, new movies and shows, favourites, search\n- Seasons and episodes with thumbnails and watched marks\n- Your progress and watched status go back to Jellyfin, so you can pick up on\n  any other device\n\nGENTLE ON YOUR SERVER\n- Plays your files directly whenever the headset can, so your server doesn't\n  have to convert them\n- Shows whether a film plays directly or is being converted\n\nMADE FOR WATCHING\n- Subtitles (text and Blu-ray PGS) with size, style, position and timing\n- Skip intro and credits, chapters, seek bar previews, up-next episodes\n\nREQUIREMENTS\n- A Jellyfin server reachable over HTTPS\n- A Jellyfin account on that server\n\nJellyTheatre is an independent project, not affiliated with the Jellyfin\nproject. It does not provide any content: it plays the media on your own\nserver.\n\nScreenshots show Blender Foundation open movies (Tears of Steel, Sintel,\nCaminandes and others), CC BY, \u00a9 Blender Foundation, studio.blender.org.", "short_description": "Watch your own Jellyfin library on a giant screen: a movie theatre, a home cinema, a lakeside cabin, a space station or your own room in passthrough."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jellytheatre.vpelloin.eu/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "vpelloin", "support_website_url": "https://github.com/valentinp72/JellyTheatre/issues", "website_url": "https://jellytheatre.vpelloin.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "exter
", "id": "2828956927483990", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825503_2828956930817323_589672073038431333_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1psLSTlW-WkQ7kNvwGXEjAs&_nc_oc=AdpFx1vvEVLUuJkUzmqg-l2VV9raxP6zi9RCQxP7YM87M_KbA4OX0bB9elYRtObx8Ds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWI0MfuQwx3hx6BQEOcEnuiWRPAp8do8lnf6EcimSq7g&oe=6AF71FB0"}, {"file_name": "screenshot-2-playing.png", "id": "1754014090065974", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825305_1754014093399307_279176435794436414_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3IxzYZ-z4cQ7kNvwGhwBNr&_nc_oc=Adot9DuHA1E4ExAypIbKYoZSBmUTMNiIQhsywHBwj5X1p5Dm3YRk2UXjV6XwQRFnl_M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2MT_81u9Oqq78Rths9h49-fmhf4FCnm6uHiosD2vOdA&oe=6AF749FC"}, {"file_name": "screenshot-3-series.png", "id": "1404211985204123", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823366_1404211988537456_3185832738215004774_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKY4ECfOGnUQ7kNvwGH-8EF&_nc_oc=Adp4rg77wV39nPFpfY2VskCfST4K15HoZ_D56HrD1rgbu2YT6RvO5RKzP7dhR0zqf9A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-SCedr1qMapUWtD0FaekwKi4hEMs2MLqp_fyyBg24gQ&oe=6AF7225F"}, {"file_name": "screenshot-4-environment-station.png", "id": "982933147479863", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825575_982933150813196_1098495751667877981_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QATNI5QEfoQ7kNvwEX-Yis&_nc_oc=AdoBAopwfuYGgtZCvYZ9Om_RQA0nUHXNLdYkoOZyBm6AXtlyc7MWzG49RnplLfgrMz0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREpFLQFb2oVet_o6sLZB91-En5bNAUFC5BpkuufS7J-A&oe=6AF71E0A"}, {"file_name": "screenshot-5-environment-cabin.png", "id": "1524763559413134", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300725_1524763562746467_764910693733824437_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27MCAg0jKpoQ7kNvwHyShc_&_nc_oc=Adr3Sc0Br9MdMpT6PImT3n6Mch9xdPV7DlfMKl-Ld4lXvyr0XGGy47OBETOtX8HA2pc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS22v2hsjLVPqEglcrjTJ20tidux47ynXwmJWYYB4kb6A&oe=6AF74581"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "JellyTheatre", "keywords": ["jellyfin", "media", "movie"], "long_description": "JellyTheatre turns your Meta Quest into a private cinema for your Jellyfin\nmedia server. Sign in with a Quick Connect code (no typing), pick a film and\nwatch it on a giant screen.\n\nPLACES TO WATCH\n- A movie theatre with dimming lights and a screen that lights up the room\n- A home cinema, a lakeside cabin with a crackling fire, the Cupola of a space\n  station floating above the planet, a dark void\n- Your own room in passthrough, with a screen you can place anywhere\n\nYOUR LIBRARY, IN SYNC\n- Continue watching, next up, new movies and shows, favourites, search\n- Seasons and episodes with thumbnails and watched marks\n- Your progress and watched status go back to Jellyfin, so you can pick up on\n  any other device\n\nGENTLE ON YOUR SERVER\n- Plays your files directly whenever the headset can, so your server doesn't\n  have to convert them\n- Shows whether a film plays directly or is being converted\n\nMADE FOR WATCHING\n- Subtitles (text and Blu-ray PGS) with size, style, position and timing\n- Skip intro and credits, chapters, seek bar previews, up-next episodes\n\nREQUIREMENTS\n- A Jellyfin server reachable over HTTPS\n- A Jellyfin account on that server\n\nJellyTheatre is an independent project, not affiliated with the Jellyfin\nproject. It does not provide any content: it plays the media on your own\nserver.\n\nScreenshots show Blender Foundation open movies (Tears of Steel, Sintel,\nCaminandes and others), CC BY, \u00a9 Blender Foundation, studio.blender.org.", "short_description": "Watch your own Jellyfin library on a giant screen: a movie theatre, a home cinema, a lakeside cabin, a space station or your own room in passthrough."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jellytheatre.vpelloin.eu/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "vpelloin", "support_website_url": "https://github.com/valentinp72/JellyTheatre/issues", "website_url": "https://jellytheatre.vpelloin.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4693777187573090"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823366_1550280833805396_3960617085583054216_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIVidGQ3HjMQ7kNvwELuXNy&_nc_oc=AdrEREgzEtsNRKN-OrdGbr61g3ucrtEsU-_yg00sS2YwJnRunO3R5IMuJ4duh2EiEAc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSj2zhLjNFIvr9Uizc9vbOHs-qJrhJN31KtalkRvzVk4A&oe=6AF719A9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "JellyTheatre", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1792086240, "lastRevision": {"nodes": [{"id": "4688003751483767", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4688003738150435", "i
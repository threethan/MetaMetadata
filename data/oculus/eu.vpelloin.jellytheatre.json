kNvwEFHnTy&_nc_oc=Ado5_BpSraEb4uFKK862dUBELH99DaZiijAOyaMuEcXLkiu4ek_244x8h9pCIPzKRlU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTa5ULxMarYkNB2nRFSNQqbCmOM6uXpUwvUWHVeOk2X2w&oe=6B071BFC"}, {"file_name": "screenshot-3-series.png", "id": "1404211985204123", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823366_1404211988537456_3185832738215004774_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xpFd1koquEQ7kNvwHIquPl&_nc_oc=AdrR_k29tHx82tVrUHJuKzKCVUQ95bQMmrDu-byN4yh0HREKOBRF9V2pIBPpwXp9HbY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzfT132csSGrg0xyGmAIK0QggLJpcaSovLeh6upO7J7A&oe=6B06F45F"}, {"file_name": "screenshot-4-environment-station.png", "id": "982933147479863", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825575_982933150813196_1098495751667877981_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjOi42IyfhQQ7kNvwFhE_W2&_nc_oc=Adq5Wf6EGEQEwK7ZV0YNxx6sAOo-hpGPuFcYVCrrpejYo_5q7crtZwGV1GmZ3_8YI5k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJykjtWFDicBvYD3yGebugrd_knTOBS4mX2fsPT5velw&oe=6B07284A"}, {"file_name": "screenshot-5-environment-cabin.png", "id": "1524763559413134", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300725_1524763562746467_764910693733824437_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbpKB-JF9jQQ7kNvwGZJ-5B&_nc_oc=AdrJSmFa5NGZsOg-Fk1c9GzF2YayKEmxX8ZXCvWzdIN3YTlkNPvOnOJvlA-lGhRqJsw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5tN1KW-9Q3d66p4C7XDViXNeBAlfynvY1kLStKOv_NQ&oe=6B071781"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "JellyTheatre", "keywords": ["jellyfin", "media", "movie"], "long_description": "JellyTheatre turns your Meta Quest into a private cinema for your Jellyfin\nmedia server. Sign in with a Quick Connect code (no typing), pick a film and\nwatch it on a giant screen.\n\nPLACES TO WATCH\n- A movie theatre with dimming lights and a screen that lights up the room\n- A home cinema, a lakeside cabin with a crackling fire, the Cupola of a space\n  station floating above the planet, a dark void\n- Your own room in passthrough, with a screen you can place anywhere\n\nYOUR LIBRARY, IN SYNC\n- Continue watching, next up, new movies and shows, favourites, search\n- Seasons and episodes with thumbnails and watched marks\n- Your progress and watched status go back to Jellyfin, so you can pick up on\n  any other device\n\nGENTLE ON YOUR SERVER\n- Plays your files directly whenever the headset can, so your server doesn't\n  have to convert them\n- Shows whether a film plays directly or is being converted\n\nMADE FOR WATCHING\n- Subtitles (text and Blu-ray PGS) with size, style, position and timing\n- Skip intro and credits, chapters, seek bar previews, up-next episodes\n\nREQUIREMENTS\n- A Jellyfin server reachable over HTTPS\n- A Jellyfin account on that server\n\nJellyTheatre is an independent project, not affiliated with the Jellyfin\nproject. It does not provide any content: it plays the media on your own\nserver.\n\nScreenshots show Blender Foundation open movies (Tears of Steel, Sintel,\nCaminandes and others), CC BY, \u00a9 Blender Foundation, studio.blender.org.", "short_description": "Watch your own Jellyfin library on a giant screen: a movie theatre, a home cinema, a lakeside cabin, a space station or your own room in passthrough."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jellytheatre.vpelloin.eu/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "vpelloin", "support_website_url": "https://github.com/valentinp72/JellyTheatre/issues", "website_url": "https://jellytheatre.vpelloin.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "exter
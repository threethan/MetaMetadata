ent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRjgud4OezNlh26NON9Un3LjD7J6VdiYFYme42RXwGgQQ&oe=6B0B1CCA"}, {"file_name": "screenshot-5-environment-cabin.png", "id": "1524763559413134", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499300725_1524763562746467_764910693733824437_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wDrU5u04KkQ7kNvwHTMo8C&_nc_oc=Adpr-odE8dZb6BngKCpwlfyWYauAIJQIBHBzHJit0FA6x72mkz761Ko8H5MSHaeLkwI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTlL1ZNlb7QqursCt8ECN_NxdfwPnouCTEEx9OrKKPUFw&oe=6B0B4441"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "JellyTheatre", "keywords": ["jellyfin", "media", "movie"], "long_description": "JellyTheatre turns your Meta Quest into a private cinema for your Jellyfin\nmedia server. Sign in with a Quick Connect code (no typing), pick a film and\nwatch it on a giant screen.\n\nPLACES TO WATCH\n- A movie theatre with dimming lights and a screen that lights up the room\n- A home cinema, a lakeside cabin with a crackling fire, the Cupola of a space\n  station floating above the planet, a dark void\n- Your own room in passthrough, with a screen you can place anywhere\n\nYOUR LIBRARY, IN SYNC\n- Continue watching, next up, new movies and shows, favourites, search\n- Seasons and episodes with thumbnails and watched marks\n- Your progress and watched status go back to Jellyfin, so you can pick up on\n  any other device\n\nGENTLE ON YOUR SERVER\n- Plays your files directly whenever the headset can, so your server doesn't\n  have to convert them\n- Shows whether a film plays directly or is being converted\n\nMADE FOR WATCHING\n- Subtitles (text and Blu-ray PGS) with size, style, position and timing\n- Skip intro and credits, chapters, seek bar previews, up-next episodes\n\nREQUIREMENTS\n- A Jellyfin server reachable over HTTPS\n- A Jellyfin account on that server\n\nJellyTheatre is an independent project, not affiliated with the Jellyfin\nproject. It does not provide any content: it plays the media on your own\nserver.\n\nScreenshots show Blender Foundation open movies (Tears of Steel, Sintel,\nCaminandes and others), CC BY, \u00a9 Blender Foundation, studio.blender.org.", "short_description": "Watch your own Jellyfin library on a giant screen: a movie theatre, a home cinema, a lakeside cabin, a space station or your own room in passthrough."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jellytheatre.vpelloin.eu/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "vpelloin", "support_website_url": "https://github.com/valentinp72/JellyTheatre/issues", "website_url": "https://jellytheatre.vpelloin.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4693777187573090"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823366_1550280833805396_3960617085583054216_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJk5EBF7syUQ7kNvwHcJq8x&_nc_oc=AdrzgITxWYUJ4SST3dQgGMu55K1Y_Dq1kZl41llxrvQj52Z2lLJcyMaKnJDnPKLgjEs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR2VREgq4P7k17uNd0Lqq5ZT64z9TJsjkXdT8U0MuUDzg&oe=6B0B1869"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "JellyTheatre", "platform": "ANDROI
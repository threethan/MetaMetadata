", "id": "2828956927483990", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825503_2828956930817323_589672073038431333_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47JYU_hs6YcQ7kNvwGRvMsi&_nc_oc=AdojbfumMOMZZ5l7qB1kR3oJmTYsrLN650H7Yup0pq698hyVW0t-1JxZfOty6UX9ZuM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRWKalgvvLUElfuyF0j2GNbmIsB3KSeHVV8QaQLBpR-w&oe=6AF32B30"}, {"file_name": "screenshot-2-playing.png", "id": "1754014090065974", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825305_1754014093399307_279176435794436414_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdC2prs3hZAQ7kNvwH8sYnW&_nc_oc=AdrQMcLeGOPHIqvDFYwPT3BfRGgrmxXrCSGRhrrqdIGQfBROVarQwkH2vw1nwWy8-tQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdKrxqgb6nu28HqmEBHdlgN5xIqGWR1SfoHjKtxT4Z8Q&oe=6AF3557C"}, {"file_name": "screenshot-3-series.png", "id": "1404211985204123", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823366_1404211988537456_3185832738215004774_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9agmveVlw8Q7kNvwFjsn1g&_nc_oc=AdreUdJgOiFCtFeZTae_hnunHKxLfYC-0L5jcTDUKMc1d_c8lCNCOq_-IyEYJVOOHWU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkdPhg9ufJPgmfnxNkj47oE-cdJLfdrnAFLe0twvXjzQ&oe=6AF32DDF"}, {"file_name": "screenshot-4-environment-station.png", "id": "982933147479863", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825575_982933150813196_1098495751667877981_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxPigrL-8cgQ7kNvwF0kXVX&_nc_oc=AdqVLFnyxoXyq-oUy_1LydJbOit3slaNoSm4sAK4XI0EeAYgQEdf2OmEm_SHytdKNWs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY_e-zD-AUIQbiJuf2RPUMmigSuV5yKx66Ev_g1SCCgA&oe=6AF3298A"}, {"file_name": "screenshot-5-environment-cabin.png", "id": "1524763559413134", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300725_1524763562746467_764910693733824437_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihFVUZXn4xMQ7kNvwFNHF_y&_nc_oc=AdqTmT0LWg4T0R2MYCaXvA4Me7shVOKqVfAG6ndqNvR8HQ9kHCJxj_-gOu4efaNWQ2c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRadjz8xH0J6u5FjgjbfzkjeJYZdkq5Jz11Np5UrQCnEQ&oe=6AF35101"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "JellyTheatre", "keywords": ["jellyfin", "media", "movie"], "long_description": "JellyTheatre turns your Meta Quest into a private cinema for your Jellyfin\nmedia server. Sign in with a Quick Connect code (no typing), pick a film and\nwatch it on a giant screen.\n\nPLACES TO WATCH\n- A movie theatre with dimming lights and a screen that lights up the room\n- A home cinema, a lakeside cabin with a crackling fire, the Cupola of a space\n  station floating above the planet, a dark void\n- Your own room in passthrough, with a screen you can place anywhere\n\nYOUR LIBRARY, IN SYNC\n- Continue watching, next up, new movies and shows, favourites, search\n- Seasons and episodes with thumbnails and watched marks\n- Your progress and watched status go back to Jellyfin, so you can pick up on\n  any other device\n\nGENTLE ON YOUR SERVER\n- Plays your files directly whenever the headset can, so your server doesn't\n  have to convert them\n- Shows whether a film plays directly or is being converted\n\nMADE FOR WATCHING\n- Subtitles (text and Blu-ray PGS) with size, style, position and timing\n- Skip intro and credits, chapters, seek bar previews, up-next episodes\n\nREQUIREMENTS\n- A Jellyfin server reachable over HTTPS\n- A Jellyfin account on that server\n\nJellyTheatre is an independent project, not affiliated with the Jellyfin\nproject. It does not provide any content: it plays the media on your own\nserver.\n\nScreenshots show Blender Foundation open movies (Tears of Steel, Sintel,\nCaminandes and others), CC BY, \u00a9 Blender Foundation, studio.blender.org.", "short_description": "Watch your own Jellyfin library on a giant screen: a movie theatre, a home cinema, a lakeside cabin, a space station or your own room in passthrough."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jellytheatre.vpelloin.eu/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "vpelloin", "support_website_url": "https://github.com/valentinp72/JellyTheatre/issues", "website_url": "https://jellytheatre.vpelloin.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4693777187573090"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823366_1550280833805396_3960617085583054216_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWmWiNlQFqoQ7kNvwH7laoJ&_nc_oc=Ado9ZNstvHhWmMDDm-U3I4rKF8k25h7acE8hAc8n0jvY9E7tXOozwUHVj_nl7Q-Od9A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR42TbfDL3CPc_HEjlngSB_N-kJRzVYyoo8FXyeFTM02g&oe=6AF32529"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "JellyTheatre", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1792086240, "lastRevision": {"nodes": [{"id": "4688003751483767", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4688003738150435", "i
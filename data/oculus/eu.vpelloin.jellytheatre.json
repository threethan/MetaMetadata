kNvwHC13Zs&_nc_oc=AdrboJNYKi1H9ah7488NgmplxK0JM_fQqnW8yG8qU4zEQnA-kO_7Q7m5aCMgYx2jldM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSN5ODp-HYBRP4BNeaMfyXtXIeQjkudKAuVSiui2sDfqw&oe=6B05CA7C"}, {"file_name": "screenshot-3-series.png", "id": "1404211985204123", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823366_1404211988537456_3185832738215004774_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xpFd1koquEQ7kNvwE29DM1&_nc_oc=AdrlyddWQo__OWh5uY8IlNX7cOOFAV8B6rj1c_-qCSCWzYQIkSGuITiSJJf6IhCFK4Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJo-SJB7J20u4ukKRq1e_M_WvtwPkMPflkOrintP0tsQ&oe=6B05A2DF"}, {"file_name": "screenshot-4-environment-station.png", "id": "982933147479863", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825575_982933150813196_1098495751667877981_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjOi42IyfhQQ7kNvwFaRmLZ&_nc_oc=AdpNNRmvvNJ1JNVbx5JK8JfqmUQrWI5zDeQ16gdGc-eaUMWlaqB4TmMpDjmla5SUnOM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxWnn_rIuMSylfADcN13WfB-HzkSOxBSK3HOAwloUt3Q&oe=6B05D6CA"}, {"file_name": "screenshot-5-environment-cabin.png", "id": "1524763559413134", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300725_1524763562746467_764910693733824437_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pWp7RXnbDIQ7kNvwEpXKra&_nc_oc=AdqxODy_bkHFFVYqaJloFeiy6HoZccSmGHGHNqaM8_JT2ZVRuSineajZsgM6fd4SVQg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3ByQLboZoRTH2EO8UeRvWk-A9X0Ea8dOWcbBZMma3Xg&oe=6B05C601"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "JellyTheatre", "keywords": ["jellyfin", "media", "movie"], "long_description": "JellyTheatre turns your Meta Quest into a private cinema for your Jellyfin\nmedia server. Sign in with a Quick Connect code (no typing), pick a film and\nwatch it on a giant screen.\n\nPLACES TO WATCH\n- A movie theatre with dimming lights and a screen that lights up the room\n- A home cinema, a lakeside cabin with a crackling fire, the Cupola of a space\n  station floating above the planet, a dark void\n- Your own room in passthrough, with a screen you can place anywhere\n\nYOUR LIBRARY, IN SYNC\n- Continue watching, next up, new movies and shows, favourites, search\n- Seasons and episodes with thumbnails and watched marks\n- Your progress and watched status go back to Jellyfin, so you can pick up on\n  any other device\n\nGENTLE ON YOUR SERVER\n- Plays your files directly whenever the headset can, so your server doesn't\n  have to convert them\n- Shows whether a film plays directly or is being converted\n\nMADE FOR WATCHING\n- Subtitles (text and Blu-ray PGS) with size, style, position and timing\n- Skip intro and credits, chapters, seek bar previews, up-next episodes\n\nREQUIREMENTS\n- A Jellyfin server reachable over HTTPS\n- A Jellyfin account on that server\n\nJellyTheatre is an independent project, not affiliated with the Jellyfin\nproject. It does not provide any content: it plays the media on your own\nserver.\n\nScreenshots show Blender Foundation open movies (Tears of Steel, Sintel,\nCaminandes and others), CC BY, \u00a9 Blender Foundation, studio.blender.org.", "short_description": "Watch your own Jellyfin library on a giant screen: a movie theatre, a home cinema, a lakeside cabin, a space station or your own room in passthrough."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jellytheatre.vpelloin.eu/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "vpelloin", "support_website_url": "https://github.com/valentinp72/JellyTheatre/issues", "website_url": "https://jellytheatre.vpelloin.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "exter
", "id": "2828956927483990", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825503_2828956930817323_589672073038431333_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ja_6ZIkn_AQQ7kNvwEUfTF8&_nc_oc=AdpjFrdnO11hjVoWjVkjy8MsBu5MvmPoYFgRNoO1uYzJgokG7IUNkypchBotEWJ8cU4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWGXPJU5ezT4xipdp1gpSeUpj1G59eS6bQN1pVxuZw1w&oe=6AEB4230"}, {"file_name": "screenshot-2-playing.png", "id": "1754014090065974", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825305_1754014093399307_279176435794436414_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPEqgqBPHU8Q7kNvwH-S06o&_nc_oc=AdoOYruYbyijI5MaK_ZhxwrR4toI9-Fb1xYB6pWv3tuESVm7xeTMtxdW7FL5xEiOVyk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTPUwb0IiSl1ZDeb2zOqS36dDybA77fSWU6daaBR3jtA&oe=6AEB343C"}, {"file_name": "screenshot-3-series.png", "id": "1404211985204123", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823366_1404211988537456_3185832738215004774_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoubwBhHV8cQ7kNvwHwYCDi&_nc_oc=AdoE4dxkXkigZr6I6BzAD-ZDp6ZP8Alyor-uMUrru2KFDdfFB32kIoStvSbxq6v_6Os&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShP6dKctNjbOI_cUCT4NXfqn5TevMf7xG6cA9d-PLxCA&oe=6AEB44DF"}, {"file_name": "screenshot-4-environment-station.png", "id": "982933147479863", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825575_982933150813196_1098495751667877981_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZvcLZhCQ1wQ7kNvwFBaOMJ&_nc_oc=AdoAfA--i1r3iCK9dqMYM0NpXudvPGK4GcUE5Ck3y3nfUpX10lZ-zOywRUfRhrYBP98&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0vrAJ0XmuFJ4Kkb3DHgFGlvtbtr1DezZz_8ZWWrbuwg&oe=6AEB408A"}, {"file_name": "screenshot-5-environment-cabin.png", "id": "1524763559413134", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300725_1524763562746467_764910693733824437_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyGgpzuYlysQ7kNvwEDGrk3&_nc_oc=AdpUjgT1as_io5tn1TZMqzY4QcUFmypQA8N1hPFfuhvueUcjM6Fk4h0vHytF_OTuYPU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS52SQL1XZqvpEQ6C4mpYsiJKosr36bncox0YoWEO0KbA&oe=6AEB2FC1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "JellyTheatre", "keywords": ["jellyfin", "media", "movie"], "long_description": "JellyTheatre turns your Meta Quest into a private cinema for your Jellyfin\nmedia server. Sign in with a Quick Connect code (no typing), pick a film and\nwatch it on a giant screen.\n\nPLACES TO WATCH\n- A movie theatre with dimming lights and a screen that lights up the room\n- A home cinema, a lakeside cabin with a crackling fire, the Cupola of a space\n  station floating above the planet, a dark void\n- Your own room in passthrough, with a screen you can place anywhere\n\nYOUR LIBRARY, IN SYNC\n- Continue watching, next up, new movies and shows, favourites, search\n- Seasons and episodes with thumbnails and watched marks\n- Your progress and watched status go back to Jellyfin, so you can pick up on\n  any other device\n\nGENTLE ON YOUR SERVER\n- Plays your files directly whenever the headset can, so your server doesn't\n  have to convert them\n- Shows whether a film plays directly or is being converted\n\nMADE FOR WATCHING\n- Subtitles (text and Blu-ray PGS) with size, style, position and timing\n- Skip intro and credits, chapters, seek bar previews, up-next episodes\n\nREQUIREMENTS\n- A Jellyfin server reachable over HTTPS\n- A Jellyfin account on that server\n\nJellyTheatre is an independent project, not affiliated with the Jellyfin\nproject. It does not provide any content: it plays the media on your own\nserver.\n\nScreenshots show Blender Foundation open movies (Tears of Steel, Sintel,\nCaminandes and others), CC BY, \u00a9 Blender Foundation, studio.blender.org.", "short_description": "Watch your own Jellyfin library on a giant screen: a movie theatre, a home cinema, a lakeside cabin, a space station or your own room in passthrough."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jellytheatre.vpelloin.eu/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "vpelloin", "support_website_url": "https://github.com/valentinp72/JellyTheatre/issues", "website_url": "https://jellytheatre.vpelloin.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4693777187573090"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823366_1550280833805396_3960617085583054216_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2fzWUH3hfQQ7kNvwGsHvw9&_nc_oc=AdppnK1MHHs_7DZvqZNhGwXpo7zwEzwxVhoafmF4_9pHyKfdPCPPxWeCCRaw_9CTwc4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStDQiXbZyNfzhGrZW2QgPzxNDOPMTQ5SA808KE9nyYjQ&oe=6AEB3C29"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "JellyTheatre", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1792086240, "lastRevision": {"nodes": [{"id": "4688003751483767", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4688003738150435", "i
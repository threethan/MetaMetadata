pdates and player feedback."}]}, "developer_name": null, "developer_privacy_policy_url": "https://primal-link-privacy-policy.bonto.run/", "developer_terms_of_service_url": null, "publisher_name": "Reworks Studios", "support_website_url": "https://primal-link.bonto.run/", "website_url": "https://primal-link.bonto.run/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "1137825999415105"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499313063_1800040554738816_3016395061148154971_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnqRs-bCIXAQ7kNvwHXwKCk&_nc_oc=Adro47yMwGIkdEHkWrAVS2hwkx7AtZJcySKc871gs3-QPlVt2yckQqLYma39wziVlCs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPKUokj3B6cAckyicqTLWXjigvlgYwyvSzBUS5tbhvww&oe=6A5F58EA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Primal Link", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1780759380, "lastRevision": {"nodes": [{"id": "1133232006541171", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata
=00_AQS81t_IEiKH4S69MqsmeRnGMN5fKkBY8TWTBgXa-dMHFA&oe=6AFC825E"}, {"file_name": "screenshot (1).png", "id": "2182033669057679", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491821796_2182033675724345_3123254008305390526_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8M79Oek0zgQ7kNvwFa2tPh&_nc_oc=AdoQm-tmhIg77i08V3-goGVvixh7wPLDqSoxdOTa53Z_xe_8pgPIhLkPGLEdwcQZLSE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKufoV2Vgb54epraamR8d2oJHnkAMiwLZroJlCvfXsBg&oe=6AFC863A"}, {"file_name": "screenshot (2).png", "id": "1600378031826688", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491824700_1600378038493354_4164601422385651695_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lg0XgvSF6vYQ7kNvwFY1x9k&_nc_oc=Adrs1Y9hfdT6swIjWhFVS3kmgzNbiJac1_Dxh-29legQVtIjSKG4iFTRria1xdzHsFE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFLyeLwXWzUBvSJC6bpEJx-QxziSPiDKT5imNcyPmtaw&oe=6AFC6129"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "1441805081228519", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_1441805084561852_6242885199993355314_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OURAOrJQYW8Q7kNvwHHikLM&_nc_oc=AdrcK2kJmUSIxxUgcCvsd3srFbd_fLcCehYpQLQo4xzKMjiyGIwUmCR-YkFS3EgpHLc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0QCTXhTLs3iRQgOjfgM8D4WRg7kGnxb7_o_A6x3K4nA&oe=6AFC6FD5"}, "display_name": "Forest Construction VR", "keywords": ["forest", "building", "sandbox", "physics", "nature"], "long_description": "Resource extraction: In Forest Construction VR, several basic sources of construction materials are available, such as trees, stones, and clay. You will be able to use various tools to gather them, then divide the collected materials into parts, process them, and use them in construction.\n\nCrafting: The gathered resources can be processed at workstations into various construction elements, such as bricks, planks, beams, and other building components.\n\nConstruction: The construction mechanic allows you to place an object at any angle and in any location, enabling you to build a wide variety of structures such as houses, towers, bridges, and anything else you can imagine using the materials you have gathered and processed.\n\nInteractivity: Forest Construction VR offers players excellent physical interactivity. Players will need to carry, transport, lift, and hold tools and construction materials, which have the necessary physical properties for realistic interaction.\n\nThese key mechanics will help you create unique structures, enjoy the building process, and immerse yourself in the cozy atmosphere of the forest world of the game. Use these opportunities to have a great time.", "short_description": "In Forest Construction VR you will have the opportunity to experience all the joy of free construction with realistic physics, while being in a pleasant forest environment. A sandbox where the only limit is your imagination. Create a simple shelter or a piece of art? It's up to you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1-06ZkGXNGR4bma6Fx-1YpO1VnzJCuYzL_GtepdZBy0o/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "RedLightsStudio", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1-06ZkGXNGR4bma6Fx-1YpO1VnzJCuYzL_GtepdZBy0o/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_
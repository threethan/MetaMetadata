 {"file_name": "Screenshot_4.png", "id": "1909450359688782", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491820470_1909450363022115_6341696849400202071_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3EKHtkzK2MQ7kNvwGerAu0&_nc_oc=Adp1r744JFBPvqWebMKu1gR4iAs2FAS2B-nqMGo8o2N2QubyvWy7WkPbQygBvd0uiGw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aVjSkyKTJ5uEi2sBsV44U-YtxAC01pnHmkf2rEkJN4Q&oe=6A09CB98"}, {"file_name": "Screenshot_3.png", "id": "1375758093962775", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491824012_1375758100629441_8620852822867916391_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5m6wQrA9pYAQ7kNvwG5e9iQ&_nc_oc=AdqI1E5vpN7A3I60Iq88p-uLmQ6FyVNDAW-2jL-ymCH3kHzMLSWkQ1XNMiOIz-o2WPY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xasT8JbSskEH5seWN4ZKvatGpA427V6AJvWlmsUQPfA&oe=6A09B1C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "3D Stunt Bike Extreme Rush VR Ride", "keywords": ["3DBikeStuntVR", "VRBikeRacing", "MotorcycleVRRide", "ExtremeBikeStunts", "VRBikeRacingGame"], "long_description": "Get ready for the ultimate thrill ride in 3D Stunt Bike Extreme Rush VR Ride! Experience heart-pounding action and jaw-dropping stunts in the most immersive VR bike stunt game ever. Race through intense, high-speed tracks, and perform extreme stunts that will test your skills and reflexes.\nWith stunning 3D graphics and realistic VR immersion, feel like you\u2019re truly in the driver\u2019s seat of a stunt bike, pushing the limits of speed and control. From daring jumps and flips to dangerous obstacle courses, every track offers a new challenge to master. The rush of wind, the thrill of speed, and the excitement of defying gravity are all here in virtual reality.\nFeatures:\nExtreme Stunt Bike Challenges: Take on various challenges, from high-speed races to complex stunt courses.\n3D VR Racing: Immerse yourself in a 3D world filled with fast-paced action and breathtaking visuals.\nJaw-Dropping Stunts: Perform flips, jumps, and gravity-defying tricks in VR.\nMultiple Tracks: Race through a variety of environments, each more challenging than the last.\nAdrenaline-Fueled Action: Feel the thrill with every stunt and every second of the race.\n3D Stunt Bike Extreme Rush VR Ride is not just a game \u2013 it\u2019s an experience. Whether you\u2019re a seasoned stunt rider or a newcomer to VR, this game will push your limits and give you a rush like no other. Are you ready to ride, stunt, and race in the most extreme VR experience available?", "short_description": "Ride in 3D Stunt Bike Extreme Rush VR! Master crazy stunts, race on challenging tracks, and feel the adrenaline rush in stunning VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/3dstunt-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Horizon Hub", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonhubcom/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25755910020705118"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491822818_3989214748035576_5865448308553981865_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PSIlDNTWpcQ7kNv
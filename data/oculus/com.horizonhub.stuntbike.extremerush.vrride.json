, {"file_name": "Screenshot_4.png", "id": "1909450359688782", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820470_1909450363022115_6341696849400202071_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zecSx8QjCJUQ7kNvwGUbI79&_nc_oc=AdqiP4KxwoxB_4bD-H4mL4XcHzOuv_alFMvvWnT80Tr7_UJEgndCArXvPr4FCb_6xJU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPYVx68GXEjkIH3XSsZC_B89QC06Dh2I69DK49tZrA2w&oe=6AE20198"}, {"file_name": "Screenshot_3.png", "id": "1375758093962775", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824012_1375758100629441_8620852822867916391_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtCAY8TEWDYQ7kNvwFH5dBr&_nc_oc=Adq0mRlOpYwpaQHE3uvB6poQ5iPMuxncQ27piD4IuX017V3rRDoxKb8zr6P_4MyDsb4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKYHrMN067x6nnp5sZCJHORMnhWjOlNwg2papvAvp6Dg&oe=6AE1E7C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "3D Stunt Bike Extreme Rush VR Ride", "keywords": ["3DBikeStuntVR", "VRBikeRacing", "MotorcycleVRRide", "ExtremeBikeStunts", "VRBikeRacingGame"], "long_description": "Get ready for the ultimate thrill ride in 3D Stunt Bike Extreme Rush VR Ride! Experience heart-pounding action and jaw-dropping stunts in the most immersive VR bike stunt game ever. Race through intense, high-speed tracks, and perform extreme stunts that will test your skills and reflexes.\nWith stunning 3D graphics and realistic VR immersion, feel like you\u2019re truly in the driver\u2019s seat of a stunt bike, pushing the limits of speed and control. From daring jumps and flips to dangerous obstacle courses, every track offers a new challenge to master. The rush of wind, the thrill of speed, and the excitement of defying gravity are all here in virtual reality.\nFeatures:\nExtreme Stunt Bike Challenges: Take on various challenges, from high-speed races to complex stunt courses.\n3D VR Racing: Immerse yourself in a 3D world filled with fast-paced action and breathtaking visuals.\nJaw-Dropping Stunts: Perform flips, jumps, and gravity-defying tricks in VR.\nMultiple Tracks: Race through a variety of environments, each more challenging than the last.\nAdrenaline-Fueled Action: Feel the thrill with every stunt and every second of the race.\n3D Stunt Bike Extreme Rush VR Ride is not just a game \u2013 it\u2019s an experience. Whether you\u2019re a seasoned stunt rider or a newcomer to VR, this game will push your limits and give you a rush like no other. Are you ready to ride, stunt, and race in the most extreme VR experience available?", "short_description": "Ride in 3D Stunt Bike Extreme Rush VR! Master crazy stunts, race on challenging tracks, and feel the adrenaline rush in stunning VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/3dstunt-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Horizon Hub", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonhubcom/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25755910020705118"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822818_3989214748035576_5865448308553981865_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBMrVPpWc0oQ7kN
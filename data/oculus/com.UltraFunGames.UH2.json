ng", "id": "1237642598532612", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821682_1237642605199278_3311663350936593121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0nLonlDMqYQ7kNvwELFbpN&_nc_oc=Adm8yunNqhLqQ3FOnqNHg_XF0pd0HQeHOU0VPtq7Q5DeEnaFeOe-tCUs7G7at6GXr_c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9_EHeg3aPg-WlP4AImyFNrRnDcFANvx6Q0DsuTKBlRQ&oe=69AD5C2A"}, "display_name": "ULTRA HEIGHT 121 BUNDLE", "keywords": ["VRClimbing", "UltraHeight", "Flying", "Climbing", "WebSwinging"], "long_description": "ULTRA HEIGHT 121 BUNDLE takes VR climbing to new heights with 121+ intense challenges across 11 massive worlds. Inspired by Ultra Height: Mist City Climb, this game combines grapple gun action, web-swinging, and extreme flying for a heart-pounding vertical adventure. Master climbing, moving platforms, ziplining, jet rockets, parachute jumps, and gravity-defying stunts. Conquer skyscrapers, cliffs, and futuristic cities as you swing like a superhero and soar through the skies.\n\n\ud83d\uddfb Key Features:\n\nPlank Walking \u2013 Conquer extreme heights step by step.\n\nClimbing \u2013 Scale skyscrapers, cliffs and impossible structures.\n\nJet Rocket Flying \u2013 Blast through the skies at insane speed.\n\nGrapple Gun Swinging \u2013 Swing between towers like a true hero.\n\nGravity Gun Experiences \u2013 Jump and Slow Down Gravity\n\nHang Glider Flights \u2013 Glide across massive open skies.\n\nParachute Base Jumps \u2013 Leap from dizzying heights above the clouds.\n\nFlying Platforms \u2013 Jump and traverse floating structures.\n\nZiplining \u2013 Slide across the skyline at high speed.\n\nMixed Challenges \u2013 Combine mechanics in intense vertical trials.\n\nFree Exploration \u2013 Roam freely and discover hidden routes.\n\n\n\ud83d\uddfa\ufe0f Explore 11 Massive Maps:\n\nCyber City\n\nIndoor Playground\n\nOutdoor Playground\n\nNew Mist City\n\nRocky Mountains\n\nHigh Playground\n\nNew Sky City\n\nAntenna Isle\n\nPrivate Island\n\nThe Ultra Mall\n\nSky Bay\n\n\u26a0\ufe0f Warning: Stay above the fog or the game restarts. Don\u2019t look down!", "short_description": "ULTRA HEIGHT 121 BUNDLE is the ultimate VR climbing, flying, and web-swinging challenge. Conquer 121+ intense challenges using grapple guns, jet rockets, ziplines,  parachute and hang gliders. Explore 11 massive maps, from skyscrapers to mountain peaks. Master gravity-defying stunts. Test your limits in the most extreme vertical VR game ever! Don't fall \u2013 the sky is your playground!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ultrafungames.com/privacy-policy-oculus/", "developer_terms_of_service_url": null, "publisher_name": "Ultra Fun Games", "support_website_url": null, "website_url": "https://www.ultrafungames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26404094972542786"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819281_4315881892012124_2246658015070415063_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZXzY28dvTEQ7kNvwGyEHaF&_nc_oc=AdluqzWAwsPS3fUYToFTIMzI6QmaUcOWo0qx_CN2lIaTsiW7WgXg869ChYF3pVKlsa4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxtuO3unx_WESR8nOIM5R0SWTK_gUxvyH8g_P836xPDbQ&oe=69AD51FD"
ungamesuh2-20230904-221614_2560x1440.png", "id": "606058561790004", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819942_606058565123337_5288110718287674824_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnzv0ytQnGEQ7kNvwEDM8K3&_nc_oc=Adq3ZE884Uk4wfEa7Oa8EGB66Fjf2iB-zXTp3WA0M-jNQqs9C72kPZbKnF1Nyq_lX0k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJu1XBX_VF0oNkjdxrH0urBQkeQG-zAG9mXrMG8uyQN_w&oe=6AB90AEB"}, {"file_name": "comultrafungamesuh2-20230904-214538_2560x1440.png", "id": "3862164284096430", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391826_3862164290763096_6169609672159070790_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uD2hQWwo7egQ7kNvwEQ0XPz&_nc_oc=Adqipp-mrj968yEQncUFjaC3fOyGP03HeWfuPwwb5PrpUXY1asKHYtc2ZQe8uUyeJys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRmkxjRvNR3xUWKRZH-3SjuIVyADK8eBrYWSK3kPBBCw&oe=6AB93C19"}, {"file_name": "sky-bay-4_2560x1440.png", "id": "1028472436127624", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393602_1028472439460957_4727439774339542090_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxXR6Npd3m8Q7kNvwGzjZqZ&_nc_oc=AdonyXEUk11IoAGrSbscKt45UnEKCrk4ukfi7Q88Q-lUgdnjuPubQaVMHtD4PjrN77M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZInBgy6FI4qGjlNv5BeXJUadqS-4MOgr_o5u6cJ7bZA&oe=6AB91CFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UH2_2560x1440.png", "id": "1225415472517646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391769_1225415475850979_2162465729579857920_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BT4FHfUcP9MQ7kNvwFTNQkR&_nc_oc=AdqFbA62qqfybiEUSVuHJXiX370xaRnMpB-PmfZJbwNZNZawt-kNryiyKpnHSGjPHJA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkjoeqIWcvLWAEvU7TP2Y-RfrMQr54LJuzARLgOAz7jw&oe=6AB91462"}, "display_name": "ULTRA HEIGHT 2", "keywords": ["VRClimbing", "UltraHeight", "Flying", "Climbing", "WebSwinging"], "long_description": "Ultra Height 2 takes VR climbing to new heights with 100+ intense challenges across 10 massive worlds. Inspired by Ultra Height: Mist City Climb, this game combines grapple gun action, web-swinging, and extreme flying for a heart-pounding vertical adventure. Master climbing, moving platforms, ziplining, jet rockets, parachute jumps, and gravity-defying stunts. Conquer skyscrapers, cliffs, and futuristic cities as you swing like a superhero and soar through the skies.\n\n\ud83d\uddfb Key Features:\n\nGrapple Gun and Web-Swinging \u2013 Fly through the air like a true hero.\n\nJet Rockets and Wingsuits \u2013 Blast through the skies at extreme speeds.\n\nZipline and Parachute Jumps \u2013 Defy gravity and dive from dizzying heights.\n\nFree Exploration Mode \u2013 Roam freely, uncover secrets, and find hidden tools.\n\nGlobal Leaderboards \u2013 Compete for the top spot and earn exclusive rewards.\n\n\ud83d\uddfa\ufe0f Explore 10 Massive Maps:\n\nIndoor Playground\n\nOutdoor Playground\n\nNew Mist City\n\nRocky Mountains\n\nHigh Playground\n\nNew Sky City\n\nAntenna Isle\n\nPrivate Island\n\nThe Ultra Mall\n\nSky Bay\n\n\u26a0\ufe0f Warning: Stay above the fog or the game restarts. Don\u2019t look down!", "short_description": "Ultra Height 2 is the ultimate VR climbing, flying, and web-swinging challenge. Conquer 100+ intense obstacles using grapple guns, jet rockets, ziplines,  parachute and hang gliders. Explore 10 massive maps, from skyscrapers to mountain peaks. Master gravity-defying stunts, discover hidden tools, and dominate global leaderboards. Test your limits in the most extreme vertical VR game ever. Don't fall \u2013 the sky is your playground!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ultrafungames.com/privacy-policy-oculus/", "developer_terms_of_service_url": null, "publisher_name": "Ultra Fun Games", "support_website_url": null, "website_url": "https://www.ultrafungames.com/", "category": null, "comfort_rating": "COMFOR
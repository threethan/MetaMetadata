_sid=6e7a0a&_nc_ohc=B3DAOrYYmeQQ7kNvwENv91Q&_nc_oc=Adn9LN-uhS80v1DeOz9APjpw-gE5p9kJIqDW97DLLQ-9ftu2pkKu1x80XZCtRXo-lLU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftQe-csTnUtpLFNYbljQtiuDl3-P2Ld_jF0L0dM8KLQVQ&oe=69A6C078"}, {"file_name": "comultrafungamesuh2-20230904-221614_2560x1440.png", "id": "606058561790004", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819942_606058565123337_5288110718287674824_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CL8ubT1Tx9sQ7kNvwER24gS&_nc_oc=AdlaT79xzch75VF9pGqN7Cx-WH8uO-AsVzRd7n5hJIvkEYER6PenGjsIZ2QWmNCpzqg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsz-fhXdm_gys4VgA7tSZtH-K_eZaei2jwWajeUlGRg7g&oe=69A6D2EB"}, {"file_name": "comultrafungamesuh2-20230904-214538_2560x1440.png", "id": "3862164284096430", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391826_3862164290763096_6169609672159070790_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Jiqao7W-IUQ7kNvwF81q12&_nc_oc=Adn8FpywAc3tQYv1Q0ZvmBnDDsvpTbq5vAz20hbz9RD6TZlt2CxyZ_oZaeUf2xaJOkA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfulHqlRCaNjjYYDy67jd_44Rg9bu4UVK68Oa9nO5L2YEg&oe=69A6CBD9"}, {"file_name": "sky-bay-4_2560x1440.png", "id": "1028472436127624", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393602_1028472439460957_4727439774339542090_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5o5ZZ6CEAsQ7kNvwFCymz3&_nc_oc=AdlIvKoRulDh8uy78YR1GXy6hQmU7lkD7yvY5gZrMkUjzE6e7Qc4P9U2tGmXYEckOWc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfunzBs_1zpbl4LFHoAih1Q778Pmv4raWrvUorco6dYhgg&oe=69A6E4FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UH2_2560x1440.png", "id": "1225415472517646", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391769_1225415475850979_2162465729579857920_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uS41iHUWsokQ7kNvwEfuJ05&_nc_oc=Adld4p1QALbOgGzz-ilWzgyMbcm36DZ9V1hHqA3vM3EIsNXkFKPPZbs-tFYtfTxXhBg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftozT1CVfiC00S0QzoDEhiZOje3dovuKU0azjVUH6w3zw&oe=69A6DC62"}, "display_name": "ULTRA HEIGHT 2", "keywords": ["VRClimbing", "UltraHeight", "Flying", "Climbing", "WebSwinging"], "long_description": "Ultra Height 2 takes VR climbing to new heights with 100+ intense challenges across 10 massive worlds. Inspired by Ultra Height: Mist City Climb, this game combines grapple gun action, web-swinging, and extreme flying for a heart-pounding vertical adventure. Master climbing, moving platforms, ziplining, jet rockets, parachute jumps, and gravity-defying stunts. Conquer skyscrapers, cliffs, and futuristic cities as you swing like a superhero and soar through the skies.\n\n\ud83d\uddfb Key Features:\n\nGrapple Gun and Web-Swinging \u2013 Fly through the air like a true hero.\n\nJet Rockets and Wingsuits \u2013 Blast through the skies at extreme speeds.\n\nZipline and Parachute Jumps \u2013 Defy gravity and dive from dizzying heights.\n\nFree Exploration Mode \u2013 Roam freely, uncover secrets, and find hidden tools.\n\nGlobal Leaderboards \u2013 Compete for the top spot and earn exclusive rewards.\n\n\ud83d\uddfa\ufe0f Explore 10 Massive Maps:\n\nIndoor Playground\n\nOutdoor Playground\n\nNew Mist City\n\nRocky Mountains\n\nHigh Playground\n\nNew Sky City\n\nAntenna Isle\n\nPrivate Island\n\nThe Ultra Mall\n\nSky Bay\n\n\u26a0\ufe0f Warning: Stay above the fog or the game restarts. Don\u2019t look down!", "short_description": "Ultra Height 2 is the ultimate VR climbing, flying, and web-swinging challenge. Conquer 100+ intense obstacles using grapple guns, jet rockets, ziplines,  parachute and hang gliders. Explore 10 massive maps, from skyscrapers to mountain peaks. Master gravity-defying stunts, discover hidden tools, and dominate global leaderboards. Test your limits in the most extreme vertical VR game ever. Don't fall \u2013 the sky is your playground!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ultrafungames.com/privacy-policy-ocu
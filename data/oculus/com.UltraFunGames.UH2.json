ungamesuh2-20230904-221614_2560x1440.png", "id": "606058561790004", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819942_606058565123337_5288110718287674824_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bna8y9xK0GQQ7kNvwH6BxjQ&_nc_oc=Adq2q5DvWyYrrOtS-HR6pTjewFwhmybPTv0UeVWlfSoszDcKIRvbRfU8dQq0Hg-6lMg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rjQqgLRSsDZMHa0IU4p2BUCCla-I-czjlBWCKt_E6eQ&oe=69F9E16B"}, {"file_name": "comultrafungamesuh2-20230904-214538_2560x1440.png", "id": "3862164284096430", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391826_3862164290763096_6169609672159070790_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRX-_bqWMnEQ7kNvwFD1TAd&_nc_oc=AdrddtJBluPPQnFrN6sgRg3RLqjAWaKXvRQ_87tA6u-K8X8c7DucnO5vQCfi0Hlncpg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EaoOWYv5rH8zhujkiUUaHCHQ6Tr89XlKt45RqTUq41A&oe=69FA1299"}, {"file_name": "sky-bay-4_2560x1440.png", "id": "1028472436127624", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393602_1028472439460957_4727439774339542090_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KkacUsyl-2kQ7kNvwGqvJD1&_nc_oc=AdrVRN4rz6YxAW99LwwzFl7GHxBsdSL2jaWq8Yge4nCOfvhnPPR1SAWkTk3jh8lchNQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7M5D8GDkC-l_I0Seys6ozKcAQaUYAWEJ4FThLEF21ujw&oe=69F9F37A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UH2_2560x1440.png", "id": "1225415472517646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391769_1225415475850979_2162465729579857920_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnwPC1ch40YQ7kNvwGqorLv&_nc_oc=AdqBEF1S9SNioLAuj9xH-_eA4zq8izG0ydk_fwdK6scoLVL1-NqU-Qyj5loi6cRHHBI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6U4dThWJRVojycv2Mg5nQgjo-qgN7lbFTLXGzkHHq4fg&oe=69F9EAE2"}, "display_name": "ULTRA HEIGHT 2", "keywords": ["VRClimbing", "UltraHeight", "Flying", "Climbing", "WebSwinging"], "long_description": "Ultra Height 2 takes VR climbing to new heights with 100+ intense challenges across 10 massive worlds. Inspired by Ultra Height: Mist City Climb, this game combines grapple gun action, web-swinging, and extreme flying for a heart-pounding vertical adventure. Master climbing, moving platforms, ziplining, jet rockets, parachute jumps, and gravity-defying stunts. Conquer skyscrapers, cliffs, and futuristic cities as you swing like a superhero and soar through the skies.\n\n\ud83d\uddfb Key Features:\n\nGrapple Gun and Web-Swinging \u2013 Fly through the air like a true hero.\n\nJet Rockets and Wingsuits \u2013 Blast through the skies at extreme speeds.\n\nZipline and Parachute Jumps \u2013 Defy gravity and dive from dizzying heights.\n\nFree Exploration Mode \u2013 Roam freely, uncover secrets, and find hidden tools.\n\nGlobal Leaderboards \u2013 Compete for the top spot and earn exclusive rewards.\n\n\ud83d\uddfa\ufe0f Explore 10 Massive Maps:\n\nIndoor Playground\n\nOutdoor Playground\n\nNew Mist City\n\nRocky Mountains\n\nHigh Playground\n\nNew Sky City\n\nAntenna Isle\n\nPrivate Island\n\nThe Ultra Mall\n\nSky Bay\n\n\u26a0\ufe0f Warning: Stay above the fog or the game restarts. Don\u2019t look down!", "short_description": "Ultra Height 2 is the ultimate VR climbing, flying, and web-swinging challenge. Conquer 100+ intense obstacles using grapple guns, jet rockets, ziplines,  parachute and hang gliders. Explore 10 massive maps, from skyscrapers to mountain peaks. Master gravity-defying stunts, discover hidden tools, and dominate global leaderboards. Test your limits in the most extreme vertical VR game ever. Don't fall \u2013 the sky is your playground!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ultrafungames.com/privacy-policy-oculus/", "developer_terms_of_service_url": null, "publisher_name": "Ultra Fun Games", "support_website_url": null, "website_url": "https://www.ultrafungames.com/", "category": null, "comfort_rating": "COMFOR
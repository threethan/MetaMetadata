rzz1mZXsA5emwPL1ihKAGKSmsapXEdDZdKXNjuOZvKl4z_Lc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwkpm0dlBNP-gTOJXZ6KmSiunzO4ZlRiJCHf7CJUGUW_Q&oe=69AD6359"}, {"file_name": "sky-bay-4_2560x1440.png", "id": "1028472436127624", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393602_1028472439460957_4727439774339542090_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SunxoiOuorIQ7kNvwFisJIk&_nc_oc=AdllLgVMcs8JkJymC_vqrKmqfvATqVZlPt-2OpNtLZtOFvE4A0ucA02mrqQ90dZQme0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxe-nhQC8Apuyy7BKMtISb-ZbVuC4qvf2xjlIkWVxvxYw&oe=69AD7C7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UH2_2560x1440.png", "id": "1225415472517646", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391769_1225415475850979_2162465729579857920_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SR5nsE8ArMQ7kNvwEkPpDG&_nc_oc=AdkNivOVZMR3CE9z58Fqo5NYavSTF2e5w6t17MX5ZVp4ByHCWXwzgc8u4nF6MeEwVvY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxfW7TkgWKLXw29q9ewcJUub_CBm22gHHoJJrASND3soA&oe=69AD73E2"}, "display_name": "ULTRA HEIGHT 2", "keywords": ["VRClimbing", "UltraHeight", "Flying", "Climbing", "WebSwinging"], "long_description": "Ultra Height 2 takes VR climbing to new heights with 100+ intense challenges across 10 massive worlds. Inspired by Ultra Height: Mist City Climb, this game combines grapple gun action, web-swinging, and extreme flying for a heart-pounding vertical adventure. Master climbing, moving platforms, ziplining, jet rockets, parachute jumps, and gravity-defying stunts. Conquer skyscrapers, cliffs, and futuristic cities as you swing like a superhero and soar through the skies.\n\n\ud83d\uddfb Key Features:\n\nGrapple Gun and Web-Swinging \u2013 Fly through the air like a true hero.\n\nJet Rockets and Wingsuits \u2013 Blast through the skies at extreme speeds.\n\nZipline and Parachute Jumps \u2013 Defy gravity and dive from dizzying heights.\n\nFree Exploration Mode \u2013 Roam freely, uncover secrets, and find hidden tools.\n\nGlobal Leaderboards \u2013 Compete for the top spot and earn exclusive rewards.\n\n\ud83d\uddfa\ufe0f Explore 10 Massive Maps:\n\nIndoor Playground\n\nOutdoor Playground\n\nNew Mist City\n\nRocky Mountains\n\nHigh Playground\n\nNew Sky City\n\nAntenna Isle\n\nPrivate Island\n\nThe Ultra Mall\n\nSky Bay\n\n\u26a0\ufe0f Warning: Stay above the fog or the game restarts. Don\u2019t look down!", "short_description": "Ultra Height 2 is the ultimate VR climbing, flying, and web-swinging challenge. Conquer 100+ intense obstacles using grapple guns, jet rockets, ziplines,  parachute and hang gliders. Explore 10 massive maps, from skyscrapers to mountain peaks. Master gravity-defying stunts, discover hidden tools, and dominate global leaderboards. Test your limits in the most extreme vertical VR game ever. Don't fall \u2013 the sky is your playground!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ultrafungames.com/privacy-policy-oculus/", "developer_terms_of_service_url": null, "publisher_name": "Ultra Fun Games", "support_website_url": null, "website_url": "https://www.ultrafungames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23956222577330050"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHE
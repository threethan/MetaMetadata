_sid=6e7a0a&_nc_ohc=7lYz0LZhL3UQ7kNvwE_3C3-&_nc_oc=AdnwrszjjcBlNo6VXAnH2H-aNxqU2JRHhWDisUtY0hK6kr8-gD0jXYk39OsiQvpIvig&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfszQqgnZFnZwbWp4DNXF2yL8VQJJBoMRMeJgu3wVNAaIA&oe=699AE2F8"}, {"file_name": "comultrafungamesuh2-20230904-221614_2560x1440.png", "id": "606058561790004", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819942_606058565123337_5288110718287674824_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Tpm5lrIyqcQ7kNvwGHdee2&_nc_oc=Adl48STKofYpVjJX3lLy-FmHwPjuKLnNxFCKsMk-OmVVTbDLXfeAG3ccaL7yt7r5yGo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs4xJDpp7CnnGmxujykozcREUmhG-FQem6RBqg6KdF5fw&oe=699AF56B"}, {"file_name": "comultrafungamesuh2-20230904-214538_2560x1440.png", "id": "3862164284096430", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391826_3862164290763096_6169609672159070790_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PYme5rw4eYQ7kNvwGSv88i&_nc_oc=Admg-9A9LgIT7BV0l9ROtzidWjjDXfSMNDdKrS26i4YtIdbijTAFk82fn-r_v6iVU2c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afthbot_OonxsIvPUDLebfQFliYDWAe4OCsBzoPru5zkEA&oe=699AEE59"}, {"file_name": "sky-bay-4_2560x1440.png", "id": "1028472436127624", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393602_1028472439460957_4727439774339542090_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vi3yYIQtLgoQ7kNvwFh48GV&_nc_oc=Adl-4lrISl996wpyKVXzz1h6oRjbdYkJeAZu8qjyrhi6ow-CAhg8Ue3mtyNZGOz51fk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfteiIFeaay6FQUIpvlK-9tJnXBVkypVN0ts7t8UKP3ZEw&oe=699B077A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UH2_2560x1440.png", "id": "1225415472517646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391769_1225415475850979_2162465729579857920_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsZdPaUGiqUQ7kNvwHdvxHH&_nc_oc=Adn_deqyVeceneCFJ_fADbC5K2kofMlAde15oCx1SsuynaoZqt0HO7O-7rUY6ZBuprw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsC9gqEYA2RXX9JOwvuH9OuTksYSsTKBo82usq8EQEfTg&oe=699AFEE2"}, "display_name": "ULTRA HEIGHT 2", "keywords": ["VRClimbing", "UltraHeight", "Flying", "Climbing", "WebSwinging"], "long_description": "Ultra Height 2 takes VR climbing to new heights with 100+ intense challenges across 10 massive worlds. Inspired by Ultra Height: Mist City Climb, this game combines grapple gun action, web-swinging, and extreme flying for a heart-pounding vertical adventure. Master climbing, moving platforms, ziplining, jet rockets, parachute jumps, and gravity-defying stunts. Conquer skyscrapers, cliffs, and futuristic cities as you swing like a superhero and soar through the skies.\n\n\ud83d\uddfb Key Features:\n\nGrapple Gun and Web-Swinging \u2013 Fly through the air like a true hero.\n\nJet Rockets and Wingsuits \u2013 Blast through the skies at extreme speeds.\n\nZipline and Parachute Jumps \u2013 Defy gravity and dive from dizzying heights.\n\nFree Exploration Mode \u2013 Roam freely, uncover secrets, and find hidden tools.\n\nGlobal Leaderboards \u2013 Compete for the top spot and earn exclusive rewards.\n\n\ud83d\uddfa\ufe0f Explore 10 Massive Maps:\n\nIndoor Playground\n\nOutdoor Playground\n\nNew Mist City\n\nRocky Mountains\n\nHigh Playground\n\nNew Sky City\n\nAntenna Isle\n\nPrivate Island\n\nThe Ultra Mall\n\nSky Bay\n\n\u26a0\ufe0f Warning: Stay above the fog or the game restarts. Don\u2019t look down!", "short_description": "Ultra Height 2 is the ultimate VR climbing, flying, and web-swinging challenge. Conquer 100+ intense obstacles using grapple guns, jet rockets, ziplines,  parachute and hang gliders. Explore 10 massive maps, from skyscrapers to mountain peaks. Master gravity-defying stunts, discover hidden tools, and dominate global leaderboards. Test your limits in the most extreme vertical VR game ever. Don't fall \u2013 the sky is your playground!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ultrafungames.com/privacy-policy-oculus/", "developer_terms_of_service_url": null, "publisher_name": "Ultra Fun Games", "support_website_url": null, "website_url": "https://www.ultrafungames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23956222577330050"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1467263217800320"}, {"status": "PUBLISHED", "id": "1197595922466524"}, {"status": "PUBLISHED", "id": "2024516217927934"}]}, "baseline_offer": {"id": "1467263217800320"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1767529920, "status": "PUBLISHED", "id": "1467263217800320"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26300934082858876", "version": "1.2.76"}, "id": "3496886607306663", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7071233096255596", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26300934082858876"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3496886607306663"}]}, "change_log": null, "created_date": 1771270327, "id": "263009340
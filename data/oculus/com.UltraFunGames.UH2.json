_sid=6e7a0a&_nc_ohc=iWbWWm62By0Q7kNvwFDIdFs&_nc_oc=AdlPZLh8DRaXTjY_KqG9hVTAVyb74jZz-wbu8j6YN2V6PvH7cupCNIxIm5EL-5zBth0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft59YP6gjQuMhSgwACvpmW3jFbOOLeDJQjp1SZtGqDwyw&oe=69A028F8"}, {"file_name": "comultrafungamesuh2-20230904-221614_2560x1440.png", "id": "606058561790004", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819942_606058565123337_5288110718287674824_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmPefmRHWK0Q7kNvwGu4lsI&_nc_oc=AdnAiRQj8yGjX45-RdfAEMV2dvQQ4XNYSJq6wqTZo2UilNainLdxibeKpC1BN0LfdJo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuJDw83pzV_q5_oWSlBhYnz_Hf7JD5Eei60LpWvje4j_g&oe=69A03B6B"}, {"file_name": "comultrafungamesuh2-20230904-214538_2560x1440.png", "id": "3862164284096430", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391826_3862164290763096_6169609672159070790_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDkUqOzQPqkQ7kNvwHBvBHT&_nc_oc=Adk5okpkRyQjn668uuldZIFIBYUMNZLtvaGFo7HKX7MwOlMaiyCX5mrpddi-Oc9PtL8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftHou3yvnwhI7DuI35O0Gjmau5V9Ghdg65InMZ013Rgaw&oe=69A03459"}, {"file_name": "sky-bay-4_2560x1440.png", "id": "1028472436127624", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393602_1028472439460957_4727439774339542090_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2Aj7vqzNbkQ7kNvwGtmuXt&_nc_oc=AdlqS1p8GtKu8BdmQ-U_1RCG-sYYnIxuX-eW-VFjk84MJu9QC5rodea484ZFQTRfqOY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft9OZe325obOduApozD17IJwSwK6JeNLJS1nQyMWHU29w&oe=69A04D7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UH2_2560x1440.png", "id": "1225415472517646", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391769_1225415475850979_2162465729579857920_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXFlDtd5WwUQ7kNvwG57n4B&_nc_oc=AdkIgkFcHPDDqj-KscbRCFHsEmUXj9hYRJgIZCGGT9FkP5E90-hqEsgsAd4O8QkvIwQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvsauUFKSH4j71Y5l6zKqZGcCe4-7iHkKdgzsJV-rMUXA&oe=69A044E2"}, "display_name": "ULTRA HEIGHT 2", "keywords": ["VRClimbing", "UltraHeight", "Flying", "Climbing", "WebSwinging"], "long_description": "Ultra Height 2 takes VR climbing to new heights with 100+ intense challenges across 10 massive worlds. Inspired by Ultra Height: Mist City Climb, this game combines grapple gun action, web-swinging, and extreme flying for a heart-pounding vertical adventure. Master climbing, moving platforms, ziplining, jet rockets, parachute jumps, and gravity-defying stunts. Conquer skyscrapers, cliffs, and futuristic cities as you swing like a superhero and soar through the skies.\n\n\ud83d\uddfb Key Features:\n\nGrapple Gun and Web-Swinging \u2013 Fly through the air like a true hero.\n\nJet Rockets and Wingsuits \u2013 Blast through the skies at extreme speeds.\n\nZipline and Parachute Jumps \u2013 Defy gravity and dive from dizzying heights.\n\nFree Exploration Mode \u2013 Roam freely, uncover secrets, and find hidden tools.\n\nGlobal Leaderboards \u2013 Compete for the top spot and earn exclusive rewards.\n\n\ud83d\uddfa\ufe0f Explore 10 Massive Maps:\n\nIndoor Playground\n\nOutdoor Playground\n\nNew Mist City\n\nRocky Mountains\n\nHigh Playground\n\nNew Sky City\n\nAntenna Isle\n\nPrivate Island\n\nThe Ultra Mall\n\nSky Bay\n\n\u26a0\ufe0f Warning: Stay above the fog or the game restarts. Don\u2019t look down!", "short_description": "Ultra Height 2 is the ultimate VR climbing, flying, and web-swinging challenge. Conquer 100+ intense obstacles using grapple guns, jet rockets, ziplines,  parachute and hang gliders. Explore 10 massive maps, from skyscrapers to mountain peaks. Master gravity-defying stunts, discover hidden tools, and dominate global leaderboards. Test your limits in the most extreme vertical VR game ever. Don't fall \u2013 the sky is your playground!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ultrafungames.com/privacy-policy-ocu
_sid=6e7a0a&_nc_ohc=3J9DFq0DTXcQ7kNvwF5EWuL&_nc_oc=AdqRE-1Qo9DdICDo49Vq1B0V21hY0Vn_mOfwOsNOglykumXRfxTzhL6AVXf161dB58M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInC2gOJvw_PISd6WMIc8g7jU9EPnn8x46_eSHl17C5Cg&oe=6ABA7367"}, {"file_name": "screenshot_02.png", "id": "441813883809734", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982478_441813887143067_2986964696433044405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HC2d7J85RO8Q7kNvwGiiu0n&_nc_oc=AdoxCxjaG-sq9FE8jNQVeTsi9Z3Z3p0wuo9e2p3HJxPUixeVAQpFnS_M8df91ykuKBo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVdcfPXAkAlqKHwIAo0gcHPBs-5-XE_u6owvUVMTZdkA&oe=6ABA761C"}, {"file_name": "screenshot_03.png", "id": "440158363886653", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984454_440158367219986_5081739348623505343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXwnlY1xvZsQ7kNvwEZrjII&_nc_oc=AdqLTtIcF0xq-7Wz6OIAhHaY2PdDPteA_1iVBWjDHbLSP8vLBn7As7sCoK4sRluzBw0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQutL9gO85v6HC8T_RR-KTfYK8IbmFh3mUpxo6gH7mlA&oe=6ABA734F"}, {"file_name": "screenshot_05.png", "id": "813056236086867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003239_813056239420200_1661077816866897120_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCrewX7gt5oQ7kNvwHOZ7J9&_nc_oc=AdoHTCh9ky2ybp9ad-zgEkDC7GiQF1VeAqTjeWQR70_Mo9ZhrZEb_0uYHe5XXOXW-rU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLG-c9OWllt2AY62uZ01LCPvmWhxUDagTmd47Q-d-cLWQ&oe=6ABA75B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fugitive 3D", "keywords": [], "long_description": "Features:\n    - Cross-platform! VR and Flat players can play together.\n    - Server browser: Find a game quickly from any platform!\n    - Positional VOIP: hear the fugitives whispering in the bushes as you search for them.\n    - Watch the Replay: At the end of the round talk with everyone about how close they were to catching you as you all watch a replay over the round!\n    - Free and Open Source!\n    - Even runs on Android phones, so your one lame friend with no VR and no PC can still join in on the fun :P", "short_description": "Multiplayer, objective based, Hide & Seek! Cross-play between Flat and VR!\n\nPlay hide and seek with your friends on a warm summer night. Hide behind bushes as the Cops search for you. Make your way to the end zone without getting caught! If you're friend gets frozen by the police, you have to decide if it's worth trying to go rescue them. Or be the Cops, and drive around in your cop car shinning your flashlight into dark corners."}]}, "developer_name": "Stumpy Dog Studios", "developer_privacy_policy_url": "https://fugitivethegame.online/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Stumpy Dog Studios", "support_website_url": null, "website_url": "https://stumpy-dog-studios.itch.io/fugitive-3d", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "437090238169685"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036666_1556163801246867_6447318279780708782_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j23zGiw6nloQ7kNvwE8bHrO&_nc_oc=AdqoLXZw7flbx_wEvnulsHRpbdSlv4Jy4yB8hhGawcPKJkbZ7w40VZmmN-Lk7AqOmJ0&_nc_zt=3&_nc_ht=scontent-sjc6-
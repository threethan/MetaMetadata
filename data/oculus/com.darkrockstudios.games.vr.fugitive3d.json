_sid=6e7a0a&_nc_ohc=MnQQW_golLoQ7kNvwGSZCQw&_nc_oc=AdqVFNDD9jG6C9d9WeTSfQgjpwo0Lp_puGhVgEa_tI6ZdEB3f-uZdpYGzF63iNBADI0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnmSI3xufDfH5Ah8A3_INPDWo63h5bfAdwXTdfoi-jKw&oe=6AD22E67"}, {"file_name": "screenshot_02.png", "id": "441813883809734", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982478_441813887143067_2986964696433044405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTBAUkQ02ZcQ7kNvwEC1ulF&_nc_oc=AdoTKcJ-GIsJRTxoakA_Usv1nGSjcQTiq_q7S4K4VFaFonkWheF9I9brbRPLxaeQHfQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKFTYEm08kQ-V4UHsbEb4k_P3ZSCvMHMDbKp2n5RwX8A&oe=6AD2311C"}, {"file_name": "screenshot_03.png", "id": "440158363886653", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984454_440158367219986_5081739348623505343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3I81BnmnesQ7kNvwE5B4RU&_nc_oc=AdpECR9L4zq2QVTXiyCk8DGhSrJgQRT2TOSXK3H90NKR1Ctl5vch49oQ5YwdNi6-06k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOv3I07rIzkhmXxubb282_UbGtKqDcds-yK3hChE_0TAw&oe=6AD22E4F"}, {"file_name": "screenshot_05.png", "id": "813056236086867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003239_813056239420200_1661077816866897120_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVafmwHQBZwQ7kNvwE3m1cS&_nc_oc=AdouVfWSTfgvqok1Hy8UWKGOghaSZBxB3huGk9NvvIqJRnA1xt5XEaj9zTUaMAsnYEA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSdNKsKMOg6fc-1YBYyybfEsv3A8Zg1bQqELZvio2M4A&oe=6AD230B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fugitive 3D", "keywords": [], "long_description": "Features:\n    - Cross-platform! VR and Flat players can play together.\n    - Server browser: Find a game quickly from any platform!\n    - Positional VOIP: hear the fugitives whispering in the bushes as you search for them.\n    - Watch the Replay: At the end of the round talk with everyone about how close they were to catching you as you all watch a replay over the round!\n    - Free and Open Source!\n    - Even runs on Android phones, so your one lame friend with no VR and no PC can still join in on the fun :P", "short_description": "Multiplayer, objective based, Hide & Seek! Cross-play between Flat and VR!\n\nPlay hide and seek with your friends on a warm summer night. Hide behind bushes as the Cops search for you. Make your way to the end zone without getting caught! If you're friend gets frozen by the police, you have to decide if it's worth trying to go rescue them. Or be the Cops, and drive around in your cop car shinning your flashlight into dark corners."}]}, "developer_name": "Stumpy Dog Studios", "developer_privacy_policy_url": "https://fugitivethegame.online/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Stumpy Dog Studios", "support_website_url": null, "website_url": "https://stumpy-dog-studios.itch.io/fugitive-3d", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "437090238169685"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036666_1556163801246867_6447318279780708782_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fp9wLNLtJM8Q7kNvwG8LzEa&_nc_oc=AdqtTtcTbzYuUTAIo9nKd0iQ6BF3ozO3JUCYJtyMqS208IqdAH0mYFaH_Fdo29yZ26g&_nc_zt=3&_nc_ht=scontent-iad6-
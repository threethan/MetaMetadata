&_nc_sid=6e7a0a&_nc_ohc=QEjAOmcALyoQ7kNvwHYXCN7&_nc_oc=AdqxFU6uW6BB0ezKJXBAsF9mGf0bLFBN_sa7azcE3NRCOI7T8ptEDQF83E20ZVFiKHs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0HOorDKGVxs1Twx7ZnS26WKijJxtzfLp_yWRkSHnBsg&oe=6A369D67"}, {"file_name": "screenshot_02.png", "id": "441813883809734", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982478_441813887143067_2986964696433044405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9e06p_oD9cQ7kNvwGKTqtV&_nc_oc=Adqs5Z3eWsiQaSD0FK6NQ22nF3qusvn2Qm2DW0DVo3AeiP23cTS01z7sukefiwJ2LU0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Fn_WYv7_0Dcbe2By3-jq-QCK8_NGJXONZvPBdFTfb6g&oe=6A36A01C"}, {"file_name": "screenshot_03.png", "id": "440158363886653", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38984454_440158367219986_5081739348623505343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7m6F44N6ZOgQ7kNvwE7be-U&_nc_oc=AdqaUNGZZibvEyW9IYnMXGiWLD3m8oMylhnePxZoIxio51ckUk2v_rT8MAEC7iIBb5A&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Em3ZckM_Zk4DY0mgd7NsJo3IawDxB7BuQe3e9M2MMuQ&oe=6A369D4F"}, {"file_name": "screenshot_05.png", "id": "813056236086867", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003239_813056239420200_1661077816866897120_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1aOk0PztXhkQ7kNvwEwZbBl&_nc_oc=AdpoiUxtNOwKdjkw3im_TW9bVKQxj5Ej1H5tijvLqO0djTeUpEnPHcMS2JCrhm0PHqw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BUtm6E5E-4lcUfeXcMHw6Or2Em_ZlYmpHlx85DG0h7A&oe=6A369FB0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fugitive 3D", "keywords": [], "long_description": "Features:\n    - Cross-platform! VR and Flat players can play together.\n    - Server browser: Find a game quickly from any platform!\n    - Positional VOIP: hear the fugitives whispering in the bushes as you search for them.\n    - Watch the Replay: At the end of the round talk with everyone about how close they were to catching you as you all watch a replay over the round!\n    - Free and Open Source!\n    - Even runs on Android phones, so your one lame friend with no VR and no PC can still join in on the fun :P", "short_description": "Multiplayer, objective based, Hide & Seek! Cross-play between Flat and VR!\n\nPlay hide and seek with your friends on a warm summer night. Hide behind bushes as the Cops search for you. Make your way to the end zone without getting caught! If you're friend gets frozen by the police, you have to decide if it's worth trying to go rescue them. Or be the Cops, and drive around in your cop car shinning your flashlight into dark corners."}]}, "developer_name": "Stumpy Dog Studios", "developer_privacy_policy_url": "https://fugitivethegame.online/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Stumpy Dog Studios", "support_website_url": null, "website_url": "https://stumpy-dog-studios.itch.io/fugitive-3d", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "437090238169685"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39036666_1556163801246867_6447318279780708782_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Tp4IDL_TBoQ7kNvwHcr5F1&_nc_oc=AdqcYb-uUDZx--6ldlLOcjyIC3HLTutCMYl7ZZZeCf_ygnjYfJdXm2MPSDu-9e1alNY&_nc_zt=3&_nc_ht=scontent
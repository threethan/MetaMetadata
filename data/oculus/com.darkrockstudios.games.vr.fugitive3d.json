QiqDIyjKHU-4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsmwGSALv2I7XPdXo0pT4ng5CbGQfDVOsURw5l5PjB-zA&oe=699F00E7"}, {"file_name": "screenshot_02.png", "id": "441813883809734", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982478_441813887143067_2986964696433044405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dD8XCC-bxQkQ7kNvwF3fTzw&_nc_oc=AdmGZtR4Dk2Lr1FW-XZ5XoWfcPTsMqg5qHJkz5zJTYt7ajzpgu_8n082kJF8akKHH8E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfteRdi6C90mGzKuenfofhp_Uuw7hSGsX-73dGhlpiA67g&oe=699F039C"}, {"file_name": "screenshot_03.png", "id": "440158363886653", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984454_440158367219986_5081739348623505343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AD390nXhix0Q7kNvwFmEWcw&_nc_oc=AdnaXxddxaTglaWiTleSL17lQOkp1p0AajZMcJnODJFabppAaeWsXXFlsxybC9Rrr-8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs3RJE8ZgoQQVMo3rgmZYQFgT-oBXk1ZQm0E0KsTfpGKg&oe=699F00CF"}, {"file_name": "screenshot_05.png", "id": "813056236086867", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003239_813056239420200_1661077816866897120_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKBduL0clfIQ7kNvwG_E5Nc&_nc_oc=AdkFHpHuC9by4Wg65Y8Pt0gbZlOVg2pQ9_hkczq51yDlhfgyR347U9RQsmEvUdSuO3I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuGcxhJ4_gGZcrX3nlpx4QN0HCrtMOS3u0_znhSiove-A&oe=699F0330"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fugitive 3D", "keywords": [], "long_description": "Features:\n    - Cross-platform! VR and Flat players can play together.\n    - Server browser: Find a game quickly from any platform!\n    - Positional VOIP: hear the fugitives whispering in the bushes as you search for them.\n    - Watch the Replay: At the end of the round talk with everyone about how close they were to catching you as you all watch a replay over the round!\n    - Free and Open Source!\n    - Even runs on Android phones, so your one lame friend with no VR and no PC can still join in on the fun :P", "short_description": "Multiplayer, objective based, Hide & Seek! Cross-play between Flat and VR!\n\nPlay hide and seek with your friends on a warm summer night. Hide behind bushes as the Cops search for you. Make your way to the end zone without getting caught! If you're friend gets frozen by the police, you have to decide if it's worth trying to go rescue them. Or be the Cops, and drive around in your cop car shinning your flashlight into dark corners."}]}, "developer_name": "Stumpy Dog Studios", "developer_privacy_policy_url": "https://fugitivethegame.online/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Stumpy Dog Studios", "support_website_url": null, "website_url": "https://stumpy-dog-studios.itch.io/fugitive-3d", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "437090238169685"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036666_1556163801246867_6447318279780708782_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pwcmz8mcv7AQ7kNvwEfWVys&_nc_oc=Adlcp6LukdmnpvenWn3ilcKTaLb_gfFaQiiINyk4228PRYtYSEf18uhhENL6HiGTcH0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsT_WZZJ2l3J2D2a-u-5tcQEWYeKhy5f6HzL1NsNEmk9g&oe=699F079F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "dis
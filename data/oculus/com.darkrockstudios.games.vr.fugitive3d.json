NvwEV_Ses&_nc_oc=AdkhdxXKLwW4VCNnl4vnD7VSbG1RivxSsYGPV4GLXUuOpjc0e0zOU7oi2Xd_3lDrOmI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz88A2vh0iCAXrQ-NrA-OexfokprUUH3FnoPIQr4FMVWg&oe=69BD5367"}, {"file_name": "screenshot_02.png", "id": "441813883809734", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982478_441813887143067_2986964696433044405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLecbEjcDZwQ7kNvwELU20J&_nc_oc=Adm6wCsX11WdbycbdYUHCMGG8DmeRMFAgo-uDUC5nPmKBkgeQfGLXwyPNU8LDRqFR9k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfytMjnqrgjCO6lZHwwF7eNzLkDY-J0JZG82UGduA_l7Jg&oe=69BD561C"}, {"file_name": "screenshot_03.png", "id": "440158363886653", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984454_440158367219986_5081739348623505343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZM7Eb2APSPgQ7kNvwHGdORk&_nc_oc=AdnyKovN5pf60BopcZFHm0MNmXFoRUg4HIPNMFfPgAgpopveEoFmQv2J62yeIcBBb6w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzKwIohpe3j6-SG8VrzV7KFN5KdNL-Ad8knjP85gL9gqA&oe=69BD534F"}, {"file_name": "screenshot_05.png", "id": "813056236086867", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003239_813056239420200_1661077816866897120_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSSOppqZCHwQ7kNvwESLk6O&_nc_oc=AdkyKaOIP0rZABkw8OqAte3clQvG-gStMtjihh0DbEisuqtAhNySrc3TUHUzbl1X0ag&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzfC5-p3W08hBwwAB6wS5ETQK9OamhgJTLFRxtKakaQrA&oe=69BD55B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fugitive 3D", "keywords": [], "long_description": "Features:\n    - Cross-platform! VR and Flat players can play together.\n    - Server browser: Find a game quickly from any platform!\n    - Positional VOIP: hear the fugitives whispering in the bushes as you search for them.\n    - Watch the Replay: At the end of the round talk with everyone about how close they were to catching you as you all watch a replay over the round!\n    - Free and Open Source!\n    - Even runs on Android phones, so your one lame friend with no VR and no PC can still join in on the fun :P", "short_description": "Multiplayer, objective based, Hide & Seek! Cross-play between Flat and VR!\n\nPlay hide and seek with your friends on a warm summer night. Hide behind bushes as the Cops search for you. Make your way to the end zone without getting caught! If you're friend gets frozen by the police, you have to decide if it's worth trying to go rescue them. Or be the Cops, and drive around in your cop car shinning your flashlight into dark corners."}]}, "developer_name": "Stumpy Dog Studios", "developer_privacy_policy_url": "https://fugitivethegame.online/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Stumpy Dog Studios", "support_website_url": null, "website_url": "https://stumpy-dog-studios.itch.io/fugitive-3d", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "437090238169685"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036666_1556163801246867_6447318279780708782_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=---aOBcqvQQQ7kNvwEdBm01&_nc_oc=AdlpH3EbzXvMPvQVXkue5zd-eX5F8kCIQbDs9h_tkBYNSEBCAV9R1HraMWSCSGRClso&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwwh_EhPxk40GDGrRi
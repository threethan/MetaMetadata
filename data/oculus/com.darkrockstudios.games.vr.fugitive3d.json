_sid=6e7a0a&_nc_ohc=7DNEYEZ5FhQQ7kNvwFpU0V9&_nc_oc=Adp83zquopHak8hSyM-t7LCOTwJDnUxeA5VfcdYDaMxNaQWJf42Q40ex1GARGRmkUeQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5dsZqcvFiu4UGf7UPzgHbmBYKkk2P5i6FuEyclmxnZw&oe=6ADE0BE7"}, {"file_name": "screenshot_02.png", "id": "441813883809734", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982478_441813887143067_2986964696433044405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1cy9FSpTYoQ7kNvwFvXete&_nc_oc=AdpbtKYYBgLFnnl1VGbUAa4CVv9GifE1NPAeVLRyZS7Lth19gmG9o8MNtzX3OMirgdI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO56XMZzhZDRYccof8u3J8X0YLVThBjwgwblbqoinwAsg&oe=6ADE0E9C"}, {"file_name": "screenshot_03.png", "id": "440158363886653", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984454_440158367219986_5081739348623505343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yZ5CpyCFswQ7kNvwHwK7Zz&_nc_oc=AdqJyYCpPxR87mzuNPLo021CxB-pyUHTsAByShhR8rL6kEGqKeRtw5sP-AkZhvYuwfE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpzjxhDZX70P3c_Pp8LydB8ZYHERUl4ZzhzotX6jOCTA&oe=6ADE0BCF"}, {"file_name": "screenshot_05.png", "id": "813056236086867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003239_813056239420200_1661077816866897120_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUQk9453RbcQ7kNvwEWWAnP&_nc_oc=AdoPQm0fvAsMUsDO7A00k2o__uhhV4BH_C06Qf2QZth3piKmc6PeAooB2eDd4WBg7Y4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTXzqdwuRFkNHIjUVuxa-P35KBoS_Yx1gcdBAS0iWtKw&oe=6ADE0E30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fugitive 3D", "keywords": [], "long_description": "Features:\n    - Cross-platform! VR and Flat players can play together.\n    - Server browser: Find a game quickly from any platform!\n    - Positional VOIP: hear the fugitives whispering in the bushes as you search for them.\n    - Watch the Replay: At the end of the round talk with everyone about how close they were to catching you as you all watch a replay over the round!\n    - Free and Open Source!\n    - Even runs on Android phones, so your one lame friend with no VR and no PC can still join in on the fun :P", "short_description": "Multiplayer, objective based, Hide & Seek! Cross-play between Flat and VR!\n\nPlay hide and seek with your friends on a warm summer night. Hide behind bushes as the Cops search for you. Make your way to the end zone without getting caught! If you're friend gets frozen by the police, you have to decide if it's worth trying to go rescue them. Or be the Cops, and drive around in your cop car shinning your flashlight into dark corners."}]}, "developer_name": "Stumpy Dog Studios", "developer_privacy_policy_url": "https://fugitivethegame.online/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Stumpy Dog Studios", "support_website_url": null, "website_url": "https://stumpy-dog-studios.itch.io/fugitive-3d", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "437090238169685"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036666_1556163801246867_6447318279780708782_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R955ELtiJ6UQ7kNvwFcsVy-&_nc_oc=Adrr_Ld1LiL62oqk1KMVGb77h5Bj52L79HRR7j7UtY3cjCpxz5baFqX_MHzEA1-pyAw&_nc_zt=3&_nc_ht=scontent-sjc6-
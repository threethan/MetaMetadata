_sid=6e7a0a&_nc_ohc=ARJYJHiOOOwQ7kNvwH-hcY3&_nc_oc=AdrPIQ1pY1nI-I_fBMuVaFsETbD10sxG2aWgsbBFABU_Bdw_ZyTcT_bWcFDWoJOSCMM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKAl-p9frkTThS1Aa3XXnn8jIPzvd3U6arnSXB4HhcnA&oe=6AC4FF67"}, {"file_name": "screenshot_02.png", "id": "441813883809734", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982478_441813887143067_2986964696433044405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lujEFfCVOAQ7kNvwG3e-Rf&_nc_oc=Adp-UdyhVUD-qXQDc8hweiuwIirhPo8z-GrdFytv7fDF6T2OAAl4iOF39hCatGgQPRg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJCSZGSDo4Mfj4sjxRhwlIp4gtWg-SozK7zAcF64_1Eg&oe=6AC5021C"}, {"file_name": "screenshot_03.png", "id": "440158363886653", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984454_440158367219986_5081739348623505343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4xiSp66WEwQ7kNvwEHYUTO&_nc_oc=AdpGvkBNoEUu5w9F5XXwVo8qVFwBFtkfO3-oIpvY375eu9UPojrxZGk0BlWqEAocLrw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAzeIeidePWL70oU76R04zitdfNBbtpuFucR_WZmB4Uw&oe=6AC4FF4F"}, {"file_name": "screenshot_05.png", "id": "813056236086867", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003239_813056239420200_1661077816866897120_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUKDcFW4USYQ7kNvwET0xMX&_nc_oc=AdqLrUCHcW_dpXQLivR1bm7JurgkY6nSPbyIh4R1cEe4q0xfUbpkX71BRox3uPqwdfM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYk_WUJS0djcti5-Nn-xEpITWgmLJnnXqmjba8uWK-Kw&oe=6AC501B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fugitive 3D", "keywords": [], "long_description": "Features:\n    - Cross-platform! VR and Flat players can play together.\n    - Server browser: Find a game quickly from any platform!\n    - Positional VOIP: hear the fugitives whispering in the bushes as you search for them.\n    - Watch the Replay: At the end of the round talk with everyone about how close they were to catching you as you all watch a replay over the round!\n    - Free and Open Source!\n    - Even runs on Android phones, so your one lame friend with no VR and no PC can still join in on the fun :P", "short_description": "Multiplayer, objective based, Hide & Seek! Cross-play between Flat and VR!\n\nPlay hide and seek with your friends on a warm summer night. Hide behind bushes as the Cops search for you. Make your way to the end zone without getting caught! If you're friend gets frozen by the police, you have to decide if it's worth trying to go rescue them. Or be the Cops, and drive around in your cop car shinning your flashlight into dark corners."}]}, "developer_name": "Stumpy Dog Studios", "developer_privacy_policy_url": "https://fugitivethegame.online/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Stumpy Dog Studios", "support_website_url": null, "website_url": "https://stumpy-dog-studios.itch.io/fugitive-3d", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "437090238169685"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036666_1556163801246867_6447318279780708782_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnLqJCRBQ1wQ7kNvwEZ6hQd&_nc_oc=AdoiIq2U5hAlYOdqVNjakCe27iJbdm2ZjvpSKiHH_qKRDMk4vS6dUX3lhq_8Euv5XBc&_nc_zt=3&_nc_ht=scontent-lga3-
NvwE1x-W2&_nc_oc=AdkJc0yanWSDe2q2jucHR0L7whR5G0Tz5atWidfc_BeR3xsIuskixae6nu3D10JGUn4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyLaRJTy1EOtiviuvAFH54R5eJOooXzzveBkHxYIJA3cA&oe=69BAB067"}, {"file_name": "screenshot_02.png", "id": "441813883809734", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982478_441813887143067_2986964696433044405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GgYT-mmOawsQ7kNvwF7o0zx&_nc_oc=AdkAuWEuRetVAHFWWPJ9U44rnImJplKcZwcze-jMJ-OI9l6YpRT1F7LmZ53v-ZDvIsY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzvYLa-q6F2Y1aj3exLw29DGo_1dGT18JaPeNQ6l-U-tA&oe=69BAB31C"}, {"file_name": "screenshot_03.png", "id": "440158363886653", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984454_440158367219986_5081739348623505343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSo5ioolB0kQ7kNvwFtlV90&_nc_oc=Adm914GCmpdO6F4pxOBDVjBe6d1ahmUjewonM6MC3rWI2ju3ypRbzmtsbX27W2M0Evk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw51NFTCl74Tvra2SCj8kiopdY9XdY6Yhiiqo3dldZACQ&oe=69BAB04F"}, {"file_name": "screenshot_05.png", "id": "813056236086867", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003239_813056239420200_1661077816866897120_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wvYmhSbPmMQ7kNvwFEUbax&_nc_oc=AdlD7jfbyK7GRGQ5uUvpgxNIUpaUVDQTTZHISU3yOPXtudNIjGosK2SnVQTrK3XFdGk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz-M8Mo5cHAXGAM_OKpbIwlgSiLEg6xMOlgpIUmexOg1Q&oe=69BAB2B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fugitive 3D", "keywords": [], "long_description": "Features:\n    - Cross-platform! VR and Flat players can play together.\n    - Server browser: Find a game quickly from any platform!\n    - Positional VOIP: hear the fugitives whispering in the bushes as you search for them.\n    - Watch the Replay: At the end of the round talk with everyone about how close they were to catching you as you all watch a replay over the round!\n    - Free and Open Source!\n    - Even runs on Android phones, so your one lame friend with no VR and no PC can still join in on the fun :P", "short_description": "Multiplayer, objective based, Hide & Seek! Cross-play between Flat and VR!\n\nPlay hide and seek with your friends on a warm summer night. Hide behind bushes as the Cops search for you. Make your way to the end zone without getting caught! If you're friend gets frozen by the police, you have to decide if it's worth trying to go rescue them. Or be the Cops, and drive around in your cop car shinning your flashlight into dark corners."}]}, "developer_name": "Stumpy Dog Studios", "developer_privacy_policy_url": "https://fugitivethegame.online/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Stumpy Dog Studios", "support_website_url": null, "website_url": "https://stumpy-dog-studios.itch.io/fugitive-3d", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "437090238169685"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036666_1556163801246867_6447318279780708782_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DT36H1fCmgQ7kNvwGCv4vA&_nc_oc=Adl4UJESn04B0bdLcUk5F-lbRo90QnHFz8GRW_bVTlQU8HA0ir142_LEocZmpa5SIu4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwItLT9pwewYfHmu8g
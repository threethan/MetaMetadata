e=6B030A7A"}, {"file_name": "screenshot_00.png", "id": "915944145830828", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974702_915944149164161_5060685664285408117_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRozlvqenLsQ7kNvwGgSzGp&_nc_oc=Ado4OHK8Z6i-63v-xAb-SLSjwIkq7DqTmMRQN-ZR4lQA3HRG1IFh1-BMwUdK9fEmXvU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIZsXu0ndaVDRfqZAtpmLpdpiaa7oPvrcdyuwRjMeQ2A&oe=6B032E27"}, {"file_name": "screenshot_02.png", "id": "441813883809734", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982478_441813887143067_2986964696433044405_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mf5kDCQrt5QQ7kNvwF-ONlQ&_nc_oc=Adrj3hDfPnQPf4zEIUS4wd0WC3B92vizRpZ8oNumHVTAnlmopxaLxiAk2dJk7XAaeuw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGlZVNUicnz69REao1CUSeQAbYL9LRqUoZMbJCOBBbSQ&oe=6B0330DC"}, {"file_name": "screenshot_03.png", "id": "440158363886653", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984454_440158367219986_5081739348623505343_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9oibcf3M1EQ7kNvwEYOkBN&_nc_oc=AdpC381Q8uDVy8AtLKzyRiLYMj7fvoa4c7L-s2fljtiuaZ6Ob-YwB_xBsCrw2CPfx-k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRct_g_NubXbUcAMsT5cj5ch5nwu2fwL_vDxUK_fp0CYA&oe=6B032E0F"}, {"file_name": "screenshot_05.png", "id": "813056236086867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003239_813056239420200_1661077816866897120_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Y0GrUyvHSoQ7kNvwE8QNjo&_nc_oc=Adr8Jt5bLn_vyQyDYUBGkIk9ewTLMCxkEaZH4G0VAtbt1D6yS5f4q5ij48WAwfaU6Fg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTxx4eTVUcDlY4I07ZTY-yOyQu8uWIH-VzPySavb6lLw&oe=6B033070"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fugitive 3D", "keywords": [], "long_description": "Features:\n    - Cross-platform! VR and Flat players can play together.\n    - Server browser: Find a game quickly from any platform!\n    - Positional VOIP: hear the fugitives whispering in the bushes as you search for them.\n    - Watch the Replay: At the end of the round talk with everyone about how close they were to catching you as you all watch a replay over the round!\n    - Free and Open Source!\n    - Even runs on Android phones, so your one lame friend with no VR and no PC can still join in on the fun :P", "short_description": "Multiplayer, objective based, Hide & Seek! Cross-play between Flat and VR!\n\nPlay hide and seek with your friends on a warm summer night. Hide behind bushes as the Cops search for you. Make your way to the end zone without getting caught! If you're friend gets frozen by the police, you have to decide if it's worth trying to go rescue them. Or be the Cops, and drive around in your cop car shinning your flashlight into dark corners."}]}, "developer_name": "Stumpy Dog Studios", "developer_privacy_policy_url": "https://fugitivethegame.online/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Stumpy Dog Studios", "support_website_url": null, "website_url": "https://stumpy-dog-studios.itch.io/fugitive-3d", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "437090238169685"}, "review_messages": []}]}, "cover_square_im
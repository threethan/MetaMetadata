id=6e7a0a&_nc_ohc=aRELqs_jCLYQ7kNvwFSR6MY&_nc_oc=AdqCYiZl3j7ywcl_pbjMWi8-nDc9TK914iz4H_UrEn0v0CvTfiDlqXHIlqrWVbiOPVQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mHGFWETEMq0hFHXS6Gpy2Ib9GnLgu2fb3L9ck6jQL2A&oe=69D3BCE7"}, {"file_name": "screenshot_02.png", "id": "441813883809734", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982478_441813887143067_2986964696433044405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBXshMQnFE4Q7kNvwG_TYj3&_nc_oc=AdqW_vPmzDngA_ZkgBJGWqV0dou5ZHcMvpvVEO57reWDKqZB-rUUhpwW_O3k2lLCG7I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1D-FWO33oB6t243vd_xCcdswkzYQ8bABVZaaFPrFep9A&oe=69D3BF9C"}, {"file_name": "screenshot_03.png", "id": "440158363886653", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984454_440158367219986_5081739348623505343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Qsn3IS1fs0Q7kNvwHHI7x5&_nc_oc=Ado3Ddr2yvio6utQdl2Mz7XIXwbAhVU5fM5h1iSIcHKDnfat5K5klR5SozYgiRIiQvk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2saG0AdB_IXDOXgia1x4VuxaL02GF3mYsJJCPoWpG1ig&oe=69D3BCCF"}, {"file_name": "screenshot_05.png", "id": "813056236086867", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003239_813056239420200_1661077816866897120_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fA8lHLgUUjwQ7kNvwH8ikaR&_nc_oc=AdrGbvvTrVrv4j4wqSmNFB-hSB-HKpdsnn7Dh7WxINw-OpNceSzfvTXUF58VZ5oxC78&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ugj6oBnLL2U5HcZxaZ6mBua8uxFNCmsTRyM9tcm57cA&oe=69D3BF30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fugitive 3D", "keywords": [], "long_description": "Features:\n    - Cross-platform! VR and Flat players can play together.\n    - Server browser: Find a game quickly from any platform!\n    - Positional VOIP: hear the fugitives whispering in the bushes as you search for them.\n    - Watch the Replay: At the end of the round talk with everyone about how close they were to catching you as you all watch a replay over the round!\n    - Free and Open Source!\n    - Even runs on Android phones, so your one lame friend with no VR and no PC can still join in on the fun :P", "short_description": "Multiplayer, objective based, Hide & Seek! Cross-play between Flat and VR!\n\nPlay hide and seek with your friends on a warm summer night. Hide behind bushes as the Cops search for you. Make your way to the end zone without getting caught! If you're friend gets frozen by the police, you have to decide if it's worth trying to go rescue them. Or be the Cops, and drive around in your cop car shinning your flashlight into dark corners."}]}, "developer_name": "Stumpy Dog Studios", "developer_privacy_policy_url": "https://fugitivethegame.online/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Stumpy Dog Studios", "support_website_url": null, "website_url": "https://stumpy-dog-studios.itch.io/fugitive-3d", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "437090238169685"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036666_1556163801246867_6447318279780708782_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-O14fptHKx4Q7kNvwHcQ7jO&_nc_oc=AdqGo4T18G2xyqzKanBcj9bzvuUS8R45XFUB2WSrFeHO-gSeGpGfnFQJCH5ESN574U8&_nc_zt=3&_nc_ht=scontent-ord5-3.
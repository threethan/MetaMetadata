_sid=6e7a0a&_nc_ohc=j1HNzTBST7UQ7kNvwHepE2E&_nc_oc=AdowiDib3WgdQGsCl0Rlw7UjdC1h9PSpzxRUsIc2qbmozUwbV_k4c-vuu8IzEr-hhgg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTlmuhezvEqAYyFRJ7wLtAL62qS0FFjW3i4nZdwxTuYw&oe=6ABFB967"}, {"file_name": "screenshot_02.png", "id": "441813883809734", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982478_441813887143067_2986964696433044405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_FtTFoJNT0oQ7kNvwEg7kqR&_nc_oc=AdqjmgFiadhdxhWb9gNjVseWgsqrLfHFqGlQ0nNtL6f_qtUJy3adKbviAxt0yLDyY7U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPg5gjpcBK7PFMVec5CFW2PEPLx-eIJWDG6dphRhJ8uHA&oe=6ABFBC1C"}, {"file_name": "screenshot_03.png", "id": "440158363886653", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984454_440158367219986_5081739348623505343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VByIjILx0kcQ7kNvwHFzljF&_nc_oc=AdoaB-3KOS08ijetuYtoOlFlV4kXm0R9Dixm6Q6mYPt8OCq7pqtCvmNiJAjcAkrHZJg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNq2qsLoes3u3MpaUGL107BxI958kKXx6U9QAkT5X--MQ&oe=6ABFB94F"}, {"file_name": "screenshot_05.png", "id": "813056236086867", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003239_813056239420200_1661077816866897120_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rl92SihGv9YQ7kNvwEct-NG&_nc_oc=AdqKta3lNupB4qUyzkMdOf_8EJlHAUIFpI9GkEq19OLtP4n7h55aikVgKv9t7ifQl3E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtt3xzvIew3zDFr13MrzK_guH3iH0-o07c6_XqVZoSaA&oe=6ABFBBB0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fugitive 3D", "keywords": [], "long_description": "Features:\n    - Cross-platform! VR and Flat players can play together.\n    - Server browser: Find a game quickly from any platform!\n    - Positional VOIP: hear the fugitives whispering in the bushes as you search for them.\n    - Watch the Replay: At the end of the round talk with everyone about how close they were to catching you as you all watch a replay over the round!\n    - Free and Open Source!\n    - Even runs on Android phones, so your one lame friend with no VR and no PC can still join in on the fun :P", "short_description": "Multiplayer, objective based, Hide & Seek! Cross-play between Flat and VR!\n\nPlay hide and seek with your friends on a warm summer night. Hide behind bushes as the Cops search for you. Make your way to the end zone without getting caught! If you're friend gets frozen by the police, you have to decide if it's worth trying to go rescue them. Or be the Cops, and drive around in your cop car shinning your flashlight into dark corners."}]}, "developer_name": "Stumpy Dog Studios", "developer_privacy_policy_url": "https://fugitivethegame.online/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Stumpy Dog Studios", "support_website_url": null, "website_url": "https://stumpy-dog-studios.itch.io/fugitive-3d", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "437090238169685"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036666_1556163801246867_6447318279780708782_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKTqqlqP-mcQ7kNvwFVNQAy&_nc_oc=Adr0yZMKxbJyIFUxpwQc2l-g-6xyuaAzvn3WbMUkLBXN0E0LNHa6pbx6UiXg0Ke5TUw&_nc_zt=3&_nc_ht=scontent-ord5-
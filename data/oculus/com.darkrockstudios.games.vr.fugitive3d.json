_sid=6e7a0a&_nc_ohc=MnQQW_golLoQ7kNvwFSs1sA&_nc_oc=AdqSrdiBjNs8IRdueYAv_vIk-7HFybkYEuUvaq0YVjPW5puHjdpIqilLy3AVWJco2nU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSeERGYuFqOFlmhHy7h5y-ixrK7Hsk6Vu8FCOChAUxJQ&oe=6AD0DCE7"}, {"file_name": "screenshot_02.png", "id": "441813883809734", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982478_441813887143067_2986964696433044405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MefmdSGDnmUQ7kNvwFkdOC5&_nc_oc=AdoppdjtaH-vsF0fnIMSw7oZ-RClikmDIhGNvxHBMeeubS2f-0xvBKDPAo7u_GArbt0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyMyd-jJeZPQsLJRaYj3ymKgjNb-sSBN9TwfAJ3FjStQ&oe=6AD0DF9C"}, {"file_name": "screenshot_03.png", "id": "440158363886653", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984454_440158367219986_5081739348623505343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVeoVFM4Gl8Q7kNvwGzr7jn&_nc_oc=AdrZzv6hY2jQILD8K8UUYCC2xJ_DbKsJZ0_p9joNQJas_cH2HIBE5YnYnWuTzNGymKk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpsxBcS-7tHWwK6e5JRSb4QoKUoz9zXbLxpVQmVAO7jA&oe=6AD0DCCF"}, {"file_name": "screenshot_05.png", "id": "813056236086867", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003239_813056239420200_1661077816866897120_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWMO7zVxuxQQ7kNvwEA6s0B&_nc_oc=AdolNoFgF1p8_tZCp7FcrGeuHbxrxz3msU0jP_IR53RlpX0SnTsJHOzOxOg2gSFh-m4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtPrI5frxPRT3IKZc0Eb5PWa7zDuOOZ_N8Vzdz34hVOg&oe=6AD0DF30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fugitive 3D", "keywords": [], "long_description": "Features:\n    - Cross-platform! VR and Flat players can play together.\n    - Server browser: Find a game quickly from any platform!\n    - Positional VOIP: hear the fugitives whispering in the bushes as you search for them.\n    - Watch the Replay: At the end of the round talk with everyone about how close they were to catching you as you all watch a replay over the round!\n    - Free and Open Source!\n    - Even runs on Android phones, so your one lame friend with no VR and no PC can still join in on the fun :P", "short_description": "Multiplayer, objective based, Hide & Seek! Cross-play between Flat and VR!\n\nPlay hide and seek with your friends on a warm summer night. Hide behind bushes as the Cops search for you. Make your way to the end zone without getting caught! If you're friend gets frozen by the police, you have to decide if it's worth trying to go rescue them. Or be the Cops, and drive around in your cop car shinning your flashlight into dark corners."}]}, "developer_name": "Stumpy Dog Studios", "developer_privacy_policy_url": "https://fugitivethegame.online/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Stumpy Dog Studios", "support_website_url": null, "website_url": "https://stumpy-dog-studios.itch.io/fugitive-3d", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "437090238169685"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036666_1556163801246867_6447318279780708782_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fp9wLNLtJM8Q7kNvwFH2qY-&_nc_oc=Adr0mFIgoabnHFRwkNylEBMJrVrn6IMoP7ormsHjCBPcCIPiBkwe2Mnr8K1bG9QQawE&_nc_zt=3&_nc_ht=scontent-lga3-
NvwG-stiF&_nc_oc=Adkm_5zpp1vmX6KfZd-Gc-uL8M40m4kcf1FR6R76yFTqcib1PQOjck4vHSVvt0Zy9qs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxAL4zfE3pb82OzfnTxGQwnYuU8rm0QvYWVBovE3jq9-w&oe=69AED2E7"}, {"file_name": "screenshot_02.png", "id": "441813883809734", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982478_441813887143067_2986964696433044405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7a--wTWV6AQ7kNvwEAjWiL&_nc_oc=AdlxZcZx63M8BvyR9V_mSEOYa47Cg5rS1Ct_0RQhiIoeJkpoS2AuUsP_YPwnjrGOytw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxAVVG-mmf7-rXcaIRMysYBGKle7y4Jt61bTcER7jN7mw&oe=69AED59C"}, {"file_name": "screenshot_03.png", "id": "440158363886653", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984454_440158367219986_5081739348623505343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-73N5VZ2xsQ7kNvwEdouOL&_nc_oc=AdkHZ4_6mP0aNh5BxLaBwaJ2JaVyU0byB5uWu7cqN26bGKH1aCj8IX-FBTTjGsPtUOY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-dtIPC1Jkuqysnc_40KdL0iZTKjlRzltZEyzCJ_9gVw&oe=69AED2CF"}, {"file_name": "screenshot_05.png", "id": "813056236086867", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003239_813056239420200_1661077816866897120_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UV2dxJ2e6TsQ7kNvwGtbGZQ&_nc_oc=Adlie62yKIDyoDCeAZenGYnxSKiHx06gQ3yUziHS2lQ3Bwjo7pTs-k12ZAjgzRSRjCQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx3WIvumB2StG-Wb-PxYdOf_QWhKg4o8iROdQjTlH8fnA&oe=69AED530"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fugitive 3D", "keywords": [], "long_description": "Features:\n    - Cross-platform! VR and Flat players can play together.\n    - Server browser: Find a game quickly from any platform!\n    - Positional VOIP: hear the fugitives whispering in the bushes as you search for them.\n    - Watch the Replay: At the end of the round talk with everyone about how close they were to catching you as you all watch a replay over the round!\n    - Free and Open Source!\n    - Even runs on Android phones, so your one lame friend with no VR and no PC can still join in on the fun :P", "short_description": "Multiplayer, objective based, Hide & Seek! Cross-play between Flat and VR!\n\nPlay hide and seek with your friends on a warm summer night. Hide behind bushes as the Cops search for you. Make your way to the end zone without getting caught! If you're friend gets frozen by the police, you have to decide if it's worth trying to go rescue them. Or be the Cops, and drive around in your cop car shinning your flashlight into dark corners."}]}, "developer_name": "Stumpy Dog Studios", "developer_privacy_policy_url": "https://fugitivethegame.online/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Stumpy Dog Studios", "support_website_url": null, "website_url": "https://stumpy-dog-studios.itch.io/fugitive-3d", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "437090238169685"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036666_1556163801246867_6447318279780708782_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyqJL3_9yPcQ7kNvwGzcufe&_nc_oc=Adl4TsyYaqROBjrkuYQBpEV9voznCDB_DuhV6KVgnABxlyhk9foc1y_jjTO78qMNpEk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQ4UM0HBixaQ0TNft
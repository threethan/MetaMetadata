e=6B0F203A"}, {"file_name": "screenshot_00.png", "id": "915944145830828", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974702_915944149164161_5060685664285408117_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVUP6-38g1oQ7kNvwGYQs1w&_nc_oc=AdrbmYjzwI7uF67XP_qV9FyL7aa71V7ayP_FwXPy6fBVAqYD6mODBw_WRagUJwa5uVE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUuxMJKGC_gF-zvekpbZpU27-HMbfFsUXMCKV-bMM6I3g&oe=6B0F0BA7"}, {"file_name": "screenshot_02.png", "id": "441813883809734", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982478_441813887143067_2986964696433044405_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UX1UzzVB3HUQ7kNvwHyqHZx&_nc_oc=AdpFXlReguQDhuFAnFzXMlqbPh4bVFRAuSFonOPKE4hzDvecVYjW5dJIGthWoh2l-_Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVwgQuezXizszz1KyS0w4zxBN1DjeQehAQNjs7zj3hWhA&oe=6B0F0E5C"}, {"file_name": "screenshot_03.png", "id": "440158363886653", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_440158367219986_5081739348623505343_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0CVFhliKQIQ7kNvwHnaO73&_nc_oc=Adq3eqqfCiOIns1aG7slTXRyJPyI0uGgMizpTIhqlIyF31PQ3Qr-s7mzQDk2SOGDZEg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWkd0Rm7ffWKAS-CPtZ_KVBooD-pXhfzB4ICroo0pZBZg&oe=6B0F0B8F"}, {"file_name": "screenshot_05.png", "id": "813056236086867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003239_813056239420200_1661077816866897120_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9s82dcnqHHAQ7kNvwHEmxFx&_nc_oc=AdpeVx-7XvI6K-jvaDPzdFqmx5Q2jXq-cDK49FIb5M5QxOnfLGPuTSRENLp7h8oX9-I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWAt-wg1qiVhdL5K_gJevUZ50zWdIRK_XuaKmdkeSSWCQ&oe=6B0F0DF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fugitive 3D", "keywords": [], "long_description": "Features:\n    - Cross-platform! VR and Flat players can play together.\n    - Server browser: Find a game quickly from any platform!\n    - Positional VOIP: hear the fugitives whispering in the bushes as you search for them.\n    - Watch the Replay: At the end of the round talk with everyone about how close they were to catching you as you all watch a replay over the round!\n    - Free and Open Source!\n    - Even runs on Android phones, so your one lame friend with no VR and no PC can still join in on the fun :P", "short_description": "Multiplayer, objective based, Hide & Seek! Cross-play between Flat and VR!\n\nPlay hide and seek with your friends on a warm summer night. Hide behind bushes as the Cops search for you. Make your way to the end zone without getting caught! If you're friend gets frozen by the police, you have to decide if it's worth trying to go rescue them. Or be the Cops, and drive around in your cop car shinning your flashlight into dark corners."}]}, "developer_name": "Stumpy Dog Studios", "developer_privacy_policy_url": "https://fugitivethegame.online/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Stumpy Dog Studios", "support_website_url": null, "website_url": "https://stumpy-dog-studios.itch.io/fugitive-3d", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "437090238169685"}, "review_messages": []}]}, "cover_square_im
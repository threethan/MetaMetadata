_sid=6e7a0a&_nc_ohc=Sp8o9tl48CEQ7kNvwGZVMHg&_nc_oc=AdqvWlOweYdksvEItAFLmTNsmXLMEixv1JZWxWFjrO7SQE4tK5XyCio9PW2i8EviUqs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbp-m75jPOtoXqP4fFt4fEav1D2SelxvQc0TJ5p4GiQA&oe=6ACE39E7"}, {"file_name": "screenshot_02.png", "id": "441813883809734", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982478_441813887143067_2986964696433044405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MefmdSGDnmUQ7kNvwEI3GVr&_nc_oc=Adq6CtkNoRw5GMO00qBJN3plqIP0Fa61h8y_8JFDHwd5KOvf62AUPXQJTWH6qQShu10&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSHu0b8ZSSljX8YXZEidvk-k60R7EdvJlmtt4menyNDQ&oe=6ACE3C9C"}, {"file_name": "screenshot_03.png", "id": "440158363886653", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984454_440158367219986_5081739348623505343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVeoVFM4Gl8Q7kNvwEDEirH&_nc_oc=Adp678lAHkerSWP5iRafgG1HnhloxeuSm45CrBsIrN7YjZFCEHqlw2cWqdQavn00mM4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPz9eNevC1LdD_p__JHSJOqNOmEskHRFxmBbtmOOBBVEw&oe=6ACE39CF"}, {"file_name": "screenshot_05.png", "id": "813056236086867", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003239_813056239420200_1661077816866897120_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWMO7zVxuxQQ7kNvwGo0KY5&_nc_oc=AdqViIorR9aiKvQUTxtDuGHOztgrfs9KrNlqddQ9pkMAHaZCNs-NSpcR2m2y_gU4Zb0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMn-69IYEbdWey-a0e1hRQwgoL9-YvQJ9pxyVgRyoi-zA&oe=6ACE3C30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fugitive 3D", "keywords": [], "long_description": "Features:\n    - Cross-platform! VR and Flat players can play together.\n    - Server browser: Find a game quickly from any platform!\n    - Positional VOIP: hear the fugitives whispering in the bushes as you search for them.\n    - Watch the Replay: At the end of the round talk with everyone about how close they were to catching you as you all watch a replay over the round!\n    - Free and Open Source!\n    - Even runs on Android phones, so your one lame friend with no VR and no PC can still join in on the fun :P", "short_description": "Multiplayer, objective based, Hide & Seek! Cross-play between Flat and VR!\n\nPlay hide and seek with your friends on a warm summer night. Hide behind bushes as the Cops search for you. Make your way to the end zone without getting caught! If you're friend gets frozen by the police, you have to decide if it's worth trying to go rescue them. Or be the Cops, and drive around in your cop car shinning your flashlight into dark corners."}]}, "developer_name": "Stumpy Dog Studios", "developer_privacy_policy_url": "https://fugitivethegame.online/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Stumpy Dog Studios", "support_website_url": null, "website_url": "https://stumpy-dog-studios.itch.io/fugitive-3d", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "437090238169685"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036666_1556163801246867_6447318279780708782_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFib6Sy3l68Q7kNvwEQYO8y&_nc_oc=AdqzM7FDkVLmYmpWfX5NEyXsBr7UxjIm4v9qU1bqJB1gfho_ddXmE1ganytLygWoKwM&_nc_zt=3&_nc_ht=scontent-ord5-
_sid=6e7a0a&_nc_ohc=3J9DFq0DTXcQ7kNvwHc8WNs&_nc_oc=Adovw68Oert4tiaGOFhKvhFrUS-DM59nBuPqz9NvF0B_4iEQ5PX-r_LO42CfX0oN7LA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1QxgYM9BYnjNEEs5CRWn5VX5xDSQJFFbvg3yR2pc6eA&oe=6ABBC4E7"}, {"file_name": "screenshot_02.png", "id": "441813883809734", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982478_441813887143067_2986964696433044405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HC2d7J85RO8Q7kNvwEQ1VGT&_nc_oc=Adq-vZmoU3DU3PfhTpNzBFo1P_opqcFpQMdbi0uk9NGQa0MLaUVA-iJvbxW9d9DTxSQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPCcbQXx-Kp-sb9eBaaq5FM0tsLtljEFiDklHl7V2PPA&oe=6ABBC79C"}, {"file_name": "screenshot_03.png", "id": "440158363886653", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984454_440158367219986_5081739348623505343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXwnlY1xvZsQ7kNvwGEiVpI&_nc_oc=Adp_ogZPPYekRfyMwkDmmtj5gnVcnEL06Wp_DsmdJQVCqRZdFNARs3NqJn5kFHSbRfI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILg6KNzxCEYgHqvA6MwZux8JOXn3v4eB8nW00PI_mDaw&oe=6ABBC4CF"}, {"file_name": "screenshot_05.png", "id": "813056236086867", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003239_813056239420200_1661077816866897120_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCrewX7gt5oQ7kNvwE8vSaw&_nc_oc=AdptB8qeeXgOOD4mKlRWycJ4IvK1eLqUEpf1TPGqDEsL2LGh7WrNd9tLblGjZJFLUu0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVCZxmSB-kfY97XDnyKgDggvtm6BVGzuygyF3o2G7WbA&oe=6ABBC730"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fugitive 3D", "keywords": [], "long_description": "Features:\n    - Cross-platform! VR and Flat players can play together.\n    - Server browser: Find a game quickly from any platform!\n    - Positional VOIP: hear the fugitives whispering in the bushes as you search for them.\n    - Watch the Replay: At the end of the round talk with everyone about how close they were to catching you as you all watch a replay over the round!\n    - Free and Open Source!\n    - Even runs on Android phones, so your one lame friend with no VR and no PC can still join in on the fun :P", "short_description": "Multiplayer, objective based, Hide & Seek! Cross-play between Flat and VR!\n\nPlay hide and seek with your friends on a warm summer night. Hide behind bushes as the Cops search for you. Make your way to the end zone without getting caught! If you're friend gets frozen by the police, you have to decide if it's worth trying to go rescue them. Or be the Cops, and drive around in your cop car shinning your flashlight into dark corners."}]}, "developer_name": "Stumpy Dog Studios", "developer_privacy_policy_url": "https://fugitivethegame.online/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Stumpy Dog Studios", "support_website_url": null, "website_url": "https://stumpy-dog-studios.itch.io/fugitive-3d", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "437090238169685"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036666_1556163801246867_6447318279780708782_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j23zGiw6nloQ7kNvwETayBi&_nc_oc=Adromyx6jcfk9bTUOGL5_d0kzx5DKPHdYu97DCO3F0WHgmX3hwG1NwQd6j9W14jorZM&_nc_zt=3&_nc_ht=scontent-ord5-
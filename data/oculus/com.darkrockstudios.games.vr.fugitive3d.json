_sid=6e7a0a&_nc_ohc=8o8YBnpiV-YQ7kNvwHWfC_W&_nc_oc=Adr_Taq7JI5aiSUMfy1WmaqUBAj7nErS0PPBwh8o5-4edyZvsr4tHAdGoZzSp418TaI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHAG9e9G-zi3e8OktfrTy7A3r7EfauG2BN8NJmqy39gw&oe=6AA7FE67"}, {"file_name": "screenshot_02.png", "id": "441813883809734", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982478_441813887143067_2986964696433044405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3HXljaSkDEQ7kNvwFukfgz&_nc_oc=AdqYpS6_QN-PEriSxuAGLLS9TiXTZaZlLbJT7CMdQNN0RepZ3TUek5WehbiKx-rgfWc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1ozsABe2bw8UFH8hfM9ls0zoGyd5gWTFeQCDMKGfCoA&oe=6AA8011C"}, {"file_name": "screenshot_03.png", "id": "440158363886653", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984454_440158367219986_5081739348623505343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDlomjM2vz8Q7kNvwHJ3vzh&_nc_oc=AdpIRXcPwlt4yet_t0hAHKj-yJoyKUxTGwNm92203S29AnAFAybq7oIx41zPkBB5_Yg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFOpADZCPAKcaHpn085q5OoJXZj8SvvE8PEW4o0CvusA&oe=6AA7FE4F"}, {"file_name": "screenshot_05.png", "id": "813056236086867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003239_813056239420200_1661077816866897120_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3ZQ_S_70L4Q7kNvwFk9sEL&_nc_oc=AdoFPMdY-_-ibo2dtvfhhVPykx92S9uFzfk8Acul7DJJ3cWM8-oozUZHC36KJ_HURYw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9kinB4dR07pUDHqMffM4FAXpmawEat-c3nadk-TGnuA&oe=6AA800B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fugitive 3D", "keywords": [], "long_description": "Features:\n    - Cross-platform! VR and Flat players can play together.\n    - Server browser: Find a game quickly from any platform!\n    - Positional VOIP: hear the fugitives whispering in the bushes as you search for them.\n    - Watch the Replay: At the end of the round talk with everyone about how close they were to catching you as you all watch a replay over the round!\n    - Free and Open Source!\n    - Even runs on Android phones, so your one lame friend with no VR and no PC can still join in on the fun :P", "short_description": "Multiplayer, objective based, Hide & Seek! Cross-play between Flat and VR!\n\nPlay hide and seek with your friends on a warm summer night. Hide behind bushes as the Cops search for you. Make your way to the end zone without getting caught! If you're friend gets frozen by the police, you have to decide if it's worth trying to go rescue them. Or be the Cops, and drive around in your cop car shinning your flashlight into dark corners."}]}, "developer_name": "Stumpy Dog Studios", "developer_privacy_policy_url": "https://fugitivethegame.online/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Stumpy Dog Studios", "support_website_url": null, "website_url": "https://stumpy-dog-studios.itch.io/fugitive-3d", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "437090238169685"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036666_1556163801246867_6447318279780708782_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6MDRC3oqHwQ7kNvwH4blWJ&_nc_oc=AdrHrJ1HPI7pu0lGDiVErv1THL4mRrXfoAXEpocGJRlgrEVFMGKZAVh28-ozH7Ru8rk&_nc_zt=3&_nc_ht=scontent-iad6-
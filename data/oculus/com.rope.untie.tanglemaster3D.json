_ss=7a30f&oh=00_Afx4NBcbZsbMwHpGK-SmEEMDo4_BA7s0-C34DvllvKIwjg&oe=69C28EFB"}, {"file_name": "SS4.png", "id": "2098496724258320", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499304938_2098496727591653_3844137180353188301_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rx82ZlMiJtQQ7kNvwE99QTZ&_nc_oc=AdqvddoF4syhMWqpcakhdNfF5CEvLoi6j57iQyz77JkgtWb2X9u8ETrRHgFk0S1F-_M&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxG4Digw6-p9AmZWKLdv8r-OuqsNoyF30D_qE7c-GgLVQ&oe=69C28AB8"}, {"file_name": "SS5.png", "id": "1957446248536488", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307422_1957446251869821_2214776567180596638_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZhhj2BEsYgQ7kNvwEi9lnM&_nc_oc=AdphO9VG03GVzCGAvxjofCbT9bFZc-fOZEUbdRwhiiSRzbUXtdZ0MBh7VAq-n24I-Jg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwSt6zFY57HvE3gkNxvzSSp3M2jC57k0DjmD1tJKSMjKQ&oe=69C29260"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "No More Tangles", "keywords": ["tangle", "master", "untie", "rope", "twisted"], "long_description": "**No More Tangles - Brain Puzzles** is a vibrant and relaxing **VR puzzle game** where colorful cables, playful electronic devices, and smart connections turn simple logic into deeply satisfying challenges.\n\nEach level presents cheerful, toy-like machines connected by twisted and overlapping cables. Using intuitive VR interactions, you grab, move, and rotate cables to untangle them and connect each plug to its correct socket without crossing or blocking other wires.\n\nDesigned with comfort and clarity in mind, the game features **bold colors, clean environments, and easy-to-understand interactions.** As you progress, puzzles become more complex, introducing additional cables, tighter layouts, and new device combinations that test your spatial awareness and logical thinking.\n\nWhether you want a calm, relaxing experience or a light mental challenge, **No More Tangles - Brain Puzzles** delivers accessible gameplay with rewarding **\u201caha\u201d** moments in every level.\n\n**Key Features:**\n\n- Colorful, toy-inspired VR puzzle environments\n\n- Cable-and-plug untangling mechanics\n\n- Natural grab, move, and rotate interactions\n\n- Progressive difficulty with thoughtful puzzle design\n\n- Comfortable, stationary gameplay suitable for all players\n\n- Clean visuals focused on readability and ease of play", "short_description": "Untangle, relax, and challenge your mind in a satisfying VR puzzle experience where every move matters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nomanawan89.wixsite.com/brokenengineers", "developer_terms_of_service_url": null, "publisher_name": "Broken Engineers", "support_website_url": null, "website_url": "https://nomanawan89.wixsite.com/brokenengineers", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25571987822491423"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1232107272345772"}, {"status": "PUBLISHED", "id": "942304024972581"}, {"status": "PUBLISHED", "id": "1967094220881342"}, {"status": "PUBLISHED", "id": "1135633948469463"}]}, "baseline_offer": {"id": "1135633948469463"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUB
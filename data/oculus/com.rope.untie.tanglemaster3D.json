QMNw&oe=699ED744"}, {"file_name": "SS3.png", "id": "2053523325401715", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307326_2053523328735048_1746245826379513994_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M605Y8poNy8Q7kNvwE84u4_&_nc_oc=AdniFEXZT1ozuJoIkC5UONOBhxoNIh9ZhY_RkPAvNOrN2xOUtGicYLycm9sEneEz3Ys&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfusaSjVDb4-ttDPaDJN1vT4aYpKI7qxkfMewEXcb6NpFw&oe=699EF67B"}, {"file_name": "SS4.png", "id": "2098496724258320", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304938_2098496727591653_3844137180353188301_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AisdnRAewKIQ7kNvwFDi8mS&_nc_oc=AdkbaCj0sVqQWKNB8mTjpIhxupgzeEuw3PMsITxAqvdHBkfLevZ1DC56URansu_AY9s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuReKocOJgv2cC4Zk5yiaMQgeTR0IGiNDb9FaRcCwM1PA&oe=699EF238"}, {"file_name": "SS5.png", "id": "1957446248536488", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307422_1957446251869821_2214776567180596638_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSB2ST0gyJcQ7kNvwGpjH7J&_nc_oc=AdnceaOSPGs9fL3do_DNnD0ARLshjkSnq8sArKJvja4h2Hvnu_VlW67MLCn0M4rc4SI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsWZVLwgMP0VOT1xH44hNy2R03GYLwiyGXJEfpGFnt5zg&oe=699EF9E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "No More Tangles", "keywords": ["tangle", "master", "untie", "rope", "twisted"], "long_description": "**No More Tangles - Brain Puzzles** is a vibrant and relaxing **VR puzzle game** where colorful cables, playful electronic devices, and smart connections turn simple logic into deeply satisfying challenges.\n\nEach level presents cheerful, toy-like machines connected by twisted and overlapping cables. Using intuitive VR interactions, you grab, move, and rotate cables to untangle them and connect each plug to its correct socket without crossing or blocking other wires.\n\nDesigned with comfort and clarity in mind, the game features **bold colors, clean environments, and easy-to-understand interactions.** As you progress, puzzles become more complex, introducing additional cables, tighter layouts, and new device combinations that test your spatial awareness and logical thinking.\n\nWhether you want a calm, relaxing experience or a light mental challenge, **No More Tangles - Brain Puzzles** delivers accessible gameplay with rewarding **\u201caha\u201d** moments in every level.\n\n**Key Features:**\n\n- Colorful, toy-inspired VR puzzle environments\n\n- Cable-and-plug untangling mechanics\n\n- Natural grab, move, and rotate interactions\n\n- Progressive difficulty with thoughtful puzzle design\n\n- Comfortable, stationary gameplay suitable for all players\n\n- Clean visuals focused on readability and ease of play", "short_description": "Untangle, relax, and challenge your mind in a satisfying VR puzzle experience where every move matters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nomanawan89.wixsite.com/brokenengineers", "developer_terms_of_service_url": null, "publisher_name": "Broken Engineers", "support_website_url": null, "website_url": "https://nomanawan89.wixsite.com/brokenengineers", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25571987822491423"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"
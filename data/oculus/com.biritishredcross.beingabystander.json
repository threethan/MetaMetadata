 on first load.", "short_description": "Would you step in to help someone in need?"}]}, "developer_name": "ImmersiveVR Ltd", "developer_privacy_policy_url": "https://www.redcross.org.uk/privacy", "developer_terms_of_service_url": "https://www.redcross.org.uk/terms-and-conditions", "publisher_name": "British Red Cross", "support_website_url": null, "website_url": "https://www.redcross.org.uk/bystander", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "621428992485243"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162686_216148875734631_4251806293469167616_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8THYuOdLSskQ7kNvwHLCHt6&_nc_oc=Adle33eoQaTMSW_IP40KVFG-ewK8jW2J6T9sv-xUwMYxF5SlfRzD8ohW2duJWIWSf5U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuyIpVyRKwheC4DphXRJzTj8olmKwlGarNZQD2lHPhzdA&oe=69A2D40B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Being a Bystander", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1534435200, "lastRevision": {"nodes": [{"id": "2111908625761520", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1630345863750550", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "63
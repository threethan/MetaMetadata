houghts of 4 different people and experience the power of kindness.\n\nUse headphones to experience the 3D audio. \n\nThis app downloads an additiona. 340MB on first load.", "short_description": "Would you step in to help someone in need?"}]}, "developer_name": "ImmersiveVR Ltd", "developer_privacy_policy_url": "https://www.redcross.org.uk/privacy", "developer_terms_of_service_url": "https://www.redcross.org.uk/terms-and-conditions", "publisher_name": "British Red Cross", "support_website_url": null, "website_url": "https://www.redcross.org.uk/bystander", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "621428992485243"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162686_216148875734631_4251806293469167616_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAWmW3YbkP0Q7kNvwE2NsFD&_nc_oc=Adr0vHV_U1hnBEfkN8OgH8V7jHkAZU-K52dD_d6SW0UZVErlx7KKqvK-qn9T5NylAZY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkCfeMn-ag_uIZ9CnWCxii4qip78rAL4UarWrsAPntcQ&oe=6AB14FCB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Being a Bystander", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1534435200, "lastRevision": {"nodes": [{"id": "2111908625761520", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"defau
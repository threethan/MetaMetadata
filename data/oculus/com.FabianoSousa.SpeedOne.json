rgtAN-28RarxbZjv2UNshxrYAgeKR8AHNd_ngqBmPX0kzE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOk22SEBnp-YUZ_jbnVAUDFd54zoIF5j-hzSTK6EctavA&oe=6ACD0421"}, {"file_name": "Screenshots 2560 x 1440px 5.png", "id": "1556480058531622", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982500_1556480061864955_8088281580031592040_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7Zi5m3vTUoQ7kNvwGvC6Bb&_nc_oc=Ado2kEhQoTw07rJWmycrWlJL9AVWqtZMhu09cRuEJUFJ0yiRfpXpm-lPZL119irODg4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDpxnUffI9ad8gCY2YccxzC_91HrkTZ8N78fbTEdBI6A&oe=6ACCFEA7"}, {"file_name": "Screenshots 2560 x 1440px 3.png", "id": "1541462143087388", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984461_1541462146420721_8867480191941042972_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kah4zuBWbPMQ7kNvwEffHUQ&_nc_oc=AdpG92l9zkY9nVihmTdZA6W66A1UtOjGsSv1t4DMHNBYSHoxAHEK7J0M6g7GLIVKvvY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIAzW71mK6KcZrDbtSJu06Ai5dMyj9RMTRBQcMdr3sKw&oe=6ACCE8A6"}, {"file_name": "Screenshots 2560 x 1440px 2.png", "id": "1117606969382087", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974544_1117606972715420_7641892375241908929_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pw9DrG193ZkQ7kNvwF30IXl&_nc_oc=AdrLYXC0mhLCu89X_m8UhvKRvLsryfIQivxAuQ0Yr8LDzfiEJTPJLnSk5l2BrPayrp4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONWE5F5nxgxpDwPc214L0Ygc9qfOmjQQul8hCy2xhcig&oe=6ACCEADC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshots 2560 x 1440px 2.png", "id": "665697875609329", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75367589_665697878942662_5889780060250420793_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJeGuSovfK0Q7kNvwHI5V9O&_nc_oc=AdpcyjE3bE1jjKysg_BE5u4f_V8BDcZ1fG3A-CR7sSbgp68JM-YCwMpD5GM15wPCwmM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtROg82SgYQ04MJYNlv8yVteIP_E2btQNnUcM2tA9aJg&oe=6ACCFFD9"}, "display_name": "Speed One - Real Racing", "keywords": [], "long_description": "Embark on a thrilling automotive journey with Speedy One, the racing game designed exclusively for Oculus Quest 2. This innovative experience aims to redefine the standards of realism and immersion, transporting players to the pulsating world of high-speed racing.\n\nIn Speedy One, you become the owner of the tracks, taking full control of your racing experience. From selecting customizable cars to strategically choosing challenging tracks, every detail contributes to creating an authentic atmosphere of automotive competition.\n\nFeel the power of roaring engines as you accelerate through the tracks, tackling tight corners and overtaking skilled opponents. The advanced technology of Oculus Quest 2 provides stunning graphics and immersive sensations, allowing you to fully immerse yourself in the racing experience.\n\nThe competition is intense, and your driving skills will be pushed to the limit. Choose wisely from a variety of cars with unique characteristics, fine-tune your vehicles to suit your driving style, and get ready for thrilling races that will challenge your dexterity and strategy.\n\nSpeedy One is more than just a racing game; it's a visceral experience that puts you at the center of the action. Race, push your limits, and prove that you're the undisputed master of the tracks. This is your chance to live the thrill of real racing from the comfort of your own virtual reality.", "short_description": "Speedy One delivers an immersive and realistic racing experience for Oculus Quest 2. Become the master of the tracks, choose from a variety of cars, and race, race, race to your heart's content!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.midnightstrike.com.br/fabiano/SpeedOne/privacy_police.html", "developer_terms_of_service_url": null, "publisher_name": "Fabiano Sousa", "support_website_url": null, "webs
": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974544_1117606972715420_7641892375241908929_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwl6ASI3czMQ7kNvwGOaqiv&_nc_oc=AdpTQz_YmTYXeQLB7R9HfigBEQsAwiTeUde6a3VUkXB1fFFQD_Xg-0xEsYJ23Azdm_4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDUZV-XH7vBjWMvklP4HKhopxMr6PXEIatc2BfYPvDvw&oe=6ACB995C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshots 2560 x 1440px 2.png", "id": "665697875609329", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75367589_665697878942662_5889780060250420793_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJeGuSovfK0Q7kNvwHaSUvw&_nc_oc=AdoFu0AAds2a_qjmRM4fhYht96Nqz6vwcx-geuwPgELhiB8_uITTvL8mmD371MDXJww&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOc_P_dCoK2hn0pfzpR5aWwFngsDXWSDy-mtL0cEbiJtw&oe=6ACBAE59"}, "display_name": "Speed One - Real Racing", "keywords": [], "long_description": "Embark on a thrilling automotive journey with Speedy One, the racing game designed exclusively for Oculus Quest 2. This innovative experience aims to redefine the standards of realism and immersion, transporting players to the pulsating world of high-speed racing.\n\nIn Speedy One, you become the owner of the tracks, taking full control of your racing experience. From selecting customizable cars to strategically choosing challenging tracks, every detail contributes to creating an authentic atmosphere of automotive competition.\n\nFeel the power of roaring engines as you accelerate through the tracks, tackling tight corners and overtaking skilled opponents. The advanced technology of Oculus Quest 2 provides stunning graphics and immersive sensations, allowing you to fully immerse yourself in the racing experience.\n\nThe competition is intense, and your driving skills will be pushed to the limit. Choose wisely from a variety of cars with unique characteristics, fine-tune your vehicles to suit your driving style, and get ready for thrilling races that will challenge your dexterity and strategy.\n\nSpeedy One is more than just a racing game; it's a visceral experience that puts you at the center of the action. Race, push your limits, and prove that you're the undisputed master of the tracks. This is your chance to live the thrill of real racing from the comfort of your own virtual reality.", "short_description": "Speedy One delivers an immersive and realistic racing experience for Oculus Quest 2. Become the master of the tracks, choose from a variety of cars, and race, race, race to your heart's content!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.midnightstrike.com.br/fabiano/SpeedOne/privacy_police.html", "developer_terms_of_service_url": null, "publisher_name": "Fabiano Sousa", "support_website_url": null, "website_url": "https://www.midnightstrike.com.br/fabiano/SpeedOne", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7567657086627101"}}]}, "scheduled_offers": {"count": 26, "nodes": [{"status": "PUBLISHED", "id": "1611833767257561"}, {"status": "PUBLISHED", "id": "2295081738006546"}, {"status": "PUBLISHED", "id": "2479641819202272"}, {"status": "PUBLISHED", "id": "1016254757570591"}, {"status": "PUBLISHED", "id": "2165351397562490"}, {"status": "PUBLISHED", "id": "1732200524419206"}, {"status": "PUBLISHED", "id": "942786748437808"}, {"status": "PUBLISHED", "id": "1206236494999601"}, {"status": "PUBLISHED", "id": "26139063245724262"}, {"status": "PUBLISHED", "id": "2295189067648516"}, {"status": "PUBLISHED", "id": "1316271896932459"}, {"status": "PUBLISHED", "id": "25612248348371130"}, {"status": "PUBLISHED", "id": "796143269701285"}, {"status": "PUBLISHED", "id": "589601594234299"}, {"status": "PUBLISHED", "id": "1173046160489892"}, {"status": "PUBLISHED", "id": "4012187499047134"}, {"status": "PUBLISHED", "id": "615604674435736"}, {"status": "PUBLISHED", "id": "1321590172303206"}, {"status": "PUBLISHED", "id": "1179145503882178"}, {"status": "PUBLISHED", "id": "551926577609444"}, {"status": "PUBLISHED", "id": "1217967639657975"}, {"status": "PUBLISHED", "id": "3695602057366765"}, {"status": "PUBLISHED", "id": "498984659315329"}, {"status": "PUBLISHED", "id": "999083785556367"}, {"status": "PUBLISHED", "id": "2343666835821172"}, {"status": "PUBLISHED", "id": "458033476618674"}]}, "baseline_offer": {"id": "1206236494999601"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1611833767257561"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28928814050084762", "version": "3.0.4"}, "id": "338814269131962", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7535297866529690", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28928814050084762"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "338814269131962"}]}, "change_log": "Speed One v3.0.4\n\u2022 Multiplayer mais est\u00e1vel: cada piloto agora tem uma vaga garantida no grid de largada.\n\u2022 A corrida online n\u00e3o trava mais quando algu\u00e9m sai ou cai, nem na espera da largada nem no p\u00f3dio.\n\u2022 Nome e cor dos advers\u00e1rios online sincronizam direito.\n\u2022 Melhorias de desempenho no Quest 2 e no Quest 3, pra uma corrida mais fluida.\n\u2022 Corre\u00e7\u00f5es gerais de bugs.\n\nSpeed One v3.0.4\n\u2022 More stable multiplayer: every driver now gets a guaranteed starting grid slot.\n\u2022 Online races no longer freeze when someone leaves or disconnects, during the start wait or on the podium.\n\u2022 Opponent names and colors sync correctly online.\n\u2022 Performance improvements on Quest 2 and Quest 3 for a smoother race.\n\u2022 General bug fixes.", "created_date": 1791329835, "id": "28928814050084762", "version": "3.0.4", "version_code": 37, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28928808686751965"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7535297866529690", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28928814050084762"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "338814269131962"}]}, "change_log": "better menu and pet", "created_date": 1767310238, "id": "25784335084532690", "version": "3.0.3", "version_code": 36, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "25784331124533086"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7535297866529690", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28928814050084762"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"
s=7f20f&oh=00_AQDhA5S0RaoaGDUNc1UCm0ZCgLqZmo0mPWlQsh6MvM3SOA&oe=6A6CA4A2"}, {"file_name": "Screenshot - 4.png", "id": "1034256398572499", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392006_1034256401905832_916406133103083175_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOCuu3xK7RkQ7kNvwFc8q-i&_nc_oc=AdozhCwfq-FElng28EMTUPUgqkjkQDn87995zLQkiGYf2MiYPZ_OKv8Guq08IWdDzSg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqMNcAFiQGHu63kFJtzPektFBV6KN72v1vYv8bZOMDSQ&oe=6A6CA64E"}, {"file_name": "Screenshot - 5.png", "id": "718818050501461", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394202_718818053834794_7665903363271797667_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYekVyRq_r0Q7kNvwF5UoId&_nc_oc=Adr3F1TjESiNpfDh5xlEjbPAdgqMrx_L5ePUM6-6gpqQEa_AqwsVCPUOuxcR9b2ZTfE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA62dFSgbXCixbUp1ZjQBLIsPMQ6Av2Ex4xS5I1iwEFSw&oe=6A6CA58C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt_Landscape.png", "id": "1027457658802031", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392046_1027457662135364_2308984832068190577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68EIrtK2GH0Q7kNvwGhLwG5&_nc_oc=AdprnDf4FXoPjBYMOeokNVKGpUmPQs9A4O5FYsVBeKz810u1w88cz_2IWBuct87ceoA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMMPGXi66ZkrK0n5CDLwqN-2BCXr5yNEJJ-SkY9WJB4Q&oe=6A6CC105"}, "display_name": "Remnant Protocol", "keywords": ["flight", "sim", "simulator", "strategy", "scifi"], "long_description": "The assassination of the Blessed Mother has plunged the galaxy in darkness. Usurpers rule with absolute authority, and blood flows in rivers of red across the stars. Only the Protocol can restore Her light. \n\n{992787059659848}\n\n**Remnant Protocol** is a space flight sim with a strategy layer that puts you in command of a galactic rebellion.\n\nFrom Sanctuary, your hidden rebel base deep in the outer territories, wage a guerrilla war against the Usurpers who rule with oppressive authority over the galaxy. Your mission: to create an underground movement that will eventually bring down the totalitarian regime through acts of sabotage and subterfuge.\n\n{2830795767105859}\n\nRaid outposts, make alliances, manufacture ships, research new technologies and lead your wingmates in battle. Outnumbered and outgunned against a sprawling empire, you must be resourceful as well as ruthless if you're to succeed.\n\n# KEY FEATURES\n\n* **Intense dogfighting action.**  Hop in the cockpit and take command from the vanguard in your own personal fighter.\n\n* **Rebellion on a galactic scale.**  As commander of a hidden rebel base , you'll make difficult choices required of the long campaign to reclaim the throne. It's entirely up to you how your limited resources and personnel are allocated for the war effort.\n\n* **You are being hunted.** The enemy is actively searching for your secret base, and each ploy that advances your campaign's goals increases your notoriety and risk of discovery.\n\n{9389236474531607}\n\nThe fate of the galaxy is in your hands.", "short_description": "The assassination of the Blessed Mother has plunged the galaxy in darkness. Usurpers rule with absolute authority, and blood flows in rivers of red across the stars. Only the Protocol can restore Her light."}]}, "developer_name": "Progenitor Game Studios Ltd.", "developer_privacy_policy_url": "https://progenitorgamestudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Progenitor Game Studios Ltd.", "support_website_url": null, "website_url": "https://www.progenitorgamestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "275629210202852"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "ge
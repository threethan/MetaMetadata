5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWnDpRDIPPCMiA_SPOFo5DekK5ifuaMhff-kwxgNdv0Q&oe=6ACB90A2"}, {"file_name": "Screenshot - 4.png", "id": "1034256398572499", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392006_1034256401905832_916406133103083175_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fB7YkL40I_wQ7kNvwF2HrSx&_nc_oc=AdouG-7R1bvmn-F1Sgq5u4W9oG4SNVbmL-nHSiKMJAsFW45C3mVIT6OSZBJfgdWB2zA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNi7rKM1JnzUVWieLH6jB4jcQ4A5aIv0NUXBohV2GOLXg&oe=6ACB924E"}, {"file_name": "Screenshot - 5.png", "id": "718818050501461", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394202_718818053834794_7665903363271797667_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=104oSNFKm3QQ7kNvwEsvY77&_nc_oc=Adr9IMmXiKUkUYUZ7ifzIycaPExsVYQdFyQ_0g-SGdA4hbBxxAd_FXnx2tLYe5GJIcc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhI7zUCEgSR1tY7n019yYMAvm6quYmbH1_w4lIzrqjhw&oe=6ACB918C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt_Landscape.png", "id": "1027457658802031", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392046_1027457662135364_2308984832068190577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckhjIRfGeVEQ7kNvwFnCHHh&_nc_oc=Adr_YjxValkFdlVCLCb-kt6NnSpnEeuSFyfLLWA7rdyjwZ5IJkZ8gvPlx9sitmWNE3U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrc-qleHtdGjE5H74seeMSl8KQJVonbUYKE0vkuhimpA&oe=6ACBAD05"}, "display_name": "Remnant Protocol", "keywords": ["flight", "sim", "simulator", "strategy", "scifi"], "long_description": "The assassination of the Blessed Mother has plunged the galaxy in darkness. Usurpers rule with absolute authority, and blood flows in rivers of red across the stars. Only the Protocol can restore Her light. \n\n{992787059659848}\n\n**Remnant Protocol** is a space flight sim with a strategy layer that puts you in command of a galactic rebellion.\n\nFrom Sanctuary, your hidden rebel base deep in the outer territories, wage a guerrilla war against the Usurpers who rule with oppressive authority over the galaxy. Your mission: to create an underground movement that will eventually bring down the totalitarian regime through acts of sabotage and subterfuge.\n\n{2830795767105859}\n\nRaid outposts, make alliances, manufacture ships, research new technologies and lead your wingmates in battle. Outnumbered and outgunned against a sprawling empire, you must be resourceful as well as ruthless if you're to succeed.\n\n# KEY FEATURES\n\n* **Intense dogfighting action.**  Hop in the cockpit and take command from the vanguard in your own personal fighter.\n\n* **Rebellion on a galactic scale.**  As commander of a hidden rebel base , you'll make difficult choices required of the long campaign to reclaim the throne. It's entirely up to you how your limited resources and personnel are allocated for the war effort.\n\n* **You are being hunted.** The enemy is actively searching for your secret base, and each ploy that advances your campaign's goals increases your notoriety and risk of discovery.\n\n{9389236474531607}\n\nThe fate of the galaxy is in your hands.", "short_description": "The assassination of the Blessed Mother has plunged the galaxy in darkness. Usurpers rule with absolute authority, and blood flows in rivers of red across the stars. Only the Protocol can restore Her light."}]}, "developer_name": "Progenitor Game Studios Ltd.", "developer_privacy_policy_url": "https://progenitorgamestudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Progenitor Game Studios Ltd.", "support_website_url": null, "website_url": "https://www.progenitorgamestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "275629210202852"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9526524467441905"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1101088908946121"}, {"status": "PUBLISHED", "id": "1679616949939802"}]}, "baseline_offer": {"id": "1679616949939802"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1101088908946121"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28270688172598918", "version": "Early Access 2026.09.16.A"}, "id": "1092996715456395", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7105204019573974", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28270688172598918"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1092996715456395"}]}, "change_log": "Staffing is sorted and the team is firing on all cylinders with a huge update.\n\nThe VR controls have been completely revamped from scratch with a new in-house interaction system that gives us complete control. Haptics included.\n\nPhase one has converted the flight sticks and command console, with phase two covering the rest of the cockpit instruments [currently in development].\n\nAdditionally, Attrition and Last Stand both have brand-new mechanics and structure with improved UI and world readability.\n\nTransitions are significantly less jarring with better in-world fantasy.\n\nWe've re-enabled canopy glass with a more performant shader that dramatically increases immersion. The HUD also has proper collimation that should make aiming easier.\n\nPlus a number of small improvements:\n- Pause during missions (menu button)\n- Improved settings menu (music, control scheme)\n- Significantly increased lock on distance\n- Combat feedback slightly improved (hitmarkers, enemy lock bar)\n- Barrels visually gimbal while locking\n- Radar and HUD now agree on which way to turn\n\nAs always, we look forward to your feedback!", "created_date": 1789585256, "id": "28270688172598918", "version": "Early Access 2026.09.16.A", "version_code": 385, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7105204019573974", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28270688172598918"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1789580223, "id": "28269890766011992", "version": "Early Access 2026.09.16.A", "version_code": 380, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7105204019573974", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28270688172598918"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1788372370
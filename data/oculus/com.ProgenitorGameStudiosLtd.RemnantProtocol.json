=1-7&_nc_sid=6e7a0a&_nc_ohc=VJ16s_XT9FUQ7kNvwHTQl0e&_nc_oc=AdrzharLKV-BwnfkvzcYZ6RP6knA26ZHMEcuKPS1iQEhfCRO9Ngf4G_u-RQsVWIMxq4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABc6tyuOK6unl2iRCjxqQsDIAugwm0e_VFhP0f0PvqIQ&oe=6A490DCE"}, {"file_name": "Screenshot - 5.png", "id": "718818050501461", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394202_718818053834794_7665903363271797667_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wdx33Let2qsQ7kNvwFxwpT2&_nc_oc=Adrgy5MuFvnFtdl1cnYVDOTWM5jZ0wJUHZ4Oxbpf9ik98yK47jfhU4-HHSShWxtV9MY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbPgZYkYjwHr50tk3pb7VQKL-MdiOi8fhHes0Y4xqpPA&oe=6A490D0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt_Landscape.png", "id": "1027457658802031", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392046_1027457662135364_2308984832068190577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Mbj7nSv4jcQ7kNvwHEzKXK&_nc_oc=AdoKtwNvD8rn3DE_07WiG-4ZzcHidKNiqn6V7L7XMYgdhf5GiXCf-HDWJgI94YzPqao&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpH8On-5ihkLCwWKuPcZiKU8lK0S49Q_cCybktC-ZZHQ&oe=6A492885"}, "display_name": "Remnant Protocol", "keywords": ["flight", "sim", "simulator", "strategy", "scifi"], "long_description": "Remnant Protocol is currently in **ALPHA**  during Early Access, with the following features:\n+ **Attrition**: a ticket-style squadron battle where you and your wingmates battle for supremacy against the Usurpers.\n+ **Last Stand**: an endless wave of Usurpers are coming for you. How long can you survive?\n+ **Flight Training**: learn the ropes in a safe environment.\n\n{992787059659848}\n\n# EARLY ACCESS ROADMAP\n\n**EARLY JULY**\n+ NEW FLYABLE SHIP\n+ FLAGSHIP GAME MODE\n+ CAPITAL SHIPS\n + REFINED FLIGHT DYNAMICS\n\n{2830795767105859}\n\n**LATE JULY**\n+ CONQUEST GAME MODE\n+ NEW ENEMY SHIPS\n+ NEW ENVIRONMENTS\n+ MORE SHIP WEAPONS\n+ MORE SHIP AUXILIARIES (SPECIAL ABILITIES)\n+ IMPROVED AUDIO\n+ IMPROVED VISUAL EFFECTS\n+ IMPROVED PERFORMANCE\n\n{9389236474531607}\n\nWe're looking forward to your feedback as we continue to build the game.", "short_description": "ALPHA SANDBOX EARLY ACCESS AVAILABLE NOW!\n\nRemnant Protocol is currently in ALPHA and under active development. We need your help shaping development, so hop in the cockpit and join the fight!"}]}, "developer_name": "Progenitor Game Studios Ltd.", "developer_privacy_policy_url": "https://progenitorgamestudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Progenitor Game Studios Ltd.", "support_website_url": null, "website_url": "https://www.progenitorgamestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27271258785875200"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393355_962462139361802_7296277486255833995_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpwWHyFV47IQ7kNvwER5u8C&_nc_oc=AdpT6gwP0UsJAZuO2CEdUxxIzpTAJX7gDKUqarpGpFWJME1xn8b_KyhIX9ezDULrNxA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDubzuhC0M2_ie0I7XFnRgpIDF2gAjpYPwblVFngba1vw&oe=6A492BBB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Remnan
splay_name": "Slip Taggers V2", "keywords": [], "long_description": "\"Slip Taggers V2\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity.\nThe objective of Slip Taggers V2 is simple yet delightful: players use virtual reality tools to create beautiful, glowing art installations throughout the game world.\nThese installations can take the form of intricate patterns.", "short_description": "\"Slip Taggers V2\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity.\nThe objective of Slip Taggers is simple yet delightful: players use virtual reality tools to create beautiful, glowing art installations throughout the game world.\nThese installations can take the form of intricate patterns."}]}, "developer_name": "viper", "developer_privacy_policy_url": "https://docs.google.com/document/d/19KnJVxh5aWW11jNEs-_md9KtptWUlPPdnjh_f9FSjQE/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "viper", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1epkgASD15DUEwBI50-lcmh-r_4bcBEHQEi1e8bSPZpY/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
3.png", "id": "27939116845758736", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499620630_27939116849092069_1719458433438721566_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRKqpceGCkUQ7kNvwEQN0En&_nc_oc=Adrgy89tsAKqydGNwRYhcfsFDgyZWwEVms1zN40Xx2DckCGVCje_qGsnxG5fenRqKsc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHVNhmmDDI6pFrGFiHCsu4r9ebzDIuJ-cXZvs5M45e8g&oe=6AA94756"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SkeleSlayerCoverImageLandscape.png", "id": "1586109369699919", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499296127_1586109373033252_9073637978860929496_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4Zj_XnXyDYQ7kNvwHIO7E5&_nc_oc=AdqMp4_MXC7zUlE5hDUgrWgJc1YoEs9XWbnYNSjoMAfFd6FoIsLzoWq4K_ZPySBZ8LU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdmGOkoiik8PhDVDeCvDTZ0kQqO8ofO-h1ik_P-xLQVw&oe=6AA94E15"}, "display_name": "SkeleSlayer", "keywords": ["Swords", "Skeletons", "Fitness", "Singleplayer", "Action"], "long_description": "A skeleton-slaying fitness and arcade game. Enhance your physical and cognitive fitness via combat sessions. Slash and smash your way through an endless wave of skeletons, surviving for as long as you can.\n\nSingle-player. Free to play.\n\nStatistics package available for in-app purchase to track your progress over time. Variety of weapons.\n\nPrimarily created for standing play, since skeletons spawn in a 360 degree circle around the player. However, it could be played in a swivel chair.\n\nEnjoy :)\n\nJoin the SkeleSlayer Discord! https://discord.gg/Yc6UQ5CVRq", "short_description": "A skeleton-slaying fitness and arcade game. Enhance your physical and cognitive fitness via combat sessions. Slash and smash your way through an endless wave of skeletons, surviving for as long as you can.\n\nSingle-player. Free to play.\n\nStatistics package available for in-app purchase to track your progress over time. Variety of weapons.\n\nPrimarily created for standing play, since skeletons spawn in a 360 degree circle around the player. However, it could be played in a swivel chair.\n\nEnjoy :)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://maddyv.xyz/skeleslayer-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "XRchitect Studios", "support_website_url": null, "website_url": "https://maddyv.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28514471378150707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499619704_2460376397807440_6910258557638220886_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cb866dIvygwQ7kNvwFbxij3&_nc_oc=AdqrqZsnoSU84f1hRQypgcabzaMzFo5h2urn_aKkORsMUjTD5vWoItO5Ll9Gbkk5iYY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_yY7l1sAGdxnbfE1wRoOj711RRbK2PPi_OnY-qdXZCw&oe=6AA94072"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SkeleSlayer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1785312000, "lastRevision": {"nodes": [{"id": "26918270024437525", "release_type
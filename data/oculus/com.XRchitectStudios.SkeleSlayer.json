orEiXhsQ9gqYxGyoZLko0mII-vRuXIRCgVVoEhFmpO8oFxmYx-VwtNdw2QeCg3l0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQShLhnlh7QRK0TxDCKLpYfw9YGR8iq1bRlgRfdJydML1w&oe=6B0C7C35"}, {"file_name": "SkeleSlayer_StatsUI_v1.0.3.png", "id": "27939116845758736", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620630_27939116849092069_1719458433438721566_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CH5eHDkdorQQ7kNvwFCfKj5&_nc_oc=AdqGJ5tGfe9UZwOaYOYla1P_sO1HSGCM4BxvWxpS_E_uXAbf_It7MGMrOH7TPY8QylY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS0mW7oobC186dN_LD5sWNhQuq0QbJluSFaGg_rZMugpg&oe=6B0C6016"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SkeleSlayerCoverImageLandscape.png", "id": "1586109369699919", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296127_1586109373033252_9073637978860929496_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o32vbdF9oP8Q7kNvwFjz_PZ&_nc_oc=AdqHABxu_vYA0e-rkDfyB9eTJt7tzqlJrTExPJlqSlw8SMU7gF0L0MmixLSRRZiWnWU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ4BdrQjTzyBuzl6cr4nzzkYwuIzKs54Tx9XAi0omWyKA&oe=6B0C66D5"}, "display_name": "SkeleSlayer", "keywords": ["Swords", "Skeletons", "Fitness", "Singleplayer", "Action"], "long_description": "A skeleton-slaying fitness and arcade game. Enhance your physical and cognitive fitness via combat sessions. Slash and smash your way through an endless wave of skeletons, surviving for as long as you can.\n\nSingle-player. Free to play.\n\nStatistics package available for in-app purchase to track your progress over time. Variety of weapons.\n\nPrimarily created for standing play, since skeletons spawn in a 360 degree circle around the player. However, it could be played in a swivel chair.\n\nEnjoy :)\n\nJoin the SkeleSlayer Discord! https://discord.gg/Yc6UQ5CVRq", "short_description": "A skeleton-slaying fitness and arcade game. Enhance your physical and cognitive fitness via combat sessions. Slash and smash your way through an endless wave of skeletons, surviving for as long as you can.\n\nSingle-player. Free to play.\n\nStatistics package available for in-app purchase to track your progress over time. Variety of weapons.\n\nPrimarily created for standing play, since skeletons spawn in a 360 degree circle around the player. However, it could be played in a swivel chair.\n\nEnjoy :)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://maddyv.xyz/skeleslayer-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "XRchitect Studios", "support_website_url": null, "website_url": "https://maddyv.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28514471378150707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619704_2460376397807440_6910258557638220886_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9j-SJ_i4Lu4Q7kNvwH9wLwN&_nc_oc=AdrJN_gjsc0RdMAt1Etj2O13OctDzJWl4U30GRfeClupVcJ31fNmfdoY_hUdemXxmrg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT0n1-XVM-D1um7bR-gQJbfn5F5o_NpBuwipY6B1sRm9w&oe=6B0C5932"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SkeleSlayer", "platform": "AND
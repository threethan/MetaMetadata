=1-7&_nc_sid=6e7a0a&_nc_ohc=Xop5WVRrrkwQ7kNvwGnr-d3&_nc_oc=AdrDersQ-AxnXWP5FJ3XKM_0lm5hErTWrBXlL1k42rJhPTV0ftpaa3WaTJB-5ffzWBs&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYZ1CaiCCUhJd5RQ2M1fo-4u-tQOGBze1xmKgPSmW3Rw&oe=6A93FDD5"}, "display_name": "SkeleSlayer", "keywords": ["Swords", "Skeletons", "Fitness", "Singleplayer", "Action"], "long_description": "A sword-swinging, skeleton-slaying fitness and arcade game. Enhance your physical and cognitive fitness level in a fun, engaging way. Slash your way through an endless wave of skeletons, surviving for as long as you can.\n\nSingle-player. Free to play.\n\nStatistics package available for in-app purchase to track your progress over time.\n\nPrimarily created for standing play, since skeletons spawn in a 360 degree circle around the player. However, it could be played in a swivel chair.\n\nEnjoy :)\n\nJoin the SkeleSlayer Discord! https://discord.gg/Yc6UQ5CVRq", "short_description": "A sword-swinging, skeleton-slaying fitness and arcade game. Enhance your physical and cognitive fitness level in a fun, engaging way. Slash your way through an endless wave of skeletons, surviving for as long as you can.\n\nSingle-player. Free to play.\n\nStatistics package available for in-app purchase to track your progress over time.\n\nPrimarily created for standing play, since skeletons spawn in a 360 degree circle around the player. However, it could be played in a swivel chair.\n\nEnjoy :)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://maddyv.xyz/skeleslayer-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "XRchitect Studios", "support_website_url": null, "website_url": "https://maddyv.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED"
xMPK2FejQR9ckcqZFuH76zmplJYE5rGx873g9TX_TdcyRuC0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmxnpJ4JAf3m-eOO20_UI4VMaLgmK96kG6nEsUn01Wyg&oe=6AD389D6"}, {"file_name": "HighresScreenshot00009.png", "id": "1473563077284729", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499623314_1473563080618062_4367040088212853579_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLilZ7ESGBsQ7kNvwFwgYU1&_nc_oc=Adry4mHgLGLggSqhhgHTwsTx_I79_eryXR9ud5oYHtt0_GK99u5TpZksayp6mbh6Y-Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMa3H_wf9pPLjVC7RKJjauMJx-RKtWelsQGnsp9rKNoPA&oe=6AD3AFDD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Electric Vehicle Motor Systems", "keywords": [], "long_description": "Electric Vehicle Motor Systems is an immersive VR training application developed to help learners understand the core components, functionality, and diagnostics of electric vehicle motor systems. Through interactive simulations, users gain practical experience with motor assemblies, controllers, and troubleshooting procedures in a safe, virtual environment.\n\nThis application is exclusively designed as a part of the Immerse Learn Electric Vehicle Motor Systems micro-credential program. It is not a standalone product\u2014access is restricted to learners who are officially enrolled in the program. The VR experience complements theoretical learning by providing hands-on training that enhances technical skills and real-world readiness in the rapidly growing EV industry.\n\nIdeal for students and technicians seeking practical exposure, this app bridges the gap between knowledge and application through immersive learning.", "short_description": "Electric Vehicle Motor Systems is a VR training app designed for hands-on learning of EV motor components, diagnostics, and system operations. This application is part of the Immerse Learn Electric Vehicle Motor Systems micro-credential program and is accessible only to e
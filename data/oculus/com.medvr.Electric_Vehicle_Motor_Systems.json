QFhaFxdChGL0oSfJR1ZsLs7W8a1Zn1WJC0A&oe=6AC3B7D6"}, {"file_name": "HighresScreenshot00009.png", "id": "1473563077284729", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623314_1473563080618062_4367040088212853579_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jmfbnef4R_EQ7kNvwFRNFhw&_nc_oc=AdryE2WERbjeVYv9tCY9cBTWpTbwAe4ixgXxmeXDBV8dbdcFwwANbY5srWzifsa6688&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPf_guW8Kitd6M32hLuOd7RwkHD-AlKEYyB2rMQ36qexQ&oe=6AC3A59D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Electric Vehicle Motor Systems", "keywords": [], "long_description": "Electric Vehicle Motor Systems is an immersive VR training application developed to help learners understand the core components, functionality, and diagnostics of electric vehicle motor systems. Through interactive simulations, users gain practical experience with motor assemblies, controllers, and troubleshooting procedures in a safe, virtual environment.\n\nThis application is exclusively designed as a part of the Immerse Learn Electric Vehicle Motor Systems micro-credential program. It is not a standalone product\u2014access is restricted to learners who are officially enrolled in the program. The VR experience complements theoretical learning by providing hands-on training that enhances technical skills and real-world readiness in the rapidly growing EV industry.\n\nIdeal for students and technicians seeking practical exposure, this app bridges the gap between knowledge and application through immersive learning.", "short_description": "Electric Vehicle Motor Systems is a VR training app designed for hands-on learning of EV motor components, diagnostics, and system operations. This application is part of the Immerse Learn Electric Vehicle Motor Systems micro-credential program and is accessible only to enrolled learners for immersive skill development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26656709480648181"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1356357929880491_6296704450955880578_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aK_FTqmkNB8Q7kNvwEULJAr&_nc_oc=AdpJsar9H4WAV62wnYZ8CSoxgj_7vjhFD53vwCNo6rBaROqzeLYoPQqwp1xK7l6fb4M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPI2Abh-JzmVetV6hACQnokoNP1VrWXKHnGlYMX9jzCog&oe=6AC3A317"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Electric Vehicle Motor Systems", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1779950700, "lastRevision": {"nodes": [{"id": "26656709587314837", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "26656709453981517", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "943191498487502"}, "iarc
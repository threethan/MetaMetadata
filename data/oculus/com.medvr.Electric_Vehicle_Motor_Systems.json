culuscdn.com/v/t64.5771-25/499305396_1515834353498812_8980560411359302448_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fq8pK12EGEQQ7kNvwGS8G89&_nc_oc=Adp6KIR_rFH_SfkM2w-YwhQMx_4nhHItsIRhPSvR64eXaMbyl_dygwsyB8oQxeTxxJA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FIuTcpykdAW-35cuybUtesF-qrEwV5xjTSOpTOWr8_g&oe=6A2FF5F1"}, {"file_name": "HighresScreenshot00007.png", "id": "1688482049132905", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/595112037_1688482055799571_7669929014348707461_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqahL4qV7lUQ7kNvwHxUkGD&_nc_oc=Adoygd4YD72R5s1MPKEeHjbws487WFYYnbc_CvGKRNfxUZi1JHGN8tr6a3rnjiMkUJY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8c1B7FenRIqquzq5CDA5m7ms4DQdhOX9QnWHQbepEBJA&oe=6A300FD6"}, {"file_name": "HighresScreenshot00009.png", "id": "1473563077284729", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499623314_1473563080618062_4367040088212853579_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcRb6onxYn0Q7kNvwFg9W6N&_nc_oc=AdpboP4elFxg9Fx5NtWeQXyP9eE2MbmHqcYpyHFRLfbygz-xDqbadRh3J_7QwUxaAqs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cOibICi9KbVnlNfr2f3aVKs_lh7TBk3RA51BeFDbIPw&oe=6A2FFD9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Electric Vehicle Motor Systems", "keywords": [], "long_description": "Electric Vehicle Motor Systems is an immersive VR training application developed to help learners understand the core components, functionality, and diagnostics of electric vehicle motor systems. Through interactive simulations, users gain practical experience with motor assemblies, controllers, and troubleshooting procedures in a safe, virtual environment.\n\nThis application is exclusively designed as a part of the Immerse Learn Electric Vehicle Motor Systems micro-credential program. It is not a standalone product\u2014access is restricted to learners who are officially enrolled in the program. The VR experience complements theoretical learning by providing hands-on training that enhances technical skills and real-world readiness in the rapidly growing EV industry.\n\nIdeal for students and technicians seeking practical exposure, this app bridges the gap between knowledge and application through immersive learning.", "short_description": "Electric Vehicle Motor Systems is a VR training app designed for hands-on learning of EV motor components, diagnostics, and system operations. This application is part of the Immerse Learn Electric Vehicle Motor Systems micro-credential program and is accessible only to enrolled learners for immersive skill development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26656709480648181"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821704_1356357929880491_6296704450955880578_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xy_HFvcqIEQ7kNvwH6H5ug&_nc_oc=AdpUEGQrkC1RwI95EgWgCVf51UiQiBRhmvgAsyQcUL27SIwwC1EO8yGarDkWPwV01Do&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af
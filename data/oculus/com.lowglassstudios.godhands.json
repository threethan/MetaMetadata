V5T_KvR6wQ7kNvwFdpBUn&_nc_oc=AdodWXH3nfqClgOIJCwnIJKEUvuRZUnViiW341m122T8V4jc4-14nIvoypBrPycdEGo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSi9JcgkyOw4wfVns1TSMSUtbgh9RtmUoB5fF_xEgLEQA&oe=6B0C5BB9"}, {"file_name": "1_hands_and_hole.png", "id": "1458324512877080", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/759751223_1458324516210413_326905598356302176_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9tmUAas0lYQ7kNvwEqlQkX&_nc_oc=AdpLb168P0V0oA4HHeVXDFdJ71JO81kmFMUfOw30mxPSiCgCyQ1Z0RBUCD8NuUtzNEo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ_9CHBSwxUX2yKE-9hsuBULynWLBHqRS19f4f-ovfA7w&oe=6B0C7573"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "God Hands", "keywords": ["Space", "Universe", "Sandbox"], "long_description": "You begin as a single atom floating in front of you, with your own room visible through passthrough. Pull back and release like drawing a bow to launch, then absorb anything smaller to grow through dust, pebble, asteroid, planet and star until you are a galaxy, and avoid anything much bigger than you.\n\nPlay with controllers or bare hands. Pinch to aim and launch, grab and throw bodies with the other hand, toss rocks into orbit, palm and throw yourself, swat alien ships, and poke a floating instrument panel to change zoom, render distance and more. Gravity is hierarchical, so moons, planets and stars orbit as you would expect. Black holes bend the starfield and even your room, and a generative ambient score shifts key and mood with your stage.", "short_description": "Start as an atom in your room, absorb smaller bodies to grow into a planet, a star and a galaxy, and launch yourself with a bare-hand bow pull."}]}, "developer_name": null, "developer_privacy_policy_url": "https://god-hands.lowglass.org/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Lowglass Studios", "support_website_url": null, "website_url": "ht
V5T_KvR6wQ7kNvwFYD6tU&_nc_oc=AdpGj4RjHM90z7SfPz7SOitkSmHcfRzaNDCfd6u6zy-MU9SZ5g6pnqiLHSnk1TSHKas&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSxrM98__LUbd08zXH-fSvUsWx7MJgpx2mn9w19-dNrYA&oe=6B0DAD39"}, {"file_name": "1_hands_and_hole.png", "id": "1458324512877080", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/759751223_1458324516210413_326905598356302176_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9tmUAas0lYQ7kNvwGvVuZt&_nc_oc=AdqU-daOX90tKA5TG0SdC2sDie47zWtHzYwaKzfqlhipjamEZHVCC5uzk9zJaevbh_s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRSdXZJfrWwCt9nRZ9O48J3MbGypBrt_2CrSbmv9BdaKw&oe=6B0DC6F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "God Hands", "keywords": ["Space", "Universe", "Sandbox"], "long_description": "You begin as a single atom floating in front of you, with your own room visible through passthrough. Pull back and release like drawing a bow to launch, then absorb anything smaller to grow through dust, pebble, asteroid, planet and star until you are a galaxy, and avoid anything much bigger than you.\n\nPlay with controllers or bare hands. Pinch to aim and launch, grab and throw bodies with the other hand, toss rocks into orbit, palm and throw yourself, swat alien ships, and poke a floating instrument panel to change zoom, render distance and more. Gravity is hierarchical, so moons, planets and stars orbit as you would expect. Black holes bend the starfield and even your room, and a generative ambient score shifts key and mood with your stage.", "short_description": "Start as an atom in your room, absorb smaller bodies to grow into a planet, a star and a galaxy, and launch yourself with a bare-hand bow pull."}]}, "developer_name": null, "developer_privacy_policy_url": "https://god-hands.lowglass.org/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Lowglass Studios", "support_website_url": null, "website_url": "ht
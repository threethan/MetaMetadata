982685_1006761173251185_3784763179064135815_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvfqDXFr1yIQ7kNvwFGCrjj&_nc_oc=AdrxGdCqJK48qQprc5xDSuDnNLNvG0VYazKmREXEoBSDMYTSjONX23AV8j_4_iRi6c4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nT8whbqcGryQK_L82pXpw5sK3xeJYftrN_S10OeWalw&oe=6A3AA8C7"}, {"file_name": "screenshot3.png", "id": "2857623401201668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031379_2857623404535001_968049663691508693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxdOEyWkFUcQ7kNvwHssCL-&_nc_oc=AdqYft6VV7oo01jujgB4kptZOkbSkEExph33iay6NqawbCTrtu3oMJGxiLJj4NTbmZk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EqsayG54flGm2hz6gj0xjkxft9lUr89Ex2XcQt0NTKA&oe=6A3A9F5F"}, {"file_name": "screenshot2.png", "id": "276527484435391", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974824_276527487768724_7735967117058921973_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIcOR3pFPMIQ7kNvwFwo6Zb&_nc_oc=AdqJbQas3E530IIxb8rrz0cMu-xIoNjnki5zJ0bM3WsuCmqFbPZiW-7cG6NLe7Xw23E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JldDblv_0sGBML9Zb2GQvuWEwmPfPMuIDkYi8AhlqEA&oe=6A3AA04D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1299949397179828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974821_1299949400513161_8107954095255813463_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Syr7OQI052cQ7kNvwECTk5b&_nc_oc=AdooMh8m-7QCXW7gMaQ8oO4dUSp8mxTY5tdQrv33x230AyqsYrKAEuCTrk-ufLX4Tq8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mi6DhNgTV3EGG9kcxA_ldaCa9Vk3L13kumzUR5MxKTA&oe=6A3A9F21"}, "display_name": "Immersive Standardized Patient Experiences", "keywords": [], "long_description": "Nurse Practitioner learners use the Clinic Immersives Immersive Standardized Patient Experiences (ISPE) enterprise and their own Quest 2 headset to practice and demonstrate the application of advanced knowledge and clinical skills competencies \u201canytime, anywhere\u201d.  No travel is required, availability of practice is nearly unlimited, and the included analytics of learning outcomes provide insight for every aspect of clinical skills, learner performance, and learner and class skills gaps.  As a result, Nurse Practitioner learners acquire skills faster, with greater accuracy, and retain learned skills longer when compared to traditional instruction. The learning enterprise encompasses a Cloud-based delivery system for management of the application deployment, licensing and usage, tracking of Oculus Quest hardware, learner and class management, learning outcomes analytics, and supplemental resources.", "short_description": "Clinic Immersives Immersive Standardized Patient Experiences (ISPE) allows nurse practitioner (NP) students to use their own affordable mobile VR to practice and demonstrate the application of advanced knowledge and clinical skills competencies \u201canytime, anywhere\u201d. No travel is required, the availability of practice is nearly unlimited, and the included analytics of learning outcomes provide insight for every aspect of clinical skills, learner performance, and learner and class skills gaps."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.clinicimmersives.com/privacyPolicy", "developer_terms_of_service_url": "https://clinicimmersives.com/termsConditions", "publisher_name": "inciteVR", "support_website_url": "https://www.clinicimmersives.com/support", "website_url": "https://incitevr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recom
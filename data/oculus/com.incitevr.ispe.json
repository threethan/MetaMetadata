982685_1006761173251185_3784763179064135815_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFOcW9Z8LnYQ7kNvwGT5C9S&_nc_oc=AdoGzYwRmvz2hFqM3YHDuJkHjNn1UQn_p5NruaslPnL1d3bHlbsGjrjw_Wte_GKrN48&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsvAeVZLEhqmcJ-P05XKXPNHGicrfBli-HQ-kmQfMwLw&oe=6AE75D47"}, {"file_name": "screenshot3.png", "id": "2857623401201668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031379_2857623404535001_968049663691508693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=om2jfi59U-YQ7kNvwG2eXJC&_nc_oc=Adp4f971OyE1R223BR-aOU6JqGdlaBQnlVhPz250QTXbILtgB64EoxIcRYFZAke3KUo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyPI9IvZs_WB8RxiDff7cLGXG_zbWXlPtEb5cjKUdVuw&oe=6AE753DF"}, {"file_name": "screenshot2.png", "id": "276527484435391", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974824_276527487768724_7735967117058921973_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dePd7XLPKoQ7kNvwHcHmqw&_nc_oc=AdrcJHcpjdoFAq2mgZ563mkS1ufNACZC-BdXr6CDyG4SmfeYhQoASP8-K_HmojOm5bk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbM0GVj-c3YUy9ldfCF4pTJte0pze_GiwWTeIhLurpJQ&oe=6AE754CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1299949397179828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974821_1299949400513161_8107954095255813463_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpmFPNjxaEkQ7kNvwHZ4OsU&_nc_oc=AdropJyRqKprtRMB892SeeUeKeZwg7IXM_9Wxah6_7yXU1FQ2cqHbcbuWpPSvK4TkLw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlS9O9yGs8OY3WkZg-RCpUpj92AxhKxebMvfIpV7Fdeg&oe=6AE753A1"}, "display_name": "Immersive Standardized Patient Experiences", "keywords": [], "long_description": "Nurse Practitioner learners use the Clinic Immersives Immersive Standardized Patient Experiences (ISPE) enterprise and their own Quest 2 headset to practice and demonstrate the application of advanced knowledge and clinical skills competencies \u201canytime, anywhere\u201d.  No travel is required, availability of practice is nearly unlimited, and the included analytics of learning outcomes provide insight for every aspect of clinical skills, learner performance, and learner and class skills gaps.  As a result, Nurse Practitioner learners acquire skills faster, with greater accuracy, and retain learned skills longer when compared to traditional instruction. The learning enterprise encompasses a Cloud-based delivery system for management of the application deployment, licensing and usage, tracking of Oculus Quest hardware, learner and class management, learning outcomes analytics, and supplemental resources.", "short_description": "Clinic Immersives Immersive Standardized Patient Experiences (ISPE) allows nurse practitioner (NP) students to use their own affordable mobile VR to practice and demonstrate the application of advanced knowledge and clinical skills competencies \u201canytime, anywhere\u201d. No travel is required, the availability of practice is nearly unlimited, and the included analytics of learning outcomes provide insight for every aspect of clinical skills, learner performance, and learner and class skills gaps."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.clinicimmersives.com/privacyPolicy", "developer_terms_of_service_url": "https://clinicimmersives.com/termsConditions", "publisher_name": "inciteVR", "support_website_url": "https://www.clinicimmersives.com/support", "website_url": "https://incitevr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recom
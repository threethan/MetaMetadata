982685_1006761173251185_3784763179064135815_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGMn5ekPB78Q7kNvwFaYd5z&_nc_oc=Adqavci0_rr_HasNQio13v0ZgUZF4cUfOH3yC2LI-2sEbPjupARG5hXYY9g0waAgAmI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8E7qX2AhJSuiScXEAAcwlXDaGAj7w_7l44O_gQlUa_sA&oe=6A2833C7"}, {"file_name": "screenshot3.png", "id": "2857623401201668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031379_2857623404535001_968049663691508693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=679Lir3hnn4Q7kNvwGE2hb6&_nc_oc=AdrrBX9aRlQc6Gd94lhsthjtTDq1b8vKRGh8eGnOFrKjiv4sUiYAKrEiIBC5ZuZxrQ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Cbbo_PD3HhWRZVTMmJvhi5l0do9ALc0YT9rpDdDTLHg&oe=6A282A5F"}, {"file_name": "screenshot2.png", "id": "276527484435391", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974824_276527487768724_7735967117058921973_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6uoR4phFHsQ7kNvwEZUjgt&_nc_oc=AdoAE8cSRlm0UBdGekWIFZwAqhcMi1aoPLP0X9Yf35dzOq3by75GLLy4JwIjsaMsUpM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CuySaeDafFHOr4hO00Tf43I0WKu7W1kIHnMyF_NXrxA&oe=6A282B4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1299949397179828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974821_1299949400513161_8107954095255813463_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmd5bmzptYEQ7kNvwGgSw7T&_nc_oc=Adp7I6YkmLv98saisRSgUUDxdfdFyCI50X-LnAeItMr1Yx5sYvkj2UbdN7pKV3bM7WI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cusQ3hpmPWxVL5W1JIkfDYi9W5em_1t6owaxT5-l3vQ&oe=6A282A21"}, "display_name": "Immersive Standardized Patient Experiences", "keywords": [], "long_description": "Nurse Practitioner learners use the Clinic Immersives Immersive Standardized Patient Experiences (ISPE) enterprise and their own Quest 2 headset to practice and demonstrate the application of advanced knowledge and clinical skills competencies \u201canytime, anywhere\u201d.  No travel is required, availability of practice is nearly unlimited, and the included analytics of learning outcomes provide insight for every aspect of clinical skills, learner performance, and learner and class skills gaps.  As a result, Nurse Practitioner learners acquire skills faster, with greater accuracy, and retain learned skills longer when compared to traditional instruction. The learning enterprise encompasses a Cloud-based delivery system for management of the application deployment, licensing and usage, tracking of Oculus Quest hardware, learner and class management, learning outcomes analytics, and supplemental resources.", "short_description": "Clinic Immersives Immersive Standardized Patient Experiences (ISPE) allows nurse practitioner (NP) students to use their own affordable mobile VR to practice and demonstrate the application of advanced knowledge and clinical skills competencies \u201canytime, anywhere\u201d. No travel is required, the availability of practice is nearly unlimited, and the included analytics of learning outcomes provide insight for every aspect of clinical skills, learner performance, and learner and class skills gaps."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.clinicimmersives.com/privacyPolicy", "developer_terms_of_service_url": "https://clinicimmersives.com/termsConditions", "publisher_name": "inciteVR", "support_website_url": "https://www.clinicimmersives.com/support", "website_url": "https://incitevr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recom
982685_1006761173251185_3784763179064135815_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8xlci6Zr-kQ7kNvwEsjDfn&_nc_oc=AdpaVURuf3bqI2DS-qDxwt_HJ8rgu9ujSVD4JBxegk30E8EiMtEtrrIDKCxHZmXjOGI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89n0AFBHQpLDPteJx5AkHtB5tq559zz9ugymHbIQ7NvA&oe=6A2C2847"}, {"file_name": "screenshot3.png", "id": "2857623401201668", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031379_2857623404535001_968049663691508693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYRRQkSla6YQ7kNvwH_xeYE&_nc_oc=AdqCc707_wMiyzbX6LCeEjgJ6xdOntuzLJy_xdNdcxFs1FmSeGAyvHgSc7udc8Oi8xc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_c0e9_iPZLcGzmIx7yq_s6g5cWXujCikayrKRfC3dCnA&oe=6A2C1EDF"}, {"file_name": "screenshot2.png", "id": "276527484435391", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974824_276527487768724_7735967117058921973_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4zaeSs_PX0Q7kNvwHZLox7&_nc_oc=Adr-JC7r0Qi2QxIcDLT5M9vs_wLPQEVVJNCgfiIwhTED7NrObpWM3fe-heWW5kj4cOQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BLBch2uMAGVn1_o9dCamzoxOEhr7ttbwRkvG2m3OQaw&oe=6A2C1FCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1299949397179828", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974821_1299949400513161_8107954095255813463_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8BkZg8_dX8Q7kNvwG6oMl5&_nc_oc=AdqTapPgYQjwTbRCmxXrus6kcJSsMTn1oCsouq7j_d0T4gaU9iA2kv1JWT9hwj0MTKE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ECJNJ10GyHWeXjvBXVYgFkoYHJNniypcv2c2cGTkoYw&oe=6A2C1EA1"}, "display_name": "Immersive Standardized Patient Experiences", "keywords": [], "long_description": "Nurse Practitioner learners use the Clinic Immersives Immersive Standardized Patient Experiences (ISPE) enterprise and their own Quest 2 headset to practice and demonstrate the application of advanced knowledge and clinical skills competencies \u201canytime, anywhere\u201d.  No travel is required, availability of practice is nearly unlimited, and the included analytics of learning outcomes provide insight for every aspect of clinical skills, learner performance, and learner and class skills gaps.  As a result, Nurse Practitioner learners acquire skills faster, with greater accuracy, and retain learned skills longer when compared to traditional instruction. The learning enterprise encompasses a Cloud-based delivery system for management of the application deployment, licensing and usage, tracking of Oculus Quest hardware, learner and class management, learning outcomes analytics, and supplemental resources.", "short_description": "Clinic Immersives Immersive Standardized Patient Experiences (ISPE) allows nurse practitioner (NP) students to use their own affordable mobile VR to practice and demonstrate the application of advanced knowledge and clinical skills competencies \u201canytime, anywhere\u201d. No travel is required, the availability of practice is nearly unlimited, and the included analytics of learning outcomes provide insight for every aspect of clinical skills, learner performance, and learner and class skills gaps."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.clinicimmersives.com/privacyPolicy", "developer_terms_of_service_url": "https://clinicimmersives.com/termsConditions", "publisher_name": "inciteVR", "support_website_url": "https://www.clinicimmersives.com/support", "website_url": "https://incitevr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recom
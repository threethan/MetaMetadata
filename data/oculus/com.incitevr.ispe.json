982685_1006761173251185_3784763179064135815_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeTBNqojCngQ7kNvwEHNul1&_nc_oc=AdouykV2E1-cZRPcSzs8_cBhuhdH1BxP03JpD_8hnmu04r8ek04SALza4JzYJ6fx8go&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pBabnQugeccR1Qp9DJkKa7PdL-ju3A4-dBIRcMqVxnw&oe=69E8B387"}, {"file_name": "screenshot3.png", "id": "2857623401201668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031379_2857623404535001_968049663691508693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwD1EPv4GM0Q7kNvwF2qvpC&_nc_oc=Ados0Vj9WIe-ktGp8RnlJtndsqHFPYPV1MCB8mMkFgfCpqGqU1LS9P1eiOrJByP1cT0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EZubRMm4kwTl3WWcKLcdk5TaSZY0y3qJBqpw5F4EdZQ&oe=69E8AA1F"}, {"file_name": "screenshot2.png", "id": "276527484435391", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974824_276527487768724_7735967117058921973_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDVJo_qXKeEQ7kNvwGjSBBY&_nc_oc=AdqStcMh0Uwgo0ME6-pSjW0BiM9uXIQmqjFMxDb13CuEe7LaMAS7NIJItzovWDNgZfY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UdQd7tzhAjQr5-aHk2t2mZBs64zGmURT2X4beIg9Xmg&oe=69E8AB0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1299949397179828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974821_1299949400513161_8107954095255813463_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qnt_3We7jhAQ7kNvwFfjLvP&_nc_oc=Adra-qzVMDRZlVbvoIpdULK5SRfCzFMyiSTcmIw_7ptA-ZndopA_s6FtczD20qclWFk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1n2GiVNAzfNk1fh9WiHBqhUuLLLMPIBlxEwppeeaT4zQ&oe=69E8A9E1"}, "display_name": "Immersive Standardized Patient Experiences", "keywords": [], "long_description": "Nurse Practitioner learners use the Clinic Immersives Immersive Standardized Patient Experiences (ISPE) enterprise and their own Quest 2 headset to practice and demonstrate the application of advanced knowledge and clinical skills competencies \u201canytime, anywhere\u201d.  No travel is required, availability of practice is nearly unlimited, and the included analytics of learning outcomes provide insight for every aspect of clinical skills, learner performance, and learner and class skills gaps.  As a result, Nurse Practitioner learners acquire skills faster, with greater accuracy, and retain learned skills longer when compared to traditional instruction. The learning enterprise encompasses a Cloud-based delivery system for management of the application deployment, licensing and usage, tracking of Oculus Quest hardware, learner and class management, learning outcomes analytics, and supplemental resources.", "short_description": "Clinic Immersives Immersive Standardized Patient Experiences (ISPE) allows nurse practitioner (NP) students to use their own affordable mobile VR to practice and demonstrate the application of advanced knowledge and clinical skills competencies \u201canytime, anywhere\u201d. No travel is required, the availability of practice is nearly unlimited, and the included analytics of learning outcomes provide insight for every aspect of clinical skills, learner performance, and learner and class skills gaps."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.clinicimmersives.com/privacyPolicy", "developer_terms_of_service_url": "https://clinicimmersives.com/termsConditions", "publisher_name": "inciteVR", "support_website_url": "https://www.clinicimmersives.com/support", "website_url": "https://incitevr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recom
982685_1006761173251185_3784763179064135815_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZzAuK8uy3EQ7kNvwGayG6H&_nc_oc=AdpYXTXq7AMNWRb9CdkvnOBVv2A9LQINp3xP30mbdgh6iINrXp-k7FiUKv-3kFTW0Pk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3gPMCUV_TPqz_KxkY8ruMjyECEAbNExkCmc8q8oZ_zw&oe=6A9C37C7"}, {"file_name": "screenshot3.png", "id": "2857623401201668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031379_2857623404535001_968049663691508693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYg-qK7wUEEQ7kNvwGNMXXH&_nc_oc=AdpUrve5K5jnV6_0e6WU9LY4hbY_Glh5MSWmWND21mg-Dei8aQ1h9kRTNyg-BHpYdz8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1qXmSGRepwawC2Ph_J4-zzzRyE-2aNZYcYL-UVYWs7Q&oe=6A9C2E5F"}, {"file_name": "screenshot2.png", "id": "276527484435391", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974824_276527487768724_7735967117058921973_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tY2sMmaNyfoQ7kNvwGu-VGC&_nc_oc=AdrKNk3pdoHXBfKv2yP7llv4vbV5AH5c5Wtz81txIZi5LWjE_3Ya6aoqUCfMjQMERg4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJLRqpSg1jPQr43xDmwN2w5rLOtdnWpT6iAunI3NA6XA&oe=6A9C2F4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1299949397179828", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974821_1299949400513161_8107954095255813463_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rL1MBkPh974Q7kNvwGe31Tm&_nc_oc=AdrX1TTC67VHP_KKwKTcYQNMKE9R-KJwfARs9N3l1jfvPfSf492_WYoD1jchspSKi3w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKa4WcEXOcojOyg0mCFEvvDG_fI-Z4pKvbPZmY7JBGqAg&oe=6A9C2E21"}, "display_name": "Immersive Standardized Patient Experiences", "keywords": [], "long_description": "Nurse Practitioner learners use the Clinic Immersives Immersive Standardized Patient Experiences (ISPE) enterprise and their own Quest 2 headset to practice and demonstrate the application of advanced knowledge and clinical skills competencies \u201canytime, anywhere\u201d.  No travel is required, availability of practice is nearly unlimited, and the included analytics of learning outcomes provide insight for every aspect of clinical skills, learner performance, and learner and class skills gaps.  As a result, Nurse Practitioner learners acquire skills faster, with greater accuracy, and retain learned skills longer when compared to traditional instruction. The learning enterprise encompasses a Cloud-based delivery system for management of the application deployment, licensing and usage, tracking of Oculus Quest hardware, learner and class management, learning outcomes analytics, and supplemental resources.", "short_description": "Clinic Immersives Immersive Standardized Patient Experiences (ISPE) allows nurse practitioner (NP) students to use their own affordable mobile VR to practice and demonstrate the application of advanced knowledge and clinical skills competencies \u201canytime, anywhere\u201d. No travel is required, the availability of practice is nearly unlimited, and the included analytics of learning outcomes provide insight for every aspect of clinical skills, learner performance, and learner and class skills gaps."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.clinicimmersives.com/privacyPolicy", "developer_terms_of_service_url": "https://clinicimmersives.com/termsConditions", "publisher_name": "inciteVR", "support_website_url": "https://www.clinicimmersives.com/support", "website_url": "https://incitevr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recom
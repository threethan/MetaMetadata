982685_1006761173251185_3784763179064135815_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2O357SqGIOcQ7kNvwGZ5TTr&_nc_oc=AdoZh-FE4dXxMA2Kv3YeQ4tTBMfxCXDbr-S_pySLSqzFZMtQUvOmaqPtUXQXxGK_Suc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN800DTNSVztRwM1jK-FzKNARsQrT1SZAUnM87_gOV0ng&oe=6AE4BA47"}, {"file_name": "screenshot3.png", "id": "2857623401201668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031379_2857623404535001_968049663691508693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWyanOjRykoQ7kNvwGc5gyb&_nc_oc=Adps5YQy7hdkBmkmxdCvw6vAl1Az2tBjNnpCCi85M3X2ikGyaAdntyc80h4zuZ1g76U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFuUCo_1auh9RfpbDCDsk9P-EbR7hnjaVBbPcNMxQw3g&oe=6AE4B0DF"}, {"file_name": "screenshot2.png", "id": "276527484435391", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974824_276527487768724_7735967117058921973_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHDeUyeqeR4Q7kNvwFy95pP&_nc_oc=Adq12qTnLVJtx2Y9SD9AzdZ6Jmac9N1R9XPVsCIkxpofPyTUN46mdOR9u9Dd_wQDt0Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAHJAPzPWEbnHPxHyKY00dR-mD-Hmft4JR7YgPElTC5g&oe=6AE4B1CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1299949397179828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974821_1299949400513161_8107954095255813463_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpmFPNjxaEkQ7kNvwFKGYG1&_nc_oc=AdrKKW2y0sUesf9_MV1WZxq0PAotB3pCVNrwK_HsO9NWj245Cq3MCiuGcbjvqovyDWA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuUqvBbUIiIqTAC4B10RBiXdWIA2rS_XzM9WBffy8ZrA&oe=6AE4B0A1"}, "display_name": "Immersive Standardized Patient Experiences", "keywords": [], "long_description": "Nurse Practitioner learners use the Clinic Immersives Immersive Standardized Patient Experiences (ISPE) enterprise and their own Quest 2 headset to practice and demonstrate the application of advanced knowledge and clinical skills competencies \u201canytime, anywhere\u201d.  No travel is required, availability of practice is nearly unlimited, and the included analytics of learning outcomes provide insight for every aspect of clinical skills, learner performance, and learner and class skills gaps.  As a result, Nurse Practitioner learners acquire skills faster, with greater accuracy, and retain learned skills longer when compared to traditional instruction. The learning enterprise encompasses a Cloud-based delivery system for management of the application deployment, licensing and usage, tracking of Oculus Quest hardware, learner and class management, learning outcomes analytics, and supplemental resources.", "short_description": "Clinic Immersives Immersive Standardized Patient Experiences (ISPE) allows nurse practitioner (NP) students to use their own affordable mobile VR to practice and demonstrate the application of advanced knowledge and clinical skills competencies \u201canytime, anywhere\u201d. No travel is required, the availability of practice is nearly unlimited, and the included analytics of learning outcomes provide insight for every aspect of clinical skills, learner performance, and learner and class skills gaps."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.clinicimmersives.com/privacyPolicy", "developer_terms_of_service_url": "https://clinicimmersives.com/termsConditions", "publisher_name": "inciteVR", "support_website_url": "https://www.clinicimmersives.com/support", "website_url": "https://incitevr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recom
982685_1006761173251185_3784763179064135815_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i78CConPssIQ7kNvwHxQQE8&_nc_oc=AdoxQZibdxBt2kEgF0QwP7wxwWbqO2vYEwen4n4g1Sth05qUyY_82_rJ6s5WPAOBTAE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xKBD_felboXBIILIYyHSwk-6gmjki8rDjFk85wKfsmw&oe=6A131BC7"}, {"file_name": "screenshot3.png", "id": "2857623401201668", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031379_2857623404535001_968049663691508693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJwy04-OQNUQ7kNvwE4P20D&_nc_oc=AdoDapQvQ3di_NqRH4Bjs1-7KRntH60bwU-39UsEltMABV92Y88rS0nkUZj6OxXHJ7o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oxLaW402UWAM0ChuZweajp61oXWGsmBWQB-CedcNBSQ&oe=6A13125F"}, {"file_name": "screenshot2.png", "id": "276527484435391", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974824_276527487768724_7735967117058921973_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYj_N2UJHxwQ7kNvwF6o4Gt&_nc_oc=Adps2D2vGZIC8iugTHET5PtkjLrVo7Wwaz1hHlwNnbcRjYVqIKXkHERkQp11mEuyJZ0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65SmzkYp0nOFQTpvdRMMyGaYcXo6xKpKdIy3oSkaJzJw&oe=6A13134D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1299949397179828", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974821_1299949400513161_8107954095255813463_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iH4WXPxF7qoQ7kNvwG-7ecr&_nc_oc=Adr1BYu_bvT5feiX2QXfOhQczeoBs7fk3qA3H7YNWRo9JTBg9qC36Ll2BBQ-eLMn31A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CEogxW3bSWEsymbnOF799hCSCVKpbZCIG9yvYfH0YIw&oe=6A131221"}, "display_name": "Immersive Standardized Patient Experiences", "keywords": [], "long_description": "Nurse Practitioner learners use the Clinic Immersives Immersive Standardized Patient Experiences (ISPE) enterprise and their own Quest 2 headset to practice and demonstrate the application of advanced knowledge and clinical skills competencies \u201canytime, anywhere\u201d.  No travel is required, availability of practice is nearly unlimited, and the included analytics of learning outcomes provide insight for every aspect of clinical skills, learner performance, and learner and class skills gaps.  As a result, Nurse Practitioner learners acquire skills faster, with greater accuracy, and retain learned skills longer when compared to traditional instruction. The learning enterprise encompasses a Cloud-based delivery system for management of the application deployment, licensing and usage, tracking of Oculus Quest hardware, learner and class management, learning outcomes analytics, and supplemental resources.", "short_description": "Clinic Immersives Immersive Standardized Patient Experiences (ISPE) allows nurse practitioner (NP) students to use their own affordable mobile VR to practice and demonstrate the application of advanced knowledge and clinical skills competencies \u201canytime, anywhere\u201d. No travel is required, the availability of practice is nearly unlimited, and the included analytics of learning outcomes provide insight for every aspect of clinical skills, learner performance, and learner and class skills gaps."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.clinicimmersives.com/privacyPolicy", "developer_terms_of_service_url": "https://clinicimmersives.com/termsConditions", "publisher_name": "inciteVR", "support_website_url": "https://www.clinicimmersives.com/support", "website_url": "https://incitevr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recom
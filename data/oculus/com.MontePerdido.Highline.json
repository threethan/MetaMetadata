25/38982715_797207448209806_2742432445934761110_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsLVVpNBP2kQ7kNvwGrUTvM&_nc_oc=AdmH3dxRAXZba1kl8qciUUnlAogRWD8TiTwFCiPGK6hopXBiuSu1bg1zFReZyP1zmKw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv1VRRS85pz0AUjq2IaVvqcJjr-3iVq-eGyP4T_oF_SzQ&oe=69A448A1"}, {"file_name": "Screen3.png", "id": "830158965070135", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031368_830158968403468_7400007788056871560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mAYO6odsqUQ7kNvwFVbUwU&_nc_oc=AdlBYjXbRbrfP-OWWCjvR3tGX-XiC8LY0RDsjx2LOGZeLFHZsgEfOiJ-HtIgKd24qkY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsfezO01cKr7LVroFZKFox9GS2WdKmAx4X1t9AGan6uUw&oe=69A44E2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FrontEnd_CoverLandscape_V1_2560x1440.png", "id": "430542742556397", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982715_430542745889730_1000337972939003822_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRymU4Bp7mQQ7kNvwExDaTh&_nc_oc=Adnq7TS9ysh2j1UTJQqvSwBhy1s6A6RfRzWE0VKWfwEEsPZfx9Kc-HQYNc5AgtmsWqQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuTIYfCa3U32S8k-kSwshuRNkLCV5xpDBlQtw-IwFhi2w&oe=69A44AA6"}, "display_name": "Highline", "keywords": [], "long_description": "\"Highline\" is an immersive slackline sim with narrative elements.\n\nYou play as Olivia, a professional slackliner who was about to beat the world record when a terrible accident happened. \n\nKeep your balance slacklining while trying to find your way out of Limbo. \n\nDiscover a brand new mechanic designed exclusively for VR. Use your whole body to walk through vertiginous lines in a unique surreal environment. ", "short_description": "You are a slackliner trapped in Limbo.\n\nFind your way out highlining through surreal environments while discovering the secrets of your past. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.monteperdido.studio/privacy", "developer
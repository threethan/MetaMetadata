4u-5Hurbl5-NO63Ps4I_pnjWavN2YSF7NSIeC973c0-kX3VcsF6lAmwcPih7M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVH3BwZFl39Assda1r-M7mPIx0hCNe29PG_qSSuUQ5P1g&oe=6B10646D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FrontEnd_CoverLandscape_V1_2560x1440.png", "id": "430542742556397", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982715_430542745889730_1000337972939003822_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FP27f-HfDqgQ7kNvwHruvN3&_nc_oc=AdpJLFIILkMtVrFgRjUWtri007cRWljzcy2ahUj5WYCiPsvo2qJibRSb0wE2DOAFj6Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV9Rll833Dq_OIJv97Rr86TuIJo2dAZjfNGP6BwISQwhw&oe=6B1060E6"}, "display_name": "Highline", "keywords": [], "long_description": "\"Highline\" is an immersive slackline sim with narrative elements.\n\nYou play as Olivia, a professional slackliner who was about to beat the world record when a terrible accident happened. \n\nKeep your balance slacklining while trying to find your way out of Limbo. \n\nDiscover a brand new mechanic designed exclusively for VR. Use your whole body to walk through vertiginous lines in a unique surreal environment. ", "short_description": "You are a slackliner trapped in Limbo.\n\nFind your way out highlining through surreal environments while discovering the secrets of your past. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.monteperdido.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "Monte Perdido Studio", "support_website_url": null, "website_url": "https://www.monteperdido.studio/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "SIMULATION", "SPORTS"], "has
25/38982715_797207448209806_2742432445934761110_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsLVVpNBP2kQ7kNvwGqiwzZ&_nc_oc=AdmW-KzccYvk859e_SQwhVhroAJjnPzVYtdK1MpsQsNx9IDIxNFnFkHVQCKS_WQSoRA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftLaqzvAD0iknx8cwIEH5to2jlsB_XCpu7CJ7gAizUr5Q&oe=69A2F721"}, {"file_name": "Screen3.png", "id": "830158965070135", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031368_830158968403468_7400007788056871560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mAYO6odsqUQ7kNvwG__u24&_nc_oc=Adlwz8F64mWEE9De-R8_ONcEVh3pCAI2Z2W5m45OrfClyC_gpedhIfYDQOYFOBnBu-g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv08xunSfaCJsuEfBOc8qlkUkFAcK_Z2l8mVVjHusMJ2Q&oe=69A2FCAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FrontEnd_CoverLandscape_V1_2560x1440.png", "id": "430542742556397", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982715_430542745889730_1000337972939003822_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRymU4Bp7mQQ7kNvwF9PA7O&_nc_oc=AdnYaSysvfcWBez3e9EBvr_mSDpf0O2HuVYbFb879HeSvwuegMs4mOAACQ-PqQwJAW0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftq_D70miEtHOjqQTx43ZoYhipd3NXVUqD8cGsNMbnMWQ&oe=69A2F926"}, "display_name": "Highline", "keywords": [], "long_description": "\"Highline\" is an immersive slackline sim with narrative elements.\n\nYou play as Olivia, a professional slackliner who was about to beat the world record when a terrible accident happened. \n\nKeep your balance slacklining while trying to find your way out of Limbo. \n\nDiscover a brand new mechanic designed exclusively for VR. Use your whole body to walk through vertiginous lines in a unique surreal environment. ", "short_description": "You are a slackliner trapped in Limbo.\n\nFind your way out highlining through surreal environments while discovering the secrets of your past. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.monteperdido.studio/privacy", "developer
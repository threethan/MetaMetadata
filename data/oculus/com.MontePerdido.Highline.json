42556397", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982715_430542745889730_1000337972939003822_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdY1AUvxsU0Q7kNvwH3kqDc&_nc_oc=Adqf-1BKAPMu1U4oBmmVOPHq_Z3aWQzmf06Wk1RVioRY6MD36LQHRz9qZ1FBU7nKP-o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGCY9Es6HHoixbj12cy3246tKPWJVeWLy0i57v8qXS4w&oe=6ABBC8A6"}, "display_name": "Highline", "keywords": [], "long_description": "\"Highline\" is an immersive slackline sim with narrative elements.\n\nYou play as Olivia, a professional slackliner who was about to beat the world record when a terrible accident happened. \n\nKeep your balance slacklining while trying to find your way out of Limbo. \n\nDiscover a brand new mechanic designed exclusively for VR. Use your whole body to walk through vertiginous lines in a unique surreal environment. ", "short_description": "You are a slackliner trapped in Limbo.\n\nFind your way out highlining through surreal environments while discovering the secrets of your past. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.monteperdido.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "Monte Perdido Studio", "support_website_url": null, "website_url": "https://www.monteperdido.studio/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes
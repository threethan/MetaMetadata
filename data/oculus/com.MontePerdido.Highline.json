25/38982715_797207448209806_2742432445934761110_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnJBM5wfFVgQ7kNvwG_SXLK&_nc_oc=AdnQ4RqdxyeTiLEZXYZSfRziCnNG2QnEHbj3EfEm661YkLFCh4Ueiif0vI02zSoowhw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afu8T71gmVJ3bkY32DlODaxS8dbqAXAwRdR9x3Hlx7ucXg&oe=69986B21"}, {"file_name": "Screen3.png", "id": "830158965070135", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031368_830158968403468_7400007788056871560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dqs7NUcFayUQ7kNvwFjp9SY&_nc_oc=AdlKEmR0LhnUTqLA5jubBF2_NbCRAkd50pyGqNMsh9OUYA5RtLzlSMR8fHs4DmQtfa4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afv6qeOBWMGzswA70YPnwv1S0H2cV3cu2DqxLlCjNUnxrw&oe=699870AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FrontEnd_CoverLandscape_V1_2560x1440.png", "id": "430542742556397", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982715_430542745889730_1000337972939003822_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFiOz6QvEzoQ7kNvwE4iSzd&_nc_oc=AdkwQtKGI_BLjXPasG8HrPChF9XxFMPM0lY3feCUUjas-n6LyDRbHu-9ZNx72l-7gxI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftQdpnWiDGPK7w5at-XolJtgQXDjUFvpEWNBbipvCJExg&oe=69986D26"}, "display_name": "Highline", "keywords": [], "long_description": "\"Highline\" is an immersive slackline sim with narrative elements.\n\nYou play as Olivia, a professional slackliner who was about to beat the world record when a terrible accident happened. \n\nKeep your balance slacklining while trying to find your way out of Limbo. \n\nDiscover a brand new mechanic designed exclusively for VR. Use your whole body to walk through vertiginous lines in a unique surreal environment. ", "short_description": "You are a slackliner trapped in Limbo.\n\nFind your way out highlining through surreal environments while discovering the secrets of your past. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.monteperdido.studio/privacy", "developer
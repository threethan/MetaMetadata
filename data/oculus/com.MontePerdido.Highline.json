25/38982715_797207448209806_2742432445934761110_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K68DCW23l2EQ7kNvwGsmXPD&_nc_oc=AdlyIjcqNoa8o2zViPDDPaIPXb1E5CZEYPuYwcWKEo6wmPjs17eUmJMibcyT8fV-E_o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftKx_hGj0GSnt6ym6cXcsVb6UyCcQ4z2Yx4fLN8-ESCPg&oe=69A59A21"}, {"file_name": "Screen3.png", "id": "830158965070135", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031368_830158968403468_7400007788056871560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNMCfDn1vOUQ7kNvwF1jMFj&_nc_oc=Adkg1OI365ZDXpZLz1KS4ijc4jTIuOoAau4kNaDGReULPvUSmt7gFh4-YWwhxij-nuk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsIRhcI5buBgJSv5l2rYXZDDoWk2MUHbrG4WUsAEzRjRw&oe=69A59FAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FrontEnd_CoverLandscape_V1_2560x1440.png", "id": "430542742556397", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982715_430542745889730_1000337972939003822_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47GVvE7J9jkQ7kNvwHdJdqF&_nc_oc=AdnroGemkrpMk44JMw6Ti0m8N7BgqAXKUQdhIUxmzpaIQ1z3_H1hqRVqjFz_fXSWB04&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aft4ps-mVTMiCw02gdFXIl6ZR-1zUyLxstlJsq_xbM6Ing&oe=69A59C26"}, "display_name": "Highline", "keywords": [], "long_description": "\"Highline\" is an immersive slackline sim with narrative elements.\n\nYou play as Olivia, a professional slackliner who was about to beat the world record when a terrible accident happened. \n\nKeep your balance slacklining while trying to find your way out of Limbo. \n\nDiscover a brand new mechanic designed exclusively for VR. Use your whole body to walk through vertiginous lines in a unique surreal environment. ", "short_description": "You are a slackliner trapped in Limbo.\n\nFind your way out highlining through surreal environments while discovering the secrets of your past. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.monteperdido.studio/privacy", "developer
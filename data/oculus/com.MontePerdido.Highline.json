25/38982715_797207448209806_2742432445934761110_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ad7AzSxBsFQQ7kNvwFdwmxk&_nc_oc=AdkVuK-HtzWBLtLO_b2gk7bIw48-QJj4uhZIdLQaB811cuS9s8Dud-v5sBeI9E5uA0s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuJxy038aJgvszBjNt9gqkUOLCuCTAhoNiXh1hmENRiww&oe=699F02A1"}, {"file_name": "Screen3.png", "id": "830158965070135", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031368_830158968403468_7400007788056871560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WreH9H9uXUcQ7kNvwEpQkAQ&_nc_oc=AdnwvmpkulbYyHPRpMIEl_fi6rtf574RQbLBthFTiWZUeg4pjSuxHe9gf3huw1_Bmrk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftlvtvB3pMMFmeYgu_YEfKXWyZiIGHBHEZeLWI8xqkBlA&oe=699F082D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FrontEnd_CoverLandscape_V1_2560x1440.png", "id": "430542742556397", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982715_430542745889730_1000337972939003822_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aU8OSqZGa9YQ7kNvwE9dIfQ&_nc_oc=Adn7NQPSq6NyA4uelSO2xwk6Ekdtp7jOqTfO2Z_syS6uzVa-80famTGUGWwPm2J9YZ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsyVv3WGUTHaWxKmor55i8eUQb5-WAqCQYLid4uPvkHQA&oe=699F04A6"}, "display_name": "Highline", "keywords": [], "long_description": "\"Highline\" is an immersive slackline sim with narrative elements.\n\nYou play as Olivia, a professional slackliner who was about to beat the world record when a terrible accident happened. \n\nKeep your balance slacklining while trying to find your way out of Limbo. \n\nDiscover a brand new mechanic designed exclusively for VR. Use your whole body to walk through vertiginous lines in a unique surreal environment. ", "short_description": "You are a slackliner trapped in Limbo.\n\nFind your way out highlining through surreal environments while discovering the secrets of your past. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.monteperdido.studio/privacy", "developer
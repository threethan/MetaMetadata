25/38982715_797207448209806_2742432445934761110_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ad7AzSxBsFQQ7kNvwGqLA39&_nc_oc=AdniI-_hY0oCCLl3uZ1pDEaMOSX9kj02aPorcV4H7CdXarwRyHeG6juAjghAxGcdTGg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft327e4KE0NfDCx40rHRkYHrGU59TuNkj0gP1YuowNNJg&oe=699DB121"}, {"file_name": "Screen3.png", "id": "830158965070135", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031368_830158968403468_7400007788056871560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WreH9H9uXUcQ7kNvwHEl_f1&_nc_oc=AdkNFQRWTozkS3M_d_mRDtYKxu7MIlPdyC-kta8gtm2r6Vx6MhSeZmIoqUl12P3hlJM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftKGTMQLREkH7g-rhEf_J-vYeqfoiOUBePNIb41MnL7wg&oe=699DB6AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FrontEnd_CoverLandscape_V1_2560x1440.png", "id": "430542742556397", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982715_430542745889730_1000337972939003822_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aU8OSqZGa9YQ7kNvwGRQic-&_nc_oc=Adl7exGKMAfa5iJV8nrNJ-Jj9JcC6rLILcMV5vLjRBiQ-xAhQUS1OC5EFdTeJmXucBw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftaaO39W2bTlOyb3gzFp3EiutorfBkqo94-Ha87-ZHOoQ&oe=699DB326"}, "display_name": "Highline", "keywords": [], "long_description": "\"Highline\" is an immersive slackline sim with narrative elements.\n\nYou play as Olivia, a professional slackliner who was about to beat the world record when a terrible accident happened. \n\nKeep your balance slacklining while trying to find your way out of Limbo. \n\nDiscover a brand new mechanic designed exclusively for VR. Use your whole body to walk through vertiginous lines in a unique surreal environment. ", "short_description": "You are a slackliner trapped in Limbo.\n\nFind your way out highlining through surreal environments while discovering the secrets of your past. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.monteperdido.studio/privacy", "developer
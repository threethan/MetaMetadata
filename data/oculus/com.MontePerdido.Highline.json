25/38982715_797207448209806_2742432445934761110_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFX4HHztQjIQ7kNvwE83fyw&_nc_oc=AdpvAjM21zUbcPtHRDBll629MbtjGyiocKh_zOmM7z4GPZJpDXJSUbcagEWZ5G4-6qQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1C3L1yf8Z-0CGt-d0yQAy1_U46DETtPgkOPEV2an7wBw&oe=69F0BFA1"}, {"file_name": "Screen3.png", "id": "830158965070135", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031368_830158968403468_7400007788056871560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8BDfj5ZBWcQ7kNvwGB2zDb&_nc_oc=AdojdzmsTMy-xlAAATGufPT-GkKB9QqqYnoKd7U8FqXLjdfbS8dgn6RzZnEwO-65fII&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0W1Yuv1a-awUWpG3wR05nG8NmJLc1wZuuXNQA6qwfa8Q&oe=69F0C52D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FrontEnd_CoverLandscape_V1_2560x1440.png", "id": "430542742556397", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982715_430542745889730_1000337972939003822_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gbmp3QRGPWMQ7kNvwEWgu3k&_nc_oc=Adpr02djikpz8_vj9tusZruBEEFYvQHycRIkC4wtUFtbA8Zs2LGme-HrlW1b_rPfhTM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0a__QzpEpb8rJmlOm02_XuHsAOGq-UssprJp-52LU-HQ&oe=69F0C1A6"}, "display_name": "Highline", "keywords": [], "long_description": "\"Highline\" is an immersive slackline sim with narrative elements.\n\nYou play as Olivia, a professional slackliner who was about to beat the world record when a terrible accident happened. \n\nKeep your balance slacklining while trying to find your way out of Limbo. \n\nDiscover a brand new mechanic designed exclusively for VR. Use your whole body to walk through vertiginous lines in a unique surreal environment. ", "short_description": "You are a slackliner trapped in Limbo.\n\nFind your way out highlining through surreal environments while discovering the secrets of your past. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.monteperdido.studio/privacy", "developer
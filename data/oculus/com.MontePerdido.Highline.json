25/38982715_797207448209806_2742432445934761110_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NPEHsv1WaYQ7kNvwE3okLh&_nc_oc=AdklyxXdB2n2dAUJkSAb4-ipcYwyzvMIToHcmygIyLEDFJfpSTJP4Asxex0lcwaeGJM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft_vtNB9pfRAS8LW4nvtXQGN935D-6JOuWuVNUzgCREHQ&oe=699C5FA1"}, {"file_name": "Screen3.png", "id": "830158965070135", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031368_830158968403468_7400007788056871560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3jSk7yAy-cQ7kNvwFtZI2o&_nc_oc=AdnX1pPCNO_ExUe_MMfu8e_RbknYVkCxh_eUszld9r-jeAlw-mp1-75G5WYH58I4I8g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs9vR0wNdFfVBaHpaCyMs6sANH1Hzzm_z1uZTwQw-iYhw&oe=699C652D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FrontEnd_CoverLandscape_V1_2560x1440.png", "id": "430542742556397", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982715_430542745889730_1000337972939003822_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67GoWpPLmAMQ7kNvwH-HvGW&_nc_oc=AdmBYtGH-D2AKiRrpHiRftp1owMaC90RO641eYXptWNoPnorJkKb0VeVoxSZiENy0Gk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuWiRyKCFKzNJBT-299NFdvI-gH6k4E4HewNQ6WtlMgww&oe=699C61A6"}, "display_name": "Highline", "keywords": [], "long_description": "\"Highline\" is an immersive slackline sim with narrative elements.\n\nYou play as Olivia, a professional slackliner who was about to beat the world record when a terrible accident happened. \n\nKeep your balance slacklining while trying to find your way out of Limbo. \n\nDiscover a brand new mechanic designed exclusively for VR. Use your whole body to walk through vertiginous lines in a unique surreal environment. ", "short_description": "You are a slackliner trapped in Limbo.\n\nFind your way out highlining through surreal environments while discovering the secrets of your past. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.monteperdido.studio/privacy", "developer
apped in an endless maze. the lights flicker, strange noises come from the shadows, and something is always watching. run, hide, but no matter what... dont stop moving."}]}, "developer_name": "CyberRebel", "developer_privacy_policy_url": "https://pitheciidae.my.canva.site/monekprivacy", "developer_terms_of_service_url": null, "publisher_name": "CyberRebel", "support_website_url": null, "website_url": "https://www.youtube.com/@EmperorGT1", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9446839182032301"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "987148226291574"}]}, "baseline_offer": {"id": "987148226291574"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1743198720, "status": "PUBLISHED", "id": "987148226291574"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9468697263179826", "version": "0.9"}, "id": "692630129884048", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9369820663067487", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9468697263179826"}, "release_status": 
tC0YxUS25OvBUeAiswum9ZZa4Ngr1TfkPCtKIKXC8abQ&oe=6999A643"}, {"file_name": "Screenshot 2025-03-15 121241-2560x1440.png", "id": "9227412570640691", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394299_9227412573974024_236731477646913277_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxwWvSlJ1aIQ7kNvwGvwgP5&_nc_oc=AdmmT5oxu0ps2-PB1qQH8u2xjZ2QAL5KZBgW1BpvIhk6_901nqLlsce4V2x2YXnc7Fk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvTipcvm2YxoHKi8A1oq4Sb6MebqzUqNqI3p11TDO3UIw&oe=6999A6EA"}, {"file_name": "Screenshot 2025-03-15 121555-2560x1440.png", "id": "1693008224974302", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393450_1693008228307635_6613196708445610308_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LY0dsIpN_54Q7kNvwGBcJ3P&_nc_oc=AdnW278diYKZfCMZVT8ETgTZnNMxitkk-5XxfTFDX5-gO1njTGx2WK2qbqHvHVChF1Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsu4QfkWxJSnS7iYPQd1BSSu6-YD8TV1ssvzhR5gclfHw&oe=6999ABB0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MONEK: Birth Of Darkness", "keywords": ["horror"], "long_description": "monek: the birth of darkness is a gorilla tag backrooms fan game where you and your freinds are stuck in an endless maze. the walls never change, the halls never end, and no matter how far you go, it always feels like you're going in circles. but you're not alone. you hear footsteps, but they're not yours. you hear voices, but they don't sound right. sometimes you see something move in the distance, but when you get closer, it's gone. your freinds keep getting separated. maybe the maze is shifting. maybe something is taking them. you don\u2019t know. all you know is that you can\u2019t stop. run, climb, escape\u2014just dont let it find you.", "short_description": "monek: the birth of darkness is a gorilla tag backrooms game where you and your freinds are trapped in an endless maze. the lights flicker, strange noises come from the shadows, and something is always watching. run, hide, but no matter what... dont stop moving."}]}, "developer_name": "CyberRebel", "developer_privacy_policy_url": "https://pitheciidae.my.canva.site/monekprivacy", "developer_terms_of_service_url": null, "publisher_name": "CyberRebel", "support_website_url": null, "website_url": "https://www.youtube.com/@EmperorGT1", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9446839182032301"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "987148226291574"}]}, "baseline_offer": {"id": "987148226291574"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1743198720, "status": "PUBLISHED", "id": "987148226291574"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9468697263179826", "version": "0.9"}, "id": "692630129884048", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9369820663067487", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9468697263179826"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "692630129884048"}]}, "change_log":
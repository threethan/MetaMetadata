ile_name": "Screenshot 2025-03-15 121141-2560x1440.png", "id": "656402116966356", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391865_656402120299689_9203100618432548350_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GU8CkOWnfDMQ7kNvwGhPbDw&_nc_oc=Adpwu7FP1GDVx0p1mJgBsk_VyQm71I4pkFvuYw35V1pui_HI5v_zWao7KStIft8D4cE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXgkNUAIRtt_2IiLfe3ufHGyGu2U3ACfWQslug__hO0w&oe=6B09B103"}, {"file_name": "Screenshot 2025-03-15 121241-2560x1440.png", "id": "9227412570640691", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394299_9227412573974024_236731477646913277_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhDlaiIYj0YQ7kNvwH6Ie7c&_nc_oc=AdrmGB4zVsfQFD2P6ouedZHafsV4SZ_DzqPfw8MktBcQtjKZ1nupzToKs85kEh0ZWCA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSq_1SVeXNZWxwhztMOYCSwgYRwXZ_V3AsEp0MAaIKXLA&oe=6B09B1AA"}, {"file_name": "Screenshot 2025-03-15 121555-2560x1440.png", "id": "1693008224974302", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473393450_1693008228307635_6613196708445610308_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVd1ZnodIKMQ7kNvwEi7mi2&_nc_oc=AdpvN3_QRqSdpNBwlgJSy7aNJGY1v01YKcxotm6r4RllaULfzmn1q8JSVUliRYdfdU8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJ6vys3dmFHgNwxIdxkTVI_nOMFcSYjESaBoi9dgD2Ww&oe=6B09B670"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MONEK: Birth Of Darkness", "keywords": ["horror"], "long_description": "monek: the birth of darkness is a gorilla tag backrooms fan game where you and your freinds are stuck in an endless maze. the walls never change, the halls never end, and no matter how far you go, it always feels like you're going in circles. but you're not alone. you hear footsteps, but they're not yours. you hear voices, but they don't sound right. sometimes you see something move in the distance, but when you get closer, it's gone. your freinds keep getting separated. maybe the maze is shifting. maybe something is taking them. you don\u2019t know. all you know is that you can\u2019t stop. run, climb, escape\u2014just dont let it find you.", "short_description": "monek: the birth of darkness is a gorilla tag backrooms game where you and your freinds are trapped in an endless maze. the lights flicker, strange noises come from the shadows, and something is always watching. run, hide, but no matter what... dont stop moving."}]}, "developer_name": "CyberRebel", "developer_privacy_policy_url": "https://pitheciidae.my.canva.site/monekprivacy", "developer_terms_of_service_url": null, "publisher_name": "CyberRebel", "support_website_url": null, "website_url": "https://www.youtube.com/@EmperorGT1", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9446839182032301"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "987148226291574"}]}, "baseline_offer": {"id": "987148226291574"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1743198720, "status": "PUBLISHED", "id": "987148226291574"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9468697263179826", "version": "0.
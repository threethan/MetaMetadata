t-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJj8bgjZpCHfrers7sZP119k7Gs515Y2HeIPbzSe9Tyaw&oe=6AAE8460"}, {"file_name": "Screenshot 4.png", "id": "1284154326151416", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391894_1284154329484749_2318945669764872212_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cW5hbguyBgQ7kNvwGJHu61&_nc_oc=AdoSqu01QozbdKbgzIsIS9n0K8sJHilVB1H7nNxvt4GDYbSk9Wct8_qvUXTWe2AHFt0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKdIshI065Fzb5Qrob_qxbvnRf1KtEgBIyEnUXdGWtNQ&oe=6AAEB328"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Convai Animation Capture", "keywords": ["Convai", "ConvaiAnimation", "NPC", "AI", "AnimationCapture"], "long_description": "Unlock the power of human motion capture with our innovative application for the Meta Quest Store. This tool allows you to capture detailed human animations with ease, transforming real-world movement into reusable data. Using the Convai SDK, you can integrate these animations into your applications, games, or virtual environments, streamlining your development process and enhancing creative possibilities.\n\nWhether you're a developer, animator, or digital content creator, this application empowers you to create immersive experiences by bridging the gap between real-life motion and digital animation. Explore endless possibilities in VR and beyond with precise motion capture and seamless animation reuse.", "short_description": "Capture human animations effortlessly with our application and reuse them in creative projects using the Convai SDK. Perfect for developers, animators, and content creators seeking seamless animation integration."}]}, "developer_name": null, "developer_privacy_policy_url": "https://convai.com/caa/privacy-policy", "developer_terms_of_service_url": "https://convai.com/tos", "publisher_name": "Convai", "support_website_url": "https://convai.com/#contact", "website_url": "https://convai.com/", "category": null, "c
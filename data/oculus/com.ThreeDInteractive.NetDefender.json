22007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ON2WPxmIRwMQ7kNvwHxxrE1&_nc_oc=AdoFay4hCq8wbVu001BJ4fN4MKvZV5CkhaBbhblNozRPtAqTh8sn_P_af7GAqzP_7rU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAruHtxQDlCjuChM_JAtJ3xbn7-tR3UXQD85JcirNvcqQ&oe=6A5CB816"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VA7dg6sBpMQQ7kNvwF0KLgm&_nc_oc=Adr6kCVsmaCtHhpGjhs2ArkX6K9tNxcrPmfY_5ogocf0d5U_Zn49sHb6l2NCGJWQ34U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABtB7xkZyC6IZcAYW07A6_s1tozw3Dx-Fb4TGj6bwY8A&oe=6A5CB860"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KP_mwKMyxsoQ7kNvwFL6kFc&_nc_oc=Adr3yeXC9tsezks-3T66cZh2ONJjq5QQqwnfVkW5h7xDuHChZ0x2mpRJrOX8ybcN9OQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRZD8jAOW5QE7mDl2sKsk8bkdJUkXde5RvEHqQLbz50w&oe=6A5CB7B1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of 
8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O060gaS6dpIQ7kNvwE3L26M&_nc_oc=AdouFWqMRXuvFhHwyrHghfOXDF4U3wEKBIeSSFo8bFszJAjt34B2Fhl39NVqv_j4_eA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJh0fe1lGriyLbS_YfSp09qRuUeNdYrTEwOv9-S_8S2YQ&oe=6ABE5795"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGxojnXkna4Q7kNvwHm_w-B&_nc_oc=Adr-4woAXJJ9wzAEjnbtmEjY1IPaOEY7CGM_v-5MiyJwsbiqXZdfa_vaQdFqHNhPKhM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZLYgC3iaGOMu6lzB8VrsO0Q4V6cR5kHIktJneRISz6Q&oe=6ABE85E8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMV2i0Tj8qkQ7kNvwEK2cCJ&_nc_oc=AdoMHadlHsAEiZqH7yjkqBF0UNSfPeWdDrn6e55M_j1A-_eJDg7xQyQEDyBDaBeLV3w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvz86DpnJCSuAVngN4hjCYVk_QZLClDWfhVRb8RsjgIw&oe=6ABE7F56"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsZvxqaywPgQ7kNvwED3dAA&_nc_oc=Adq1fBJY7lI08CqWspSautkA1WTT34rv7AtYjOocDsvaZKQy-Qlticyw5UKRiI6RDkw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHkHYCz1Kwj-wg3BOx4ni7IUZ2PuvSWe3bSXyKHBwMsQ&oe=6ABE7FA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORCmTVX_vCIQ7kNvwHAOrrU&_nc_oc=Adp7LH1ckbGOtp20lHc1wimCc6Cl1QBxBNYPr5B8ZJDhtMoKVQyVu5RuZue-iWNe6iY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxwJhJkOsWbelZwoutZ4JN2FO8JiagYpmOBGBxI_pLEg&oe=6ABE7EF1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
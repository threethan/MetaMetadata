8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sie60MoJuFIQ7kNvwHcfR0x&_nc_oc=AdrZchbBPe2pUw7x2wGFQFMIvqBqaG81MHcMhdGZ7xW_TyRoFo7Z5pRV-tFGxGjjCeo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTblV-5j08CwrO7thP2ItGi9vll0UeBYntAu28IqGji9A&oe=6AF9E355"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Asr4c0vlUxAQ7kNvwHHr2EH&_nc_oc=AdqVW17DzZWaRTmQrVpayPC7-nqyC8w1yvAH_Dnuj88ZlVplTqfGkaQy_-dNIZ7k3rs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZd81D_gBdVWQXDxJDEyxmIdBdaX4tVzx_N9PGMm3big&oe=6AF9D968"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=suyMKAha2xoQ7kNvwHUmm2L&_nc_oc=AdoZmzvRmPYOLmwFUPgjC-5tpwww-_eM4DQHRTALpnK2305Rz5YfiveXG8kh0a4gVAw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmmrBIm3ohwpFjXu-9svxyTICCFSmV13i0Ilr9A6oANg&oe=6AF9D2D6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y61BDmjj2-cQ7kNvwGlDtek&_nc_oc=AdooRaBQJwlmu4NW5m-zyWJo978tBlpcWa8GccjoFva83msU8Qv04ZejwhZsAsnq97g&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTybWGHJqapA4kmIeUONra9FlWUJRSjzylPiBOpWF95DA&oe=6AF9D320"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uo9ytXJ8LyQQ7kNvwHIwCUE&_nc_oc=Ado2J2gQW01Bz-5fsuLr1NdnS1c5-lXaxyqHCMWhKWGufzwK8toCNdO99Va-3YCwnbc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNu6LrDibW2yCfXfoB5X9DVMCKko7HGIf5h4JGKrtETQ&oe=6AF9D271"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
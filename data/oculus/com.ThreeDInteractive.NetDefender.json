137_3161180598516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1PNG_oDxFSoQ7kNvwHwlL4d&_nc_oc=AdroOeyzNE5JxtAgeFTya9Lj1b5ayT5e_ppOCaSb4WuVIEFZ_AuzEzmIrT8-dEREQaI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQTz9h1ZSxCLwvq20EpHSgtQmExqat1UJiE2bJ5hJsLQ&oe=6A8EE195"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjcAyowuficQ7kNvwFXZa-e&_nc_oc=AdomaWMmxX5JzVFPztWFf8Q762Et-4fVlJAyaVdwshgx5fEx4TM0Ey5Mx97OvdDkW40&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-xlWP7ikhtRtb_nI-ws3xERC4Gypnvgui-8lYhbICLQ&oe=6A8ED7A8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSWGHuNWzesQ7kNvwGAbZ4h&_nc_oc=AdoNVxGFEG2z-BMpsnbi8BSYTe_ZXyR2J-q0rRdS9QjMW0KsEDoAkx8JGhXm1ztwoh4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFfcnaGDoKmf6NOwfLxYetZYQI8CJPyuKxTqF0b0qb6Q&oe=6A8ED116"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swd9c-sY8gcQ7kNvwE2KnD-&_nc_oc=AdpxLhfhstP3jXN12NQrFj7cYFI2OcjRPHnEfMqYA_G_5N9xlrxMMsu9h-NB48tx49k&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-5HTupii4w7yS__aFklwQmC6B0-wu7IpxTvI2b3D3RQ&oe=6A8ED160"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvMFFBqKzm4Q7kNvwGlDout&_nc_oc=AdqTgt3G4pGXODSuGqWWGbWnxtCv9R_4Os911GlGs7JsS4e40en9lCS28Z_o74EkdcE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHelvzqEoz9dLv0IrDDT_tmSnsX3maTOxSYCm5FMTxg_g&oe=6A8ED0B1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_mes
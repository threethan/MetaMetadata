8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBgNDg6GaS4Q7kNvwEiWiS1&_nc_oc=AdoCMG_L45hqvI2L-PU5Cp1s-guTv6IwFAfDkuTax09Q6_jWZD1t86wSfn3-qvLG3wo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJg_DqOcxXRQfEu6740oDJwno2q6M6dA_1Zk8ZHNvnag&oe=6A5B7715"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4UAS-i8CFb8Q7kNvwEsjt4C&_nc_oc=AdqCY_gfMbmon8T946QagugVvKRqXc9fP_UE0kxYuR5yn9xy9YNHg30TTze129j2GFI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZkXcu8W1OcnPJIPDlLMmuk6h6m6iisUCps8QhKGmx-A&oe=6A5B6D28"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ON2WPxmIRwMQ7kNvwHvqCGm&_nc_oc=AdoWE7xK2_o1ovZ6Yo3bNpiRCzpSC5gx572WmCRWHn8gX0mDRYH8pYXfqYTbKYJFApw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnzdGT5eXIzz0mTIfkYUhI1cq0EEiNOrKZ1R9JLIWa2w&oe=6A5B6696"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VA7dg6sBpMQQ7kNvwGxcla9&_nc_oc=AdomyeanYb9QWvgWkAd99XqwQ_YMCv7nJ3fTU3cqkbBSp0GJ7Dxro9DgVhGitjBr8GA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrWdOVeXWf2C9aFDnH12JasT3cJkFdxoAxoq6Ay3jXag&oe=6A5B66E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KP_mwKMyxsoQ7kNvwFrcIE4&_nc_oc=AdoqP_JVJliYKRXDA2ZbhQD3p_n_x5CcP-qPnzXRfbyqzKI5Eg1wvpksL9aIQLNlu70&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDklZpj5a38uE8DxGvMg_nb14NGLE9K2okpM8bgc177Gg&oe=6A5B6631"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
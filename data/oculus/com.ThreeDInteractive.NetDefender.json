8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBqGzSG4Ju4Q7kNvwFLl9yw&_nc_oc=Adq7yOflcnxkYZ0FMGpNJpvRQ_mzGOlzwAX_UHLCuEwT8Z2e9IC0WdAqung0cCjUlFs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jsYwp8eFGZVW4T9k0BjIUoP0CwIsM_ElgX7Fdn4ICyw&oe=6A2AAF95"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQi9CFeYJ14Q7kNvwF1Q-qU&_nc_oc=AdqcyjTyUTziAp0yxzDAyUMyXYCz4f8sEV2jOWWOyzWc8vhYnvvD81ASkWlmOov_lFY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_l6tt6l-bI9npldJ8UDvtYQ4sSoHn6erxLdZgxLlMRrQ&oe=6A2ADDE8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DKjeDUn8IMQ7kNvwH7cTaA&_nc_oc=Adq5mhDsV9v0737UouDwOM4rgXANlgdDcNudikzIa0goCAajh4JNA_dltuTOUeO4KAY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kMD3dkfo0oy6Vx4VrTG1ZOjYqtPoJA64W28-ZnGs-sg&oe=6A2AD756"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQB-XrsyPz4Q7kNvwGckDMZ&_nc_oc=AdqtN79alR9j1LRwCRhDtMTEn7fe-eoYATTxlk3iKlGyN-Gkurri_sAYSCofxZiBIqs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xXZUCAHNeYnuXpqb2I6HEqVwFIaC76BSbYzruDHfOnA&oe=6A2AD7A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNo2xrUAjXEQ7kNvwHt5Z6X&_nc_oc=AdqWOPbfhTegE-uq1KVBU7nWE5zgjMnbHZ7ozGxqdeFoA5j8a33Cqo0gRov_npSZRhs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84Sc9rEQKclh7uWxEj02BrkRE6q3-B4sXIOCXXHJ6bUA&oe=6A2AD6F1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Spx-ARk9E8QQ7kNvwFH6km5&_nc_oc=Adrg2dJ2dhn3SlB7MU5QZ6PfUCEaGlTW_gc7KoU-iTPrP2VG23daFo69qVR9sTvf5mU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ClqUm1i8rW7H0qFPbQjL4L-GDPkvVL1y9ObOipeHFmA&oe=6A3BD315"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWcQiqHIzNoQ7kNvwH7XoMU&_nc_oc=AdqSx3TcoQ5VBa7mNTWr2Wf8ROjHB2wwXgSTEXLUl95zCRG5y0jVSpfi2V17jnuSz9I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8F62Yg1GPs5AnSXwFCnOqB5v-AlrWPRgXJFxWY1ILYuw&oe=6A3C0168"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fs2mNpNjdgEQ7kNvwHZaIkP&_nc_oc=AdpAQRdFk_I56cM4FYOAy-_Bevgjn6jq2zYGYeT70CYRLq-lqkTX1MnutyQ306UTaiM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tYusHbihYeCu2AKZWZqzYeq5n9lyAK8lFx_0HtfwSpQ&oe=6A3BFAD6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xoig5r5i3twQ7kNvwH6TDjg&_nc_oc=AdoscHrIxmrdS-_1K5-7of-XzjXkL49SznEZEpcBgMnteBkVxKTWSx_G2Uti6bSGGa4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9K5aeKT4tRNeTLCLYQLGKU7Rrei35eL5Vw9x2Clx_sxw&oe=6A3BFB20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruyiRT530swQ7kNvwG1Rf26&_nc_oc=AdppEEw2p7Wmb9slSJ-xfZzE3xC8i47E4A6Mkd3ofSebanmDYdIPrF5qStxqou7M6LI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hLJd7EJie2C8KObbUrcbgIF1GjdX0nrUTgQg6ULh_7g&oe=6A3BFA71"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
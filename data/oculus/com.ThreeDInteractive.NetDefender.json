22007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nU9do5qgd8oQ7kNvwG8nohO&_nc_oc=Adr_YZlOXzVA3Jw48tM3CcEpewHy1VX4p7l1DI9ctNuUMAs7WDR5JQPX5ZPa1dEstQs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9lbTFk2kLE0qcT5qeIDlIFq3qGr9qgUAxBCEVgIA3Vw&oe=6A9EDB56"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1LFG0wJnASAQ7kNvwFp4hTE&_nc_oc=Ado_KuNMKQh7k-jstsIzrm66YZ_RFF03r3zpuPTT7t_7hDzJjvRJ-SIbYLnk3mEE70I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBKIY4tT0vOcVV50mJSORb7yo0rEke0ZaOsMGVoaemeA&oe=6A9EDBA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTj1fAkBLMcQ7kNvwEF_qID&_nc_oc=Ado4r6Kx3m-BHX9Ka_Z8JKFx0x-Nyqj0HSD-zLI_ZSqkTXsGcqyCbgdRI2iouEH2uyI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqAiyINGHJ8o3bam0QHURqPVksD_kcuUtg2OL1GVPUCg&oe=6A9EDAF1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of 
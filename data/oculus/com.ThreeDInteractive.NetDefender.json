8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDqgydrTZnkQ7kNvwFBa65A&_nc_oc=AdooMw_gAfl2beq6zU_8I3tEZir9LuTNcUHeT-QrJJzsmM6p30vqsXAOxWwd-6kYK7g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6X2Jxt-lN9IHK9V4MKc1DRpEI_xlXmVblGCltdNgdIw&oe=6A660315"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RONYB1FsPP8Q7kNvwHg-DKJ&_nc_oc=AdohSs1iduq2fXfhA2oXz9m5I48wcCwfDTp4NDzEl0GCmTxAibkwrYdUw3VmnJmzbJw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJMpdnfzZd-tue8FGUx0_bltKZLyEeMCEEv275YzmT_g&oe=6A65F928"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcqraVzGLr0Q7kNvwF8WsH4&_nc_oc=Adosg7MqEPxHJaX5IqhLGe4Zxt5YudwpPLn0qZXM3m-dqSJZjO__c_oQ-s0o_HV6Ams&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCz3TlN6Dvn9HPnGo3MoRKkt2JBocevXsEig7Hm-JMXbQ&oe=6A65F296"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D01vj687kJkQ7kNvwH2ZWN4&_nc_oc=AdpWD8T1pRGJoIxtYznwhxzyU_hU9MjLhIU294YTnmeHlyDfi9pzdQYR0xn2vpi4S_s&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8Q7ra_m1sjpukuP331cG8H6eq4CEEGyn3AaBMNvPYng&oe=6A65F2E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0UR5xh_8vsQ7kNvwGqovpQ&_nc_oc=AdqjXZ82wROL-1V0QJHpUizRlBf0CKMjSRt4UzVCUCqJVyEniYvpzzPENEeAlw0RJWk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQe33iZRHuo2_fbADrr1fgJpkUqOzxZgxgHb9kSb2sOQ&oe=6A662A71"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
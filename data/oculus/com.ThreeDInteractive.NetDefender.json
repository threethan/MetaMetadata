8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnG-pqnEqKIQ7kNvwGQ-XFQ&_nc_oc=AdoigQvI6z9tg5X-ku5bb-aB7gCNASXpj-EwbuJto5M3qWtUaBY2_fhJc2AxIP_rnoM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2FjXFqscMOhH9Xv8rVTnVoVq8S2VfXnGoCNKWvLIc9Mg&oe=69F4A215"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VAnGKr3Lf4Q7kNvwHzZW-I&_nc_oc=AdqCWovZ8Mo6itz9JrWVSnmogfwrEzW4MituFpe1kjR2QhCFE5Hy8LGEY7dwrA10COo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2oHJA0JenKgD0FC2xWctmFcMj04izugI2K7ceinWaEQw&oe=69F49828"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmQqkw7Z1SoQ7kNvwEMeytu&_nc_oc=AdreYaHXAMQLNkr3WkugCHFDCOZoyGfHFLQ8ZdK5Iq5SbHuEWPErxaEoYvsrM3iqWyA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2dwoWmeY3naIyJZPqLNKmPAkcNA5jFks0Vn4izcmugDA&oe=69F49196"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXUJPP5qrJUQ7kNvwH7zj1F&_nc_oc=AdoB-14RImVS9rtkeBhQwhMCltHS0jzMv6hk2U_H7m3_7zvfubpuuuCkKdgTR0l7pG4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1mMvvic7C4D25BSUTgJyW7Z8jN-VPGqXBSglrkrJib4g&oe=69F491E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Exi3GbAo50YQ7kNvwHyw-DM&_nc_oc=AdpyTHLlK8i71yAMxlmF1-YXDY8CIXfufpcUjGq2vFcSNX8sJ-8NDH9DeCTQEU4cYyM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3NAsF5GcqnO2HyuZFSe3S3kCLumU4hgqCkDwvrD5KkJQ&oe=69F49131"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
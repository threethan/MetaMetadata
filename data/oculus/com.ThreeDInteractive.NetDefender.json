8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HeM6kwBRysQ7kNvwFaVkr6&_nc_oc=Ado-NBcc7xMRETRuTWDkGmfXEqRm3QwxeNAEYTgOBD4IYzq04JJ4R7A9btQT6XqJlXo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCEnbDARmjlUatbm1QaZShv5BCiXHu6uN_JZtIFKEd6Q&oe=6A903315"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCf6lQ_KIh0Q7kNvwFBg_j9&_nc_oc=Adot66BwAeTUgCEyP3uYE4Gi5ZmEgggu1TdPkK1Q9lPf_wy4ZrBB_GyuZTwWNpT1pwM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYJ75cWBuAcNMS9xNdpOv2JmQ1t05Ak0MQpbb1F-JMNQ&oe=6A902928"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSWGHuNWzesQ7kNvwGHa8xj&_nc_oc=Adr2G2PYdiSQ-D7xtcIDvTCuRP0xReCewjms51gGoSbEOHb0xzi7tg3AawlDZ9oG_Q0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqIV_Xfg81SXtrO2zXNlr8PwQHFJdmVJknoQv7Gxc6vw&oe=6A902296"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swd9c-sY8gcQ7kNvwHjZ4ua&_nc_oc=AdpkWMZ094MAw4C5tsa9IqXP6NSO1l3sG-gdchRlug2YlBzr11o6PVmyuR28nHjBJKA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHRLolzvq0LBK3khHqn-C7GTuKXwoBp9vvl8sgF74MTw&oe=6A9022E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvMFFBqKzm4Q7kNvwGiDxY6&_nc_oc=AdoHiNRmLgNHIPHe6AE4LEGzC2XGtYpiazgySJhBciUzwclWsPV2qGhrUwdH-P46aK4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAH4ZZVFVPgm4t3VC16-mEUWFz6kVlY4ZGpn_rUSn8mw&oe=6A902231"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
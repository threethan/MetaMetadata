7a0a&_nc_ohc=96E6GlhEsUkQ7kNvwHKhtAD&_nc_oc=AdmyFSWsOTZqpwbaEAz33l0vc1Ia1ynOvjqa_oMdGpXNPMTa6LPnETRH_tresF_gR8I&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOMLWr4fbVVSAOq3Tljj9r7BQt5ss0w7AewNXuNCLbRA&oe=69AABD96"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1unGFrCeBAkQ7kNvwE2SGCj&_nc_oc=AdklgTBwwltjLY3ICy_31aiR15KYY-swJTOPJu0FUni3laY_nVxDcSg2ts1VsPF4DSY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afx-82D2I7BNjyJMAM7kV_5z-RdKniMzkz1DIsGmg6R3Cw&oe=69AABDE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jh-TZ6Eog90Q7kNvwHFcwj7&_nc_oc=Adl1H2jdoR1NJh23v6zEyXjvlY6GeUauUdWMVK7Z57Z-cpUT6HjV1p6wx6UqWUEQWis&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfzJhtXe1nwfAINT_JQ1Zlj-oTW9bT3toG3EkVRjv_HGBw&oe=69AABD31"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": nul
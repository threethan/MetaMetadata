=1-7&_nc_sid=6e7a0a&_nc_ohc=gbiWA53f7zEQ7kNvwFxCzw1&_nc_oc=AdnBVf6rAjolS68Y_FQ2KJOzjvoKB0A9CtleKFQ3xHbWv-f5VuPdmXo0H9u4wnorBbI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzFWwTxWwtASaPLHK0nTJyYMXC1mn_KR0gcoUN89sCFSQ&oe=69BD4315"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaP9yMuTWhcQ7kNvwEm3Bt3&_nc_oc=AdnYxVkHW2m5INP97VZNeiiPk0B32jeMXfrf7UqIpS3s3xe0dc9KhgkWzxxvh-6LZlY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwaVWm1-rmk7afLPUn6EOzZRUvLIinxPbEJZ9voK7-VcQ&oe=69BD3928"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6Kk7KrIHvoQ7kNvwHiJl_W&_nc_oc=AdkRIPKAdy8ZueHGPM0ExXL_9pSb_Rwxfi0bUa-FNho0CyIbZv1MfSLRgFWAe11bSVA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfynEX0k2r8bmMfXcFOzJSj8RvFTvaaQPoyH9kHspb7VHg&oe=69BD3296"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjeNaQiaBbcQ7kNvwHezU8d&_nc_oc=AdnDKN6LUjzKHBJGu3Z49kaP9vgSZYp41d_aHqxcgUoCqtpkVw_vUm-KPfs_2WC00Vw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwbMQTGgOn53gcPDofsti3UMUFcWnXz1irYTeW-r-dM1g&oe=69BD32E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-Ih1Dj-T10Q7kNvwGzmTj2&_nc_oc=AdnvpcxlA65RoRIPt-E2JCVUbBoRVuP_ZcYF2Nx_kavxFeBGd7Wz3wWxDCW3NbSmElE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXkIO83EF_87qmb6n9iGkyQI5b37C09tUBcYcDuxwXtQ&oe=69BD3231"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.
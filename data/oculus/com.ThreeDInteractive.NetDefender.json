8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQq18DlGQroQ7kNvwEDwwsV&_nc_oc=Adowu5e7kKxVxFiOvxirDqgheexWkXFnVfsKinK-rkckJcU5BBPWWQWjHFIi3cHvAkk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TtMCuLmIMo4VIE1BRwBSDOmIfpMBiaUoEReoXaykxbA&oe=69ECB915"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uztierorN7UQ7kNvwFqwS9G&_nc_oc=Ado2t9-eYrhQoDyRn7euLXjixFFhQyI2-JKuDk_IgL6RqEP26s0TOXKk9Cmr5iEAigc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OccIZhAb2Sa4TMezDG5OMMyBH7T0IiPOXKmwa2JmnKw&oe=69ECAF28"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Xq07TygOrwQ7kNvwHjSs8I&_nc_oc=Adr8fovjvqvpDuMghOnhimgp18xeoxluNwRWxERWBc2DOk655fDqfnKtyKvN9FHxqaY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1aronnksH_Y7rD16NHPg0O54aHnTX7kAdVxWqP7GAmgA&oe=69ECA896"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGoyZwPLHxwQ7kNvwE1XkAS&_nc_oc=Ado5Ifiv-T28lWXfXc0gCYQaOpSd8EeB32_lFP9ElyY9WBkEfYxXqwF9OUGfu9oCcTw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BSiodil-cCgrKivhI9kPeiGQZtaMpoZ6cyJ-mEykaOw&oe=69ECA8E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsLz8XFCRucQ7kNvwFFj91p&_nc_oc=AdqYBO4D23OzrZxceyumjgbv6sDt5PtVLEsJFIqZr8LTs5HZyBZ7NINWSzNSmHzx4FU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mTTJwqZopKSjLyQUH4WOD1G8XajtRppqjDFOQcUGWzg&oe=69ECA831"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
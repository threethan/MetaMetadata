22007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-XFOk9-pWoQ7kNvwEFVpD6&_nc_oc=Adq-XAHjryt4MUdvHzOmjyl1TFfmi0EOWBuRN1YstxuVRRtdxj8PXW4fiEQ16Y1xttM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7aMZxYJPbm9J6w0YpeMpJ9FpB4GvCWTMge9kCFIYJLw&oe=69CE5616"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wo0dGcnzJWwQ7kNvwEupMnt&_nc_oc=Adr8KBvhpyYVlMf0myz6I6PhBxrUVC-nc_HlF4dljakDpOQjAhWtteTj6hatezJhFhA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxo-FgC9Y5dgREH1XEqQPSu0yS4cuBIlUnNeuWWBTPmTQ&oe=69CE5660"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u49I6LT8UWoQ7kNvwFWw7Xs&_nc_oc=AdrjVpOeaX9sFbY1W3R-ZfjnsQndg0__9ZA2yeHF626YSUiwuN5-4Ky_UgiZVATCvGU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfytnEeCS4BToelIY-t7pZLH-1_Hy3aQa_43nlLgpGxH0A&oe=69CE55B1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of 
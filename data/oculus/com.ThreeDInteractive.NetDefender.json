8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcgwqGCltcQQ7kNvwHMI1ix&_nc_oc=Adp_cXFmsICkvxJbx3cVR8w9kKajhJwrYW7qIQsi0WDQNMrUJHx3wdS8zO0j99DvFpg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRNaFGoBmDD8HCk_DllwboczQzQKQHyLRI_eV79RS7nw&oe=6A538E15"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lq9wGsPakEQ7kNvwFX0z5t&_nc_oc=AdqYoWQGnIJHQ6S82qxDQAi7MGkw79CGzOUl3kceJEoN1C7lYfmg_Vts6RqlEyAv-9g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDavwcB5ExARPxM_h7-IcRnml3BnExZw6V3cccXkD27WA&oe=6A538428"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBtPpM46cz0Q7kNvwHQfKk8&_nc_oc=AdobHHYrHQSWwJkNO7NduEwWY72iCGPH1f9sNOU6obn66LdX9UbCFt2q7fdgq727Jz4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoYB6jHvukh8teAQdtSpNtyfy8PGoUSkYnZA7j5lG9Ig&oe=6A537D96"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHZp1n8ikJwQ7kNvwFGwPd_&_nc_oc=AdqthpgV-CA3sYQjvWj0nmEzLNkEK4CzHwzeUBu98hW5dkzL5C3pP32B5rzD38IadOs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxJVP54LmACIeqEgpvGjkCtNKAjrvFFCJchU01uqj1Bg&oe=6A537DE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQJfZagY9GIQ7kNvwG3kVFD&_nc_oc=AdpMXvGWmt6vN0YeMDAXbc2OGiKsoNPJq4aLsP7XWlh4qdJ8zcaEDdWhoAdkwevOESY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMgTcorBGEfd1K52zO-H2cfcELdevpesCkf18alv155w&oe=6A537D31"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
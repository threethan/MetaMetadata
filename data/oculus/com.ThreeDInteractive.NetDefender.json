8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLvfjd2XoDcQ7kNvwFynz8K&_nc_oc=Adpu6zJbcFvTbx9psqYuJbEG1tu7v4vo2iQdjrU84egRjcgb-GR5VzLcmIYzgICCF6c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDi3hfePxxo8LSF5B9L2cq2d2k7zjN7Cr5r583TdNOsYA&oe=6A578295"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpawtEPXa1IQ7kNvwF6ZRbY&_nc_oc=Adobp0wPsrDh39LbOEq3jgSwIkD-SO1OLvuyX3HL9ND_V6j2s3-HaXWICvmcrUusvl4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLx8gwwLSYw55GnuixWh0IoOSc4eDfj52oFq2YBx6vuA&oe=6A5778A8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJMLBZ4X_GsQ7kNvwFeP7kC&_nc_oc=AdpNF63wNrvMJvlcUs62xQZo-TWFrJfeCpb9U9WcnJqPL9V_6hnlKfE8z0I-Lu0F3ho&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2BpkFippfshj0KWN8xa2e7SRxly1QwNF3NQkSFyTZcw&oe=6A577216"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DO9FUea14w8Q7kNvwGAnlvl&_nc_oc=AdpUIUxNpIw0L491VoIbyHO1gyDSwIKRD2oIlNx4KfvfalWaRt2gVOdvXsVgaGogrps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUgANNuhV0Rh936UGbVs3PIkYt2ZJiydcUSCp_8xbsDQ&oe=6A577260"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpwX_cM-FL8Q7kNvwFHbo9D&_nc_oc=Adpd9eyhCDz6ogrYfrVPxSMzEgiS2TqxxwlfaGqXDPHegcALzptJ_eEhbuZb-CrevWg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsCdO_dEYsW9Lj4eq4wt8I94dQf9GtMcZS3_8js89aeQ&oe=6A5771B1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fO8ofeDcrsIQ7kNvwFPT_J4&_nc_oc=AdomAwdvRs0apsLNe13JCdQMZrplpCvDgoE3qQ3e1XTr43uqu_eXnRG7BGHby-ZgpkM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvINLNaNSAgJonEGSZDMifaBFPQOKRa-kKPdbsDuaLWA&oe=6AAFD715"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ODgjfmuQpQQ7kNvwFTqLKg&_nc_oc=AdpYTcEG2MRWUmG2VHbktHKPzvdmfSKXjaew8MK9oxP7YnMnmET_ZklzNm7pc736PHo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwCGWbGg2JpfytunJBvZc2KEDyoRYgH9hwVLHSR-X9Kw&oe=6AB00568"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIE8kjqssegQ7kNvwHxGLf3&_nc_oc=AdoUVOLnaAfk85f6dPqZL7G7F2sK_ANRh31CBqYeP1-NbI3JTKmaNgfEhxHXIzvGPPw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeGw3rwUjYTePfl09e0jKdvYnJFXy9Ny62Icz0Aev_tw&oe=6AAFFED6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7Q0tmWR7isQ7kNvwEDdQEN&_nc_oc=AdoJKp6jMuFaMvIL-0fgWR3R2q7qT0BXhJuU1WMYUSJkQ6ZCgpSm4s5qRmcX061-p5Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIO-cxKkDImrctTtgmxT59qwyVVhUNWR6CH5uYhokR3NA&oe=6AAFFF20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iskfqx9k4WYQ7kNvwGi8XO0&_nc_oc=AdqWsXBuUFKgWGooMIOFIQZR7pfvxp8IjfIijZaJdhqQtvsB08y8h3gjcF2SBB1aQNE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1Y7xF1XXVfBhxhbuppeiXktJSPmuvtbnrg75AVAbLoA&oe=6AAFFE71"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
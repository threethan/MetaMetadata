=1-7&_nc_sid=6e7a0a&_nc_ohc=gbiWA53f7zEQ7kNvwHDL4T2&_nc_oc=AdlaizYx2FvBu76ngtrf3n_1Sidft7z9QUdVfddnHCCDSJ0n-syWiCxu_waFD-xyOII&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwQv9-EyoUvkjUTgTtbw_D_c2cjLe9bz2ONGKvGc2FsAg&oe=69BBF195"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaP9yMuTWhcQ7kNvwEvHg6A&_nc_oc=AdkBc-TJ59o3whhpJ9ESjExeq35ngMeONlqjJuNgEeICwnsKy4uLpmgpgAlBtr46pyI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxdlGwzGvZcSFfFWkTe0xhcMvW2HQwK_qdb493--wa7vg&oe=69BBE7A8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6Kk7KrIHvoQ7kNvwEAhWJp&_nc_oc=AdkHDpc6iIdE1_4nz6-UxaCGWlGQcIMB5ugfpWqx3yTdOn9freFlWermS_c30Dr4jII&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyY2eq1eRu2tFGV1PMDzVv9gDvcrTkYk_jWG0uCiJoLZg&oe=69BBE116"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjeNaQiaBbcQ7kNvwGTDrPJ&_nc_oc=AdkXMyJAY1l_SbusgZMGZDOcMLPiV_wuPIjfS9F_YelSd3TDrO0KvNE8J31s67O2_aM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxKkMkcZlmCyEUPei-71DQWxo7Wq04RBhoRVZPYY8XRQ&oe=69BBE160"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-Ih1Dj-T10Q7kNvwGkfdtd&_nc_oc=Adkj3LT5J9mxl_MwWGq6zGmYjLUabjfQqMdcwezmTBRmEY_m4Z6L5QkeIE1EjfgTEYc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzdJt9ngvj0YRa34CHQofNdDLLE8D8h331PYg2383NcHQ&oe=69BBE0B1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.
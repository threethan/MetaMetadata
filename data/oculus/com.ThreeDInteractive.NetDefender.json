8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlDWWlhLkH4Q7kNvwE1FyHy&_nc_oc=AdomDAv2LrRJR4x5_r4itPx8JZDYnIQ9BXCdAkC8sgYeDFt-lXG-rQUEalUZ5AHEzyY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8EK8m4Jr316PHZgvvdhWjpcAWYlofZByAcKOEru-B5w&oe=6A806115"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5F3mVXhqOQQ7kNvwFMrYK7&_nc_oc=AdosEVDt4poFq_LRjUR9dwfHqkp9GSQwnBSa13Q6tc1vIcJsFxaaN4O7YRXepxTGNcg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6Um_WPRF5dDfLt2rrieRBEm4y6gtRBWzWaX34N8D8yw&oe=6A805728"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyc29OxPphYQ7kNvwG_sBFV&_nc_oc=AdqzqAlH_905KnS4_QBmejdCN4fOnuRVPJgCerv82Wc0FpMAM_N7nIC9jDnHX8rsUcg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCG0rZkrXR5OnVnlhC29u0NH6kkUs4xx0vP6aaGMo94A&oe=6A805096"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YY52w7uaIgQ7kNvwGuZx3A&_nc_oc=AdpqA61-O2AtO2ypafnHJ1lZ1KBGcjX1Llif3PgoP9iY5ZgOdV99PfIIcFqBVl2ZeJA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8KEtr4MPMcMDRxblIz40196zaYhTS1n4Qma5g3jamnA&oe=6A8050E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VzfeLzo1dkQ7kNvwGmfiFr&_nc_oc=AdqE5UlAENJxB7jjlW6xtahgXUvdxT10TvHiFjgi2_iZRzvKZ2Jc5XO6tbTbZuH0Jao&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHc4uMJX__0WBGCQGAYJttTZk2DVliaHjQxDP6MB5jgNg&oe=6A805031"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
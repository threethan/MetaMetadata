8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXWbMsZoiLQQ7kNvwHb-YYg&_nc_oc=AdpZkoPSfL09K9oqV_hKvZdz8PrnoM80FMtm_AMqBaz1X_kMPhs6bv5Pj7EQQ6AAEkA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWNjFc1IzqdxA7bC4Z9pe8qKOFKfEC8roZsaGcYrRKhw&oe=6AAA9115"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pEUbCIDqpwQ7kNvwGHW1_O&_nc_oc=AdqIAMd21ZKu8KPDvw4uEd6uEQEU-BMMrO5cJPzwRnwCZfZm1aq0r1ke_RPRfF8vViI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKko2TqATfpSPswrlkJpf8meSHumRfeI2p5WK3qV83mqA&oe=6AAA8728"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZQVhoOdNokQ7kNvwHcCExn&_nc_oc=Adqe0mpRA-0ELaJt5OdEjF9s60ICmzIuDoOQ8cCarAitqUFVFjQJooibeDUPmjKWfoQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaj7TquzCqBVi_cbiBk8vld93puo-dpPhyOgyH8aD7bg&oe=6AAAB8D6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-s55tLlKcEIQ7kNvwEK2ATV&_nc_oc=AdoNAP2yocuraP2KSnWf96FE2nZ3tvGRfvkG-Yt_orA-KC4zxunqy2rY5L7ZcDdgmcc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLy-gBIefRCPDqQ_6fpeoZRtqBsqTWiTRBg41kT-2mLWg&oe=6AAAB920"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5phvEMVBFawQ7kNvwGvHKX7&_nc_oc=AdrugpQlxAo_A0RNtAjFTDBgH-l8XonkNG5jq1Pmh8Xv14x-lmtl7-GbrkgfoiYAtWg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeM4Dg6Uxx6Kvgpgx5bWmHITH_Q39ch7bVpJkuTeFeMA&oe=6AAAB871"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
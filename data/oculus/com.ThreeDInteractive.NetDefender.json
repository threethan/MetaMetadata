8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1Ohhgo-HWEQ7kNvwHTLXI8&_nc_oc=AdoJhv6G3reLOoM_4eGqOyNZe3cqr3uJP6q5znsgxvmh8kz4Qz8hGUm3Oc4endwkXyU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12NPOIHkEX4-_m59hXz_CoEAXRsrofSZGvKlHKUv3LRQ&oe=69E77315"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBN5OU0cuzEQ7kNvwE8FZpV&_nc_oc=AdpB6LC3tJrEpp1V7yFZxwl9HGWvodiHxCyOxP7WjAf7YmIb_4SE6y8Ugzdf-d6Mr1M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zlIUgM5Gp59uS8ACYrHyvdHYLg95GQeEMNg8eTPvKng&oe=69E76928"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2uK4lws8RUQ7kNvwGtxlVZ&_nc_oc=Adq8D5dOQn6nwtUj2rhVCbG60KPVSgTuvEYo0QNJrHcDhK_t8ijzsk19uaYydaw0GMk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DmYNKCX5vxqaOqXwbN9TMDGcu2BLWJIQAC1W75YdMaA&oe=69E76296"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMsCYcEkDy4Q7kNvwEOJP41&_nc_oc=Adr57AazzuJI97LOlriIefCEuSgLQK-rjTpjpVQQQweVJ6B2tXMxWEUy6ce21PlQlLw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kX4ee83gUCUXyJptpBlIoLcWKrhYnnVoLaZrKR4BKKQ&oe=69E762E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DT-IiIx_l98Q7kNvwE2YUrL&_nc_oc=Adqr0p7JJNjlLNS45_B7P9w0CsV8d4irZnXxN2Ci7GoNkkeml9T8wKJS-PpokXV7h8U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06R6jITR1kvpl9mcisMOFLovcze29h-xkrWxIYZ5cj8A&oe=69E76231"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
137_3161180598516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1PNG_oDxFSoQ7kNvwFKrATI&_nc_oc=AdrjGYCsuSKNlYE214z1Ll4DAJeuvuRS_l7DTo7UeVYZsPt5HSfBCstD6qHs35AJIxY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCYvaBATEkGeWNU-1MelATy2RNAS9wKvdo11rwCKAseA&oe=6A8D9015"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjcAyowuficQ7kNvwE4Ujar&_nc_oc=AdodbADC4FA8Yg5Oj6dQBRnzBZjmdF54tYzLx1-k7j_MJUUIF0C1dEStdEj8wdrlzp8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqTmFJ5-SX7Orw5v_7V19ja1HY6gi1Gyirgn2ogq-Lzw&oe=6A8D8628"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSWGHuNWzesQ7kNvwH-ak7i&_nc_oc=AdovaatnXKlUjOms4gt55vSrgdhi18frp74M213wHWpwEzaZiEoU6v1pRNS4dSmFa1A&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1am3Y-DXMwbrR-tXSf0lYjX0TQ-AYXVCPjezEHDKZ0g&oe=6A8D7F96"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swd9c-sY8gcQ7kNvwGtLdC-&_nc_oc=AdpV_qEH66JHr48tm6R-ehFgC9e_Su-j74ENW5QZGlKc-KjN9eLGiQtuB2IhpbcaGq0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMd6uILYN07p6XOz5xYT9xKpIFtURg8NuE7JlsTYNgZQ&oe=6A8D7FE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvMFFBqKzm4Q7kNvwF06ylK&_nc_oc=Adr13ShCocv1j6BfjXB0vNiwPo2kga_EXB3bJJgAmBJlUbBcGH46UomwK1VFwu6iIAk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoLWF4BewfDuakLwBvA-ZnV17qXA6jJA7r8XvdNxTfxA&oe=6A8D7F31"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_mes
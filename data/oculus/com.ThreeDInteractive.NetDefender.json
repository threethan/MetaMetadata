8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O060gaS6dpIQ7kNvwHYhU0A&_nc_oc=AdofR82yvEhNVl5hhX19aU2-tDDCgaoCvenXsIO3MfjQVePeyI2HuYgCFLUTPm3tHzs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUDdh9koaUavERpLZtFkXC-jpEmMbhyhmu0_2iXpkR6A&oe=6ABD0615"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGxojnXkna4Q7kNvwGBAn0j&_nc_oc=AdrMwBbMHp9KW_w_jD9k3qaprdnCwNCH_v_PVEcJDxpdZDmW_LG4KiGQVEIWyyGjsQk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDs_PBM__pxdICd0ob0BkaodMpjYetP7VxMi0KRVKt4w&oe=6ABD3468"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMV2i0Tj8qkQ7kNvwHR8mnp&_nc_oc=AdoZ3LdCYiL2EfFCh34uszSB75KQuGtrGEa33lK73JaWUkByVKFhA0NP9GjJaCBI7Qo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoS8NGLHq1jHp9ZcS9XpD6qqID8WHxQ4PJBZLloD-y5A&oe=6ABD2DD6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsZvxqaywPgQ7kNvwEIl7-f&_nc_oc=AdqlDtnbtgPtaEV17-mjAtUE5RDIGNBZ-OI-xMxj0fJs205m898c6CVigmyYMcXfBdU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIj8lQT_1djBU0_G9mWJzCs-kTgeSZF_RLURkkBkyCuxg&oe=6ABD2E20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORCmTVX_vCIQ7kNvwGw2d9C&_nc_oc=Adr_tGqSCRmKkTHmof0RkQHCTipezb9-VpVh_q2HQgJCJCwW96uVVsJBlqK_gOeGagI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKN3YnzGBVx15mebPcj_bnOiTDi2wzF0YDBOaSi8IBM1A&oe=6ABD2D71"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
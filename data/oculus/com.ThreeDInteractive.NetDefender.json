8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OyJS1XtsYOsQ7kNvwFefYx3&_nc_oc=AdreiAVpGu6Zgv9b0ey1JcYvhQAvyB4gKhb4z5r-cXOyvtmGjA2f1jU_2Sj-y4RP33w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPy2Ke_1Dxsqe7fBoCuzvhbXZTMjg1FaKRbOrTP-ym6-g&oe=6ACBBED5"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9Ao-S52zwwQ7kNvwEP8lrm&_nc_oc=AdpfdlB1kluBjaFJ5my8C64BCx3TLKDEuT9_ohUMc9ZKhENXpJF7dvR_QtDNK6IPDMA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5WNeY0Zuvj8wfXeJzf3EyM6EeQazjnC60SUl0fKiG1g&oe=6ACBB4E8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xt1QowgYCxcQ7kNvwHuckKp&_nc_oc=AdrRAhhgUp3mJ7puHl0n_KkBuh91Ym1x7AfI380VZNlcI3zlhPPCgNQT3moKeUy4fUw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNk7MU4w6_HBODsBy-ZdazQpMujY2APgxP03PE1j8aJ-A&oe=6ACBAE56"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgWvNt_5AyoQ7kNvwERu8hp&_nc_oc=AdpE77kXKGwFkcA7tnk92lkiJy-p-wnJJQdGIUPCW08qyCJLv5BjYUk2kTjSVZCbRk4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPh0HyCqiNUoeZcWxtNZ3bxsQmkDj1wiG8ovQUYryripw&oe=6ACBAEA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaBUEeQLERoQ7kNvwFPh08g&_nc_oc=AdpUOz819xiuKcZX3dVIpiApRp-UV4ifA2qp3HwTO34RnI53YNUp8yReSEc0Hd2nlb4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhubDTeTEQOUa9vAjbX2eiUUVNsW_OjMfUKPnwKyiJFg&oe=6ACBADF1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5BzFcEjAewQ7kNvwGbxQeA&_nc_oc=AdqlRGqdKe6Fwtv6O0Vb4w7ziwGgX_FqXCX8psB35NKxqXVrS2OFwbI8LOHRrwg4oFM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89ItvXtYkR2PniaMrpwoBMbfRimab8o4lBPLtfByCmKg&oe=6A3816D5"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0_MYVSnBtUQ7kNvwGOGsGI&_nc_oc=AdrJkuQeOxXf9nh-f14ImUC-5NBeuKkAu5V5i24WfcrHfwrPbuFiobpUZNuET0XOsaE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pa4cimkrN6KhQz2im1cHHYleqtne-f22DFClqLyfFrg&oe=6A380CE8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67TYJV_21BAQ7kNvwEYM3df&_nc_oc=AdpbmDA7uhjTNXigsCNnQpAiQ0wXibrDWtyBI2p9oeSJaNU7GuvtcPU19w1o_xctBfk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8glUU_XMtgsnRNG9cXWT9au1q1QEMuIQJN_CyVsBCYuQ&oe=6A380656"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TN35Fwr4jg8Q7kNvwGRnsQ_&_nc_oc=Adrs88e7loe1bY2C-xxpS9TW_8iAGCXzBKbs4j3-rQBVl714Abrq2Rgp1gOc_7Dvr-w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ET9wGfVbLEN25AMrGj8NNqmw7B87lbcr5OReMqdJvog&oe=6A3806A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R33VLf0fRDEQ7kNvwH_EBJ1&_nc_oc=AdrgPYEyFHFzueo-LcuIaUDzNq0JtWxaslMI-mPZ3P5WJh0-pJPx8pqWkhjEKeQ-TBc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uGwPIbXwCVcTqriqRvC9gGHBm_BOuB4y_aoRrzIvSlg&oe=6A3805F1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
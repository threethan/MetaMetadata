8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlxrTWZj-jUQ7kNvwESuJ-b&_nc_oc=AdrOSL7HlcgO9qfifK3yFCs5e71a4lh4jLPtfJromqkEl_zHii_ccSzMXVJ7iaa0l0U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpt1jToUjyNiWcUsLClh1_w8erH1vBDTrpJ-8gAOsrjw&oe=6AE09E95"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1Ob4b-emyMQ7kNvwG_tzyr&_nc_oc=Adq0Kfck_-PIZjrvl3aDUWJ6wP2WPiOh8LdBY0bW8rMlmgOdFtl_JgmwXGHlwiH28yg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOapBHq5oy9-XRqQk82rMAq-0ynyM2x2jc6oyGXHBD1WA&oe=6AE094A8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plm3YWAPnkoQ7kNvwHxzBmz&_nc_oc=AdrtHVTCfGF4tItM6dv_lQD-jMMUIoxS9D7fixTziLc1UZFMIOdUsYe_J9ylg41a3p4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAUph-6zt_Uu3eWZOrm7f5Kjk5WFOon8wd24BPR3qOoA&oe=6AE0C656"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olx88R8Gtc4Q7kNvwHVZzuy&_nc_oc=AdoSa77H0yzlxOjUbOL44-4xbiDqACviSWHuyIGNKMspXp4mi_oHujkocoVewrOTRbI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNneZF8Rqaigacx2zh3VRIYnaRMMzuFdPsHQHflC9FIow&oe=6AE0C6A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HREZxGuby6IQ7kNvwFW6Zg-&_nc_oc=AdqzOjlBRG267umU4nKM41GfAzzm5vIcg_39E-vYMdgrXq64HLiDmxMxqh_3X0yM30U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBJfM8DWZ-JMnXjJsCuSRV5_M6qwiH5Gt8tT-n0AxxUA&oe=6AE0C5F1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
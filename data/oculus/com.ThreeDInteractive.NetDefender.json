22007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9R-yTjpGTWAQ7kNvwFVr_b2&_nc_oc=AdoJZak-hIcJLWNi5HdFNtV9xxauA94eNv3S9vW6CyPoYH_YVrk0h2DLjON16-3XXHc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBntajWanNQGh7B4iTSrhUYhU7_deVrDFOFml2cghiWtw&oe=6A6F2D16"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQdWQYSKcaUQ7kNvwHcw0zT&_nc_oc=AdoSSIRYzjuagfTs-6IJ0gDetq9XDLcVRqx7HeoBVFstoRivwx6uCOYNFoNZNDPSDbg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDm631223JspMSyAMOn1KwnPq8idFnCQy2azbzsK6tWOg&oe=6A6F2D60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uO01f-f9V5UQ7kNvwFu9R07&_nc_oc=AdpBGLYu_l5DKJ7SvWlgDqA7J5hTDZcOiVhEdKJQY65FZvnFJ7KJkcBvWWp4Z3qBdMY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAelxNA8eD9qBGqno9Dy4k7ZxVcCFYe1qfyTfr7-2jfAQ&oe=6A6F2CB1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of 
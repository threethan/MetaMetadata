8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OyJS1XtsYOsQ7kNvwFphl23&_nc_oc=AdocQ2w33dfMnRpgdxzCbAJM_OQYcXRZOvBH_3_D21WZhbl6imZrjgk9Q98ppG3vCzI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMG81rgORuVZDCsM2FktizXb3Bu7gmoBkfLxOcAhmCfg&oe=6ACE61D5"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9Ao-S52zwwQ7kNvwGO0wFC&_nc_oc=AdoGj0jkUADXcSoeDwzQqwqNtZ7qaixKIe2sEeVbVQQ3XOzRAuC-vBrIYaabtCd1JFI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOn7RR0CyngbQzUWzh6CbV09reIZjEghBC1y3_pNlD65A&oe=6ACE57E8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xt1QowgYCxcQ7kNvwHd9lnW&_nc_oc=AdrI_A2-LB3X9ohWNbDG6qeKfRG8mYu6rUCWIfIaEu4q4eOo8PEmaVKol6iDm2ssULo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUeqxAi4174C0R57dxoP_qXoiSppfVH0ty7yI5_Am1DA&oe=6ACE5156"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFL7sQJGMZoQ7kNvwGggpBO&_nc_oc=AdpIKK7S7Syl8YChOuL6hNWHtCjCLsDhKQH5qyukxLhe2uUWRS1MyVWk4qN7HkhFuaI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-6aDRQeoLVPSb-TZlH-cHJymUYoZ9ydmXjZQI_RN08g&oe=6ACE51A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8ppm-0ZqEYQ7kNvwEiPc68&_nc_oc=AdpsjkTGFBZEyoWPWHgCOnMBoUihcrA3M2rc81m4cSrPcRQXitCW8AhdVWCTSUrz5xU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwuCltbm3kf0kkNfYcTTCl6mmTUx9S7IzH4uT0Ovor4Q&oe=6ACE50F1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
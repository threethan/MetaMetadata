5tk9vB0Q7kNvwFKZjGs&_nc_oc=AdkKuI_1aj4XAW32j4zGcutcP8BRQv3jNyZDpFF3VkhsWV_4iL-7BmMXb_5ogmlumHI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDkYIX9GW0tjmqnPUX3cjNhP3qFNUzGSbiiQLf_OHmEg&oe=69AD6096"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ar6j02-r5soQ7kNvwG-Q0nA&_nc_oc=AdliEkCCMR5fnxnPCVakIcLiAojNBc2_j3BUcUgIamvpTSx5i0WoPdy_u1olJHnXrxM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyImTc1_yuY-wMmNyVai1XgoEUGOd2Ldd9qWyvz5SAptg&oe=69AD60E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAOGprUrCDEQ7kNvwEuaIXH&_nc_oc=AdmL1P986K7IDzMQ5e5VEAfqwmRchgxrz5fz6ZSROZhl88dMo82w-XjIeSwftbbG4Es&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7k00PCGgJuU5v4DBMr9hYs_KzzXHskYtZgJqKumFTgQ&oe=69AD6031"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privac
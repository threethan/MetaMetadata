8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlxrTWZj-jUQ7kNvwHoW-_7&_nc_oc=Ado3ReeoYY8iwqv3V6c5Y2-BVf6Fi944ITIh6kJT65kYPOdG0Ws3_U0yAx3Svcw5qQs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgqTbqaRoMi8qIv-An-mCIg3oTWMY6S0WBy50Aw9fcOQ&oe=6ADF4D15"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1Ob4b-emyMQ7kNvwHjMUrk&_nc_oc=AdpTOH6t2O3dNNg4P3XS2RnaWTvNH7v0B5FDhsoMCuNoCxhNw3BMS70DKxx6AOd0PXY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQQKFjkXJbGa77Bv5po5JGTMtp9IH8eXAweSWOJEPiKA&oe=6ADF7B68"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moVCPokkcIkQ7kNvwFDxbph&_nc_oc=Adrj3vV8ElQj9Dd5Cywr-lc1nIS8FiYznxwYs1jDztdhMevCb7Ye8-wH2o8xhMz8HAM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8Ip1SaaqguhlnIRqy9FNaGak1g0AQG_vpoBABRWT17g&oe=6ADF74D6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqHGIMtGlxkQ7kNvwGsyZN0&_nc_oc=AdrP6M9UycHBTezOMGeT4X6rJhV_1QUJ_g2xWghLApUPqVposLj5KiX4Id4SJb52zhI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpEYiRmfw70U4Ift_3lJxQZI88OLj5sQuh7fRHvArGzw&oe=6ADF7520"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTJtlj8THWkQ7kNvwGH5DVx&_nc_oc=AdoYsOe1DKt_7YcgTSSlnv8J4CFUwcALk9BMZoRIdkTZC7ZrCNmMvNwTmgk2VWF6CHg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhfPHo1AIA98DXz12gpV9WGDOnD4fVUiESn6mRlD8Lag&oe=6ADF7471"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
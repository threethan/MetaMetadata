8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVQS9jxeVtUQ7kNvwG0-N4-&_nc_oc=AdpFhKl5CUTxDyzIhKRvLH4F0TvHjXjgLCiTcYPNwt5cxvFP3sC8gVE-ZldUxnts5U4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uEHTDEpEtVu8cW-kTEePOikWIrcqtl9T4DFNY1G57ow&oe=69E4D015"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRNYGVZ2wb8Q7kNvwFlCfB8&_nc_oc=AdrzvRM7k6d8IU-0fsMe2VDWnWRj8nXD-61Yg4SJajEhJo5QvR1LnStzTM7UHGojVZY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sb0hKED607d8jfbJyysbttJjrwNlCfX5O8pf8EeTPdA&oe=69E4C628"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UmtqPSeOrUQ7kNvwG-QISA&_nc_oc=AdoWsW-eVHu3mgzLHQAsRZI7SUzMyE5rmUBKF3RBbw9CclIuMoTuaUZdgAaXpS6rtuc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XSLoFH7_VXNeLAm6Nhcnr7F6rQdvyV97iZEOmw2nnMw&oe=69E4BF96"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BdT9kt0il0AQ7kNvwHYoaRv&_nc_oc=Adr4bbfmd3fdncurcYXB-UbsB9pFUQsYrR1Jk1XpzGlukuLCQHo9yukIxLrzAfaf4wc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af227kVGWd6W-OMFnjF71KFtVt1A2e-IvdfQIJ7PYKW7cQ&oe=69E4BFE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cydAo5xFnCkQ7kNvwF9OiNT&_nc_oc=AdqZ1ilCqJQIss4XK00LvyRmROCLT0-YEdEwp-z5iNBu9bz_Ahgr4Ci4k5W6VcN1es8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kKPzAEnoT0uWivTHDsquZbiuYZ69VjmACmrODHI3AKg&oe=69E4BF31"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
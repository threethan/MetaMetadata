8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBgNDg6GaS4Q7kNvwFMplw_&_nc_oc=AdogmuFP9ZaLD695X87V80loJecST_JxnD3EpVLYu9ST0ih1Ed83YOSWSsD6DF2gx_M&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcfLgxXHk00U3OHX5bCgDBvduXwK9-H8TGh1R5mwXWzQ&oe=6A58D415"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4UAS-i8CFb8Q7kNvwHiVZVv&_nc_oc=AdrnRbpuHMl6UZa7gQPg1JaOC5g68SGmnm54uhKrMqd_b9p7FSNz3mR-yZrS1SHd3Eo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSg0aeJRtuPoOBG4W2PG5n8OBtMjIlRqt3nXutaqsQ0Q&oe=6A58CA28"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJMLBZ4X_GsQ7kNvwHB0hPE&_nc_oc=Adp_nyc69qEBa7jh8RfQMwotA2gSZi4hj7si6Iz2ri1jb9AFlY6r43r_ce7BUq-Pg_k&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFgKIbEqCKRDAVfZraZwdk0ab2awsfqENUxI4tW79NaA&oe=6A58C396"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DO9FUea14w8Q7kNvwHV7U9o&_nc_oc=Adp0PT8CZy8B6OFjMrZpaeb-dr66v_CzWOrD65xi-MNBuTj9FeF8LhblbXAoufMkJWI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEQxFfd-whbTNPj1--2BdpZOo9uOwpdLYk0vH-t3yhqA&oe=6A58C3E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpwX_cM-FL8Q7kNvwHSjfHB&_nc_oc=AdodxfKlOHWKqradFU8Q5BMr_hDdY8BMH4AsZVdsFIBlzXurzWer9Ufim9N4Rq0d5Hc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCImpA7HkL-SWf7Z06uxmdZ-JyJhSql9U-bXQ4KgSqKag&oe=6A58C331"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
=1-7&_nc_sid=6e7a0a&_nc_ohc=Ogo55Ml5yI0Q7kNvwHRlTLr&_nc_oc=AdkknxbmP9coSp9tIjW--HvKfvu_iaD3emKxZfdwR1VJF21tzVx14m092XnavfwNsnQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzFyFwnBHSox9XSs68cMXuWTnmBE5UaepL0OLUeHi2bYQ&oe=69B01415"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-y2G-KcfLEQ7kNvwEjsn_m&_nc_oc=AdmaYULhnLEigKa1cMMJsUC-LS6EuGKw-k_9Zl1kI0QgYVlzHhW2QVE2_XUq3cAe_ik&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUlRmgx7PI714Me7Afn56CNABLInZnn4tZRoB5flOHTw&oe=69B00A28"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3_QxqoNX3MQ7kNvwHswRM1&_nc_oc=AdlvwgeZg7B2ZQmtQYMoRVViuxHKIYpwRNCi_T6D7zktGGWzjS3L2uEFSKyctf4XGhM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0c4iAletZKzwVPw4xUZTQdZrJo86b8RLoj0w5OH9bqA&oe=69B00396"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9RPIEgff44Q7kNvwFTGJ7H&_nc_oc=AdlAF9BXop3pJUUFdtdIO-KPQEk2iDipbOQ4xd_-JZh9AIX7tdghJjzQiBxn0pbRnnI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxE4MNI_3-9iI-sA_TqOUphUozctKMc5R485_1qCBRwYA&oe=69B003E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rgub2Z__OMYQ7kNvwG2-qNC&_nc_oc=AdnuDr2u4avEfVhrEM1AvOVvMeW9LFwG6bITdwLTpT4dOLLE9qtSP6AHyTY5yH-FfWc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxU_dmHQD3Xwyf4HhmQuTp1HSQTw0Kfmfhazlt-21ExXA&oe=69B00331"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.
8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Gvmmq_DGhAQ7kNvwG_D1BT&_nc_oc=AdqVKYK_JraC9oDIBu-Bgdt5K34dEcnxgqoidr3tl-Ua3sH0DXzvpbKsCjHjmtU7xBE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3OiCnN0n7j_v16aQ-8XxfOndgQJww0zC0NEyK8peiLKQ&oe=69F74515"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuE9EFZA76MQ7kNvwG1ow30&_nc_oc=AdognZX9kA5PztPtvsa5R8i04E7G8e4KSrv_AR5AfOVfsogC3GyOgMeIxNxufPjVn80&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Q5wG7AjQL_DVWZo6p5Z-P1wk-kuOkXrMTBgdKX1HHew&oe=69F73B28"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFJLFFh43vAQ7kNvwFlM9t8&_nc_oc=AdqP_3QRwQ5Y0NHpUzc3LGlGfC7EuD_h54VOjXC2JV7sDGFlDRiPxRmh5rvK3UdKCTQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0O6YH4kvFj5KeLzEzQvMNDmtzYIn5CUCGRio8snGsEYQ&oe=69F73496"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_QhEaHw91cQ7kNvwEUuAiA&_nc_oc=AdovcuCABjSqERF4rHs7FGpK_tiDSKsTwJXyJInPxvLHs0cUq73x0O045gMasnFFY_0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2o4FKwMhqRFF-OvFYcDJtoHf_jL-q12jxVP8gsVjaqwg&oe=69F734E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8U_btoe9VrYQ7kNvwGUTwMp&_nc_oc=AdqMJ2xyQpGOBGU_gHeCNuPgcwFJe3TZmTkHLPuOl3w9-RPy_MR-qUaJRq846vvRJaE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0-7t8WUlVaiUP9KMXxv2i2SiJPWwfQNGV0lb3F65X9Pg&oe=69F73431"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
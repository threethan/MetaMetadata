8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WqhrzKF11cEQ7kNvwHe1ci8&_nc_oc=Ado0w4TB7iSgw3MUKRAH42HKejEFgAhSAy4PsLei100wE-HxbQgDGUVQ5uxM3gQ9pKw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP76kGSQ4nWKcpr2VhvyiX0sr_fHrqJ3yhoExXJEnVCnw&oe=6ADCAA15"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-r1D3j8BEUQ7kNvwGejgd7&_nc_oc=AdrL-6DZ0sI1nZ9YH79ZoZBDofpmWy-m9vkz7Yna8LuFvgNrAPq-SLqKjTExTCdRlxU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJ7SIFKGdTfNaYrhaVwFYdieEI1-EetIvz-7V_nCSP-A&oe=6ADCD868"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moVCPokkcIkQ7kNvwHgZM8M&_nc_oc=Adoh3NU0aYJbTAvoK8_yHV0cEz1HWDc9p-xAmaqfPiz8hvL9TjZ6IxFRQVKhYCV3rGk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCEaTZFdt6gTotLBHgkGN_Ug5q1GtnvTJq8GEFiW9Cqw&oe=6ADCD1D6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqHGIMtGlxkQ7kNvwFiDGiY&_nc_oc=AdqIiw5Z17RjK-9Jx6Nt2xS3Ea59qIgO-KpsxsexcptYQc87r5v5yHbQ-ZyU4D_Arc0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQqy9POf2aRnSZxf7pBv2QAlXVexebN29Y65Olmn8bww&oe=6ADCD220"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTJtlj8THWkQ7kNvwGks4Xe&_nc_oc=AdrzsuiZzHaZ4e7DuTaQphKHKtdmtwqFb-RkebEGUzSdkldLTs2mGZ2kic3yNbhQiY4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkEQr1UnYQ24t_69tNhJsF0f5iQhPNHOtB0irpsLkEHg&oe=6ADCD171"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0Rdy6iGf4YQ7kNvwHAwtLt&_nc_oc=AdqUbKkw9hGESgt_n1SShHEj95VGBxteF2DuOc7MsCqDvMkI1aiMpVvRlI765qwv9Qk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJndZNKCMpMgXhJ4UPhn3CluGHU8Er6GRlu9dWdyUJcAg&oe=6AB7C015"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjyJEGAWxb8Q7kNvwHEvNjo&_nc_oc=AdrfnYtkO9TDa8pUwW10agq6p2GKTtynroZ8OqfTMviSMGajseao2ByRGxMe6RRP55g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRDsLEVUXCiixzqRJfdP3sVmDkackrVvcqg-5bppJDGw&oe=6AB7EE68"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WnYIKmsiuQcQ7kNvwFaxnOP&_nc_oc=AdruEyYP0hsI2nF86_Jg-CARU2y2CnBCEMivGO8NasWrDdJzzHMdMkhM8CSML_zzp9k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaPKQKXnJXf99jb9sYUc7FhKSi3thIyjhTrRHGvyWDhg&oe=6AB7E7D6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMgTlU3LWpUQ7kNvwHPw0kl&_nc_oc=AdpqpK5wrypdUMOfFoohDgn5Tc2lws-OWoYSt6S3owHKBCGBgnH-WNt5BMJsIksM2Og&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbkwXZlA6FXNNPYSchzleS7S7CP7T7pfAWS1rQ1EwzZw&oe=6AB7E820"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clqfDL6jwhsQ7kNvwHeeGqU&_nc_oc=Adq6lQVeKetQ8MWcMKE6cjcDLdUlfKiS_Zd95CfLOYYtT0DEViSkdXyYuzNETlBnQ28&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJegz-BWrp1r8o04ckRveJcTUwCuEu_ktgEc3EDRtyl_g&oe=6AB7E771"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
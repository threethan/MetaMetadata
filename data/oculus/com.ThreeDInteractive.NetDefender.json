8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uO7v2skJOUQ7kNvwH4-L2P&_nc_oc=AdoNozfa-Rf5yrF3i8VQWnihteKlXx3uh6abpIXt0nuaRSvSmfOjVvDua1bOBIQVbmM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFGfj6uFnEEJAT8s0p3G6n1m-x0BXVJWv0avbhBlfO5g&oe=6AD3A7D5"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rck9neTEC8Q7kNvwGuYHC3&_nc_oc=Adr1u7zeNNNy0ee-_RysnZjB_6_UO6pDEJloPseWdd39YnJYmx8FkwY2LcWsXCI63oo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONY881qgRcvzk8iG0JF-iGxH1UX1bGzgrLsd6ZYoFpgQ&oe=6AD39DE8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZoYU3VLuI8Q7kNvwFdBN5U&_nc_oc=AdrW20S9W2VJO9lRs2ewaS7sa6hi03QC6DzYhbpjS5PJrEP5TCl1TQkl0h-TOQPfhG0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiST8XNeexSSFqeuM_0BG7hXL7FwVhCQu_Ffed0ob6FA&oe=6AD39756"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dg7gMsJLDuUQ7kNvwEPWHjv&_nc_oc=Adp8QX-KZkAS79Ke24Ep_BiX9rnZdfNZ2bn4Vkue_Y_czo2rjbBCrzunLEwazniX7gw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPz3lMYpMep8vGiA5noiiBdq1XM97uXEeS7BuJgRk88_w&oe=6AD397A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdowJLPQ4WUQ7kNvwEIclhG&_nc_oc=Adoo12x79jyard6G3_acQHjJm3Ks1LRZGZJbN67tKbFHAwG8alEbUlx0j1iXg8CVzcc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEW6tiJuuu8D-1ZxTPhGdU0_Wx8tJ6szB3poBmIbERaw&oe=6AD396F1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
5tk9vB0Q7kNvwEWjYpj&_nc_oc=AdmGgE9ke1yTWy0s4lZTZtWkV9Kp_bhS7L2r8ENAE-tiaHb9fcwGh5SvrdWQMme8CQQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6XB23f_gxUPyjwsskreOcNu24CkOXnoIgVnGq1r-XkQ&oe=69AEB216"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ar6j02-r5soQ7kNvwHmPv9f&_nc_oc=AdlA2tk0CsxiX8yvH7Axzb8NLrlLkZn8tfxLJPvk5waB0AUZyzFdXaBlnOyCxSX3yH0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwq-2KrnQhSdpeJYBH1Zf0L9eLhxYxoeNweJdv5FghRgw&oe=69AEB260"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAOGprUrCDEQ7kNvwGJsNDF&_nc_oc=AdnqcXk-PoAjTGhf4xiFLbXDcEvRaULjzWMoBbeO3cLyXlyr9dUfzEE-BtdGQI2jk4c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwsNjlobBVqge5UTeK7JRtbKniSA1dSQbeStUF3Z4H_9Q&oe=69AEB1B1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privac
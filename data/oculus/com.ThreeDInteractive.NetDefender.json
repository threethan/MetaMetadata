8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjWzEY3Yx_MQ7kNvwHkaEA0&_nc_oc=AdrES5cqPl3su3mOziyxZQfP8-4oD9RiYqbQO-Eu_U8i6-40fJO-N7E8uhctbYiAub8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySRq_h4lAGIIYqNRyxgrqikCb12G8Ivpgs0idmK6xsBw&oe=69CBC395"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VcRgzons-jMQ7kNvwH3ezee&_nc_oc=Ado2wqAXgIxoyjV0sinScH_yY0flxIQQJ286RGmBucK50WVxszTittKSyCnIjZBpleU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afydqi1obkf_ZVrGMjcrpmbxgg6ePv--r2T6vdoB_l76uw&oe=69CBB9A8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-XFOk9-pWoQ7kNvwFzHt_e&_nc_oc=AdofuqGkg-x--fuZbzP2eHgsjg3m1Plvlc3XQSLK-gVdB9BKkp-iQf6qDW9ULsVWwE8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyr-S7O535UFID1VAI5auUz2uWn5NTRjnWmP7KtV9GWRA&oe=69CBB316"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wo0dGcnzJWwQ7kNvwEHtgYg&_nc_oc=Adq6O8e-SRfB9SOELa5exb7HV1AnuWKPCnqooqCZl-N9ohrWdghC7sOrPh0bbh5GALc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHKW1Vo7C_HKXsSCxwlaDIdUJPnLX_RnPmgB8AMfqfBg&oe=69CBB360"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u49I6LT8UWoQ7kNvwFF8h2f&_nc_oc=AdoTOG4IAN5MQ_sJXzySMyf7pJW8HqnAmoeXcTg6vpMbSujrqsP3m5j7gSOISW4rpzI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7GDy0K2te7EycH8HnLvV08t6AdM411WmHOAG2HPQ8ew&oe=69CBB2B1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
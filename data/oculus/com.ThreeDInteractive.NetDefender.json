8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wMazEiGyHU8Q7kNvwHsIASp&_nc_oc=AdrCrfhYWjBFIifD9Ad7pzhFZAhA0oM2RsJewIUjOZW4V3rbFS7RyaOyLUIHOTbi5TU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwYM4lMVCQD8Nhp1maLb0B1P5f0FjmEKjPuxtBRnuid_w&oe=69C67D95"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTvPQtxp1t8Q7kNvwF3sSyp&_nc_oc=AdrAoZHPEEScMkJd6XP0gG9oW5Vut5Ry4QuoqYDMkJt0lFtuVdIX04Q32bK0jtEuCw4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxXq_91FSrRUuwtMDbqXbdJK96NYyULfw53Rw7_mecxqA&oe=69C673A8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0qiNPYL8sgQ7kNvwE_YPJv&_nc_oc=Adq1cYzNPdsZO-CsdJxpjrjtiiXMzVkdthbcb7zamMJtRgclae-YVaYKfhSJq7cX5w8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwUpzRsH2Vrnh4Msl_nghpo_DKwvEngPjsywaLQnVbyqA&oe=69C66D16"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qo1N4rWfEvIQ7kNvwEiPuw-&_nc_oc=AdrIFDF-fdbyOSQ33cW3PxnfWk4elt5M7Bz7P8DvaKnoU3EAGm9Ci0zdHXL1aMLCVJk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzL1BuWMx01ZuDtCyrHoHgdd3GnDGQU1avagHX8OmRZhA&oe=69C66D60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-Y89DdnsHcQ7kNvwERyfaX&_nc_oc=AdoN9SPxuGT5Kl1oRO6K2Q6l9NvIcEWUZQUzMrnkGKwgjKLhzMtoD1vRDI77DpHvKXQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx-GcKccjCLES5NdW9D8fRHJfo41-bSrVkcDe4ISvPmZQ&oe=69C66CB1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQq18DlGQroQ7kNvwHtVifT&_nc_oc=AdoZKOMvDK9304ChLgJvGcHlzj7km12VDWOaQQ1owdTrG4nmv0k3AwGIxirWZ3kV-Mk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af290bKK0V4uyFKKpNjdy2CpcwDXKdAqVhdy0KaiGzcYlw&oe=69EA1615"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uztierorN7UQ7kNvwHgE6t_&_nc_oc=Ado5sVwCy3OYp_9i_GpD2aus5ckK1anzDh4cXYNE0OGWmw5kdky4ge8uPKOj39G_L2A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3iSML5S2TIBYoNc941aJ7RfmoF3POtmtlpOAUNAoiBtQ&oe=69EA0C28"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2uK4lws8RUQ7kNvwGdYKlp&_nc_oc=Adphj7nZ3aaFmreqhFJBz2BcS3MYIcxbR-ycQ6TE-fhUU5JIlxWpa9OWH7GnmyEkJh0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pXe1xH1j_1oCKi8jVNqP2WlbjM8ekTtvqKqSrB-UEhg&oe=69EA0596"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMsCYcEkDy4Q7kNvwHMMZwz&_nc_oc=Adp_LSuQ1vhOH75ubnVAVdytMuuZF6UYwyKwdo3VU7Dq2ocNtQG3O_k7oYrduUru73k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07dPd6e0N1XlcX3jM161Zxw-yLLf8Gm6sQEzclnGbzMQ&oe=69EA05E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DT-IiIx_l98Q7kNvwEJ6SA6&_nc_oc=AdqsfKugMN3YSGVIC6DuoEDOfoepCryvpbmfcFsCj1HT8ktGv85zItaiiBVUcIk7IEg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CVaH3zGAN7AsdvPV88nM0sAHxM-zSK7z6y5jsbDXe0g&oe=69EA0531"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
22007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ON2WPxmIRwMQ7kNvwHvqCGm&_nc_oc=AdoWE7xK2_o1ovZ6Yo3bNpiRCzpSC5gx572WmCRWHn8gX0mDRYH8pYXfqYTbKYJFApw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnzdGT5eXIzz0mTIfkYUhI1cq0EEiNOrKZ1R9JLIWa2w&oe=6A5B6696"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VA7dg6sBpMQQ7kNvwGxcla9&_nc_oc=AdomyeanYb9QWvgWkAd99XqwQ_YMCv7nJ3fTU3cqkbBSp0GJ7Dxro9DgVhGitjBr8GA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrWdOVeXWf2C9aFDnH12JasT3cJkFdxoAxoq6Ay3jXag&oe=6A5B66E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KP_mwKMyxsoQ7kNvwFrcIE4&_nc_oc=AdoqP_JVJliYKRXDA2ZbhQD3p_n_x5CcP-qPnzXRfbyqzKI5Eg1wvpksL9aIQLNlu70&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDklZpj5a38uE8DxGvMg_nb14NGLE9K2okpM8bgc177Gg&oe=6A5B6631"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of 
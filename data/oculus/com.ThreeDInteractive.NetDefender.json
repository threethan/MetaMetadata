=1-7&_nc_sid=6e7a0a&_nc_ohc=Ogo55Ml5yI0Q7kNvwGIU1xN&_nc_oc=AdnvEdzPO1kqXpI5jlZUSXtWLR0jOGjla2T68DyzHNBtx8YZ42l-zBhOwvhNqmP7YaM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzbZ2qZKvE69C4CR76Yqtvzg8iIdqMK-GR4O8fMHqS4wA&oe=69AEC295"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-y2G-KcfLEQ7kNvwEDAzf2&_nc_oc=AdnW-EPlU1q035Wr8OKUM7VobrE1j65v0SjySJZh4AH6uyCWmi3sTGwuIq0YhUbsnRc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxyxXK_eQaKk0onUfXrm3YYMP8m66_sKKcbExEf1C3J_w&oe=69AEB8A8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJqc5tk9vB0Q7kNvwEWjYpj&_nc_oc=AdmGgE9ke1yTWy0s4lZTZtWkV9Kp_bhS7L2r8ENAE-tiaHb9fcwGh5SvrdWQMme8CQQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6XB23f_gxUPyjwsskreOcNu24CkOXnoIgVnGq1r-XkQ&oe=69AEB216"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ar6j02-r5soQ7kNvwHmPv9f&_nc_oc=AdlA2tk0CsxiX8yvH7Axzb8NLrlLkZn8tfxLJPvk5waB0AUZyzFdXaBlnOyCxSX3yH0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwq-2KrnQhSdpeJYBH1Zf0L9eLhxYxoeNweJdv5FghRgw&oe=69AEB260"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAOGprUrCDEQ7kNvwGJsNDF&_nc_oc=AdnqcXk-PoAjTGhf4xiFLbXDcEvRaULjzWMoBbeO3cLyXlyr9dUfzEE-BtdGQI2jk4c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwsNjlobBVqge5UTeK7JRtbKniSA1dSQbeStUF3Z4H_9Q&oe=69AEB1B1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.
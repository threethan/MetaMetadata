8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GgQX9lLVGc4Q7kNvwEd5dWn&_nc_oc=AdpFAdtXfBWeGNWQs6TFTM2BrGCrZ5Y5C1g13sZpdi16oeeLKQwZWQ2nNZF8AXtvLA8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fTDmflTjVoCJwlikiisjObrd34Z1q-ykos7iNMBU9Uw&oe=6A411915"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIguZoFqtK4Q7kNvwE0u-yC&_nc_oc=AdopGMaOHYd85ybs8WbIgHS4lbHdS5L5JhQmgdBn_qzaP2x-zpcRgQQmOPWFmXwaorA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dh_TdZFzLMlc4XaJ3o-pJzt04lg_h-HrcQnNB_da-Ew&oe=6A414768"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oc3ku7F0lZMQ7kNvwFbpWZm&_nc_oc=Adr85YbySSPnF08_-kcYuOomHRhWj4s7IVgEbPnZ6Y9L-zhx63_xck2cJJ4B62AWZwQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86QFd0WGGAoPdZTccHomHeX41_HRoN7n2QPlRcIShlyg&oe=6A4140D6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1E2GV01axQQ7kNvwEYA9y0&_nc_oc=AdpErMNJzyJnhlxvIieZgZUKdnxCJYu1L5Y5A94PPzl8sdaIdAYmu2IFtsmgcwRpIXs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jqgkYw9sUQ9ZKPeAGyLsmLXgbUNj2Kev9u5PKZ9GDtw&oe=6A414120"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFsdt2wNt_gQ7kNvwFrYChT&_nc_oc=AdoS-ar6xHwT7b6x9QO66URMKm7u--Xrlr0YmQ1p4uZyZXWUmj2QK4WHG8VyEaHou58&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ukQC9e6amSKQ18-5ZUI7g9ut--KDoNs4srPIXNQRg8g&oe=6A414071"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8oPEz52J3MQ7kNvwHCOJrB&_nc_oc=AdpgjImnr95QkwrfSFtPDh0izTpRaK5TnnvN8-k2OWZwA1rEmdVagVz3tm6KttrbGfI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PoQ122jvjOBAsf3ahcZJcVBsTFxgcUVqrMfbjyItJ0g&oe=6A2D5295"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bifq7kfdOKAQ7kNvwE7BO39&_nc_oc=AdrL2Ku41SayFTSKoM3dkWlCsaehfPBsYY9oitx78bSPnQjfaQxGcvJe0QZgkErpWck&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NwUMTqD0Nu6w9RjmmwcIJqhUhtKmOslTWuJDfk1YuXA&oe=6A2D48A8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DKjeDUn8IMQ7kNvwGLpnuU&_nc_oc=AdrFImHUVaXkNyYMG04gd9L9cEGjgrPfjfrf4Rct5wsfzBKBD8NS6jagyynbq1vBHug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--R380-KJVhODJ2EAQltYkXZSGwxKpCA7guMLJnJ-EyA&oe=6A2D7A56"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQB-XrsyPz4Q7kNvwED8Cwa&_nc_oc=AdoyxVmG3_JCdvbAJXHxhPYvPpOvqsbwP0YwYQB-ZEROT9a6Qe5xLJ1L2yVoY3_MCbQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xzUWdQv-BcEms-68bUmTEdt9LA4OGAOU11eqhRHEZgw&oe=6A2D7AA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNo2xrUAjXEQ7kNvwEWZxSv&_nc_oc=Ado5hbsCNOOe9nAsj-4Y1J-c02ki2Z0Xw01sVZSyDhj2wMtRJynldmAYJAM7OmUPUyc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oVLWNsJP_3d2DNk34_v3kDiqtKLmcEBn7oUuAtS0flQ&oe=6A2D79F1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
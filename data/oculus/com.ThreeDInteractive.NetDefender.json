2GVj6IYQ7kNvwFJ_5dF&_nc_oc=AdkKa95YQm7fo3o9TO2goE-khAttsKbzX3p5MiRzOqus_-SDy_YjUFhk-QzAJUovvbo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzoh5fpFXI46sAy02WPBFpjcrhW3x_jJeshRuZATXC5UQ&oe=69B54996"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHJKief7zF0Q7kNvwF17HIH&_nc_oc=AdnNfS0dEkd8Ka6vWyxV_bYKxsX0dnU652oSjXnzdlJvAFlsd_63wTx0s5wE0kbaFXA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzdq7gCvEE2WXUoLTp95d_nYWLdWVaHtbmSSS6ZIfe10w&oe=69B549E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTDKc02AlUkQ7kNvwG7qtS7&_nc_oc=AdkKsibYxpWJgtQi4MYkVN4tucj9n1TOiXnuMqw0JnKZN6mEHN1LiL3cFWC8AbsB-jQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyhbb5Y4SCE19e0juuDzStpNGOxDxrVil4Gj3UUFwuaYg&oe=69B54931"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privac
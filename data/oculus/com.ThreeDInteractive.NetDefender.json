22007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPBiPV58Je0Q7kNvwG9GsnP&_nc_oc=AdpakFtJ1N3cBt6aFxGe8oLNGvSaA6R4yUiTqXQwVmzHrSLwaQMXSHifn_Tuws1Xy1U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DP_7uePu06woBHA8s6fJDl9W9_e_xZ1C0fKDds-KvGw&oe=6A301D56"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lP7nnOKDIY8Q7kNvwHKS59c&_nc_oc=Adrbca0IzOkGD715DnQ4Iyv_5_nAqdYoRchi-1S7UvPQp98bVlRVozKq2N3Z4wykn_o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94l8mgBpl6iKXIG5sAeG2a4MI9F1PgQMpYZ82uBcqqDQ&oe=6A301DA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVkjsQjJj8AQ7kNvwG9FRFh&_nc_oc=AdomYiUn8Y09Eg30LCBOP2lqni21BaC4oBtF8k0QUf6ubEK7YiNDgr81w40ECDf1UR8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8r7PCXGFKPN0UMXzLKwLKwS5TJkkmjUw3ga8AhQqsIbA&oe=6A301CF1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of 
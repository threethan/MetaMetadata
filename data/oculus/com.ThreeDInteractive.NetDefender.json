8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltR49etg_usQ7kNvwE-Ocmv&_nc_oc=Ado7E30iNHoXLKgUhxePRwks-HCuDRhQW1m4-5GB8kMiI5PaODPchEy97UjN_EckgrM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdMwbBgVKRrwpNLL81NqnqbEi1YptcdwnS4m8MjeTBbA&oe=6A4E4815"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKUqy4RwvcgQ7kNvwHIN3lu&_nc_oc=AdoZTBIs4l_pOeXXrcUKnP-J2BKa2UuGVUrtowgdbHyGQ98GOb3Zzqm-WuuqQZVBt_w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-mP52hBM4KXvrUt9mnlKnVMekNTm6qBOHeeUcyfOFOw&oe=6A4E3E28"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xwBUfrqeJwQ7kNvwHO0XaD&_nc_oc=AdpJkKl1ieCsIdqiegJMDM9UPMLIsDyG3R8ObFgW4X_UJLXU-zANixXR8bu4js6Iddk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJL1N2lqbVwqbLbcvJWGCXohUQ7P0fpNOBPolb2ER4gg&oe=6A4E3796"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMd2pdQJ3DsQ7kNvwHfM0ga&_nc_oc=Adq8ktkZVcpi915cbl1hb73kVrA1gV5eHB_fmprnWGHKaj6fzK1orL6TAuQJgcTLHvU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7Rn_1IBfnJXi8WVVPUtkL4Ocud0KV6-X35ReVrd3MMA&oe=6A4E37E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uy5lXx2H1H4Q7kNvwHBntRm&_nc_oc=AdqusliWeU34ZBm3KOwDJ6miZinaQb2eQD6Lk7E8sJl_EhP5YsWQ-oISwl7GksTuqgM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgwYZoJ5Uhsp94AW845YNKxVZtl0atTYotNwtZsE_7HQ&oe=6A4E3731"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
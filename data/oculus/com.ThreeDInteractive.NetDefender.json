8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLvfjd2XoDcQ7kNvwFf89Mj&_nc_oc=AdooR7DQGGCNWYJoJOSqd7Wta2H6QnlEwLAI-G87z-iyObKzjAu_innjDgXg5y3DuqY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTyKd_kBWifJHpHqA7I82evMXHPwaDE3bLtl6nE69cdw&oe=6A563115"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpawtEPXa1IQ7kNvwHWpf5i&_nc_oc=Ado6v4hCsHVUmTdeMqnwMHioPRtkmPtl4Qdpkbh8bcKG9aUz39N6IJ-Wexj6QclqB30&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAR_5AE81JjXGQsT5Wat8FOCQfw7nMctD3rVdFULsE4w&oe=6A562728"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJMLBZ4X_GsQ7kNvwGFWkfm&_nc_oc=AdonTwCgxtnjI_HU5-zgr1kOFHg74oljyqR0SKySJpCB_lfU8pH0a1CFN5vhFBPmPxM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKazC3Ue-LMDojwh3ID-RJw5T2pDdXzZWKFCfWLNneqg&oe=6A5658D6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DO9FUea14w8Q7kNvwFFCdTC&_nc_oc=AdolWWdSZ9l9Ey4cJlCRzJTDdAtxazyHHbYbWPCGzTQX1JP_OUwrUBvBrlFM4g1Yclg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDO8GHMLkZYn05xdMtZ4X3tkiLI6JWhvZktAn2u4nvigw&oe=6A565920"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpwX_cM-FL8Q7kNvwEOSrOM&_nc_oc=AdogpEHl0yGg21yI0ekh5CKKplE0yqc4wXt8A4GTaRfclc6bj9IFqvRaKkoirKhdhHY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLoVLdq4ecCe0UlW5Xl88mRHZz-t9ArzY6K-7mtgG1kQ&oe=6A565871"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
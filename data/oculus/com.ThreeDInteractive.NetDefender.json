aNJJMPcQ7kNvwFWAF0g&_nc_oc=AdnIpx6vRSQ6-ugnWltyUS7gkADM_xT1GeVo8e55vHXja2kA6TsMeCvYx79R_Vx_yhY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxr14N9uFdQM5ofkiLZTINp98jMEBtf4fORiL03whWhNA&oe=69BFD596"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtXuY4K0feYQ7kNvwGP9BpL&_nc_oc=AdlsSbz2Xt_KrsZKPsFZHIvdjQY29ia-2NDmGKRi0qyXY5pBP1qYv-w7SyCO6kTB3oY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwwi_KHFigUS1k12BJK8wsNgZ6Vm6IyiPpJ58nWmo1DSA&oe=69BFD5E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jamzmhpZRMYQ7kNvwEjy-3L&_nc_oc=Adn9RbHLaBQ6yfkUGNP72abRNQx_yxGSiC3LxYQ7KVJYXZwmFTS_IbSSvFHEGingq7U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzGjyTiXvtXwAQ2y0dR8mzMiJkq0_LDoWte_Ik95_bD4w&oe=69BFD531"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privac
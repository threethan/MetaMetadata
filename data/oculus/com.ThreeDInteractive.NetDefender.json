8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOE-bFCHGWkQ7kNvwF0VXcy&_nc_oc=AdrQoprSdE2cTc08qsuzLgWrYspqs2PTQJW431XVgHpyJSEfucigoNAyV70ispBAGbw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7cdDuQbzE27J77CYWPt8kiLo0WDfkUlOLF3DeJC4UMA&oe=6A636015"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Eri08BqO4AQ7kNvwEfuwKr&_nc_oc=AdqGhydAgQf2VlEW2hmOhZgqXfRC_AjrEHXjDNIDyDivHXjVrML2P9aX6U0YKAb9jU4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCikDUQ5rCjoz8V0DluN_IlhhmKU1WcRmTsRBJzvUKFoQ&oe=6A635628"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pyb4oXwTi4oQ7kNvwH7KcKX&_nc_oc=Adry69_3-GPfYfupjygIXBZinj6D0qFFFt_EzZX1hlGcFBfNR8SiEPJ7xeTmmCy7H9c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQbBL0RwfDuvOnSLSajIur7qzYdPTd0yhD6q1iYDRp_g&oe=6A6387D6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTtQIkTZbBQQ7kNvwEOWfsa&_nc_oc=Adq4qGVLWFqDD1Q3OOpF-SN3XzMSCwQ4c-glUjyUEdVl5cziZy0187tdigeucuAif20&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFq9cjGgpQ7-lW_ygIgMDwogPY5Nrk8mW24s7Hsc4xPg&oe=6A638820"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-EDlIv3z5_kQ7kNvwHpgsAw&_nc_oc=AdqYj5EK8fnDYI3qD0JOXjnKZeyo0sEUFccZJCZkkN4Giyjbwi1hLFJzKb-4m7NVTHI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKO5y2zN0OGzZgQezGqu6iSrSLKVgjD6BsM0L2QpuBLg&oe=6A638771"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HeM6kwBRysQ7kNvwEHotbM&_nc_oc=Adp92evcP81pYLOAR0uR_4xdImcfr9tgCXwjAaiY2CkfhPnH3p0oh_LQpQFevGVl_jw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMCrDQOmoGg2Y4DHSAJLIcTborm_n2Xr_c1md-Fa0uzg&oe=6A92D615"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCf6lQ_KIh0Q7kNvwHNIAu3&_nc_oc=Adp5ESEDOXs_152Aq7cbTMd5gZ8EFQOxiX1ybg7Fy_BSx0-YkDM_rKhMyQGiLnvDtsI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzkU-2wfVMkYuIYAwIWkxPNa0hlRyk_ZqAQx_fEjYHEQ&oe=6A92CC28"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9LcbVPGcHMQ7kNvwHPW-nL&_nc_oc=AdqAuPvvfHk3ExqRQrHc7re9Kw4_t6SXv2EoMKMidzK7m7hIPMcxRuf_QrtJyj4IlhY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcswaEVMpo96SULeRk7244u0PDOZXFnJcfMTzoarZuxA&oe=6A92C596"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqCihV8y4WIQ7kNvwHFEDcu&_nc_oc=AdqWxwlyDPSIR5G_lADFOvD85D2jyPE9KyrLBWbMeFew1Ls7L_4G0pU9lOFWpzveG9c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHL4iCP3PKPKiULYud4dc_ufbCPlFtEU7Pg3Bsgi-yeA&oe=6A92C5E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4V8QroCLqIQ7kNvwFktXpB&_nc_oc=AdqMHbo7MvcHiJcmZyNLu6YZ_J2ytKusBM5THSnkzU2WfxwXYHqLrKuD5a7tGRM0fWI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3s2FMH2SwqCUCr8eU0YfmhSQ7LfFWljMXZqUksMTSFg&oe=6A92C531"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
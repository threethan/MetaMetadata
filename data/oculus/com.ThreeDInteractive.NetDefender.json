22007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sthxB4DqrHMQ7kNvwHeIpwc&_nc_oc=Adpl1-u-exoM-zxCuIWTKbwGc3Jg8z2wgxak2-nBHVeXjDonHzwohyn8AQLIGgxel1A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJh7RZqTPeTsHGJPoPC3TjJcI3q2JHWkyDNZWzmmGezOQ&oe=6A999556"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0Qt_Nb3_VAQ7kNvwE6RyXc&_nc_oc=Adqs5V6M_7syvj149XbsXEwLDUO1gOPz8JPjN0BuSXQE4AVUxSRzYcuuRD6zDhOoEw4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrZIm_-c-erSIY5htkg1qNyqUj0lPHF9jfow2nhKk10A&oe=6A9995A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZYqI_QEA6UQ7kNvwFVxAS8&_nc_oc=AdpTKaWk2AiuP95kdYuTr5KrQvvg8bQ9EaS72G_JwG5QP5jflnOo3Cy6pMfcrQYBI9U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8-ZOyNG1iVz9pDzZGlFEQ1HXsAap2ykh6uRUpmSfYvg&oe=6A9994F1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of 
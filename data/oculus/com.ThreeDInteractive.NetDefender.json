content-atl3-2.oculuscdn.com&oh=00_Af3ZzLK_8FymleT5oRfspenLHdu0RxAvRG2_iVmvYy-UzQ&oe=69F1EE96"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ualwaeq33I0Q7kNvwF7iJ1K&_nc_oc=Adp-sq37krjYg_47UWwJBbIbdAXpm2SyDJ_REO2GGeW69EX2zwq7Nz-IQbUKvhZjcSk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0umtu_ZxrQnGSnyd2qWJw_HkYNIWDonAMeUn_PC7wDXw&oe=69F1EEE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-Bls9yk394Q7kNvwEkxeXG&_nc_oc=AdrmW_9wifHh8-W3ehdwkDmhUzQhxmZCnUX5n2Ukrd3B3o6ur2NKZFUYegDN_vLpflI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0skERwMQqNKyp3VqSuAqh8DuJmR8_8-isfTvZo9nOhpg&oe=69F1EE31"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https
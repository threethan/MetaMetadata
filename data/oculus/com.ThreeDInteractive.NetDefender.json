8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1QObcXQAlIQ7kNvwGEVSOp&_nc_oc=AdobWl7Jl02j9Yuv21hhcili1EchcnDkaruNgvnxpuBNbyktHt8xs1H0XKd4Ax66iJk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af565HhQpkTyWP9jNkocEjyF0JCHpBeFME3EmgNGIzA8Xw&oe=69F9E815"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gqDiRy_Rj9MQ7kNvwFvD416&_nc_oc=AdpqPQ9T9cXxugIryj3v72Ok1QnhCILJDnkiGq-5UOqvb2b0i6eMGUUtVuw3XgdawOc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zvqnfkO4-eFWtv8sKsqW6M2u8Bza7_f_t2Sg2dsAQfQ&oe=69F9DE28"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFJLFFh43vAQ7kNvwGkOXci&_nc_oc=AdpfWe-kwPn9HJl_LfqvIB30uoTHGuzLRpkJP_pMItPqgl36pCmJwiucT8kv3X9CZTA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TG9e77ec4VNWm80KMpFAdnEPPLhcHn4Fa1mFm_uwvwg&oe=69FA0FD6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_QhEaHw91cQ7kNvwHu_9cm&_nc_oc=AdoKg6vooygr-WcJW0FVqFr8RHuhiXsobIHCra6yshWJujqkNBw_iIy2XoOqFsQizkA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af536-Q2Y_D6-NikGbMpo8QN2raIoM9gQa6lL4UdopP8Jg&oe=69FA1020"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8U_btoe9VrYQ7kNvwELplov&_nc_oc=AdrdKxGbb91Xsy9zEtLRGeFYIPq4SeKk-gIDR43GzWjkobm_EZNmIyW3emfBKjPRgoA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bqBmVQiWCdneTI-etmyayWi8iCI34ojIRyrU0IuptCg&oe=69FA0F71"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
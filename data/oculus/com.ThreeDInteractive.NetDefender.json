8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rk6sM4bfUHcQ7kNvwHgTRal&_nc_oc=Adqm1x4PmDMCkTfZ0xaKArTLEDbBJQIkWZFU4oEaQruTo8tQv-qWPIQHTXfNmxj8F48&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-RkJ_LQ0F_-KROD7WSt7dEoyexzeZN89CO1rL1DlKOg&oe=69E0DB95"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1jlHkvz59cQ7kNvwEXzLHe&_nc_oc=AdqQBM-mdxmzs1FRCFFeBrACErCYSwvsPzsqJCAvXv_yTdKH0Fkgh6v_LLtEJKVO8Mc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vPsHqjXuiTxvIRbAFmh_3uBzm1l62lm-bMgnRS9K1bw&oe=69E0D1A8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0SPdOb3YvoQ7kNvwHJIxAx&_nc_oc=AdpDGIlKW2B3jSPoj4QREu3lLj9k4bFdb-hMtPzO1YztAROahkh9qgzLZZhLqI1G38E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fPKvK9WR77wBHY9BtOLeGhelZpSMwiOMeoWUjYvLVCQ&oe=69E0CB16"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKbmyW5sGJEQ7kNvwG9TCnq&_nc_oc=AdqO0z39C5b_i4JxxEaJJH9g3YYpSXjSsnPPxA-Bbq3mfOMo4O9dP4K01Ru5DRUn5yU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_AJYnzQ1ZXRQfLB3n7rM_u4fCs5GiNEViXp0Lnkprmg&oe=69E0CB60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHAE-Rnv3KAQ7kNvwHR8ce4&_nc_oc=Ado2eE7wfWJ00umlHD6e5effw31eOPEzDb-ayt9MNJXNVH1yFDQU_ufz70vGtlUcwzA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08OstkBje5Ui8xiYgLsleI8xn24K2i3AfJ-9xiAvZjFw&oe=69E0CAB1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uW1QCyuuOd0Q7kNvwEeSNdM&_nc_oc=Adq5b1Gxya21LfbT_Cio9t3i4Zl-i4EK4fIYJV8As60ujUL4Ce2XSkah4NdPoE50Prc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjyIL-7w1EmJ8KnqtAF6AtbuJTcaw5a3OF8PCyQV30bA&oe=6AE8BFD5"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oG5h2Ob5MkQ7kNvwF5XfUm&_nc_oc=AdqycYomqLfm4zrf7mcniAiYpy4NTY-mgUYlO_luJfZ0t7drIcROf5nsnfVmYt6WjhM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTG3MlUshWB3hJCeUIuCQfhnvwYZ8_KHZbtSuw2kPy7YA&oe=6AE8B5E8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vRSYJKvdQrgQ7kNvwEW6znZ&_nc_oc=Adq8JZlkBjMvGlRGsBdFXR2SwPJrQvlyd6h5NkskGtibeo6WtCr1HhwnZwepnn3IwBQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSF3SCvlyWVKmBW10VQdu2ub-rnxSOmrYMYS76JthuScg&oe=6AE8AF56"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvCsU5BMCv0Q7kNvwHGIZ4Y&_nc_oc=AdoeideZ1fNoJPa53i-u6bSI7cErl7P6UIuLqDTThRtoV-_JYyDz3jVVfN9I5NsCvJY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR77ywh6fGaG-vyCuXjXjHnipmm1PFMKt6Bx2obuaW5zw&oe=6AE8AFA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-YHRx-7ciwQ7kNvwH8rNsT&_nc_oc=AdoA-8pkdSu9oLYym9CIa8uGWEKJh-pKjfnbyEh3eFLhFzigmB4c_yIIKgt8d85l6Xw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8pQrBP0Tey8_ZHLnaM_67bbBbSHUumt475uKFjSnnxg&oe=6AE8AEF1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
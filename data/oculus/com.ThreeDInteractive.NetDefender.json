y5sXjyV4BmUZZ8sjNtD_ZL7vP10duDTBFdcFvkS6Hi7-FaEbRY2SqM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsHOxYkyITf5bXz4Py6NLczuFSu_nQMgKbijxG8NJwRdQ&oe=69A58815"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkcSJgbZVsAQ7kNvwHBDZ4F&_nc_oc=AdkzANRdrlRfqeskU9_AYcBBbQKGyMnwqA7PLkeZ7v0iMTziHmqz79VmPjVv5190gEw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft59k33EF5kSDhUB7V9XVqQskIKCO3ctgyKTYK7bMbSng&oe=69A57E28"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQ1auLGt4I0Q7kNvwHEetzk&_nc_oc=AdkFug2HVZtEh2N3Zu_95DuESUR_4yPCK7SDnZ2u0Qoq6J0cXyNDkjvszKtqP9bRs74&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuUOru127mzYbCQeStPhBJe6v-p9nyJMwKicC0ZpphHfg&oe=69A57796"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Ko9m06Gpn4Q7kNvwESlAsN&_nc_oc=AdnfTBROo73SKngrtCBChNZrJ_Ma8oX09silW4g6ArlqHEKuFW_C82XScYTOsjVVlLw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afvd2CtijyELp4-hyxPd6MqIYqzd65CQ1bsSwki_4BI4Wg&oe=69A577E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-tIlzZCmmwQ7kNvwFH1NO_&_nc_oc=AdmEP4Zyj4HJYF8PwrquPOryIsBjkjTgNTOJVu3IfKgFHn6aW5JoaXfmE7-8BG5wosI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsHDcs_XcFACoMBwrFOBbWXXDsQ1MdJ6FqiBOSxCWnlqQ&oe=69A57731"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75371511_182990337983422_1813415391423379401_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1
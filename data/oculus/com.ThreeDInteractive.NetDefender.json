8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdSz3CU1t0IQ7kNvwGIBiJK&_nc_oc=Adr1359eTunlHkIsbIoxxc79i4v5mKnxn6Ll-yUCRC7bIUgaCKlPKdf2O76YkJWNVrc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsDSrUDshExZxpEH64ttR4-nzIBdzyiWnIIubHDvVbDg&oe=6A5E1A15"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoRoG97-ju4Q7kNvwHMupsH&_nc_oc=AdrB0QrXAgIeIj_nJBlA1PgXTdbHJKPb5hTJHGaG5Y4PKc99EOzSHPrF_OO2gOLLZkE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVtR3_4x8YgJHYG2F8ubgpLqKWxK55nxg9pKgqzBpG3w&oe=6A5E1028"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZIZN22aHccQ7kNvwF6XtRZ&_nc_oc=AdpPVgL7R9progPvHOG6Hqkv6PjAo39oFsjYuspcUZpvFFkCnypDpgBV6dLn-Jf9m0o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOAHCsGKVLuTlznsHfMGCGPYaCCit1AYaYpMWsnssM9w&oe=6A5E0996"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8Cq0m61iuwQ7kNvwGhY0wq&_nc_oc=AdrxHq9OnYb-zbMuWOcCcWOcH9IO1fmX10UhmNPMqj2jBKQ0JBB5dlIyHjwUj4pjByU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAa01eEmfyXwYejHPZOy1-rEM7JzA_ajU6fUHD-uoqzA&oe=6A5E09E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IiIjCgnlE-cQ7kNvwHVKkot&_nc_oc=AdoAFCt6hvARLonmCBtSRELG19Fah1jv54bnz-gOjvZZ9RAcOQTTnAzE7hgW8Rgby5s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJ5yc7QfSHP-bHETQxE5bkYnt9kbXZEopL3kdGuJ2YAA&oe=6A5E0931"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
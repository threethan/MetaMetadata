8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltR49etg_usQ7kNvwEXqmVZ&_nc_oc=Adqq8OTI1RstoS1o_G_TefgFO1jAzJg0bFhqrszjsbHK3ukrs1vsq-4PmG67L5CSrds&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPs2VLTSjb2a_ibKq3Xfiuz-Uxgo2e0K7y-GWXPhPUhg&oe=6A4F9995"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKUqy4RwvcgQ7kNvwHaOGCf&_nc_oc=AdqYrX7FqjMU3M2O6vNXpE6JWrIJwfbOt2AvvzDQsry0xioKhHV-irxMsDlToBEtzpk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOMZn-RnzQZmr0u-5-SiLHnWvt1c4LBLjGM-vxdyqQIQ&oe=6A4F8FA8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xwBUfrqeJwQ7kNvwGck5Kv&_nc_oc=AdoXxwAgUHcxW3RACaxS2quR14YuEZMbAFUX3FckNq9kl6RwS956I4Qpw-owgwG9htg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQ3XS5-OMwSTLeCNOzkH3Z53bV1SRlRTdVn-Q2nkJZ-A&oe=6A4FC156"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMd2pdQJ3DsQ7kNvwGDZoay&_nc_oc=AdpJ7elhCjnAGwDY6DWjYNBlNddXtPaLHYeEuakO0dC6BJP8lf67OuiYtmurQqRhMfU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCml8tKxVFBx8luxKzYjlmrtAljQvq-dubqE2TOFlAGRQ&oe=6A4FC1A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uy5lXx2H1H4Q7kNvwHdRTKM&_nc_oc=AdrM8Bm3qYEvuu13IJMJFTUB__o7k-s0rjS2hAUHWHBCNdqWnMoPVc6wyoMYkP6M6IM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.co
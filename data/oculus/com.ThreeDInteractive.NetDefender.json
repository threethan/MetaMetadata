8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4xWrBLl7kIQ7kNvwHfCZQy&_nc_oc=Adp1fRhGmeoNWniFdVbnAXXfOfpUteTsiQdw6KunuL5Eim0vopGrFkVDBNgiBjribT0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIInfQRk0ZGNfvUY7WBc9hTsJ4Rfq1q9RC39e96g6-oxA&oe=6AA54B15"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qy6QxHt5g4Q7kNvwG-Wrt9&_nc_oc=AdoZhbeslAVOUXRX1KAVXGpyYAXOMSjAou9FOqVc0SS1bSTvu596CocpTRuIngOXQm8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaQyVkYbIawIEnv1xVzH3khDRMIo5Af-D2rx6G5E4b_g&oe=6AA54128"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HY8Y4UbwxqYQ7kNvwER_yHF&_nc_oc=Adq5z5ptOH4z1AWkTG-oGQgkNH3CMQr6lqRPB_iOc1OGWOjJi8WUjvHYd30dKvMTJ6g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGiuTdzCbQCW9c5DQZGhLlCZK9pYBuVxwhyC3TmG5k2A&oe=6AA572D6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXVdeduhG4EQ7kNvwHtsM4J&_nc_oc=Adp5HPt8ZrAL8N9q988JYa2oT0zZnK1rEketmzXR2oNFaHJk2nDdrwUPCsSPdAlwLdc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0Um4_u2kcWk0li8e7aj7KzZeSpGstVrLHvzpI7bT53g&oe=6AA57320"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCZOmnNkgQsQ7kNvwGsegj9&_nc_oc=Adr7tjwP2sSPKy6S2lUUxfMsTv_pcXbn2Hz10OFq1YfQMtdCecwMaLxxVsbJP93uwzQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrFq2QGUztUwXeDBlDj2IF4h8rG9m4qJIrwvCByU9wtQ&oe=6AA57271"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
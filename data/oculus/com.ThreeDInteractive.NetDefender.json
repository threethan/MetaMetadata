8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXWbMsZoiLQQ7kNvwFg9p6O&_nc_oc=Adp_1no4PbM2Mk0Hu8AsG9LfiIEfEUiwk0tjinNWX1jNaiEOY9JWNfUr0nHr1FtMRqo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5YDvMe23Nt71CuR2QlmoBR3g_pB4Be3X4uRyl9BOUKw&oe=6AA7EE15"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pEUbCIDqpwQ7kNvwH4zOJZ&_nc_oc=Adp4EiwzSTStUF_qsDYNf52BYOecfgAuwAXIGkswT6BK7MHsrpGOr-gTAYzIoFmYzE0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGK6ylT5ZiSUxyH1donji460mdrUS28_xfOPmNMJElIg&oe=6AA7E428"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HY8Y4UbwxqYQ7kNvwF9aDc7&_nc_oc=AdpONtkWV1XHBm4VAshHqKcUco1S02NwocnMFC_ubde8jMD2JUO6yTNb2Kwe4nEQCfA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKdRjsYAQSiI0CtGZwqTHgCcGeIGM50wHEAENbFDeACg&oe=6AA815D6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXVdeduhG4EQ7kNvwHN5IGM&_nc_oc=AdomU9T-fJqfj8BKiDv54FIMhqyOY1Agos4uEkGwKSp_1zhvuc4gJskEcVFKet3M4uY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgDTyTXsxXFibyhRT8qxZAfauit14-AaoOyBwZ0CffTw&oe=6AA81620"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCZOmnNkgQsQ7kNvwEgTqKT&_nc_oc=AdrZYNJoXQaD4IV0GaSYFRnXKW95qLxGrv5_1am1K3Sv_FODqMruyWlYHJezcAvmV3M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJV_HaHT82vaQjK7y0wlvy4BwszCxAcKS9qpkpjNb8Twg&oe=6AA81571"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0RKgG3BgDsQ7kNvwGSM1KN&_nc_oc=AdqXRMpGdZSMUgRZJUgv7oZJcIiVJG_rweH_rj9TUCgxcpaw_cqKDoFGyqVasRsqOt4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqGJ1trxvWuGKDlBv2Jr15hRQMsELq7-IHt_17horxuA&oe=6AA42156"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hLDIdW9fRwQ7kNvwF4dxrm&_nc_oc=AdocXVnaZLZ034ZYxqd1xOAdCh_PQCMFmCsvXyWQHolJHLLbF8fh2ChgwnmpHynr6Os&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3wrnHhndKvEb7HrzTF_F1hYiqfOYCnhOy-34YsKf2wg&oe=6AA421A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TiAEaEzFUAgQ7kNvwF-rNCB&_nc_oc=Adpi8HbFy4yRutTyW6CyM4JvWsTT_oT27QBy52-McAWmhWI8fetzZ5ocAfAqJMVT_3w&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6Hf9jqGp6gFcpt_eFs9EDxTk6eqtD2VKVUvrV9E70Qg&oe=6AA420F1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "790315082507582"}]}, "baseline_offer": {"id": "790315082507582"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1683662946, "status": "PUBLISHED", "id": "790315082507582"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9080846865323846", "version": "0.1"}, "id": "620070596328121", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9017649998310200", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9080846865323846"}, "release_status": "RELEASED"}, "binary_release
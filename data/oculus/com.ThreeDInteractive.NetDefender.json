8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwyJcMbGWVUQ7kNvwHYhcUH&_nc_oc=AdpiKM8texlj59bzs0ej7Vfrrne0-7Lwz_iraCC_d1fMURYkOzPN5Byvi-3lxN-4G8Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76SDhgD0S-5Zur1wFq9jckwF2nvG7ksjXrxje-aZ0CEQ&oe=6A0B0B95"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_Q8Br9eHzwQ7kNvwHgHFlO&_nc_oc=Adp4lk2V-_wElTuERj2L4phAH_NiDb1J42sx-yGuiE116PxkAlirvS9hkbQkWNuH1RU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cE6IXkcW0zRFnaxSptaehReoyGlARQesw6R3n85LSrg&oe=6A0B01A8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THjQZbnXFqUQ7kNvwEBOFfU&_nc_oc=AdrRImM15E5ZVkXgclYcT4inbaE7wfW5ByjIOHEhKxXoUAcuFTBLBCjwT69E2UPfKAM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iw_V6ZU905MpmtXbNHnLylR1z-zKJvRj97ycOLXLrSQ&oe=6A0B3356"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCKWzplaS6EQ7kNvwEleJft&_nc_oc=Adq-vIgZCxqjt-wNUqtI9mBtJOwACcMfvNDc8lRMAwelfRHllf3UlJRzD2lBrKnWmYQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7S77M4t31iUUej-NF7YbU0P4954-J9FS9TEvgAaxgFqw&oe=6A0B33A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m74hSWPvrp4Q7kNvwH47mU5&_nc_oc=AdqAoKNSkA_xbESH2SYwvAbWUMaTZnd2Qb96prRfucIdnOx9Q-Ox8doZQnVVXwhdMhE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5me5D9SknSKPQiJck_D8CV_gbG7_ncbjO9ma5fN-SqKg&oe=6A0B32F1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZCeJF2uQNgQ7kNvwEfWlCH&_nc_oc=Adq2hzVVUg4UV2Ku2L8gdTFLxMx1tlsNXCMzLNN3VWqqF0i7VzclGEKBzzT-2M_a3QY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNv99ZPVaHNwwSzn3na3HjHNLj9BwbujacqVTlbAxEtpw&oe=6AE5E495"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W53EBxHwcr0Q7kNvwGsjCIf&_nc_oc=AdrkJ20Z9Ux3WqsdUrZjhNXKgbqZB0GDaPhm_J6TJhT0w5BvCwUJfHMjIEK2KRG0jKw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUfZNuy72IlDP6xRIRYEF1bXmGjlIBaggor6hUg3WM8g&oe=6AE612E8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3eKx1PfQeaQQ7kNvwEgDBVE&_nc_oc=AdqHzsS7htvlktxP63VbWFiogz3EVeeNf1njJsnFio1vFEj8ZrXl-rx-0EqiNrg0b_A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOstTUzSds9R3ZHbqqIi0kr4htahFDEfzsUHW6sZKzmyg&oe=6AE60C56"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fNbqGPsE6EQ7kNvwHBCAoP&_nc_oc=AdplfDzAg7nVvAfNNg8QHR7JAibM74t4s821O6mkVcrmulrGuzhCE3pswYX8-efFD94&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPw--TMOVyAVIe3p_8MNydXkgA_bjd5PhjmXHEgr_k_4g&oe=6AE60CA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vy-tsnGt2-0Q7kNvwFWmpN9&_nc_oc=AdoH5WfJII2jnmuRarDPZhPqHSJ4LzRyuJ4XlWw4OYOWBGTY_FLOI5UFrbSu5flkh-s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQvNaycH4e_BMU48zJi2QaYQ6QPSGso82BKpxE_LnCbw&oe=6AE60BF1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
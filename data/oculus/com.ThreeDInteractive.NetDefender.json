8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1W3wTulTGoQ7kNvwHfk83o&_nc_oc=AdroPz7lEuiYRtzrP2ikuI2dgaEHVfyEEn1uhoQu8GrqOcHLSBR-oi41K0-S0lmEoeE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGN-l4j3r_InEqPYsFF5UN1cF2qqgijOYMkUR2DNUxqw&oe=6A95B155"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-oLZRXk5FQQ7kNvwEfvNy2&_nc_oc=Adr5gILwQanrkYjkbuNRxirebl9VKPxHjQJqmJXc9RU4BzbSE3EQuIeH5PIEjH7wOYE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUNddQxOqvuHyaYmuzSZz5_Q7s1BINGkRRtxd37GWKVA&oe=6A95DFA8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xc9IYdacpj0Q7kNvwHkTDAC&_nc_oc=Adq1VlwpznajlyWiH_vhHBZo7E5iOpoVjq9INnJ2Qh7IK9SqjYHRFZ-5uJix0Wl1qBY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGi4RWMh1aPJTb9i9qr-ft8qNcTknEz4XU8KzdlC4mVg&oe=6A95D916"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5w6H-JE9I24Q7kNvwHmhASH&_nc_oc=Adrg36Sid2uKFVU7-UyJnJ2-CeB2faUxHixWU6Q1Z-j1CB_3D4l3y6ixPOCKrs0ODUc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWIvjHw8m_p96m8lqrxxkq_t-EOmKikO7Ds27zI-U-Eg&oe=6A95D960"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjaT6QAy8acQ7kNvwEAp4xo&_nc_oc=AdpuRAooCZY1WGI_JOwREosVS3RdDGFTzTpq6433lmiYx_v6GSaDTjaB-k2sk2I2cwY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqAUhuj46rdVr6fCxXmsXygskhd04GhDo9igSV-aGX2g&oe=6A95D8B1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
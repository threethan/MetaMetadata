8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-XwU1-NxJrAQ7kNvwGNCbLw&_nc_oc=AdqA0tuIfmQ2ETpAlmKRZQHRRDUy8WnA01JUA1h01WmFGNmNtpCObwEq-9vTK0lAZCc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61qocJOm0uyd3ZcDhAXEe7HEvKfmfEC4jFEQeiUuolDw&oe=6A007F95"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3xnl0q0ijoQ7kNvwFMyrIq&_nc_oc=AdqpUB1SGlbfJq1ekEgGRk003RyS-siS5uTbuZBZaCrp1Bevb8k1Eva2BONprBk5mes&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LTVslvLBV3aLFSQlXsH6gPSsrEBvRVt4ucye8G-laTg&oe=6A0075A8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7quPseQMbuMQ7kNvwESHkX4&_nc_oc=AdrRhz0XX_GPMHMFOkliyyKOSoJr2Fls7ZVA70TR3m0rBaUwYcaaXaaaU58Tqoutzqs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-0T97nhbrUEx7p5sgnJhwOw9MwEbSgcS9feqdeD4mPg&oe=6A00A756"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2uzg7oJ4coQ7kNvwFZZvvJ&_nc_oc=Ado4qwXdxPxexPosDkxVcwFWcXbFwdnHXasmc2yODh7prR_mTrEPe5x3vIJYJNnekfg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UXMT5LKPhyoyUnnuqZG8MrrRHLYecJH8AfEDYx2yGjA&oe=6A00A7A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PgLOyZaxfcsQ7kNvwGopqNO&_nc_oc=AdqjFsMGExxxoDZFMF6cfeiMyk7pNsYg-UngkVEmqdxyhVw0pPEM32OJgSRdEesdFNQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.co
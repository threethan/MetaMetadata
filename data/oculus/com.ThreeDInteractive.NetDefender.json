8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWfc882qe4kQ7kNvwEAXrpU&_nc_oc=AdrAyMB-Zicg8QIUnkNW4gwLnA5GRI2HEIphJsZYXYjzNjrJMXhKsmB3IXQRV836Jok&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cS1dSI9s8rjknVUuxHBQQsE6Yr5M36shPLZJEyBCeAA&oe=6A314715"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7rBdoH1H4QQ7kNvwF05N88&_nc_oc=AdpQO7qa0niOJZBIRp1e-OY7VjNqqEI5F57aAkzEcbxMJg9d74eyeunFZrmarakzVXU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WCok1aYdWx72uKGEs1JBpbl5mjviYt-5KQj-nfKFY1A&oe=6A317568"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPBiPV58Je0Q7kNvwFmjo8w&_nc_oc=Ado2EOcktviNC6BLwmQZWGZuqYP5VEAagLzj0WIHPQ_Azd21tTp4nSyYjXOc-snLC3o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fVMX5OsQDURtZAXMV75ZPXUamKvEP8bipReKMUg6VlQ&oe=6A316ED6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lP7nnOKDIY8Q7kNvwGxvjmy&_nc_oc=AdrUiva3urx993kcsD7FDjfnGcpjU7_bRiiNFPzDAJRaZovC48a2PBVcVqfbTZbPnrU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Y9Usc9_EASs3gQ7k0kj4dAcH84JwaJLgK9MsPkTydew&oe=6A316F20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVkjsQjJj8AQ7kNvwGnyO3w&_nc_oc=AdqgmWbjp8SOgS7QePJhR_JL6hFQFLs-6YwyYlKclFeUzgl4SmQwP_RoOSpbQFKf5DI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CyRTAfloi7PABf2gAO7G16-u14IJF6AFAjEaun1TF6A&oe=6A316E71"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
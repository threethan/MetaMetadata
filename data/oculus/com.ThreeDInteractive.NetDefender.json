8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caPLdmj7-igQ7kNvwGHOQTi&_nc_oc=AdqEWDxIRiwvjM4XIANbLT084h91forWSjOhGzUxKQslHEo2efiUlBJB-MVFKtqAdmY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rKeSNPJGCYTeQOAUi19ATY2LIVsfv_blUu6q1qqwang&oe=69D25B15"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XvFjZlovP8Q7kNvwEAxzdP&_nc_oc=Adrae1hQKovNKpptjPRizb9XuL4PyJNkfePNEzrSzDWSJh1eb28rsOfLicb41Ewnk8o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36q34UEpl_kCs9ruyUdmH-mdUTyJeYiOmMM_4XRMOCXA&oe=69D25128"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyb_ugAbu2wQ7kNvwFS20T0&_nc_oc=Adp2Fy69Y1LQ5h6m_zpqYycXU6c_gJ_DrrHA6Q2oDjXClsBYGvqs_3ClnU3PGFlSoOo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UyQ92eznnfHVJFp4LD9t-UbrBi1ZHI0YfbMWpZXqhLQ&oe=69D24A96"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lx3nckT6mZAQ7kNvwFMEtvW&_nc_oc=AdqzDK2E-KzIrpRTtGT21yZcQW8RjqTNcpJWbO1d__bzoRRjBr7Lji9L3F05pnjyZ0o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1penSjGuhrKXx4MrFEP1PgoJZhor21Biid1rmeABDpyg&oe=69D24AE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mpjv5RTAbKYQ7kNvwFzv5d4&_nc_oc=Adok3enktrW5Etqgooe-HLjNv5-BrLHj0TKhz5l_KsM24dQfNAFR7bD7zp_fG_guLVY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0czAsSXeZjhYxw_0fDY5wd3a5F95iu711i5nh9DU2zVw&oe=69D24A31"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
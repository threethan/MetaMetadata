8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9sxbuVYfAXkQ7kNvwF1O5CS&_nc_oc=AdqFE-OcNYDss7bwiu2lLrtsSeHOBSwXL2i9-MI6QYtOJjp1_sXUAIeCmqrqfdOm4Jc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbB2NBUkWYCl1e18Ja77DjWcLYD0luAbKhFtSTNSuexA&oe=6A9EB395"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3L9gt6zy_EcQ7kNvwGP-G2I&_nc_oc=AdqWgWNfm7Ivb7NS8xIk8kNHO45LgByYCDnXkAT-CJ2tzmuTWTJvCfg_DCIt9K1fVdk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBe-lajC0Ht4bzKLrgIW6qzBxBs5YQIexPgerKiBFqSw&oe=6A9EE1E8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nU9do5qgd8oQ7kNvwG8nohO&_nc_oc=Adr_YZlOXzVA3Jw48tM3CcEpewHy1VX4p7l1DI9ctNuUMAs7WDR5JQPX5ZPa1dEstQs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9lbTFk2kLE0qcT5qeIDlIFq3qGr9qgUAxBCEVgIA3Vw&oe=6A9EDB56"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1LFG0wJnASAQ7kNvwFp4hTE&_nc_oc=Ado_KuNMKQh7k-jstsIzrm66YZ_RFF03r3zpuPTT7t_7hDzJjvRJ-SIbYLnk3mEE70I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBKIY4tT0vOcVV50mJSORb7yo0rEke0ZaOsMGVoaemeA&oe=6A9EDBA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTj1fAkBLMcQ7kNvwEF_qID&_nc_oc=Ado4r6Kx3m-BHX9Ka_Z8JKFx0x-Nyqj0HSD-zLI_ZSqkTXsGcqyCbgdRI2iouEH2uyI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqAiyINGHJ8o3bam0QHURqPVksD_kcuUtg2OL1GVPUCg&oe=6A9EDAF1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBgNDg6GaS4Q7kNvwHRkVMZ&_nc_oc=Adohctf0Br7VChCtdBwK_eDQP1yvaXGIznV1kLykblcpRAF6efaJ7kP55SYhEzVGQAI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzM8N6e3alJhfYxsu1hvtowaLPT3bMyGz74daAik1K7w&oe=6A5A2595"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4UAS-i8CFb8Q7kNvwG3aCDT&_nc_oc=AdrcE1XfpsfFXHsxfxaasPuuUERl-cA6jkt0T-qx4IO5ey38mPk0GZIGOA9jrHb7W5A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIltZD87eHEQhYNLtAURv7llP1tG1Q0KY0biehIPtrOg&oe=6A5A1BA8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ON2WPxmIRwMQ7kNvwH1b7g6&_nc_oc=AdqJE8wX6nnlwRRS-NU9xLuplNhJyPGlNGjKFoY06UF2L1QxMxHTJNoWGq3xr5SPD2U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhSCxtm5H_h_wS9K6rrhOZlaenxhGimVayzzUYAPL6cA&oe=6A5A1516"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VA7dg6sBpMQQ7kNvwFhvzO9&_nc_oc=AdqBVZqjhKBB2YAm3LtXkdwr_VceyyGIYRmKxxj77n6726HTaM9x39ldiWget1-Fu8k&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtxQjILRP6MCYErZqgXTxFtgdp2EFhxi9h1W1_0HAzdQ&oe=6A5A1560"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KP_mwKMyxsoQ7kNvwE-axr2&_nc_oc=AdoZfGUMf3pBbGajjG6Snf2IewWSoDi8CKdDz3NMlRsAiGzoiYd5MJMob17s-_j8Rsk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwXAKkpVEzFFGOIR-fDq70-n8YQG0NlIFap0e1yAOZKA&oe=6A5A14B1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
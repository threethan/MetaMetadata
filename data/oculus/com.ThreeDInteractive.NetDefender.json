GlhEsUkQ7kNvwHrxMef&_nc_oc=AdkDlyo7jUuvL_T3K3kSPdNOTnnkaq9c7YbQUUD6ObEa-_-hUPiwB2x_91NB9rET-Xg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu1_3-LA0C6AK0OQF9cit-epnqxcj9dLwMN-IhrgmUzww&oe=69A81A96"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1unGFrCeBAkQ7kNvwGpbgP4&_nc_oc=AdkUg1K6Agtxifh51S4-kKjdVNN2MB0BNM_egFjlpP8B8KfNbOcDk4kOLM08W2uI3m8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftUoLLs78YUCrhWzs0nZfB21l2yT_aVDmwKcn8--3MIVg&oe=69A81AE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jh-TZ6Eog90Q7kNvwE3fPk5&_nc_oc=AdlUeBBxYc1FQKBEAWTFGRGcgxcru8mpnIDyHbNSHri9v8NXn89067HfjPfi3rFHlhE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfswUh31TrpgxP49yyeD1mD9BEWYy_m27YAdXg6e4DM9JQ&oe=69A81A31"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privac
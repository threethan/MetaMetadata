8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNY7msYi9SEQ7kNvwF5WYuq&_nc_oc=AdpgHGtlhRoHvedSM7j4lmfByMDDz7TUOC9E9jhwfTq52_yPO9PcJURbENyBdInV0VU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hDySF6JW5UcLTpSHk_tR3rjYyekevtux_vcqoleIX5Q&oe=6A183A95"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKybVg1GHX0Q7kNvwGZenDD&_nc_oc=AdquW9_6AFHi7_bEGCYe8NJ4c-BjOeWDh43O9bxuysN38qQkMG7RNEZd95nsYnYxQM8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_fOy4elKhSe8yoFLsa3LrF4fslCyDpulzgtdx8WrL2g&oe=6A1868E8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyU4b9XTxUkQ7kNvwF1J7Ko&_nc_oc=Adp1hWLKlNudawlEqzMdb_Ja3HGn4L1Ja6owx-wVNpvvwHI37Lr9mtA30L3mywVXBr8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Orf7D4STgz4BtQHH-g_4-2ilyhk0Fc3BojWU2Pm4Dyw&oe=6A186256"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t74ziKZgvGQQ7kNvwFaKZER&_nc_oc=AdoATTnjPUf_OQkJim83gchZCRwVXNoCZII20GKRXK6klb4zprt_MmCXT3eD8wrjDwU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sNSAD8WHqXJ-x9hI4qn_X4__OFiVTpkSgI4htf_O2nw&oe=6A1862A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqoPs_CtK5UQ7kNvwFpbqhV&_nc_oc=AdrpvVgv-l756VaiO5q5koBd5DL7BteVy6ZZa68UofNIHRK651EnVJYFaR9g_xr_MQ8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JLCBgQMrIEYxsHxg4R0qOyzcl5x3d_XN3n1JEchCCPw&oe=6A1861F1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
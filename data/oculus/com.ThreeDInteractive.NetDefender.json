8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjuUhKv5RdgQ7kNvwGIXt90&_nc_oc=AdqqwUp-1KqSfMBM5m1BOgPfQ4Mda6zX55YshLKQwD49dJ8vuzbEx0M8bzbDvStRLmI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ee79GOgoF7OcUb2dSVfuZetz7q3Wb9It-q23XjU2eJQ&oe=6A3FC795"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JupwSI0AycIQ7kNvwFH2ehV&_nc_oc=AdrI33cOccsOM9OpxUSV0kO8NRLomLoRvIgnIq2_FiSaJ9IeqnI9SKnSSTBXiAW49aQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Dm1NZchYYxtRZDHI21Ucv51N3Os1O3dFTJtQQWztFWA&oe=6A3FBDA8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oc3ku7F0lZMQ7kNvwGBhTYR&_nc_oc=AdqBF30LfX4LpK1qJ85j-MP_zr3-K8tFowqLxzXR3SKb4CPfDDFOBx3eEyrwUUUKZoQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cADvRS3_KArFqmIhfsnMpDFHSz1clldm5G-_0_l1Qeg&oe=6A3FEF56"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1E2GV01axQQ7kNvwHtRcrg&_nc_oc=AdpGaJC9MHF6acpS6Ra4e3sm3F8j6pTyqHDCvsdR-CMSrGcYF90sEv2LvjtiBSyVXYg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rRjfx6lY51l2YbDudCxCFFKeLeuQtE49KiWDQOy4_aQ&oe=6A3FEFA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFsdt2wNt_gQ7kNvwGleJCu&_nc_oc=AdrTz6GJ8r18nJSuYBUqWsLT-7yIoCaCcgXi8M7NClPp2L7qUxX2vIITCUFS49wgbmI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0YuOHK0OhQuIvNPPQFv7lnc8PRUNCpd5KR7IPSDIPng&oe=6A3FEEF1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
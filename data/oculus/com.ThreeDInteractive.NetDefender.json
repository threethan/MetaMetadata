8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3EcnL6qWx4Q7kNvwF8NXTA&_nc_oc=AdqJ8zsJWbsg1A7_Xw_D-kVoTReLCjKws1W11N57dZLANFgaaywXJr0C_xa_xJV5gXQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoJZs_R6XazmtRzUBJgO9q4W-bGQCQh10F6h9j9bbSkA&oe=6A7C6C95"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edFUWAcdyUoQ7kNvwEPkEO7&_nc_oc=Ado8lBDvToGjtUZIP8UQfA6TiVD7i-8KLEJ2C1DrGg9z71TvLJByth9unpRZ1Odde6Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHftialouolop3lNb7vxuq8bk6n9KxPu3GuF7zGWUTYuA&oe=6A7C62A8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCbh22f2Y_IQ7kNvwHJsKSO&_nc_oc=AdpYRtzeFxPeNRsqhUnuMPfFK6LgHWYyPONYG_P6abLlSJCpzylpuB6sjm6nZMhPr3A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5FdU1MIRfTjVkyFblM1aoFB3Ne2ZC4WwrKqgIcAYEHg&oe=6A7C5C16"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-TrSNTfHd8Q7kNvwGZ64na&_nc_oc=AdqqIXe2YalXOss676OqKn8CsTwWA8cAk-RUOLDDlz7BU1RCrg1s-_lNizLgd55NqNQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuymYo9iDzwJoSIrl359Ff47cbFFRszswQ-g1mqPnnwQ&oe=6A7C5C60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f94lIIE9z_wQ7kNvwEvbLRp&_nc_oc=Adp4pAnoj1Dng5yE3tS_Cx9rtSRF_5_OpktAquF8znNTDUBY8xHXE44u7GhdHpw3w2I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjnhmAS2rvyeIWGl-0r1sMvILBGuIMeYm-zIMWmpx5QA&oe=6A7C5BB1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
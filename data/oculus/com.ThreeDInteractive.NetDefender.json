ySCut8SFjKnuJnddcJ4W4lm5JMTMZhfmcvYH8ryJ_VvdI7u6UqJwhM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftsDjUnJEsKcpm4MYa4nTEpmoumR09niYz0R8eri9n1GA&oe=699C4D95"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFsyzPGCow8Q7kNvwEJ4Ov6&_nc_oc=AdkiDDHcgEiCCN2eOLpaOoD03QU3jbcJ8Z7GQ3dAeBsBd9j9alGki7TJn8FFjdhMUrs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfszbPBu6-QoPFczeeYW7cmDyZ-pCqK828DAidFe7Vk3RQ&oe=699C43A8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXevdO3l0D4Q7kNvwFwtFsV&_nc_oc=AdmJ3lpjUMHo7z03-J6X6JrS68tJRhXM5k5Tw8r5yIYvfqGPuCQZ4n3rHQjjgdgpiFY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu6NHqUuNEUH80nwQneuQDEQJrSGdtB9GHmpYV0wTZWOA&oe=699C3D16"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRcy6gBbg4gQ7kNvwFr6UI4&_nc_oc=AdkGSMoG3RtJNM4sKv5MNDWO0OnxAmDN0W368vJ9ze2T1u4Smq_MR6W4f7EcPj2_XKI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsXNyQ3F6R8GVEw6tWY0gxSnjdkhd7-QQ6ldjSk0CQhsg&oe=699C3D60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfBV9FrlMXgQ7kNvwF2qwbn&_nc_oc=AdkUPYYapNI5LaSIRznw_jkJu7HxE3i8ME8bn48-7yRosyWcqSpAIoEEt8dVAw_3kdI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsY0OkGvG-G-l3aYHEk-7XF59bgO-Z2jPxVbCF875bEJA&oe=699C3CB1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371511_182990337983422_1813415391423379401_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1
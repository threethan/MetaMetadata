8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-XwU1-NxJrAQ7kNvwEHqX0i&_nc_oc=AdpcHbdYQ_T2UZALLNfxBJEOGVXGot-sMBFHF6cYNRKhUsubNVBpTAlRHtf6ytIatgk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AtNAUfZQqZvSl24uhP3QKNrmdj7FIEV_KBwSZ2-jcmg&oe=69FDDC95"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3xnl0q0ijoQ7kNvwHEI1pT&_nc_oc=AdpK4rbcjW_YtfWqRcwEw5tKLHpjoWvuu7sVr2wVpfecxR0BMue6fucEFEVlPfi0R8E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WURoCL0xbAKkVBkCxniEGDfrFRbKhuc56zJuAuiKkSg&oe=69FDD2A8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNX54Ank5s8Q7kNvwFAKn6R&_nc_oc=AdrMTMK6rL3rzws3L11IMUK_eEU9U3FQR_zG3yvtLWro9yhStRpLAJRu1Fe8RXSPFyE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lXV2IqJAMJ9Am9zHeiXSUMOZYwRKWA9mSvybJhk0eyg&oe=69FE0456"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgD667_ksh8Q7kNvwGMDIJW&_nc_oc=AdowtBdh0FNqZOh5xNXG1-y4-K3VXKx0GVtMiuV4O2rCt6m9DCPq4lFoE-DTH2Js7vk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5j0c5TvpNCcGvX1WvRw0xm80bz2n9Dv3JmlfcsyhJ4Uw&oe=69FE04A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szPMTFlfBzwQ7kNvwEmzvrG&_nc_oc=AdrU0R5EPvOC2ZEVTx7YdTg7qg4YzTicxkAP0rNi9AyjzTqtQIxIoSDpffKwAnk75FE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uDyUUnU5yzsGryjXniU-fw3ZkK4idOm5q196BmRLUBA&oe=69FE03F1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
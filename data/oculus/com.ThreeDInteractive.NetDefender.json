8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjWzEY3Yx_MQ7kNvwEz5a9h&_nc_oc=AdqCHxTr4mz1D7-ryyvrkrldesppXG8J5Fi7LHeTrWt2YSlwO9CgqFOnkNyr5ZFq_7w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLaCNuBpp2a-khxBCrnc-pcvgg8roo099CGMusf6bVJg&oe=69CD1515"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VcRgzons-jMQ7kNvwF9Tpja&_nc_oc=AdqP7HKbirh8ewvA953BkVOP5Oc3XnddFeY9JB09LrPk8m5fgFj9hef8mvs9ay3lq68&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzUggzsG28bXx0zhNdMfGzG_rCzPgkthy0OQk0lJBPLIA&oe=69CD0B28"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-XFOk9-pWoQ7kNvwGGKQMD&_nc_oc=AdqgYn3SkjnNOH7HI9WYsV-uCF0GewJoj2m2rlDM-3JOo--U8q452g_eEyQ-WbFMHfc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzmASJuL-_llfgeJOq48vDN0OS_Hk3smdteM2CxYklo0g&oe=69CD0496"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wo0dGcnzJWwQ7kNvwEBZelX&_nc_oc=Adr3oPqPDSSBUPe8dOwya04vWOR9mEKicNGOUXErHUVafAkuyR0Otq5sxohypcBk0_A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyvALhpJRmboUbiW4DAce2gjD8R0Wa9as29k0zENvbBxA&oe=69CD04E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u49I6LT8UWoQ7kNvwEFvLRs&_nc_oc=AdqHieKFlBARGK16YZe9PbxdLhafjPxFmSrgm3eP52nt_pCcJJrN8aqM5JF-T8aoMZE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyY6kEuZ97_kQFYoBfygd9ulC5RR8NBeAq8XMXJ-9OlfQ&oe=69CD0431"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZCeJF2uQNgQ7kNvwHux13F&_nc_oc=AdohC6XH6tIKWoXfiCjS_VfGxVw4IMTeAQDyDzckcwpPG7DTIIgHEJz3rtjkqmlmlKc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcAGnKAxpcNNJ3qVBHqn-iNEApUSLfWhHIIpyXCzOh0w&oe=6AE49315"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W53EBxHwcr0Q7kNvwGudZRS&_nc_oc=AdqhW8fiVXOZzFYW773_VUtePcxP67sEYtSbcdKLetw5Qnk9sVyvsdmC6wCLLrEPaaM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxoYQvO9mkQ0RJh69bY6okEtB-yro9TG_Vl8gO7sn6Bw&oe=6AE4C168"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3eKx1PfQeaQQ7kNvwGNageM&_nc_oc=AdolelQ5ct_1XrTFV9-nXZpIWMzizNygD4G849VjEFw6WF1F3-wrquo2bf9DJ-nq71s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3X6KqtmxiT-doT8n1jhUYdRxmR8XmgL8HUM7__ILKTA&oe=6AE4BAD6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fNbqGPsE6EQ7kNvwFRCPuV&_nc_oc=AdrTcy43a4fbOVyXFCMEQSgNFOXQpwNKsYIequq1ZmG7brgwSDFo4LAA1fiPRdXr3iM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbCndBzeV84muWHVPzF4pUFLam8XgPnvdVbWPmcxgNHA&oe=6AE4BB20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vy-tsnGt2-0Q7kNvwGlq9CA&_nc_oc=AdrMnnd8kPZsuqelDlkBJYdL7wXFHMhYyBV8XVCrOYgqAhybtGywMSxMHTB1lJruqmY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtkLjMzrkXt_q8YGEBgaVFYI6geGliywoWsDMNMi8ZUQ&oe=6AE4BA71"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
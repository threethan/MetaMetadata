8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rk6sM4bfUHcQ7kNvwF42-vc&_nc_oc=AdpuJyXMkrGDr_Kml0jGtPSWCI-ChPbdlawqavWU_92zjbSqz5b2-AotucJmGNVI7s0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Bq5ZfBJyNQybwXTG0KqajzAACssVBarWYFuhm7hXWOQ&oe=69DE3895"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1jlHkvz59cQ7kNvwFn4B8q&_nc_oc=AdrcKxE-N5kN9jKxDqOYcB_WMq12wSYVY_xyhOyHsz-Gr1Lx2-q-7AJ7y59u9ojhaFs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CK5pBkl3wtFywQ86W4xQt4h7EUR8keTL6viUHGU_JKQ&oe=69DE2EA8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGj1rt7TwhAQ7kNvwFMALev&_nc_oc=AdqN-sbZPeVABNxrVaWw4lIvHRF4MXT5az1uZhzQkkfwjBADk5jdditxq1KEOXFuSSw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oJzivvDsApfxtznJqMQ8o96h_iXP-FLsQzdvp8Q_i8g&oe=69DE2816"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdlLK2-bXScQ7kNvwE70rGs&_nc_oc=AdonLnMGq3X0JnIV0COLfKvHCb5s4OUcNhO5sY3mx9gNPcvN9kJ-bpwrrqRw_tPN0EE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3k15eyIzQB4Ce38A4_tNQrWx9yYDUNnAZBsZx3agIOrA&oe=69DE2860"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcrpUFlrQaMQ7kNvwHMk-me&_nc_oc=AdqtdLYg9YQMFutraGK3-bqbd4hyIlndaWmeqT27MYyzlgGWqIZcNvaori2RxZEVyo8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1f0cKf-Z_ToUGpaGW1dAZQPeEau3dDvyRreIQPWKHYbw&oe=69DE27B1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
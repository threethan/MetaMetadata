8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqUu8p7ohIcQ7kNvwE6aSMm&_nc_oc=AdqyQPjk3ycElcFeECUI-HaeyneZE6JEKttI7ozMRb_OTgk1230m0YYpgsOJYYPGuVk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOXvYata8lJLVzbwCj6_I6Zk844UGkg0iXFQoOVNNAxA&oe=6ACA6D55"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HWnaJuRXIYQ7kNvwFghQp5&_nc_oc=AdoWo0wR6BBOXInAqfE9JhJEGAP_D7YD6J_F90Wpm1om-rZISmzBwnH2Mmt51LLKCkA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFJShhwEDNn5UWGxkOG-ndZhqReAUZZWPwyoA_HXPR3A&oe=6ACA6368"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOG6b_GxW0QQ7kNvwERGQpn&_nc_oc=Adoh0JA28QBD4SfOAJGSBWDZ4QoCM07yGKSnDzFLcOJLzVxgze1Zq7d8DcryN9h7wcg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkNvjbTWAm1dl7eBxo_rH9jELTzmz696A0GNvsDw03Ww&oe=6ACA5CD6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgWvNt_5AyoQ7kNvwE0ZUxS&_nc_oc=AdoBRsJD-S7gZ-F0roNhtX-02sa_hujj0W2LxhAJxs7eZrIzuY5vjZwBflAc0XzIqME&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHdqX16zhmH4-u8p5yJlTBHGUW794YtPzl6HL678TPJg&oe=6ACA5D20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaBUEeQLERoQ7kNvwEzuFEq&_nc_oc=Adotz771nygkr7r6ONtScb9xMDOvBV4wgtqBlluWw2Oj7sPhK3JlwaU4jV-aEenYv5k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObKcaIQk5JZq0brT-8Z9aaDGENedvfKXF0XNFOvMnIcA&oe=6ACA5C71"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
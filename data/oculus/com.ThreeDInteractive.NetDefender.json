=1-7&_nc_sid=6e7a0a&_nc_ohc=1DBxf-cp_2gQ7kNvwG1cfJ7&_nc_oc=Adm2e5IIrOaLqdfyd6iT5nrdxhtKCPdhxQ0_JYboXa-KfSaPXbLFQjVvQDDkU71CJRk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzqu--5P2xUMcL3KqBPR9sEfmAPuthmzdhVrY3YRciJJA&oe=69B6AB95"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFQin5QyNLAQ7kNvwFt7OCM&_nc_oc=AdnejxhIsxtYqyDwnD7Z38yLPWYnTbMWS9QWWtnHnuDeBKQlmJgkPhI_lbF-ZntoRuA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3bxLhCPi3ihTAb71vkPSiowHe1CT7-rPzkYBaF0wPuA&oe=69B6A1A8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0KG2GVj6IYQ7kNvwGWbuet&_nc_oc=AdkXiHPk8hQiwwz5fwi06lt84ksliovhOKDrIop_ELbGtjD85HVWEhwmoUIf4wd2MDs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzW_l0NVWl1j4qPTmm8L0f5dkYFwa25AutWOLlTP5xWPQ&oe=69B69B16"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHJKief7zF0Q7kNvwGdmqnm&_nc_oc=AdkAjLjo4SK2eUlQaTWI3JmiYeSpRSpiRZ6gpM3_M4DylfKK3jlER9W02Gc6i-owuE4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzjrSgbDGeAANXyNcQS6VFEbFkIjHly89IGHbg7_rLM9g&oe=69B69B60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTDKc02AlUkQ7kNvwHz3V1p&_nc_oc=Adn9AYLdIYtduf1WkFUKuV4cixXo0Ca2uCzB1g68pkA8poGnfBPYu90qPQt-ImPU4co&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyR20_C54T7v8-oxBKNAW8A-7yQRkt-lxIcfEw2PknSjg&oe=69B69AB1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.
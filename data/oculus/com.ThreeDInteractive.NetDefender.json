8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1k6Itj4p7aYQ7kNvwHOFCtz&_nc_oc=Adr_KmqJw02EoFVzCys5BUCU3pNYWxMaw_-zbuxpCZ-82ZAC0sS5Yw5BC0k4SHGippg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpOHOqXe82u-KnRoWMLUpIJNvPEc_aDyKICcO9B-VxNQ&oe=6AC3D5D5"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBQb7IeX8yEQ7kNvwFl_qEP&_nc_oc=Adr0rxNXc5KcoA03qVZOOXph4kstw_T873Yp1VffP367QYK63O8U1y-T5dI4-0wwxVQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIeupqNFi2pDSn5TydCdjNZUiN7AR8QbJB6Vqn6vbreA&oe=6AC3CBE8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQOQTHDn6KcQ7kNvwHAn5_u&_nc_oc=AdqEKm59SF4pZiYdLPiH-_20BOgMwscbt2KP11w7xSpvG0sq7tGysMHOle3mYnm3pPs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhsmh8oCh00-giFKmGjdr2sAVEvbxfz4G2O4j0zCIrjA&oe=6AC3C556"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsmFRj_OJYQQ7kNvwHIS9wl&_nc_oc=Ado3jQmE5XK5-YEqDPFXkgM9sTi_Y44nyYSgsMXt5gbKtQqpFGPeX-Kd5fDrRjSaaR8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1r5SqCEr48GYXavjFAUk3ZkP7fXlKmOd7XX-eeNsxXA&oe=6AC3C5A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfopicQZX0QQ7kNvwEdmDK8&_nc_oc=AdqPIqZu7LhKSPw1g6UcyRaNy3Dc3UUBcQ58xjoS2XM-e3cna_Fz5qkBYYnIJP4re9c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMPGzUtiG11ncA-P5ERDLeoRefbyDKqU3NavLjRt18Ng&oe=6AC3C4F1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
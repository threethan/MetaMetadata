-kkMIwYfiOLdC5xm69OpIeicdMozmnmlGwIx9mZ9msYbUnGefrdH1o&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftmjNmu2jBEuNFNAasCLICVVino2nTdgy3Zk8B9IplNRQ&oe=69A19395"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWkPyw1OW20Q7kNvwFiq5Lj&_nc_oc=AdlLlr7JIIh1zHm-Ym3gI93Cdxkl2r2GsqUkRuoKvULyZ5jYy3PGfSuHwFdVv7BQehQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftNdNjCJc-MIZyOKRZ_iGD0DwdFgswnmmyi-blRrWemdA&oe=69A189A8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wr9eV1mT8xAQ7kNvwH3m6uV&_nc_oc=AdlwwcbzRraHJfTnbunBUg5ds7g-8X08Porqhj8YsrEIcWGirB1cOlZ25EbC5m5pPFM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvdeAKS-aS1XskuNk1aNg0JVb0wt26iGWRyfocGwZtYhA&oe=69A18316"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3z7Xf_iI-kIQ7kNvwHxdn0t&_nc_oc=AdkAgd5dRhwtaLaq4b_mNiKgsUAG7vCfYl3oWys5iWzsknMw4wD4iWyVjnYVbYnQA7U&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsBXH6a3erZIyNlZBnkEgfSt6Odf4Y7kpOofoAJjjV0RA&oe=69A18360"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QmbVZAqCsEQ7kNvwFwJ9Wq&_nc_oc=AdkGnp5meqwc4QSSb6mzvHVmh4x7YnnmlfGGUZVT0lQzi5x94_1bPMmPv77g0pdq_Ec&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afu3uu9se_AU_daSRFJ8VXbzrEDq8aCiL4AjEthrxcf__g&oe=69A182B1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75371511_182990337983422_1813415391423379401_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1
8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVXJsvIWcDgQ7kNvwETNqPH&_nc_oc=Adqqt_dNMelW7n9WBl31-Ut1tTbmeXKqRSkQvjrRdE116A97V_TOYh3oUEfC69Z70Z0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NKNzGklf1FSTSSfr6TI-kM04-OAiuoWpxPSzgZzOCjQ&oe=6A0F0015"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2R43jbcbkkQ7kNvwEigX3D&_nc_oc=AdoQWykJs6kdo78d1RGhIN4WVAyVSmMedw2YE4otPY8tSTyvlFgO-UxMQ1bCg8qut_A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ROpVaHNccBaQageOItYBi4OcbVL7OVhq8ohmXXi1PmQ&oe=6A0EF628"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8jptKvzpyIQ7kNvwGCVUpY&_nc_oc=Adpo3umv-WIjeqkpTme0jbHwAjjBePKejJ7gs0IMP7vB61cuE7j9I3BJkX0d4GJWenE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EFP3ypIQT6qmr_sAcYN7QKxszJ4PH55U5E4ZAA9QyFQ&oe=6A0F27D6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uV7THmad9oQ7kNvwHYso0h&_nc_oc=AdqYaoTJluVycJ0zO2j-ornj3NqFv0yKvuHoWHUM_qVO2qD7c4mIOquQ46kGNBR6zt0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VnFxQ9JAQlnB7JhdTLgZd8kSEMjRbcvd3z1aoj4SYww&oe=6A0F2820"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1CRA-m5dWoQ7kNvwGJ4SJU&_nc_oc=AdqF8tGB6rjEoci1n0f4i3h4jdZdcZS2I3cQekD-vBAwBRyXllnMYcPHmyFjdCP72wo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.co
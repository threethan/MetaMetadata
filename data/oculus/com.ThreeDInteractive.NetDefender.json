22007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyU4b9XTxUkQ7kNvwF1J7Ko&_nc_oc=Adp1hWLKlNudawlEqzMdb_Ja3HGn4L1Ja6owx-wVNpvvwHI37Lr9mtA30L3mywVXBr8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Orf7D4STgz4BtQHH-g_4-2ilyhk0Fc3BojWU2Pm4Dyw&oe=6A186256"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t74ziKZgvGQQ7kNvwFaKZER&_nc_oc=AdoATTnjPUf_OQkJim83gchZCRwVXNoCZII20GKRXK6klb4zprt_MmCXT3eD8wrjDwU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sNSAD8WHqXJ-x9hI4qn_X4__OFiVTpkSgI4htf_O2nw&oe=6A1862A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqoPs_CtK5UQ7kNvwFpbqhV&_nc_oc=AdrpvVgv-l756VaiO5q5koBd5DL7BteVy6ZZa68UofNIHRK651EnVJYFaR9g_xr_MQ8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JLCBgQMrIEYxsHxg4R0qOyzcl5x3d_XN3n1JEchCCPw&oe=6A1861F1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of 
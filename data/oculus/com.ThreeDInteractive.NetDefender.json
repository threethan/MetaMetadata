8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wMazEiGyHU8Q7kNvwEghLlL&_nc_oc=Adr0GZRFRQy9_N08NXiiFmHr_bdQMay1-IJZzX1W-q3NCNR0yKMOfdZLZq5221j5og8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyT013W0P4J45eufyfvYt6Yi1R3x3n9LYUycQyVZ0pqng&oe=69C92095"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTvPQtxp1t8Q7kNvwGYuQ71&_nc_oc=Adq4soOEtyDYuYeCNrDufsWHoiKT-z1qoM2nhCrxzjTD2Z6ZFBI_2TSCJZTtcx29B9A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzg6nTWRabM2RD60Li-aevO4Rhxc42zpk4TBhhZialFiQ&oe=69C916A8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kvxizOsLRYQ7kNvwGyErSf&_nc_oc=AdptjGfF8ZQTeFxp8fJZZyvajjdw9H0WTmvmvrGUTWl4H7QAtFV2MAuGIiZhRj8ss7Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzuEo4OXgMHD-8Df7EzKHoorldtz1itrBBL8896NGoZSw&oe=69C91016"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_Ccqt6W4TQQ7kNvwGSdqKx&_nc_oc=Ado0MxvGZb4pRS6voX1hR_xKYRbKz0sT3C4lH-2pRZxi9okHIllrokE1nJvZcOBZSQQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJ23pQ8fH2i6NfU8S_ydAmaBaG-w9HRxSZHQBoJc9JnA&oe=69C91060"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRN_Aiq8RjwQ7kNvwHaLJNU&_nc_oc=Adq_ZPSzHgSNg_Q1Pdee3IAWCqxpvSL2u3JFy-dwA958jjvUpbRdYwpoX06OJSqWP1o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyi9Lv5tls8_s4iQ8SRgCUslI6hiafsAkFHgRFIEdvtTA&oe=69C90FB1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
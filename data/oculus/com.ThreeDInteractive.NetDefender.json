8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kLsXGN6dw8Q7kNvwERCd3_&_nc_oc=Adrt2sHz--liy2d2q8CofaHTlQEmDQcKSh0jjuuangXhcGlWpdE8_x6hply1J-_kY1Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TbFZB0hBl8olPCj9JNgekC3-L7GBAJqgVM4RXnLnKBA&oe=6A241815"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSrfEqOVdtQQ7kNvwFbwmmV&_nc_oc=AdrBkod7RMWG0MfpijzmnfaMJULBWtaRKN9HCt3ImbiyLJ43Bp7oNoUZQjJxgvfdNME&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-e3gBTEHlmuYwHf6oCV8wxD_Ih5EG6-1YARgSPjXZZZg&oe=6A244668"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXmjtRZFEX0Q7kNvwHlrBKX&_nc_oc=Ado6RIoOyQ-S8quWebXD-Tfgf6Qy5SZ-T2zfnzCWxofdRf8nrSLypIL6ZqEtRmphdIc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9e91teA9qLxyGVkLtVFwekYaTKvwMw8B57qZBYdjKomA&oe=6A243FD6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jwy2wm4lQX4Q7kNvwHyVE_F&_nc_oc=AdrqpaDPeQf31-V_xdcFW0d9GgcauAfv7OeyoedtLnVG4MDu-9RU-Jt7ECBx6EaussQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YqJAkHbT-Ic6Ipxut7srUSiqSF7NbI6T1qP3OwvOckw&oe=6A244020"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePP0xPACn1oQ7kNvwGUy6-3&_nc_oc=AdraAFwpUGm2wNR8iwRbq4ruRWwsKgajkf-46Crk6J76pwsOYr9h5Jqo8gy6-o7lgzY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_L-4CyvBgJirf5IGlYBO8s9dYWkzcrn9MTLMxxlZCrmA&oe=6A243F71"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
xqoNX3MQ7kNvwGh8ALQ&_nc_oc=Adky_aK3eh8YuDVHY1uaHKJW-TrZXDS703cPfvYLdT4hpr6R1tmi53FkkVj8VB_MixY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxzE6L_8omrkeA0YVugV5X7t9bLWiUV2vCudzm6XEyKKQ&oe=69B15516"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9RPIEgff44Q7kNvwG3eudz&_nc_oc=AdmKL7GU8Cr-jA3Mk5_wB_dTp_dJrepgMZC8sqevFYvlAgQRY6UhNKijs7yhLxA7nhE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy_VZbq37CDMWmuTOsSu9OLtXfUPVTpyAhm4G-LwDOgCg&oe=69B15560"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rgub2Z__OMYQ7kNvwG5x52O&_nc_oc=AdnBBWNEskdPBAe6BDcIBeorsgRDOBOnovM0atCxfFJH-a_DS2H4OtL0XMlRvY_tTW0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZRwlW7qRBTPFyYOJ21jqee05rTUrB08za92OEsU-yfg&oe=69B154B1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privac
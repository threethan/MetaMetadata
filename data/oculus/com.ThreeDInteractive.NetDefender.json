8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsn_b_sGAkUQ7kNvwHpT-wI&_nc_oc=AdqRNpsjRui2t7AXabA64a11NBI2Y1VlAoK5f_TL7UpkwABwCBNcG2AroSH-4oLOlTM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7KVpo9-iLMCQgIsYq_8RM4Q0b_xgUcHiTxZ-H9cVAxw&oe=6A9ABF15"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lixk36bJYiYQ7kNvwE1LscQ&_nc_oc=AdpM-crxxxkmGpl8nDWIFjokJMSOZf6Z1KPi_ZkaX-JJ2u1oOCdRcdbhkLhZpEPmcRY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLXeXzlO2cMQV-5gsbiCrggIRpKuOk3vb4Be25byEgCQ&oe=6A9AED68"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sthxB4DqrHMQ7kNvwGAuA4V&_nc_oc=AdovrXwJwxIr04HXNcEQS5IssLNiLm07aAZk_tMNX9A6UpMekiYbrxoZrpXXdPCpYVU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoYiVQ4t4LSV-QNmW15SX0MWyTx3jdnPULlHwi7JubUA&oe=6A9AE6D6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0Qt_Nb3_VAQ7kNvwHgmoYI&_nc_oc=Adr4fyQtyNlnH6HoQUq6his-kBKWf5YKwa8qyUFUrXYwQnt8QoEg3lDY8iOHdGUHAG8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSbSOj_JZI5kj4QV670K5fy4hhsPK-g3CO4E_HDTjnIA&oe=6A9AE720"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZYqI_QEA6UQ7kNvwFBf7dS&_nc_oc=Adrywl0aof3YA77jMpYPbQzca6tbs5U7Ajvk7emAoSucN20k3SElIbL5rwY_JpvTAzc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK99sXHksjyxANLLn6d5asacm3VjzpucISOjsl1_2sFYA&oe=6A9AE671"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1W3wTulTGoQ7kNvwHx1eHd&_nc_oc=AdqOLmNZxZQaKR_eITecVzxkRgv-elTmpRT19chHOVQE9SasPNdVxRQFk3QP5J1NxRk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2F8JcletFq3neW-rdh94vZ6TTjPGlcwyqauwdVtF7_w&oe=6A973B15"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lixk36bJYiYQ7kNvwFLSVEa&_nc_oc=Adp_KtonzOcwN6N0BbdR5v_76uBqA6MTlsi5ucPwAOedP5wgZ54_h8F10saF6hG0FS0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaeesaFj1Tj3HbgEcHDsW2m9UXIsIpwF5IdmQdd-mkoA&oe=6A973128"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xc9IYdacpj0Q7kNvwFh0gxJ&_nc_oc=AdqMGkFbnbMDplgWIr4HzUuq5MseycEk2yuEcBlKzX9c6yJeKZYblzLZWdaYCE9b_u8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjB56mUpkWTXyN-LDfN3Lw7oKQuevp2JM6xwnbuCPPtw&oe=6A972A96"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5w6H-JE9I24Q7kNvwHnnYws&_nc_oc=Adp-R96Ra6q0k4DN9QpLPkwnfceeuP-JP71TLqaHw9vRk1uu0HLLYUUK6VpLf5ZXoxc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFys42xS6X0XrAKp9osBjaRDtV2RDNPCMHn3gNvPApQfA&oe=6A972AE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjaT6QAy8acQ7kNvwF1pb_k&_nc_oc=AdqM-dYsb2-qyqPVM28P_Hh83RedSl-p-KMTEcKGEjo5KQ5W70XgxO9eVdEhzi0Esko&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECMlVBqXcCNkg2u0TwRR4E74wwvrwVJgrh90I9Mi2sig&oe=6A972A31"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgUDeLcPyDAQ7kNvwGQloyq&_nc_oc=AdohQ-OOOkeTjkXqmKAcJwx_7r7blbtN0D2v4dct4yRoT9kiTrLbNoUAOtGRLwYcb2Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBv7WdBBUlL1uEgm2crR5Wi2Jr4QM6k31dKm_yKwSEM9g&oe=6A6F3D95"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQ0nl2jXU0IQ7kNvwFAVNKw&_nc_oc=Adr3qD2YaEWnJTE5EK_k_l2JJrg-2Bo6hrRZBlxFQ7jgGjOejJ9BdlUk07tTPX9_tc8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZS3CgV8Aaquig86Bp5S7QS-RLqqqExZz5UE5E8SEuQw&oe=6A6F33A8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9R-yTjpGTWAQ7kNvwFVr_b2&_nc_oc=AdoJZak-hIcJLWNi5HdFNtV9xxauA94eNv3S9vW6CyPoYH_YVrk0h2DLjON16-3XXHc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBntajWanNQGh7B4iTSrhUYhU7_deVrDFOFml2cghiWtw&oe=6A6F2D16"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQdWQYSKcaUQ7kNvwHcw0zT&_nc_oc=AdoSSIRYzjuagfTs-6IJ0gDetq9XDLcVRqx7HeoBVFstoRivwx6uCOYNFoNZNDPSDbg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDm631223JspMSyAMOn1KwnPq8idFnCQy2azbzsK6tWOg&oe=6A6F2D60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uO01f-f9V5UQ7kNvwFu9R07&_nc_oc=AdpBGLYu_l5DKJ7SvWlgDqA7J5hTDZcOiVhEdKJQY65FZvnFJ7KJkcBvWWp4Z3qBdMY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAelxNA8eD9qBGqno9Dy4k7ZxVcCFYe1qfyTfr7-2jfAQ&oe=6A6F2CB1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
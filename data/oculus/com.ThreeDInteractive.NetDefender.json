8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsn_b_sGAkUQ7kNvwGlBTAQ&_nc_oc=Ado9B51VcDodOLufRdo8R-8Q8bztCLdLduVi58cuJtJSVbZet4MGK2_dUXWP6K0fQBw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-G9vDras_qrAh1GL-AYbnTxnlHjUaOtq73BL7PvD3lw&oe=6A985455"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lixk36bJYiYQ7kNvwHB4hXq&_nc_oc=AdqZQ1c1MiYwqv2cKfgm0ZWZifwB-Ty-DnyGunYHU_MrFU4Q7x4BL_unEQXQ9f6Uw98&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKW287MuxVwD81G2_F0oeVUN2p0xYX2ZDsDgO2dXL4LfA&oe=6A984A68"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sthxB4DqrHMQ7kNvwFaciS4&_nc_oc=Adq1zCrpfAeAGkFuERkyYuDIa9Swt1MsOjKA31bgpHaLoiz3C5XQNJPBFC1oEoVoiv8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIn617KO1Q0ue0Xqb3yuc-1v_vGVBIY49LUBD5evkVxaQ&oe=6A9843D6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5w6H-JE9I24Q7kNvwGBqcp-&_nc_oc=AdopVYBVEUGuz5FSM0m4TPSgMeK1UIomercy8IzUZlK40zLnOwD-kKSw9vADRY6g4tQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPMPPIvx6HmreI_Qv-9f2I6wssSN2P_FYqNOQMGYk8JQ&oe=6A984420"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjaT6QAy8acQ7kNvwF_lw-0&_nc_oc=Adq-u9fiR9qMgXeEtgX6nhIKQsVx_QpuJhaZtZ41zgBqYK8cmJgnhSdLs-7hVt2xznc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJh-VbiwftGQUhKIaXrK7z8nibUo_KUgaE_LWFig-J6Qg&oe=6A984371"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
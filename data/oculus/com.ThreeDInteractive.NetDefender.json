=1-7&_nc_sid=6e7a0a&_nc_ohc=1DBxf-cp_2gQ7kNvwHhdrze&_nc_oc=AdnozhosTXRPP4BIbmZiy3XAkDHZbZBFiynK2qY6AFePADwFsF1f7P5PMGc19TM7Hlk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxrwaxyJ_FzU0GMNlW2seybwyQ9pNfbQcFynSnqfMCYJw&oe=69B94E95"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFQin5QyNLAQ7kNvwG30Krl&_nc_oc=Adk_CLqf35vr8-TwmakmQS-SthT6aGsjwa44gJ138qMphBPwL32_p_rbAT6EgNkrbkg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzcAlv1gtd2UlxcBoMCWaDRnjIZBLZEooEPzOImEmwsgg&oe=69B944A8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhFgWMGh7PYQ7kNvwGSrKPM&_nc_oc=Adl_t_qpggivqOisDcq5GYg84PVxgPJRkGabETjEsGxKxBWwhd-SxVE2p2Yak9rmDjw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx5RnRoMT_uR6rKPtfjNGiaZ35cQxOt6WRq_euMTCot1w&oe=69B93E16"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0J8fOEwnzkQ7kNvwFNdm6e&_nc_oc=Adnau8BVV-vD0BmTfE6Motaw17Jfyz7GQkCK3pTOcxMOyH-WTYyhWWjxr3lgzh-s2F0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5541-H_YlzGaPgNnbCs7XGAESmGued2GHOvTxduV_Ug&oe=69B93E60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7n__zOnrIbQQ7kNvwFoOqeg&_nc_oc=AdlQqAAtu5U0UVGi01pNC3R1Syz_6z1qgj3xQP6j_h1On-ryUwkh4ZHtPYu1wlGufMw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxKSYUSe4XEU_1fII8S310poqjQwlgNXOpYKQypqppRpw&oe=69B93DB1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.
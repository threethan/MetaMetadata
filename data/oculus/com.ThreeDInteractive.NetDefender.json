8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIJmmzZeBD8Q7kNvwFNdrdI&_nc_oc=AdoadEfS9V0X6gCk_q_3NAperlAaeccqQpxQYWM01brmal2FOnKnMlcbF410KPgIVaw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIS-U1KBkTk7aKVxzSkX6cRZK9yfEMwGlFrR-HIfCvsg&oe=6AF49D55"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXP3N1ueejkQ7kNvwGXzURq&_nc_oc=Adqp7BSjPkNQ21MZM5KKKDswVAqjDf36Tt2ODeBKe5Hg9JpUJFBW6zxJP2C-0zoMan0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsjjYYo_e2lOy86pEZLADrYr_yDpEICjBBPOzdvStxyQ&oe=6AF49368"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTU5UQAqZksQ7kNvwGJKfNM&_nc_oc=AdpFSiWByVKUy3DhAd1SlZq0HaSJHJNqk172h8GmZfuROO3-Z_QW-0QHdlJc5NqCLTg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJCYU1umJI4K0DesNVkN0HDD-OnxfPN6kZ8MlSB4pxGQ&oe=6AF48CD6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTJZ_VHb6vMQ7kNvwFs7eGv&_nc_oc=Adrr4F9H_pIuQFNOeinuUE-OTO_EcSviUFA4Nf3tCdseoFdHJ5d2rDg47XPF8wJjwZk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDSZ6gJ1vLTNuUOfVyA4-220stDKGhu4UlHzQF9jz_lQ&oe=6AF48D20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vy2bN0HZa74Q7kNvwEvbkPS&_nc_oc=Adr8YU4r1Tl-XXYYNc1fbaKkj362xk7tRQspIEagaUHO5uKUK4Yf7h8gogoMq3GycDI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp2g7hbnpibEUEvum5BQyAoZ4V6ikukNvp5aLMZXJY0w&oe=6AF48C71"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
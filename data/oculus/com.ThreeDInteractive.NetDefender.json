8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1QObcXQAlIQ7kNvwHuttAw&_nc_oc=AdpkcuIfP_EtIP2ZIWVzPfRigTEU0uBSQb18rHOM8CtxOQXbZlxkzPPanTy4-PBqBe8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6plwlKIRKv3IRaEZ14IYIf2yhvgcRBXPPmKAizhzGOCQ&oe=69FB3995"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gqDiRy_Rj9MQ7kNvwGyW1nJ&_nc_oc=Adqv8r69Mm-gvJZpGHVWbGiyqYWhTkV7GDDizw5KuLm5YEpHofsb_2M12VoUZGUAymQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zEBl9tCUSL_TPqiprZugJVmvXytkdPAtJIBo_TBMdOQ&oe=69FB2FA8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNX54Ank5s8Q7kNvwGEW1Zt&_nc_oc=AdpQbE_blYtle9RtExeCnygaBN2S4sYr_wUtMQgj2w3nwHAf1ceLiKaWQ_cruwOEtpY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48C2SZEDtgcpUiaG4xlWgxArXCAn6GNDjRcR11ndCUyg&oe=69FB2916"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgD667_ksh8Q7kNvwErlhJP&_nc_oc=AdobwmDyIkg1MxA2purJheP2TH9JY87Yc-WQZfJ7oFTlvUVCv4KSlUKfnEvqOHQDz2E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AFKoGN64SNO9Q48Uq-HqcZA2yMwSuQF5o5lVgBuqS3A&oe=69FB2960"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szPMTFlfBzwQ7kNvwGWip4p&_nc_oc=AdpLMXlaoHVAujuHNw2M6_Nc8J1Vt1a87QjtJDJLeM8VwuYyZH3SbLawJALGEhyQFA8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5miEyB6yZ4gH5x2YJJ3s9zBCLLblzBt_pi3SXHAtU8ww&oe=69FB28B1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ta3rE0Xf9l0Q7kNvwHe1ktp&_nc_oc=Ado8xegppgo3WhIhjzLRkagA-AhZjDiIynVd4HpZRF4YLr6sQ6rJhhoIU0qI5eF9SK4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaNv3ItxrJU1SyLQuYR-U-choi6HTLzpLVwGw64mBghg&oe=6A7B1B15"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70g8uY8ly-8Q7kNvwEh0A3l&_nc_oc=Adoo7D1IH3LMS-iwxeNCUxGHgHgVI7tdD5dOrHHqJgAp-y6gZjD8k3MswC4bdvpHgl8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3T2Pky-2tgEizMka_1UYbRl77YdbDMliuohevo_LpOw&oe=6A7B1128"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCbh22f2Y_IQ7kNvwERbL5B&_nc_oc=AdrV_cpwpXxwcejPeb3IgpS9e8scEgCmlWzoOLv6HLlko8ORlcYYJl4I6EVBuU9gvuM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkf-NVSsLidzkGxl0dk07yfeXgLNP0DiuN7F4bqzXpHw&oe=6A7B0A96"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-TrSNTfHd8Q7kNvwGjcfaI&_nc_oc=AdoRiK5b22no51KxcYPTTs77zt2iZ4AErFFjijxM6dkwx9NEAJiUUayN0Bht2A3pJmw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvfPDlGl1jVV2KtdsusdKNIoDp2MVHr34FdbPR48AaZw&oe=6A7B0AE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f94lIIE9z_wQ7kNvwE5AEgg&_nc_oc=Adr-Dl2WwccqTuc_6V5SF1jfbjSBzjeJY3J-lFnqlVZZYMclx3v-WQ1FYlDSbCxp0nI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJKEECsl4k_ZHMLzB4i0BfmsvGig6qt3ih33IeU-BC6g&oe=6A7B0A31"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
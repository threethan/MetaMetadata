22007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYaZ6Blj32wQ7kNvwHsD93z&_nc_oc=AdoHK4BwA61cJpz2ji73QkLXZ3ljaeUyJE3QoXFj0yNoSvgIUrw0C85sRCOBIuSPtgk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CswBuoni4O-dzijyzvVGXNnmh8T-DKRzu0OJ6V3U81A&oe=6A429256"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3DfqExDpxEQ7kNvwE_1Dsz&_nc_oc=AdrZYc0Dc11HJBMV2pGrbIVJR0umTewlcf_Cy7symedmlBuZFowYf4-XPAi1AVnF9RY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fRxlwe0lj-qYfllu-9bvMJDwkjMIkYLlpuPTDZb5wow&oe=6A4292A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dk1jijFzyVkQ7kNvwHDgHmr&_nc_oc=AdordX7Yl3HpTXSU41qmU7V8DAezU8GCe4SbE6Nz1STXr08OVPqvM15RhP2E70x30TA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JU8mIj2B2Tdn6oZjXRL6Te6RphJRxy4qvi_QBanQo7g&oe=6A4291F1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of 
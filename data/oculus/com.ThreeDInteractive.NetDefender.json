8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9t_QaS0wa4Q7kNvwGyQ8Tw&_nc_oc=Adp0KgFU43ZVohYiqkVvAHTVNhRL7yc-zc7TT-6uI5QXY8GsO_K-j0HkoumYBSSHEw4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObj1iedfrneAJ8cSZKI9DgEGsKokCI7d1ZeGWNrO-aGA&oe=6AD25655"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOiILXSToJAQ7kNvwGng9v3&_nc_oc=AdpS7UnerRAixC8S2n-KrCZ1iveFkej1Uk5s7UPNTxSVOcTSMY8nviNqQzTlyKmD4P8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3CkwXv7PdEf4wUv48p2Y4jvGSsojEy-wTudOjADa9ow&oe=6AD24C68"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-ASnomsWpYQ7kNvwGF2nMx&_nc_oc=Adp0bEoB-g8hNecGB8fmtBWTQmjj_f822pZd4y_fmjqulu4wATsIkTh-XVU845erJjI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfRiU1ECRuSrPpmagxgKF6tlJi_Gs531Kv4mLk_xJkvA&oe=6AD245D6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dg7gMsJLDuUQ7kNvwFGzsA2&_nc_oc=AdorkkSSZE6vHjfisDCGBEa1Qfkr7lTP0bNzVLVHyb5rwFOAzHymZwaqonu81T-zQbo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEfbp2fo8WkIfJPEOYJy_sqBcc4Rd_9elqzGUJ6X0VBg&oe=6AD24620"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdowJLPQ4WUQ7kNvwFdj1QR&_nc_oc=Adrepa4SOdn03JXMmhjbUqBF2Ub4dcyi7gUnA6reAf_qPC6D-Wz96NNZcM_Bn8ZTl-o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyYUCq0fS-FfCV1sR1lH6ywadDNwSG4QqXkUY_kfExDw&oe=6AD24571"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
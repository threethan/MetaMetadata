8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBqGzSG4Ju4Q7kNvwEgY2H3&_nc_oc=AdpU2tyIX-nT4kwPfYfgr1OjCwrwKhAQn2ohQ8uBujT-4sHK7dbxMFbMSFZ9Q23ZdGY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZDtMnxNK6NmpRNkvI-FFn-naR4_G5mVQ89R9nkbRsKQ&oe=6A2C0115"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQi9CFeYJ14Q7kNvwEOaT36&_nc_oc=AdrY7iVJ_ZKWhkW2-saymeSSG0QW4D40biMnYCsY--DgSAyKl7Lg1XjOj7dWk7fq4pI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hndxe5XvtrpR9quxNuQbCoVTphBg-6vzsZpwJ_ts4mA&oe=6A2C2F68"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DKjeDUn8IMQ7kNvwE2X4ny&_nc_oc=AdoI-s-ckNKIzvnEaWzGWHlXmNbAVcuTxEwKiP5MPxCvIXIRkKgGccs8-8Hm6fQjCrs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0Ctc6LRFFk4RPoTGALLrqwzJPjDTSviYtgKoFxxZI-Q&oe=6A2C28D6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQB-XrsyPz4Q7kNvwFP6E6h&_nc_oc=Adoet76b0w2bqakP6eqBeEbsLZJTCRPVxhPZPcCwH_u4uRYD5mUV0m_jC-DfNpNtI4Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89IsB06fLbnQJyxNs0lnQdluIu8xzBQa0nQ0m3oIm9wA&oe=6A2C2920"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNo2xrUAjXEQ7kNvwFCQ4IJ&_nc_oc=AdoSK-dPabXaR0AnEgwCbQuz4CB2kqgfn5sgq64Nt6YRjiggvMJpwRhIdgfnbclyFmg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vhgq442m873i3g-mxYB0eBliQIO8Fzy2rbDjgROK2pg&oe=6A2C2871"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBqGzSG4Ju4Q7kNvwGWOaWS&_nc_oc=Adq8AQ3HHvDsuWu1JaZI8L21rUKpj2rdKCGCxnHyT8dX7xob46NMZeYppvQBe1BW03c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7_S9l9WEIGREzNqs44vER6w8rqbHUDFseSt08nQ_SqA&oe=6A295E15"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQi9CFeYJ14Q7kNvwHIXeuD&_nc_oc=AdoB6g4RZMaVbWyTeW2getr5nktbbuE-3wsibmZ7Y_8HYkDH-kxLDZ6GqqJzdvje67Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EitS2Iy4IZr-8Pm_2IhUeT_vKL8fSF9d6TeQ8wWrkpw&oe=6A295428"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQ4Cz2_Ct5gQ7kNvwEia4qx&_nc_oc=Adq9DUlc_lmjUQOCgBEkL_DibNTN1t0QhUatMaZd_y5EZp00wFA3EXvHoXYqt-Rdwjc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yLtFMZ2TX-tvJzEW-E8sX1M1mF-07tIuDc1iXGiLtNQ&oe=6A2985D6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOICPWvSRNsQ7kNvwHEjGqF&_nc_oc=AdrFg47oOfEtPyZmV6zrGOUNWXEc34qi_1tYDW6xiQOc65xPRrKhM5mGppopS2By3rY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_T140Uz_WSKJrZh6FUW2r2jqBUpMn1fTu1RTPdgvzeQw&oe=6A298620"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1hizWWBK7QQ7kNvwEYSJsG&_nc_oc=Adpdp_avGieHibLvjeJW-Y_kL7CLadhKw4vAVRzm906HArwHolWe70hUOkfxr-ljNnw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nSC4FaoOVMNRzYBewluUYcY_KGSL5owZN34_431yhNA&oe=6A298571"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-XwU1-NxJrAQ7kNvwHFkHBP&_nc_oc=AdpwAiWb1E2o5MSue7FjsouWM-VwtYxCwOxxw_Aqyo7eEGPwM1Q-idRolZwojUG2qrM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rNdd7WWnEv4kFJwr6p3qq3Y0KAMRVvdgcztT6gKavFg&oe=69FF2E15"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3xnl0q0ijoQ7kNvwGaMkJg&_nc_oc=Adq-Wb1mrh_lGbNvkHX8nz_IW2BJmriyPSGZWWni0FUfJBvDR3CwIILrcumbePMpubg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4O17YXTMcXYeWKyJ9BUJZ1a8Y2WFCqIDMt2nzmx_T-4w&oe=69FF2428"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7quPseQMbuMQ7kNvwEgK0GM&_nc_oc=AdpxXpC5dSZ3-5judtSv5ARUW8Ud-YeGXWs9JeIKfbQm5r71QVCf_AbbT4F3iXSmcw0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5srlijOLM59dADjlcs_4NtbXk1dXf52xMtm06iV_g1bA&oe=69FF1D96"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2uzg7oJ4coQ7kNvwEhtWR6&_nc_oc=AdqRrgY32EO0Jeid-NLuV_GgXv1RZ9luN26Shwp-ugOkSkIOQIZobi1PaV2QIh3ECc4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58o-vCCyr91DOPNkhel-Y6ZjC49hfIIS5XnMK1_DYtNw&oe=69FF1DE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PgLOyZaxfcsQ7kNvwFVfsOP&_nc_oc=AdqqZehRyLnNvYjfnw69EZQS-pl4tI6Kl7o94sNu47c9lYYVRZmIJzIQA0Tyn2dHaZw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5asalQhJbFnXbDWjIRvlIVSn45l8Fh75w3eiIJRhw2uQ&oe=69FF1D31"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
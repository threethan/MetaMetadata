8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chHF7fCwEsAQ7kNvwEWJsN0&_nc_oc=Adq_bXxYO_1VJ4r9XnybPcoPHg-NHcVyODJ1svtlrbAM192R7PSxqFdiC9_zXGFf8e0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAR64Sput7R8s1U9onblWHnVow-Df31V_rBdMl5Ripong&oe=6A490215"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lg4KYgLnwKkQ7kNvwElmgGn&_nc_oc=Adop4-Mac8MphMZoFA7CHOwLrbemTT4Wo8d7lLKKJkHOMRuu7CHXcBi4mwHZ14ZJW7k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARRtdUAUeVO6Fal5jDKHzZ0FeoiIr_qDO87dJ21xPt2Q&oe=6A493068"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XysXDNAVOEcQ7kNvwG7UAE6&_nc_oc=AdqNGn-yDH_WmtZ8RHlKprTZCEOYbGNBdPY7Ha_pz_7CKTS07s7ptW3ISufFwmKie3U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5XKAJk1yMAKNMF0rGgZcYyIjz9MzQBaHqcVOYZaSlDg&oe=6A4929D6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zifEHPhQaakQ7kNvwFN1jLg&_nc_oc=AdpeuUvZsgCEfUuT9L4zbgR9YF9JHBs4uvtCKhSmN3LAvQXo-3aL2jP5KxYpp-Y2Tq4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9YiGAg1LrYp5X6c6btlYWMqoYK6OgzvxkjKnatTyTlQ&oe=6A492A20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MFpTwjMbSQQ7kNvwEi9J80&_nc_oc=Ado5XJe6zuns5zWNjn-OwpsFnynT2aTsemjcoOpW4U9cfoT4tBQql2ZGzuCt5j5-jok&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUfluA6yPXqvLBENMFnNp8_Sc2iBo-MHh8s2IrIt9nWA&oe=6A492971"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
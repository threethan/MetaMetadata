8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iMCcW3lX7UQ7kNvwGjvE9p&_nc_oc=Adq-0n9i6JoA357xBraa5w5-s3tZbhyJ8t5cOx6hz8b1YVVimfXXCbX6kSTbMsX0L0o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91Ai5B1ECFdfDsm33Lme9ZrSZ-3urlg6grzS_9HCicwQ&oe=6A450D95"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqtL-f_OMPYQ7kNvwHCUHR4&_nc_oc=AdqKvzON-haunhKpC4FiRkwRh7_2dWJjlGzhKrNbZwzBhbptLgltaM-C9PcfhvoDmBs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cdxRnUUTpTk9atT_C6YPd5FMcQTVRc9h6Xj7ciEwMLA&oe=6A4503A8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYaZ6Blj32wQ7kNvwGeCFz0&_nc_oc=Adr-U1wSjqNMpbqswfWq355rLaJjKObxmv4kUFGpg4f-La2Mrt_1l6eFdz4tuS0oAFk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PZP9vKsm32tzT5Q89CN7wqM8lwkuYOga0P2SrAVmSTg&oe=6A453556"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3DfqExDpxEQ7kNvwGBacqt&_nc_oc=AdrHjeG9wBfYdU7Si-7zionSFBgvpiitlL3lsdSml-6rreW14Y8_UX-1j-acTenFao8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yl0qglafwoJRuBSve8uDZM2jk3Rq8qLQuRZqQ3dWV1w&oe=6A4535A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dk1jijFzyVkQ7kNvwEyK0mG&_nc_oc=AdqunmJy8TgS7avpiJvhv4RcpYtByBp_-9IrstJqmqtefI8uGEIZn4MG53A-vhdkM1E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gbqLwHsGwBgkTmCG6_wYFTwEvRwHwShW8cXX7garnlQ&oe=6A4534F1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
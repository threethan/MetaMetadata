8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFUr2V5KpVwQ7kNvwFKYH_2&_nc_oc=AdrCbVxBEmQDY4wUPrtPsFO8WvyimNJD9mjRXx49Mu_3JKDUMnaskPOHqOaVwgNHatI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzSDrJIVcHsYe7vsHRZMlK7e8fMk0P6sdlRzq2FwdYPJw&oe=69D10995"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqNi-K7mfNQQ7kNvwE7e9b3&_nc_oc=Adrri9SliENkl-mL2LpPcgQxnCxNks3db7Mi2sL1brglDSuud_SQKwzW9vDp-Qcw4fo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfygV0IHchUU633T-8CK_RC2rXgN4eNpivBG-SZo94c16w&oe=69D0FFA8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyb_ugAbu2wQ7kNvwE1EWy5&_nc_oc=Adpn1sLRkV30LD4_fvenqJhtYXhCZld0fsZhLSSRrmHRDCUQrmxqIpYqnGDuaqoMDFI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzg7zMh_XnfS5Fu58Q3Y_mo4SGSEcEmlcTsvzf3IRrdEQ&oe=69D0F916"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lx3nckT6mZAQ7kNvwEbMNgW&_nc_oc=Adp4HBdV74ATeq00fQ1iXO757Y-Y-D6uW_hvwkq5PDRJdzO7eraSH4ymyox0yNjANa8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6YpLIsbVBkocE9Ov_QoQk2s1Tog_y6l2RlAnG3Iuhfg&oe=69D0F960"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mpjv5RTAbKYQ7kNvwE-UER8&_nc_oc=AdoCu8a0cU07dLhEQ4mRNst68a5WbChyk5fQQ-uy9s8WYKaIbdLLO0SWenLeZO-BRIE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzVmA5k_Lp7LubxZ1tqDvuNSAgkVCx0T3ItJkqdoeTh-Q&oe=69D0F8B1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
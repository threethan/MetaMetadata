8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlDWWlhLkH4Q7kNvwGGux7-&_nc_oc=AdoTBEeQFMhVepgTiPbrufq98AZIAv7NgXzEfsA1Qe1RD52SxRnHsKw99gykxrcfQ5s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFqnpI_gTdUIKq5TlK1jmH2ynnnP7TSXrXTdsUN_W_EQ&oe=6A830415"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5F3mVXhqOQQ7kNvwGXYeH6&_nc_oc=AdodfpzTRL9xax2roV5fm2GGtuMoQbAudwZCNhZNH94bNYMMyEcxgr05v_sroXkZN-A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiTiU_cbIVxtoEBjmUECrrXqUV1f4Z_sV4U36olCSsgg&oe=6A82FA28"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qN924y27XPAQ7kNvwE7_-1F&_nc_oc=AdrRGClh3TQQvHbfxArgQ_T21rOj7RFDW6nHNGlE5-GpNSyRhM2gE8bzTgpHz9njc4Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFe_5hzWLR9yJV-FXZZYame9y9gUEBaehrYviHwt_vxoQ&oe=6A82F396"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_p3Dvt39y4Q7kNvwHmJ7jg&_nc_oc=AdqvP1GluBdXh5mkooWrGwYPwFtInMPrsMdAszcf5FhICuLW3mS5-IQsN9a_N4I7U7U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2YgdigW5YTv53bDrUjt9w6Z2DjSBAEWdVZn0RXPq0AA&oe=6A82F3E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9R85aXcXhUwQ7kNvwFqN952&_nc_oc=AdrNH0blmehLGFWq6LzbhQt7gsfhxFfwMD1I5pwbCG__VcfqmbUdtvdjwWr6Y8PI4oY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHlRL93jbCmHXERIn9RjKxB0v5Xpfj1KzSuMKRjiwAIQ&oe=6A82F331"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
4GddJ5VjuY44aOQ9NxwxN2t5ULvzDpN0pZDOxA7ENLTIebP54D9cT4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs1ZQYA8AMYJ5QTphHTpgZoWOw7S4m783O7woWGHr61MQ&oe=699AFC15"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFsyzPGCow8Q7kNvwEeE4PN&_nc_oc=AdmKoA_MAhLUcSAUNF_4v-mffs1ynr-6eJDqD4k9ZdcDcnPGRW9WeLTKnOLX1_zLYis&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afud6TJhgn2n6y-58Hy9dM2cgkVIaW3S-QvBI7M3abXZbQ&oe=699AF228"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srFmwNkOKrkQ7kNvwH7HhWc&_nc_oc=AdkkbSBrH_Xpg4p4kJXZIK_s_O7wkFuvCcC-RcKm1NZu0Sez5myZu7yFor9U3mVp000&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afsu1f-G12enESd_n4692KeA-iJ6Uu7PCa827vOa_8fgiw&oe=699AEB96"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRJmMpu2QzoQ7kNvwH-g2gV&_nc_oc=Adlm1TjeEgG0onOd4b-OeDoDc8H04aQSX0EqpFWAVbJLYFs8Vxe2qUi7Wj93-S7FxeE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvGo8x4-SgAa6QP4-Vt3mduyD95fUKSqr8FfGikGLkQ8A&oe=699AEBE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzfgLtXRci0Q7kNvwGxpttn&_nc_oc=AdlBAf8QUWjIjMabdoP-pVrND9WCON5ppVfXvn6CDuepuVtYP20HkMJ_KGaPyUfZCAg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsrOc__GbEtkU3j9PhYI30yHqTTNAVT7IuKRNpw0GYvoQ&oe=699AEB31"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371511_182990337983422_1813415391423379401_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1
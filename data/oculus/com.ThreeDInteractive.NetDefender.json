8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVAbV_9Rc1EQ7kNvwFanP_G&_nc_oc=AdpWiyFrz3dE0jJ78ot2bIGZ9nr-OuNKRAqmfKBt8YsBrdYcVSmpkh5Wyh1qzVmmBMk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWWHvZeGoKVrOC1YDeFjqlzW-BkkRAnxioHhJpEnnUow&oe=6AF0A8D5"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99ASYPJGt0EQ7kNvwE0SQCA&_nc_oc=AdpTj0zmZp3pB55WGyVRQluBGacCU6SmKqR0s_6_p0Ni8ZmvNeC8wtjdbwZxnyZexlM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0flLkNq8_XmzRfBKkOPaL5iiuJy0q1H1KykScA6FNEA&oe=6AF09EE8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mh29XSL_3DoQ7kNvwEXWKCm&_nc_oc=AdpMAZh7pNih2wMCNen0vnd5kG-0shSGLOpGYsUenOjSqVKVTLJ3CLJL78QuBn1aZi8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0pWmC6q-bAeSTGY-bMTIuX-OHan1n_5WFfOEAVNxhBA&oe=6AF09856"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nA2XL4yrWNwQ7kNvwFS0R8s&_nc_oc=Adq0znBYKCLX_kP_oNfGH68jCM6xh5ZZmdTS2quursHlJkqbL8W0EgJZqlhlZqg6rC4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTc38HsGAA84aU7xaYe3C2Q9t7qOyJ1HiUs2HuUJ9EueQ&oe=6AF098A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_i7jIuAgTNQQ7kNvwE1mcbt&_nc_oc=Adp9uYtBOTnmmYn_KviUdq1JYCu2bWAUIQAAh-k3Jv_dwXbbD9SiiIkCVENjYOcsRAg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTd_Qn24cAU3GzWiGy74HQXTjd--UuBbqCkY1YDD7Pz5g&oe=6AF097F1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
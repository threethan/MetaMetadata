8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVQS9jxeVtUQ7kNvwE0LL0F&_nc_oc=AdoHe61dP9Zf8enFiq_RZvScqzjVU9NdMiMj1ef_twr0zUS0gTWkKy7pjh7Ya7Fqjh0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GdKZBL2wQFTEw81RBkZvdTS4Gs8rM4LRpayD9b8v8Yg&oe=69E22D15"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRNYGVZ2wb8Q7kNvwH_WUf9&_nc_oc=Adq8d5GWeRb8dCu85g505bOtpJVe9qlUBDov5Pvnb6MTdRZPJuO7UGA5B60xNglDf6A&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RNW8FEg4GrOXVeDY8i2LRXdKfPCSfpVr4YII4v7eWcA&oe=69E22328"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0SPdOb3YvoQ7kNvwF93DDs&_nc_oc=AdpdWv_8dMAqNJ5HVmndNq-rlIuibIS2OVBtRaOsbolOKOiWFV7KAts8oQ3bO_ktfy0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jZHdwjJouvA5jGJcGN-abgJ8H19hKzYeUhPanWt-5_Q&oe=69E21C96"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKbmyW5sGJEQ7kNvwEGV05A&_nc_oc=Adq9Ql8L878syjxQydghS-I90A1zeaLaSTD18FeV8TpJi6_s5Xfj_22nzGROLTspSIg&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2obN8qrC0ZwPHTLRJ91gL9LJ73BuotTmDOxBNfOmWvqg&oe=69E21CE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHAE-Rnv3KAQ7kNvwF7tk7S&_nc_oc=AdoUVCUfzhyQsjbPfX1zbqKIkBvoeg8Qm_Va7PWOnwckDt8YoYLilZvj7CWe-BhjCZU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZGKgojNOhGIe5_vIATY6JiM5QAGOKrSPRYyamFHF8Wg&oe=69E21C31"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9sxbuVYfAXkQ7kNvwEZe3Fc&_nc_oc=Adrv5_JMU64cf4PqWQbz_kXjLhjydXS40hB8dz0gIVdm1ZjobzMLyBHUnMk_vAkWYnA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhnlmhEYMfKXViX7A7ZhmtQmqQbEPIMAHWsPuCwdlBVA&oe=6A9D6215"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3L9gt6zy_EcQ7kNvwFsxT8P&_nc_oc=Adp3Q3nR7YRfHR7c8knkUxFe39ebsnzdiChZh-k4u3x7yX1IE27eRiDfRfpcLG_PZUI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJwjQgyR5IqL406fz7mRHiZKDVoC9h1xTmmtSF5M98Mw&oe=6A9D5828"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nU9do5qgd8oQ7kNvwHJW5ri&_nc_oc=AdqQ3bt4s9UiLpiq4pNckeoi04BUK-R_-nIwrOSFUj6ledl_kCgtPPV45E3f_P-5Wmw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKujc_ItcJRYBwjcwDWI9q7Nlki215fvGFaWp9HKvkquw&oe=6A9D89D6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1LFG0wJnASAQ7kNvwHiBfkA&_nc_oc=AdqAPWzQ2FmuRw9Jvso_RXKo0tykcD9F_--UC2ACIJ84TmAlGHaCBLZoRABUxzqEYwk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbYPXkHmLelfGmAqcdykh9feTulMdnDnN_3ruX_tNE9w&oe=6A9D8A20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTj1fAkBLMcQ7kNvwG_cecq&_nc_oc=Adq5oz7u_tOsrzVWihKRfFyvWH-1mGuILHLZbb6Nyou5fJeRE2r3yf-qBE5s5dFh-SI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNFIjSMDyRO_I16_Xfg7_Re_aFyQDuYVms163oaY6anQ&oe=6A9D8971"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
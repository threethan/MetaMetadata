WGjsymgPd_DMNzTSLetV32Vxr1TqyRzrw3XDXk29dV4FdEtZj5noUs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsXE4KZgqUx-PcgusMtqjPgbGcbPg82fAglTtn7qix-jA&oe=69A2E515"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkcSJgbZVsAQ7kNvwGWY90Y&_nc_oc=AdnSmzpne4DmwvFL-ou0Q8hfUUYpTsDE1UBVnkSkRQ91PdEnfr3Cn-h8HkI98TKW7mQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsAV_LKEV37aXMoLubLlklltsn6Z7JDFkHkq7PFOgQigQ&oe=69A2DB28"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wr9eV1mT8xAQ7kNvwHUfQa8&_nc_oc=Admh3nXQ6_JOqyVedocPehNMNJF9kMI7Q5kthH6KR7fWD01rlOR88vlhKuAAklsV7K8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvynu1RVzKBmsJ5T5DF1l1qt6909Pq3s0waJ3wFnUJUDw&oe=69A2D496"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3z7Xf_iI-kIQ7kNvwHYEUoB&_nc_oc=Adm4aR6K-05zHUL362G_wGw_vfPLPfVKbbi7A8HzPC55aL7uyRN7-VOBNib9TT-J9ms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft-ihzwJn1pWwFrVKDl1bzs4CFKCff6NOUg5NayLM2SNA&oe=69A2D4E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QmbVZAqCsEQ7kNvwFF1783&_nc_oc=AdkvaFVpgjC8WVW9biNM4XQkSeSJY34EzHf0zhiSRY7cgcXXKLYBY-Fj4LaMcvFO-U0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftzThMQSpRg5FYvvmLaUMofnDCSwJDTzxEcq3bF7MQcbA&oe=69A2D431"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75371511_182990337983422_1813415391423379401_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1
8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTa1cofyl78Q7kNvwFWefG5&_nc_oc=AdrWGdqQmVp6jiZdNi8OOnWXb_DwzfuvIn9Qz0x0aGLVYz1m7W6FiyZKCJT_x8Ftw7c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlzaOFYgPvjjcAl5HIxCoert33UPvPKpmUFEU_W1_b2A&oe=6AAD3415"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmJtqcv9xxUQ7kNvwHwd0uL&_nc_oc=Adqz9WrsrcbF_ZcnGZ59Qc_Mez-57HbNXe9GhFC2dWUzzmj-7UlsOx77mZ64kv7EsdU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsO10udf2Bz-piRFEjdkF9d5zPedbUbKMnX3X1cnBJdw&oe=6AAD6268"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIE8kjqssegQ7kNvwGV09Yv&_nc_oc=AdovOGZB7m-pplXgmmjD6CSFS9TFRqxkiNi7gsUUJOxIZWelTSmsSCrt53BgUTr_9W8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJc4Spy2ksm0dx4WY3Xf_PnpSOaGvf7O-iMihcvpcl3sQ&oe=6AAD5BD6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7Q0tmWR7isQ7kNvwFnJthQ&_nc_oc=Adq1YasjQ4bhy3JDRTGqWspnCpOnS5wMNHZPxproHJeUUr51CU8HjMbzdULO3_wvVHU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkjkqCwnmb9pQj0CXoKfjtINrWKU5y3amh8Oh0SyUTww&oe=6AAD5C20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iskfqx9k4WYQ7kNvwFCUES9&_nc_oc=AdrX1Kpn0FEb9KVCONKSVZEJ-idTI9AgodbT6ePeJFeikaBOkQzhNxa1i21CZRw7py4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8FFx50K3xb3Tuz4ogktsrapFE6fAQwVWn1i_BtnWYxw&oe=6AAD5B71"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
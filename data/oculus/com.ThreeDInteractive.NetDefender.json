8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tua7UQm7muQQ7kNvwHvyqAh&_nc_oc=AdqEpVB6kkO7JdD1FqBLlZGcYZSd__1735ry0xXZLmCEtIpfp6NZbeA1i7bpREvNYTc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uY9IQlKBOHU74xkB-P2NnCw5o8Xpgtk-6JcQbfYxO0w&oe=6A26BB15"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvoX1neggKEQ7kNvwEOJTZZ&_nc_oc=AdqECvkQ7vULfOZ-LEqjs05aq9ze677ldYBFJdfGMtupuutZEAZoXw0xU7UrsEEOTJo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1VQAcu7OYkF-1kaBLY0Uk-lgiFnN6EGy11g_BVVrUUQ&oe=6A26E968"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQ4Cz2_Ct5gQ7kNvwEFtsMa&_nc_oc=AdpGGQb9xX7htZjSTz5sZxKue47kmWet67c08H22QrUsZukx1bxb4QBz6Ov8Z-Jd3XE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6zpfxu0mX8B7Waqn5S6Jv5bw4eSWGbNo2jUtWtWHkTQ&oe=6A26E2D6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOICPWvSRNsQ7kNvwHRDKqd&_nc_oc=AdosoUOg9IaBhzHgBX-G81R0d9MYzeXr9tIMOX1nWRQbmei-NEPodEDZAj9KlBRz8nE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RaBkhfjq9_z-CbLnkI7AgERFxVYnXhoUZsEchWK-LZg&oe=6A26E320"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1hizWWBK7QQ7kNvwEQ3eVg&_nc_oc=AdrihDMCQ_SBpKp8Q2uXP910Rv5k_Qz78xJdR31Ewc5q0o84R7Wrqv57GbquuvpTx1Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-Rwv91mB9Y-xS1MiK6pqL40pbU_zEYWT-arbO-ihORg&oe=6A26E271"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
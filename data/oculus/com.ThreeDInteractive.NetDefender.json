8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZnjgQlCn90Q7kNvwGTC5Oq&_nc_oc=AdrJHSoLApxHIxP3Zq6rDUqAfsFPlyNBWk85zt1UY7UWxMI9SgDFbVxOz4hG90IhVbo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66pnkKJHNuvgvQmlX9LLZJOoST19jCksHzUPYOyqj7fg&oe=6A032295"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8aJHawlnakQ7kNvwEGFuVq&_nc_oc=Ado5DEATIaSex8jtoqN8QDnE5efliN5l6GALFb53QdDog4vYcQF10ekjX99feR_wyLY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65c0sE_ZTtBZhwH7CGy3Mrvy6yKpOmZyoyODJm3jvcFA&oe=6A0318A8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXIkIJt93wMQ7kNvwG175TW&_nc_oc=AdpvkjfuWv-s_u2IBfGjcL6QgpnNAFzZYEok0SuK4AGTU69IzbWlNRufgKt-vHOel6I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eXGtNYni9GervvZR5kgbBYFDxH4QnBWQQksgRgW6H2w&oe=6A034A56"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAoD7-uDXRAQ7kNvwE6Oen4&_nc_oc=Adq5I68gFxc9CI3KOFhFupjC3FIU3bQAlO8z-RXYs1qIBoJRkv-PCrX9BCMlHS6T9lA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Xc3IbM5EJDkF6zwI8LBhKmcKnMhqHjYGTgzqAocA5SQ&oe=6A034AA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgW61p-8Nh8Q7kNvwEH73hn&_nc_oc=AdoQ4QAQo1LpYGILarODMQ3SaeQzFmS3p_wZ6I-n_sQuoObMqgBEYBUHdN2F3vrDSXw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47GhxL1GupQpfN3vjLmAPC8uPoPt8ZrMN0X6NtZ2DkLg&oe=6A0349F1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
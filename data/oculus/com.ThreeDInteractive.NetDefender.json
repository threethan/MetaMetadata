8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fO8ofeDcrsIQ7kNvwFon3oO&_nc_oc=AdrMvU8Re92kaSW7QMuPBBk4A9oVhI99MnubiqBOY0L9IyUTLFTuvBGmIzUKsSm6IJg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsr-Cq7CFfrVtIguHMyeHafZzVxLPnnmc8j97pG94dIg&oe=6AB27A15"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ODgjfmuQpQQ7kNvwHd_Rw7&_nc_oc=AdqeGwORiI7VrLrAWvfepg2NMZJoxQOKHQ7W0kgJ5ch7OH7AZacS0VNwl5k1QG7oMTc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzSIVhv0aKSmhumQPiGOEvYeAjMzdgbVC9zuKRQqHneg&oe=6AB2A868"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMTohm9RxbUQ7kNvwH7KIOw&_nc_oc=AdpJowD2AYjo21NG6mdfAX-dZVA1cHG5w3ivqKhr_CWGP7c2xHrrPfC4uLeKidR6wn8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8bR7jV44XqZ0s26rWXO9GSXpbfJDjoiDCLmICEUz3jw&oe=6AB2A1D6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ow-8p72slYMQ7kNvwH_rQMD&_nc_oc=AdoKhBWPk2vWgWXqWNeUTRohX8azBCGKBLmdU4Yf8rFkXEcScQdEWbOsGt9tYoaXnOI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSGX8oNtzjC7tj_dHuAit_IZcLq7r2vqL_EirwiPKhMQ&oe=6AB2A220"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSrzcZL5fuIQ7kNvwGHpt_C&_nc_oc=AdpXtcZrQGF3t3WKcrIlG_sefeb7qR8U937YZ1cxoO3uWGsUtx2vEtTfLHAGlTC4RZY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKd_nqiAZEy2PkUWXVeHz0D_N4nNuUIxIbxrwbFl9m4g&oe=6AB2A171"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
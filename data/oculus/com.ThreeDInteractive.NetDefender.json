8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1Ohhgo-HWEQ7kNvwHGd92B&_nc_oc=AdooP7HZDjzd5NXNQVzXi87XTTRmGeJ7qvL_kfLVARdKBf5Aldzp7KKpLDTU2bZWEEs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25bncYjZB5siGQtuuEjvfmX0NZ4c8vMNHJEctvO-Tq3w&oe=69E62195"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBN5OU0cuzEQ7kNvwE-Agle&_nc_oc=AdpXecrvt-Uaa4JZhqjqb7MKx_VpALHOxuVA_5unCjVkkHjn5VUPDu0lQW7yP6rMSHU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3W391PzTL--bvgzT43DQWc_RSsBZlLkaYnhGisrDjwzw&oe=69E617A8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UmtqPSeOrUQ7kNvwGgd6mV&_nc_oc=AdrlHIAXORSp_0jVxQ_Bh-Khh02_NEiZWkveuBxzzyUwtiQ6dL5rLXNidHLzWnFdLXQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gkpvvFgMvvFMSi3FttiQxXvLGVU22KBP1AJsUrXOMwQ&oe=69E61116"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BdT9kt0il0AQ7kNvwErbhqN&_nc_oc=AdqnMD9iQ9SyUrsQjzRbpXFJkjKgQfXvE15Y-Q10Y6KqJ4H4UjeYUM_-9oI1POW1fLI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RirR7NZCa-LFhE-NBx943fb-gNNnTjllvrkTmwsEZgw&oe=69E61160"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cydAo5xFnCkQ7kNvwGO1kRD&_nc_oc=AdoZLOFhyQ41skYFf-4VCkYmhCOJtCTFzr3gXN9Kr0CIsewVbHHmWlB2qKKEIJ8xv7o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ybROG3tBCdrarDk630R1RZ2_fCNTdjubXZMCnb7p3pQ&oe=69E610B1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
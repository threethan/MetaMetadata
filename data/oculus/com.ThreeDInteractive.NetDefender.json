22007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2ruqiZy-F0Q7kNvwHx4ppP&_nc_oc=AdqRHSbeDmLJCSJAmfNtC2pEgDwu1cr9J3iIMMMRWSV6VHu9U8FTsw7ilj4-UjbWNdU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7E4JBjG3va5Buj-6xmTn1QQwhArIjcRhytEemsmX05JQ&oe=6A09E1D6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63Q2hAAMoBQQ7kNvwGCDmbX&_nc_oc=AdoD7Hv2WmhQ2otGwEEIGgwTdPDUo_mKlcy-1Fdffe3b8U5it387a0QKnM8v_vgE8-w&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ky8NJTPjQYYxcoqXgFdLKnmyltpFahm9-7K1-hGh1Ug&oe=6A09E220"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmFA30PIxTUQ7kNvwFJikc9&_nc_oc=Adp7T-LIKNqPq5EifwlPVqcS6IJWYshmGSRkTrZA1CeuT_W6NHjq9lk47BWpRP7H9Go&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5f7N6T4BciCp659kPXiHzeqnS8LxUvGpeOj0LUreJDNQ&oe=6A09E171"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of 
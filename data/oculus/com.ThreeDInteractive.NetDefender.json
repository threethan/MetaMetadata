8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ta3rE0Xf9l0Q7kNvwEwjVSF&_nc_oc=Adq546a5hXF3hmZC-iC6yB_FprFYjDjOqM9TVWPxcpvMLUA7_-5FBv9aDVHQJ5RYs-A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESiHKIbd6k2SCi6lDgYCHOFBEeR4C_yZIAAJW6nT-Hng&oe=6A787815"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70g8uY8ly-8Q7kNvwE23Ldm&_nc_oc=Adr4D_QU6eQJKDD7Bfn-5rbzPRsUCwUmWblfBaIlc84J1AOWrBY-Z89IiibgWFcbMhk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlNJlSdh0oHlYW2KCjmO1OF6KCWdNV5aygVhxkZyUwTg&oe=6A786E28"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OVly576AwwQ7kNvwEzq8AQ&_nc_oc=AdosvJsH89dh09P6C1PMKNdYd-fSWZmGZb4x0ZAkTu90jb0xfWM5wUOJ2_xUFlVCHXQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjR9iXAcdvFa3WN4C7BggF8XWfkT1czODR4b8LYPJhMg&oe=6A786796"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxfVUrx6bp8Q7kNvwF2BPc1&_nc_oc=AdraadMIDSX7xvCtew1gwVH9PBOel_c6rQ0Q_bhxmKKLJMOrS-IVCUAGrhSHH9eQTvI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpa1wpLQpFaTNF6DZDlQYRda2JlDcpbGUvkTu4gxPHLw&oe=6A7867E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrj0fzO1itgQ7kNvwHHcyqd&_nc_oc=AdrxVrof7AAUn4PCla56K0KLDAQKmvEcVANUfZWIuAw55rjr8u3t5_X6CosolB0a9i4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpUdF1lhhML_7SHS1YKkj8kw3lB3XAiEiRw0MIaxe37Q&oe=6A786731"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
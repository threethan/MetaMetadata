22007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFJLFFh43vAQ7kNvwGkOXci&_nc_oc=AdpfWe-kwPn9HJl_LfqvIB30uoTHGuzLRpkJP_pMItPqgl36pCmJwiucT8kv3X9CZTA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TG9e77ec4VNWm80KMpFAdnEPPLhcHn4Fa1mFm_uwvwg&oe=69FA0FD6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_QhEaHw91cQ7kNvwHu_9cm&_nc_oc=AdoKg6vooygr-WcJW0FVqFr8RHuhiXsobIHCra6yshWJujqkNBw_iIy2XoOqFsQizkA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af536-Q2Y_D6-NikGbMpo8QN2raIoM9gQa6lL4UdopP8Jg&oe=69FA1020"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8U_btoe9VrYQ7kNvwELplov&_nc_oc=AdrdKxGbb91Xsy9zEtLRGeFYIPq4SeKk-gIDR43GzWjkobm_EZNmIyW3emfBKjPRgoA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bqBmVQiWCdneTI-etmyayWi8iCI34ojIRyrU0IuptCg&oe=69FA0F71"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of 
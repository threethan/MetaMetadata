8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePDtJZEWZd4Q7kNvwEXJ5ac&_nc_oc=AdrVi49M8G42e7ht2TWDXFj-eK3gWSu8r5Pluz686KA7VNBZtDZlXVKbOh-5bezYfGg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qexdmbH4xIdn21wzePyxcqUVsupebq-YTm68l-o5sBg&oe=6A071715"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47o6nkKb8PEQ7kNvwGtLaAq&_nc_oc=AdqB-pC99vADf3HcGRAM7qJXH8Vko7DdgiK4F2_HVWEzUGY7ajxZswpDOy_D37S_9gc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iWjSV7nxMa6PXiELb7SELrePetwqLUpnMK6njFraTGw&oe=6A070D28"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2ruqiZy-F0Q7kNvwFdJ355&_nc_oc=AdqKbIH5Y_Gweh48hkMmWuJWodWU4Gb-vjiHy4Xjkgg-RUHe-fCitk3FqiSiEhEs-II&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RmTda86ytxsNzUl2slC7FL5UQwTD0LBHSHj17VV_ZQw&oe=6A073ED6"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63Q2hAAMoBQQ7kNvwHg34pt&_nc_oc=AdqpC4Wbl69NifTg8koZgzNvg1O7bEP7V0DEB7vqP3Hkh9SdysM_CWNughEmyn2m8j0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4o6Tw1_d55tQSDrpL5quLG9EwNx0TRsEdW7aoVPS02Ww&oe=6A073F20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmFA30PIxTUQ7kNvwGYIlFR&_nc_oc=Adpn2vKmsQg3BJW-JxqBtSRHQUtGtd3Jp-P_V-VkNv5-YXjZEo2WTA6AdlnoKlP1yNQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FNIsEq59Fxx144evYgbjkNTIbBPAdKsg-f6RQ4v0KsQ&oe=6A073E71"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
8516197604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sie60MoJuFIQ7kNvwFQj6Wq&_nc_oc=AdoCHmt7fitRg-RpGeebYZ0symPbcL5UDFaiNdKc54eqBnY1JyqxB06LByYcxdggU7E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCXiMuzPMtmlN7dV6isaF34fU7AwHmeydR9wxYaS95jQ&oe=6AF891D5"}, {"file_name": "screen01.png", "id": "928348535172960", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974779_928348538506293_7020189532290350247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Asr4c0vlUxAQ7kNvwF9Cu_6&_nc_oc=AdrF8BSgIu9xyrbcyKAkAAy1IifNevyaINScZeXzWhdH69AM8RXIeFwkrcO2vMxiFQ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0A0iEncY9yXXL0sdEnQRaoXKSttv_vw9zeVjzDECF4w&oe=6AF887E8"}, {"file_name": "screen02.png", "id": "1107224366864416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=suyMKAha2xoQ7kNvwHRGZ2c&_nc_oc=AdoqsrZJcMfkHioffEGJj8RfCAsOpg10sl6P5cZhHfZoVEulrETL02pjpypOMvxJwgU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZXd_SgIZqkctf2Ul6BK2E0w0z54ODKgobBW4GsU5dmA&oe=6AF88156"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y61BDmjj2-cQ7kNvwGTroop&_nc_oc=AdrD7z5KcejCoUJEyE4He5RpJ_lrjw4oqnL6Z61va9r7QxX9WJnzdRFyIMsEubdoF3M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUNYbMbLfMGr41ZS6UNisedEsTz3FWpQBqJNsnMWmeoA&oe=6AF881A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uo9ytXJ8LyQQ7kNvwFBdTl8&_nc_oc=Adry6Eqwaci8r1BHlODqQTf-7KSNO9blPvCU3hZJGak5e9d-u5CyN4K9Johtgn6wLPY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjHLRD5QIaqIgJPmBanx4SiXE0GsLynNyo322n2NAdiQ&oe=6AF880F1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of being on the pitch and improve your reflexes while having fun"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dinteractive.se/privacypolicy/NetDefenderVRApplicationPrivacyPolicy.pdf", "developer_terms_of_service_url": "https://3dinteractive.se/termsofservice/TermsofserviceNetDefender.pdf", "publisher_name": "3D Interactive Sthlm AB", "support_website_url": null, "website_url": "https://3dinteractive.se/en/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3469137276746284"}, "review_messages": []}]}, "co
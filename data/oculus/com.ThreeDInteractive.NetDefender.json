22007_1107224370197749_2264043245924574786_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMV2i0Tj8qkQ7kNvwEK2cCJ&_nc_oc=AdoMHadlHsAEiZqH7yjkqBF0UNSfPeWdDrn6e55M_j1A-_eJDg7xQyQEDyBDaBeLV3w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvz86DpnJCSuAVngN4hjCYVk_QZLClDWfhVRb8RsjgIw&oe=6ABE7F56"}, {"file_name": "screen03.png", "id": "975096360296177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404382_975096363629510_659015580431631843_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsZvxqaywPgQ7kNvwED3dAA&_nc_oc=Adq1fBJY7lI08CqWspSautkA1WTT34rv7AtYjOocDsvaZKQy-Qlticyw5UKRiI6RDkw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHkHYCz1Kwj-wg3BOx4ni7IUZ2PuvSWe3bSXyKHBwMsQ&oe=6ABE7FA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_Thumb.png", "id": "560244449425258", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031645_560244452758591_8781739990437323558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORCmTVX_vCIQ7kNvwHAOrrU&_nc_oc=Adp7LH1ckbGOtp20lHc1wimCc6Cl1QBxBNYPr5B8ZJDhtMoKVQyVu5RuZue-iWNe6iY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxwJhJkOsWbelZwoutZ4JN2FO8JiagYpmOBGBxI_pLEg&oe=6ABE7EF1"}, "display_name": "Net Defender", "keywords": [], "long_description": "Net Defender is a VR game that lets you experience the thrill of being a goalkeeper in a futuristic football match. You have to use your hands to block the shots from the opposing team, which come at you at different speeds and angles. The game tracks your movements and scores you based on how many shots you save and how many you let in. Net Defender is not only fun, but also good for your health. It makes you move around and exercise your reflexes and coordination. If you love football and VR, you will love Net Defender!", "short_description": "Net Defender, a VR game where you play as a goalkeeper. With realistic physics, graphics, and immersive sound, experience the thrill of 
scdn.com&_nc_ss=7f20f&oh=00_AQQ8A2tP8moz4-StbPAvwCizvwlJ5cMSFmkinb9u1iVPPg&oe=6AF8A2B9"}, {"file_name": "bedroomIsam_aiming.png", "id": "465173675167441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036675_465173681834107_8186388931955346379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dErAwMwKhUIQ7kNvwFWEaql&_nc_oc=AdrwXEvOjEeS5XmoQi4D1r5WhcWIgsdMX1pSWV9xaGcu_DAKZxLeov6fPEx0KlBh9qI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaVeWO5U5qs-agjYk5pY8LJWJd8ZZgyiBHJKLY_ezRDg&oe=6AF87FA6"}, {"file_name": "in_menu_start.png", "id": "598779101213293", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566695_598779104546626_431948362914051546_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqCDlpUAWeEQ7kNvwFHMxTF&_nc_oc=AdphKT0VmMDrO869xrkOqowtH1lSLbrpc5YxCRAhj3ew4oGWe8aUxmGGlXCoyI19kLE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsvtUj_lfyN7Btb3CxIgioTmL-lhCaZ8nv9n0e5ZSInA&oe=6AF8A429"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image_00000.png", "id": "1082031439221611", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610703_1082031442554944_8389638920817316209_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npYDYJP9BV4Q7kNvwFiDVL-&_nc_oc=AdqQHwbFeiK_sIY9WBWseVjqrE9SIFzSnaaWO2jEdmr_D_F2V37ytMX6w7G7MANkUdY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBCCMXhmjeGnmVJoEl1bXKD5KnuL3agOUsCdzwNOqmWg&oe=6AF898D1"}, "display_name": "RealityViewer", "keywords": [], "long_description": "Experience virtual realism as never before!\n\nExplore beautiful locations and real estate properties in 6 degrees of freedom and a visual quality that you haven't experienced on your Quest before.\n\nRealityViewer is a free showcase application for our virtual reality conversion service. Using our proprietary technology, we can convert scenes from any 3D software and any renderer, or lidar scans of real locations, into highly realistic virtual reality experiences.\nNavigate through these virtual spaces using your Oculus Touch controllers, or even directly using only your hands.\n\nTo learn more about our conversion service, please visit www.roomscalestudios.com and get in touch with us, we're looking forward to help you!", "short_description": "Experience virtual realism as never before!\n\nExplore beautiful locations and real estate properties in full 6DOF and a visual quality that you haven't experienced on your Quest before.\nRealityViewer is a free showcase application for our virtual reality conversion service.\n\nUsing our proprietary technology, we can convert scenes from any 3D software and any renderer into highly realistic virtual reality experiences.\n\nTo learn more, please visit www.roomscalestudios.com and get in touch with us!"}]}, "developer_name": "RoomScaleStudios", "developer_privacy_policy_url": "https://roomscalestudios.com/realityviewer/realityviewer_privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "RoomScaleStudios", "support_website_url": null, "website_url": "https://www.roomscalestudios.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "744757656901344"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []},
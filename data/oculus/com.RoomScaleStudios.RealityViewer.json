nExplore beautiful locations and real estate properties in full 6DOF and a visual quality that you haven't experienced on your Quest before.\nRealityViewer is a free showcase application for our virtual reality conversion service.\n\nUsing our proprietary technology, we can convert scenes from any 3D software and any renderer into highly realistic virtual reality experiences.\n\nTo learn more, please visit www.roomscalestudios.com and get in touch with us!"}]}, "developer_name": "RoomScaleStudios", "developer_privacy_policy_url": "https://roomscalestudios.com/realityviewer/realityviewer_privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "RoomScaleStudios", "support_website_url": null, "website_url": "https://www.roomscalestudios.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "744757656901344"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4700319633355806", "version": "1.0"}, "id": "663075168434677", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary"
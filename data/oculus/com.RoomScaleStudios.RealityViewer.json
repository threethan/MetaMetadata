_name": "bedroomIsam_aiming.png", "id": "465173675167441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036675_465173681834107_8186388931955346379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSZXrSpCPTUQ7kNvwHK06Ac&_nc_oc=AdlXoc3bY1M5zzihbosGhYEv-t1owG_QvyeDAveXp7KjoYCzYdLcdZEldTW2-04MLcE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxpnlsAMqmlO-AHQEIJiQ0paYXYQydMFMGtwMGAW92xVQ&oe=69BE8266"}, {"file_name": "in_menu_start.png", "id": "598779101213293", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57566695_598779104546626_431948362914051546_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3ymh0dYfXQQ7kNvwHTn8G3&_nc_oc=Adl9DiH0_sf4B_o7YgDkTPfGz_CM6i1gbFKQIVbUkJvbJP4boYicDj0Rf1qF4yquITM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwqFS7waXmmC5CVCn_ET_IdcTbkP8tyz5IxrEBZPdsf3g&oe=69BEA6E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image_00000.png", "id": "1082031439221611", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610703_1082031442554944_8389638920817316209_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvS57-CcxZ0Q7kNvwHYSU-Q&_nc_oc=AdkZqCoONR4VCHnt5mhBvaghslGidbBuM9Fvn_T6uPYcNIr6qQ9ayFAVX5ni60ae9Hk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzeUGprG_lDyJOVmKW8KPYZSaHclqqrcBqKvZZGdgvsaQ&oe=69BE9B91"}, "display_name": "RealityViewer", "keywords": [], "long_description": "Experience virtual realism as never before!\n\nExplore beautiful locations and real estate properties in 6 degrees of freedom and a visual quality that you haven't experienced on your Quest before.\n\nRealityViewer is a free showcase application for our virtual reality conversion service. Using our proprietary technology, we can convert scenes from any 3D software and any renderer, or lidar scans of real locations, into highly realistic virtual reality experiences.\nNavigate through these virtual spaces using your Oculus Touch controllers, or even directly using only your hands.\n\nTo learn more about our conversion service, please visit www.roomscalestudios.com and get in touch with us, we're looking forward to help you!", "short_description": "Experience virtual realism as never before!\n\nExplore beautiful locations and real estate properties in full 6DOF and a visual quality that you haven't experienced on your Quest before.\nRealityViewer is a free showcase application for our virtual reality conversion service.\n\nUsing our proprietary technology, we can convert scenes from any 3D software and any renderer into highly realistic virtual reality experiences.\n\nTo learn more, please visit www.roomscalestudios.com and get in touch with us!"}]}, "developer_name": "RoomScaleStudios", "developer_privacy_policy_url": "https://roomscalestudios.com/realityviewer/realityviewer_privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "RoomScaleStudios", "support_website_url": null, "website_url": "https://www.roomscalestudios.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "744757656901344"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results"
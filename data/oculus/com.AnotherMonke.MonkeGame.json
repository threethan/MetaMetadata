9947581_1951485674532949198_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IbLFUI_flEQ7kNvwEz1P-l&_nc_oc=Adrvk1ZxDYX3Est7-KAec5oSsvSBA1M8ey596ory5nNY6O8skIlPdnRtTAEvOC_S6tM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9y0dpXRaDUtdg1tuxgILU1yeIWQLWW6XAshghkcRQaZA&oe=6A2BFFEE"}, {"file_name": "shop.png", "id": "400856519569886", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982584_400856522903219_4011625723855828206_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RD4h2vGC_ykQ7kNvwGCj_pd&_nc_oc=AdqPDpEEHzU0E1aPJJ-fnzY7Cq79KohP1HNminOCFJtD0GhYdTjrdAphir505xjFPQg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8499rcXVJJAZZO9hz_57wm_231Z-DpX1vxBXaa1sf7xg&oe=6A2C33BB"}, {"file_name": "cabin.png", "id": "1482583072357545", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974857_1482583075690878_6243162177780423859_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6dXq8ejDRRQQ7kNvwHgamJp&_nc_oc=Ado7rX6_eStcCi1gfWnOb1j43v_9eaQH4N2AcaKAw5dARKiGmi9b0tmJDNCL7gVbTc8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-k6LIGgJsGJWK6z6RgrhlA8lsEbPVjo4qHLwNkkVM7KA&oe=6A2C06AB"}, {"file_name": "forest.png", "id": "1829399834149597", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035455_1829399837482930_3828830269880611024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rDVd2uA8lgQ7kNvwFbLwhJ&_nc_oc=Ado8tsZ_dlrdXnJ9mEi9tV_SHQvJkOLKRMqoHrFR4yptYFgzzfxQ2xWxmU2iJt4AF8A&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8udUOMNrdSnNtYAccaC9h8EVTcMXwJwW7ULN0rVGgoAA&oe=6A2C1937"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Game", "keywords": [], "long_description": "Monkey Game is an exciting and unique virtual reality multiplayer game that takes you on an adventure with your friends as you play as a monkey's. Jump, run, and explore with your friends through four different maps: Forest, Shop, and TV Zone. With more maps to come soon, you'll never run out of new places to explore! Challenge your friends to races, obstacle courses, and other fun challenges. With realistic graphics, you'll feel like you're really in the game. So grab your friends and join the adventure in Monkey Game!", "short_description": "Monkey Game is a fun game to check out if you want to chill with friends and meet new people you can also put on hats and hold things in your hand as cosmetics and there's a tv area to laugh have fun with friends"}]}, "developer_name": "DeeJr", "developer_privacy_policy_url": "https://sites.google.com/view/eclipse-studios-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Eclipse Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeygamers/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8117289194966907"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031434_241220611627208_5044610552579849431_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_DJzhRrx5UQ7kNvwEqhxQ7&_nc_oc=AdpKY59xEr-8CCYJHGDiOmu4EzTEqNiNqeeVoko7wNFf4uEfe14GIJnMK59oDhJYPFs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DrW6HTz5pFN-7S5eMvkne1UobmowbI7DXqNKBZFw1GA&oe=6A2C20F6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkey Game
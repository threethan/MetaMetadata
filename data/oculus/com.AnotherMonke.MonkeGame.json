9947581_1951485674532949198_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBPjvqhtx5UQ7kNvwHQ1_7K&_nc_oc=Adrw6EkY9PQGu3mSVQ3ftpQjAL7E6hFi71m3fGFFWugtC5RLypiOuQJvvCUSKR6yCmk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCk1mrUGEuaOq6DLwXUipIzuDTAeK4SaI5hCEseZiS8ww&oe=6A620D6E"}, {"file_name": "shop.png", "id": "400856519569886", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982584_400856522903219_4011625723855828206_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQqryOV6AuUQ7kNvwFYAqTH&_nc_oc=AdqOfzD4GKtPbDI8fFXtpOKCaEbCt8hQW8Wx36JgQVm7k2fU_h-xRDEYAYPcgI9pfzc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZFvp64LauaBadWAw22yiX8PR6shK-u5W8hFLWELgmug&oe=6A6208FB"}, {"file_name": "cabin.png", "id": "1482583072357545", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974857_1482583075690878_6243162177780423859_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2jNKVVPdFcQ7kNvwE9zlmY&_nc_oc=AdrOxJPMcynrN8ZMokIN-FT2U0ROnCV7yMpC1FaKiauBANA2r9pp4DNJ--MrsPnbkOE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYbzrvGY9NNdeLliFKvhgmW9V02fCa-pr3SPYzTuXE-w&oe=6A62142B"}, {"file_name": "forest.png", "id": "1829399834149597", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035455_1829399837482930_3828830269880611024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4v8eGaz5ZCcQ7kNvwGVfzVU&_nc_oc=AdriTq_wMt8dv2ek4rv0qV9S-Il0vhztM5s61vH-VxNr7ATpeNVb649SJAs5txcyJ6A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZuLPr8o6pN096O_Xy8-ZnbrgB0jb8dYiV3C0mYpFvag&oe=6A6226B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Game", "keywords": [], "long_description": "Monkey Game is an exciting and unique virtual reality multiplayer game that takes you on an adventure with your friends as you play as a monkey's. Jump, run, and explore with your friends through four different maps: Forest, Shop, and TV Zone. With more maps to come soon, you'll never run out of new places to explore! Challenge your friends to races, obstacle courses, and other fun challenges. With realistic graphics, you'll feel like you're really in the game. So grab your friends and join the adventure in Monkey Game!", "short_description": "Monkey Game is a fun game to check out if you want to chill with friends and meet new people you can also put on hats and hold things in your hand as cosmetics and there's a tv area to laugh have fun with friends"}]}, "developer_name": "DeeJr", "developer_privacy_policy_url": "https://sites.google.com/view/eclipse-studios-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Eclipse Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeygamers/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8117289194966907"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031434_241220611627208_5044610552579849431_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrpzjp1o1GIQ7kNvwE_4rNd&_nc_oc=AdonQD7AJ0Ow3jeBboyB3AsIm2Z41c5VNt-V3Q3h2-UmjcWw4-XIfAmjgMtJ3tH7fYc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4An1K0oq9jFNh0H6ERqov42zyrAHhOyJE24m6Oex7eA&oe=6A622E76"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkey Game
9947581_1951485674532949198_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WPCFSqb1fcQ7kNvwHHUEjv&_nc_oc=AdpKZV2llkUbVzo33euiMOF08pOiyaIHGOMKCngrPmDYQgDxmb9foZSnICz2UlobGQo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mqcKcnhJbMlsF7pp3RnITpaIw-JeF4gpGr1x1wEAeIA&oe=6A25686E"}, {"file_name": "shop.png", "id": "400856519569886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982584_400856522903219_4011625723855828206_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9P6FnocAJcQ7kNvwF1Q0po&_nc_oc=AdrKiL80q1YaLmQOYnUIngrmKu4A1FelNp413NEV43j7j8CmCwf5EvZ1qsANhP2iGY0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cd0QI57cvn1gQdM9kOGO-ln23DI7abE6FzAH8Y-HrMA&oe=6A259C3B"}, {"file_name": "cabin.png", "id": "1482583072357545", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974857_1482583075690878_6243162177780423859_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwSUZgQaoiUQ7kNvwGvN8dV&_nc_oc=AdpmtuzXdOhPRW2DYEO0Wk9ts3WwhdDmtYpUrvOHUElRXEPcrumlf49txVSPN50kt_4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kvdSLdH0JNQ0h8a9bFq7z3nVWELihd9OXAvLfUu6wyQ&oe=6A256F2B"}, {"file_name": "forest.png", "id": "1829399834149597", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035455_1829399837482930_3828830269880611024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8WuVhK3_KoQ7kNvwEBTrYC&_nc_oc=AdpOWdVefZCTyxSA1kzXZuAva15BrmvY5_5HjvvVgY9twT2NwBkOCj9W6KEQJDhkfec&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Y0N0nYXsuFsb6nzSDm4KgHM-s37rT3zzK666pvoVbwQ&oe=6A2581B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Game", "keywords": [], "long_description": "Monkey Game is an exciting and unique virtual reality multiplayer game that takes you on an adventure with your friends as you play as a monkey's. Jump, run, and explore with your friends through four different maps: Forest, Shop, and TV Zone. With more maps to come soon, you'll never run out of new places to explore! Challenge your friends to races, obstacle courses, and other fun challenges. With realistic graphics, you'll feel like you're really in the game. So grab your friends and join the adventure in Monkey Game!", "short_description": "Monkey Game is a fun game to check out if you want to chill with friends and meet new people you can also put on hats and hold things in your hand as cosmetics and there's a tv area to laugh have fun with friends"}]}, "developer_name": "DeeJr", "developer_privacy_policy_url": "https://sites.google.com/view/eclipse-studios-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Eclipse Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeygamers/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8117289194966907"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031434_241220611627208_5044610552579849431_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1th1WLt7glMQ7kNvwFiGpyw&_nc_oc=AdpboJeH0jNBXrfdFVCtUS5j_FZP3XpXqS-RH4dtKTHXE5A69a1AgzjlzZyhEp3g_Ns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HI__jnv__7o3Op3vRJ0W2JB43GchFX2UGeOdfoutbwA&oe=6A258976"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkey Game
vHVNNOe6OkHBeMdpOaMdHK7g&oe=6B0B1EF7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Game", "keywords": [], "long_description": "Monkey Game is an exciting and unique virtual reality multiplayer game that takes you on an adventure with your friends as you play as a monkey's. Jump, run, and explore with your friends through four different maps: Forest, Shop, and TV Zone. With more maps to come soon, you'll never run out of new places to explore! Challenge your friends to races, obstacle courses, and other fun challenges. With realistic graphics, you'll feel like you're really in the game. So grab your friends and join the adventure in Monkey Game!", "short_description": "Monkey Game is a fun game to check out if you want to chill with friends and meet new people you can also put on hats and hold things in your hand as cosmetics and there's a tv area to laugh have fun with friends"}]}, "developer_name": "DeeJr", "developer_privacy_policy_url": "https://sites.google.com/view/eclipse-studios-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Eclipse Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeygamers/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8117289194966907"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39
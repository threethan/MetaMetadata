9947581_1951485674532949198_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22RPFiQPtdQQ7kNvwEg34wR&_nc_oc=AdpLviL67cQIQ7jqNu6YA5P9TUhCDVQeEQG7q6JvZl4n8Ct8tLn3TIKUxoAXLVeU9Jc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71AYRwuTYQryzKPsa2zb_9SEWJ73IkmhZxevtjpmM_Qg&oe=69F9E6EE"}, {"file_name": "shop.png", "id": "400856519569886", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982584_400856522903219_4011625723855828206_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbfnWP0XvUUQ7kNvwF6RXbJ&_nc_oc=AdqSJ1pAI2OmoqzJ03iFRJBIu5Dhc5KclF1Q9lzXLSqcVuej_yY-hZzqZm1X7S48KqA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hAnTXEB5zsJi9Fle1mF9Yekz01Cqt38ZCrmWEB34xNA&oe=69F9E27B"}, {"file_name": "cabin.png", "id": "1482583072357545", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974857_1482583075690878_6243162177780423859_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_COU6mNaFYQ7kNvwGw4L-f&_nc_oc=AdqiwuV3Ir5qm9rJM9emLZg60JNKpSNFK3NDJ_p0YsIzLDiNDEeZCvyKt4WncwEahbk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57aYjL7rwCkOSZY4yTlerc6HhIiBU9QBjoDGG_vkcMzA&oe=69F9EDAB"}, {"file_name": "forest.png", "id": "1829399834149597", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035455_1829399837482930_3828830269880611024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wj8qIAhQuYQ7kNvwFHZfVs&_nc_oc=Adq6BpV1VCQ6uUa6DFcjRX_wQEJwdgbWBff4GFvHnU1qlfMEz4rdTMsO2fVlYM8nEv0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41DGhRFNj3X4nLxK3OdpshCOoRXlx7Qkz1kay4huXJBA&oe=69FA0037"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Game", "keywords": [], "long_description": "Monkey Game is an exciting and unique virtual reality multiplayer game that takes you on an adventure with your friends as you play as a monkey's. Jump, run, and explore with your friends through four different maps: Forest, Shop, and TV Zone. With more maps to come soon, you'll never run out of new places to explore! Challenge your friends to races, obstacle courses, and other fun challenges. With realistic graphics, you'll feel like you're really in the game. So grab your friends and join the adventure in Monkey Game!", "short_description": "Monkey Game is a fun game to check out if you want to chill with friends and meet new people you can also put on hats and hold things in your hand as cosmetics and there's a tv area to laugh have fun with friends"}]}, "developer_name": "DeeJr", "developer_privacy_policy_url": "https://sites.google.com/view/eclipse-studios-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Eclipse Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeygamers/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8117289194966907"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031434_241220611627208_5044610552579849431_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShBHlpwUcXAQ7kNvwE7zrPZ&_nc_oc=AdpsEltDNG0VCr8FujM5KV2hpEcHv-W3ZTj2zPqXGKCW_TEbHLlvT6rO9sWReWFYigY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57ManXJcdUoho7MRnyK4pqGqFM9hQC8nVlePBjwVBXlg&oe=69FA07F6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkey Game
9947581_1951485674532949198_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vJB0VlEnysQ7kNvwFSNgIK&_nc_oc=Adqw-se9V8kUZzdTQ5LV6rg3QuejsS9fs7jcnVB1vaTZOT6U5Vc__aAOAcb8bf_YFtI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3cPfeQl2eG1GvUEhYIx8ZDy68hq3fD9HWDRwW1gQbLvw&oe=69F743EE"}, {"file_name": "shop.png", "id": "400856519569886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982584_400856522903219_4011625723855828206_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tm1rEJOA8AQ7kNvwFH3jFn&_nc_oc=AdqkaGQv7_R_eLW_2GAhOTakye3ER75HXKy9otfgHugpvLOrFScpzYKNKcG-RU842i8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af00m98gL1hgQCFpAIpVdcYf0HcbCYrTNRMGas-n3onMQg&oe=69F73F7B"}, {"file_name": "cabin.png", "id": "1482583072357545", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974857_1482583075690878_6243162177780423859_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRBdYAk3OjsQ7kNvwGEmp-x&_nc_oc=Adr1oUxPwqFT9n6E5eRrmr-o_zczLnx-3lXWW4O7uINT-B3v_vj1fYc5GXQziF17YIw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0aaaMd_KNyutG0mZNUy4pemp6vIo8Kz5FdAPaCQHNvdw&oe=69F74AAB"}, {"file_name": "forest.png", "id": "1829399834149597", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035455_1829399837482930_3828830269880611024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wj8qIAhQuYQ7kNvwEllPnO&_nc_oc=AdpiIoOzdtG4HlzevdgdjoebrYx7ZBD9UGK1Ru37gds1mHWHSs_YquxwwGZB0PaMH9M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af15UprA6Wr0glc7gV52cZZWtJaUKEPcp2pwf_1J5SmvWQ&oe=69F75D37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Game", "keywords": [], "long_description": "Monkey Game is an exciting and unique virtual reality multiplayer game that takes you on an adventure with your friends as you play as a monkey's. Jump, run, and explore with your friends through four different maps: Forest, Shop, and TV Zone. With more maps to come soon, you'll never run out of new places to explore! Challenge your friends to races, obstacle courses, and other fun challenges. With realistic graphics, you'll feel like you're really in the game. So grab your friends and join the adventure in Monkey Game!", "short_description": "Monkey Game is a fun game to check out if you want to chill with friends and meet new people you can also put on hats and hold things in your hand as cosmetics and there's a tv area to laugh have fun with friends"}]}, "developer_name": "DeeJr", "developer_privacy_policy_url": "https://sites.google.com/view/eclipse-studios-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Eclipse Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeygamers/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8117289194966907"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031434_241220611627208_5044610552579849431_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YEE1t89pg7EQ7kNvwHpSzR0&_nc_oc=AdqW8sMDX-emBmF1f9UjC4juZgtGWb5HGPZxt-RFaiRkScjkPyXNg6mqVOz6WzA2P_8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af25i8VR-fNeCm4XNOAkDrQtuOp3OSpH1vRoCUZrBpABPA&oe=69F764F6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkey Game
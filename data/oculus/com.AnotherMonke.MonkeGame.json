9947581_1951485674532949198_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6neHgWU_aZsQ7kNvwH_WNA3&_nc_oc=AdqVRtg6bohLxelAVg6-fdvqiNzAvKOONHUe4Lydj5WeWVIvr3Z6INcUe6FsBYF0pGs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0f2Fk5HNYQTabDrD5-l0HVPgBvEudBxBPDIewCMOikKA&oe=69EA14EE"}, {"file_name": "shop.png", "id": "400856519569886", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982584_400856522903219_4011625723855828206_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1i_xNRxIY8Q7kNvwGuZHls&_nc_oc=AdpiVo7wfKkZ-JfXEeEsQuXs9JWPpUrZVnrDPiw1ZykoWOP3LxLcGZiCeCnfawKfjjM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kspFEz5gXmKQc2Fm-dhu3UuhHoeHpWd7HNzxsdXDqGA&oe=69EA107B"}, {"file_name": "cabin.png", "id": "1482583072357545", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974857_1482583075690878_6243162177780423859_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwG6KfWecqgQ7kNvwEPkbeT&_nc_oc=AdpNL6q_f5auZlpjdWQVYAscPAAlUG8G-009DAN6vchILdHmRQGz5RODKwBfqpyCWGE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ref8C9DPhRF3b5w-sBITRe_FbIahQ5NzoFghekrlhiA&oe=69EA1BAB"}, {"file_name": "forest.png", "id": "1829399834149597", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035455_1829399837482930_3828830269880611024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2Ly2ylmTFwQ7kNvwFiRLtO&_nc_oc=AdpcFkyS8-NIPHfj18WYDW-grGwWWHozkJN3xIacUl7eQdzbWSekMsjJHThaxu6Q95w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vWBA8O88W1ETwgpML0szrsvEpEJgI7l7IdO7KwBwDow&oe=69EA2E37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Game", "keywords": [], "long_description": "Monkey Game is an exciting and unique virtual reality multiplayer game that takes you on an adventure with your friends as you play as a monkey's. Jump, run, and explore with your friends through four different maps: Forest, Shop, and TV Zone. With more maps to come soon, you'll never run out of new places to explore! Challenge your friends to races, obstacle courses, and other fun challenges. With realistic graphics, you'll feel like you're really in the game. So grab your friends and join the adventure in Monkey Game!", "short_description": "Monkey Game is a fun game to check out if you want to chill with friends and meet new people you can also put on hats and hold things in your hand as cosmetics and there's a tv area to laugh have fun with friends"}]}, "developer_name": "DeeJr", "developer_privacy_policy_url": "https://sites.google.com/view/eclipse-studios-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Eclipse Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeygamers/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8117289194966907"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031434_241220611627208_5044610552579849431_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3qsufn_kWYQ7kNvwEJCdAs&_nc_oc=Adoa0cpT8gxy6ZW4i3edbKm6s4eTU6SrndgdUoGcuq58N-tAANEtdNa-WXgBXUoOYrk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fJZZ0dob-NrlubpQipeeXH68Ic3uZNUaNfTNV0XfMxg&oe=69EA35F6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkey Game
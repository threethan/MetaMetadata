9947581_1951485674532949198_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1r1zYDjKg7sQ7kNvwH7ljvH&_nc_oc=Adpe7a3fjepLOiw_u9xWkMvgdtTXxD5KBM-fMcX8E7RlLJmqoE5AI7CUhkArLH2TEZE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Noaf_ob2x2v1X8xuG18U4jGUOt9RmcqxS2Z45V-lKHg&oe=6A3FC66E"}, {"file_name": "shop.png", "id": "400856519569886", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982584_400856522903219_4011625723855828206_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwBfHx3ViFkQ7kNvwGZI7L_&_nc_oc=Adqs0htwUyCFmJGu_kcqFKm4hl2uFkeEx6gszUrDrf8zEnKfs6h98Ve9k3j2gqb0_zU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rp8xTFSVC-XLAjKnGolVncJjUMlnd9tFdP82iYHTvVA&oe=6A3FC1FB"}, {"file_name": "cabin.png", "id": "1482583072357545", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974857_1482583075690878_6243162177780423859_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38cYSu_CX3UQ7kNvwFx55am&_nc_oc=Adp5tbTqXJkYffpw8IbRtG1BRUVrWAXm-YvFqdPEfFB__4JCeb7tMc9Ue1n2eSiG5HA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iJ_83CBMhTMKmcZTSrs61sb8bwuLrGHyxRGoUZr2gpw&oe=6A3FCD2B"}, {"file_name": "forest.png", "id": "1829399834149597", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035455_1829399837482930_3828830269880611024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHbxIOFxjmsQ7kNvwFMa-jo&_nc_oc=AdqwmAiriqGTc9v6tHCMac2X7t_kIlWVFzuWaggnc1EH6gRXK7SSuK2ArO8cZvdQeZw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AVpK8uf8c9u_Hja7-HI_5zypKUdjjfkC-3hJMktUGkQ&oe=6A3FDFB7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Game", "keywords": [], "long_description": "Monkey Game is an exciting and unique virtual reality multiplayer game that takes you on an adventure with your friends as you play as a monkey's. Jump, run, and explore with your friends through four different maps: Forest, Shop, and TV Zone. With more maps to come soon, you'll never run out of new places to explore! Challenge your friends to races, obstacle courses, and other fun challenges. With realistic graphics, you'll feel like you're really in the game. So grab your friends and join the adventure in Monkey Game!", "short_description": "Monkey Game is a fun game to check out if you want to chill with friends and meet new people you can also put on hats and hold things in your hand as cosmetics and there's a tv area to laugh have fun with friends"}]}, "developer_name": "DeeJr", "developer_privacy_policy_url": "https://sites.google.com/view/eclipse-studios-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Eclipse Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeygamers/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8117289194966907"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031434_241220611627208_5044610552579849431_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8RIoaNa5C4Q7kNvwFK9pFH&_nc_oc=AdoIiD1fxxkktbnj8xyI70zsAqjXzrYnAtRDyFZ70Jg1tNt4jcYjtSEyX_QhWx4CNnQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kLRW48Zi9KPEZ2_1qmt3-YRWj2yBZDHNDOtdj69RNaQ&oe=6A3FE776"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkey Game
9947581_1951485674532949198_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHkTqw7R1EMQ7kNvwGJEnQB&_nc_oc=AdqvK7QdP99hqwvAvyQi2HrtxIAyHd1a_fPVKlUig4MVr0Ycx6TNuY0vOWnCBCs4OBk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0l6JXMaLvoLMWoN4UMByqnQsEZFbou2NgViCAh2L83sw&oe=69D8F16E"}, {"file_name": "shop.png", "id": "400856519569886", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982584_400856522903219_4011625723855828206_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NddMesDITI0Q7kNvwEaeGPw&_nc_oc=AdrJUomSNnNoY8ykAAyH38QtVlAuuWGB7ltCb350rLWHrekROYgCS5015-rclpkR1JA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2P7pmVth2WQVgtEFTCew2rFatp4TlLAuNRyZFfpqDmzg&oe=69D8ECFB"}, {"file_name": "cabin.png", "id": "1482583072357545", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974857_1482583075690878_6243162177780423859_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CwxkE0hEmW4Q7kNvwFO3qSA&_nc_oc=AdodimsZ_RKCZqUtRdl1NVIYaEX2dcOxpIC6UNv9HaVaSOvthmjNMqIdzJN042qhdM0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xtEBfHq4EPVe4kQN2hg-TmwLDa-OjFYbpgJPO1FPSEw&oe=69D8F82B"}, {"file_name": "forest.png", "id": "1829399834149597", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035455_1829399837482930_3828830269880611024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMOWkvHUWLsQ7kNvwHCasae&_nc_oc=AdrT9EDEKb58axZHmf72QydC8EcSD11d1yYLfRdcFh6JSPZKadS3-amXM9X9TP0k5T4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oBEkPPMyTxSBQjflqBXAq8J67qwnRiCz29jAdhvm-yw&oe=69D90AB7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Game", "keywords": [], "long_description": "Monkey Game is an exciting and unique virtual reality multiplayer game that takes you on an adventure with your friends as you play as a monkey's. Jump, run, and explore with your friends through four different maps: Forest, Shop, and TV Zone. With more maps to come soon, you'll never run out of new places to explore! Challenge your friends to races, obstacle courses, and other fun challenges. With realistic graphics, you'll feel like you're really in the game. So grab your friends and join the adventure in Monkey Game!", "short_description": "Monkey Game is a fun game to check out if you want to chill with friends and meet new people you can also put on hats and hold things in your hand as cosmetics and there's a tv area to laugh have fun with friends"}]}, "developer_name": "DeeJr", "developer_privacy_policy_url": "https://sites.google.com/view/eclipse-studios-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Eclipse Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeygamers/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8117289194966907"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031434_241220611627208_5044610552579849431_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMobDlnNLW4Q7kNvwEfazNF&_nc_oc=AdpCBesAR01jn-zLIKU4Z555Lpkj07Q-Gha1dUl9jS3n74pc0v3mO65lFQdPEbqbspM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Anp1QdCk1qhrcy7xnmvLu2Q4_P4G089A4Ay7zKBByHQ&oe=69D8DA36"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkey Game
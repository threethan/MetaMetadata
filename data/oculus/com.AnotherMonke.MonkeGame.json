9947581_1951485674532949198_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGPxVdg4L6UQ7kNvwGfayHk&_nc_oc=AdpSKc9yNNducV9eJUXuCK1BSzu7T7I_J0rKxCJ_oqpLdjs0IYVLDsxMYcI6beD-CEw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xI230kXNgVgwmmt49ZRfG7HGpgokcGDI2XtPNUaUkIA&oe=6A0B0A6E"}, {"file_name": "shop.png", "id": "400856519569886", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982584_400856522903219_4011625723855828206_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQFUfpMOeKYQ7kNvwF1Yx9I&_nc_oc=AdokpboTOPxTkruyTr68TC-uDN8sYr0uU7jDCVb5bjKoGtuKN7RU59oePqHJY1i9h58&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59ZwvgV-OScLqM2HR6l0SRKJA8znrCG60B-QjnbgMLvw&oe=6A0B05FB"}, {"file_name": "cabin.png", "id": "1482583072357545", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974857_1482583075690878_6243162177780423859_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CUBqlrJZegQ7kNvwH6xhv8&_nc_oc=AdolDMHxvcE3th_THtRQ-0EXX3bXfkk0UkS2GNiW0hHhJDrd5E-rcjm2_9L0xpBOo0M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Jc0_5ogqDsL8WmCKo8kOjiHmSDFOl-Dj_Ed5EvcKsIQ&oe=6A0B112B"}, {"file_name": "forest.png", "id": "1829399834149597", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035455_1829399837482930_3828830269880611024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YnlS-Wvhy8Q7kNvwEtA_mY&_nc_oc=Adptl9rpEF94jypf3bUYDguYJNErvNIwdcalQ0_Qbzi8NbndtINI4cqamnJl8QvH2MQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4knjHaB6T-iUy_SNJGFQuyWt--EFKGkI8yhw-C5mA1UA&oe=6A0B23B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Game", "keywords": [], "long_description": "Monkey Game is an exciting and unique virtual reality multiplayer game that takes you on an adventure with your friends as you play as a monkey's. Jump, run, and explore with your friends through four different maps: Forest, Shop, and TV Zone. With more maps to come soon, you'll never run out of new places to explore! Challenge your friends to races, obstacle courses, and other fun challenges. With realistic graphics, you'll feel like you're really in the game. So grab your friends and join the adventure in Monkey Game!", "short_description": "Monkey Game is a fun game to check out if you want to chill with friends and meet new people you can also put on hats and hold things in your hand as cosmetics and there's a tv area to laugh have fun with friends"}]}, "developer_name": "DeeJr", "developer_privacy_policy_url": "https://sites.google.com/view/eclipse-studios-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Eclipse Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeygamers/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8117289194966907"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031434_241220611627208_5044610552579849431_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEJ7B8tz1OwQ7kNvwEGLZ4P&_nc_oc=AdrlmlowXZGf87C-Z_KzJY1kfeUscXPQMgzO-Bib94rcASZ7JKZMcm1eKiCQwCZiTk4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BdDC0nlJRLw-jZXQz6g8KbO0jSBWJvfCQ7Z_1KgP7Ow&oe=6A0B2B76"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkey Game
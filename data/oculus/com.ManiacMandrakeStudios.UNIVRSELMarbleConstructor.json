_592878162934008_2834069384287429190_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbXaPGd2ZmIQ7kNvwFJ5uMp&_nc_oc=Adqnv5kIJu0ELchBr4NX9iim5oLL2kMPDtZ9Gcu9zjCGb2RgoAVQb-LeVxD91hW_kTA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAt0BnpZNPxqHjcCO6eCo2SS3Km3A4kV95NL4xDlD-xWg&oe=6A54E7A7"}, {"file_name": "5.png", "id": "802343154781662", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982569_802343158114995_5752615963947088209_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BShN4N7P8YsQ7kNvwE6hRnW&_nc_oc=AdrD5zqae0NgzcB3AaUxR8AhXBVFMxNxUBJTqUgqDW-szT0aUTgf87HYaLbCYNoIIbo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-bjuQ4zAo2QmDeJySedLloJwd3DfYXwbQNPkeUJGY7Q&oe=6A54FB36"}, {"file_name": "4.png", "id": "807251044289330", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610561_807251047622663_2532793456191196708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dlSK4i_UmkQ7kNvwFy860n&_nc_oc=Adrh411yY7zRNHl9Qhyk2CcUCLUuUCdSRlL8TRB2FJdObmeH5RXZbJnqdBhYdXniaQk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbAsgEqa3LTlXEnwABY-g_QjKe5RliJurzyVW7sIcejQ&oe=6A54E935"}, {"file_name": "2.png", "id": "658527362840776", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974534_658527366174109_8964634538097857168_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIssCAHsrjIQ7kNvwEqLUjK&_nc_oc=AdrETqus-C7afQ1hSBBmXA6hlW8Dy3G2M_A8GO05GFVywR_zDTo_MrJPZLylUh3BUlE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVv2pC2BSgj8qoUbxfmFJsvDm-y257Ch5b_PyTsuhCqw&oe=6A54E077"}, {"file_name": "3.png", "id": "183507574717662", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974585_183507578050995_7372688867595747247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eaJHAtGVBAwQ7kNvwFdUuFx&_nc_oc=AdogFZSEy3CT4anzMGPb--dYNx3WGjcK1TxeeaTuzHXQNzxBV92TAzpnIvd_Vo-omeA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDo06ehzN3Z72ooQO6fjwRy4M3mSuJikwJcKJUSa9pD8w&oe=6A54E369"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "querformat.png", "id": "1313538886267584", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974534_1313538889600917_8615038871323704132_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6GTkftL69IQ7kNvwEjj3Y_&_nc_oc=Adpj_PPe1tiftxxUuN00Tjzq_fnkTrGEViJE--4Du57bfGXUzbVdXxCoq_6O1u0lUac&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNXMCYv2jOeNaVdf8bk56bqSEM6IcDCQUvPyoApn1NaQ&oe=6A54D4E9"}, "display_name": "Uni-VR-sal Marble Constructor", "keywords": [], "long_description": "Welcome to the Uni-VR-sel-Marble-Constructor my marble-ous fellow.\n\nYou seek brutal action in the World of Marbles? Well then it is the perfect game for you.\n\nThe Uni-VR-sel-Marble-Constructor is like you think it is, a sandbox game to build your own individual marble tracks directly on your Quest.\n\nFeatures:\n\nPlay with 91 (+ maybe more in the future) unique designed tracks.\nNormal Tracks, Pipes, Narrow Tracks, Elevator, Gravity-Modifier, Color-Changer and more!\nA simple but effective Save/Load System with 3 Slots for your individual tracks (more upcoming maybe)\nPlayable during sitting/standing\nAbsolutely lightweight app Version 1.14 RC1 is nearly only 100 MB big. Savegames probably never reach 2MB\n\nIf you would place every Object one time, you could create:\n 80,150,775,687,724,724,631,352,622,122,648,436,813,888,337,400,256,824,204,946,344,032,827,440,325,458,733,740,704,428,022,216,465,000,000,000,000,000,000,000,000,000,000,000\n\nindividual tracks\u2026 This is a real number and called 91 factorial.\nSo feel free to test every possibility \ud83d\ude1b\n\n\n\nYou wanna share your track?\nNo problem, plug your Quest on your PC, find the folder of the Uni-VR-sel-Marble-Constructor and copy your save-game and share it with your friends.\n\n\n\nThis game is/was a project from one single person (Me\u2026. Mandrake :) )\n\n", "short_description": "Welcome to the Uni-VR-sel-Marble-Constructor my marble-ous fellow.\n\nYou seek brutal action in the World of Marbles? Well then it is the perfect game for you.\n\nThe Uni-VR-sel-Marble-Constructor is like you think it is, a sandbox game to build your own individual marble tracks directly on your Quest.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://maniacmandrakestud.wixsite.com/maniac-mandrake-stud/privacy-policy-of-the-uni-vr-sal-marble", "developer_terms_of_service_url": null, "publisher_name": "Maniac-Mandrake-Studios", "support_website_url": null, "website_url": "https://maniacmandrakestud.wixsite.com/maniac-mandrake-stud/end-user", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1976901462642994"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "314505718316700"}, {"status": "PUBLISHED", "id": "1009674386880781"}]}, "baseline_offer": {"id": "314505718316700"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1712007480, "status": "PUBLISHED", "id": "314505718316700"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6832729476827145", "version": "1.14"}, "id": "1307493020195625", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinar
_592878162934008_2834069384287429190_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WuSooD1Tgy4Q7kNvwEjoZjY&_nc_oc=AdoNIHw_EkLccK4NwNBVVqnW958TF_5fpiwtGX_hQ_6LZd2m_FAmhn-e08eLTWpGCIs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz9GbCjUmdwkiS6jplABO35oVkmGQU4pnkOay3-_R0whQ&oe=69D111A7"}, {"file_name": "5.png", "id": "802343154781662", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982569_802343158114995_5752615963947088209_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEsfOP5KU_sQ7kNvwEP_G1q&_nc_oc=Adp3aluAqtp3uhs-WigYeSAvVcSkW8jCRvVh3g3HGu6vHOta3aV_ST9-TgMYKKWxVFk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMHD9T2E4CwkJunUQWn6GQesqvv0xODBZGpqMVMt9rEw&oe=69D12536"}, {"file_name": "4.png", "id": "807251044289330", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610561_807251047622663_2532793456191196708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEvhvtJj2hEQ7kNvwHlhv_1&_nc_oc=AdpH63Ras17__vQN2Th59iWn0suN3ROylDDSWyAdmpAtQEoA6RLStJpVTHSz3Rma4IU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwPXaQTrfalLTxeIqnzua9UoxPi6de1-hJqfaS5L94kHA&oe=69D11335"}, {"file_name": "2.png", "id": "658527362840776", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974534_658527366174109_8964634538097857168_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zoroZb_HX4Q7kNvwHZ6LTL&_nc_oc=AdqwBKQ1M0UIMTT9DDRYS3flhshPugQ123zFr5ct4x8uAHhg2BmHEV7utE4UTxQaO2A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxeSXeWVxES71wUHcHUcGrb7NQ1gzFKZ33Hjdnvs0k1sQ&oe=69D10A77"}, {"file_name": "3.png", "id": "183507574717662", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974585_183507578050995_7372688867595747247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wayNX5MZBJcQ7kNvwEcnhGq&_nc_oc=AdoFgLxUIlEtQJxS8nrt-poOY7IUf3Bmn_U7acSQwRLUiMTmYpIYrhb9j6O2HMWfrC4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzer0mwFKAdc8vGZZ3CBfRc7Qu0xfBwhrsPo7taieG3Uw&oe=69D10D69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "querformat.png", "id": "1313538886267584", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974534_1313538889600917_8615038871323704132_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QuV33Iqx5QQ7kNvwH2-R9P&_nc_oc=AdqinMNCFRiPo_16odiNa2uX6e8D0Njhv7SnBR98668bxut32hvbTz4_l79e1uFaEu8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxctDhqy2dUdqJf3mITYaYB3fUZl1rcMw27-nx9sUo59Q&oe=69D0FEE9"}, "display_name": "Uni-VR-sal Marble Constructor", "keywords": [], "long_description": "Welcome to the Uni-VR-sel-Marble-Constructor my marble-ous fellow.\n\nYou seek brutal action in the World of Marbles? Well then it is the perfect game for you.\n\nThe Uni-VR-sel-Marble-Constructor is like you think it is, a sandbox game to build your own individual marble tracks directly on your Quest.\n\nFeatures:\n\nPlay with 91 (+ maybe more in the future) unique designed tracks.\nNormal Tracks, Pipes, Narrow Tracks, Elevator, Gravity-Modifier, Color-Changer and more!\nA simple but effective Save/Load System with 3 Slots for your individual tracks (more upcoming maybe)\nPlayable during sitting/standing\nAbsolutely lightweight app Version 1.14 RC1 is nearly only 100 MB big. Savegames probably never reach 2MB\n\nIf you would place every Object one time, you could create:\n 80,150,775,687,724,724,631,352,622,122,648,436,813,888,337,400,256,824,204,946,344,032,827,440,325,458,733,740,704,428,022,216,465,000,000,000,000,000,000,000,000,000,000,000\n\nindividual tracks\u2026 This is a real number and called 91 factorial.\nSo feel free to test every possibility \ud83d\ude1b\n\n\n\nYou wanna share your track?\nNo problem, plug your Quest on your PC, find the folder of the Uni-VR-sel-Marble-Constructor and copy your save-game and share it with your friends.\n\n\n\nThis game is/was a project from one single person (Me\u2026. Mandrake :) )\n\n", "short_description": "Welcome to the Uni-VR-sel-Marble-Constructor my marble-ous fellow.\n\nYou seek brutal action in the World of Marbles? Well then it is the perfect game for you.\n\nThe Uni-VR-sel-Marble-Constructor is like you think it is, a sandbox game to build your own individual marble tracks directly on your Quest.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://maniacmandrakestud.wixsite.com/maniac-mandrake-stud/privacy-policy-of-the-uni-vr-sal-marble", "developer_terms_of_service_url": null, "publisher_name": "Maniac-Mandrake-Studios", "support_website_url": null, "website_url": "https://maniacmandrakestud.wixsite.com/maniac-mandrake-stud/end-user", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1976901462642994"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "314505718316700"}, {"status": "PUBLISHED", "id": "1009674386880781"}]}, "baseline_offer": {"id": "314505718316700"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1712007480, "status": "PUBLISHED", "id": "314505718316700"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6832729476827145", "version": "1.14"}, "id": "1307493020195625", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinar
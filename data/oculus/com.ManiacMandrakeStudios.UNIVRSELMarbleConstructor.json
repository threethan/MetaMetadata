m/v/t64.5771-25/38974585_183507578050995_7372688867595747247_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=In05FXycOXwQ7kNvwF_ieKW&_nc_oc=AdrqJIt0eult841-YuQDPEiPtoAzhYYlw-1yuD0PJtqpLSQkhoSma9qoLVNKXSWppg0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDTAOZoFR-AdvVgfD2W_lkXfDpot0QxzpoozPT1sbsiw&oe=6B0867A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "querformat.png", "id": "1313538886267584", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974534_1313538889600917_8615038871323704132_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BS8Rms8UD5oQ7kNvwHh3Mru&_nc_oc=AdqRepwr2RQdwo1NoL946JZbjA_JExmACdZmZAv31E_4u1pgsdNGS-JEN_8WZhASmG0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwPUFCZE0g2EEGlOeIBeuE_0oAgAt2AOQiTH7GPxVoLQ&oe=6B085929"}, "display_name": "Uni-VR-sal Marble Constructor", "keywords": [], "long_description": "Welcome to the Uni-VR-sel-Marble-Constructor my marble-ous fellow.\n\nYou seek brutal action in the World of Marbles? Well then it is the perfect game for you.\n\nThe Uni-VR-sel-Marble-Constructor is like you think it is, a sandbox game to build your own individual marble tracks directly on your Quest.\n\nFeatures:\n\nPlay with 91 (+ maybe more in the future) unique designed tracks.\nNormal Tracks, Pipes, Narrow Tracks, Elevator, Gravity-Modifier, Color-Changer and more!\nA simple but effective Save/Load System with 3 Slots for your individual tracks (more upcoming maybe)\nPlayable during sitting/standing\nAbsolutely lightweight app Version 1.14 RC1 is nearly only 100 MB big. Savegames probably never reach 2MB\n\nIf you would place every Object one time, you could create:\n 80,150,775,687,724,724,631,352,622,122,648,436,813,888,337,400,256,824,204,946,344,032,827,440,325,458,733,740,704,428,022,216,465,000,000,000,000,000,000,000,000,000,000,000\n\nindividual tracks\u2026 This is a real number and called 91 factorial.\nSo feel free to test every possibility \ud83d\ude1b\n\n\n\nYou wanna share your track?\nNo problem, plug your Quest on your PC, find the folder of the Uni-VR-sel-Marble-Constructor and copy your save-game and share it with your friends.\n\n\n\nThis game is/was a project from one single person (Me\u2026. Mandrake :) )\n\n", "short_description": "Welcome to the Uni-VR-sel-Marble-Constructor my marble-ous fellow.\n\nYou seek brutal action in the World of Marbles? Well then it is the perfect game for you.\n\nThe Uni-VR-sel-Marble-Constructor is like you think it is, a sandbox game to build your own individual marble tracks directly on your Quest.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://maniacmandrakestud.wixsite.com/maniac-mandrake-stud/privacy-policy-of-the-uni-vr-sal-marble", "developer_terms_of_service_url": null, "publisher_name": "Maniac-Mandrake-Studios", "support_website_url": null, "website_url": "https://maniacmandrakestud.wixsite.com/maniac-mandrake-stud/end-user", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1976901462642994"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "314505718316700"}, {"status": "PUBLISHED", "id": "1009674386880781"}]}, "baseline_offer": {"id": "314505718316700"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1712007480, "st
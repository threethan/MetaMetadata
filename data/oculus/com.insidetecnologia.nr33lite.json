lay_name": "Safety Playground: NR33 Confined Space", "keywords": ["training", "safety", "confined", "space", "industrial"], "long_description": "Safety Playground: NR33 Confined Space is a virtual reality training simulation designed to support safety awareness and procedural learning for confined space work.\n\nThe experience places the user in an immersive industrial scenario where they can review key safety concepts, identify risks, follow guided procedures and interact with training elements related to confined space activities.\n\nThe app is intended for supervised corporate and educational use, especially in safety training contexts. It does not replace formal certification, legal training requirements or company-specific procedures. Instead, it serves as an immersive complement to traditional instruction, helping users better understand risks, sequence of actions and safety-critical behaviors.\n\nNR33 refers to the Brazilian occupational safety regulation related to confined space work. The content is educational and simulation-based.", "short_description": "VR training simulation for confined space work safety, based on the Brazilian NR33 occupational safety context."}]}, "developer_name": "Inside Tecnologia", "developer_privacy_policy_url": "https://insidetecnologia.com/compliance/privacidade/", "developer_terms_of_service_url": null, "publisher_name": "Inside Tecnologia", "support_website_url": null, "website_url": "https://insidetecnologia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_langua
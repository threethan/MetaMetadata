h=00_AQW-31plCJWRCgZjvbLnQPrGjrv9aE92pz5MHl-i_MXscw&oe=6B0F0336"}, {"file_name": "Imagem 12.png", "id": "4510893542517300", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/654867655_4510893545850633_2658747490649213769_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOX8ZI7okJwQ7kNvwE-_MfQ&_nc_oc=Adqu9lVdi-50tWqgKuhDVuwXeMRbvJzf1_kB43FegfV5A1-yLDML24M7klaE2f4WX-k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVcFzn8yAvD8D8vJ6CwXs7T4SYv1DuUYvKKjhSoLgiqig&oe=6B0F0680"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1002541308803869", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604366035_1002541312137202_6069985527595655573_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIQTdFgeNSYQ7kNvwGv-sdq&_nc_oc=Adrjx542Pn5VmXxylZWsyPbwq62HndIKP_mRQJ_-Pk6ubG5uyWfzR-PF27EQBnZ7TbI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXI7gbErwFu7-5AC5YgusgpfCMgUf_s0zipA1c2GcM4Qg&oe=6B0EF656"}, "display_name": "Confined Space (Lite): Safety VR", "keywords": ["confined", "spaces", "hazard", "awareness", "safety"], "long_description": "Explore the basics of confined space safety in a short virtual reality experience. This Lite module introduces recognizing hazards, taking precautions before entry, and deciding how to respond to unsafe conditions in a simulated environment.\n\nDeveloped by Inside Tecnologia, the module is designed for awareness activities, demonstrations, and a first look at the topic. Use it alongside formal training.", "short_description": "A short VR introduction to confined space safety."}, {"images": {"nodes": []}, "id": "1604489538327936", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NR 33: Espa\u00e7os Confinados (Lite)", "keywords": ["treinamento", "seguran\u00e7a", "espa\u00e7o", "confinado", "industrial"], "long_description": "Conhe\u00e7a os fundamentos de seguran\u00e7a em espa\u00e7os confinados em uma experi\u00eancia curta de realidade virtual. O m\u00f3dulo Lite oferece um primeiro contato com reconhecimento de perigos, cuidados antes da entrada e decis\u00f5es diante de condi\u00e7\u00f5es inseguras em um ambiente simulado.\n\nDesenvolvido pela Inside Tecnologia, o m\u00f3dulo \u00e9 indicado para a\u00e7\u00f5es de sensibiliza\u00e7\u00e3o, demonstra\u00e7\u00f5es e introdu\u00e7\u00e3o ao tema. Use a experi\u00eancia como complemento \u00e0 capacita\u00e7\u00e3o formal.", "short_description": "Uma experi\u00eancia curta em VR sobre seguran\u00e7a em espa\u00e7os confinados."}]}, "developer_name": "Inside Tecnologia", "developer_privacy_policy_url": "https://insidetecnologia.com/compliance/privacidade/", "developer_terms_of_service_url": null, "publisher_name": "Inside Tecnologia", "support_website_url": null, "website_url": "https://insidetecnologia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29368133622810370"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673525341_1774864987076944_317622004691060903_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vg3XhpIzv8cQ7kNvwH8VDp3&_nc_oc=AdpC-pHWmSm7GghKilTtI9qjLcWMdCxVok6kl-so-d2t-HgXNkRp6nIBygl5gDaQR8M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUAjqfFGMKBbXwD5o7VonY5BVMMEG-7B4Ea0ocE-p8whw&oe=6B0F1CFE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Confined Space (Lite): Safety VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1783618800, "lastRevision": {"nodes": [{"id": "27095427250081030", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "27095427176747704", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1710199810159041"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2072277030344014", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Safety Playground: NR33 Espa\u00e7o Confinado", "keywords": ["treinamento", "seguran\u00e7a", "espa\u00e7o", "confinado", "industrial"], "long_description": "Safety Playground: NR33 Espa\u00e7o Confinado \u00e9 uma simula\u00e7\u00e3o de treinamento em realidade virtual criada para apoiar a conscientiza\u00e7\u00e3o sobre seguran\u00e7a e o aprendizado de procedimentos relacionados ao trabalho em espa\u00e7os confinados.\n\nA experi\u00eancia coloca o usu\u00e1rio em um ambiente industrial imersivo, onde \u00e9 poss\u00edvel revisar conceitos essenciais de seguran\u00e7a, identificar riscos, seguir orienta\u00e7\u00f5es guiadas e interagir com elementos de treinamento relacionados \u00e0s atividades em espa\u00e7o confinado.\n\nO aplicativo \u00e9 voltado para uso corporativo e educacional supervisionado, especialmente em contextos de treinamento de seguran\u00e7a do trabalho. Ele n\u00e3o substitui certifica\u00e7\u00f5es formais, exig\u00eancias legais de capacita\u00e7\u00e3o ou procedimentos espec\u00edficos de cada empresa. A proposta \u00e9 funcionar como um complemento imersivo ao treinamento tradicional, ajudando os usu\u00e1rios a compreender melhor os riscos, a sequ\u00eancia de a\u00e7\u00f5es e os comportamentos cr\u00edticos de seguran\u00e7a.\n\nA NR33 \u00e9 a norma regulamentadora brasileira relacionada \u00e0 seguran\u00e7a e sa\u00fade nos trabalhos em espa\u00e7os confinados. O conte\u00fado apresentado tem finalidade educativa e \u00e9 baseado em simula\u00e7\u00e3o.", "short_description": "Simula\u00e7\u00e3o em realidade virtual para treinamento de seguran\u00e7a em trabalho em espa\u00e7o confinado, com base no contexto da NR33."}, {"images": {"nodes": [{"file_name": "Cover Square.png", "id": "2280159945850729", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619808_2280159949184062_5538222532187820938_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RsfVNZ4DxYQ7kNvwHmOjIz&_nc_oc=AdpRpBMuk-P7i5_-5b5yk5QW0qnMPbtUsdV9ZPMBpbdt4wNKL5QEZQIQtjCCFS_IjCE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXQPo836M61-cisNTVQ8GIt7gzac-mDK46ZMy0i_RofNg&oe=6B0EFDEC"}, {"file_name": "Icon.png", "id": "2279379859627668", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623400_2279379866294334_5804789156413773816_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHyKsezsutwQ7kNvwF-bZN6&_nc_oc=Ado8h8Z_zKauYk19uAjnAmKEICa8CpKhHHfYN_GVHDtc0DXuKRP0x13gfparvZFagII&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVfTv__Vjt6w1roChRXRfL43CxsnZsEj5UqXY9OjEroiQ&oe=6B0EEC9B"}, {"file_name": "Hero Cover.png", "id": "2085096165404836", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_208509616873
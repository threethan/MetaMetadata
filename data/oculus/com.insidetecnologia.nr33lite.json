.com/v/t64.5771-25/499623384_996774989504610_6337789378113176136_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMCucc9sazwQ7kNvwF79Ivf&_nc_oc=Adrom1rHiHYVSH20PW-JrmaQXX8WTQv53l1v1tTXCK0Q2TgCtyrocubJqZloWJYZ7HI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWqt16PDnRNsoF42UWbfd3Tpgwtl5WJztyq9OniCSbekg&oe=6B0F067A"}, {"file_name": "Imagem 13.png", "id": "2352527605236901", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620817_2352527608570234_2026864260811438126_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4TIjuBE7noQ7kNvwGQ7eVy&_nc_oc=AdpccEKziRBNm598YyfQGcPiqMbvOGg3CNLCVOAuvjUZYfr55ebGKV-7e6Z8APznmgQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW-31plCJWRCgZjvbLnQPrGjrv9aE92pz5MHl-i_MXscw&oe=6B0F0336"}, {"file_name": "Imagem 12.png", "id": "4510893542517300", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/654867655_4510893545850633_2658747490649213769_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOX8ZI7okJwQ7kNvwE-_MfQ&_nc_oc=Adqu9lVdi-50tWqgKuhDVuwXeMRbvJzf1_kB43FegfV5A1-yLDML24M7klaE2f4WX-k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVcFzn8yAvD8D8vJ6CwXs7T4SYv1DuUYvKKjhSoLgiqig&oe=6B0F0680"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "2191038475046041", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622285_2191038485046040_2469573563971578478_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KypFy-cHan8Q7kNvwHvlrUh&_nc_oc=AdrdmYtDvglR1kGbD2P4PKhg5b2My8MxjgH0TSoqTW0gst1Aasln87QbVED901JqhUQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUpq1FsNS5iE0eGgOzxByNCXoQW_W3Hv2oc5hohBXnaww&oe=6B0F09A0"}, "display_name": "Safety Playground: NR33 Confined Space", "keywords": ["training", "safety", "confined", "space", "industrial"], "long_description": "Safety Playground: NR33 Confined Space is a virtual reality training simulation designed to support safety awareness and procedural learning for confined space work.\n\nThe experience places the user in an immersive industrial scenario where they can review key safety concepts, identify risks, follow guided procedures and interact with training elements related to confined space activities.\n\nThe app is intended for supervised corporate and educational use, especially in safety training contexts. It does not replace formal certification, legal training requirements or company-specific procedures. Instead, it serves as an immersive complement to traditional instruction, helping users better understand risks, sequence of actions and safety-critical behaviors.\n\nNR33 refers to the Brazilian occupational safety regulation related to confined space work. The content is educational and simulation-based.", "short_description": "VR training simulation for confined space work safety, based on the Brazilian NR33 occupational safety context."}]}, "developer_name": "Inside Tecnologia", "developer_privacy_policy_url": "https://insidetecnologia.com/compliance/privacidade/", "developer_terms_of_service_url": null, "publisher_name": "Inside Tecnologia", "support_website_url": null, "website_url": "https://insidetecnologia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "u
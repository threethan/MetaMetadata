tent-atl3-1.oculuscdn.com/v/t64.5771-25/499622214_1296441169268296_2832930429196333045_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MX3tkTWjMKEQ7kNvwFhzN3x&_nc_oc=AdqlYDU5WJULfBtrJMx7ywxzTmKgeLuOgONyu4YAJcfvl2UFHabGYv_qkW-L8f1fT1o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkP6Oil2NTIYn9UQmw6hSpOp74WRTjeNgAyKLAD99NxA&oe=6A71D779"}, {"file_name": "Imagem 14.png", "id": "996774986171277", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499623384_996774989504610_6337789378113176136_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oek2ah_ZMSMQ7kNvwGYWiMs&_nc_oc=AdodYDpElfsIA3FSF_J0u5dhBVZN2SG9tm1gdYls7RRuyNXjXz1qhAP2PpzsvTDR_-c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEx8B9e7Nk9Yq1YC15EXAkWsr-9pR0t68AwkKLJLTZM2g&oe=6A71EBBA"}, {"file_name": "Imagem 13.png", "id": "2352527605236901", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620817_2352527608570234_2026864260811438126_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OeEpaNJWmsQ7kNvwHQaaCg&_nc_oc=AdrUY2GLFG_2RAY6Jee4xyaMgeGTebqwasFf1n8MgHq4NEqUtgt6YNaaEWvKECpUcX4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDp2S1VmNUVD4KySE10x4M7edvUhypYJkK2nfa6SG7dQ&oe=6A71E876"}, {"file_name": "Imagem 12.png", "id": "4510893542517300", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/654867655_4510893545850633_2658747490649213769_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsFR22-7EQkQ7kNvwF5AUpW&_nc_oc=Adr3A-tZc16WfPD9RaVW4_D8Vzgtt-AnveQ2w_m3O-RigmvymKAzbYNiIbYDIroOCCg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGc8abRQX9kHV3CKt73QfkkgZYK6nXAznJf06_WTV-jbg&oe=6A71EBC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "2191038475046041", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499622285_2191038485046040_2469573563971578478_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmWlioHu17MQ7kNvwGNwjLI&_nc_oc=Adp0kl8bYtrdRMSO4XvG6qXE2bUqmxzwcQPYauR5RDQfedY-aKmuGSuvkHYodbBLYPs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9nSwJe39XIUOQO6SSBIQh6m1-LXf4TGzKVHvBDlDWaQ&oe=6A71EEE0"}, "display_name": "Confined Space NR33: Safety Playground", "keywords": ["training", "safety", "confined", "space", "industrial"], "long_description": "Safety Playground: NR33 Confined Space is a virtual reality training simulation designed to support safety awareness and procedural learning for confined space work.\n\nThe experience places the user in an immersive industrial scenario where they can review key safety concepts, identify risks, follow guided procedures and interact with training elements related to confined space activities.\n\nThe app is intended for supervised corporate and educational use, especially in safety training contexts. It does not replace formal certification, legal training requirements or company-specific procedures. Instead, it serves as an immersive complement to traditional instruction, helping users better understand risks, sequence of actions and safety-critical behaviors.\n\nNR33 refers to the Brazilian occupational safety regulation related to confined space work. The content is educational and simulation-based.", "short_description": "VR training simulation for confined space work safety, based on the Brazilian NR33 occupational safety context."}, {"images": {"nodes": []}, "id": "1026951690292355", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Espa\u00e7o Confinado NR33: Safety Playground", "keywords": ["treinamento", "seguran\u00e7a", "espa\u00e7o", "confinado", "industrial"], "long_description": "Safety Playground: NR33 Espa\u00e7o Confinado \u00e9 uma simula\u00e7\u00e3o de treinamento em realidade virtual criada para apoiar a conscientiza\u00e7\u00e3o sobre seguran\u00e7a e o aprendizado de procedimentos relacionados ao trabalho em espa\u00e7os confinados.\n\nA experi\u00eancia coloca o usu\u00e1rio em um ambiente industrial imersivo, onde \u00e9 poss\u00edvel revisar conceitos essenciais de seguran\u00e7a, identificar riscos, seguir orienta\u00e7\u00f5es guiadas e interagir com elementos de treinamento relacionados \u00e0s atividades em espa\u00e7o confinado.\n\nO aplicativo \u00e9 voltado para uso corporativo e educacional supervisionado, especialmente em contextos de treinamento de seguran\u00e7a do trabalho. Ele n\u00e3o substitui certifica\u00e7\u00f5es formais, exig\u00eancias legais de capacita\u00e7\u00e3o ou procedimentos espec\u00edficos de cada empresa. A proposta \u00e9 funcionar como um complemento imersivo ao treinamento tradicional, ajudando os usu\u00e1rios a compreender melhor os riscos, a sequ\u00eancia de a\u00e7\u00f5es e os comportamentos cr\u00edticos de seguran\u00e7a.\n\nA NR33 \u00e9 a norma regulamentadora brasileira relacionada \u00e0 seguran\u00e7a e sa\u00fade nos trabalhos em espa\u00e7os confinados. O conte\u00fado apresentado tem finalidade educativa e \u00e9 baseado em simula\u00e7\u00e3o.", "short_description": "Simula\u00e7\u00e3o em realidade virtual para treinamento de seguran\u00e7a em trabalho em espa\u00e7o confinado, com base no contexto da NR33."}]}, "developer_name": "Inside Tecnologia", "developer_privacy_policy_url": "https://insidetecnologia.com/compliance/privacidade/", "developer_terms_of_service_url": null, "publisher_name": "Inside Tecnologia", "support_website_url": null, "website_url": "https://insidetecnologia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27904163175874096"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619808_2280159949184062_5538222532187820938_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hm2uwtwaS6cQ7kNvwFV4V_m&_nc_oc=Ado7nsIWdjE4_6K9RUm2ur0Seho0N7iz8b4SYg2zcmq3z6-uq29cC1MB2mwp3iFfbU0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFv-gAqLCUMhV_vxvWnEbfijQsjoGJJyFrF_leAphUXhw&oe=6A71E32C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Confined Space NR33: Safety Playground", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1783618800, "lastRevision": {"nodes": [{"id": "27095427250081030", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "27095427176747704", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1710199810159041"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2072277030344014", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Safety Playground: NR33 Espa\u00e7o Confinado", "keywords": ["treinamento", "seguran\u00e7a", "espa\u00e7o", "confinado", "industrial"], "long_description": "Safety Playground: NR33 Espa\u00e7o Confinado \u00e9 uma simula\u00e7\u00e3o de treinamento em realidade virtual criada para apoiar a conscientiza\u00e7\u00e3o sobre seguran\u00e7a e o aprendizado de procedimentos relacionados ao trabalho em espa\u00e7os confinados.\n\nA experi\u00eancia coloca o usu\u00e1rio em um ambiente industrial imersivo, onde \u00e9 poss\u00edvel revisar conceitos essenciais de seguran\u00e7a, identificar riscos, seguir orienta\u00e7\u00f5es guiadas e interagir com elementos de treinamento relacionados \u00e0s atividades em espa\u00e7o confinado.\n\nO aplicativo \u00e9 voltado para uso corporativo e educacional supervisionado, especialmente em contextos de treinamento de seguran\u00e7a do trabalho. Ele n\u00e3o substitui certifica\u00e7\u00f5es formais, exig\u00eancias legais de capacita\u00e7\u00e3o ou procedimentos espec\u00edficos de cada empresa. A proposta \u00e9 funcionar como um complemento imersivo ao treinamento tradicional, ajudando os usu\u00e1rios a compreender melhor os riscos, a sequ\u00eancia de a\u00e7\u00f5es e os comportamentos cr\u00edticos de seguran\u00e7a.\n\nA NR33 \u00e9 a norma regulamentadora brasileira relacionada \u00e0 seguran\u00e7a e sa\u00fade nos trabalhos em espa\u00e7os confinados. O conte\u00fado apresentado tem finalidade educativa e \u00e9 baseado em simula\u00e7\u00e3o.", "short_description": "Simula\u00e7\u00e3o em realidade virtual para treinamento de seguran\u00e7a em trabalho em espa\u00e7o confinado, com base no contexto da NR33."}, {"images": {"nodes": [{"file_name": "Cover Square.png", "id": "2280159945850729", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619808_2280159949184062_5538222532187820938_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hm2uwtwaS6cQ7kNvwFV4V_m&_nc_oc=Ado7nsIWdjE4_6K9RUm2ur0Seho0N7iz8b4SYg2zcmq3z6-uq29cC1MB2mwp3iFfbU0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAAs6LnWg80_qK94LPrxPVAfA1rSt8AMmujvJ1fzKXVg&oe=6A71E32C"}, {"file_name": "Icon.png", "id": "2279379859627668", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/4996234
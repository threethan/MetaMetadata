-1.oculuscdn.com/v/t64.5771-25/38982516_1450238888778255_1716779583130603234_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTqYc2IzRYoQ7kNvwHnM7k_&_nc_oc=AdpWcsiR2Fm8AnpccA1WZO-QHaBfG7AUdC4W7X5ZZrHLH_KUxNog22-jkKsp9IGpId0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3jx9fUPXuzYGynSt7QweDoJOQiaj_bpjCa1pvd2WXz7Q&oe=69F4BC7F"}, {"file_name": "screen5.png", "id": "634593251368551", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75195911_634593254701884_9186735167580064035_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cOyMuLuczcwQ7kNvwE2-90n&_nc_oc=AdoWascr1PQDdkHgT4VLDUALmdjJ58WcjYNyLcT4IBb7X3fY1XGyRAS_TLiy7Kscmmo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3VLC1nRY-JE7hiOWxsDvEf7k_F6wPdt1Im1PTC20n7lA&oe=69F4B296"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75375753_3903884889682947_4886526662235127808_n.png", "id": "3935345336525084", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031490_3935345339858417_9122599871720348175_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qu1yqQlCvW0Q7kNvwHdVDqx&_nc_oc=Adp0HqEUmpYMQrxqmEA2h7vopgI2XBBMKIvW9FF59Dsa_okcFs4tuVpc_RoOrODabGs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1JT7-PbzL0kR4LnUAR_sIZ7kJvMedobGKGMNwIsKWp1Q&oe=69F4B3D5"}, "display_name": "B99 Untethered", "keywords": [], "long_description": "A Fast Paced Shooter set in a Roguelike Metaverse crafted by the B99 AI itself.  The remnants of humanity are forced to challenge a Labyrinth created by an AI trained on Classic Digital Games.  For the B99 it is only a Game and you only the Player.  For humanity it is survival. Upgrades and Weapons abound to help you overcome Enemies, Bosses, and Traps looking to end your Run.", "short_description": "B99 is an FPS Shooter Roguelike set in a vision of cyberspace pulled from the 1980s.  Dungeons are randomly generated each play through."}]}, "developer_name": "IronStomach LLC", "developer_privacy_policy_url": "
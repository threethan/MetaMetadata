238888778255_1716779583130603234_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvN33VTgwfUQ7kNvwFUfdu0&_nc_oc=AdlQCnKG1XPsR59DW_SXVymooRjVZpsp86ZKY7toEYClvTCG6ExCjDp_ukJtbtUxjPo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyai6kUkX6YcxuhJYOk38DOmQdvVA1bK6-YJOiJLWavNw&oe=69AEA4BF"}, {"file_name": "screen5.png", "id": "634593251368551", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195911_634593254701884_9186735167580064035_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPAIexUwTagQ7kNvwFNvJTE&_nc_oc=AdnHP4BctjdjdD3PFG7sOEuKayGyTCGLuKeQHomryWUsHqmIkg7Ovg10GYfXef9-wCI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afydr04DYqD8nGd0bnjOEaEVzUI2XmHjKcVHW6G1dgGqxA&oe=69AED316"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75375753_3903884889682947_4886526662235127808_n.png", "id": "3935345336525084", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031490_3935345339858417_9122599871720348175_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfe1LEStOhIQ7kNvwHIc-jp&_nc_oc=AdkxfpZ0CeBqZzjbAf_Ze3o4bognJQvUFdzwHDAeVxKvvak4iC85A6YtW9fC9-HEx4Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxSKlgqG5HNgTDc4JJrTN8J1XPJLHdpEUtn78_YqaqMXQ&oe=69AED455"}, "display_name": "B99 Untethered", "keywords": [], "long_description": "A Fast Paced Shooter set in a Roguelike Metaverse crafted by the B99 AI itself.  The remnants of humanity are forced to challenge a Labyrinth created by an AI trained on Classic Digital Games.  For the B99 it is only a Game and you only the Player.  For humanity it is survival. Upgrades and Weapons abound to help you overcome Enemies, Bosses, and Traps looking to end your Run.", "short_description": "B99 is an FPS Shooter Roguelike set in a vision of cyberspace pulled from the 1980s.  Dungeons are randomly generated each play through."}]}, "developer_name": "IronStomach LLC", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyb99untethered
238888778255_1716779583130603234_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvSkqrxCslsQ7kNvwFrS2fH&_nc_oc=AdmkN6XARQjYEuOFO-7HsO4fYW41rtoczEAbRF5vgsS7E_E21kLvfuixFSa2Y_Ead1g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsgxwfwiAuJ4DLibKEtlZHGmhN6Mc5zzKmlYxY_S0fFSQ&oe=69A80D3F"}, {"file_name": "screen5.png", "id": "634593251368551", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195911_634593254701884_9186735167580064035_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hwGB32xytsQ7kNvwHbzzLU&_nc_oc=AdlJmrCSiUwj6UbZBTFqIQ-znJvSkx2nwkdxdZZvfGYKZdTgigqxOC-1vn6rfPSsKCs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftwJU3CX-iBIg9_V81_3dQ369sLbu-gVNlvw1httjaPMw&oe=69A83B96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75375753_3903884889682947_4886526662235127808_n.png", "id": "3935345336525084", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031490_3935345339858417_9122599871720348175_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5pT_2WENFkQ7kNvwG0DdVf&_nc_oc=AdmUk2YkBTGs6_LCX2XinGuTHjtf9mLAWzTyn1bppsmqqxBLvKGsY_DPEShoPSoyyr4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv8hkJeNcVM_Blhb7d2MRjQo2PvXo088fcL-1o0o2GMCg&oe=69A83CD5"}, "display_name": "B99 Untethered", "keywords": [], "long_description": "A Fast Paced Shooter set in a Roguelike Metaverse crafted by the B99 AI itself.  The remnants of humanity are forced to challenge a Labyrinth created by an AI trained on Classic Digital Games.  For the B99 it is only a Game and you only the Player.  For humanity it is survival. Upgrades and Weapons abound to help you overcome Enemies, Bosses, and Traps looking to end your Run.", "short_description": "B99 is an FPS Shooter Roguelike set in a vision of cyberspace pulled from the 1980s.  Dungeons are randomly generated each play through."}]}, "developer_name": "IronStomach LLC", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyb99untethered
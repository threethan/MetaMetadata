238888778255_1716779583130603234_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ayv-MOCUYRcQ7kNvwGd-0VA&_nc_oc=Adkwu00nacHRbYf-WRbx0WCY3NK3aZozotBOnVS_VskNqOfzDRGzezpZPbriTillnkM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxvTNP5CMhOIHdkPCusOzNaiC7AxAHyPV4R2kz2E0X0zQ&oe=69B53C3F"}, {"file_name": "screen5.png", "id": "634593251368551", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195911_634593254701884_9186735167580064035_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jycwk6Tgo0cQ7kNvwFDyeyf&_nc_oc=AdnS-or5UBpK5NDhvFKm7I4_yA4_7lJpgTXUsvVUxzKYmQdxoG7XF6NxAM1xXDSq9M0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEj-5I2XhPgU02ds3uDfprq9Bzyth9InAoyEBmOCHtlw&oe=69B56A96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75375753_3903884889682947_4886526662235127808_n.png", "id": "3935345336525084", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031490_3935345339858417_9122599871720348175_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvMqQKCoqwcQ7kNvwE3bTiC&_nc_oc=AdnsSCSht8UjdVohW4hqxdhqIuElRHZS4w7dHxoSzFuF0MHj7x1cA6HzlmtIhHchBo8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz5wbeAqX8nhgBD52QLm9HXoVJ_djERvWx0-5gRYxgxbw&oe=69B56BD5"}, "display_name": "B99 Untethered", "keywords": [], "long_description": "A Fast Paced Shooter set in a Roguelike Metaverse crafted by the B99 AI itself.  The remnants of humanity are forced to challenge a Labyrinth created by an AI trained on Classic Digital Games.  For the B99 it is only a Game and you only the Player.  For humanity it is survival. Upgrades and Weapons abound to help you overcome Enemies, Bosses, and Traps looking to end your Run.", "short_description": "B99 is an FPS Shooter Roguelike set in a vision of cyberspace pulled from the 1980s.  Dungeons are randomly generated each play through."}]}, "developer_name": "IronStomach LLC", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyb99untethered
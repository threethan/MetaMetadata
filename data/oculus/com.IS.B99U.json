238888778255_1716779583130603234_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvN33VTgwfUQ7kNvwFSKGx2&_nc_oc=Adn08pfxzYMDMDbB7xbRz3uyAy3kQxBa_k4Vo5qfu_QJH8jFeRv2CDxKeZGhMjM3a2U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwoBGofCBaVanzuMbLgL0vYPWb1O3dfd3wLS0DfTb93QA&oe=69AD533F"}, {"file_name": "screen5.png", "id": "634593251368551", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195911_634593254701884_9186735167580064035_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPAIexUwTagQ7kNvwHDo5IB&_nc_oc=AdlhWg5u5iwZH5FHWs5U7j6ftIw7Id3XGSYKUYhSVyFn6YF9VJBXqxLIvuvDE2vkEHY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOSblumYbGREOY85wSDfWC5bu_4zTz5PvhdLR9kEyieQ&oe=69AD8196"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75375753_3903884889682947_4886526662235127808_n.png", "id": "3935345336525084", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031490_3935345339858417_9122599871720348175_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfe1LEStOhIQ7kNvwEf6n2t&_nc_oc=AdlKkvnIurBr8F5BXsrzffzWbwWJnwUo0RSi_-pKoWMzDiiGbjxJH6uYL69sFHpyVZM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzmBiwpnUNQvNI-zd8lh6uIzfY-HaEofTNx7DQFZBdVZQ&oe=69AD82D5"}, "display_name": "B99 Untethered", "keywords": [], "long_description": "A Fast Paced Shooter set in a Roguelike Metaverse crafted by the B99 AI itself.  The remnants of humanity are forced to challenge a Labyrinth created by an AI trained on Classic Digital Games.  For the B99 it is only a Game and you only the Player.  For humanity it is survival. Upgrades and Weapons abound to help you overcome Enemies, Bosses, and Traps looking to end your Run.", "short_description": "B99 is an FPS Shooter Roguelike set in a vision of cyberspace pulled from the 1980s.  Dungeons are randomly generated each play through."}]}, "developer_name": "IronStomach LLC", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyb99untethered
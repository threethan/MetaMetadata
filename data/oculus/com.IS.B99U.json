238888778255_1716779583130603234_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvSkqrxCslsQ7kNvwHLhbT8&_nc_oc=AdkyPlCcMFX67Qp1ZKngkxdCKC8gwpoXoM7SlWcahBpEIJUyxQC_qaGvJNL7V9qlJT8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afu_wdzGeCcOEV6MvEMWymDwDyiokWq6jTmj7JBQqgq53g&oe=69A996FF"}, {"file_name": "screen5.png", "id": "634593251368551", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195911_634593254701884_9186735167580064035_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72EekWHULsgQ7kNvwFGPZCy&_nc_oc=AdnYjHCIDozJf1jhKV_aEEV63TEY_clqmwRWZdHgOP45HgQSkZBbTaSRfLeaJO48das&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuTreMXduOMN9menxMCIVP7tCaEVULwr8LE-GylqGJoqg&oe=69A98D16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75375753_3903884889682947_4886526662235127808_n.png", "id": "3935345336525084", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031490_3935345339858417_9122599871720348175_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5pT_2WENFkQ7kNvwESoY7U&_nc_oc=AdlhO3vs7VVQKWyaWCapkLdVnttYoMql80bRBZqT6y_gT_PTPUxwc_jxbgvFUf0FqEM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsKPAM7PqN0JBFd9iPGDNFl3U6Yp0O6lC-RRWg4V1fxFw&oe=69A98E55"}, "display_name": "B99 Untethered", "keywords": [], "long_description": "A Fast Paced Shooter set in a Roguelike Metaverse crafted by the B99 AI itself.  The remnants of humanity are forced to challenge a Labyrinth created by an AI trained on Classic Digital Games.  For the B99 it is only a Game and you only the Player.  For humanity it is survival. Upgrades and Weapons abound to help you overcome Enemies, Bosses, and Traps looking to end your Run.", "short_description": "B99 is an FPS Shooter Roguelike set in a vision of cyberspace pulled from the 1980s.  Dungeons are randomly generated each play through."}]}, "developer_name": "IronStomach LLC", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyb99untethered
-1.oculuscdn.com/v/t64.5771-25/38982516_1450238888778255_1716779583130603234_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4oNS3BrrV4Q7kNvwFMtmNX&_nc_oc=Adr_NUCh_4qPYXJqDZAvO7wRrgPAc5goes5Yx1zue6pg07kR3yTY8P9-2gURWqoH4So&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxVLTPcbINjYQLqjWzlc7xQXlLugotRcKq9klUPdjQ_4Q&oe=69C5467F"}, {"file_name": "screen5.png", "id": "634593251368551", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75195911_634593254701884_9186735167580064035_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=by89SAfUaMkQ7kNvwG5qt1n&_nc_oc=Adrhy5NYTlcaG4pAbGnv-JVSDvi19es0oYU0H5n9N_-Chf5pvHIiHA0mTUO2bOi7etk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxSXmhpFpNUvQyxZWY5t9Xl8rvXg9xB4k4-UaJzbt__5w&oe=69C53C96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75375753_3903884889682947_4886526662235127808_n.png", "id": "3935345336525084", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031490_3935345339858417_9122599871720348175_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IO81erOZ-KcQ7kNvwHgUqdq&_nc_oc=Adq2DZGSc-bzRAMrbL6JPKupOK4_T4KpKXkjILmao6LTkIzA6BxsaRisT3N39HpOrso&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyE8gzKYFSVSCTiLTk2OjAyLmnx_17CzzOLT0i08XMB2A&oe=69C53DD5"}, "display_name": "B99 Untethered", "keywords": [], "long_description": "A Fast Paced Shooter set in a Roguelike Metaverse crafted by the B99 AI itself.  The remnants of humanity are forced to challenge a Labyrinth created by an AI trained on Classic Digital Games.  For the B99 it is only a Game and you only the Player.  For humanity it is survival. Upgrades and Weapons abound to help you overcome Enemies, Bosses, and Traps looking to end your Run.", "short_description": "B99 is an FPS Shooter Roguelike set in a vision of cyberspace pulled from the 1980s.  Dungeons are randomly generated each play through."}]}, "developer_name": "IronStomach LLC", "developer_privacy_policy_url": "
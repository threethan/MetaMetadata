238888778255_1716779583130603234_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqEM_JczZYcQ7kNvwFVrGXN&_nc_oc=AdkcyVKaFAb6qIIsBhigLwoihr-DCvJAGlfilpQswF_a9_w8xYB4x_2jX13KNOXISns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwLqNbUYCEn2hQxCQty8b6fTfc4n6XzEoXynK9xsHj9Pg&oe=69C0007F"}, {"file_name": "screen5.png", "id": "634593251368551", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195911_634593254701884_9186735167580064035_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOhqbe943x8Q7kNvwH-OljQ&_nc_oc=Adn_P5e68LEd14liMIv6erUMY5aY5d0DadOgN0djqzAJ_MpR93ZAPXZZgaiGtCU7ayY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzrXb-Q75A64utZwecVx9npQu9EXdLsWoChIOlu5U0dHw&oe=69BFF696"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75375753_3903884889682947_4886526662235127808_n.png", "id": "3935345336525084", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031490_3935345339858417_9122599871720348175_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tT7hdWOSJEsQ7kNvwGT_2kO&_nc_oc=AdlIob8Grc68B1OThoKQdqCuIC4MDyaqkzhDJ1EfkQnAdkTokaV_JicHRGPlkQ9gzRI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwDm-AYj_a2hJO2yRuPJa33f90zfYf-5Sn2OaF46adyKw&oe=69BFF7D5"}, "display_name": "B99 Untethered", "keywords": [], "long_description": "A Fast Paced Shooter set in a Roguelike Metaverse crafted by the B99 AI itself.  The remnants of humanity are forced to challenge a Labyrinth created by an AI trained on Classic Digital Games.  For the B99 it is only a Game and you only the Player.  For humanity it is survival. Upgrades and Weapons abound to help you overcome Enemies, Bosses, and Traps looking to end your Run.", "short_description": "B99 is an FPS Shooter Roguelike set in a vision of cyberspace pulled from the 1980s.  Dungeons are randomly generated each play through."}]}, "developer_name": "IronStomach LLC", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyb99untethered
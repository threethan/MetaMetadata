238888778255_1716779583130603234_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=devkZQKZ7y4Q7kNvwH9gG5w&_nc_oc=AdkMIFEl_SFCa8JnFHeLUmZ76geOdUfF8uHuJFr9liazppsGpNh1LrhorqdtcjukM20&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZugjt3nk5bA50tEErPiNiEPYbO4fCD8EZ6XlZ3nn_Jg&oe=69AFF63F"}, {"file_name": "screen5.png", "id": "634593251368551", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195911_634593254701884_9186735167580064035_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPAIexUwTagQ7kNvwFY8iwU&_nc_oc=Adl2Ff_RVYNVzF0n10uvNFiqE2oWKidi_LmTh1KH2O_ifzYqsscOb-KA9CWa9_sQpvA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzduJ7UPeoxaYCi0NUV7ZhsMFIGuE36_pxH7fMyn2wmkw&oe=69B02496"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75375753_3903884889682947_4886526662235127808_n.png", "id": "3935345336525084", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031490_3935345339858417_9122599871720348175_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCKr4lVQI8QQ7kNvwFrVBSc&_nc_oc=AdkeLm_LaDK5-lFfN2n8-EysMRC77kE0b_2pj4ar_KJply718FvT0b4QxCrHBByJgGI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwm1PhQAnzSBw4IrZhjXh8NwenQD-5YZXJlArDmOTWszA&oe=69B025D5"}, "display_name": "B99 Untethered", "keywords": [], "long_description": "A Fast Paced Shooter set in a Roguelike Metaverse crafted by the B99 AI itself.  The remnants of humanity are forced to challenge a Labyrinth created by an AI trained on Classic Digital Games.  For the B99 it is only a Game and you only the Player.  For humanity it is survival. Upgrades and Weapons abound to help you overcome Enemies, Bosses, and Traps looking to end your Run.", "short_description": "B99 is an FPS Shooter Roguelike set in a vision of cyberspace pulled from the 1980s.  Dungeons are randomly generated each play through."}]}, "developer_name": "IronStomach LLC", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyb99untethered
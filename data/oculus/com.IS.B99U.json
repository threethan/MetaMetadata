6_1450238888778255_1716779583130603234_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvSkqrxCslsQ7kNvwEWLqzo&_nc_oc=AdnPX2SzGg1F68ZJQjCLC6y_uhhDOjbuYZEdKpCE5vL2du3rkwY0gBnVsOv0-jvJ-yo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afxj5Ka98xrQ_RehmcnHJBPeJeankdjk9KT2AFek2-W9QA&oe=69AAB03F"}, {"file_name": "screen5.png", "id": "634593251368551", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75195911_634593254701884_9186735167580064035_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72EekWHULsgQ7kNvwHg-j9a&_nc_oc=AdnWViqh8XI13iJ_hr6IfaOeORb1egfUq9_lov6X02Q4ggmZlaE7pRv3OLPYCazJS70&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyh7lbhIJPiEtEw_IGStXU-Q0Xy8zC_aqJcW7RtK9OlBw&oe=69AADE96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75375753_3903884889682947_4886526662235127808_n.png", "id": "3935345336525084", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031490_3935345339858417_9122599871720348175_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5pT_2WENFkQ7kNvwGDpa-e&_nc_oc=AdkaeEc6Um8Gt-8Y5SlVa2-jkQAcx-kkgw_3xa9_w6WldufPlz5hWJ6USRTt5pekTsM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyxfOgvCtRyTsGyiLKiyAlxIAhRMpBBPRNY3uTPXz5jNA&oe=69AADFD5"}, "display_name": "B99 Untethered", "keywords": [], "long_description": "A Fast Paced Shooter set in a Roguelike Metaverse crafted by the B99 AI itself.  The remnants of humanity are forced to challenge a Labyrinth created by an AI trained on Classic Digital Games.  For the B99 it is only a Game and you only the Player.  For humanity it is survival. Upgrades and Weapons abound to help you overcome Enemies, Bosses, and Traps looking to end your Run.", "short_description": "B99 is an FPS Shooter Roguelike set in a vision of cyberspace pulled from the 1980s.  Dungeons are randomly generated each play through."}]}, "developer_name": "IronStomach LLC", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyb99untethered/home", "developer_terms_of_service_url": "http://ironstoma.ch/IronStoma.ch.htm", "publisher_name": "IronStomach LLC", "support_website_url": "http://ironstoma.ch/", "website_url": "http://ironstoma.ch/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "RPG", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3347211925549000"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "875778244614968"}, {"status": "PUBLISHED", "id": "1160905875014077"}, {"status": "PUBLISHED", "id": "570655511494535"}]}, "baseline_offer": {"id": "1160905875014077"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1729789200, "status": "PUBLISHED", "id": "875778244614968"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27827664630182775", "version": "163"}, "id": "434716501012677", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5040980022611226", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27827664630182775"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "434716501012677"}]}, "change_log": null, "created_date": 1733631312,
238888778255_1716779583130603234_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFl-NsQKc9gQ7kNvwF7jd4v&_nc_oc=Adlf7JsUjf5f52uW6HFKZP-rYimMLV6jdoa6TBA4f45--4PAozoVOqebdtkNeRhmtqo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx_WHdvGlGanLdMn0qI-ftzMZWTjkMnN5y4QIb7ehsmCg&oe=69B7DF3F"}, {"file_name": "screen5.png", "id": "634593251368551", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195911_634593254701884_9186735167580064035_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jycwk6Tgo0cQ7kNvwGlnlpe&_nc_oc=Admi3YACNzUykuoxnjkdFPtUIibOVWpMyo1Dbz3JAyocrpPrsvhYq-hPTY7IZz19394&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwEsU7ro5NN6_ng5mi0ZUJwkh1ISqC1T4CcAtv5YNBkaw&oe=69B80D96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75375753_3903884889682947_4886526662235127808_n.png", "id": "3935345336525084", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031490_3935345339858417_9122599871720348175_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPw9BUG6ucgQ7kNvwF5VC-h&_nc_oc=AdkfBNPZ5RJX8MLXbogxZj7SMhpC2fJFPUBaeV1RRwEOPiRh_QBlmfueZWdEclS46WE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyz8_DpfFT8cbxAQce01z9R0qJ1bpfqQ38Td_W37knoWA&oe=69B80ED5"}, "display_name": "B99 Untethered", "keywords": [], "long_description": "A Fast Paced Shooter set in a Roguelike Metaverse crafted by the B99 AI itself.  The remnants of humanity are forced to challenge a Labyrinth created by an AI trained on Classic Digital Games.  For the B99 it is only a Game and you only the Player.  For humanity it is survival. Upgrades and Weapons abound to help you overcome Enemies, Bosses, and Traps looking to end your Run.", "short_description": "B99 is an FPS Shooter Roguelike set in a vision of cyberspace pulled from the 1980s.  Dungeons are randomly generated each play through."}]}, "developer_name": "IronStomach LLC", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyb99untethered
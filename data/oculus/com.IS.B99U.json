238888778255_1716779583130603234_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ayv-MOCUYRcQ7kNvwFMgZAG&_nc_oc=AdktwElIXlIkN8sp3w1hKhuSrIDi64uKWPNqrN_0os8MUtk9RXiXaatlbhH2NYGKzVU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9SrkfTh9xifa0Fwjr4fTYe2_GAUhuxl-RdDy-swj4RA&oe=69B68DBF"}, {"file_name": "screen5.png", "id": "634593251368551", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75195911_634593254701884_9186735167580064035_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jycwk6Tgo0cQ7kNvwHMGRci&_nc_oc=AdmECv1NfKv0uhBNwwJkVNuSQzU-vLht6kFMSyLemK3XPk7g_hwmf97-Jkj8Fa3es5Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7yR7lUq8ZNXxkqXJe9FQ0_v0sPSPYHYRzMzEzh3ckkw&oe=69B6BC16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75375753_3903884889682947_4886526662235127808_n.png", "id": "3935345336525084", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031490_3935345339858417_9122599871720348175_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvMqQKCoqwcQ7kNvwEwmuUP&_nc_oc=Adk3LI42L4V6wqDnXpmkBHNlpr7U-GPb6FD-dtjAa430kernCF-4WSY-9YK457JA_-o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyym7vI2CWcjrw6p-mpbuhIVfxY_z2FaYAQaDg4BK5hgw&oe=69B6BD55"}, "display_name": "B99 Untethered", "keywords": [], "long_description": "A Fast Paced Shooter set in a Roguelike Metaverse crafted by the B99 AI itself.  The remnants of humanity are forced to challenge a Labyrinth created by an AI trained on Classic Digital Games.  For the B99 it is only a Game and you only the Player.  For humanity it is survival. Upgrades and Weapons abound to help you overcome Enemies, Bosses, and Traps looking to end your Run.", "short_description": "B99 is an FPS Shooter Roguelike set in a vision of cyberspace pulled from the 1980s.  Dungeons are randomly generated each play through."}]}, "developer_name": "IronStomach LLC", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyb99untethered
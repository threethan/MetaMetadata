238888778255_1716779583130603234_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ur20x6wRqhIQ7kNvwE_MQND&_nc_oc=AdnW9tVbaKbvujtBleRUcQ-s51LZ3PIDWwku-XdrLCP1Rnym1NhC74j8EcBA9YyUez8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwhDg5lMTdTilC-eB6fd6kmn5c4OC0VNLP_oZQ3iBU42w&oe=69BC0BFF"}, {"file_name": "screen5.png", "id": "634593251368551", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195911_634593254701884_9186735167580064035_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YY1cXrT2NEQ7kNvwEbqA9e&_nc_oc=Adm5VpqRn--7b5yjgC_S7yBxlZsv5UDVx4VCPoh-mN8iushkxlb6IiQZP30FqOYAsPE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw7Ua51Y1peZVSeCaJTtbnIHSQ_t_a4zWAUs5aU5cPhFg&oe=69BC0216"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75375753_3903884889682947_4886526662235127808_n.png", "id": "3935345336525084", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031490_3935345339858417_9122599871720348175_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cPHlROVYrQQ7kNvwHh-7av&_nc_oc=Adl98CbKoKOocpzLR6LPVMGZ6lQRx2UE8hvKEUa9Y38mFJIcD4bf6s00E_dvqD3fYfw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw44uKT2t_Ik_RYsJevUxDl3UCmnbKZC-gGDm2kl__pHQ&oe=69BC0355"}, "display_name": "B99 Untethered", "keywords": [], "long_description": "A Fast Paced Shooter set in a Roguelike Metaverse crafted by the B99 AI itself.  The remnants of humanity are forced to challenge a Labyrinth created by an AI trained on Classic Digital Games.  For the B99 it is only a Game and you only the Player.  For humanity it is survival. Upgrades and Weapons abound to help you overcome Enemies, Bosses, and Traps looking to end your Run.", "short_description": "B99 is an FPS Shooter Roguelike set in a vision of cyberspace pulled from the 1980s.  Dungeons are randomly generated each play through."}]}, "developer_name": "IronStomach LLC", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyb99untethered
ive you some fitness exercise. You will need to react fast, wise and predictive. Use exact and wide hand movements to assign rotes, rush from one side of airfield to another, bend and even jump to get the planes flying on higher levels - like you are DANCING between runways.", "short_description": "Control aircraft around airports inspired by real locations while avoiding disastrous collisions."}]}, "developer_name": "reflektsoft.com", "developer_privacy_policy_url": "https://reflektsoft.com/atbvr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "reflektsoft.com", "support_website_url": null, "website_url": "https://reflektsoft.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8852728318114703"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982518_1607411583483205_8254580847343259387_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1Znx12Ye2YQ7kNvwEmGQri&_nc_oc=Adogrx9DZ9t0-PukxpiHL8lik9-a3yzIHSNCOVQOLr4A477tc-9MHw1-eWcw_JpHCiU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-ioJRjcS_Y2AOIo6V1RwqDCjjUg58o5KQWTFYEE6HtA&oe=6AEE0B33"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Air Traffic BLITZ", "platform": "ANDROID_6DOF", "context_category": {
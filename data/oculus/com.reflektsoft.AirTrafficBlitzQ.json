1_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVD4DJrL0WwQ7kNvwFILffP&_nc_oc=AdrhLRjX2FOyzqto15rPQlmL5Iuk3DkW2NBScuE315XWrqB98eDC3SfIdv5rBTKqXFo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSH_TU2CdkQYkqBaKt100SVkO4pP_-QtXmw9ObjnNPo5g&oe=6AE766F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumb.png", "id": "942631240609208", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57575346_942631243942541_5660738900294071439_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pu6vjRsBCdEQ7kNvwG3MMTs&_nc_oc=Adqsk6F0OLLRvGONACGIPrmeUYzuIft4Pka0UfHnWS-6JcVxSB3E5j6S48Ck15QY1Nw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqBdyZvcn3RkJTWk6UbAPQiesWGHYOCY4JR5rCgAz-XA&oe=6AE74D5E"}, "display_name": "Air Traffic BLITZ", "keywords": [], "long_description": "You are an air traffic controller. Your duty is to manage the movement of drone planes, delivering cargo to one of the airports under your supervision.\n\nThe airspace is busy, airplanes coming fast - so expect the task to be physically challenging and give you some fitness exercise. You will need to react fast, wise and predictive. Use exact and wide hand movements to assign rotes, rush from one side of airfield to another, bend and even jump to get the planes flying on higher levels - like you are DANCING between runways.", "short_description": "Control aircraft around airports inspired by real locations while avoiding disastrous collisions."}]}, "developer_name": "reflektsoft.com", "developer_privacy_policy_url": "https://reflektsoft.com/atbvr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "reflektsoft.com", "support_website_url": null, "website_url": "https://reflektsoft.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id"
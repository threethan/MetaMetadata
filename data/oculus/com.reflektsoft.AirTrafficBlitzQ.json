1_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMghwP4-GDEQ7kNvwFNpU82&_nc_oc=AdrGQleNNqRaoNhIogjFAsuf4LtJMyslUtJOT9NR-FMg4z9BGZ1ZC9xMf7-h7eMcbf8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCLyRB7iQMHh7QRZDAn_R-BqH5Lwj1lSVd_X84ScssAA&oe=6A60B5B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumb.png", "id": "942631240609208", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575346_942631243942541_5660738900294071439_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnlaxdSO3jQQ7kNvwE8vKfX&_nc_oc=AdqEIVSymH1jf9GCi0MPQXVXKl3JWTin2AXR8VjonCRpSVWHLvfy2hp0z1IqXT1A6rI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCN9wQFqUIYvfmqJu39KJbrJr5DaC0RzQ3GipxJnLRvMg&oe=6A60D45E"}, "display_name": "Air Traffic BLITZ", "keywords": [], "long_description": "You are an air traffic controller. Your duty is to manage the movement of drone planes, delivering cargo to one of the airports under your supervision.\n\nThe airspace is busy, airplanes coming fast - so expect the task to be physically challenging and give you some fitness exercise. You will need to react fast, wise and predictive. Use exact and wide hand movements to assign rotes, rush from one side of airfield to another, bend and even jump to get the planes flying on higher levels - like you are DANCING between runways.", "short_description": "Control aircraft around airports inspired by real locations while avoiding disastrous collisions."}]}, "developer_name": "reflektsoft.com", "developer_privacy_policy_url": "https://reflektsoft.com/atbvr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "reflektsoft.com", "support_website_url": null, "website_url": "https://reflektsoft.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id"
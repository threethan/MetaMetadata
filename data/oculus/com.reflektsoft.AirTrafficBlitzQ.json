1_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XM1ycnp1NSYQ7kNvwE3u1Gg&_nc_oc=Adpk-ZW9UU_xSIeV0VXVTnywvRoTHviHlc-spb1L0HhQgq6nW4KYSSlSTLDDXCsDV_o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYcoL15Xuw_7V2hdpOxoqzq6Fqc8S3W2uIvuo9qM2l0w&oe=6A7870B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumb.png", "id": "942631240609208", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575346_942631243942541_5660738900294071439_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAvTTF1XIsIQ7kNvwHrz_xK&_nc_oc=AdrIzxIEIzguY-3z-JJg8dx3jA1P3BNKfkMHjmZltoI8U1D-GAPYfVtwYYdnRrAx-Gw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFfIa2jprOkuLfxc9bVGtXYHk6MzJTQv_w_vRU4xpwOQ&oe=6A788F5E"}, "display_name": "Air Traffic BLITZ", "keywords": [], "long_description": "You are an air traffic controller. Your duty is to manage the movement of drone planes, delivering cargo to one of the airports under your supervision.\n\nThe airspace is busy, airplanes coming fast - so expect the task to be physically challenging and give you some fitness exercise. You will need to react fast, wise and predictive. Use exact and wide hand movements to assign rotes, rush from one side of airfield to another, bend and even jump to get the planes flying on higher levels - like you are DANCING between runways.", "short_description": "Control aircraft around airports inspired by real locations while avoiding disastrous collisions."}]}, "developer_name": "reflektsoft.com", "developer_privacy_policy_url": "https://reflektsoft.com/atbvr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "reflektsoft.com", "support_website_url": null, "website_url": "https://reflektsoft.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id"
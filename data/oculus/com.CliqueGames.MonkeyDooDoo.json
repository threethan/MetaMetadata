t64.5771-25/75221322_541147131739595_7049747370601371318_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ojE-LiRJsYQ7kNvwG3XOCJ&_nc_oc=Adr-pqkn03F8JFspXaeqAo7P56OIsSv48L3VggiAYEdVbX1f2zE39DXmdJNubYgcGsE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rLmqPQ8RHhknqVnGK2MXEMc4u2KFDLrVONUYjW9JjKA&oe=6A0F1A2F"}, {"file_name": "Swamp.png", "id": "1017283003910400", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499297447_1017283007243733_550097104264033962_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArqQxh32LbkQ7kNvwE9b4pr&_nc_oc=Adr85MMWSWJAxdjx2F_7sz2n8y0yVQrXNzpWqj1-gGFP5F6QmvfPB1gsLMGFXq_l_x8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7awAMvV-iMxkRokG2ujS2eyhXUSiFm8mhCXjdJSieVqg&oe=6A0F0A6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MD_Landscape.png", "id": "906447009117582", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620432_906447012450915_6014910777510186176_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qlG5gqRHbxkQ7kNvwEoaFrZ&_nc_oc=Adp3LqAscDhupHfjgNn7VRK9RVPmqQqc4CKcX-r57-PRnQ8Y2jxRN8lNIVEDTzZqr0s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6y4Hw4KUbXQKFzOtJ03LVMWgVtAz2Mi0n2DPEc2vpFsA&oe=6A0F09B1"}, "display_name": "Monkey Doo", "keywords": ["free", "multiplayer", "gorilla", "social", "hangout"], "long_description": "#                                                                                                                                                                                                       \n\n{1077943844296017}\n\n# ABOUT THE GAME\n\nIn the Bermuda Triangle, you and your monkey friends have one mission: swing, throw, and climb your way to fun!\n\n{2181339839044478}\n\n**Play Your Way:** Multiple game modes offer you and your friends different ways to monkey around, including banana collection and cooperative survival. New modes are coming all the time!\n\n{1234204794637922}\n\n**Get Some Drip:** Customize your body color, equip face & head cosmetics, and stylize your doo.\n\n{1430846391437069}\n\n**Ruby Mines:** Explore an endless set of tunnels filled with secrets and strange denizens. You can also unlock exclusive seasonal rewards via the Battle Pass, including Cosmetics, Doos, Boosters, and more!\n", "short_description": "Live in the heart of the Bermuda Triangle with all your Monkey friends! Swing on vines, throw doo at your enemies, and climb everything!"}]}, "developer_name": "Continuum VR Studios", "developer_privacy_policy_url": "https://www.clique.games/privacy", "developer_terms_of_service_url": "https://www.clique.games/terms", "publisher_name": "Continuum VR Studios", "support_website_url": null, "website_url": "https://www.monkeydoovr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "528142316460358"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26768569296157794"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499619078_2397452980718264_2496501965899922675_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtKsz5DmdI0Q7kNvwGjCvNp&_nc_oc=AdofGvfIjtMzunaKgHKWvHKWhm3AOcEfT1v7bFX0LXISdYniLXDqcdWVk6ZFJBut99Q&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ng0R0B7LHtRJImsi2GHtExba9T5PRAOjFVS4tCy3tdA&oe=6A0F2
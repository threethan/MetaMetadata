RXztjXQi4S9ONpd_CajQ0J0QH_deA&oe=6A8EC208"}, {"file_name": "ocss2.png", "id": "1612853025749161", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974456_1612853029082494_1018358577806091438_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vjv7W5jPnC0Q7kNvwFzKbn8&_nc_oc=AdrX0SSS4_0YsDPMYxZnqAg7lt-mzyB6o3BnwUMEcZSm6FZa_PEd6Gz7nsDs29OHMTc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJJc1rjzlVgzZSkGp-woBha0yK4vLlZKv1kV_uNUnu6Q&oe=6A8ECC69"}, {"file_name": "ocss5.png", "id": "1103043040549068", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974771_1103043043882401_4568398946290794293_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpmsOP9ZFs0Q7kNvwHzkvT6&_nc_oc=Adrf_9DbUTRkS-DUy0oJi1VUd_RxyvsmyOYjubkqcyp7S3NzpddjTaklbFqTwxuUsnk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAX7zVfY-Kb6eGCRahw_S5FiBggi1y7jXH7D8JNQ5CWA&oe=6A8EDBE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "1125555513083250", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499307326_1125555516416583_4126974844898021753_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-gUILeOmlkQ7kNvwHW3059&_nc_oc=AdpdveJULoGkzDeG3G3xTy5GtFL8ZWGYpiNnYdUo5apOLYwKLJBvgxkao0YaXilUHdA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsb282dIn_81UzGMnrcB0TIsw7HZr8ZiKPlwcKnpOVIg&oe=6A8EF224"}, "display_name": "VR Dodgeball Trainer", "keywords": ["sports", "dodgeball", "simulation", "arcade", "fitness"], "long_description": "#                                                                                                                                                                                                      \n{1367751464866066}\n# Train With the Pros\nVR Dodgeball Trainer was built from the ground up by professional dodgeball players to give you the dodging prowess to survive out on the court.\n\n**Customize Your Training**\n- Change the # of opponents\n- Control throw speed\n- Increase # of opponents throwing at once\n- Bring opponents to court front or back\n- Enable 360 mode\n\n{1495116238199893}\n# Watch Out!\nWatch out as these red menaces soar over your dome, leaving you constantly on your toes. Can you take on waves of enemies as the pressure rises?\n\n{1534958797931631}\n# Slash?\nYeah this gym has swords, guns, and much more! Hop into arcade mode and play around with our stupidly fun mini-game modes! Take on a range of unexpected challenges while the waves get harder and harder.\n\n**Arcade Gamemodes**\n- Saber Mode\n- Bullet Time Mode\n- Shield Mode\n- Gun Mode\n- Curveball Mode\n- Big Balls Mode", "short_description": "VR Dodgeball Trainer was designed from the ground up by professional dodgeball players to give you the dodging prowess to survive out on the court. Watch out as these red menaces soar over your dome, leaving you constantly on your toes. Can you take on waves of enemies as the pressure rises?"}]}, "developer_name": "Grounded", "developer_privacy_policy_url": "https://groundedservers.ddns.net/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Grounded", "support_website_url": null, "website_url": "https://groundedservers.ddns.net/vr-dodgeball-trainer/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "ACTION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes":
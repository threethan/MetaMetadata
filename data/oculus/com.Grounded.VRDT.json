file_name": "ocss2.png", "id": "1612853025749161", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974456_1612853029082494_1018358577806091438_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EYkppfldjsQ7kNvwHpM39l&_nc_oc=AdleQyp7M6cKjgc3KUnwIY8bzVVKr3iKNmCHO97cJkFEcomTMm6MLISzKEJM-zp1mJI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfygqdxjlXzqWT9-QgbdeaZzeFV6JE04z6r_ho2GZjwGug&oe=69B93969"}, {"file_name": "ocss5.png", "id": "1103043040549068", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974771_1103043043882401_4568398946290794293_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52lpo_j3G-oQ7kNvwEg_oTY&_nc_oc=AdkqgYE_X6E2wvFJVqudm3E5qETg_or6wxRdkI2tgZergC3qsE9VeY16MFalzJAuS_s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxYRgOkopllJkTRBH-oQ3Nb5TPHYVqLP2lL0sLaedRjAw&oe=69B948E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "1125555513083250", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307326_1125555516416583_4126974844898021753_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ulhnGeK0lkQ7kNvwEdtac2&_nc_oc=AdkP7KN7oSDtCrcQ8IQ3MmsASzZ7v1QfH02jSGE-t3wMGjsCuO0oG8pM2_evqlHBfO0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxdXq1eEOUwFMIDeB8sbs7kHE7A3UynnKSA2BpjhrcfxA&oe=69B95F24"}, "display_name": "VR Dodgeball Trainer", "keywords": ["sports", "dodgeball", "simulation", "arcade", "fitness"], "long_description": "#                                                                                                                                                                                                      \n{1367751464866066}\n# Train With the Pros\nVR Dodgeball Trainer was built from the ground up by professional dodgeball players to give you the dodging prowess to survive out on the court.\n\n**Customize Your Training**\n- Change the # of opponents\n- Control throw speed\n- Increase # of opponents throwing at once\n- Bring opponents to court front or back\n- Enable 360 mode\n\n{1495116238199893}\n# Watch Out!\nWatch out as these red menaces soar over your dome, leaving you constantly on your toes. Can you take on waves of enemies as the pressure rises?\n\n{1534958797931631}\n# Slash?\nYeah this gym has swords, guns, and much more! Hop into arcade mode and play around with our stupidly fun mini-game modes! Take on a range of unexpected challenges while the waves get harder and harder.\n\n**Arcade Gamemodes**\n- Saber Mode\n- Bullet Time Mode\n- Shield Mode\n- Gun Mode\n- Curveball Mode\n- Big Balls Mode", "short_description": "VR Dodgeball Trainer was designed from the ground up by professional dodgeball players to give you the dodging prowess to survive out on the court. Watch out as these red menaces soar over your dome, leaving you constantly on your toes. Can you take on waves of enemies as the pressure rises?"}]}, "developer_name": "Grounded", "developer_privacy_policy_url": "https://www.groundedfilms.ca/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Grounded", "support_website_url": null, "website_url": "https://www.groundedfilms.ca/vrdevelopment", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "ACTION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26650743154533860"}, "review_messages": []}]}, "cover_squ
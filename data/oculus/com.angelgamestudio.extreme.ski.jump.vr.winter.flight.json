dn.com/v/t64.5771-25/491818890_670901755862310_5065739328920581909_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkO6gPhV7ssQ7kNvwGrTWKL&_nc_oc=AdqBEkxFNc4c2CxUI0MR-KS-0X5c5B6bVxCkS_jLqS2xxvOjwnyD9gmyBBDi-yLgS6c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMue4mkikZU_ArDi0FhiKpqSNgGlfPJGAEEH1s00mcLiQ&oe=6ACB9306"}, {"file_name": "Screenshot_5.png", "id": "1132475319059990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819511_1132475322393323_5934147919301715573_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcA6fqjfizMQ7kNvwFssIXI&_nc_oc=Adom97GGHwtj7Hp2l0phQ89cJScIhia0DHx1XM6ls_YdReJ-Tva_oqi4DsqslPVquZ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQOSfh-mItRfjbw5n-ZcedHOBdvlvmtuWjU0VYpgq1BQ&oe=6ACBA5BE"}, {"file_name": "Screenshot_2.png", "id": "1171321095186593", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823930_1171321101853259_6363069800570579588_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8QzB4dh57gQ7kNvwHfopUv&_nc_oc=Ado4Auaxpc5HdYTdpUBLhVmdgKzc5QCKBOcg2sTafYaidS3M6MILJZSODKdX2-8YbLU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRbtn9IJbRRZA4ACmpvCLNfC4Gs7T3JnMwX2I2dX-qEw&oe=6ACBB8F5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Extreme Ski Jump VR : Winter Flight", "keywords": ["SkiJumpVR", "VRSkiJump", "WinterSports", "SnowGame", "ExtremeSports"], "long_description": "Take flight and conquer the mountains in Extreme Ski Jump VR: Winter Flight \u2014 the ultimate virtual reality ski jumping experience.\nFeel the adrenaline rush as you launch from towering ramps, slice through the icy air, and fight for a perfect landing on stunning snow-covered peaks. Every jump tests your timing, balance, and courage as you chase record-breaking distances and picture-perfect style points.\nBuilt for realistic physics and full VR immersion, this game captures the true thrill of ski jumping like never before. Experience breathtaking alpine views, dynamic weather, and responsive motion controls that make every run unique. Fine-tune your technique, master your takeoff and landing, and rise through the global leaderboards to prove you\u2019re the ultimate winter flight champion.\nWhether you\u2019re a winter sports enthusiast or a thrill-seeking newcomer, Extreme Ski Jump VR: Winter Flight delivers a heart-pounding mix of realism, fun, and freedom. Strap in, take a deep breath, and get ready to soar beyond limits \u2014 the mountains are waiting for your best jump.", "short_description": "Take flight from icy ramps and master the ultimate VR ski jump challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/angelgamestudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25033537369674395"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1230445048945542"}, {"status": "PUBLISHED", "id": "1382351953301024"}, {"status": "PUBLISHED", "id": "2109517316248411"}]}, "baseline_offer": {"id": "2109517316248411"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 177100
f&oh=00_AQSm_j9ceHLgqV3oISJS47Xhv_DYs37UikOfrQ0q0SCj8Q&oe=6AE89AA8"}, {"file_name": "Screenshot5.png", "id": "1025141950364718", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499298900_1025141953698051_363276515884126893_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vw7pJArKnnwQ7kNvwG09N0d&_nc_oc=AdrIHEkHTWmg8epL8GidHaYdscqZUFDG0_uEylRhYcWj0ewgTu4JFYJ2_kgcteL4hYk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQg-cAHHwDHJXUReaVhm-dB7emq5lfSnUVXFLXL1-4KyA&oe=6AE8921B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerArt.png", "id": "2502707830228067", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/604298355_2502707833561400_7245139048836842592_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MJUbpvv-x4Q7kNvwFB81jg&_nc_oc=Adqse72a01O8oCcntNiyF5uGDs72Fho_LBVw0vZXaFji3aCkDwhqj-flZGWJnRYQeqo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWTHhPly9TG0BWwNv4rCVuDWbe926mUEQ3J_fv3Pkl4g&oe=6AE8B271"}, "display_name": "AR Dogfight: SPADs & Fokkers", "keywords": ["ww1", "plane", "airplane", "dogfight", "biplane"], "long_description": "Strap in \u2014 it's 1918, and the golden age of aerial combat has invaded your living room!\n\n**AR Dogfight: SPADs & Fokkers** turns your real space into a miniature Western Front. Authentic WWI fighters at miniature scales bank and weave around your furniture in full mixed reality, ducking behind the sofa and screaming past the bookshelf.\n\nThese aren't arcade gliders. A genuine aerodynamics model \u2014 lift, drag, stalls, and energy management \u2014 is tuned for small-scale play, so a SPAD S.XIII and a Fokker D.VII handle like the real machines shrunk to your tabletop. Open the throttle and take off straight from the carpet, then grease a landing back onto your coffee table.\n\nBetween sorties, walk around your full-scale plane parked right in your room.\n\nIn the air, optionally point your laser designator to assist running down enemies with hairpin turns and thrilling dives. This is no hit-point sponge \u2014 control surfaces snap off, wings break, and damaged engines trail fire before spiraling into the floor.  Plane scales are adjustable from 1/1 to 1/192, making even outdoor play exciting!\n\nBattle a 50-mission Campaign against escalating waves or jump into quick Dogfight skirmishes. Earn victories, climb the ranks, unlock medals and liveries, and share your score on the global leaderboards.\n\nThe skies are waiting. Chocks away!", "short_description": "Your living room becomes the Western Front, 1918! Command authentic WWI fighters at miniature scale, dogfighting in mixed-reality through your living room!  A genuine aerodynamics model \u2014 stalls, energy, the works \u2014 is tuned for indoor play, so every SPAD and Fokker really flies. Take off from the carpet, hunt enemy aces through hairpin turns, and set canvas ablaze before touching down on your coffee table. Walk around your plane at full-scale, earn medals, and top the global leaderboard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vroom.space/dogfight/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "VROOM", "support_website_url": null, "website_url": "https://vroom.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
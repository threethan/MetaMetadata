u5411\u3053\u3046\u306b\u5e83\u304c\u308b\u306e\u306f\u3042\u306a\u305f\u3068\u672c\u3060\u3051\u306e\u7279\u5225\u306a\u4e16\u754c\u3002\n\n\u65b0\u6642\u4ee3\u306e\u8aad\u66f8\u4f53\u9a13\u3092\u3001\u3042\u306a\u305f\u306b\u2015\u2015\n\n\u25a0 Virtual Book Viewer \u3067\u306f\u3001\u4ee5\u4e0b\u306e\u3053\u3068\u304c\u53ef\u80fd\u3067\u3059 \u25a0\n\n\u30fb\u3042\u306a\u305f\u306e\u304a\u597d\u304d\u306a\u753b\u50cf\u30d5\u30a1\u30a4\u30eb\uff08\u307e\u305f\u306f\u30a2\u30fc\u30ab\u30a4\u30d6\uff09\u3092\u3001VR\u7a7a\u9593\u5185\u306b\u8868\u793a\u3067\u304d\u307e\u3059\u3002\n\u30fb\u672c\u306e\u4f4d\u7f6e\u3001\u89d2\u5ea6\u3001\u5927\u304d\u3055\u3092\u597d\u304d\u306a\u3088\u3046\u306b\u8abf\u6574\u3067\u304d\u307e\u3059\u3002\n\u3000-> \u4f8b\u3048\u3070\u982d\u4e0a\u306b\u3001\u8996\u754c\u3044\u3063\u3071\u3044\u306b\u62e1\u5927\u3059\u308b\u3053\u3068\u3082\u3067\u304d\u307e\u3059\u3002\n\u30fb\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u3092\u4f7f\u308f\u305a\u306b\u3001\u9854\u306e\u5411\u304d\u3060\u3051\u3067\u30da\u30fc\u30b8\u3092\u3081\u304f\u308c\u307e\u3059\u3002\n\u30fb\u5b9f\u969b\u306e\u672c\u306e\u3088\u3046\u306b\u3001\u307a\u3089\u308a\u3068\u30da\u30fc\u30b8\u304c\u3081\u304f\u308c\u308b\u30a2\u30cb\u30e1\u30fc\u30b7\u30e7\u30f3\u304c\u3001\u3088\u308a\u6ca1\u5165\u611f\u3092\u9ad8\u3081\u307e\u3059\u3002\n\u30fb\u591c\u306e\u68ee\u3001\u9759\u304b\u306a\u56f3\u66f8\u9928\u3001\u771f\u590f\u306e\u30d3\u30fc\u30c1\u306a\u3069\u3001\u597d\u304d\u306a\u30b7\u30c1\u30e5\u30a8\u30fc\u30b7\u30e7\u30f3\u3067\u8aad\u66f8\u304c\u697d\u3057\u3081\u307e\u3059\u3002\n\n\u25a0 Virtual Book Viewer \u4ed5\u69d8\u8a73\u7d30 \u25a0\n\u30fb\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u76f4\u5f8c\u306f\u300c\u8a66\u7528\u7248\u300d\u3068\u306a\u3063\u3066\u3044\u307e\u3059\u304c\u3001\u3059\u3079\u3066\u306e\u6a5f\u80fd\u3092\u7121\u6599\u3067\u304a\u8a66\u3057\u3044\u305f\u3060\u3051\u307e\u3059\u3002\n\u3000-> \u30a2\u30d7\u30ea\u5185\u3067\u81ea\u52d5\u7684\u306b\u300
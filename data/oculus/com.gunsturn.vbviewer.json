ok. You can read any books as you like in VR space. Hands free. You can use the data you already have."}]}, "developer_name": "\u77e2\u90e8\u826f\u8f14", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "gunsturn app Lab.", "support_website_url": null, "website_url": "http://www.gunsturn.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "RELAXATION_MEDITATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "330669685473015"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12410331_449657428841862_938708524660162560_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQKiDLXW3QAQ7kNvwGywce0&_nc_oc=AdqUUPJ_qJdXOxKpSCS4qMzPzxFNaRKdn4ONOQ_Aror8wENw1_KrM0hGJd1C9IlH5Go&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJODzzx0aXJ15EU0nfLiyyy-N_YANqRcnKyt1ziapc32Q&oe=6AA3F0EC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VirtualBookViewer", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1534970757, "lastRevision": {"nodes": [{"id": "2087650751309302", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2341468065880359", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "242342996367351"}, "iarc_email": n
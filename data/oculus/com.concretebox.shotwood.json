ontent-iad6-1.oculuscdn.com/v/t64.5771-25/75593951_4144036918950659_8192308952281982814_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTPERFwHQqAQ7kNvwGItbMi&_nc_oc=AdoJ449QcYrL0oFqI3Vc5jbfTH_So5703x30FTmCgNX20fs6Wx6bGFMjwDVe5ok38-E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxACGRkIBup4rX4LI0Wh2FXaSbGaqy1YRwt0-31vBzfQ&oe=6B06F7BB"}, {"file_name": "screenshot-1.png", "id": "2914580902135212", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375752_2914580905468545_80433455254843461_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLBPnziyd90Q7kNvwFYt9Ox&_nc_oc=Ados2EGljqP_AxKiah6ZtcwEX2OX5j4Oq-S-SUQ5sfLgY-x20mnPfqy6t0JdhiejdgA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnP4RlmQ9w9DAUzrMN35Etb5w7UFb_mbBMoSuRWbztfw&oe=6B0709CA"}, {"file_name": "screenshot-4_v2.png", "id": "927824121486073", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974469_927824124819406_2964890372995800077_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55UDSXMjsX4Q7kNvwG_Xavy&_nc_oc=AdrOCuIYhwnkok1RRr2c-LSJzcXc80uqu9_apsjCngti15g6qZH2q4vZsg1I039GVCM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRX-wdDHtUnsHHy99fDZuUKbjWIx78g7CAZWqDpRkgQZw&oe=6B07285B"}, {"file_name": "screenshot-5.png", "id": "443029733325686", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210398_443029736659019_6449814880897090248_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdpjllCwlikQ7kNvwEGucvh&_nc_oc=AdqG94aIXN1VP6nc_qgEtcm3s0TZmAHnYknoHif7v1N46ENBFMxE619B6Z2ugTRECis&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSptH6NcUjn5FLd9i-OJxr02We6vpM4-iKvDlkos6DEcw&oe=6B07144B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1641373653324486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375081_1641373656657819_7984888512499574922_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2Gh_dBfTKUQ7kNvwF97lGE&_nc_oc=AdoEUFzTIGTiIW2zYkqyOIWrnHoVhJVxDxZL5Ye3WmUs8azbrpYt8VdKRjZkxqLRnhA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSq-Fwzy2HOPYyUqozFt_PnNXNeXIHYXtMl-8gNtliJGg&oe=6B071616"}, "display_name": "Shotwood", "keywords": ["Shot", "Shoot", "Shooting", "Wood", "ShootWood"], "long_description": "**Smash deadly wooden targets** with realistic firearms & explosives while you try to escape from this ominous, ridiculous, mysterious facility. Shotwood is the casual (yet satisfyingly tactical) **shoot-house themed game!**\n\n{1905707109834711}\n\n# Story & Progression\n\nPass the facility induction then complete shoot-house assessments, **gradually unlocking content and earning credits** to buy guns, ammo, and more. Listen to the ominous announcements, eat your food paste, uncover the mystery of the grievance booth, and **learn the terrible truth of the facility!**\n\n{3860058090936325}\n\n# Gunplay & Tactical Tools\n\nOver 20 firearms to use, with attachments and full reload mechanics. Plus **kamikaze drones, augmented visor, pistol camera, various grenades, and much more**. The targets shoot back, use the environment for cover - full room-scale movement is supported, as well as seated play. Multiple difficulty modes available, including permadeath!\n\n{527290279756471}\n\n# Content & Tech Features\n\n**Master 8 full levels, with 3 modes, challenges, and randomisation.** Plus a gun range, 2 physical minigames, arcade cabinet, and large secret area \"beyond the booth\". Cash wads are hidden throughout. Multiple options for movement, audio, captions, haptics, left handed play, framerate (up to **120hz** on supported headsets), 4 save slots, new game plus, and more!\n\n{3686487571566764}\n\nWhether you're looking for a **tactical room clearing** sim, or if you just want to **fly some explosive drones**, Shotwood has you covered. Jump in right now and... SHOOT SOME WOOD!", "short_description": "Smash deadly wooden targets with realistic firearms & explosives while you try to escape from this ominous, ridiculous, mysterious facility. Shotwood is the casual (yet satisfyingly tactical) shoot-house themed game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.concretebox.net/privacy.html", "developer_terms_of_service_url": "https://www.concretebox.net/terms.html", "publisher_name": "Concrete Box", "support_website_url": "https://www.concretebox.net/support.html", "website_url": "https://www.concretebox.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "CASUAL", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8909361605745729"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_1134808751080973_3174481721789671110_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMxyGAWDpFkQ7kNvwFzLwp7&_nc_oc=AdrR3X5Y0mceL9kcoCJpYnGOZB-zty0lMOl-SwlVDDm6nPyRGGd1b7TgCbKVACWiMYM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsYf4rCr8okA76eAxfHhtNy_2zCAmnoAcOT7dBpKouwQ&oe=6B07098B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Shotwood", "platform": "ANDROID_6DOF", "context_category": {"context_cat
ontent-iad6-1.oculuscdn.com/v/t64.5771-25/75593951_4144036918950659_8192308952281982814_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0UVvdlnjRYQ7kNvwF1mmWn&_nc_oc=AdoFNjnQg8j11frhYB_jxcvpIZyRBi8BjCDGh4LRcH40APEbbRxUFTq5SggxUrlVrC0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU7KBOZ0TVsWO9PYt0kWjE_b8XDtUxU79hOoQrqqCYabg&oe=6B0F18FB"}, {"file_name": "screenshot-1.png", "id": "2914580902135212", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375752_2914580905468545_80433455254843461_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPbTUfxkK0cQ7kNvwHwoQEo&_nc_oc=AdorU9GtWmwMSiS6KqUR3cUo6VWGZLC-uUL34HbXqWHcyaqkYq6z0rtmRwVXTZSzHNw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXqg6vBFlRQw96Lcp_LiRm34mefgndIVGtRnweMIbWysg&oe=6B0EF2CA"}, {"file_name": "screenshot-4_v2.png", "id": "927824121486073", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974469_927824124819406_2964890372995800077_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mqk2Z1UPPj0Q7kNvwE5BdDd&_nc_oc=AdpfFMqtxlrQJmyWF3JHJAWhYjXCGcDlYIStEQtSf0DUrKVJ5AuYQ3Owuwt5_8jWI1w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUc9P57x8rNCJa0weFsmNR1YTO1v5TEDsWSOXSzy0ueLg&oe=6B0F115B"}, {"file_name": "screenshot-5.png", "id": "443029733325686", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210398_443029736659019_6449814880897090248_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYgSEYsHxhUQ7kNvwFx7JIf&_nc_oc=AdoH17Rp1Xmq1YyCAtcg86OTE-_HiVSwh-8LNv9I3_ZBPSAqwwv36fZYR2EG4O-Ii5o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWZLjLE_E6OvIFfOnCUta5PmNFeFzaMkBMEYf3zO3cLHw&oe=6B0EFD4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1641373653324486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375081_1641373656657819_7984888512499574922_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8b47iPb925UQ7kNvwGclzFQ&_nc_oc=Ado-AYHYRxD-IKj4cW-o7rdUNHeWe5lSgha3zhRtNglF2iACfSr1jxJlga-en3vD-RQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWwrcH3GrF9vIm6UJ8lscDbfqGnA70-ymvJNcD_9tMYuA&oe=6B0EFF16"}, "display_name": "Shotwood", "keywords": ["Shot", "Shoot", "Shooting", "Wood", "ShootWood"], "long_description": "**Smash deadly wooden targets** with realistic firearms & explosives while you try to escape from this ominous, ridiculous, mysterious facility. Shotwood is the casual (yet satisfyingly tactical) **shoot-house themed game!**\n\n{1905707109834711}\n\n# Story & Progression\n\nPass the facility induction then complete shoot-house assessments, **gradually unlocking content and earning credits** to buy guns, ammo, and more. Listen to the ominous announcements, eat your food paste, uncover the mystery of the grievance booth, and **learn the terrible truth of the facility!**\n\n{3860058090936325}\n\n# Gunplay & Tactical Tools\n\nOver 20 firearms to use, with attachments and full reload mechanics. Plus **kamikaze drones, augmented visor, pistol camera, various grenades, and much more**. The targets shoot back, use the environment for cover - full room-scale movement is supported, as well as seated play. Multiple difficulty modes available, including permadeath!\n\n{527290279756471}\n\n# Content & Tech Features\n\n**Master 8 full levels, with 3 modes, challenges, and randomisation.** Plus a gun range, 2 physical minigames, arcade cabinet, and large secret area \"beyond the booth\". Cash wads are hidden throughout. Multiple options for movement, audio, captions, haptics, left handed play, framerate (up to **120hz** on supported headsets), 4 save slots, new game plus, and more!\n\n{3686487571566764}\n\nWhether you're looking for a **tactical room clearing** sim, or if you just want to **fly some explosive drones**, Shotwood has you covered. Jump in right now and... SHOOT SOME WOOD!", "short_description": "Smash deadly wooden targets with realistic firearms & explosives while you try to escape from this ominous, ridiculous, mysterious facility. Shotwood is the casual (yet satisfyingly tactical) shoot-house themed game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.concretebox.net/privacy.html", "developer_terms_of_service_url": "https://www.concretebox.net/terms.html", "publisher_name": "Concrete Box", "support_website_url": "https://www.concretebox.net/support.html", "website_url": "https://www.concretebox.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "CASUAL", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8909361605745729"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_1134808751080973_3174481721789671110_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOoDBXtsP-4Q7kNvwFMvao6&_nc_oc=AdrNuw7h9OLn0X2hcA6YD7OHvlaSuRAEqcU4q8AW6DLD9Q96HHqY57ZA1WdEEAsKajg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV7bZJooVBxypBbrdVPBKEe4yO4rXy9ti3kJNJWBXBnYw&oe=6B0EF28B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Shotwood", "platform": "ANDROID_6DOF", "context_category": {"context_cat
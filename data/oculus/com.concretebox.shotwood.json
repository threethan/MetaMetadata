JwT2N6APwUW9Br2TO4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHYNk2nHHNOZafSB4v2fNdWYWasou1Ms-GMgTPFj8vwg&oe=6AFC902D"}, {"file_name": "screenshot-5.png", "id": "443029733325686", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210398_443029736659019_6449814880897090248_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qy5dVRX374MQ7kNvwFOv0vq&_nc_oc=AdrOaJuGfcSy0McUxspiNpyCp5o3TiCNMoFNEKe0nFMIFACoxBqiV6crzpFD7--L-YY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrZ9xwCVJoVLx45lsdKaeU5a46y31eH6Jm2g2P2D09ZQ&oe=6AFC884B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus-Thumbnail.png", "id": "3009970792661767", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036632_3009970795995100_8495805163915112358_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R355BBtSVgAQ7kNvwHJerPh&_nc_oc=AdoochrjWPV4spHMtr4bGkulsftbDpebVQqxr1tR4mjS2D-Hp_p0DZrel8oCPDOQckE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGhgOonTisZWF5R-MR4t8BEAeDyyPQcGB9cfa_SqdgNQ&oe=6AFC6932"}, "display_name": "Shotwood", "keywords": [], "long_description": "Shotwood is a single player shooting game, with realistic guns and full reload mechanics. Duck and dodge between cover in full roomscale VR!\n\nWelcome to the facility. Here you'll complete combat assessments - killhouse scenarios - clearing floors of deadly wooden targets.\n\nBeat challenges to earn credits. Spend them on different firearms, attachments, and ammo. You'll need to buy LOTS of bullets!\n\nUse the gun range to toy with each weapon simulation, or dive into a shoothouse floor and blast away. Tactical shooter or action hero, it's up to you.\n\nNasty case of shell-shock coming on? Take a break and enjoy the minigames! Balloon Stabber and Brick Shield. Or gamble away your earnings playing cards, with the Simple Jack arcade game.\n\nAce every challenge in an intense action-packed weekend, or duck in for 10 minutes to smash an assessment, and bail back out with time left for lunch.\n\nShotwood VR is the casual, offline, FPS game that you can play your own way.", "short_description": "Welcome volunteer! Prepare for your new life at 'the facility'. A life of assessments, challenges, and of course; shooting wood!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.concretebox.net/privacy.html", "developer_terms_of_service_url": "https://www.concretebox.net/terms.html", "publisher_name": "Concrete Box", "support_website_url": null, "website_url": "https://www.concretebox.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "CASUAL", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1256803971477952"}}]}, "scheduled_offers": {"count": 18, "nodes": [{"status": "PUBLISHED", "id": "2212870502602720"}, {"status": "PUBLISHED", "id": "2174319593493317"}, {"status": "PUBLISHED", "id": "2108312683396406"}, {"status": "PUBLISHED", "id": "1041530218438437"}, {"status": "PUBLISHED", "id": "2393465624492975"}, {"status": "PUBLISHED", "id": "2106566863468688"}, {"status": "PUBLISHED", "id": "1576543230309339"}, {"status": "PUBLISHED", "id": "1993666561492439"}, {"status": "PUBLISHED", "id": "1365451717854284"}, {"status": "PUBLISHED", "id": "1147334763672252"}, {"status": "PUBLISHED", "id": "780374061152149"},
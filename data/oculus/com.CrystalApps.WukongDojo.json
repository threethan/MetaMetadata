k2aIC27qm-3mmL_MaF0V2B-ntnNmfY1cAmiIePmV66js3mHLU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbG4NUzyc9PpJClVZNLVg0_TzxqRFDN1DRdh-4Q1T6BA&oe=6AB66BCD"}, {"file_name": "image_017_5175.png", "id": "881268370052612", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75314851_881268373385945_6070400854680337175_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H55weGlRGIMQ7kNvwGdx4eB&_nc_oc=AdroMBA3OtXPP3zVNpHL3YCl92DQzYhyDytKB2jm0aLn20SWMXs5Jx0k-37tkrOM_dk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJa1LXX-W1IHAeSjzIu-6iMUNTuD7-AnWL1knVcWhWkhg&oe=6AB68731"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wukong 16 9.png", "id": "898558298318246", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974482_898558301651579_7851134238691417132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9yKDPRjBcEQ7kNvwGArlvj&_nc_oc=AdrbjonTzW-TUs_5kribQER5r1dRXMQs1wDP9FO0TfWnbvRIYURRnyLo174ayPqgPHw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5WkqWZQ9NUilB4C7rSHtJmMCmJUW1Y5Wx-Kl1SdK5VA&oe=6AB68469"}, "display_name": "The Monkey King: Flying Dojo", "keywords": [], "long_description": "Immerse yourself in the mythological world of \"The Monkey King\". As Sun Wukong, you are called upon to conquer the mystical Dragon Valleys. With your enchanted staff in hand, you'll smash through orbs of power and face off against dragon guardians in this arcade VR adventure.\n\nThe heart of the game lies in mastering your weapon, the Monkey King's magical staff, through intuitive VR controls that make every action feel lifelike. The difficulty escalates as you venture deeper into the valleys, demanding greater skill and agility to overcome the obstacles and enemies that await.\n\nPrepare to unleash the power of the Monkey King and reclaim the Dragon Valleys!", "short_description": "Early Access\nEmbark on an epic journey in \"The Monkey King: Dragon Dojo,\" where ancient China comes alive! Arm 
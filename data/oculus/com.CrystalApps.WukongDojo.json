0kbiaOb53CF8YtrQoKMpQiJz8-We3Y_tjmzaOMDYv8Hk8f-rX_xL33pdmVti_RKk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzMcZuhSZtdbfq53hrHIRe0a0Jscc7UkQZkKnV-sVvDhA&oe=69B7DEA3"}, {"file_name": "image_015_3225.png", "id": "2692914217674527", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371506_2692914221007860_9091460182182850157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mXAI6DyWCAQ7kNvwGWBU0F&_nc_oc=AdlsZudpPumbCdVbnMBwVWxx4ArqynaH7Jg1jp1ar-2u9xZbiZwBW-DZEqaLk9Qlkpg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzam_EL9PjKWIRKUlJsg5NxYGlOF7W8CW6OAtA1UtGKAA&oe=69B7FA4D"}, {"file_name": "image_017_5175.png", "id": "881268370052612", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75314851_881268373385945_6070400854680337175_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzAgayQ1wN4Q7kNvwE65fy0&_nc_oc=AdkilzhVymok2o395U4_OCEmFVDffBO1jPpcEteG1XSv354Ta2OBj9_rR_lgT24jEmA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzUE1-9XWEK-oWi2ALFT8Hzrhh9qz3sR-XrmrtLUq45uQ&oe=69B815B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wukong 16 9.png", "id": "898558298318246", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974482_898558301651579_7851134238691417132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zya7CrhZNWgQ7kNvwGabh68&_nc_oc=AdkHGORSRtX8hK-1pgSgp12LmKvreJa4tP48W_Mg_hinLpzV5uAnrku5yPZ9wqOw9M8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwznBSO3ZiT-TExuNMyb_p2Akuxu313-EMo6u1yFwc25g&oe=69B812E9"}, "display_name": "The Monkey King: Flying Dojo", "keywords": [], "long_description": "Immerse yourself in the mythological world of \"The Monkey King\". As Sun Wukong, you are called upon to conquer the mystical Dragon Valleys. With your enchanted staff in hand, you'll smash through orbs of power and face off against dragon guardians in this arcade VR adventure.\n\nThe heart of the game lies in mastering your weapon, the Monkey King's magical staff, through intuitive VR controls that make every action feel lifelike. The difficulty escalates as you venture deeper into the valleys, demanding greater skill and agility to overcome the obstacles and enemies that await.\n\nPrepare to unleash the power of the Monkey King and reclaim the Dragon Valleys!", "short_description": "Early Access\nEmbark on an epic journey in \"The Monkey King: Dragon Dojo,\" where ancient China comes alive! Arm yourself with the legendary Ruyi Jingu Bang and smash through mystic orbs to conquer the Dragon Valleys. Are you ready to walk in the footsteps of the Monkey King?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://crystalapps.eu/theMonkeyKing-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crystal Apps", "support_website_url": null, "website_url": "https://crystalapps.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4196727970430043"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "807259285633348"}, {"status": "PUBLISHED", "id": "2641009356266357"}, {"status": "PUBLISHED", "id": "838528718602814"}, {"status": "PUBLISHED", "id": "1133161565443722"}, {"status": "PUBLISHED", "id": "1383190019495457"}, {"status": "PUBLISHED", "id": "1164387351886981"}, {"status": "PUBLISHED", "id": "1139153017553562"}, {"status": "PUBLISHED", "id": "3821748478153022"}, {"status": "PUBLI
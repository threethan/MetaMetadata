r8J9aEvMEul1OMwVT8NFpQ71FuolGQYvfx93alOmuNJmNTJYA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcNN1ylUGnHakafPjwK_-NaEY7H1vtG-gBOMVpDD9EUA&oe=6A7B184D"}, {"file_name": "image_017_5175.png", "id": "881268370052612", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75314851_881268373385945_6070400854680337175_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuStbHoKgIwQ7kNvwG_ojUh&_nc_oc=AdpttidbD5bsYpoAh2T7x0fa1qc6nlv4UDDXoe2M1Q0j1s4gEJc98zVXueYzeg6uaiw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEop5qN3oBfaYmnrEVhcdjkmA2ueB7rkm5k-k5-_0yCuw&oe=6A7B33B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wukong 16 9.png", "id": "898558298318246", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974482_898558301651579_7851134238691417132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuFrSMnba4cQ7kNvwHL2hhc&_nc_oc=AdpdRp9XXW1hnVWBHc3E4jC1zGTKOey_YkqSvfqMapPYprjBJXIhFGyAoMYgiIvlo2Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtudn1HQWMnynmUJ7fFtmXQF9E_GSQBCFAjghyPrMyRg&oe=6A7B30E9"}, "display_name": "The Monkey King: Flying Dojo", "keywords": [], "long_description": "Immerse yourself in the mythological world of \"The Monkey King\". As Sun Wukong, you are called upon to conquer the mystical Dragon Valleys. With your enchanted staff in hand, you'll smash through orbs of power and face off against dragon guardians in this arcade VR adventure.\n\nThe heart of the game lies in mastering your weapon, the Monkey King's magical staff, through intuitive VR controls that make every action feel lifelike. The difficulty escalates as you venture deeper into the valleys, demanding greater skill and agility to overcome the obstacles and enemies that await.\n\nPrepare to unleash the power of the Monkey King and reclaim the Dragon Valleys!", "short_description": "Early Access\nEmbark on an epic journey in \"The Monkey King: Dragon Dojo,\" where ancient China comes alive! Arm yourself with the legendary Ruyi Jingu Bang and smash through mystic orbs to conquer the Dragon Valleys. Are you ready to walk in the footsteps of the Monkey King?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://crystalapps.eu/theMonkeyKing-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crystal Apps", "support_website_url": null, "website_url": "https://crystalapps.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4196727970430043"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "807259285633348"}, {"status": "PUBLISHED", "id": "2641009356266357"}, {"status": "PUBLISHED", "id": "838528718602814"}, {"status": "PUBLISHED", "id": "1133161565443722"}, {"status": "PUBLISHED", "id": "1383190019495457"}, {"status": "PUBLISHED", "id": "1164387351886981"}, {"status": "PUBLISHED", "id": "1139153017553562"}, {"status": "PUBLISHED", "id": "3821748478153022"}, {"status": "PUBLISHED", "id": "1580259882762147"}, {"status": "PUBLISHED", "id": "903600734927445"}, {"status": "PUBLISHED", "id": "316745877770919"}]}, "baseline_offer": {"id": "838528718602814"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768845600, "status": "PUBLISHED", "id": "807259285633348"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "767971
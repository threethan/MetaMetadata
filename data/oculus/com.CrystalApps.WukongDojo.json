E1fHJM6m-aaQ9lEo94ycnUagMN3Dfk5fApJ4Rk8-SLRhX1XqU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVllDFfMnQcj9Z0GxfvyEBf_At8T4ptiqzZeOxm60-ug&oe=6A9EB0CD"}, {"file_name": "image_017_5175.png", "id": "881268370052612", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75314851_881268373385945_6070400854680337175_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yr30tr7rwGMQ7kNvwFQrds6&_nc_oc=Adra3i7R3ktGMRTPdIs7fy2H3DbvICST3rljYUC2-1bTWxSX-Wyq04AgHBENjgALeSo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcSFrLHqlMGWzNtKDlXlNs-DUQ-8Ltxf2z2HZr3o5QMQ&oe=6A9ECC31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wukong 16 9.png", "id": "898558298318246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974482_898558301651579_7851134238691417132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPL9iTg2y70Q7kNvwF9_rfq&_nc_oc=AdrlvJ135U1K2L0LminN5t2Z9SiVcxeDw9yCO0kUi5DDhotcl87QHis-VUPzCAltyeE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJliRJcEyQAq4Op2jKPW2pabVzoZDlrEpQg-HskzIMxbw&oe=6A9EC969"}, "display_name": "The Monkey King: Flying Dojo", "keywords": [], "long_description": "Immerse yourself in the mythological world of \"The Monkey King\". As Sun Wukong, you are called upon to conquer the mystical Dragon Valleys. With your enchanted staff in hand, you'll smash through orbs of power and face off against dragon guardians in this arcade VR adventure.\n\nThe heart of the game lies in mastering your weapon, the Monkey King's magical staff, through intuitive VR controls that make every action feel lifelike. The difficulty escalates as you venture deeper into the valleys, demanding greater skill and agility to overcome the obstacles and enemies that await.\n\nPrepare to unleash the power of the Monkey King and reclaim the Dragon Valleys!", "short_description": "Early Access\nEmbark on an epic journey in \"The Monkey King: Dragon Dojo,\" where ancient China comes alive! Arm 
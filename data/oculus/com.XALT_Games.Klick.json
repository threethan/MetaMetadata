tent-atl3-2.oculuscdn.com/v/t64.5771-25/473391986_1388755188964529_8707864296202774605_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQzT1cqrHNAQ7kNvwGTMNxr&_nc_oc=AdoP7xpq__a7pH2KeKwM1JI7EbGFWrHyjQ6K17vz5XKtyKXKLKTeB9vB_qWcVVF0V8Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS9quGaMVJml36btbawuxwWpT6WbCAoIW2dVn1xrOHt6Q&oe=6B0B2124"}, {"file_name": "5.png", "id": "1052562140116047", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393971_1052562143449380_4330406577120548270_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28szbi1CN9sQ7kNvwFsJlga&_nc_oc=AdpxLpshGFxhGe3GfUsfww6bboCDujTvc2mlWcJclqBjhbCZAL344cAyLbupkFf30qU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR4X_atLl9625mik67cLV8vcw79StRFPOaxlfqEt0b_iw&oe=6B0B10F6"}, {"file_name": "4.png", "id": "2408464942863131", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393432_2408464946196464_5117368587959372767_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0JxgNhrH6YQ7kNvwF_nhoH&_nc_oc=Ado09SbCs7AqHhw-VpkJgPN6s7xvqxhnbuiCU_Yn2tNc0O8hCOzNelOZ6PAmPeLcIvk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSmelaEqGOuiMVeyi9TSTZQZ_Wpb1p1jPnmzFQGmonB6Q&oe=6B0B1AF1"}, {"file_name": "1.png", "id": "631256663110807", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391937_631256666444140_5526436203422352506_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eW_dfjWxkoQ7kNvwEwo2f3&_nc_oc=AdpsQbQIFezqc6FjVg9r4jy9QS0_AStAJgrsTHqsXQ80Geibbk6uW5daGx0bL1cKrFE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQDxUodXIOTIagSKwhFDWENsJydUCoVVCFHH9Ehqi8_VQ&oe=6B0B1DD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape - 2560 x 1440px.png", "id": "674109361695253", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391937_674109365028586_8423212186245884846_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OG6qEnyaqI8Q7kNvwFsDVmy&_nc_oc=Adr2BYr830L02LjtpyhsbbvPa5tDFnCyvVz7C3K_cu5WWXs4OGbIaGUCXvzfaGmY4js&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTAAHQYvBBUTuJUXTBjl_la7FLxOzXSONwrzac-LXI93w&oe=6B0B4184"}, "display_name": "Klick", "keywords": ["Puzzle", "Casual", "Minimal", "Logic", "Sequence"], "long_description": "You think pressing a button is easy?\nKlick dares you to prove it \u2014 200+ handcrafted puzzles, each one designed to mess with your logic, toy with your memory, and test your limits.\nEvery level is a trap. A pattern hiding in plain sight. A sequence you almost get right \u2014 until you don\u2019t.\nShapes, numbers, lights, matches, rules \u2014 it all looks simple, until you\u2019re stuck staring at four buttons like a fool.\nMost don\u2019t finish.\nBut if you do? You\u2019ll earn something better than bragging rights: the quiet satisfaction of knowing you're built different.\nNow with Mixed Reality support, you can fail \u2014 or flex \u2014 in your own living room.\nOne sequence away from genius. Or madness.\nClean. Cruel. Klick.", "short_description": "Most players quit by level 17.\nKlick isn\u2019t \u201cfun.\u201d It\u2019s a test. A clean, brutal exam for your brain disguised as a VR puzzle game.\n200+ handcrafted challenges designed to break your rhythm,mislead your logic, and expose your blind spots.\nPress the wrong button, and it\u2019s over. Miss a pattern, and start again. Think you\u2019ve got a good memory? Prove it.\nPrecision. Focus. Obsession.\nMixed Reality support if you want to fail in your living room\nYou won\u2019t beat Klick. But you'll try.\nClean. Cruel. Klick."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/nitinkumar25195/PrivacyPolicy/blob/main/Klick_Privacy_Policy", "developer_terms_of_service_url": null, "publisher_name": "XALT Labs ", "support_website_url": null, "website_url": "https://www.xaltlabs.in/"
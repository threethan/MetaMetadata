JSfuIZAb3dlIQtpjJ7xtKJo_xk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ymwet4O5FtCGpl9O6FZ65O-RyqKEc9Za7lVwYDbWuWA&oe=69E63BE4"}, {"file_name": "5.png", "id": "1052562140116047", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393971_1052562143449380_4330406577120548270_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZueNLhjeIQQ7kNvwGNCoFU&_nc_oc=AdpjgXTRC_WPfXEiCivJz1K4Kt5l6U9QL_jDJGer-85knTlL7_OvJedcfR6n0IuoSoQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jO9NGeYOInC-DNNnUtKGYClO23_gKw0L9a2TtuigQog&oe=69E62BB6"}, {"file_name": "4.png", "id": "2408464942863131", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393432_2408464946196464_5117368587959372767_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPVIXZZ0W2IQ7kNvwGN7vTU&_nc_oc=AdqLbv-zez6X2Jt5wSyLE74ax7GVkbYvEqupbcKDA7I9t6YvKc1Hn2rHKtPnEkmno_k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rUp7R7vyiKC0Pbb1mbu00fV6dOB_m9KBfxSr9_Xm3rw&oe=69E635B1"}, {"file_name": "1.png", "id": "631256663110807", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391937_631256666444140_5526436203422352506_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqGlqZS9ZskQ7kNvwHTp53c&_nc_oc=AdpD4RjIkl45ZP3hVMoh6-8IF5VzVD2oxG6RUWePXvn6qpWurxrebnLOJkQXi2dl788&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dk9ZZ9ry5mDsGJniM6qNeMdwXZYgsCWyuF8da7iU7GQ&oe=69E63891"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape - 2560 x 1440px.png", "id": "674109361695253", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391937_674109365028586_8423212186245884846_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-mpMoKeBN4Q7kNvwE4Vhqi&_nc_oc=AdofRD95zObN-zNXHlcSgE0yiYu2chajsGoRu382E-TRrABb9Y_yoAaPKyCWq1bLB7M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19xhVErcMy7IQJafGHABDBVWuXEvzSK_3JTArBmbw4QA&oe=69E62404"}, "display_name": "Klick", "keywords": ["Puzzle", "Casual", "Minimal", "Logic", "Sequence"], "long_description": "You think pressing a button is easy?\nKlick dares you to prove it \u2014 200+ handcrafted puzzles, each one designed to mess with your logic, toy with your memory, and test your limits.\nEvery level is a trap. A pattern hiding in plain sight. A sequence you almost get right \u2014 until you don\u2019t.\nShapes, numbers, lights, matches, rules \u2014 it all looks simple, until you\u2019re stuck staring at four buttons like a fool.\nMost don\u2019t finish.\nBut if you do? You\u2019ll earn something better than bragging rights: the quiet satisfaction of knowing you're built different.\nNow with Mixed Reality support, you can fail \u2014 or flex \u2014 in your own living room.\nOne sequence away from genius. Or madness.\nClean. Cruel. Klick.", "short_description": "Most players quit by level 17.\nKlick isn\u2019t \u201cfun.\u201d It\u2019s a test. A clean, brutal exam for your brain disguised as a VR puzzle game.\n200+ handcrafted challenges designed to break your rhythm,mislead your logic, and expose your blind spots.\nPress the wrong button, and it\u2019s over. Miss a pattern, and start again. Think you\u2019ve got a good memory? Prove it.\nPrecision. Focus. Obsession.\nMixed Reality support if you want to fail in your living room\nYou won\u2019t beat Klick. But you'll try.\nClean. Cruel. Klick."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/nitinkumar25195/PrivacyPolicy/blob/main/Klick_Privacy_Policy", "developer_terms_of_service_url": null, "publisher_name": "XALT Labs ", "support_website_url": null, "website_url": "https://www.xaltlabs.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection
tent-ord5-1.oculuscdn.com/v/t64.5771-25/473391986_1388755188964529_8707864296202774605_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7pIACIT7ZEQ7kNvwGGSuzX&_nc_oc=AdqD7IfEKjjxE0l9tBK2f5FU76zT3e3MQSI4m6GYIDIm3_Tcy9X25Np-WIZOGepV050&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRbd-sJZ1ShkGqeUEiGIsGqMmGN2UEY044S1uMadFbAQ&oe=6AFDB9E4"}, {"file_name": "5.png", "id": "1052562140116047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393971_1052562143449380_4330406577120548270_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMk6oBiLISYQ7kNvwHOXp82&_nc_oc=AdpYR_DB_A-_nxdt6DIbZOj1vpxQGTEdlAofeEAzWc2wRemY0_p5aKGx7YLx61KSEgc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT49jK9y1S6k6XmdYvF8EaD_RIWybMMFL8V9wtnm4ozQw&oe=6AFDE1F6"}, {"file_name": "4.png", "id": "2408464942863131", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393432_2408464946196464_5117368587959372767_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gHd4HKKIPUQ7kNvwFvoP4H&_nc_oc=AdqC6fMZhb5cNAld0YYW8nhCJPqynU728W4NHQPLbhPlwGzYx7qL0Imrnix4o_6EiSA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGbDrcxlC8qvXiXDNKMsPWJnFcA0AC5WmvMvmmh0AyBw&oe=6AFDB3B1"}, {"file_name": "1.png", "id": "631256663110807", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391937_631256666444140_5526436203422352506_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ngn-xlJXaqwQ7kNvwFJiYyq&_nc_oc=AdpSepg67D4y86Mph1DGxFouhT79HIp825lkalXTr68tvAghPSTWRc0Br15c-aPvab0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQR4EwmaqhXDtNxSeNmTNdhpvuhcWR6hLoct3KUjGUVZA&oe=6AFDB691"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape - 2560 x 1440px.png", "id": "674109361695253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391937_674109365028586_8423212186245884846_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmJxJAbzaRAQ7kNvwFIZORC&_nc_oc=AdpwTz4IC17EEfclJbxDEWl_7n3e7vc3M_NsTGemExcshXc2ykPfJjIVMpdhTuCSyNI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRU-Xx9aSR0fDzfg6AV9ta3jIYdLn_Lo7K27GyGIombBw&oe=6AFDDA44"}, "display_name": "Klick", "keywords": ["Puzzle", "Casual", "Minimal", "Logic", "Sequence"], "long_description": "You think pressing a button is easy?\nKlick dares you to prove it \u2014 200+ handcrafted puzzles, each one designed to mess with your logic, toy with your memory, and test your limits.\nEvery level is a trap. A pattern hiding in plain sight. A sequence you almost get right \u2014 until you don\u2019t.\nShapes, numbers, lights, matches, rules \u2014 it all looks simple, until you\u2019re stuck staring at four buttons like a fool.\nMost don\u2019t finish.\nBut if you do? You\u2019ll earn something better than bragging rights: the quiet satisfaction of knowing you're built different.\nNow with Mixed Reality support, you can fail \u2014 or flex \u2014 in your own living room.\nOne sequence away from genius. Or madness.\nClean. Cruel. Klick.", "short_description": "Most players quit by level 17.\nKlick isn\u2019t \u201cfun.\u201d It\u2019s a test. A clean, brutal exam for your brain disguised as a VR puzzle game.\n200+ handcrafted challenges designed to break your rhythm,mislead your logic, and expose your blind spots.\nPress the wrong button, and it\u2019s over. Miss a pattern, and start again. Think you\u2019ve got a good memory? Prove it.\nPrecision. Focus. Obsession.\nMixed Reality support if you want to fail in your living room\nYou won\u2019t beat Klick. But you'll try.\nClean. Cruel. Klick."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/nitinkumar25195/PrivacyPolicy/blob/main/Klick_Privacy_Policy", "developer_terms_of_service_url": null, "publisher_name": "XALT Labs ", "support_website_url": null, "website_url": "https://www.xaltlabs.in/"
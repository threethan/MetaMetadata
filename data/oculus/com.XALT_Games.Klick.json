tent-iad6-1.oculuscdn.com/v/t64.5771-25/473391986_1388755188964529_8707864296202774605_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVPXAM8SaEkQ7kNvwEgBc7N&_nc_oc=AdpYHEX11gP1TMPTpI9bp5NK_UxEi4fu57BhmJhejXmajmGiH8rWZjAhrjoSGn6uNlQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJBdaX_fJr1s9k0aFlqjTH9EtbbFiS3hK6PrgPuSDs8g&oe=6B005CE4"}, {"file_name": "5.png", "id": "1052562140116047", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393971_1052562143449380_4330406577120548270_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0vGYWTMlKsQ7kNvwEhBb00&_nc_oc=Adr7VHaYEcUUeTNGS1JACIu-eLgKtqelmY-dJGozWCXdHsRuyGRCn82t9EtqwfLdhIo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLdMc9PR57AqKUvDPl5MHrna6ERmCfzYiLRaus3Jm28A&oe=6B0084F6"}, {"file_name": "4.png", "id": "2408464942863131", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393432_2408464946196464_5117368587959372767_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gHd4HKKIPUQ7kNvwFpupwC&_nc_oc=Ado6y9MaxwoXqYLTwT2RmDJTwJYGPcob6AyJ_9ZDet18-C5--wG5OlS00NTesfSzRa8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRK8qASLUgVN_o1g6IcCXPb1_8FyEdNROFB-JryOY4uzw&oe=6B0056B1"}, {"file_name": "1.png", "id": "631256663110807", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391937_631256666444140_5526436203422352506_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WkjnmUT1jkQ7kNvwF8XJm8&_nc_oc=AdpijjaQnV4pNEo4fD5euh2ZZKnjhxHmWchmTn1xCYerycYrdLIIotugt94jzp9tu_o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaSzKxzfeNeiC6V3kWMwP92NUGP8qZVnFF_sIooQ0NYw&oe=6B005991"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape - 2560 x 1440px.png", "id": "674109361695253", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391937_674109365028586_8423212186245884846_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ipR7xqY79EQ7kNvwHA1g0v&_nc_oc=AdqZN8aVezWOMQvnwQLKjOZZPLza7Fk6iiio45-vEcNQyoXuIQgjUGzpfE6_fKCWWAc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGmN9Eu0ZYkd58Vdl7y8oMhSIgBTYUxCYlWefRnG6j2Q&oe=6B007D44"}, "display_name": "Klick", "keywords": ["Puzzle", "Casual", "Minimal", "Logic", "Sequence"], "long_description": "You think pressing a button is easy?\nKlick dares you to prove it \u2014 200+ handcrafted puzzles, each one designed to mess with your logic, toy with your memory, and test your limits.\nEvery level is a trap. A pattern hiding in plain sight. A sequence you almost get right \u2014 until you don\u2019t.\nShapes, numbers, lights, matches, rules \u2014 it all looks simple, until you\u2019re stuck staring at four buttons like a fool.\nMost don\u2019t finish.\nBut if you do? You\u2019ll earn something better than bragging rights: the quiet satisfaction of knowing you're built different.\nNow with Mixed Reality support, you can fail \u2014 or flex \u2014 in your own living room.\nOne sequence away from genius. Or madness.\nClean. Cruel. Klick.", "short_description": "Most players quit by level 17.\nKlick isn\u2019t \u201cfun.\u201d It\u2019s a test. A clean, brutal exam for your brain disguised as a VR puzzle game.\n200+ handcrafted challenges designed to break your rhythm,mislead your logic, and expose your blind spots.\nPress the wrong button, and it\u2019s over. Miss a pattern, and start again. Think you\u2019ve got a good memory? Prove it.\nPrecision. Focus. Obsession.\nMixed Reality support if you want to fail in your living room\nYou won\u2019t beat Klick. But you'll try.\nClean. Cruel. Klick."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/nitinkumar25195/PrivacyPolicy/blob/main/Klick_Privacy_Policy", "developer_terms_of_service_url": null, "publisher_name": "XALT Labs ", "support_website_url": null, "website_url": "https://www.xaltlabs.in/"
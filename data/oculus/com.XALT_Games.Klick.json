OMpq2JWnj0rvn2RS5MueQ&oe=699ED2A4"}, {"file_name": "5.png", "id": "1052562140116047", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393971_1052562143449380_4330406577120548270_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xramUkiYLvcQ7kNvwHTdDqr&_nc_oc=AdneJdbwY7wTdJ68msrV9_81RYDgNc2NsHkVc4saBMxGPQG_A2Dst2DNvmJY1mBKMTY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvE4xBrcoxYkCDJRUk9nWfAstj0r8_qhJuv7EmUe-6wEw&oe=699EFAB6"}, {"file_name": "4.png", "id": "2408464942863131", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393432_2408464946196464_5117368587959372767_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_F9yb5oG2kQ7kNvwGv5r_R&_nc_oc=Adn0MR-8QU7TZX3p2C5_DsXSr52L9Evj-5GNJ2hGc6odEa4JYYgEbiASZ-cU0gRMrNY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftmVsE0B0Y0OXDviWlvifoaTcyugIU2cXiyLtcvHOyEzQ&oe=699F04B1"}, {"file_name": "1.png", "id": "631256663110807", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391937_631256666444140_5526436203422352506_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZ1KvWo-8scQ7kNvwHxgtun&_nc_oc=AdnOjAFH7WcXsjBe_Uw8gGAjvK-cheZX8EmUPP8dEW1bcuQTcK7ffOliZPu4NW-egAU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvEdbQjnLCBHxtlXRGtTaUvOb3qhbh3VC3HrdTaOis04A&oe=699F0791"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape - 2560 x 1440px.png", "id": "674109361695253", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391937_674109365028586_8423212186245884846_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ImaBs6SXqUQ7kNvwHGTbK-&_nc_oc=AdnQDgU_vccL4LQ2cv3gXAl7yJ8kmNbTvtysN4jHVt4yEBQVXXZ_ZlOYxcHb7FRqnDc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsTGph8ZL-t_r9cXG5KHwx_2bTvbGNLMyJSfGGyrGFm3g&oe=699EF304"}, "display_name": "Klick", "keywords": ["Puzzle", "Casual", "Minimal", "Logic", "Sequence"], "long_description": "You think pressing a button is easy?\nKlick dares you to prove it \u2014 200+ handcrafted puzzles, each one designed to mess with your logic, toy with your memory, and test your limits.\nEvery level is a trap. A pattern hiding in plain sight. A sequence you almost get right \u2014 until you don\u2019t.\nShapes, numbers, lights, matches, rules \u2014 it all looks simple, until you\u2019re stuck staring at four buttons like a fool.\nMost don\u2019t finish.\nBut if you do? You\u2019ll earn something better than bragging rights: the quiet satisfaction of knowing you're built different.\nNow with Mixed Reality support, you can fail \u2014 or flex \u2014 in your own living room.\nOne sequence away from genius. Or madness.\nClean. Cruel. Klick.", "short_description": "Most players quit by level 17.\nKlick isn\u2019t \u201cfun.\u201d It\u2019s a test. A clean, brutal exam for your brain disguised as a VR puzzle game.\n200+ handcrafted challenges designed to break your rhythm,mislead your logic, and expose your blind spots.\nPress the wrong button, and it\u2019s over. Miss a pattern, and start again. Think you\u2019ve got a good memory? Prove it.\nPrecision. Focus. Obsession.\nMixed Reality support if you want to fail in your living room\nYou won\u2019t beat Klick. But you'll try.\nClean. Cruel. Klick."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/nitinkumar25195/PrivacyPolicy/blob/main/Klick_Privacy_Policy", "developer_terms_of_service_url": null, "publisher_name": "XALT Labs ", "support_website_url": null, "website_url": "https://www.xaltlabs.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": 
hozDYjybRQisYTHrMPwwab5ktc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNT56zpN-M-2tQ6nWg-t_pY0U-WWW3tiPOOYFboCA4Ncg&oe=6AE35BE4"}, {"file_name": "5.png", "id": "1052562140116047", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393971_1052562143449380_4330406577120548270_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4hHNpptWI0Q7kNvwGliz1q&_nc_oc=AdqY2zgyFqRHsg03EgAaW-XFz8-eVM7p1GaSgkBKEZfXsJviY3vrh1OXvQ6uAZe_Kis&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQWg6KYGG2tILROv1UiPIq1nXPeKTAIk5K4anbzVPinQ&oe=6AE34BB6"}, {"file_name": "4.png", "id": "2408464942863131", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393432_2408464946196464_5117368587959372767_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOcy8jm828UQ7kNvwHfCQI4&_nc_oc=Adpwh0eYa2c3pNctxZo7BM5jrA37Ot4E8_zf7CA5P4GW9Rykh-WX50AFcqC82kUnuHo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrKQX00xbrKbCtJSrRuBD1cvt3pGrVRQIaNwP9BbaSYA&oe=6AE355B1"}, {"file_name": "1.png", "id": "631256663110807", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391937_631256666444140_5526436203422352506_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQ0SkeJndCYQ7kNvwGcpHw5&_nc_oc=AdrXsagQMQB9H42WhA1LcT0aSKkay6cCuKfm_j03zF9QjndUkfNExUu7AoAQ3dmPn_k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7TjGuMiodWjU59-1kc_6cendjJFZ5z6ohhJL6xc5GAQ&oe=6AE35891"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape - 2560 x 1440px.png", "id": "674109361695253", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391937_674109365028586_8423212186245884846_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oC_0pReQs6oQ7kNvwHFJ_G9&_nc_oc=AdoUt6zs7vxRCKQNpwbX_MMiyKh81nJqfsPo3-b53QDXz5wIt5au5nz2MUCo071VsGI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnpUuZ-2bh3kxPwmHIzr9ZkZrQV8qhhjH9woOtOiV5dw&oe=6AE34404"}, "display_name": "Klick", "keywords": ["Puzzle", "Casual", "Minimal", "Logic", "Sequence"], "long_description": "You think pressing a button is easy?\nKlick dares you to prove it \u2014 200+ handcrafted puzzles, each one designed to mess with your logic, toy with your memory, and test your limits.\nEvery level is a trap. A pattern hiding in plain sight. A sequence you almost get right \u2014 until you don\u2019t.\nShapes, numbers, lights, matches, rules \u2014 it all looks simple, until you\u2019re stuck staring at four buttons like a fool.\nMost don\u2019t finish.\nBut if you do? You\u2019ll earn something better than bragging rights: the quiet satisfaction of knowing you're built different.\nNow with Mixed Reality support, you can fail \u2014 or flex \u2014 in your own living room.\nOne sequence away from genius. Or madness.\nClean. Cruel. Klick.", "short_description": "Most players quit by level 17.\nKlick isn\u2019t \u201cfun.\u201d It\u2019s a test. A clean, brutal exam for your brain disguised as a VR puzzle game.\n200+ handcrafted challenges designed to break your rhythm,mislead your logic, and expose your blind spots.\nPress the wrong button, and it\u2019s over. Miss a pattern, and start again. Think you\u2019ve got a good memory? Prove it.\nPrecision. Focus. Obsession.\nMixed Reality support if you want to fail in your living room\nYou won\u2019t beat Klick. But you'll try.\nClean. Cruel. Klick."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/nitinkumar25195/PrivacyPolicy/blob/main/Klick_Privacy_Policy", "developer_terms_of_service_url": null, "publisher_name": "XALT Labs ", "support_website_url": null, "website_url": "https://www.xaltlabs.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection
sGzQ9b209KZDnxkjIwuE1dGPKk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHDyBt0-MEeMDs8gXyDph_Byh8uNn3R4cjpTw2fOkBgw&oe=6AB92BE4"}, {"file_name": "5.png", "id": "1052562140116047", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393971_1052562143449380_4330406577120548270_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAE27kLlyIYQ7kNvwE_NZcL&_nc_oc=AdptaGPHlWD_5tbH2F57pE2wfmJDYJxICfvI0Rlbpc2r0_SH05uv68DQUg9CrQAAwAA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMBqfn2pIwpPMRTt2SJyZxtq4u63ANWhGsFYYD2_-2BA&oe=6AB91BB6"}, {"file_name": "4.png", "id": "2408464942863131", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393432_2408464946196464_5117368587959372767_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14RhW4fnvQYQ7kNvwEzL5G2&_nc_oc=AdqlCeibixcxIfdT_-MXTV4VRo0O3DU-UMVZdivX-4q--8c9uzu72vrR0pWDMTjQnQ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaZ0dhc4mRklzNSoGQatabnPD7bJgmvdi_NWaPf41oDg&oe=6AB925B1"}, {"file_name": "1.png", "id": "631256663110807", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391937_631256666444140_5526436203422352506_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FnztGyLMhUQ7kNvwEPOpBT&_nc_oc=AdoHXcMnqSgJvDQTQs7thrBFR0fmDVGfHXqPcH8oUgeHB5Ebf7znQVUc2wx2J8PWH2o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiICwhtaF9KSqg__AjLE3WClCZgBM9A-8To4eCfG8BIA&oe=6AB92891"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape - 2560 x 1440px.png", "id": "674109361695253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391937_674109365028586_8423212186245884846_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msWsDug0AVcQ7kNvwHYTU2a&_nc_oc=AdpeHlbvdhuXWs9NgB9tn8lVL7-SdmVv-JP7bZradXMXmm4psnE0lri8W-Bo_lDelJY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPWnEh2BdK5LAp8f8TuJlfkUlJ9l6bk-B0UtIPSI5jIQ&oe=6AB91404"}, "display_name": "Klick", "keywords": ["Puzzle", "Casual", "Minimal", "Logic", "Sequence"], "long_description": "You think pressing a button is easy?\nKlick dares you to prove it \u2014 200+ handcrafted puzzles, each one designed to mess with your logic, toy with your memory, and test your limits.\nEvery level is a trap. A pattern hiding in plain sight. A sequence you almost get right \u2014 until you don\u2019t.\nShapes, numbers, lights, matches, rules \u2014 it all looks simple, until you\u2019re stuck staring at four buttons like a fool.\nMost don\u2019t finish.\nBut if you do? You\u2019ll earn something better than bragging rights: the quiet satisfaction of knowing you're built different.\nNow with Mixed Reality support, you can fail \u2014 or flex \u2014 in your own living room.\nOne sequence away from genius. Or madness.\nClean. Cruel. Klick.", "short_description": "Most players quit by level 17.\nKlick isn\u2019t \u201cfun.\u201d It\u2019s a test. A clean, brutal exam for your brain disguised as a VR puzzle game.\n200+ handcrafted challenges designed to break your rhythm,mislead your logic, and expose your blind spots.\nPress the wrong button, and it\u2019s over. Miss a pattern, and start again. Think you\u2019ve got a good memory? Prove it.\nPrecision. Focus. Obsession.\nMixed Reality support if you want to fail in your living room\nYou won\u2019t beat Klick. But you'll try.\nClean. Cruel. Klick."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/nitinkumar25195/PrivacyPolicy/blob/main/Klick_Privacy_Policy", "developer_terms_of_service_url": null, "publisher_name": "XALT Labs ", "support_website_url": null, "website_url": "https://www.xaltlabs.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection
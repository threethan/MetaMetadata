f4jWVMCK0D0Kqot-01O3P8n5Hg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NgdE3oqqALpUMZ3nmikt5idKaQ-AYRVyQa3pbrWiRuw&oe=69E78D64"}, {"file_name": "5.png", "id": "1052562140116047", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393971_1052562143449380_4330406577120548270_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZueNLhjeIQQ7kNvwGjlmFm&_nc_oc=AdqTVnbu2OQLdgBazoYIVxeWXiTNHz3G9LsN43G-SwTvbhi1Y8DPIqmnwx6eb_0eG5g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22Ic4zS_mAHaFNUk8Oi_Aeb5_0LHyjp6zjlJmUrzO64Q&oe=69E77D36"}, {"file_name": "4.png", "id": "2408464942863131", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393432_2408464946196464_5117368587959372767_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPVIXZZ0W2IQ7kNvwF_8sqo&_nc_oc=Adp3rZkn4SIgJZ8fOKfSQwameGc6YwpXbiIN_NES8UMH63lfPlkFqLbPfnDU1KShuLU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pvlspqM0KzLSmOmC1yNFIpx-Sh_MBx1-fZhfJg2WXiQ&oe=69E78731"}, {"file_name": "1.png", "id": "631256663110807", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391937_631256666444140_5526436203422352506_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqGlqZS9ZskQ7kNvwEB9aQO&_nc_oc=Ado2eAiR0ES1tU-kAWQDvd2QEvTtcR5WGiUEtiNum6jDcN_qZc1BtRKOSchgeMSLcmg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MTVZoBPO8eBuxVkMmuG_OuxN1XbjFAphagq_i7s14zQ&oe=69E78A11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape - 2560 x 1440px.png", "id": "674109361695253", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391937_674109365028586_8423212186245884846_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viHO3iJja64Q7kNvwEjq8i6&_nc_oc=AdrHVLbOojMOtmMvOnpm8YBj03-ydiOr8x7clmtFqwLpyISR4P-ufmILdHtXkP1kxdY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jj6uAGnTSXDdrXCqjdYT8d9bpsZTum0DSMRp8y_PQtQ&oe=69E77584"}, "display_name": "Klick", "keywords": ["Puzzle", "Casual", "Minimal", "Logic", "Sequence"], "long_description": "You think pressing a button is easy?\nKlick dares you to prove it \u2014 200+ handcrafted puzzles, each one designed to mess with your logic, toy with your memory, and test your limits.\nEvery level is a trap. A pattern hiding in plain sight. A sequence you almost get right \u2014 until you don\u2019t.\nShapes, numbers, lights, matches, rules \u2014 it all looks simple, until you\u2019re stuck staring at four buttons like a fool.\nMost don\u2019t finish.\nBut if you do? You\u2019ll earn something better than bragging rights: the quiet satisfaction of knowing you're built different.\nNow with Mixed Reality support, you can fail \u2014 or flex \u2014 in your own living room.\nOne sequence away from genius. Or madness.\nClean. Cruel. Klick.", "short_description": "Most players quit by level 17.\nKlick isn\u2019t \u201cfun.\u201d It\u2019s a test. A clean, brutal exam for your brain disguised as a VR puzzle game.\n200+ handcrafted challenges designed to break your rhythm,mislead your logic, and expose your blind spots.\nPress the wrong button, and it\u2019s over. Miss a pattern, and start again. Think you\u2019ve got a good memory? Prove it.\nPrecision. Focus. Obsession.\nMixed Reality support if you want to fail in your living room\nYou won\u2019t beat Klick. But you'll try.\nClean. Cruel. Klick."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/nitinkumar25195/PrivacyPolicy/blob/main/Klick_Privacy_Policy", "developer_terms_of_service_url": null, "publisher_name": "XALT Labs ", "support_website_url": null, "website_url": "https://www.xaltlabs.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection
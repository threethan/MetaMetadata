aVnzVr79Yj2ZVSW7vtwwQ8Lbh8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pTcicad5Zhqqcx8bQy8BFrIQ2LU_VlsofK0jV2c7amg&oe=69DA5E64"}, {"file_name": "5.png", "id": "1052562140116047", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393971_1052562143449380_4330406577120548270_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksp-kGp9c-IQ7kNvwH4unO0&_nc_oc=AdrqKP_Wtxzy0TklmU0LapqgPxE1POGIOlpnDWqouidXasRYD8y3gEwIWvTbs3kZUL8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af157xNxKEkHA0Iwgd0FAzx6ESaLM3_y8HYMI4TTaD3fhA&oe=69DA4E36"}, {"file_name": "4.png", "id": "2408464942863131", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393432_2408464946196464_5117368587959372767_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1mUsRZs2ykQ7kNvwE2-_Ty&_nc_oc=AdrE-K066POHIMOBilynIxVOxeWimg3nQblQErF8Gm82Iww12b3ypRTHI-i2oUdGR4M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MfHCMlbHbu2PswjPeCsuIphEMuyHVHrHjujuEaw-zdg&oe=69DA5831"}, {"file_name": "1.png", "id": "631256663110807", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391937_631256666444140_5526436203422352506_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jJaCBgodNMQ7kNvwFiQJl9&_nc_oc=AdrNi1fY2HR6iYeyrhapaXBaZh_jyUvgGjR2R0lss3sd2zICxehJ0FCZABoC1qu53c0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32W91zIG-Zad57g6ewOcjnr8fV-5h918v02rZdX2Jt6A&oe=69DA5B11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape - 2560 x 1440px.png", "id": "674109361695253", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391937_674109365028586_8423212186245884846_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4w1AWnK9psQ7kNvwEkoPLk&_nc_oc=AdrGPhcD2BtCqbYX9MSAyngRcUo8ItJ1bDX8EtC-1m_sLr7UUafiRmyBiup9QxSABx8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_RoAlYnpH6tz84hZ_Ug1cOEOVaErrGLr38zVFVQkzXg&oe=69DA4684"}, "display_name": "Klick", "keywords": ["Puzzle", "Casual", "Minimal", "Logic", "Sequence"], "long_description": "You think pressing a button is easy?\nKlick dares you to prove it \u2014 200+ handcrafted puzzles, each one designed to mess with your logic, toy with your memory, and test your limits.\nEvery level is a trap. A pattern hiding in plain sight. A sequence you almost get right \u2014 until you don\u2019t.\nShapes, numbers, lights, matches, rules \u2014 it all looks simple, until you\u2019re stuck staring at four buttons like a fool.\nMost don\u2019t finish.\nBut if you do? You\u2019ll earn something better than bragging rights: the quiet satisfaction of knowing you're built different.\nNow with Mixed Reality support, you can fail \u2014 or flex \u2014 in your own living room.\nOne sequence away from genius. Or madness.\nClean. Cruel. Klick.", "short_description": "Most players quit by level 17.\nKlick isn\u2019t \u201cfun.\u201d It\u2019s a test. A clean, brutal exam for your brain disguised as a VR puzzle game.\n200+ handcrafted challenges designed to break your rhythm,mislead your logic, and expose your blind spots.\nPress the wrong button, and it\u2019s over. Miss a pattern, and start again. Think you\u2019ve got a good memory? Prove it.\nPrecision. Focus. Obsession.\nMixed Reality support if you want to fail in your living room\nYou won\u2019t beat Klick. But you'll try.\nClean. Cruel. Klick."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/nitinkumar25195/PrivacyPolicy/blob/main/Klick_Privacy_Policy", "developer_terms_of_service_url": null, "publisher_name": "XALT Labs ", "support_website_url": null, "website_url": "https://www.xaltlabs.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection
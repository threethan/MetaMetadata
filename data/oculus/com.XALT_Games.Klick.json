vRvgiIfr8PYMtSJK6Bw9bH6lis&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QHjtwSnH97qKbEtg47n88BlxlA2xbzL7p10XBx-rGCA&oe=6A09D464"}, {"file_name": "5.png", "id": "1052562140116047", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393971_1052562143449380_4330406577120548270_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4Xi8wpJ32EQ7kNvwFMEwJx&_nc_oc=Adr3yUSLaWE9UeTW228NVZHdYn5csUS-q9Q-R4jsqgNqwmCInmfJp-Sbrw2F4J3x6Is&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78wIkemBLXog2iTm7O6VClhMWKdJ1vzOc1HxlaOEsA4A&oe=6A09C436"}, {"file_name": "4.png", "id": "2408464942863131", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393432_2408464946196464_5117368587959372767_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJ7Sp_uYhdQQ7kNvwFsakAs&_nc_oc=AdpvkxFFdEd1m4n6bXej5pEtT_3mdjRxvmp1moTXq94Y3qn0rrYPTTtwOiCY0zFWkcc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4l9XRiwfekJKiTsa_k9HiLaSPkNV0BDxlg75Rk0PBHtA&oe=6A09CE31"}, {"file_name": "1.png", "id": "631256663110807", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391937_631256666444140_5526436203422352506_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pepPO8U5ztsQ7kNvwGNG2GL&_nc_oc=AdqIfGljDHansbaMyBLZT6gEakh0XzeHRmXNcGYMgQA020qQNMNOkk01Qjya7LgDfxg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Cd95jfxu7B5vvQrG_B51dMzEDr-VYJpeTq1tlCROV4g&oe=6A09D111"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape - 2560 x 1440px.png", "id": "674109361695253", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391937_674109365028586_8423212186245884846_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjncu5dLYikQ7kNvwFI8Zv3&_nc_oc=Adpo5HU3bNkVB9XJxvih8_UN0kvyVEKIkCWoFARTUKMPRvLwVWUR-F3xKMzGT01vZco&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79TYlNV_s9BvyO00SeQ_YwyAticUxcwMfRvkNXrT_p1g&oe=6A09BC84"}, "display_name": "Klick", "keywords": ["Puzzle", "Casual", "Minimal", "Logic", "Sequence"], "long_description": "You think pressing a button is easy?\nKlick dares you to prove it \u2014 200+ handcrafted puzzles, each one designed to mess with your logic, toy with your memory, and test your limits.\nEvery level is a trap. A pattern hiding in plain sight. A sequence you almost get right \u2014 until you don\u2019t.\nShapes, numbers, lights, matches, rules \u2014 it all looks simple, until you\u2019re stuck staring at four buttons like a fool.\nMost don\u2019t finish.\nBut if you do? You\u2019ll earn something better than bragging rights: the quiet satisfaction of knowing you're built different.\nNow with Mixed Reality support, you can fail \u2014 or flex \u2014 in your own living room.\nOne sequence away from genius. Or madness.\nClean. Cruel. Klick.", "short_description": "Most players quit by level 17.\nKlick isn\u2019t \u201cfun.\u201d It\u2019s a test. A clean, brutal exam for your brain disguised as a VR puzzle game.\n200+ handcrafted challenges designed to break your rhythm,mislead your logic, and expose your blind spots.\nPress the wrong button, and it\u2019s over. Miss a pattern, and start again. Think you\u2019ve got a good memory? Prove it.\nPrecision. Focus. Obsession.\nMixed Reality support if you want to fail in your living room\nYou won\u2019t beat Klick. But you'll try.\nClean. Cruel. Klick."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/nitinkumar25195/PrivacyPolicy/blob/main/Klick_Privacy_Policy", "developer_terms_of_service_url": null, "publisher_name": "XALT Labs ", "support_website_url": null, "website_url": "https://www.xaltlabs.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection
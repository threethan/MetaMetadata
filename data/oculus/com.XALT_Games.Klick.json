tent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391986_1388755188964529_8707864296202774605_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t92GeXLtG1QQ7kNvwF066_o&_nc_oc=AdqMKa2WnjqrMBvRiuUGbukB9Zv1u-OuAnDeYskbU71-bzsz1fkNnDVa9-ZjX_zzq74&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaYwYQ7VgoEOl-VzLtbxL8Qv7S1MLOwSE-7J7XxDrN7Q&oe=6B033824"}, {"file_name": "5.png", "id": "1052562140116047", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393971_1052562143449380_4330406577120548270_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3FTK5MeP20Q7kNvwG8j9X2&_nc_oc=AdrGOYDV4gL-Nchpb8ioJDsOtpiaP797UisQtWjoI72KJG6gVDgdew3D1vWXsWFpFwA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTD9wtSH-yaJnaDaJNkwSWInUesTmJAKNHTd9yQy6hzpg&oe=6B0327F6"}, {"file_name": "4.png", "id": "2408464942863131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393432_2408464946196464_5117368587959372767_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKJGdI5H7sgQ7kNvwFGFiOT&_nc_oc=AdrimUofJEr6_OyKlidgJJfwqJA2nKW9Hii4Ty9V4DFJ-u5gHcqIKaRZVVmuWaa3PzY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHPkEr3oOyS5Y-GvC7SGAquy9kQWH620CnRkUGh3fp5Q&oe=6B0331F1"}, {"file_name": "1.png", "id": "631256663110807", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391937_631256666444140_5526436203422352506_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJulYUymH1oQ7kNvwHo93Mg&_nc_oc=AdocMa4qyX95ZULXJ2-WuFIJtQKj7BlHOKt9a06bnVDYepeI17G2dHLNbVNhYYfaVwM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYp2UAaky1m5uSV2jBSBbvAeKUmewC5nSiQTdShmyZOg&oe=6B0334D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape - 2560 x 1440px.png", "id": "674109361695253", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391937_674109365028586_8423212186245884846_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ipR7xqY79EQ7kNvwG-UxEo&_nc_oc=Adob4Bz2aizV84OFErXMX2LpwGEGtiBysdCf0hdz5xnCKB0r8geYmWEJ9Tb371MOMis&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_KiBELIDKSQRiJqZX6h9eXaD5mm6K5Yf-QHJUTSihaQ&oe=6B032044"}, "display_name": "Klick", "keywords": ["Puzzle", "Casual", "Minimal", "Logic", "Sequence"], "long_description": "You think pressing a button is easy?\nKlick dares you to prove it \u2014 200+ handcrafted puzzles, each one designed to mess with your logic, toy with your memory, and test your limits.\nEvery level is a trap. A pattern hiding in plain sight. A sequence you almost get right \u2014 until you don\u2019t.\nShapes, numbers, lights, matches, rules \u2014 it all looks simple, until you\u2019re stuck staring at four buttons like a fool.\nMost don\u2019t finish.\nBut if you do? You\u2019ll earn something better than bragging rights: the quiet satisfaction of knowing you're built different.\nNow with Mixed Reality support, you can fail \u2014 or flex \u2014 in your own living room.\nOne sequence away from genius. Or madness.\nClean. Cruel. Klick.", "short_description": "Most players quit by level 17.\nKlick isn\u2019t \u201cfun.\u201d It\u2019s a test. A clean, brutal exam for your brain disguised as a VR puzzle game.\n200+ handcrafted challenges designed to break your rhythm,mislead your logic, and expose your blind spots.\nPress the wrong button, and it\u2019s over. Miss a pattern, and start again. Think you\u2019ve got a good memory? Prove it.\nPrecision. Focus. Obsession.\nMixed Reality support if you want to fail in your living room\nYou won\u2019t beat Klick. But you'll try.\nClean. Cruel. Klick."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/nitinkumar25195/PrivacyPolicy/blob/main/Klick_Privacy_Policy", "developer_terms_of_service_url": null, "publisher_name": "XALT Labs ", "support_website_url": null, "website_url": "https://www.xaltlabs.in/"
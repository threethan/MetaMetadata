SLe2WA22cXSRDC_njdpVvvNBy0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SAJS6fP0oJhxNMV_qn5sqI41hhaZxoH9asA-PFSukhQ&oe=6A3555E4"}, {"file_name": "5.png", "id": "1052562140116047", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393971_1052562143449380_4330406577120548270_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6i1iM3d80mwQ7kNvwHiapBD&_nc_oc=Adqk_j8_csefC6X4UigbmMNC6Ob1xDnKebdWq0UAE7zeO9m80ipo7T4VfFblvK-o6Lc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1SEmUKxv99N2O84TUqRIN3ObwtJfPQmV9AsJja5_New&oe=6A3545B6"}, {"file_name": "4.png", "id": "2408464942863131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393432_2408464946196464_5117368587959372767_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTcYq9dRISwQ7kNvwHMnlcA&_nc_oc=AdpEtjTfiFN9nkHLczDBve-nkS_60PAo0HgJ7dbAzSfDc29OjxBGuGJa25Em2an1L6o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8e36SVxvzOK6FXTDRvyvskW-l1ni__pJ5jqBt61JD-hQ&oe=6A354FB1"}, {"file_name": "1.png", "id": "631256663110807", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391937_631256666444140_5526436203422352506_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NwJ46oR_2fkQ7kNvwFbpwWu&_nc_oc=AdrZZrH6jA5OMHVdDgJB54Hmf8J8oFlaqtjTPZvwpg3f4BDbRQuTYJR9nu1She7_-QM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3lWMnCBM_ePF_3Kz9W4lN0WJ3G3-oZJC4F3s1yd1XuQ&oe=6A355291"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape - 2560 x 1440px.png", "id": "674109361695253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391937_674109365028586_8423212186245884846_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oap3LrxWMc8Q7kNvwFDk8LS&_nc_oc=AdpKbupGM4Wfv_E9TuGr13EAmx7ySNOTtgLuSx2TaWEne2WXrfMMkZcvYaCpwF5eR5I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JCl7eUNFFsf6U4a4Z97n_IVh8nO3vD9K86YQEbKr4LQ&oe=6A353E04"}, "display_name": "Klick", "keywords": ["Puzzle", "Casual", "Minimal", "Logic", "Sequence"], "long_description": "You think pressing a button is easy?\nKlick dares you to prove it \u2014 200+ handcrafted puzzles, each one designed to mess with your logic, toy with your memory, and test your limits.\nEvery level is a trap. A pattern hiding in plain sight. A sequence you almost get right \u2014 until you don\u2019t.\nShapes, numbers, lights, matches, rules \u2014 it all looks simple, until you\u2019re stuck staring at four buttons like a fool.\nMost don\u2019t finish.\nBut if you do? You\u2019ll earn something better than bragging rights: the quiet satisfaction of knowing you're built different.\nNow with Mixed Reality support, you can fail \u2014 or flex \u2014 in your own living room.\nOne sequence away from genius. Or madness.\nClean. Cruel. Klick.", "short_description": "Most players quit by level 17.\nKlick isn\u2019t \u201cfun.\u201d It\u2019s a test. A clean, brutal exam for your brain disguised as a VR puzzle game.\n200+ handcrafted challenges designed to break your rhythm,mislead your logic, and expose your blind spots.\nPress the wrong button, and it\u2019s over. Miss a pattern, and start again. Think you\u2019ve got a good memory? Prove it.\nPrecision. Focus. Obsession.\nMixed Reality support if you want to fail in your living room\nYou won\u2019t beat Klick. But you'll try.\nClean. Cruel. Klick."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/nitinkumar25195/PrivacyPolicy/blob/main/Klick_Privacy_Policy", "developer_terms_of_service_url": null, "publisher_name": "XALT Labs ", "support_website_url": null, "website_url": "https://www.xaltlabs.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection
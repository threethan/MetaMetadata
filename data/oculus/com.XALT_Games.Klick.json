0E4"}, {"file_name": "5.png", "id": "1052562140116047", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393971_1052562143449380_4330406577120548270_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmBJzf6IVrEQ7kNvwG806I8&_nc_oc=AdqfgvGw6pgtEQ-JlDmVFRZn1Uh-iCdU3Ii4tZepsCcXaO2bt84-FOhx3KsANHFQqY8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RXxyI7XT7LV2LW-4MP8zAtcdfFqeowurjq-xqq6Vq4w&oe=6A22D0B6"}, {"file_name": "4.png", "id": "2408464942863131", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473393432_2408464946196464_5117368587959372767_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4IEIqnF3ycQ7kNvwFdY-tl&_nc_oc=Adohtxi0rxT0proRfC1GVXYl3c98b-ztT1L0UFMiYUUXQXzEbXkypjWu8hinV-aTJCY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_A2ErXmZLij1y5PiY5uUBQkPmHCO33id1dKE5hOA9xqw&oe=6A22DAB1"}, {"file_name": "1.png", "id": "631256663110807", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391937_631256666444140_5526436203422352506_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctFf4ewU-W8Q7kNvwH0sSd_&_nc_oc=Adpb73waBswhbeOD-cIh3CdAyN0y231jTPAdkhpKXxbRHvCrzGRi24wzvEQj6puLuyE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Kjvu7RwKsN9lGkOE7oLy4goMkvivkbUmXNwSmtR0KeQ&oe=6A22DD91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape - 2560 x 1440px.png", "id": "674109361695253", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391937_674109365028586_8423212186245884846_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFYmW6z25tYQ7kNvwGhE2-o&_nc_oc=AdpdbX4dXY1QiBIy5JTiHu6B4_e0vg4_Z7W9Dsy8pyzCWd1PyFo2ICey2LpVzylLbEI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_l0uE6nNMs4sjuUdaUf1cRKPWOLnPfo8ofqFwdnvoFpw&oe=6A230144"}, "display_name": "Klick", "keywords": ["Puzzle", "Casual", "Minimal", "Logic", "Sequence"], "long_description": "Klick is a minimal, mind-bending VR puzzle experience where every solution is just one sequence away. With over 200 handcrafted puzzles spread across five unique sets, Klick challenges you to think logically, observe patterns, and press buttons in the correct order to progress.\nFrom simple taps to complex logic chains, each level is a test of precision, memory, and deduction. Whether you're chasing the right shape, matching pairs, balancing numbers, or following light-up patterns, Klick turns pressing buttons into a deeply satisfying puzzle journey.\nNow with Mixed Reality support, you can bring the puzzles into your real-world space\u2014seamlessly blending logic and immersion.\nClean. Clever. Klick..", "short_description": "Klick is a minimal, mind-bending VR puzzle game with over 200 handcrafted challenges. Press buttons in the right order, follow patterns, match shapes, balance numbers, and more. Test your logic, memory, and precision across five unique puzzle sets. Now with Mixed Reality support, bring the puzzles into your world for a seamless, immersive experience.\nClean. Clever. Klick."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/nitinkumar25195/PrivacyPolicy/blob/main/Klick_Privacy_Policy", "developer_terms_of_service_url": null, "publisher_name": "XALT Labs ", "support_website_url": null, "website_url": "https://www.xaltlabs.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": 
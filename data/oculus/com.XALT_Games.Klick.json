Ifn2ra2j4yXhLy7t4IT5tzjx3Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPT4amSdD9_AG76dBhoEX8mAtQzqmR7ozomDnEOQBxmA&oe=6AAAAB64"}, {"file_name": "5.png", "id": "1052562140116047", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393971_1052562143449380_4330406577120548270_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9o-y8bSNiEEQ7kNvwFgFdsL&_nc_oc=AdrEhG-jFwGIXib6LC592KZg7otgghey4fgxzheEL43BMhx34g5K3b3VTPYMWYIkUa8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbY0IiY26aH86UUSxTJsV4d9j-x0piaRhq1ChrrptUYA&oe=6AAA9B36"}, {"file_name": "4.png", "id": "2408464942863131", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393432_2408464946196464_5117368587959372767_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_THHpEgi2gQ7kNvwH2D3WH&_nc_oc=Adr5PMqG6hAGYRiJ_7VFLSTlUo0VEhC8QZDR28bo7rOdl8g92r8OBnYQSlV71qt3QlM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIo8ITEa-b4TgwBEmfK8TcgADFliqBV7orj7sEhGVRvzg&oe=6AAAA531"}, {"file_name": "1.png", "id": "631256663110807", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391937_631256666444140_5526436203422352506_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-eqs8d3BF-gQ7kNvwEYp302&_nc_oc=AdoFAJ0o85ZVWZ2G99qBaKzn70b4yNmkPE0zohtJKdtCSXgdJyJyWcCCvj-bgo1A1sc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQlEoSD-SEto3wVXOYcgTu3pDmbMnTEJc9KgEUAimFYg&oe=6AAAA811"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape - 2560 x 1440px.png", "id": "674109361695253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391937_674109365028586_8423212186245884846_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjDCp1HZ3igQ7kNvwGkDpYb&_nc_oc=AdpG_e4Y7v9GdleluhsJgleDswvRdr5k9ftqRzveYQ8AxDjCT4e4RH7TranXCLU7ECk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeH1NzaCwsK-zUTHIsl-3RD3_a6AYqQlWSrqdBcKA7rA&oe=6AAA9384"}, "display_name": "Klick", "keywords": ["Puzzle", "Casual", "Minimal", "Logic", "Sequence"], "long_description": "You think pressing a button is easy?\nKlick dares you to prove it \u2014 200+ handcrafted puzzles, each one designed to mess with your logic, toy with your memory, and test your limits.\nEvery level is a trap. A pattern hiding in plain sight. A sequence you almost get right \u2014 until you don\u2019t.\nShapes, numbers, lights, matches, rules \u2014 it all looks simple, until you\u2019re stuck staring at four buttons like a fool.\nMost don\u2019t finish.\nBut if you do? You\u2019ll earn something better than bragging rights: the quiet satisfaction of knowing you're built different.\nNow with Mixed Reality support, you can fail \u2014 or flex \u2014 in your own living room.\nOne sequence away from genius. Or madness.\nClean. Cruel. Klick.", "short_description": "Most players quit by level 17.\nKlick isn\u2019t \u201cfun.\u201d It\u2019s a test. A clean, brutal exam for your brain disguised as a VR puzzle game.\n200+ handcrafted challenges designed to break your rhythm,mislead your logic, and expose your blind spots.\nPress the wrong button, and it\u2019s over. Miss a pattern, and start again. Think you\u2019ve got a good memory? Prove it.\nPrecision. Focus. Obsession.\nMixed Reality support if you want to fail in your living room\nYou won\u2019t beat Klick. But you'll try.\nClean. Cruel. Klick."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/nitinkumar25195/PrivacyPolicy/blob/main/Klick_Privacy_Policy", "developer_terms_of_service_url": null, "publisher_name": "XALT Labs ", "support_website_url": null, "website_url": "https://www.xaltlabs.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection
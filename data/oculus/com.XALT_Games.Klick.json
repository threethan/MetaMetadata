sL-3Qp5H-7_thRcqFNxhr_fq44&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wGmtOYmLtD98RhTVbOzVarUb4pVB_2Z0HcaQCF9a0fg&oe=6A243264"}, {"file_name": "5.png", "id": "1052562140116047", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393971_1052562143449380_4330406577120548270_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmBJzf6IVrEQ7kNvwH92TQv&_nc_oc=AdqspXGrctQpavXAH46k66qrUmXwWI7-89T9Wuj01hEu2YljUeX4YS0px-JiBgHnKes&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9c9-vtfk7vQvtrIX6b49jyhi2y1ooj9LmkyjfUZcDNAg&oe=6A242236"}, {"file_name": "4.png", "id": "2408464942863131", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393432_2408464946196464_5117368587959372767_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkPDKjy9wrAQ7kNvwHc5L35&_nc_oc=AdqBQSERXyn1ENq2p4e9rgBV6pkQ9JmHdDw7gxP_0MC0NYmZ2hdDTj4JkEAt-3EDxL0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gfB5WJGwiFqoRV37hG7fgXO-gUROhgNlPPnVNGL4Paw&oe=6A242C31"}, {"file_name": "1.png", "id": "631256663110807", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391937_631256666444140_5526436203422352506_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctFf4ewU-W8Q7kNvwFgtQKb&_nc_oc=AdqhuX_wQq--kufNk7B_XWWCizGKPxY11Ui2bhk1CWYaYLEG6w0p-9DnJBs02a7Br8I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vQv2Fz-d9XV5SxLuyH-FL4lX7d56CrabTL9fjC1Rzkw&oe=6A242F11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape - 2560 x 1440px.png", "id": "674109361695253", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391937_674109365028586_8423212186245884846_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFYmW6z25tYQ7kNvwFxeM6i&_nc_oc=AdrYBz_qRp-L0hZAcnFvcJzHwCAiA732srohon2l-M50mkZ4-_lTatg1ZUq26LB7_WU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wq4ZadfksV1fpH-ZP4kO3gGhDJV7kDzRxpkAF8VU-_A&oe=6A241A84"}, "display_name": "Klick", "keywords": ["Puzzle", "Casual", "Minimal", "Logic", "Sequence"], "long_description": "You think pressing a button is easy?\nKlick dares you to prove it \u2014 200+ handcrafted puzzles, each one designed to mess with your logic, toy with your memory, and test your limits.\nEvery level is a trap. A pattern hiding in plain sight. A sequence you almost get right \u2014 until you don\u2019t.\nShapes, numbers, lights, matches, rules \u2014 it all looks simple, until you\u2019re stuck staring at four buttons like a fool.\nMost don\u2019t finish.\nBut if you do? You\u2019ll earn something better than bragging rights: the quiet satisfaction of knowing you're built different.\nNow with Mixed Reality support, you can fail \u2014 or flex \u2014 in your own living room.\nOne sequence away from genius. Or madness.\nClean. Cruel. Klick.", "short_description": "Most players quit by level 17.\nKlick isn\u2019t \u201cfun.\u201d It\u2019s a test. A clean, brutal exam for your brain disguised as a VR puzzle game.\n200+ handcrafted challenges designed to break your rhythm,mislead your logic, and expose your blind spots.\nPress the wrong button, and it\u2019s over. Miss a pattern, and start again. Think you\u2019ve got a good memory? Prove it.\nPrecision. Focus. Obsession.\nMixed Reality support if you want to fail in your living room\nYou won\u2019t beat Klick. But you'll try.\nClean. Cruel. Klick."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/nitinkumar25195/PrivacyPolicy/blob/main/Klick_Privacy_Policy", "developer_terms_of_service_url": null, "publisher_name": "XALT Labs ", "support_website_url": null, "website_url": "https://www.xaltlabs.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection
f-k94EwQ7kNvwG7OQIu&_nc_oc=AdottcwUzTIJpeCUMKWXrPcA4AgFn_zIoHvuGGuaBoARChCUg6Ib_872nEuipc4IFcg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0krkypRiKUUPT4c_PpN0Wme7TAbYj_u4aEJAzdFxISbw&oe=69E763DA"}, {"file_name": "migrated_image.png", "id": "555293135108000", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12410453_200768527038499_4161114219313364992_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOYuVc4j--YQ7kNvwEFg1JV&_nc_oc=Ado8VmBqxWmw1RanO2nHG3fEpIYhzTsodl0ITUT_KX7nPSFnAz_pVqfHI3T0eqcTGzE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tji1rW4kvyCR1pkruJa-Ibw42_kRxKdGtYVjHodD6zA&oe=69E78158"}, {"file_name": "migrated_image.png", "id": "516016999103139", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12138845_609142182606583_4482711582207377408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44VqHeH34dAQ7kNvwG-rIUz&_nc_oc=AdpovhYXy5eEAe-6MMVutlUpUq-GkVrZi4RTHJCfOjjkBhO_d2j2d_U_LukRrMOjVCQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XkiPLJL7OuAWCHBK-LimCviTELsg620a1dJoGh_TWmw&oe=69E78B40"}, {"file_name": "migrated_image.png", "id": "217163369341263", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12727849_1805928052952257_5353107934765121536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ExixFCD9_4Q7kNvwHUMQcP&_nc_oc=AdpojFp-iVCiWX_YFUDsn6Sudg8mqvdzVaHGA5h9LJxJdgQgS8juuEQROva3DCK_rtc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xQO95dVooOlHOys493H0xd6NkQc7w6T6Su4t6R0gMyg&oe=69E77EEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Earth Origin", "keywords": ["Space", "Flight", "Combat", "Earth", "Battle"], "long_description": "Blast aliens, steer through winding tunnels, and explore the most dangerous corners of our solar system. This fast-paced space shooter puts you in the heat of the action, zipping past asteroids with enemies on your tail.\n\nShortly after our first contact with an alien species, a multitude of curious alien invaders from across the galaxy set course for our solar system, bringing with them war and destruction. As a new star in the Earth Alliance, your mission is to bring peace and safety back to our solar system, one planet at a time, starting at home: planet Earth.\n\nBegin with a few easy training missions and progress to harder campaigns, upgrading your ship with weapons and utilities along the way, and track your rank in the leaderboards. Each mission has a different goal, from protecting important structures and figuring out puzzles to destroying alien bosses.\n\nA swivel chair is required to allow 360\u00b0 rotations. Gamepad recommended.\n\nVisit earthoriginvr.com/hints for tips.", "short_description": "Blast aliens, steer through winding tunnels, and explore the most dangerous corners of our solar system. This fast-paced space shooter puts you in the heat of the action, zipping past asteroids with enemies on your tail."}]}, "developer_name": null, "developer_privacy_policy_url": "http://earthoriginvr.com/privacy-policy/", "developer_terms_of_service_url": "http://earthoriginvr.com/terms-of-service/", "publisher_name": "Cryofrog Inc.", "support_website_url": null, "website_url": "http://earthoriginvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "SHOOTER", "SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "478017913770019"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12138943_9166
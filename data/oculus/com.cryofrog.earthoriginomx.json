uUGNNcQQ7kNvwERoiW5&_nc_oc=Adpg4-Ny9QRd6KWpo0rzLiI8mnyrQM6I4V98pbvo4QqMiEfMb0KHi48O9yYFZJXD8Zg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNdxidWr0EQ3-Z736JfQV0VNqEvylyOM109c6aenPEow&oe=6A9D8B1A"}, {"file_name": "migrated_image.png", "id": "555293135108000", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410453_200768527038499_4161114219313364992_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EAOXxSU5yKEQ7kNvwGyOsxu&_nc_oc=Ado1jM82d_xAKhTDMiDMkS7_qJE_w-FAe58dwv4r263u0RiXVi3WLKWy2OMNMWqI2u0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2gbKItmVuvG7w0KN6Kzuwn9dZY2nQ0u4FdOr2Gbk9YA&oe=6A9D7058"}, {"file_name": "migrated_image.png", "id": "516016999103139", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138845_609142182606583_4482711582207377408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63Zj6cTfXI4Q7kNvwFIv6um&_nc_oc=AdoUrRVA8Fc-15CdNn6VCtC1Csy6dYBMbI5lEdpkYHb4Mfe-9xzyCbyvUO6th51Clg8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkND1o6clIN-3s0S_dG463pgk3A1KNDCW2tZSc6q96Bg&oe=6A9D7A40"}, {"file_name": "migrated_image.png", "id": "217163369341263", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12727849_1805928052952257_5353107934765121536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTKAmye-a1oQ7kNvwHYMXuH&_nc_oc=AdoSfrec-dKZDKSXg0Io6cHbqSrN8zkP6iGDjmz1c7MGboS5ebk-dkOzbYoD6vDTSmU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDIR5CbiTkLqW5kWAQC8i5Ku2vKvvjexC3ghMaoUKcDA&oe=6A9D6DEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Earth Origin", "keywords": ["Space", "Flight", "Combat", "Earth", "Battle"], "long_description": "Blast aliens, steer through winding tunnels, and explore the most dangerous corners of our solar system. This fast-paced space shooter puts you in the heat of the action, zipping past asteroids with enemies on your tail.\n\nShortly after our first contact with an alien species, a multitude of curious alien invaders from across the galaxy set course for our solar system, bringing with them war and destruction. As a new star in the Earth Alliance, your mission is to bring peace and safety back to our solar system, one planet at a time, starting at home: planet Earth.\n\nBegin with a few easy training missions and progress to harder campaigns, upgrading your ship with weapons and utilities along the way, and track your rank in the leaderboards. Each mission has a different goal, from protecting important structures and figuring out puzzles to destroying alien bosses.\n\nA swivel chair is required to allow 360\u00b0 rotations. Gamepad recommended.\n\nVisit earthoriginvr.com/hints for tips.", "short_description": "Blast aliens, steer through winding tunnels, and explore the most dangerous corners of our solar system. This fast-paced space shooter puts you in the heat of the action, zipping past asteroids with enemies on your tail."}]}, "developer_name": null, "developer_privacy_policy_url": "http://earthoriginvr.com/privacy-policy/", "developer_terms_of_service_url": "http://earthoriginvr.com/terms-of-service/", "publisher_name": "Cryofrog Inc.", "support_website_url": null, "website_url": "http://earthoriginvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "SHOOTER", "SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "478017913770019"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138943_9166
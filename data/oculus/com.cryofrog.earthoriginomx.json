_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afv87p5oukBqtrtsPS_5F-4Gy1sIhYir7EVfZQIAdjlTKw&oe=69A1845A"}, {"file_name": "migrated_image.png", "id": "555293135108000", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/12410453_200768527038499_4161114219313364992_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qd0dd8KcqKMQ7kNvwGEX1oF&_nc_oc=AdlDBMavnTcpHBGuPN8qMv4PwJYXlqmb7hANrnjFPEweN3Ll-Rma22JVUiAYOQBWY6Q&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afs_JfVpSObh2Jilhoi1AvuUhrPJh5vwqXphGybw0rzFBg&oe=69A1A1D8"}, {"file_name": "migrated_image.png", "id": "516016999103139", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/12138845_609142182606583_4482711582207377408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmLPhzgg-sQQ7kNvwGh7Hm9&_nc_oc=Adk-N2AvX6um_OTbfFxrArmvZpYgBSOQv25DFumQ5B7ove12CDYjI60lnXHTCqTUBs8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuZKN5OsUjKrUEbgTIecg2enLkeC4ukFnXh3lrKl1Le7Q&oe=69A1ABC0"}, {"file_name": "migrated_image.png", "id": "217163369341263", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12727849_1805928052952257_5353107934765121536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7126qKb_MnwQ7kNvwG-utdW&_nc_oc=Adnw31XDJbUry1yuvEvbr5Mga9sPemPqmbXQWOv931dTsazxSzT1ZdAu39LjY_AS_c8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afs4w7iVhitj50JYw8-Rs7DfUgVK7OeDxxTSmea3n1nIxw&oe=69A19F6F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Earth Origin", "keywords": ["Space", "Flight", "Combat", "Earth", "Battle"], "long_description": "Blast aliens, steer through winding tunnels, and explore the most dangerous corners of our solar system. This fast-paced space shooter puts you in the heat of the action, zipping past asteroids with enemies on your tail.\n\nShortly after our first contact with an alien species, a multitude of curious alien invaders from across the galaxy set course for our solar system, bringing with them war and destruction. As a new star in the Earth Alliance, your mission is to bring peace and safety back to our solar system, one planet at a time, starting at home: planet Earth.\n\nBegin with a few easy training missions and progress to harder campaigns, upgrading your ship with weapons and utilities along the way, and track your rank in the leaderboards. Each mission has a different goal, from protecting important structures and figuring out puzzles to destroying alien bosses.\n\nA swivel chair is required to allow 360\u00b0 rotations. Gamepad recommended.\n\nVisit earthoriginvr.com/hints for tips.", "short_description": "Blast aliens, steer through winding tunnels, and explore the most dangerous corners of our solar system. This fast-paced space shooter puts you in the heat of the action, zipping past asteroids with enemies on your tail."}]}, "developer_name": null, "developer_privacy_policy_url": "http://earthoriginvr.com/privacy-policy/", "developer_terms_of_service_url": "http://earthoriginvr.com/terms-of-service/", "publisher_name": "Cryofrog Inc.", "support_website_url": null, "website_url": "http://earthoriginvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "SHOOTER", "SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "478017913770019"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/12138943_916646121769711_503003776316080128_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKV6fOnZ4KYQ7kNvwGYVVsl&_nc_oc=AdnLbq2PoQ1A1287z72TfKJf
DQhIvxsQ7kNvwFHiVIQ&_nc_oc=AdpeFFuLbaYp5Dxs-n4vVydond_K8FryKuYkwTxHk9nWECysyD0AV-CgAb0fCOAjSGo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnMoJgCO7DxKwJIkofDv_my9lgFWqHK9VeAZW3HvhRHg&oe=6A6C8B5A"}, {"file_name": "migrated_image.png", "id": "555293135108000", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410453_200768527038499_4161114219313364992_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMCPG68bJ8oQ7kNvwGM5of_&_nc_oc=AdpETEmi4dkq8BbEpFF1_dv1x4sZomlCSjt_-RNWlKh6PzvjCONt2-8MytmVLubcExc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRcU-p5o8-uwxT6_81nveAl7a1U3IHYI1aUkhAom9Vvg&oe=6A6CA8D8"}, {"file_name": "migrated_image.png", "id": "516016999103139", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138845_609142182606583_4482711582207377408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiUEj38DnEcQ7kNvwHlu4-1&_nc_oc=AdoyYwZTPMUXXImjrAP4u8zMS9uiJcw-TuVXig-Usmxv2YBXxJj6l4LUTTXkxYLyCX0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsvQeD-oiuR_ZD4w_rFrU2QyqA8n_kWKWqoIOkBdV5ng&oe=6A6CB2C0"}, {"file_name": "migrated_image.png", "id": "217163369341263", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12727849_1805928052952257_5353107934765121536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNfQbunkObUQ7kNvwGzU3Cb&_nc_oc=AdpFBA0LoL0oxI-QkNnkLr9ifULm3E1qBJv2zKNFLpEMncfN4POexuDOcC4Id9Fl3O8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPYJM4haHf6D-eFHdlFGcYvsR0X6RKKlpqOG2BAM_OrQ&oe=6A6CA66F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Earth Origin", "keywords": ["Space", "Flight", "Combat", "Earth", "Battle"], "long_description": "Blast aliens, steer through winding tunnels, and explore the most dangerous corners of our solar system. This fast-paced space shooter puts you in the heat of the action, zipping past asteroids with enemies on your tail.\n\nShortly after our first contact with an alien species, a multitude of curious alien invaders from across the galaxy set course for our solar system, bringing with them war and destruction. As a new star in the Earth Alliance, your mission is to bring peace and safety back to our solar system, one planet at a time, starting at home: planet Earth.\n\nBegin with a few easy training missions and progress to harder campaigns, upgrading your ship with weapons and utilities along the way, and track your rank in the leaderboards. Each mission has a different goal, from protecting important structures and figuring out puzzles to destroying alien bosses.\n\nA swivel chair is required to allow 360\u00b0 rotations. Gamepad recommended.\n\nVisit earthoriginvr.com/hints for tips.", "short_description": "Blast aliens, steer through winding tunnels, and explore the most dangerous corners of our solar system. This fast-paced space shooter puts you in the heat of the action, zipping past asteroids with enemies on your tail."}]}, "developer_name": null, "developer_privacy_policy_url": "http://earthoriginvr.com/privacy-policy/", "developer_terms_of_service_url": "http://earthoriginvr.com/terms-of-service/", "publisher_name": "Cryofrog Inc.", "support_website_url": null, "website_url": "http://earthoriginvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "SHOOTER", "SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "478017913770019"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138943_9166
", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_1471180357945589_984879460779356239_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzVIDWOKJr0Q7kNvwGMkO5_&_nc_oc=Ado_0cTl_-rxWd7VRqpA20PMnCeH9MOj4EY86OINFEqMyuQ2uWsu5hc_mBOJq7CIcmY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVZu0gJPzw0anOjXqvHok1Bhx96x6LcO0vai7IbazoDcw&oe=6B0F07EF"}, {"file_name": "screenshot-5.png", "id": "1640254443653797", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819356_1640254450320463_7854810272428944501_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdAWdWCg8HkQ7kNvwEldvYS&_nc_oc=AdplJu41wW96rb3krVUNn7hQcPp3yfMynE7G335Ypyc6BDNJkRsh4E-ErRTlSEhETyk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUsrYoOe561hx0DDrcfZRBY3o_RsWTl7CcHhYhafQ0wYg&oe=6B0EEC12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image.png", "id": "946154301193864", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823366_946154304527197_8335039024854569259_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1s1KZ6tlAYMQ7kNvwFkuuOc&_nc_oc=AdrUbwkpoJjDjw7hALxWIg8_2GsX-flnnpPZdiC4nP-p-XTsOjEdGV3WVrbgs07DPtE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV6X0jGWjbRmWMhfvAlWYW5VoPZun5CBJUJXrtPrB4NFQ&oe=6B0F00BC"}, "display_name": "Lucidity Complex", "keywords": ["narrative", "therapy", "surreal", "story", "anxiety"], "long_description": "Lucidity Complex is a mind-bending, 30-minute VR interactive narrative.\n\nYou play as a troubled young man named Arden as he undergoes a new form of techno-therapy that allows him to explore rooms within his own subconscious, all while accompanied by a therapist. By interacting with objects of significance, you will unlock and witnesses Arden's memories, after which the therapist will help to contextualize and internalize what happened.\n\nTaking place in a dreamscape, the visual aesthetic is both striking and memorable while the experience itself plays with the ideas of logic, physics, and chronology. Rooms and memories go backwards in time, from recent memory all the way back to childhood, so you can see the ripple effects of traumatic events and conversations.\n\nThis is a moving story about the flawed nature of the human experience that emphasizes the value of therapy.", "short_description": "Lucidity Complex is a mind-bending, 30-minute VR interactive narrative. You play as a troubled young man named Arden as he undergoes a new form of techno-therapy that allows him to explore rooms within his own subconscious, all while accompanied by a therapist to witness and contextualize pivotal moments of Arden's past."}]}, "developer_name": null, "developer_privacy_policy_url": "https://buddhapunchstudios.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Buddha Punch Studios", "support_website_url": null, "website_url": "https://buddhapunchstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34038856935729579"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819859_4623122047907647_3206932056880546680_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phIKIZfRPGkQ7kNvwHMgR3r&_nc_oc=Ad
", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823812_1471180357945589_984879460779356239_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7FivdGe2aWMQ7kNvwHdt5P9&_nc_oc=Adrd4ktirZECWrTUS5t8jU2oAOiXRMxyLq4i8h6TeRbb_zme6K98hNBjot2XevWD30E&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRva7xcxY-e7DB9RC0RD3yo9kXbhR8Vq6nUdxkoCQXJGw&oe=6B09C1EF"}, {"file_name": "screenshot-5.png", "id": "1640254443653797", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819356_1640254450320463_7854810272428944501_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDBy5fLD6cgQ7kNvwEJ-SW0&_nc_oc=AdpX6Qc1U1Zh8P0JSAZDuVBlebCty9naN76mMe787dRR9m5VpZNwqCfWxVezdsVAGcA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTMzFpvq4VS9Les2-QFhH6AwzthCSXIho_paQ5xLQdyA&oe=6B09A612"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image.png", "id": "946154301193864", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823366_946154304527197_8335039024854569259_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-id302SI9cQ7kNvwFyzU6N&_nc_oc=AdphzXBmuo5Okjuk8eDwcB3mvi2vtTtuTccuFf_xZzAE7niVDC6iFWILcfP9FJgKEy4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJLEt2jagvrvk2OUlwYb1Cuplmw-E6ItGAeJ05JkTTDA&oe=6B09BABC"}, "display_name": "Lucidity Complex", "keywords": ["narrative", "therapy", "surreal", "story", "anxiety"], "long_description": "Lucidity Complex is a mind-bending, 30-minute VR interactive narrative.\n\nYou play as a troubled young man named Arden as he undergoes a new form of techno-therapy that allows him to explore rooms within his own subconscious, all while accompanied by a therapist. By interacting with objects of significance, you will unlock and witnesses Arden's memories, after which the therapist will help to contextualize and internalize what happened.\n\nTaking place in a dreamscape, the visual aesthetic is both striking and memorable while the experience itself plays with the ideas of logic, physics, and chronology. Rooms and memories go backwards in time, from recent memory all the way back to childhood, so you can see the ripple effects of traumatic events and conversations.\n\nThis is a moving story about the flawed nature of the human experience that emphasizes the value of therapy.", "short_description": "Lucidity Complex is a mind-bending, 30-minute VR interactive narrative. You play as a troubled young man named Arden as he undergoes a new form of techno-therapy that allows him to explore rooms within his own subconscious, all while accompanied by a therapist to witness and contextualize pivotal moments of Arden's past."}]}, "developer_name": null, "developer_privacy_policy_url": "https://buddhapunchstudios.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Buddha Punch Studios", "support_website_url": null, "website_url": "https://buddhapunchstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34038856935729579"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819859_4623122047907647_3206932056880546680_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCuR7cFbjhoQ7kNvwFiz1c4&_nc_oc=Ad
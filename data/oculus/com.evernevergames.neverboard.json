7a0a&_nc_ohc=abaw_Mx06mQQ7kNvwF0IozW&_nc_oc=AdkkBQF86-WnIERFMCVVrXT94SF8emUfZqdZjgxQU2SESi6hhmXR-VO3pl1GGHUR6RY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzOErC_AYUoaGpjnRbZ04_-NlcabgqHfxsBJpwoJmIADg&oe=69BBEA7C"}, {"file_name": "Neverboard_store_ss02.png", "id": "355520632694808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974526_355520636028141_8787938112571796621_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvXv8bFJbnYQ7kNvwF95ttW&_nc_oc=AdlOxvD0_XzJkEKFdRWDMACEm0d6_1Vn1MMUJhpqBw9FHafllGS1UPk3IDoi-ME3y_s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxUyJRSTa7t6gAjt1FwQJaZ7h1KdAtZyf4XPTqPSAyOTA&oe=69BBFC68"}, {"file_name": "Neverboard_store_ss04.png", "id": "225513486241486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974560_225513489574819_2855921463829190666_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SecOFTVucWsQ7kNvwFoW9VP&_nc_oc=AdnLLJEEagDBxm3aQCmAEAISZcGfMRW3k_vhHrsQsB3QLp-ANTAndE4toC617t_VlSA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxxYuFKaToFT9eKf3_qDoJFuH8Ckq4k1403yO3uM1d1Tw&oe=69BC010D"}, {"file_name": "Neverboard_store_ss05.png", "id": "254939093109883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974730_254939096443216_7373439405362586955_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pa0X3hbpe54Q7kNvwHAXIz1&_nc_oc=AdnLZ_hdzeAzW2CIvfDx1at2h_tYWEzd_7AooWaugmQxocRr5hmiJnpRAXIho4WgRdA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzUh389rKgHhhYYG2r3vcwFGE2NnRtoiMa3CpPbhhRhOg&oe=69BBEE93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Neverboard_store_trailercover.png", "id": "215030317207306", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974883_215030320540639_9034172187144613713_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hn0Trci1oSEQ7kNvwEv5z3J&_nc_oc=AdlgEzffG-D9k8hEJQycypOzRViL5e6MqlCztfmqktE_NhXKWvYPZrDFeRNFW7iS71E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyY6PTXoIBgGONF8wg4heazxv8wPbEZDm1kahwEqLWFYw&oe=69BBF440"}, "display_name": "Neverboard", "keywords": ["board", "tabletop", "cards", "social"], "long_description": "Join your Oculus friends to play board games in a whole new way! Filled with a growing list of easy to learn 2-4 player games and delightful interactions with something for everyone to discover. \n\n\u2022 Own any game and your Oculus friends can join and play for FREE!\n\u2022 100 FREE Coins available every 24 hours! Use it to try games or in-game concessions.\n\u2022 Play games from our library with no set up, clean up, or explaining rules.\n\nHost your next game night with your Oculus friends! Neverboard offers Crazy 8s free to play and you can also practice any game in the library with coins, so be sure to stock up on the FREE coins every day! Additional content and coins can be purchased in the game. Please note that public matchmaking is currently not available in Neverboard - you must have Oculus friends to play!\n\nStill have questions? FAQs, how-tos, and more are available on our website or by joining the Neverboard Player's Club on Discord.", "short_description": "Hang out and play board games with your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.evernevergames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Evernever Games", "support_website_url": null, "website_url": "https://www.evernevergames.com/neverboard", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_
7a0a&_nc_ohc=HWAHfBsWylMQ7kNvwF5BPOH&_nc_oc=AdkBOuBDatkkj7dmqUj0ZEHWYOJKhulr4WqFhdiB_Fwu6OlYoqg-nbvu0WWNI1hWHw0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aft5qeXXZdKGt5rQDso1ncauNDnXgPToyt4JyirIqj_q_g&oe=69A9757C"}, {"file_name": "Neverboard_store_ss02.png", "id": "355520632694808", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_355520636028141_8787938112571796621_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTN-DE2HKaoQ7kNvwHaAOQ1&_nc_oc=Adl4PMfF6Fmiwo7GLOEulGkBqCFHW3fRbMgsf0atczaMKSuQKtudbGxa4W8hAUGao2Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsWBnpBYb-q2oMu5C5eJDOetGaczS-8oyictxIZOrNezQ&oe=69A98768"}, {"file_name": "Neverboard_store_ss04.png", "id": "225513486241486", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974560_225513489574819_2855921463829190666_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uG7cyKaUiqoQ7kNvwFdkk3v&_nc_oc=Adno57cjxg5w4d3twCye1GLF8Lz9FwoNE6lOR8eD4bDQ4wmSYJfx6LofjqZ5A8C1nWQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuRHNX2Tz-H0RjJvFfvB2GB6i5PtP-zQMKwxyGs0QXTow&oe=69A98C0D"}, {"file_name": "Neverboard_store_ss05.png", "id": "254939093109883", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974730_254939096443216_7373439405362586955_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQLPHDnYL38Q7kNvwFIlk9_&_nc_oc=AdlT5q9mKcI1DjcmbhsVMs1yR_yoGu_rmKbHmViuCAk7endDIubChgXaYoQxbb5vYMI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuDvTSjceXBWKRh-SJ4S4TdeQyK8Ru2vpkgpWJvRMyGlQ&oe=69A97993"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Neverboard_store_trailercover.png", "id": "215030317207306", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974883_215030320540639_9034172187144613713_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGkMUsuzgScQ7kNvwEzE1rC&_nc_oc=AdlVjAPm8wKe1--FnPIN_Xc4y8ygJjcdG1clIa_YslRWatNtGtuRa9tmLs0LrB8uvcQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvPWo9iexEIFuYuGBy9xQeObCvq5m66z-74tJ_fYY1ouQ&oe=69A97F40"}, "display_name": "Neverboard", "keywords": ["board", "tabletop", "cards", "social"], "long_description": "Join your Oculus friends to play board games in a whole new way! Filled with a growing list of easy to learn 2-4 player games and delightful interactions with something for everyone to discover. \n\n\u2022 Own any game and your Oculus friends can join and play for FREE!\n\u2022 100 FREE Coins available every 24 hours! Use it to try games or in-game concessions.\n\u2022 Play games from our library with no set up, clean up, or explaining rules.\n\nHost your next game night with your Oculus friends! Neverboard offers Crazy 8s free to play and you can also practice any game in the library with coins, so be sure to stock up on the FREE coins every day! Additional content and coins can be purchased in the game. Please note that public matchmaking is currently not available in Neverboard - you must have Oculus friends to play!\n\nStill have questions? FAQs, how-tos, and more are available on our website or by joining the Neverboard Player's Club on Discord.", "short_description": "Hang out and play board games with your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.evernevergames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Evernever Games", "support_website_url": null, "website_url": "https://www.evernevergames.com/neverboard", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_
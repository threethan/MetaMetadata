8_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3qrbd51itUQ7kNvwEqSRNM&_nc_oc=Adq2XwTSIl5LE35Bd9PnnHzHaJNrb68ONUOcg2EhN22OE9M6gdkG8VcY2wyye-lx2Y8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9f1odkwA6_-lWzXl-s0FtC_tunYIg1ATgaCG-QEZwd0Q&oe=6A4657FC"}, {"file_name": "Neverboard_store_ss02.png", "id": "355520632694808", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974526_355520636028141_8787938112571796621_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lB2M9oOLMYgQ7kNvwHbTH8y&_nc_oc=Adq6FGVTKSWQ30GNzbrDQcBK3oRZdtiVmF7AA2zCNcR7o-xwUee10STBRx8SjuW5Dpo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dv9s9jUnDRkZpJTbRzwkzFUdi7x-K6xIEG-gwslqb8Q&oe=6A4669E8"}, {"file_name": "Neverboard_store_ss04.png", "id": "225513486241486", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974560_225513489574819_2855921463829190666_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1uk1-Lb430Q7kNvwFC4Xc3&_nc_oc=AdpbIzoNhitfpZ6-sqMkFf1OFi_9C-bBBSnC-pdIZsRbDU1vGwnHUt2SHbiw-o79XWw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WnnR0oOEqwsImlE7tKk6H1mU3cthNwUGEOFTXhgyDHQ&oe=6A466E8D"}, {"file_name": "Neverboard_store_ss05.png", "id": "254939093109883", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974730_254939096443216_7373439405362586955_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EME5pz0pfDwQ7kNvwEk8Y4S&_nc_oc=Adq3YSGGcZfwMEGU2VhtauFeH4VpSfYF_VZwdxGvzjYR0iCwXgv7zvMCMFeff-q4fb8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8f2EqQhiU649cZP12TyT2HZudRSwNLZnPuBesAPXHk2w&oe=6A465C13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Neverboard_store_trailercover.png", "id": "215030317207306", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974883_215030320540639_9034172187144613713_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lv4Us7nYbUUQ7kNvwHaHbMX&_nc_oc=AdpzCBjhEkdMNv8ntA_HjqO9p44odVVk4Mg2VVZPrVrYOmi16PS0R-Etqh3mBbMusqs&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3MyvqB_CGhCFIlWt_51HFFWKE8WxpYBjICNTpzR02EQ&oe=6A4661C0"}, "display_name": "Neverboard", "keywords": ["board", "tabletop", "cards", "social"], "long_description": "Join your Oculus friends to play board games in a whole new way! Filled with a growing list of easy to learn 2-4 player games and delightful interactions with something for everyone to discover. \n\n\u2022 Own any game and your Oculus friends can join and play for FREE!\n\u2022 100 FREE Coins available every 24 hours! Use it to try games or in-game concessions.\n\u2022 Play games from our library with no set up, clean up, or explaining rules.\n\nHost your next game night with your Oculus friends! Neverboard offers Crazy 8s free to play and you can also practice any game in the library with coins, so be sure to stock up on the FREE coins every day! Additional content and coins can be purchased in the game. Please note that public matchmaking is currently not available in Neverboard - you must have Oculus friends to play!\n\nStill have questions? FAQs, how-tos, and more are available on our website or by joining the Neverboard Player's Club on Discord.", "short_description": "Hang out and play board games with your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.evernevergames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Evernever Games", "support_website_url": null, "website_url": "https://www.evernevergames.com/neverboard", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb
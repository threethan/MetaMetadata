7a0a&_nc_ohc=srQyE7N_8REQ7kNvwEl36fZ&_nc_oc=Adn7uDAWny5CjuMkCDq7oaSi5gKS4ZlD62xcWJVxwqFPhNEAlo0JcslqqM17pD_UpfA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwmDU9stwz-_Djuftd92M36LYxBWdoNNeRixErSxu2yeg&oe=69B6A47C"}, {"file_name": "Neverboard_store_ss02.png", "id": "355520632694808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974526_355520636028141_8787938112571796621_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWGiMfWg_BkQ7kNvwGi87b0&_nc_oc=AdkmiU7FaHXMp2jLi74KgAZRajKtD7pVwM3erjNIXWqwv-_G9dWkXJl8PYTvykCabS4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfznppaC9ZRPXCfhKUc_CkD0pIpCOeE7OgvTuanPAwiCcQ&oe=69B6B668"}, {"file_name": "Neverboard_store_ss04.png", "id": "225513486241486", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974560_225513489574819_2855921463829190666_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHrbIcrI4-4Q7kNvwGHwk5s&_nc_oc=Adnslt35elvnm-BiRIyaWnYzmbmBRH49UWLZYIXNYvNX5t8lrvMrDig-LsJUOd2Qp3Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwUhI3pe15RIJZeOmx8B62t20MKJDDohVlkoEDqvhOW8w&oe=69B6BB0D"}, {"file_name": "Neverboard_store_ss05.png", "id": "254939093109883", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974730_254939096443216_7373439405362586955_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04GV85isBeQQ7kNvwFF5p0g&_nc_oc=Adn-XqYLIqpXw-uh4kpL1b-HVyQq4mx-VcWilW2i0VY35HMBMABgCjVx-dhu7oma12I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyksCm0WdMjjWQ3qWQc7wZnsds-yxckqzY-yG50Mmr89A&oe=69B6A893"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Neverboard_store_trailercover.png", "id": "215030317207306", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974883_215030320540639_9034172187144613713_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ilRpgFT8BQQ7kNvwEQcJeI&_nc_oc=AdmPJDIBnE49qMu_906y2iVgXzA_IVFHunWhdcovOVWVkOmGDYcAw7uuBhIgYGiahkQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwyrg31kJ7Ty9Ec8kX-tVSEy97NflOD6tp6ATov-KNbLA&oe=69B6AE40"}, "display_name": "Neverboard", "keywords": ["board", "tabletop", "cards", "social"], "long_description": "Join your Oculus friends to play board games in a whole new way! Filled with a growing list of easy to learn 2-4 player games and delightful interactions with something for everyone to discover. \n\n\u2022 Own any game and your Oculus friends can join and play for FREE!\n\u2022 100 FREE Coins available every 24 hours! Use it to try games or in-game concessions.\n\u2022 Play games from our library with no set up, clean up, or explaining rules.\n\nHost your next game night with your Oculus friends! Neverboard offers Crazy 8s free to play and you can also practice any game in the library with coins, so be sure to stock up on the FREE coins every day! Additional content and coins can be purchased in the game. Please note that public matchmaking is currently not available in Neverboard - you must have Oculus friends to play!\n\nStill have questions? FAQs, how-tos, and more are available on our website or by joining the Neverboard Player's Club on Discord.", "short_description": "Hang out and play board games with your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.evernevergames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Evernever Games", "support_website_url": null, "website_url": "https://www.evernevergames.com/neverboard", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_
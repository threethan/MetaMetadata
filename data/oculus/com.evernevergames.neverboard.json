xBvB2UcCn7WKRp8z5yRAS8-xbsU3n2oj6hs1hHY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuPU33lsajfBGbK9G_fMCRQZEmaIHM1VSJ3AGOpD6GTXw&oe=699C467C"}, {"file_name": "Neverboard_store_ss02.png", "id": "355520632694808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974526_355520636028141_8787938112571796621_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sC1jSSuJi6AQ7kNvwHfxyQB&_nc_oc=Adndd9oAEdszISG2wxzwaEaIsus0RGMyX3sWjQ6XmK_qBTb5t4goj46-8PiKlOuhZaE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfugWkWoVjdP_npi7vyPI6mco36htWhI6sERxNZV_04Gcw&oe=699C5868"}, {"file_name": "Neverboard_store_ss04.png", "id": "225513486241486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974560_225513489574819_2855921463829190666_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HoQiLOe5BMYQ7kNvwHT2zc3&_nc_oc=AdlJrwWyS8M2v3NjR6qo2wuBfrOwN7lehj-6RwRHwB1N96CTiS2qPntCnXry1IXPSRE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft_-IE9eFPUajW3p-MDo6u-FbNK2-5urSUSzXDEn5p6qw&oe=699C5D0D"}, {"file_name": "Neverboard_store_ss05.png", "id": "254939093109883", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974730_254939096443216_7373439405362586955_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmW9119869MQ7kNvwEdHIjY&_nc_oc=Adl-5ryzVqaABPX3C1XB8lPOjFCJjAEIwwj1_VX3zC2tKHssZrZ5tqcDd-bSYFVMIgc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsc55szdKQehNrqE0srCFpJPfZUDWiVeZPzqxPXKe6V8w&oe=699C4A93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Neverboard_store_trailercover.png", "id": "215030317207306", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974883_215030320540639_9034172187144613713_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dp3hgug2tR0Q7kNvwECyom4&_nc_oc=AdkGcgMxVGlAGGvIFdeOxHAKEMRhE1YwDDnjpe5ujK89hv7Oz5eAp8V980_PJzTSy_E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvDKlinrMOpSB0ieQqJ225BQfAMUvKhcNyUVmZsWjzjTg&oe=699C5040"}, "display_name": "Neverboard", "keywords": ["board", "tabletop", "cards", "social"], "long_description": "Join your Oculus friends to play board games in a whole new way! Filled with a growing list of easy to learn 2-4 player games and delightful interactions with something for everyone to discover. \n\n\u2022 Own any game and your Oculus friends can join and play for FREE!\n\u2022 100 FREE Coins available every 24 hours! Use it to try games or in-game concessions.\n\u2022 Play games from our library with no set up, clean up, or explaining rules.\n\nHost your next game night with your Oculus friends! Neverboard offers Crazy 8s free to play and you can also practice any game in the library with coins, so be sure to stock up on the FREE coins every day! Additional content and coins can be purchased in the game. Please note that public matchmaking is currently not available in Neverboard - you must have Oculus friends to play!\n\nStill have questions? FAQs, how-tos, and more are available on our website or by joining the Neverboard Player's Club on Discord.", "short_description": "Hang out and play board games with your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.evernevergames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Evernever Games", "support_website_url": null, "website_url": "https://www.evernevergames.com/neverboard", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "
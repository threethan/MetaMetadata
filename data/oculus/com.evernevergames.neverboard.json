YxQuI65XBHTSdjcl5A00aGXgk_wx7KUmzZPQvvA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1v65n6FGcyDPFd6zDpU-Br3trnfxT42r13wS3lOuzUYA&oe=69F0A67C"}, {"file_name": "Neverboard_store_ss02.png", "id": "355520632694808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974526_355520636028141_8787938112571796621_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOKmpDWblJsQ7kNvwH0S7dM&_nc_oc=AdqoxxHiX0krzlZpSvp4UgUoNBttrH9evzQ3ReZOq4DmS-FHNjYd8187k8lvUUr4gEw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3wSKk_PIG0Flym9xl3bww8X5ArKbuj0eW2XsbZ6MDRRg&oe=69F0B868"}, {"file_name": "Neverboard_store_ss04.png", "id": "225513486241486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974560_225513489574819_2855921463829190666_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gghh2iARnC0Q7kNvwHWOaMM&_nc_oc=AdpbJBAeiSLbUKb-SYcZISK0rcAjojvc74rXriMV00lTJZjlnhohKFdUpyGBMI4iz-I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1X3GTMDgU5-VpS3_A5SBHKR6Ew8RGCQxwd2vG5dZoejA&oe=69F0BD0D"}, {"file_name": "Neverboard_store_ss05.png", "id": "254939093109883", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974730_254939096443216_7373439405362586955_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIe28EsALeEQ7kNvwGwZNnn&_nc_oc=AdrLFUaQOh8GLwRiyuuBkOS69R9rXbdG-P-Fwq5jOK5yfy9vsmkc2ElziBz1ghT9VyY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1YF592zXn99LpYuFWDDa_3zpN5J6RJJAV9jN1X2SC0AQ&oe=69F0AA93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Neverboard_store_trailercover.png", "id": "215030317207306", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974883_215030320540639_9034172187144613713_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2B2ONPUWaj8Q7kNvwHSHPWc&_nc_oc=AdrvqqXl9HCDrnTNH1oWm6PwqO9VTvQ1ci2_xN91V-QlaU55tVN8opzjamQtaXhA6Ro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1nc_fIpvO-KJndcrm_QOMYepQfRuhHlpAa30wqyZG0mg&oe=69F0B040"}, "display_name": "Neverboard", "keywords": ["board", "tabletop", "cards", "social"], "long_description": "Join your Oculus friends to play board games in a whole new way! Filled with a growing list of easy to learn 2-4 player games and delightful interactions with something for everyone to discover. \n\n\u2022 Own any game and your Oculus friends can join and play for FREE!\n\u2022 100 FREE Coins available every 24 hours! Use it to try games or in-game concessions.\n\u2022 Play games from our library with no set up, clean up, or explaining rules.\n\nHost your next game night with your Oculus friends! Neverboard offers Crazy 8s free to play and you can also practice any game in the library with coins, so be sure to stock up on the FREE coins every day! Additional content and coins can be purchased in the game. Please note that public matchmaking is currently not available in Neverboard - you must have Oculus friends to play!\n\nStill have questions? FAQs, how-tos, and more are available on our website or by joining the Neverboard Player's Club on Discord.", "short_description": "Hang out and play board games with your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.evernevergames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Evernever Games", "support_website_url": null, "website_url": "https://www.evernevergames.com/neverboard", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "
_ohc=44KoMAoF1IwQ7kNvwFgVFtV&_nc_oc=AdowR3PdS9n8SCLK7Q_6Npc1C0OB7MoJAZ3WgSXnUwn0Eu60-tyix5mXR_9hSqAsPJU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIHiQNWxhccC4NzMyVcG3blokxAFVEpv8JhqqwSw4eDg&oe=6A6F5311"}, {"file_name": "sc-2.png", "id": "798593488293358", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982468_798593491626691_4000679900781327174_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipxCcUFivJIQ7kNvwHTD-2Y&_nc_oc=Adqqetvnk536hirzv9yFFQcl-S-fQIYntUFtr7lbXBs4G4o4gUQ08YnUXpO1RqO0eDw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPXQdx23TpVYfPgYhmHJmXW61urXtVlqqj-c887Dw0Ig&oe=6A6F3609"}, {"file_name": "sc-5.png", "id": "782892266579619", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974672_782892269912952_1367021943691056169_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZ5YiKdn840Q7kNvwHqiLin&_nc_oc=AdoutHmSOW_BrdnLBIvDx_wn2rQG0nGl2Zr-5gS46TFudBlMM-iNMDJArYqv8WmvCLI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8sadLXNXNFKZ3Y6a_7s0gWlAqMu7MFLkUcjrwLh44BQ&oe=6A6F3A92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8-cover.png", "id": "1237940290182617", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974497_1237940293515950_8379298951291711086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kfmh2NGDrdIQ7kNvwHs96nH&_nc_oc=AdoAgD597RVFlYZ1aRBNniyLgZyQ5OnqN0iZJnjVywkqiJB2z4uuHqYDbo-FsNIT4GE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRPwARQDEmC8GfjyPEB9Hximob0GfCh7etnXKW6alCuw&oe=6A6F3147"}, "display_name": "Retropolis 2: Never Say Goodbye", "keywords": [], "long_description": "*** Now available for early access! Grab the first episode and secure a season pass to all four thrilling episodes releasing later this year. Dive into the adventure today and become part of the Retropolis legend! ***\n\nThe story of Retropolis 2: Never Say Goodbye is set a year after the events depicted in The Secret of Retropolis, and continues the story of Philip Log, the hard-boiled robo-detective, and Jenny Montage, the automated femme fatale that just can\u2019t keep herself out of trouble. Nonetheless, Retropolis 2: Never Say Goodbye welcomes new visitors to the city of robots, and can be experienced as its own miniseries. \n\nThe Retropolis series is a user-friendly VR experience built from the ground up to support effortless VR interaction. Using Philip Log\u2019s extendo-arms, the player is able to collect items from afar, use them to overcome obstacles, and move the plot forward. On top of the first game\u2019s mechanics, Retropolis 2: Never Say Goodbye features enchanted logic puzzles, new rotation mechanics, and movement between different environments, offering a more challenging adventure with a substantially longer playtime.\n\nEven though set in a post-apocalyptic cityscape inhabited only by robots, all 3D assets in Retropolis 2: Never Say Goodbye were hand painted by living and breathing human beings, making each environment a stunningly detailed piece of art. With improved graphics and character animation, returning to Retropolis is more jaw dropping than ever.\n", "short_description": "***Early Access Available Now*** The critically acclaimed VR adventure series is back! Get lost in a sci-fi mystery spanning over four all-new episodes. Engage a battle of the minds with a sick new villain and use only your wit, your hovering inventory, and a pair of extendo-arms to uncover the truth."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.peanutbutton.net/privacy-policy-retropolis2", "developer_terms_of_service_url": "https://peanutbutton.net/terms", "publisher_name": "Peanut Button", "support_website_url": "http://peanutbutton.net/", "website_url": "http://peanutbutton.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269189016
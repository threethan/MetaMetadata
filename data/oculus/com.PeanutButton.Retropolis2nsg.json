_ohc=n9khindLJSAQ7kNvwHO6eGw&_nc_oc=AdrCx5p4bhjKRIBYliUW6NHNiLYp_FbOII0RAgKL5RM0Xcn42x8O1cVnq9IOMO7E5jA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5-q1FUioAXo7pzw_Ghf15uZlQ7eUP_ic0MdBkKQllew&oe=6A5F8111"}, {"file_name": "sc-2.png", "id": "798593488293358", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982468_798593491626691_4000679900781327174_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTpzsFaBqHMQ7kNvwEUfn05&_nc_oc=AdoeODkTljC2Rtkn9fhs76Z8x-DvQ5cS1eGpesko2dKUtxTpZ1n8roIQmw_yqtBw_jc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKYauBeLCbDw1QpNrvL0YF-vfocOM9EMT08Az78H6J8g&oe=6A5F6409"}, {"file_name": "sc-5.png", "id": "782892266579619", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974672_782892269912952_1367021943691056169_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HODhLpf7_PMQ7kNvwFLB_MJ&_nc_oc=Adqw41msYXLY-pO6QINDrpj-WaBGkQWpcUqKg7eP47GovT2RssKSKKzuTW03WR_oYL0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiBAxJCPvndeW4LwP8D7r-TskPZ0pxTSiNFUWA7RXRYw&oe=6A5F6892"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8-cover.png", "id": "1237940290182617", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_1237940293515950_8379298951291711086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQqp3TGmErEQ7kNvwEgExVQ&_nc_oc=AdrfTK6pbWWGs-_d7p2h20DWF8YNhttII61I0kzFyClXxRmH_31cQgSd6XhQyLJny0I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAMTPMZEc6WXnBJBmke0JXkCI87EanTXWJOpHkJ_CWnA&oe=6A5F5F47"}, "display_name": "Retropolis 2: Never Say Goodbye", "keywords": [], "long_description": "*** Now available for early access! Grab the first episode and secure a season pass to all four thrilling episodes releasing later this year. Dive into the adventure today and become part of the Retropolis legend! ***\n\nThe story of Retropolis 2: Never Say Goodbye is set a year after the events depicted in The Secret of Retropolis, and continues the story of Philip Log, the hard-boiled robo-detective, and Jenny Montage, the automated femme fatale that just can\u2019t keep herself out of trouble. Nonetheless, Retropolis 2: Never Say Goodbye welcomes new visitors to the city of robots, and can be experienced as its own miniseries. \n\nThe Retropolis series is a user-friendly VR experience built from the ground up to support effortless VR interaction. Using Philip Log\u2019s extendo-arms, the player is able to collect items from afar, use them to overcome obstacles, and move the plot forward. On top of the first game\u2019s mechanics, Retropolis 2: Never Say Goodbye features enchanted logic puzzles, new rotation mechanics, and movement between different environments, offering a more challenging adventure with a substantially longer playtime.\n\nEven though set in a post-apocalyptic cityscape inhabited only by robots, all 3D assets in Retropolis 2: Never Say Goodbye were hand painted by living and breathing human beings, making each environment a stunningly detailed piece of art. With improved graphics and character animation, returning to Retropolis is more jaw dropping than ever.\n", "short_description": "***Early Access Available Now*** The critically acclaimed VR adventure series is back! Get lost in a sci-fi mystery spanning over four all-new episodes. Engage a battle of the minds with a sick new villain and use only your wit, your hovering inventory, and a pair of extendo-arms to uncover the truth."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.peanutbutton.net/privacy-policy-retropolis2", "developer_terms_of_service_url": "https://peanutbutton.net/terms", "publisher_name": "Peanut Button", "support_website_url": "http://peanutbutton.net/", "website_url": "http://peanutbutton.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269189016
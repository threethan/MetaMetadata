&_nc_ohc=N4--SJdurJUQ7kNvwFUWJy5&_nc_oc=AdoJ6rRTFFFB2GM-j-Y5kN-apq7GaSz_ChaWTpwcwGQ-mrqx1h4Mu_277A1bQT48WWQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS_przwTji455Hwi_Cy3CCeou-dHAtkceUbXwNcWbn1Pg&oe=6B0C644C"}, {"file_name": "10_passthrough_kitchen_build.png", "id": "1606988198110302", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622153_1606988201443635_3572002927217900596_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OnuCbuXBigQ7kNvwFvBBSR&_nc_oc=Ado7CJbwb6HSXZdep9eG1_TooYjjlRnAMFtQD4oKAQMcO_g1WWR9es7tPRCLbRfb6sU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRTvNxBCbiYxr_36nkdouHQYjrpNOhdxeJxiuqddHxJ-A&oe=6B0C827A"}, {"file_name": "03_synthwave_clear_sparks.png", "id": "1616644436599574", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623179_1616644439932907_1883521344907197868_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4730X1VfNSQQ7kNvwE0YaYo&_nc_oc=Adrl2pSPTB6YDxg-qUX0TgzlnzGRfToZjFB74a3Jv_6_tbmFHjNnESxytLpAKDQKElI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSe1SrcWp0Ov4CpjntEJvbSkdSpNNg2oy9H13PHUFnvhQ&oe=6B0C57FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Quest_title_page_graphic_3f23a2d9_2K.png", "id": "1700291118180531", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593723055_1700291121513864_6001813877996049397_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSWEjTnf_7kQ7kNvwHig-HC&_nc_oc=AdovP3lUq8klbSARa4tODceI_t8QXiXY0WUibSrLSUbDhuQb6DEYKtHxbVU_dwIXfK4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQofJvoGeA1kjBuDupa-b9aptVNTh1uY5_UALj3AwQRAA&oe=6B0C7427"}, "display_name": "RecubedVR", "keywords": ["puzzle", "blocks", "cubes", "passthrough", "arcade"], "long_description": "RecubedVR is a tactile 3D block puzzle made for mixed reality. A target shape spins up as a hologram and the countdown starts. Grab pieces from the floating dispensers, turn them in your hand and snap them into the grid. Build the shape anywhere on the grid, in any orientation, and it clears.\n\nCLEAN OR FAST? EVERY CLEAR IS YOUR CALL\nSloppy fits are allowed, but any cubes hanging outside the target freeze into grey debris that stays on the board. Debris gets in your way, or gives you a head start, because it counts toward the next target. Nail a perfect fit with zero overhang and the whole board is wiped clean, your combo multiplier climbs, and every third perfect in a row wins back a lost life.\n\nFEATURES\n\u2022 27 target shapes across 5 tiers, from simple boxes to hollow frames, castles, spiral stairs and mirror-image twists\n\u2022 Time Attack with 3 lives: run out of time and you lose one, lose them all and it's game over\n\u2022 Perfect-clear combos, debris-reuse bonuses and a saved high score to chase\n\u2022 Short three-target levels, each ending in a satisfying finale and a breather\n\u2022 Mixed reality passthrough by default, with a full VR mode\n\u2022 Play with hand tracking or Touch controllers\n\u2022 Built for comfort: play seated or standing, with no locomotion and no falling pieces to catch", "short_description": "Build 3D target shapes from chunky block pieces before the clock runs out. Grab pieces, twist them in your hand and snap them into a floating grid in your room. Nail a perfect fit and the whole board wipes clean. Get sloppy and the leftover cubes freeze into debris you'll have to build around, or build on. A hands-on mixed reality puzzle game for hand tracking or Touch controllers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1erlgi4H70wBQ6tAAt0efr6D-SDKBOUwvcdTNZq2uEk8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Eyemobi", "support_website_url": null, "website_url": "https://www.eyemobi.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_c
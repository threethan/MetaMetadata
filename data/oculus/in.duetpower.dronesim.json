e": "SCREEN-2-himalayan-valley.png", "id": "1021973277599431", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628446_1021973280932764_1280454174385628541_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74B8tJLJB9wQ7kNvwGqJvSe&_nc_oc=AdotsclMQAuaIQ7OBRgLVFNVlzux6PL5_JE6aDbMsscbDNElzAvLnj_fkJr-3I3tviM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQEe1Pb2IhUAEGtHzBNCHfJEWNXLx-OwTLu2ezn2DN8RQ&oe=6B0DB7BF"}, {"file_name": "SCREEN-4-village.png", "id": "3708193265995808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499313074_3708193275995807_2059811878620554961_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5mA9GRVsC0Q7kNvwF-86Z2&_nc_oc=Adp5ggbASrTtkxcP8YFicRM_s7uBq_YN0dns6o2wuCOljmvlnb2y3-VhyuHc-7kvkvU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTqaAfCUtT2mYM8i0RlfZIdI5NB3rx0wOyA6KDyPXmnyA&oe=6B0DB44F"}, {"file_name": "SCREEN-5-valley-pad.png", "id": "1457047099874962", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673652249_1457047103208295_7766426614565733180_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5a5Q7djBahMQ7kNvwF_OMzn&_nc_oc=Adqqkl5ULHwfpZ_dEBdeF4hmK3b36ubYc45fDgObuJb1ELNHR--hOH6IQ-DBaVYfM3Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQgZN6XAU1eNlXOxiWbD28M2huJyjC00o-kKScSod0jTQ&oe=6B0DC713"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DUET Drone Simulator", "keywords": ["drone", "simulator", "education", "STEM"], "long_description": "DUET Drone Simulator teaches students to fly drones the way real ones fly, without the cost or risk of crashing a real aircraft.\n\n- Three aircraft: a camera drone with GPS hold, auto take-off, landing and return home; a 5-inch FPV racer with Angle, Horizon and Acro modes; and a tiny indoor whoop.\n- Real physics: motor spin-up, thrust, battery voltage sag, wind and gusts, ground effect, and crashes into trees, wires and buildings.\n- Radio link that weakens with distance and is blocked by hills and buildings, with video breaking up like the real thing.\n- Three large maps: a village with fields and a race track, a solar park with a substation and power lines, and a Himalayan valley.\n- Missions: free flight, racing against your own ghost, training lessons, solar panel inspection, and search and rescue up the valley.\n- Fly in VR standing in the field, or in mixed reality with the drone flying in your own room.\n- Camera screen, FPV view, chase and line-of-sight views, photos, video and replays.\n- Works offline after the first launch.\n\nFor schools: full access comes with a DUET STEM school subscription code. Without a code, a free 10-minute demo is available every day.", "short_description": "Learn to fly drones safely in a realistic simulator: real flight physics, wind, battery and radio range, a camera drone with GPS, an FPV racer and missions over a village, a solar park and a Himalayan valley."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ashutoshduet.github.io/duet-lms-media/drone/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "DUET Power", "support_website_url": null, "website_url": "https://ashutoshduet.github.io/duet-lms-media/drone/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes
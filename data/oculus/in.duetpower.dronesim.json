e7a0a&_nc_ohc=lqw2ylVQOoIQ7kNvwH-Sum9&_nc_oc=AdrTFHJ9T0D6kd6YBjYUqh63oCt-vb-UXk17GqhrA6LR7QVkLiOMzg7fOu0pLRdzI1s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUX6q-pop_Vy4hM8sbq-Z-SUS_CuA1YKQrPf9ofcaCg1w&oe=6B0F0BD4"}, {"file_name": "SCREEN-2-himalayan-valley.png", "id": "1021973277599431", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628446_1021973280932764_1280454174385628541_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74B8tJLJB9wQ7kNvwGssofV&_nc_oc=Adq0KwkUrg61v7WEsI9ih7qH63t5SgyjMzanuNA-Fm284Jy-B7DigfHfvQbNHH5npFo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVQJ6wgZHe27uk-RdH8duBwa5WM_H75aIrMlwNUcZh5pQ&oe=6B0F093F"}, {"file_name": "SCREEN-4-village.png", "id": "3708193265995808", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313074_3708193275995807_2059811878620554961_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUi7yGCQfI8Q7kNvwHLwXKE&_nc_oc=AdrtISQiqWBefhO_zd_Bw51UXbBl4qReWiaoZyriGWjTlhXpu4-m9USsr5Gj5RPULSk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVVo1Dr5dbbZWshi0GYvR-lKAgqfIljZdt_qAffmM11eQ&oe=6B0F05CF"}, {"file_name": "SCREEN-5-valley-pad.png", "id": "1457047099874962", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673652249_1457047103208295_7766426614565733180_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5a5Q7djBahMQ7kNvwEQ0v_D&_nc_oc=AdqQXiHF0ix8yt45XGFIE5PMjdqO_kfw8VIf4F8zD6DbOdPMYbMJmh7FpvuQY4BCets&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVbJuuiK_1x4kqlUvXMdG8bMSPs5ESdPikRcZognfY2cg&oe=6B0F1893"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DUET Drone Simulator", "keywords": ["drone", "simulator", "education", "STEM"], "long_description": "DUET Drone Simulator teaches students to fly drones the way real ones fly, without the cost or risk of crashing a real aircraft.\n\n- Three aircraft: a camera drone with GPS hold, auto take-off, landing and return home; a 5-inch FPV racer with Angle, Horizon and Acro modes; and a tiny indoor whoop.\n- Real physics: motor spin-up, thrust, battery voltage sag, wind and gusts, ground effect, and crashes into trees, wires and buildings.\n- Radio link that weakens with distance and is blocked by hills and buildings, with video breaking up like the real thing.\n- Three large maps: a village with fields and a race track, a solar park with a substation and power lines, and a Himalayan valley.\n- Missions: free flight, racing against your own ghost, training lessons, solar panel inspection, and search and rescue up the valley.\n- Fly in VR standing in the field, or in mixed reality with the drone flying in your own room.\n- Camera screen, FPV view, chase and line-of-sight views, photos, video and replays.\n- Works offline after the first launch.\n\nFor schools: full access comes with a DUET STEM school subscription code. Without a code, a free 10-minute demo is available every day.", "short_description": "Learn to fly drones safely in a realistic simulator: real flight physics, wind, battery and radio range, a camera drone with GPS, an FPV racer and missions over a village, a solar park and a Himalayan valley."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ashutoshduet.github.io/duet-lms-media/drone/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "DUET Power", "support_website_url": null, "website_url": "https://ashutoshduet.github.io/duet-lms-media/drone/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended
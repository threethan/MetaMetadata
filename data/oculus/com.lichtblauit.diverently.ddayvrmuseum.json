ps://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491820923_895426869928945_5093900726720406846_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_bx9Hw4rhEQ7kNvwHtR8BA&_nc_oc=Adp7zlnXRyhcrpR4hiY3gKMxB7gmSAPZHnVOrkQebfKC-RL03uDCG4Bg-t42s22KRrY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSNsu7iggutMxv37G0K0ombqOUz7BQVnNdXEvyuCPI3g&oe=6A8D6779"}]}, "id": "990822340137336", "locale": "en_US", "screenshots": [{"file_name": "2024-09-04T21:06:34.png", "id": "1438399731071005", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491828050_1438399734404338_1019183305337512234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDVApVaAoXcQ7kNvwF4kreq&_nc_oc=AdpiUPrwc10yQJ6gJU8okUN_r0MDRA9dNom6AUif5vGj9HmhP8Q0MXsFpaQrNRCXdG4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1s2nINy_qC0eefLyWMDjkHb6vSpD6z0ffx7cHyWky0A&oe=6A8D8464"}, {"file_name": "2026-01-08T10:03:19.png", "id": "1479341297047782", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823783_1479341300381115_129236614142501265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xKlTWSvkX0Q7kNvwFYplu7&_nc_oc=AdqbL3mHuHvhqbJp-OKbO-YM70KqW1oIP88MO4mbQGj7Cx2XMnESyUV-dbYDS9D8XWE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIlJZYBsYzHSp8YiW0kJ41l5Z-d51YMiGsBIJOMstI-Q&oe=6A8D78F2"}, {"file_name": "2026-01-08T10:14:18.png", "id": "1734123057549823", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823286_1734123060883156_8912451276853786625_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJVDRkCFcfoQ7kNvwFvRR9d&_nc_oc=AdqqHNTfyv-jynKJ0ei5ajGbwYuxqPn4YXNSWtKGni3r_assYQQ0Rf5wKnNVAQ0a9fo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEq4MxsJhpuBU2YLEOB9shVnU38QwV0xv-Iu3C4MxjVXw&oe=6A8D7BC4"}, {"file_name": "2025-12-05T10:09:08.png", "id": "1457506652537455", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491821719_1457506659204121_5331531040026850805_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lIntg3z1UgQ7kNvwFbOBNb&_nc_oc=Adp4zpYq4PeZ21lzc1rJ_P5P5XTWxIWj_bluNkt821N5sY9l4_pUPKCnnp29BOYunQA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGb-nNeMQjC8caa_9ZQnV5icmXqyrD8jcnkGcMmafP52Q&oe=6A8D8E64"}, {"file_name": "2026-02-16T13:45:42.png", "id": "26883705317882968", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491820923_26883705327882967_6771895506510023126_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOl5LsIOOJAQ7kNvwERZTDr&_nc_oc=AdqGV9ux_sTXt_lgn-bvJb786_5GYTETDct5GoDkG0Qt9HM4S6zX-2z9gBJryzWwgkk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHz8oN2YDrMvUPQwOON1RDXzEj5iO3-PDD-XPHiQqidCw&oe=6A8D723C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "26223327134007147", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823286_26223327140673813_6470542425560117435_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YIOO7kVqYAQ7kNvwGFAfMS&_nc_oc=Adqzp2YqfWaUklLTBpYn786Tjdnu7VkOfEYd7A5VrJtdzXPKylDRnslsA9cH8XSQ9cw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGDzGZ3U2TzULzDoVDQMZkaf0CaVBrYtEZCCqzjY4Hpw&oe=6A8D93BB"}, "display_name": "D-Day VR Museum", "keywords": ["WorldWar2", "Educational", "Emotional", "War", "Historic"], "long_description": "Step onto the beaches of Normandy and relive the turning point of World War II in a way never before possible \u2013 through Virtual Reality.\n\nThe D-Day VR Museum takes you on a compelling journey back to June 6, 1944, when Allied forces launched the largest amphibious assault in history. \n\n# Content\n- One room / scene for each of the 5 beaches (Utah, Omaha, Gold, Juno, Sword)\n- One entrance room with an overview of the operation and the different locations\n- 400+ exhibits, including 3D models, photos, and videos\n- 30+ 3D scans of original equipment\n- Additional scenes with 360\u00b0 views for key locations such as (but not limited to) the Pegasus Bridge, the Beaches and the Normandy American Cemetery\n\n# Features\n- Realism Redefined: Utilizing 3D scanned models and 360-degree imagery from the historic places of Normandy, the museum offers a visually stunning and authentic experience. \n- Historical Artifacts: Encounter a vast collection of authentic World War II artifacts, such as weapons, uniforms, vehicles, and personal items.\n- Interactive Exhibits: Engage with interactive exhibits that provide in-depth information about the planning, execution, and aftermath of D-Day.\n- Relive History: Explore iconic locations of D-Day, witness key moments, and gain a profound appreciation for the sacrifices made by brave soldiers on that fateful day.\n- Educational Experience: Immerse yourself in a blend of traditional museum exhibits and cutting-edge VR technology\n", "short_description": "Experience the best of both worlds with a unique blend of a traditional museum and immersive exploration of the iconic places in Normandy on D-Day in Virtual Reality!"}, {"images": {"nodes": []}, "id": "880248081724333", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "D-Day VR Museum", "keywords": ["Bildung", "WW2", "Krieg", "Simulation", "Historisch"], "long_description": "Betrete die Str\u00e4nde der Normandie und erlebe den Wendepunkt des Zweiten Weltkriegs auf eine Weise, wie es nie zuvor m\u00f6glich war - durch Virtual Reality.\n\nDas D-Day VR Museum nimmt Dich mit auf eine fesselnde Reise zur\u00fcck zum 6. Juni 1944, als die alliierten Streitkr\u00e4fte den gr\u00f6\u00dften Amphibienangriff der Geschichte starteten.\n\n# Inhalt\n- Ein Raum/eine Szene f\u00fcr jeden der 5 Str\u00e4nde (Utah, Omaha, Gold, Juno, Sword)\n- Einen Eingangsraum mit einem \u00dcberblick \u00fcber die Operation und die verschiedenen Schaupl\u00e4tze\n- 400+ Exponate, darunter 3D-Modelle, Fotos und Videos\n- 30+ 3D-Scans von Originalausr\u00fcstung\n- Zus\u00e4tzliche Szenen mit 360\u00b0-Ansichten von wichtigen Schaupl\u00e4tzen wie (unter anderem) die Pegasus-Br\u00fccke, die Str\u00e4nde und dem amerikanischen Friedhof in der Normandie\n\n# Features\n- **Realismus neu definiert:** Mit 3D-Scans und 360-Grad-Bildern von den historischen Orten der Normandie bietet das Museum ein visuell beeindruckendes und authentisches Erlebnis. \n- **Historische Artefakte:** Historische Artefakte: Entdecke eine umfangreiche Sammlung authentischer Artefakte aus dem Zweiten Weltkrieg, wie z. B. Waffen, Uniformen, Fahrzeuge und pers\u00f6nliche Gegenst\u00e4nde.\n- **Interaktive Exponate:** Die interaktiven Exponate bieten ausf\u00fchrliche Informationen \u00fcber die Planung, Durchf\u00fchrung und die Folgen des D-Day.\n- **Erlebe Geschichte neu:** Erkunde ikonische Schaupl\u00e4tze des D-Day, werde Zeuge von Schl\u00fcsselmomenten und gewinne ein tiefes Verst\u00e4ndnis f\u00fcr die Ereignisse an diesem schicksalshaften Tag.\n", "short_description": "Erlebe das Beste aus beiden Welten mit einer einzigartigen Mischung aus einem traditionellen Museum und einer immersiven Erkundung der Normandie am D-Day in Virtual Reality!"}]}, "developer_name": "Lichtblau IT", "developer_privacy_policy_url": "https://dday-vrmuseum.com/privacy-policy-meta-quest", "developer_terms_of_service_url": null, "publisher_name": "Diverently GmbH", "support_website_url": null, "website_url": "https://dday-vrmuseum.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "pl", "ru", "es", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
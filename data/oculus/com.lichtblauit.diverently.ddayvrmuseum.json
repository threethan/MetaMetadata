0f&oh=00_AQRqJti4ViOy_dXo8f7P5NxKxEk8sUAnJjkGncg32nEHCg&oe=6B06FE04"}, {"file_name": "2025-12-05T10:09:08.png", "id": "1457506652537455", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821719_1457506659204121_5331531040026850805_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHKkrzZo9fkQ7kNvwFhH1aU&_nc_oc=AdqGkME9QN0oXej6x3Nz8yMo9tho4rpmb066j1iTxd81KKsiotKr9z3tYQ2qCsCpbw0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSO5DOowYHrfbnSv_NnZJ9QK9ETKfRAzLzigCUXJmAWdw&oe=6B0710A4"}, {"file_name": "2026-02-16T13:45:42.png", "id": "26883705317882968", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820923_26883705327882967_6771895506510023126_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiCJzsiHIfEQ7kNvwEWQUL8&_nc_oc=AdoYhBgoUz6pQjWmiHCnNgjyImjOyQYJ5WXhtUmtRlubaaDZdA6nn_SfBg3-0TdE-ro&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuOvS0-UlyF0YTD3nY1c4SOpOfpOmbE35shjvgnfgW4g&oe=6B06F47C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "26223327134007147", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823286_26223327140673813_6470542425560117435_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DsDhDEoolcQ7kNvwE-APAZ&_nc_oc=Adr4GxQgt86mgA0lDzfAHPhvZJYmdxFZ3rHB3SOt5SsPlj0TiIy0pk4PX9rAP9Z4iwE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2lf-XJMJ4bnkvlxfxT3oVCbaRfqGmHZcz5QNk_EUlng&oe=6B0715FB"}, "display_name": "D-Day VR Museum", "keywords": ["WorldWar2", "Educational", "Emotional", "War", "Historic"], "long_description": "Step onto the beaches of Normandy and relive the turning point of World War II in a way never before possible \u2013 through Virtual Reality.\n\nThe D-Day VR Museum takes you on a compelling journey back to June 6, 1944, when Allied forces launched the largest amphibious assault in history. \n\n# Content\n- One room / scene for each of the 5 beaches (Utah, Omaha, Gold, Juno, Sword)\n- One entrance room with an overview of the operation and the different locations\n- 400+ exhibits, including 3D models, photos, and videos\n- 30+ 3D scans of original equipment\n- Additional scenes with 360\u00b0 views for key locations such as (but not limited to) the Pegasus Bridge, the Beaches and the Normandy American Cemetery\n\n# Features\n- **7 Languages:** English (+Voiceover), German (+Voiceover), French, Spanish, Italian, Polish and Russian\n- **Realism Redefined:** Utilizing 3D scanned models and 360-degree imagery from the historic places of Normandy, the museum offers a visually stunning and authentic experience. \n- **Historical Artifacts:** Encounter a vast collection of authentic World War II artifacts, such as weapons, uniforms, vehicles, and personal items.\n- **Interactive Exhibits:** Engage with interactive exhibits that provide in-depth information about the planning, execution, and aftermath of D-Day.\n- **Relive History:** Explore iconic locations of D-Day\n- **Educational Experience:** Immerse yourself in a blend of traditional museum exhibits and cutting-edge VR technology\n", "short_description": "Experience the best of both worlds with a unique blend of a traditional museum and immersive exploration of the iconic places in Normandy on D-Day in Virtual Reality!"}, {"images": {"nodes": []}, "id": "807774802129402", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "D-Day VR Museum", "keywords": ["Bildung", "WW2", "Krieg", "Simulation", "Historisch"], "long_description": "Betrete die Str\u00e4nde der Normandie und erlebe den Wendepunkt des Zweiten Weltkriegs auf eine Weise, wie es nie zuvor m\u00f6glich war - durch Virtual Reality.\n\nDas D-Day VR Museum nimmt Dich mit auf eine fesselnde Reise zur\u00fcck zum 6. Juni 1944, als die alliierten Streitkr\u00e4fte den gr\u00f6\u00dften Amphibienangriff der Geschichte starteten.\n\n# Inhalt\n- Ein Raum/eine Szene f\u00fcr jeden der 5 Str\u00e4nde (Utah, Omaha, Gold, Juno, Sword)\n- Einen Eingangsraum mit einem \u00dcberblick \u00fcber die Operation und die verschiedenen Schaupl\u00e4tze\n- 400+ Exponate, darunter 3D-Modelle, Fotos und Videos\n- 30+ 3D-Scans von Originalausr\u00fcstung\n- Zus\u00e4tzliche Szenen mit 360\u00b0-Ansichten von wichtigen Schaupl\u00e4tzen wie (unter anderem) die Pegasus-Br\u00fccke, die Str\u00e4nde und dem amerikanischen Friedhof in der Normandie\n\n# Features\n- **7 Sprachen:** Englisch (+Voiceover), Deutsch (+Voiceover), Franz\u00f6sisch, Spanisch, Italienisch, Polnisch und Russisch\n- **Realismus neu definiert:** Mit 3D-Scans und 360-Grad-Bildern von den historischen Orten der Normandie bietet das Museum ein visuell beeindruckendes und authentisches Erlebnis. \n- **Historische Artefakte:** Historische Artefakte: Entdecke eine umfangreiche Sammlung authentischer Artefakte aus dem Zweiten Weltkrieg, wie z. B. Waffen, Uniformen, Fahrzeuge und pers\u00f6nliche Gegenst\u00e4nde.\n- **Interaktive Exponate:** Die interaktiven Exponate bieten ausf\u00fchrliche Informationen \u00fcber die Planung, Durchf\u00fchrung und die Folgen des D-Day.\n- **Erlebe Geschichte neu:** Erkunde ikonische Schaupl\u00e4tze des D-Day.\n", "short_description": "Erlebe das Beste aus beiden Welten mit einer einzigartigen Mischung aus einem traditionellen Museum und einer immersiven Erkundung der Normandie am D-Day in Virtual Reality!"}]}, "developer_name": "Lichtblau IT", "developer_privacy_policy_url": "https://dday-vrmuseum.com/privacy-policy-meta-quest", "developer_terms_of_service_url": null, "publisher_name": "Diverently GmbH", "support_website_url": null, "website_url": "https://dday-vrmuseum.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "externa
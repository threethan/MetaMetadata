_8912451276853786625_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Jiyiw_GgCoQ7kNvwHTiVEI&_nc_oc=AdqghQreBylndpAH07wTFjhVTzusddN-HmS79ogYdEZ8AAbIHvNTOMibKVLTzNclqzQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWgImw0AY8f_Jjj8YXHDD3cTFXy0rVez2Cvggw__MgEyQ&oe=6B103884"}, {"file_name": "2025-12-05T10:09:08.png", "id": "1457506652537455", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821719_1457506659204121_5331531040026850805_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTDX4fS6JjIQ7kNvwG195vD&_nc_oc=Adqdh13T1Uk9AYiCoc3zAeSKdfSx8fhnxGj4oblRvvZRP7XiGKgU2BZphZqYbLyR_Rs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV9A0SCIzZtHIFsW5Z1JmiQx1ai2nicTGjLhaNnxiCLTQ&oe=6B104B24"}, {"file_name": "2026-02-16T13:45:42.png", "id": "26883705317882968", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820923_26883705327882967_6771895506510023126_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thXK5MrXdxcQ7kNvwG929Qt&_nc_oc=AdqC7Ge8ba54le8wB4lGL-dswtceLh2JFqRf3DCDWaCp-5teUjtSSbQ5OSBRjE899Qw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUiDKiEYtuok_cYFj6mKVNNwiyrHRin9c68XobfDwYl4Q&oe=6B10673C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "26223327134007147", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823286_26223327140673813_6470542425560117435_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaXC-h9HVH8Q7kNvwErVjsd&_nc_oc=Adr8sk1frYg7aVVXb8W0lnrEgZ701n_VxT_qUQIkHgcnZo-eeAbJSFFxTJnDyeOTzjk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWhEcxzVD35AF7peLZVIzu0yU78h8t4GsLooxxW_OC_yg&oe=6B10507B"}, "display_name": "D-Day VR Museum", "keywords": ["WorldWar2", "Educational", "Emotional", "War", "Historic"], "long_description": "Step onto the beaches of Normandy and relive the turning point of World War II in a way never before possible \u2013 through Virtual Reality.\n\nThe D-Day VR Museum takes you on a compelling journey back to June 6, 1944, when Allied forces launched the largest amphibious assault in history. \n\n# Content\n- One room / scene for each of the 5 beaches (Utah, Omaha, Gold, Juno, Sword)\n- One entrance room with an overview of the operation and the different locations\n- 400+ exhibits, including 3D models, photos, and videos\n- 30+ 3D scans of original equipment\n- Additional scenes with 360\u00b0 views for key locations such as (but not limited to) the Pegasus Bridge, the Beaches and the Normandy American Cemetery\n\n# Features\n- Realism Redefined: Utilizing 3D scanned models and 360-degree imagery from the historic places of Normandy, the museum offers a visually stunning and authentic experience. \n- Historical Artifacts: Encounter a vast collection of authentic World War II artifacts, such as weapons, uniforms, vehicles, and personal items.\n- Interactive Exhibits: Engage with interactive exhibits that provide in-depth information about the planning, execution, and aftermath of D-Day.\n- Relive History: Explore iconic locations of D-Day, witness key moments, and gain a profound appreciation for the sacrifices made by brave soldiers on that fateful day.\n- Educational Experience: Immerse yourself in a blend of traditional museum exhibits and cutting-edge VR technology\n", "short_description": "Experience the best of both worlds with a unique blend of a traditional museum and immersive exploration of the iconic places in Normandy on D-Day in Virtual Reality!"}, {"images": {"nodes": []}, "id": "880248081724333", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "D-Day VR Museum", "keywords": ["Bildung", "WW2", "Krieg", "Simulation", "Historisch"], "long_description": "Betrete die Str\u00e4nde der Normandie und erlebe den Wendepunkt des Zweiten Weltkriegs auf eine Weise, wie es nie zuvor m\u00f6glich war - durch Virtual Reality.\n\nDas D-Day VR Museum nimmt Dich mit auf eine fesselnde Reise zur\u00fcck zum 6. Juni 1944, als die alliierten Streitkr\u00e4fte den gr\u00f6\u00dften Amphibienangriff der Geschichte starteten.\n\n# Inhalt\n- Ein Raum/eine Szene f\u00fcr jeden der 5 Str\u00e4nde (Utah, Omaha, Gold, Juno, Sword)\n- Einen Eingangsraum mit einem \u00dcberblick \u00fcber die Operation und die verschiedenen Schaupl\u00e4tze\n- 400+ Exponate, darunter 3D-Modelle, Fotos und Videos\n- 30+ 3D-Scans von Originalausr\u00fcstung\n- Zus\u00e4tzliche Szenen mit 360\u00b0-Ansichten von wichtigen Schaupl\u00e4tzen wie (unter anderem) die Pegasus-Br\u00fccke, die Str\u00e4nde und dem amerikanischen Friedhof in der Normandie\n\n# Features\n- **Realismus neu definiert:** Mit 3D-Scans und 360-Grad-Bildern von den historischen Orten der Normandie bietet das Museum ein visuell beeindruckendes und authentisches Erlebnis. \n- **Historische Artefakte:** Historische Artefakte: Entdecke eine umfangreiche Sammlung authentischer Artefakte aus dem Zweiten Weltkrieg, wie z. B. Waffen, Uniformen, Fahrzeuge und pers\u00f6nliche Gegenst\u00e4nde.\n- **Interaktive Exponate:** Die interaktiven Exponate bieten ausf\u00fchrliche Informationen \u00fcber die Planung, Durchf\u00fchrung und die Folgen des D-Day.\n- **Erlebe Geschichte neu:** Erkunde ikonische Schaupl\u00e4tze des D-Day, werde Zeuge von Schl\u00fcsselmomenten und gewinne ein tiefes Verst\u00e4ndnis f\u00fcr die Ereignisse an diesem schicksalshaften Tag.\n", "short_description": "Erlebe das Beste aus beiden Welten mit einer einzigartigen Mischung aus einem traditionellen Museum und einer immersiven Erkundung der Normandie am D-Day in Virtual Reality!"}]}, "developer_name": "Lichtblau IT", "developer_privacy_policy_url": "https://dday-vrmuseum.com/privacy-policy-meta-quest", "developer_terms_of_service_url": null, "publisher_name": "Diverently GmbH", "support_website_url": null, "website_url": "https://dday-vrmuseum.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "pl", "ru", "es", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26532504083078711"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "952854840942989"}, {"status": "PUBLISHED", "id": "1638638357410591"}, {"status": "PUBLISHED", "id": "839267092567114"}, {"status": "PUBLISHED", "id": "1460200185698409"}, {"status": "PUBLISHED", "id": "1684960126256807"}, {"status": "PENDING", "id": "25553556917654348"}]}, "baseline_offer": {"id": "1684960126256807"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "952854840942989"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27029160780079703", "version": "1.0.4"}, "id": "911337241360129", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25889137087415417", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27029160780079703"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "911337241360129"}]}, "change_log": "- Fixed graphic glitch on one of t
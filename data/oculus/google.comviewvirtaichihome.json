PHJkg5yZ53ntqqcVNtdGJLwGHTbYrUs_k300R_7EYViuyS9cItKjl8TLo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZIjOkxbzd9nmYr8NypCW87TLs1LW8GfLSvwZa_hdLOw&oe=6B099F10"}, {"file_name": "MaBa.png", "id": "402372402916342", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974508_402372406249675_6978485084713301365_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGWcWmyD70MQ7kNvwFpskcL&_nc_oc=Adqzbd0eag-TNK4Xdy6TK-wi7IM4ZHAdfon5FjbvO5ZOgEtr1AAJOAkgYn9Dowp1yas&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsdoVFKEfJODpA0-qZBXq51vRdgfXo2TVI562zcCknZA&oe=6B099E1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainMenu2560x1440.png", "id": "990293449567737", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974832_990293452901070_8840274522652524177_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hafdFoHOcFAQ7kNvwG6MdrQ&_nc_oc=Adp2IIH7xneGx2vKehXeoATnsG5j0i-8SEls8OWcTCdb85k3in960NxMyFPoUcKa_Ro&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRs1eLij35U-5uqwvCDnbUcNg9ytP-DSWrqHYNaDWpkog&oe=6B09C4E0"}, "display_name": "Virtual Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\n\n\n\n\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for a
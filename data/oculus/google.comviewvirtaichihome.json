BgSNSj4I7SSOF475wnZJKhmV4pflwG-0LDQAdDTJzcZ4MMux_waZF-8KU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHepTD8ryD3YUsNdlAoi4S2YKfR3lZKaibt3l1Mb20sA&oe=6AFF1310"}, {"file_name": "MaBa.png", "id": "402372402916342", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974508_402372406249675_6978485084713301365_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D23tOqplnFkQ7kNvwGnmSlP&_nc_oc=AdqV_3RWjdd9CSLU_s__J9JQ4yshem6pocEyq59ldaArYxgm9aoUa45sOGGzvHOEGSY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrIgMszMP6Du9r6ipoLxbR306_BqzL5wDjCKr_9-eHHA&oe=6AFF121A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainMenu2560x1440.png", "id": "990293449567737", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974832_990293452901070_8840274522652524177_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JP-wvTew5rsQ7kNvwFCPPMh&_nc_oc=Adr_GoBLQAnDWy6ChMkBHIWpvZRPM7gliy3tRQzlX7-nPjsIQqA5Kc_h7R0duc9FB_U&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlHPN2a0xU_K5SeKiPh0vheT3N3wlQDBxDOjw9GsYi6A&oe=6AFF00A0"}, "display_name": "Virtual Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\n\n\n\n\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for a
myifE1f-HlE99XIKmkD44yxxdvIq30RPGILhGbFkaIh4NsFDnLVachZNc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnRh9ADCJEdCCkF5Ux00aTFkIAplF_NHaveoJjY5If0w&oe=6AFDC190"}, {"file_name": "MaBa.png", "id": "402372402916342", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974508_402372406249675_6978485084713301365_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D23tOqplnFkQ7kNvwEN5vyY&_nc_oc=Adr4x4WKYiInV5-oZWHAcCKwPh-rBrKWFrb2KJKlZdjZOonKjwpM81JN028RtPEmIAY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmVF9p1Y6QFeyCAAyGfqt9Oux9Eb33J5oqc2KRmlyKtw&oe=6AFDC09A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainMenu2560x1440.png", "id": "990293449567737", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974832_990293452901070_8840274522652524177_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JP-wvTew5rsQ7kNvwHPJ9yZ&_nc_oc=Adpf3NNsU1g5zb1KvcF__TCqwOppKUxYtfpUzSIJF0nXvGJpTrVjY9-puEFFZoXy1hQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2zDvU1iN-JAMfI0_saIG68v61lHo6wlB6YyKEqUBmyw&oe=6AFDAF20"}, "display_name": "Virtual Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\n\n\n\n\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for a
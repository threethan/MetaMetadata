uzoqTUpoYzizBf-0Oks0OXS2JaFkZrtJ4aA8Motw8IWAb2i3G4li-X5RA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbv16GqHQN-jh5DjkJeY8CB97hc8gZetgpCWQt3M6-JA&oe=6AFC7010"}, {"file_name": "MaBa.png", "id": "402372402916342", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974508_402372406249675_6978485084713301365_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nm51Jjb5ttAQ7kNvwGDEE1b&_nc_oc=AdoCwbQXsFJ7pCGRmnaThI2XleSyL2EdNJ2XK0m0cnD_rreNIyOzMrFRtxMdv97Sf6g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7xxSYmxAFdHd-gLxZ1kVxSDSHAYzp3RVPI6Yxjxy-pA&oe=6AFC6F1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainMenu2560x1440.png", "id": "990293449567737", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974832_990293452901070_8840274522652524177_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JP-wvTew5rsQ7kNvwFBS5QZ&_nc_oc=AdrRRakvdCW7HvFkzj0SGIyq36Th9qdvXIVdve6232zdtbRE3uwmedRoEj7cLIU84k4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQp6UBCMxnMWeWrCDtWu9MCiuKmF9edtXRQ6KLhttvMtQ&oe=6AFC5DA0"}, "display_name": "Virtual Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\n\n\n\n\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for a
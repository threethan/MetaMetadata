640038_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSF6xA-o1ZMQ7kNvwEYfHWX&_nc_oc=AdpAxqFO3YZClHuAeArFo1xnR5r_qLNIqeBjMbVNCFkrSxreg6iPINLpJ75JH0OnXKo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9epszVNqt2RGaJcIYm71--Q5SvbWAiX6zNIoSySv6Ow&oe=6AF9DCC8"}, {"file_name": "screenshot_1_2560x1440.png", "id": "1026249587106934", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/613094043_1026249593773600_3049180054069379854_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ufo0u_y7ch0Q7kNvwHGiRkR&_nc_oc=AdpFqmX04MWVsKHuaBBZAqhtA92dqK2NCb01IjyjlLfTKKr00NgbxgSvwvtY2hlo6T0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8yNs6zt0N7AkFIV7sCR6xc-l9uDBEZANHMQ5JGvisnw&oe=6AF9C591"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1149076627683363", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/604293968_1149076631016696_7214199090008639895_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjMnM-ALlYQQ7kNvwEX331c&_nc_oc=AdohGCO6j75t501VQzquyCu2GjczWl7YC5Z0VKT6OLUhk7NcFj3ae8XbXmcOCbzEHfg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNW2bHhtAzX144skZlQrjdaCmOu5mTDZ9bkKfysdycyw&oe=6AF9CD06"}, "display_name": "Castle Builder", "keywords": ["castle", "builder", "sandbox", "medieval", "building"], "long_description": "CASTLE BUILDER gives you an empty plot of land in a sunny valley and a wheel full of castle pieces. Point, pull the trigger, and a wall snaps onto the tile grid. Aim at the top of it and the next piece stacks on. Build a gatehouse, drop in a portcullis that winches itself up as you walk to it, put roofs and flags on your towers, then stroll through the gate you built.\n\nTHE BUILD WHEEL\nFive pages of pieces: WALLS, TOWERS, GATES, DECOR and PEOPLE. Walls, corners, doorways and stairs. Square and round towers with windows, balconies, roofs and spires. Gate arches, drawbridges, doors, banners. Trees, rocks, a catapult, a trebuchet, a battering ram and a siege tower.\n\nPEOPLE\nTwelve villagers to place from the wheel. Set one down and they walk your castle grounds, never through a wall, and wave when you come close. Pick them up and move them like any other piece.\n\nCASTLE COLOURS\nOne press cycles eight colour styles across everything you have built.\n\nREADY-MADE CASTLES\nStarter Fort, Royal Castle and Grand Fortress drop in piece by piece. Explore them, add to them, or clear the land and start again.\n\nEverything auto-saves. Undo up to forty steps. Standing play with snap turning and smooth walking across a 104 m meadow with hills, a forest and a lake.", "short_description": "Build your own castle on a meadow the size of a village. Pick walls, towers, gates, flags and siege engines from the round build wheel, snap them onto a 4 m tile grid, stack towers as high as you like, then walk in through your own gate. Add villagers who wander your castle grounds and wave as you pass. Three ready-made castles, eight colour styles, auto-save."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/castlebuilder/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/castlebuilder/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USE
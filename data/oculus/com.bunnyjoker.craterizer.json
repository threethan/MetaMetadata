K-GpJCGQ&oe=6AF8AADB"}, {"file_name": "444.png", "id": "1450186483634796", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830904_1450186486968129_5839986104589931188_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_tnHbIEqz0Q7kNvwHvt72E&_nc_oc=Ado_UKgyIvVOgDircbEnjYGU0UTTN4ulY-Hk2zhncQ8PTZlCGV4RySjE_oBNYfJHdjs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-sW2DRQj0yH5u-DERJv2rsQ6BSOPMlf8mGPkU8dpP2A&oe=6AF88288"}, {"file_name": "crater.png", "id": "2282039712530193", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604385997_2282039715863526_8363330143462808500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjyI5aWSO74Q7kNvwGMUH4P&_nc_oc=AdoQGGBnOK8lOdF0mZKOJLZDe76Hotae_X016FjOfM66aHs1t8vxIHS6GQCAOhW7c30&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjLc7nUsJ4LHLCQTVCk0CWhGtdLRJfGsgIa1yiIV0HRA&oe=6AF8AC13"}, {"file_name": "gg.png", "id": "2648284708958879", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/613094043_2648284712292212_270996806363127181_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJsA9dOVhTgQ7kNvwFuPLF1&_nc_oc=AdoqoW9svGL2zk9o5tKU9wS_iRvPqS3KLGZagRCzgYlAs4v5stLlyyuVGeWSk6ciN8g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCrqcTZbhxw4zp58pgJzuVA5_gKf8Szzk9_hSRP1Cm7Q&oe=6AF89FA8"}, {"file_name": "as.png", "id": "28526458063671734", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830576_28526458067005067_7629760254159228865_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGJXGOs91owQ7kNvwGg6oyW&_nc_oc=Adr-CfJYeARgs-LID-M8uEhz2rYhaERyrNRJ8otCqetxfgFkslNempv4HHd7lPJjEkA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFd_r8krwaXpFyJL-GMNOJz-U-VXuBMprSoMzmcBiDmA&oe=6AF8A6AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Wide_RightResolution.png", "id": "1838150037203136", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604385997_1838150040536469_5973516465049868849_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GVirGOBi40Q7kNvwGugM-R&_nc_oc=AdodfxTOb4PxAn4y82rNewLUKVF9p4omY56qQdIJqF6v86p_dkx8H3QWA3Z_o63hWwA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSU8BDzlO7tIAdAsJCRdEDvRnnywTKnD6QibfplyvwT8A&oe=6AF8A8ED"}, "display_name": "CRATERIZER", "keywords": ["power", "hero", "fly", "destruction", "superpower"], "long_description": "# CRATERIZER\n\n**Unleash devastating powers in a fully destructible world!**\n\nBlast through mountains, carve gigantic craters, and uncover hidden power buried beneath the surface. Fly, teleport, and unleash massive energy attacks as you explore, destroy, and battle other players to become the most powerful!\n\n---\n\n**DESTROY EVERYTHING**\n\nThe entire world is yours to destroy! Blast massive craters into the ground, carve tunnels through mountains, and reshape the landscape with devastating energy attacks. Every explosion leaves its mark.\n\n{3683268698504402}\n\n**BATTLE OTHER PLAYERS**\n\nChallenge other players in an open multiplayer world! Dodge incoming attacks, unleash powerful energy blasts, and steal their power when you defeat them. Every battle is a chance to grow stronger.\n\n{1863180268428934}\n\n**CREATE YOUR OWN WORLDS**\n\nExplore endless procedurally generated worlds, each with its own landscape waiting to be destroyed. Enter custom seeds to generate new environments and discover endless possibilities for exploration and destruction.\n\n{1661171522030799}\n\n**FLY, TELEPORT & EXPLORE**\n\nTake to the skies, teleport across the landscape, and explore the world with incredible freedom of movement. Reach towering peaks, dive into massive craters, and discover what lies beneath the surface.\n\n{1784578006019863}\n\n**BECOME THE MOST POWERFUL**\n\nSearch beneath the surface for hidden Power Extenders to increase your energy capacity. Grow stronger, unleash increasingly devastating attacks, and hunt down powerful opponents to claim their power. How powerful can you become?\n\n{2631
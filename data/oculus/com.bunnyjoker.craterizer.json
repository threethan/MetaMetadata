jdeHGR3w&oe=6AF7211B"}, {"file_name": "444.png", "id": "1450186483634796", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830904_1450186486968129_5839986104589931188_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_tnHbIEqz0Q7kNvwHq-nt8&_nc_oc=Adp2HWLry15QZcHv7afsoKobDaENnWGkqv3lXBpVF57fWbKE0UwNuRSO6NV4J7CODlY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJsofsd-AhaCT1kmZ6WekrH8kACjZQgebKsZQE1qMc3Q&oe=6AF73108"}, {"file_name": "crater.png", "id": "2282039712530193", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604385997_2282039715863526_8363330143462808500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5gYSjB2xCUQ7kNvwGNcIrc&_nc_oc=AdpX10iy-ZQENR66Uop7pu-Of_dyT9kfK7TXGvMFmClHU9CoBkV3QDo_RiCoMF9Q5LU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDfuS7Zbd2raYq4xsZq4OgqiJ6GzNLgVbKQbRSHXjpKQ&oe=6AF72253"}, {"file_name": "gg.png", "id": "2648284708958879", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/613094043_2648284712292212_270996806363127181_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJsA9dOVhTgQ7kNvwFNsGxn&_nc_oc=Adp6_SOzuQcit_VATGYNiC-aJFPBvqEv0HODUWiAEWTjE5PHp0HM8Q5fNeMcSQ04g_w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTw6CIDi_Tf3iF_zizu6EYJlLGEt1y04dqcaE7fsJPrRQ&oe=6AF715E8"}, {"file_name": "as.png", "id": "28526458063671734", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830576_28526458067005067_7629760254159228865_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGJXGOs91owQ7kNvwHNx055&_nc_oc=AdpPv38tmMBWf9l4Pl_jGjGMf6lNUjKmB8z_Vp19HD9Wow3TrVU3KQ_7DbvCLz2EnHs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7EyyXKIDm1OENs4HL73cID98OFn-s_CMkD3UznH67dw&oe=6AF71CED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Wide_RightResolution.png", "id": "1838150037203136", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604385997_1838150040536469_5973516465049868849_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GVirGOBi40Q7kNvwEXo9qC&_nc_oc=Adq2UyyD0VLAGv63CVvWth2l21m-h0irzpOhSJ1OnqP322xDajlCmod-mft2Ptb_JVo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-0xiY3JmZgui2R1XujpkqHFq4Z3yNJU4HAnAPs79pqw&oe=6AF71F2D"}, "display_name": "CRATERIZER", "keywords": ["power", "hero", "fly", "destruction", "superpower"], "long_description": "# CRATERIZER\n\n**Unleash devastating powers in a fully destructible world!**\n\nBlast through mountains, carve gigantic craters, and uncover hidden power buried beneath the surface. Fly, teleport, and unleash massive energy attacks as you explore, destroy, and battle other players to become the most powerful!\n\n---\n\n**DESTROY EVERYTHING**\n\nThe entire world is yours to destroy! Blast massive craters into the ground, carve tunnels through mountains, and reshape the landscape with devastating energy attacks. Every explosion leaves its mark.\n\n{3683268698504402}\n\n**BATTLE OTHER PLAYERS**\n\nChallenge other players in an open multiplayer world! Dodge incoming attacks, unleash powerful energy blasts, and steal their power when you defeat them. Every battle is a chance to grow stronger.\n\n{1863180268428934}\n\n**CREATE YOUR OWN WORLDS**\n\nExplore endless procedurally generated worlds, each with its own landscape waiting to be destroyed. Enter custom seeds to generate new environments and discover endless possibilities for exploration and destruction.\n\n{1661171522030799}\n\n**FLY, TELEPORT & EXPLORE**\n\nTake to the skies, teleport across the landscape, and explore the world with incredible freedom of movement. Reach towering peaks, dive into massive craters, and discover what lies beneath the surface.\n\n{1784578006019863}\n\n**BECOME THE MOST POWERFUL**\n\nSearch beneath the surface for hidden Power Extenders to increase your energy capacity. Grow stronger, unleash increasingly devastating attacks, and hunt down powerful opponents to claim their power. How powerful can you become?\n\n{2631
/v/t64.5771-25/753032404_1618433840076833_347273255166686971_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGxZMuWgpSYQ7kNvwG0KVaA&_nc_oc=AdrC6wq6eX93lW60VEQAF_g6ny6_NjvqUaFqUdbRAnukXNiljpxBiqE1DWceSE_Utas&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVvLoYry7jA8mNjgLDK0ZvMimjzPRgE4UamcdpfXjwA_A&oe=6B0F145B"}, {"file_name": "444.png", "id": "1450186483634796", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830904_1450186486968129_5839986104589931188_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4S_ST5At3HMQ7kNvwFyq_uL&_nc_oc=AdpsxSG37thYsRj8hmiGctNa_dPEeCf6ZuFeBvpijz2KA0t02Kkv9Fbx4K2EPGa_m-c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXvEPqJqm0yrqYQWX8AOEzQRAYOVsa9RKxTexuVQvTEZQ&oe=6B0EEC08"}, {"file_name": "crater.png", "id": "2282039712530193", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604385997_2282039715863526_8363330143462808500_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytcrzAE1e8EQ7kNvwHcjdqG&_nc_oc=AdrV6joC8nzyFsdrA5TeR8W8EFlag8-XMKmOqg36RnwIhqr-uAnJRu5J3HJq4jZp4Sg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWwkLG0nSSXhU2PptAjG9jSMZzI_C8FhiorpTPBwWh3Tg&oe=6B0F1593"}, {"file_name": "gg.png", "id": "2648284708958879", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/613094043_2648284712292212_270996806363127181_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-v2ECDcuh8YQ7kNvwEr1ypU&_nc_oc=Adrq6AwGyq8V7rbqzfYDBKiZcmwpithGEZs2_MqqYDiMdpWJTMUxZq6kdK3w0AYZGgE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXwQ6x50v76AKjMfWimBwiWv3wcqAld8UxjK3cGIHGxjg&oe=6B0F0928"}, {"file_name": "as.png", "id": "28526458063671734", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830576_28526458067005067_7629760254159228865_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSq2h0Vae2IQ7kNvwExGuFm&_nc_oc=AdqIr2AZ9rea6FKtBYmZirPthVfjaLXRekmFGb5zgiBROosxME4RwUrpbV8b4PAJEOA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVFOxd1xMxwEUEp4hJg2nz5nmIP867jgX_1csVjLcMmaQ&oe=6B0F102D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Wide_RightResolution.png", "id": "1838150037203136", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604385997_1838150040536469_5973516465049868849_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2q5WA33sOs8Q7kNvwGapV5N&_nc_oc=AdqrpPRK6TKzSAZr4k9Xl4yFO7QxwwKAguEBgRH8fbn1KdtNb90YCvoPk_jmnek-o70&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX9PiFQsgyMz8ICogoBsK1J-Rkeyls3epwuRHkIXOaFDw&oe=6B0F126D"}, "display_name": "CRATERIZER", "keywords": ["power", "hero", "fly", "destruction", "superpower"], "long_description": "# CRATERIZER\n\n**Unleash devastating powers in a fully destructible world!**\n\nBlast through mountains, carve gigantic craters, and uncover hidden power buried beneath the surface. Fly, teleport, and unleash massive energy attacks as you explore, destroy, and battle other players to become the most powerful!\n\n---\n\n**DESTROY EVERYTHING**\n\nThe entire world is yours to destroy! Blast massive craters into the ground, carve tunnels through mountains, and reshape the landscape with devastating energy attacks. Every explosion leaves its mark.\n\n{3683268698504402}\n\n**BATTLE OTHER PLAYERS**\n\nChallenge other players in an open multiplayer world! Dodge incoming attacks, unleash powerful energy blasts, and steal their power when you defeat them. Every battle is a chance to grow stronger.\n\n{1863180268428934}\n\n**CREATE YOUR OWN WORLDS**\n\nExplore endless procedurally generated worlds, each with its own landscape waiting to be destroyed. Enter custom seeds to generate new environments and discover endless possibilities for exploration and destruction.\n\n{1661171522030799}\n\n**FLY, TELEPORT & EXPLORE**\n\nTake to the skies, teleport across the landscape, and explore the world with incredible freedom of movement. Reach towering peaks, dive into massive craters, and discover what lies beneath the surface.\n\n{1784578006019863}\n\n**BECOME THE MOST POWERFUL**\n\nSearch beneath the surface for hidden Power Extenders to increase your energy capacity. Grow stronger, unleash increasingly devastating attacks, and hunt down powerful opponents to claim their power. How powerful can you become?\n\n{2631245777412584}\n\nDiscord: https://discord.com/invite/dPxCgFfUqC", "short_description": "Blast the terrain, opening huge craters and tunnels, find buried power extenders, summon a gigantic energy blast, and blow up entire mountains (or your friends)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/insanemedia.com.br/craterizer/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BunnyJoker", "support_website_url": null, "website_url": "https://sites.google.com/insanemedia.com.br/craterizer/landing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "1419625214565848"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673652249_931955919639421_2893549962888751822_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless
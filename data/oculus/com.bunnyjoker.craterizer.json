U9MVwQ&oe=6AF47E1B"}, {"file_name": "444.png", "id": "1450186483634796", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830904_1450186486968129_5839986104589931188_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0q9eStgjD48Q7kNvwGmvser&_nc_oc=Adr4KfS8FxA0fwGLstNQelVAuzdsp5eBffAkLWozSTUgc7L3iBZYWIniXtnaTW60Qao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGalctUMcl-7QhKA8VBmrO4gS6Fbgh52DcXFQGK1cgUg&oe=6AF48E08"}, {"file_name": "crater.png", "id": "2282039712530193", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604385997_2282039715863526_8363330143462808500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5gYSjB2xCUQ7kNvwHkDVfu&_nc_oc=Adq_YGgYib9MYAl8y66Xq1SnZ4akhkmTmQp_Wdj0PxJhmc82ugHaIiMXFNR1IHoRnKs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGykjsRt8O34iqXHsIYbxVsDvfStMBKDAcFHHhdEkseg&oe=6AF47F53"}, {"file_name": "gg.png", "id": "2648284708958879", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/613094043_2648284712292212_270996806363127181_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OY5xzbWOSusQ7kNvwEDGEmE&_nc_oc=Adp9d4OHt5__803Yv_rIKaJiR8FZKDw7BXWjpYqXTM2TDaZ3OsVjSigX436QDpkw3eg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVprXelUKlX4Q_pgQm6kNIy33SB60ufezJp-hbENvNcQ&oe=6AF472E8"}, {"file_name": "as.png", "id": "28526458063671734", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830576_28526458067005067_7629760254159228865_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Si-XvGS6nGgQ7kNvwHyvCw2&_nc_oc=AdqhpTRn_QmU9xVqyBco-k6K18JSSVSHh_SFKzhWSRGECmljbJQgwt6VRw9hOidHZmU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2vrF_VTSeRa6Pkeg6ZPIcGQkxcHXz2g_pxQodyO0f_g&oe=6AF479ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Wide_RightResolution.png", "id": "1838150037203136", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604385997_1838150040536469_5973516465049868849_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyWVmZzpvckQ7kNvwGSkF0c&_nc_oc=Adrs5Ya5wyiYYlvogJ10L6TOzFw_FzFaOaG7aiyLZetIIKBMai_FxGOBaDEp1SMBqpg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2Nn1MTzr5hoKLUz9zny3hrlhJ6P50IDq159JRq0wA3A&oe=6AF47C2D"}, "display_name": "CRATERIZER", "keywords": ["power", "hero", "fly", "destruction", "superpower"], "long_description": "# CRATERIZER\n\n**Unleash devastating powers in a fully destructible world!**\n\nBlast through mountains, carve gigantic craters, and uncover hidden power buried beneath the surface. Fly, teleport, and unleash massive energy attacks as you explore, destroy, and battle other players to become the most powerful!\n\n---\n\n**DESTROY EVERYTHING**\n\nThe entire world is yours to destroy! Blast massive craters into the ground, carve tunnels through mountains, and reshape the landscape with devastating energy attacks. Every explosion leaves its mark.\n\n{3683268698504402}\n\n**BATTLE OTHER PLAYERS**\n\nChallenge other players in an open multiplayer world! Dodge incoming attacks, unleash powerful energy blasts, and steal their power when you defeat them. Every battle is a chance to grow stronger.\n\n{1863180268428934}\n\n**CREATE YOUR OWN WORLDS**\n\nExplore endless procedurally generated worlds, each with its own landscape waiting to be destroyed. Enter custom seeds to generate new environments and discover endless possibilities for exploration and destruction.\n\n{1661171522030799}\n\n**FLY, TELEPORT & EXPLORE**\n\nTake to the skies, teleport across the landscape, and explore the world with incredible freedom of movement. Reach towering peaks, dive into massive craters, and discover what lies beneath the surface.\n\n{1784578006019863}\n\n**BECOME THE MOST POWERFUL**\n\nSearch beneath the surface for hidden Power Extenders to increase your energy capacity. Grow stronger, unleash increasingly devastating attacks, and hunt down powerful opponents to claim their power. How powerful can you become?\n\n{263124
/v/t64.5771-25/753032404_1618433840076833_347273255166686971_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlYmJ3mEfv8Q7kNvwEOD-H3&_nc_oc=AdqLKkCLvep4mYTYNBD0AKa8-G4Zsa0jRCIqJiQ3NEdi6akXlCtViXva7zloQ2hn9-4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUDxUz4_99RK41UoddGWlrazkJ5eQhUJ4NUo-Lz2PPmqQ&oe=6B1065DB"}, {"file_name": "444.png", "id": "1450186483634796", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830904_1450186486968129_5839986104589931188_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4S_ST5At3HMQ7kNvwEjKvf2&_nc_oc=Adp5aNgyTa6eb4KTXBWDOCEmDrpLsYkf21_TKoOwTzIorNjkJ8m7aVBfX07PUiRuSI0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWTLKZRz_3DOfFFDX1NETW_o29UB0Gn8BjElbOThoqbpQ&oe=6B103D88"}, {"file_name": "crater.png", "id": "2282039712530193", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604385997_2282039715863526_8363330143462808500_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8mVcvfvn3kQ7kNvwHhNeGk&_nc_oc=AdqcwTfL7a4DrxL9EXtYGKypux0xZDuAsfYQ-mGPJoWIwpCt6geRX9qAdqrNJE__q-8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXx4spv6dc_GMD4BRCut0_exJ3tJQl0TAEvmafmPjVa-Q&oe=6B106713"}, {"file_name": "gg.png", "id": "2648284708958879", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/613094043_2648284712292212_270996806363127181_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-v2ECDcuh8YQ7kNvwHE9JQm&_nc_oc=AdqrDf31fCXA9RH-4tTxU36l0q65gk3tUdk9CvcnZxMxs_Tp4yji9IXJaiNa0FpDHqg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVLpRdj5Lz0tM4A_RNx_vKEtZyInjewTIeJnXlpmacD5Q&oe=6B105AA8"}, {"file_name": "as.png", "id": "28526458063671734", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830576_28526458067005067_7629760254159228865_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSq2h0Vae2IQ7kNvwGhBf-k&_nc_oc=AdrVPig4DzNBP8GZSFh3B1fUKZdr-_lQSPyWk6B_4E_lxEQ8pbVI_jAutpfYsReO298&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW-eQffj-hoQ6aT-RRqCoS1j-fSghMvuswYLeXnNvofAQ&oe=6B1061AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Wide_RightResolution.png", "id": "1838150037203136", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604385997_1838150040536469_5973516465049868849_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2q5WA33sOs8Q7kNvwH_XDsv&_nc_oc=AdrA8UPBiKctSdYOV9L_HR3WzEocz6YGoTszvDs_IQJfu4KGk8r7k5ktMxaO6TgfaH0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUBojVWO08RaXlYYGQ5WClbvl1QHSMfUcY5mzZqmcRycQ&oe=6B1063ED"}, "display_name": "CRATERIZER", "keywords": ["power", "hero", "fly", "destruction", "superpower"], "long_description": "# CRATERIZER\n\n**Unleash devastating powers in a fully destructible world!**\n\nBlast through mountains, carve gigantic craters, and uncover hidden power buried beneath the surface. Fly, teleport, and unleash massive energy attacks as you explore, destroy, and battle other players to become the most powerful!\n\n---\n\n**DESTROY EVERYTHING**\n\nThe entire world is yours to destroy! Blast massive craters into the ground, carve tunnels through mountains, and reshape the landscape with devastating energy attacks. Every explosion leaves its mark.\n\n{3683268698504402}\n\n**BATTLE OTHER PLAYERS**\n\nChallenge other players in an open multiplayer world! Dodge incoming attacks, unleash powerful energy blasts, and steal their power when you defeat them. Every battle is a chance to grow stronger.\n\n{1863180268428934}\n\n**CREATE YOUR OWN WORLDS**\n\nExplore endless procedurally generated worlds, each with its own landscape waiting to be destroyed. Enter custom seeds to generate new environments and discover endless possibilities for exploration and destruction.\n\n{1661171522030799}\n\n**FLY, TELEPORT & EXPLORE**\n\nTake to the skies, teleport across the landscape, and explore the world with incredible freedom of movement. Reach towering peaks, dive into massive craters, and discover what lies beneath the surface.\n\n{1784578006019863}\n\n**BECOME THE MOST POWERFUL**\n\nSearch beneath the surface for hidden Power Extenders to increase your energy capacity. Grow stronger, unleash increasingly devastating attacks, and hunt down powerful opponents to claim their power. How powerful can you become?\n\n{2631245777412584}\n\nDiscord: https://discord.com/invite/dPxCgFfUqC", "short_description": "Blast the terrain, opening huge craters and tunnels, find buried power extenders, summon a gigantic energy blast, and blow up entire mountains (or your friends)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/insanemedia.com.br/craterizer/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BunnyJoker", "support_website_url": null, "website_url": "https://sites.google.com/insanemedia.com.br/craterizer/landing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "1419625214565848"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673652249_931955919639421_2893549962888751822_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless
YxlBZB1Q&oe=6AF9C41B"}, {"file_name": "444.png", "id": "1450186483634796", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830904_1450186486968129_5839986104589931188_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvSNcKk6WqcQ7kNvwFpSUGT&_nc_oc=AdqlvUo3UpeIkWmHs4MdsRvywNt88REcuIvlnWs-omL6AXji8RVf7xRO1z0EKKuOcfI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-THUBEMoBS6NJLk4MfXePHL0DP2VatuzzOIGUhKVw_A&oe=6AF9D408"}, {"file_name": "crater.png", "id": "2282039712530193", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/604385997_2282039715863526_8363330143462808500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjyI5aWSO74Q7kNvwHGUUMo&_nc_oc=AdrpJOxBPIYKFV9Un4L3fn4le2U0h5m_BOERyXydk-vxFBmayd-t-XtA5hxHLgkZSDs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQI1A1JnnJaewSdmYkOmS9CNS_F5KaBeHVKk5A3_fq8rg&oe=6AF9C553"}, {"file_name": "gg.png", "id": "2648284708958879", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/613094043_2648284712292212_270996806363127181_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0a2h0XrDzsQ7kNvwFcHX80&_nc_oc=AdoncWLXdvNSgeUC5U0CJ57qeY8LEFngntSHXS89_jVEfdyV3reioNJ7w4Snsz3fYTM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTphiqSESnvfhu0pjqWjWTckSc3HNf2cyj4tILVLQ684A&oe=6AF9B8E8"}, {"file_name": "as.png", "id": "28526458063671734", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491830576_28526458067005067_7629760254159228865_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGJXGOs91owQ7kNvwE1lwrT&_nc_oc=AdoA9xyAHbOy1-7E2dbVSD4dZT9nPrLX-b1Hd7TFKH3g-mBQeHT1D_U0xzUJBOwRTsI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQd50_4pK8em6jFLcjKJDiWMGJqChGUaOTRobM5NSdo4Q&oe=6AF9BFED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Wide_RightResolution.png", "id": "1838150037203136", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/604385997_1838150040536469_5973516465049868849_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ttW0yBw_qEQ7kNvwE--zmF&_nc_oc=AdrmwIUmwnbRgO028b4SdI45kTDtGCgEkkdR0oB3rGgBiYAnb13gryJYdJiyjFJRvSo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI6s8gKpUSCDsQmh0YjFx61WxnW2QQnTYGRh_lI0Z_JA&oe=6AF9C22D"}, "display_name": "CRATERIZER", "keywords": ["power", "hero", "fly", "destruction", "superpower"], "long_description": "# CRATERIZER\n\n**Unleash devastating powers in a fully destructible world!**\n\nBlast through mountains, carve gigantic craters, and uncover hidden power buried beneath the surface. Fly, teleport, and unleash massive energy attacks as you explore, destroy, and battle other players to become the most powerful!\n\n---\n\n**DESTROY EVERYTHING**\n\nThe entire world is yours to destroy! Blast massive craters into the ground, carve tunnels through mountains, and reshape the landscape with devastating energy attacks. Every explosion leaves its mark.\n\n{3683268698504402}\n\n**BATTLE OTHER PLAYERS**\n\nChallenge other players in an open multiplayer world! Dodge incoming attacks, unleash powerful energy blasts, and steal their power when you defeat them. Every battle is a chance to grow stronger.\n\n{1863180268428934}\n\n**CREATE YOUR OWN WORLDS**\n\nExplore endless procedurally generated worlds, each with its own landscape waiting to be destroyed. Enter custom seeds to generate new environments and discover endless possibilities for exploration and destruction.\n\n{1661171522030799}\n\n**FLY, TELEPORT & EXPLORE**\n\nTake to the skies, teleport across the landscape, and explore the world with incredible freedom of movement. Reach towering peaks, dive into massive craters, and discover what lies beneath the surface.\n\n{1784578006019863}\n\n**BECOME THE MOST POWERFUL**\n\nSearch beneath the surface for hidden Power Extenders to increase your energy capacity. Grow stronger, unleash increasingly devastating attacks, and hunt down powerful opponents to claim their power. How powerful can you become?\n\n{2631
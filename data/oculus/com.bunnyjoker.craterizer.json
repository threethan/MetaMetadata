/v/t64.5771-25/753032404_1618433840076833_347273255166686971_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9314CVys_TgQ7kNvwEQmePe&_nc_oc=AdpyDEqHMi8t89AQsvpgVnwMRZ7xNQGWfYtZ4jiG0MlteM2ZpFC7JlGuxPZXAmZtrY8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBrYmXI_DpYloKaF1-xfb_5Y6DzfBDYgtnnrdNZoxZJw&oe=6AFB159B"}, {"file_name": "444.png", "id": "1450186483634796", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491830904_1450186486968129_5839986104589931188_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvSNcKk6WqcQ7kNvwE_o5Fh&_nc_oc=AdpVHemBTa4B0teY-U8g5ugKNJuALTBOfabAKjnbDeQbGUxlBgFtYebqiZ4h9MWnRZs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5m0WJNAL8OtxpBX-TiLePgTwKHmLHMzMpH3GLS5GJkg&oe=6AFB2588"}, {"file_name": "crater.png", "id": "2282039712530193", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/604385997_2282039715863526_8363330143462808500_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjyI5aWSO74Q7kNvwF3KkWD&_nc_oc=AdobEXMamsdweZp8FwP9FJ_3EuGtiH-OcbVoqPvoin0vv8nlSJgmUfHE6uhpbAoIRnY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTv_IWIMz0LP3Fp8g_oeHeKXOvCfRzMs3EHbdhh7PB8Fw&oe=6AFB16D3"}, {"file_name": "gg.png", "id": "2648284708958879", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/613094043_2648284712292212_270996806363127181_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0a2h0XrDzsQ7kNvwFHPfeY&_nc_oc=AdqBxrbeZQ8vW9BrkB5_xH_4308pRSZQkxFYA97wQ2jOOJHhTctZn84ynBzB0J5JNgA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMii99pAoaEsfxT88bz4ItQd6ZStWcGbUAip7-6nGAag&oe=6AFB42A8"}, {"file_name": "as.png", "id": "28526458063671734", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491830576_28526458067005067_7629760254159228865_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vCaAslpnIYQ7kNvwGqgU6U&_nc_oc=Adr8aUcFiNrxXbRjFi2g2rn-3OwIDI7Gi3cNSBqa3TBaUq9FvkapUX7w4OJavyPnwY8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFq5yEBL1_eYyfXjgQEi4v5QxbgWS_GBg5Cl41fu0neQ&oe=6AFB49AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Wide_RightResolution.png", "id": "1838150037203136", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/604385997_1838150040536469_5973516465049868849_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ttW0yBw_qEQ7kNvwGNRJkS&_nc_oc=Adq27ENoZKL4Pumw2S_R9X2Y4CZmA9C3Tr21or6xWUpcBO-98z26UgB5iKdXdgwhmyg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQskD5z6syfF_tr0-SJcq-vaUTTnR3iUrDIKem7zdDyBA&oe=6AFB4BED"}, "display_name": "CRATERIZER", "keywords": ["power", "hero", "fly", "destruction", "superpower"], "long_description": "# CRATERIZER\n\n**Unleash devastating powers in a fully destructible world!**\n\nBlast through mountains, carve gigantic craters, and uncover hidden power buried beneath the surface. Fly, teleport, and unleash massive energy attacks as you explore, destroy, and battle other players to become the most powerful!\n\n---\n\n**DESTROY EVERYTHING**\n\nThe entire world is yours to destroy! Blast massive craters into the ground, carve tunnels through mountains, and reshape the landscape with devastating energy attacks. Every explosion leaves its mark.\n\n{3683268698504402}\n\n**BATTLE OTHER PLAYERS**\n\nChallenge other players in an open multiplayer world! Dodge incoming attacks, unleash powerful energy blasts, and steal their power when you defeat them. Every battle is a chance to grow stronger.\n\n{1863180268428934}\n\n**CREATE YOUR OWN WORLDS**\n\nExplore endless procedurally generated worlds, each with its own landscape waiting to be destroyed. Enter custom seeds to generate new environments and discover endless possibilities for exploration and destruction.\n\n{1661171522030799}\n\n**FLY, TELEPORT & EXPLORE**\n\nTake to the skies, teleport across the landscape, and explore the world with incredible freedom of movement. Reach towering peaks, dive into massive craters, and discover what lies beneath the surface.\n\n{1784578006019863}\n\n**BECOME THE MOST POWERFUL**\n\nSearch beneath the surface for hidden Power Extenders to increase your energy capacity. Grow stronger, unleash increasingly devastating attacks, and hunt down powerful opponents to claim their power. How powerful can you become?\n\n{2631245777412584}\n\nDiscord: https://discord.com/invite/dPxCgFfUqC", "short_description": "Blast the terrain, opening huge craters and tunnels, find buried power extenders, summon a gigantic energy blast, and blow up entire mountains (or your friends)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/insanemedia.com.br/craterizer/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BunnyJoker", "support_website_url": null, "website_url": "https://sites.google.com/insanemedia.com.br/craterizer/landing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "1419625214565848"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/673652249_931955919639421_2893549962888751822_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless
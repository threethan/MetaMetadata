T0yFb5fA&oe=6AF5CF9B"}, {"file_name": "444.png", "id": "1450186483634796", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830904_1450186486968129_5839986104589931188_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_tnHbIEqz0Q7kNvwGj6U1h&_nc_oc=AdpaXSszR5EzNxTu2wJ4PjB11AXX1xcCvSCKDv9BskDa-pD93yOmlMaoKpxVP-hSRek&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRW2XEorWahBpjhUvJpk4Q0mlalfVCFaJ3g0vLdtCW7fQ&oe=6AF5DF88"}, {"file_name": "crater.png", "id": "2282039712530193", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604385997_2282039715863526_8363330143462808500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5gYSjB2xCUQ7kNvwH1ps4v&_nc_oc=AdrS_1GMiZaGXc8UPwYiWtxbWcIVRKsGByI8KjVP0JW9kRCZ-aOD5P9mGdteAcUrTXI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCtSzY8FvEmXwXYR8CkhOXGeDLu5zK4CTbdCH-lwBO6Q&oe=6AF5D0D3"}, {"file_name": "gg.png", "id": "2648284708958879", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/613094043_2648284712292212_270996806363127181_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJsA9dOVhTgQ7kNvwEhIIXn&_nc_oc=AdqKJ4J4tf-XLEAFXGHGoTpqb7qjH2zEz1oQLMQ-3bsmaRUO_FI7BGyC7srJm74JjT4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQO1uZ5vizyPplLNqZgMY5MdYY90WtdrAz8hypFkNjOFQ&oe=6AF5C468"}, {"file_name": "as.png", "id": "28526458063671734", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830576_28526458067005067_7629760254159228865_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Si-XvGS6nGgQ7kNvwElMvP-&_nc_oc=AdruS_OPmmmy85gXPTMYNMSUSvIywtxZlieBVr4u5VXqmwLehuuEM_7bnADp3ivMwAU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSr7TCcnYDCun1ADpfzTueEZ6ALC3GjoVWsEahA3owncw&oe=6AF5CB6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Wide_RightResolution.png", "id": "1838150037203136", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604385997_1838150040536469_5973516465049868849_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GVirGOBi40Q7kNvwFapOnq&_nc_oc=Adrb_sjMciXoP0s_nXq6cq-lggOeXiDfZ5CVyjG50_Mw3Ce07g7ZXR__MPqbtIhk5ZY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2jzRdEAA2YHekL6u1xeCvbazFUAH5M5mXOdjmEmUG2Q&oe=6AF5CDAD"}, "display_name": "CRATERIZER", "keywords": ["power", "hero", "fly", "destruction", "superpower"], "long_description": "# CRATERIZER\n\n**Unleash devastating powers in a fully destructible world!**\n\nBlast through mountains, carve gigantic craters, and uncover hidden power buried beneath the surface. Fly, teleport, and unleash massive energy attacks as you explore, destroy, and battle other players to become the most powerful!\n\n---\n\n**DESTROY EVERYTHING**\n\nThe entire world is yours to destroy! Blast massive craters into the ground, carve tunnels through mountains, and reshape the landscape with devastating energy attacks. Every explosion leaves its mark.\n\n{3683268698504402}\n\n**BATTLE OTHER PLAYERS**\n\nChallenge other players in an open multiplayer world! Dodge incoming attacks, unleash powerful energy blasts, and steal their power when you defeat them. Every battle is a chance to grow stronger.\n\n{1863180268428934}\n\n**CREATE YOUR OWN WORLDS**\n\nExplore endless procedurally generated worlds, each with its own landscape waiting to be destroyed. Enter custom seeds to generate new environments and discover endless possibilities for exploration and destruction.\n\n{1661171522030799}\n\n**FLY, TELEPORT & EXPLORE**\n\nTake to the skies, teleport across the landscape, and explore the world with incredible freedom of movement. Reach towering peaks, dive into massive craters, and discover what lies beneath the surface.\n\n{1784578006019863}\n\n**BECOME THE MOST POWERFUL**\n\nSearch beneath the surface for hidden Power Extenders to increase your energy capacity. Grow stronger, unleash increasingly devastating attacks, and hunt down powerful opponents to claim their power. How powerful can you become?\n\n{2631
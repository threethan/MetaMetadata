=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTRKgqRdvW0Q7kNvwHvs53Z&_nc_oc=AdptnocgDnOsTMgaFOC_pf6N3cz0I9D4eGJNffQyZ-1ABvcgVE-Hy6Zfzk9zKqKp_Is&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ca4YSaAXEDgMv9bEIlRec25m-Fw_10fv3lSiqOC7ZCQ&oe=69DF88CA"}, {"file_name": "Screeshot_4.png", "id": "749475594694178", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618254_749475598027511_6783824000723588972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0_DZVnc9xQQ7kNvwHKxmo0&_nc_oc=AdqduevJhGKJUbLuyUU-qo_uIzFOxIRbEyLPOgaFTdL_Gsdesd5A-ySeeeOOPWDCTw4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20BO9N1tJ6rNMobr1qK9dXppmyn-mO9mrIiFf2OZft2Q&oe=69DF8DEE"}, {"file_name": "Screenshot_5.png", "id": "713453271396879", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819476_713453274730212_7845404713817018470_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wndzoDRdemoQ7kNvwHwGoEo&_nc_oc=AdpiZmCh5YamM7O-3H4_gyA0UD5F1x0w6lEHs2kyIC1n0oTZV-4IqkJ9PsKnkmuUHOE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_Yr7ZmxPwe0xUG_7ost2xE_7-k9ClQYTvDRtkR-TrfA&oe=69DF7028"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cat_2560x1440.png", "id": "1444890606932880", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619697_1444890610266213_934929122431537399_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOWrzHhdrWcQ7kNvwEyrYk7&_nc_oc=AdrZlYHiNTpqGeGyYeF6cwiGSyKc4TrOw-Oi2xPjjUL9AEpIOOklpITsH0Yqr7pqmjo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SIbH36X3Pnm0ARP8DHy3R7-C5_Elm5v4wzvdLr8sLpA&oe=69DF8ED6"}, "display_name": "Cat Cafe", "keywords": ["Cat", "Pets", "simulator", "sandbox", "Animal"], "long_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities. \n\n \ud83d\ude39 **Cat Memes Come Alive**\n\nFrom the Spinning OI Cat to the Crying Cat, your favorite cat memes are hidden all around\u2014see how many you can spot!\n{1372492100461219}\n\n\ud83d\udc31 **Feel the Fur**\n\nIn Cat Cafe, every gentle stroke triggers lifelike feedback\u2014you\u2019ll sense the soft give of tiny muscles and joints, as if the cats were really right beside you.\n{1389394782078149}\n\n\ud83d\udc95 **Care and Cuddles**\n\nFrom preparing yummy kibble to washing a muddy kitten clean, every act of care deepens their affection\u2014and your furry friends will remember your kindness!\n{1407459710569238}\n\n\ud83e\uddf6 **Playtime Fun**\n\nWave a cat teaser, chase a mysterious laser dot\u2014each toy sparks your cat\u2019s playful hunting instincts and fills your moments together with giggles and soft purrs.\n{716976647361329}\n\n\ud83d\udd75\ufe0f **Discover the Unexpected**\n\nAnd there\u2019s so much more to discover! Come find out what fun awaits!", "short_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities. \nEnjoy complete freedom as you explore this cozy cat paradise\u2014feed your furry friends, engage them with playful activities, or simply enjoy their company."}]}, "developer_name": "Smartmelon Games", "developer_privacy_policy_url": "https://thesmartmelon.com/cat_privacy_en", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://thesmartmelon.com/home.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
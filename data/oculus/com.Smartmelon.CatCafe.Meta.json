"}, {"file_name": "Screenshot_3.png", "id": "985744243752259", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824592_985744247085592_8588943664061122494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T46VFhsRSk4Q7kNvwE968LN&_nc_oc=Adq2QTnm0koxi7J2R3iZQCNs716fQzZ8Z7qAu3ICSKeJwsP6P5ENR2LZDDVGE9vCqec&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUreXjiPRextbQr0qYBZZZqce8thTLhH-0yLlki5byxQ&oe=6ACCEAD6"}, {"file_name": "Screenshot_4.png", "id": "914799184027185", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825091_914799187360518_8621325599848622444_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymDmgFWmDREQ7kNvwGqh8FA&_nc_oc=AdpUVz79pzUn5SFC6MIH_yVtB1fZgNYnwMTCZmhRtiJkLVPqLoagiwkT9DkhB3d2J1U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpZEeSPY_5OsW-f7ZqSedDzV8ERwTJY0K4c5KRz9266Q&oe=6ACCFC67"}, {"file_name": "Screenshot_5.png", "id": "1433734251391042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821784_1433734254724375_8033982263853796036_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pG4F6z-EsmwQ7kNvwGqNzKt&_nc_oc=Adry9weZAwFszdfTEUpW1SdnND6rNNl92VU7ULJt5Vr738iu0XQVFV1Qi-kssW4W5dY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUx2kUX5wjqcUR6ON_JGFjmEMuYWeK9XDq4REAUO5k3A&oe=6ACCF58A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cat_2560x1440.png", "id": "1188224326044423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822559_1188224329377756_9071464048390316677_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uobq9kzK1ncQ7kNvwHPaEAc&_nc_oc=AdrZKSqL-LfveuS_LqLZi_BDMf9HZd03jt06rrsrAMw7sQqoa78RwtnJiiFqlrIkYlE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKFQDdLpaV8HPUXDuR4b_yC1MxhqjW7qw6hEmuI9-d2A&oe=6ACCE677"}, "display_name": "Cat Cafe", "keywords": ["Cat", "Pets", "simulator", "sandbox", "Animal"], "long_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities. With a fully physics-based animation system, our virtual cats exhibit realistic behaviors and interactions, responding dynamically to your every action. Each cat has its own distinct personality traits, such as being playful, shy, affectionate, or mischievous, and autonomously selects behaviors based on their current state, traits, and your interactions.\n\nEnjoy complete freedom as you explore this cozy cat paradise\u2014feed your furry friends, engage them with playful activities, or simply enjoy their company. Be mindful, as your actions directly influence their moods and behaviors, creating a uniquely personal bond. Whether you're seeking relaxation or playful mischief, Cat Cafe offers a lifelike and endlessly entertaining VR journey for cat lovers everywhere.", "short_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cookclash.com/game_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://www.cookclash.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9634312096687345"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "
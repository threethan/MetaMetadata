7f20f&oh=00_AQHJjpLim__jFCOSM7cVwhD18_FEB1okClANGSwGJShF0A&oe=6A8C45CA"}, {"file_name": "Screenshot_3.png", "id": "728240283357686", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623541_728240286691019_1059920376867982623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcPZr6wD3F4Q7kNvwHQh28y&_nc_oc=AdpGgff7RoQasp-KZO2Vl8mDwNI_qucsDXnzG0Mdjc2BSbftFOyJArizXpfJPzCAMfQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHH-FbWmJAMiL1DufkQ0usUqvMvcAZflHu8xaaJtJ3M_g&oe=6A8C3D4A"}, {"file_name": "Screeshot_4.png", "id": "749475594694178", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618254_749475598027511_6783824000723588972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjA_G1X9ircQ7kNvwHjZr49&_nc_oc=AdoW-DhglAa_AU3BFBBnHDlRp8x0ut1VnAO-dZu1In2gb22WWSFkTgEG2_nyN2x1AAY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_6NmoIsmMzaCyLF8dXQeY_ReJe-xRVFbHqVLI_ritnQ&oe=6A8C426E"}, {"file_name": "Screenshot_5.png", "id": "713453271396879", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819476_713453274730212_7845404713817018470_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kteOaOhtxEgQ7kNvwFDICNy&_nc_oc=Adr6eLsKENG_87Ea-0-7780sVrAj_fMTonO7V30I62VsLsSKroJkrNd5noaB-Sdul9k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJX7JC9Cx-qREtvtboD37nwBkOLR7NhzjBQC3TdggI2Q&oe=6A8C24A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cat_2560x1440.png", "id": "1444890606932880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619697_1444890610266213_934929122431537399_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEJcW8T1cFYQ7kNvwFt1n7x&_nc_oc=Adpis8QSUmDVP62E5avpXJr5V7Zn2zZ0Y54TibRrio9o8fQuALnrS-xrBBpkB1UHtSc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-2BEWocs9oqs5Ulgr5s-Ut12KyJytm0BSIhHyVq6k8A&oe=6A8C4356"}, "display_name": "Cat Cafe", "keywords": ["Cat", "Pets", "simulator", "sandbox", "Animal"], "long_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities. \n\n \ud83d\ude39 **Cat Memes Come Alive**\n\nFrom the Spinning OI Cat to the Crying Cat, your favorite cat memes are hidden all around\u2014see how many you can spot!\n{1372492100461219}\n\n\ud83d\udc31 **Feel the Fur**\n\nIn Cat Cafe, every gentle stroke triggers lifelike feedback\u2014you\u2019ll sense the soft give of tiny muscles and joints, as if the cats were really right beside you.\n{1389394782078149}\n\n\ud83d\udc95 **Care and Cuddles**\n\nFrom preparing yummy kibble to washing a muddy kitten clean, every act of care deepens their affection\u2014and your furry friends will remember your kindness!\n{1407459710569238}\n\n\ud83e\uddf6 **Playtime Fun**\n\nWave a cat teaser, chase a mysterious laser dot\u2014each toy sparks your cat\u2019s playful hunting instincts and fills your moments together with giggles and soft purrs.\n{716976647361329}\n\n\ud83d\udd75\ufe0f **Discover the Unexpected**\n\nAnd there\u2019s so much more to discover! Come find out what fun awaits!", "short_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities. \nEnjoy complete freedom as you explore this cozy cat paradise\u2014feed your furry friends, engage them with playful activities, or simply enjoy their company."}]}, "developer_name": "Smartmelon Games", "developer_privacy_policy_url": "https://thesmartmelon.com/cat_privacy_en", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://thesmartmelon.com/home.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "int
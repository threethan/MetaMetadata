_oc=AdrT4fEkUC6GW8qlFigcEvRSdA_ymO2qKBMmbRHkR-rx4zsgPPzZ_SzGlLtauXJaPec&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvrQ5_ROelkgHQdRy448pVlhlpibWIeQ8Fhqn-DYfZgg&oe=6AD0D3CA"}, {"file_name": "Screenshot_3.png", "id": "728240283357686", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623541_728240286691019_1059920376867982623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5vpM7jMtH4Q7kNvwG6lr0z&_nc_oc=AdpC_lQeOn6VuMifahGiOo3ozL4gw4OdCqIvoCS-nX-HwiPMy87v0ahPzQfJCMfL_Bk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7pSoXzK-xI9vZsHoYT_K4LBm2JA5Dtkib2b2bbGOl8g&oe=6AD1038A"}, {"file_name": "Screeshot_4.png", "id": "749475594694178", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618254_749475598027511_6783824000723588972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GjQ5r12hTsQ7kNvwGub2EQ&_nc_oc=AdqES1dZV4zoptCELj10j52UmYMybuAwSN5_pGXHB0FjD0aMxB_fSObtxkXW13Xr97Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOi8afLh7g01jy17CEELo_1b33Cfw2TdYY6RqWZ7xW7jg&oe=6AD0D06E"}, {"file_name": "Screenshot_5.png", "id": "713453271396879", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819476_713453274730212_7845404713817018470_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BA64SOKUXqIQ7kNvwG4uQ_0&_nc_oc=Adol05nF_oF3eOx7rDFV2WNHTy_qxPstn5gnK90xEBi8FzHMM_6SXcIW7uGP2AHn7Sw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIqEWWMB_DO8lWg21xZ_bk2I7aY2Xp4nbt6SR63KGLYA&oe=6AD0EAE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cat_2560x1440.png", "id": "1444890606932880", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619697_1444890610266213_934929122431537399_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMxvuCTSvqYQ7kNvwFPWTOr&_nc_oc=AdpPUnGQYgrs1LEQgq3-X1dOvE6jfaI8TaoLWsTd4o9B1A5dTBgaqr-EC0cjs9W89dg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2Vq0d8zwZU6bZlQ-zdFkEZygzaHJN7CHB2CFNirU65A&oe=6AD0D156"}, "display_name": "Cat Cafe", "keywords": ["Cat", "Pets", "simulator", "sandbox", "Animal"], "long_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities. \n\n \ud83d\ude39 **Cat Memes Come Alive**\n\nFrom the Spinning OI Cat to the Crying Cat, your favorite cat memes are hidden all around\u2014see how many you can spot!\n{1372492100461219}\n\n\ud83d\udc31 **Feel the Fur**\n\nIn Cat Cafe, every gentle stroke triggers lifelike feedback\u2014you\u2019ll sense the soft give of tiny muscles and joints, as if the cats were really right beside you.\n{1389394782078149}\n\n\ud83d\udc95 **Care and Cuddles**\n\nFrom preparing yummy kibble to washing a muddy kitten clean, every act of care deepens their affection\u2014and your furry friends will remember your kindness!\n{1407459710569238}\n\n\ud83e\uddf6 **Playtime Fun**\n\nWave a cat teaser, chase a mysterious laser dot\u2014each toy sparks your cat\u2019s playful hunting instincts and fills your moments together with giggles and soft purrs.\n{716976647361329}\n\n\ud83d\udd75\ufe0f **Discover the Unexpected**\n\nAnd there\u2019s so much more to discover! Come find out what fun awaits!", "short_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities. \nEnjoy complete freedom as you explore this cozy cat paradise\u2014feed your furry friends, engage them with playful activities, or simply enjoy their company."}]}, "developer_name": "Smartmelon Games", "developer_privacy_policy_url": "https://thesmartmelon.com/cat_privacy_en", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://thesmartmelon.com/home.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_t
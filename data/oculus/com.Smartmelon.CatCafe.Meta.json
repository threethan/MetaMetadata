1824592_985744247085592_8588943664061122494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8LDAb7rtZcQ7kNvwHtBf60&_nc_oc=AdphnU3iOivhhnSRj4eHK51otJWDugPlZZ7hoj-3QXQsdyyYK8GYkzZx78xQPtVnLJw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdkvtQALiWNnKmBeu-qj2xwFdNr3JKZq9SvqFt3xk2Mg&oe=6AF32656"}, {"file_name": "Screenshot_4.png", "id": "914799184027185", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825091_914799187360518_8621325599848622444_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8ByB6bu0OAQ7kNvwFqOWAA&_nc_oc=AdrrgWgmNeuFVuyX2KU0tyse8YNAiw38I6TffM7lAfaDMbJ2QQYU_20ajOWqAROxem8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbvMhPVyqFmGmvFkaGv-FubOBRCk8KP--a5TUY82hJ9w&oe=6AF337E7"}, {"file_name": "Screenshot_5.png", "id": "1433734251391042", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821784_1433734254724375_8033982263853796036_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Yf2qLjvkPsQ7kNvwFtXnsw&_nc_oc=Adq3I4tl-ED3IoN8sfjuF6aydTU4sT7RiohBpsRRkGIqiToim9H2oNASkiYwJ5BF6Qs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRM6OxjZnQdBl5uwLnciftmFD73vZx2GKHkJcc7usTmAg&oe=6AF3310A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cat_2560x1440.png", "id": "1188224326044423", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822559_1188224329377756_9071464048390316677_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzrD2rndeK8Q7kNvwEWdpd9&_nc_oc=AdqzRHXyR6byYo0UlYBig1BW8VZr1FkMtopxGiywOgF4wxddnd3k1Ci1CLzO91EmXNc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5ef5cCHesVzpWhzmbx6EAB6Jg-vTqSu7DGbHlMNrpOw&oe=6AF35A37"}, "display_name": "Cat Cafe", "keywords": ["Cat", "Pets", "simulator", "sandbox", "Animal"], "long_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities. With a fully physics-based animation system, our virtual cats exhibit realistic behaviors and interactions, responding dynamically to your every action. Each cat has its own distinct personality traits, such as being playful, shy, affectionate, or mischievous, and autonomously selects behaviors based on their current state, traits, and your interactions.\n\nEnjoy complete freedom as you explore this cozy cat paradise\u2014feed your furry friends, engage them with playful activities, or simply enjoy their company. Be mindful, as your actions directly influence their moods and behaviors, creating a uniquely personal bond. Whether you're seeking relaxation or playful mischief, Cat Cafe offers a lifelike and endlessly entertaining VR journey for cat lovers everywhere.", "short_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cookclash.com/game_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://www.cookclash.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9634312096687345"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1530733921868889"}, {"status": "PUBLISHED", "id": "2066469100799867"}, {"status": "PUBLISHED", "id": "3301
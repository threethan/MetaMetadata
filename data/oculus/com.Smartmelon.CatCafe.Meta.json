"}, {"file_name": "Screenshot_3.png", "id": "985744243752259", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824592_985744247085592_8588943664061122494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8rU1_pkJcYQ7kNvwHQtI8c&_nc_oc=AdoutE9xzPeyP65F4b53wTnCnuBDrWcUoYXLeMEvOobwIkx4-OO9Cu0o-X4lNtyePb8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwT6uM-dzg4vF9vdG7WKAl4WuXEqcRVX8d9Su0BI49Ig&oe=6AD0DF56"}, {"file_name": "Screenshot_4.png", "id": "914799184027185", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825091_914799187360518_8621325599848622444_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttcMIIl3vy4Q7kNvwGTC9yH&_nc_oc=AdoB1i1XsoZhSfRD98y1UNwy82EMxvPboSYi9jaUYZm7Ay8KelMnZ6utIIKq33sv_5M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZTWxd-mx71ViziRR1CfHgImIwuP4QBtG-wywAwk5NCw&oe=6AD0F0E7"}, {"file_name": "Screenshot_5.png", "id": "1433734251391042", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821784_1433734254724375_8033982263853796036_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4piWfeg_bMQ7kNvwEi9ozQ&_nc_oc=Adrn60e5UHK4q0Yjmtz6oWLPtLBUgWfPBwXpFiBqi3neP2cV2LCckIxgtqCGmIL8zC8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1XraPhRWDltqyLst5LPnrF3Q6cbNBizQjF75-wi4-tw&oe=6AD0EA0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cat_2560x1440.png", "id": "1188224326044423", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822559_1188224329377756_9071464048390316677_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hs9B9KiiqbEQ7kNvwGbBPjU&_nc_oc=AdoNuAyy12AFlfEykpp_nQzVGdciMBbFnYmoUGeyrdcCvD0Dx0Ry3FSIPXzH4wIcvsI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzDLF9yS8c_CYrVeGu_t4Q3vZwUIWD_6e3KMxYFVHlGA&oe=6AD0DAF7"}, "display_name": "Cat Cafe", "keywords": ["Cat", "Pets", "simulator", "sandbox", "Animal"], "long_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities. With a fully physics-based animation system, our virtual cats exhibit realistic behaviors and interactions, responding dynamically to your every action. Each cat has its own distinct personality traits, such as being playful, shy, affectionate, or mischievous, and autonomously selects behaviors based on their current state, traits, and your interactions.\n\nEnjoy complete freedom as you explore this cozy cat paradise\u2014feed your furry friends, engage them with playful activities, or simply enjoy their company. Be mindful, as your actions directly influence their moods and behaviors, creating a uniquely personal bond. Whether you're seeking relaxation or playful mischief, Cat Cafe offers a lifelike and endlessly entertaining VR journey for cat lovers everywhere.", "short_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cookclash.com/game_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://www.cookclash.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9634312096687345"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "
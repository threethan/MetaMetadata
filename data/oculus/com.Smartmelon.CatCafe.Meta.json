7f20f&oh=00_Af-TLyGyc4LJmWPSqiFD13d69x6VN-Lw1cY8EjvO-5GH7g&oe=6A3D2BCA"}, {"file_name": "Screenshot_3.png", "id": "728240283357686", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499623541_728240286691019_1059920376867982623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgtyHFOaRFAQ7kNvwGZnCSA&_nc_oc=Adok1yiO7L5UUzMk2T-93R0sNWu8KQdvFDvN3O2xmVMahRJ932AbE6ElZ4tOQEGoWXM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RASLZ9K2nf4Zw2rbqvcRxuKwN26uUzIwbEK4fUBm4UA&oe=6A3D5B8A"}, {"file_name": "Screeshot_4.png", "id": "749475594694178", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618254_749475598027511_6783824000723588972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3dbhraJo8sQ7kNvwFI6C69&_nc_oc=Ado57FZVD1-u78zuOHl4tBgZgqN7l2n2HWntIXxVbzteoc_4cA5u_Xn1uZ9a8ic2rDY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82i2UblRodfcISolAFk66SSDqXOjKnYayfNuLofK2i1A&oe=6A3D286E"}, {"file_name": "Screenshot_5.png", "id": "713453271396879", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819476_713453274730212_7845404713817018470_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CdO3zSwJlwQ7kNvwGG9vfL&_nc_oc=AdqiB-dKRYv2Y858VFfXZxz0uvRBuEkfOfHZKxqhtpgHiRJVgvglgREdMpYLyXBsBOg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bUzTsusLjQ35OmRaJyKVKmdHMnB6j7LlonYWMLyq7bw&oe=6A3D42E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cat_2560x1440.png", "id": "1444890606932880", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619697_1444890610266213_934929122431537399_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCgLpy6i-MwQ7kNvwHWWbee&_nc_oc=AdqAQm6b1nsVCYgsQUAx2mFykDahOl1sKWnbjPbNmLeagF_gAM2Iq6Z9v2lMYTsT0rk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Pbpc7cp3KkpBfDcm7fcxn6M3bhb--BoDuT6NrV1F4EQ&oe=6A3D2956"}, "display_name": "Cat Cafe", "keywords": ["Cat", "Pets", "simulator", "sandbox", "Animal"], "long_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities. \n\n \ud83d\ude39 **Cat Memes Come Alive**\n\nFrom the Spinning OI Cat to the Crying Cat, your favorite cat memes are hidden all around\u2014see how many you can spot!\n{1372492100461219}\n\n\ud83d\udc31 **Feel the Fur**\n\nIn Cat Cafe, every gentle stroke triggers lifelike feedback\u2014you\u2019ll sense the soft give of tiny muscles and joints, as if the cats were really right beside you.\n{1389394782078149}\n\n\ud83d\udc95 **Care and Cuddles**\n\nFrom preparing yummy kibble to washing a muddy kitten clean, every act of care deepens their affection\u2014and your furry friends will remember your kindness!\n{1407459710569238}\n\n\ud83e\uddf6 **Playtime Fun**\n\nWave a cat teaser, chase a mysterious laser dot\u2014each toy sparks your cat\u2019s playful hunting instincts and fills your moments together with giggles and soft purrs.\n{716976647361329}\n\n\ud83d\udd75\ufe0f **Discover the Unexpected**\n\nAnd there\u2019s so much more to discover! Come find out what fun awaits!", "short_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities. \nEnjoy complete freedom as you explore this cozy cat paradise\u2014feed your furry friends, engage them with playful activities, or simply enjoy their company."}]}, "developer_name": "Smartmelon Games", "developer_privacy_policy_url": "https://thesmartmelon.com/cat_privacy_en", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://thesmartmelon.com/home.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "int
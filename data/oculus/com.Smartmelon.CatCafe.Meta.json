scdn.com/v/t64.5771-25/491822559_1188224329377756_9071464048390316677_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjoLsNq9d5QQ7kNvwGTtX2d&_nc_oc=AdpqAFSypFQSkSlx5dX5Vn0zKDlNtQLW2e9U0zICY_RvPfIuSpLSZDJVwHsuUQaHlRg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzV0Bk8cB3G85N1Rg1V5Vy4Gp4OYsCvhPdKWhMZpXg1w&oe=6B01DAB7"}, "display_name": "Cat Cafe", "keywords": ["Cat", "Pets", "simulator", "sandbox", "Animal"], "long_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities. With a fully physics-based animation system, our virtual cats exhibit realistic behaviors and interactions, responding dynamically to your every action. Each cat has its own distinct personality traits, such as being playful, shy, affectionate, or mischievous, and autonomously selects behaviors based on their current state, traits, and your interactions.\n\nEnjoy complete freedom as you explore this cozy cat paradise\u2014feed your furry friends, engage them with playful activities, or simply enjoy their company. Be mindful, as your actions directly influence their moods and behaviors, creating a uniquely personal bond. Whether you're seeking relaxation or playful mischief, Cat Cafe offers a lifelike and endlessly entertaining VR journey for cat lovers everywhere.", "short_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cookclash.com/game_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://www.cookclash.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}
"}, {"file_name": "Screenshot_3.png", "id": "985744243752259", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824592_985744247085592_8588943664061122494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyRvg3y7VfcQ7kNvwFpIkay&_nc_oc=AdrHkykR6SvLnjeQGNyR7kXe_19XRnyAWgwmXxXZA1pd_5FBKUyyM3p5Cl8ezGS3E2Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrU8TyH5IGO-nWgEf6jt3KcvoA86Y4mVq8ucbCMDMFZQ&oe=6ADE0E56"}, {"file_name": "Screenshot_4.png", "id": "914799184027185", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825091_914799187360518_8621325599848622444_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tsq4gp0apoUQ7kNvwEFRQ6L&_nc_oc=AdpttUn9qcllYjkSJ7QLxV4-hkHSRis366jFqcM3W5LBDBpNHtQ11htITpKaM1PYRpQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqh9lEAnqaqT5v71f-OTsQck0vDlDKA0d1eHf9uuHQXQ&oe=6ADE1FE7"}, {"file_name": "Screenshot_5.png", "id": "1433734251391042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821784_1433734254724375_8033982263853796036_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NekXLY_FcdMQ7kNvwHdAaXI&_nc_oc=AdpRX9TANMStJFUAMsX16Rs97-vre3786qZKZv0Gq4qnkjTdn7i0tAj1oM-gohdHcm4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhBwDbbWfYk2bACvARIQ4J8pLf97b4F9JrH2Ki-ZW-jw&oe=6ADE190A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cat_2560x1440.png", "id": "1188224326044423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822559_1188224329377756_9071464048390316677_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvkbgXLBp20Q7kNvwF1lH9l&_nc_oc=AdpB8OmPoPwwOlk1b_44xwHa3z6CXM6irjM1_9iRI6UfzuRpivAtZeaBfy8kIb2wPPo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDW_WHGjaFgITA8Zo583peclC6IEgAk68_V5detGqr8Q&oe=6ADE09F7"}, "display_name": "Cat Cafe", "keywords": ["Cat", "Pets", "simulator", "sandbox", "Animal"], "long_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities. With a fully physics-based animation system, our virtual cats exhibit realistic behaviors and interactions, responding dynamically to your every action. Each cat has its own distinct personality traits, such as being playful, shy, affectionate, or mischievous, and autonomously selects behaviors based on their current state, traits, and your interactions.\n\nEnjoy complete freedom as you explore this cozy cat paradise\u2014feed your furry friends, engage them with playful activities, or simply enjoy their company. Be mindful, as your actions directly influence their moods and behaviors, creating a uniquely personal bond. Whether you're seeking relaxation or playful mischief, Cat Cafe offers a lifelike and endlessly entertaining VR journey for cat lovers everywhere.", "short_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cookclash.com/game_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://www.cookclash.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9634312096687345"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "
ro3Q8&_nc_oc=Adk7-DQaBgs__7l30ZJiBUQ00fiA_r7MqA8YgT2RmYVPp9rgqBzYA_CAPzvsNWNgnhI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuDLNNLwgSuSTMG2ThXPNotKONVOkdE4WCiYjVILJhURw&oe=699996A7"}, {"file_name": "Screenshot_5.png", "id": "1433734251391042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821784_1433734254724375_8033982263853796036_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z1yGGnHZ80QQ7kNvwFGAAc_&_nc_oc=Adn31Mqm4-9Lb32VivY3b-z8YrMeE99PT1Xur-kLFn2ZiWOsMgg2TEQ2GTRXx9cIHu4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs7xmDca5Tbrn28H4KjJ3RYJzYkC7GrL8DqyCfS53j1Yg&oe=69998FCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cat_2560x1440.png", "id": "1188224326044423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822559_1188224329377756_9071464048390316677_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUvcm0vzBNYQ7kNvwH2MvLI&_nc_oc=AdnY_uHW4B0cVjcP9y8QSm556OhJoalrhZUYsSImO9HLjhMTXs3M7d8-Ww5hntYp_ZI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftZrDs9_vtDYrAzC4bROajOiQyEbgyqNqfAbHToyir6vg&oe=6999B8F7"}, "display_name": "Cat Cafe", "keywords": ["Cat", "Pets", "simulator", "sandbox", "Animal"], "long_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities. With a fully physics-based animation system, our virtual cats exhibit realistic behaviors and interactions, responding dynamically to your every action. Each cat has its own distinct personality traits, such as being playful, shy, affectionate, or mischievous, and autonomously selects behaviors based on their current state, traits, and your interactions.\n\nEnjoy complete freedom as you explore this cozy cat paradise\u2014feed your furry friends, engage them with playful activities, or simply enjoy their company. Be mindful, as your actions directly influence their moods and behaviors, creating a uniquely personal bond. Whether you're seeking relaxation or playful mischief, Cat Cafe offers a lifelike and endlessly entertaining VR journey for cat lovers everywhere.", "short_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cookclash.com/game_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://www.cookclash.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9634312096687345"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "33013333968313955"}, {"status": "PUBLISHED", "id": "1957798531618254"}, {"status": "PUBLISHED", "id": "852817247913627"}, {"status": "PUBLISHED", "id": "1060481699586662"}, {"status": "PUBLISHED", "id": "625455327218170"}, {"status": "PUBLISHED", "id": "1363853434851705"}]}, "baseline_offer": {"id": "1363853434851705"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771005600, "status": "PUBLISHED", "id": "33013333968313955"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25220654110959892", "version": "0.0.22"}, "id": "2007101873032187", "channel_name": "LIVE"}]}, "is_for_oculus_keys_on
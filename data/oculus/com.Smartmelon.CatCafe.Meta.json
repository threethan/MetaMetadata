1824592_985744247085592_8588943664061122494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxH7TO0_mJsQ7kNvwGEUAR7&_nc_oc=AdrlVFg0AXwn1Wl8X8kicrb6ZawSjuIy4CG9XXD8DYXaWp9oc6sI-YgYvQhl47ZnIy8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVQgEULL1Pyd_Ufl0Gb-OkNwAgMFptQx-vAssdAzD1_Q&oe=6AF71AD6"}, {"file_name": "Screenshot_4.png", "id": "914799184027185", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825091_914799187360518_8621325599848622444_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zce9QcRBGPsQ7kNvwFGfUKF&_nc_oc=Adqtbk1fe9re4xJhIM1WzU5u5Li3aaRG4c79sy1NQYcBNsWvYy_C3-j4avnFcHMoud8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQf7BrxSdluUue2opanfBMNAiGIfgMlRPrqzeKSw1yCUg&oe=6AF72C67"}, {"file_name": "Screenshot_5.png", "id": "1433734251391042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821784_1433734254724375_8033982263853796036_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hI_-CfKxA9EQ7kNvwEnMqMm&_nc_oc=AdoPeyT6sm859lGGq6tKfgq3VLWWfbKqJCKAFAwGaQV7Lkmi2jtdr_PhgaIAQSbeg7M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQm5m5iWGMzgisFkcrojLwtAN9GoXIMt0rQ0JI0t0a7SA&oe=6AF7258A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cat_2560x1440.png", "id": "1188224326044423", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822559_1188224329377756_9071464048390316677_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LEbOBK0QLYQ7kNvwG_6TFI&_nc_oc=AdpbLlDP0kwyz9AQKMXMduiciZRjJQMrs4b5XQaxVGfes8gGi5khP9Pt01T4h-5sRjg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNYTrLxair9T01lk4X2T-mVoqXy_zWbNhPV7DFS1ebmA&oe=6AF71677"}, "display_name": "Cat Cafe", "keywords": ["Cat", "Pets", "simulator", "sandbox", "Animal"], "long_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities. With a fully physics-based animation system, our virtual cats exhibit realistic behaviors and interactions, responding dynamically to your every action. Each cat has its own distinct personality traits, such as being playful, shy, affectionate, or mischievous, and autonomously selects behaviors based on their current state, traits, and your interactions.\n\nEnjoy complete freedom as you explore this cozy cat paradise\u2014feed your furry friends, engage them with playful activities, or simply enjoy their company. Be mindful, as your actions directly influence their moods and behaviors, creating a uniquely personal bond. Whether you're seeking relaxation or playful mischief, Cat Cafe offers a lifelike and endlessly entertaining VR journey for cat lovers everywhere.", "short_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cookclash.com/game_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://www.cookclash.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9634312096687345"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1530733921868889"}, {"status": "PUBLISHED", "id": "2066469100799867"}, {"status": "PUBLISHED", "id": "3301
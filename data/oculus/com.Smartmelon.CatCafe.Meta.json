=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q56qF_lH_84Q7kNvwGeQdG_&_nc_oc=AdokqCrpj_XuILEauk734eOYrLc6W1yNWnr3tqWggy6EZtMyeKyJTUJaLvIdpaqMrVQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxuqjoNWmLuK6p6HWRvaanaSelW1KJFc5yabsNIVoa6fQ&oe=69C287CA"}, {"file_name": "Screeshot_4.png", "id": "749475594694178", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618254_749475598027511_6783824000723588972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxZ0KBDl9RwQ7kNvwHJ4IHn&_nc_oc=Adqpd6cDnWXBThtSNlF-8hpWbYAL-EKi_LdrQz36ziIqaATHf9SG9bwhlWej7GTWFOc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwDNX9DKMRzDIZ_Aipadh0yNXpIR_WQFxSjmYbN8kPMpw&oe=69C28CEE"}, {"file_name": "Screenshot_5.png", "id": "713453271396879", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491819476_713453274730212_7845404713817018470_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPZMI3g2xa8Q7kNvwE9ZBp8&_nc_oc=AdoTuY0h8kvw8rfOQckbpv54am4N92TgD2q-KohU_cca0_nUQ2yv7tiTV6JpveEELgI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWeFPYUp7z6G1Gz1UDJXlXIehswowTVbo_6N95TRLO6w&oe=69C26F28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cat_2560x1440.png", "id": "1444890606932880", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619697_1444890610266213_934929122431537399_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rw75Znu_Ih4Q7kNvwGajLX8&_nc_oc=Ado2_WChfRZxqVmIFEzP3L4EgmQ9CCTn4qMwRRlStBUAOwjKSZA6WPb5f5gEZr2j-SA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWdjDWQxyzdgu6OE4uTrdpGf6L3dNySd3oa3qUzB0XqQ&oe=69C28DD6"}, "display_name": "Cat Cafe", "keywords": ["Cat", "Pets", "simulator", "sandbox", "Animal"], "long_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities. \n\n \ud83d\ude39 **Cat Memes Come Alive**\n\nFrom the Spinning OI Cat to the Crying Cat, your favorite cat memes are hidden all around\u2014see how many you can spot!\n{1372492100461219}\n\n\ud83d\udc31 **Feel the Fur**\n\nIn Cat Cafe, every gentle stroke triggers lifelike feedback\u2014you\u2019ll sense the soft give of tiny muscles and joints, as if the cats were really right beside you.\n{1389394782078149}\n\n\ud83d\udc95 **Care and Cuddles**\n\nFrom preparing yummy kibble to washing a muddy kitten clean, every act of care deepens their affection\u2014and your furry friends will remember your kindness!\n{1407459710569238}\n\n\ud83e\uddf6 **Playtime Fun**\n\nWave a cat teaser, chase a mysterious laser dot\u2014each toy sparks your cat\u2019s playful hunting instincts and fills your moments together with giggles and soft purrs.\n{716976647361329}\n\n\ud83d\udd75\ufe0f **Discover the Unexpected**\n\nAnd there\u2019s so much more to discover! Come find out what fun awaits!", "short_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities. \nEnjoy complete freedom as you explore this cozy cat paradise\u2014feed your furry friends, engage them with playful activities, or simply enjoy their company."}]}, "developer_name": "Smartmelon Games", "developer_privacy_policy_url": "https://thesmartmelon.com/cat_privacy_en", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://thesmartmelon.com/home.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
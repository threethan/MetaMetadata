7f20f&oh=00_AQA37Ff0Mqdo0XvGDHFjW_DWAiOT4ZDwxk-3PQaqR3bnBw&oe=6A5789CA"}, {"file_name": "Screenshot_3.png", "id": "728240283357686", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623541_728240286691019_1059920376867982623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1Xe1xntl6YQ7kNvwHe4MXE&_nc_oc=Adpiex92b7nhZz25JQ-bq_OzmXr8FH8BO7srHM0g7FLH8HRecJdC5exKhsg3ecqAshU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8smMStbZnXckpDj0ktns-T_LJD0jx5augyqKDsP6qOQ&oe=6A57814A"}, {"file_name": "Screeshot_4.png", "id": "749475594694178", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618254_749475598027511_6783824000723588972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_vUXfAmsQgQ7kNvwERgm8C&_nc_oc=AdpqVq8SojUJw_tUUed-1NeHlgUjBCmGjAM7XpGV2R65H7qethpTZ2wKtXEDCxsvU64&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkOtoH9AF3V0Fb0F11b3P9Pr53ZNKxEevcFtoXjartxQ&oe=6A57866E"}, {"file_name": "Screenshot_5.png", "id": "713453271396879", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819476_713453274730212_7845404713817018470_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyUzPmV-PvEQ7kNvwF1T6lJ&_nc_oc=AdrSYAUWZ2vGclXWE4kdhW052B7hA4A7J3SHPMCFg3XzwfHc30FbbvG3NE_AxkXLggg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJ-X1bZBE6hRzgQNUim9MqNT5Wh5kK3IzuDiKstOGR_Q&oe=6A57A0E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cat_2560x1440.png", "id": "1444890606932880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619697_1444890610266213_934929122431537399_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaceF9DSxOgQ7kNvwG2cDeF&_nc_oc=AdqRCyF_XLrqKuoybk_ywOP0fO0ZelXUm10kdL_6LagOZgZoFs0aZIgkTYhaoRQT58o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8mumZ6mC8HoEUJ31-PClqvLWYkE-ZkrcdyUvfYYaRig&oe=6A578756"}, "display_name": "Cat Cafe", "keywords": ["Cat", "Pets", "simulator", "sandbox", "Animal"], "long_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities. \n\n \ud83d\ude39 **Cat Memes Come Alive**\n\nFrom the Spinning OI Cat to the Crying Cat, your favorite cat memes are hidden all around\u2014see how many you can spot!\n{1372492100461219}\n\n\ud83d\udc31 **Feel the Fur**\n\nIn Cat Cafe, every gentle stroke triggers lifelike feedback\u2014you\u2019ll sense the soft give of tiny muscles and joints, as if the cats were really right beside you.\n{1389394782078149}\n\n\ud83d\udc95 **Care and Cuddles**\n\nFrom preparing yummy kibble to washing a muddy kitten clean, every act of care deepens their affection\u2014and your furry friends will remember your kindness!\n{1407459710569238}\n\n\ud83e\uddf6 **Playtime Fun**\n\nWave a cat teaser, chase a mysterious laser dot\u2014each toy sparks your cat\u2019s playful hunting instincts and fills your moments together with giggles and soft purrs.\n{716976647361329}\n\n\ud83d\udd75\ufe0f **Discover the Unexpected**\n\nAnd there\u2019s so much more to discover! Come find out what fun awaits!", "short_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities. \nEnjoy complete freedom as you explore this cozy cat paradise\u2014feed your furry friends, engage them with playful activities, or simply enjoy their company."}]}, "developer_name": "Smartmelon Games", "developer_privacy_policy_url": "https://thesmartmelon.com/cat_privacy_en", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://thesmartmelon.com/home.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "int
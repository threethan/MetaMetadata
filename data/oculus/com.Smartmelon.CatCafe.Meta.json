_oc=AdqiF_SlNbU4F8-Uj0rkJmJ02hwNmRfD0_1hwx9PEXSgG7Wk2IaGvVAFsrbZOfr0c2Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhqQ7l8ohEsm3Co1HewCkzWRIU8P0Y0GhVzpUMD4JvzA&oe=6ACE690A"}, {"file_name": "Screenshot_3.png", "id": "728240283357686", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623541_728240286691019_1059920376867982623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5vpM7jMtH4Q7kNvwGVDII8&_nc_oc=Adpx3PNLc42CSX52EUCxrF_1r7fFDGW-acvaZULSO5yU_kehxo3hPVpamITFcKHzGms&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-K80qOf7ebakp4vVB_CoI21Lrbv1bc7snOEgM5zvcMw&oe=6ACE608A"}, {"file_name": "Screeshot_4.png", "id": "749475594694178", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618254_749475598027511_6783824000723588972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rhvInebr7kQ7kNvwGjUW07&_nc_oc=AdqHZhQjv7TGGW19Qc2Wv9xYK0aK-C0UJXH96MiTn2SMLyOhaKq0dZntxZA6YraeOCQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIIbvYUe8QrGtkGvCOwP7Q5oddpZXp-GF8uiNpnkT_rg&oe=6ACE65AE"}, {"file_name": "Screenshot_5.png", "id": "713453271396879", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819476_713453274730212_7845404713817018470_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BA64SOKUXqIQ7kNvwEXB2gL&_nc_oc=AdpAjiSRml4s5wytEP6zhpZ32KVyu_Snz8exLR-KaUztw2zF50mtiByonFMjJ-Q5mU4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCpHBQuvgzewJZdNB_tpFLytBAebbXPtCPitrYtNBWHA&oe=6ACE47E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cat_2560x1440.png", "id": "1444890606932880", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619697_1444890610266213_934929122431537399_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sJsxqoAv5QQ7kNvwGHQsp6&_nc_oc=AdrUll10cGgZ6TAVXot6J7IdUPgmPz990gp5XXQY2i4GkNjzWQrinMCSoA94W-_Uotc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOOhpEPFFWZP-FpsNWsldBCuV4DeXJVCMNBW_XsZVJzg&oe=6ACE6696"}, "display_name": "Cat Cafe", "keywords": ["Cat", "Pets", "simulator", "sandbox", "Animal"], "long_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities. \n\n \ud83d\ude39 **Cat Memes Come Alive**\n\nFrom the Spinning OI Cat to the Crying Cat, your favorite cat memes are hidden all around\u2014see how many you can spot!\n{1372492100461219}\n\n\ud83d\udc31 **Feel the Fur**\n\nIn Cat Cafe, every gentle stroke triggers lifelike feedback\u2014you\u2019ll sense the soft give of tiny muscles and joints, as if the cats were really right beside you.\n{1389394782078149}\n\n\ud83d\udc95 **Care and Cuddles**\n\nFrom preparing yummy kibble to washing a muddy kitten clean, every act of care deepens their affection\u2014and your furry friends will remember your kindness!\n{1407459710569238}\n\n\ud83e\uddf6 **Playtime Fun**\n\nWave a cat teaser, chase a mysterious laser dot\u2014each toy sparks your cat\u2019s playful hunting instincts and fills your moments together with giggles and soft purrs.\n{716976647361329}\n\n\ud83d\udd75\ufe0f **Discover the Unexpected**\n\nAnd there\u2019s so much more to discover! Come find out what fun awaits!", "short_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities. \nEnjoy complete freedom as you explore this cozy cat paradise\u2014feed your furry friends, engage them with playful activities, or simply enjoy their company."}]}, "developer_name": "Smartmelon Games", "developer_privacy_policy_url": "https://thesmartmelon.com/cat_privacy_en", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://thesmartmelon.com/home.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_t
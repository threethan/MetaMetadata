1824592_985744247085592_8588943664061122494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6OKdHlV4jYQ7kNvwG8KsiP&_nc_oc=AdqR-BzJf4lkDaMnGONqGtXtyu_fqQciitIp4epMUAv-upHq2G-z62rdplaY_cl3d8I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uFve7i-H9CIz-Jqbj0qfKYRlJTttvndQc6sXmj1C_sw&oe=6A412BD6"}, {"file_name": "Screenshot_4.png", "id": "914799184027185", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825091_914799187360518_8621325599848622444_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBZF3afsON0Q7kNvwE7y0iZ&_nc_oc=AdrxyKKC10VFMDsbFKArJhUGsr1UDPEGENfh1TyGx4p1xb1VkO02jn3NsSOcRo4eUb0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8AlCgUS7Y5JJcXNXCLDf5HyPNr2C1u1tzcbDKr3TxzA&oe=6A413D67"}, {"file_name": "Screenshot_5.png", "id": "1433734251391042", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821784_1433734254724375_8033982263853796036_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=or-pK_YSrsoQ7kNvwFb0YTH&_nc_oc=AdpzVp1SaQ0mqDeV_6uKXZX3pJGbT6VeoBQkvkmmCuW5_WefN7vzAAAyjD7F3x-6tDg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NO1JqRU10RG3oTHDX6vJfenRU7FFkj1uB0iqJuu2ERQ&oe=6A41368A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cat_2560x1440.png", "id": "1188224326044423", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822559_1188224329377756_9071464048390316677_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNb1yyYyU3sQ7kNvwGZ0-5l&_nc_oc=AdozR57QhXxOmNk70K6d6tKRiFE5JosKCuzAdofU3qnaQ_l6BgirmyPt0QlN8BH70n0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Pegh0wQwS7c9tWjfvjD55qj8js5aefwSxlhI7xWf8hw&oe=6A412777"}, "display_name": "Cat Cafe", "keywords": ["Cat", "Pets", "simulator", "sandbox", "Animal"], "long_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities. With a fully physics-based animation system, our virtual cats exhibit realistic behaviors and interactions, responding dynamically to your every action. Each cat has its own distinct personality traits, such as being playful, shy, affectionate, or mischievous, and autonomously selects behaviors based on their current state, traits, and your interactions.\n\nEnjoy complete freedom as you explore this cozy cat paradise\u2014feed your furry friends, engage them with playful activities, or simply enjoy their company. Be mindful, as your actions directly influence their moods and behaviors, creating a uniquely personal bond. Whether you're seeking relaxation or playful mischief, Cat Cafe offers a lifelike and endlessly entertaining VR journey for cat lovers everywhere.", "short_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cookclash.com/game_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://www.cookclash.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9634312096687345"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "2066469100799867"}, {"status": "PUBLISHED", "id": "33013333968313955"}, {"status": "PUBLISHED", "id": "195
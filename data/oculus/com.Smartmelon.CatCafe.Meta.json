=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVPvpKXWGWUQ7kNvwFtcaol&_nc_oc=AdpQ9u36Ui3nczkZhWn4Oji9gNFiad5OvCJP0qpv4saxg24ohlRinI6-jA6D_VwEvJU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzwoBBB_ZRkE2FdEdkwQSciMsRDbAbTQxxKg9uuf2NThQ&oe=69D1084A"}, {"file_name": "Screeshot_4.png", "id": "749475594694178", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618254_749475598027511_6783824000723588972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIRqEiBETmsQ7kNvwHEpeHK&_nc_oc=Adqb4R3cRFNAaIE7W-Ur8dq1lLqayVxjLx-kPowa3VkVcpraIqFJg6fTC4yvlr8WXTg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz4UvZ4uHr7SEqq5ltUNyOX1Oiwnu5UK868V1wtO3RHeg&oe=69D10D6E"}, {"file_name": "Screenshot_5.png", "id": "713453271396879", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819476_713453274730212_7845404713817018470_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZqqapx3GkAQ7kNvwF7VLUl&_nc_oc=Adol5gEbDGlKcf4e_lw07lYvfK2_fLLNJKApRJO46-eJvQ7OxUgrai_LbwWNrsfPEdo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzNtliE38Vi_aHutc2zsZ5ucE37GlhBrcCYeit1R-obmA&oe=69D0EFA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cat_2560x1440.png", "id": "1444890606932880", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619697_1444890610266213_934929122431537399_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9P-wG7mEYsQ7kNvwHLLp2a&_nc_oc=AdqygSgzc8_fJ1OAkPb3MPGPiqRgLACz26GblcCnaDCVU-CU3o8nzw6aFKaSGQYGTp4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx2xPANEpDuRrIKWGmk4IVFxHxo8RnoLsksS03hECN2PQ&oe=69D10E56"}, "display_name": "Cat Cafe", "keywords": ["Cat", "Pets", "simulator", "sandbox", "Animal"], "long_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities. \n\n \ud83d\ude39 **Cat Memes Come Alive**\n\nFrom the Spinning OI Cat to the Crying Cat, your favorite cat memes are hidden all around\u2014see how many you can spot!\n{1372492100461219}\n\n\ud83d\udc31 **Feel the Fur**\n\nIn Cat Cafe, every gentle stroke triggers lifelike feedback\u2014you\u2019ll sense the soft give of tiny muscles and joints, as if the cats were really right beside you.\n{1389394782078149}\n\n\ud83d\udc95 **Care and Cuddles**\n\nFrom preparing yummy kibble to washing a muddy kitten clean, every act of care deepens their affection\u2014and your furry friends will remember your kindness!\n{1407459710569238}\n\n\ud83e\uddf6 **Playtime Fun**\n\nWave a cat teaser, chase a mysterious laser dot\u2014each toy sparks your cat\u2019s playful hunting instincts and fills your moments together with giggles and soft purrs.\n{716976647361329}\n\n\ud83d\udd75\ufe0f **Discover the Unexpected**\n\nAnd there\u2019s so much more to discover! Come find out what fun awaits!", "short_description": "Step into Cat Cafe, a highly immersive VR experience filled with adorable feline companions and endless possibilities. \nEnjoy complete freedom as you explore this cozy cat paradise\u2014feed your furry friends, engage them with playful activities, or simply enjoy their company."}]}, "developer_name": "Smartmelon Games", "developer_privacy_policy_url": "https://thesmartmelon.com/cat_privacy_en", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://thesmartmelon.com/home.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
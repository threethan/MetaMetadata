t=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwp5hLpTDh7Tmfe-h5hl6dfXjmlFIG9Vq1U4R9gaIW4Gw&oe=69B02D6E"}, {"file_name": "loading.png", "id": "1433585068353253", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823757_1433585071686586_586921144329060395_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsNmrGsOrDcQ7kNvwHaseh3&_nc_oc=AdkxatJyxOFRgKxu6nvcLYgd2_Uuusd4KmdO5Ce7MajkykKk_PvV0lmuCzZxpQXv9yc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxUF7xr4tEx14OFnMw4Hbid1j7CJd_lEMgm35H1Fjfq1w&oe=69B0262B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Earth from a Space Station", "keywords": [], "long_description": "See Earth as astronauts do \u2014 a WebXR experience from the International Space Station (ISS) or the Chinese Space Station (CSS/Tiangong), orbiting in real time.\n\nLook down at Earth from the International Space Station or the Chinese Space Station as they orbit in real time. High-resolution NASA imagery shows daylit terrain and city lights on the night side, with a realistic atmosphere visible at the horizon. The Moon, five naked-eye planets, and thousands of stars are in their correct positions. You can also observe a close flyby of the other station, visible as a bright point of light \u2014 just as it would appear to the naked eye at orbital distances.\n\nTwo camera views are available: forward and straight down. Points of interest \u2014 cities, mountains, lakes, rivers, deserts, islands and more \u2014 are labeled on the surface ahead of the station. Country borders, names, and flags are shown for all 195 countries (193 UN member states and 2 observer states). A time offset lets you rewind the simulation to see where the station was in the recent past. A heads-up display shows latitude, longitude, altitude, speed, and the country or sea below.", "short_description": "See Earth as astronauts do \u2014 a WebXR experience from the International Space Station (ISS) or the Chinese Space Station (CSS/Tiangong), orbiting in real time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://earth-from-ss-in-vr.metebalci.com/privacy.html", "developer_terms_of_service_url": "https://earth-from-ss-in-vr.metebalci.com/terms.html", "publisher_name": "Mete Balci", "support_website_url": null, "website_url": "https://earth-from-ss-in-vr.metebalci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26172579069062401"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823905_870958435931565_655644739310920283_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GjXHE-PBxQQ7kNvwE6KWOE&_nc_oc=Adksjkh0FF8LDgufk0e0CdDewLxLreQsYkb3dExIfkUIL1G1I8MHq_cClmHVhEkhl_M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFAOb_i5o4_uOzH3yhcakuKkgjbSYN15vXts9H2MTINg&oe=69B02605"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Earth from a Space Station", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1771514580, "lastRevision": {"nodes": [{"id": "26142048728782102", "release_type": "SCHED
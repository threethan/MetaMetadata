g?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14fK9w4d9lEQ7kNvwEvBgMy&_nc_oc=AdpOizAATwhxFp3Yv3_3a9MKKoxs-4Y8-fr7uMx9_1uEK5VD-MsTcrjK-55MJtBF5QU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSkGX-yzJKWWaw70pGvMgG5h7sNGKQ5v0u7pfG7SVXWw&oe=6AA2BE6F"}, {"file_name": "com.eldc.fior-20260428-162347.png", "id": "942802148659965", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623585_942802151993298_5381765046513508414_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0AK0K_TpVcYQ7kNvwGQ8Fls&_nc_oc=AdrPWCQH2Zk0R82YSK_qrXo1y3fJPvyIo7sPcM69gC3T9k9P6c2SG6trvgH8oP5auKM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVXaIkOnKJ2CYk2-kyLkZwy5cxlEk37HWnLoZsfdoWHQ&oe=6AA2B52F"}, {"file_name": "com.eldc.fior-20260428-162205.png", "id": "1302160875216459", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312338_1302160878549792_8261424249192903347_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qy8kEX7RUQQ7kNvwEFOCYX&_nc_oc=AdoT7UMXYNiK_FNSWn5Z4DnvWIwEse8hvxh50ZK7F332vp9pdIWOTwX1bldwh6fVhBo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4Y_4FRAG8I20-ESw30ZSfbRg31SwnhfYdeUhYR3Uxpg&oe=6AA2C418"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fire in Operating Room", "keywords": ["fire", "operating", "room", "vr", "medvr"], "long_description": "Fire in Operating Room is an immersive VR training simulation designed to prepare healthcare professionals and students for one of the most critical emergencies in a surgical setting. Step into a realistic operating room where a fire incident unfolds, requiring immediate action, clear thinking, and coordinated teamwork.\n\nUsers will learn to identify early warning signs of fire hazards, respond using proper safety protocols, and manage the situation effectively to ensure patient and staff safety. The simulation emphasizes real-world procedures, including fire risk assessment, equipment handling, communication, and emergency response strategies.\n\nWith interactive scenarios and guided learning, this experience enhances situational awareness and builds confidence in handling rare but life-threatening events. Ideal for medical training, safety education, and skill development in a controlled, risk-free virtual environment.", "short_description": "Experience a high-stakes VR simulation where you learn to identify, manage, and respond to a fire emergency inside an operating room. Practice critical decision-making, teamwork, and safety protocols in an immersive medical environment designed for training and awareness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "26711285045178975"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "986804587441719"}, {"status": "PUBLISHED", "id": "1268995262071987"}]}, "baseline_offer": {"id": "986804587441719"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781268120, "status": "PUBLISHED", "id": "986804587441719"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2674531715510909
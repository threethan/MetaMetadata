g?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCnfpPoo5HwQ7kNvwFkdQAP&_nc_oc=Adq23_02KLFupW6nvTBQc_ri8ynPiIdgz0YoW6fJAKSeUqRQt2L9NKpXamGyPAVLda0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4AYC2Z--X7rI1N7CY4Mh1ZhG2t48yjZAgJbYwz7dHKw&oe=6AD385EF"}, {"file_name": "com.eldc.fior-20260428-162347.png", "id": "942802148659965", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623585_942802151993298_5381765046513508414_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ljxdtfch3WoQ7kNvwEHQddw&_nc_oc=AdpF2eF4p4HESIKNoUP7cqbnF0zSN6VnIw1XDPWOEv-90EwiV7GvdHrOi8fYLj07jZo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN49nF4rRgUbf_fe61kBxylyv2jQeDVcfvW97-2KAYRXQ&oe=6AD3B4EF"}, {"file_name": "com.eldc.fior-20260428-162205.png", "id": "1302160875216459", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499312338_1302160878549792_8261424249192903347_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9R2m9OenULgQ7kNvwGFEc7O&_nc_oc=Adq1vW0NBaUVkrYZZjrP29XatKknf-xt4v2K17OlFspIATyDZ3jJCW4YK3Gc0omoyto&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM12VAOyW-BZC8sawMg84YZuCgDyIZLkCx6qdGRkKEzAQ&oe=6AD38B98"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fire in Operating Room", "keywords": ["fire", "operating", "room", "vr", "medvr"], "long_description": "Fire in Operating Room is an immersive VR training simulation designed to prepare healthcare professionals and students for one of the most critical emergencies in a surgical setting. Step into a realistic operating room where a fire incident unfolds, requiring immediate action, clear thinking, and coordinated teamwork.\n\nUsers will learn to identify early warning signs of fire hazards, respond using proper safety protocols, and manage the situation effectively to ensure patient and staff safety. The simulation emphasizes real-world procedures, including fire risk assessment, equipment handling, communication, and emergency response strategies.\n\nWith interactive scenarios and guided learning, this experience enhances situational awareness and builds confidence in handling rare but life-threatening events. Ideal for medical training, safety education, and skill development in a controlled, risk-free virtual environment.", "short_description": "Experience a high-stakes VR simulation where you learn to identify, manage, and respond to a fire emergency inside an operating room. Practice critical decision-making, teamwork, and safety protocols in an immersive medical environment designed for training and awareness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "26711285045178975"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "986804587441719"}, {"status": "PUBLISHED", "id": "1268995262071987"}]}, "baseline_offer": {"id": "986804587441719"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781268120, "status": "PUBLISHED", "id": "986804587441719"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2674531715510909
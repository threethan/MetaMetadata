iX97fWmLfrjRDqZKJmVMNzT0FHMjaA&oe=6B0DB4BE"}, {"file_name": "com.eldc.fior-20260428-162411.png", "id": "1741987323849570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307954_1741987327182903_8458144387769303032_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sp83UOfFtZgQ7kNvwFEUTqG&_nc_oc=AdqubR-jtkZdDHQ9l6x0AoJiuTFd29tf5Y3ekw1SNP7NGqRSdrINO_PYBDVHSNjQAD8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQXX_iQ0XLPlfaZl5xKbiNBhbcBN0-TgItX2WzHVhbrFA&oe=6B0DC02F"}, {"file_name": "com.eldc.fior-20260428-162347.png", "id": "942802148659965", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623585_942802151993298_5381765046513508414_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zuU0SwPlE78Q7kNvwGosCwb&_nc_oc=AdrjBF7BaG0bKYGobtSxPJHDSQS8Tcyr9bioIeR-QGJSRgvEl-qVREFAtbq5O5XbCM4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ0oaFc88tqLYoOWUioR0rbeeQOCZOiK2PxKG9flGYukA&oe=6B0DB6EF"}, {"file_name": "com.eldc.fior-20260428-162205.png", "id": "1302160875216459", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312338_1302160878549792_8261424249192903347_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OyXJM35rTT0Q7kNvwHpOEg4&_nc_oc=AdriS_nqDR9MQVjnyCiF3ofDXWrNruPd03qx6DcF2Z5L243qB3f4Tw6xNhMMaCN9leI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRVOPoOqyk7YqeiqM6Cffn3XTiVT5vEswd18CmfatTfwQ&oe=6B0DC5D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fire in Operating Room", "keywords": ["fire", "operating", "room", "vr", "medvr"], "long_description": "Fire in Operating Room is an immersive VR training simulation designed to prepare healthcare professionals and students for one of the most critical emergencies in a surgical setting. Step into a realistic operating room where a fire incident unfolds, requiring immediate action, clear thinking, and coordinated teamwork.\n\nUsers will learn to identify early warning signs of fire hazards, respond using proper safety protocols, and manage the situation effectively to ensure patient and staff safety. The simulation emphasizes real-world procedures, including fire risk assessment, equipment handling, communication, and emergency response strategies.\n\nWith interactive scenarios and guided learning, this experience enhances situational awareness and builds confidence in handling rare but life-threatening events. Ideal for medical training, safety education, and skill development in a controlled, risk-free virtual environment.", "short_description": "Experience a high-stakes VR simulation where you learn to identify, manage, and respond to a fire emergency inside an operating room. Practice critical decision-making, teamwork, and safety protocols in an immersive medical environment designed for training and awareness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "26711285045178975"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "986804587441719"}, {"status": "PUBLISHED", "id": "1268995262071987"}]}, "bas
.com&_nc_ss=7f20f&oh=00_Af_2mwmOWkG3_c-cLN1RBcnObEWkDMGh2E2EYl5nivTOag&oe=6A296B2F"}, {"file_name": "com.eldc.fior-20260428-162205.png", "id": "1302160875216459", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312338_1302160878549792_8261424249192903347_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e78yXN9uOlYQ7kNvwEzbXt9&_nc_oc=AdoAPT3ycb-JTSSQhE9Td2I9DRB1MgGceGXxSNww36wmxSt8ukwMzoqoQU3eqbzUy50&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ddWuqq7k3T7A8IDSQP-umsQZbsPatZEGxzhJUZLFn5w&oe=6A297A18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fire in Operating Room", "keywords": ["fire", "operating", "room", "vr", "medvr"], "long_description": "Fire in Operating Room is an immersive VR training simulation designed to prepare healthcare professionals and students for one of the most critical emergencies in a surgical setting. Step into a realistic operating room where a fire incident unfolds, requiring immediate action, clear thinking, and coordinated teamwork.\n\nUsers will learn to identify early warning signs of fire hazards, respond using proper safety protocols, and manage the situation effectively to ensure patient and staff safety. The simulation emphasizes real-world procedures, including fire risk assessment, equipment handling, communication, and emergency response strategies.\n\nWith interactive scenarios and guided learning, this experience enhances situational awareness and builds confidence in handling rare but life-threatening events. Ideal for medical training, safety education, and skill development in a controlled, risk-free virtual environment.", "short_description": "Experience a high-stakes VR simulation where you learn to identify, manage, and respond to a fire emergency inside an operating room. Practice critical decision-making, teamwork, and safety protocols in an immersive medical environment designed for training and awareness."}]}, "developer_name": null, "developer_priv
591", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827046_1847193152802924_1916133089747068590_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z96nvG14KdAQ7kNvwFQ8tRK&_nc_oc=AdpuEY6Wr92FzAUprjndp8WzrGY42tVo0lDdlA50nL3AKoDZkIslAs4Rb6eUItXuEBg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJo2xckdUywvtj1ZQNhCIE_qiycMQk7gyaJ1bXv0TvpYw&oe=6AAFEFDF"}, {"file_name": "2560x1440.png", "id": "668518512565632", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828837_668518519232298_4456767759610879531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_hoU25p0qcQ7kNvwFmjHKn&_nc_oc=Adp9uEIe6F_fwm2wxX0tgU-x85-utUHvWKhMiqHZm1BwTJu2v6zWpIg_dTo47R1ilmc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgOSWGJNnetRyEoIcUSTf50tqw23sVUFkuB0hPXEz9DQ&oe=6AAFD8D8"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdWG2rivVGcQ7kNvwEHIm8K&_nc_oc=Adq2Oq4xrjxfvX_ZMKQjZaLkzrEwbX5Vu0JTz57t9LDcn_82AfXGBr2Wo842anqPguM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLK5ePOGS_BAMhVrodjFTQPr1yZ2fiW_tJN5NmljGrihA&oe=6AAFE1C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaVts8NpbKEQ7kNvwGlqHKK&_nc_oc=Adr4zzwJxuKxa1vP_dJyU8PjxYHAlEOAEiREJOqexA3b3fCBS20cwsK1UiuvEay1nkA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUKpfclCBEQ73yt8ICh18RMLNE3_JFZGBB5baWCj2i-w&oe=6AAFD58A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_of_service_url": null, "publisher_name": "Mastery Augmented", "support_website_url": null, "website_url": "https://www.masteryaugmented.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9895615000505983"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820354_1875368689922637_8999221336170309456_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxVgu8wt-N0Q7kNvwHUanGl&_nc_oc=Adrf3LsjNCXnYOS49SrHWFomSh2-TJOcg3YUFWosSl_uLqzVXHh4XPea96LRW2ug5Uc&_nc_zt=3&_nc_ht=scontent-
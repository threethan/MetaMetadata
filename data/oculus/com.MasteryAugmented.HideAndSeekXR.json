591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827046_1847193152802924_1916133089747068590_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRRXKvMcUjsQ7kNvwGYU6Pi&_nc_oc=Adr4CeUG5LC4PJDD4eWfdahpwk2jJAwE5FARn2TuOxtcg7D1hNr49GQvEpftSLcFehw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41as7ZTpRdTv-W1pO2pa_Xfa41Gq0rIrt8dRYYLwjvEQ&oe=69FCA3DF"}, {"file_name": "2560x1440.png", "id": "668518512565632", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828837_668518519232298_4456767759610879531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rm55rZvX_UcQ7kNvwHu0CO1&_nc_oc=AdrkuJhfI8tqBa81uvFrZxRQxwkw--STM_kVwi7gNwNi-wMySv3thLCDa5Mhb2-X4Xs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NKXjQMYmDQ0cHUKQvuEuQDO6ecGt4Dvfhk2pi8kur6g&oe=69FC8CD8"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-_uRM8FkzAQ7kNvwFx2Vn1&_nc_oc=AdoYUtaU_1ROSdJYzJiRLTp9DKEGWa9eeud25tlnG_WSNZ6bIz4hpWJ_AK-hKIZYG1k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60OMu2WyDfT01ZFrHm7LJBj61R-AiEmVsWMqGL2i6BJg&oe=69FC95C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ev2PQFOO_zQQ7kNvwEqlR-1&_nc_oc=Adr3j8l9GEhGPMIH-wzRZUqp6U6SS2hDRaC61K0mHjgqMcVSd2L05wqs7ZvUuNncZug&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LBKfgaHj6aDuHnsrmVZ4T6AjYe5RjPiKyrsYbLDnA7w&oe=69FC898A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_of_service_url": null, "publisher_name": "Mastery Augmented", "support_website_url": null, "website_url": "https://www.masteryaugmented.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9895615000505983"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820354_1875368689922637_8999221336170309456_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3CBcbBzyEIQ7kNvwHcb4RI&_nc_oc=AdoPE2Z7I5_iDIvNszXCHf1YDpGW2Z5FAlmqYh56z8iPu-R51GuheCOtnWelHYjZyHo&_nc_zt=3&_nc_ht=scontent-
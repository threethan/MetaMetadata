591", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827046_1847193152802924_1916133089747068590_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DC4OsqyXB64Q7kNvwGxp8nv&_nc_oc=Ado-C0funYdpAQIlNkZVwd1aguQRRBqGVZvtewbNA-oECrvAzNg680tFGuRF0W01Jtw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBHMf0Yo-1ieLJPqWGu90IL8WTrns9q--IzPSMZ355FQ&oe=6AAD4CDF"}, {"file_name": "2560x1440.png", "id": "668518512565632", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491828837_668518519232298_4456767759610879531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15S726ymgnkQ7kNvwG4N1xl&_nc_oc=AdrAgUp9ADUiWQHfjz_7S6zoZvkEB3-0h90Hw_1oo9tRzHo0K1yWg88Ly6yzR1_U9TM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEnuK1uQnap0Ah5BZB3F_U1eqZF3AOu2qXQnUwZqneMQ&oe=6AAD35D8"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdWG2rivVGcQ7kNvwFWzil_&_nc_oc=AdqBt5jKUopzY3vcoIlwFzrWunftacI0RhtcGcJDFNeVfK9q6cHPNI8Dr8suj-1S7es&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsO_r-Z5HKCki6EifQlPAFeR2clJI4FZ2W8S3ZORNiyg&oe=6AAD3EC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsDg3rDHmwcQ7kNvwGPWWsP&_nc_oc=Adqye4eWfLAy8BHkbu6PaF9rW7UVr3PzVS1jC4JTWOV8WpWHzjADOPASOFxJ8BS_GCk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMbNDwBE75QEZfmvdJZN5uo5lIpwCviNyoeWtnZwc0Rw&oe=6AAD328A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_of_service_url": null, "publisher_name": "Mastery Augmented", "support_website_url": null, "website_url": "https://www.masteryaugmented.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9895615000505983"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820354_1875368689922637_8999221336170309456_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kRNIk6QnzAQ7kNvwFg0cu2&_nc_oc=Ado9hSI0aBMot1NFWx1oJrfGLrimU0iGRtwOCzbTV-tAAdebbChjOpRf36-z35SLVOw&_nc_zt=3&_nc_ht=scontent-
b0zFKqW6i_Fn7W_sRqL1QJjrBBDGaE4Omqcfiww&oe=6A37E058"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IUL1GIGw3oQ7kNvwF5kJVP&_nc_oc=AdoZ8Vv4v2B8xFja0mNZODh8UIHoKyJQS1kS4PN5ycySFPsd5c1zWWeFCePL9XafyAA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XgkDdvkkSoSha-ISuaqIPuk08hatzb6leR4jNDWR2Jw&oe=6A37E945"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dj2nm8IFqsQ7kNvwH0zuvr&_nc_oc=Adp1fEZR9zKI3GrcsmzPvYjG2LXgQycR1Aa8DfvrTgKG7X56LpJreRN-MDTztKXYCi4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bKJ9OOA28di8KRp8g8_VwhrPYCZ36pxYEe9LykT44ZA&oe=6A38154A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_
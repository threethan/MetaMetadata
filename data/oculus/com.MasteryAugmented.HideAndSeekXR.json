591", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491827046_1847193152802924_1916133089747068590_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Y0kWmaRVEQQ7kNvwGKwgz9&_nc_oc=Adqq6NWSAMoAbT5KHuChdYSyhIhW64_wLf1NxRhsk1FBCTGx7CKUMutseeBb3uzHWhg&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0e0-Ayq9jbduIi8n8tVQL8__JtFOEd8cTXeNtxTbMkHg&oe=69E245DF"}, {"file_name": "2560x1440.png", "id": "668518512565632", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491828837_668518519232298_4456767759610879531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jF2wYbrEBOEQ7kNvwHDkPT4&_nc_oc=Adqp44d4wu22AV8rcgbfACKDzFC4p4taXqqX0b-9RPwWLxg3fnoCTOjnDrCF80m5YS0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bawr3b8_w79vvIjKCmc3OBWKC6G5-F9C0wHKLMToGpg&oe=69E22ED8"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1cDKxmOaLcQ7kNvwFWOI-r&_nc_oc=AdqjaJ5BKW6RVB9bwaLAhCE5acHG8_M1gDjBeCE8QdR1fGD6wM3uywO5EAd3LrTzQjY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af113rb-47sU1_qWRVJeyRLLoboWKZoR1pCsYtTYis2bDw&oe=69E237C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsVj3w4DazwQ7kNvwHua2P_&_nc_oc=Adp4ZVRgSu2P15dpZRC82Vf_IXj1gO4Q0G6uuRZjQnfBwSSbZp5koVmQVwbiqePMp1o&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MJc_opGXzmKaDU8ZeB2JeWloMmPpaZROqh_fC7EOG3A&oe=69E22B8A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_of_service_url": null, "publisher_name": "Mastery Augmented", "support_website_url": null, "website_url": "https://www.masteryaugmented.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9895615000505983"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491820354_1875368689922637_8999221336170309456_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujBGey3__sUQ7kNvwGjE_2x&_nc_oc=Adq2mm8O7xh6Z0Z2oyh1vb8SDt46JZWPxnCp7kJct2pAd0yjN88Bym4T1ZcMzjToWKI&_nc_zt=3&_nc_ht=scontent-
591", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827046_1847193152802924_1916133089747068590_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkqbzgTK5ksQ7kNvwFzTw_c&_nc_oc=Adocdq8UJFboxJDh089euBVD-D-NTi3RVM_PdjOhG-yIiW3uVQf1WuDngIYZBkYlG0I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCS29So4sHrC5RAeoJkDmn9W9253oJmVcOJehMiXNdOrA&oe=6A53A6DF"}, {"file_name": "2560x1440.png", "id": "668518512565632", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491828837_668518519232298_4456767759610879531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bh9lLVsYHsQ7kNvwGTxFfL&_nc_oc=AdrQg7mUKtuoXT9t-Gi9ZfKOVTy-d4daP6Q5nwhCVuLe7Rb8FYb3wKRrm84BTDnOM-I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLxPSJ2FEEf_SofEVbs082EeyGFMFaOvMkv8Vc9pXBjA&oe=6A538FD8"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfQV7f1IcU4Q7kNvwH9xDU5&_nc_oc=Adpq6FiH4FvfuLuJn_wHPskuAiJLNB7zqcr0Fge3tXaO2INRhxcqSEzcF7LFvZMZfuo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBv87AblgqN4R6ChuufjdiaNNILZ8svMZMZKFWdy8arqQ&oe=6A5398C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-U9WxzbkpYQ7kNvwHFYi6P&_nc_oc=Adr3GDp41NE2U5jdHtqPL6Vwj6onUnq_6QNJDzTsqWw4cadeptOh-AoVKI9hfGMzOvc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjuV13M3xsn51HcDqu5JB7UrOSlBj2pCssD6NT6Fe-LA&oe=6A538C8A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_of_service_url": null, "publisher_name": "Mastery Augmented", "support_website_url": null, "website_url": "https://www.masteryaugmented.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9895615000505983"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820354_1875368689922637_8999221336170309456_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hp2wkP8r364Q7kNvwEMGs2P&_nc_oc=AdqAJnCD4hUoxwOz7GY9zsCqz-3UtSyDi6OPQGSe5mZ3dUCEYkAuNmtBg8QwBQdm1iI&_nc_zt=3&_nc_ht=scontent-
591", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827046_1847193152802924_1916133089747068590_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u07asKQWkvQQ7kNvwEUyfz8&_nc_oc=AdpsKGRSo3P5o1Y7VVn5mYVmKsiowvng8SyiqQXoE14SPwKDQXXBMza2QBQ-9BYVuMI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ypQpGunMvN6P3-IISLTV1VjkliD1HsEuZkcAdLsOu1g&oe=69D90B5F"}, {"file_name": "2560x1440.png", "id": "668518512565632", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828837_668518519232298_4456767759610879531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXvj9X_TzMgQ7kNvwEjePtb&_nc_oc=AdoM9Ns4EpHQyBk_L1_qYAN3CuOsDK-C1t0fq8mHqp-edx-XXCfQ06FHfuBw1wuKM-0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22nnAQj0wL5uC39aXVPRHgIwh-aRm4fOZt-M4FUWQ24Q&oe=69D8F458"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prSeqvTGnUIQ7kNvwFhgNOq&_nc_oc=AdrZZ9NJKYvHmqNf8Ywn9rjDcml_SJqQDTMGCcyc7gBycB9jjJRTTuUNxm5IAamsqxM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oT_Y548XuKfYW9XxbODUMowRkbRIB3cZuo3RXBuO3Dg&oe=69D8FD45"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YMGmOlmbTM4Q7kNvwEtFukl&_nc_oc=Adq4UfU6HZ6FpG9G3ZnhfDaCF_Tjd2haoEgk1afM63_GSccVqd6u2O05nFyFLHpBD0E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Gd2siqQVBcht4hSFYpWgV4-sqebDAHKkITZctMRGPDQ&oe=69D8F10A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_of_service_url": null, "publisher_name": "Mastery Augmented", "support_website_url": null, "website_url": "https://www.masteryaugmented.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9895615000505983"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820354_1875368689922637_8999221336170309456_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0DLKVWYRCggQ7kNvwGLCCZz&_nc_oc=Adot1tlGvdhxmTNiZv4SNzxrOmxT5QVqFy-EZtW1Me6jMTTgD7yxzx2TaHPvTXjw4Qc&_nc_zt=3&_nc_ht=scontent-
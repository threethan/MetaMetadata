7Gs7IHKP5AGG-dDjYDJB7Lh6_GgZw3xZJ0YExcQ&oe=6A6361D8"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bM541AzvciQQ7kNvwGjdWcp&_nc_oc=AdpWul3PoFxtWS3x8bxnFWR7dfQ7yDAzD71zhfYa_eyfDW2myhdtxMqVIKq-hke-79o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfsKNFtZtCHte3OTw9_mpuArytw9FDjD6CMqAAuVDhSA&oe=6A636AC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RedJKwRL9NQQ7kNvwHgivey&_nc_oc=AdrGTorACUIfeZ6SHtBSm5j8f3nwcVLZh59Hbik3Y3JiALBeqH5rF1i4zFNOqBe-4NM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA85AK9TeFhwVLZ6J9KJyJxT_F1bOwSv-apTIuxgJJpmg&oe=6A635E8A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_
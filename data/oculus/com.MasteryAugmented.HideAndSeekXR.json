1.oculuscdn.com/v/t64.5771-25/491827046_1847193152802924_1916133089747068590_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0U9YTNHpU4kQ7kNvwHzHAM4&_nc_oc=Adl_dPjJcWAFxKNRSKpYL_UH2tNv9_vM-X6eu5zHyMCYY5QYh0_FE57tk5JhlGOuGEs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzgOEDelhlum81I7xCqCQqbLW6xOS0WsHqwotvJ41VYCw&oe=69B92F1F"}, {"file_name": "2560x1440.png", "id": "668518512565632", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828837_668518519232298_4456767759610879531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sua413Do2-QQ7kNvwEcYjWq&_nc_oc=Adn4wlQr1UoId1JH3-3usony4qGmpJ9M_dgMCfycwTbo0kGPoEUuTxGGKOIuxcoZk-0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz27In7rspcFSN-cCgh5TpEbceW7o82rW0vb7j9BdHhGQ&oe=69B95058"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7AG5yo0DLQQ7kNvwGIALba&_nc_oc=AdmW-eog2QbJ0-hzlpijZbLLUWRL7hjjC4ld0kYxdG85_rpQqfCmLvcWjlnKsGcJ82s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxmmsvXorA8AT40_6HwX6tt4AwTY1UhdFbUPtf_4bMENQ&oe=69B95945"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yn9Wkfh7ot8Q7kNvwFUcjxN&_nc_oc=AdkiF8PgVOb9Upn5hSIufpaCBNUthEDcS_1LMRzd2qrjzFfWGFtUMkZlkU67Hbe_QbQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwKyq-_-4Xd8xGqA0yF2ePWTfpVqqu_x9IO2Wy6gUfmsA&oe=69B94D0A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_of_service_url": null, "publisher_name": "Mastery Augmented", "support_website_url": null, "website_url": "https://www.masteryaugmented.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9895615000505983"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820354_1875368689922637_8999221336170309456_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nHS0amER4gQ7kNvwF-t5Zy&_nc_oc=AdnUtfPwgxO-3Qtek1OzNAE34jTtCadFiIF0Cu1puusutN-H4ecJxq7CdQOyB37GOK8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzeqIjzHyb5H-4i
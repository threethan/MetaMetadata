591", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491827046_1847193152802924_1916133089747068590_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2kb1q1awfwQ7kNvwFq9wuM&_nc_oc=Adq1N7OBfcQDlkfRcLwt2pg4Ui9lLKMwukc5vpqbINKV6TXhYk0i0TITOx8g1XcL_2E&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Z_ESbW334mwRRTNIII5rXzLEysawQR2Tp9WYx0X1zIQ&oe=6A1AF65F"}, {"file_name": "2560x1440.png", "id": "668518512565632", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491828837_668518519232298_4456767759610879531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rV49U_0PDX4Q7kNvwEpJyZo&_nc_oc=AdqDc1PKtnKSmPb_PEZ-YKQ0ySj4ixy52_wbIzYb11uC5GQmjtl-bst8JPAN8SqVnvQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RMuMV3GS5csDjfTsIndtSoSrABucC4Pa5Fgl0oZPYuQ&oe=6A1ADF58"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXSsbbSOfzQQ7kNvwFCeJQM&_nc_oc=Adp892_JPMkGLuH8UrUaEJqvX6BRty1H79q7MEdv9V2nuaKetk7oGX37YsDOAtZXoO0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Vi8gKURlrLj8k8srmrKXx52GfBJ8ZEBZ58OR-GH8how&oe=6A1AE845"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDduKUaoEQUQ7kNvwEkIE62&_nc_oc=AdozBvU7GS4hHehEZ13u3J0dIuxZOFjvqDROwkQ_tCfMDLB1zhZSce86JWkiYjRb1IU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4J5-MB1DZ0MTFNxWyqgqsRfPHJfvpk8iKSkbDt4pH9CA&oe=6A1ADC0A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_of_service_url": null, "publisher_name": "Mastery Augmented", "support_website_url": null, "website_url": "https://www.masteryaugmented.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9895615000505983"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820354_1875368689922637_8999221336170309456_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sB1bYdvHYU4Q7kNvwFe4t6M&_nc_oc=Adr6bWURjPDAODTRjc_V_vF5WaPlaokp1s9Tcn_RJY7w3UsrU0mDDOiXNYFvhYaJ9iI&_nc_zt=3&_nc_ht=scontent-
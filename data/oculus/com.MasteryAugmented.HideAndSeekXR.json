93149469591", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491827046_1847193152802924_1916133089747068590_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8r5pEW1jG4AQ7kNvwFvq081&_nc_oc=Adpo3kFlFl6CD7td2KtsNz-EkyGl_dR0en7MOykpDb0RNTuG9ceZPJ7ZeUyjdbtfLmA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEu3DBAOjESiJH2f164MBXsAZtUW7m6mnWiFLCCQAuKyw&oe=6A8D709F"}, {"file_name": "2560x1440.png", "id": "668518512565632", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491828837_668518519232298_4456767759610879531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyICYw03_ecQ7kNvwEXVicC&_nc_oc=Adrh_yhmKF8ziXI9CPF1-ylzZ4ttjwSnLI5861OlikJ6oNBoTkYOV_9zIDLT660Bpbs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExHY5zsri21xXi1AKwVSh5ur9bsFdgjhLaWoGjYtZQFg&oe=6A8D91D8"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MO0i9dTvLM4Q7kNvwGr6DDN&_nc_oc=Adp0o2iqkFoA0cffINbSmw7Zsw-W3LHVoaWjHaA806w8_XBjk2rmsQe8PGTNRVaCB5Y&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbMRX4ZeLWA4AWQANHJm0JBtYKvxvAxtCk55H3ldOxCw&oe=6A8D9AC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXc7jTqNttEQ7kNvwEH8mnU&_nc_oc=Adox7Hak_zHtMf1fDOVi0r0vseicW183_mcXTBFGIGnNIavxgVPo-gH3QFF3qVJ9iOA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFB2SdI21ONF6jrQFIOuypuslIvbZrhsmnLETTcm9HJrw&oe=6A8D8E8A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_of_service_url": null, "publisher_name": "Mastery Augmented", "support_website_url": null, "website_url": "https://www.masteryaugmented.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9895615000505983"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491820354_1875368689922637_8999221336170309456_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPQWGkzDi8gQ7kNvwGDKFkg&_nc_oc=Adrh0C4v5LvrRZdMHA9OKyRdao1yLtOVJ598ydih1cH7ZiUA2p6tpd8Ol67J6dEh1C0&_nc_zt=3&_
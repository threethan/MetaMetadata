Yj0AJzNlWyMc33Lds4XGVpKOCwwRJbzMAdY5LMw&oe=6A54E158"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfQV7f1IcU4Q7kNvwEVCVHp&_nc_oc=Adogl9QLKSiC9W673gqSq73xeay7JR8Sg-KECxs9kSrpY9M1dfL7y-H_j9kNbZRymdU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3BfuhgA-46kNx8sEyyEucOQI49QdwKjm9yQB5GXSB7A&oe=6A54EA45"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSsg-15NC4oQ7kNvwEMMqB0&_nc_oc=AdrOiUOvFTHwKqzxvYy20k-1ku9rdDME54VSHxH5PTupsqXs1A_56Gar6VtcgEjQihA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYiM9_fFbA1dUfG3TAIkuUSpWJyf1Baex3oqdHN3wjwQ&oe=6A54DE0A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_
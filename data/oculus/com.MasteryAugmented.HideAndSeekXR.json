-sin11-2.oculuscdn.com/v/t64.5771-25/491827046_1847193152802924_1916133089747068590_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nv3rDcZ5MuwQ7kNvwFCFoJ6&_nc_oc=AdnE3fsHsAwU9CZafp-skEaexBWPLMvxxZnSVnL6k6_ulKNG9rAS7fzzcgkKzcoKqgI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzLRnojzxUcG3jqZfOBn-ATCOcxatWh89h1g_n2DoAKMw&oe=69AAE6DF"}, {"file_name": "2560x1440.png", "id": "668518512565632", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491828837_668518519232298_4456767759610879531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYaJh1oHoGEQ7kNvwHnJ3sX&_nc_oc=AdkEaYZyWoMQ9euUGhs7pNdfJH5nHkpIkgAqI5xL8vM-vnfxbme16LmJEdCCGQvXA6g&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfygEIH3fPSPJ8mwwm_mxKUBCl3uTnLwWqiqqVvgaPWCPg&oe=69AACFD8"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5lM_r2LkioQ7kNvwFHoMuT&_nc_oc=AdkerWY6h-foJcelcrofqbq6EPgCPFirvRDs4qIGQU8GTxaWN2nViYGVwTaz2uLROpQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfynGy7XWj-adshdQH3gDb_owDy4AjH9he6Ja6gYwvxPnQ&oe=69AAD8C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pIA44k_8n-MQ7kNvwHqcFrG&_nc_oc=AdlnExhQJ4H8J87KqDbsIWClhvijNulsIOTvcda8gbyOvHLysR5leXfaQiLKY1Ii9nM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfznzI3RiZbhYX1A3WZ5BuFY8UG1gz14pLXwTe53zYRBtg&oe=69AACC8A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_of_service_url": null, "publisher_name": "Mastery Augmented", "support_website_url": null, "website_url": "https://www.masteryaugmented.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9895615000505983"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491820354_1875368689922637_8999221336170309456_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3d3Q1ZabI7wQ7kNvwFBVG8A&_nc_oc=Adk_6x_iaJtUGg9IaH9jcPv-QR6zn7Y2OK0A9qfBUgiH_AvvwXmbA1Z7BjiR12XD7lI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afxbpf
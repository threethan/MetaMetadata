3b8_w79vvIjKCmc3OBWKC6G5-F9C0wHKLMToGpg&oe=69E22ED8"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1cDKxmOaLcQ7kNvwFWOI-r&_nc_oc=AdqjaJ5BKW6RVB9bwaLAhCE5acHG8_M1gDjBeCE8QdR1fGD6wM3uywO5EAd3LrTzQjY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af113rb-47sU1_qWRVJeyRLLoboWKZoR1pCsYtTYis2bDw&oe=69E237C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsVj3w4DazwQ7kNvwHua2P_&_nc_oc=Adp4ZVRgSu2P15dpZRC82Vf_IXj1gO4Q0G6uuRZjQnfBwSSbZp5koVmQVwbiqePMp1o&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MJc_opGXzmKaDU8ZeB2JeWloMmPpaZROqh_fC7EOG3A&oe=69E22B8A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_
ziYl7jEmIlhChBEKLRmB0HDa71gBx_EN2Q0n0aQ&oe=6AEE0798"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3rhwj0Vu-4Q7kNvwEnXpMl&_nc_oc=AdrAPk6OkdSW73hxcYrpdhMaRN5POsQ1qBxansKA6r7lDGkPnERHIysNapgSah2sxXM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJ5stEF_8bHIubT-R1lTKU1Y22YSDfvC2R32R5pOSe4Q&oe=6AEDD845"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrkztMceslYQ7kNvwHRIF_g&_nc_oc=AdpSTEa06shlD5L6eS3jduzLwvDkVqXt5kiqOq732-GLWtr1_A5uemwxzP6RTIz8p90&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAHf82vs5dNtLV__p3XxYkj_togpn7ziXhJvd0QwGXiw&oe=6AEE044A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_
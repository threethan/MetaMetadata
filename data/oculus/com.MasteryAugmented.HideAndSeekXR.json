591", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827046_1847193152802924_1916133089747068590_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4H1-r9VhafUQ7kNvwHfmpCh&_nc_oc=Adp_QU0jJ2G0nv3b1dBnWbxGbkVfvazlHV_UrloVEJK7NnvaetStZtQZf-np-yRLbss&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2EJtHvIjWie84KEFvOhZDbO-5NgbHh5t6eoPm9Xlo4g&oe=6ACF93DF"}, {"file_name": "2560x1440.png", "id": "668518512565632", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828837_668518519232298_4456767759610879531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvXV8JKWwbAQ7kNvwHVF3pj&_nc_oc=AdrtvdJy8qK5cVp4cwOQKP5-EtEuSb31TBh1qLuxIkDxYXRIYIO6xomX9qXwsvC-tVg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTbRQ54C0hFkT5U2ZGhgdrNhsFibCj1PltDrXAcjqnSg&oe=6ACFB518"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldNQd_-IB7kQ7kNvwFX7F_x&_nc_oc=AdpcxwSqTehjXHPcKtGwNU1jnQbefSVrzT7QBfaz8a_r5xcw7RcbS8QqdPKBMMk2NP0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaC3ug_QMebibSiMgzb30o8QUf_Nw0qvTGYFedOOAEPw&oe=6ACF85C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0sRTweDBgAQ7kNvwGyerRl&_nc_oc=AdpuXP7b3uDUQo7U7p8W3dgH-yA245eSCY9b0auGevIYJGNJz2080i2Np3aaq8-LjvI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeFmIe_76QSvUPjZdDGS9EtzdkVRAbz0a-EqEqzbMjWA&oe=6ACFB1CA"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_of_service_url": null, "publisher_name": "Mastery Augmented", "support_website_url": null, "website_url": "https://www.masteryaugmented.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9895615000505983"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820354_1875368689922637_8999221336170309456_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ve_NmBCLb-QQ7kNvwEnb3YK&_nc_oc=AdoM8Ydk6iLVzVf1TELh3Dki24Rj1KDHJB8amlwPpu5AtFOJlFpvUSkfX3MYa3fgJDg&_nc_zt=3&_nc_ht=scontent-
591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827046_1847193152802924_1916133089747068590_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyYsRyavXJAQ7kNvwEOFvKj&_nc_oc=AdqziWO_ShtUnlXnZ3Vn8D-XOZXoYgYfKo92IZzFLHzR5q2KPnIDh5JO-5vVa0BuDoQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRG75LMuHviXY2bXX7trQaE0bjilVS0V6m_YTbQDClmg&oe=6A4D0F5F"}, {"file_name": "2560x1440.png", "id": "668518512565632", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828837_668518519232298_4456767759610879531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yv-_Bv_NT9UQ7kNvwF_1q98&_nc_oc=AdoD0kHoVJuGTqHikulNBzMvQspSIbdR13AILv0S4FTJBRZ2YU5aH8S5tLSXtAEtjmE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3aI8TUNmjFCg65QV_qAsPbw3L1V-LuwiFF3YbR8l_ig&oe=6A4CF858"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNubyzPn7fUQ7kNvwEmHAVc&_nc_oc=Adp_quj1xoRdaX1KDP826zhH1cb6h1AxicdY3PuRjWXzom6kA1xQYI45ZuD8BrWl-6E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALot1bTtklA3dqwSXaKG0ECUhDToNQgAn5936r2r5jPA&oe=6A4D0145"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wa8lH1VSIkEQ7kNvwHuUOFg&_nc_oc=Adq37TqjZ1n8euMZOpUZbZJFO92esqwGqQwPp3QLvd-mPpf5zggnw36aOtD0gjoajnk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWiR-HL3lGQOc0rCu57WcvWi7Erc0RApuXAFUtB6cY-Q&oe=6A4CF50A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_of_service_url": null, "publisher_name": "Mastery Augmented", "support_website_url": null, "website_url": "https://www.masteryaugmented.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9895615000505983"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820354_1875368689922637_8999221336170309456_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9ko0bIXXukQ7kNvwFZcskN&_nc_oc=AdprTtuSoJfQpPVB7QIv8QwC3zOi5IrQOKQW5anCl0A9zKz5VDEi0HN3w8Zx3dIZy_4&_nc_zt=3&_nc_ht=scontent-
AYE-_dOl1KQpExdzUeqOAx-X1VbDXuKsCzInK5g&oe=69F5F558"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seLn1DM7mrMQ7kNvwFiYuTj&_nc_oc=AdrAsPqvDrmja_jK7Cdw2NkIeXkk2jmk4X8jsv7kG8wnQEROY0Hud4GJaDMEo0TjskQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3lKl7JdyvQ68jvPyhEJnQAYkowyOl4nDbCAXIF55HG7g&oe=69F5FE45"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QuwJL6ACvkQ7kNvwEv3_1x&_nc_oc=AdqDJ6LiJEj6p_FUA6iIRNN1Ch3X8oRg8IdvOxZozxOM4VGERv7bid8llyTD6_xdsHc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0zEN5RY0O5Jq9Rus6a0YHmIvy3RSJw7WHkGFFBVt4YmQ&oe=69F5F20A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_
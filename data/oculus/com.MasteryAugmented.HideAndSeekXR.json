591", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491827046_1847193152802924_1916133089747068590_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9sdsH_e2S70Q7kNvwFi81_v&_nc_oc=Adpb1VzRYQ8kNDWD6oqQaGX38aQt61v7BOpcAqUWU57mTxx22yVEG-a3S_zFq9cyICg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJDjZ4pGV2MHvYZN7Qj40qcKT36M7U1uqKYqHm0VF6AQ&oe=6AF9C3DF"}, {"file_name": "2560x1440.png", "id": "668518512565632", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491828837_668518519232298_4456767759610879531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-OKBrTvcBscQ7kNvwGotrOK&_nc_oc=AdoSCkS_63_T-itb4oIXZgRWMZSGQxmU6Mk1_vO7enCojMoAgt4R7htDjP6BEBJpw_0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyh4QxF73a79nR5VMO-_SPeKhyi2q9DFwosjvkpOX8wg&oe=6AF9E518"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nefEjE8v2QQ7kNvwG92Fc8&_nc_oc=AdpujcIvwVCTp4Y7NjdKg24YbQ1uAWQVEqDIgrwyy8rs34xoejvfSUfHSe8Wc1S3TSc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTm1KHCVTuLqj5Dh0i-yUIT3QtYtbaoEo3eOS3U92Yw0w&oe=6AF9B5C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHH3-vU7X5wQ7kNvwEPByb3&_nc_oc=AdrLOy3GTAAziGb60Ty9xd6Ro7q-3OoYCnk7ROZ_k0IiMfpJ7AYjdiM6NKqLW_7llEc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwpaJYX2-pDvAMcVttozI-8nEw4orjYu7SLeGGOKsd3Q&oe=6AF9E1CA"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_of_service_url": null, "publisher_name": "Mastery Augmented", "support_website_url": null, "website_url": "https://www.masteryaugmented.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9895615000505983"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491820354_1875368689922637_8999221336170309456_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z70BExLx6EEQ7kNvwE9QTLe&_nc_oc=AdohctORxFeTYNRyPmAojiRgY7Cmrc8Q6kgalG3qpfJz61xRmuDXIycM5xvTGEuGI0I&_nc_zt=3&_nc_ht=scontent-
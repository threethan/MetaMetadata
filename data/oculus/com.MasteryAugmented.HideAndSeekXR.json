XND2o2N2HWZkff_Ta4WgBFe2s9svaQQDSpRP2TQ&oe=6A68A7D8"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZB7rjo8B0mkQ7kNvwEisx8Z&_nc_oc=AdrGwGDQGUtBUX44fXI_6SjDem_hg6-X4hLCBxa3bUwu1wSI5wb0-XlcR9l3AiUfVsw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_jMj92Nsrc9YFxXKjslApJ77elT5llKJjc0Gcz4vdrA&oe=6A68B0C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLC-pFl0jXgQ7kNvwGB-gQS&_nc_oc=AdpbwDiASG8QHG4heIK-F17ibAm7Ct7KByh7teW7ssq5KgsQt5WlvsE0AmafrIretAM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_6yfEVgu0B8d7SlBORlF2HbOw9SGvFjp3wYmcEzs81A&oe=6A68A48A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_
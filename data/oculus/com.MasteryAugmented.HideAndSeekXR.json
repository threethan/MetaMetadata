-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZwYU0A3gFTTunVOSMYcVIoip7jyMPaS1lwJpFIkKTiQ&oe=6AFDD64A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_of_service_url": null, "publisher_name": "Mastery Augmented", "support_website_url": null, "website_url": "https://www.masteryaugmented.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9895615000505983"}, "review_mess
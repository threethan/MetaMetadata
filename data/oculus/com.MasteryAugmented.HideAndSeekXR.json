Qj0wL5uC39aXVPRHgIwh-aRm4fOZt-M4FUWQ24Q&oe=69D8F458"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prSeqvTGnUIQ7kNvwFhgNOq&_nc_oc=AdrZZ9NJKYvHmqNf8Ywn9rjDcml_SJqQDTMGCcyc7gBycB9jjJRTTuUNxm5IAamsqxM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oT_Y548XuKfYW9XxbODUMowRkbRIB3cZuo3RXBuO3Dg&oe=69D8FD45"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YMGmOlmbTM4Q7kNvwEtFukl&_nc_oc=Adq4UfU6HZ6FpG9G3ZnhfDaCF_Tjd2haoEgk1afM63_GSccVqd6u2O05nFyFLHpBD0E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Gd2siqQVBcht4hSFYpWgV4-sqebDAHKkITZctMRGPDQ&oe=69D8F10A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_
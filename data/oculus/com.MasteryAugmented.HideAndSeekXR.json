591", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827046_1847193152802924_1916133089747068590_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HvmgjJH1bsQ7kNvwGUOGlc&_nc_oc=AdoqajPqftHh5q-SQhilpGErvQWEYq6n3oXjwV8MXLHt-78him2udOCoJarK4Q8ZVVw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwD8RM_HDT_FyWhYB9s6_8gl5ggG2Z9H7FTDSSycn4-1A&oe=69CBDC5F"}, {"file_name": "2560x1440.png", "id": "668518512565632", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491828837_668518519232298_4456767759610879531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xuYU_e97Z8Q7kNvwH9cka0&_nc_oc=AdoF8HROX6y2bSoJlCD3wtI304-OYTIncXFHFIN5Ze6-nZAMoS0ypKv3WcMNE7wrCo8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxjKnUu0_jSMNfq_RJPcUiNMtpk8KKbtkiVz7pck7ZiUA&oe=69CBC558"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7lTvxBYEbUQ7kNvwElKE8H&_nc_oc=AdrunMcB6avQ0Jyoyq_eYjYFVVjx8th2y2raQdreF7RNX8ObwEKevOublmcilGyYc6M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzioM4_fUPakY55SaBjifKsmmnfTA4Z0y1MwfIVSh7cVw&oe=69CBCE45"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUY-m4wRt1cQ7kNvwETo5HV&_nc_oc=Adp68gX0b0VbQ4vZqMpIwdkehkd82Z7vRspfS00QQv254Ud5OOq4aKhkAEFSe5kMDjc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy8GQC6QfOcTzhKVJ-QePAe_a7dXLKUivpcAkslXwuB_g&oe=69CBC20A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_of_service_url": null, "publisher_name": "Mastery Augmented", "support_website_url": null, "website_url": "https://www.masteryaugmented.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9895615000505983"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820354_1875368689922637_8999221336170309456_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSYc5meRc5oQ7kNvwFxvGxi&_nc_oc=Adq7zTqsuMjR0Zl9i36zXjX4qjEDjfTuVzcQ6SU64dZyzcjNCQrL0g2JHlE7fnjyUEI&_nc_zt=3&_nc_ht=scontent-
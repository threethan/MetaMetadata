591", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827046_1847193152802924_1916133089747068590_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMH1hC7YzeUQ7kNvwGsCph1&_nc_oc=AdrP3Ug3LRI9RYhgMPrO-YAgIKDv9C0mbQJFId-J-4xgxyUxCJgunhmwiRJlN8FHXzY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2WrAh4dofmpBsSwKnetCx7KXuGJPrTaCsH4zR3OBxOMA&oe=69F4BADF"}, {"file_name": "2560x1440.png", "id": "668518512565632", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491828837_668518519232298_4456767759610879531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tCudOMc5hgQ7kNvwFATUMX&_nc_oc=Adp5_1XZDU4thS8EOWflrsJt1hOG7CcAza54vhpc89f3vHEVFU130kH0JaG0N9OKK0k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af19kWcwnkWC0WyzSZs5yGyeDjzG55YkgtudCnriC3Q1PQ&oe=69F4A3D8"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seLn1DM7mrMQ7kNvwHBwXlC&_nc_oc=AdrT3Wxeabix8I64ibbi1TFFM4G2QcLWM7Km144SPHSYOaBg9tG2bFFJYPrWvAHhDTs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2k4Gjieh3AnFrNN1yrzYhlf0yo7_RmSdvjIVTnuhxS4Q&oe=69F4ACC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjKf49JPq0cQ7kNvwHDCzWC&_nc_oc=AdoWygvQ4y21BpEvqan6C9PRMv_l2MWP95U7aDmfP_qgNFQnRBPUALKXX3WUSCgKjoM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af29F7WKmlJ1pWO8RZRyKxEwoh6Ax28ljdpDtXJ56jP8yQ&oe=69F4A08A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_of_service_url": null, "publisher_name": "Mastery Augmented", "support_website_url": null, "website_url": "https://www.masteryaugmented.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9895615000505983"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820354_1875368689922637_8999221336170309456_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7PM_Qu6_18Q7kNvwFVtMgD&_nc_oc=AdpAMMKZuvAbmwrBlfSc8N_xsv8E1UNzQJ1Jif8ywQBhf29Zs3-jNT30GCNgKHZzpiU&_nc_zt=3&_nc_ht=scontent-
591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827046_1847193152802924_1916133089747068590_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0ncEZ6MKK8Q7kNvwHD-n6E&_nc_oc=AdoXElcG8nmy2VQNabXNas0J_4SVFiT0DLWI20zzuoJkn2dsBospmCRL_EcGnWWN6mE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vHBu_rO4mrXzM1ak0i2FYpcBoZgdo4qZkdBl_ygghXQ&oe=6A0DC75F"}, {"file_name": "2560x1440.png", "id": "668518512565632", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828837_668518519232298_4456767759610879531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKgPlCKnFggQ7kNvwFYsZlC&_nc_oc=Adra5DRqsV02KotUlt1FmxqKkfyfJf2DuirHmjm6fT90NX8FlhBcxKhWTq1V2b_AK4U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6shtmcEr_-qewFoyhX1CLwDdjttltvtjnTL-0yhQWCrA&oe=6A0DB058"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3mp4ac1Pm64Q7kNvwFWAlZ3&_nc_oc=AdrSAoh50MCiAfST3T1NH_6EU9NSXYa6x7qZRlSziZVaH9IIybfSU2zK_tD6lRwnPyM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rGkriZbf3FQPTadEthJI9uMS7L668PNHabf5RtusJWw&oe=6A0DB945"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yeu_bzYxdqQQ7kNvwEj2naC&_nc_oc=Adq6b3GgG4HGcDacXtJE64kTgfIn3XhzbA-P-09nZzs0g5p4EU7qrGLvEsWA4MT9HoE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aWH-tOmT-gC-EfPAiJKte9hBDEuvBHRs9FDhupXMCeQ&oe=6A0DAD0A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_of_service_url": null, "publisher_name": "Mastery Augmented", "support_website_url": null, "website_url": "https://www.masteryaugmented.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9895615000505983"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820354_1875368689922637_8999221336170309456_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_AOzeSPLusQ7kNvwG4En8x&_nc_oc=AdrGRCGC8JCSWkFVYbf-rHABzA1s3NVC4pp7f5FMZJbX1_0XswOuJvBUb-4-HS7ESBo&_nc_zt=3&_nc_ht=scontent-
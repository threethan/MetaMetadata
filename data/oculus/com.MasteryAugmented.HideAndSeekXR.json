49oTY5ZYYSgnXKhH1a27LxlSb2Ieup7s7PQhVfnbKSI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfslXTHBiu2JVbBDa3b6PCMU6xu9MOfByivgmE25QeYMjQ&oe=699EFB45"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkZmr1ilzi0Q7kNvwFWzVoy&_nc_oc=AdmzZa6xo3lvh2d6fExoVKxmJdrOI5d-xvym1vGRB5LrT7G_F15acI49ZI4oofYRrMY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsxZgLLHgmjWhqEh1eLSh8lOeKT_OTZnC6LYrJAZKoScQ&oe=699EEF0A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_of_service_url": null, "publisher_name": "Mastery Augmented", "support_website_url": null, "website_url": "https://www.masteryaugmented.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id"
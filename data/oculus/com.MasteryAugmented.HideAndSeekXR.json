8Y4NzpDMtMjLizrArsxnTaoUs-LiSx9cdvjE72A&oe=6A6F3F58"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SX-pWVWpJsQQ7kNvwE_79gA&_nc_oc=AdqlqiqFGBvzgjO1ZYhWGolmCP8GXCsmNxn0ldY-BzO4umnp21xI3ZCUAq_yhu7q7Ww&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpeP2OSSsszzqSvZP1YH37RLut5x-o6aghWlMTUCk6Kg&oe=6A6F4845"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1uLRvRXfZcoQ7kNvwHVd75r&_nc_oc=AdoGYjv17h_wc5JsGTgNRsvnEELDwLMTUsL_ohm4eTZZGARbumJJbGWn-FkALz6siwo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvclEvmmIOhtcS4DQKQ9uD9jjD278dIDueOqDqIQNrmg&oe=6A6F3C0A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_
yEO7dhHbnd70p1lIprrnI6IyRJgy1rI6vXgD9kA&oe=6A50ECD8"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMP4uNJt3d0Q7kNvwEGm5SU&_nc_oc=AdoHv8tcjbwLVEcTTR_Q3lkzuHnMtvsRSdHAkegkEaBF3vQYgIa97jx93rgZXNcRA5A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsTSeNCSlzvsYGI-qRFXe0PX5TD15Z-GiJT1ZJMI1cUQ&oe=6A50F5C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-U9WxzbkpYQ7kNvwHTgRPa&_nc_oc=AdrjHl8rxUxnfHnxfI3uh2ZV7P-avzf_jLDH3QN7bjdM0XjiWxLpdeUXLdTy6rAM30k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLkuDIkokyKLoDk_FnW8qB3SpgqgaIljPJLTdc0LjjLQ&oe=6A50E98A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_
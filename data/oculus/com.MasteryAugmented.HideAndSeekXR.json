591", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827046_1847193152802924_1916133089747068590_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6Am3Ukq5KUQ7kNvwHUxO2l&_nc_oc=Adp_dwrzPUn2y3QVFUQaNWoSSMAulVJs-z14_OFLPviiCqMYU05IdPmNCBys5OnEnMI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWj8loCJaTPHUotKUu92aMMvKt9XwG0hq8KcMoNELT-w&oe=6A90139F"}, {"file_name": "2560x1440.png", "id": "668518512565632", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491828837_668518519232298_4456767759610879531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65Kjp305lesQ7kNvwHMIaxB&_nc_oc=AdqNeCJ84VTUO8FxePeA2g76b3suP8sj8VxmvU8L45CsFdPDUyB_17GOsKRulZP_huc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWbq3ZxX15LzrLUni5vokLp3XBYub-6tsIopB8f9eItA&oe=6A9034D8"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bz3lzu_af8UQ7kNvwFtwH4R&_nc_oc=AdrqqojLvhVHeR6_I7ULQaLzKk5pjk_KIjNuvPz1871t2kkeAu8-r9UiHCamBcbTLRU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKF4pUlT-uLMbr5aMZHDy2vVfTe4ZmZYvAu6lL8Ch8kg&oe=6A903DC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmT10WqNGysQ7kNvwHxlw7o&_nc_oc=Adp5RK16GSTzEluKAN4UukmdW-IhE1c1L8tWSlROd4k_giqKUl0DK4JJY8tlj0uN_7U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-3RNc8FDujhhn6ibqLoM9GV91VIV3Y9KSQRGB_TGs9g&oe=6A90318A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_of_service_url": null, "publisher_name": "Mastery Augmented", "support_website_url": null, "website_url": "https://www.masteryaugmented.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9895615000505983"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820354_1875368689922637_8999221336170309456_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ag0h3XUhcoQ7kNvwHtNBMC&_nc_oc=AdrHOdsGOexIvAgI1A1y3fQveW68z2b4iY-DQIZuf2-7sdFRDqWIDWFlu6XGxRCa-I4&_nc_zt=3&_nc_ht=scontent-
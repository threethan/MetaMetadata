93149469591", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491827046_1847193152802924_1916133089747068590_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8r5pEW1jG4AQ7kNvwGPWyBH&_nc_oc=AdpyxQ4cHRskD4UUuZHizGvE4RyICyij1Xp8kRe8I68y4ugPfOTthJp1UUT_cEAQCJY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfN4si_JIzqOl30GQCdEfRgWnNt1idRRGZt01YCftWsw&oe=6A8EFA5F"}, {"file_name": "2560x1440.png", "id": "668518512565632", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491828837_668518519232298_4456767759610879531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyICYw03_ecQ7kNvwGitR-d&_nc_oc=AdounQt0M7gttXEKd4j-a0EMNfTBz6Y2xG1ijH_b0ckNRvnPZ7Th8AzgeJ8Ke42JytU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhQQB3R6UkAORbzDiLn_L0A3qqzlPyKnA4IVg_Z8UDHA&oe=6A8EE358"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bz3lzu_af8UQ7kNvwHvokaW&_nc_oc=AdrDmPKpxX557fhnTg09EzH-P5VNWEKv9meq2ekaIhIrkSnPeoZqdgCjHKrSYprLqDQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBYlvJoVoI0NG9S8Qzy9C6QUddH9nMfDtu3S5FiWBDxQ&oe=6A8EEC45"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXc7jTqNttEQ7kNvwEZwaPI&_nc_oc=AdrxCffzWxm67m00afXZMNB8papelG3zwqWtPL7zInnfXPLTTbfz5J85D5yuyXw1PL8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfb27MZlYj2_eQpKx2U9mR4WxUDjdo_9RgqWVb9SXZRA&oe=6A8EE00A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_of_service_url": null, "publisher_name": "Mastery Augmented", "support_website_url": null, "website_url": "https://www.masteryaugmented.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9895615000505983"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491820354_1875368689922637_8999221336170309456_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ag0h3XUhcoQ7kNvwE8Bj3j&_nc_oc=AdpylkDeCdXi30MZ0_vyPUENl0WljfRTWo0bbXuvpAfOCbeMAWMSLLZUGH4t4pD4vkk&_nc_zt=3&_
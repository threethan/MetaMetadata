hpWe0guktJ3KTTzZtL6R08H3FZx5t-WJF68Qmlg&oe=6A4903D8"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3O4Cpk7vjS4Q7kNvwEmdTNh&_nc_oc=AdpgR_i-4JfTkpb6ivKdkU1AYxz6zyLYHI8rHyjUHod4-HGCaWIepI1nBQW_uWL-6OE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDytQtpb-fahGy2if9Li71PIcQmSWZSqd0r7hlaT4d74Q&oe=6A490CC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5O6Ynf1jFq0Q7kNvwGS9fpk&_nc_oc=AdouCc9Wsh_4aEDoLHk9f-mpHJbtJQMURsqeQChUYEenUvujB5e4enmOy15fj7ljb_U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdEeqDGPUmClQyaG-sx1lWahfeBu6MqIt7tuszZIKQmg&oe=6A49008A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_
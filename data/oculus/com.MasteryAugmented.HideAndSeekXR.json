591", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827046_1847193152802924_1916133089747068590_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTG2f0ZQ_z0Q7kNvwEMkJGS&_nc_oc=Ado43OAhzUGnomlV1tGHHnTgMTpFG7-6CWHnawrOgC0xlBGLdEIwEp7t1dIO-eYvemM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6kI60RbJ5Nx4qQMdO9_NerWXdVjdAHUm1gAQcG4AkRw&oe=6A5CE15F"}, {"file_name": "2560x1440.png", "id": "668518512565632", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828837_668518519232298_4456767759610879531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEtEjXGVV-cQ7kNvwHE9F3t&_nc_oc=AdplouPaxL5TpouBPiL4yrFLcBIz9NhzGMIgL7NWmIjdi6p-9sNhROXODas4eJaa5I0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANzpu6ONiTWaLR2HnbXOJiVWBez32FrMyJ-AzxFmnprw&oe=6A5CCA58"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxZa1iNvSEkQ7kNvwH01GJ6&_nc_oc=AdqH0cZJfFvO4_SAUYNGfXANLeJXyMvRsF-fIepbgRp-PZ9BRX6zrulXTiTsI-O7IXw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaAdLi_K1wJ_9lzHPhfJBijbWZeDggvqvK16PVANbJeQ&oe=6A5CD345"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhyHPqgtPTAQ7kNvwEhOe_1&_nc_oc=Adpi8uU7WSzQayiOhE3KGTIW6bNu1ISXi15nTa9vF3rnB_zyxoDpD-4o66925kA49Ak&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNRp1vpQ5dUXL_lIMRXZUK6oH3nKNV5VX38kvyQLo0uQ&oe=6A5CC70A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_of_service_url": null, "publisher_name": "Mastery Augmented", "support_website_url": null, "website_url": "https://www.masteryaugmented.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9895615000505983"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820354_1875368689922637_8999221336170309456_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FueH79QHaS0Q7kNvwHO5z3b&_nc_oc=AdrFcmYeHt10QmMKAXCe9h4XI8pDTnVmJKiiBYRZGt86F63tymY28rp8EGOPlHayt5Y&_nc_zt=3&_nc_ht=scontent-
591", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827046_1847193152802924_1916133089747068590_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YMPdOVZe0WQQ7kNvwEonO6P&_nc_oc=AdrxCkghusTGWTuoLOWN9nXkFU3gyr_KbblnM1XEugQYxJHTw_AalGB4msxoTruA_vE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpNFSYyL2NhAaRYX-EPoxoJ51g53NYF2IDtQlG7J2Xlw&oe=6A7C4D1F"}, {"file_name": "2560x1440.png", "id": "668518512565632", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828837_668518519232298_4456767759610879531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBajqedepTwQ7kNvwFd-6HE&_nc_oc=AdpvpCAz4iVSh-n5Od2Gw6jsruMsj1nMjGP-pOJf8GzKo61kvd6UiqFdZ3gC7lxynpU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNLcyzShx1Ij8NRCxanyOKbaTeOb2JCax7Frto2IifRw&oe=6A7C6E58"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ojDQQLuy80Q7kNvwFe95Go&_nc_oc=Adr5mqr9pIvOF5kN_draZ4TF1e6xGzJNvUdwcjz1xJDGBBw0gq9VBaWdt7QciZOFdNw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpHyYUzSxZascmvmnN9nL0E4sOByNuwUdP9bPjA1jitw&oe=6A7C7745"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgy6LVJyTWMQ7kNvwEc5p4f&_nc_oc=AdqU3SrXWKuMHd_Pi8VopH_UYEimevqzFrocwSFgkYgGCKZ03RwrJd6NN9K30OO_B-c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1ajiLf8nkw5BO34gB_ti4xg9LQxZLTlzsXYNtVDNkBg&oe=6A7C6B0A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_of_service_url": null, "publisher_name": "Mastery Augmented", "support_website_url": null, "website_url": "https://www.masteryaugmented.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9895615000505983"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820354_1875368689922637_8999221336170309456_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6_LOvVWyKEQ7kNvwHPdRTY&_nc_oc=Adr3Zy3T9C6myNAAaBhkmb6AmLZU2mQOpVN_v-OZW1XTmCD9U4EtA-xHmi1NuB94OnI&_nc_zt=3&_nc_ht=scontent-
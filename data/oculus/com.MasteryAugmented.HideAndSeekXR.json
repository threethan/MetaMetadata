591", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827046_1847193152802924_1916133089747068590_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSBKI9vAI3cQ7kNvwGclgHr&_nc_oc=AdqijXNJEAddB68MlV-YyTeaF_hX0-4zxBjjCZiwq88zPXPdJbsOC66qxdg0XAA1i2o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwaDQMSLHtW1vC7CHdlslzpE5erL3xH9GvqvCtMu63owg&oe=69D1225F"}, {"file_name": "2560x1440.png", "id": "668518512565632", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828837_668518519232298_4456767759610879531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYcUb9hEopkQ7kNvwHMgFZ5&_nc_oc=AdrblpzJWealN0aW1cEAxxrjSFK2rPvgTwcl_DnF1YIP77U2hBeWJbnGhwQJiwWkZTM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxcd5qaXWSy-QTfFdGZEWZ39m8k5nq8XD45lMxledTJww&oe=69D10B58"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLpgLVFqbAAQ7kNvwHzHpsp&_nc_oc=AdoeFYEhZjd1_OAM0b8X7a1UIlyXAPsq9YlfoKTx8zY_d-6XDAdxLXsMDfT_p-cBlEg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3eDa3QLzE5vMX1VOsUAoK88m7BV49sT1LlWMt7U6w9A&oe=69D11445"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOvEl513L1cQ7kNvwHnCk8g&_nc_oc=AdoA9fJ_GB5NzwN-XUE3s5gfL1JwGYzeHN4aYNl8GykkPLoUj5wuj8pEcVe-jbz9Y0o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfylSSF-SZUROkydO203i4xfpjncHLplHFkyuFobKPrOhQ&oe=69D1080A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_of_service_url": null, "publisher_name": "Mastery Augmented", "support_website_url": null, "website_url": "https://www.masteryaugmented.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9895615000505983"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820354_1875368689922637_8999221336170309456_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsiKEn1nNMAQ7kNvwHTG9e2&_nc_oc=AdrsRYMt2qbbA2A5rbZFlm_Lq9ACrrPBI8RQTlBHoyzRLFByvObdt8ia1U5Aa-8y7Hw&_nc_zt=3&_nc_ht=scontent-
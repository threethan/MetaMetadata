591", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827046_1847193152802924_1916133089747068590_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXbXPEdD1o8Q7kNvwHby7DR&_nc_oc=AdpuGwXkOJys0SKIkA0YMa8-wrBr6-efa9dmfHkPKrxTl4pHA5ggU5ybkPULLSExSbY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af002RKYklzZrjto8ryKt1YgX-vhkUu4hYvYt4x918_AEw&oe=69DE515F"}, {"file_name": "2560x1440.png", "id": "668518512565632", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828837_668518519232298_4456767759610879531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZNN3wtddjQQ7kNvwEEnlM0&_nc_oc=AdrufCZgElw2VYKou3cANRJQwvCxKR25xN984eWGuUZsuBMregsAfMjskSphA5FM2UI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0q1dL6LuvxhjGCjyy2ie9wyrKNMoh6_oBWWDheRLjUxA&oe=69DE3A58"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6L0e4MFlQYMQ7kNvwE9xqYt&_nc_oc=AdopRUOFR2iBPevOZ6kBkSGdXumrh80PDtnmN6MOhYebrQyPp4oYbhgup_nC7BFNziE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QgPHIRyaKjYVGJyGTEOeiUkoEb88EL2Vp37OMmBMRnQ&oe=69DE4345"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHpa1V8Y7tgQ7kNvwHFuAMG&_nc_oc=Ado1RLikb6q0sxfBjBFQnUgDtKRffE-hD-KtBeaAEfPPl_cjvmrm9TD0m7g6YZ1mURU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OsemENg_0CK1Sh2YCeSML36XhRyL_lwT2xaSTKRdKEQ&oe=69DE370A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_of_service_url": null, "publisher_name": "Mastery Augmented", "support_website_url": null, "website_url": "https://www.masteryaugmented.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9895615000505983"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820354_1875368689922637_8999221336170309456_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCDSNDQs7t8Q7kNvwE-1x4d&_nc_oc=AdoY4AY6fuAXVD5p57_1Xhm7hQPfEpLz7VqZJsxJHYF47hqOTdIpShel4oRw9XINJdI&_nc_zt=3&_nc_ht=scontent-
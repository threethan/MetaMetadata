591", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827046_1847193152802924_1916133089747068590_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b12ANCH1ECYQ7kNvwH5D_1A&_nc_oc=AdrsldRBv_7agJdj6TB6QK1yDVpsp38wu4E47JkAxwQHr-y_yWVdWW2QbprCdKBHpLo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1i5tSndlzqnt0fCIFk8xH7b1U95B9UPTeZfj8lQw3xiA&oe=69EF74DF"}, {"file_name": "2560x1440.png", "id": "668518512565632", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491828837_668518519232298_4456767759610879531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9u8zkynndQQ7kNvwFOCDj-&_nc_oc=AdoxiypfjCG0s2sVBkd8K4i-D5jOqcfJWUF_hGkfwCaNRRBl0tW7V7DyMn70ri_eNX0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Oys-mWQjedel90B0I8yvEQVZMb_yazpVe3DyrYWK1Ew&oe=69EF5DD8"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bANCsG3vvQQ7kNvwFfTEf9&_nc_oc=AdrGeLIvkYnZIgjkj-HfMJOWxkNv2G2gTRUAZI0mLP8xM1thhkI9W5OCo4o8vZhV8uU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2MNrYlTHsYFR554kNikeiZcAcGljfglhSZwJ_AlBSoEw&oe=69EF66C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmFEXvpxw-UQ7kNvwEWhQX0&_nc_oc=AdrxxLUH_bDOc9pMRQvDUuifR5o_qp5dfd1nazslxnX3XU5hOVkrssZ9dmqkwtBQllw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0_DI9vB0CVXtsIOHaz3coUH51hwpILm2FiEfJd7XCZTA&oe=69EF5A8A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_of_service_url": null, "publisher_name": "Mastery Augmented", "support_website_url": null, "website_url": "https://www.masteryaugmented.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9895615000505983"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820354_1875368689922637_8999221336170309456_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Svh5qY6NqR0Q7kNvwGn_Lry&_nc_oc=AdozDY28aMCdeEF1_qp479S6V4q6DzFwyaE1UzQc6Mgsd6tK6BGTXyUT-nGpvQnEWvo&_nc_zt=3&_nc_ht=scontent-
sAC0CWAPj7wvD7pWj14-tmems1LthiER4dC4CBg&oe=6A58D5D8"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GviUAa8a1yAQ7kNvwE7csP9&_nc_oc=AdqHfYL_uBJNS6eC7XslVu_zv9YHbeNJs_SLQuTTAFEN3bouptjEQB6rboLUQG1RaWY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVEINweQV2GH-A44YjBiX8PQahCvDyTmW_BDlXcAUfTg&oe=6A58DEC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wsudo0tm9yIQ7kNvwHXslFj&_nc_oc=AdrUjEvZQzkz4UompsqYvaBYoT8BQsHaNYMwJCDRDfmi3nJ9S0Finu3Q8aCTsuR61iE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCACvjBKk7js6RrgVY4UJcH2MF3hJQyhMyuKxozSL9Tjw&oe=6A58D28A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_
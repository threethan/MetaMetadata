591", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827046_1847193152802924_1916133089747068590_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHuKD9tVeCAQ7kNvwHg2i0o&_nc_oc=AdqKB30eeiA4KyEYEa1SO9HiSRXIiZUY0QQOIYiiBJBcVXx7Mg6cYSmoE9Z-JlMdyj4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLdmYIMKvstQByP4YbOXU4ZouE6D2vuePo62ZS5DPGQA&oe=6AF0895F"}, {"file_name": "2560x1440.png", "id": "668518512565632", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828837_668518519232298_4456767759610879531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeBKqSFI0WoQ7kNvwF2q_uE&_nc_oc=Adq5jpUHTIG8cA0fsX4upjaCTepHYXvn61PkTGHcOZoIHZ-NEB_E6BqUymRFNw9behE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTk5wTMl8d2W6VWsKBrrUnXS6x5eeDiDtoDJ8YyWkE2Iw&oe=6AF0AA98"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I08gBbiqZ9AQ7kNvwEa6tv5&_nc_oc=AdqQB-A-WYNDONRYxWwFTqz55CxDoxhfg_hQv7YHP9E6u7_5vsfb2nhSoM8t9IU49l8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe1uSWm_4A-y8xZruQ0ts8RpsKUi6GkxuXWmtFmuwjFA&oe=6AF0B385"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrkztMceslYQ7kNvwHGtzED&_nc_oc=AdpPG1K9QQXiOEklOWu7he0kIvMH_YEK7yScRE3o3YF5di9_n9F8YGYuC5RCslxz45I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjB6bybUe8hBouqpVreEk94Du_TqN7YZfuGCXm_4gNEQ&oe=6AF0A74A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_of_service_url": null, "publisher_name": "Mastery Augmented", "support_website_url": null, "website_url": "https://www.masteryaugmented.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9895615000505983"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820354_1875368689922637_8999221336170309456_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHCAPVTJ-QYQ7kNvwHqSK3l&_nc_oc=AdrrQAoX1H5i_5EaI7rUy6ocoidcrMjUPj9gmJoFwbijpNY2kR8l6dZIwSnZo7GOZ6g&_nc_zt=3&_nc_ht=scontent-
prOIwxC7Dr4B2Qg8_K8BQLlCJaw6AiW-DAOKHDg&oe=69C7D0D8"}, {"file_name": "vid_thumbnail.png", "id": "621272557567200", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491830394_621272560900533_7727830206926333797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcTE7vZ99okQ7kNvwE2qihK&_nc_oc=Adrc-iKKW2HoUtLtlH6x-CaMnwHyYYQ8gymWF-2tahxzcbq_h9thqlfxD36yMatqWoE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyupRHRq-Mu2BbGJTlL3YV0mtLsKA_WJikHsNQ_PyBq1g&oe=69C7D9C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vid_thumbnail.png", "id": "2554842291513491", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491818931_2554842294846824_7564595421614714205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLy8-w_h2i8Q7kNvwF0U0wH&_nc_oc=AdqrjPSFO_DSvDvgTrH73B2vHVxmYpdo4bEwcgnTSx_gz2Kq1wa3mFtIxxyWDangv8o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1byjBGUVc0h8jNYL-NvcQAOZKI9AkHMZ0cAvShra-Eg&oe=69C7CD8A"}, "display_name": "Hide and Seek XR", "keywords": ["Interactive", "XR", "Monster", "Multiplayer", "Social"], "long_description": "Hide and Seek XR is an interactive mixed reality game that brings a fresh challenge to the classic hide-and-seek. One player takes on the role of the hider, strategically placing monsters in the real world. The seeker must track them down using hints and a monster radar before time runs out. Move around your space, scan your surroundings, and capture every hidden creature to win. Play with a friend that tests your observation skills and reaction time. Think fast, search carefully, and capture them all!", "short_description": "Hide and Seek XR brings a fun twist to the classic game. One player hides the monsters, while the other searches and captures them before time runs out. Use your tracking skills and stay sharp\u2014can you find them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ayman23-zmn.github.io/Hide-and-Seek-XR/", "developer_terms_
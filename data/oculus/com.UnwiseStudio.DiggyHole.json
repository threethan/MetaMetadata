om/v/t64.5771-25/473393107_2120365001769526_3493667534028676650_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A88DzSNMJpQQ7kNvwH2Xz20&_nc_oc=AdoRJ3a9dA18P2c2Yr515GhdekSVkBO86_7npkrXVZ1jAHWWQaRCYoZp-ByFzqdF7Xk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5l7gV84Bdkhjuuf3hqmQ8pSPDiFmHI_bX9ibdIvrB3ow&oe=6A04657A"}, {"file_name": "reward chest.png", "id": "772256475367774", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819854_772256478701107_3603306531009672371_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRuQAB8loZ4Q7kNvwH_qS5N&_nc_oc=Adp8ws6W8AnOr5nxXD0qV6DLsfBmqOCdSl5MtVMoxWucEZDrFekgHr-o-NAzbRbuZTE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KNRbObvU1d5xO9x-bj9690hITV2PIIcLvhytDBSILRw&oe=6A047F43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Main 2560x1440.png", "id": "1637948367161145", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303222_1637948370494478_5654950217321794837_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KOjemzWceEQ7kNvwHAGotY&_nc_oc=AdoQC4DMAeddBpi1PQvv9IUWagj0U64UOm7eBsS6-xFnJtHwc-5Eoo49qQ-1l0KhT7g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YwOPltlZclftE67J8mgXgyqtmSyjagQp2iNiKXGlmqQ&oe=6A046E69"}, "display_name": "Only Dwarves Dig Proper Holes", "keywords": ["digging", "dwarf", "adventure", "funny"], "long_description": "You\u2019re a dwarf. You dig holes. That\u2019s the job.\n\n\nHold on to your beard and get to work, because there\u2019s a whole lot of ground beneath your feet and absolutely no reason to stop digging. \n\nWhat\u2019s down there? Probably treasure. Or doom. Or both. The only way to know for sure is to try...   You\u2019ve got a shovel, no help, no light, no plan. What are you waiting for ? \n\nThis isn\u2019t your typical heroic quest. There\u2019s no saving the world, no epic battles\u2014just you, the earth, and the growing suspicion that things are getting... weird.", "short_description": "Treasure? Glory? Nah. I just dig. I don\u2019t know what\u2019s down there, but I\u2019m already halfway to rock-bottom\u2014and stopping now feels like commitment. Let\u2019s see how deep this bad idea goes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1us_ErrSJrgSOTGdimpTFG39Si43WHS4i5DE91RCS3Hk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Unwise Studio", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1us_ErrSJrgSOTGdimpTFG39Si43WHS4i5DE91RCS3Hk/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9392323137512900"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1246659057437068"}, {"status": "PUBLISHED", "id": "1968548460657570"}, {"status": "PUBLISHED", "id": "1847560405866345"}, {"status": "PUBLISHED", "id": "852645464016473"}]}, "baseline_offer": {"id": "1968548460657570"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "1246659057437068"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24991443990507563", "version": "1.0.3"}, "id": "1040191161301001", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": 
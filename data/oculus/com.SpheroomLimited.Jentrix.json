n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUQ21f2aaw4Q7kNvwFD62TG&_nc_oc=Adpcq-5QpcDxDTvE-8_SF900T6Uylwp2xH_Ab-dN39HWbpA0Fedi6MN-2ET1zpt7xI4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3M7nWYeXGZ3Ixwnt4au5yBNgkhmPIO3bvuLirOUH2qsg&oe=69F21A35"}, {"file_name": "Jenga-32021-05-26_19-22-52-249 !!!.png", "id": "480056643301190", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974499_480056649967856_4545037340399736900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0CySqGHMyAQ7kNvwFtM-sa&_nc_oc=Ado4JuB17C3T96cbdxpeRImBwTWoORYXN2V7ZTFd__H6X_XboEKBJg7hPpq4oNXhSno&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1rScXj1EUnpLAH380xaowRxUFiw9DWUBGW4bi0PzeCSA&oe=69F1E402"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560_1440_Jentrix.png", "id": "470414117374817", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974591_470414120708150_1454389544219201507_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7etwIaPZcwQ7kNvwH6PZ36&_nc_oc=Ado_PiOs_k05YhkXAsD324RZjZ0O7NGBQ_QG95MTYP5a4B_pNgHJ1RnNEoADaJ4jEPk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2BYxErvSdtEk11wnJNjVMy22eEzcE4AWTT6p8apcQ9hw&oe=69F20915"}, "display_name": "Jentrix", "keywords": [], "long_description": "Jentricks is a Virtual Reality board game that combines the best of Jenga and Match 3 mechanics.\n\nIn Jentricks you have to travel across colorful locations and dismantle cube fruit towers just like in the classic Jenga. But everything is not so simple \u2013 the fruits fall down and form a high tower. Move the fruits, rearrange them, collect \"Three in a row\" and they will disappear!\n\nYour goal is to prevent the tower from growing to its limit or falling apart. Jentricks offers 6 levels of difficulty in each location, after passing which a passage to the next one opens.\n\nFalling fruits and fragile towers make Jentricks a unique and unforgettable VR adventure!", "short_description": "Jentricks is a Virtual Reality board game that combines the best of Jenga and Match 3 mechanics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://arcadia-vr.com/pdf/Privacy-Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "SPHEROOM LIMITED", "support_website_url": null, "website_url": "https://arcadia-vr.com/en", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "639469383950546"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4453097321444154", "version": "1.0.6.704"}, "id": "1181695535611331", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3944725358948022", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "4453097321444154"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1181695535611331"}]}, "change_log": null, "created_date": 1636120667, "id": "4453097321444154", "version": "1.0.6.704", "version_code": 141, "release_status": "REL
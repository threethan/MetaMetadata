w4o8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afte53sEkX9s61Bhqne1C9c0Rc9WiUCaIWxfGC3Q08ELtw&oe=699C3075"}, {"file_name": "Jenga-32021-05-26_19-22-52-249 !!!.png", "id": "480056643301190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974499_480056649967856_4545037340399736900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obYx0Vd8f64Q7kNvwEedcoW&_nc_oc=Adn-49r12zRXE8y8haB2TVcCR1Jzb9JIQPowN8Oqr1IY1rQ8dQVPk6b7InDaxINDdW8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsObqT1AaskwD-ZZZRjJahZlPUqvmt79P3ScK17k4ey6A&oe=699C3282"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560_1440_Jentrix.png", "id": "470414117374817", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974591_470414120708150_1454389544219201507_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1pEHlDLa5AQ7kNvwH3eOWB&_nc_oc=AdlThFWre5xhdeR10c8ZRRK5n-_xE3GFM4mndwAq5zV8XdeO7jJ7YiXtEm8pICmnpBU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuSdhM9EamuQCQiLEcw6nMQc6UtQl6_7NzLbAAJHAu0AA&oe=699C5795"}, "display_name": "Jentrix", "keywords": [], "long_description": "Jentricks is a Virtual Reality board game that combines the best of Jenga and Match 3 mechanics.\n\nIn Jentricks you have to travel across colorful locations and dismantle cube fruit towers just like in the classic Jenga. But everything is not so simple \u2013 the fruits fall down and form a high tower. Move the fruits, rearrange them, collect \"Three in a row\" and they will disappear!\n\nYour goal is to prevent the tower from growing to its limit or falling apart. Jentricks offers 6 levels of difficulty in each location, after passing which a passage to the next one opens.\n\nFalling fruits and fragile towers make Jentricks a unique and unforgettable VR adventure!", "short_description": "Jentricks is a Virtual Reality board game that combines the best of Jenga and Match 3 mechanics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://arcad
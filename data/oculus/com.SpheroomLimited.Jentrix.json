FQup0cQ&oe=6ABFDE8D"}, {"file_name": "+gm3_3 png (1).png", "id": "3074445359459012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035390_3074445366125678_3578756512971502053_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YinXrvPnrA8Q7kNvwHd9iI7&_nc_oc=AdpWC9czQnXHSGJ3Px1Xd4Tk1RctaHbSG_uAoDXOKyjnNjBVsqs4sLHH_5zGgY2yX3g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNw3noACiF2uJzvNB48LXUMkcD8Mnf4uJx3outCIBCu3w&oe=6ABFC484"}, {"file_name": "+gm9_2 png.png", "id": "407956794139390", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572935_407956797472723_7419472238995283805_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRHgMKv-OuIQ7kNvwFJMwXy&_nc_oc=AdpS5VGcDsPMbvziwSqOPmlr8xXB9FG5Onk7OHUk8HNKHwI590uozz187cfgg48hMAA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYthOx2v8qYSWWPpBwRWPE2uJkNUyv02_Yg9-ax6j2Ww&oe=6ABFC003"}, {"file_name": "+gm1_2 png.png", "id": "317780649745224", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57574721_317780653078557_3166335117325876068_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCGRaGQUqj8Q7kNvwG0Y75d&_nc_oc=Adreoa-i6yD0DiMMLfUuLrYYG3A19qWL0W1tpoeAJuFP7mo4uLZZyjymSaG9k7kkaxo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLTZ2nsTiZumamHLWmN71LnC07cuAkF4sippYlkC8DJQ&oe=6ABFC846"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jentrix", "keywords": [], "long_description": "Meet Jentrix! It is inspired by the famous board game and combines the very best of Jenga, match-3 and Tetris. And it\u2019s all packed in Virtual Reality!  \n\nWe are pretty sure you know the classic Jenga, but what if instead of wooden blocks there would be colorful fruit cubes, the towers would grow every second, and crocodiles would try to bite your hands?\n\nJentrix mixes different sets of mechanics from everyone\u2019s favorite games. Jenga provides its well-known look of the tower and tests your physical and mental skills. Match-3 brings its popular 3-in-a-row portion, while Tetris vibes will put you to the edge while the tower grows. \n\nIt\u2019s Jenga you\u2019ve never seen before! \n\n\n", "short_description": "Jentrix is a board arcade VR game with a perfect mix of Jenga, Tetris and match-3 mechanics! Grab, move, collect fruit cubes, don\u2019t get your hands bitten by crocodiles, and remember: don\u2019t let the tower fall! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spheroom.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "SPHEROOM LIMITED", "support_website_url": null, "website_url": "https://jentrix-vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2593437067456791"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984443_1134814376930546_4858039055876247561_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i27o6rBTvuQQ7kNvwGzgEtv&_nc_oc=AdpncPT6te2OnKCF6WTQunYHrEctGvlnvHVsAx_4a2OaM3rOJSlFPS67t6jxdOATh98&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdB7cHyFAI14Ijr3uqmCYRMOXUXioFJ8B-44-x91xnqg&oe=6ABFD9EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Jentrix", "platform": "ANDROID_6DOF", "context_categor
lbKU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfufMI5cwD5VYc589_ZRbh2jyxmVP0mpHxj7KWWCORBQiw&oe=699D81F5"}, {"file_name": "Jenga-32021-05-26_19-22-52-249 !!!.png", "id": "480056643301190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974499_480056649967856_4545037340399736900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obYx0Vd8f64Q7kNvwGKvYNn&_nc_oc=AdkYvMROyhaU2eOGK8KrwzIB8vY6zcy-0YH44NHWzxNwiSiB0iW0sXnb0xjgf5ceL-4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs9daAJdnPPEwBpvdzi5rivMca0xvz08ipFXyUhmpPM1A&oe=699D8402"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560_1440_Jentrix.png", "id": "470414117374817", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974591_470414120708150_1454389544219201507_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1pEHlDLa5AQ7kNvwHYOUym&_nc_oc=AdmGBmsOEJE7GqlnRP6wXOzEkg8Sea69xE8yd2K6gVQhjJGi1id_nertBoyCmCorNC4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfubMNpWepkw0tXBc5PSjD-hhtijIZFpXZtnJ1U99MyM8A&oe=699DA915"}, "display_name": "Jentrix", "keywords": [], "long_description": "Jentricks is a Virtual Reality board game that combines the best of Jenga and Match 3 mechanics.\n\nIn Jentricks you have to travel across colorful locations and dismantle cube fruit towers just like in the classic Jenga. But everything is not so simple \u2013 the fruits fall down and form a high tower. Move the fruits, rearrange them, collect \"Three in a row\" and they will disappear!\n\nYour goal is to prevent the tower from growing to its limit or falling apart. Jentricks offers 6 levels of difficulty in each location, after passing which a passage to the next one opens.\n\nFalling fruits and fragile towers make Jentricks a unique and unforgettable VR adventure!", "short_description": "Jentricks is a Virtual Reality board game that combines the best of Jenga and Match 3 mechanics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://arcad
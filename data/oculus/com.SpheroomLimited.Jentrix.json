rSGsPPQ&oe=6A92D34D"}, {"file_name": "+gm3_3 png (1).png", "id": "3074445359459012", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035390_3074445366125678_3578756512971502053_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3o7QYQ7L58cQ7kNvwH4I_xa&_nc_oc=Ado1dO8ERnPKytUAMhVrGKzfH_nPaoGN--Byw_zSvgAwzJu4XSjlcY_36rZ1I2z0Dno&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbiX8YhS5D3L1er-ZiLlJdH953h9ABdKfyXKYDPZdKKw&oe=6A92B944"}, {"file_name": "+gm9_2 png.png", "id": "407956794139390", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57572935_407956797472723_7419472238995283805_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbMJVdxSxigQ7kNvwG75UaT&_nc_oc=AdqS65-LAa2Y43aPmF7ODK1sq7xGfLQdBIuhby06sErQJUybYQYUktneuslXgwDiHPA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhYI_ldLrkda5-jzkHfOtkL9wkEbdfefxyCs7RQSCC8A&oe=6A92B4C3"}, {"file_name": "+gm1_2 png.png", "id": "317780649745224", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57574721_317780653078557_3166335117325876068_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MyEl37UTFIQ7kNvwFbedWJ&_nc_oc=AdqGiwuEhStvJ6QD1GpuPuTdSg3EzCyRrmqBeLWeieOIgbRBmgiSQ0F7vJGY0DPAROI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEF__RIo7yNRTfllW3pFbcVsXhdFJPkpZ98IturAU8JXw&oe=6A92BD06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1270232313403313", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031517_1270232316736646_1899296244109522719_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yokOdPZ0ickQ7kNvwHezg1z&_nc_oc=AdrdeDNIysUPa_eod8dN4yQJEIergpC91NnY7MIoCegGdtfTiYmckXwnBTGkjqRMXqQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEArP43ijVLr7g6gZl1sSa5da6mytno2IB18yqTW-7sCQ&oe=6A92AA3B"}, "display_name": "Jentrix", "keywords": [], "long_description": "Meet Jentrix! It is inspired by the famous board game and combines the very best of Jenga, match-3 and Tetris. And it\u2019s all packed in Virtual Reality!  \n\nWe are pretty sure you know the classic Jenga, but what if instead of wooden blocks there would be colorful fruit cubes, the towers would grow every second, and crocodiles would try to bite your hands?\n\nJentrix mixes different sets of mechanics from everyone\u2019s favorite games. Jenga provides its well-known look of the tower and tests your physical and mental skills. Match-3 brings its popular 3-in-a-row portion, while Tetris vibes will put you to the edge while the tower grows. \n\nIt\u2019s Jenga you\u2019ve never seen before! \n\n\n", "short_description": "Jentrix is a board arcade VR game with a perfect mix of Jenga, Tetris and match-3 mechanics! Grab, move, collect fruit cubes, don\u2019t get your hands bitten by crocodiles, and remember: don\u2019t let the tower fall! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spheroom.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "SPHEROOM LIMITED", "support_website_url": null, "website_url": "https://jentrix-vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2593437067456791"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984443_1134814376930546_4858039055876247561_n.png
oculuscdn.com/v/t64.5771-25/39035390_3074445366125678_3578756512971502053_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lY_F_gD8-w0Q7kNvwF1W_Sb&_nc_oc=AdkC0Ab19t101HPgYcxTrXNygTYQYZkaFMODBz2IH1O4mbuJFncxVpSwZ3RdSRhzwMw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftMAM1HRlNfOFmes4DmAsV-VqtZiK_iH5i9PRd1evFDnA&oe=69A176C4"}, {"file_name": "+gm9_2 png.png", "id": "407956794139390", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/57572935_407956797472723_7419472238995283805_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4S54n2fKjt0Q7kNvwFLcPep&_nc_oc=AdkndXLs51Kxp1k1but6V00DTljnGngXdRrl8x5lp6wTj7lkXNw0GRNu8frroyfxQ2Y&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuLVmjiCEzGsDTgKLW8Shokqee1pf6mXTOM94g8Nxr3BQ&oe=69A1AA83"}, {"file_name": "+gm1_2 png.png", "id": "317780649745224", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/57574721_317780653078557_3166335117325876068_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyXzswLVWQMQ7kNvwEnFZ7X&_nc_oc=AdmFeU8ZZie4ixwk3crgjaV1VOR6OAMsuJLgY8I8UckD4OHxyrU3sH8QCuwHTKcuvzk&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afsen5tkAln1PdUm61jrgF7aAatlqRH5Eb8yqHVcAgUMmg&oe=69A17A86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1270232313403313", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031517_1270232316736646_1899296244109522719_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8xn4BM_uvoQ7kNvwFskbqb&_nc_oc=AdnONJb2EEzMkdNwgcnPFiitvdwKL9WXZoiAQwgzhDmhaT-g-a_Xc6FLoI_zmPxRyMg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuXrM3aQfeTIY8IY1KGGAy5AazYQsZrc6YNDGmd-ng80w&oe=69A19FFB"}, "display_name": "Jentrix", "keywords": [], "long_description": "Meet Jentrix! It is inspired by the famous board game and combines the very best of Jenga, match-3 and Tetris. And it\u2019s all packed in Virtual Reality!  \n\nWe are pretty sure you know the classic Jenga, but what if instead of wooden blocks there would be colorful fruit cubes, the towers would grow every second, and crocodiles would try to bite your hands?\n\nJentrix mixes different sets of mechanics from everyone\u2019s favorite games. Jenga provides its well-known look of the tower and tests your physical and mental skills. Match-3 brings its popular 3-in-a-row portion, while Tetris vibes will put you to the edge while the tower grows. \n\nIt\u2019s Jenga you\u2019ve never seen before! \n\n\n", "short_description": "Jentrix is a board arcade VR game with a perfect mix of Jenga, Tetris and match-3 mechanics! Grab, move, collect fruit cubes, don\u2019t get your hands bitten by crocodiles, and remember: don\u2019t let the tower fall! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spheroom.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "SPHEROOM LIMITED", "support_website_url": null, "website_url": "https://jentrix-vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2593437067456791"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38984443_1134814376930546_4858039055876247561_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vG_M859vIAkQ7kNvwHqSwkp&_nc_oc=AdmwUDR6C-IPL-ETW5wG5k1WVuMPuBj6W8WNH35i-2V9PYJT4Z6k-cNBbG4EfhjG_zQ&_nc_z
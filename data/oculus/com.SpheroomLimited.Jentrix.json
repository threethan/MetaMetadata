pj6Nq2g&oe=69D2584D"}, {"file_name": "+gm3_3 png (1).png", "id": "3074445359459012", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035390_3074445366125678_3578756512971502053_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1V81z5FQmH4Q7kNvwG1RJWd&_nc_oc=AdqwZs-QoCHoqP-dkV-ly31mLUvboBqL7uNX7zr8dZBp2wd5BFap5AEy0BlAHnG4F_s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CN87vwGW58d-oo6pkHz93pSKyx2G6SjhZEBdeb9AOhw&oe=69D27684"}, {"file_name": "+gm9_2 png.png", "id": "407956794139390", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572935_407956797472723_7419472238995283805_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvZdNmqL3S4Q7kNvwHumhvS&_nc_oc=Adp4Cd4zrHwxBQJJIgxd5j68ICCKeW6tY2imXLvBKlAd1BWt4mPi_Ozgyx8bhmKY9c4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cvUygMLNErEJMitpmxyLesfdDvnXZE24ZEIoF1J_1CA&oe=69D27203"}, {"file_name": "+gm1_2 png.png", "id": "317780649745224", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57574721_317780653078557_3166335117325876068_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFJmmYA4uoMQ7kNvwHhi3jG&_nc_oc=AdplQwSM7KpgmoJ7CBaJRpxdJBjfYbyIXBGIn77NnvdpvqQKXqu-EALzeJc-E4FIA80&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0M0xxSTX9KdAWeYTB6kqWRqDoeNsC9uNjAohS4pYpHjA&oe=69D27A46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1270232313403313", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031517_1270232316736646_1899296244109522719_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLS4Y3GdwacQ7kNvwEC4doI&_nc_oc=AdoL1lJOEow7VeDAt0AXVVbx8qe58OXRrlJPA8scqVcCqWUVfoyWqtFcljzB6LKMkcw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XOvaaZvapVgkFethEHTu7NcHwRUPxsU0EpLjWdIO3dg&oe=69D2677B"}, "display_name": "Jentrix", "keywords": [], "long_description": "Meet Jentrix! It is inspired by the famous board game and combines the very best of Jenga, match-3 and Tetris. And it\u2019s all packed in Virtual Reality!  \n\nWe are pretty sure you know the classic Jenga, but what if instead of wooden blocks there would be colorful fruit cubes, the towers would grow every second, and crocodiles would try to bite your hands?\n\nJentrix mixes different sets of mechanics from everyone\u2019s favorite games. Jenga provides its well-known look of the tower and tests your physical and mental skills. Match-3 brings its popular 3-in-a-row portion, while Tetris vibes will put you to the edge while the tower grows. \n\nIt\u2019s Jenga you\u2019ve never seen before! \n\n\n", "short_description": "Jentrix is a board arcade VR game with a perfect mix of Jenga, Tetris and match-3 mechanics! Grab, move, collect fruit cubes, don\u2019t get your hands bitten by crocodiles, and remember: don\u2019t let the tower fall! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spheroom.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "SPHEROOM LIMITED", "support_website_url": null, "website_url": "https://jentrix-vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2593437067456791"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984443_1134814376930546_4858039055876247561_n.png
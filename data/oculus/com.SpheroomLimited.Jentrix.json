FZ9A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvvo7ZF8lzsajD54x6mCgfTPNsUi8pAmum7QZHT4KswVw&oe=699ED375"}, {"file_name": "Jenga-32021-05-26_19-22-52-249 !!!.png", "id": "480056643301190", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974499_480056649967856_4545037340399736900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpSDwJobx2AQ7kNvwGUK3B8&_nc_oc=AdlnbuBNwM68zdiE8Zu3KNaDqHZsjDcyEaBh9bnTMAL6iufaUbm9IIG5q5iTDBfSo1I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsjxJQBumc2IN_vDkWwcFfcv1zYgYigOuAgGkXx_22tSA&oe=699ED582"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560_1440_Jentrix.png", "id": "470414117374817", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974591_470414120708150_1454389544219201507_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1pEHlDLa5AQ7kNvwGQehXH&_nc_oc=AdmFwucFM9XtRamSXrX5FpHHogu4bMxkt_21FZk8h6OqHbEpEGSobZiT1GcM6EL06Wo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftHTiIt2PeR3oc8YlclnkwgTKYArPvP3BBBik_3SKmMQQ&oe=699EFA95"}, "display_name": "Jentrix", "keywords": [], "long_description": "Jentricks is a Virtual Reality board game that combines the best of Jenga and Match 3 mechanics.\n\nIn Jentricks you have to travel across colorful locations and dismantle cube fruit towers just like in the classic Jenga. But everything is not so simple \u2013 the fruits fall down and form a high tower. Move the fruits, rearrange them, collect \"Three in a row\" and they will disappear!\n\nYour goal is to prevent the tower from growing to its limit or falling apart. Jentricks offers 6 levels of difficulty in each location, after passing which a passage to the next one opens.\n\nFalling fruits and fragile towers make Jentricks a unique and unforgettable VR adventure!", "short_description": "Jentricks is a Virtual Reality board game that combines the best of Jenga and Match 3 mechanics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://arcad
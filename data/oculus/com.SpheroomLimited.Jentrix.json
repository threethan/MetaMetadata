ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWedehDUlEYQ7kNvwGvFkLn&_nc_oc=Adrrx0US5siT8fD08KTp6Hg1NbWq8oaftsmxJQ5eewSynr3WjhZbgQEnm9ICXDWYe4I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRRPTPvYNQ2FUjbCSj5al6bpl4SLjDfzieAF-tTr_p88A&oe=6B0B3C4D"}, {"file_name": "+gm3_3 png (1).png", "id": "3074445359459012", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035390_3074445366125678_3578756512971502053_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n239hZ8ousQQ7kNvwEjPA3E&_nc_oc=AdoFpUXX6i06lFHtYSjUxdP4Q7pohsig8xGuhG4HC1VNZ3VSx4LEgXnra1Rg3nJ6TNI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRZYQ3p8mzaPTSxqdCb_E4RLSRRSUAqDTg6kjGE5iOSlw&oe=6B0B2244"}, {"file_name": "+gm9_2 png.png", "id": "407956794139390", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572935_407956797472723_7419472238995283805_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FsaEhLTpPJcQ7kNvwFHTv0F&_nc_oc=AdrSoromSw1KAxW_B7GQ56z8OMkP-a4XtrnDQ-KHDrRfhmS-MD7yQs2T4cZRCBN3JGs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTNT5GbacPSe9quVXTo6euvdORovh6ijBJZwhqFnTLE-g&oe=6B0B1DC3"}, {"file_name": "+gm1_2 png.png", "id": "317780649745224", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57574721_317780653078557_3166335117325876068_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84eF2Vka1b0Q7kNvwGwesSR&_nc_oc=Adq4pSyszGcB2bm8D_vjYyexNCuAcTf4Y5gxroI53BeS9GrDrapilKGJaarhoxBiLJE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQu7NleB9IKO01R4SwgawOOfHMRuF7QE3ZocW2O5xfXCQ&oe=6B0B2606"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jentrix", "keywords": [], "long_description": "Meet Jentrix! It is inspired by the famous board game and combines the very best of Jenga, match-3 and Tetris. And it\u2019s all packed in Virtual Reality!  \n\nWe are pretty sure you know the classic Jenga, but what if instead of wooden blocks there would be colorful fruit cubes, the towers would grow every second, and crocodiles would try to bite your hands?\n\nJentrix mixes different sets of mechanics from everyone\u2019s favorite games. Jenga provides its well-known look of the tower and tests your physical and mental skills. Match-3 brings its popular 3-in-a-row portion, while Tetris vibes will put you to the edge while the tower grows. \n\nIt\u2019s Jenga you\u2019ve never seen before! \n\n\n", "short_description": "Jentrix is a board arcade VR game with a perfect mix of Jenga, Tetris and match-3 mechanics! Grab, move, collect fruit cubes, don\u2019t get your hands bitten by crocodiles, and remember: don\u2019t let the tower fall! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spheroom.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "SPHEROOM LIMITED", "support_website_url": null, "website_url": "https://jentrix-vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2593437067456791"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984443_1134814376930546_4858039055876247561_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbVhHl4-LowQ7kNvwFp_X9f&_nc_o
6P8Javw&oe=6A4E454D"}, {"file_name": "+gm3_3 png (1).png", "id": "3074445359459012", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035390_3074445366125678_3578756512971502053_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijGBJRX8FKwQ7kNvwE7QDa6&_nc_oc=Adr7YKV9b3npKr410vfRFG4mVvcI7CQM0FicDGDrTqWBbQrUlEVuxp-Mz0b_JKWCv8A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkRRKIfySZ9cw5n7KhuXr-xLZHmkV0rKSKIXDVl5bc7A&oe=6A4E6384"}, {"file_name": "+gm9_2 png.png", "id": "407956794139390", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57572935_407956797472723_7419472238995283805_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_Q6bZoa9MoQ7kNvwGxsTD6&_nc_oc=AdqHEhXNsFIiaxHTaalNzlOEU-LeJalfxGK5cmCQpUIofy8Gw8j3Z8-PX3Ae6MFqB28&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrKvf3itUHGiQwsWyX9TLDa28Q-ilbixKVHsudr9VlWw&oe=6A4E5F03"}, {"file_name": "+gm1_2 png.png", "id": "317780649745224", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57574721_317780653078557_3166335117325876068_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irq5hcx5NK0Q7kNvwGZP34d&_nc_oc=Adp_XMQzMXuDbci294w6p4mZefMRr_oehl69f4dgFnBEvkYeaG90c0zSiW0uhZq6_Ds&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgBtBosiedsBfhZUi9m5w_NIAq-cC4bFNAcWCvZtTKYA&oe=6A4E6746"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1270232313403313", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031517_1270232316736646_1899296244109522719_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXMaJRBjOY4Q7kNvwG7_G4U&_nc_oc=AdpPSD0cSJlE4bmoTA-h39kiXLcy0lrqaf78_02hDUezmc1SuDFWhqFIZ3FXJUVNOgQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaH4jZhMj7y-g0RLSh6I2HBvuxvZpwsqVgw0yE1EmaEw&oe=6A4E547B"}, "display_name": "Jentrix", "keywords": [], "long_description": "Meet Jentrix! It is inspired by the famous board game and combines the very best of Jenga, match-3 and Tetris. And it\u2019s all packed in Virtual Reality!  \n\nWe are pretty sure you know the classic Jenga, but what if instead of wooden blocks there would be colorful fruit cubes, the towers would grow every second, and crocodiles would try to bite your hands?\n\nJentrix mixes different sets of mechanics from everyone\u2019s favorite games. Jenga provides its well-known look of the tower and tests your physical and mental skills. Match-3 brings its popular 3-in-a-row portion, while Tetris vibes will put you to the edge while the tower grows. \n\nIt\u2019s Jenga you\u2019ve never seen before! \n\n\n", "short_description": "Jentrix is a board arcade VR game with a perfect mix of Jenga, Tetris and match-3 mechanics! Grab, move, collect fruit cubes, don\u2019t get your hands bitten by crocodiles, and remember: don\u2019t let the tower fall! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spheroom.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "SPHEROOM LIMITED", "support_website_url": null, "website_url": "https://jentrix-vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2593437067456791"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984443_1134814376930546_4858039055876247561_n.png
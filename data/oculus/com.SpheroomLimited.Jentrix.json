JNtIgDw&oe=69C2864D"}, {"file_name": "+gm3_3 png (1).png", "id": "3074445359459012", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035390_3074445366125678_3578756512971502053_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5K0g1ANAEIQ7kNvwHLzl8s&_nc_oc=AdrGv2HNC3J6bEji33rEvKKHPDwA5jh2_mFuKKqXX9Oe9xS_RqX1GsOeafBcOnPqczI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQ58b9Ce_nAM01_sUZ4d2ZmevORpHU3qKj-EfXS6f8Pg&oe=69C26C44"}, {"file_name": "+gm9_2 png.png", "id": "407956794139390", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57572935_407956797472723_7419472238995283805_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gm0T2MdvJCMQ7kNvwFtWgiO&_nc_oc=Ado58ZytKzK10snxGJJd12eyfHQMLM4wDUmGN5a5bLcPhpsbpmVt8ihN_J3XMAnVEyI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyA_-WdI6loZhiHAlcTLbUcqqeAjO3-_wx8fuO6YeySog&oe=69C2A003"}, {"file_name": "+gm1_2 png.png", "id": "317780649745224", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57574721_317780653078557_3166335117325876068_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DH6xZ-RYeTQQ7kNvwErlDo0&_nc_oc=AdpLVb9KYbCCySMfHwFA4IrwC-Hykk7-hwtvcnwJ6r6TE7N1ObNLyYN-uQSBxghf9Mc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyXz2inJlgZHDiYEDn4Ka4v-B0JFW6jnG4WiXrlwP6TbQ&oe=69C27006"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1270232313403313", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031517_1270232316736646_1899296244109522719_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3xT-_hLBqgQ7kNvwHocLMv&_nc_oc=Adpfi8D0NmC7nfx8b8PN9D1MErwyT-ogFDyRxrgEeb_VGjvS5wLa_ULCh-2ZmY98a4A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxmY4aG3qvy4cmrR_7p-_tZITLV6vAPXFrwkr-WoCh0jw&oe=69C2957B"}, "display_name": "Jentrix", "keywords": [], "long_description": "Meet Jentrix! It is inspired by the famous board game and combines the very best of Jenga, match-3 and Tetris. And it\u2019s all packed in Virtual Reality!  \n\nWe are pretty sure you know the classic Jenga, but what if instead of wooden blocks there would be colorful fruit cubes, the towers would grow every second, and crocodiles would try to bite your hands?\n\nJentrix mixes different sets of mechanics from everyone\u2019s favorite games. Jenga provides its well-known look of the tower and tests your physical and mental skills. Match-3 brings its popular 3-in-a-row portion, while Tetris vibes will put you to the edge while the tower grows. \n\nIt\u2019s Jenga you\u2019ve never seen before! \n\n\n", "short_description": "Jentrix is a board arcade VR game with a perfect mix of Jenga, Tetris and match-3 mechanics! Grab, move, collect fruit cubes, don\u2019t get your hands bitten by crocodiles, and remember: don\u2019t let the tower fall! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spheroom.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "SPHEROOM LIMITED", "support_website_url": null, "website_url": "https://jentrix-vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2593437067456791"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984443_1134814376930546_4858039055876247561_n.png
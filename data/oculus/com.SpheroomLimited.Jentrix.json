oculuscdn.com/v/t64.5771-25/39035390_3074445366125678_3578756512971502053_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lY_F_gD8-w0Q7kNvwGn_B3e&_nc_oc=AdmShfJpfVqb-JobZ3RO2uaRwAUFY7ck7ju76LzfjnC8Cs9N58nywuJSfuDhqHC1iFQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftcRvShrbnX5KHzvN5O8eFLzAekq3_y0E76ZKeMjWzxLQ&oe=69A2C844"}, {"file_name": "+gm9_2 png.png", "id": "407956794139390", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572935_407956797472723_7419472238995283805_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4S54n2fKjt0Q7kNvwH3txU6&_nc_oc=Admva9oKSgLwZAwIy9ZhY3G90WZmByfAXCh3Eu9b40y9KRVmogLuoOL-uGo5RqbvrF0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvcxebObU7SwCIr2ZtE7_yWUvqKaUqlnPWN7DD6GRA1BQ&oe=69A2FC03"}, {"file_name": "+gm1_2 png.png", "id": "317780649745224", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57574721_317780653078557_3166335117325876068_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Gu8xcyPTnYQ7kNvwFRi83r&_nc_oc=AdlDN1s2Kh0WDpnjuElxa2UNyuZ8jJK0S8A2kLXtrbQ0H-DpBRS4qm47EO-Z0xP2yDg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfufJ8lDefmK-1LBhV_0_nNfnVuIlt0toMns_NJyE6njWw&oe=69A2CC06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1270232313403313", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031517_1270232316736646_1899296244109522719_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3dDTCRPxhkQ7kNvwGRni1a&_nc_oc=AdlsJNa_dl7s6yEo3T7bdcSJlIyUbRbfiasxRp02Fikxk48voHYnBMOZDP7ldbCzcSM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuv7aI9vrfC-EhCga2T8Xd2LfilQxMia_MZcYoVpOKgTA&oe=69A2F17B"}, "display_name": "Jentrix", "keywords": [], "long_description": "Meet Jentrix! It is inspired by the famous board game and combines the very best of Jenga, match-3 and Tetris. And it\u2019s all packed in Virtual Reality!  \n\nWe are pretty sure you know the classic Jenga, but what if instead of wooden blocks there would be colorful fruit cubes, the towers would grow every second, and crocodiles would try to bite your hands?\n\nJentrix mixes different sets of mechanics from everyone\u2019s favorite games. Jenga provides its well-known look of the tower and tests your physical and mental skills. Match-3 brings its popular 3-in-a-row portion, while Tetris vibes will put you to the edge while the tower grows. \n\nIt\u2019s Jenga you\u2019ve never seen before! \n\n\n", "short_description": "Jentrix is a board arcade VR game with a perfect mix of Jenga, Tetris and match-3 mechanics! Grab, move, collect fruit cubes, don\u2019t get your hands bitten by crocodiles, and remember: don\u2019t let the tower fall! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spheroom.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "SPHEROOM LIMITED", "support_website_url": null, "website_url": "https://jentrix-vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2593437067456791"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984443_1134814376930546_4858039055876247561_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vG_M859vIAkQ7kNvwHohrLi&_nc_oc=AdllAyzPLKJ7V87LbTpBdClLT_ZAaRk90peLiMrztb8m0_QkuWKIAnux-q0EasTIa_w&_nc_z
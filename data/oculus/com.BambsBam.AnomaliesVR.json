7&_nc_sid=6e7a0a&_nc_ohc=HQe9uDC1iIEQ7kNvwHGcLnL&_nc_oc=Adn9ROpD4Qw6ddQJTbJyNL6pZSkCsYrQYTOkXCvDdyOOThMG20bYsjBV91oYIRnsVB8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsrbY_AyRaOWMZA7otgvBEt9uvLuZ5bj94FTWTz1UvYQQ&oe=699B04BD"}, {"file_name": "NewMap_Custom..._23.02.2025_22-36-46.png", "id": "1804534303637981", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391896_1804534306971314_8526765286868852693_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNPDqy9O8RsQ7kNvwHTmP9x&_nc_oc=Adk3U2UDtEfzMNwRplurvH7Js2mylvECSKmXk_DIoC3wSUUBqXmI0JYQuzZNBljqqPc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afuc35M3yhih24-ApW_k6vAXQ8hrASbGnC6FmTfsADWzEw&oe=699AE47B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AnomaliesVR", "keywords": [], "long_description": "Anomalies VR is a heart-pounding horror experience that reimagines the fast-paced movement of Gorilla Tag with a terrifying twist. Set in a series of eerie, dark environments, apes must use their agility and wits to navigate through the facility while being hunted by horrifying entities. Every shadow hides a threat, and every corner could be your last.\n\nWith immersive VR movement, spine-chilling sound design, and dynamic AI-driven anomalies, no two encounters are ever the same. Work together with other players to survive\u2014or go it alone and test your courage against the anomalies lurking in the dark. Will you escape the anomalies, or will you be caught by them?", "short_description": "Anomalies VR is a terrifying horror experience where apes must escape from the creepy lurking anomalies inside a big facility. Run and Hide as they will always find you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/wgs-updated-website/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "BambsBam", "support_website_url": null, "website_url": "https://sites.google.com/view/wgs-updated-website/home", "c
7&_nc_sid=6e7a0a&_nc_ohc=HQe9uDC1iIEQ7kNvwGTCLKj&_nc_oc=AdlCTTu3KGbOJMZpqs1a4HBtuX1kpSMI8hzCeTTM9IFLAm-ntyggumbJoYYmklHfvj4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvRGPFAOzYL89VrOvigqz3Ytt0SremAiCK7IlULOhqx6A&oe=699C563D"}, {"file_name": "NewMap_Custom..._23.02.2025_22-36-46.png", "id": "1804534303637981", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391896_1804534306971314_8526765286868852693_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNPDqy9O8RsQ7kNvwHqw1sv&_nc_oc=AdkGN0JbF5Kt2VA2Sgb6csbGITPfU7jn0lUf3wnyFDxl9Q2KO7WjDslXXGEy7EHFDhA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsypRBxt2DuleklcKh7V9mMP3dh4F-oWsO48yYjQZCjcQ&oe=699C35FB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AnomaliesVR", "keywords": [], "long_description": "Anomalies VR is a heart-pounding horror experience that reimagines the fast-paced movement of Gorilla Tag with a terrifying twist. Set in a series of eerie, dark environments, apes must use their agility and wits to navigate through the facility while being hunted by horrifying entities. Every shadow hides a threat, and every corner could be your last.\n\nWith immersive VR movement, spine-chilling sound design, and dynamic AI-driven anomalies, no two encounters are ever the same. Work together with other players to survive\u2014or go it alone and test your courage against the anomalies lurking in the dark. Will you escape the anomalies, or will you be caught by them?", "short_description": "Anomalies VR is a terrifying horror experience where apes must escape from the creepy lurking anomalies inside a big facility. Run and Hide as they will always find you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/wgs-updated-website/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "BambsBam", "support_website_url": null, "website_url": "https://sites.google.com/view/wgs-updated-website/home", "c
7&_nc_sid=6e7a0a&_nc_ohc=X1yIDrHD4MsQ7kNvwEQ1VOS&_nc_oc=AdkpEqVWb1vbRwgSIUHe9CaR4MlI5hkN8TCCs50nfu2h-akfUWrOeO9_hBcksrKIQrQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsMdloHn7qILk7XioZgYHIjI7CG-7EW5G86CMOdEIAtYw&oe=69A6E23D"}, {"file_name": "NewMap_Custom..._23.02.2025_22-36-46.png", "id": "1804534303637981", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391896_1804534306971314_8526765286868852693_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9hFaiI_TxMQ7kNvwFNo_AG&_nc_oc=AdmDks_WBScPLRStotdo2DK2Vp0NyE-lcSZ8yoXf5lPnJdVpxYFIvHIHC2JPzD6duJ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsksGXYyLAq_hut0Kdy4JJ5iF0X4dky_5nuDczTDSxSNA&oe=69A6C1FB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AnomaliesVR", "keywords": [], "long_description": "Anomalies VR is a heart-pounding horror experience that reimagines the fast-paced movement of Gorilla Tag with a terrifying twist. Set in a series of eerie, dark environments, apes must use their agility and wits to navigate through the facility while being hunted by horrifying entities. Every shadow hides a threat, and every corner could be your last.\n\nWith immersive VR movement, spine-chilling sound design, and dynamic AI-driven anomalies, no two encounters are ever the same. Work together with other players to survive\u2014or go it alone and test your courage against the anomalies lurking in the dark. Will you escape the anomalies, or will you be caught by them?", "short_description": "Anomalies VR is a terrifying horror experience where apes must escape from the creepy lurking anomalies inside a big facility. Run and Hide as they will always find you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/wgs-updated-website/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "BambsBam", "support_website_url": null, "website_url": "https://sites.google.com/view/wgs-updated-website/home", "c
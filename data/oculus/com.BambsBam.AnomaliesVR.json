7kNvwHZmk_4&_nc_oc=Ado_perufTSu0fhKHnpEkvcvj1PPEA5SZSHe0cmVHDg2cY8xdg_FgyPkMRts2FE1XMw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9_pBzTVvI6S3T2Y2YRP7AL-0-x8UaQRqaoMq5OUeUbA&oe=6AFB39A5"}, {"file_name": "NewMap_Custom..._23.02.2025_22-35-21.png", "id": "3369003473231020", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391896_3369003476564353_1395099242997111134_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJEVHKWmsbkQ7kNvwGZ7QKN&_nc_oc=Adrsim3XaEZuka2OmAl7G7V64R5NgRIUt_JCNj-VwefKyQJQ_fRIuTRKfJs4kuR1KKQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCoG9NOncWHfUyq4wpIxRPKWMJ8fISr-hTMEKyDbY4dw&oe=6AFB3D7D"}, {"file_name": "NewMap_Custom..._23.02.2025_22-36-46.png", "id": "1804534303637981", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391896_1804534306971314_8526765286868852693_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmmtbEGRVHEQ7kNvwGBNvlC&_nc_oc=AdoxcuuLz1qi2fox8O7hK7R9blXwZZlM-sSuF4lCmyPKEETKIwvimAtstbnXMxlyJ8U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8i-DOv1MGrD3kGrn-tBYgGYRoEESq8wuOnxk8VN_-DQ&oe=6AFB1D3B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AnomaliesVR", "keywords": [], "long_description": "Anomalies VR is a heart-pounding horror experience that reimagines the fast-paced movement of Gorilla Tag with a terrifying twist. Set in a series of eerie, dark environments, apes must use their agility and wits to navigate through the facility while being hunted by horrifying entities. Every shadow hides a threat, and every corner could be your last.\n\nWith immersive VR movement, spine-chilling sound design, and dynamic AI-driven anomalies, no two encounters are ever the same. Work together with other players to survive\u2014or go it alone and test your courage against the anomalies lurking in the dark. Will you escape the anomalies, or will you be caught by them?", "short_description": "Anomalies VR is a terrifying horror experience where apes must escape from the creepy lurking anomalies inside a big facility. Run and Hide as they will always find you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/wgs-updated-website/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "BambsBam", "support_website_url": null, "website_url": "https://sites.google.com/view/wgs-updated-website/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "28808275232119105"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1339788204121445"}]}, "baseline_offer": {"id": "1339788204121445"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1740784800, "status": "PUBLISHED", "id": "1339788204121445"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "30304741369139143", "version": "1.4"}, "id": "3892671537672382", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28407336398879659", "is_concept": false, "latest_rel
7kNvwF-k3ed&_nc_oc=AdpAnmblBw-PTn3LrY558PjkFnheKlq47hu8ZoncGubCxmZVaTKCpOboAcwB0OUvOeg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXkwc0EZwYsSfyY0xAsYbgnrtGDH_rIG5Z4HgxOgQlXQ&oe=6B007FA5"}, {"file_name": "NewMap_Custom..._23.02.2025_22-35-21.png", "id": "3369003473231020", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391896_3369003476564353_1395099242997111134_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0m3YICLaSrMQ7kNvwF2-lE1&_nc_oc=AdquW7mhFFeozZA9uahMZZlw2acgqNLGaMpPCphlamu3jWkYXyanFbXcGNqjFwj6ocM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAOg85X3xjWjZLjqJ47c021eVMAFrg_-B-_FqbGW3EWQ&oe=6B00837D"}, {"file_name": "NewMap_Custom..._23.02.2025_22-36-46.png", "id": "1804534303637981", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_1804534306971314_8526765286868852693_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JC8Iku73C0oQ7kNvwGmQ39s&_nc_oc=AdquH67LxyYyVk8KTUtYYZ8B2L3ajfe5n2v2eU9NC8nBWieJw1Gf73hzx9xvjQAsUbk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4qDeDDRys_k-NQrVgVFpaGr9T_zs32YjW2PZSRm6rOg&oe=6B00633B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AnomaliesVR", "keywords": [], "long_description": "Anomalies VR is a heart-pounding horror experience that reimagines the fast-paced movement of Gorilla Tag with a terrifying twist. Set in a series of eerie, dark environments, apes must use their agility and wits to navigate through the facility while being hunted by horrifying entities. Every shadow hides a threat, and every corner could be your last.\n\nWith immersive VR movement, spine-chilling sound design, and dynamic AI-driven anomalies, no two encounters are ever the same. Work together with other players to survive\u2014or go it alone and test your courage against the anomalies lurking in the dark. Will you escape the anomalies, or will you be caught by them?", "short_description": "Anomalies VR is a terrifying horror experience where apes must escape from the creepy lurking anomalies inside a big facility. Run and Hide as they will always find you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/wgs-updated-website/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "BambsBam", "support_website_url": null, "website_url": "https://sites.google.com/view/wgs-updated-website/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "28808275232119105"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1339788204121445"}]}, "baseline_offer": {"id": "1339788204121445"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1740784800, "status": "PUBLISHED", "id": "1339788204121445"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "30304741369139143", "version": "1.4"}, "id": "3892671537672382", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28407336398879659", "is_concept": false, "latest_rel
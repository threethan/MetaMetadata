7&_nc_sid=6e7a0a&_nc_ohc=HQe9uDC1iIEQ7kNvwH51Ejm&_nc_oc=AdlwpYPRvz4AqeLSxf0Z76njoXPKCsoa8BBw9I-UfFdQBTRBSQ0Bs3klx1ErNWv3s44&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvB8NxgJ-VxEy_qxGI0urh55Jak09ABO8mVc0aKBTs6UA&oe=6999B33D"}, {"file_name": "NewMap_Custom..._23.02.2025_22-36-46.png", "id": "1804534303637981", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391896_1804534306971314_8526765286868852693_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDlRB9HJUnMQ7kNvwF4xFIy&_nc_oc=AdkI2Edb9drbffUTdtN6_Raa-_aneh6r3I0ynp5VlAN9WooX9Lbqgq5igXHCkoVWPlk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu8E-OInk1Kvcyi5nXSZXfRp-5s8tQECUfTQUnDIMMvvg&oe=699992FB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AnomaliesVR", "keywords": [], "long_description": "Anomalies VR is a heart-pounding horror experience that reimagines the fast-paced movement of Gorilla Tag with a terrifying twist. Set in a series of eerie, dark environments, apes must use their agility and wits to navigate through the facility while being hunted by horrifying entities. Every shadow hides a threat, and every corner could be your last.\n\nWith immersive VR movement, spine-chilling sound design, and dynamic AI-driven anomalies, no two encounters are ever the same. Work together with other players to survive\u2014or go it alone and test your courage against the anomalies lurking in the dark. Will you escape the anomalies, or will you be caught by them?", "short_description": "Anomalies VR is a terrifying horror experience where apes must escape from the creepy lurking anomalies inside a big facility. Run and Hide as they will always find you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/wgs-updated-website/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "BambsBam", "support_website_url": null, "website_url": "https://sites.google.com/view/wgs-updated-website/home", "c
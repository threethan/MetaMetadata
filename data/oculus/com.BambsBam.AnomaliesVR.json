473231020", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391896_3369003476564353_1395099242997111134_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4eqcimo6NgQ7kNvwFNr2bF&_nc_oc=AdpnhutZbTdteQ_gonLgZ1QhlpkISvp2FiRAev-8kvjGEdJyZVwI8cjaRMNTWd24_IA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2MFgJVQeTTGa8_a60tL4YNzbRrFDGcm9y_aOKxXG-cpw&oe=69F3593D"}, {"file_name": "NewMap_Custom..._23.02.2025_22-36-46.png", "id": "1804534303637981", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391896_1804534306971314_8526765286868852693_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DK2oZ0ZXD_gQ7kNvwEFbGSc&_nc_oc=Adoyyp4j7RLQ-gorRYm_Qy9gGKY_BGtRtmqSjnbnJZ5uFcCA_rdhYyPHmxEbS5Nkb4Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af37MpPLiWlGnflhHnnia6o5zpb5_TtOxnLL-eF31cYONg&oe=69F3713B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AnomaliesVR", "keywords": [], "long_description": "Anomalies VR is a heart-pounding horror experience that reimagines the fast-paced movement of Gorilla Tag with a terrifying twist. Set in a series of eerie, dark environments, apes must use their agility and wits to navigate through the facility while being hunted by horrifying entities. Every shadow hides a threat, and every corner could be your last.\n\nWith immersive VR movement, spine-chilling sound design, and dynamic AI-driven anomalies, no two encounters are ever the same. Work together with other players to survive\u2014or go it alone and test your courage against the anomalies lurking in the dark. Will you escape the anomalies, or will you be caught by them?", "short_description": "Anomalies VR is a terrifying horror experience where apes must escape from the creepy lurking anomalies inside a big facility. Run and Hide as they will always find you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/wgs-updated-website/privacy-policy?authuser=0", "deve
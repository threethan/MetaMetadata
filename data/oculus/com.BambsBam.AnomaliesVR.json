oculuscdn.com/v/t64.5771-25/473391896_3369003476564353_1395099242997111134_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfu8Og6ccFcQ7kNvwFJNaJo&_nc_oc=Adk8_viHTgJfmF4aPYS_0GrMv1UkUFrkuYc38r2H2BKnEU-rYnuPhOYzDiyPOW5KeAg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwUIZy0AqDr52YHqQSLawH-D0bDca8dUSJSLEMSiHGaBA&oe=69B01CBD"}, {"file_name": "NewMap_Custom..._23.02.2025_22-36-46.png", "id": "1804534303637981", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391896_1804534306971314_8526765286868852693_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1s078dcKQUQ7kNvwET6-p-&_nc_oc=Adni95EuNHS5DHgiiDDo5K3QTUeQfKtNyOjgr4EV-rEkstZldsk1BYpYkdMv1UlYPqQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz5QgfxCUDx8qJf6gUckgQwlnV8shiDcBEpgvORKg6Kig&oe=69AFFC7B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AnomaliesVR", "keywords": [], "long_description": "Anomalies VR is a heart-pounding horror experience that reimagines the fast-paced movement of Gorilla Tag with a terrifying twist. Set in a series of eerie, dark environments, apes must use their agility and wits to navigate through the facility while being hunted by horrifying entities. Every shadow hides a threat, and every corner could be your last.\n\nWith immersive VR movement, spine-chilling sound design, and dynamic AI-driven anomalies, no two encounters are ever the same. Work together with other players to survive\u2014or go it alone and test your courage against the anomalies lurking in the dark. Will you escape the anomalies, or will you be caught by them?", "short_description": "Anomalies VR is a terrifying horror experience where apes must escape from the creepy lurking anomalies inside a big facility. Run and Hide as they will always find you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/wgs-updated-website/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name":
oculuscdn.com/v/t64.5771-25/473391896_3369003476564353_1395099242997111134_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hmh5h0RC0f4Q7kNvwG2ND2s&_nc_oc=Adl3Dvj1KD1i03GWeNGRa3VwpXpJL5MenpbUOJwT_-2NAiCFKHOqhc3BBy2TN4pO818&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzL5x8mnXkwUKBQ-2sqPGye2IxKEQ9GjCStqrGmdh0GCw&oe=69B9573D"}, {"file_name": "NewMap_Custom..._23.02.2025_22-36-46.png", "id": "1804534303637981", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391896_1804534306971314_8526765286868852693_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O26AkODPH6wQ7kNvwG7o_Vs&_nc_oc=AdldAGQCOLsj9hbMUC-V6cErgAH-80P6BVm22S7SQ8YmPTxpdS9Ah4-Og_DBW-q0lfs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwGdFsYVW52Jh-29wRlze8WeuhCSgZ21E1uhH84lPDg1A&oe=69B936FB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AnomaliesVR", "keywords": [], "long_description": "Anomalies VR is a heart-pounding horror experience that reimagines the fast-paced movement of Gorilla Tag with a terrifying twist. Set in a series of eerie, dark environments, apes must use their agility and wits to navigate through the facility while being hunted by horrifying entities. Every shadow hides a threat, and every corner could be your last.\n\nWith immersive VR movement, spine-chilling sound design, and dynamic AI-driven anomalies, no two encounters are ever the same. Work together with other players to survive\u2014or go it alone and test your courage against the anomalies lurking in the dark. Will you escape the anomalies, or will you be caught by them?", "short_description": "Anomalies VR is a terrifying horror experience where apes must escape from the creepy lurking anomalies inside a big facility. Run and Hide as they will always find you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/wgs-updated-website/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name":
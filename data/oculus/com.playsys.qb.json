ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24_jF6wCWE0Q7kNvwE6i61c&_nc_oc=AdqLdVTuBPceony2YCfipj_44OTGUDs_W5Ekn2d9WvIyRG8_QHaAJ8ahyre_CxzdbTI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuAEp-VmDIAex2eBVpM_atEj0ywCRtcXrlKJixFTbqZQ&oe=6AD0ECC5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuIVikzqd-wQ7kNvwGjyOWb&_nc_oc=AdrNxQsqRBrMGo_wfqgv1GO4ym9VaF3aGemKLjTHQd8umUTnB5CL65k4qVPpqxsbRlg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuGQi2yOdbjdxXwMKDgNMgb65thGs683gADyFq6wlW1A&oe=6AD0FD91"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIZYzpbnEtAQ7kNvwFcGsDM&_nc_oc=AdqADGA2N_WDECqjgbzbNlrSa9s-00Ub0FqARFRyuAQPWqPkuTFgj-Ihk8wbE_tVGm4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYoJLTASNZuXOCeeuN_VVyDgRSCtuJS1kATXjFD6gUYQ&oe=6AD0E830"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQ0jNHM6wDgQ7kNvwEexYap&_nc_oc=Ado8XezuJk0ta25KQnGsQAIebPy621WtFPJr0eS3N6Mcg1BZBErG1d-sGQAS01uJgSc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQhit2WgDC9_niD5QjrJYxdW--4FpZzKgqHWrlTos0nA&oe=6AD10125"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EWuPHvqnmAQ7kNvwHuwmpU&_nc_oc=AdqCgO80utuPKtsxpquSaTQE2GOU33zNjeGx8YgDd9m8Pxt8tCPMMtkGs7hMCUypzF8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPolluZyr-NQXgvTly3YVanGqW3wILmhMSlXcxQrAivog&oe=6AD0DF32"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
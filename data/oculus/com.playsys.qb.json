ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w55eQc00Jh4Q7kNvwENhup7&_nc_oc=AdqioTjTuJ-SiuD-C3fDdwGvsoidOPEb0LYpi_Gm506LJoB1hrFWD0b7ZCAvsKpSZo8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExddmuTRUxxnTSiZCEmPXuwVL262PKr2atZBgZLmZy8w&oe=6A901B05"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVmccvyq7xcQ7kNvwEa4a38&_nc_oc=Adqb-AbKwCHZfFORd4CVpRYjB622OnPM6h-hNU-nLX6EQi7jDX9dQ_IwtyfiMfSXCSI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4k49AVoDdiO6SEQSTBFppoCE9c36acnZZ-fgPhSnrtw&oe=6A902BD1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VQiUnBWakoQ7kNvwFvw0gd&_nc_oc=AdpvPe-VScUfzcM8mObSijkBgxhA8fsw3O9lrKdhXllvMn03pedDvXkZxVRdYUabOLA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3KW7CcQAufBJuugiyfQ0AH9LszayrKrSzh65UydQ9mQ&oe=6A901670"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dN7WLBqPJ70Q7kNvwGqNGfd&_nc_oc=Adost2UhtIsJCAbIply52Uq_Sq4ZTUCOSywS6lKGuAR8LKIS5ZObq5XpZ0DZ-RHhYSk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFf1RdsiymDQ7f7DnBPFKnhGvGebJLkoXJNiv1M6tK0FA&oe=6A902F65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRWERnwN8zwQ7kNvwH2J2jy&_nc_oc=Adqh4W5Y8Wh84HN2psdb3vWv2BqFmc_xzJv0gMFMYN9mdZMzvSok0hwQ2KJ3axo_qK4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsR1n5UZa3A3BCgPQgIhxOQtb01ajHZTgSz-fdPWYt0Q&oe=6A900D72"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
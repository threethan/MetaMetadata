94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BuEOKUi2SvsQ7kNvwEebRjk&_nc_oc=AdqFQRTVsEDNYiA09hJDhJ-AGZVveyrtO0SEITPKWZ6PT8aBNShYzLWKvYCj3ZQUQWs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Q06MGd5mD_etwr48ULcXbfsizd1G5xmsYLo2Ac0-gnA&oe=6A1314C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3U1BJUowtdoQ7kNvwHlQymv&_nc_oc=AdqjJCty-Qwc3p-Ea7VY9a_HKqde4avlkLvJ6tQtwr0egplQPLlBaq9nd2oGCL7YMU0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WRmECuOExXVr1uCiAt2nejDCCAiHfIOtMNyIUmRR-_A&oe=6A12ED51"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46fMv2rRILYQ7kNvwGq6gN3&_nc_oc=Ado7S39armJAOlnByPDI1Wq7xHyXbQMiYeWTOXML9efpgfxWNh90xvNEaNMNL95iRtc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50ijIrOuYJJ5NL7SFQ94Tlk01rEspUPMFGQ4ne3CMclA&oe=6A131030"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UM9o5difzLMQ7kNvwFGj7aj&_nc_oc=AdoZq44_t90Dm3cs8EwJHxL_NjiSnil4CmflWsQbxQKeDBrIwA92fdoawlumNEiWeBg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WYKVxdfclNk_1btGqkTpD3RB-MiQfPbsTkDSdQIugHA&oe=6A12F0E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIFBQmoE0uAQ7kNvwFjXe_G&_nc_oc=Adqfi-cm_CtI9yhXw9tl0ZaEN17mZACIi3mfVnkx-R-7VzKiN4u9FeWxY4QVTbHE-s4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XuRb7ZXH1bHrA-i3E2dfKQIJwtmpKDLExFXKYQiQOww&oe=6A130732"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
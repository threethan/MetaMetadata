ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1MgvmX20XEQ7kNvwF-fMHS&_nc_oc=AdrWZqzQXNoV7q-2KY6qznsss7pSIhIOysGkLnwfT9x7h4AxvD9c8wcRDAvQMEsgIHM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_Ez9woY4Yf1BCkjDj9J5n_iH9QMTxYyQJ2fk0VZum5A&oe=6AC11AC5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FN4ZB_7TM8Q7kNvwH2Sz0N&_nc_oc=AdpmX4XVItGP5sLG-oDiI5ZM4lQk3wyqJEDgNA5xKHMB8h_K_B__vnHxHobdWLZusS4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5k7c6u_VA7n3crQg36vdIlI2R2BHKuWb4BV7v-OhpBQ&oe=6AC12B91"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5hnuwgP5WMQ7kNvwGTPuiR&_nc_oc=AdpjuL8scW0NWHmn_MW-fbOEPadHDL_diXNRk1BI7-CrDfgZ_5p60TrCmABVmj8w8HM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSKyfHMj36TjkVZNSzZt2kMP_wweh9BbUZi1z3t2DtSw&oe=6AC11630"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkwX6MPUHiQQ7kNvwF7M3LD&_nc_oc=AdrQlhFb7x89KtE9MGndNrxq6Ck6BWek6VSQw2RflTHTj6xk-vtn1dbdamvyRu_CdNw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2-9O1eU9GTb7ujb-UBEddu2przw1pLpmAsa11lnGKOA&oe=6AC12F25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMY6tRk2J_EQ7kNvwHcyExS&_nc_oc=AdrQQHXxn-wI3gIEC55CmMPL4rKSa47Gm-MVQPzANvsWz8WyYXaWf9KGUwRfj4IlGns&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJchw41WG01vKLjrSWnkK32P61ZlYNKq39xtVOfJwe2Q&oe=6AC10D32"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
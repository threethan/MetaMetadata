94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBoXfb8xfasQ7kNvwGRT_DY&_nc_oc=AdqyigO3ehUaXY_PDX0iSRWy15KjlyXje5suViqljoy20Kjnl__GP9EtFthS_bcQfUY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BR8xXBR8aSSVvxRafw6zibkwvsgA0B4TCChkMzLYHCA&oe=69EB87C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klNOV-OnyTQQ7kNvwFM-8Sz&_nc_oc=Adoz6D7QsNHK5vwl6tKeMT25Ey15p9VVS3M9_wk6jApELV3SVzJiq34ZWpyMFV1fbKs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jiw_HlPwTkDEsnvwG86Rx4Uj4ZXouQ3fdbbXRWd6PPw&oe=69EB6051"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCjxNV_SysMQ7kNvwGgwh78&_nc_oc=AdoXIOlTS-3LgSmYfDpETFz8S4ud-BTYuuUjeELsgqGOK60puddfDTQUcpfgcn_f4vQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hJfsd8H0qAxeNeqeLxojGly4hir2Is4NP1Tp9I4gzQA&oe=69EB8330"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svBJo8lX7J0Q7kNvwFlCw8w&_nc_oc=AdrQdhKiklmg1-kKoI5rGtA4MnWnv0cYAmhExxX8OUu8Ak2Z_HZArR72HZwE1v-UX-g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SJVrxZ5Fv2JikaMHhRf1fZ5s1TMcfIPFtPd0VEZ9XFA&oe=69EB63E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_dJsYt3X0cQ7kNvwF36J-C&_nc_oc=AdpQA73Xsm5PihufVbHqJzOmStVgfR2JmQcrejZHOpRyOgRg-NPO0XcCnk0FQrr2pS4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KVOvOlo9NY0P2n12MOSKFCdN2SHUNUCMA8k5CE0i6Qg&oe=69EB7A32"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
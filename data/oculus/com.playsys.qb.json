ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luHmflJVaSQQ7kNvwFaD55n&_nc_oc=AdpG5i_rozFg7gm6mRnERFsA0Vba9Rs3MFm40l3VqAkRonOxy0xjcdqAWirupCBn36I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKpamSMpIYmregvh77DbFmqiOsvp9bHXoFWsC8SIcePw&oe=6A5B5F05"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsyJqLh8vQkQ7kNvwFYWPdx&_nc_oc=AdroNxemU3yTTWOWZVwKFNGHYbHC8IwEamc5eh96IxskggPsHeNOhuzfRQgVdK4CPKM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLNbo6nYQ3eCrnrQU7S_SDshe7ObDg7pg7xUOD6TUiBw&oe=6A5B6FD1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKeIT54rSzkQ7kNvwEv78ND&_nc_oc=AdqH2STf37WMiryXhurnsmxPnFdO3D4RjDr8_A0O8BjHOLAVN3ZcK_Ga6dg7-EgiSTU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDciFYuo9l0Q2RVXQea8bAzjvkeRAY7ReG2ZXYc47V8HQ&oe=6A5B92B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgDSTs0U1iYQ7kNvwGpdHmf&_nc_oc=Adq1XWrxH3ZZ_fqKEBAAHWWkQr1j8f840GzJ8g80DlSMiZGJGXW9Ep_GRNaY4yaG7yY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrG1yYhfJfzItoyz8nWqCwdpzrbdlzYhzIst9ifMxUjA&oe=6A5B7365"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpL3_N9kHnsQ7kNvwH6iQO3&_nc_oc=AdrIHv_KOlJPt-YcM54dpPNz3S93HICx12uEXxj39Jil2PKO179OpZp2PpePUAup48Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZw6AqE3obDzfi-f3axoLNSqPdclexNEaoG2n5JF6jcg&oe=6A5B89B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
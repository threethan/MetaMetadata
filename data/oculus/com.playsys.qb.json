ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLtkvn0S85AQ7kNvwGwif1Z&_nc_oc=AdrVO-xVEMrGDAKZNEmbgLeUETEIOqR2vxJrtrJCfnAdVJ0fe8vMfTsrdD6xQO8rhq4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPf8ShVbMVZTkQR0FJfiWr68AYxAd5e4RbIfasamhI5IA&oe=6AE604C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWRQtAWa89kQ7kNvwE3FXrT&_nc_oc=Adpn3XaCbxj8N7vPla-5M73jzAhtl1-le0DBIU4u_yVGvrj9u2kaxPGe4I1Pdn7R6Sk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMncXyu2y6PaMKXYSBIJmmkVMxToHBKMtQUGv3869TNDw&oe=6AE61591"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3lH5H3ZJWYQ7kNvwG4XDeJ&_nc_oc=AdpvX3PiEOYcAzUYlcZ0bqBsUT6m6bDKjkUnqUndu-_RUa5eZUBjBvNqghwwpZ6Hr0c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMrOWIAnFir8nIy5nPcBwDIfWJ9kDujThnCn3852Owxw&oe=6AE60030"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzDx4ob2yAkQ7kNvwEOKtr9&_nc_oc=AdoG3Tqgz3t8kddk7BcutFB7fEo1zZFtXS7h9sNQGA-oz8JQE8hm_T_1ju6SR09LXug&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFQPOiAIL0hNzZumzL6CRQf9fdbON1i8r4ZVxcpM4OfQ&oe=6AE61925"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gn0WL8xi9W8Q7kNvwHjRvCU&_nc_oc=Adqim1BmQsFDNp5T4O1T4cnwZJYWLLz_zdfvmq9AGV-0fkYk6m3j8_bTfsSEDBoDChI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOcw4LoQnCpDqyphvgtJ03UYW6CMiVwyHi098nJr2aIA&oe=6AE5F732"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
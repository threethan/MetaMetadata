ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gC2l9pPn8b4Q7kNvwH3E0cL&_nc_oc=AdoP3cnH0yVYOTFepaCYyVzehUX3tiXpPewghutA4EhZXqigDM8Cu2jm4SexKFwnKiM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2zEb5LQH55VeGEtg5ArknrfmjTmAiEVakN5CXGrbQGg&oe=6A64D1C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ll_y01t5Pq0Q7kNvwEl04R0&_nc_oc=AdqyZGwbN9Voo2XqdsnHvUp4Td3G5q2jvVoPFQiXGJPr9G2OWjwQEfc1pGvgCfkWuWA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfr8VeKJQRD9X56Bkai7DrzCUkulm4ohMXsVfu7tkEpw&oe=6A64AA51"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbv2k2lPpzMQ7kNvwED3sds&_nc_oc=AdpKf4pl9EcVlzKapzJqjIdCHGNs_mifJXGaZ654mMxdK_APLlIkA9coLvF7fR2YcIg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCS5LMVpv7YO0Y2WIguMZEyR8OhhrQO5apOKgq43xeCBg&oe=6A64CD30"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUxS5H1WPFEQ7kNvwGhmJRv&_nc_oc=AdquHC5CNmxWiTxmK3Virv70mnYm9dO5k283l4TLg5Yo8Az71gbWB3nGoZI0cvSWmQQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTlexDks45MEymu98VMshkBmDg3-xIDRayWrnY2EAm3Q&oe=6A64ADE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgzrP6gEWMUQ7kNvwFAzc_T&_nc_oc=Adp6u-fLqpapf6Kp5fr7AXMpjcPjrhV0bZu5z3ielleFK82M99O_DiozqJyBsq_x6qU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_4eLblOCnBy224ine0ke3h3mQX6Wr1VQ6FPFeAyEZdA&oe=6A64C432"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
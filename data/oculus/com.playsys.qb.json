ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYpgIJ5f9jAQ7kNvwHT8xPo&_nc_oc=AdqnfRfc7HmSXCRA_QRPFQjdpy9vc9gxPTZhAjEjw2mvYRviwktkazvrH-IPMR_9QuU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-ViQVg0N9ix7dEQT5RCsNWk91g_xxh8aV6YvZXZ1MRg&oe=6AC7B245"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6Sm7rsfCwYQ7kNvwEqtpK4&_nc_oc=AdqDE8izOBY4IcVdUkC404cH7uLrlFWc6pbwiB-sdRi0KnhLIXBkK01gNPq5Uimbmv8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNppATuSoBewcqVvAyAJP_4333BA3PHXH_EhZEU2jhmkA&oe=6AC7C311"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJZOVD1h2R8Q7kNvwG3O2ke&_nc_oc=AdoFZVgFF7X5fvMFBr7wKVSfHbBv-RHsq2OEfGzl23txrHpxV04UCAxQ-R0BW1ofw98&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOo2ogYfM4jKGBIsvp53GZNsgPmfGSj6LH__Eb8q31vYw&oe=6AC7ADB0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiiMH1bYVUcQ7kNvwHjzpJf&_nc_oc=Adq0b6IkJNlZGPhHjqcyilkPansRqD3LkqSHNCME42nDFygNPAX9F0v2frbRx-gxE5I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFeB0Sj4kIQPOp3GSEOnE_blLfHZ_w4Qx8ihVHtxHPHw&oe=6AC7C6A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IcIhWFBW6SoQ7kNvwHZuUib&_nc_oc=Adpz7KqD8f3pffa0b14WNXDEP13UyepfxdGDEJSqRnRxkMXCYxMmTaHnxhPZaR4kWIE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcPqTB2GhCIppXPZHFmflvOiXvOS_eJccnEKCIkTaBZw&oe=6AC7A4B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
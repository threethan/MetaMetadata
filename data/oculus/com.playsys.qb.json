94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGHIhQkEnLsQ7kNvwHDuwXS&_nc_oc=Ado9g3RLnj37GsPSs6p3DHf5yb1984u7FWpVzEim15swzZoaVN4TKDylnNDgcjLAhhM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oaA5ppWVoUS3HcmWLiWP9dV2vXiUo-drnNP7LVQvVsQ&oe=6A073745"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25-15AdIhQEQ7kNvwF2DlLw&_nc_oc=AdqQ8ZDnxKlSuSAl5qXeV4bziEzXc3ps7ajYX-2Htt3vct-ex93kiAKXQRxmVdk40ls&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QX72_lmIilPjz0_48s6ncMZqybkD_6LRZ9yI7xFjIgg&oe=6A070FD1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWK7sypFcI8Q7kNvwF_k_sv&_nc_oc=AdoZ5M_-jCLDJkBgSKcsuEjvi6mF900vqRfArWbHMhE8swXnksjig9BEQLvHDUkLjag&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WpBouHHxzPQzmLkmRm8LDDJXwzCQgP7MI7QQ_M_YgIg&oe=6A0732B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNqVCq3D9K8Q7kNvwH3AxMn&_nc_oc=Ado9ZSIIm4B83D3hhuxFfN15ngeEDFRUnf1y7EgbLvabcJzDbxn7lxBs4fhhhI7zavA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4suqu6nAUrB1koFXvW4IhrRcO2Q-beBn0bYfmJgNYTVw&oe=6A071365"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SohjI88rdIwQ7kNvwG_O6O2&_nc_oc=AdoPMmzta-uHDMBlrCnWK2HJKa9W3SfBE1ir3Qdmxa9wgBmla1XOSIxiOy_t611dnlQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73h-0PrgZtdSeUaC_KbrPbIYyypq3OSFXwCbYxIF3e7Q&oe=6A0729B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
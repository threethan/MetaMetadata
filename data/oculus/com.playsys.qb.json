ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1TUT77iTWfQQ7kNvwGgzToW&_nc_oc=AdpTy9awSW_tj_2KqsUuqUTij6yA9834aVKpCkuL8A5yEU09qUb6XS9_-oc1vxfxiz0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MKJCDIqSTmKXGXx2UY9wuhGA1ZRa0C6ADrSkOCZyVVA&oe=6A47D0C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGFfxr0eFycQ7kNvwG0w4ew&_nc_oc=Adrmqv7yG0N06pcOlqwMiV_vYbpEe-_VJf2j0t31beik5aeBtdIiLSZdghE1Z7XS7j4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RdWcLiU_0qrFHjyFnRj85y70guUZPAUOOVw_FbWj3Tg&oe=6A47E191"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwZXYZztqMsQ7kNvwEMeNfY&_nc_oc=Adoq4rIWC3LFmvXrmT_h4WnX7-2_pZ3H57LCfcFpnV4jrF17x8i4jDJQsk3umVBS4Cg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--viJpdy58Y7eus2xWPSC0oi2VvFnoXcGhGmBoUrk7SA&oe=6A47CC30"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=niIgRx-HBvIQ7kNvwHSAHQ0&_nc_oc=AdqXrtsJExPKO97soeCBBOGKQ7sEv3GfcjoSNGG9p1nmZs8OIihs9sTi1_pCNtjdN_Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zQST-TiJgqmKSgcSFBbYv1WpRFw638vzfV-NOE33e4g&oe=6A47ACE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwKMB1-FMykQ7kNvwFcRrBL&_nc_oc=Adp9yewMdPsDPnl4HJhR5W6PRDkdlYAJuwIiMTsL5xNgH1fPE8YEHDF7MckQHV4D1YY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IvpcKbLU9nHr-hNj8oBdeCz6fiM8VcxTOktfPgGOjPw&oe=6A47C332"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
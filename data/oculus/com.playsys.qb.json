ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRtHsHTiM7sQ7kNvwGXzr1o&_nc_oc=Adq3ZA2h0dVyjQBD6YKOCbiE5uOEGfI07HxUaQtP8apY6irmeS2ol3w19DD3w6mLBEE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY88GkYkQRaAm1vpbAUuIsLwN42hmYpitOiREOHhrYnA&oe=6AEDEDC5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCwZ8lZBpzUQ7kNvwEhqyLm&_nc_oc=AdrilXXXJSYMjx3lJcqPLGyYhwYVFrS3Sh9qLSfZEdbzLCxP1QLB3N7UtfW8d3Lt6IU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQztDKt856sKfC_PA__CxVF78hm2EXwN7fJA1H2n0YN9A&oe=6AEDFE91"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7tkmL2wm8YQ7kNvwGkXbXf&_nc_oc=AdrTUGzNJQOabnocAA3jnJP1o5L0XdO6IHTFIRhCCI1YAY_FD0VQIMgfKQM8wDWH__g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRW_z0ikh-jl-xzu0vQ0ZAMa14Yriodk6QP5TATiWOmvA&oe=6AEDE930"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqwS6X1BeV4Q7kNvwEdDgwC&_nc_oc=Adp0saGCdx73I9Boqz4YiTKdayJ-lE6Zu8cYwrVDrsq1pIhZ87bRD2LyBV34g-vpc4A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTt1et0ETlx2JD9SAfnzkdU0KQvLfpTBBxHqy9XGteDbw&oe=6AEE0225"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icjLzE-0Eh0Q7kNvwEL5Va8&_nc_oc=Adp_Ys6QmZp453B1sU9cT1tic8HxPjqZGDHro47dj1Ds42kPwpCL7WPOusfGg0IXM2w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRD7SdwNJyHIVfmTOo0krGI4YURZfy4ZWmurgnSrYXUWQ&oe=6AEDE032"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYpgIJ5f9jAQ7kNvwHJgS1G&_nc_oc=AdrVJMdKyohugOsMk1YFVBlgWu4QGnMbjseNomf2yjWvjNXM3-FbzD7ud1bQdNYOiUE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrqW7oL6PnoyqsWm8zmzL0w60rNNYnOsvcXoMscCxsng&oe=6AC660C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6Sm7rsfCwYQ7kNvwEushwe&_nc_oc=Adqt9MJGfX37dhGcGshcd7tv-TJATEQC2Eg_X9oiN4yBCFbMevL-kE33KHyEveNZ8iY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_SKJiZb_Yu538soFUqf_AikmBeiJ7Vl_EnEPa8omKiQ&oe=6AC67191"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tyd-x8JwHE8Q7kNvwFAO4tu&_nc_oc=AdramgnrH0tVwpSbWcFWn0S8XW1IQgIJZqRqx60EvM4UuHSEiaacSYRjh-DxRHVoNm4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3YW-uEkGkMIgdn8lyjQaEbXtJxFH9aY-Y04tJ-mUXkA&oe=6AC65C30"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiiMH1bYVUcQ7kNvwEC9-v7&_nc_oc=Ado-ufryrC-VfciQzKSD79nzCLYGgZqEPKxCRdel7clSVquk4Inh52RIlQbH0IGOqZE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3yMKyYKBolHyGkIpUQ7mtlIp0YDLsoFkQIXh8oCLh7Q&oe=6AC67525"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0aO2DoQ5vcQ7kNvwFI2OPw&_nc_oc=AdrLIEOPe_I0oULj9JeeUHDuxkBd3vTR8sIO7Z39g_GRa3MmI7lUt3NStb6LQkn_Urk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGHMNkRPaEPM6VdEC0stWAzSf6HE2JEO-SuYDxE3HMwQ&oe=6AC65332"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
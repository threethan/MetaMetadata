94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GW9dOtAn7wQ7kNvwGiTFqI&_nc_oc=Adp0roJOrM7PLmPie02E1L0p5mOLsSyhg8BM6Nmb5_LW2EW31yOez2Kjwsgd51J-oyg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2n09PtVRDdIjGMUT4xl0wmghC6hLvA4-MCIYcaT_Qs8w&oe=69E641C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aW2PAV2f5ekQ7kNvwHDNSh8&_nc_oc=Adr2jksO_FVuqxHGfYB76Du2KZ_Kq55i0O_55nyi00EbNkWm8T34y9vfJx3yGBjzR6g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1plOYAtdumvmdHp5XIDPB1t3te9BrfrhNAlPUBw9GTww&oe=69E61A51"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxQneWPeEpAQ7kNvwHaEq4q&_nc_oc=Adpigxckc_OsVI5SFGBiEPh9AW5btD44-km-s4XWzuu5Ij1Z4DI-AjbhhK0HlzuJFGk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-2LwChvJVMgOfqhv8c7XHc8eX_xk_Sp2_sC5kAI7GMA&oe=69E63D30"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLOCeJAT_6AQ7kNvwGFTn8C&_nc_oc=AdpAgIwGN--OS-qM-nbmsEY9VQvLdeqTe5QIh25mQuelhniJh8MPTDWKpqQxvMRS1Ag&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30nzSVB7gtbhsjFV22aKAT8xW75Inm7WtOlIzg_DlX7Q&oe=69E61DE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7XYqYRDe3MQ7kNvwHnEOhh&_nc_oc=Adr6mnYjOPn3YbeZFQ_AifS4NCbYVBK3LeRW23jEq6re32iMhYGQ3UCFWG94sgIDq48&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2J3z-kvaEntdtGVMC19clrNRTrOE1joG0qsxFVBmFAlg&oe=69E63432"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
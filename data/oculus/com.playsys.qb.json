94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMY2wEZN9UkQ7kNvwHzl5tg&_nc_oc=AdrgnMKX9KXpEo0n59ahclvmRJzYjLLtcpHhqGeNz4GHDrSHkD_Wt44aj4sV4rzzFIA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0m2XrbpOMBUCnpDOFLfxFnFnWXo7CtYrpq4sn61NHdrA&oe=69E36685"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aW2PAV2f5ekQ7kNvwHgoXL7&_nc_oc=AdrqkKJqgFenOvJO8C84J30hP19GmjfCt1ocYo4H0oEqpqTYESD9bMXtaTJZ_XQrY5k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24ungyDk2aMyXW3QK0OEZ3D5RZo4LSTXcUAjxk7Of5cA&oe=69E37751"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRo4EeJ9Ad0Q7kNvwFB69Ao&_nc_oc=AdpuHOWTYC4vgEcQfApnu66EzQGUszQ9SIH0afILASAHK8Hqtmg9TP8HgKwWov2cyGQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BcW9IDlmbGwOtOWeGBfhFiag_CBEQBQo1q2dDrAzslg&oe=69E39A30"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZgomhNL8CUQ7kNvwHfKMLO&_nc_oc=AdpncmV8XBtwozst2d-3yMib9g71AsX6MyVzfH0r9jEbNZTesUhteH6ydlI-wAoUM9c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wXU0Up4i4WgjjHW6h6UBGvr7ymOVHuSyGBstwkzl8XQ&oe=69E37AE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpNnTnawdQUQ7kNvwFAFYdM&_nc_oc=AdpBuWblL7Tl35WROJmwpinvxSumL9QUR3cmnwqOUCg6FbcAoso-16ghqEu9yotF5ts&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03BwjneCG9WBaXQp0sxHaXEOyP1mLMxqxaMg2wEdd_0w&oe=69E39132"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
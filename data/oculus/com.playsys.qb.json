94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCI5uT4kCr0Q7kNvwFaOuvi&_nc_oc=AdpF3eWBv6KygHVc3te7TO464TLZs1a3yHIslOpV4W_0zWBYeRDzkzjoBBJKIttNFoo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MmwBI8V2I5YsA5057aM6pAmWErRvvTeQMVqUCjHpK5w&oe=69D39485"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7GUUDrvsVkQ7kNvwGepDsI&_nc_oc=AdqNcMtscoF1OS1Zt35WdnkCP4AeE8MWftMmaBqzCXTrSbY8w-Hx9sGeNgflzFTXFM4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0O1A60xwPTggqpob7MkvgzWtcwT_objnxyE5iJEJpc2A&oe=69D3A551"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAfUeO5ot8MQ7kNvwH9YAaB&_nc_oc=AdpB2d54POelGGmynFKirTPM8BFjfwqeOJ6ypS2grc62gxW7AsARvkAXG5wUaaXa5fc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wDCM2czWd8wRE-5gK5W3-1Vu-syUFa1DblxpQO_Ft_g&oe=69D38FF0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guM4pqU5T7YQ7kNvwF-ZSoD&_nc_oc=AdroUoq6W-zstZzQxtfZqqragomFwRrDewvYtKdcCzHW14li6ZLLAYPWE7ML1YbIem8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OlXSPDJ6YirosyQ3JOR16Sj_FI0QRNSvdFxc2a5orpg&oe=69D3A8E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWmJe7XiOq0Q7kNvwHsJ9fB&_nc_oc=AdpIC-dtY75IfTEdQBXR6X6Zo48Gcr8C22ug-TX9xexyNmD2MaYKm6YRK_UnFvSMwmc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CP2sbC_xrMvohUDmmeLI67sdzkypIwVveE8nHQs1SwA&oe=69D3BF32"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
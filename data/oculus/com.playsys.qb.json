ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24_jF6wCWE0Q7kNvwERDThf&_nc_oc=AdrzkCGYq5beQ-1PMbA6XuvOYRA3fP4iHjJdzypixEGWlqLosnOQ1gQXStBv67TtQfg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLQ3DTv7zA1md4bsw1A3Kva_Sc8EiLzz2p5vQY3NjbTw&oe=6ACE49C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_OJPW2Z-ctYQ7kNvwGOSqyL&_nc_oc=AdrKslNdVdC97W_LPcx3Sq0xi729O1h7rmZFqU4M7Awj4peW4j2rvtTQ0NKF9m5aZmA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMe24oF6rkoaL3ksA19vH9nlGQcQ0Iu8VWjzsTiBxYTFg&oe=6ACE5A91"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fi4za20UguAQ7kNvwFeheKu&_nc_oc=AdqtAg5wkpyGUPnv41T3EIDj_8Fkh0NhpEg9nYl4utN2JohFyfOjufGMZ4Vb-Ljp1uc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPo46SqO6WyfHhT8c0T1By3CEPnY831iuPcUCTBo40I4g&oe=6ACE4530"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQ0jNHM6wDgQ7kNvwGuikAi&_nc_oc=AdqzNR0eGtx0xUPeNRhcA1pAYUYbnl4ww6lIDVlGHi8Bao7gLsf07Gx3uAXKz-fGoAg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKp-FglccZO6GH8DoqfS0FO865measmAItc8q_i82teg&oe=6ACE5E25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EWuPHvqnmAQ7kNvwEG9NLq&_nc_oc=AdqfRCTbf3rMzLUwuR1rvEJh-qo2MtZjbNii62VN6SrTe9_cXqqrSOwd_6PitxMVbX0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKOrm4XmlPGqFeJi8qqrGmajOyHFpxO-tRs5HzBfAqgA&oe=6ACE3C32"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
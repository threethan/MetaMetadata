ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ln34IiGL5wQQ7kNvwFRJ928&_nc_oc=AdpcFpebOjmmeGMp0qeslu6wzXSgatxUS2G4Xq-LbkeGaCyJpo8vPv6llBW04mNZBWg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLX-uj1dgOqJcRQTYY0QAuPKK6yZEWpiSL8EMKtRyfUlA&oe=6A9D8245"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OM1-d6lJ6FEQ7kNvwFXResD&_nc_oc=Adqp67-Pn6X7F-_Y_jEeDLgXXLHGhEfd2WeDobwzE8sG8HKGCLgAH7CP6m14KV-6RQo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLNAYobAwRFo0fxp6zdqTC2lEA3h-Ynh1txBfBwmhyjA&oe=6A9D5AD1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szCR3zJwEYgQ7kNvwGC1N1_&_nc_oc=AdrCpCT6OCgFDnfTPjDCjvJhdyBO5P4Jqq5OOY7cHu0SvkfhE7wVbE8zn9Ervu7px4c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-b3v659NJiE905Ois4uzYiUKvr7N9mN2OIxCTMqI9AA&oe=6A9D7DB0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTTbVsqyR5wQ7kNvwEMIviZ&_nc_oc=AdpoaDyWO_ot3Hb-8N1j6LT5dAupa2uIXEWcOjFKBVmBvOFwnm5THSWPBc8RjXBNR2c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIh1pbRW1IZYyt_z_6SINHLEW7AsbZtHbcwPyT89JJ_cw&oe=6A9D5E65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_n3XuZV6qcQ7kNvwEIW2ZZ&_nc_oc=Adq1KNesIJaC7hjjhNPCDZMQMfSbhpJFgnMBMM6x7ueqlLyr9JBjpxdEjLA0dejaHEE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrYrd-e8e5vMCGHGRgb47xhfbezl5fhh_wjrAvAnpMHw&oe=6A9D74B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
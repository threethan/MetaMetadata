ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6F61hj-8ODMQ7kNvwElzbcf&_nc_oc=AdqcMjYmHUAJ5QDaTh5mPDGUwDH2FnN-QJ8iH_t0PCXRmguP6lYfXcBi34pvNkosmd0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_hFA6jCuJgCC-wJTCYiwEY8abY-o2YBsAJzHVluWYLg&oe=6A7EF785"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ipbdgmsq8AQQ7kNvwHEicyh&_nc_oc=AdqqBsvML7a3fN7mdKiiv9Y-dGpcWGSUnaenPltASKTfQIEu-ayrAModxUESt2w7H4w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXuFKPgDs5KwumAXw6u39HpELku4NschO167foQLzDcQ&oe=6A7F0851"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZhqlLx69B4Q7kNvwF1r1h-&_nc_oc=AdoN_y0f8PA8LW7u3iU_ZjNzNNvV753HoZKl3jSF5ZIm59yRcrS_TXfmbdrLiqTD_vM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYAlAUOR7rAcW-kE9Yf05DHUFnPpeh-lc5qjAqUKcXbg&oe=6A7F2B30"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgXGQ-I6MW8Q7kNvwGjnYaI&_nc_oc=Adq3m4P5qW0htm-W5fTo_B7xtkegdAagkYk6knLMLKIA3-EKw6Od0kbPdTM6JTXg2Ms&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEW-DqNXJWbtDSaH0BtPdjus9pqMWFaXsfxgGWoQ54ABQ&oe=6A7F0BE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejfeJilnY6QQ7kNvwE4MZRj&_nc_oc=Ado60dfD_Dx8djxve0eW02tCsu9ZHywmtN0dQlMEmS3_BDpv1rpIuhKSKkov80NILSg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxBcw5vjHm1SDq0mDybkI8Lmpxwz2commzbyaRyeDlhA&oe=6A7F2232"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
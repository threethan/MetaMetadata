94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GW9dOtAn7wQ7kNvwGiRq02&_nc_oc=Adol8WFytMjQUsteBs6F_B1lDf_32um5P1wmXDZO1y2AbGN6GMd6tFQDWxk-fuorUWU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0msOBL7TUBap7QMG-T-JpaZza9zVBvXanOWxErGGqn5g&oe=69E4B805"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aW2PAV2f5ekQ7kNvwFPs_I6&_nc_oc=AdrjuaVil9jNUw4JoICHzWFT2ZLjxGxgSBTPR9PP9VMYpLMkMrtn_OjNXMTqeEEbEcY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pQItPv7uViVvN7o707HORZbiyOF2ITystJmtym_kTWw&oe=69E4C8D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRo4EeJ9Ad0Q7kNvwE47PwH&_nc_oc=AdqUl4_mkrGfgJILokVM14uYAPya_zgyGKXw7mV6iLLwNzKqM8mNbcDB0Sz2bSpP30k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yp45QQnLbXkig_0Nink2ti6IVunKJuLinVzQmTs3xAg&oe=69E4EBB0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLOCeJAT_6AQ7kNvwEcHHvp&_nc_oc=AdoL4F9qlTPyCNpJ03nG4Sjs59H7f1KgMkwG_FX9wBcKcDvIukn37eHJhYjJXNR9pqQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WxEi0-i7u0wEcAFSgOPHlpApN9iQIy4liekqS3WPNkw&oe=69E4CC65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpNnTnawdQUQ7kNvwEMPnMs&_nc_oc=Adpt4VyqXKVIpx-Qwwwk53xIC-mIxV_zEAWqaYeuKFBmnI7DSjgI9wlxbtn5Za9RHak&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YcdULxxMra_ZYpDH-v70kxOv_8eV6U6rvwED5sSpCGA&oe=69E4E2B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
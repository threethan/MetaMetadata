ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ls9kJQoLERMQ7kNvwGM7xVI&_nc_oc=AdrSJajvVhh90CH7HPku3s3LzYfXrkU3lKT-nuNXqoGSuTxTR18zebxCZiHYbdCjJ90&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4iiISyUtMDrDz7TxoE1uOaM4I0I5JMsDlnVqCPItWrQ&oe=6A6774C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2WtnCSri3UQ7kNvwHiGLPG&_nc_oc=AdrXbGUx-80KOOKzGSQziA6C5nP2jVNUvRvXQeoS8NQDP3idCM9s21YHaqWaHEpfipA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwbNmfcCW8uwM7YJrLVk-ch1N-3jMK6N_4zH-iPtLOdQ&oe=6A674D51"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbv2k2lPpzMQ7kNvwGp_p_C&_nc_oc=AdrIcJUOHo-ZIDNo0TNT5e4vxYPNEKxt-oA3daZt8GfjM6cH33JjkL2R-wxZ13kNFRA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPcsC4u4gY1AM8WTzvhlbxoviptIKo-gqkmnRBU_nElg&oe=6A677030"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2lDLw1_IhcQ7kNvwG-b2Dy&_nc_oc=AdqR6m7ZgsUGPmhhpMCfENYiZ12DGf9sqo2Gn5BSxUWeYSZeNMWi0QMk-USFL1OPlEw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADUJjyegi_folNuBDsNWrytBZbdtq6a8EkE1gPx4sdZA&oe=6A6750E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgzrP6gEWMUQ7kNvwE2RRxl&_nc_oc=AdpMZUkKBfOJLmjn_zNtQnrS8G6PXzTJnBiKNvO39VPcM2968FDOSn_g0FeBCM6VpBE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCb_bCoEcNRnXJSJRTuiHtyiOSduQEySWg8ZJOecoK9Rw&oe=6A676732"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3DJJu6DMAIQ7kNvwEYipMZ&_nc_oc=Adq2zfaMRIctmtvYErPWEUkcBrTp9fPe8nx_sC0F3y9F9IM8O6q1cDgrTWKU5qcbvXo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSdsKPFkLFmuc3chlT0h4ZKDl1HpBbmuj2FcwRHyitYg&oe=6A972305"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKxcFdMvJfQQ7kNvwF6Yihq&_nc_oc=AdrgmbQ70biskp46rZzTsGoMSLIt0KXwykrvOp6B2c7iW38myTPTy1xcdqySGVCbtyo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFA_8oheaC3KjXbCqVdYoLHdV-sFGDkyS_VDKYYsHoJyg&oe=6A9733D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iq--fnf1TLsQ7kNvwEwLaGJ&_nc_oc=Adq1AsNuTwqVoKLgXeYcSoeGwxKlq3ZR8mM5tBt7UUmB3FvDWrFJ8PxrZl5Sau1q1-Y&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHL7nUaipByYl85SVx2qkOhkUrQ0w5tOPrYBTWCwph7uQ&oe=6A971E70"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yqvzCLReQMQ7kNvwGkbaEL&_nc_oc=AdrKb4NjONb-teukT5rdnHQR4GJKEky_SxcQPyy-4ey-cWh34HkAfPPQcXUhBF56Q_0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuDIeWFrI_-67t30miZIPEOmrX09ZHXENWDo698fc6iQ&oe=6A973765"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWwMcxnRa8QQ7kNvwEndut1&_nc_oc=Adq89tM8jcaYmTZ_eldYYtrCDbDnfy-O0UxCmYLDhk-A2fRc_9pHb5l83kf7irJH6kU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-9Vvw1fL0gGjAFgOpHtbZp6thOX0KBVuTmTWFbM14Yw&oe=6A974DB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
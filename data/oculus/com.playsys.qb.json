94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GW9dOtAn7wQ7kNvwFopU0p&_nc_oc=AdqEg2QjpBIZy25HSzGKJ_f5shCPmT7B8CuZQteeQI-NUu8oWz8KiBa3gQoOGwHodyU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iM1cJF029N2wW3tSSIZpDjvXMO9LYswZs2M0A7uPtrA&oe=69E75B05"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xvwSk8QpPQQ7kNvwGjuODn&_nc_oc=AdpwV5ROf79BLPwHgrDYYnohFnmr2x-ieHj4emQe0EbJkxBQHVQXzsAEbUN11lznskM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Lt7F0abdoxj4qdX9qPamAy3cj1F1ok-03lj64THoTBQ&oe=69E76BD1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxQneWPeEpAQ7kNvwFsxFmZ&_nc_oc=Adq0Gqxt63UqpQlx5tW1yUdXtrxyp-1R0BCHfN8JsOJDz5QiWjXFNgCl07TTN43bolk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AW-9_wDTY4l0GmRf3XDTsY8PKHZcmxAq0NXg0RxBpHQ&oe=69E78EB0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLOCeJAT_6AQ7kNvwG0Kwxp&_nc_oc=Adr08GKZFdvI_iVlqggy126-tvIRaUx2a899lpNF1fBJmevem4awCCs0x8xvD1S62gY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wZ66Y0tRrlsh6u-MIO1k5-6MkqpDUwVMj-QR3LMGhUA&oe=69E76F65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7XYqYRDe3MQ7kNvwHbmfcz&_nc_oc=Adpu1mL4Dq6MeTme4OBFShEZsCTvcD2qPlI2hnpZ_TGxcdqfcZnILP5UVcbqCdRDvo8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oi6an75AmYVjkZ22NHHar454EQAWWFMkAmTqsvRHD1A&oe=69E785B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rmS5RVGBi8Q7kNvwGwMwsK&_nc_oc=Adoe0h7b_YMBZCGlOmNgETvp24iAhz7jnjCqTsiz8QPxlDXUe2x2giNIpAGicN9QrGY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Do5etGMSYGe1a4SVudqNU_-8xtVb3LjespzZd00KLCw&oe=69DB7D85"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YF0NgAL8Wf0Q7kNvwFNlshr&_nc_oc=AdoLT3yJDp0KeHtT0xYs4OFdFkGAc8quKhCMxHzJLAapWdKE5VneJm_2NHLvgFu7G0g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vNXIGq3amNFk6OS48TCs9EDsov5Nq0oYx9YuUvm-lYQ&oe=69DB8E51"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6F0KDXEMBYQ7kNvwF1Jk9-&_nc_oc=Adp2lZQgxrxI67vVYU0icEEAaJFg0g10ff03O89Pc6vHFcAdvVlREfOq7aeAYAz_55c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1geCIr9YHUfmn3WmgWkbjy7sEEpOapAGCVuWiq-NpcvA&oe=69DBB130"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoRCsy7jjgAQ7kNvwGbI4NR&_nc_oc=Adq9Fe2zkkzkY970AMEhA6bRMqTRMV4qagb-__-uMAQoOplz6CTTgL4PMSjSDnFbOpo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PBZS9sV3LbhoOyyO01d3v9TtUFSuWo81qrFOeR_SNow&oe=69DB91E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gldfCKNeulYQ7kNvwHjqVCB&_nc_oc=AdpztCcgf-uHSxCsz345yPDlnQuqJGsK1QFQ9DN78tDONgmxKiR7fMTxQVPshJ8uekg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39XawuMdS344ze-Gedur2uAgiRIwobugVp8d60HEvUIA&oe=69DBA832"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
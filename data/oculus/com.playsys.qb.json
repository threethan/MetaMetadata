ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3R1GiaA4XYQ7kNvwFL4ulK&_nc_oc=AdoMOJqzjtH-Y1uKcDvqFrUW4YSGTIEMO_Iidzphj2qG0X6RFjrQpgGI0mQXBDonKsg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeLuxuz9fw07mkH8Y0KCBkiDUteRfgIH2W1-6JfmRTPg&oe=6AF9CB45"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIiCTqHUtIsQ7kNvwEBLJXa&_nc_oc=Adr4hcLYNZTvPHAvkl__LNKcCTP8aWPszTQC5Fb9kMZAY6XQVSTEn_NaqE8XGnDGbOE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKUmWy8tt1cf1arv5YbIfMICOSjlH-Mp7_3nS-O5cQJg&oe=6AF9DC11"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQeZnfocyLAQ7kNvwGvDgxu&_nc_oc=AdpQOymwKnkvs1-bWBC32hgSc1tqneXCpvrteLDyASv2U7v5zN-f5EZR9OtHOnN6cvk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi3mj9pLQGpM3czlUOHy9XmThTYgqrVgmFB_xZO_Usdw&oe=6AF9C6B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QX7rrJ-X2c8Q7kNvwFfY-ZY&_nc_oc=AdrGwqvdqrHDpXDA_97zKeLpTT13aMq3RymLXXXHvYxe2JtcuGQxVmBXSh_0sSY-d90&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxxG7PyHotc-kV6xJnOIv5RxotXAml-LM31GYYMjyrHA&oe=6AF9DFA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMJMMwR7RTMQ7kNvwE3MzfE&_nc_oc=AdoLsmiVtCgFKr-ltzBLdpDZNdI1rAFTh5ja4yg_VjeU8cr0iFlRy9Xc0VEnNKxjl6M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTubl5B2Ai1C_XIBRxDj5oAtq-ZYymhYvd1WwULoT6uw&oe=6AF9BDB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
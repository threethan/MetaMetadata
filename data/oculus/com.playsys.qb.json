ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1MgvmX20XEQ7kNvwGrUYy-&_nc_oc=Adr3xXXkLIXMck6BSz4_IRNR85PmC2FTXweHR7dGjXXr_UgBHGO647MUBIv1D3JI_Vk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsZpntG1jCo3MqfVmxESnI73uPYCQNCI0IXtdbRosMkA&oe=6ABE77C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sM5hNv0AYAUQ7kNvwGzym4b&_nc_oc=Adrs97GmcMgf6C1RsGroLdu1C0rueD1VcMGH4bSzSaVmTh1Sr7TdYOfcFp0JaVyh-40&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyCQJygeoxEYVJPW_R6IZ1tjPBZk7kE2IBmhzA6Vrq0g&oe=6ABE8891"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPPXvWD1l9gQ7kNvwGSC2FA&_nc_oc=AdpcwbqOLvmZNc22BH6eNNf1wLP6MI7ZKH-G8VfTnT2apvbrBFqa-RvMMugopG5xjRA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGxAV5dXEK6eD9CNMUGJXyJCZKnh6WHGA9WjNrCXiDxA&oe=6ABE7330"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkwX6MPUHiQQ7kNvwGZoUXW&_nc_oc=AdqhbugofMjwzClRoO70dWnZEYwwmZazRv5JRd-FSvoleUmGvQ5gAEYBCskAo8WoPiU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3WNCkYB0bzF3KAUEpcUSUTVzrVKfTOdxMx3GywPZZKw&oe=6ABE8C25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsT-P1sv4IgQ7kNvwGOSl-V&_nc_oc=Adoc9uDkrHzRVaDlVlzfVndSntzCfACoFnjxO-4fcar8Orbh3V9_egL1o3jDNFKdi00&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFQbdq7O1plsQAx9magwaDOelS07DBbr27v6pmVM5U3A&oe=6ABE6A32"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
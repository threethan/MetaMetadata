ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHpjDTzR7UsQ7kNvwHRKv69&_nc_oc=AdqLOrI5VYp8ASuxnJjZ6KpFu3p8hADrTP3xWLvcdNsQO70IFR5j0GNIVzgBP4wt9G0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMXE6VKr4x8Ztouxz3M1f0pkbIqao_d6mGiR-ybjQVMA&oe=6A60A505"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFA4pViXVmUQ7kNvwGDgQDH&_nc_oc=AdomRLaVrMK4I8C5ap00CBR8d6TkJQTO4wAAk3EFxxi8fk5S1UWxOOK3Pn4oriB7xzk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGKGd45BHrvO95DvEfSCm_ctWkT7KPSp6egVaVMjbwqA&oe=6A60B5D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYezz92-kvMQ7kNvwFe_NOT&_nc_oc=Adqn1c9pQHL4gccnKh_qIL-y0_N0WtYD3C-oePMhG_IQ6s5ujwSZyeImEMj_8rLHRq8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4CBsWY87azC_OBSVhBWbwpae339XOwfmypXMmYNsH6Q&oe=6A60D8B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEoh98Cp9hMQ7kNvwGFSDTY&_nc_oc=AdqsYRvYKpAhj8-LSMqM7o4Z8M_QwHwt1CA_ROS00xY8lZ1E5z8ftZsmFle2EAg_rAM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwC8WTFpOGnjCS4uGXoBp49Ub_1YSeznIzOwGme5WX-A&oe=6A60B965"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mM4KJkoMMyoQ7kNvwFwOlsY&_nc_oc=AdpPUlaxaffM_TUnLbkKDZfUklJHPie68229CWRyckZbsnBiR05ufOrxbLsvQRgpylE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTBUL5YS95AshaHDeegSifYJR0uYg4ZLj6w4L8yhh9zA&oe=6A60CFB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
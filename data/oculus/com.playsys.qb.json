94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-CbIv3JAqEQ7kNvwG0XbT0&_nc_oc=Adouoa0amBARbcRoSW2TLHoG4az3hxV_K_HkJIsNYKh8MbfO36O9XEau5js4UXiE2xk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2dBH6tHIY--lUQUD6PGZpeaHu-NNBR9zO_VWxpmsssSQ&oe=69F8B6C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1sknyhUak4Q7kNvwHNqu3I&_nc_oc=AdoVtuJSGzYvQoDSImC4N3U831OFHyoIebyFRc3NfXjgclhVMC9zqp-WDr0noWLfD0w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2wtXoAdTvfQpFHeAIKvnU7BNQ_Hip_CTZsipO-To4RjQ&oe=69F88F51"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qL_DN3lqP0Q7kNvwHAas1P&_nc_oc=AdpDNQoqCmfqM3esXiQdcYGBKS7uvnT0l-PzqAuxFoFPsrHsOBidHuzZ7EoDrXHWC4M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2cGkHEaLUuhAKNBJcmPdrAh_2Bngemra1zZDnUvtFz6Q&oe=69F8B230"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfCyY4wFa-kQ7kNvwE5K6lU&_nc_oc=AdpL5F9xZWbEqfz0R_nelLDWRpC-OlTPmvYVcgd0xmn3HOcG__OWBuuJkljabv5lINU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2OajKzu_sfkF9v3vOQmoWSLvR4mGXwpmzyN7KGqrZ1Vw&oe=69F892E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1z36p7K4YgQ7kNvwF0KzZP&_nc_oc=Adrb8kl-rmFy9XoY1gcRfZC_tNQkGCqcnUc_4mJG7f7Bdaie9vtQEB6ESc9gifMmwbM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3OhYwTX0RmTyByRer9cBFn1uI6sRzatfSek8sxPppgAw&oe=69F8A932"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
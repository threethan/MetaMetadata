ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpFQkvEbP_MQ7kNvwGlIkKZ&_nc_oc=Adpwveqfnc9SFxQb-ADEuwf95dHR4-wmsT9qYtlM7PaKJlL4k5ka9XThOJIWGVALIMU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLUf5zorIMEm1HE3g6A2ggGlKL3P3xWFqkfN9SkeceZA&oe=6A565145"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fd7C63_jpw4Q7kNvwEA2eHu&_nc_oc=Adpy3misBqiuT7yPXrLLs_UKeZBgFZ63Qkcy--rRun77sEg_Vt9-rvjvJ4XksSYUlG0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmYMAdB-Cf6ne13YL4OawFdyeSfHPT-RHaDReYFfYUfg&oe=6A5629D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwdn19X3CkAQ7kNvwHRHMpO&_nc_oc=Adq8FIYodv45ozvNt6iCYGuRes1Vmmy0kXZcRp18PhcLpNE4-B2CeFwRgxLb8N6GUPU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD92B13BTUZSza17M8pwe9EzQ7RGCy3IZ9CwQhbZSfKIA&oe=6A564CB0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evxRT8Ip8wEQ7kNvwF0i4aX&_nc_oc=AdqrDag2E6SaRirox7r3DLh59ColoMfosXVJJpYeMl7Gsa3mS43eYG2zegqpMoBB_wg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDV5HubUdm5m6dj_Sdh_pvA6ZyhAvNoUcbJ3qOcBslZUQ&oe=6A562D65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-M-EiTo2b4Q7kNvwHlfn25&_nc_oc=Adp6n5651m2Y-x_KzSj81eaqPTJsgswQ_zZOtHfjSpQJ7wPE2arfylVOfvhhfXi1qxY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxoUjj1UUl2EE-ZFfkiiNkwrIkTqTpm2AKqGWUjFLokg&oe=6A5643B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
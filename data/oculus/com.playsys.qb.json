e.png", "id": "1548464281984968", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5p2Q-bKUPV4Q7kNvwHk8UBv&_nc_oc=Ado0oj5cxT7aUYZgw3CQXOQvbPFV70fLfSSANR4wmXt7mo-xAVyEa5sMxVOPz-X0ctE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GauTdc7VBRj4Knk8JI7RiizAMgA2cv1MHLCkMOE-b1Q&oe=6A22E6C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1jNjcOZan8Q7kNvwGl-spf&_nc_oc=AdrtIhiCEiceGYUWrGOEvHZwzrLX8cIJFfI2eRNjxZlCSgZAq34fqJXYLoaVpcxvXQI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_femtenGBtI5mfiTBadsVye6pbV1DYvqlhrag5gBWb8w&oe=6A22F791"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_37-0w33LgsQ7kNvwFgRgjk&_nc_oc=AdrJsIYwBDsto-1-NGIv_9gGggGInZNziSulnyNJHX0L7h0usTVUP9j557mEBoO7sY0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mT_u8qS1cWdUmM2FgDQ-nI2L8NcMYfz63wvr2TXVUSw&oe=6A22E230"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ge7ISXQ16fAQ7kNvwEwRvcY&_nc_oc=AdrJaSxeyuqpTG6h8wnmhOG8EzMt5E7QhcCFBYrLMO6ixiM_9sx2laB82VVD4b9IK8Y&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8w4haHrhJx5Rm8ej4R5E8f8FztOn_UQfrdU7dKIpMNtw&oe=6A22FB25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YBGBM8vcxsQ7kNvwGkro62&_nc_oc=Ado-Yk7Zsux8CW6hhIuSHfYBZVIfAiARwuCbW0jWyvxqG_lT6dBiHxgUnP70DrDT2JY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pd35XUupJi0xGG7hFQYPCc8o72habn_OQPeLokK7o7g&oe=6A22D932"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXVRSAzIDvgQ7kNvwE7aY1V&_nc_oc=AdrWvir6TaQXJarEKGRvy0Md4zjjM9p-eyetVDa3TijL1r4see4Nq6bq6jNQpZPXshU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkalvDB-dNfGg_u0aVgDQ_mIpZajGTZzAalfdgbrPgPw&oe=6AB931C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BicNZ4S_nMQ7kNvwHfDH_l&_nc_oc=Adq3slRuDHVLDxHG0u7QRhmd9KAZg3utdm7b2OwsLfGGhmSQD_R7xnLWdTgq50C_hh0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRz5D74ZA_RrjDdNS_TBlS4dTT0dgBX0CkmCKTVDfKdQ&oe=6AB90A51"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GT5GOjx7jIIQ7kNvwHo2JLA&_nc_oc=Adr33pTlxtf0c1PspiBMcC3iNCXwGkEC-hB6NKZu4dPM1qo8QACTArDQnVyV-RHNMz0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpHNcQ2BLF2aNt0XTMhO39ezob2WYmZKArq7TUCxdktQ&oe=6AB92D30"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ch7xxvnq0hkQ7kNvwGTLgBY&_nc_oc=AdoRt_AJ2I0UXXY4LvYCpqst_EW2hgNkIHCBQoj5HtEF_G_F0tTflSORl3JNyP7nEFA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaJIxlqSNg-OYpfqsc3EP0kFAlvPypB3CtVR57jIW-xw&oe=6AB90DE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyilM-OtktoQ7kNvwEaWkB9&_nc_oc=AdoXmdpFHRodoOX6fGmwSdJdv75ESaDKLQnk_7xMIrrQc_eNhCjk0fXqKCCj8evpmMY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFYnQsRKc0fo8QfJBnLqSEKWyE9-A9oH7FukEKHokNaQ&oe=6AB92432"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
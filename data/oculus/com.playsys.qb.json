ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xarSVfVKY68Q7kNvwFWAFF-&_nc_oc=Adq4SQgu8B8T1KX-9sC8mPmnhF5YtETMMJtQ3lysZGWXRHM33tovqxF1zTVz5vQj0-Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMYgHgc-lEd684O5DFH6mZB414rwr-g1Akpi1e8UHTbg&oe=6AB3EBC5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z0Ib2Rr2qyQQ7kNvwEHQiZC&_nc_oc=AdpI_I3veUgnLjGYeIn3a9k-W0PAajV6bDOGVKWRWRAzZk9uFSVKIz9R9WjBvlKkja8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIX9OrUBz4oYL_5q2VQKqsISWJr_ogcSwRb8I9o_a9rkQ&oe=6AB3C451"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdAxyyj6p1MQ7kNvwFP8fHY&_nc_oc=AdpRkVQyzRl73v6IfSPKjRgx2MKBfiRAbZLkecLChRzNivvLLMRX97sfjOf51Udbwr0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKivGHDwbtesQWsWftIR_w17T8JMIThx_HHfuSSQbRZng&oe=6AB3E730"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXlFTmMtkxMQ7kNvwEYD-2o&_nc_oc=Adq-P_sfLoryZyxOlX7vmjPMdpPEhLUu6_781vtu2xqtG8OHiaPh9EsHNxGIYZ56SfA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJ3-xrTj1PalurSF5-9TNwlj4wwytZy4-UktqxUk4cmg&oe=6AB3C7E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-XAO_ASWgcQ7kNvwFHiKZN&_nc_oc=AdorMOQBS4567C3EGv-yvk0jId7nXsjKHapAooIk6_ByuQfi0lWc1ba0nJXgwWkJq5I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYuNcVIgY6ngokzu8sityffN1OB7eMnUreYRUrZLxOeA&oe=6AB3DE32"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
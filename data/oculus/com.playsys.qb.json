94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtmqVpOKjGUQ7kNvwGN8d6m&_nc_oc=AdpwEbKPMMnfQLikXxRHNsujwYDBI-0K1eegsfgmR9ecdMDpGHwZqNIbX90jmcuHcWA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af714XaJujZCqHwuQ9AfebsxMnVoBy76kE7a0J6MFPJDaA&oe=6A146645"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3U1BJUowtdoQ7kNvwE_1xXo&_nc_oc=AdoaTf_a4Oz_dTKnJG0utZ7m4bAmtWcIQsolXzN-oSjSVUPAGmELtRffhWSZUEtb0R0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qAuQg_3-tVbC4_8CObt_7nSDJn_V6sJeadA6Z0umv8Q&oe=6A147711"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46fMv2rRILYQ7kNvwGN769s&_nc_oc=AdqugQ5OrAmPGo0_wdZ_KIGnHSbxW4vTf9qH-iNPA9U7si4T-5TXNjyuyhi1zPl0yj8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yjw8U3ESl3TqKFkuJ1SK7btqpxRCFNbjgVjM_8DPpQQ&oe=6A1461B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXl-LZxw8gIQ7kNvwG-_8MV&_nc_oc=Adr6xO-N0hSyYavuBS4_7bhCqUAvjfYZR-CVCb4wQMDBWWiu3FX8_vYag2wZgkgSfpA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5y76F5nbMm7fNX9fUYKTyglCGnJbAWoSw1oFedYzzKaw&oe=6A144265"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIFBQmoE0uAQ7kNvwH4KqUR&_nc_oc=Adp8tRuKCgk2zvUPORlwVbfUjjbP0NDeQNkGDWjkLKlRkmvQfegpDjmK0v6H3S2zbbg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mqFncYQ4ysgRRLUJng7ouRpwHUn6kgXErz8f8hgh_Vw&oe=6A1458B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
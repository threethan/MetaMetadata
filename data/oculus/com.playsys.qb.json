BSMzx9pR9WQ6ptxsKbyQ11_NiDcugS2bYRA40RJ9BbscEh9GSthY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftFFXCLP-16FP3b3zvZP02e-RBFFbsgI3uPLpA_94Szng&oe=699D8705"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Is1yQoFGHKwQ7kNvwHaPzKk&_nc_oc=AdmyNT0G5oYuasxfQR8uAx0lq1NwPpcwkOsCm_nhd384YQbz3G2NgLmWdTP04cHHkHg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsHxi2yjT5MaU-tCruZEg4SH5_QQG93xS3p16Xsg9SVJg&oe=699D97D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ancobwK1qEUQ7kNvwE_26zE&_nc_oc=AdkGwrHBmV4y9qBJ5kJWoZmPuAR25JzajgByKrVADHs9NtQdLYY9SZaoyvt_yyQobRA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu_kgwKyuKVYNpb4LQztAAPTF4YHHSgpSAl65rMNIhYew&oe=699D8270"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_IrClYZ-84Q7kNvwFvKGLS&_nc_oc=Adn-kdsLBAQZjYynLUR_aY18WRF_xQFy5GCIBUxarWIx29MpVAGwvzaX6XM479LaPis&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftidpVFR0M78PSDjRuNgO4JEbOgTFozv2GbdYh5_3jg2Q&oe=699D9B65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYjKDLqZpUYQ7kNvwGF2e0V&_nc_oc=AdnH3z7mXeHYfJLEmfToSE7aCKMiBZtONSNDuScsk_zOLUuWpu_DBc1x4AbHbPwNLQQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuBTegcnVX0LM00YmJfQzKLPz3xLLRk-JJk97K-LxUogA&oe=699DB1B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
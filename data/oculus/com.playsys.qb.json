ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgPxO9G9JeYQ7kNvwHiVavu&_nc_oc=AdrIRvnVuFZ9y8akBRx9fcdYduiPXy0qJoSAsqjkYSsF5C2QfBMG9JjaLrE8jHnf3Dc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKW8L0j1YmM6GOGkdAMJcFg0ITeZFuu5hOrzfrJup7HAA&oe=6AA02545"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OM1-d6lJ6FEQ7kNvwHutYKj&_nc_oc=Adqd05yNMaX7PFaxON6ixvkdUZGiLbSjPJbB1xRFLCC5qAwvchIS-OXsRHR7zgeLhD0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-VOAbqPApiu7EBeIiw7hRqrCcUjG6uhB--VIJoCy7GQ&oe=6A9FFDD1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nK0UK3v3dwcQ7kNvwFXLbl8&_nc_oc=AdqeFu8P0-TYlPXhcV6VFb62aHU8j8ZI_KOF8Dny1OdVxUeYZbJBG0L8K-1_ENWgAJw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLi7Mcy6UCgORii4bceszM2lDryEWEQl2vgc3Bo3ZMBpQ&oe=6AA020B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uA63Z8zQw8gQ7kNvwEoSxuN&_nc_oc=AdpIRsTJf68lyMQgGNhAXKRZ0e42sFu0_9pUJVQ1ecZHbWVJdG8PCldD5BaLDui2Qno&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLC9jfkjEi3A2UnRKfxfmtrL-cujyadf_BVEJIiIJu5cQ&oe=6AA00165"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPG6_t4kIP4Q7kNvwHmjtMx&_nc_oc=AdpRNRC9e0EKOBPW4pfUyihvmLUg6p5hqejJBSqLI8GALzvukh1KfMVqsq89CBTqIlc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2J3xbL3rk1m4u8EPnRcdZdaeEDJnz9a2Ql2cP3-1mzw&oe=6AA017B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBb6NPCGn68Q7kNvwF1Nv96&_nc_oc=AdqVIJeG_vcfbJglmCJG65J1s5z-71MQZDACJgwiqJnEdGk0AGUHDk22ipAZjL1vhDI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKToTdPvBBbfjzSoCoVcdFmo950M_Unph0EQfz4R6HH6w&oe=6AB148C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z0Ib2Rr2qyQQ7kNvwG2Q_NQ&_nc_oc=AdqWQ3na_kSlyY7M6FLCfEE-noxIdbMeeCaozFgtAMs15nr8l-jMnDF_NhbFOSCBZc8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeb2Ts7ij3qw6ABpJ76DtQoc9dkmzkBCzVgay01_cSUg&oe=6AB15991"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWpr7dMcWQoQ7kNvwGdzTpF&_nc_oc=AdpTt8_aEQxhqWsfZPRvBGGZ8sGbj2sYvg_WbLigsbagJuWEy3b3h2hqh_dYaaxCJqQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYPx_nr8Rz-8XsiLirsOh3h4ikpPyvfEMx-cexxrzxpw&oe=6AB14430"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ehA3f4CKRAQ7kNvwGVJIag&_nc_oc=AdoZVnBCBpsxp1s4PeolxNPtPNIkI5x2wJIXQq5XwKgHAJpD9VQ567puO1QB2cO1w4Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQwC-gqPzrvhLnMW1WhpbHE0WRGKxh2Qf4qi1REnrVVw&oe=6AB124E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0HlIL_ktDwQ7kNvwEnHkCZ&_nc_oc=AdoP9gtrcChZou38djflMUBj56mnRdhSTz_UqYIHIqK2slxhOrGqO_t7yXczxfLgtnM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvbVv596TnANqk0-PuuQlxUZgMlvC8Jb0c-nMEEPosig&oe=6AB13B32"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKSpuuXXqvAQ7kNvwE3WF2E&_nc_oc=Adrpfte_3Sjn93aVOhYvJNuNdg7HESt0gG4Q3PQDC1N8o2XhYADCgc9G3fHwZJPTFBQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPnOmDLUsvJQqni4VRSxej4DYcAiY6a4kUaQTvjFf9Sg&oe=6AE0BEC5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSQrUAslwFkQ7kNvwEfZ_cm&_nc_oc=AdrOKBBl2GLMWMJ6ETSiXfL8XGpTe04VViZYS_gVncV9HjVYldjWXtSGrdFz31Jw9w0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZEerScuMEpeUe0Y3KyLoZnxuFQkQQ093JxtgIcPluNg&oe=6AE09751"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LyMzSm5MVYQ7kNvwHA2iZQ&_nc_oc=AdoeyQfKp3Ijtf874cW3OBP4-5UJK_-rkbqTyAWNVPnfg08w9lRcNgASBvHEnzwdZBU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-BMpWEDTKiMhcQXqWcr8Mlf34wGfbSMEBfWalEPhp7Q&oe=6AE0BA30"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQ0lJhe6BkcQ7kNvwGzaHQ4&_nc_oc=AdoZXW-bhqTGzuyKqR7sJy9McSbLrmYjDwJl0pYKS9Sc6wsOPz-RXzOG0Tkvg1COu_U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpuRr9rWUOJFNopIMwPrPXm28-nUvUMftw0YVFjRey0g&oe=6AE09AE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YcuQ_6bmwWEQ7kNvwFzNwMI&_nc_oc=AdpbzIr4dreWNKG-lqGKCK8bFHHYXdYqHvCMm4ElneqYWHKY2yiv1xuGs6u5UIFpctk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1MtgbYePNUVjOEbt0ahzHI1Cx6yPXPfAPvTPnlNy62Q&oe=6AE0B132"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
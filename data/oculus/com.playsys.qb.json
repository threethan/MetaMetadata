94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhU1zZHAQRQQ7kNvwEi5Rci&_nc_oc=AdrZHU30ozlFdme1R7wNcjxyzwHyvT1CG5s4Br3TN7lJ63wx6i38X6GTDRBkJoeZmxU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HS2zv_njlJfzUiJlHfnNjRRNdDA-w1a6EiJAXbPzmbg&oe=69D4E605"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7GUUDrvsVkQ7kNvwE7_51D&_nc_oc=AdrOXwhp0M-faXBsgu0gzMHbuoQ2t8AP3CObBrYmo6iEI4nGV7EW2NrpbZJ8THixR7s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0h7BFHEuNlSpCw9lktcwYUlonbsq3g9qmEHkmo4zr76A&oe=69D4F6D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAfUeO5ot8MQ7kNvwEvP-8Y&_nc_oc=AdoKyVqT7n2vYVzbzqMAvyixvV6mJlkHZgRRQOAdS0OAf6IpcRMkwj38l5xfSK_jo1g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cgJExBlUAiiO6PRQDW4bju2sMwVpyfNWejnzAhjibcw&oe=69D519B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPPRfDMemnIQ7kNvwHlLR_s&_nc_oc=AdraFrhl_RYRTXj1TnaMWIic28pPktiUmLX4jFJbPT01ukXncnNodRs7tPiezXiK8m4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HbDaEV-qAh8I-s94loN_XoA8-zR2BZk8HFVZ8fkWktw&oe=69D4FA65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWmJe7XiOq0Q7kNvwHKcXRw&_nc_oc=Adp4BC9YjDU8ieX5L5nN4PMYUlHb9xTDAUGI1QrhpXZObXK6ZJoZPpOrxQVoOvBO-Uw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WFoKh9CxjefIVsoZHbksiQ0eXtiSwRb2dOedCMaSOyw&oe=69D510B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vowVA5U218Q7kNvwHofpW_&_nc_oc=Adq3oJbM_TZW6bgHx-erCQUqVTScitoNdjNp60ZODN_Vjl3SkwxvcEYvSTzAB7AN4-A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1XWHBC_Z-X0VCg-xhKlgbk8OUzzctUQ3_ATv-Wp_8Bg&oe=6A43DC45"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTRkfKUACtUQ7kNvwFJp2rC&_nc_oc=AdpuHWU_e8d1U3BISsH-3BTwyorqdvEeDSXsIK5VcgX4kda9yXKatDTywgD3jU_Suts&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SkzwK47vxsNzMy02RNmgaCr_GoFLxCWJZxXT2GQ7aSg&oe=6A43B4D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUREMHpJD3EQ7kNvwELIHGQ&_nc_oc=AdpwSHemnkkirZLsD4SCrabEgMuUs97kxH0BekwXGjhaD8TZSDHJ8-KsdyUmMaWZTtY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qB9yQD_tatsE497YPYh6pR_nRsPXB1Z50VfwvZ63ttQ&oe=6A43D7B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBQg-0tslI4Q7kNvwH_j-TY&_nc_oc=Adr3MVwMkABsS7RTiQIkvJcV5f5Ei4M27PoNFnINWRZ1NQHZxZPiTyLhWMe1WlhgXzg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PiiI4eo0uqN2-4Gkl09lggg4eDQohX1ubhRiN3uvgsw&oe=6A43B865"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3DU6DtJsX4Q7kNvwG2LddO&_nc_oc=Adqij26mH7AVyLc7NRH8GHZ3auEKVFKSRAPzI8VFh_FL77qnv731dee-sag6TSD9WAY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dQxHTOSaiznERP5RWlbatRtrDQ3RrdN9MJ3sdknwMwQ&oe=6A43CEB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLtkvn0S85AQ7kNvwG2e4OY&_nc_oc=Adq7FtPp3ntCJRb60j7dbWUbeanddsxv9m1ea-q9AKUpz-lfC5hc9QAVTHxhQsr6gMY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9l2zMyx6RD0EEN_Fo52y2F_n_UAW5fV4QSSyC8auyGg&oe=6AE8A7C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnJiCbHUsOMQ7kNvwHFsfAw&_nc_oc=AdrqPs1AacImqodu76c4t6VX6yq-oKcPA84Ahl22sneZNgtQbl6R_Nd9tK8picRblNw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQikgGhAmFYn7voRcuK53t62FwbV10oufIz1RixpIlVaQ&oe=6AE8B891"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lmha_ZXq3QMQ7kNvwGPQ47V&_nc_oc=AdoJbKr88ghl8zUqP8CKWJ9XeNqDVuzN4h94SFl3WSCKp7lgdemPol3XVxX-A7kAHv0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGaLNskM8yVZ3SxP04Z92YL3ClmDLM0fFSirXXvjicFw&oe=6AE8A330"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzDx4ob2yAkQ7kNvwGn23N0&_nc_oc=AdoTO11OZDPSO4CY3W35vZh_JTjcJyoxkEoDa5ZCx6jW3I5YP-ub1q9mcKOL6kifsKY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaKisaNkewMms-yMfbnPrrePI0AgNWmFznMN_xswJZMA&oe=6AE8BC25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HV0XhShvaWQQ7kNvwE_LHfn&_nc_oc=AdqE4ZzW_sR9v-P5Y_i7TVL4MQYaoj3pv-ZcJvOjmmVtMJaWoo9anYuVPHPah6B3Fco&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIkCxVeY8P558AGiGa9nMpc26QZWJyY6SeahtIqH4CaQ&oe=6AE89A32"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
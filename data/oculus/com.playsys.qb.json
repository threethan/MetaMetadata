ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6spqc3JGDAQ7kNvwHOFyx5&_nc_oc=AdrpkfH-9_s78pwRtmRISw-cgqhKFT3tTd6VyP6fM6nPomMQ_t_zwEDFVBJ_Iartp9c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Qm-49QHOj-w9C6G-79LZ-DEjySUzZ_gcBxkkAWeYp-w&oe=6A355BC5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Eg9nx5dpe0Q7kNvwG2PVmN&_nc_oc=AdpRUIbV4_1dmt_Qdsm0G8pgCMQRpRXk3aNmz_22MbneiyX77KVQQFScME8TQBsK5_Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_o11GfhOd_QpRc2qjy9ZcMR07j1qdn3-_CeMRQKXFU4g&oe=6A356C91"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1c8_rsyPXGEQ7kNvwGJF_ma&_nc_oc=AdogNZx9HL_lZXt6j9gmXgaeQ5RnWgbempB-JtWFKpPGZOLmtPbDPt0h_akm6iP23MM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8fNg3aKqyu9HmfR31lkRTmVuPnbOfxEYZw3xZMgr5ZA&oe=6A355730"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlBGsL4W3wwQ7kNvwGrDX60&_nc_oc=Adq0T-YBi9V_j3HkHvEC1z54KB0GoQ86gdACmaEwRJ4UL21mW4K6d_DDjDTiyrY2vFo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yNyte6zHtX3ZM11TZ7DlstRbuLtkI-XLNgFn0vp3NnA&oe=6A357025"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhONoB05xGwQ7kNvwHv9Gvq&_nc_oc=AdrtIpeHexN86DXdt33IAy56f4Um5jP18x8VWf0erXP8ksO6dKIbbhtN1Jqk4incr1s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8M9laIHQwuN3PqUsjZH7AgGuQXLyp66yAO7i7joNPqVg&oe=6A354E32"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
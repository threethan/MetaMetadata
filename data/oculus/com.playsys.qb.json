ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Agf8XISeEMwQ7kNvwHyFV2o&_nc_oc=AdrVVD-MmLkayGPNZU5R7THXujKGA0Y-39iftZvFYF4327gtJMtHfCbArCZv_twosVk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlZpqnhl0iud-9wQlO1h5gwtb5Xk_jANC-K0BN7lQxIA&oe=6A58F445"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fd7C63_jpw4Q7kNvwFp85i8&_nc_oc=AdpTIqegsdpy2j1GwYyXBsi2vfSaSzzfGfXMv8FrODNOeDjBiFVbdtu_X7L5cTfCsZM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQiJ-7hSjRsYvrG6Qf9Sib6UJB2OsMPMC34AeLngrfVA&oe=6A58CCD1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKeIT54rSzkQ7kNvwEvWpdP&_nc_oc=AdryO0skxHNgCYD-lR-vu-k4w7SZwhQ0UK2nxofU_CJsNbKopmeLUi-yYMRj5ODo-0o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvfBUuzU-K-Izq7hZECJ3u_gyKL97qxnR4ZJImQeqL9Q&oe=6A58EFB0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9ZAb0yi9xsQ7kNvwEQjlOs&_nc_oc=Adpb7VA8cjhzArsK7oRTncrSilwz9zzXCfB37IAeL1HXUxDIp_46hlZOBFsfilruTF0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrxIX5_akeJh4_0d2AUeFrO6x-dzuYG6u_LxepJIQBcA&oe=6A58D065"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpL3_N9kHnsQ7kNvwEyEJLW&_nc_oc=AdrMYDBqorzxO3nmYwFyOF_pghM3UdDBj53PAlhzJVDFQrdeEyHP0yb-CEpWZFYVeQQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOl0WFAEs7JpjgWk6vaVHbvtECDw0e05oQFmgRaXUo9A&oe=6A58E6B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jj5AWcVF9qwQ7kNvwF5Y96I&_nc_oc=AdrDnpSJ3doOmn02b14Xt42zM9j4L-Gri5BOZYhRBFbbR5mdp8GtUrxI-Gslh3sNDDo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9Jj9_BxUD3ZmmOkt8nD6dL3ra-A3jjWWGKe4-nz1vSQ&oe=6A4BC545"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXQFf9dqfxEQ7kNvwHzxqxP&_nc_oc=AdqK2UvXICgJI72IfWwPqdoSupfG4fAXA8u_JfSYEhI0qMlqfG8xjLVeRGRvHRK0GxE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbIJeO01YhODlUN_liKrCrpq0WHihGBQREUZklQln7KA&oe=6A4B9DD1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AemD9vazWk8Q7kNvwGmiuN5&_nc_oc=Adr3h-yp98Nys2kTa-4EpMW4m-bh3UGLpPGcfsbjnb-iqFMpPqJtG9x4i63T9Ln-_ZI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxd2ID5R70B8VpNdFHRQS3w6uQ2HSdfdKW4Vwi_wDTmQ&oe=6A4BC0B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwYwsbtUGHcQ7kNvwGqeKut&_nc_oc=AdrmIJoNGAQr7mVe_fWNlyAv2AZae3L0pSsjlfgGpBX12scLUSoeRFLl7kNM4andWjg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVdrzvgdXt7y964yIvS81JzOsXXXjM9XvdBNaA2rqW8g&oe=6A4BA165"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWjlq02a6XgQ7kNvwE6SuM3&_nc_oc=AdqU8U9sFx1odtNpUe7iU2ZlN0scmvT5Eo0_3K9DEF9RufKIBR6V11ylE07Pw932cNI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9bcCrKoBHVOJG3nBvLU0uRiIBxGzknVpEE1fkSEDw_A&oe=6A4BB7B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMY2wEZN9UkQ7kNvwFYHSVz&_nc_oc=Adr4-e6OFauxs5JbhxbaKgYZnOoSYqxTZ2GCSh2bMgCcPpGd3BlMg-LZV3O0HsaGtLg&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23s2fwsAHK11F13Ihk7P_DsjGvjjwBG-fxA1tq1lH5iA&oe=69E24D45"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cS73XJ4IKBwQ7kNvwErJAGX&_nc_oc=Adoq-UTH-fNKkDqsRUx_W87Pde_IFRwCnA-J71D-Rg7UOAXz95yUu5TRFZjErNnYyeQ&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gPc-36Xk1XYDeGucFnRtJOAmbfVxvJScsOvYXt8SYtA&oe=69E225D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRo4EeJ9Ad0Q7kNvwFtfAuL&_nc_oc=Adqiv0r6bsiwXfXxgos0_b8iGnxwSX17cBxh7y9tJb8q4sstR0UfBnba5YcHc5Zhy3A&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0N1kTVSA8Qqkai5CYktslW2cdDuwNTagqG0yCdoiT6xw&oe=69E248B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZgomhNL8CUQ7kNvwF85Ovk&_nc_oc=Adoy5wcWlp_bjGTag8-iU1cYUyKANPbz1m3LSE-_6vD0CeZs3WIR2Hw5yhMN26pI6FA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14cqLkiBUrmZKMo8Qc2xH2zJygCGeCKp5FHJgoF6WQdg&oe=69E22965"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpNnTnawdQUQ7kNvwEyCpvl&_nc_oc=AdqjCiwa1jQ4TDkWtLlkDQEGMT65oYD93k8cwgEDyNemeQYky5IDOqRl_7W24tGSoXk&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EQ2g5ow-CjQiE6Os_15bxNFFfAkOd9CyPk_0IhX04Yw&oe=69E23FB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
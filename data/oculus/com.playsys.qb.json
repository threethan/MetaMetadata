ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luHmflJVaSQQ7kNvwHqLl45&_nc_oc=AdrsFJ2V3OAbgjJ955MHcRX7ZXSBrjQj8c4rUBHJLUT4rn3GZPsmv1fdduTUbTi9TEY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTQbuPyhjxr5C5n0hS2gFaiBfCXgAMC_pGnvb4bGlUTA&oe=6A5CB085"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsyJqLh8vQkQ7kNvwEZ433h&_nc_oc=AdqQxmc85vrFTJN91Li76tpjFHjoeRWDGINjIHLBBNgylU4H0VuDSCKjMn-RWmPxNAs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMK_9w1QwoKsqqDDgPPjp4Pk75WTwBoQ7z1iQaKb7RjQ&oe=6A5CC151"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IULW7FWJwEQ7kNvwECxocQ&_nc_oc=AdrcSIkOKbnWuYwhCqZTA_st-ySRoQnCsbSvRLfLTRX1ETMpIX_4YCVgsNMe1yCJl4k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6MjO3-ZrnG4JKJUQx2dc4UiR1SI8VX9iqVhhoFBvAxA&oe=6A5CE430"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgDSTs0U1iYQ7kNvwFdv5X2&_nc_oc=Adp4vMRLfpFpyQK6qkAMfWsr67n5_j0PELM9TcNYM8wJlakMnb3m8MCWtfww89CGbt0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMW3syumWKiRybzsTGwW4JygRY4jC8GFq_PHAz7wwSSg&oe=6A5CC4E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCEQjNQVA18Q7kNvwGXZHKN&_nc_oc=Adp1m_50Cmt57ioniJ23JF8n2H0ellPDlVccVcVGY0AwLqDgheCwR2FuOXDaeNH7FSM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9Y0uLqmdDL5A83sbOVXVqyNWevV1uD_TwipqSATHXhw&oe=6A5CDB32"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
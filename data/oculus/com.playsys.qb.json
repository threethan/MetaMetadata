cbRFQH9ru4UBafeJOUzK7KPUZtvEsNPtY27D3-9WoY2mzfvJ1qQU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsRaL-1BHr0m0nQDkdVMw4p0ieJsTx3140TGMc6kqOtpg&oe=69A02A05"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SY59GdyVyTUQ7kNvwFKvO44&_nc_oc=AdlA2FDGvW-pSLNFBfYUtxV8vbL_pu4spYRLgWgSEF14oaPYiQxEE3oP3r9FcuubOiQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuxn9TGScUzKnlZRFrbgEk8w4gx9WHP4sW3kj6i3uFuFg&oe=69A03AD1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JKQTSNv1wcQ7kNvwGOhmTL&_nc_oc=AdkkWOLJm9b3WdBun4R9OpntN_dtSZRflyN5L2mTd0iTsWrsA7T7khDo58gAUuLFBu8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu8F-gzMSpm40RDN-1rAQ--ZLIl33RlalsSFpIu70yAag&oe=69A02570"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_IrClYZ-84Q7kNvwET6NMM&_nc_oc=Adkp3vgQfpFyWrmMYuJ8e2gKbUetJycQqBx07Yw8F-h_GqpJL5UYf2hn93MjY8R2a9A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsrCmcpBLp5BH-EeGNDXu_eXKBfXcbHUS2vzvbfe9sFtw&oe=69A03E65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOmDJuPN17gQ7kNvwGKzRFN&_nc_oc=Adka-eqNjButfNHJQwRcC_z6AdK2N__elJpkkce_zQmeJbu9QarqmdifdPtId5hUnzY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu7XCzrc-aAJcqMmUhOsMUmqGIhvI2l4amz6E_qVdGY7w&oe=69A054B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
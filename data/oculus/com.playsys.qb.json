ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6KJwLtM-ccQ7kNvwETMhUG&_nc_oc=AdqFytOy0CrEYcKVwEdzsJqyOTWED62dy1jiB5DbC8zAn994SxW6HKzFBNZ3m8zOe2c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBA8rmF6YoI2dPuy7vl_aHldGJ_tJGdX1z561dB--HS8A&oe=6A6F5DC5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zqxzs0jWEywQ7kNvwEmKP2S&_nc_oc=AdokDHgVtPrko2-uO9bSzixLuGTMV1YGbug7kGX4FWTBiOIyyMwAX0tOgR5uvWiC0go&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGghIz7SwS0D7rWwv4nS4aa3Dz1dhl-tsxUVOvHJJlCw&oe=6A6F3651"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMSYP3BFfjAQ7kNvwE11Wex&_nc_oc=AdodieqWqBf4pEA1E7u8U3bAnLWQA50SZrOai1zHkGkOcXsiHU_xelaxjsoZ2gJeKq0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXJJbBu8gTPcemTQ-QjP11wqnD5hRCWOIbYqd86C7bfg&oe=6A6F5930"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAy8dlbBeiMQ7kNvwHcxVWz&_nc_oc=AdpLoSfjlJKE2M5btN951DaHWnOGp5A17-X6RpFUC0cJl30Mi5OqcoIV-UY7SERFyE4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUDJ_8KODg2TThml8UcsCrSZysUNXZDLeSCgfMhQS3BA&oe=6A6F39E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nemJ6WtyLfwQ7kNvwEaie2K&_nc_oc=AdqWxX1pJ0ilgaiGQ3GBZfSP3D95N93deIi2L8mVo05iZlFnQ-ytHrGRcpCfb6xzm4s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBtkMCcTLZ5qkRAoHBLC1292vWijRnxUwQDPveiGYdcw&oe=6A6F5032"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
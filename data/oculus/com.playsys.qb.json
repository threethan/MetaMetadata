ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xarSVfVKY68Q7kNvwGfh6Q6&_nc_oc=AdqEnF5mpGGCgl1UCo_s9vUw9pljl5jmKG4igORW9YO45r3oqcu2kgtv0jY4P0NY6vI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjMLv0h4CUOnD9XuqTtzYCqw6PwZkBjH05IF0v4uNGkg&oe=6AB53D45"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKT2ms31ON8Q7kNvwFlg6yE&_nc_oc=Adqasjzg_eU9UTMiEjHMSF3jGJfy41wSnayvcL9aAcz7IjWTG6v29sElZ6Fplr5zA54&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNY5fRt8IJxwxhZvTuTM2Az3p78OaN-hxpLgsDwetTCQ&oe=6AB515D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdAxyyj6p1MQ7kNvwHzupra&_nc_oc=AdoKrkqkLz7dvEN-c50IACZLLlUX1dDk8KiX_J7vZW3Ay6TYb9U10sU3XJA656QcM7k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICVAHpC_dJF4K4BNdvyC9tEJvJLpT6kF5Egn-doibE0Q&oe=6AB538B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXlFTmMtkxMQ7kNvwGLhoGN&_nc_oc=Adoef40Pj2ccdElT7SvOo7xGNAUyiZuI_Ho_NWBYZOQV2jBx6pQ5wNpyLlWSAXpyPxo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtAPFhDm5lZ4IRxxqEDCxjhkw7TyYn78m-gHuiDb5K4Q&oe=6AB51965"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-XAO_ASWgcQ7kNvwG_FK0I&_nc_oc=AdobSqPgUAG0gVoRf5tKDIRFC34GofPbn45_fi6qg0v2Fo6weCrgMhhh7OS8bvfPFIM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFiy9HRfYuQRTFSgQeB2fCO4bbpSa9SdpKaeYr8Xi9vw&oe=6AB52FB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
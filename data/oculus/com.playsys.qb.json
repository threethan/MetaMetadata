94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_sGc3onmWgQ7kNvwHI_75d&_nc_oc=AdqqjcRhCTpMCdO0q7LL8DUD1ScRVre8SOdiEntLtzTEeCKAD3bvcTWZhUTk5-H37Ss&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxD8karlXEiQvY73OHub4CFUI9kh0tKLPL-0LKJgdXUhA&oe=69C3C285"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhgyBei0j1AQ7kNvwGZmMcB&_nc_oc=AdpeKh7d7pVnG8y6dtiGLGeKQOaUCSiD9cyqde2uNAO-R9nog7mdxGwK7GYeP634dDM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwuRmfxQyytXDTtY7DOgWftkcD6wGq8QFQMW15GinHcrA&oe=69C3D351"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGHwTj3r0LMQ7kNvwFsv0am&_nc_oc=AdpGJWT7j3yw_IFsF3a9m6pESL1E4esCaj2R4iu9H_ir6Bm10y2w4ryPtaKPh6bohuM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxi87VYG8gh1SInzC4HHcQ-yKfnB3LweiMjD3iSS5vv4A&oe=69C3BDF0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57ztNMeVPfYQ7kNvwGTwKHw&_nc_oc=AdrdT9mFWS9tSZAb6l3RLA6_yoEMa9gBt3msimxa8G1d_NxjNoKfYlXdlFkKnxGQbWo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyX29rjQ9b0Ptbj4CJqj-LI1xgKjESJcPBVGwVuRctklA&oe=69C3D6E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLynNp0h3XYQ7kNvwHKWYfp&_nc_oc=AdqfcWtxX2DDeUOMlh8p6nugQ_nh7GLBSY6mLGkYWkDJSfj-EdS3fhp7hLCFOzpvxwo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxoPHgXX0xYamviA1BKN4tjX7x-gbyzvz-5ItXVHQMOOQ&oe=69C3ED32"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
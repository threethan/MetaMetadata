94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-CbIv3JAqEQ7kNvwFJICyP&_nc_oc=Ado9tx-Wrh1ZAkCLIdG9UgkVA2rR_La4lc3H7jEdtDFXYDfBdhpq-cP2yJjs_xklJoM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61fVdxOtuIXX-OqM5yuytcXW-3mnBSJSGgXIb6MWXwow&oe=69FA0845"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1sknyhUak4Q7kNvwG_RzgJ&_nc_oc=AdrmHj9TyW6mmza-OKs67n9DGykuLjn4teTINBaf0dMs5cUFN6mDFkcwQKmmT51qAjY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HAPsiXW6Qx-5IPUasKH4DuPJPfy47na7kasYhxDyyvw&oe=69F9E0D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wANIgQlxfoQ7kNvwFRqOrz&_nc_oc=AdpFnkq7qicmgJsu4Hcq_Er61ocApNDzv2kEzcbUi82528GYUqtqXNF0stxEUn4Zo68&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Qb4o_TXlqo9gN3SqIqqThIfWLpIAQhTPGrKuq-Ua7OA&oe=69FA03B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfCyY4wFa-kQ7kNvwFu1BEp&_nc_oc=AdrGLxrOf6GEFZQBmC2WFftpod3ed_jHh9D9n60CQPCeafqh0rSAeGn6HnkY5uPRRbA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76MXuLEPJx6ZQGDNTJP5C05C_OWklwUyLwYiSCEj0Qlw&oe=69F9E465"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSMiE74RLg0Q7kNvwHaDFOj&_nc_oc=Adr81ZMCG5Tjy4Q6wc7609sh-uyKT6I2MclfuGptEfGrXUg78w60CchdXglrndcFIAQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fdruCOOYRq0DFJulv1E5KBvo9yHAxzBX1fYU3tsn4Sw&oe=69F9FAB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
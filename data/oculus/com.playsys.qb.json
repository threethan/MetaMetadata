ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luHmflJVaSQQ7kNvwHIvRA3&_nc_oc=Ado6SBb6vTX1efJ7f0NTpKbG4GIILQQ-ng-67T7MpLBLsafKNLRIOFsbicmn38Qa_t4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6rFdCsiiE4oAJ56XWaXivr9-zjryn6QejAXemprHbNg&oe=6A5E0205"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFA4pViXVmUQ7kNvwFJmAsY&_nc_oc=AdoAoteiZxbdFVqwkzpIY5N7K0Sl7aPn0VgqP6oFyDGA7Qrrwj_US_5RZ_h3yMVIHgU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7e08gMH9l4ve9G2N7hk6yJA4g7xTdbqtjlZUAxXB5BA&oe=6A5E12D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IULW7FWJwEQ7kNvwEANH9d&_nc_oc=AdrWGn4r8rEXOzYCitX0emJ2HHDwUoFNQGdlVj8S9ghkkJy3bMX_WfMKM9CRrgMd-r8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD35gIW2cMhbSatqsawHFJSHV2LRrEFoSrzOV88ldACiw&oe=6A5E35B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgDSTs0U1iYQ7kNvwFyo_Pp&_nc_oc=AdpcaCZsS_RMoLELs7IMdRjapx6MDBp5M-WH2gM8HGoO2qonMexXy_jt3QbFHO5S684&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwd1bgUlfVeb27XN8Dz9u7kR2V666DzEcTNP5PJSLC7g&oe=6A5E1665"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCEQjNQVA18Q7kNvwGQnxri&_nc_oc=AdrrWgvv3oDaenZaJkcoySNDZS2afoewevSui9fWAfjuPCst_GHZppVP8JqI_giUs5Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrImuAaMpXUWQB5OEk2jve2VFi6jYnjekgXjBw7yo1JA&oe=6A5E2CB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
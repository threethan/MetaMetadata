ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gC2l9pPn8b4Q7kNvwGc0kVL&_nc_oc=AdoMvCDGndx6MCVDptwACa64zs8mzDIzoekb00iUkhu3JOJDOfxR5AUa0lkqFch6uRg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArlaaDXG7HB6YULkkT-vKShmwUB0XvaoAVzsQ7_m9GeA&oe=6A638045"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ll_y01t5Pq0Q7kNvwGGLfMC&_nc_oc=AdqTpErZeoc86EAru8MiQT8nDwZx4sD6DxlSM5fMjjSEaFopo6Vu-4RhEizque06hzE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUNhH_8Ja9NYy5JiLFEH42J2ii8D2-eOFtGvPsyH1c_g&oe=6A6358D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYezz92-kvMQ7kNvwGSB1Fw&_nc_oc=AdqngHB0yoZQzV9ql7kbW3kgqxIAnrIYGOeT_HlAzWSfVn-V58MEQveJvN0n74vB_Yw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD04HCXNW-ADXZFZfp_LPKsbtIDsNsGGNvABF9kfmITnA&oe=6A637BB0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUxS5H1WPFEQ7kNvwErhDA6&_nc_oc=AdoaCoJMrvrnDSyfWsgbqPqVm0ls-86ZgysUCQKZjiwpD1rE5ksjDpP-9o8zKKN5SpY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8u0glk1wv1S2pNm8B_zVr61WHVrW0uPTjvxNdgywzIg&oe=6A635C65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mM4KJkoMMyoQ7kNvwHeuPcz&_nc_oc=AdrnZN6pT9tks9mi-TReyM4nbMjhyBVV4MUFusSPdJU3xOygAB2WrN4zbSeIWYwwUUQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOjbPTEvwuorbOz4jqCkM6goPDKHCK2iL58i_5QB3OAQ&oe=6A6372B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
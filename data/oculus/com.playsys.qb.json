94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAEUHedRts0Q7kNvwHYNC6P&_nc_oc=AdpFEYn_N492MXBTS04kdGPaI3WQ3a0FfWjbonCfjaeim9So7Zk-wgk4WGkPk4GzFfk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Minl8bDrvRy61ucqB1Dmgm-MhSgnHUBfcfDZSHjRK2A&oe=69ECA105"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klNOV-OnyTQQ7kNvwE_vc7Y&_nc_oc=AdpB9D3VZ_kb268cdku29avHNwgVWnrdTun4Qlh14M0E6pz3x9nUKWIW06GrkeBjcug&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OBxK6SYJmAr9lFQnqQl_CY3mkKO_n5qYJjoBi87mASw&oe=69ECB1D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCjxNV_SysMQ7kNvwFmQNQc&_nc_oc=AdpRa-NNWXHSQ9bohwMEa42c8OGo0VhFYXgfOzmf_15W9Mo7rW93HDGSX1zhqaaAao8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1by4WuR6E93LmrwD_UO7u-UjBkC47XFBp5yHXfZaXtwQ&oe=69ECD4B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mp7jB0tX5usQ7kNvwFaIScF&_nc_oc=Adpdad9RbO4oSNUKpvveofNclPstbeJqX5WdI7dhuazpWSp-T7yiZ3XMxPMvB1ALjqA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36_X6TSznRLmcQoa3mmrQvkFDUDZ2ylbhaV3P7D1jg8w&oe=69ECB565"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_dJsYt3X0cQ7kNvwHJNXpo&_nc_oc=Adpf6D1CivpTog_FHeUaOT7FRS3EQtv_hUPZwSEMNJew1a_MSOjpgyoN2bOhtZhXLM0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IlIXG0dIfskCt9ixV--FgDiKf_RVGIkfbnemyFsaYKw&oe=69ECCBB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjZgbW6ktWIQ7kNvwHdv4sK&_nc_oc=AdqWk4zEDDguv9RfqC-_9TXtQSwdc6I_HS5snCquILEVqFh7hcAHglWbvKdL7qYtces&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_Xni_bE3OA9Ai3NG2PMpjeBlY4mjDKUxl42tlZcgaIQ&oe=6A0F2045"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvzzPsA8eMwQ7kNvwEcVfAo&_nc_oc=AdpJWCWPasTotHppIMT7sbIkcxDWVZ_E502N6eX-Przj3CY2_FscZynApm09cf7S35A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DjTba4PhJkaPM9JXiPnxOi_H-GhP-Ish_ZBv_faUowQ&oe=6A0EF8D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5qe6s1gzsgQ7kNvwEgOwUx&_nc_oc=AdrLo-vEr3mMxppCDWeCZePzRB875Ss4TNwMH3oa_R-eAdrH7cb9gW424tY7Qts0_l8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aNrWnk4mRCFf2T-2-iQO3Euf7wF6Tk4TCBpE4QXGhsg&oe=6A0F1BB0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ty_DXV975QYQ7kNvwEdrtbA&_nc_oc=Adq9lsxPXFtViWjYxu6K4T-qkGgOPliuS0Cu_3GeZ1lGx9iVK5wwAprIODDeFPHcAX4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6A3Xw-8lvXx8nE1sWuagJ9xddefLzM8iaWDsbM5hWj-g&oe=6A0EFC65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqIPP1jFglkQ7kNvwGFnUDs&_nc_oc=AdqJkBso3f8h-jEC92ShwjNeUSs-1KdPsY3T5uRIVRRSjQuVq6DTrh6FfKtm8REb2g0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7O4yPQEKqQR3L7yOOOkup_C_wiw8A2AFb99CWs4VzoIA&oe=6A0F12B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
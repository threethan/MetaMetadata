94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpNpiFZWZcgQ7kNvwFY0725&_nc_oc=AdqAECM0FMdwDfT3SHNB3Hdb0Jb8OkioTvhrjQhqm0-2u7hFyLgrn3sBfPmXg6Jhrrg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7n9Ie9hUIJRJRhxZHit00Sv_AyRNs0H8lGtmOoIWTeEw&oe=6A19AC45"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zdTQ2D-VmoQ7kNvwEq5EWc&_nc_oc=AdqfEbGVLwUbi98Z5ZzwJEz1xFjaR8BQjqcbbfpv0AJchguFAmab2cQnTG2LbcpQ9ws&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Z_bRKdMC9Cm3YsZAATZM8mXjCFm1ndRpNeE_J8El-Dg&oe=6A1984D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-qk9SO8ScEQ7kNvwEBL0gl&_nc_oc=AdrPTAkdQnVaRIoEr0TjjWQqzPr525H4xvU6gtJ7SEQ6Bs5Hw1F-tg3CTmXZBAbKfmQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OVCkqBQTJ_BUoKZga4fSNbcxoCQ9b6v_w9kD2SYgj5Q&oe=6A19A7B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_W2-YuWbGMQ7kNvwHSCADe&_nc_oc=AdrQCldEIUvPSMa3PRFj1FKziHz5ePQfB2ET8_zEkQR9bAYFRfPzvqUi6EV-5ZkAoFU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iiONMaRhj9x4jZasAyJN9GaJIleq9rL4-CFGZ4pmGFA&oe=6A198865"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbuSrWOza7oQ7kNvwGs_NCU&_nc_oc=AdoB-6mk9Rk0stB5Y6xFOqKouv8dLebINqhEzeoyWKte5CO1tCKo0G0GupZXMhhM8Wc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jtW65GYwLwJ3oPXz_SRwJRJx2Fn1ed8jdkVZpkK_vrg&oe=6A199EB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
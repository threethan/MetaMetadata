ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gC2l9pPn8b4Q7kNvwGfzkeP&_nc_oc=Adp86lO13IiziXNF0qSn_vlY196ofBjKu1o3dJPZR_NetxJ8KjvbjQIovy33F5s2AJ4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCGlXspfWPg-2glhQH2cJLD0vjZn1nCn9ORPkAjITSBQ&oe=6A662345"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2WtnCSri3UQ7kNvwHbfQFM&_nc_oc=AdobsUjXPlbnSz_-upnHwWSy0UvGuYYDKCiws1ulQQ99TRI4SkU30IZP_tlBklCPO7k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADruLUQ7mVZ2R_I8UEQY9CeOVL-bh_IKOES_yHbaD6aA&oe=6A65FBD1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbv2k2lPpzMQ7kNvwFmwRyP&_nc_oc=Adqn4PcqNwcpjDd132uFTpFWy6GU950Vyp4aG8ZTer1a8TDRfvUxZChFJ01eShQQ-to&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPEcyROdZrFAmclmfY2R0LxZ7ZGSlVVKdZF4XtLRb8Vg&oe=6A661EB0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUxS5H1WPFEQ7kNvwFW59jc&_nc_oc=Adrzi6h0_yd-MksQBvnfi5oEyXbgWeHBFf-rpMx_kCrn3rnx0tJd4eAg9hXDXc6rYvI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDig-q7rYEQUfU3Txugc6E4XrTWB9BpYz-OBkbBWYfwQw&oe=6A65FF65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgzrP6gEWMUQ7kNvwHVUl_W&_nc_oc=Ado8p99wZNIyQqDK6HhvU0JwdJFCHtTNku9CGKf41P059iQN4hQVGKvAkaI6By-Jc3Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOTMLe901jo8t0gnNZhrO_oxIu3UPaY1a_idHHYV2IJA&oe=6A6615B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
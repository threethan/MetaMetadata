ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHR8-44b9QgQ7kNvwGZIu-T&_nc_oc=AdqkN33XmW6s18S-LTmB9LURfxOO6MbF3i5Xea0_81a30fW-dR5i6lhiKi967QtsCjI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9trcDb_Uck_DVBkiloRzl1vc9U_ZNrFhzAZTYTY-GiIg&oe=6A3E9645"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F63fBmqbyJYQ7kNvwGQyu1Z&_nc_oc=Ado96unIVkvYTnudkXZ4IMTB_1GxYO9kNj9WDZ98-fq2ZXAmI86X6clUnjUbiygVuLo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dl8BZ0VUk3WIGEktjU1mq6df1-hcHI5JzoKs0oA3WAA&oe=6A3EA711"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzb2JNRs9nAQ7kNvwEoihqg&_nc_oc=AdoCp9GcSxFGECPvTBr8lbu96Z1J0CRKU1nz7wyArkMBNqUdB2ucTvyOB_Dqo7uk290&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PVBd1907to219tpB3RV0NAWKY6L33SWqDXGJoRE8L1Q&oe=6A3E91B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4OHuTBCLKoQ7kNvwH9W2PS&_nc_oc=Adp25VkEOK2f4yDbXYJFPa1wcVyjd0OahilrwLW39kl9b_85qUbU37kTvn1lGY1hE54&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LhNHfrh1ofKNl7AWxfExpFqa8BoHGkECjzGFKPnFKvQ&oe=6A3EAAA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjqsaA59qnQQ7kNvwHm9sM0&_nc_oc=Adpng_wF24LXUl0xIIOTLen3AvfIjeH0VCal2qeU5XncP7iW6h5L3GD27OB-pRnEYxU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xem7IHOPOniHD7EeEEtad-6ErvABfNBv_HMxlNrV_lA&oe=6A3E88B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
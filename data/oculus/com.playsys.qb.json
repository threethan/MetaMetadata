94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtmqVpOKjGUQ7kNvwFYwwGe&_nc_oc=AdroOJ_X7QY_O4TZcTvh-W8cWUEgP0bAVoUzgiyn4YzbJtkC3xniVd7kXaD0WNDSmUg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hg5vFWSCejdlHWR1R-Sa5BvUFvGoNtONin9PE4cl9Mg&oe=6A15B7C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3U1BJUowtdoQ7kNvwFndqjf&_nc_oc=Adr2YIe8qJzqykEVpu1D-LnNZgxIq11ceTwLDFTX_FRX2-A60kC5EZELkhwR0mh6_58&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5txjBCOr9SAzwn3cP8-F3zwGNL1vVCgckM-NHkBr4oVw&oe=6A159051"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vd36FX-aBUQ7kNvwEKjZ5q&_nc_oc=AdpnH0_ehKi0NUOPkRJJdFCd8esqqTQlwJbN5HxWnnwTcdV7VXPmcfkZE1XrBFQuFsM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WDde_-hf_2C6vnBTvSerpF02zFegBWGJ1wbmJAfO3uA&oe=6A15B330"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXl-LZxw8gIQ7kNvwHJZD5u&_nc_oc=AdoRoOh2dYd_5iASyi1sl2zyoPzRn0h6Acf7VjtSk0J1e0DHRWiYhGHBaGlYhU8xZmc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uWWV0kErAr4knY687r7vg2WBInuNQxDxHBR3anCpYug&oe=6A1593E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGq8DOzsam0Q7kNvwFlX0wK&_nc_oc=AdpEIZ1enhvlxTk_V3HFnchLC5ySC2WdbO4YZZk3DQmGgQ3byejpMKdMVnnZ7gJ9VFw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aBjjikrNeoCYAc1DifxRBuhXXvlWDKPcjOMR3El4Bew&oe=6A15AA32"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
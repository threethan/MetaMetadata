94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGHIhQkEnLsQ7kNvwFx_JXN&_nc_oc=AdpVrBXibIdwYY-oNSvLNJK4pIfW4qI5DC1PApiknC2Vh-LMgDcDXinQIv8k1QNudis&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7U4MNoc_EaAPbeOLhqE4-oBofvjkXz4y3UgTkrLJoiFA&oe=6A05E5C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5VoCsXw2_oQ7kNvwFGju_P&_nc_oc=Ado-jpgNJueJeH3sqo4-KjC5dvqDODpEGnFdCuuzc4BYfLp525-CuGb8Ong7LpvbZ1E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PMN0YzeHjpV1_NyZru10hgc1WLMrG7hM8o066mDO5aA&oe=6A05BE51"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWK7sypFcI8Q7kNvwGJ7cgf&_nc_oc=AdrZmqZnUVhDQCJOZW9SkpK1SaOQ26YwFW9RUFpIdhMu2MQtJgzhDQ0Ucl_1N-VqbYA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5K9tBlKBLG7SOWOcB1r4yqzBbr4vsvlxrEi-lcSimA_Q&oe=6A05E130"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNqVCq3D9K8Q7kNvwHBM9wn&_nc_oc=AdolNmkh3WwOmqEupVy8V2QhsD-bkOgDFPzYTMB2FolToG_Ih024vQ9h075br0RRDLM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sIPig5UahxFMh0xQ4JThYozYap7cZnPf9YV_U4hxH-Q&oe=6A05C1E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SohjI88rdIwQ7kNvwEKpXxJ&_nc_oc=AdrYbSCrXGhzkKEIek4mM19BZjTdZhcszkdZengRa4hbbEaqZJXxnN1YYJApFdhXyOs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EcxGWbxyWX31crNomjgT-zWNIZ18O3_G3_0gtQaODyg&oe=6A05D832"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
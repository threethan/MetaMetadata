94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lf-2ad3V5GQQ7kNvwFl3qgC&_nc_oc=AdrjTJDYk0v97zO_Mue_TYvd9e3tfStQZVAGCdhgeocbUrzc9EseBojTE_VKttAQav4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ws-JYGiPPgfJMJ7ZvC0woMEY2GzH5GcLLi9um9q7n6g&oe=69FF4E45"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsQPXS5ZoooQ7kNvwHUfq7t&_nc_oc=Adpe6_Q6D-0CMFIoz5VWTmWtqLDQwD7yvn5ukBXT-6WDfGm85JN10f9MIKqjVoYxqjM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6X4k4b2SlkUDW3z1dBffFa_cuYkRLri5_8TbwH0Wnxqg&oe=69FF26D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtjZW8ZSWFEQ7kNvwHLRtb4&_nc_oc=Adqu74_LPHUdm9VPOmybzjeeJBxCC2Zo3Wn5s5pe8ZJ-9I1fK9IW4GZP7TABtmGqO4A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qXQ9pPfcF8fvuM5upE3iOtSJyg9_ggO4T8-y3NAakwg&oe=69FF49B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iX7LCi6aQsQ7kNvwH88Zhj&_nc_oc=Adp0wu3C3QdzPmG-m8BagatwWHLCze4peorob4yhDvoUCuK_sbla6k3Kkvzk4lwupc4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aQzgjQVC8gfjMrN6P6_4w-FcoE98XYfcJ7eiJuAfLAw&oe=69FF2A65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXY0yf9a66AQ7kNvwFaCdxs&_nc_oc=Ado8xtuWPaDLse00xAuSV71NcZCsp30upe7y1RV7ypXKHQWQcZJDTax02fPbQuHVVj8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_2_oiXSUBYw4aZ-0plHfekdh2aXhALR-LFvDOjEmhEw&oe=69FF40B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
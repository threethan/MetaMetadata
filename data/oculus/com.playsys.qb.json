94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAEUHedRts0Q7kNvwGVFYXw&_nc_oc=AdpAATQNNKz3fjEjvjxbTS6H53f2tJ8f7T54EaLQvfF1mcDB__kGf6VQ3X74Bno5-IM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Y5AYOJqRuI1ddmMLBQZ6dYHCoDG3xoYIrlsG6JBrM-A&oe=69EF7C45"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dklVA6D1oTsQ7kNvwFHQDST&_nc_oc=AdqRH2vCMplzLLACfcauZP899I9Ffj-YmLkZv4u8Gf2QifI4BKHKCiDvxS5JrBxPQhA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3X96qsucWD560JGPlcTF2m_uDM6NF3_9jk_QL3fWL3Qw&oe=69EF54D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwGz197peioQ7kNvwGUSHZv&_nc_oc=Adp-IQ_StJV8Ib0IuIw4CjxfywLvhcudbljXtNj5Xxx61BxVgr8fQfI3eQ1CdRCI6ig&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3FGKSEtZp6XeO1T0DePvx0L9QzPNHEZec0ux4rVUnaHg&oe=69EF77B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mp7jB0tX5usQ7kNvwESI05v&_nc_oc=AdpA0oCxmG5yOMWxDXywFpz5K7xWLXYtAsrnDIL0vjbS40q5rFm8OhFHrlfKoUrRTUw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3KzSlJMUcBHM6VNIfXfXpUjWqecbZA6p0ifJIEuEDKAw&oe=69EF5865"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leEqHa4IIyEQ7kNvwGHyrwO&_nc_oc=Ado0RFZcBFd824kxRfY9Ajxc23iMJcph0wdnNJ6RqdsMcovO4D2VznIfc-qzRGfLGOs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2T7JwKik6glIwE8_BzIcgIhhsmkJ8sbCeoFFpMg-zQzw&oe=69EF6EB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
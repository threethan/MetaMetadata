ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xarSVfVKY68Q7kNvwG_w3Ve&_nc_oc=AdrdmNQJIhhUmKFLoddmIcCPuNdkOTgXAX-HxszWuGaBxyOMrzdklxNElkokT4HBY8Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLna2ZwnqFYLKzKlQu4_ZQo9IoLkUQ5h9INJw2nFpYFYA&oe=6AB29A45"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z0Ib2Rr2qyQQ7kNvwH2kn1K&_nc_oc=AdotrzqQObTfN3G5NCJOLPG8rdSLuPegyLMfSoAEBlDh-H-9naBcGeFPwGvqX3bQCEI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLnSD0_69akw4C1vuJMr3B7h_JCjNGL5yA1eOdqVgvcA&oe=6AB272D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWpr7dMcWQoQ7kNvwGBv89q&_nc_oc=AdpH_2UCYx4gcZ20C0fviZoeUqSdBQijxBUF8y__sBg4CbwEF0QNDCeMPZzHr1Pw5Ag&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPFbQWLyED4wDkkact0Revc4rQslXD5UzndFWDoQRsaQ&oe=6AB295B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXlFTmMtkxMQ7kNvwEZEgGh&_nc_oc=AdrSboAMXQE1V9pONgodK12C-b4uSJ9Wz4L5I3m42l7gdJSP3cLZQrNnoQK0whXpxUg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTBmrWAPB7BpkW_IuqmZ6CHAyo5_V0jVcHcn7E6_vHzA&oe=6AB27665"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0HlIL_ktDwQ7kNvwEMWagO&_nc_oc=Adrt_Rq4EuY1C3y6UTXcSdl-susdBW2gkxmeCRZgcv9bMjGuCxYPI9yfupWwGKX0P6Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFiz-n-5IWOe6SX4yA7Qi2nA3mkCJ9nvygRArdFFdsDg&oe=6AB28CB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
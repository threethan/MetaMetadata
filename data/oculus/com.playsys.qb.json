-7&_nc_sid=6e7a0a&_nc_ohc=ZSgeEhGvFakQ7kNvwEOS3t6&_nc_oc=Adk0SIbF7lvjod2uPXI0bJOasX3Taj1tPaSU66KlRHmp1ZB1vyfissC17HDJl__Gd_s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvG5dygj_RDrrX1abYNNmq9qw1xj8MGiklRDwxFeW5ujQ&oe=69A96485"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fh3arPqTN-IQ7kNvwGOmOE9&_nc_oc=AdlhrwLU2uQ1XXuCUQez5W8l2XAdDQED0xvzgXpVifvRIupZi76UKv382yfe6Z4QmyE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvGPBM77yOE2LUY3AdHU04bSQlD0U7kFqlQlNl2MkDLDg&oe=69A97551"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oia-Tw86paEQ7kNvwEay77v&_nc_oc=AdkxYWW6xUSN8SmwcKizd4d0praTnpNbZXrUTC5A9zWRl-5xZWlaEy-Yuoc0eYVjWgA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuggKZ48bE473c6w2W3aa2fCijakLU02mmi6BZ6oJ7MzA&oe=69A95FF0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Ak8ZzLr4bYQ7kNvwH3K_U6&_nc_oc=AdmyFQzSQbotUZU0yuTybCnfgFnkeD9h1Jez4pPA4wliAEZxHQVex28nVcI1yX0SHLU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afvb1ofsrDFnoeQpAM326F6-e0oFDMeWBAaMakdvgbzm5Q&oe=69A978E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dT4OoFVmIDAQ7kNvwGKnYeV&_nc_oc=AdlTzWqdPQ_E6jEfyI8u4abk2AajLhuSJ8Wotrd6of_tEAxLHFgSbHtIqyiiYqdWnI0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afu6pYtpHDfjVdmbylWObg9djspTM6aGug74wst4FtuCWw&oe=69A98F32"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics
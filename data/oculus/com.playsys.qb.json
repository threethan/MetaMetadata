ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYpgIJ5f9jAQ7kNvwHAOzTR&_nc_oc=AdpWxTCcEPsTxfuJDFWkMhJO4e6vCbHjGT3ZmQOveojiQWccgYpYN7eTAomiGSKvH2A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4o3vnFhd5ByvVwrECem3WNMl6zWq77K6QFXTQ48AbRg&oe=6AC903C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fg28Ac5-SgsQ7kNvwEXDeXA&_nc_oc=AdqL4gm4edjlt2_iVzecVjr_lG5JFaxLWPNDGAE2XZ4Tav8adwt2EEWE1vvKR6amvXA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7IRYpbUA-VC6Q0sEHQWIEwPO5b6E5OrnffwwiGxbq2w&oe=6AC91491"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJZOVD1h2R8Q7kNvwHsQI6A&_nc_oc=Adq4hvlFnFFTmpJCGBDsA6p3-zT9eGGmVXmuLF11F_i7wN6AzApzoxYESkSDs7wc3C8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlHCZ5RHEFPxyTNkhmxHkPlxnkCArj4C5az5qyMOCGAQ&oe=6AC8FF30"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiiMH1bYVUcQ7kNvwHsWhIn&_nc_oc=AdqBdyAhHAuh4UxsV1CHj2eOjH-73aNQkgAkRr0zFUjYpgKeQuqkYvf1FbpwGN-RAeE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhVKiuPU5lCEp59BNpnSx8eaVkK8BAAdriJczAq4fBmw&oe=6AC91825"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IcIhWFBW6SoQ7kNvwGwLoI2&_nc_oc=AdoKEO3URs8fL6gXmuSVxqnd1xsXp7WrWlO7p6HyVXqWQLI7Jo2LhQ807Cv7Hbg5ZbE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9_gLBW4iKqjsDCYerL9toNTrBrk9MIEFC3y5hjU0jDA&oe=6AC8F632"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
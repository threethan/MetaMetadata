94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyERjDL06MUQ7kNvwGQg0TN&_nc_oc=AdrUlmTTczzVfspZunWWoKbFMx2UoV7pQ1Qn7JcqXNEQa8Ql1t_MUZQw7_SeuerHqLg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pB3waA_GBMUEWAeHH1z-nG64U5p8EbQ_lcrpauzeKyA&oe=69DCCF05"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YF0NgAL8Wf0Q7kNvwEXNUYE&_nc_oc=Adp_Zs_dmCL-ydtg0xyQtPy-kut4n_bKrvRusvD2Jh2Yu7C89_EVMVgZ2kR0nKTlaP8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ds1Rf4fnj8-T85rJoliBxqb0SHvNuZxZEqb_Fol6iHA&oe=69DCDFD1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6F0KDXEMBYQ7kNvwEyTuRI&_nc_oc=AdrEB7wu42LwC1zt8RB63E9upuTsVa0dpxdR045c3llMgDT6XjURVP10L2VCFyhlmlo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01iWn0mJKfwebtGMBevPg41jKd87kO8zW7z-gTr0n6hQ&oe=69DD02B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrPvwyrd4vIQ7kNvwEYdQUI&_nc_oc=Adopuf93csFTAM8mSR-FS7VQxLCYJFd6DBUGFKh1Y9RbbL6xka3-slqvUotDkD0lJ0I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CcMK1UCRsB1Culti5zyAouO4w5QFOBL8bOFWURrTg4w&oe=69DCE365"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gldfCKNeulYQ7kNvwETa8tQ&_nc_oc=Adrrp-RXQAQ0oBywvDYvYFWx-c4wZuqo0ZGoLdEkIml0w6fYAp8szgLEfXOmGtBfR10&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1487SLwzGcMItSseDN28Wr2hiJQJHEs0FwPBgtJH_z3Q&oe=69DCF9B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
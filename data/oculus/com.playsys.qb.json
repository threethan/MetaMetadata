ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVa-li1FvDAQ7kNvwHpXn1i&_nc_oc=AdoqcvUWR8xOw4a5mZqlavzj0ScL4059P92uFc4zZ-Sk_ihbYI6srLnIkbPQrtjIy1s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADAZQOqb2dG6oertUo-fo34-3sWpfJdxGP4vEiP6OhmQ&oe=6A6B6945"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7zE--yrcHoQ7kNvwE4KvIw&_nc_oc=AdoKsn0PS2ejJAJdC6onQGIGrrxkJ7VMMiO1pgMGhfj4iEuDsYe6jgWtX7PU1b189eg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoKo6IhatvPGsNMc0zEhLpwsiBNUHZz1Vf1UCDBW2eNA&oe=6A6B41D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TNNApjiruUQ7kNvwFyA3Kq&_nc_oc=Adp94UFKEVvQ37e41QCZfM4VWuzrwiiJ8AcwlmuwMbCY6RLN5NstzOnqjWKytTJd3C0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXTc5wOgTBx5m2ujpJ4Tf5VQdUlJVsJbixR6gp62yuSA&oe=6A6B64B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGJJFaxmoQkQ7kNvwGZnxdw&_nc_oc=AdrGPtO8gp2LXfeFBqz28j7nuSJYWyac-OZw08AVl6LXPGMdfYkXF_JM7ssHRgJdQIc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDc9Ae3CFwkdFkCRTJf5YqFeN34X_Fu3O1MbU0cJPz-kA&oe=6A6B4565"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zp6Ve0NX9cQ7kNvwHRAIhx&_nc_oc=Adr-OsZNLwGjKZfaIUAaOPJsaXgR_v70ta2nAbwIR6PeoDKwwz1XUNGVsrcoGF9-Ik4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWGZqR6p8DlDHPgTVJVhLHAyDgvjmhbde4lyV6ewCFRg&oe=6A6B5BB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVa-li1FvDAQ7kNvwEOyr8J&_nc_oc=Ado2txJmtPQP0vb2iWcZzy4ek2vMLBcXWjVQ_oxkaa88pVazoRadMmqEqIYVdbnWlFo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-r78o0JZDrpiIOo0ZFVLo5VdF4m-pGtHMWPHrDzcoGA&oe=6A6CBAC5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7zE--yrcHoQ7kNvwH4PLMt&_nc_oc=Adrk_5SzCjB9sz8BTr3MzKvPRTzdLMd1f5pLFUlNnmtGQsSye1WBB0uMrdqkleN_UTE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhdMIIpIuvliqxt1AB4gxxlZzJti53sGrYsg7LSZn7sQ&oe=6A6C9351"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMSYP3BFfjAQ7kNvwHLeCCs&_nc_oc=AdoeVeJv3pDJC5RluzDVThst0nRt7vkRex1lhq1j6CSgKCxiIv1Lw8qjw_faZA7Pf0s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBtgVcegpsvVfyEk1wpx8pMByzG67urOmfkQajmOvZDA&oe=6A6CB630"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGJJFaxmoQkQ7kNvwHgGLy5&_nc_oc=AdoGPeWLUPAzsVPr0IYFa_FTVSeagat8j8JIyvbVTRVmYVek-2fAzoMouBmfgaapORc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSpOFAy0-ZZo5tpyvYIf9ZZh16l4MMt_MqUFF2xpon3w&oe=6A6C96E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nemJ6WtyLfwQ7kNvwFOfg-P&_nc_oc=AdrFqfytxPD93Rcq7K9fz0rOwmNG6cyRcvPu-C6Ulx8iZNMMUBNRidDSapvfXLqk-Xs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBziHjyPKuxn_iDAhUxG7aj-y9VwvtRadflUAINxAniFQ&oe=6A6CAD32"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0ArNvvVuDEQ7kNvwE1xtqy&_nc_oc=AdpQ4rQLX4Fi-G0xGIx-pMAlFXXIhxeAw5ZtiUB5v04yUGis8qdT6NjhjLrW-5wA5P0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeJFUXRTqnzh6FISXE8ctMaKQcLrlUxbd7pixvrLxhtQ&oe=6AE361C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSQrUAslwFkQ7kNvwEkgGSL&_nc_oc=AdpQKU1EcX7scPO_g_7SA4K0DRaYonm_ePcnKjYQx0-xqpEQlkEykEpXseMG2NwRnJs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOld81crd4H0U08JyAFtxWeg9LrbfMM-ZMHcTJUYAEfzw&oe=6AE33A51"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3lH5H3ZJWYQ7kNvwGM_gAt&_nc_oc=AdoR6WIcCBB_A0c7YwTRPehDeLkcVfeOGpWDUJcJANSkLCEcCWUUalaSKwjx-j_Jw2M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqEnux8-Y3oJtXMkG4i62ov0cC9LHwD2I5cdE8VryEiw&oe=6AE35D30"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3pnxrZdiS68Q7kNvwGNIqGe&_nc_oc=Adq-spqCoJeriYYzGqNa046DerC0gIT1V39NM06XgDPk02YJSDswd4lpHv7NH81-Bmc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBGipovSUgcx1QMVNn1XMQpmWgYWH821z-gZeW-xQurQ&oe=6AE33DE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gn0WL8xi9W8Q7kNvwEIi2sS&_nc_oc=AdqglSnFIh4e5hTwmsKYhLlFOWGucwJyo-uxG_yZmToRiVpwCQy-TEwg9hN-18tTEuw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAbDu2oNAlozOnJjW3BTtag7CXENxJWZeDbzsMBoOi0Q&oe=6AE35432"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
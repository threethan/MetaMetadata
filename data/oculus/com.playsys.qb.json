ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRtHsHTiM7sQ7kNvwF3aKZb&_nc_oc=AdpI9Tsxg6s5F9zQeSuIqaBETJkPNCfD-_l7ez135VWlHJzder4QnbBmPLbjGgldFI4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQb1nHMC9cZWGfVB1ttwboPs-9goSJwewv9TpCybc-XAA&oe=6AEF3F45"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCwZ8lZBpzUQ7kNvwHiz6JD&_nc_oc=AdqDOPCPK59gstMzNBcUla0_p64vAz9ZmpLWlB2xwc7Hv_C4vy_pwEdwpSyzQHBRGGE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwTkG9lnpCdlc5IUTV94ZuFHLtIuChYtm8KAfEHfYLBQ&oe=6AEF5011"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gPVuwkXvxIQ7kNvwFbGUKi&_nc_oc=AdrhjppYOqsNwiiDWxX-Kv2vxuIepz37M5FEFnCbuWEQbPbL3BnWr7rH3y0LzRmA0ek&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQc_eJCNWzi4o6T4SiZGNJLhG8uTKOMmQBNz1PM2qFUNw&oe=6AEF3AB0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqwS6X1BeV4Q7kNvwGkhFW2&_nc_oc=AdqVGkwRw-gVaYmOJKT9EPNjc34Q2TeSs3dsk-0DPAUM5GQPAaA-FXCQ90pvFZgII7Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQphRINSver9Tgc8WxSj2GQ7_VsCo9CFbwEHltMbPbihw&oe=6AEF53A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icjLzE-0Eh0Q7kNvwHYXY6w&_nc_oc=AdqLjjddP08mmv_t-OQviniCz6iGgYH0oSReAHlu2iYYDaZOcfhNhWmsUiH-ySuSiD0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ19-IPPiijSXfyLSixkZpGDhiSqdLqSsbfaXi7z6v5ww&oe=6AEF31B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
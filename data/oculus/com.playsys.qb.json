ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ls9kJQoLERMQ7kNvwFdr_Te&_nc_oc=Adr3EYJ_v4JyrvzQwDSgYwGXF0xNqticdKDexqQKmWDeRiPfh2_EUd0YcBu7MEPwck0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCkRS1k0mWcHs93SvOa60GyYQ2zrj7uMwrGLzfOTaCCQ&oe=6A68C645"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2WtnCSri3UQ7kNvwHYt6Tf&_nc_oc=AdpGc1101nDAtH_oR4d9PABa-eDb71I0RI0ZOnc0zHThUmYcr49xUK7S09oa57mf2zo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANBU2slJD-P3RnN-bA-W9Miy-B4LdYSKm8WIlQnRn1TA&oe=6A689ED1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TNNApjiruUQ7kNvwHA7l18&_nc_oc=Adqgl9YXIQcV9jRpBHA5GfO9ha0lXtBoOu7i2aS5GWBaEJcW1WkBrdVSgpmMAa31nBw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZMiUwBohIFPFa7gqx3xhVipTEjFDRV_9SIN5ZYSnQwQ&oe=6A68C1B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2lDLw1_IhcQ7kNvwHfVsQB&_nc_oc=Adqp7EQvT2FdlNR7MjhRinySJU4HJFv7ubH14yYzpa2bQtoUbgeDWLZsvBuCMZOnovY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2Qv53czVvI_HN75pCNPLIRghpwBQdSNhVxmsB4jR3yA&oe=6A68A265"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zp6Ve0NX9cQ7kNvwFbAOC6&_nc_oc=AdoolmHXT0kkEpX7JsnUEblfCuXRHrQpymuBH-UbPG6gIi_8jv2e3LQr1midHcoaAMM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiGRnheN1zwYGWS44GjnNTQXclN2xJ-LfgiPd3pe67sA&oe=6A68B8B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
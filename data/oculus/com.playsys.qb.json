94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBoXfb8xfasQ7kNvwFO8VMM&_nc_oc=Adp6tgrbD_F06VCrrmz5nUIE8dX5-g-Wa5SKPJMvo5t43Or-elKLl9VJIoNOc6i0P9k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YNXT_zMluetDzUtW1HbCj6GYSPJO1XY-Cuj6rdk9ADA&oe=69EA3645"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xvwSk8QpPQQ7kNvwGt4v6q&_nc_oc=AdpIHESPv1hW1V4OF9AONKrHz3EJqJnc5saNJMtjNXWBsa4TqgQA-mmRBhrZDtRRekU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_eS0W1oXxw4BSfLmvthL6ReDEC1uXAyYCm5Z4McLSRw&oe=69EA0ED1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCjxNV_SysMQ7kNvwGTmCqO&_nc_oc=AdoyUV5ELpDO_FRTMX_bvWRMxqWo7Dk0hU5IbWVY6Gfgmsue1KIMIVbX5s8xMx1kHlc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1s9384uHOgmfIOfL0m0Xkcdv8Z9djkR3VJm7ZBGwC2RQ&oe=69EA31B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svBJo8lX7J0Q7kNvwGRJp5b&_nc_oc=Ado9SiVQkmPP5vA8acp8iMaTO1BPjaGiQuABv35K1uyGRW83GR_cZooVqE2mU9RUPYE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_CvynCR6UJjLmFPR3nk0PxXgiDS_vijVarsZTzVYR2g&oe=69EA1265"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_dJsYt3X0cQ7kNvwH40PsY&_nc_oc=Adrl_28JYvBaKIHvDaR35tvvagGMCSqAfg6fOUCjvRXXDsWq86r5HgOHbcc7ywxsjJM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kObIY0y5bZWjmdbzlkxQgqJAxZpPQB5-5Sx2Kh_WyxA&oe=69EA28B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
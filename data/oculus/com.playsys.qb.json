94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rmS5RVGBi8Q7kNvwFsuCRq&_nc_oc=Adqku71ARAJm2MpVWHxQBslUzTf2WizKulo47Lr8Ci5ZqhY8Y4QsXk_h4Adz2yHcrP4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VyRU6f7K56y_mhJSo2iocdMa9fx_0qmgi64xuhYnVSA&oe=69DA2C05"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LkZD3rS5LsQ7kNvwFdxGnQ&_nc_oc=AdqcL65-zjfj5FKFFYCpbWAWPsU4WmvvHwmHkS9kgE7T4uMKC0QorzdyHJzt2d6gLjE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fva6luDj6QlN5XqDH7cUpAczI8YitiM8zPisnVsbdgQ&oe=69DA3CD1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6F0KDXEMBYQ7kNvwEic8FH&_nc_oc=Ado0PowwYdLOVhLPkLHhbl29vnoam0_NF2Yr_JgjUwH0Exp8wg625kHQCR1ccWaAWrU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yGgfAe3Iza1-dpU168Fukapy9fdi7oDgdUeKCNl_G-g&oe=69DA5FB0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoRCsy7jjgAQ7kNvwGWJnwu&_nc_oc=Adqyy0ICj5aXisAG30EgOT9uHwhNIiy_dyM1jMHQ2dHizcQm3cC0qytyPaCGTUiKDKQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xXbLozSCWexYkABQNM9cW7yrXXEM1F-21xhlErP8XDA&oe=69DA4065"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gldfCKNeulYQ7kNvwG4xJOj&_nc_oc=Adozvuxvf3dR1kXynZiW9No85euY54oKVgNMG1iVdOaj7kKGMhhASne2m4UeD3tTIrg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zc6LTRLvyZ4TpRbH4d0lrEKSG0ZFspCJhN5R4-G42yg&oe=69DA56B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
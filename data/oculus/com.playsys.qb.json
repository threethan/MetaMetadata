xat00d2923ueXtOMajkPeZcu4Fs0e5P-6gH98IWjrngXEuD9zpBw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsDtl_q9-fyRNs5oxfp2-XJR5grRNYjY2VS5tUrvw16Vw&oe=69A6C185"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkZoc2eRKRsQ7kNvwH4XE5G&_nc_oc=AdmiY8MYuC81BAHU00knzxIFqtkjrNqAzJIe2S-1PRjfZqSEQBIYQxhFzhs9kfXYWqk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuXJe4S2EF_WTW5250XpOVokSyx_o9RvLJufYfSxk5t1w&oe=69A6D251"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oia-Tw86paEQ7kNvwEc-zF3&_nc_oc=AdnHh0iocGGAqVu1TurLlFvKgnKqpo2bcL-uYbepbkRtFUwrzcdpJ9N3-DAchp2QVeQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft8-aH3IzXP-muA48Wgow1ZYv3yC1ef2iR0SPyfVn_81Q&oe=69A6BCF0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yo62Ov-YGPIQ7kNvwEdxTYO&_nc_oc=AdkuFS94aZidZ3QYYsbH_l-64Q1A_KjYx43t5z5BhxNlxnHpRgADs4RlaxuMuReBX5s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftgMDEkTFACXyt36ezFrZji5gdS4j-j6enhkX5gN2G_2w&oe=69A6D5E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dT4OoFVmIDAQ7kNvwFO7scg&_nc_oc=Adn4Dy_4agXr-ncFN-MQcLMMgEdrXhyCmITIzMPNVdGZhpd2qCVNo9jOsZ1ieAguV_M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftJXkBAQ_ot35ZEhC8_kyTFir-UHJ3lkxFLhPTxythIcQ&oe=69A6EC32"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPFE7KAPuMYQ7kNvwHqxNhU&_nc_oc=AdrVTMW8Lx9yVnEPuWnyAKe7Pm-7rX9_I711mAGw1Kve9vuvBF5tbuOlb4sqP5_KXQM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8QfFYT8B-nigch_PQRIX90OQvRrHNg_YMeDAPMNglxQ&oe=6A82EC05"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNOEbSPh36UQ7kNvwHYojdh&_nc_oc=AdoNZ_-YAt39COc43YydVobC7gFsiFT_u90VSEYSKg3xObJXMilfA32bs9OB5fb3iHs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGB3vHzACsxoasHU8wHH4qLENBmN2ni2YUKj2mRKwjtg&oe=6A82FCD1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OuNp_M4lJoQ7kNvwG7gNDn&_nc_oc=AdpvllZ41AxwFPL5H1CNnwFYv2hLQWmRLMAtjdG4CPsGhZ7wOjNGqsk6HVAeSkWQUWY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGV0OWkvSAxDA4vCYe7Hl-0tWlHE08xaBplqtiA2D18pw&oe=6A82E770"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fR_QBqlKbn0Q7kNvwEvaH_1&_nc_oc=Adr5v4BwZ62IpHFNzVS_A_PHLJEuq19-AV9AP9WNbZfxR0KUrlA2XHK8rzitTf7cVfc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYiAalFVh23c_u3yuc0iMbrXKIKbPhu-bP9b35NpNniQ&oe=6A830065"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fREMEBJMr9sQ7kNvwFUO-qh&_nc_oc=Ado_zMZ6rRGGKoqqk0IaW7pnrFJ19l5lMqVcJZhaWep3dNfMtqPDMOj_sQGlwPqRblA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDvJe7e2nAzKKjTjult8SEaDLIrCgKAYFoSlKMe_O0vw&oe=6A8316B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASSMlzmY1TAQ7kNvwFOYPMf&_nc_oc=AdqBJc4s3s8t_Jjw0YkNcJdRK3z9SgO-aib3n2YppyiWLz_2ifRX2LiJvmm8SQ5RGZw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55YQZsEp8sK3jQ_fpW2JEwhKaSzybza0In4OVmEwIbWw&oe=6A0888C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25-15AdIhQEQ7kNvwHaZbeS&_nc_oc=AdrPo3_oHOJEfF0PkPWAsqH5jy-m753ljAQQT1LVrcKfLnUZCkd38mSb2OQw2oBdGH0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45xBrdOn-Nrq7jRuX_YcTCYBZGKrcvHQw48xh-0QahpA&oe=6A086151"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWK7sypFcI8Q7kNvwE2UuFV&_nc_oc=Adr5tvy2b1G8DOWvadHeDCsV3oxl4-7W9HHe1ybBNfpAwklVFqYsqoEsmcAWMi-r04A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6q4v-9QlOnLXMYLnk_lL7eP4p3AL3t3DsRsiF3fjgwMA&oe=6A088430"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5P4wx6Hn5XkQ7kNvwGe9w4a&_nc_oc=AdrATudEJ5sTJZnEKk1D8ThT1Rpp2BH27F-DvHR8-yUMOxrCxmTW3k89e2DPqWq6bE8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6T-28ywkjl0XtAvEzkcojzPxSRvfsgln1EEiDbvL4MBA&oe=6A0864E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SohjI88rdIwQ7kNvwEm4nOP&_nc_oc=Adp1vRzKN6ZnkNLmRmQNKQYAzkn6Kj8QBwhccUBaHKeTAhAh683lV2GnqD2NT1YA-Iw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pbseLXk2ly6B3GttApzUKUUy2TemY--aOqk6E9R2E4Q&oe=6A087B32"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QH5oin73k7YQ7kNvwHEctNU&_nc_oc=AdrTne0RdlRWRcjrBNehkODVZutPSFBeyG44wJR8Sb-8QwVXWysiiWVRY1LFJUn6J1M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSALfkN94LUvinTVTTlceukYkmo--uA-4OuKEiRlS6BQ&oe=6AA2C845"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDDESS9d0lYQ7kNvwHPudyA&_nc_oc=AdqOsALLgfwV_OQ-c0UhKV9i07GumFb87U57Vzs8KFglywQxH-QSV3GUesQjdOESDFY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNjeTh4om13fl5_iBWYchCdeAfN53W7XD5BoLmf6o2sw&oe=6AA2A0D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nK0UK3v3dwcQ7kNvwFfEU-8&_nc_oc=Adq2tWIdBBGxzG9XJziPjm5hIycp6F2xAneLommD2VbJtQ0BJziGLrztQ2nX_Sc1fhU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJW4OB0v2JRHbZB8pmZBApkk15Kv-7-Px4zQci7VMihbw&oe=6AA2C3B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpPmMIZwGmQQ7kNvwGsrFw8&_nc_oc=AdodD3mr99p9Nqb2XM_NtN0CYaUm7CZUb2pno9qWHXBQRF1R-OFO3oKOON-7-8-sr3s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCbRYXRl_97KmUIX8tSj63jwQb55OzRtqJ1u7wSLUuWg&oe=6AA2A465"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPG6_t4kIP4Q7kNvwHHtvud&_nc_oc=AdqgUJX5mA0RG7l3WKQX49F33VZ_0_QEfd4A1PvSHec88SIYWRl1Bs_407U9vhKYWR8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmBuDHxQZKfp0Gzmm9ys6ElsiYau7np9KUKze7bRZm2Q&oe=6AA2BAB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
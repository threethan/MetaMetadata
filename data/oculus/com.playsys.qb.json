ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAOAvkTPY7UQ7kNvwGsFrIL&_nc_oc=AdpuHdrwKomrIXQds2TPqzRb0XOj6wS_MbvYca-Bh06N8JQoMSerUO3XEnDrqJNyLqA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeZ8uSV9rz-U2AohGvfh2p6K_Q3bdzTulRuHpQIdhk8g&oe=6AD38FC5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuIVikzqd-wQ7kNvwEvs5wg&_nc_oc=Adp3M53fYVBg3WCAMuw4Zik5PvO2AgIvth1BbCExL9IqdLS0Yzvxfsc2gOJms1DTMS4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxdjti3_Dd8Fd5hod-buI1IWz47_5tfBJdrtyT0RVF9A&oe=6AD3A091"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEhbzl1zHyEQ7kNvwEa_z-g&_nc_oc=AdrjqdUnXsw7czZqkJ0EqL4larJIDQ31EUuVn266kCxkX3zSxQtT3VohB5clXx_QTBM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjg-P2ypCyPl5rCW8yY-_DDxbnYtFzNInXxsZIiAruXw&oe=6AD38B30"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMNS_NEY-LkQ7kNvwFTrwbE&_nc_oc=AdpRrOluUZ4-MA_6hKYMh_Qkf83rEGPsGuyCowmwkxdIUWw7ZmMudFg0Pl5Ko7GRO3M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMS0oizR8PL-5RHWJ1EybPSw-ipcDZhelQbvGEiPPU4Pw&oe=6AD3A425"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaVORHzFiJsQ7kNvwE3mQQP&_nc_oc=AdqYgit9PFl6cXt8QeEicYovMOBA86NOtStg0yS1Eunnh0Ws2Q39EDvQSHELaFiuFTk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOck5huJlw8ZKOBezIvj-Urlqd7OusJaqXd49owGqaBIA&oe=6AD3BA72"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
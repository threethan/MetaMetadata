94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIch1S72psUQ7kNvwFNKDAK&_nc_oc=AdpfiOPsrGeen0ZNdj6W2iAlZI7CVtj8Kr1w_wbiu3HWrTAlFzIuBkgG831otNZBCEw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af09ulHid9bnkuRkQ0cen7MYzbfOqc9oAg0gAAHCSFmY3w&oe=69F613C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3L0U3Z9PGYEQ7kNvwEMI9sm&_nc_oc=AdqwgwB5kJH0paFe8VDAowpIRMwf5y6-PnXCRoZULaloL3gWumO28-BI-5g8ZlRHKIY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af05x8ORqQlpY3wsr-jKlxEy7boKP804MXxSa5zJs_kQbQ&oe=69F5EC51"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qL_DN3lqP0Q7kNvwGfMBvY&_nc_oc=AdoCjdn0kMizpd2oJD07fDYefIe8hZrE7uUph13jiBd-f3Qk3YqfOOdgvNLdbZ0y-Rg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0pCIBSv4qsOWaMRmPoQ7km-FakxFpo1EP9sH0f1438bg&oe=69F60F30"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sG6UXtJeq3EQ7kNvwFruQcH&_nc_oc=AdpRm0XaQBbAF0fFBuxsJ6UYFioNEMqOdRFrwVYrkzgpfUTOQw5v9ISal4kRp7ouSmk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3UDcbJY9VDOlj-8UAYGLHFno_QjZSq6HPcWsGFCoBv5Q&oe=69F5EFE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1z36p7K4YgQ7kNvwE6D0tG&_nc_oc=AdqDRprclpQCEoRo7x3u4dwV4vVfCUNEIlGDKi8_5S4DQ7RZxM5kb-2bFAte8dkGL1U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1zNlhovH3FMZRgYpq9SeJyZjJlVxGA6dKo8BjGWcSanQ&oe=69F60632"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ser2D5AufKMQ7kNvwE9lWFC&_nc_oc=AdrYNKv0qjyPxmJ-5kTLug1Dp_XezAgnAQfgwsVdNOGjeEaxGohOwMP7dGsM32PCjG8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwO1JQvvdGoVQ3iW4by-0qCq9WC_1IUQlTZlS7LF8FklA&oe=69CCFD05"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJ7EteOExl4Q7kNvwGYyHj7&_nc_oc=Adqsc2wGwsl4uXm8m5wW87WZnSjwS7zDt0IKSHikPuKG4tXsCedbs3aMP0hbX4uPb-c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy5faJjRfZWHn_WtVZfpEGOr0csAvh9kfJPNooZrGRvJQ&oe=69CD0DD1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDvCDdW4ABkQ7kNvwFN68O4&_nc_oc=AdrXNU6B2DvdifDOEGHH7CClHgkr9b5lgPGkdqWRYsJxSJK42CT7HPEs8pks9a0kB10&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_wLInvONjZTYeQ8hM9FpsjYl_CMWLhynW8RU4gV5ATw&oe=69CD30B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fre6nIXbwZAQ7kNvwGoiswR&_nc_oc=AdqYeysFjaqGtoNEL3BvOnqgve1KLq9Y3toWmvuuGnUFdtcEkY7800gSHFMTuM9VOOM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz0e-kb4vpleujqhQ0A08dltA62h9GAAGhEx39KxcYK6w&oe=69CD1165"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llvOO8Rvn7kQ7kNvwGSXK82&_nc_oc=AdodBi3yGSvesK_AT2HVo1o0wxdXzZwD5mGmQKJs7cvD8qdequBgfxZq2fEofiAAdqA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8ycTXVQLwNK4p42bw-E4MpL_6DpK7Axtc1mCBLk4TNw&oe=69CD27B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
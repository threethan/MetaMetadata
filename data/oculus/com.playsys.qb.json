ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FiqZ-yzYKWQQ7kNvwGeC4zD&_nc_oc=AdqkwJRHBGcsfMdpunGLDqWYKFlUr-174UV7aEs6B99xEYo375j1b9IgqWHcCcM1wnw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxW0x9HSsBeMaP0dcef-fYwKGo0uklv4TLzdc4rP5kYg&oe=6A525CC5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjUrnTe0lAwQ7kNvwGcMvCs&_nc_oc=AdpnnrrN63upUgPUs8olkViEhlL5NEUu0m72ef68OgyIOKCKogb4q3h_GpNVdnsjJug&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7KrevT04PSAEPRhCs5B_bh3GN8SrD8-jK6006g80clg&oe=6A523551"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1a4QPZu6Kh4Q7kNvwGKMbLH&_nc_oc=AdqhDUNYgwi4B2np1vDWIgdQZ2y6RZg-msrYiCiULQnMxMbyDambA2Tx9M7kvR2wcKY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqDQexVphVMumJd7MkE84Vi2m-YKG3JLENPfB_vEz2fQ&oe=6A525830"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vc-0uqGHRWIQ7kNvwF4tEvT&_nc_oc=AdotpMlsvNSje1ZNdUtIAV7K7w9VF-scy_K9SpybOAjZcxqtgZdZFJzAa_3ctuux4NE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaJpHzurgRGOVAaGCMdd15X7Cd7Ap_rcjyNUK3lMRAOQ&oe=6A5238E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRoX9jQ2owgQ7kNvwF8re6W&_nc_oc=AdqrnKn5wHSTvC6k3pIpYHrP0G6v8SbuCVodgEEyUq32SFt1kusBJKCraXIjYTSAVdw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtG3vPv7OnxG-b2g0DVpOdxywkSAekY9gGPuoPmAgbSg&oe=6A524F32"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
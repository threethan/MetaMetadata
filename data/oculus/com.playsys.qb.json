94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KfVJ8nPF_gQ7kNvwEAqXJi&_nc_oc=AdojqMfEmMYAYtveCrC2hxL3Zev0i2LhrPEt3KZvrQvVM3zgCfLK-ugqsBNq8ddHwvM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw20_shSjMbqsjl9FRdm0Z7vnCHoVxuNisRpvtQV0yS6A&oe=69C90885"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1wP4x57XwAQ7kNvwHpVGIj&_nc_oc=AdqWQGhxAJQe1PK_L-EEq4ZtKmpP1ENYUTWqmF2yRpMDiHuHIS0bb9jfQiyg_pYhNFQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9n9huuy0LrztB-t1pI7tZ6_S3j0Lv9X1jPjsFqHBWGA&oe=69C91951"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rmhq9NwhVgQ7kNvwFe9lwI&_nc_oc=Adr3hgpTXELu7R1r9r60WeIEUX58kGokcdAeGXpqtsboOc_hsb4CyjiXyKqIE0hIMLA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyjEZEx6iYKApirPFehUvzB1kor5z72kjYc3NAcQnGJqg&oe=69C903F0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDm1SzlLR80Q7kNvwFIyIF_&_nc_oc=Ado9pVusw56BDSjqo8zsF-goCZ4Wclg0Q27028tUPlA1RslLthB4mqPE2OP2Dt1_LWw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3YbPXJDayWgW5a93h0EXYu269cdZ1OBBp4bjjJ6juMw&oe=69C91CE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diTdarJH7fMQ7kNvwFcEWiy&_nc_oc=AdrmT2rqMTSHO1XhPlxDLiHmurT5967afE96pE2fp2uoeXHG8Uu29gT5wAlO1E-HsKA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUFG-P2_Bs774FI90Sot4hqBHOHY0y0zd5o3ytdR8vFw&oe=69C93332"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
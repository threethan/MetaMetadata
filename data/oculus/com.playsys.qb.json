ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InXf5ZKxS9YQ7kNvwFrvmf4&_nc_oc=AdqJ4migAzCZtYOShYtsLNGHnzaGewDWO6pECEJyi5kk_B4MfrjyRShpTrKpFQ_xlec&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98u-PrwYnmS4K6odDal_khu4DYQAHpL_jePGoGUIAtaQ&oe=6A413945"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F63fBmqbyJYQ7kNvwEYlbps&_nc_oc=Adr7gYfkqDs3Ltg2JvZy9qceTONgp0msoI5X_bNX_NjMJMgDelqG2k25kkpxS-JHBXA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8w5s-Xdt93yopSvq8hxw4bACm9HiHIvGCvuV39AF2lnQ&oe=6A4111D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUREMHpJD3EQ7kNvwFtJKgi&_nc_oc=Adqbd4TtzskESgB6UDc44ET6nTEINYif-rILnkAmgVyFoKdUNZZuUaJ34thMKWq1DCw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EHRZZnBbHqWbciAGR7J2imP2M9gZX_q3BAVpK9J7-ig&oe=6A4134B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fY0Axw_Nx8Q7kNvwE6L8wi&_nc_oc=AdpyCowcnpgycLqQ4i327ViRNOE3hdQB-Pk75PcF9tLFUP4gA4uHTG6wB4INkJMPRng&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95BV4qWstgnV_6NnR-ioOXseHzII3D6FPU7xAynWgpZQ&oe=6A411565"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3DU6DtJsX4Q7kNvwHnArLf&_nc_oc=AdpmiBChLFh17O1BIusbQfFOSg2CYDeB5BDieSoNFOBGcHmlmJljFJzx9Ikm3LBopTo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af933cFWQrMuemRlTCKfzk_YD54s7YrDDhZNaTwJ1GO-kQ&oe=6A412BB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASSMlzmY1TAQ7kNvwH3--Ws&_nc_oc=Adq2LtpfQMU66RbiNdJfxjSNUVho-oOcmo0Ruw7qf3SG_pquXpxyFt2NWETU8Rc5piA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QjW1kTPwx2RHaGqIkJXpgpHEBvcDz-w1WQ5mx6bvmWw&oe=6A09DA45"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25-15AdIhQEQ7kNvwEtesw8&_nc_oc=AdoHAZCE2YZQd9cLfMMNGkVFL7HmB6u5_lXJDSq7pyCvzjOI6GJDor-M9oHHyMb5HLk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Bm-eMlFnCMOHzGs8Bvq1ecsCTIi7dqcTZXgPNSov4Zw&oe=6A09B2D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8mFN47-AL6EQ7kNvwEtGhaY&_nc_oc=Adp_P7cD-KE9aLzV-WbvgE-i_cFDLloVSKwJKkE7-R7okfKr2tY2Su5kVPBJVVjau8E&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qBUBFpNBXtofLxOnj4ymbq0pdp9Khc6-Ic-2Ji-ajxw&oe=6A09D5B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5P4wx6Hn5XkQ7kNvwEhuK_J&_nc_oc=AdrBlhmH2AzFOepRFU0kGgEZIRadd17IzvneCalxSmNzRHsUqpEulA7G4JNNMUAxCjc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-VrlBRFYeevzOtwC6y7GFzqnXjUeJNygYX0mZd2pz0w&oe=6A09B665"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDnNx0RO0TwQ7kNvwHrRHaq&_nc_oc=Ado088TC5jeV6ChIsfLac1DBK_0UDkNwAyaKFjJMdaegLf2f8HN8oimuLHNB1zscvSA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69p9ZPE85j6M4GGIeCeW1lPY4seWAD5VAhfPo_7hg8vg&oe=6A09CCB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vp1EFZSRik8Q7kNvwHl3NGE&_nc_oc=Ado8FWrQM_Wb1FMsitWydS3pA0M6-mvmJpeCSfGsRqiizCElmpXC1z1x66OS-payFRQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzTr1J9c_ehiX2GrNLBTMKyG19LiXI-OHG845_3KWJJQ&oe=6AEB4AC5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnJiCbHUsOMQ7kNvwEIQXFq&_nc_oc=AdqgCUKhZF6NT2ekk5uHX_MIdW1HDmF1Rq-SIVGDv3vbpke0riGbnOtJSN-ZA4ya6JQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEBU82C9BmxTjlUKb0B7b2DHIK5psmeCCEtHNnE9-1Gw&oe=6AEB5B91"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7tkmL2wm8YQ7kNvwHIIWGN&_nc_oc=AdoiTkR3fir9uiypySxQYgoiZELPlE7XBSammZdh2N1ni8VFY6Q3lXxb56Ku6JVS2Uc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwAphxmZrgCJfIjvFHYdr3pMMqdF-JLgEHzHsWSMmHoQ&oe=6AEB4630"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTOiixHZxNAQ7kNvwEvsxp9&_nc_oc=AdoGJ2Nx3HAYlpV97J8rVkt--_WbF65u_6tmUHlwV_dDbscfUezSTpg3CNDv_I5AODw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLHURcWSpZnczVi0xjXB18sBtBoCOjzcMY__ORH9neaQ&oe=6AEB5F25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dmBAvxK0iEQ7kNvwGnZWCO&_nc_oc=AdoNbm9PZkg2NoFNCceEBPBap_zOkD5itQYtIK4l9mKOSzsKjQqi4LKeAPZd7ZdI_6I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQklF0csEiHCCd1XeUKwFkSVBjpm8Vto2BZ22TSRVXT7Q&oe=6AEB3D32"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
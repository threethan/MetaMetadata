ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0ArNvvVuDEQ7kNvwH0LFP_&_nc_oc=Adrmd4C-L5bKZ_ersrqOmJUN7n9CwDSq2Xjwalh3IknyFNwQw1hRgyNA-OR_-g5hM08&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0eLKGuFONa3EiCmIR9Gs6_crgGtfUyHDBMZx-e_bg2A&oe=6AE4B345"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWRQtAWa89kQ7kNvwHiCA5C&_nc_oc=AdobDA_QzlZlgtBg-pLFfHYDUlYeEIBKMRNxflTyJTkND69-_GnD2mnHk5q8KCyFPB8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfI8Cm8mnhgs1V-NKKuSjjAnVbVztxs-3to2QGQMi6AQ&oe=6AE48BD1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3lH5H3ZJWYQ7kNvwFNAt9w&_nc_oc=Adq8NKlKJ8A2K8CGzUpDdjBxaLXgZqEqVfmLHo2_5rfQ4CsHiOMTrofY4VXxgVsRrJo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyjAcPkv9n7lISLUMgR8bMBJIF4oygE8z1O67iJBz1XQ&oe=6AE4AEB0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3pnxrZdiS68Q7kNvwE88Fkx&_nc_oc=AdpIheNPWoJ0xpiH52pWSJrIYfwGkKcp2DjSA0A2yavmNDpdSIDJAttrAsUUL2iWEYo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMm-8gmMkvGAcKXIIpruMXsk160aBIxkhVVPag-lTKtsQ&oe=6AE48F65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gn0WL8xi9W8Q7kNvwE5OgKd&_nc_oc=Adr8cAbo05pvor82C3RzdoBo0f-mf70069iZYarTncYAl_vqCSvZYUKVOohlXiEVvYQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcCEjEAQ3Id6CpLNqDyS8K3nSmmTat7aJa1w9P8ldGlQ&oe=6AE4A5B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
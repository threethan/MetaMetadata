ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzNyua0yOdIQ7kNvwGCp1I6&_nc_oc=AdoQDxEq32QPm-OxSLRREy8yu1Ko-46xUYvWISBnuU_njaZNGEgpdup0Z0BSv1GkkKg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_HbxLufo06ZiAYka0z2Wptv6nXa2fZLZurGPttkPI5w&oe=6A8AD505"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYsJNBvevn8Q7kNvwHlli7O&_nc_oc=AdruhujiYbGwPBVkGLYHr_8AuUHG4Cff8ZpB16WE1PW2AoScRqSQUQaPYjAENXPQYD0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVPEzfTNHgDRGV4WerbIxS-LQIx7xxKgPupgfGzURJKQ&oe=6A8AE5D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcXYN76Yx0kQ7kNvwFVHUT6&_nc_oc=AdoC11uQTvZ1FtCOe4xQxdoG3vLknhozYk6ew1Zl4Pv2fsYllIeesPH8JkGl6NIfcQA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH42CmCMjEbZEWL0GNUcqwy_9bTwZiFWvdgv6-muZI0Fw&oe=6A8AD070"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnigVJ4x6tIQ7kNvwFyZd_V&_nc_oc=AdqwMZ7wqP4zLMCrA260Fb1Sa6Dc0aXkbOAz5loU3RAQavugcCpjgfSd_uZHpnU-MaM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTkM05Db8qhBAK6WB057Fq88s1CjsFaqxe8qQ71fz3nA&oe=6A8AE965"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOV7AFCXFP4Q7kNvwGt6mkt&_nc_oc=AdrraIe7wrP0oC5O5KgVBDfGJE3YwFWaVoMj6y35w0Ddyths9q0kXGhCR8pPKI_xY7I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDKUHMtNRwIbZ_-1kNEPmaDbs6ZtpctQb3lG-gZOrMqg&oe=6A8AC772"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
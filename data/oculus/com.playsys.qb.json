94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpNpiFZWZcgQ7kNvwGgN5YD&_nc_oc=AdoTzrLXPhjla4G7wlyFNFhdTVPoQdjP5MQrP4-jZHVu8yeuvE9kkbKupr9WOdzYCn0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62vPYBOkcTt-tF5EAZ67Oc-F2WbZii_M3dxdWKrHHB4Q&oe=6A1AFDC5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2PkN9vhWv0Q7kNvwFREaMT&_nc_oc=AdorFPaS7SVG_T0IHlaHdOwDXfOSxzzyhpo0E77bOB1OC67WGIJWd3R--v0YZhoOCUI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MYjQvdPoPycplDmnyyODlyRs5_WsRdkdqGz7YyRShdg&oe=6A1AD651"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-qk9SO8ScEQ7kNvwFn98WJ&_nc_oc=Adq5xXc4heb8aSyr_SrJE-hDq-ynmbRRtjTN-FCvazG63m44YGrLfp-EX4HubCneJoM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TIYkVkMaSnXNrxPwHSJUA63YvBiXptUurOueo1JGtYg&oe=6A1AF930"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_W2-YuWbGMQ7kNvwEfVXPR&_nc_oc=AdqNRJcwWeN5VIzsXbFbZow2Z7GLI_DLLBp6m180XaCgJSPdpEaA3GREtiE43oi4w3U&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IroZLQADioDjA3mH5AayuCHbbvRz3VRyqyNjchwGStw&oe=6A1AD9E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbuSrWOza7oQ7kNvwGPoKcC&_nc_oc=AdrQ_n6XXbXEVQafTVTBQm-g9astDNKtQ-QFp4wY7U2LDHlV1G25xidvkPa0WugmXCA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ssBLt9f_BCOg0Mb8GBJiQc5VKvr7ZRleb0gbkMQEmbQ&oe=6A1AF032"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
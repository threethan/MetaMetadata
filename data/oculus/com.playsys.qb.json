94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAEUHedRts0Q7kNvwEBLToo&_nc_oc=Adpyf9sYvCIxiTsl3nlkf9J7AWf-28X9NDbe4UIeiM9mFsdl9DUHGmN9vgqvETZ0pjM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TPQwILzuVkIFm8J5VtsZvIqpN1S8lPZW977oJJTig6w&oe=69EDF285"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klNOV-OnyTQQ7kNvwEGLTDK&_nc_oc=AdpgSeMyMo-oZp_76jUYGmpbY7wnn4iGQ9acFy2nzm_SWgzixxGvipzdPxLqohM-nvg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gRKpDNb-s5DiDOSDuX4hYLc6fRNjpydzjMquqbHc8Og&oe=69EE0351"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwGz197peioQ7kNvwG70agq&_nc_oc=AdomcL1-_Kx_-ErVCivOqDmlKuzxot9dZIZYRJKMKp6GS3oFvxa3AhlF5OrRU85RacM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yTebkroGGH0zL0LI1WswfyRrne4BLmyXiSu_b7fDjog&oe=69EE2630"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mp7jB0tX5usQ7kNvwEwR3JU&_nc_oc=AdrA2zVItS1pxqVDfWus99RYW3vIhYHmbU0ShhRe2OFZY7uvKtf30QAuFH1e5KNhFT0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gdbyW7JHxJ6-F9X_qGX7z45HjLcGzG--Psg-tZW17rw&oe=69EE06E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leEqHa4IIyEQ7kNvwF3a_CQ&_nc_oc=Adr1FvcRzXYd9ccfAvRDU0qk4upM4r_RHI_gaK8oW32b19RvcEbcT6uBXm5qqtwr-KQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18UNxeLDo1uFLXs_8M5Wu-XKRhYExDsd-Prvo2ITs2KQ&oe=69EE1D32"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_sGc3onmWgQ7kNvwHMxGLa&_nc_oc=AdrA7Dh0auzCpe3mRtcw2BHmouxKdZgR8Y9MDCK7ioZY1YA0BHanSziOM9ECVp0PJfg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzrOCIa4Gk_zJ_SMDMkF5fqclJIyfpmqi-mVCpFIDn7Nw&oe=69C27105"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5rX4Xi455MQ7kNvwGUQMlj&_nc_oc=AdruXq0N514gWKUDmp8dka1OysCNXfcFX5bbhem2EYkQrJBXh2xe6bkWUKJq0IEixIc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6LwGNrk1qMT-ecp95SVk9lx422JvktF7n5GmjRYKDKw&oe=69C281D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGHwTj3r0LMQ7kNvwFY2biZ&_nc_oc=AdrUBLl863XqzrwWtpNbBkLTccni15VoxDhjRkh1VBlNInd2w7mGR3_IYY2wQEWbdp4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxT8Bp5EpHtTCvKPDnOUfmJCQ7yQFWzXoQJgJcgLBHIAQ&oe=69C26C70"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57ztNMeVPfYQ7kNvwGNH4Cr&_nc_oc=Adq0f_fWfIlwiVcKJeYAIb2iMZLQJrmpHL9iLk3PSww0071_ttlViWBJsx32SflTYes&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyAkvnc7IaLoTwxCdlLPVvit3L5_RM0WIo-vuRlr8_M6g&oe=69C28565"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLynNp0h3XYQ7kNvwFDJvou&_nc_oc=Adpm6fSEEm5sfQwsF74MEwhReWLdGzALDY0MnqSX9RM_L5cjU1ZduLB_dVNB3iPTPp0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyaTil9-UJLeAj35o7G3jXK9kuVXtS6gLEbl0jbpKfMcQ&oe=69C29BB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
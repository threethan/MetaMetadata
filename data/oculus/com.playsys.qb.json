94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJkvoN1M0NUQ7kNvwFEGRSu&_nc_oc=AdrFRQK7lFZ_tuH9orf3S-SGFDllmY2ype7-_QKNikPawoqup4SSvSoYdrDRkQg_oJA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwRfeZlcCWwdaMLYSYOGTfP_TFyBVkyE8dmZHxEqAdiCQ&oe=69C7B705"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1wP4x57XwAQ7kNvwGbN4A5&_nc_oc=AdrDvVaAmG8h3h6h4DyQo3Q2J-BU6o4YBql2OIdh_iZ6umDUfpJsxHj_3lsvFQ6LEFw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afye1i1g5nWNsplPS6trn2nc8fgy338700YT3MB6A76pQQ&oe=69C7C7D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rmhq9NwhVgQ7kNvwEWP1JO&_nc_oc=Adrzof4t3cA8JrdWo7ekJZFgZ9ftint1ns48RHGhdP_2Es4SJKD_qqgK2Rsvczh-Oik&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0MIod-1GsvhFuDAon-8o-ywrPIW2Pgb-18X2nIMPe1A&oe=69C7B270"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dFn6_XxOk4Q7kNvwH9mmAi&_nc_oc=AdqyatQosg8h0wnjPiaLee_bIZBHIOt_djzcU_iD0qCPc_jTMDStfb765pcuxmtmu94&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1QT4-r-9sFuh1blDAvBr91bpLruv-1uhQshaJQBZB6A&oe=69C7CB65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diTdarJH7fMQ7kNvwF0pMa5&_nc_oc=AdqlJRp7aUAt1DL0j3mP5bVFfk-N83PQU1ta82OaP-4xiqyuCuRXhUA34S83wPZvP3o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7WzGNYzXV7uzmTHW78UBnyUxTFVWaCKL2M_k7uY9fcA&oe=69C7E1B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
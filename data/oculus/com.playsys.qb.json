ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1TUT77iTWfQQ7kNvwEZFsTe&_nc_oc=Adq4GDVZ30k1z406bJ6KbGUiG0PxKSiH_UfJJLyCFsQCo6x2wBOgygYqjD5Am_V-uUE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBex5KIZs8p0Ymlw7aFsv8PmJ8gpHH90KDZbxgAuRDTA&oe=6A4A73C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXQFf9dqfxEQ7kNvwHmVSDf&_nc_oc=AdqY1YY5iqQsr-8uFes7yhBUQU84QkOEyjbyA6hy3oED4q2t08O4_cKdvOEz2j_jplQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSqlgNHEeLJMAks7XWSMuCcwYVNSbPaD6vgFdQsqH-mA&oe=6A4A8491"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AemD9vazWk8Q7kNvwEirBiv&_nc_oc=Adq75846CUmX47L4SNzYAM4rUxEGgXBVPMvd5yKh9X43b4MivXv_ErD6Zraoq3nfzk0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBC2eWpg7FYkv5tqM4kk1JUFHR-632HlPetofvrJBIeBg&oe=6A4A6F30"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=niIgRx-HBvIQ7kNvwEKRfQC&_nc_oc=AdrMlJioJ7lJRerkvZCV6tKKDo2qKk3A6AGM1-R1WePBQGIO0YVATRoFFlQcaVaRB70&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBP-Wi5OAOwoy0RcmfATpkNqS9bGsFtXgAvIgKjhhRF2A&oe=6A4A4FE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWjlq02a6XgQ7kNvwGbUhM3&_nc_oc=AdozBpMyz5HxQlbBrWjoTT4OE1SNfRTKKXItrh90XhWTEkw5Ermq3yDkwU7vA5fa4tk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9CkWJKwU6QPPYccirp1l1SqaQ6R2Vd31c-Ty3NTHD2g&oe=6A4A6632"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
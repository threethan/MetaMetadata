ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrIZ0LUWMC4Q7kNvwHjI2_b&_nc_oc=AdqVIjdCKLV-04ZmesIsC9uMRezxhGFCn72Iuyxe4TJN6ikbryLiFxN5zi-nSfIHr1k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNSx4U1l0LCkDmtU2iKOT-BIFqAqlgYvh933Axj3jfDg&oe=6AAD5445"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q42CufkY0XEQ7kNvwGzw1Ff&_nc_oc=AdqJF7dXMjRfGor_hq97XRJ3DSMWsqFxF0Jy3qzikR4FMlQrt-6yGv9mry1fzj4asnA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIetl2DfX_Z4rVjtaUSkDB6OD08ulzr7vVxVmIzPqc_Yg&oe=6AAD2CD1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHei0zw_zAAQ7kNvwEj-sqD&_nc_oc=AdosDGTwMXQBCoCw_lovLbgQpNf7NNGxtQOz3ip5aIBNCdraJYQEX_L9F3mu3-Mdo7E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhN81bo8gT69Y0FeHQO_UjaHEzbU4hmOZLh2pzv68Pyg&oe=6AAD4FB0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIAOuXjRxlQQ7kNvwF56erp&_nc_oc=AdrtY12pZly1DGeyDvzzUC5yO4wXfR5b2PZvCK6bKRgiAjCHoTSmhqNveGLRQ1RamX8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJm-wziZX05FpmVi7YzdmVRw2U1zJhjmpF4SboaH5qzxw&oe=6AAD3065"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1umCkQqwuYQ7kNvwHvgg4u&_nc_oc=AdoV5FvtldIdOXLBoFeN9bv5c43QATMfgHy_8xGica2sjO1ChB16mXHSV2jiehD5WYM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnkfmXoLL-d1WQ8R8Kd36WphCeeXabH_r0hxCzZSLE3Q&oe=6AAD46B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
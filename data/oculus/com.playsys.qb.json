94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCI5uT4kCr0Q7kNvwHDUnHT&_nc_oc=AdqZmpCYiLSthwXqdggSUMTiMNX-WPOGRoeNMlLC5XppvHphODJdXQjQzo3HGRWMneQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dswzMwkA6vYkMaTzLbyEwZhPBOssE0dVXZ3wd3Im0-Q&oe=69D27B45"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p78tauV3Mv0Q7kNvwFWHtwu&_nc_oc=AdoEOeAbIreuflcCWYNNrFR4hEmrj8-oQrX0y0s7WoyCc8J8PbmNQ08wfvdOuQ4QMJQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Zy5ER1cV9pKAGpBfR3V10HgmiF2PWd5cqrHpH26y0eQ&oe=69D253D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAfUeO5ot8MQ7kNvwEN_PF9&_nc_oc=AdrhBY8GuqH7DqDAOz0JD6ZO9u7DzIqqS5g-dPuGT3cu9KnZssOZuGRSM6X2Ml4gEYM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cxNcdbrD1B__v2_Q-pezQU2z3uE1KbmlXejFefN7dHA&oe=69D276B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guM4pqU5T7YQ7kNvwF4w6r2&_nc_oc=AdoJYWONmfEZPwpP_AguF9-8zVQN8KH_dWiEpO8LtKseML32BwqjTrOkvXJopWhZz-0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wKbPum4z9hgSNEmEjmcR3Axp9gS2W4wx9VXBIZN0C0w&oe=69D25765"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWmJe7XiOq0Q7kNvwEVizXf&_nc_oc=AdrtT859Y_uoVPJF2rX5wL-tUa0xMnCSMPzh1YwFT9WvxwXNryOmWxdVF_B2oGAPs0k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UWWQtBnwR-eSUFXk1HiqkYRAnm2i21DqZLPSiAPTvlA&oe=69D26DB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
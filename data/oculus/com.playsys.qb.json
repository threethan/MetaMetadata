ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpFQkvEbP_MQ7kNvwFjS85c&_nc_oc=AdoSLXcp0RCWfdwj82rITcSwaeEks7KnMDoxHfvKk33777-qBQJ2R_TPgA2fSI3ezDA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBncTXpnCTUCVzVQ1VeiO63ZGEyenlnolJ4O-8pDXaJJA&oe=6A53AE45"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjUrnTe0lAwQ7kNvwFq_9y5&_nc_oc=AdpiAuxNMCkX3eThJbHicxtn5BEK7lQefxAEvPw4DReo0HqYTRWA_4WmJAHyQuZop2g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBctNn5r1UUWA8FD3_U94pXTVZUKPQIEZY7WchBlGdzGg&oe=6A5386D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1a4QPZu6Kh4Q7kNvwH5hm6c&_nc_oc=Ado6amwrlp8OmO2wHhUidqeC2-QzfQZFlY0WrcAnAHsNcXrzVg_VyvR0Nqv5A7VhZwo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCd85pMx-XjRm4AStzN0nuT82775q8L_6nQbJCN149Bpg&oe=6A53A9B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evxRT8Ip8wEQ7kNvwEisPgq&_nc_oc=Adpt_THnQ4ZwADX9UYttkwdlVT26z_PnChBkP1vTa7vu1C7zbaezEnO_AzV-uywZW3U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD65fCTOZyvElu7Bbs4KYGSK9gqEqfHm6PT4BEk_JMJVQ&oe=6A538A65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRoX9jQ2owgQ7kNvwGhSxbk&_nc_oc=Adp3o1UcQN0J47bpFYZFkMgqcmerxVlFzqgPwJ0u55My7bQOGBFZliBg24UNEzji8FQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEzdIqaURw2BiNWgz1NMnW30jFXmjzgima50auLbQZIQ&oe=6A53A0B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
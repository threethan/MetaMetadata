ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FiqZ-yzYKWQQ7kNvwFLneM0&_nc_oc=AdqR3PNlQhnVe674pQa1JU5eziAB9KZFdfroPWmKGWRXDP0JSQpHVWNladumigTuCyM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgXuuQqn3shMUz8Y7a8jvgKPrnV0TMEHti_QyP6hP0ZA&oe=6A510B45"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8xRz-9gSTYQ7kNvwG0ox9y&_nc_oc=AdoJMpN_m1SfLLCK-KN75U5-xzF4_prIyQA3Vd47uur6C_QQhQO94QPYD58jHV_hJPA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBOYqlCe8xfP_48VsisHbzMGBT629fCYNAvKUVnQ_y7g&oe=6A50E3D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1a4QPZu6Kh4Q7kNvwH-rSMs&_nc_oc=AdqknqYWAE1ONC7pNn_dhU-Q5G7InV157BIgDdZ4wqxoDuIe5Kn7RjPp4bAJWSedGx4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOGit8z1fLJsREYS48pIaseVLQACxgQGhJN0uSNfPaZA&oe=6A5106B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vc-0uqGHRWIQ7kNvwHe68Hq&_nc_oc=AdpO3f_u0JgzG46qVrpfdsgVwvDiwiNAZCLRI6cst4xvvKKTiPE_VP5Z1JwTvYnQvGg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVj2Swi-gigw_W7weVcYLxqM2KxxCzJxEKnlaVKrYSSg&oe=6A50E765"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRoX9jQ2owgQ7kNvwGD9EtX&_nc_oc=AdoJA0ShI08Sq7sOAJPeonJ9ng14BIMtUJjcHNegB7TfOxU4bMvGKlc7rkRBYeXNg4c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjgqwDj5hyHjp4uBkhrt_suow74_AFcDlvc992y6yhCA&oe=6A50FDB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
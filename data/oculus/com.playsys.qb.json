ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAOAvkTPY7UQ7kNvwGSwDko&_nc_oc=AdraE_BoLpyYDBsaA3WJHdfRJtW4m3rOo0OSmv9pfVtczAj8PCM8p_3KHUyMu51wXAQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEfaOCCL0jPJOdRmGL5nkxi_9ieIY7PnkhWr2csl-6FA&oe=6AD23E45"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuIVikzqd-wQ7kNvwHDCGiF&_nc_oc=AdrrUm3NyaiJ-TN6O4SfvXIhrOKeohT5HQ5NbPZ9NFlKmbrYG62qocPl1l9NLpqmhEw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDO7Dc0ZLhsaWAG2LlyFPj5fFHO4X31NjaR1c-TtDImw&oe=6AD24F11"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIZYzpbnEtAQ7kNvwHDb2h8&_nc_oc=Adpdjb0cEv7YcfnsGWN0eBPPbD9o0Szm-AXT1fUJcGQPKSCojyeg48xtqGVUQ4JbSc0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbJEUZfv1O2M51W7yDZgvqycG-1hLKGRDCOHTdOHZoyw&oe=6AD239B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMNS_NEY-LkQ7kNvwHuMFiM&_nc_oc=AdoFN119Y3Md82vNeBI9n1BTK-A_0OGadCZltOJSNzYb_HPQJm2DMOrVl09OHCubeLo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTE1qwHmjvk9jFTFFNOSl8Mk40i0PHXFoE0GEIH2sSpg&oe=6AD252A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaVORHzFiJsQ7kNvwG6ft-G&_nc_oc=AdplPaugHl75NbK5WgqfCkcqq6xmnpmxOHS2hFfS5Qwr2yyk22z0hFxEdVVaKcDES1E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHjBzLQy8gl0soDStcb1Jl41sE8jK5d3_zKDShGGGH3w&oe=6AD230B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
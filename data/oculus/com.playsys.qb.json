94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyERjDL06MUQ7kNvwHD2ec5&_nc_oc=Adrlm4uImCWwPTNRomDBgbdT1cPglnrkv_l4Qk11Nu4IY6D5-YtG7Hr8e3omseHc29M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uH_EtU8B299qPMCV8FuG4bAHVE3UJfRe71kKV2Onw4w&oe=69DF7205"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cS73XJ4IKBwQ7kNvwHpb1PC&_nc_oc=AdrqkO1f9Z-kWLOTZSOF8Mo8uwPABtMaCbvEINKcRy9U0zrJ4ohBY0XjxLyAXBJKe-c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WqBqvkzM_QpQCRL0cXbxn-bLpPQoG7PAJkXxKeJrKPA&oe=69DF82D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-f4zHiq3cRkQ7kNvwHmNIjK&_nc_oc=Adq07FxGivM-8Wgqv_bI7301k-34rXYcvGexR13_iLHK6azfC3rskWChyEy7Dw0H-Sw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3004qQ1eA82D8-g8xmKfSUEnUc3BVdjoaEOunHTRBw7w&oe=69DFA5B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrPvwyrd4vIQ7kNvwHhMC4t&_nc_oc=AdqNByUvkfJnJzgCe3xnlXeT9GcPWEi4W5gLMyEoiTTNt4ZCXmu9UAU35IPd0dNI7IE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LMM8X8bB_j7XEoSNhbBw2lBObQ2qsHD5HOZx5v7fokA&oe=69DF8665"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Og6u9PfWsWsQ7kNvwGvXP9X&_nc_oc=AdpmVxECO7tVMwYTvYXxSUP8IZHWjscc4sar2jzZMWa_N7plJGhnsMzzCRx7-mXmhQI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-8626bKCFon-njCKB29OL01MCmkj0b3muf-VHp86VYQ&oe=69DF9CB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
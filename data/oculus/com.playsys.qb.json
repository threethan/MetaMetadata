ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-Zoo1xmqcAQ7kNvwHJw8Ue&_nc_oc=AdpAQuv9Ay2OT-RJ9-jQBiDsFh0TLi6vQBXTZOfsJ_DelYFrXAHz1yngNdem3q58lLc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOYjf1K7vTlKKzwHLwhV2Z7UXoW3CXmWdIL7JPTqCVIg&oe=6A883205"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6L5T57bP9gQ7kNvwG3GZJx&_nc_oc=AdqLP4ZWemUAySx9DIrbQDOwYQOoZTVOXPprrruFqzC3_7gMepqSKZLhcXl2zFDTsiU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLk81og67OcUcx_Et0OlQCzQVIpQuUxHZUmbh-4ySjAg&oe=6A8842D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcXYN76Yx0kQ7kNvwH0L2hp&_nc_oc=AdoYvP3JoGQnB7SUgEpB5n8F4OHgiRaQQ5z0CHxIeVRiW4s-aPpHg64-naBnVNuGPt4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNlwoyPXyqSizehcFGLE6s1XReJlhU0VxKZIrBOyBHIQ&oe=6A882D70"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irnxpBj9dKoQ7kNvwEv0lxQ&_nc_oc=AdpxpRCf_VBN43Ny_zDSOOFQkGYQWeW3t_Dq2BiVPACrUO_IlALT6ogaVZbcLHg1tJw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHo66wMPTtyIj8_h9iUfBsufbnTaOQ-_ux0k9R-9AdzHw&oe=6A884665"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOV7AFCXFP4Q7kNvwF-vcac&_nc_oc=AdouwaTJHAb2Gd73zbvKM7F7mbA8B9WKt7VMNL4CqGb4jknt8rJE__-4jnG8erAbjLU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMSNf_vDAuOoqwP4YpK9px4uTMBJR68xKtAfG6y2aMKw&oe=6A882472"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
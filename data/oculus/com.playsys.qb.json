ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLtkvn0S85AQ7kNvwGRyKkT&_nc_oc=AdrnwLhyIf7vVH5Nb2ilDj32ldKmLMSzlrn1Lt9YZXKA0ywkkjPTyOi3bJpCJq2jNRE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOpHB-ZOJ2niiIr-nShpIgIGsrDSd_-k6Qgu99tAu_-g&oe=6AE75645"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWRQtAWa89kQ7kNvwF4CQc5&_nc_oc=Adqt0M93Vu9w8C5wQr8TwhO6onnm3BVjytelTAi3Y72fsXsGhqRrz_oqvlh4zangnWY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQF2sholHGnqabGPIWjExggtEPCK90hZsasnY1JZmyK2Q&oe=6AE76711"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lmha_ZXq3QMQ7kNvwESIX8J&_nc_oc=Adomh2kU5BbIrbWn1lbMK3SeDroXwmZtYm4ED5Bz1YuA2qfNtaPFvd1l9U7RgRo556k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSn55nRRJs1iCwOvETaqJ7L9i5jkWpoq67hFUZg0AUOA&oe=6AE751B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzDx4ob2yAkQ7kNvwE51Hv1&_nc_oc=Adr52Pmsx_n8hi5rrqxGnRaevP1TKXoeUWOK_sdQGvujcUKlycoGjNBxfUNxnBJCp1k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHYsTtd8Nz64WlOo_PgCf7vIgskkuYca8dmQE4hhBQWQ&oe=6AE76AA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HV0XhShvaWQQ7kNvwHB8q_l&_nc_oc=AdoTKGuxfKY5DQ48AzDLwkFJxbTQv37Cq1nHGNYgC2tVnpK2YTjBiv__Ggy_LZrofsA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwewgVzyFelkzKIx0i71g_4V0jhxZmc1hq11YJ3utfbw&oe=6AE748B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
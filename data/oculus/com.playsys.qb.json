ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jj5AWcVF9qwQ7kNvwFfYn4s&_nc_oc=Adot6sgtXo5xwQdCVeSUogf9ia2ZuyiH8p8VZMDLe2ECFIJdVPJRspx5tGWjCMbR3Ms&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3UHvlppv3Z0zGxfRwqoHk6LfD05J7_xchpIL6tV3CaA&oe=6A4E6845"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8xRz-9gSTYQ7kNvwGu-qhh&_nc_oc=Ado6T9Z95xy07KyITjn1wh6jLvXGQBkZVjbn7PU0RrokbaYBoKTP8hlkb4rSt3AiTIg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMmqNW7hVAzoZmtmdjbDDPsIoGiFQK4M4Tj50BffFU5w&oe=6A4E40D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7OWWz25uawQ7kNvwHYf6VJ&_nc_oc=Adrij7WkFwEg3iI9BmtPJRjMQ6Kfu6dY2binmIrTIpjbMjxorOh-n79uE111VQhsBU4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoaQvXP7jwQoiIC-IBR8yR-CijMhdnch41Ersf0MYVLg&oe=6A4E63B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwYwsbtUGHcQ7kNvwFLc2k1&_nc_oc=AdpI3a1xiUSw6QqTSqUqq0DqGHhr0lRk2zFgjGtyKf0ahUKHyEZyH-dfLyM32z3vtPQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBPaMp-n3B3-hq_liVJPfI043tthMBZQM84ZPoeMhJaQ&oe=6A4E4465"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlBuGwnFuhMQ7kNvwHdRlS6&_nc_oc=Ador6HVXP6V4RfLOgvEutHvBtrwy2TY3Jto1Rlza1vpiOm4RnXJ_5QbH6glJknl_7qs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8l0zcA83Q2Zhz-pBUcyDEEytokG3VZ8l5y5CYCioCyQ&oe=6A4E5AB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QH5oin73k7YQ7kNvwFOMm75&_nc_oc=Adp7TzEhmdHwE5whpahH2uz_C5bv297DgsxFA2uny8504XGhVcbE9UjRqgBq4yHSzQI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrV9eneIBhsS4wVOdFT-lHkK2n36obGi61Ti6ILWVZwA&oe=6AA56B45"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxoigu3Kj5UQ7kNvwE3j0Rm&_nc_oc=Adpx5o2u3OC_sHZqwhvOejQ3tvTptUrOme-GvxBDpM3Tkou2h-2PbRYp66oGKbYaWlc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkhqc0yGGPsJA_M5dMi_ELTMYS6OqANs82gP07hPasww&oe=6AA543D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpJEZ2XnU94Q7kNvwGxwZrb&_nc_oc=Adp0cZ7ZYLlI0grxpaFPFz9qlZJuDRmQV2A91TjBx5tZHW7U4HgwziQJVQkF2UQ7qmg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqHHqDVvoU2h_Vl5anOclIasw3FZFpn4kvfiaRIGL9tg&oe=6AA566B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpPmMIZwGmQQ7kNvwHE32jU&_nc_oc=AdoBAROxDl_jExo1014iY0idXEXSgyROs6XZkjEJJ4hp1HRllClIkvCQJI-Fkdo9Dss&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLzLtTFRzpmft4diQUJ5IY_l4gCKr5DIlpj_b8wbMRnw&oe=6AA54765"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBKGCkmWMD4Q7kNvwElGZrn&_nc_oc=Adq6w90twlXpiLNY3RtqROIZ7xTU0ishEwODeQsFF2Fm0Ur45a01Tvnpz05rEdCSXvg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4dYuzVPZaY9mMr12vUDgGIupNju4hXY5msVhYKuabJA&oe=6AA55DB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGHIhQkEnLsQ7kNvwFbk1sM&_nc_oc=AdotEORI0-YyhR4w5tOPhcv5vGgmAOyPktKWWFO-RHPporqrhzGbEjtA6PMaZ2_Vt5o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eUOdhQuoYp9JoKccHqBjWzcs5US5kqOAxueCkD5PnNg&oe=6A049445"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5VoCsXw2_oQ7kNvwHCJONK&_nc_oc=AdqUQnx6TW6C-oCSNvruv-yp-cptMWomF9V-R5UqdfPnZzTE2gsjIYTT9en3GDvsaWM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wJcY2ul60p-Abc37s79334a_armQSTRlxYFRRwXGFMA&oe=6A046CD1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azhleXC1yg0Q7kNvwGCBmWT&_nc_oc=Adp8hL9CIyHcPQLI1DELI56QPt7DyC57mhuMDEvY4FM3epUvYCZkt909SopLEQat-2Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4I9EWZD0qDFkIAXylJpTJLitM6V5BMG9cm9DFtn-chtg&oe=6A048FB0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNqVCq3D9K8Q7kNvwGyb-0r&_nc_oc=AdrgsqaeP8IVDwEwu7BM-X1e1HUOMGRrMgstSKxFGU9Zv6mKpbpXsY-u3lJ2j_80hDE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KKe6dVdHxfdX7ots8IMfr8hPFzlhgLXUt7EgitvjdIw&oe=6A047065"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtoUvKbDJ18Q7kNvwGRLS6L&_nc_oc=AdrPqAOgjQ_Bf7S7nwARCujd0BrEjHlVHCMYD2yFxl2Br6fzVq8HDXBOq6dEH0yhrPQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XH6ERBoesJIYQ3ShMHVV6UwOp90XUmBy4uavEm91FlQ&oe=6A0486B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
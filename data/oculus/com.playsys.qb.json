-7&_nc_sid=6e7a0a&_nc_ohc=SHroKcXf3I8Q7kNvwHt1_qp&_nc_oc=AdmSLWXyW6UjmF1QGSBiavyIICv08KgeCcNgp63sFQTCj_gxYRNdvp1vsxcmmDesZ7c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afsk2bwGsnPtJ2pKK3Q9CpEgiRZcl_i-HOGAeamlOS_LXQ&oe=69A81305"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fh3arPqTN-IQ7kNvwEkR9Qr&_nc_oc=AdlwaBtTwIh1_XEMURtL-1QTJNxButNoZC7IAVhZZ2WPcAmydSEyUVc8C_h1bXXfyEA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftLJv5f3q96axAnfb2fPhPMH6P-krtLS0yERRYRmUsveA&oe=69A823D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oia-Tw86paEQ7kNvwEaeHyc&_nc_oc=AdknkYHgBJiMGyU4NN4GU8wES36IIItD4DdTg2gpsWrMmklrzRnyQR8CZIr7DGP0UB4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvB-f1Q0NO59S0JaEshP2bVlqfZ9uEvlzThdQ5z0umUxw&oe=69A80E70"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yo62Ov-YGPIQ7kNvwH-29VT&_nc_oc=AdkXH_y7FeGTcwkfTyxwc95wLNxjs7jlH91BWJl_bU4GHmq5S71ZB7aUkYVxCDDQt5g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv6lkR6i-g1yCmKplZXRWb-s7-V0uA4RDn-4_4mLSvVHQ&oe=69A82765"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dT4OoFVmIDAQ7kNvwGkVLeB&_nc_oc=AdlsW-j6SBRd_pGRLC5d0E8CZoDbChTBXHu5Amya7CWRnrSdRdLV56w2lNUYjV4l_ZQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuEJYlPB0rIXQBFRzpt5jxhLrQiiFhhsesygUKD4TJIPw&oe=69A83DB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics
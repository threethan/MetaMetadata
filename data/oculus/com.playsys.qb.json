ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHCee4extLQQ7kNvwEBVHqD&_nc_oc=AdqtqQpR1ohsfwpAKjTPNkn0Gk9O5-kp4t2scj_kpVrKPDhXGkxI7yCEXWnVugaomDw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEH5aY-GuxHPyni0SX1X7LUykCXtS1nkXz9Ez_noyU2RQ&oe=6A79B185"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8MNbifAnIYQ7kNvwH00ssY&_nc_oc=AdrPvv_zjOKAEcnz-00tVy0F3ALFPq-uIdB-qWuI5eaQjsRB7pvuSrBWsiIEWBS4C8E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwnd9VKA9FzMj-KLBvDKshWzYriKghza9ZGkIQkmVSgg&oe=6A79C251"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiC8nrx32IoQ7kNvwFmG9Tu&_nc_oc=AdojXMDu9HQ0lZCWiyo3A_IGBiJ0sVTNU7O_h5JdSTlCrEyLAAK4kSVNvo5Y2K1AaIo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnZh-HuI-L0aJkR_iYNg4PWTiSZr2k5jYd9HYMctGhHg&oe=6A79E530"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1bIfgEYYCQQ7kNvwHl36Vg&_nc_oc=AdpM2r6TVqS7NgifF5nO7AxkSfgcjYJKeTJCA2RO9ThWIXYvKpVKFAi8Uw53zQsKE1g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJk3pnGehanj2r3HiD9fphDrY8D1xKSi3_KZHEaktHzg&oe=6A79C5E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6J7XL3D9JQQ7kNvwF_ty0b&_nc_oc=AdprCJadBCEVT-2rHm_LIiZy0Fa61OPT8V_gvUKY94G63decUhOxxzIgdmR944hnN3A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-vdH3qTrbTizM-Ce9uWd-TeA-QvY36Ric5OFulJShHQ&oe=6A79DC32"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7F9Ft1lQDAQ7kNvwEebfG0&_nc_oc=AdpMutpoclkTU8h_7X7BEBH5l_y4-URGc_fCCR4gWIq4umGNb7kzsg7ObbDvtXGRvDo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpd1x4lgthfu3ULdTeXABhfxObQMp_CB1RTYjSss9HFA&oe=6A940F85"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jC4fHsmk6aAQ7kNvwHdeOlV&_nc_oc=AdqlpGixcTGHek4AisgulocZF953ZXro-uXXXAF0uyFxQhK9o0SFLP1Ey4VmiPDqCRs&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgf2M6kFEJ_5WVEpIMjJNDicgg2VKqtEi6P7l4JXfASQ&oe=6A942051"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Ep9O-MXcxoQ7kNvwFVDU3j&_nc_oc=AdrGoiglbBczdMqU2dOpqjFEGz9S0XReBcVuVSQNgMFRDkazz7Ry3-xuj3oNr4j6kd8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcXXA-TBWttRLhomV6UDXqC2-vArTpa04y-rN6kSbEMw&oe=6A940AF0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3usCCZPQxoQ7kNvwE8rhv9&_nc_oc=AdoY-GHd9oZ-sGkVwxhqZyUYVrK_3JDPeVhxA3BV_ZYUgKJbTRRSjMAXNU5kDRonD8M&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRwI9sUL9fgKu3XoNzWZXHU0heUdN_D4nX8tcG7AXZwA&oe=6A9423E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=895inmNxusUQ7kNvwHvZAyO&_nc_oc=AdpHSpxIU34iDBLI8jNGB3nOWSN074RRfNIJW3t5j50pElVqYdn5HstIClA2ACzF5ks&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0ntvatlUA7fcjsngkaFteTpN2NaOvjnpGPsxAVOnbSQ&oe=6A9401F2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
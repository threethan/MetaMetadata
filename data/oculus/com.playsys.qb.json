ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Agf8XISeEMwQ7kNvwGLxKY4&_nc_oc=Adr06APxjM_vVUxrpO5QbT6JqHQU0h_ALeq9sKy1FCQAESsnbOgOJac4PAYnWWs8iQM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8xhsIO9VpHD4wG4YVmhHEIRisNeBEBODEZwOkwmTNyw&oe=6A5A45C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsyJqLh8vQkQ7kNvwEGf6Br&_nc_oc=AdoUfzyriCeCumGf40musdw5Ec-fZMqFobQ8VSDO9x-8RQyxqxDxXl8FByauA42sbFg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGTa3HEkkaKuHYW13iqYXIMaJQmwvXChvtKV6KGaY8gA&oe=6A5A1E51"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKeIT54rSzkQ7kNvwFjmu0V&_nc_oc=AdrRtm5Jbd0b-JXFlKo2SQ6SdlbhmpVZb9M6z4entcVCM3k709noNZm-xe0iXq3iKQg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArpJLCdcIGnp_j3EZekGZZKId1w3-t4Es8CnYC201vHw&oe=6A5A4130"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9ZAb0yi9xsQ7kNvwGP-LrJ&_nc_oc=AdqEL3W_QxxoZororXp_FhxObHttP8f-WM4rkQ0tj30-GTcu2H37kQhDl2gttLchBwc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgliGiLlSi8AHziPdvtNUdL-6lljKFzaoZKJ80WeL9Yg&oe=6A5A21E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpL3_N9kHnsQ7kNvwGPRAKA&_nc_oc=AdrfrzmpzopDDLHX_8Fkgby7FvhAheB0YRfTsOFlgJ8q_NN62g_Cuv2vX8J0ys4kM-g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApEXe4yNgHcXjI_PWnX0R2HLyXU0qQ007aSaKxwrAiEg&oe=6A5A3832"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
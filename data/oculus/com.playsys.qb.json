94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=px_xWqskdNIQ7kNvwEnDadZ&_nc_oc=AdrmaFlvZQ9dPg_oNPTQBKKCaxNYq8narJHJ2XKVZuzHvb2ee8dzNjcSzVqK6Xof3VM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0kHHkPT3DjcchXEfUIbITQqpbCXs1eh2ZO8AEU0SwH-Q&oe=69F370C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3L0U3Z9PGYEQ7kNvwGeGB2i&_nc_oc=AdoAuHmpGToYDXWf4zqi3JRqgwWfLppNSauTMXQCmhwNHy3_Dh1JlQkpe0U-phd1Xy4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1_je7rawzzGIoZgQ6rifEyvvguspmD59FYcFNZuODOmQ&oe=69F34951"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXayozwSC3cQ7kNvwE9XScm&_nc_oc=AdrplPdd4CxMZj77wtrNWIV_WzLECZbqhzv9iSC9CyDuDAe6Np2dQSLG3Qr78jmzVqM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0YMZJv9u6aaYSjZnXj0UGlOVBwV3fyPyobJ40I0TlNcQ&oe=69F36C30"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMqZKN4nxdUQ7kNvwHQmdk7&_nc_oc=AdqxjOYgFzkd05QN7aqb2Pmzh1aZP68JWIJQ5SbF3niIvKr_2NNBR73ixUGO2SEMKJg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3orvec73iMzKykDrEwGWcyYL1MLrbt6Vmu5Gsd4PvkBg&oe=69F34CE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=boSoHS1_qD8Q7kNvwHgcX1c&_nc_oc=AdpmnDgqUTafjE_6PRe8CorWd2uYWz1qdfIjmzMf-lw4w2FTXRa_wbTPObGKulrEFaY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3W3vlG-kPdBRZyfEmkRWF9_iyJPnFCA1-mDs9ef3iZMQ&oe=69F36332"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
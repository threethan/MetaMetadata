94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhU1zZHAQRQQ7kNvwHLg77e&_nc_oc=Adr89H6VFvW3EbKy8eJOXxvAKCDIahBsn9I3z3cp7hHF2kR94zC9uE4WCKoGhAIy_FQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14_mVhIGSaVAktz3Os-61j_ox3THBN-EBpYkJg8yuPpg&oe=69D78905"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LkZD3rS5LsQ7kNvwFCvxEl&_nc_oc=AdrS0SD2v3gNltDmayLZtBiqQ_epciqePcFggR-_aHw4GHi4johNJbXL7MJdnFXQFqw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25aP4FEB-aBynpSJW7ag9m42ABJFZHyPx_UtdHidGSNQ&oe=69D799D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nf3-CAml_N4Q7kNvwFKzEKM&_nc_oc=Adolwd-_mfMYKkswHW3bW7Ga1FBSQDNaJ_LDvk0PEbNPo27MtgJKmu87RqmLCBRUX6c&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HLR5GgCe4kCLkKyxYKtocdoKdQJOJRyJa9JC_fOhtqg&oe=69D7BCB0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPPRfDMemnIQ7kNvwGoeSrY&_nc_oc=AdqwBc3GXNqGqxmnMOEXY360QkuhVzjX3CCFIIYhw6mBARBxCKMsPD2GF1ODrkUNxZE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12VI7Q7l6nnSP4P2jSKUiNauddQ5fGcFlaLaJbA6Rc4A&oe=69D79D65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_dLHHhJ2R0Q7kNvwHoNpJL&_nc_oc=AdokoVV_KjRRSw4sf1KLs7sGzb7PbaTBP0R0KGSzUnWbJLkfCGGaE8oNq4azY3Gr8mg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Xf5BarIKt5A5Ic_cYNkDpMMzyJrUS1NGvP9SDOkWgIA&oe=69D7B3B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKSpuuXXqvAQ7kNvwHWaAs6&_nc_oc=Ado5VeSCBXqu-3v4HTrWnETFVoV9M1P1ITHqFZsd3m_lGWB_CjUN3mnZog9z2jZ1PC0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7lK0tvtdfSjzG0sO6Fw4V5FIdF6G0_5I6tTfI9sCbAA&oe=6ADE1BC5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9XEbZr3jasQ7kNvwEVtMrh&_nc_oc=AdrQiMTW6r-yYyagSs5BKSRTCw49vj55enj0VDNlxBn11wIumLXBLTo1klRtWnLXeZ4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2t52SsDCkg0WGaKTBIMbySlY8Xs1PeIL0PWSRRGw2fQ&oe=6ADDF451"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5F41EEbjUQQ7kNvwFPivJF&_nc_oc=AdpZwzLWKeyPOpKzv_mJ83ZwregoEfa6iwRR5ai0V5_9EEZBNPZLMloAPXwbdEKoiPc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAy7N-IjQQKjLYuGKE26t3W6ZH_B-BlOLM0hsPc7AFNw&oe=6ADE1730"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQ0lJhe6BkcQ7kNvwFnS47V&_nc_oc=AdqxxbfnqcA6Iv4d1bFXccpBR6ElmU-MJXJARRcIChV0GdUgc7Jy8p2xlq7eYI6dadE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMy8GlVIH68gPQY3h6aWT-wPax6AFGb0G_AT21oPJk5nQ&oe=6ADDF7E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLOZ2LJmlf8Q7kNvwEffVQO&_nc_oc=AdpRkdwFE-sJyJhikBFArYLl7HaDLcXDDRuXaTrAajBlZjVPT9JSUkzgVLft-55mVj0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjPLuQ5QEWIyKmDJAX36f3VahViKz2RYpjtJp6JjJ2xg&oe=6ADE0E32"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
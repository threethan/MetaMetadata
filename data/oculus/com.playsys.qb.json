ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=522xopGLuqYQ7kNvwGZWYB4&_nc_oc=Adrve22sBj_eZeEPkS3nHAvTmcsQYI8PIRiX_r1pFpZ3g1HmNETjhYPo4jBsNZxtTRU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MsAaaQELTnLnktmJYM9cEfimTgA4l0IYqgkBomElNag&oe=6A32B8C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Eg9nx5dpe0Q7kNvwFz_h2S&_nc_oc=AdqKbrdmoQQUA20u-l_1c3Gro_Gc2yZOxA2QgOfCiIiHoDzdHk4_Ehz6RW7mNRVQQWw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kRvjQh5AhNoH1fmJTlEB9ACSrEZTZ6fkZI5pqYNYSAw&oe=6A329151"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seKRE4Yin0EQ7kNvwE4ZIe5&_nc_oc=AdrFUlRYgWeYnzGZoIwQ0wB72tWw7Di4zyy8rR4JfQbMgJk8yqT3hTiGIw7OTK2nqxY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GmNUsEWidevSQbS7mb_IYKrYZm9m5ThB6c8H1mLxbLQ&oe=6A32B430"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSFTEbcUFHEQ7kNvwG-kMhE&_nc_oc=AdobI59PgFqf80zQB-AKXi50t1hWWwoWYrj06RaDa3dPqQqjhQyLhmGn5A-3_1cFoOY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Lny8v1pq5oYZGMe9NX0RSvSb88X2HP0lW9MCt_ZBwZA&oe=6A3294E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ij0Li1Xp4XIQ7kNvwFMQTZ2&_nc_oc=AdqTDvnen92lzjLqJPSBEU_yfXp2Jet_ErV0SGRKyb9stpCypZ-3gGZ7croDzwyjjck&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_w7BDZJEnawsM3AuYNL4w46B-7QB29aYY1jpk0qT4kmA&oe=6A32AB32"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
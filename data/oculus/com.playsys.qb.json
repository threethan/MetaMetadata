ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w55eQc00Jh4Q7kNvwHRYMoA&_nc_oc=Ado3auuB0yThW3NojWvln4mQKOXK4xWl0DmczsIqBAgqLQz6o7IT35TNPs_m-i6-hgE&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-F3YbX7LJHx_xGNJGkrC_4uMOuk20RJSRFJeDqaikiw&oe=6A916C85"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jC4fHsmk6aAQ7kNvwHMNTZB&_nc_oc=Adpx_JpKQJifppz2vvsxydWtlJI0gFNaqQMi5Nv0XmBseTf6K9QGWyhUQZq8f_KEx0w&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKFA_dET_6cbDKCL26Z432kHsTWM9F1AP6j6eDe8iIAQ&oe=6A917D51"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VQiUnBWakoQ7kNvwGQe94s&_nc_oc=AdpCGbAEhRtF7gPj2GGaxfIpe-VobU0mVzSOnxoEt2DtfViJn3H1w6svvExm5kpUU64&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKUxa3vcQaDpgUlwsUIYx09NkpwGt7fgV0Vswvtx0cMQ&oe=6A9167F0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dN7WLBqPJ70Q7kNvwHV96A3&_nc_oc=AdqDvh7QspnHS-Gizm9aU_Uol0SuFcK6vFnc_1y4s-hhedWJ-Jf5XIQnkl_7Dl0HZIU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHv3kCIR4JnZBh6LuWCTNAP0lbIczHgn7pIweDSnEl90w&oe=6A9180E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRWERnwN8zwQ7kNvwE6Uukq&_nc_oc=AdqayOs8pm-6W5ykIWm3AfrGDogusiCGyCfXCWRjbFBxf01dWGIAQMJyj149N5bOO00&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQ1_LckSc7PG6QQoHTMj5HfJw3zDXtCJJ01h_Yy0-VWg&oe=6A915EF2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
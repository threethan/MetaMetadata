94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASSMlzmY1TAQ7kNvwHDDJCC&_nc_oc=Adq8QvY9osSXpv_Idnxpu_biPL4FAtSlcwqSu-aehcUFCGlKuT7BL-jU2ZVl8Rhan94&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6z_82lMceyDI80Ppv3odZzEyH8QS9ZZjeh0nXa_OtLsQ&oe=6A0B2BC5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OcEt9gKyooQ7kNvwHOMOFI&_nc_oc=AdrfCO8Ra69E0fPiQW0ArIxOXfCqnghgWWxpROcwRhrj5hwd1KdNAJpEy5EO2lEcaYs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57N6SdWIfCMwtmPfVZz-L8dSntndLUC9JYTSDSQWlVIw&oe=6A0B0451"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8mFN47-AL6EQ7kNvwHuyUmM&_nc_oc=Adpn0YNy3LPQ5Zkd7qTgdiLJyXXtOMg3N_-566EE2521RKcRPVVFdKPVh8e9OgsSYWY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AHS3Z5mCCg546gSb9v6Xk2zleQfU4EhIU44UbBD6Q4g&oe=6A0B2730"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5P4wx6Hn5XkQ7kNvwGyCkkz&_nc_oc=Adq7c4or31HrYZ5zc7Q844t1-azPOBIWNASszN3_2sn4wpDWqcVW2qS1IUHXyhY0zUA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Fe7h1VO6jv-2LKFqQ6Xy_ENJkQhBNQbbMvsZle2UTQg&oe=6A0B07E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDnNx0RO0TwQ7kNvwHlRQWE&_nc_oc=AdpcZnlEf_yfMro-kCt8PVlVEnOGeXUQyL_0xc6PhPXVTa9lI9uSUxG0D6Ki5gn6CDw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Pf_9SByFea63jysLCpjcX2atLF2JWFTZgb1Wrdju4Jw&oe=6A0B1E32"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
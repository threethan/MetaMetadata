ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32Fwg7YUd_kQ7kNvwEJWxOZ&_nc_oc=AdpyxGK6_HVSCivIRBlM5ibakyLzN_ufO6BGK5jp_X-lLinAmavin0-0g8Gcwqx06EY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSgYezTEz3rVO-9AjpPNkXLyBRQyZdQQTAtQg5fOshgg&oe=6ACBA6C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fg28Ac5-SgsQ7kNvwE-6tTA&_nc_oc=Ado5iIxa7JCzvgqr284vEfmjMcHQICfqnnF2j88BsqtVf3PYv5Dwl64btvxuHzdvj2Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmKkEZRMkFIyPuGgprx2UoFsiXq9rJ-HxoshdKaqwOXg&oe=6ACBB791"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fi4za20UguAQ7kNvwECNHXJ&_nc_oc=AdrqmC57f3_Hq64NDJ0hohH3wUkwMLnq6ElzhWIdUOXKYeOg2ZG2S1akF1u5Tsr7b8w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0l7uuobwDZTTGBGXIKv9orFQSaqNaSWyHXc0HpGHg0Q&oe=6ACBA230"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8nPKAnxtwsQ7kNvwHLdE1H&_nc_oc=Adq9f5XLgQkpcUdz4A1kXBsyOZhAJBsybNZGIT0YDBqDrYOkQrLUNKCk-x-4v0hB1lQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNldYpGquUXYuUhrVskvXrwpvwXSobEHYcSSesZ_uXqTw&oe=6ACBBB25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTNZJOOjaWcQ7kNvwFAxBz4&_nc_oc=Adpn-ctbJ6cVYKB6mlODnSJuzKXw3-VItdmgmEPRusxxe5hZhelXH3Xw9dprsfQciZo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-6lUZGHjuoJPt68PmTIsX5GuY7LNLTnr6VZKbd_f-UQ&oe=6ACB9932"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6huZqty9NJsQ7kNvwGnpc07&_nc_oc=AdqiiEBMQ3EyYJvMH1E0JGfD3vF3z09L9wXA9KwopXf0L0HTwL6aC-xuoUKCXGY7uok&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoDFj2WhAN9m28bPJLIoYNQVacyzJrzoGGMI01NJjr9Q&oe=6AC26C45"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FN4ZB_7TM8Q7kNvwHvxPv-&_nc_oc=AdrqjRi4vFZ-5eS5h8smcSN_OV9uhUUtDkjJP7-x8UypsvqxAcCnVByMIk6gFi7S9F8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdE5166yNI_Yim03IOsSdADt9yTM1NWFAumQJclPeiww&oe=6AC27D11"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5hnuwgP5WMQ7kNvwGVMd7J&_nc_oc=AdrMK3pNErNnf6nSD5LlAMkglbdXRTUbsnBp-bXnn2JtYBsQvWgETwVvyTB7rfazlQY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP25Am9bq2ikd1QvMLoBLvwrFRDqdxxtI-JaFQx9hBj0Q&oe=6AC267B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2k2i0Dcxv4kQ7kNvwG1Q5rg&_nc_oc=Adpy77_uO1g5xiF1reUyC91gCLiKrsU8kHSdzE54rTwV1nGqYcwfM65MzfPBDUSKb1Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlTG0hnRImYKFQ_qJJddc8O0jV6aZPN8kFVfjfy227eg&oe=6AC280A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMY6tRk2J_EQ7kNvwF3uA5k&_nc_oc=AdpuQU3SgODW2UHTcMfwHjCzM5GhsW2sfFCHV7pAUY4Q9gH6qCFdHzPdvSA5SYSiyJ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPm9_fqm2c8jHzIqyEZGtWDWlDwbY8NZ4ehZcmvPDumaA&oe=6AC25EB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
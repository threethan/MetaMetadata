ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OQloCb5lGsQ7kNvwFVyW-f&_nc_oc=AdrJuro7cIGqZE38t4XxfOk7Vk6kHLISB1cZX-KZq4FEWHnVPQzYffhY0YLzErlo-AQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUmMbMY0FpUIV4T57qCyN36dXUUSGBNGavHMRPDDx2uQ&oe=6AA80E45"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxoigu3Kj5UQ7kNvwE2Rk3U&_nc_oc=Ado7eG47j71W5PsvlhlHwI83MWuHNBLoq5yGLpKBhD3n1J2fx3CKRLwD1y0hLn9pCtE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYlU7iPdcSm0rY0Otfzz7sEX1juAM1iUa9qq5kVwTQHg&oe=6AA7E6D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQhSWY-ujPgQ7kNvwHd-i5R&_nc_oc=AdrGguX-SCbl0s_XhrhCoh4L2zvC9oJBrKa1v1IVSLAHpWWfeo4PbvibYteVy-KKcHM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbaCrkqepsusbzd6c_bVWEvjcQZcUBT8wEpbh_NAoX6Q&oe=6AA809B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzIFC0dPpKoQ7kNvwF0Tg3f&_nc_oc=AdptN8SwEFBm8mkALXYKqLMGH72i6lsCrhU2BEXMjn02kbDNGg52eMCronrAy1YfrAM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEQA1suhrJ9J2KCVk-IgdmIK7Pm2HajdpF86rTfyXX_A&oe=6AA7EA65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B19lBRfnoT4Q7kNvwGFar4a&_nc_oc=Adp6oZh9iU7ppM85F5IaU2FmbAAbXYLajmmYZSuFWhEGq6bITLjHld1JFKJdNSVOuOI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVSQx0UjpBuRSILeo6filSnJk3YE4EKUeP_arOkNosLQ&oe=6AA800B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
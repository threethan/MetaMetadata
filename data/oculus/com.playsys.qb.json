ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpFQkvEbP_MQ7kNvwH-q00_&_nc_oc=AdopqCZxjVBPI18si1pGQNbtFjIlAIJyM5mwBCAnznLm3Y6WBuz3veEDsVwm5GaDsbk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDki58WAssBIyi4Qrse9oDiHaGfg79pskfFSPSG_R-n7A&oe=6A54FFC5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjUrnTe0lAwQ7kNvwHoU0Mm&_nc_oc=AdqOUz496-96dHNjSEZuAnMrf_yQxQDYhzXlg0dehw7LE6RVxCTfT4pnSW1zE6xKnQE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjH_L1BEaXYZeHmC90zR3_F-3DieCmb3i4nWBQ--HL2Q&oe=6A54D851"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwdn19X3CkAQ7kNvwEh1mCp&_nc_oc=AdpzJe0ETJLzULH5KncoN5clD2eyRXnBsTApALsvNA-mveY7pQyUOMwXTLJ97LDDg9c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKbMEL5jXFhtA18YJYBuMSpVM1udF39IUx8OlqVeJx4g&oe=6A54FB30"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evxRT8Ip8wEQ7kNvwHI9an7&_nc_oc=AdrUaNxdo2ONRvOe4iIBE5bYu888HethAaI516KD6ZLAPr0Sbexmtg4UNZKUrVXflQo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrKj-A1-tiWp-_zvgc4loV4VWUqfPUq9pHwpvDVIMV4A&oe=6A54DBE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-M-EiTo2b4Q7kNvwEG890V&_nc_oc=AdrUhjv7oA62UC3BKLnVR_rGAvpdAyf8q68QdDlbNdA7DqOBV4EN4lHsF3EnL0Qwcek&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClIDlhjGGZfacqqrS2deKd1m59swVFnGIsozgtppU2Jw&oe=6A54F232"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lF-uUfGm4FAQ7kNvwGVBEJX&_nc_oc=AdpMW6ULie2Fx_VKoDIHAzzN-ZZeaNi1wX5jd3g1zaUdHA5VnvLeSMKduvGKLAD1KVM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7coRp5wcJCJMo68wa83kMSzziuN04HnuUSRvlwf5j8A&oe=6A74A3C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsYUjjm_KkIQ7kNvwENQu6F&_nc_oc=Adryi6eYzqcqU59keUm17fmPiWT9fpkv82ESA_iHbfgoz51Wmyua-yx1-i5QeY9OaU8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYtvU-GMpLmYM_Ic8PyIbT8A2lEokWNHpuVs_YSyZ4kw&oe=6A747C51"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBAly9cAGq4Q7kNvwHxNvMm&_nc_oc=AdrzEIC_g8pPQAxwqdU94ONVjQX34jKtQbKFBjt2WXi5Tj2SPS9qyof7hnScGhrgsPU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjjMvPXgEXej0GZ4Ctdv9SCzwc_hKgIDgO3EyRf5c1hQ&oe=6A749F30"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4d9DiA-2X4Q7kNvwFp35Hs&_nc_oc=AdrvR4aZbUFh18uVmUuxRoHyZAnVVUUyRfPHgZ_v9S5-pxZ91n90UvuKCJwcGL_pjTE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzYP4llDgshdcAr9fS7vbrCzhwbJaOTgFb2EtgR6T5HA&oe=6A747FE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZkHl7i1OFkQ7kNvwGXXTgb&_nc_oc=AdqvXmMHTFFJkvHVGt2wANfR_5SQLm21segjs1mk1EOf5U0SgMz79KhgTpjl95rg4fY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrUaJA-eiEEp_XRojhrinDgOqC-ArvAuFnPxNNuuNvyA&oe=6A749632"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
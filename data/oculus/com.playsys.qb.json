ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7F9Ft1lQDAQ7kNvwEf9owx&_nc_oc=AdryT41kWzHVSJtkNk9U4rwUQ7TlLoq9HIDJX9p_pihDG9IEUMNqmAsmmqpw88APGLs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJlqtcUuZujwJWvAkTWOdRKEbguA76mswK0jMFzZI75g&oe=6A95D185"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKxcFdMvJfQQ7kNvwG-_Jdd&_nc_oc=Adoe4_jB8FEGqnzz-jaufChU22Pjt0rDzWg-sTyIH6iGy6AaziS0_PT7zag-cTk54f4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRgae9p0LPTGEooqt-ihQEgvHWHqMlza6uOskIfPda4Q&oe=6A95E251"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Ep9O-MXcxoQ7kNvwHHDtls&_nc_oc=AdprNcDRA08IeV00ZGCKk09PO47WQmm-UUMn14W8LrH_GJ6B7AjB5LpW9SFmAs1--YU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZjd35ARTH_xvRF21mljpUPqBd51lLLDr8Soa3smE9Ww&oe=6A95CCF0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yqvzCLReQMQ7kNvwE5LKHq&_nc_oc=Adqhjzs0gHjg4kA2A4yIZRZZ68D1d4ZU4naL-zn4HeV9kvqrz21dE0WxeFN0q3hoPDY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZ1Mp5Zpamxpks4xvW1cvrju5byHYSm6ZNCnSUuOSV_Q&oe=6A95ADA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=895inmNxusUQ7kNvwHWHJIb&_nc_oc=AdpzThSfB6I_LM-8Mfs2-JVhkpnEYlISSvPaw3_AyCaQQlmFWApNSQMLJgYGjFU7zaI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETIIJdJYiwzgRlC3fm1bAg1seJQzpnXKErY8DKEUw3GA&oe=6A95C3F2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KfVJ8nPF_gQ7kNvwFG2riy&_nc_oc=Adr_FAghgF6TcndDVWaWypFulJmqxtvdCyLtnu0QLj_Lhq9BDEmbsOMNZmxw4eYN_9U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzTvwl7mdfzr3Al8rvJfIHer9qSxmH3F0V28rh2EzQYqg&oe=69CBAB85"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJ7EteOExl4Q7kNvwGceg0K&_nc_oc=Adoo891avo9DxYytgzDJuTsc5ejC8ylMJM1z-NU3mGo4GL5rcv5JTgBBdE8yK9oR_pY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQ5fqMllJ7U_a80hmpT2gNp8OHyjhUncNUN91HMquwAg&oe=69CBBC51"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDvCDdW4ABkQ7kNvwGAg8jX&_nc_oc=AdoZ0XXkCxVwWHRz0h1jgDIpoIdDY9QMiFW6gKTVZdp71HzgNRItfwWu1rwnZtUpnVA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzdwTQASXxVtl2v7SRpSvLmF1zxTf8xBFGzbq5Lv0KKZQ&oe=69CBDF30"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDm1SzlLR80Q7kNvwF7ie7Y&_nc_oc=AdoHbBrSvGP5KFGx1efJZOc6y76Az2OScu_lrRxirHLdUaatRtjAWTGfi_8mLgpg8TM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQI6QkQY8_pvav7955A9ekZVqb3QaCNkMAoijDAbtJnA&oe=69CBBFE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llvOO8Rvn7kQ7kNvwGsRsqf&_nc_oc=AdpDoJiFCzqLvDGosbJZnK7d6JltOMv6O1y_L6XLupIAc9sFLPrkozjgPd8-6-0sdmY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz4VYFmB0k4Sl_G9aYsRv2zGbeX-C-wE52PExkYcegW6Q&oe=69CBD632"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
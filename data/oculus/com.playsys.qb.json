qTd&_nc_oc=AdpD1mmMyR4bwkbDY978sDLtD2PbC76uvpnC55TwhofLqlriX7s0We5JhygbpOD2Pq4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3GJ2wYHJgyvb4cOq5on8YCAc5SrF-vAGQFni39Hr0sWQ&oe=69F1E705"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dklVA6D1oTsQ7kNvwGl-G6_&_nc_oc=AdrQrYips328oUNfPkzBGb3NtFeNva45y31Pdh2f4LnSVVZ-WH8yRY-R2yRmYdpY2o0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2KFpS2_Yl_05OrcKsepGvEKVgRgpjlrBPrzGmSNUykCA&oe=69F1F7D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXayozwSC3cQ7kNvwHWZiPL&_nc_oc=Adr-_MxoPzz6M5v2h59ude7Bp2bXtAC--z4QCtQLiUKaMoRryscqUp7rwwnu3e3uS3w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1tscBh9JFIQC6LP4PRKrWKBQwMEevkC1rPUD5fj25Hcw&oe=69F21AB0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMqZKN4nxdUQ7kNvwFdCzWL&_nc_oc=Ado0xQJ-ftAMO8NRawuJAl3SqH4cmuXa3dg-Ks0B1hQ2XOtCXpQLYWT6eQZ5zCe1EAE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1VSJggH3b343Hhp1fRgn46Er5U_ta-o9GnTv-RcSu_cw&oe=69F1FB65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=boSoHS1_qD8Q7kNvwFaGHWd&_nc_oc=AdqmuO5S0RyyJsAvMnDeb0Gv3f9IpDlwTCKuUBxOU3FommGbL9ny09B7HiMcropEny0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ra09EyfGMyE6vTiyERuhCwLm0GhgdAoy74ErHlmyQQg&oe=69F211B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null,
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uk-g3FnTDN4Q7kNvwFD1jFl&_nc_oc=AdpHYcx4Z_FvNEmaBUH6SntgqrvNq1SbhNYRcwT6Wc49ASYqoZ8Lx6RRgdNeXJXobK0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPU1oTT6W7FSEYYM7yz5e0VXBxr-JEjILmmROdBC4yYVg&oe=6ADCCA45"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9XEbZr3jasQ7kNvwEIp1x0&_nc_oc=Adq8EA92klfDKcP-1Guf78yVGnAhKAYz1E0IpGzL6HuMIwXz1WWUMdTEApRZGyjk3rc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOn79SvhzCoh2ihVXCUQO-rX_fFnx-pDTEWYww5DUvjNg&oe=6ADCDB11"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5F41EEbjUQQ7kNvwGVitlk&_nc_oc=AdqdwgPoLDx1r3gRsOKD1Y2RZKXVlnXaIkPcPkdPFgHL8M6h46epba1SEGbYUWiAPYA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNH_OgG88EWjm8WF90tynfIzJdwD2-U-y4F-g0DR5T8Rw&oe=6ADCC5B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8deB_c5KkgQ7kNvwHo_sS9&_nc_oc=AdosvykU-tPUBABHgbPcx6Q8MUWVoko7g3Kfm59LCi1GSEb-0wF8s5KHmT6mvsUMWOk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOb6BQEBLaQic44dLtbmUuWXdVxnVB1UX0SAsAY3gDdA&oe=6ADCA665"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLOZ2LJmlf8Q7kNvwF-e0VU&_nc_oc=AdrbfTs2Ec_xkPZkULUFiySv2bH7ITcph5-bA8xDmmhqJYwAFc0V2JG_z7CeDrMhY5Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPC5HhIvi1Svez-XpXX8C-YDn0DGQvJ5vR9r01ModylMw&oe=6ADCBCB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKSpuuXXqvAQ7kNvwHlxtIF&_nc_oc=AdoV7CElKknVXupQqNRtEhoZrYVTlcr9tpgwdwov1xmSjjSbnecFlEEdaiT4mS0I1fU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdiNJCbXH3PddxJVlw-LTjhNoyTrXo-7SxQHEaEIsGgw&oe=6ADF6D45"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9XEbZr3jasQ7kNvwGcHkfc&_nc_oc=AdrLicGXA_e59qjbJZHpgOk9PpfRxpOjEOFTOW4mMICrcOLEI6Evj9ic-7Xo7Khwcmw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrKFki1reKaPvDv9zr_SEbGafGMtkDXyT6LEdPlEBF3Q&oe=6ADF45D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LyMzSm5MVYQ7kNvwFyhLSE&_nc_oc=Ados5EcQkIspSjblFd-K4WwIMsYqDW_FHkm_K-W4Xw58EpT0AccwghViCxOIpQ1Es0A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFhfW_mIhMHnQLluThy5usV5Z5XiDsxK620bziT-s-ow&oe=6ADF68B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQ0lJhe6BkcQ7kNvwEAd_if&_nc_oc=Adp1pbSmnFfraHaw9J4psfUBbFeYAODhM79a027RLZ9IJJRmS6yA6g3Rvz6Or7oPny0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5DG8VOIk2W8nQ_dfNYBIHbuAJinloVeVOqGevBqyBHg&oe=6ADF4965"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YcuQ_6bmwWEQ7kNvwGfbcSy&_nc_oc=AdpuzHtiCW_nyKNWfCs0F3urTxZ2fW7hMwwg2FaSVHn18gfuF4FQterLJMADj3k3wZM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPN5Vgb3A2lQ7VuAwAjQdIr3UR5cw5dPfRK7I-Cv15pmQ&oe=6ADF5FB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
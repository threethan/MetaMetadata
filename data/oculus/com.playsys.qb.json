ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6spqc3JGDAQ7kNvwFVz6EI&_nc_oc=AdrhxSpHML0mZ51KyQwQEOdJp_Yhtl0N6TLA_B9Sd948yUNDnVJKKkSfJiNSNPiHOy8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Z0rubuBX2SY1D3NWxW6W-s5XBIxskK9BSP6A7Ul53yg&oe=6A340A45"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Eg9nx5dpe0Q7kNvwG59MNR&_nc_oc=Adrs3IwXPS7o-4HADnJxe56TB9eyynpj7n-Si8Tv8CjQ_poYrJ3yRyI7Pb51IAVkWcU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RRc1M4UQwx8Gn9RQgbbjZGh4G0WanrUaj_MBMm-bcnQ&oe=6A341B11"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seKRE4Yin0EQ7kNvwGBa5bn&_nc_oc=AdppK9pf1xeRL1f1uPjiMMFdvIF750VpopFARuTMwAx0LgQ27yDAERXh1hpHrFwqC2Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-io-MRxkMLnzAr9G_WZPIQLq2ID-UE-D7Pxkw2Tmo9w&oe=6A3405B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlBGsL4W3wwQ7kNvwHf21IS&_nc_oc=AdpxRMkhOUuZWXbt_AyGbUzEmc-gatzN1BP3nlV8nhZ7kjT4-z-ketpIpmTynIP00vg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ac5uW2xAiMf06qe_8Z1FSDOAcvXHvrZanJXfgcrDQXQ&oe=6A341EA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ij0Li1Xp4XIQ7kNvwF8BeCy&_nc_oc=Adpc84_a_ietYpElz8Xlvix_cMz2UgWAc37vB5nJvjwuTJdD6RauJwKATgQZ7ooS_Eo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yp8aXL_iZHizbbZD3byZPXGU2PJQGiKpxzPdm11biFA&oe=6A33FCB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
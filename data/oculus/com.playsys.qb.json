ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YkBtkXU9SFQQ7kNvwFddEsi&_nc_oc=Ado-eHHsVXvUOFQQP1rqg2OhkCdukJ4nUKBaHzncFiWb0IsCwYmywiNBgfW_iCVYEDk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxo2VJBMeOtcH5KrnFOzRBAytGXi91626loyFT_3Sdbg&oe=6AF1E245"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRHiwV9hBIAQ7kNvwF0ZqIx&_nc_oc=AdqKKg60CoX9t4zttoa6uYBsAGiB0BMxcQ99Vg2cq0gjyaqYxIm6VwBlDr71bPQAOB8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLCCXoIDHGo-_yjuyQhzYcLw0NT5gUrQHM7YPF4pdmZw&oe=6AF1F311"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MadeMXvP20wQ7kNvwFs6XE3&_nc_oc=AdpRMWFz6hasMfY5epiI5-1VfnX2NUJzvADLo-tF0aMHd8irp95fRrSbSEvJQEtlzhg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsjxurS2sZbtcWg6PHKh9_M8Ao8eGCR5Jvkbv6acanmg&oe=6AF1DDB0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6Tnm06B4mgQ7kNvwFs3x79&_nc_oc=Adpi42CIZrCAcKmw4mvvXJe2LifMvImRolutwzaC2-qR2ecTi7HM2zpe-6xv7EEifq0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2yNrWkMy5oTPIT44pmo0O-2ffPkPQm3SpNuku_ybHQw&oe=6AF1F6A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfPvjpgni3oQ7kNvwFjnfT8&_nc_oc=AdoPAIcvEKJdLTB6ODDMQ-XNHzKISK_asYBeOBElRkPFNYEyDwKWAemx3jMqoynejsA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtoPScq5NXebJV3q3hmwtRmRMo0BWIeC9N2xq8n1e80Q&oe=6AF1D4B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
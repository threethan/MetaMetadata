94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMY2wEZN9UkQ7kNvwGMeM1H&_nc_oc=AdpfuSTTBoLhowCEXMzeIeFFDJ_R_K7nmLUUpq7gh7XNCj6TLhm9hNkqDU0D4XKTGqo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2i-IU-HpvP_cTQzKz0CAFLILxVhKdVF0EoQtjX5dC8Jg&oe=69E0FBC5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cS73XJ4IKBwQ7kNvwEPZW-W&_nc_oc=Adoh_Ei23RPaOfBCfr_Pchthwob1weS4Fj9AZ9tvk0SxQrOY5pibBBlNGFzpyzAVjqQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cxL860nMY5FENmEwnDWJtmKSFTCuwn1JpuMM_t_v0Fg&oe=69E0D451"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-f4zHiq3cRkQ7kNvwHJELUI&_nc_oc=AdoFd3nwr9oRkTsAhAsfOGFEywjOHN0EbjdQwasXxfZlPx_XDs2Sbt0n6pHXojDJJXs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10ozYxPcW3i1jsdvbhkKzTyOuVEL1dBoSkuPSwbvHP6A&oe=69E0F730"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZgomhNL8CUQ7kNvwGjjk4Q&_nc_oc=AdqSCRW8dIoN0ozxutkXemJTJTvtUIrpnHxxSvmb3HMPZl55sfWd2NEULNiqarDtKiE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0l7z-f-bk68-xMRG8lTWrqov3mCHHaMitU4u5Qpq3Mqw&oe=69E0D7E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Og6u9PfWsWsQ7kNvwGn4iGk&_nc_oc=AdrVUGFqN4Mzggap6WoGIICWgQDekaMUjADwYfmF2eUrozILyBTJGQ7mer31yznh0Lk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03JaarTu12V-bTGFZNJMGbPCaH4ioTiwAeltJobXroZQ&oe=69E0EE32"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
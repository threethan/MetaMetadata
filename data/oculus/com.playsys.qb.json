ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vp1EFZSRik8Q7kNvwEmimhL&_nc_oc=Adr-hcZw6Y5YMscpGGa34yJZP19gmdmJEBwh41Qr0hwXUSAbA8w56P13QN6zSKQtKfA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAEz4AW6eEUEXl0iba0Vrt4Z7CRF0ULnW19fKxn0IbHw&oe=6AE9F945"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnJiCbHUsOMQ7kNvwGmFTQ-&_nc_oc=AdqY4mtOc5MawKqt9WKTUR9OxZ0epaz4yNz6gMuAuGAX3xSF2VxzeIUQZC4YSUQQNtk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIMZWsWZAYqNh-pytz5m5Mntk7ubn8Asqq6i6wM0uuhQ&oe=6AEA0A11"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lmha_ZXq3QMQ7kNvwHQaxY7&_nc_oc=AdoEFIzoFtVW7fvA61NEcjzEVLHEBS7SPm0hIlohrlCneNzP0pB78xNnqzcAihk921c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQr2hwEAY424o7Ql3OWcXhfLF7VQ8x3TD-yj8ZlrZASbA&oe=6AE9F4B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTOiixHZxNAQ7kNvwG_eJPN&_nc_oc=Ado-7ug-JnNgkeF3AOIFicDcYXpy4MpzvPLwTZxk5FXxR9br8gr1vT5VMEEkJ52EK0U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReqoG1ddCB_MXrnaOaiU8EZpjxadPgGNE5SbzXPahQdQ&oe=6AEA0DA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dmBAvxK0iEQ7kNvwFToHA_&_nc_oc=AdokXCXVjsy1KBbP_hwUMbsRgslmHKozK8zceWZn2skzt97crGevKXxvghFF3zAaGIA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLYRkLUOdrnLvyR9vu9l5JU6S1U0PHJbk-b26felOlNw&oe=6AE9EBB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-CbIv3JAqEQ7kNvwHXWkdI&_nc_oc=AdoCfn3ll2f4uiAQg9oK_PmhiXY2C4FzQRVNxwgCT1I92bYHd7VZWHq3126qX9k2YRE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rLYHS7fej6TJInOYVMoOfVTjTNzpWXCGerK8qf4bEmg&oe=69FB59C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNj18nRfiCcQ7kNvwGP0maB&_nc_oc=AdoqwmxiyastWgfdG2aaFm_DwyjzZlMPaCxIx_pJg01aDhwzCKU8G0enwlA3ZctPbkg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kO0bAHSlw5DG9Q2q_AnWPXwXyU9d8eHh7AXQKiNjNzg&oe=69FB3251"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wANIgQlxfoQ7kNvwHVXo9U&_nc_oc=AdopF3_9uzzfrS-ax2_YjGpzTddDxJIH09Kj02YDP5EJAOVygWONIIhFTI4RchT73i4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oargzMSGEYkjrAb6SomPSLYwRo5MTrIuo65ssTutrBQ&oe=69FB5530"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfCyY4wFa-kQ7kNvwEyd1th&_nc_oc=AdqBrN7a4ZK15vW1W77WfcPjFYQW8MQY7-9Anv59y3uparQzesJhP02XB9_ZjbEaD9M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5D8CBXFQJK8Y_dRzY3OFIlV6sxJNaw5t9ykyBnIKVx8w&oe=69FB35E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSMiE74RLg0Q7kNvwH8l0pp&_nc_oc=AdqtFIFa1QguxE2WmBMhjxEXcQvmoxPv2HqtcddTdHGgyksR0DsiLcknwQxSYuk_1nc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gfmjzHGvozQxdRc4GoLBkll4ULVDeQXgBV7k-y4FauA&oe=69FB4C32"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7F9Ft1lQDAQ7kNvwGNlZBM&_nc_oc=AdqlEpfYx0wBJug0bRdhIen17F-nTOLFPwn307EaQTKYJt4TruBq05Y5xpMSMpdjfU8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErTVOewxKblDp0KV2iS7LjxHBNg9xFVqcaXCcZ_JqWvA&oe=6A92BE05"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jC4fHsmk6aAQ7kNvwEu7CCg&_nc_oc=Adoix67Itf2It-ds_MFsJyOWe9g1ETPd5ki-VR9g7_Jh98wnYhujxjZueD0QqEuzzf8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpKzj9WTKqKh8B2JwAatQ__Y5S3g84Lk49qVQDlCeptQ&oe=6A92CED1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VQiUnBWakoQ7kNvwF0jJFg&_nc_oc=AdpWd0Geoor8pE4S28nNVPlaK-RxP5tqUuTYG1U_fb6uiAt0j3sen6i0lAlITHqlt0U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcqa6LBvorlqGDGHzY7IiK-W3_p-GyvU6KTUKZLUUsjg&oe=6A92B970"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3usCCZPQxoQ7kNvwFaCVxZ&_nc_oc=AdqypRMjVjM4_wdaF4KEjSD1ZprmpEfg6LGZ19vKrRNL0Z4ABvEc9ZDoQNrA4xT1bKM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfhUncNYK87GGFD5wgzJ5u9FE0_BwbJcch7R-QMFQ0sg&oe=6A92D265"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRWERnwN8zwQ7kNvwGw3hFz&_nc_oc=Ado_3Jl3f_AXOHX0JGlE48ASlilAYxvpj0ElmS5wZbuRlanI0nSNRDYWjytsNEkAeZ0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF24naRJQ9XR1rHz7Ij_ASZxDAayIfWp6oPp9MEnQKgPg&oe=6A92B072"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRtHsHTiM7sQ7kNvwF4MeDQ&_nc_oc=AdqcwkO7aRFtdtphAt10TNphQa3NPXk57MlentR_qVw-Pl551VtnPoRYOs7pEcrxreE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBjfqg5PE7C8Ik7yZ4RKxnNXUgcOgidelfRF6Ei2hWuw&oe=6AF090C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRHiwV9hBIAQ7kNvwGyXJZP&_nc_oc=AdovcIRaBTFAZE4iA9wUYpywJbJDfgsVqlUnJT6bFTTkcWJt7JaTCT3_iYTs1wSjbkQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsBkdcbvDAPKeU_YnixYeJajJeRfdsq6H0vHtxviEItg&oe=6AF0A191"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gPVuwkXvxIQ7kNvwFIRkHb&_nc_oc=AdpwmwqjyCXTWelUet9kDYYXck5glhFpGcsBV3BT-Rw6X-Ci4BSGIVmcUV1oEopauFk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQo97Ln5nj4Z87hqvO7Br4Pl8_A6-fti4Eq-Uk3Txj7Q&oe=6AF08C30"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqwS6X1BeV4Q7kNvwE7xK4-&_nc_oc=Adpxk_WuoaENRDkgvx1wWdroK2crw6HZIqdqxwHCoJQozgWrKTjHEzVli8ikDvfu2CM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXcwCtwiQ9fzF1KQcNzL7D0_QJ82nrgTIIO8nH9Elw7Q&oe=6AF0A525"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icjLzE-0Eh0Q7kNvwG_CVF2&_nc_oc=AdrfYsQLJcQStKWS2QoB1mO2nH_cdwlg3TRfTtbrtPvufpn5e_Tim363XjmMmJSnLRI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSO_x61To9vO5rLBgGwqpgnfA5LZ6wCR0DBw9U5yehVKQ&oe=6AF08332"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
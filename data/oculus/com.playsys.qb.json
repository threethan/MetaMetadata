ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-Zoo1xmqcAQ7kNvwGBCa5B&_nc_oc=AdpVBZ4ntiAfZNJBuUlTmYmShQtz9EtjL14mM2lCY1TuRPBsZ9LehfZ5PHbQamxv3nE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8W8Z2E2WDInu1gAkkTxQi6n_xG5etCd5byHnlW-iuNA&oe=6A86E085"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6L5T57bP9gQ7kNvwGiLDws&_nc_oc=Ado4U0bJBS3JPSCfECUW5NcdXt8RsLtv-Pv7B479E4WQBryn_jLea0qkHPmuvWNSvc8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOWbF857i9McuEuok44RTOUAKpd5Fa28yp-4AxCCX95g&oe=6A86F151"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWggcLM6Ko8Q7kNvwEPqu-j&_nc_oc=AdpW4fXkmdYHH4Q-Qi24cc22SWxLBxjPiYaWyWy1AU7bWox0ri6eimeDmKFE7FpLTpA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrcZkwe4rDN2yCbUTDxdBeHma_zZ1BXuQROFUHX9CwUg&oe=6A86DBF0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irnxpBj9dKoQ7kNvwFJaj7T&_nc_oc=Adr9JF-Iv3MPHJpHgYGDp_DBPDL-EjnNlJCmrAdhtKOTcdKvSwBtNoCQeEVVvdZThC0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExwBaHTeq9Q1o9YTiW2QCu8ihz_eKsqq2hwEQ550WY4A&oe=6A86F4E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYA2YTm6sZkQ7kNvwFlOAlA&_nc_oc=AdpINgvI3QCL449AmQxfzWZ-4mZEG8oGCrNiJvb0J67BLDOVrDbQCJVp_ibPVMtOp-0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtH0sHqCC_23-nNxo4UYLI_AVy2tWaV-l3Y38bRymrdA&oe=6A86D2F2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
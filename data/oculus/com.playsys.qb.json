ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1MgvmX20XEQ7kNvwFpYw5p&_nc_oc=Adolp9_GZ50cOS1XVgkMXxSaAFu8jKcUcT7zN3XE3Wd2Rbh36XiYzmMp-wiB58ODhDs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_2s3CJFN1OmXYqB4wHm5urFx12YKmIWCo_prOXegyrw&oe=6ABFC945"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sM5hNv0AYAUQ7kNvwEvIcxk&_nc_oc=AdrsQNZlz-LtMz9RfWK88vrl3WSfKkh4qjwmsa-qNAQnilEoiDfY36n-o7ugEpWm_AI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuCWrEtQAnxWUrWam9O6egaiWa1Rj-b8CQ0-3zS7v6jQ&oe=6ABFDA11"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5hnuwgP5WMQ7kNvwGG69AM&_nc_oc=Ado-iI4HO79gpVzPiv2xgFqkraYm3itDCvADZSRpi9LRXl62zMghopQWdrL5EpQKUVc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNc26eouAeNW5ydpy-5YELKuDB_UbwJFNn6phoSRor47Q&oe=6ABFC4B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkwX6MPUHiQQ7kNvwEkYDGp&_nc_oc=Adr6xe6dj__FRL4b6XshqFtJcv2-lY23hs5L_YqsMUNlgw6N-WYSaGaEh3rQISpyrYU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPx0T_pZfmUbrLXltG3dDGnUfpdF-ZvbnEn2O87HnLuAw&oe=6ABFDDA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMY6tRk2J_EQ7kNvwGjhvPZ&_nc_oc=AdpuJCZL-XoswiRzkUTf6VDu8WICXnXAGA7K2vocDJ4kcv-Gvn61nN0XTbWW-strINc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMfl3kARGWrkKs5OUB3Jz3l_NtTtdXYeqtl3rpFzklxw&oe=6ABFBBB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
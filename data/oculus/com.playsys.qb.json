ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXVRSAzIDvgQ7kNvwGaqmHS&_nc_oc=AdqTm9KvW4sxSiQY3gSl4Ambha43kPk7WmrQDC5cjDgjTyudjtBkDUedfBzZBOzhMRk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlf8ZhvZuCyoE9fuuxYDWqIHMIOXcalGavca4vA50d4g&oe=6AB7E045"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKT2ms31ON8Q7kNvwEjJMCO&_nc_oc=AdrJV8Ocw0SVRmdvP7i3Pz7A2WgAU6Qp3YuojXTWOq5Z9CTNa96QZEj7XXErlnYBxsk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZeeXWPTEO-aG0FSUDjQ0p7oxnmjcAFOi2DLhEoTQkbw&oe=6AB7F111"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GT5GOjx7jIIQ7kNvwEavAu0&_nc_oc=Ado29N3zZWofOE61ei-lXMSg1o_Ymfh12gh63sKMJNWI59cCz_UzQu2vYpz6DmHnYPw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKpdprq0wgBXAn601Q2qGnjxemX_2aB36MnDWjes8Ayg&oe=6AB7DBB0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ch7xxvnq0hkQ7kNvwG09yPN&_nc_oc=AdrBJ9oGznr6-zKf1g4_TkZ5OUTFzjmGE6l9BZ2Bfc5EP_rZ6o5xMp0bcyX_f2yqWho&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBSHvzq_LnvFCjNxXkITMGiD1DDLIESsZ8hVP7dzQ6gw&oe=6AB7BC65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyilM-OtktoQ7kNvwG6FDIm&_nc_oc=AdpgIvgTbYh9B0t98FAsZbnXG42K8kM2FTDR1oqxO1H9Skh8t0FhynwIFy0ZTH-ZQH8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAlFckzcaxhQmbuTZ4bzuTkwuphO0eYHikAS_PzF9rdw&oe=6AB7D2B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vp1EFZSRik8Q7kNvwFZV1Si&_nc_oc=Adr1MO2dOUBEArkk3_VCymQp1TD4nzJWkMmWzkGaWzwEhTNh0D2soWNiKh_puAPy5Go&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtxrkXiFFAVC1RRG8ujBIbfoyINKICrzTd2wH8upipTg&oe=6AEC9C45"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCwZ8lZBpzUQ7kNvwGbRCM6&_nc_oc=Adpf4GtWAiiaN6TRVIe88XgX-c8A9YNET6E3HcuTV7c1UmaeLOChIW6CGrhkcJSNejQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7CX-u7xrTD5HpC7sbxVWHSudCTa8dtMhqR9UZV27Wow&oe=6AECAD11"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7tkmL2wm8YQ7kNvwHlrWY0&_nc_oc=AdpVnCPQYpzbT1_d1AbFdja9eR9dhhXoSDD1T2DQBsgwBHUUc-VooZ-ARz6BrNr94jc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtpr_7H7ozmUlgDIpSHLzYn3U_-JHo6CnjSSpoMA0Bbw&oe=6AEC97B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTOiixHZxNAQ7kNvwHUgxa_&_nc_oc=Adpu3HOAYu3oWHxSnjgvrcqCe53Ez1-5a0qkdPUG124Y7TERbQ-0wOonO_Kz8ywpFcM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHy17Rg-HEGEY-Aqe4JB6vb_Ms6ZfsVIav3kHKk456-g&oe=6AECB0A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dmBAvxK0iEQ7kNvwGyvxXH&_nc_oc=AdqlSmqhqACsI4WpFp1Dvpf5s6llUKWTtLXPY4RDDv0dvqXjZljx_OBO0c7qlGvMNog&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSykeUTiiNpOwfqqAAzcAWgaheAEnGY7IZLoFP521EsOw&oe=6AEC8EB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
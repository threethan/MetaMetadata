ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0ArNvvVuDEQ7kNvwGUDNor&_nc_oc=AdpGlt6FZa3XNGE8T2p2nUbMpM7MLi7eBccY6vk6zcXtM-E30CEck_dQcA-OHbovrPU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjSBFPR3Pb6MLVbEY3X60JB7AnPhQotokIFGvQ3jy-AA&oe=6AE21045"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSQrUAslwFkQ7kNvwHWvRKG&_nc_oc=AdpndLi59hcq1jt8-BlpBoMfqHKJEUeaA4NOcznDJCM5b-mK6Y7NONERgvMjbgtPlNw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOw6ndq4rwWjPpgcDxL5vWaDNR2Zjyg7SrirGd1PqM6WQ&oe=6AE1E8D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LyMzSm5MVYQ7kNvwF1N8Ht&_nc_oc=AdqG2npUHw2ikfzCTKbgpQWe0BVbYrCZhpyZIOmCo-w_GN1jq6p9oUZOlSTAOX9bbWg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyOrqjpaQJFMKri-aGiIxB51S17HZvuVaxqux82b3pCQ&oe=6AE20BB0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3pnxrZdiS68Q7kNvwGoi4DM&_nc_oc=Adp0v1h5puCdqpS_LL_Iy1gjgNyD76ad9W8ml1AwdGjBmM7NmoOVY98wTO2krcf1HAo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXlYLHkbWQD5X4OVRHHwa6lFJOevgrNQ_9HRD2YBa5Hg&oe=6AE1EC65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YcuQ_6bmwWEQ7kNvwFmCm5m&_nc_oc=AdqOcD7SxepYAh4yi-bLjAY1tK6wVemQtuNAUHWAwd9hKedhtYw3Z7MkL4WNXWhP2OI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcpHR1k72F1VfQM4x7LsP_G_cW9rkiRiDMDwRoEyCSNA&oe=6AE202B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
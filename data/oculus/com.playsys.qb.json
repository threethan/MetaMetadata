94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hh4jk443LtwQ7kNvwFW6iZD&_nc_oc=AdoeUAYYykZ1S68LGg9Qy4NNpCCR7xpzdJ3GwKfrghoYlnopC-beth9Xg9ooIWeb_dE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_nJorUaHGb2YFkt40xfLmKEUZfiPtA0VCsaYw63Tpeg&oe=6A01F145"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsQPXS5ZoooQ7kNvwHw2qI1&_nc_oc=Adp6pmiIMx74gsjwlrtKfWE6I0srq0I99WFb6HcD4lO5qpROWiREMGLpdOP9XVM5Wz8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UV3qOpriAkpMdKxZY1f20TfmhyW7QpnYeBjkZ71oyUA&oe=6A01C9D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azhleXC1yg0Q7kNvwFkC-7P&_nc_oc=AdqkkJfyo1DmqdjrKVblwlyZQRJlagHWNn7ZS8gl4WD66fdJMXvC3VGrM5vxoZaEjrE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Q1U-hRZyYHZcBwDFYx8Uto3Ce-VL-i3iDab4MV6qFFA&oe=6A01ECB0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HLReCfTRxQQ7kNvwHM5wCu&_nc_oc=Adrmn5rOpeWggzrm1_bjtqie3PLOK9gLPxbRIJIsx382uMLk7xVdZ0Hbf0O5l_IVPxQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GPIBzzt8WYwZqAVBjSUkm5tk1Fq3IpY3TgUV4_Vf6dQ&oe=6A01CD65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtoUvKbDJ18Q7kNvwFG--lh&_nc_oc=AdroF5owaxbFUsaIC_TKtCEvzCFyOGUA5FJyX2f-KnTWRBykhxSEc0lFYMqvWKYDN7U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ymu8qkYtUR6p1puAr4SZvQWxb0NK13jx0IZIzLeYK9A&oe=6A01E3B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
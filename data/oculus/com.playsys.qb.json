ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1TUT77iTWfQQ7kNvwHzXZGO&_nc_oc=AdqMV8AMzmRweB1rFkueLYeK3ITKh-OQm8SR164SwtiUibpfQYrFk29FyoQyXV7V-1Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBL0NY3MhU2ga9QNU-TtVnuv0-gZcIbB5YM4Lk8Ir__pQ&oe=6A492245"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGFfxr0eFycQ7kNvwEF5GaH&_nc_oc=AdpKOLqt0xdJnVPVuRsGhVacvluQFBSH3G-wrJn_ynXTNAL_QT8hBN95dPfyR-AElRU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvdc7PvLk_jAzAza36bnB9TPV16BDA-KipMxO22o0fiw&oe=6A493311"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AemD9vazWk8Q7kNvwF6YTcn&_nc_oc=AdoMJFfTGMcYj8r7TC93-zTi98dMArK8PvGSVItJxy7cJNWJygDTypSheRP6oSnkBT4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeej5X-Db7t50nxOl6cd5meCm-CdkdqFSZDl7LG8Tepg&oe=6A491DB0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=niIgRx-HBvIQ7kNvwGjkL2k&_nc_oc=AdqVR5GqSyFCKm5LKCTxiY0NC50NmrvdNXrc8AlvuL3kR_ZwfR6QhllyfWpX3bTllEM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTzQ_N6YsqB3jXgXIfI8-rnk-IoxcKfQa-4qrnrYyoJQ&oe=6A48FE65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWjlq02a6XgQ7kNvwG9k-vQ&_nc_oc=Adpyo3gvJjNQsNyalz16KglaUq7tshFddeSnGD11Tb-0OfP39moMSqNjEU8TuTQOJk8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXqOeQEwzthtY4UfLSpUvqnbSovBuJrv1EV8Y_lpigHg&oe=6A4914B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
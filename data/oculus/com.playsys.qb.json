94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtmqVpOKjGUQ7kNvwFhtRz6&_nc_oc=Adq5uvYOajdvF1LBfPGTIuPktvSrCT52I0adUpTKlnWz28DZpKBQZsExTMOex7QP4IQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vOpy7mNYhCIMWWYmwwrlSOTCxEMmkCzBeq6DKVsv_ug&oe=6A170945"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zdTQ2D-VmoQ7kNvwHqjRtq&_nc_oc=Adpnimid-_5fiUCUgwu8N1pFpP5LvjHPli5udg0Qo5e3GGAL8p6lUGb6ZPfdxCy98Wo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CuV44Gpv_ArBOzp9diLTPpiH3jtfgNtVJoOn95mt6JQ&oe=6A16E1D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vd36FX-aBUQ7kNvwFvkqbf&_nc_oc=AdolbayRaDl-nkoG5D6Ws3n9G_PvHCq5RMVWKiAIzufud8Rzmik-GVT-9vhjFVDdRHc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54SeobG1cN94qbipIPezLMx5_AuJo1KDW-NlZ38AInxg&oe=6A1704B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXl-LZxw8gIQ7kNvwHkpAue&_nc_oc=AdrX_ZtrB5NfePboc9h3UW0Bls0y5OYKse1SCmrOu5xKcFhJyUEAu2b7O63EC8riY3g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af440MGNqyr3IoL9pFlmgGTqMtPf8FYfkYxskYBNVVR-Yg&oe=6A16E565"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGq8DOzsam0Q7kNvwHEbuie&_nc_oc=AdpH_GM5cImlgVJdPDI8EIeio1JqlhHoIHMfjMn19MXoku717KFpqaWlSopgetrSw7M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nK0HsHFtNx_F9z4ubTNO13VacHwhBfuQx2Sq_0jm0tg&oe=6A16FBB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
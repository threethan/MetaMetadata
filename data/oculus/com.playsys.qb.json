94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJkvoN1M0NUQ7kNvwEU7z3x&_nc_oc=Adr8d0Qnb9U8J42PO8MGza2-cMgFScRL7yXIT-XdGQMX9-IikkthQ2qIrIcV81iWulo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwYR40oVmhF1qq0aM1KHbDHiXZ7_KF8qJvmdgQKz6-7vw&oe=69C51405"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhgyBei0j1AQ7kNvwGc9NMQ&_nc_oc=AdoaY1F-Q0MWF5AI4VwjVsk7hek2lLvXPlJNfOD_mxYZV7f6uNPCcctP5XacyvNMjNM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzzfR3AJvbpdaQ_j6hqeO7at6C-k6fBKhL0Lgop1M9qIg&oe=69C524D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGHwTj3r0LMQ7kNvwHI9iym&_nc_oc=AdqlaNX93nhAwDYJSqHnIy2RWUKmwTnsxrFTnYbCCl5oJ9-bMTnkrk17W4oHYHA_Sm4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxLqsmJv4TGssI03EANlr4Sb96UzfhvYjVnlbebAKqWEQ&oe=69C547B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dFn6_XxOk4Q7kNvwFXvHNk&_nc_oc=AdowIY1pQWK6pnqMLIM1E-438wyXd54tWQNuqEY6crDCaqN2wpMlHYMsat8GS5AD3n8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyZsJnmno52FW-IguN8fdRg6xMp1c1SyRjUApACWT-BfA&oe=69C52865"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLynNp0h3XYQ7kNvwHXfKUJ&_nc_oc=Adqtv74fDbwx-PfLVy-Y8dbARzXe8Dr4FDqPCzVKX4jP6556lthud3GcSMbYYDoLfqk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwaMvupIDXN_nO7KvWmBaSHZ2XzZ7UQ5XQdFRJ54KDJ1A&oe=69C53EB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
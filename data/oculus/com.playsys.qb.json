ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-Zoo1xmqcAQ7kNvwH4XDYl&_nc_oc=AdrR-kQ7YM-d-KpmoxETFxoiwDpLyHswAh81zGgzmbqU7NYB5Xyd4SY1CvyUe8_qXHY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9r82svSjVWwHcRAD-gABRN-ztQFDKcE6VxwBNMRq1pg&oe=6A898385"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYsJNBvevn8Q7kNvwGO3DIq&_nc_oc=AdpHcgQobul9w-Xc7g61gbYTVINaOUMmg_PNj6yMLs4ONwV-VZzRMF8uaigPBCb1yag&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAO9SuZR8URVJ_58jKp4cDnoRxKHkpfOiY-bEfjc9gbg&oe=6A899451"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcXYN76Yx0kQ7kNvwFYbxi1&_nc_oc=AdqMjUfSLBziD7F1GAmfZiuWXm08MdzOwTVSQrCKM3IkXxUUtl5RLKG3InhxS0p9650&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETPyqqBFhqE0OlfjVJ-Cx-KMlmHyVzxEVli2AP6E4HNA&oe=6A897EF0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irnxpBj9dKoQ7kNvwFHBeq1&_nc_oc=AdpGjp_fuCXGpYcgPkWAHUisADvts3KnLPd8CmRmwdEiNCnVAHRi3AAFvIKd4N1JR9g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCbnKXnjsJlHLijna3LXsLCrozy0gWKvgPQ3nx-kqByg&oe=6A8997E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOV7AFCXFP4Q7kNvwGCi8O1&_nc_oc=Adq4AKl0KqmwtiTYsQBpSBJJalRy2ygjJZlonvyZ2EzpnccjW831xg68ISOT9IAzNYc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG62nav-AkBOEv7X_nZZvx3vZU4pgZw7tMk_uCoCwkgfg&oe=6A8975F2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
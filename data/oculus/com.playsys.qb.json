ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YkBtkXU9SFQQ7kNvwEgNyhP&_nc_oc=Adp3NFf-K2iExmh6Y4hXlAU6moApS2F6zvvQ1xlb0NsyOZBB1hWAghf8kffNw2mL-7U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQORnYdz-Tvi-sNtEa8BFS2QOWAoQyLzk63Yo6c7ilN7Q&oe=6AF48545"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6e0RBJ5DhuEQ7kNvwFzBC4j&_nc_oc=Ados_SVSq2yVwQE4zh1NT5TV6YZYk-u8N1u9tRDCNl9JoX5MNGfFCaJ_gxEPQxQEivw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0SekBtjDem49WFqXpgdzlAGvx2F_QkFBG73E7bmW_TQ&oe=6AF49611"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MadeMXvP20wQ7kNvwFu636k&_nc_oc=Adqodk5eRiwm6ioIxqoSSzQ8fnTGPyvRxfOVyU2lUHrxn3NNpH0g7wImrP6Jw9H4X3I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTA6aEF9_N1HJKB3UF37BqoKgpoAA7IYRRhek78Y_Kp8g&oe=6AF480B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6Tnm06B4mgQ7kNvwGmwELK&_nc_oc=AdrT3IaoifhWmGBcJ27qmw6yjUUQ0A06t7cb0F5XkKDxvBuF8D9Pvrs2z018rKeJh68&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQA76IUVGMY3lpCsn6cP0-oUJFg4qgDz9SuQ3LtMEAtLg&oe=6AF499A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfPvjpgni3oQ7kNvwHje7D7&_nc_oc=AdoldO3f41YBcZyScsx7Gx1Q0l1NzquAR_d_UhTylkjImeP1o6TE4-ZHEVJOPue9GPQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvlF38NUO14OSJGuL3JNag8H5tZTTO5YQFGOGKYyEnDQ&oe=6AF477B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
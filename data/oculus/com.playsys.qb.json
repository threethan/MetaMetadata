94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyERjDL06MUQ7kNvwGiE_zZ&_nc_oc=Adp8k-eTaRzxPKYYLAbvkufQwWygM56aaru_8xgkjRnPaRAkm3bmD42l191IUDnUFqA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39S2FUgXIOkyKZ9vVHTzGPJERnTFBF2DTe30q1yDkbag&oe=69DE2085"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YF0NgAL8Wf0Q7kNvwGWn94j&_nc_oc=Adpf9SDknJAwU3dBnLP3bsGL6XI56PPi0o31e90Zd9not5TpWKC8pTUhP0MFFPIoM4U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2L_3lGARwkSmrE6g3olcYBbUJUisLfkMD1gXDW9iOygA&oe=69DE3151"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-f4zHiq3cRkQ7kNvwHYzaRM&_nc_oc=AdqFRhfp5cW0wy9NMS0sFurP1oQnwv9msJnjJxtVYNKp47XA8o30P5weDrpWZmd4HPE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01suqDyluXCc9ziMaL4EMfXBQWoErOn2yhntGuh6KwaQ&oe=69DE5430"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrPvwyrd4vIQ7kNvwEWMl7j&_nc_oc=AdrpHuKmhGgU51dqr0Afc8tVjF3xgBcRlX8bNClZKwRHuW8NGY9pd5MVVgZCe6VIdqo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mxO-8BMjRLJAO09xWZDtlrwNOEZvETGbU5sRmdAsaPA&oe=69DE34E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Og6u9PfWsWsQ7kNvwGpFf55&_nc_oc=Ado8zOoF4uHo5FduiLcDd9VQ46o177pdU4yEqcrMoXGEZDdNV8cA018Ucuz0N0ti2sE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SKA2CQTRLyL_oDgTM7F7T4ap26t9jY4PtCaMvux831Q&oe=69DE4B32"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
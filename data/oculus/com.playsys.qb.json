ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHR8-44b9QgQ7kNvwENQiYn&_nc_oc=AdoZvYEfoDPEN9_9W4NHzKlVVeGoXx9v8Fe_H36PHWqVlLayS-BU7dQNXhYmsGJfG10&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Uk3nCxlqOHRmSVt7omt0xagD2HX8qwtGHsnCDr-_Zzg&oe=6A3BF345"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tmq3iIkypY8Q7kNvwETgVYx&_nc_oc=AdqD6Z6HVo0OdiNAYTezDn_yscnsoDLiS2x2GWsQ3wKn_aBbvIYLaN24cgxFgAHlax8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99R9Tum7UaxZQiplI3P2_juWLQvvObDIb8d9MJPUQIng&oe=6A3BCBD1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MoOJukER54oQ7kNvwEICWMR&_nc_oc=AdoXlM0JtnDCvpt4cHxY6hzhWWBcWQrLuCgbwSjnq0-BbMt-rebmSgU2E3THs1BXWJI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KAPCyxUfi9usRbVnxOulLYP3PmBSgG-O-Q0iWC6TPGQ&oe=6A3BEEB0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4OHuTBCLKoQ7kNvwH7Vi6x&_nc_oc=AdoyLGQbw3feRniZxwU1N6tlFWYDhsFJQGwtPoGLxwnMy0ZTUSMmm-be4oJAQR96LMk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82XJ-7hGPN1TFbgaGsmnvvCK7u9I-SfwQjW5CplPuZiQ&oe=6A3BCF65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhcS0LFfo_MQ7kNvwFLbh56&_nc_oc=AdqA9gCSpIO-EorKFlgjjHiMslPacJhkRGdcrCsVp2ZJh-LN5W1XHQF-oyyfZWqkZ4g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_J44_dgejC5bsG_gtNAhZ_Y0gjUic4HQ_6dUTt2MaJ8A&oe=6A3BE5B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
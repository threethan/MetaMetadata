94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ser2D5AufKMQ7kNvwF-Qyse&_nc_oc=Ado7nihSUwSBK0SPME9KtmKAz3q0ZbW1RTTG5-wqER4plrIDqe-LRukg3cnikDMHzRE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwozmKqg657npkGpHnm1U__8S_U5rKJD9Xfk3hEgUm1pg&oe=69CE4E85"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJ7EteOExl4Q7kNvwFaUfbc&_nc_oc=AdouOiEC_uxVAiIODph7GK74-q6T7w3Bc5ddJ1Z9Fv8XbdwlfZBZSc0WCvKJpGRULlI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyO8ElcmrRxTlXv2GjFCTZQ3sEhHDqbZnWEuTSQQUqK0A&oe=69CE5F51"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogHsxvwGTaYQ7kNvwE0vycr&_nc_oc=AdpOFSa4GdyXsAG2Tub0WoSYOW4VR7pMknQ6E8hUp1Horbq1jElDBg2mC_-z9PBlYZk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzzKKEBS7nFCbIowp524FtLO1oN-_imwjDCX2lk17-a0g&oe=69CE8230"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fre6nIXbwZAQ7kNvwHD10SH&_nc_oc=AdqwkE-2eK4h7xiDIeoc6PxapHkHsjWOJ3rDm3Pjp4NPs5QCtGd5WdekOBdqIK5A35k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx2J1xVL3ioqYWwMv_mDWfRFNiYb9tRXlvN3tjTL-KWRQ&oe=69CE62E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSjYfLaEnloQ7kNvwGsEG5e&_nc_oc=AdrguMrB8slvjHxjj8-Ej70PCdNBB8YSeOvvZ5twKt1UuxZKqJXCgOHnM3PTHGVrWL4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPRnRk5vQ-hJu_Fa6sZcliarjJz0f4ilEXpDUOKmKNkw&oe=69CE7932"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
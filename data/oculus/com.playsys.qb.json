ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lF-uUfGm4FAQ7kNvwHDVGez&_nc_oc=AdqysOUF5mfvHPg--ZiU2OyIGjXGZ4GpSa-F4ckMHownITmCU_eax7hSFwnIMB1kUmA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFymrwGRLuWdZ2IIEq9eo84lvdlqoqVcWmAQGspDVuc8A&oe=6A75F545"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Dtg9iHMZYUQ7kNvwEsdbDi&_nc_oc=AdoX_TqgAU_tb1NhkIfs1J5tJE9uJrhe8Y8DCzXMnoNtwcijFI10OEAl0FJ67_eq5VY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqt5dAYMhTfZN9FKKDY-pkeTZ2mY3XyMvtW89EXmwAfw&oe=6A75CDD1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBAly9cAGq4Q7kNvwHua-mI&_nc_oc=Adr1Ne-u0qVjGZoe2j1C5L0BrTBO2Yr4tQ4i99d6Ojmmh9pQA0b993NFZMV9cO8yFC4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKspeKcaGpZk6G6T6zuDQ96WLXh6JmBOu3oY7KN5Wk_A&oe=6A75F0B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4d9DiA-2X4Q7kNvwFRvmF1&_nc_oc=AdpxPU6OWpyU0kaWJVHSSHGKsdyFg0oD-CTSO020g27f2JyufARAEWRSN49fYuFrv9s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEuY7LpkmW0J-AIvx9USPEGswV-G5QU_YjWYWyZXYP5Q&oe=6A75D165"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZkHl7i1OFkQ7kNvwFvxHw_&_nc_oc=AdrZT578lcxXp530pAMQUHdrH9iYJUfOCS87eb7rdOv-mwPPNiIMN5EJ_brikhVSvdU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOEUG0pEQA2nCo-3sLMYcQiVUdThWfOrOwfhldplkNEA&oe=6A75E7B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
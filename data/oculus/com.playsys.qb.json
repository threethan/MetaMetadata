ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBb6NPCGn68Q7kNvwF-w8PX&_nc_oc=Adr6oWAahS_tk-u-fOpuLCxYgEdL0IX1bI2iXIInjUsN8dtp0h4gu3hPNafblwUwEf8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIysNAA4X1geTI7Q2czIL81x0yvib-wqrsaE1EMButiIw&oe=6AAFF745"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q42CufkY0XEQ7kNvwECMlHD&_nc_oc=AdoSpcevsbG-eznnNij9Ny6NJQeoyvhZFfaoKh_860GBZ4FYSwiZOJvvbkrs88wKipo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIqEXRFP_d1kfwyRa7gMAt3I7H_BGFMGir1VplLljldg&oe=6AAFCFD1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWpr7dMcWQoQ7kNvwHcDRae&_nc_oc=Adp2LAK6xqH0d-NK7gvLCLohgSGJ-uVGDZUdm08X0XtwOM0zRFl5UQShyXlfDIgwg_g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVZgJcwcSwlnIArnXQnGUptDYoDsIa1Knh7fUGAWEf5g&oe=6AAFF2B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ehA3f4CKRAQ7kNvwFRpQPd&_nc_oc=Adqf3pTIuks4Yo94XVwaCihrk9qmKOubYekNqa8V8MvcEwicqAL9dxc159QER8lRUU8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKs1SX7wu1rj1WxDZ0ZGDBFL3cYIAglrxQmrVGri83lEw&oe=6AAFD365"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0HlIL_ktDwQ7kNvwHrBkNk&_nc_oc=Adp3UsuYwqRB3ZMAwWxqH_tjPfNorEPCrGEnPPtrJtOjdrB7GmntFK0Nr7ysAw6jZ4E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJf-UbXLX2d6XYi-nY2FWMNTuVjpyRno7Q4Dn2c_20a9Q&oe=6AAFE9B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHR8-44b9QgQ7kNvwH53Je7&_nc_oc=AdqGWWZELC8FKyRT7_mxWxAdjn8LM7feP2YJUoOR7mPSV9lkOrF0x6ryh7pnFxoouBk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wFgrzGDivy1CvsJSJe_u2w2ZEga9kHNQ5Hw94qPL3sA&oe=6A3D44C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tmq3iIkypY8Q7kNvwFo4f4r&_nc_oc=Adr083mIFaspZGTxGxtT-mjaPn72RwHdgYzTVenRZpz-ajCi9NVs-y4-xDew5u82C4Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qsQ8_7aUVO0_cxgU4tc9YNrtVs52hvn4gLZsDhpXp8w&oe=6A3D5591"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzb2JNRs9nAQ7kNvwFGj0A5&_nc_oc=Adrm8PjtDAMZgDcPWOJLlSKakUVNJcRv6eWqc3ISE8bsCW0egCPmkxggGN5oAFTucVk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93r8RKWM3O8Wqpjx5e1wrL_9a3SJxG7bFLABBc_zbhig&oe=6A3D4030"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4OHuTBCLKoQ7kNvwFv3LoA&_nc_oc=Adoesj4OkypNAoODECpCjwsv3n6Fbufzy2jSmXyMP7v2-CEgazsLbehXdRjvifO8WTs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RoE8uA3PyoAPJBmTtwSmyKwjMQIVSYlXSxo28wjhyfw&oe=6A3D5925"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjqsaA59qnQQ7kNvwEDsk15&_nc_oc=AdoVyd106R0z0AUdMEkyYJH5YZNcyaCls0dJ5RhifyGTInHGoKbe46OXD5InRNq4e8c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hgfBIXhJFI1NNN_NsRpPFCEJ-bOaG18OdfPUsZ-Kh6g&oe=6A3D3732"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
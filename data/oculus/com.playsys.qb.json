94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjZgbW6ktWIQ7kNvwFCKwIS&_nc_oc=AdoRIusdwCl4GFYdtM4p_IiHpDodDezlrYVMrKZJQx_qjGnPzbknI6QQ_36xdi3njEQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af610Fkmoz108CsGHfNij3rcDH21m1BGLYiccCfqy0n0lg&oe=6A0DCEC5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OcEt9gKyooQ7kNvwE21OZA&_nc_oc=AdpwU9RgXxgu1MF09xizdx9oSiWreCprXPS1Fdez62GD3ZAeGdShmot_Twc-glrfJss&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cPxJz7ueg7ro8ehBiHOQRBTjMLqERPFCZ7Yr55sAXWA&oe=6A0DA751"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5qe6s1gzsgQ7kNvwG3yuqG&_nc_oc=AdrIV0xNuk81uTLMNS_dh9m2s0V1tk9NFVBOt4yQrvBSD6Sspcm2nR08gRgR7DTG4wY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TPKr_Zo_czoUdFaJf-g5kgrD233s6syhHL6fC6ZZPwg&oe=6A0DCA30"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ty_DXV975QYQ7kNvwGZikjw&_nc_oc=AdpYOvpHeOI_DzpbhfAeMUAhcMKTsRr6EIzNXyPgHY_qDesFJRtNn_BR3IyaL71YUNk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58Y2ixmTrjJqhWZamuP6py2b1Z88mLuGJ11UsdBf1aGw&oe=6A0DAAE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqIPP1jFglkQ7kNvwF8dAEj&_nc_oc=AdoK-8yrdGStEQAENE_wkBlEKQkhghkaxfcjGPKPDm6FbuSsSs62YZa9hBrq_H7sbg0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iHgbjuvVc4-VC4pVr8Ss6sBZGr_Wv9VM4-4PzpFWPXA&oe=6A0DC132"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6huZqty9NJsQ7kNvwF7gh5R&_nc_oc=AdqRPGM_BbfMgwuz4JjZHuou_UpQ1Siw3_-XUTB3LsGiMWhnRmibwNcjueDcfQcDvcU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKrLesKN2t6sckXiPV2G5g4wRRHheF5AnRqkExHxLT5Q&oe=6AC50F45"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6Sm7rsfCwYQ7kNvwFeJdFg&_nc_oc=AdpLnruLkixHJQ3I-9wBYwhs6HEp4JTFynNVXicp89SmWReWNvCYSqQEH4fPywA6tEI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsO_Wkx6PSwKLTgoUGEsHD18LwAP-xHDbDHJLmiMyvWQ&oe=6AC52011"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tyd-x8JwHE8Q7kNvwHTCvCH&_nc_oc=Ado3wTAL8AShzNMbIPEfgYCqHkg2sQQgVObTXCb12R4B9S6m2YatyR5Hkxov6UkOFuY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfxZBQIQG-W6V4z7ks1YE1aP9NTPfdNQY5FXk2QVWgmA&oe=6AC50AB0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2k2i0Dcxv4kQ7kNvwEjose7&_nc_oc=AdrfnXXS3ZzG6wvuFoYoatXbRt3vtDNAmMGjqlXnnHFz8OFxhuaCLVDZBC735MDIrzc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUPudW-GTvcksEgJdmybuke1g_p52LUbKP59N-PgWwwQ&oe=6AC523A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0aO2DoQ5vcQ7kNvwECxlTI&_nc_oc=Adph-RaGG2R1KgEVZatL-W1xSbJkpRH4fhRf3u6MSBQ82TC3XZxX4RQASsTRJdLatB8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0BEhLvEk-6WOWACc1LHoUtLrSim_sFXPKajT94YsUQA&oe=6AC501B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
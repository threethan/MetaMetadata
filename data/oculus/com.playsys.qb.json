ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6KJwLtM-ccQ7kNvwHZ-owG&_nc_oc=Adq9P-OCksIY7AJS0pfgkRFkOvJwvadOfguw3wxykeXJYgEkhUicuckDoUe8h7NG3js&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpHqxHITLL5G6QtkWHk2slBjtSu6Eyxys0PmN1OWDcmg&oe=6A7200C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsYUjjm_KkIQ7kNvwFgt-no&_nc_oc=AdpJGEbTn_ISbQYb9Mke4Akepw4aHFf8KUo24O6xh8Gf-_iq90yupPaPhu5CAQTx5BY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAgjlR9GjCUkIo7TutDq41mvYkdjPoMmopN4kcgscTlw&oe=6A71D951"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sE-VEWlZOYQ7kNvwESNFag&_nc_oc=Adrs8dfPLtJewXIB2ALnSDk7dvmbJjtvoe_KSad3xX59_bqU3idNthJI-IvZF8INDUA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmnl5Jf_G9kVqvwktGeie_6pQBaXi7uDXhenJwxN3IMQ&oe=6A71FC30"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAy8dlbBeiMQ7kNvwEpdHn-&_nc_oc=Adpv8WOmzhiVbu1-wuL_89AwBEk4iz-Bt2XDnw67TyTfCAwScUiRx8qaVJMGoXB4Paw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6oXXLw_GzL0bkzWdOxkxURXZ3gS0MoxnNhrge05SiFw&oe=6A71DCE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjNulLWf2swQ7kNvwHpWNhL&_nc_oc=AdocKkkEhziSuLSSWutVXh39OeAcGQJEHOLwKb5cYPHIGnafjlumcF-jIfZ_HA0A7S8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMdaw3S_8k5hyLVsRNFpevec0oCiJQx-EC_CSDTi6eYA&oe=6A71F332"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
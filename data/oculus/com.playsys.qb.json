ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32Fwg7YUd_kQ7kNvwGHS_s-&_nc_oc=Adq4jINxsm5xRtBdOgDeGJiaoIRuYIt1JDOB_h7tVWGVWfKzKamSLmpalBwLMzRxtZY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNsSOjZ55rHBEoWJr0NEF0GCiFcpZdeWD4DGOHY_Af3Q&oe=6ACA5545"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fg28Ac5-SgsQ7kNvwE6yng5&_nc_oc=AdqbP71V1pA_GjNPfpvmzgB8fzk23us8w-mV4WbFDM772006tmMUR212ra8VG_KX1u8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObByZcFIFVXqnB4RrKWZYtHzQoARI5Z8M7n7QsiquNUA&oe=6ACA6611"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJZOVD1h2R8Q7kNvwEUC6y8&_nc_oc=Adqhh9BxeCPDQDSNhDFL5olsC-cixALq2G6_9PUYfOFH8jobT1eGhe-ef8GDREE_kbI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpKyJ5328T0DDLYvUdUw_5gOLBob8CUVmwIYP5KHttpA&oe=6ACA50B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8nPKAnxtwsQ7kNvwGiQTUt&_nc_oc=AdrCpOH6j4VUoqpZec2csMJ-0MOKq1YDBMxffiOnt9BpF6DYThf6O8FFo4L8W2IlCt0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMV7PcLrg5rqH6Np6pkwqG3hznwVcSoJj18Um8crvXZQ&oe=6ACA69A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTNZJOOjaWcQ7kNvwEJuHoU&_nc_oc=Ado03QFWuIbh2G-cdCqofBgeVBwT7kVSs0hXyJRpQBKjhwZsDy-A5dzsLnK6eVdYfdg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKqS-tzAsZ1PmBAJSCdGMlp_PzGZSZhlnWNipXfPjkcQ&oe=6ACA47B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxSsazsX_CgQ7kNvwGl2vrM&_nc_oc=AdohUWzs5Uh8wFIchlK2iROH2VY-e63juZWDQd2wFCvvdTUOKB4xWuN4xSJCrFSigpE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrNfCffvaCP9SXztWMVVy6jzhF5nFA9UrNFMOdC82Drw&oe=6AF72845"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6e0RBJ5DhuEQ7kNvwHVdVWI&_nc_oc=AdpoYes273zlGKmkt7qceevDFgskL-upU-CiC3IG92W26Gc0gaVk2yvmLvMu1xai6sg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyjdjDLWdCuqm61EXBgoW0B4_SoNLjUomjuyN61bR-Mg&oe=6AF73911"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQeZnfocyLAQ7kNvwHMHvlL&_nc_oc=AdoZ23y1QpTnhP1JklqaeG_7m-so-cmo3rEkXqUn7kmmaNmJTBw_WNFBH_xXyGS9SJ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzYMoEBF27qXtECb9PFaVU-GfDWRD0tpAdyh51dVDstg&oe=6AF723B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIS8T-1g3poQ7kNvwFBMMjW&_nc_oc=AdoqN1xUEqeVy24U5JCj2pIfK-_umlCRQFeEVMvWwP-IREm-z1tYCQL-Fj1lNqYF7nY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVf5i2-oGl93M2oA767JpxPH9Kmfg5MqKUb2NAhV25UQ&oe=6AF73CA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGRsWamK8eMQ7kNvwEDWON-&_nc_oc=AdqY1AX-Jnfqy_tewtEmpe7Tytwo8XvskxCzYPNUFWqq52twQ22eaRy6fndyE1BCvTw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRSHzz_5QjGsCxkLhNsooIohzPGHCnB_bRAkAAimpqgQ&oe=6AF71AB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ln34IiGL5wQQ7kNvwHxfIMR&_nc_oc=AdpI9UBjP_6lpqsrou8VxS5KhV9YQ8WN_JDiBDyNrfSlknYVg4zfV1ISVcVSgWqv9NQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpwPDo15JfshY9Cywn53b_rhH4RqCQjAuUubXud4wG4A&oe=6A9ADF45"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jvRvXbIT0IQ7kNvwExBx30&_nc_oc=AdrSWBZ739b6kxhrBGyrzt2ebuYypWshpP3elfET4CRpJNUyNp2NjNoM3yTOBBTOOwo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWrY1ZUZg9v4DNoJqfCQxjbGQO5aa7mNggv81TlISdog&oe=6A9AF011"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iq--fnf1TLsQ7kNvwGApXOL&_nc_oc=AdpYAkZQ1FCH5jKRbCR1Yyyf12SimEpAos3iK6prz1snAerWiy-3fF-q55UZY48YREM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIT0bYU4wZJCJT1sO8lT2Vn7TEABgDd6IG9oVwu1x1xnA&oe=6A9ADAB0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTTbVsqyR5wQ7kNvwEyk5dC&_nc_oc=AdqELKjLORzG19p5ny_dqKU_eIcpswQiZJajDv3yL-QXV6Do1aYiQ0bVru8CBvsEOuw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsZajulsBFQXncu198apSB-GNaE6-i-vNUACJ_z5ihQw&oe=6A9AF3A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWwMcxnRa8QQ7kNvwGurtqs&_nc_oc=AdpZpdlqDbrJ65NSEj9eXCQsDR3SE7zDrPnyXk20N_HCaJz3p32QtgTNYNohImkh3Dw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJU7RzjV-zBHxvwt8BbxM3dkPd4WOdM2fvGdUNB-trOuA&oe=6A9AD1B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jj5AWcVF9qwQ7kNvwErAg9E&_nc_oc=Adop7mM3cXdMQLPmnOt5XD0S5GCn6zqYEaKm2-ufQTRxWFjMgfvgL6VL5HGiiKOlSoI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANYXJRcrHllmhK6XVyV_NaEAdf8xM-k5jisRMDfDf2Uw&oe=6A4D16C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXQFf9dqfxEQ7kNvwGkuhRn&_nc_oc=AdrHwXDObNeTYXSBBFHL5x9BP-sjuSB2Y6TAXYzWo43ponk27nNQG_Qgv80vuhM7ar0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDH6G285H7hY3nboawPBOBpybOx_EOUmgI2xVn8-dr6Jg&oe=6A4CEF51"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7OWWz25uawQ7kNvwGtvrUK&_nc_oc=AdoGpYcbOcQKQZebY93Y05Qbz5TJFUuEeIzkrBxzq7dIvc8KcG1mWj1KnXQUyefFBa4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCG_D18XFcbae7g00PSqgKYaBSXOnlWBZL-ULpChr7yJQ&oe=6A4D1230"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwYwsbtUGHcQ7kNvwH6hBwu&_nc_oc=AdqM8i7P8akOLSB1vk8tysUJBV7VplUPhbNPZmjRmE1x_yjM9jClZ-IzAvAOiHorU2g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBejUfI0m0-kAUdURwstptCd0MwNVwQfMxfOdnZMaLixA&oe=6A4CF2E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlBuGwnFuhMQ7kNvwHUUnGu&_nc_oc=AdoIgZ4xC4RHRQQdf2SnuNOBtXwghk5jt7-vep48qwf68F_JSJT8ohq66ssYfERTQ_0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBlKuFSJvBfJHhbh2fOv6PCAc9MDZeq_1-ptm5fpFRcw&oe=6A4D0932"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24_jF6wCWE0Q7kNvwFgAcLg&_nc_oc=Adr1BZZK0VeQ5DO-OGc2FwYZ7rZT2ifBT0dWzRQ1z_xwnEATWzv4yDXzPfN6UeQ-RNw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdf1ryOSG-upNTa-9t-EhHuYob8i0_Jf8eMBd8YvaWZw&oe=6ACF9B45"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_OJPW2Z-ctYQ7kNvwHobpy8&_nc_oc=AdpDkBk1_2ey41Q9W3JaOuK5AaXQiq6nxdAUN0sKK6IYZ6raIGQk7uDXkFB-cu-KbcI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7Egrt0czb5bWbwjHOhwN1aN3aAE1F0a6kfqLFjob1Yw&oe=6ACFAC11"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIZYzpbnEtAQ7kNvwGUQqSN&_nc_oc=AdoRLTugnsYAHEi-UfFbvwyxUU6TITGVM7OyS4ZiW1ovSYZJltTLHNwUF1NCicZnL0E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxdRCJzUGQ_67xGJsUNmW6MzGD0fHHnMwKh7JJAS5XWQ&oe=6ACF96B0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQ0jNHM6wDgQ7kNvwEwvitA&_nc_oc=AdoUWvlyew1tIQCjKDoYEjoOq86skI9wDf7EUvakFwGb0Co4akP_ywAYY_vaVokJUEk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNF2BvtVph3L9UPVn_rj7CGTln03OHva77aHxXfNxm-4A&oe=6ACFAFA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EWuPHvqnmAQ7kNvwGKicNq&_nc_oc=AdrCeqY_DxhzqYdfRN7V7hnO4C0kT_2mzPWJmONB7DPU81_GPG2yQ3d5vrIXGEhZ3PQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3z1asbx23PHCKRmcDxK18vqsUDeIc_w8vqF4jjfJQ9g&oe=6ACF8DB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
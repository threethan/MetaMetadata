94196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0bkaGvg5KMQ7kNvwG20hYO&_nc_oc=AdroA3QzjkCYIgfyEIJI8DFP35R-0d_VvQyvWmnZmXFmMgl0eJIHVjrCJwRRyj9m2MI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61t8htomOojTGJJpRl1oOIrtfOHsc4dgGRxCAODuP_sQ&oe=6A1C4F45"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2PkN9vhWv0Q7kNvwEWjj8G&_nc_oc=AdpmxcN9EnI8FXCPBtN4d8ilHO9RHJ6npBaZExhQq-l1-YhGk2yCQkTyeQVl7LYX5BU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OfSr7Jto3zU05jnZjQ-1Qo9qZkfXn8fgZ698Otz_HCA&oe=6A1C6011"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-qk9SO8ScEQ7kNvwEgvkM3&_nc_oc=AdojzI1KMPgjUPrPorTpK0Ll_C_a1gB9WTTW_u25EDoiECpw-UfrMy3oVP789R0kHyQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HXtRq9f4upCM-jSRCd88q3brTOQZVebcGHrHsD9Kheg&oe=6A1C4AB0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J269T-UOYrwQ7kNvwHPaqGD&_nc_oc=AdpnuIisNlPjdTXYi6h6EmfuacSAjm01Pueg_oRQJTQF4RuomLhqmsoQKxUF2CdzdN8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66MksrUBzuB4rKnBGlOcthnwN57OTvTv4j4MrdMbOnSg&oe=6A1C2B65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbuSrWOza7oQ7kNvwG3x5w0&_nc_oc=AdrS3SkT8-doNQLQ_TXgHloZiVwiYS56ZOBl4QDewx83Yc2IPc3Mnegj9rXUb5HqXDk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-ZMCeaQwCww1HURl9x_dRAupwrbPy1RL0SRxBbEgviA&oe=6A1C41B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT
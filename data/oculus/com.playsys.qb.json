ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzNyua0yOdIQ7kNvwHSy1rv&_nc_oc=AdoiWyoYYF-hpniYZ8WLxS2f9W03Fqi7HVfVTEFObxJ_TS4JJA-CfpJ36FsxcoPMw8U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVyIo4ntG4rMFR4cr_et0sl_3jKWpE4x0kf0fOLDIkbA&oe=6A8C2685"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYsJNBvevn8Q7kNvwHNvIu6&_nc_oc=AdpoE3tdHtxXNNJmWKqFUquYrjFIgQyeGPKRN_7YzDXNnN7eQmira7UOb4KjrOOCXNI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFChVz-KIvyABlMfieUtBebEKIXBKLpBW5X0cRquJL-DA&oe=6A8C3751"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_yV8wF9ntgQ7kNvwEY5U_r&_nc_oc=AdoHEY7XSlUhIkx3p2tRz6LXGcoewsSfXD1GNfIFEbUVH4TqV-30lfSf0C46Y_aaqrA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEe3_HbbDgngtOPGbx5Z7vTebKrB-_wrLsVJZGOJ6g52A&oe=6A8C21F0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnigVJ4x6tIQ7kNvwEIRcLu&_nc_oc=AdopmZTYm99DJTa76cIS2Rm29AP05yhhjtsIKdJXe49j6v1WpVERbMy2Hn1KLgtn5lk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdCozA7wNQT3qjzQZaFeo4KZSTfgmJqMI6JGwjK14SEQ&oe=6A8C3AE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBWyR6bgAv0Q7kNvwF6QsTi&_nc_oc=Adr04KlxPtwMiTrUlbhwEcrlC2MydcpS_4Q5lTkDFip5QivGNXCq8jcCWVysfEqS1ck&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETnCguld8qh3Bqz9V3Cxz78oZP4O1eX9UWOOhUKta4zQ&oe=6A8C18F2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
0jyFRgXZKSvyWprts1vbjmdniu18CllnB6Qy9roNmengLPamWQ-Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsdwsYEZsAOubAczCjXNgUPxBtHvUNuOVEK5GTnGSMqzQ&oe=69984105"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-a7Ney0hEYQ7kNvwHAy6ON&_nc_oc=AdlqNAg1FI8IMKVM22H-5xobr9AzEs5nXQoXf05EOtnOVvgfAjVGIiFnrGIwupdKx2Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfshCxrh1fKriDV9Mlh7ilc-lyVVNXx22jj4vDhiQTPDlg&oe=699851D1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKxUOyYoh8gQ7kNvwGUjSB7&_nc_oc=Adn-d2N1M_DUDSvODHlRan643Yb3KWyLWx4GLzIg0DMy1BIxtCE80IV8H35nXfdy02E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfttKvxwgl5cjfjV7HbGGetoH8KoOsS0a5Gmw-EOT0cwyw&oe=69983C70"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1l915THyTMQ7kNvwHxAExk&_nc_oc=Adl12NWQdD15w1NBNMAS5e_bv0rxx651jGUj37AK9NNlEAM9iD1Uprnz-jpeJdb2hGA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftQKw7sYn7XlXwpZFtDvDsZC-umXJlFfLwalkt-WaZ89Q&oe=69985565"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAaejw0Cv3EQ7kNvwEb8DH6&_nc_oc=Adka45DO2_VhCQdjqSgQfoCWT3t32ZSZN7iggmwnlcLwjF9xfB5iTewDFF0jPnpiS_E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afujj8yglGhkNVcbMURaLDZ8yOr0jg1QwtXVVNtFY8aa8w&oe=69986BB2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
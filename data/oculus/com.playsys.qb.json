ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6huZqty9NJsQ7kNvwHt9mx-&_nc_oc=AdrJ_FQtzivxBR0723LLczZGZzZ7M4rp6qLtr1RyVcGqw3PZgv66PakG6HBLEkOp-QU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1FfZ3DxZU473SaSdtkI74VYOeeLAg-0KQleIdfxXvww&oe=6AC3BDC5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FN4ZB_7TM8Q7kNvwFh0nBF&_nc_oc=Adp6q3MYha1OnMKuQKHgOwIvq_UyVliAGOFUu6AG1GYFB4pL0KG1DD9iTIGl8U9HRZc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYfDooLEvCh4vH0126ZDHXJeh0MfCw-nmxlCSkQHT9og&oe=6AC3CE91"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tyd-x8JwHE8Q7kNvwH8w3pF&_nc_oc=AdrRHAQXynFlDRUL7S7K3sFEfCFOp2uOwEUAkUV9kL4zncJKJ-x5pV88C3WMeiPhg_Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNl8dC5_-goHuiBt-GYi9iyMu4VWK919juh3o8PoUPrsQ&oe=6AC3B930"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2k2i0Dcxv4kQ7kNvwGsgtQf&_nc_oc=AdpEYEQNdJdKErjmXwbMgNk67NcVpMWZSj2CkmBYSZSh03A-wYsJUjE2_Ia54eTYXMk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLyz7xiqbtQoR9j9NRrOpKk13HLZTsIVEQubhmQxy_mw&oe=6AC3D225"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0aO2DoQ5vcQ7kNvwGcPNIv&_nc_oc=AdqQMgLvTHwrsm3c19PhvqtSdD-oSAND3bkuwTTVqAEllWF19STtqRrzNYcdlJj63s0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8IfqICseN1RUI3ZUCieaRYcyYN1nLM4lvvKIZpnNEvg&oe=6AC3B032"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxSsazsX_CgQ7kNvwFLbvza&_nc_oc=AdrxqDj3eSajY28XQ5-C1bU-kW9I5L_-i3d7FNzYSCLV-4BfVJsNMmaUdMIkE_poDCQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRf_yCJy8lMGOB3rzX6rBECn1fcFKSbZ2blL_dkdYbYZg&oe=6AF879C5"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIiCTqHUtIsQ7kNvwGpEK68&_nc_oc=Adoa_MMxSgLxh7aye19N3NrkXpyICvnu-lt6__mvNCMr-l63MJI5nbXdckxlXL2_V2w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbn-l09jrcJqr-K7bjhlV0WPlumhbCXMlAtLkKCMWIHA&oe=6AF88A91"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQeZnfocyLAQ7kNvwFyxNTo&_nc_oc=AdpcPFkK34hnFVgQ8CIwzsoEBc5lPQA_vML9vMEkPVVyEL8RSNWoPAT1AiQvB85rDqo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNthPRHGjhIBzrT9zqosPD7S1u97_pDS1vk7gOwkCE0Q&oe=6AF87530"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIS8T-1g3poQ7kNvwEULARK&_nc_oc=AdrVqqw6a8HV1-4d8exQaG1n40ZRI_VSrytmwkCVj0m3pbsuHxBfj1wCmjznH6cyUeI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR98MuJodVtsxhWdJaeyWVKeEaVJvKEH1g4h-SdXbE57Q&oe=6AF88E25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGRsWamK8eMQ7kNvwHn199G&_nc_oc=AdqIZWhXf6-QizW7G2b-uDxClIL8_n2g1Zp0HZ00xWBOvHdFUwFn09JGggZNb4sKjXg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxCN5lfH-j0tcOmiHD0QgYEUkQZuUP9BN0K0ZE9SA0Ng&oe=6AF8A472"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-BwU4Xt75gQ7kNvwHN__6B&_nc_oc=AdqyNPGn_JMGH0lQ8cn9Ltcps9vPomp-599yB-uxBw1JjQ-CY64iB7YR_XrRhzzWckU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCY1V6CyknXWN-bS5Dk1sWJo9KLJDTygeC1srxTDC60A&oe=6ABA8345"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BicNZ4S_nMQ7kNvwGqfLY0&_nc_oc=AdpFwwwGWggr8y8qdpRHl8xHgZI6xL2No7j6qYRE3EWjlfk0-tLLDuiPCwxoReCn7eg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTEOVJ9qRzzxj-5mMvXcHKBjnLK0RDXlEYPHxkLt5emw&oe=6ABA5BD1"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GT5GOjx7jIIQ7kNvwHECLVx&_nc_oc=AdrouN3F0gjS7_jeX11ctsxfXdJrjIiesgcOihKbI9-RKf9Qz7BYulHkpZI7ZhwPv2A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIj35gRfz8aq9V_bdRXf2RHpgUCNj1Ttoc45r68Q9yGdw&oe=6ABA7EB0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qu2YPu9I5sAQ7kNvwFaP_jm&_nc_oc=Ado0_MzuFbAtnOMD-XbWVbE5bpziePXWN1JfkKsOSzibyCn8BYcutTexe239KALYYjo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDFifKT_Gkp8lUN_xw8AUGlzMmcleFgflEpCBFgWi92Q&oe=6ABA5F65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyilM-OtktoQ7kNvwGyWIrB&_nc_oc=AdqT4T5Wiua6JtEXdelFYi8FJ2xbMsiC47Xs3QYUoEgkAvixtypmzVsDEDrBmIqw5Pc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqj9LEVA4jD5gQcztyGYsGL5NUX1EOD_b2LRyHVt1lSA&oe=6ABA75B2"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
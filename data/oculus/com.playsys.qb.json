ile_name": "migrated_image.png", "id": "1548464281984968", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139240_220879904992549_3420941425494196224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPFE7KAPuMYQ7kNvwGktQQ0&_nc_oc=Adr38sB0ABuaOrKMFapiv0owqqCAQjt3OoE4FZVzrLJJfbpPkxg-u2ntrzW_mZlbIMY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIitmqlDtEtIUbNlyf4mEX2sQfrtaiKmgDmOgSA5wzNQ&oe=6A843D85"}, {"file_name": "migrated_image.png", "id": "1318435351877655", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386390_1065903746841411_388598564948803584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNOEbSPh36UQ7kNvwHYCYth&_nc_oc=AdpTlNqQR8W0O6_v6cdLOIITB9X5OIU1ONoO2UbakzgtZE7O9Ihu8uArWMHmWj7nquc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFS0nfd23_PRsZBIK_KQKh3ed8m3KppY2Kk9sL_XI28XQ&oe=6A844E51"}, {"file_name": "migrated_image.png", "id": "227717815037513", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602236_1608922459410980_6998638711931928576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWggcLM6Ko8Q7kNvwFIkcgX&_nc_oc=AdoSDGuj4gio-SBODCZMwLmymirNt4QOyY8uBWzyjAVFRW48GfcIWT7oyR_seFWgLew&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHM67Vl3AHXbYDgVnOeggVUnY4A2MqvkA2ClO_C66FMQ&oe=6A8438F0"}, {"file_name": "migrated_image.png", "id": "138745274220646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139355_157370078058723_6298003321160466432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fR_QBqlKbn0Q7kNvwFtRtgm&_nc_oc=AdrjBSmqf0hloEW8WDtwzcpbW1s3N2-Hz_pjB3IaDt1ljUoi-yGu1OG9DdAZJHnUf-0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjTsvGGU42mLotRgPFDR_VoNZMj4g2GXUxI3k4efa4rA&oe=6A8451E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qb_video_thumbnail.png", "id": "1673636789604214", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602290_1673636792937547_6272712586626596864_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYA2YTm6sZkQ7kNvwEH4iu9&_nc_oc=AdqJ5asRZeV67qEeHLCZrpHAmsjCPD6vKQVRzptyyIBWMiQtj7030vS2kLlJ-pKOzBA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyZZcUrU9w6xCEBr5d6YvBr9xj7xn6TR9r71yPOO2-8g&oe=6A846832"}, "display_name": "qb", "keywords": ["puzzle", "3d", "firstperson", "shooter", "railshooter"], "long_description": "GAMEPLAY\nWe developed this game with a pretty simple idea in mind: you throw colored cubes in colored boxes. That's it.\nIs that's so easy, you may ask, well, try it yourself and let us know ;) \n\nENVIRONMENTS\nCreated entirely in 3D computer graphic, qb will transport you in a desolate world ruled by machines.\n\nSTORE\nGot stuck in a level? Visit the integrated store where you can exchange your game points with power-ups. No in-app purchase or real-money requested.\n\nDISCLAIMER\nPlease note that qb is a pure puzzle game for those who like this genere. We designed levels to provide a consistently growing difficulty enriching the traditional puzzle experience using virtual reality technology. If you don't like puzzle challenges then this game may not be for you.\n\nFREE UPDATES\nWith the 2nd update we expanded the game up to 25 levels including two special boss levels with unique gameplay.\nSuggestions or requests? Write us, we're here to develop and expand the world of qb!", "short_description": "qb is a virtual reality 3d puzzle game for Gear VR.\nWander through hi-tech environment and practice your precision and strategic thinking. Spend your points to unlock upgrades in the built-in store."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "http://www.play-sys.com/privacy-policy.html", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "http://www.qb-game.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "contex
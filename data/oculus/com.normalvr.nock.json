_name": "Screenshot1.png", "id": "5148178051912784", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003280_5148178055246117_4804780388933075680_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1m2_4LR8sc4Q7kNvwFzaU7u&_nc_oc=AdnvAvYvBaL7rTYWeBONnLseo0P0hpANGeP1TJTEY-YdGz597EiLl13VWsRaul2DFI4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuV9DSNbpt-syKB2129MLMroz0ujLAZGDTyXURrx0gY6g&oe=69A96ABE"}, {"file_name": "Screenshot3.png", "id": "703926541016940", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035421_703926544350273_1667812412201693133_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1cHb5mJV3sQ7kNvwG822j1&_nc_oc=AdnP2_xiXdP5bBj0ULgn5_OZX1K4zO0tJa5W7jMSeWe0kXj2TYhtXSGVp_H-I1Yomjw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsOPuASKaLZGdnayf4MmYCb4MfM-7qX_IQbXxwd8Ogo-A&oe=69A9805B"}, {"file_name": "Screenshot2.png", "id": "280747354144862", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035322_280747357478195_949002718148707032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A01YkXyGTEQQ7kNvwHm1lrj&_nc_oc=Adl6iWBNdU_nI8ta4wzZUmRksecNkvco-QYYk4As059Z_tqHwN2wEeZYtKKaX9vpJig&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvLcWJkatqobhK5XbPFbfkvWMZ11ABHgKN8utu-h_tSfA&oe=69A97C69"}, {"file_name": "menuScreenshot.png", "id": "330249632488876", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75429288_330249635822209_2400290683021814419_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBn7SZ3aQ2UQ7kNvwEc9AQu&_nc_oc=AdkpErkvBLDZxkLmKy1slamXkPysy6d0h8RTWWJt6RvZUsQZDgcMx-gLKFCvLiYQVl0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvsayvKyYonrlgiHJaofO_1v-qvNM1Sy-uwMEz3n8u_IQ&oe=69A98C2F"}, {"file_name": "NockScreenshots5.png", "id": "346905437312284", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974472_346905440645617_3640611684722686033_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3aqeEMpKcgQ7kNvwFX-n62&_nc_oc=AdlD5krgA6KEjsi5566gwrE2_aKy2yo4TO8W1Cka9MPDNFWUwwDtcB-Ju3VeotMjJBk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afs9CVLR08LjLik31Ir4Ci7oSxCXcNlNVjp4VVKfVi09WQ&oe=69A9885F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nock", "keywords": ["soccer", "bow", "archery", "multiplayer", "sports"], "long_description": "Nock is the first real multiplayer sport for VR. Compete in aerial archery soccer matches from anywhere in the world! It's a brand new game that requires coordination, agility, and strategy. Skate and zip around the pitch while using a bow and arrow to blast the ball into the other team's goal. With intuitive controls and realistic physics, Nock is easy to learn but difficult to master.\n\nLike a real sport, this game can take years to master. Block arrows let you create obstacles and you can even use your body to make a goal or save. A fast-moving ball can knock you out. Skill-based matchmaking keeps every game extremely close and competitive. Casual modes let you challenge yourself against bots or play with friends in custom matches.\n\nNock includes voice chat with individual muting options so you can communicate with teammates easily.", "short_description": "Nock is the first real multiplayer sport for VR! It takes the best parts of soccer and archery and combines them into a completely new game. Skate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends!"}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://normcore.io/legal/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": null, "website_url": "https://nock.game/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context
.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-V0KwbtTpzrKSUCJGX97HTBFZphtABaFrUtgxys9M30A&oe=6A22F911"}, {"file_name": "Screenshot3.png", "id": "703926541016940", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035421_703926544350273_1667812412201693133_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5MCLfQYfgoQ7kNvwEDS2Cg&_nc_oc=AdrWEVSAaSTMjwXaWs8RpWcmXKYyoLlhiFAT_9Dym1l0xFe1E2gbSF4I5zfZpdH9hxo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NjGd9RIE6oR8ESQygSH4IVwR4E_WkSt4S-UYI8ZSXiA&oe=6A22CA5B"}, {"file_name": "forest2.png", "id": "478533937518445", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974854_478533944185111_7413754463287527069_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NhbLZSd-QQQ7kNvwFKmvo5&_nc_oc=AdqoEleTS9s3w2i0V5rwsIZ7OcbLkcZNcsW63Fq3zFDpNp_HRTfwhMAACzegaRyZISQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cdsk6fL762kVN3juRnF8oqy6RN02w7MfZq1oWZdMW4w&oe=6A22C84A"}, {"file_name": "screenshotCosmic.png", "id": "548185793743298", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974658_548185797076631_6295053414421418954_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkRAETGqOoIQ7kNvwGnD1L2&_nc_oc=AdotvqshzbK57d4wEmagocGKacLyb6vIMNiOC26koHkUJRGUwjLJB9s7EJ3cbwo2gz8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Vb4XFkThZOT5yvJ0FqhEkITAHABobbbeArl8ECVoqRQ&oe=6A22DAFF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nock: Bow + Arrow Soccer", "keywords": ["soccer", "football", "knock", "archery", "gorilla"], "long_description": "Nock is bow and arrow soccer.\n\nSkate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends! \n\nLike a real sport, Nock is easy to learn but difficult to master. Block arrows let you create obstacles and you can even use your body to make a goal or save. A fast-moving ball can knock you out. Skill-based matchmaking keeps every game extremely close and competitive. Casual modes let you challenge yourself against bots or play with friends in custom matches.\n\nNock includes voice chat with individual muting options so you can communicate with teammates easily.", "short_description": "Nock is bow and arrow soccer.\n\nSkate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends!"}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://nock.game/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": null, "website_url": "https://nock.game/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "it", "ja", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7408135945877646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/43997718_883949636446454_2947261530912816551_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTBzP7ZQGLgQ7kNvwFOUu1y&_nc_oc=AdpBG9Ff3JRNRw9zeAHsIMDBRkaL6njREr4MgAX-NT4m_5clynFN7uIo-pfHsEnL2So&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87D2LFwm8seagS1B1hAFkr17LZ8nqqdRaRGkG-gX
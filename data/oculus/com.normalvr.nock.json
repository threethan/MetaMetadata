.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qtuxhVZ6QJBI_KbmmUrqKjPM4_LMlgM38lvDva0KEQw&oe=6A469191"}, {"file_name": "Screenshot3.png", "id": "703926541016940", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035421_703926544350273_1667812412201693133_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4eP5NBBTFgQ7kNvwHW6ub0&_nc_oc=AdpOSqhzsQcImykXQntQ6Vfd_61m_iV9W9VDJMyLDbIPrTGOAFgHlbsr5B1YVqkJc-w&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uo4RFKEBR--nz8oMWaj57d4hBTiNWSgBYBGVtU3hB2w&oe=6A4662DB"}, {"file_name": "forest2.png", "id": "478533937518445", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974854_478533944185111_7413754463287527069_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Q9lFyjJD7AQ7kNvwGZeEiD&_nc_oc=AdrVFhBHC770aQZXo0EumN4gZ8Wesjcr-wRsU2l3FpJ1xNVG-zqTNyeWnmM6ZmZOW8k&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94YDOryO8kMpc6Ek4q_3c0kN_VKKjAuBaWDJKSazWhsA&oe=6A4660CA"}, {"file_name": "screenshotCosmic.png", "id": "548185793743298", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974658_548185797076631_6295053414421418954_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00q8QgBh6OAQ7kNvwFUV-Qx&_nc_oc=AdqryZ9a8rEjhDFp72KD7444u_iCJTGdgK3KFFT9-HeLR24U1cuJR-k1-c35CoH2kC0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Bpi3vJAlyPeSm0MCyf6X80PTo2t0RcVBuFXNAQUmbUQ&oe=6A46737F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nock: Bow + Arrow Soccer", "keywords": ["soccer", "football", "knock", "archery", "gorilla"], "long_description": "Nock is bow and arrow soccer.\n\nSkate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends! \n\nLike a real sport, Nock is easy to learn but difficult to master. Block arrows let you create obstacles and you can even use your body to make a goal or save. A fast-moving ball can knock you out. Skill-based matchmaking keeps every game extremely close and competitive. Casual modes let you challenge yourself against bots or play with friends in custom matches.\n\nNock includes voice chat with individual muting options so you can communicate with teammates easily.", "short_description": "Nock is bow and arrow soccer.\n\nSkate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends!"}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://nock.game/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": null, "website_url": "https://nock.game/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "it", "ja", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7408135945877646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/43997718_883949636446454_2947261530912816551_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2kXXrNfovYQ7kNvwEaWU2F&_nc_oc=AdoTjhT8m7jsdmP_-SloBSnJtR9Ye0mbJtGJDTtrLwsqPRfuVim0Y9nM2ap6uvYRBx4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eRtfNIw3rtVO7n3nI2IE_k-DbLtrNNkAZ6-zUcU
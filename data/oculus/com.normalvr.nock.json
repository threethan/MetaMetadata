_name": "Screenshot1.png", "id": "5148178051912784", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003280_5148178055246117_4804780388933075680_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8pyIog4fd8Q7kNvwE79b4M&_nc_oc=AdmW9GKFIekIoZkC3Qv5IyV-EIrg6nlrYard4YsjnWkZdza0YXh-4yLcJErGa6LnMwU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3YP7PRms3Vwh7E42zY-ck9PJUpY_9Rw3d0GtGeAQ7dQ&oe=69B0023E"}, {"file_name": "Screenshot3.png", "id": "703926541016940", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035421_703926544350273_1667812412201693133_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bfhNUIlgf8IQ7kNvwHUlDRs&_nc_oc=AdkgiTTZ09euQPz4ORYk3XE9XYANLuMN1I8HExDUGwE2ugCJqmi14flXfz710C-Rle0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzBRU4_4Pk1GQsfC_Q5QAxbJ_gcdBwd5XLYL7cSZP3KlA&oe=69B017DB"}, {"file_name": "Screenshot2.png", "id": "280747354144862", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035322_280747357478195_949002718148707032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44zrmDdCnUoQ7kNvwG-RwYN&_nc_oc=Admcrrt_cQT-wQWdmOv9S5dN_ljWSPtx56VGeAWI4Z_YjjKb01Ofr78H55BouYwa98g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_rSmSMD5YbI4NBKDviLCRy6D2NrQqKH7S9hwAoCgsUg&oe=69B013E9"}, {"file_name": "menuScreenshot.png", "id": "330249632488876", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75429288_330249635822209_2400290683021814419_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mf6RbYKBfE8Q7kNvwEKz7gY&_nc_oc=AdkyY4IXEKSStyoTjZ_jo00k7KroNPk0gSxqIGE8auliJlQQnkcGwt8JhmV7UZP-_1w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzuu2DfJ7TNth4fIfR777YCfPwZet20zQNdVgfXUATepg&oe=69B023AF"}, {"file_name": "NockScreenshots5.png", "id": "346905437312284", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974472_346905440645617_3640611684722686033_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xc2ZYvPs4AUQ7kNvwGl2LT6&_nc_oc=Adk9fmvodn3ntUIppVt7gPrNtbrFXoo9cm5rqgUqpbM1mm_lBxUaGHjdHYnsG0qlMcQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzne4RGSGgh2G6wPQ7_Uwqr5ZTk6_TRdmQYM7dPqlThCA&oe=69B01FDF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nock", "keywords": ["soccer", "bow", "archery", "multiplayer", "sports"], "long_description": "Nock is the first real multiplayer sport for VR. Compete in aerial archery soccer matches from anywhere in the world! It's a brand new game that requires coordination, agility, and strategy. Skate and zip around the pitch while using a bow and arrow to blast the ball into the other team's goal. With intuitive controls and realistic physics, Nock is easy to learn but difficult to master.\n\nLike a real sport, this game can take years to master. Block arrows let you create obstacles and you can even use your body to make a goal or save. A fast-moving ball can knock you out. Skill-based matchmaking keeps every game extremely close and competitive. Casual modes let you challenge yourself against bots or play with friends in custom matches.\n\nNock includes voice chat with individual muting options so you can communicate with teammates easily.", "short_description": "Nock is the first real multiplayer sport for VR! It takes the best parts of soccer and archery and combines them into a completely new game. Skate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends!"}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://normcore.io/legal/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": null, "website_url": "https://nock.game/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context
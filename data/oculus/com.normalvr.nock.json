.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Dctcew75tRsoEwbtUxxQY_w6E89ZB2cVODm7rIczAJw&oe=6A119D51"}, {"file_name": "Screenshot3.png", "id": "703926541016940", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035421_703926544350273_1667812412201693133_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCEiHwPm4AwQ7kNvwFmfuOC&_nc_oc=AdpgIJE6GC315SPm856YA6zcDPxxbMP5rr-PSgOEF1PRee0mMfvj1iLaGOEuTiq2D_Q&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HXPtboASoxL0D-b4DyNVOvkA2TI1ITQq1bWUrg6Y6OQ&oe=6A11A6DB"}, {"file_name": "forest2.png", "id": "478533937518445", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974854_478533944185111_7413754463287527069_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1blZ5YniNu8Q7kNvwFTjSxw&_nc_oc=Adrqe69KfRFehuE_2Acou3ETlMOjogXmyeCclwwhntgd8R02I4moxnqCeEg4wWlZOZU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IpR1Vg2VBlONf4QGs1Ra9tmLTN3qQKRimq8hIFK08vQ&oe=6A11A4CA"}, {"file_name": "screenshotCosmic.png", "id": "548185793743298", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974658_548185797076631_6295053414421418954_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fK2vVZsY1QsQ7kNvwHAVndV&_nc_oc=AdqPx1bEzt3Ty3Jvc6tkxltiesNQJrjvXBkI5SziF74WPCRJNzW1YZjGph9Ig2zfC8Y&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CaDgz1NscoR9iq2kExw98XjXyuRRo6At8Igy-gaVn8Q&oe=6A11B77F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nock: Bow + Arrow Soccer", "keywords": ["soccer", "football", "knock", "archery", "gorilla"], "long_description": "Nock is bow and arrow soccer.\n\nSkate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends! \n\nLike a real sport, Nock is easy to learn but difficult to master. Block arrows let you create obstacles and you can even use your body to make a goal or save. A fast-moving ball can knock you out. Skill-based matchmaking keeps every game extremely close and competitive. Casual modes let you challenge yourself against bots or play with friends in custom matches.\n\nNock includes voice chat with individual muting options so you can communicate with teammates easily.", "short_description": "Nock is bow and arrow soccer.\n\nSkate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends!"}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://nock.game/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": null, "website_url": "https://nock.game/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "it", "ja", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7408135945877646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/43997718_883949636446454_2947261530912816551_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLgz6XkxjNkQ7kNvwGa29-j&_nc_oc=AdpwEyQ990sVUhf8Hfp6w5aBe8DhrVFCkuXmA1YDvqIaXTaAXc4hfuiLmm8qaiBFYzg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JUmw4OTOxWi32CP-kU31olYig-O96h4IyF5FOHQ
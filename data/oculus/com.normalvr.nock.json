jCy7_CVyUyu3TSBhoEB0L7tw&oe=69B6A5D1"}, {"file_name": "Screenshot3.png", "id": "703926541016940", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035421_703926544350273_1667812412201693133_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bx_OjgqpBroQ7kNvwGwfU8d&_nc_oc=AdkZK62YIz3NtCUEWG6qMUPk9W0mH10ik1QdyVcdPyOELW-xBfqS1YBD9x1IrY4Jdhw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwkWIgf6XOT01XA7PmulsAHUVn-YL_Ne9Awua89QaNbhA&oe=69B6AF5B"}, {"file_name": "forest2.png", "id": "478533937518445", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974854_478533944185111_7413754463287527069_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2R1cYolmG40Q7kNvwFJgDXY&_nc_oc=AdmkUGEiLFTgtFHZf7EewHj6DYd0dIT3JGtDEqEviRi4D0C0wAkhsrz9ING8u0QRhug&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKmCyUPG2LJ6qdrvSMdc4ZEZEmeZkYoXNvnyZUbLqwww&oe=69B6AD4A"}, {"file_name": "screenshotCosmic.png", "id": "548185793743298", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974658_548185797076631_6295053414421418954_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msGUDgzgS6AQ7kNvwGme6PS&_nc_oc=Adn-tyQ1SHl22Z27LlyD29qVW-Qak1FIINGy1iEIwakgomu6tW-6_OJAKjG-xRGtYvY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwdoKCJyUtCUtdl_aDg8yeL0lDJaBSJ26wetXcXNgQtog&oe=69B6BFFF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nock: Bow + Arrow Soccer", "keywords": ["soccer", "football", "knock", "archery", "gorilla"], "long_description": "Nock is bow and arrow soccer.\n\nSkate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends! \n\nLike a real sport, Nock is easy to learn but difficult to master. Block arrows let you create obstacles and you can even use your body to make a goal or save. A fast-moving ball can knock you out. Skill-based matchmaking keeps every game extremely close and competitive. Casual modes let you challenge yourself against bots or play with friends in custom matches.\n\nNock includes voice chat with individual muting options so you can communicate with teammates easily.", "short_description": "Nock is bow and arrow soccer.\n\nSkate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends!"}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://nock.game/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": null, "website_url": "https://nock.game/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "it", "ja", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7408135945877646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/43997718_883949636446454_2947261530912816551_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVwFncsbbMUQ7kNvwEd7D2x&_nc_oc=AdkmvSguOngWo9XzDYnYYqJjQHIcBQZO0e9TX5QseI4ehh2I5K9caN8cdoozlGPwZWs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxad-tlsh4sih_T0FJs7CBK0JWLhPjho8m4FNvonOyWOg&oe=69B6ABDF"}, "is_concept": false, "is_test": false, "is_trial_offer
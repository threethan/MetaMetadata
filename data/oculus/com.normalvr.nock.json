scdn.com/v/t64.5771-25/39003280_5148178055246117_4804780388933075680_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foTB2nUitgUQ7kNvwHYmKMz&_nc_oc=Adp1174ddkUwyrBWeqx9KPmMrNR4h04rduIEUzmIfCCHejUkaH6WxH8JslL7-9c4zRs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0EjNFv43UwPhnWrVN83HvDSkRs94EeP12TzZXKDZcp-w&oe=69F09BBE"}, {"file_name": "Screenshot3.png", "id": "703926541016940", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035421_703926544350273_1667812412201693133_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V75RrXXamS8Q7kNvwFELeJZ&_nc_oc=AdqmYK-AB-ZuZ7HxntnI7Z4uJS4RheD8EZnQk4aTiEoDG0bEf9gfcRXiyapiPDK8biY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1JoLmCTMqENM2i65xL8lW5-KlPN2xmBUZ00bZ9wL6wug&oe=69F0B15B"}, {"file_name": "Screenshot2.png", "id": "280747354144862", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035322_280747357478195_949002718148707032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQuIZKePE7sQ7kNvwFt6bFZ&_nc_oc=AdooTNbNBuA1OgORz8a7Ie820iWmt52MGkJueBN8InUHxgQZzlIoyCB7LJzFrdv7ub8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3TeIL8IYYrABkRewnIa-7kSrQTe5qns_8Tpl3URgVfgA&oe=69F0AD69"}, {"file_name": "menuScreenshot.png", "id": "330249632488876", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75429288_330249635822209_2400290683021814419_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmRg4dmK78sQ7kNvwE-isPD&_nc_oc=Adr-itPtScUtwjLP_zeJqq5kMNhLxOrlBaFG_wyiaJOe_b6f36V2hyuRq3LHrlHw52w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1CK-3Hi9mFXjisxq3AO6gmvb-U_ZLDP0sPAq610Nqo9g&oe=69F0BD2F"}, {"file_name": "NockScreenshots5.png", "id": "346905437312284", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974472_346905440645617_3640611684722686033_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEMjIlVS3eIQ7kNvwFnED9I&_nc_oc=AdqD92ce2SBJiKcm-KET6zjcb0tbJ8n2wDEPLvsMmzhv6nOVRzB-IT5jM3i571aEdOE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3YtHpFvlZy-pnwz_T5-OyX85v5RG9AflbQgsVMx9wpbw&oe=69F0B95F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nock", "keywords": ["soccer", "bow", "archery", "multiplayer", "sports"], "long_description": "Nock is the first real multiplayer sport for VR. Compete in aerial archery soccer matches from anywhere in the world! It's a brand new game that requires coordination, agility, and strategy. Skate and zip around the pitch while using a bow and arrow to blast the ball into the other team's goal. With intuitive controls and realistic physics, Nock is easy to learn but difficult to master.\n\nLike a real sport, this game can take years to master. Block arrows let you create obstacles and you can even use your body to make a goal or save. A fast-moving ball can knock you out. Skill-based matchmaking keeps every game extremely close and competitive. Casual modes let you challenge yourself against bots or play with friends in custom matches.\n\nNock includes voice chat with individual muting options so you can communicate with teammates easily.", "short_description": "Nock is the first real multiplayer sport for VR! It takes the best parts of soccer and archery and combines them into a completely new game. Skate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends!"}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://normcore.io/legal/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": null, "website_url": "https://nock.game/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], 
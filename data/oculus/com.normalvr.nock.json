3l4Q7kNvwEh_HQE&_nc_oc=AdkE4CHDaDw9bqbt7O967mXfxvm9hULdLNR8j7nS_hUtj1Vx97zYbs-VNH7zjd69UXk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvv8fe7WvQKswXIMByX5D5qYeX3k3G6JfazIdYXSJc1EQ&oe=699998BE"}, {"file_name": "Screenshot3.png", "id": "703926541016940", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035421_703926544350273_1667812412201693133_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eB84ZNLzbVIQ7kNvwGy5ctS&_nc_oc=AdknKN5egMGK8FaGFJml-DC4_jQ6ryBkon0Z5ji65LCo3SSGdKBWfS_dQuhy6fQlFO0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv7IRd5esfqcwUtNGmTAPttOB1ThZxN4EisGtwBnisj4A&oe=6999AE5B"}, {"file_name": "Screenshot2.png", "id": "280747354144862", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035322_280747357478195_949002718148707032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrL4EdWSL8oQ7kNvwGmnKJR&_nc_oc=AdmP_dsswMLzEcauhkDITP3-UBglFZA1_Ly7HqHwFQbM-UDkEnsBv5nC4gvJCRRNf9U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvhhzOYnXsrYejvH3HMKixLkVxe7rBR4muFgNhKippVYA&oe=6999AA69"}, {"file_name": "menuScreenshot.png", "id": "330249632488876", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75429288_330249635822209_2400290683021814419_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ML0Z4PuGo20Q7kNvwGLNDRb&_nc_oc=Adl5XdAlYjm3T8uaqjdkDjXI_IsUN2i199D3PH4hJduYA2Bc-cTeoHbZwdDqdUX3OYw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvLMrAQMb_kQn3yrqEycOhpR7yXKoKCKjb6DxTatk3yAA&oe=6999BA2F"}, {"file_name": "NockScreenshots5.png", "id": "346905437312284", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974472_346905440645617_3640611684722686033_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkBZ1LmWhgwQ7kNvwHr0igQ&_nc_oc=AdlrVyRb8PdN0_zJn8NOTZiecI7O-spQFxzJ19cerrHtzFvex5iT0q69juGC45cCZzs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftv1yJTEQFiKMmBlpHWQEe-JgeKpFqaoSUshQuxeVE6pw&oe=6999B65F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nock", "keywords": ["soccer", "bow", "archery", "multiplayer", "sports"], "long_description": "Nock is the first real multiplayer sport for VR. Compete in aerial archery soccer matches from anywhere in the world! It's a brand new game that requires coordination, agility, and strategy. Skate and zip around the pitch while using a bow and arrow to blast the ball into the other team's goal. With intuitive controls and realistic physics, Nock is easy to learn but difficult to master.\n\nLike a real sport, this game can take years to master. Block arrows let you create obstacles and you can even use your body to make a goal or save. A fast-moving ball can knock you out. Skill-based matchmaking keeps every game extremely close and competitive. Casual modes let you challenge yourself against bots or play with friends in custom matches.\n\nNock includes voice chat with individual muting options so you can communicate with teammates easily.", "short_description": "Nock is the first real multiplayer sport for VR! It takes the best parts of soccer and archery and combines them into a completely new game. Skate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends!"}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://normcore.io/legal/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": null, "website_url": "https://nock.game/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended
3l4Q7kNvwG5MWfC&_nc_oc=AdkZs5aK5J4P6OlXhOfvysl9Y8BRV89apHQe_JHfVyIyR3bi2Yxe-IXRT5Llm44J8gY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuziRzyFKafNShtyoKBmewruX3Q-QRWfWC9dCayo9V1TQ&oe=6998473E"}, {"file_name": "Screenshot3.png", "id": "703926541016940", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035421_703926544350273_1667812412201693133_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eB84ZNLzbVIQ7kNvwEzwcq6&_nc_oc=Adl7vUAt134faMb-dmbGzQ9bvVKBXvctAFpMp2Ejcfw3zkjTyBj2F8nt55luI21ankQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfudJ7UOggYGJNiKXZmTyOKig5ZaEnXIrMY9zWMRH60deQ&oe=69985CDB"}, {"file_name": "Screenshot2.png", "id": "280747354144862", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035322_280747357478195_949002718148707032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrL4EdWSL8oQ7kNvwFIDt3J&_nc_oc=AdlD0cOZvZ8I2A_1QNF98fC-obfb1dbY_9kD69_iYEqNyLj1LDtlCp85uf9CrBfqiIE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afub9wueb3l8LOsVCYyXzmfzq21tK_2C95551fmgYeEqVA&oe=699858E9"}, {"file_name": "menuScreenshot.png", "id": "330249632488876", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75429288_330249635822209_2400290683021814419_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ML0Z4PuGo20Q7kNvwGWKBic&_nc_oc=Adl9PxUNcf4Pnhhbi04K7QHg7NT9derX9T9_5xSLPBr89Be5vFFQ6artxP1y33IkHhU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsOxdL3lKXfvqXEAC7pBKuAOmC8xSPr6xNNGTlJoeuJlg&oe=699868AF"}, {"file_name": "NockScreenshots5.png", "id": "346905437312284", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974472_346905440645617_3640611684722686033_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DGSfbAwq5kQ7kNvwEClwI3&_nc_oc=Admz6nbPmig0fnsMXU2ABsw8iwVAEIjjTpon5Lv6OqTXPqjxREZADPSkqZjgfpyJW68&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuZFMfwxqVvzUeGxTzvHN-ZqJUJEzkj9P7oWe_dkHax0A&oe=699864DF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nock", "keywords": ["soccer", "bow", "archery", "multiplayer", "sports"], "long_description": "Nock is the first real multiplayer sport for VR. Compete in aerial archery soccer matches from anywhere in the world! It's a brand new game that requires coordination, agility, and strategy. Skate and zip around the pitch while using a bow and arrow to blast the ball into the other team's goal. With intuitive controls and realistic physics, Nock is easy to learn but difficult to master.\n\nLike a real sport, this game can take years to master. Block arrows let you create obstacles and you can even use your body to make a goal or save. A fast-moving ball can knock you out. Skill-based matchmaking keeps every game extremely close and competitive. Casual modes let you challenge yourself against bots or play with friends in custom matches.\n\nNock includes voice chat with individual muting options so you can communicate with teammates easily.", "short_description": "Nock is the first real multiplayer sport for VR! It takes the best parts of soccer and archery and combines them into a completely new game. Skate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends!"}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://normcore.io/legal/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": null, "website_url": "https://nock.game/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended
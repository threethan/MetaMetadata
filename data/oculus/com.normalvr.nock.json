fh3GwG7kYzuk1CbWBxrp_iEw&oe=69BD3D51"}, {"file_name": "Screenshot3.png", "id": "703926541016940", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035421_703926544350273_1667812412201693133_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhY-qYZpCt4Q7kNvwHVLzYt&_nc_oc=AdlTrxarmzE8_YJzQNAQQ6_8FLSSYEJsJpU6KzVFyywXk8WnbsdUwXYkPPQJZqlkuto&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfziiOQ9t-nkV7JxjmzApx_J9IoGqmJ8xTKHrypoaCaK6Q&oe=69BD46DB"}, {"file_name": "forest2.png", "id": "478533937518445", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974854_478533944185111_7413754463287527069_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CiWW8azdg0IQ7kNvwHIgtFw&_nc_oc=AdlJP4AZ91UVNIgwwQnJNdbKfQoMeb2sjjgq0vxfmxb8j_Js9MUOxN_VkOgDmc-8zJ0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8_lbLG98m863MbwvoxvvnNd0RxHuTcXSgCg5MpXgB3Q&oe=69BD44CA"}, {"file_name": "screenshotCosmic.png", "id": "548185793743298", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974658_548185797076631_6295053414421418954_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3B8dFwqcLYQ7kNvwHZJbFR&_nc_oc=Adk-yM9YRFxRnhMLqFlYgVkKJFjrhNQ6CnyZj3mKoPj70g0qnlNWwV2mvBRQBFYSWBQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz_9dmW8Gz4aneuOBNLv_Zp8MRMkOZX3IJQpaehBX0ooA&oe=69BD577F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nock: Bow + Arrow Soccer", "keywords": ["soccer", "football", "knock", "archery", "gorilla"], "long_description": "Nock is bow and arrow soccer.\n\nSkate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends! \n\nLike a real sport, Nock is easy to learn but difficult to master. Block arrows let you create obstacles and you can even use your body to make a goal or save. A fast-moving ball can knock you out. Skill-based matchmaking keeps every game extremely close and competitive. Casual modes let you challenge yourself against bots or play with friends in custom matches.\n\nNock includes voice chat with individual muting options so you can communicate with teammates easily.", "short_description": "Nock is bow and arrow soccer.\n\nSkate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends!"}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://nock.game/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": null, "website_url": "https://nock.game/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "it", "ja", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7408135945877646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/43997718_883949636446454_2947261530912816551_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5iAsjQ7H0MoQ7kNvwHVzT5L&_nc_oc=AdlEjQax23cqBlZPT22FRiPEe6V5joyV_Y-J_t6EXz-O6ykzR6EPSYmyB95dbag8vG8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7shMxKadoYkh2f_aeIuGk9RemULPYLKCfvL8A6Uj4mw&oe=69BD435F"}, "is_concept": false, "is_test": false, "is_trial_offer
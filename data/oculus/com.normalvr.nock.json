9YoQ7kNvwHiAJG2&_nc_oc=AdlxwJZXGGjuXr3Sed7Jek0_kfU6EWanxVoKS4CM8VpAO4S8z_Gd6UsEZR70KGZX9FE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftnfR191s0A0GiWM__ht4r021B4YQRWf2fK7KUCOqNfGg&oe=69A2D33E"}, {"file_name": "Screenshot3.png", "id": "703926541016940", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035421_703926544350273_1667812412201693133_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=me0vc6ezq1AQ7kNvwF8MGeK&_nc_oc=Adm7U8KXIGyR57WoNUBMLZR273vvtRlj9k3rr2yLKB2pAyhs8sKCIqUEuj7Od-4I5vA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft8sx07fNefFJI439tk557Fi9Ya6Ej93gTsdWpwt1PWOw&oe=69A2E8DB"}, {"file_name": "Screenshot2.png", "id": "280747354144862", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035322_280747357478195_949002718148707032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nqmb_AI_uyEQ7kNvwGJLvBe&_nc_oc=AdkgWIZ8_vbjqavQcjco63WI7kaLoz7BhUB5WUGfKto3q86ZnnCZD95_Z30fd088cVU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuR1mnuNDPygsKjKVBqZCVfsIPm13tDqCoIoCIh1Gt0Ag&oe=69A2E4E9"}, {"file_name": "menuScreenshot.png", "id": "330249632488876", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75429288_330249635822209_2400290683021814419_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvnXvqM0cDIQ7kNvwFW8sy0&_nc_oc=AdmtPWvoFSm0BlcCNG3c1frGPIXvaqLvM95hOidvlHnSQLMrQTA-6kZmmc7M_-tb3ZI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft7ry4VTutz8omCQcF6gfItjQ7lcylJlmQGG6W8pl5yHg&oe=69A2F4AF"}, {"file_name": "NockScreenshots5.png", "id": "346905437312284", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974472_346905440645617_3640611684722686033_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bNn1soLsk8Q7kNvwFSxVcx&_nc_oc=AdmiLgzLZ9ELmgTNAwPxEAit5BBKQuK4p_tAdSMTv8ThIyflwvr0ohSxFyy8u2zeY1I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft-YC5XJKhD-xSMiveyDfg8k-bJx70tTRXHYsq_GYVgjw&oe=69A2F0DF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nock", "keywords": ["soccer", "bow", "archery", "multiplayer", "sports"], "long_description": "Nock is the first real multiplayer sport for VR. Compete in aerial archery soccer matches from anywhere in the world! It's a brand new game that requires coordination, agility, and strategy. Skate and zip around the pitch while using a bow and arrow to blast the ball into the other team's goal. With intuitive controls and realistic physics, Nock is easy to learn but difficult to master.\n\nLike a real sport, this game can take years to master. Block arrows let you create obstacles and you can even use your body to make a goal or save. A fast-moving ball can knock you out. Skill-based matchmaking keeps every game extremely close and competitive. Casual modes let you challenge yourself against bots or play with friends in custom matches.\n\nNock includes voice chat with individual muting options so you can communicate with teammates easily.", "short_description": "Nock is the first real multiplayer sport for VR! It takes the best parts of soccer and archery and combines them into a completely new game. Skate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends!"}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://normcore.io/legal/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": null, "website_url": "https://nock.game/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended
Q3QQ7kNvwHYDRJm&_nc_oc=AdlHIhAwcd5XQ2Nk7YIszGlG_oXEa7RVgupzaIBpwd1qd_O9qEkR5DKWkMAquoldUpA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvNc7oXSC9AErZhtFkJy36auZQdTgL_4lO-ll33ewp3yQ&oe=69A424BE"}, {"file_name": "Screenshot3.png", "id": "703926541016940", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035421_703926544350273_1667812412201693133_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ybj7v2hYdcQ7kNvwEclVJY&_nc_oc=Adk-VKjDc4uHj12fND8Z2Ja79pCGdt8J3k5KjgMLSA9_yf1B2RifmQ2F9vv1UP3rnOk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftNL9Qt_P_x-rv-qDsRAUl2WK5UzqenNcvliGejQYDg2w&oe=69A43A5B"}, {"file_name": "Screenshot2.png", "id": "280747354144862", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035322_280747357478195_949002718148707032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNkXvd2iVuEQ7kNvwEIeUXP&_nc_oc=AdnVSR9L-V_RDKUz0F4I41GyN4bx32HGJjOK4nypessmH4HkAwTwiPahHWPaecD1bP8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftEnnQDizbLKXDK8mWh5mvFWMvs_AytEH0sXBa4974uZQ&oe=69A43669"}, {"file_name": "menuScreenshot.png", "id": "330249632488876", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75429288_330249635822209_2400290683021814419_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-HPXHWehUYQ7kNvwFbbL3G&_nc_oc=Adl6DOd0kxStxdFucmAAIYi3x6Hm30iUtONhCBmoHhA1sSwG0TJHEZGzXHVYbpFBKTI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfscAeKy_PR9CXq-QldE3CMItboeemyLbhsryYkNhGEshg&oe=69A4462F"}, {"file_name": "NockScreenshots5.png", "id": "346905437312284", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974472_346905440645617_3640611684722686033_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bNn1soLsk8Q7kNvwF1yY6A&_nc_oc=Adlo_GjIF6SxYsxGzJ4i4sKS4bM396IZQLkt5GF4Tc7rhn_KMl_J1hSy7nmjZ98NXoU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuN8q_X2nqVmSoL6PL2s1fntWJRrdml2MhA47CzKD_Ngg&oe=69A4425F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nock", "keywords": ["soccer", "bow", "archery", "multiplayer", "sports"], "long_description": "Nock is the first real multiplayer sport for VR. Compete in aerial archery soccer matches from anywhere in the world! It's a brand new game that requires coordination, agility, and strategy. Skate and zip around the pitch while using a bow and arrow to blast the ball into the other team's goal. With intuitive controls and realistic physics, Nock is easy to learn but difficult to master.\n\nLike a real sport, this game can take years to master. Block arrows let you create obstacles and you can even use your body to make a goal or save. A fast-moving ball can knock you out. Skill-based matchmaking keeps every game extremely close and competitive. Casual modes let you challenge yourself against bots or play with friends in custom matches.\n\nNock includes voice chat with individual muting options so you can communicate with teammates easily.", "short_description": "Nock is the first real multiplayer sport for VR! It takes the best parts of soccer and archery and combines them into a completely new game. Skate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends!"}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://normcore.io/legal/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": null, "website_url": "https://nock.game/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended
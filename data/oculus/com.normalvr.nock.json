_name": "Screenshot1.png", "id": "5148178051912784", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003280_5148178055246117_4804780388933075680_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQXA-PgTAXAQ7kNvwF_JQR0&_nc_oc=AdkOHmLNzwN_bCodX49KGveH7hOupN7o2BAba7zU-GnlQ_2g5_-crO6KSVuWjybLH_g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwnuqYPLXmi9IBT8qlOCODI_3CXnYcV6snFZuNhbNEQlQ&oe=69AC0DBE"}, {"file_name": "Screenshot3.png", "id": "703926541016940", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035421_703926544350273_1667812412201693133_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xphtFX77pMQ7kNvwG7GR9O&_nc_oc=AdlkkLvl5TL_86VazMmwql9pwHI0TSApAWpGlwVQg7RKuOyWSssXn9Uiz0_yiHpcby4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxtOexc1ZQewQQqDgu_xUe7ek70uYmpICnenfLNKgFAhw&oe=69AC235B"}, {"file_name": "Screenshot2.png", "id": "280747354144862", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035322_280747357478195_949002718148707032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RP7nEUHhVv4Q7kNvwFGX0B7&_nc_oc=Adl2X_T7FhUOo8Q8ryXD3fPoVhzsNZ2OiJutkHRux0Rx7kK9cry-gw1FuKC1jk8JrM4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxTF6Wus759eec89CMOT6pyLZhMI97bAxqa3AP5Qf6fsw&oe=69AC1F69"}, {"file_name": "menuScreenshot.png", "id": "330249632488876", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75429288_330249635822209_2400290683021814419_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46dNoYkXzi0Q7kNvwERhYZu&_nc_oc=Adkh_dy54soex68nQFS0SRsESJ7BAEBsKtqLHA3H2hSy_b3Ks2ZrrsQAVKQ20McNERo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx-PQ98pnF52DeLrTgHuolnSP67rzXdoKV7SiBFIydfqA&oe=69AC2F2F"}, {"file_name": "NockScreenshots5.png", "id": "346905437312284", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974472_346905440645617_3640611684722686033_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3aqeEMpKcgQ7kNvwECfHpN&_nc_oc=AdkMBP0RVtP3sYO-U4hn21S5D8Aaa-iVLGq0Aq9An9jZWJ7Cslev7fZOtiAvUDYfb_A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5BDGJ_7cussPE4UIekl7Zrfe3kCvwB3zQqm7IPVWm2A&oe=69AC2B5F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nock", "keywords": ["soccer", "bow", "archery", "multiplayer", "sports"], "long_description": "Nock is the first real multiplayer sport for VR. Compete in aerial archery soccer matches from anywhere in the world! It's a brand new game that requires coordination, agility, and strategy. Skate and zip around the pitch while using a bow and arrow to blast the ball into the other team's goal. With intuitive controls and realistic physics, Nock is easy to learn but difficult to master.\n\nLike a real sport, this game can take years to master. Block arrows let you create obstacles and you can even use your body to make a goal or save. A fast-moving ball can knock you out. Skill-based matchmaking keeps every game extremely close and competitive. Casual modes let you challenge yourself against bots or play with friends in custom matches.\n\nNock includes voice chat with individual muting options so you can communicate with teammates easily.", "short_description": "Nock is the first real multiplayer sport for VR! It takes the best parts of soccer and archery and combines them into a completely new game. Skate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends!"}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://normcore.io/legal/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": null, "website_url": "https://nock.game/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context
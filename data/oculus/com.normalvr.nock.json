&_nc_ohc=me0vc6ezq1AQ7kNvwF8MGeK&_nc_oc=Adm7U8KXIGyR57WoNUBMLZR273vvtRlj9k3rr2yLKB2pAyhs8sKCIqUEuj7Od-4I5vA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft8sx07fNefFJI439tk557Fi9Ya6Ej93gTsdWpwt1PWOw&oe=69A2E8DB"}, {"file_name": "forest2.png", "id": "478533937518445", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974854_478533944185111_7413754463287527069_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yySAJ7Zs588Q7kNvwHAjG8O&_nc_oc=AdkrOigsAXipVFCVY9QVZeSDluIJgYj440wOPL3Al_FPTLUg9O9kyomilegJcq02Pok&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvDUXfpSdJfRSb1gy_R4vkBxAAI-dGs2oEdX2iP27vtYQ&oe=69A2E6CA"}, {"file_name": "screenshotCosmic.png", "id": "548185793743298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974658_548185797076631_6295053414421418954_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0-8wY6LQCEQ7kNvwH3N5ko&_nc_oc=AdnAcg2ArnE2QhEZSG_WPlWI5E-7oi9-JBHYMl5QgkO92O4uY0bCECTJWDc1qFM0KeE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftFHU_o2rnbOL14Ibcm-fPuN_L9CZthyQki04JUHIVEjg&oe=69A2F97F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nock: Bow + Arrow Soccer", "keywords": ["soccer", "football", "knock", "archery", "gorilla"], "long_description": "Nock is bow and arrow soccer.\n\nSkate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends! \n\nLike a real sport, Nock is easy to learn but difficult to master. Block arrows let you create obstacles and you can even use your body to make a goal or save. A fast-moving ball can knock you out. Skill-based matchmaking keeps every game extremely close and competitive. Casual modes let you challenge yourself against bots or play with friends in custom matches.\n\nNock includes voice chat with individual muting options so you can communicate with teammates easily.", "short_description": "Nock is bow and arrow soccer.\n\nSkate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends!"}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://nock.game/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": null, "website_url": "https://nock.game/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "it", "ja", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7408135945877646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/43997718_883949636446454_2947261530912816551_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FiAOTHrc8KcQ7kNvwHP1yWS&_nc_oc=Adk6S68mlYN24wkonq76L4nK_YhBtMVtIIXVuPsDHD7jkiSWzjCPQoICqmK1v9NwDkI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftsgVRdegWG5-uzNjW6aqf_yyz605wqmzxyTvcR639Ghw&oe=69A2E55F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Nock: Bow + Arrow Soccer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1646935235, "lastRevision":
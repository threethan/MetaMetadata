SCsQ7kNvwH2XErz&_nc_oc=Adnd3DuMEsjoyw6ajc4CZBjpkqQcHdtzEVYBz5sEB6kIHqWi9hMc6qAmy5qZptgtl7E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsrqmRyhJQmUCddgosk7umtKiKJArY4wqzE_bN1ystKCQ&oe=699EDEBE"}, {"file_name": "Screenshot3.png", "id": "703926541016940", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035421_703926544350273_1667812412201693133_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VES6wDyLcnUQ7kNvwE1PiJS&_nc_oc=AdlwLX6zCCgLuM_ZKppm9p8oKJJwxGIetjtcNghGO8OA2RzyNEhtOLOB93ZpOfP-kGY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuehZjSB5o36KwGeRbLFtjywMYnjoEXYzffKkb7udEulQ&oe=699EF45B"}, {"file_name": "Screenshot2.png", "id": "280747354144862", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035322_280747357478195_949002718148707032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WB0UYksKq4Q7kNvwEgikC8&_nc_oc=AdnTCyOpFFzkGWi6GXTdbbs2IwC_E8i2-AYNOzVrbEEAef2Smipd8S0aDAaIuc2DDY0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfssM8C3mEM3hEy9KYgZHuDunfYLRq83b0dFT3YdA7wa4A&oe=699EF069"}, {"file_name": "menuScreenshot.png", "id": "330249632488876", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75429288_330249635822209_2400290683021814419_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eVqqjdDpq0Q7kNvwErnP94&_nc_oc=AdkKTXTUXBJ6x-IpWIoIcc_eyQa5bUIuZtv-eFXM_3uPUWudvzAEXFO8bzo7IbJ1opM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft6Sv8IEr-g1dzW9UpJcyJ1oYFZ5RVWEihhjjS_Ym4DiQ&oe=699F002F"}, {"file_name": "NockScreenshots5.png", "id": "346905437312284", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974472_346905440645617_3640611684722686033_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJ20sL7pE_kQ7kNvwHQN0vc&_nc_oc=Adm1OHNakzGTL8Hv1jnOWiaRAHKn1TvCTXjjocH4cGbxZDsWxNSjxnuTcVZF2kHK-jI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftwT5-A5A4UwYdwTjC0mSQfSCgsgiyX-HOcWC6EkHDuUw&oe=699EFC5F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nock", "keywords": ["soccer", "bow", "archery", "multiplayer", "sports"], "long_description": "Nock is the first real multiplayer sport for VR. Compete in aerial archery soccer matches from anywhere in the world! It's a brand new game that requires coordination, agility, and strategy. Skate and zip around the pitch while using a bow and arrow to blast the ball into the other team's goal. With intuitive controls and realistic physics, Nock is easy to learn but difficult to master.\n\nLike a real sport, this game can take years to master. Block arrows let you create obstacles and you can even use your body to make a goal or save. A fast-moving ball can knock you out. Skill-based matchmaking keeps every game extremely close and competitive. Casual modes let you challenge yourself against bots or play with friends in custom matches.\n\nNock includes voice chat with individual muting options so you can communicate with teammates easily.", "short_description": "Nock is the first real multiplayer sport for VR! It takes the best parts of soccer and archery and combines them into a completely new game. Skate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends!"}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://normcore.io/legal/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": null, "website_url": "https://nock.game/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended
9YoQ7kNvwEYJWcV&_nc_oc=AdknSecvbto5KDehGn99SkNoc47JeRXKNnaCQWbBsuekKcHmf_HGnAcMNTd_1heDIiA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftDy-tNOn4513Fm6q7piKlC3T0fgpgB7dV0lopuVk_qmg&oe=69A0303E"}, {"file_name": "Screenshot3.png", "id": "703926541016940", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035421_703926544350273_1667812412201693133_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=me0vc6ezq1AQ7kNvwGwvxC3&_nc_oc=AdlziFaqvxdgatMg2FPiffbxz70hsD1V_bjNCaCa5o333VO2ls6xsIjKrdxEU1ZmC18&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuKdoAb-mgvx4k64uxBi_EBMxLbtJldueA-7EhAq1UdSw&oe=69A045DB"}, {"file_name": "Screenshot2.png", "id": "280747354144862", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035322_280747357478195_949002718148707032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nqmb_AI_uyEQ7kNvwEi-Jhy&_nc_oc=AdkRzHPgEMLOhRkCS0v1tulJGj9IQ8dT48yfRTZO1C9JXn39vgHoVZGAICFmoVcF0iI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuqYiRcNJ8oq7zzi_NM6ObtwKLE6eT12LM6k0AydvkZuA&oe=69A041E9"}, {"file_name": "menuScreenshot.png", "id": "330249632488876", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75429288_330249635822209_2400290683021814419_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvnXvqM0cDIQ7kNvwG6e_sL&_nc_oc=AdkQ8iaM8WxS2nPeoQiV2MezLuY1V3Eha0Tt00MlkpNf2nmudoJkviVAo57JkJ2nKZ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsxE-HoMw1IC0AH0Hwmr9WNnA33MwPEAhA4CdbTXQ3ocQ&oe=69A051AF"}, {"file_name": "NockScreenshots5.png", "id": "346905437312284", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974472_346905440645617_3640611684722686033_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJ20sL7pE_kQ7kNvwFl1K81&_nc_oc=Adl3ssqs0TZkc8t8-cixc3wtWbOBQxvtzxP__8emlbLBSbTMuSk7SJCfmma0UYmWbXM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfucEBDlWTvmh6kBTQ4VgzI6xJRmXqDkgw4_Lc5zc90XDQ&oe=69A04DDF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nock", "keywords": ["soccer", "bow", "archery", "multiplayer", "sports"], "long_description": "Nock is the first real multiplayer sport for VR. Compete in aerial archery soccer matches from anywhere in the world! It's a brand new game that requires coordination, agility, and strategy. Skate and zip around the pitch while using a bow and arrow to blast the ball into the other team's goal. With intuitive controls and realistic physics, Nock is easy to learn but difficult to master.\n\nLike a real sport, this game can take years to master. Block arrows let you create obstacles and you can even use your body to make a goal or save. A fast-moving ball can knock you out. Skill-based matchmaking keeps every game extremely close and competitive. Casual modes let you challenge yourself against bots or play with friends in custom matches.\n\nNock includes voice chat with individual muting options so you can communicate with teammates easily.", "short_description": "Nock is the first real multiplayer sport for VR! It takes the best parts of soccer and archery and combines them into a completely new game. Skate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends!"}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://normcore.io/legal/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": null, "website_url": "https://nock.game/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended
hots": [{"file_name": "Screenshot1.png", "id": "5148178051912784", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003280_5148178055246117_4804780388933075680_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foTB2nUitgUQ7kNvwFh2eWd&_nc_oc=AdqFM-g8mUKslm1HwxYX6EFvsAN2Bhmj52SOWZIB5dQh68Q6wVvHQlX6Nw5AaZ3iGQA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af166-wVCtF-Nost9bsgLIjLYfIj_uRdJm4CAjhlTjV7_A&oe=69F1ED3E"}, {"file_name": "Screenshot3.png", "id": "703926541016940", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035421_703926544350273_1667812412201693133_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V75RrXXamS8Q7kNvwGRt_yy&_nc_oc=AdqtjP7696fm8clCXQqc5erQrFwwxeLiKQb6KMdv6YHtQKTX4yZEOA6qkcP10mGzfm8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0Q2ANkktRmtA9-S4okRJlIwaGAoIWyiPyIq_hUFMx0aQ&oe=69F202DB"}, {"file_name": "Screenshot2.png", "id": "280747354144862", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035322_280747357478195_949002718148707032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQuIZKePE7sQ7kNvwGtmrz8&_nc_oc=AdqX4HbZ_fGKaFGkPVIr8xdkyOAtJ3ztJmm2boSkVXHt1U2Q-_s2kowm3jmIQbQlhdo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0CUkU5uuxcfK82jpmP1ZqRxPJvV2BiyrCAF2KORff88g&oe=69F1FEE9"}, {"file_name": "menuScreenshot.png", "id": "330249632488876", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75429288_330249635822209_2400290683021814419_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmRg4dmK78sQ7kNvwGUn2l2&_nc_oc=Adp2940cV0fpOttICzigm0_wssQLnLbbM8ql9b1PeTfVtD5UfLoQDUmZ12md9z1PI5s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2WuWMYojTVHn5tJA6VtEEwXrl1qgzR1l5vvX0UIDl2nQ&oe=69F20EAF"}, {"file_name": "NockScreenshots5.png", "id": "346905437312284", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974472_346905440645617_3640611684722686033_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEMjIlVS3eIQ7kNvwF9Auxh&_nc_oc=AdovSSPImiIedKWuzSYY6turVW_moj_XjzrleaIQ3Tm_MLxf2f1r0u4PCZ9mdukmqnA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ZgoKIMLWRaLN4qML8URm3fvccKE8Gym6zDJHaiWR6lA&oe=69F20ADF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nock", "keywords": ["soccer", "bow", "archery", "multiplayer", "sports"], "long_description": "Nock is the first real multiplayer sport for VR. Compete in aerial archery soccer matches from anywhere in the world! It's a brand new game that requires coordination, agility, and strategy. Skate and zip around the pitch while using a bow and arrow to blast the ball into the other team's goal. With intuitive controls and realistic physics, Nock is easy to learn but difficult to master.\n\nLike a real sport, this game can take years to master. Block arrows let you create obstacles and you can even use your body to make a goal or save. A fast-moving ball can knock you out. Skill-based matchmaking keeps every game extremely close and competitive. Casual modes let you challenge yourself against bots or play with friends in custom matches.\n\nNock includes voice chat with individual muting options so you can communicate with teammates easily.", "short_description": "Nock is the first real multiplayer sport for VR! It takes the best parts of soccer and archery and combines them into a completely new game. Skate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends!"}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://normcore.io/legal/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": null, "website_url": "https://nock.game/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, 
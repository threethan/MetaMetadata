ts": [{"file_name": "Screenshot1.png", "id": "5148178051912784", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39003280_5148178055246117_4804780388933075680_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1m2_4LR8sc4Q7kNvwH31nda&_nc_oc=AdnEodBTfSFUR4pFoGvgFBNxhpdVOfv0mdQU4m-O1ONaQVQ-nrprEhroKWxk2btpEog&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKg9cjGnh044vhX9NnxLaC65300kiKNIwst0Zocyuk4g&oe=69AABC3E"}, {"file_name": "Screenshot3.png", "id": "703926541016940", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035421_703926544350273_1667812412201693133_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1cHb5mJV3sQ7kNvwFq3SAh&_nc_oc=Adm8OQMxImerytvo63YfDpiZ0rbNlO0zUMORQbqCEV9TTkpzwRO5SxAoD1fSoy7P_5A&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxaYg0NGJz1F_ZaL8IjVKL8FM17UVk09sB1VJZPDM1wGQ&oe=69AAD1DB"}, {"file_name": "Screenshot2.png", "id": "280747354144862", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035322_280747357478195_949002718148707032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A01YkXyGTEQQ7kNvwEa-Yb4&_nc_oc=AdmebXT80mdC-pzXC4g8xXTGkgxifnc8dE3EcTy95NQY4MgHMS3zV5C1O7W2Vstke8g&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwnmV3gx8UD5pbo3t8GUjwzSjL3H-nK8kmz1ehuEXVmkA&oe=69AACDE9"}, {"file_name": "menuScreenshot.png", "id": "330249632488876", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75429288_330249635822209_2400290683021814419_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBn7SZ3aQ2UQ7kNvwERv2-a&_nc_oc=Adk6hb4DDXEBp4vlYpuvfnxO-VEj2hxhtbzVgbwn_NXwtDWWKm_TYSlTHzkC2Ga0G0I&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afxi65fEsxzeR9oDQvV5F3FdMrGUgTFZdXvYr5ojaTwCpA&oe=69AADDAF"}, {"file_name": "NockScreenshots5.png", "id": "346905437312284", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974472_346905440645617_3640611684722686033_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3aqeEMpKcgQ7kNvwG3zG85&_nc_oc=AdmpmJiMZ1JG1PS6MNx-WBvIzFA1YFzFLDEsc31aqJmsHrKGVQzLfUKVaDeSmLb99Ss&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxOolsG-h-ofRIrMIDDRnISSHf5DITxw9Wyj76-j-ZzyA&oe=69AAD9DF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nock", "keywords": ["soccer", "bow", "archery", "multiplayer", "sports"], "long_description": "Nock is the first real multiplayer sport for VR. Compete in aerial archery soccer matches from anywhere in the world! It's a brand new game that requires coordination, agility, and strategy. Skate and zip around the pitch while using a bow and arrow to blast the ball into the other team's goal. With intuitive controls and realistic physics, Nock is easy to learn but difficult to master.\n\nLike a real sport, this game can take years to master. Block arrows let you create obstacles and you can even use your body to make a goal or save. A fast-moving ball can knock you out. Skill-based matchmaking keeps every game extremely close and competitive. Casual modes let you challenge yourself against bots or play with friends in custom matches.\n\nNock includes voice chat with individual muting options so you can communicate with teammates easily.", "short_description": "Nock is the first real multiplayer sport for VR! It takes the best parts of soccer and archery and combines them into a completely new game. Skate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends!"}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://normcore.io/legal/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": null, "website_url": "https://nock.game/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAM
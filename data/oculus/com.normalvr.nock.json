&_nc_ohc=eB84ZNLzbVIQ7kNvwEzwcq6&_nc_oc=Adl7vUAt134faMb-dmbGzQ9bvVKBXvctAFpMp2Ejcfw3zkjTyBj2F8nt55luI21ankQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfudJ7UOggYGJNiKXZmTyOKig5ZaEnXIrMY9zWMRH60deQ&oe=69985CDB"}, {"file_name": "forest2.png", "id": "478533937518445", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974854_478533944185111_7413754463287527069_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3C9ThGIT_8Q7kNvwE34TGE&_nc_oc=AdmpcDMyhSutipbHksB_h1WOBRRaxQoRL-QMJK5tIYBcLTiKFfg5S4ibh9kJBHwMqNI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsRmaJXsOer5RwZe1Tw5NLsrXB9_ofqylknTZ3WgydRdQ&oe=69985ACA"}, {"file_name": "screenshotCosmic.png", "id": "548185793743298", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974658_548185797076631_6295053414421418954_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CciOv67JSrsQ7kNvwFzCeQX&_nc_oc=AdlNVM1gzBnkXtxqg4i1lA78HrvgYlQUqggnoNfl21apO6YpgnIYXzmxdFLQbWiDszE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aftl9t5Woz9OYd4bC_YvudVgvm01FpF5qGyDCMnPsC8iQA&oe=69986D7F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nock: Bow + Arrow Soccer", "keywords": ["soccer", "football", "knock", "archery", "gorilla"], "long_description": "Nock is bow and arrow soccer.\n\nSkate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends! \n\nLike a real sport, Nock is easy to learn but difficult to master. Block arrows let you create obstacles and you can even use your body to make a goal or save. A fast-moving ball can knock you out. Skill-based matchmaking keeps every game extremely close and competitive. Casual modes let you challenge yourself against bots or play with friends in custom matches.\n\nNock includes voice chat with individual muting options so you can communicate with teammates easily.", "short_description": "Nock is bow and arrow soccer.\n\nSkate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends!"}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://nock.game/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": null, "website_url": "https://nock.game/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "it", "ja", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7408135945877646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/43997718_883949636446454_2947261530912816551_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8K6-9GSCWYQQ7kNvwF8Zg6h&_nc_oc=AdmZciHcBdC5W6ySj7Cctf56fkzqDY-ulZN5qvJKi92IP53YMh3BLbPn1OYRu8lc6e4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afurkiplp923lXb-BDK4b8hoElQDJHXPPxyPbEz28U72zw&oe=6998595F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Nock: Bow + Arrow Soccer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1646935235, "lastRevision":
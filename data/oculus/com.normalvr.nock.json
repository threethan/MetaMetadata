_name": "Screenshot1.png", "id": "5148178051912784", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003280_5148178055246117_4804780388933075680_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQXA-PgTAXAQ7kNvwFuahsF&_nc_oc=AdlyDfFpahPweWS62mewzK6DO0WiQ68yyneFnENJJlpZ3jHBOCjawBMWJOZXWlvhN8M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXeynuiOsb_N7_rQkqUAWaN5tnALv4D6-ucZDnpWJ2bA&oe=69AD5F3E"}, {"file_name": "Screenshot3.png", "id": "703926541016940", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035421_703926544350273_1667812412201693133_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xphtFX77pMQ7kNvwEkYcdo&_nc_oc=AdlK_j-7DOo6rZc7AgTTP8HKVUEPNwq-262H0Y2a6OZxrDlWKbuZm2fFeEHeZzcd57s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwN95jwDV6BawoKkW4QqntaTIc3UUOcLu-ilZ5c7VdBMQ&oe=69AD74DB"}, {"file_name": "Screenshot2.png", "id": "280747354144862", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035322_280747357478195_949002718148707032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RP7nEUHhVv4Q7kNvwF8w8OK&_nc_oc=Adn-V1bpDqv_ogR7IbMBXMCkAa4Ic2QXW23iXmWxGvzzTL6MGxf5R9kgHPUUIe75k5A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6tFyuMlmhWChK5wfkM1kI25HGoQwRnKKA7ZzAGQQuVA&oe=69AD70E9"}, {"file_name": "menuScreenshot.png", "id": "330249632488876", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75429288_330249635822209_2400290683021814419_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46dNoYkXzi0Q7kNvwFVTW9f&_nc_oc=AdnDm5VXwQ8VOajtp8f6b05o8H282SM0VyPWARbPy7fu0tz-sbp80AAlBV0nZKQevj8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJkuNFE9DMrgihYOq9pRa4GJEmw9dyUMAzeWHcFci08A&oe=69AD80AF"}, {"file_name": "NockScreenshots5.png", "id": "346905437312284", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974472_346905440645617_3640611684722686033_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xc2ZYvPs4AUQ7kNvwGFQc6G&_nc_oc=AdkwsvhWfmLimmkS9cH8pNABLyE-BlcI0Q06pNgvWPh8HXZeYidft_ksJKGf6zdQPQA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfymtZmIxfNbSAU0vUfMDnNySFpY3xsmA2a9GtcmYnsyzQ&oe=69AD7CDF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nock", "keywords": ["soccer", "bow", "archery", "multiplayer", "sports"], "long_description": "Nock is the first real multiplayer sport for VR. Compete in aerial archery soccer matches from anywhere in the world! It's a brand new game that requires coordination, agility, and strategy. Skate and zip around the pitch while using a bow and arrow to blast the ball into the other team's goal. With intuitive controls and realistic physics, Nock is easy to learn but difficult to master.\n\nLike a real sport, this game can take years to master. Block arrows let you create obstacles and you can even use your body to make a goal or save. A fast-moving ball can knock you out. Skill-based matchmaking keeps every game extremely close and competitive. Casual modes let you challenge yourself against bots or play with friends in custom matches.\n\nNock includes voice chat with individual muting options so you can communicate with teammates easily.", "short_description": "Nock is the first real multiplayer sport for VR! It takes the best parts of soccer and archery and combines them into a completely new game. Skate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends!"}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://normcore.io/legal/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": null, "website_url": "https://nock.game/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context
Q3QQ7kNvwE2LGU3&_nc_oc=Adn9DIKZhlnybJieBIlrarzd7PAKr60YipZC8bdtu8AFu0YHOxMUPpC0qRVv2a0ykfc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsaOdzZ4tJqmhRTr_7PdWCp202N8Fo_NMpObUSfNdWjPw&oe=69A6C7BE"}, {"file_name": "Screenshot3.png", "id": "703926541016940", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035421_703926544350273_1667812412201693133_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ybj7v2hYdcQ7kNvwGnE7bu&_nc_oc=AdnpWavBBKXz_mIq5EO1Pmf0Y4hBdmBs7PZ3AfPOChoSOGSYIcBzs_28DggcTv6V5Oo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu--cLNhxPf7uNO4gRzIdPSki7gXroYHcTYksM_yjGeOw&oe=69A6DD5B"}, {"file_name": "Screenshot2.png", "id": "280747354144862", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035322_280747357478195_949002718148707032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNkXvd2iVuEQ7kNvwFBU3o-&_nc_oc=AdnhpVZCtxeaeOGfyTotyvwp2xc3ErXdRzFhoWXhcvUyvXWXZHaILlybgkHU5SbQZws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuXE0bcqajxjXz__IdzBBvaRcFP5EpVD02gyp2fg08meA&oe=69A6D969"}, {"file_name": "menuScreenshot.png", "id": "330249632488876", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75429288_330249635822209_2400290683021814419_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-HPXHWehUYQ7kNvwFABa0s&_nc_oc=Adm9A3DbHXgacFSLqpDZ2OO1iRTXWk0LrogHmVhg8KkrBOFYEmKD9a10cGdfmkJKFJE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuASBOEmVulZXD0y9sDVLCkRaVTHtJs-3qZx0ZjZJGoCw&oe=69A6E92F"}, {"file_name": "NockScreenshots5.png", "id": "346905437312284", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974472_346905440645617_3640611684722686033_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYKWrfYKKQUQ7kNvwEKrqwQ&_nc_oc=AdnyTeoZZ1r9pf53B9H5TmHi_Lg6b0qZX_BiybF6-CkSkEkGQAn2DllFMdwBMg0ccyc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftguuey6eMeSj3hnJ4s-MR-qA1Odw2bpdDIT_atztH5cw&oe=69A6E55F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nock", "keywords": ["soccer", "bow", "archery", "multiplayer", "sports"], "long_description": "Nock is the first real multiplayer sport for VR. Compete in aerial archery soccer matches from anywhere in the world! It's a brand new game that requires coordination, agility, and strategy. Skate and zip around the pitch while using a bow and arrow to blast the ball into the other team's goal. With intuitive controls and realistic physics, Nock is easy to learn but difficult to master.\n\nLike a real sport, this game can take years to master. Block arrows let you create obstacles and you can even use your body to make a goal or save. A fast-moving ball can knock you out. Skill-based matchmaking keeps every game extremely close and competitive. Casual modes let you challenge yourself against bots or play with friends in custom matches.\n\nNock includes voice chat with individual muting options so you can communicate with teammates easily.", "short_description": "Nock is the first real multiplayer sport for VR! It takes the best parts of soccer and archery and combines them into a completely new game. Skate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends!"}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://normcore.io/legal/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": null, "website_url": "https://nock.game/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended
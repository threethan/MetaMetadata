_name": "Screenshot1.png", "id": "5148178051912784", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003280_5148178055246117_4804780388933075680_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQXA-PgTAXAQ7kNvwFpSBDr&_nc_oc=AdlSAVgB6zkWaP1mSSYEMWlimJZgxBnphS1hRbgalUN17wZggDId245oaYfRXaYrm38&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzuUOoujTdWbfuqxZzJ8gZXQoNWa_qj7VfAPpbVjesmpA&oe=69AEB0BE"}, {"file_name": "Screenshot3.png", "id": "703926541016940", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035421_703926544350273_1667812412201693133_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xphtFX77pMQ7kNvwGNnvb_&_nc_oc=Admz8p6VvdVpLvzE0Jfu9W2KJf9BYKlznb0MSfr5kxHavNue6JIGd_XyTFlmipDpBxA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxOv82A0xskequMXWV8h0thGNarENHaojwh5QFZ3vTchQ&oe=69AEC65B"}, {"file_name": "Screenshot2.png", "id": "280747354144862", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035322_280747357478195_949002718148707032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RP7nEUHhVv4Q7kNvwGPgh2F&_nc_oc=Adlln16QnyQaUIt7a8vijlGDVBwu7G6wHXQ2PZemg68NsFg71EqwS5wzqHpAoHgH8ns&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzBEV2A3qATfNRBhyNrTOQ0i_ulSCUgzeq9kWU9udeICg&oe=69AEC269"}, {"file_name": "menuScreenshot.png", "id": "330249632488876", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75429288_330249635822209_2400290683021814419_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46dNoYkXzi0Q7kNvwGYof7q&_nc_oc=AdnwPYyyUl5bguDH_7_4hOgoUP4S5OA4OItrXq7vqmpt_UGrISZ2dWJCq0APzwU2s9U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyhEfLGaLTuRX1737kct2d3L7ymAavK2Mkhsf9migDFDw&oe=69AED22F"}, {"file_name": "NockScreenshots5.png", "id": "346905437312284", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974472_346905440645617_3640611684722686033_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xc2ZYvPs4AUQ7kNvwGn-bGq&_nc_oc=AdkFc1kWrjZYyVeSoXtlVQo6ua801GJuTl8n_63kUhK1h7H1wQsxK_KRPYBnBH8Iuyc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afztc0CHebSIDCHzPjJy8vpo4C8f0WDcn6S3ivaJjvtLDA&oe=69AECE5F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nock", "keywords": ["soccer", "bow", "archery", "multiplayer", "sports"], "long_description": "Nock is the first real multiplayer sport for VR. Compete in aerial archery soccer matches from anywhere in the world! It's a brand new game that requires coordination, agility, and strategy. Skate and zip around the pitch while using a bow and arrow to blast the ball into the other team's goal. With intuitive controls and realistic physics, Nock is easy to learn but difficult to master.\n\nLike a real sport, this game can take years to master. Block arrows let you create obstacles and you can even use your body to make a goal or save. A fast-moving ball can knock you out. Skill-based matchmaking keeps every game extremely close and competitive. Casual modes let you challenge yourself against bots or play with friends in custom matches.\n\nNock includes voice chat with individual muting options so you can communicate with teammates easily.", "short_description": "Nock is the first real multiplayer sport for VR! It takes the best parts of soccer and archery and combines them into a completely new game. Skate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends!"}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://normcore.io/legal/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": null, "website_url": "https://nock.game/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context
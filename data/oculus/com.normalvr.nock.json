UQ2xQYYGnHmt3wKmEfpgp6mg&oe=69BA9A51"}, {"file_name": "Screenshot3.png", "id": "703926541016940", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035421_703926544350273_1667812412201693133_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0eo7t4fw4ZkQ7kNvwEx55Nj&_nc_oc=Adlo0qSC_nDbJ0Zkc_gm0K2Gty0ilQBE3CPqvF-8W4T4xMmtZdgtLJ6nf4DcW6imT-w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw944eSzndIGguKVsWQDKOYwVtcUspbjfdqjf0unU0pkQ&oe=69BAA3DB"}, {"file_name": "forest2.png", "id": "478533937518445", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974854_478533944185111_7413754463287527069_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDcqSdlwF70Q7kNvwEGwdHr&_nc_oc=AdlrpyFLBvT3KA7hzqxfEGlTHnzxoVeIyNyFjvo-Ld4SmMLqFxCb39tECmx_CjawJIM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw801d0v1Tlljs6QT0njCOi9Pkbl_gkkSbLis72ez8DkQ&oe=69BAA1CA"}, {"file_name": "screenshotCosmic.png", "id": "548185793743298", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974658_548185797076631_6295053414421418954_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsQ0F_IaZVEQ7kNvwG5sGD0&_nc_oc=AdmpdJJY5I7RvaD7kWHPpazkxUH3y_HM4BJox6WXQvTfuYPHRlxtpOCCFcj6MPvhwCU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyaK4hhk2CY4y1snlGwI2lew6RIcdvG2fYHaaPMRuYgHQ&oe=69BAB47F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nock: Bow + Arrow Soccer", "keywords": ["soccer", "football", "knock", "archery", "gorilla"], "long_description": "Nock is bow and arrow soccer.\n\nSkate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends! \n\nLike a real sport, Nock is easy to learn but difficult to master. Block arrows let you create obstacles and you can even use your body to make a goal or save. A fast-moving ball can knock you out. Skill-based matchmaking keeps every game extremely close and competitive. Casual modes let you challenge yourself against bots or play with friends in custom matches.\n\nNock includes voice chat with individual muting options so you can communicate with teammates easily.", "short_description": "Nock is bow and arrow soccer.\n\nSkate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends!"}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://nock.game/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": null, "website_url": "https://nock.game/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "it", "ja", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7408135945877646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/43997718_883949636446454_2947261530912816551_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_D2LyAg14YQ7kNvwHoMx78&_nc_oc=AdlSG6iGpu0t2JGid4Hxjx2pZauBnuuUM9ID7K5DemMCWO1Obk5pvx6aDLH5AsELRes&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzF6p8YvAFcNfQ43QOjOqJFkeRoMbUW0xMxSy4-qZji_A&oe=69BAA05F"}, "is_concept": false, "is_test": false, "is_trial_offer
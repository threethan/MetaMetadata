.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpzZp9bhJVIJ3oradZxnZCWY6bbnzrSpfPUU0FEXA9mw&oe=6A7DB851"}, {"file_name": "Screenshot3.png", "id": "703926541016940", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035421_703926544350273_1667812412201693133_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVe4N-adIpIQ7kNvwFJTInN&_nc_oc=AdoIixi3hDze3rXQgysdfjQ5zdF-i507EOdh0BdmJZshqp8Gx--ztk19_ULgSEYPIZY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAZHWhaRIkmRPaiHaJuVHqOj0PK35B3MWxlgVamogjRA&oe=6A7DC1DB"}, {"file_name": "forest2.png", "id": "478533937518445", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974854_478533944185111_7413754463287527069_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czm4iCM2CnUQ7kNvwG_EPdv&_nc_oc=AdonMMGhMwIhtWIeSruGeSts2Cllt5Yf55RT6wJTkWTjY6vEMITxBENf20psYReWF9Q&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRbaniWKZ-1Wvs4PtpaSE4vkeerVOl_lswexPpMz7L4w&oe=6A7DBFCA"}, {"file_name": "screenshotCosmic.png", "id": "548185793743298", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974658_548185797076631_6295053414421418954_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8o5fmo3ELIQ7kNvwF5ubP3&_nc_oc=AdrjRLWoy4KogK_-a12GAI_XeM0B60IGwd0k_Xo-2-EKAdDEsqm0LCu28m5Sfn9PnVo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFc9BawZVQBJDlRexZV1940gEjfboD5KFLKC59oCbk5dQ&oe=6A7D9A3F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nock: Bow + Arrow Soccer", "keywords": ["soccer", "football", "knock", "archery", "gorilla"], "long_description": "Nock is bow and arrow soccer.\n\nSkate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends! \n\nLike a real sport, Nock is easy to learn but difficult to master. Block arrows let you create obstacles and you can even use your body to make a goal or save. A fast-moving ball can knock you out. Skill-based matchmaking keeps every game extremely close and competitive. Casual modes let you challenge yourself against bots or play with friends in custom matches.\n\nNock includes voice chat with individual muting options so you can communicate with teammates easily.", "short_description": "Nock is bow and arrow soccer.\n\nSkate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends!"}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://nock.game/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": null, "website_url": "https://nock.game/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "it", "ja", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7408135945877646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/43997718_883949636446454_2947261530912816551_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdRPkT8WVvsQ7kNvwHZJUGE&_nc_oc=AdqFrrf9VLzoUy8u6O7A3RC86vzVM-FajqoTyOGrMw2nLalOnLXjhYL46NDnsq5ufbs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvUA_HE7pCmz6-unP89XNpH3Idj-lUMUaGWILT0W
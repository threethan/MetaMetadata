&_nc_ohc=5ybj7v2hYdcQ7kNvwEclVJY&_nc_oc=Adk-VKjDc4uHj12fND8Z2Ja79pCGdt8J3k5KjgMLSA9_yf1B2RifmQ2F9vv1UP3rnOk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftNL9Qt_P_x-rv-qDsRAUl2WK5UzqenNcvliGejQYDg2w&oe=69A43A5B"}, {"file_name": "forest2.png", "id": "478533937518445", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974854_478533944185111_7413754463287527069_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Khon3z-rM9wQ7kNvwFzHLS6&_nc_oc=AdncGy1hYRCjnq6qq11DWp_SOjhBX09F_FXk9WKn318IxV1mC6ZF_i2wvHkGofBVqaM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu0puVM6l0hT3Hq4KhDLZlYNbJ2PwN63AvTvlfHQT4Hcw&oe=69A4384A"}, {"file_name": "screenshotCosmic.png", "id": "548185793743298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974658_548185797076631_6295053414421418954_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rqtDcF2DsEQ7kNvwH7S5Vl&_nc_oc=Admv9dPz79b-hN-hkExciC55ws0CPMbbfJ3g51-Wb1alW4aYtRWiEw-OsVV1H4Zrdes&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu3Ls8dERUQspjSHsRrPLdeFO1BIdZzYRm7oonoE8fdVA&oe=69A44AFF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nock: Bow + Arrow Soccer", "keywords": ["soccer", "football", "knock", "archery", "gorilla"], "long_description": "Nock is bow and arrow soccer.\n\nSkate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends! \n\nLike a real sport, Nock is easy to learn but difficult to master. Block arrows let you create obstacles and you can even use your body to make a goal or save. A fast-moving ball can knock you out. Skill-based matchmaking keeps every game extremely close and competitive. Casual modes let you challenge yourself against bots or play with friends in custom matches.\n\nNock includes voice chat with individual muting options so you can communicate with teammates easily.", "short_description": "Nock is bow and arrow soccer.\n\nSkate and fly around a pitch while using a bow and arrow to blast the ball into the other team\u2019s goal. Compete in multiplayer ranked matches, or play casual custom games with your friends!"}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://nock.game/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": null, "website_url": "https://nock.game/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "it", "ja", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7408135945877646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/43997718_883949636446454_2947261530912816551_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Po3mEVVqNh4Q7kNvwEoaKW4&_nc_oc=AdlUppM0LF7Gjs9bzzv-PmwLHKXUxVeLYcA06FdLEKFCSbwR5VI9lyUyalyAW_3j24s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft-kD2zcl9KtB3OGBrRVgya1Olp9wEikTgOCBQl0ujiJA&oe=69A436DF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Nock: Bow + Arrow Soccer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1646935235, "lastRevision":
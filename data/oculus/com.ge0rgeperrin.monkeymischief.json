f20f&oh=00_AQKiWrYYBeoKP6wALURpZCnwXnZlK6xmYlNUa2CP132asA&oe=6AAD3D7D"}, {"file_name": "WatchingFromTrees.png", "id": "515361217959292", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982629_515361221292625_8502173092952948767_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81RJ-OMf3EoQ7kNvwHvJdAb&_nc_oc=AdpwyVxOFgWNfklFM-jEvz71BSqkSK--h3yGzP_hvzDXTwAOxafwtM698BC8gfy6-cU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ06k2UZDeu1GsrYGk7m1cJyxR49i2vg90Nrl7K9hF_5g&oe=6AAD59F4"}, {"file_name": "HorrorGenerator.png", "id": "506730092199699", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982570_506730095533032_1036290241158275574_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5O-qZK6p-UQ7kNvwHEMY61&_nc_oc=AdpVYUpswU9N8ctcr-X2_020mSD3f4g7Qgyqres3yIQqzrj6jrNccVFmmopczu7AoYg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPDa4q5rXy-1j5DDCQxJA-fI5czO0AbR9I_ARKvqAm3w&oe=6AAD4C45"}, {"file_name": "Mall.png", "id": "1096133269186763", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035304_1096133272520096_3251845521029510751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4SFaws3E5wQ7kNvwE5F3cE&_nc_oc=AdrrLvzsi2m74pSKvMcvCANEn41g0op67H_AxfsFgm8zVuwhHmmxNn6XK8oLLVvKqJw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJZAwxNFldv1G5W0qNzcWe_GM3mk9dtzOfd66RbbUuWw&oe=6AAD4C94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LegacyTrailerCover.png", "id": "924576899550762", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75250461_924576906217428_8652467691312870474_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZkyntWYEFcQ7kNvwEtt-mZ&_nc_oc=AdohA9AhG_QNtbqAatpA0ZK2_xlVnkl9TQkncz6jb-ZRkMWlBZeY_q2yRAQPFW1jq8s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnls7LyVfq4wXHf4L8r-mLLdcRudyOUhdKKO46quJIGw&oe=6AAD5B92"}, "display_name": "Monkey Mischief", "keywords": ["monkey", "gorilla", "vr", "party", "mischief"], "long_description": "Welcome to Monkey Mischief. The game that has little bits of everything.\n\nThere are three game modes, with more to come in the future, that are playable in all three maps! Fly like a high speed racing car across the map with friends, climb mountains to get away from rising lava, or run from two spider-monkey twins with tentacles in a underground advanced cave system!\n\nYou can even scale multiple trees at once, do backflips on trampolines, or explore the Mischievous Mall, where more then 30 cosmetics are for sale to wear on your physical VR character!\n\nOr, you can explore the Horror maps that has three upcoming levels, all scaling higher in atmosphere, and lowering your sanity.\n \nNo matter what you do, it's ensured you will have fun!", "short_description": "Monkey Mischief is a online multiplayer VR game that is dependent on the locomotion of your hands. Run to the top of the mountains when lava is rising, fly like a racing car across the map with friends, or run from two twins with tentacles in a underground advanced cave system!"}]}, "developer_name": "GRP Games LTD", "developer_privacy_policy_url": "https://www.termsfeed.com/live/96ad8549-f44a-4029-a271-842b5a2e688c", "developer_terms_of_service_url": null, "publisher_name": "GRP Games LTD", "support_website_url": null, "website_url": "https://getagames.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "pl", "fr", "de", "da", "sv"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "
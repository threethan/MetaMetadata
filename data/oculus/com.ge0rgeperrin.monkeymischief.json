f20f&oh=00_AQOx4Ufs4mntG3qiLahMiH6qXsw86hLRdWEcKjGp4qPsmw&oe=6ACA76BD"}, {"file_name": "WatchingFromTrees.png", "id": "515361217959292", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982629_515361221292625_8502173092952948767_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rj3UeizP4YQQ7kNvwGhmSvG&_nc_oc=AdqzFlnmGNpN4nY7wie9KvZfiOPs-rXz-V2yCH0XY3CRWEJBQvMVqa5Hs_cN1MLesUo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_GmyxnETkAMnwvjYKyIQp618ctt_OrsucWOM62M1XuQ&oe=6ACA5AF4"}, {"file_name": "HorrorGenerator.png", "id": "506730092199699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982570_506730095533032_1036290241158275574_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YIy7e59HZ0Q7kNvwHhDziJ&_nc_oc=Adp68nX0G5dlAzls18htxElWZIT6w76Os0YKEU-nX7Ql7n8FbKFVMB8D-Bk2lO9g81I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3BKlx9h5vu40BJEIWfY_Yzg5E6AY6GS4ADplQDMxsOQ&oe=6ACA4D45"}, {"file_name": "Mall.png", "id": "1096133269186763", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035304_1096133272520096_3251845521029510751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTs2Bln4dWcQ7kNvwHnIV7u&_nc_oc=AdqC1JKhuhVuiaE_7hXsEFk0ebhZJpv9fl1RZDd2SYvuKFSTKKhWgYshEJVbpp-YSlY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtAc5-GGxpRIP0IWMlZJma8HcBDz3DG1cCfSwOMBaXgA&oe=6ACA4D94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LegacyTrailerCover.png", "id": "924576899550762", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75250461_924576906217428_8652467691312870474_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZN4EZ3QB8A4Q7kNvwGbjow8&_nc_oc=Adoe6g9_FF4OMOwq_Ht0KjppCd2uOAQanEu0a7KVGkzv7zGC_Yia8uwRSb_xbt_zXGs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYm2GZGmYMCCtU1qnm670f4sUPpUivOoHOmfOf6Bf2rA&oe=6ACA5C92"}, "display_name": "Monkey Mischief", "keywords": ["monkey", "gorilla", "vr", "party", "mischief"], "long_description": "Welcome to Monkey Mischief. The game that has little bits of everything.\n\nThere are three game modes, with more to come in the future, that are playable in all three maps! Fly like a high speed racing car across the map with friends, climb mountains to get away from rising lava, or run from two spider-monkey twins with tentacles in a underground advanced cave system!\n\nYou can even scale multiple trees at once, do backflips on trampolines, or explore the Mischievous Mall, where more then 30 cosmetics are for sale to wear on your physical VR character!\n\nOr, you can explore the Horror maps that has three upcoming levels, all scaling higher in atmosphere, and lowering your sanity.\n \nNo matter what you do, it's ensured you will have fun!", "short_description": "Monkey Mischief is a online multiplayer VR game that is dependent on the locomotion of your hands. Run to the top of the mountains when lava is rising, fly like a racing car across the map with friends, or run from two twins with tentacles in a underground advanced cave system!"}]}, "developer_name": "GRP Games LTD", "developer_privacy_policy_url": "https://www.termsfeed.com/live/96ad8549-f44a-4029-a271-842b5a2e688c", "developer_terms_of_service_url": null, "publisher_name": "GRP Games LTD", "support_website_url": null, "website_url": "https://getagames.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "pl", "fr", "de", "da", "sv"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "
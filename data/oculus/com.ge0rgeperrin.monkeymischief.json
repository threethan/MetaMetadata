f20f&oh=00_AQT4cZsExSeHSvT2S262MBn85o7j100flxHZawq4seSMhw&oe=6AF5BFFD"}, {"file_name": "WatchingFromTrees.png", "id": "515361217959292", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982629_515361221292625_8502173092952948767_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mx9KOi2lXZ8Q7kNvwFTcJBk&_nc_oc=Adr126x-e7RFC2RjPfPSiorw5vDk-8U7zeOuZKjz42KuuVv5biu1o2bVHJxE-ODI1nc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXYUAKkFBkdPD5EDIrDZpVZgH4oDuOsRyyEoHI5Pzy3A&oe=6AF5DC74"}, {"file_name": "HorrorGenerator.png", "id": "506730092199699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982570_506730095533032_1036290241158275574_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMolf1KxkD4Q7kNvwFF7iS_&_nc_oc=AdpDBtj66GSgBMkXrKQmNQ4KQsJn7tdHCCPrZYQ6SLerZf8lr71Vp-kaN9IloAp0hmg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu19XSZZjzuR_7zmUOi2fpAXLv5Z9pQ7fsanjp4P3c-A&oe=6AF5CEC5"}, {"file_name": "Mall.png", "id": "1096133269186763", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035304_1096133272520096_3251845521029510751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qmp94YTBoj4Q7kNvwHBbjHJ&_nc_oc=Adoh5j23_1cI-Dz88JGamOD_YsHcGhvkDC7tnCDQvJ2pVYzPuMnLCfMFZC3sAffoI9k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkJr6oAk5GeS1VcuZm0YIh4GhyqIOVv71ChrSeFTtQww&oe=6AF5CF14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LegacyTrailerCover.png", "id": "924576899550762", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75250461_924576906217428_8652467691312870474_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeCqduS3D-MQ7kNvwEtOVLf&_nc_oc=AdrM72fegj0BQTBqmR2y-dnQIcWlzeX1wykcC1dUwKKka_rrJZ8XurxnzsgX8VZcX-Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7dZnzhJZxPTrIy_Zs7qlHUMdXVKwALDif18G0aohfwA&oe=6AF5DE12"}, "display_name": "Monkey Mischief", "keywords": ["monkey", "gorilla", "vr", "party", "mischief"], "long_description": "Welcome to Monkey Mischief. The game that has little bits of everything.\n\nThere are three game modes, with more to come in the future, that are playable in all three maps! Fly like a high speed racing car across the map with friends, climb mountains to get away from rising lava, or run from two spider-monkey twins with tentacles in a underground advanced cave system!\n\nYou can even scale multiple trees at once, do backflips on trampolines, or explore the Mischievous Mall, where more then 30 cosmetics are for sale to wear on your physical VR character!\n\nOr, you can explore the Horror maps that has three upcoming levels, all scaling higher in atmosphere, and lowering your sanity.\n \nNo matter what you do, it's ensured you will have fun!", "short_description": "Monkey Mischief is a online multiplayer VR game that is dependent on the locomotion of your hands. Run to the top of the mountains when lava is rising, fly like a racing car across the map with friends, or run from two twins with tentacles in a underground advanced cave system!"}]}, "developer_name": "GRP Games LTD", "developer_privacy_policy_url": "https://www.termsfeed.com/live/96ad8549-f44a-4029-a271-842b5a2e688c", "developer_terms_of_service_url": null, "publisher_name": "GRP Games LTD", "support_website_url": null, "website_url": "https://getagames.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "pl", "fr", "de", "da", "sv"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "
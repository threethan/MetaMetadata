f20f&oh=00_AQKDHCZtb8h-4omY9b06kQ_YOx6wO2ziX1KHptOeQ1YvGQ&oe=6AAFE07D"}, {"file_name": "WatchingFromTrees.png", "id": "515361217959292", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982629_515361221292625_8502173092952948767_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhpIUmnO4CIQ7kNvwEZPczJ&_nc_oc=Adovz320H8oN2eEGKLpM-WdxmEcjKDYf4hmnzY0XPN5rvrAuQFr63RgCg0aikUNVVYA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-5D1_VHM3J-J6V7zAX594r06QWupfTXEtl9T4ajSkrg&oe=6AAFFCF4"}, {"file_name": "HorrorGenerator.png", "id": "506730092199699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982570_506730095533032_1036290241158275574_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbmqF8SaFEwQ7kNvwH_xvTO&_nc_oc=Adpvd0Xuwm_59rHmzeuZUcILekfxI3G5mVmzkl7a5kTVDtDHq8_LiMSVDtQpLbX1W2c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKn9cpaKoQCCoFjtFVJFd0m2bOZPyHpWtg8mOpt9YpiHw&oe=6AAFEF45"}, {"file_name": "Mall.png", "id": "1096133269186763", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035304_1096133272520096_3251845521029510751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4SFaws3E5wQ7kNvwEupRTy&_nc_oc=Adq6oy2Pc5VgV9Gdc1LsBFeRHksBRp7JQHXxHe7X2UOKzJ5XLiByZ3M-US9k5Ometts&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIi2i8Qlq8NgT4OxCTKebPSOEI9ItcvMw_aU-RsIoA3Ew&oe=6AAFEF94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LegacyTrailerCover.png", "id": "924576899550762", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75250461_924576906217428_8652467691312870474_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMe4r6dD-UYQ7kNvwH6CHgu&_nc_oc=AdpJH-DTBQdAO1C6rXVUhGLmL2AF15Xtp8-vWwPfvZb1mh6i0AW-CqLiL6U9ZBUrKQE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRNWCniW3ch2-y08ZSwD0X91HUUH-JAAifc05DoMBAYA&oe=6AAFFE92"}, "display_name": "Monkey Mischief", "keywords": ["monkey", "gorilla", "vr", "party", "mischief"], "long_description": "Welcome to Monkey Mischief. The game that has little bits of everything.\n\nThere are three game modes, with more to come in the future, that are playable in all three maps! Fly like a high speed racing car across the map with friends, climb mountains to get away from rising lava, or run from two spider-monkey twins with tentacles in a underground advanced cave system!\n\nYou can even scale multiple trees at once, do backflips on trampolines, or explore the Mischievous Mall, where more then 30 cosmetics are for sale to wear on your physical VR character!\n\nOr, you can explore the Horror maps that has three upcoming levels, all scaling higher in atmosphere, and lowering your sanity.\n \nNo matter what you do, it's ensured you will have fun!", "short_description": "Monkey Mischief is a online multiplayer VR game that is dependent on the locomotion of your hands. Run to the top of the mountains when lava is rising, fly like a racing car across the map with friends, or run from two twins with tentacles in a underground advanced cave system!"}]}, "developer_name": "GRP Games LTD", "developer_privacy_policy_url": "https://www.termsfeed.com/live/96ad8549-f44a-4029-a271-842b5a2e688c", "developer_terms_of_service_url": null, "publisher_name": "GRP Games LTD", "support_website_url": null, "website_url": "https://getagames.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "pl", "fr", "de", "da", "sv"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "
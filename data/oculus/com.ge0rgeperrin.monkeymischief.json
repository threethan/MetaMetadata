f20f&oh=00_AQPM7Ch-hFDF4ZkmnHYGd8nbjaF6BJLjrPgWTGPMakimzQ&oe=6ADCB37D"}, {"file_name": "WatchingFromTrees.png", "id": "515361217959292", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982629_515361221292625_8502173092952948767_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbaArOLvg7AQ7kNvwHcbivL&_nc_oc=Adpjvyzz0GPbDQrfsWlLZ-Vvch9Z4jV7mKHBgWw9ue5tfpF_sYHyT6agTsODAzt-Z1E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlzSb7H1Aci92GHg0eQqWE4BLg8zz_YMmR45BtmQvmAw&oe=6ADCCFF4"}, {"file_name": "HorrorGenerator.png", "id": "506730092199699", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982570_506730095533032_1036290241158275574_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjNrV8T-0i0Q7kNvwEMsEtw&_nc_oc=AdoAk5yvKNqsX4vIYvjQDGr4X6eUet-1NmgJZvSumwJUnCJbTzId7h1OKZkE7Dbhp_I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVST-l0aso1rhzfv3zIXU7-Qf0qopHZ9VGCvOO-oBZUQ&oe=6ADCC245"}, {"file_name": "Mall.png", "id": "1096133269186763", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035304_1096133272520096_3251845521029510751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02ODZu9XcHoQ7kNvwHHpo7n&_nc_oc=AdqXFfLazJeliDyZN1sLu9Pq9hxpILNiZtp7r_NpjiwCBJfLHEP8rfrcmFRXkb9_I8s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNd4x_saBuhN2fcimPm3i6cZl3jbKTM9gyhiJ2NSKiRfg&oe=6ADCC294"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LegacyTrailerCover.png", "id": "924576899550762", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75250461_924576906217428_8652467691312870474_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZYK5GDGs68Q7kNvwFjynVB&_nc_oc=AdpaEmawWYtyXmLM8FwmY_s65mccSwhQ8GADldaL1zmYMjgI7COoC2Inj-12kBSLI_M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJz8K7jTLdLDzGatLZYEnExJZAjKBNmj4CAGEDpxtewg&oe=6ADCD192"}, "display_name": "Monkey Mischief", "keywords": ["monkey", "gorilla", "vr", "party", "mischief"], "long_description": "Welcome to Monkey Mischief. The game that has little bits of everything.\n\nThere are three game modes, with more to come in the future, that are playable in all three maps! Fly like a high speed racing car across the map with friends, climb mountains to get away from rising lava, or run from two spider-monkey twins with tentacles in a underground advanced cave system!\n\nYou can even scale multiple trees at once, do backflips on trampolines, or explore the Mischievous Mall, where more then 30 cosmetics are for sale to wear on your physical VR character!\n\nOr, you can explore the Horror maps that has three upcoming levels, all scaling higher in atmosphere, and lowering your sanity.\n \nNo matter what you do, it's ensured you will have fun!", "short_description": "Monkey Mischief is a online multiplayer VR game that is dependent on the locomotion of your hands. Run to the top of the mountains when lava is rising, fly like a racing car across the map with friends, or run from two twins with tentacles in a underground advanced cave system!"}]}, "developer_name": "GRP Games LTD", "developer_privacy_policy_url": "https://www.termsfeed.com/live/96ad8549-f44a-4029-a271-842b5a2e688c", "developer_terms_of_service_url": null, "publisher_name": "GRP Games LTD", "support_website_url": null, "website_url": "https://getagames.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "pl", "fr", "de", "da", "sv"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "
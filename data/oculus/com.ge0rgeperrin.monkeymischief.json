f20f&oh=00_AQJx5AecBkQDqBOpkYVbRnkI5y3EWYoFth64qQkLvdd0Iw&oe=6AB5267D"}, {"file_name": "WatchingFromTrees.png", "id": "515361217959292", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982629_515361221292625_8502173092952948767_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHhCr6A1raUQ7kNvwHy3yxV&_nc_oc=AdpIsrPokV_G2vXDPD7jyIte9BIshhJ7gt7kqaJ1Nk0ATvrsIDkPPo8oOw_bShicmCY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUj3ufcC2L1B9ghq_B3qPn6o6J256JiuTRRVZqvMYmeg&oe=6AB542F4"}, {"file_name": "HorrorGenerator.png", "id": "506730092199699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982570_506730095533032_1036290241158275574_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDtN3HCY_QYQ7kNvwFNbqk1&_nc_oc=Ado-X2E_g0ixzJp8H7xb5dx51MtFJTJa_YOmuNrXrWv5VOikTww_L1XhQxtrFN8k3SU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2lurAGdW7ilBB16J1yJfo6u3fI1yM9vq3V-tcjV5BWw&oe=6AB53545"}, {"file_name": "Mall.png", "id": "1096133269186763", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035304_1096133272520096_3251845521029510751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMQMDHTxnNoQ7kNvwHmf-XG&_nc_oc=AdqC7dgqpEpm8Wlr4jBJ1cfB97zC868p7TGjTDtddX7LnWKc0pUAib0UkhzrnbpFYx8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK201sPiXBYnCPI2yuFe8RigjbS9vBkHNN8PtuLSqtYAg&oe=6AB53594"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LegacyTrailerCover.png", "id": "924576899550762", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75250461_924576906217428_8652467691312870474_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmjyMEUc7AsQ7kNvwH6r0Jw&_nc_oc=Adq1or10qvqi4PpXQNyaPcayo75ZdGcRDceqRf-0W0IrIhQGtYb34AnfDU30jQ53NXc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWKbLr-56-Xk7Chd_qeEETfGpAzvFSqJlBqsqtDDeclw&oe=6AB54492"}, "display_name": "Monkey Mischief", "keywords": ["monkey", "gorilla", "vr", "party", "mischief"], "long_description": "Welcome to Monkey Mischief. The game that has little bits of everything.\n\nThere are three game modes, with more to come in the future, that are playable in all three maps! Fly like a high speed racing car across the map with friends, climb mountains to get away from rising lava, or run from two spider-monkey twins with tentacles in a underground advanced cave system!\n\nYou can even scale multiple trees at once, do backflips on trampolines, or explore the Mischievous Mall, where more then 30 cosmetics are for sale to wear on your physical VR character!\n\nOr, you can explore the Horror maps that has three upcoming levels, all scaling higher in atmosphere, and lowering your sanity.\n \nNo matter what you do, it's ensured you will have fun!", "short_description": "Monkey Mischief is a online multiplayer VR game that is dependent on the locomotion of your hands. Run to the top of the mountains when lava is rising, fly like a racing car across the map with friends, or run from two twins with tentacles in a underground advanced cave system!"}]}, "developer_name": "GRP Games LTD", "developer_privacy_policy_url": "https://www.termsfeed.com/live/96ad8549-f44a-4029-a271-842b5a2e688c", "developer_terms_of_service_url": null, "publisher_name": "GRP Games LTD", "support_website_url": null, "website_url": "https://getagames.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "pl", "fr", "de", "da", "sv"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "
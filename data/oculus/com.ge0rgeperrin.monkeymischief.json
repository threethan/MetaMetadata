f20f&oh=00_AQNfsK3DpCI-UdG9Pk5FBoRyVZCeWOKlJ4ryBabIMNa6rQ&oe=6AC649FD"}, {"file_name": "WatchingFromTrees.png", "id": "515361217959292", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982629_515361221292625_8502173092952948767_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GuJs6YjGdl8Q7kNvwF6yWtB&_nc_oc=Adq0VL_YcvRaIIkYVYwFHNqrg-5JMqNusXu4mTIqy84PtWa_sHuDetjw6TomubLaFbo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYQBDLgUoooPl9q14rtWjHjii6KtsOo2_0CIa1UHiuUQ&oe=6AC66674"}, {"file_name": "HorrorGenerator.png", "id": "506730092199699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982570_506730095533032_1036290241158275574_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dRD4zCqKMEQ7kNvwGSFpTp&_nc_oc=Adp297N1lU6d23-eox-ViXglNm_BinYmIgIPmnYI8RT-yXvlurtj-yyD6Kt-L-nEeeI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFKD5tVN6YndoPJtYRrn4sNaQ-20fKeQB6xbvg7XSmYw&oe=6AC658C5"}, {"file_name": "Mall.png", "id": "1096133269186763", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035304_1096133272520096_3251845521029510751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UN3XBqlj9-UQ7kNvwF1E2ad&_nc_oc=AdpC45C9Xw2P9ppQ1msL7N9F_CRvtxzocB2Na3N1Czj9Cjh7GTDg2EcJs_DYYjaokNA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPMCU1TNJ7pwMbtlWdyyQS1YcDeJ_34KgCJoziP4Ielw&oe=6AC65914"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LegacyTrailerCover.png", "id": "924576899550762", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75250461_924576906217428_8652467691312870474_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awYb3LiMGXwQ7kNvwG8sVzA&_nc_oc=AdrhaPrCqcMZpTWlUkbKl2AvqkEDRDRAzipyB-htVyS9LQA5tQvxSrvOszF3Dt6gc4g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgxeQM1drf0EEf0zeGFeA4l1B36-YMC5tpEjXMvw-Edw&oe=6AC66812"}, "display_name": "Monkey Mischief", "keywords": ["monkey", "gorilla", "vr", "party", "mischief"], "long_description": "Welcome to Monkey Mischief. The game that has little bits of everything.\n\nThere are three game modes, with more to come in the future, that are playable in all three maps! Fly like a high speed racing car across the map with friends, climb mountains to get away from rising lava, or run from two spider-monkey twins with tentacles in a underground advanced cave system!\n\nYou can even scale multiple trees at once, do backflips on trampolines, or explore the Mischievous Mall, where more then 30 cosmetics are for sale to wear on your physical VR character!\n\nOr, you can explore the Horror maps that has three upcoming levels, all scaling higher in atmosphere, and lowering your sanity.\n \nNo matter what you do, it's ensured you will have fun!", "short_description": "Monkey Mischief is a online multiplayer VR game that is dependent on the locomotion of your hands. Run to the top of the mountains when lava is rising, fly like a racing car across the map with friends, or run from two twins with tentacles in a underground advanced cave system!"}]}, "developer_name": "GRP Games LTD", "developer_privacy_policy_url": "https://www.termsfeed.com/live/96ad8549-f44a-4029-a271-842b5a2e688c", "developer_terms_of_service_url": null, "publisher_name": "GRP Games LTD", "support_website_url": null, "website_url": "https://getagames.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "pl", "fr", "de", "da", "sv"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "
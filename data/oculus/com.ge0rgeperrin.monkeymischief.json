f20f&oh=00_AQP5QdlLACV1bIZve4ah4BOf5anaSxVhl7sXbuA3izFFUA&oe=6AE34AFD"}, {"file_name": "WatchingFromTrees.png", "id": "515361217959292", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982629_515361221292625_8502173092952948767_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcqlOkf_Fd4Q7kNvwFNWJGC&_nc_oc=AdrkZgIHX24FV2JiCLStBL4eHnjcyyGH1OmPRqZsk0KvLbM3NP2o9qpoGWcbKZd1zZM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKGl6qc3mSnqM_e3Lw0uNSx17oPnnVV3eNlRwabH_tvg&oe=6AE36774"}, {"file_name": "HorrorGenerator.png", "id": "506730092199699", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982570_506730095533032_1036290241158275574_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPJbmiHUTx0Q7kNvwExm4ET&_nc_oc=AdodOlEqD0dD8lh6CdENEaRbb9ahB8dgnd7iS9UegGZnohiJguxdbZHeYZEyKpnQB48&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5BMCW2HcYQF8qq8RMaqHu_oh01Jz_SGzBuT3CUs4GiQ&oe=6AE359C5"}, {"file_name": "Mall.png", "id": "1096133269186763", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035304_1096133272520096_3251845521029510751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMA8lQt5Y1IQ7kNvwHEoL-O&_nc_oc=Ado1uy0IfaQ04ihj_hxy90r9_-Rw6WhwGe6r8m9t_8IQF0fYhPgE6ZbGIk60WPomhG8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdiadwqD8zjlknFy6hLlTA4yLpliGx28L3pmIOYZh6_Q&oe=6AE35A14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LegacyTrailerCover.png", "id": "924576899550762", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75250461_924576906217428_8652467691312870474_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8FFDE6LKyoQ7kNvwHahN43&_nc_oc=Ado3IwZN62hgkV6DGMO-WKCkm8TMtLYrRxm6EctzG1-Ow4lby3Q7M7zR1yheN9F9_zw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_dNj4Ee_VERuZ3v5ovKSj6xEtWLwbPtPpxINgB5jogA&oe=6AE36912"}, "display_name": "Monkey Mischief", "keywords": ["monkey", "gorilla", "vr", "party", "mischief"], "long_description": "Welcome to Monkey Mischief. The game that has little bits of everything.\n\nThere are three game modes, with more to come in the future, that are playable in all three maps! Fly like a high speed racing car across the map with friends, climb mountains to get away from rising lava, or run from two spider-monkey twins with tentacles in a underground advanced cave system!\n\nYou can even scale multiple trees at once, do backflips on trampolines, or explore the Mischievous Mall, where more then 30 cosmetics are for sale to wear on your physical VR character!\n\nOr, you can explore the Horror maps that has three upcoming levels, all scaling higher in atmosphere, and lowering your sanity.\n \nNo matter what you do, it's ensured you will have fun!", "short_description": "Monkey Mischief is a online multiplayer VR game that is dependent on the locomotion of your hands. Run to the top of the mountains when lava is rising, fly like a racing car across the map with friends, or run from two twins with tentacles in a underground advanced cave system!"}]}, "developer_name": "GRP Games LTD", "developer_privacy_policy_url": "https://www.termsfeed.com/live/96ad8549-f44a-4029-a271-842b5a2e688c", "developer_terms_of_service_url": null, "publisher_name": "GRP Games LTD", "support_website_url": null, "website_url": "https://getagames.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "pl", "fr", "de", "da", "sv"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "
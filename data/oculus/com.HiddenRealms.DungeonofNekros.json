&_nc_oc=Adow9fLANEREnwtpG5bKB6YoDIxEZIaYX9T_0m0S-nL7zxh3y6wt0W_Kio1gZjMSNb0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJR-smhAiqoUQcy0OXfYNbkDluYkfIIxDvmk0lYLqfOg&oe=6AFDDDCA"}, "display_name": "Dungeon of Nekros", "keywords": [], "long_description": "This is a one level demo for the upcoming full game. \n\nYou're alive again...but only for an hour! Temporarily resurrected from the dead, you find yourself in a musty old crypt, buried deep in the bowels of a dark & mysterious dungeon. Your only chance at becoming permanently alive again is to embark on a quest to retrieve the Necronomicon - a terrible & forbidden book desired by the one who resurrected you - Nekros the Necromancer. Discover treasure, fight monsters, & solve the mysteries of the Dungeon of Nekros in this amazing RPG by Hidden Realms.", "short_description": "You're alive again...but only for an hour! Temporarily resurrected from the dead, you find yourself in a musty old crypt, buried deep in the bowels of a dark & mysterious dungeon. Your only chance at becoming permanently alive again is to embark on a quest to retrieve the Necronomicon - a terrible & forbidden book desired by the one who resurrected you - Nekros the Necromancer. Discover treasure, fight monsters, & solve the mysteries of the Dungeon of Nekros in this amazing RPG by Hidden Realms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hiddenrealmsvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hidden Realms", "support_website_url": "https://hiddenrealmsvr.com/contact-us", "website_url": "http://hiddenrealmsvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connec
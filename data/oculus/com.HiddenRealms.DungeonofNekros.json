D15"}, {"file_name": "UpscaledDungeonOfNekros3.png", "id": "1151585338924134", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974584_1151585342257467_12151948745452325_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjowIAnaUFoQ7kNvwFovp1J&_nc_oc=AdrcmPIG68LNHQ2-KhGoewNu_Z-p7zE_1l_ruB-zhztQ5zpgjA1T0S0rgLd3LF28Sfg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITUcfxPZZaZ_RQy7EVg3lBkjUtxn-F5RykkHixGrdGTQ&oe=6AA3F9DE"}, {"file_name": "UpscaledDungeonOfNekros5.png", "id": "1061816581349370", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982563_1061816584682703_4398077042985803081_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WR1DGIxpwN8Q7kNvwEQhXwt&_nc_oc=AdrBSDVftpLOqIYVmpfVtiUQFe05WFqgjl60fEAdGSRFr_4CXHRIW8i6KDhx23O5kfA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8CVS7u76eFpku8T1EXoj_A0WFyLciMvTBOu3LQTF_tQ&oe=6AA3F87C"}, {"file_name": "UpscaledDungeonOfNekros6.png", "id": "1895786643957754", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974817_1895786647291087_2489373001132714866_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5c7jo0B34_kQ7kNvwHcJpLc&_nc_oc=Adq3lu2joD9OrU1dqxL1dvJqys1M9GIX4Jcm-iZyUvtijeDV1555pLmxs7vJYQeusJ0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLt7kh8aouz9Yg32fnfFBxYQDoEiBJaPdkpu9B8oTmq7w&oe=6AA404D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HeroHiddenRealmsTitleCoverArt.png", "id": "3763628287026264", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974558_3763628290359597_6941369554397762485_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKE4J1PAi-sQ7kNvwHpjc0b&_nc_oc=Adr_Nb3WSY6_rbhBRy6knEsVIEXDuu6ORXAxp3n9G0w6_XwHX9kxfSajQ7AcEhF4A_8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwmd3AnuDbvt7UcGRiOVcqbeaCPpacuC9czf09qEaOyA&oe=6AA3FF8A"}, "display_name": "Dungeon of Nekros", "keywords": [], "long_description": "This is a one level demo for the upcoming full game. \n\nYou're alive again...but only for an hour! Temporarily resurrected from the dead, you find yourself in a musty old crypt, buried deep in the bowels of a dark & mysterious dungeon. Your only chance at becoming permanently alive again is to embark on a quest to retrieve the Necronomicon - a terrible & forbidden book desired by the one who resurrected you - Nekros the Necromancer. Discover treasure, fight monsters, & solve the mysteries of the Dungeon of Nekros in this amazing RPG by Hidden Realms.", "short_description": "You're alive again...but only for an hour! Temporarily resurrected from the dead, you find yourself in a musty old crypt, buried deep in the bowels of a dark & mysterious dungeon. Your only chance at becoming permanently alive again is to embark on a quest to retrieve the Necronomicon - a terrible & forbidden book desired by the one who resurrected you - Nekros the Necromancer. Discover treasure, fight monsters, & solve the mysteries of the Dungeon of Nekros in this amazing RPG by Hidden Realms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hiddenrealmsvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hidden Realms", "support_website_url": "https://hiddenrealmsvr.com/contact-us", "website_url": "http://hiddenrealmsvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["S
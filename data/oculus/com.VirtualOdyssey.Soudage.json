899480210990_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFoRCxcHoUsQ7kNvwHcezWQ&_nc_oc=AdpThh2Vib-7CYpy1dTVgov4P4TT6bXnAeBwJ3bkrAJuiDGT3xyuoMdoGxBZmDVPbUg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwYRSR4xowOKKNSenxxz13NnT9pG2LO1Geu9SamwfZnag&oe=69CBAD31"}, {"file_name": "Screen02.png", "id": "1678598996837054", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491818852_1678599000170387_8913331425774332495_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9iKUTKmfPYIQ7kNvwF9fEOm&_nc_oc=Adr-HfINtn1kXz12hNvt7iH3_mNgmq8-934x3RyV_lYSMTHnoHxzJrEfFG2w36YNrPE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7UW_m_es1X2DFynSKovB-zFNJG1clw7A2j-3MBgFKbw&oe=69CBBC65"}, {"file_name": "Screen03.png", "id": "2109907463125055", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820387_2109907466458388_1699860389235330862_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhhKywzSvOYQ7kNvwHuc2RV&_nc_oc=AdobCG8gmQ3q_vGmxUIi1jLPWnIxVl5sslMwh0f4ArBVDuvVueZ4QLyfGahfPLdP0es&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyUUa6akOtPRbLJ3U2yu9AT_EF0_AzwtvFTFzi87s1Y8Q&oe=69CBB38D"}, {"file_name": "Screen04.png", "id": "1398551178158583", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823757_1398551181491916_2080030959664429025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rh1DgdW3168Q7kNvwEuxJsX&_nc_oc=AdoiLCd6h8wQ4PX5F_-r_0FoWsdjxkgyLj_kCZeBSBQrBSqhtjh-mVf_P8mPVBpukRg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy4FIidndcLfXyElJawbYZy8X6a71r13I1Jotsh8R-qkg&oe=69CBAB37"}, {"file_name": "Screen05.png", "id": "25700227569657401", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823757_25700227582990733_7465267828648408249_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJ89TBKPRTYQ7kNvwEqZ10-&_nc_oc=AdrYxC0e7vRK5V9Nm6ELqISSvtKL4w8kgSuZy385UWW2gwWeskCIxI7MSVrZ2MoANII&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySoogbsp6niwDyRLjkcPgOl3rjGJkAEYZJlufnGZYoQg&oe=69CBB61C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491820586_1255340643127962_4449086962668176774_n (1).png", "id": "1147849670661387", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491818860_1147849673994720_1069032840711290065_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnWpeXT48F8Q7kNvwHLWP2H&_nc_oc=Adp61z0uPXdhC0IRVDtKbs6-IsQG6mNW0xwFiOKCUp5ObABzBLjMafuukVeAkyo5cmE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy3PnLvLEwx3mi4LLkV3E2jT2rjOephMcKlqreRq6P7xA&oe=69CBAA56"}, "display_name": "WelderMR", "keywords": ["Welding", "MR", "Training", "Education", "Learning"], "long_description": "Move from theory to practice with WelderMR, a high-fidelity welding simulation designed exclusively for Meta Quest 3. By leveraging advanced Mixed Reality (MR) and Hand-Tracking capabilities, WelderMR transforms your real-world environment into a safe, interactive workstation.\n\nLearning through pure movement\nForget the controllers. WelderMR relies on natural interaction: your hands. Thanks to high-precision motion tracking, you develop the genuine muscle memory essential for industrial trades.\n\nA structured pedagogical path:\nPreparation and Safety: Learn essential protocols and the rigorous order of Personal Protective Equipment (PPE).\n\nTorch Mastery: Practice your posture, work angles, and the arc length (tip-to-work distance) required for a stable arc.\n\nDeposition Techniques: Train to maintain a constant travel speed and coordinate your movements to produce consistent weld beads.\n\nWhy choose WelderMR?\nTotal Safety: Learn the fundamentals without exposure to fumes, radiation, or burn risks.\n\nCost-effective and Eco-friendly: Unlimited training without wasting gas, metal, or electricity.\n\nTechnical Precision: A solution designed for training centers and demanding self-learners.\n\nMaster welding. Anywhere. Simply.", "short_description": "Leverage the power of Meta Quest 3 to master the fundamentals of welding. WelderMR utilizes high-fidelity hand-tracking for fast, efficient immersion that stays true to professional techniques.\n\n- Preparation: Safety protocols and equipment procedures.\n\n- Handling: Torch grip and work angle mastery.\n\n- Technique: Learning deposition movements and travel speed control.\n\nA secure, precise, and waste-free pedagogical solution."}, {"images": {"nodes": []}, "id": "1626569451858239", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soudure MR", "keywords": ["Soudure", "MR", "Formation", "Educatif", "Apprentissage"], "long_description": "Passez de la th\u00e9orie \u00e0 la pratique avec Soudure LR, une simulation de soudage haute fid\u00e9lit\u00e9 con\u00e7ue exclusivement pour le Meta Quest 3. En exploitant les capacit\u00e9s avanc\u00e9es de la R\u00e9alit\u00e9 Mixte (MR) et du Hand-Tracking, Soudure MR transforme votre environnement r\u00e9el en un poste de travail s\u00e9curis\u00e9 et interactif.\n\nL\u2019apprentissage par le geste pur :\nOubliez les manettes. WelderMR repose sur une interaction naturelle : vos mains. Gr\u00e2ce au suivi pr\u00e9cis des mouvements, vous d\u00e9veloppez une v\u00e9ritable m\u00e9moire musculaire indispensable aux m\u00e9tiers de l'industrie.\n\nUn parcours p\u00e9dagogique structur\u00e9 :\n- Pr\u00e9paration et S\u00e9curit\u00e9 : Apprenez les protocoles essentiels et l\u2019ordre rigoureux de l\u2019\u00e9quipement de protection individuelle (EPI).\n\n- Ma\u00eetrise de la Torche : Travaillez votre posture, l'angle d'inclinaison et la distance pi\u00e8ce-\u00e9lectrode pour un arc stable.\n\n- Techniques de D\u00e9pose : Entra\u00eenez-vous \u00e0 maintenir une vitesse d\u2019avance constante et \u00e0 coordonner vos mouvements pour r\u00e9aliser des cordons de soudure homog\u00e8nes.\n\nPourquoi choisir Soudure MR?\n- S\u00e9curit\u00e9 Totale : Apprenez les bases sans exposition aux fum\u00e9es, aux rayonnements ou aux risques de br\u00fblures.\n\n- \u00c9conomique et \u00c9cologique : Une formation illimit\u00e9e sans gaspillage de gaz, de m\u00e9tal ou d'\u00e9lectricit\u00e9.\n\n- Pr\u00e9cision Technique : Une solution pens\u00e9e pour les centres de formation et les autodidactes exigeants.\n\nMa\u00eetrisez le soudage. Partout. Simplement.", "short_description": "Exploitez la puissance du Meta Quest 3 pour apprendre les bases du soudage. Soudure MR utilise le hand-tracking pour une immersion rapide et efficace, fid\u00e8le aux gestes m\u00e9tiers.\n\n- Pr\u00e9paration : Proc\u00e9dures d'\u00e9quipement et s\u00e9curit\u00e9.\n\n- Manipulation : Prise en main et inclinaison de la torche.\n\n- Technique : Apprentissage des mouvements de d\u00e9pose et vitesse d'avance.\n\nUne solution p\u00e9dagogique s\u00e9curis\u00e9e, pr\u00e9cise et sans consommables."}]}, "developer_name": "Virtual Odyssey", "developer_privacy_policy_url": "https://virtualodyssey.fr/Politiques-Confidentialites/", "developer_terms_of_service_url": null, "publisher_name": "Virtual Odyssey", "support_website_url": null, "website_url": "https://virtualodyssey.fr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25949158238080305"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1983743965877283"}]}, "baseline_offer": {"id": "
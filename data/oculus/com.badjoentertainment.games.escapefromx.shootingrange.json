nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsu3s2Az4K_Sa14Gl66VIU2msfC1y0TT_JH0sQiFnifw&oe=6B031B5D"}, {"file_name": "screenshot1.png", "id": "1341694047058578", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818938_1341694053725244_3240032162436664286_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFbJkeMtG7wQ7kNvwHdApAZ&_nc_oc=AdoUdyuyXasqTGjSfASlYrTfJQT_PCBbxFPBSv47L_sX7yqRcXt_IEcfTQm3UKhSBIE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRveMjmln80PC_BWXIIqz7oD0-FjvX_tbx9l9pez8gr6Q&oe=6B0330DC"}, {"file_name": "screenshot5.png", "id": "4160305734192976", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819980_4160305737526309_8113990206059248050_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpxQsqHwmboQ7kNvwELGLI6&_nc_oc=AdropY61Ov9BG8OtZWiO7TITvJl87BbC-mRZelVMZxhtldoR-MEjnprh_LwhCaBNp38&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSz4uYfMncrxBLPQjGsyNuQ496elpFVqjOWrBmr-MWv3A&oe=6B03265D"}, {"file_name": "screenshot2.png", "id": "715791784457023", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824609_715791791123689_6893316896241129054_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oig-_642cWwQ7kNvwFR9kKI&_nc_oc=AdqHGag4rI1K3ygNDwe7r2MV0YncvOK2oZB0lD0p_cD1ZN7wxJSO1_zCWJJ3ja9FgIg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzq9JsYLP4SXA9geruWEyzh6QVnOe_9MSnB9rThl_Y2Q&oe=6B031586"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer thumbnail.png", "id": "1466083412053380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827960_1466083415386713_1364816353770669514_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwjmaDeKXDUQ7kNvwFtyEGq&_nc_oc=Adpkd6Zfmt90-FYIGkrl9E96OUMW6H8p1Pw2CHfV5KhiL96xd8AP7rmi94lz2ZXjTgo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4i_Rz_ViDOwM6QFTv5PVwdelrQYReuWla8Y2L3pjvXQ&oe=6B030D48"}, "display_name": "Escape-From-X Shooting Range", "keywords": ["VR", "ShootingRange", "Shooting", "Guns", "Simulation"], "long_description": "\ud83c\udfaf Escape-From-X Shooting Range is a free VR range built around real gun handling. Calibrate, pick up a gun, load it the way you would a real firearm, and send the round down the lane.\n\n\ud83e\ude91 Play seated\nCalibrate your height. The range fits a chair.\n{1780856809694852}\n\n\ud83d\udd90\ufe0f Real handgun mechanics\nPress the button to eject the magazine. Push it home with your palm.\n{1717546010092148}\n\n\ud83d\udc68\u200d\ud83c\udfeb The instructor\nHand him an empty magazine. He brings it back full.\n{2228753604349987}\n\n\ud83d\udd12 Lock the silencer\nSilencers lock onto the barrel and stay there.\n{2416982755729914}\n\n\ud83d\udce6 Seat the magazine\nSeat the rifle magazine until it locks.\n{951772184184448}\n\n\ud83c\udfaf Down the lane\nAim and fire. The round goes where you sent it.\n{1871201300720001}\n\n\ud83d\udd2d Lock the optic\nOptics and red dots lock on. Get behind the sight.\n{1620251136306297}\n\n\u26a1 Submachine gun\nLoad it, shoulder it, and run the lane.\n{1881773462787904}\n\nFree to play on Meta Quest.\n\n\n\n\n\n\n\n\n", "short_description": "Escape-From-X Shooting Range\n\n\ud83c\udfaf Free to play. The most realistic VR shooting range.\n\ud83e\ude91 Calibrate your height and play from a chair.\n\ud83d\udd90\ufe0f Real handgun load. Eject the magazine, then seat it with your palm.\n\ud83d\udd12 Silencers, optics, and red dots lock on.\n\ud83d\udfe2 Green markers show what every part of the gun can do."}]}, "developer_name": null, "developer_privacy_policy_url": "https://badjoentertainment.com/efx/Privacy%20Policy.html", "developer_terms_of_service_url": "https://badjoentertainment.com/efx/TermsAndConditions.html", "publisher_name": "Badjo Entertainment Ltd", "support_website_url": "https://badjoentertainment.com/efx/support/SupportLan
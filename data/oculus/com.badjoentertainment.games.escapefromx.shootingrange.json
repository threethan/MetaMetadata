491818938_1341694053725244_3240032162436664286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BznZ1sfike4Q7kNvwE5xME9&_nc_oc=AdnjBmHdOW15jlDeXTNawB3oSqBAIU9IpVe8g7CnlxcOXwtZTuT9oxN-2F2BLWIaZPA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzUbU7ZuUEkNpj-Wzkz7KatXc6Yr67w3XPFWmq07Z_jdw&oe=69B9619C"}, {"file_name": "screenshot5.png", "id": "4160305734192976", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819980_4160305737526309_8113990206059248050_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJUzfL2S6IwQ7kNvwFudnxI&_nc_oc=AdlbsZagQE-aZE5p7DVFYPyuFlhLH5RfhROzZWRnqWZZMFm-czDIU3aOk-ZONK2AY7o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxmr915qamu8Vgu6zHvRHnI3iFCmWSMjAGaaSa1ASir1g&oe=69B9571D"}, {"file_name": "screenshot2.png", "id": "715791784457023", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824609_715791791123689_6893316896241129054_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NO-9G-D3-IQ7kNvwHX4H8i&_nc_oc=AdmJRmEH1LXZX3p2ClQgm2FADUnWkSvCMNqzLkc1ioiBeGZhjsf0NF0L2gaeLVgn71Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzjc7MxU5Irr-UkEg9qcUv2zyzkLnImA5pgNpPTsN4kLw&oe=69B94646"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Escape-From-X Shooting Range Standalone", "keywords": ["VR", "ShootingRange", "Shooting", "Guns", "Simulation"], "long_description": "\ud83c\udfaf Escape-From-X: Shooting Range (Standalone)\nStep into the immersive world of Escape-From-X with this focused standalone experience.\n\nTest your aim, refine your reflexes, and master realistic VR weapon mechanics \u2014 all without the pressure of combat. Featuring our advanced ballistic system, interactable targets, this is more than just a range \u2014 it's VR gunplay at its finest.\n\n\ud83d\udca5 Perfect for players who want to:\nGet a feel for Escape-From-X gun mechanics!\nPractice aim and recoil control!\n\nWhether you're a VR newcomer or a seasoned shooter, this is your first step toward survival.", "short_description": "\ud83c\udfaf Escape-From-X: Shooting Range (Standalone)\nStep into the immersive world of Escape-From-X with this focused standalone experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://badjoentertainment.com/efx/Privacy%20Policy.html", "developer_terms_of_service_url": "https://badjoentertainment.com/efx/TermsAndConditions.html", "publisher_name": "Badjo Entertainment Ltd", "support_website_url": "https://badjoentertainment.com/efx/support/SupportLandingPage.html", "website_url": "https://badjoentertainment.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9273496262697634"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "610642242049769"}]}, "baseline_offer": {"id": "610642242049769"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1750270200, "status": "PUBLISHED", "id": "610642242049769"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9826108334103088", "version": "0.1.0"}, "id": "1648982135823537", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9273496256030968", "is_concept": false, "
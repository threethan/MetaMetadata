t-iad6-1.oculuscdn.com/v/t64.5771-25/491818938_1341694053725244_3240032162436664286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZixYQS2-doQ7kNvwH-J5q5&_nc_oc=AdokpEOOJbqOugryAAiWngnGHOSij4KqAo_FGZNPxtv3tEguLYqH4eoYwYg3eJqcHJI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQ4I2r01gWJrPVGkTjMBhTyWGD_QihpWaGX844DVtJrw&oe=6AEB3D9C"}, {"file_name": "screenshot5.png", "id": "4160305734192976", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819980_4160305737526309_8113990206059248050_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obFUdleusTEQ7kNvwGEqveu&_nc_oc=AdrzjD2fbt67_ZiXzaEVnmCCagRHBDv8FonaVg-p_Q_fYN4eFHY_LhAgSSPJ34fGiaw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyMvsWIcPF-i-hXABrJSA3UIrEW-WjNgMg4X7bGYi-og&oe=6AEB331D"}, {"file_name": "screenshot2.png", "id": "715791784457023", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824609_715791791123689_6893316896241129054_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ugrgobWdT0Q7kNvwGYr5wH&_nc_oc=AdpVnBUYzqzt3ka6R3mMzFwZtjzCN_oVw7bIPz4ALxwNQOcQRCqOsJgTy6-QhEm38lY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZ05B23NVXnpLPJsjMdwLFC83I7GoM8ZoPmg9mI2UNrA&oe=6AEB5A86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer thumbnail.png", "id": "1466083412053380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827960_1466083415386713_1364816353770669514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmfbi7XXOGwQ7kNvwFetoXn&_nc_oc=Adq8u4g1g259zO4thjhqDa95qR3TIu9CS7m2bZ8_ADgyFw5jSu3VP8jalW2al4OlC2M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5CpM-Uy1XsrMFjlydviTdS0EFrvfvWexY7_VH_PEeUQ&oe=6AEB5248"}, "display_name": "Escape-From-X Shooting Range", "keywords": ["VR", "ShootingRange", "Shooting", "Guns", "Simulation"], "long_description": "\ud83c\udfaf Escape-From-X Shooting Range is a free VR range built around real gun handling. Calibrate, pick up a gun, load it the way you would a real firearm, and send the round down the lane.\n\n\ud83e\ude91 Play seated\nCalibrate your height. The range fits a chair.\n{1780856809694852}\n\n\ud83d\udd90\ufe0f Real handgun mechanics\nPress the button to eject the magazine. Push it home with your palm.\n{1717546010092148}\n\n\ud83d\udc68\u200d\ud83c\udfeb The instructor\nHand him an empty magazine. He brings it back full.\n{2228753604349987}\n\n\ud83d\udd12 Lock the silencer\nSilencers lock onto the barrel and stay there.\n{2416982755729914}\n\n\ud83d\udce6 Seat the magazine\nSeat the rifle magazine until it locks.\n{951772184184448}\n\n\ud83c\udfaf Down the lane\nAim and fire. The round goes where you sent it.\n{1871201300720001}\n\n\ud83d\udd2d Lock the optic\nOptics and red dots lock on. Get behind the sight.\n{1620251136306297}\n\n\u26a1 Submachine gun\nLoad it, shoulder it, and run the lane.\n{1881773462787904}\n\nFree to play on Meta Quest.\n\n\n\n\n\n\n\n\n", "short_description": "Escape-From-X Shooting Range\n\n\ud83c\udfaf Free to play. The most realistic VR shooting range.\n\ud83e\ude91 Calibrate your height and play from a chair.\n\ud83d\udd90\ufe0f Real handgun load. Eject the magazine, then seat it with your palm.\n\ud83d\udd12 Silencers, optics, and red dots lock on.\n\ud83d\udfe2 Green markers show what every part of the gun can do."}]}, "developer_name": null, "developer_privacy_policy_url": "https://badjoentertainment.com/efx/Privacy%20Policy.html", "developer_terms_of_service_url": "https://badjoentertainment.com/efx/TermsAndConditions.html", "publisher_name": "Badjo Entertainment Ltd", "support_website_url": "https://badjoentertainment.com/efx/support/SupportLandingPage.html", "website_url": "https://badjoentertainment.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1043107
nge \u2014 it's VR gunplay at its finest.\n\n\ud83d\udca5 Perfect for players who want to:\nGet a feel for Escape-From-X gun mechanics!\nPractice aim and recoil control!\n\nWhether you're a VR newcomer or a seasoned shooter, this is your first step toward survival.", "short_description": "\ud83c\udfaf Escape-From-X: Shooting Range (Standalone)\nStep into the immersive world of Escape-From-X with this focused standalone experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://badjoentertainment.com/efx/Privacy%20Policy.html", "developer_terms_of_service_url": "https://badjoentertainment.com/efx/TermsAndConditions.html", "publisher_name": "Badjo Entertainment Ltd", "support_website_url": "https://badjoentertainment.com/efx/support/SupportLandingPage.html", "website_url": "https://badjoentertainment.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28293748383579136"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_1408763711387646_1512319530429324394_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXjjkCyL3PUQ7kNvwE50tCW&_nc_oc=AdqwpNMDNLqF9PFLsolv3NX_o26fcYpEogbOn3ow17v8TnVZ0zpK1MXnw3I8qFR0sHQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzNfp2DioOISyYmIcrGtYjKwAH4v8IvVDjvgw2UTf8ng&oe=6ACCEADD"}, "is_conc
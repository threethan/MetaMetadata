021C"}, {"file_name": "screenshot5.png", "id": "4160305734192976", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819980_4160305737526309_8113990206059248050_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0f_hzJw-gTwQ7kNvwH07JID&_nc_oc=AdoLieZy1T0APAF61JkcORfS_u9ByyKGsX_-88UOnDYXMMSyFKF29ZjWnu7_ITXsGxI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6xYmjKcHwjuXAgt3pYM9_kzQE0ejAF6vyApJ9iMXPqQ&oe=6AC4F79D"}, {"file_name": "screenshot2.png", "id": "715791784457023", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824609_715791791123689_6893316896241129054_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xni_KeRMWvwQ7kNvwHO6E3A&_nc_oc=Adrh8KYrBQmIpY9P1Kzyrxs4xAR9fodtIo7sboEZisXb0zoxqhBck37RGtUhzIiGWKA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNR70KzcX8hxtnasdfZiG5s4WVSlCbKTGa_iP92EACBQ&oe=6AC51F06"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Escape-From-X Shooting Range Standalone", "keywords": ["VR", "ShootingRange", "Shooting", "Guns", "Simulation"], "long_description": "\ud83c\udfaf Escape-From-X: Shooting Range (Standalone)\nStep into the immersive world of Escape-From-X with this focused standalone experience.\n\nTest your aim, refine your reflexes, and master realistic VR weapon mechanics \u2014 all without the pressure of combat. Featuring our advanced ballistic system, interactable targets, this is more than just a range \u2014 it's VR gunplay at its finest.\n\n\ud83d\udca5 Perfect for players who want to:\nGet a feel for Escape-From-X gun mechanics!\nPractice aim and recoil control!\n\nWhether you're a VR newcomer or a seasoned shooter, this is your first step toward survival.", "short_description": "\ud83c\udfaf Escape-From-X: Shooting Range (Standalone)\nStep into the immersive world of Escape-From-X with this focused standalone experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://badjoentertainment.com/efx/Privacy%20Pol
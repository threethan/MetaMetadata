yztAmHNgQ7kNvwHTsKCY&_nc_oc=AdrJ61_fQxlgMcayutd-qk07q3LHLQ17j2eLhnre-G4nBgY8vSMG5PnYIckmgnej5hc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxz7g63mpO1nKLEsZPcp_PrPfXYvQ89nvQ79bB2itxfEA&oe=69C281D7"}, "display_name": "Escape-From-X Shooting Range Standalone", "keywords": ["VR", "ShootingRange", "Shooting", "Guns", "Simulation"], "long_description": "\ud83c\udfaf Escape-From-X: Shooting Range (Standalone)\nStep into the immersive world of Escape-From-X with this focused standalone experience.\n\nTest your aim, refine your reflexes, and master realistic VR weapon mechanics \u2014 all without the pressure of combat. Featuring our advanced ballistic system, interactable targets, this is more than just a range \u2014 it's VR gunplay at its finest.\n\n\ud83d\udca5 Perfect for players who want to:\nGet a feel for Escape-From-X gun mechanics!\nPractice aim and recoil control!\n\nWhether you're a VR newcomer or a seasoned shooter, this is your first step toward survival.", "short_description": "\ud83c\udfaf Escape-From-X: Shooting Range (Standalone)\nStep into the immersive world of Escape-From-X with this focused standalone experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://badjoentertainment.com/efx/Privacy%20Policy.html", "developer_terms_of_service_url": "https://badjoentertainment.com/efx/TermsAndConditions.html", "publisher_name": "Badjo Entertainment Ltd", "support_website_url": "https://badjoentertainment.com/efx/support/SupportLandingPage.html", "website_url": "https://badjoentertainment.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommende
x98V9e70koF6iQ6Mj4eog_N5UnRb6SXnpRQQ&oe=6AC8EC1D"}, {"file_name": "screenshot2.png", "id": "715791784457023", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824609_715791791123689_6893316896241129054_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ha7GIaDnx14Q7kNvwGzwCPU&_nc_oc=AdqLp4mi7DzGpzuj4vUI6KwZWjscVncZhh8u-g_BzeRRUYIXnviMHVUHywgo60361fI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKoZuxDnYhdmu7ePY-1Dd3AY_D-OxQQrhw3NhklKNKmA&oe=6AC91386"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Escape-From-X Shooting Range Standalone", "keywords": ["VR", "ShootingRange", "Shooting", "Guns", "Simulation"], "long_description": "\ud83c\udfaf Escape-From-X: Shooting Range (Standalone)\nStep into the immersive world of Escape-From-X with this focused standalone experience.\n\nTest your aim, refine your reflexes, and master realistic VR weapon mechanics \u2014 all without the pressure of combat. Featuring our advanced ballistic system, interactable targets, this is more than just a range \u2014 it's VR gunplay at its finest.\n\n\ud83d\udca5 Perfect for players who want to:\nGet a feel for Escape-From-X gun mechanics!\nPractice aim and recoil control!\n\nWhether you're a VR newcomer or a seasoned shooter, this is your first step toward survival.", "short_description": "\ud83c\udfaf Escape-From-X: Shooting Range (Standalone)\nStep into the immersive world of Escape-From-X with this focused standalone experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://badjoentertainment.com/efx/Privacy%20Policy.html", "developer_terms_of_service_url": "https://badjoentertainment.com/efx/TermsAndConditions.html", "publisher_name": "Badjo Entertainment Ltd", "support_website_url": "https://badjoentertainment.com/efx/support/SupportLandingPage.html", "website_url": "https://badjoentertainment.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"
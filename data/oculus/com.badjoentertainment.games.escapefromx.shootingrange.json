nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU9Ck5QMzVxiTRVV8V9ZdLxCG_kUM0IbAvbvzl728UQhQ&oe=6B104A5D"}, {"file_name": "screenshot1.png", "id": "1341694047058578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818938_1341694053725244_3240032162436664286_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANTKVb8n530Q7kNvwEpBxc1&_nc_oc=Adrj4AmDuncwPMPnyCJq1g2a7eNwCw_EGAuzucQ1aT-ZAytSisHKfmoiQelA9Y6cnMU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUswh64Hv-2W7K31WXnCUmOv9jRn385prPTd7PvXX5S0g&oe=6B105FDC"}, {"file_name": "screenshot5.png", "id": "4160305734192976", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819980_4160305737526309_8113990206059248050_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIlAondCMUEQ7kNvwH-fM1N&_nc_oc=AdrvviLuVOgXNxE4MDGqR_Kc3n2pgMtvkxGXv2hKAhIRR84WdXXK_5jVaUgtxM_tRbE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUaotVe3zyt5Y8hx8AoSi-pYuaO-V5f5wCOAuRTVBv26Q&oe=6B10555D"}, {"file_name": "screenshot2.png", "id": "715791784457023", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824609_715791791123689_6893316896241129054_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7xMyyUgprAQ7kNvwFW-0Wd&_nc_oc=Adr8HE0dtOvyU07Or4dx63De4A8D_h2jyWJPWCWahaah__VfUR-J1JdDbtrOL2Zy6SU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVXGE89OtPpllYFJuOYrtWTcnj3owzAajheodRN1zDz7g&oe=6B104486"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer thumbnail.png", "id": "1466083412053380", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_1466083415386713_1364816353770669514_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1Am_FtTDwcQ7kNvwGnipPK&_nc_oc=AdoKtYG-Xxc7lgSjMzRVE_tFhbkkywCB821Tq4BfVbk_GSyiWdJcRldi_b0eaoLWszI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX_gzPygjhjjnWIr5WeayLtlRWJbVTpj1mKpVylUwNZjQ&oe=6B103C48"}, "display_name": "Escape-From-X Shooting Range", "keywords": ["VR", "ShootingRange", "Shooting", "Guns", "Simulation"], "long_description": "\ud83c\udfaf Escape-From-X Shooting Range is a free VR range built around real gun handling. Calibrate, pick up a gun, load it the way you would a real firearm, and send the round down the lane.\n\n\ud83e\ude91 Play seated\nCalibrate your height. The range fits a chair.\n{1780856809694852}\n\n\ud83d\udd90\ufe0f Real handgun mechanics\nPress the button to eject the magazine. Push it home with your palm.\n{1717546010092148}\n\n\ud83d\udc68\u200d\ud83c\udfeb The instructor\nHand him an empty magazine. He brings it back full.\n{2228753604349987}\n\n\ud83d\udd12 Lock the silencer\nSilencers lock onto the barrel and stay there.\n{2416982755729914}\n\n\ud83d\udce6 Seat the magazine\nSeat the rifle magazine until it locks.\n{951772184184448}\n\n\ud83c\udfaf Down the lane\nAim and fire. The round goes where you sent it.\n{1871201300720001}\n\n\ud83d\udd2d Lock the optic\nOptics and red dots lock on. Get behind the sight.\n{1620251136306297}\n\n\u26a1 Submachine gun\nLoad it, shoulder it, and run the lane.\n{1881773462787904}\n\nFree to play on Meta Quest.\n\n\n\n\n\n\n\n\n", "short_description": "Escape-From-X Shooting Range\n\n\ud83c\udfaf Free to play. The most realistic VR shooting range.\n\ud83e\ude91 Calibrate your height and play from a chair.\n\ud83d\udd90\ufe0f Real handgun load. Eject the magazine, then seat it with your palm.\n\ud83d\udd12 Silencers, optics, and red dots lock on.\n\ud83d\udfe2 Green markers show what every part of the gun can do."}]}, "developer_name": null, "developer_privacy_policy_url": "https://badjoentertainment.com/efx/Privacy%20Policy.html", "developer_terms_of_service_url": "https://badjoentertainment.com/efx/TermsAndConditions.html", "publisher_name": "Badjo Entertainment Ltd", "support_website_url": "https://badjoentertainment.com/efx/support/SupportLan
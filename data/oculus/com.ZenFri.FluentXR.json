69A05055"}, {"file_name": "Fluent XR PDP Art.png", "id": "2055286771488876", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974466_2055286774822209_4338361723960595313_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7A1yU6BuMz4Q7kNvwEPuT4H&_nc_oc=Adk0XwHiIlDaT154AyaHDCByyM9s7Q_Gi5gdAg2XDOGP6i9rcu15i_qluU5m6SHZU3c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvUaoH0dSZ6O3dPWAMihP9xALUv0hZpWxhzisM_l6iABw&oe=69A03527"}, {"file_name": "Fluent XR Cover Art.png", "id": "678364797690874", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_678364801024207_2897138990588590099_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PFte42oFGwQ7kNvwF-DHW5&_nc_oc=AdktVSdERyNJr4ksxlfBWKFmwyzFLXhtWIGCeWDOyk0BHyzeOG97WJ1MDUlu1w3Lo5E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftqrQ5UD5XaaCmKHXErE7P24NqbM6AqL8yUQsx965vy2w&oe=69A03B2B"}, {"file_name": "Fluent XR Logo transparent.png", "id": "212845385153628", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974821_212845391820294_4065972029516719811_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0w04wLBEbXMQ7kNvwGzulDp&_nc_oc=AdmOHR82jLWIlxSaAvvWbrXvKImEPkcMuURMbW3AfY4hDD6s4u1XA5ac30fm-uFbF70&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftw6UxXZn3BGHZpsjyKErrHkqmVGs8kLt3LD1PfLk-OYQ&oe=69A05896"}]}, "id": "1137501624009601", "locale": "en_GB", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FluentXR", "keywords": [], "long_description": "Unlock a personalized language learning journey with FluentXR. Using mixed reality passthrough technology, FluentXR transforms your home into an interactive learning space. \n\nStep into a realm where learning is not just fun and effective, but also deeply personalized. FluentXR is not just another language learning app; it's your own private linguistics lab. \n\nTag real-world objects in your space with text and audio labels, making learning immersive and contextually relevant. Dive into our Word Shuffle mini-game to reinforce your skills and beat the timer. \n\nCurrent Features:\nTagging Language: English\nLearning Language: French\nMini-Game: Word Shuffle\n470+ available tags geared towards common living room objects such as \u201cCouch\u201d, \u201cTelevision\u201d, and \u201cGaming Console\u201d\n\nFluentXR is an ever-evolving platform, continually expanding its selection of languages and mini-games. Achieve language mastery with FluentXR\u2014where your home becomes your classroom.", "short_description": "Transform your language learning experience.\n\nUtilizing mixed-reality passthrough technology turn your home into a dynamic classroom. Tag real-world objects in your living room with 470+ customizable tags for learning French. Sharpen your skills through the Word Shuffle mini-game.\n\nFluentXR is an ever-evolving platform, updating with new languages and interactive mini-games. Dive into a context-rich home environment that's both captivating and practical."}, {"images": {"nodes": [{"file_name": "Fluent XR Cover Art - Portrait.png", "id": "6647755272010080", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982588_6647755275343413_6975862371154701560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IB0-Bh3_eq0Q7kNvwGAIIlp&_nc_oc=Adnfci8YWrDzSncUYEPBEvU6rZfSWLAruT4MstEqYycOtRnP_XZzvSh_z9K0Q_en9zg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvoAtvfZiPck5LTPWN8tsIMeGu8QelH6cPPI4rnHNbq8w&oe=69A04934"}, {"file_name": "Fluent XR Mobile Icon.png", "id": "2082304598777986", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974858_2082304602111319_6670855186104070571_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lp71t6vwiEoQ7kNvwE3R-en&_nc_oc=AdkDZjJyefDAllPJujXIkrAdi6MvmVeqIkvmVKpD8SD7C8ofX7oWgmzed0MBSmq8UiE&_nc_zt=3&_nc_ht=scontent-iad
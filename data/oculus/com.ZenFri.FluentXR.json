69A444D5"}, {"file_name": "Fluent XR PDP Art.png", "id": "2055286771488876", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974466_2055286774822209_4338361723960595313_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQTn4KvPQjIQ7kNvwEq43RY&_nc_oc=Adk3DjurFeuORHBVDMx6ffk5XIbU23FkPJyeYBI_Pjwb2YVcEDi8feKCN3PKDMOOTG8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvkMJothPPeD-sq4AD5QtwUgF4gEdKcxdg3-rpTOskfgA&oe=69A429A7"}, {"file_name": "Fluent XR Cover Art.png", "id": "678364797690874", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_678364801024207_2897138990588590099_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYLY-dn4ThUQ7kNvwHktNfY&_nc_oc=AdkN1OPZnnyXLEQSdYD1MAvBLx6ejCj_7FAV3zfCIflXcpbS75Jzn-3RpeKerGQGqRM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsTUIlSDWBvOJHRZDckelWvX0_n-pt825-FmtAd8-UL1g&oe=69A42FAB"}, {"file_name": "Fluent XR Logo transparent.png", "id": "212845385153628", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974821_212845391820294_4065972029516719811_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1oQFVdLalJwQ7kNvwHfNfcj&_nc_oc=AdliUqPn7BeZ2Vt66-_b_qBXVXgpgS-0VTFu0_pWKvecV1d8dftyJ--ze5MwSJoqDBg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvWKIVull9PVUspRG8vQvKKHMCgV_uKkozpvaUhXpZziw&oe=69A44D16"}]}, "id": "1137501624009601", "locale": "en_GB", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FluentXR", "keywords": [], "long_description": "Unlock a personalized language learning journey with FluentXR. Using mixed reality passthrough technology, FluentXR transforms your home into an interactive learning space. \n\nStep into a realm where learning is not just fun and effective, but also deeply personalized. FluentXR is not just another language learning app; it's your own private linguistics lab. \n\nTag real-world objects in your space with text and audio labels, making learning immersive and contextually relevant. Dive into our Word Shuffle mini-game to reinforce your skills and beat the timer. \n\nCurrent Features:\nTagging Language: English\nLearning Language: French\nMini-Game: Word Shuffle\n470+ available tags geared towards common living room objects such as \u201cCouch\u201d, \u201cTelevision\u201d, and \u201cGaming Console\u201d\n\nFluentXR is an ever-evolving platform, continually expanding its selection of languages and mini-games. Achieve language mastery with FluentXR\u2014where your home becomes your classroom.", "short_description": "Transform your language learning experience.\n\nUtilizing mixed-reality passthrough technology turn your home into a dynamic classroom. Tag real-world objects in your living room with 470+ customizable tags for learning French. Sharpen your skills through the Word Shuffle mini-game.\n\nFluentXR is an ever-evolving platform, updating with new languages and interactive mini-games. Dive into a context-rich home environment that's both captivating and practical."}, {"images": {"nodes": [{"file_name": "Fluent XR Cover Art - Portrait.png", "id": "6647755272010080", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982588_6647755275343413_6975862371154701560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uPU15SQV8cQ7kNvwGcB3ZD&_nc_oc=AdmJlL7GHpTDpadcDqtfP-JeG3MCXu-p7X0yeX14mWSn9RjjgHKICjpyDX4df9wqS1w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftoTUCSmLtjT1KT92ycKIRR3sEhGeQfhAcqQt6QBxvpyw&oe=69A43DB4"}, {"file_name": "Fluent XR Mobile Icon.png", "id": "2082304598777986", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974858_2082304602111319_6670855186104070571_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DsT4mUD9FsQ7kNvwEmYvaA&_nc_oc=Adk72qjPnbbQ-RDhqLR1qF6gv9VcYxpVpZovl0mqdFhfi_YjxnRHpMKY4odD7RMU0rA&_nc_zt=3&_nc_ht=scontent-ord
699B0A55"}, {"file_name": "Fluent XR PDP Art.png", "id": "2055286771488876", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974466_2055286774822209_4338361723960595313_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WR47LUl8c2EQ7kNvwH0LOsA&_nc_oc=AdmKZC8LhbSSx7GJDX7T1jBVuKav__rMExMfLOzoAuZH6DWkStLMGFIw6eqFDtpikSg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvkOoGeYDRKOblS4SqP2KBwpOd8HA84XhvZeItQF0NocQ&oe=699AEF27"}, {"file_name": "Fluent XR Cover Art.png", "id": "678364797690874", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_678364801024207_2897138990588590099_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3dbnNiR-PIQ7kNvwFVD_42&_nc_oc=Adme2i7SXJ86X7KkuRXOLHbx_it0IK4WUfiWUgAjmpMsPGFP0AhEnzrlBFILIGjp8Ng&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu6GL1c1WwE_tPE5H-OQ4OLiOMagyKMGyidPeoXibWiVg&oe=699AF52B"}, {"file_name": "Fluent XR Logo transparent.png", "id": "212845385153628", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974821_212845391820294_4065972029516719811_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5sisPa9r7EQ7kNvwG1LgB_&_nc_oc=AdnaKQ41726I9HZrhhrXEPwojfINNOzVKnzMNsCPWJA0Yg9PXVm6ZrTXoTpHW_Ru74s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvN6NED3KYUjjQE5hDLI9AFWaffn5U4M1F5DZVkncQ5MQ&oe=699B1296"}]}, "id": "1137501624009601", "locale": "en_GB", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FluentXR", "keywords": [], "long_description": "Unlock a personalized language learning journey with FluentXR. Using mixed reality passthrough technology, FluentXR transforms your home into an interactive learning space. \n\nStep into a realm where learning is not just fun and effective, but also deeply personalized. FluentXR is not just another language learning app; it's your own private linguistics lab. \n\nTag real-world objects in your space with text and audio labels, making learning immersive and contextually relevant. Dive into our Word Shuffle mini-game to reinforce your skills and beat the timer. \n\nCurrent Features:\nTagging Language: English\nLearning Language: French\nMini-Game: Word Shuffle\n470+ available tags geared towards common living room objects such as \u201cCouch\u201d, \u201cTelevision\u201d, and \u201cGaming Console\u201d\n\nFluentXR is an ever-evolving platform, continually expanding its selection of languages and mini-games. Achieve language mastery with FluentXR\u2014where your home becomes your classroom.", "short_description": "Transform your language learning experience.\n\nUtilizing mixed-reality passthrough technology turn your home into a dynamic classroom. Tag real-world objects in your living room with 470+ customizable tags for learning French. Sharpen your skills through the Word Shuffle mini-game.\n\nFluentXR is an ever-evolving platform, updating with new languages and interactive mini-games. Dive into a context-rich home environment that's both captivating and practical."}, {"images": {"nodes": [{"file_name": "Fluent XR Cover Art - Portrait.png", "id": "6647755272010080", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982588_6647755275343413_6975862371154701560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tc-c6rO63IgQ7kNvwEMKSnG&_nc_oc=Adl9B5WUWA9L6zc1kKuQUJU5yBFs9cDE27fFQIZIKuTv_qwS7k-LGNbFmmfncCSWn7U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aful2n2KEjSa4p-m_tLHllV3gahsIAqq1OrNK6F0Wd5qXg&oe=699B0334"}, {"file_name": "Fluent XR Mobile Icon.png", "id": "2082304598777986", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974858_2082304602111319_6670855186104070571_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOZ5N3iXMzoQ7kNvwF-noKM&_nc_oc=AdnFhYAJ7xttC5RU8BE3E7s4XbY-Qe1I9sJPQ9ef0Xipbglr0r8THDBPdZAFS2wthrw&_nc_zt=3&_nc_ht=scontent-ord
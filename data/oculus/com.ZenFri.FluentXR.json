.com&_nc_ss=7f20f&oh=00_Af2V3J_k2w12r1ke6p_8KcCrHnHL-cMFWvnn6GIKxD4OTg&oe=69F1FA1E"}, {"file_name": "Fluent XR PDP Art.png", "id": "1061096168226207", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75340707_1061096171559540_9065798130022169599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETxnCIX5vWAQ7kNvwF1Wp8_&_nc_oc=AdremDBZDyMT85uJu8SHOHVezA-i-GBPcRKlisHNtYJDQ8PsOx7kY7vpim271Bp1cEE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Js4CeAxBkMwOEv5XFeGa9vqMhCBC-W1QrB_uJVuVw0A&oe=69F206F3"}]}, "id": "449609844722656", "locale": "en_US", "screenshots": [{"file_name": "Sequence 04.00_27_46_18.Still011.png", "id": "755435526614104", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003240_755435529947437_3157283510711493706_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2zow2K-e_EQ7kNvwGEqjrt&_nc_oc=AdoIs0wU8P82Emw1AKFPbim4EoE6xf3F6aOn5X_S05xh_2gsKkZjG77gd0AywRyZFo8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1LRtEFUhZIbecFVStNrYE7fZUqwQ5ff6tfNl6G0XxpNQ&oe=69F1F43F"}, {"file_name": "Sequence 04.00_34_53_09.Still016.png", "id": "377326888090872", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031365_377326891424205_2576812618867292544_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAsftVlLJcEQ7kNvwHbIz7s&_nc_oc=Ado7TP0MwBHIVGmk-VJqbnHFfzl_CyMMYfo6xPXffyPY7VLHlxOxqGd6yZKhPwt16ew&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3sS6uduFbkjMnk_jc8q73Pdz4WJmFFYX-Iw85r4l5w0Q&oe=69F1F60E"}, {"file_name": "Sequence 04.00_49_22_19.Still025.png", "id": "1792607307852843", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035387_1792607311186176_5280458374548206595_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DL1dHeBZaocQ7kNvwGcNudb&_nc_oc=Ado7MzgvYIOdJ-HWDqBBeHdXo9AhVhrsTSOYnKSjhDqpNKfzFDdmzs3_r3aw9s8flW0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3ZkqhNjouGghTdCSI1W4wAGHXRmyq68qQSpj3uBIoUtg&oe=69F1FB16"}, {"file_name": "Sequence 04.00_52_56_05.Still030.png", "id": "245249301718520", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031325_245249305051853_1598234300064219875_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Rvg-oc6FHQQ7kNvwEm7YAk&_nc_oc=AdpRWocf-4atpldl83EUMGHkt8OMbeuOlncKH-mjMJH_BojmdXv7bLmP1kt4Bxi2mPs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2fHoxwgQQqgyOfyUU78yAX2HUcJqF5TE_nxK0yC5iy3g&oe=69F212F7"}, {"file_name": "Sequence 04.00_11_37_00.Still002.png", "id": "733795254815172", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036675_733795258148505_1346935370172344005_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTeldXf6fVcQ7kNvwEHxxeu&_nc_oc=AdrI2d2uEx4Tj1XJFbIBVLUriCfI5Lgx0IS1VW5Q0skXzzk_2b3933tUfyYiPSd-JDI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3l_yBrgTPVnJ_n2v9x8j3ZZV_kH9FM2ZQa9nq7H52loQ&oe=69F21A32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sequence 04.00_27_46_18.Still011.png", "id": "894248482404839", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974686_894248485738172_2991357501924730672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCCRPn9-FqgQ7kNvwGx63d7&_nc_oc=AdoczmyQgw1Lo7jgJm7jgR574XeKKrYvq4c8PZP2grcFslJZQVFsXMuKuLMUGerGUgw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1TWqSsLwAYOQVeL3UanLzOpviUfgbUae_MOYRFDbQQrA&oe=69F1F99B"}, "display_name": "FluentXR", "keywords": [], "long_description": "Unlock a personalized language learning journey through your mixed reality home. FluentXR transforms your space into an interactive learning environment.\n\nStep into a realm where learning is not just fun and effective, but also deeply personalized. FluentXR is not just another language learning app; it's your own private linguistics lab.\n\nTag real-world objects in your space with text and audio labels, making learning immersive and contextually relevant. Dive into our Word Shuffle mini-game to reinforce your skills and challenge yourself using the timer.\n\nCurrent Features:\nSpace: Living Room\nMain Language: English\nLearning: French / fran\u00e7ais\nMini-Game: Word Shuffle\n470+ available tags geared towards common living room objects such as \u201cCouch\u201d, \u201cTelevision\u201d, \u201cChess Set\u201d and \u201cGaming Console\u201d\n\nFluentXR is an ever-evolving platform, continually expanding its selection of languages, locations, and mini-games. Achieve language mastery with FluentXR\u2014where your home becomes your classroom.\n\nNext Expansion: \nSpace: Kitchen\nSpace: Bedroom\nMain Language: French\nLearning Language: Spanish / espa\u00f1ol \nLearning Language: English\nMini-Game: Sentence Scramble", "short_description": "Transform your language learning experience. \n\nUtilizing mixed-reality passthrough technology turn your home into a dynamic classroom. Tag real-world objects in your living room with 470+ customizable tags for learning French. Sharpen your skills through the Word Shuffle mini-game.\n\nFluentXR is an ever-evolving platform, updating with new languages, locations, and interactive mini-games. Dive into a context-rich home environment that's both captivating and practical."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zenfri.ca/fluentxr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ZenFri Inc.", "support_website_url": null, "website_url": "https://zenfri.ca/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
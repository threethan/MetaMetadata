699DAD55"}, {"file_name": "Fluent XR PDP Art.png", "id": "2055286771488876", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974466_2055286774822209_4338361723960595313_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7A1yU6BuMz4Q7kNvwHN-Jcf&_nc_oc=Adn9lk2HZgW9GF8BNF5MlysV1XB4fYNMNUUgJbDi_iDLvLoP3YFdawZLW8l7R5Pk06Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuipZpsctPY0251ehwNzhTUxVlIX8MLjSEaspG0fumPzQ&oe=699D9227"}, {"file_name": "Fluent XR Cover Art.png", "id": "678364797690874", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_678364801024207_2897138990588590099_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PFte42oFGwQ7kNvwEOcg4L&_nc_oc=Adlr1qR6CnuRFr_OvDHuy1FdPNtL_Kjo2gehp7rOmxYTjTjWhoH41DIifTvA3226SOw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuKgAGkH8cYIR77seLMpzaq97A0KpbOYAwB3WMcVy7yrQ&oe=699D982B"}, {"file_name": "Fluent XR Logo transparent.png", "id": "212845385153628", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974821_212845391820294_4065972029516719811_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5sisPa9r7EQ7kNvwGxvWi_&_nc_oc=AdkgoHG_9X7zmKG6kzpSz2SgmQ2txXFI7yJWz8qQpIfihhXyVSe5Mgn3zEezh9X6gnM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvytYVZjkhADXbxeUHjxyJZir02H25ePuV760nLaOqXyw&oe=699DB596"}]}, "id": "1137501624009601", "locale": "en_GB", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FluentXR", "keywords": [], "long_description": "Unlock a personalized language learning journey with FluentXR. Using mixed reality passthrough technology, FluentXR transforms your home into an interactive learning space. \n\nStep into a realm where learning is not just fun and effective, but also deeply personalized. FluentXR is not just another language learning app; it's your own private linguistics lab. \n\nTag real-world objects in your space with text and audio labels, making learning immersive and contextually relevant. Dive into our Word Shuffle mini-game to reinforce your skills and beat the timer. \n\nCurrent Features:\nTagging Language: English\nLearning Language: French\nMini-Game: Word Shuffle\n470+ available tags geared towards common living room objects such as \u201cCouch\u201d, \u201cTelevision\u201d, and \u201cGaming Console\u201d\n\nFluentXR is an ever-evolving platform, continually expanding its selection of languages and mini-games. Achieve language mastery with FluentXR\u2014where your home becomes your classroom.", "short_description": "Transform your language learning experience.\n\nUtilizing mixed-reality passthrough technology turn your home into a dynamic classroom. Tag real-world objects in your living room with 470+ customizable tags for learning French. Sharpen your skills through the Word Shuffle mini-game.\n\nFluentXR is an ever-evolving platform, updating with new languages and interactive mini-games. Dive into a context-rich home environment that's both captivating and practical."}, {"images": {"nodes": [{"file_name": "Fluent XR Cover Art - Portrait.png", "id": "6647755272010080", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982588_6647755275343413_6975862371154701560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tc-c6rO63IgQ7kNvwHpBueW&_nc_oc=AdkqGkClFexvUBYdAJat_8JH2tBm6P_78Mf8apOtcbrCEjxiCke-hFowwUhSZWXLqd0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfscOPQaldEYBKkJaj72wO4Wokw3aTpypYMoZIgi6ErLlA&oe=699DA634"}, {"file_name": "Fluent XR Mobile Icon.png", "id": "2082304598777986", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974858_2082304602111319_6670855186104070571_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOZ5N3iXMzoQ7kNvwENfS6Y&_nc_oc=AdmOaWtRSzoE-01Gi2UMmYzJKVy8hYfd-PZ4YjYlLLAhIbL2uz6r-TXo0WuYL6HbLK8&_nc_zt=3&_nc_ht=scontent-iad
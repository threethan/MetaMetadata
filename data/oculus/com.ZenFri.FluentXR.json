8zXXXXxEg&oe=69F20D55"}, {"file_name": "Fluent XR PDP Art.png", "id": "2055286771488876", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974466_2055286774822209_4338361723960595313_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5CHRm2--oIQ7kNvwHVD2lf&_nc_oc=AdpiHyZ7W3uzDESL77H5uUFtf8x59pNJpFK7w_oxe20pGkL2UKSGJ4gLGdpO7Xly3e4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af21RXEox8ywmtn8g_w-G7j9EdgEz1eAFqkmqkK1UYn_4w&oe=69F1F227"}, {"file_name": "Fluent XR Cover Art.png", "id": "678364797690874", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974640_678364801024207_2897138990588590099_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xkkDm1ONjQQ7kNvwEuRX1M&_nc_oc=AdoWL7ZeMMKHx5wUSu5vlHxYJu4hmwBris5WY8bEhm7AWCpUbDmd-f-MwNVR_3FLZFY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1GcaujibyYF3Xa6qptOCppJceig_qbjndh_6x44qn0UA&oe=69F1F82B"}, {"file_name": "Fluent XR Logo transparent.png", "id": "212845385153628", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974821_212845391820294_4065972029516719811_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0DMLhWWEPUQ7kNvwHqnheF&_nc_oc=AdolgtwbZNg-PIvUBp_sum4qb0Bm6Vm49I9Jd4ZX2HjISCCezuLoIj8IcUtUllI7Glw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2xdcFRX8WpcjqjgqUElgMsCza7nn4Sm82ECcBFrrGSbQ&oe=69F21596"}]}, "id": "1137501624009601", "locale": "en_GB", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FluentXR", "keywords": [], "long_description": "Unlock a personalized language learning journey with FluentXR. Using mixed reality passthrough technology, FluentXR transforms your home into an interactive learning space. \n\nStep into a realm where learning is not just fun and effective, but also deeply personalized. FluentXR is not just another language learning app; it's your own private linguistics lab. \n\nTag real-world objects in your space with text and audio labels, making learning immersive and contextually relevant. Dive into our Word Shuffle mini-game to reinforce your skills and beat the timer. \n\nCurrent Features:\nTagging Language: English\nLearning Language: French\nMini-Game: Word Shuffle\n470+ available tags geared towards common living room objects such as \u201cCouch\u201d, \u201cTelevision\u201d, and \u201cGaming Console\u201d\n\nFluentXR is an ever-evolving platform, continually expanding its selection of languages and mini-games. Achieve language mastery with FluentXR\u2014where your home becomes your classroom.", "short_description": "Transform your language learning experience.\n\nUtilizing mixed-reality passthrough technology turn your home into a dynamic classroom. Tag real-world objects in your living room with 470+ customizable tags for learning French. Sharpen your skills through the Word Shuffle mini-game.\n\nFluentXR is an ever-evolving platform, updating with new languages and interactive mini-games. Dive into a context-rich home environment that's both captivating and practical."}, {"images": {"nodes": [{"file_name": "Fluent XR Cover Art - Portrait.png", "id": "6647755272010080", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982588_6647755275343413_6975862371154701560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6XfcVsgLwgQ7kNvwEGkasw&_nc_oc=Adoh8OzMo1_6woO1WcA00Lzj1FFr-Ryl766waiezAMDlAsaZRTeSFZUG1rj-_Awr_wI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2MdGq2AM7q30irQXTDlyUhj8BDtoCha08h2VHRCh9CqQ&oe=69F20634"}, {"file_name": "Fluent XR Mobile Icon.png", "id": "2082304598777986", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974858_2082304602111319_6670855186104070571_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPe7YKZHLJ0Q7kNvwG8ZUBa&_nc_oc=Adrk_Cvvjc4HhnMqms1xdSyMxx561SKRktPHb4bOCzAFxlwIyZmIOurLNnkF108OE6M&_n
69F0BBD5"}, {"file_name": "Fluent XR PDP Art.png", "id": "2055286771488876", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974466_2055286774822209_4338361723960595313_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5CHRm2--oIQ7kNvwFt_0LZ&_nc_oc=Adordb5gBBh6c8vvMk9LLLAgvp-sxUFuRojARZUWgzFOL5C98q5PnpJ9ll0WSqxC3Qw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0G2zoS7u0PhI--bpHDJKbMO5Av4geuYTLft6UzopRtqw&oe=69F0A0A7"}, {"file_name": "Fluent XR Cover Art.png", "id": "678364797690874", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_678364801024207_2897138990588590099_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xkkDm1ONjQQ7kNvwGMgMmW&_nc_oc=AdoEMV19Hkw8gaNn_qm5dbN18ajvaeqDwlMYbGRsBWVEFlRUbf5foeHPNsdIissJMKg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af34vPbS7TPXqG88KQv34ee3FaQh7Odz4YQ8Oq0nzW524g&oe=69F0A6AB"}, {"file_name": "Fluent XR Logo transparent.png", "id": "212845385153628", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974821_212845391820294_4065972029516719811_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOpHakif9OUQ7kNvwFr-qe-&_nc_oc=Adqx0TG8QzbRUlax2nMQGomuj_iKmLvIPox15UdXyuVfpvkmK07RPKyo6qOiUBBt9mI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3vSeDZ3i9Wdta4IHbqK7DNojf2EaDbsTklY0KV8WtXfw&oe=69F0C416"}]}, "id": "1137501624009601", "locale": "en_GB", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FluentXR", "keywords": [], "long_description": "Unlock a personalized language learning journey with FluentXR. Using mixed reality passthrough technology, FluentXR transforms your home into an interactive learning space. \n\nStep into a realm where learning is not just fun and effective, but also deeply personalized. FluentXR is not just another language learning app; it's your own private linguistics lab. \n\nTag real-world objects in your space with text and audio labels, making learning immersive and contextually relevant. Dive into our Word Shuffle mini-game to reinforce your skills and beat the timer. \n\nCurrent Features:\nTagging Language: English\nLearning Language: French\nMini-Game: Word Shuffle\n470+ available tags geared towards common living room objects such as \u201cCouch\u201d, \u201cTelevision\u201d, and \u201cGaming Console\u201d\n\nFluentXR is an ever-evolving platform, continually expanding its selection of languages and mini-games. Achieve language mastery with FluentXR\u2014where your home becomes your classroom.", "short_description": "Transform your language learning experience.\n\nUtilizing mixed-reality passthrough technology turn your home into a dynamic classroom. Tag real-world objects in your living room with 470+ customizable tags for learning French. Sharpen your skills through the Word Shuffle mini-game.\n\nFluentXR is an ever-evolving platform, updating with new languages and interactive mini-games. Dive into a context-rich home environment that's both captivating and practical."}, {"images": {"nodes": [{"file_name": "Fluent XR Cover Art - Portrait.png", "id": "6647755272010080", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982588_6647755275343413_6975862371154701560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUFyv5SuQh0Q7kNvwHGsEV6&_nc_oc=AdrGL47IMihCmiYTvdVvtlEq5oWt44H_NxZQtrQwunb60agNHYB2mcy1oIlwohoDRiA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af09Ec8oATgwqMFrDg503jVy28mIum0KIkCymJx8Kch9IA&oe=69F0B4B4"}, {"file_name": "Fluent XR Mobile Icon.png", "id": "2082304598777986", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974858_2082304602111319_6670855186104070571_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=md-FpMAsRicQ7kNvwFvBrkE&_nc_oc=AdpUHLn8C-TS57ttr1aJFJkTsfJNEARDAT6QkQeop5XUpzNU4mMGh8Bvi_dVy7SWbNg&_nc_zt=3&_nc_ht=scontent-iad
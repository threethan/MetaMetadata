8&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8U2jVtcv8QQ7kNvwHCvdGg&_nc_oc=Adn5Fw9n_LIOnDS7ATsyPJyFmSMBNQZbFqSzXouZ7UAhYwNTCL27g30rw5mYrMNBsxI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsBrxVhPtmrH8HUH5LbLq2DRXbfBPmXZt6V9eOz0AUiWg&oe=69A6CD56"}, {"file_name": "ScreenShotSelects_V3_02.png", "id": "978822162839374", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974797_978822166172707_6027340430733556510_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODRAnADiIHYQ7kNvwFkFkDN&_nc_oc=Adlllmwsq-RM4mXMK5xi2ryUFraGt8Q72rXDOWTKy_Psv-h1kkqU39tdoXDGDXYPq00&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftrDT7BV6qxKH1duU28wcPteIOMcSK_RMXmr12prclM_g&oe=69A6DE0D"}, {"file_name": "ScreenShotSelects_V3_03.png", "id": "390001285913890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_390001289247223_474467111710469100_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OK72-wwJ2NwQ7kNvwFtMvhU&_nc_oc=AdmHJEC57QULCpCAlM6e1YfYBloEU-bYM272jZZLmb3cZKKwI19HsPRQXMFRbgW7VIc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsfYO6j0qSc5nDte5vaat91obVy97BbTsllnE3WQj8ZGQ&oe=69A6E0D3"}, {"file_name": "ScreenShotSelects_V3_04.png", "id": "483143273474975", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569474_483143276808308_3539406548815015503_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsUEua8MMEsQ7kNvwEdZ-Sv&_nc_oc=AdkBW_MMzBilwtW4wvjfPXZX7WCXSSME5W8RYFGpfcYTsutVgccOaiNiHRcx1Z9eTW4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfufqA9jO0_h58cQ4ATp6qJlxrAE4RrG82WVvvygR0J7eA&oe=69A6ED92"}, {"file_name": "ScreenShotSelects_V3_05.png", "id": "1542998046074795", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974853_1542998049408128_6977835342410392914_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1axVNNT0H8Q7kNvwG8f6aQ&_nc_oc=AdkPTYDQpvVdObml5ew5x64uEQlseP4EltaINYLVodBFwBKQCXrIDYPvbqsCoaR2Mj8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsqIZaNokdoxo0qKPqIhkyogkfCNCKdcSzNkVb7fFJWfQ&oe=69A6C1B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover Image_2560x1440_2.png", "id": "502160987954598", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974738_502160991287931_8356783430210980710_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVMrFOyOcZwQ7kNvwEmKIdV&_nc_oc=Adk-fOqasfoXUW8xtt3AWihYg5yeaqMChyKE4bzeV6Kkvof09pNQNfHKJFtidjkmYKY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvGolklXPrhuss81Uvpvtfk8xFWfyGLAMlOTqJ02VB1iA&oe=69A6D45C"}, "display_name": "OcuWeld", "keywords": [], "long_description": "OcuWeld Provides Training in VR on:\n\u2022\t19 different modules covering TIG, MIG, Stick, Flex-Core and more\n\u2022\tA specific welding process  (e.g. The tools and method used)\n\u2022\tA particular weld position (e.g. A 45-degree pipe weld)\n\u2022\tAnd corresponding type of material (e.g. Stainless steel)\n\nOcuWeld provides enhanced academic benefits for students in three primary ways: \n\u2022\tAccess:  OcuWeld is fully self-contained within a Quest device. Students can access OcuWeld any place, any time, with or without internet connection, if they have their Oculus device with them.\n\u2022\tAutonomy: while OcuWeld will be fully integrated with our curriculum, it provides students the autonomy to drill down into process or positions where they feel the need for additional practice or have a stronger personal interest.\n\u2022\tAmplification: OcuWeld amplifies the student experience by providing supplemental learning outside of the classroom environment, reinforcing the skills and knowledge these students need.", "short_description": "OcuWeld is a new and innovative Virtual Reality (VR) welding simulator designed by expert welding instructors for welders. OcuWeld provides welding students the opportunity to practice hands-on classroom training in a virtual environment, making concerns about safety, access, and cost of materials no longer relevant. OcuWeld fully immerses students in a virtual environment that mimics classroom lab training and provides access to lessons that complement their online and onsite curriculum."}]}, "developer_name": null, "developer_privacy_policy_url": "https://stratatech.com/wp-content/uploads/STEG-POL-70006-3-Global-Privacy-Policy-1.pdf", "developer_terms_of_service_url": null, "publisher_name": "Stratatech", "support_website_url": null, "website_url": "https://stratatech.com/ocuweld", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1170872266981413"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "503336226125091"}, {"status": "PUBLISHED", "id": "752666329512934"}]}, "baseline_offer": {"id": "503336226125091"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1736947680, "status": "PUBLISHED", "id": "503336226125091"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "33531505286464190", "version": "OcuWeld v1.5.9"}, "id": "971615530116612", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6904853139556100", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "33531505286464190"}, "release_status": "RELEASED"}, "binary_release_chann
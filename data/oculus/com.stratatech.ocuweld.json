64.5771-25/39035393_339311578157838_5467537542582240817_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qOxBbsLbzwQ7kNvwFLmnt6&_nc_oc=Adk_lqGni9wLSOKEnIU-RN3ItcQNKYVi6l2q-2AShdippeN7ggeZg7MjuswQ7RNfyms&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyH8gUWZU2DwIkZcj3wDP09d_cHiJvjv6DjrJxtw_cGtA&oe=69B69F56"}, {"file_name": "ScreenShotSelects_V3_02.png", "id": "978822162839374", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974797_978822166172707_6027340430733556510_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqR3RTHvG9kQ7kNvwEyJBV7&_nc_oc=AdmtogErIFXK2cKuF0R2F_JxWduOp8QnmdUzDpyIhidQjUf78xGeV7qbyCxFB-D9cTc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0BBlMRXiXVPbxvK6pkVjzMQEsJcGfDonBX9vmHJ6Jjg&oe=69B6B00D"}, {"file_name": "ScreenShotSelects_V3_03.png", "id": "390001285913890", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974526_390001289247223_474467111710469100_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8PFiKwBCt4Q7kNvwFlCNFD&_nc_oc=AdkwwnAVUqhFWYi1jzVDsVQ2H814DLsZlPKHufl5kC4ZfgjktAea4VJJYzrND0hUM-c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz81LFF8-VBRsYu7Lr0JVzMhQX79uehyaCIhoNcQTTPMw&oe=69B6B2D3"}, {"file_name": "ScreenShotSelects_V3_04.png", "id": "483143273474975", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569474_483143276808308_3539406548815015503_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPbCS1Tt3jcQ7kNvwGUEq7L&_nc_oc=AdmqT7byDKGllCpITK1qlHjx5F7-QjUiUixTEgAV8xc5qNRNv-ZjkKaiS9X5XlJo5Ng&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFN7komWXXrXKBUMxU271HpRe0LPjxVUZX6iAeTrHOCA&oe=69B6BF92"}, {"file_name": "ScreenShotSelects_V3_05.png", "id": "1542998046074795", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974853_1542998049408128_6977835342410392914_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBbsNTMgKJQQ7kNvwFbT78c&_nc_oc=Adma4Knhx4YBtNzw5jV178ezg6eMNj-__2kFpX11bfzXsynCKpruMQJkE8xszkFpUAM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxSO-QFJmAfHP6x7qxQE617cVh3pZv3Hewz7POglFnXNA&oe=69B693B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover Image_2560x1440_2.png", "id": "502160987954598", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974738_502160991287931_8356783430210980710_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrzz7Zi9eZEQ7kNvwEhJQIs&_nc_oc=AdnrI20z9gNhEkYrZq-wFIDegc8UY7URHtZWyUwPnj4O0mBDz4T5frIijS3rkHq96l4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxt30PUI5CKDDmquFTONhqu-DeduFrknA2o5qdCw2iohA&oe=69B6A65C"}, "display_name": "OcuWeld", "keywords": [], "long_description": "OcuWeld Provides Training in VR on:\n\u2022\t19 different modules covering TIG, MIG, Stick, Flex-Core and more\n\u2022\tA specific welding process  (e.g. The tools and method used)\n\u2022\tA particular weld position (e.g. A 45-degree pipe weld)\n\u2022\tAnd corresponding type of material (e.g. Stainless steel)\n\nOcuWeld provides enhanced academic benefits for students in three primary ways: \n\u2022\tAccess:  OcuWeld is fully self-contained within a Quest device. Students can access OcuWeld any place, any time, with or without internet connection, if they have their Oculus device with them.\n\u2022\tAutonomy: while OcuWeld will be fully integrated with our curriculum, it provides students the autonomy to drill down into process or positions where they feel the need for additional practice or have a stronger personal interest.\n\u2022\tAmplification: OcuWeld amplifies the student experience by providing supplemental learning outside of the classroom environment, reinforcing the skills and knowledge these students need.", "short_description": "OcuWeld is a new and innovative Virtual Reality (VR) welding simulator designed by expert welding instructors for welders. OcuWeld provides welding students the opportunity to practice hands-on classroom training in a virtual environment, making concerns about safety, access, and cost of materials no longer relevant. OcuWeld fully immerses students in a virtual environment that mimics classroom lab training and provides access to lessons that complement their online and onsite curriculum."}]}, "developer_name": null, "developer_privacy_policy_url": "https://stratatech.com/wp-content/uploads/STEG-POL-70006-3-Global-Privacy-Policy-1.pdf", "developer_terms_of_service_url": null, "publisher_name": "Stratatech", "support_website_url": null, "website_url": "https://stratatech.com/ocuweld", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1170872266981413"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "503336226125091"}, {"status": "PUBLISHED", "id": "752666329512934"}]}, "baseline_offer": {"id": "503336226125091"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1736947680, "status": "PUBLISHED", "id": "503336226125091"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "33531505286464190", "version": "OcuWeld v1.5.9"}, "id": "971615530116612", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6904853139556100", "is_concept": false, "latest_rele
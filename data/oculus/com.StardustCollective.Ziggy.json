://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zFFdtH2e5sQ7kNvwGCVDC4&_nc_oc=AdphJNhP77BcwWa6syR3Qp2A9Pyc0iz9VvZe3ddxVqWZMmEMGef9RNWq1gvezuQjXxw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNstB4frXuvOhZSSI_3iG9IT6psXisNGgcsHo68r-6kg&oe=6A82EBA6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8729SZgOXMoQ7kNvwFyTpad&_nc_oc=AdrtuqsnWK2_gc7GbiLIOEyGqMLGNDDAVYo6cDk_x-hfr49QU0Q__uHnD-B1KICz3YU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXeEADPBjxH1deitEhSori-LPlmj6_6D3rIUaG4ODY4Q&oe=6A831932"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mt6KAdifDvkQ7kNvwEm2TaU&_nc_oc=AdoQWMRewjfCdhZiXQOWlg1vgdqhg7A6XWcXgOPZ94MfwGwidBepw8gknEfoGsxBF0o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiBosqaXs0T3bVV9q10x9MMUmUbto5wti4nILYFH55Zg&oe=6A8312FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HbkJ-vgsPikQ7kNvwGjWiRy&_nc_oc=Adq2jaGra5X85CjeoeCKi3XqL4UhBw6p4sOJWT1k48E-xC0DRzHXEDPfocpIqpsZeU0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHps6CsNnVj6sf4yXoultUTINg8dTq_YgIa8xZpjTP46Q&oe=6A82F033"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTTD4b8hDkwQ7kNvwEtlpwB&_nc_oc=AdqI84OyuJZSimt86IXMXW10xLJOjr6s3Oyasre7qGhIA5TyLC38vZWILOXCX4kW8I0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIy74xDMl3DjM5KgS5-AK2QsbnLkBHtkYa9TahHXHN-g&oe=6A82EE32"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0-n9kq-9VcQ7kNvwHrTPCS&_nc_oc=AdrGsiaPxH16VFhJGtojOko3LRytll6hzzpGZqqcaFnkvMa-4e7nkfJ3fSA-zHe469U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEptvLAjen5T8im-zE3DFNu2rdcOKS6huDZYDKEecBuxg&oe=6A82E593"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4TNZF63JEkQ7kNvwGbc6hG&_nc_oc=AdpEHlBztk6TbzYMZTYE1BB8sIItq0t3OBeoaw6w-MDJ2KGXdrretAFrCRHknsynGao&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFk-y7cyOaRFM4fQFh0pxz1EhdrO1r5XthfQ6dKnVD0w&oe=6A8319EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=liNx6kCqlUQQ7kNvwHh18HV&_nc_oc=AdpBkhHqHu6tS8E0pOj0gbc4wkGNqOlOY1ekH0CwK3QeBwykiW-EoxRa_QGW5a_2I1M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQEvjjSzEU_otsdaggt0kbSsR0zF3IJuTn4fkl0tuY6w&oe=6A82ED62"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
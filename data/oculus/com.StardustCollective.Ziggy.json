://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YA9C4ssr3g8Q7kNvwGG3vlV&_nc_oc=AdoVGdAbcbCCeIq5vdSuRPUvovYTF1KRhhTMlx9gf2eAdupPBxcWTE8duriH6RoU4Gg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wgnDE2LbTe5HUuIsix1XuUlNKvx4nVX56ujf1AHaRHg&oe=6A009F66"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OetNdfLtJPYQ7kNvwEwnBVh&_nc_oc=AdrEk59iBOU8f0NWGsmVGxBzIaNf7ptKOfcEz7PVM3hD7dXTUKbSHO1r_G6KmngX55k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cPYtpBiZY5iBIP7KfuV4x_JwsmRhG0XQs5q2HxxaoFg&oe=6A0094B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWtzgZw-LLwQ7kNvwFV8vQ_&_nc_oc=AdqdEGYOdHigeQ0z5ic_ScQRzWbWIyOCUHYBXdp0JkpgSpefFiWNcs1fQE4ip6pqj58&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QChjUcrYX5ejjdR3H3lkBPAYzr5G3I5dG1q8Zh1u7-g&oe=6A008E7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4v-ooudRnAQ7kNvwFeDiyi&_nc_oc=Adqyo63adjObbmY1Sbwf2DLOtHwK4B3RgxUiejoCYzrLmBYGRhE0_2TBJ9uCDVMEX0Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HzCa8jHVNla36FH2dTiJNWHMBBsxA75oXbrWCHRuizg&oe=6A00A3F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5e2Bm_HAbkQ7kNvwEmlitG&_nc_oc=AdowZ1GlUmKmb_Qr45GtMXFd2BZPXE5S3zpG75p2LXbL3Rp9t9GBT-oKb39aTBAuLjQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IYl80Fus8N8Obr7OYA2qhZddfDKe06C__nW-9sRffMQ&oe=6A00A1F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-DNkzygpnwQ7kNvwG4TS1Y&_nc_oc=AdoCMLgg9Q6sSlJGGyjSx4MeFhewTveJAzk3S38TO8Ce0wO3usmJRuaP9Frbuf6frqA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af493VVWOyPrhjFQctCr3V5Vp3q3P3DI-eXhIpOIkC_odw&oe=6A009953"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ih-JvqLFDyoQ7kNvwFD29sl&_nc_oc=AdpHo2SsUtI35CfLRl1PMf3UVQZD7kkNySCubuGKLjodBpTehoMt5z-0zXM5FKX1lxw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7B5_XevmE_RhrMyh2-3Uu5iHWq6ajj3NDPDLGex2nDKw&oe=6A00956F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gqBpOvAHTrkQ7kNvwEpOpXs&_nc_oc=AdqH_OySDqwKz2lVGqFtuQPwDVVoY1iqetMPC1Y77VkmNDli8GGgY18cObP8gKAJ3Qg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DlbvSo7jpLhBrFN_iUhpl6f-ssJVFwniUgoGs-jgeAQ&oe=6A00A122"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
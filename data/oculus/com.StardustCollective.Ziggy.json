-25/38974500_800214781605120_8880468551637015930_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7pSh-h0fmwQ7kNvwFEbrbF&_nc_oc=AdlXQUOmPmxXhUAhjmp8kzNq1Grnu7uom1XEtnNgiJ4gf_NhrDRDaqrlWuUDy5dQbQY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftJhYMXPzzimYAm6BAMtKOxYYtwkng-775I9p8VMx3ISQ&oe=69A595EC"}]}, "id": "1005005773748906", "locale": "en_US", "screenshots": [{"file_name": "HighresScreenshot00011.png", "id": "1326199667974786", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035386_1326199671308119_4397089309417940909_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvRS6y-c0GMQ7kNvwHB_uX6&_nc_oc=AdmYJD1uaXx7J3ZowVm8TSz-9-9kCO6pk_8ZSQCwllZwTDKN8gwT6oWmfBwdm1OkK8o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfulLTLX-d1g2y49bpqm6w5wLK4SZq2uzomOZ9gFo-qTGQ&oe=69A58F5E"}, {"file_name": "HighresScreenshot00028.png", "id": "2412721535575051", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974577_2412721538908384_6467288184304840049_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3APH0lQ1-IQ7kNvwHWiHqW&_nc_oc=AdnHHBq4_oVZZ19mLqTWj3YM5Bhed98bEaM2vbUnBzKqMPZv9vELeg0hP6kCFjSeoL8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsRooT60IfsSphjp0FnkAyDYWdx4pmoaSDWBHsgTzKBhA&oe=69A59FCF"}, {"file_name": "HighresScreenshot00014.png", "id": "997351624641332", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982456_997351627974665_2778603811108028476_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0Z20bs1l-8Q7kNvwEDTPn_&_nc_oc=AdmKb5qOQxlSYYK9ieGDY_zXRQANoquh6O7oGprJGw5-IbG7hvEY_yX4qtB8GzWOEo8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftYlbwEwc4vOXbeF1JJS8vUfkZTg_kQ9r6n42Qjqj2lhg&oe=69A592A1"}, {"file_name": "HighresScreenshot00040.png", "id": "807733037419699", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984472_807733040753032_763200239777074167_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMe3Bn5Cs38Q7kNvwGd_54S&_nc_oc=AdnxN-DkeZc5R_-OVSNP7lUlPOtzPxZAPYWkA9No12rctsfEvajwUy2K9h6_DF_JNu4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsWHtVgkiaih-hLQCAJA4wS6iKPYeOs_KBkwJ7MrRyMNA&oe=69A57D78"}, {"file_name": "HighresScreenshot00146.png", "id": "163970600033098", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57566678_163970603366431_5435931785999963108_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pk6tQQYNYuMQ7kNvwH1LO3F&_nc_oc=AdkFP4brw9UzxlrSSI-nwM5mvT98lfbS21FvOiNdavfleI2ZQv3ZoESDNEEqHsuQuh4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Aftm4KZAvegLnPMFVQH3fHTFb-Fl2z-E73Ue5psrlAVzuA&oe=69A581F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajUktLZuk0IQ7kNvwHUtirr&_nc_oc=Adl0Q1UZLrx_ruc8fIKuomSgfgulyOl4lESZDxVqwv6K1lEvEn1gYyuPwVIht6xmY-0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfubjwvixiqvoyWCv0SUeH3ZfGcPRU4AfMh4hkvY3gOmJg&oe=69A57232"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "1324311035174797", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984472_1324311038508130_2610060411856834928_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Od9BhgDvdckQ7kNvwGAL1nr&_nc_oc=AdnNZpJj1spB8KU-LVgKRwMsbEGhojH7HwrI-y4xfKNeybIFzxys4pv43eLsoHjUkpU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afv67yTyoJeQbn4l6oz1_iQ1o0vls9vfOoImliAuoS_QLQ&oe=69A56AF8"}, {"file_name": "CoverImage_Portrait.png", "id": "1021944422558335", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031612_1021944425891668_3460677483354056217_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGBGiqGBJJQQ7kNvwEWhddt&_nc_oc=Adl2RxBOlTWceR0qCHWqVAVvSaa3eUqdhI2aieNJ3Tvu7VIowpNmAjn3l1rXFGCoNFM&_nc_zt=3&_n
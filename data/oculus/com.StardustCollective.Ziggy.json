://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KdOznZlMtgQ7kNvwHRi5gj&_nc_oc=Ado3aT5xe97zqM8g3LSwqmbAZUngj9nlGijgZNDcmLG5JTZwlDv2wCJNra-QVEKxg00&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ADtWb0ng2fRf_kZxLPWWm3Hmgqxk0r2PwzGtOas0HzQ&oe=69D39426"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWJHglq192EQ7kNvwE0KeEv&_nc_oc=AdrVBgGsYSskMSZe94U9Msn177TKKMS_7hDcEPY_J_IraJvwl5Q-jFVuw6sV49lk7bo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vkKmvBp0RYiH5OeAt6bchvG_pXcNkVAdA2GE7ki0N2g&oe=69D3C1B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4zj9iIfY84Q7kNvwE6ETZs&_nc_oc=AdrFrL4eNzTItvLmYLlNfsC7tjPcgNur1AUu9GQ8scvGIJBcyiPJt1a28WuGoflACMU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32IHpZq2XFdhIRF54Widhd2I7Y4egvcHm4CCtjRJ2QRg&oe=69D3BB7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L14BBg54fnQQ7kNvwHCwamE&_nc_oc=AdpHzqkwa1JccENMjO483s_JYeiVnOOUdW6mMUZd4UdEh5bj0ecaTcWcHOStGq5ds3E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32iW4u8XWSca8fwadLEqaS0mcmy0Pix-zE5SckKkGdZg&oe=69D398B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7Zl0luW-jAQ7kNvwGEJ0Oq&_nc_oc=AdosBU66hJzlXa63xxA0i79VsUFESNllPEuY6Uctxo2wX9L-mO76Jup7pLL2ZvI9_fw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08jG0v0GbQAQGDH0JF4OUeXRLSDSNASzSQPqHyfNEl5w&oe=69D396B2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iETFOFXOumkQ7kNvwH3L7mY&_nc_oc=Adot1kCVPJe69IaZi7jzPdzuae99yE19OcNHKZTvt9WLCVxhKDFb5Dmq46GV_cXfvog&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nyI2vvF3W6cUQEKl8ttVX-hQ4iRh77-Xy30CXGPJG4g&oe=69D3C653"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNldto8865sQ7kNvwGO_ana&_nc_oc=AdqR1l8b3pvMSQSNLGzyJV-0Ho9lF24JIN-NrWoDcBlifQzlLLK0t1rMXNt8s1cnInE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SgCYVqTq-bleOvR0ZLTG9mL76rbqSMMYR-TShYG8U4w&oe=69D3C26F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8U7dpu5Dg8Q7kNvwE0rYr7&_nc_oc=Adqjd3u-aBVg911Dq6d_ycifOUyOKFz5HvhWFuMzChEeJVME8_GDDMSxr69BLi_TBlY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xPqcULdPMgJAhCpe6jeb0O2V2mIyGoBPEzSZ0ih7ulg&oe=69D395E2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
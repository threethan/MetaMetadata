://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmgI3qXplFMQ7kNvwGtCIqG&_nc_oc=AdocfLffRaD2JE7Gjef_h9YNUSNx2qoc5sRi2SVkvVlBd6p9_AXo7L--lW0dWz4s8U8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Pn2uQKCGvguRdJtv53TpJttzxyliZedqhEQ7y6cyZDQ&oe=6A0C7CE6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUkxOmZakgEQ7kNvwHsq2kX&_nc_oc=Adq3qp1A0hG61kNCFOsSHOGnV0glXjbRSnCj0H4emR9W5jnro4_muUD9hJGKQqZZjAM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5v97TTL9TqGc6r53dCl1ikwZ_Ugua8_c_iCPSPYWh35A&oe=6A0C7232"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97A4tKsZON4Q7kNvwH70HQr&_nc_oc=Adpa1swVsNJoZhrNGHQrDlIhWZEAKK1iBXRw8roFXvJh9HcjpZIFHMM4Qdzf022UhXY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68BupGOcqjU840BOa4GAxaMPC7vuZlnFTNn1MWiJ-sqg&oe=6A0C6BFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1r0-lQqRr0Q7kNvwHteOzj&_nc_oc=Adqijo2ZV1-njkBgHOXptxo_459FufMTcRkhMkeGmGe_6J7zOfPOOJsiQsb0NT3fmp0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af453vvYcyQ-Ja8c1A75ac6yk1iowp5I7fW4nxIFFhJHzg&oe=6A0C8173"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3D8cUufkl4wQ7kNvwFjl7oB&_nc_oc=AdoJ5hPJGrqfD7ntdE50Z7QELQLsRA6YZF-dJh_Y373O0evlgv4LmY3hxkTh6Yr8SO4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NRX7uwvQyq4V14JReHjqYW0pMcuelX54m-_aFPb9eGw&oe=6A0C7F72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLrq8rjasxMQ7kNvwHNq0dZ&_nc_oc=Adp7p5S8oL_DqHkhcPm3l2PtZ55Sg9IbAq9mQMtyx2zOCJDEppggC-e9DOelSw8IgRM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uINQuT_Isps-L2HFR7rIKkiH2IJiuxOLbYz6iZenv2A&oe=6A0C76D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2f8c-B3JZbcQ7kNvwF9ZHpl&_nc_oc=AdoCePjzIsFje8Lc3oCvrTMZzXMJgGwfbY42Wsn6s9IBfufzj1HA_2bizxsSIk_otcQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4D35zfTU6EeuZJa7kCeD-ERp_TKSANC_AeU6MgrWvMSQ&oe=6A0C72EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wNLK4PjmdQQ7kNvwEa6JHQ&_nc_oc=Adq8SRWxerE_BsssWZwuaHP6edgAAZs5iF2maB7P1EXRo08TMV9yI9d5waBY6fKl6gU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oBSplxkiqN4M93IXIVaq6_Fx2EVza-VLfQxc51tOrbg&oe=6A0C7EA2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
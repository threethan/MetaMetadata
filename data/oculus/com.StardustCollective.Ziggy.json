://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1Af8T-BCtAQ7kNvwEi5vUs&_nc_oc=AdqQORzAUcXIe_Md0qbiFVswgOgTrnisNokPOPCNZf7OQT-Dm6bb0GKvGGwIsES7zHQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWQd6sKgMrolRyb1MrwwDTuw_Z9qNx0fd7jMH5TQjCcw&oe=6AB93166"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfJ6orsfkfkQ7kNvwH81Fcm&_nc_oc=AdoBkMedrY2eZYx3ktsVnyB08G9wkSVn_616RyktkEV2dKgu4Rce24HS34y2fzuyNXU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKchYNERg1qhVJSAKGpcPuXu_xCcaHkNRVPiJE-R_sUnQ&oe=6AB926B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8QlNcx3ls8Q7kNvwFZ_y6n&_nc_oc=AdrC56j14BqjxgTe9LVKBMNbAVMe09_jgsnTV6n1OVX6egev--YJ1uPLlo2UExwQQWo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1b7UDX5Ojn19ShZdO7yOpTGSx8oEhW-vC_WCnXveFvA&oe=6AB9207B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lUvC6q1bWcQ7kNvwFQajbD&_nc_oc=AdqK6N8FN9tjyOOsKROfQpW-7vP7yU8z8kV7quh34zwzDRnRxIcQ1rgQFrVSuKkON04&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInrcvIDRe0oo55W5uiZBTXfjqhVcRhQBjUnm4qESvVWA&oe=6AB935F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ueuGzCH02cQ7kNvwGHbNij&_nc_oc=Adot--me8E-PWCDGrR8fcuJxToctX0bvvhgQP9TUO10r-rtSCeL_Nv9bbgI9PDhIG_0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIX2mNmxBfko3zdRrQBAENvPeLNqCVTlG1hj6xffkM4Uw&oe=6AB933F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVYwb3xqbkEQ7kNvwFhWhEB&_nc_oc=AdrZoJGIK09ut1GtQH8Qksx-auCDkx_pWRZT8waf1sLMpVkf9Ye8GwBCV3jFHHnC7lo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDl0MdCYTmL6VrJbDh6aWUJvGLfYiDig-w8ZlkfoUl-g&oe=6AB92B53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlXQbtTOaHQQ7kNvwHZL0Ha&_nc_oc=AdqnpEVqmrHfECV4AKbaOTtYYoGtNP7J34-tSwOcTUT3sbvPDeZ1LPXK7c4tO4F1r1U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhSWunK86qvA9JnhqUlxzkun1rp6_MqRq_B_g7vCDqgQ&oe=6AB9276F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTs9ctW2HgoQ7kNvwGUEIam&_nc_oc=Adpb53BB-ED56isxT9gstVdGYz8xVicarotsoSw1TFI-H-drS-B3lPHUlzl6bONDvf8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhdlxzGMP4Z61i2ilgBFicJocdb3vrfWCoV4kDVltkhg&oe=6AB93322"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
5_2778603811108028476_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxpbusRBdysQ7kNvwFszUfd&_nc_oc=Adq0seo4kYNNq_mZ9FJR8HVfMqIKYk9bqdNha6uUsduJIl6P-E4bTR0p0CdxS9mIJ9c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6c0AxFZm8LS_vnrGxvzVxHyZhnqsROaNKVI7QrowaaUg&oe=6A05D021"}, {"file_name": "HighresScreenshot00040.png", "id": "807733037419699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984472_807733040753032_763200239777074167_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6yTVOb1vHkoQ7kNvwG6ixXe&_nc_oc=AdoWv3wvTqY9hy6pBcr5bdPAmB7Ir2M9Cyd_ju-eUP7eadJiqfTHSAw0rr54L3vWklc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7j8Hw2Mr74xerC1SucJVTn5pqiHpEJ5Si96cmZ1XLSSw&oe=6A05BAF8"}, {"file_name": "HighresScreenshot00146.png", "id": "163970600033098", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566678_163970603366431_5435931785999963108_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbiUUgUUIBoQ7kNvwFQ89Yg&_nc_oc=AdoencxNNq0LsgwYwOzIAyKmxF1-oIO9Tz_NOuUVJDEPHA3wYZEPoHtnVJO52Ui9qGY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qnnZkUQI162hA5fUfKNQ6UEMUsTiLA8ry-EomLodNhQ&oe=6A05BF71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fzNJYdWtY0Q7kNvwEyPDsG&_nc_oc=AdpC27lDjSu7YTXA4sK26ikEzhofYVx5QtxAkUzlkU7FO-mH8QJTnapXc58R6F14-NQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QRAHFJKE5LEcVs0eVQZdZv8syAe43jhi_7HIxklnY3A&oe=6A05E7F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "1324311035174797", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984472_1324311038508130_2610
5_2778603811108028476_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8yuQPRxO3YQ7kNvwGkQsbz&_nc_oc=AdrdppwL9ehP_9Fa_PVllghACWTpqIdfM_q3k9Fqzw7VC8hIhmh2T-ORK0obqRHa0SA&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bHMDDKx3MUnYk72R7PU4dJ_D3vBC1EJ1_qzK-LL1tdQ&oe=6A105C21"}, {"file_name": "HighresScreenshot00040.png", "id": "807733037419699", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38984472_807733040753032_763200239777074167_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVp50tWgyvYQ7kNvwHdD6vq&_nc_oc=AdrzwWzXy9VPw0sgC4_U3f9_2cdKZqXjHqsgtDv1-FXet-XRMeutTPL4NUuPORGidVo&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CfVmBA03q3MvC5PKq5bYtmyz2r8Gwl_glmb4m26Yg0Q&oe=6A107F38"}, {"file_name": "HighresScreenshot00146.png", "id": "163970600033098", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/57566678_163970603366431_5435931785999963108_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNtOpkXCqiwQ7kNvwExhXQz&_nc_oc=AdrQvwd__F9wiO1zPpHEy0m3FsLrIiMGBEajSYHFwDbSV7jmfgngCdWqkLZ6vwbLMFU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6driFF6832Qk9Qc_-_L-TYQOoGlflMhqK2BFBSYoDOrA&oe=6A104B71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJVzxP2iZksQ7kNvwFm3-WQ&_nc_oc=AdrlP9I-M1BmDKBMmOZsNuWX7GDDyx-DdKRZQq4B9Y1tiwjfdSSumTJAtGx78Wfvuwo&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bDJBEjHQJOfnyKV5f6RRsO92MCRlPCtcHf3Kj6BzR1g&oe=6A1073F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "1324311035174797", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38984472_1324311038508130_2610
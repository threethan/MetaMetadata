://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KdOznZlMtgQ7kNvwHpIEvd&_nc_oc=AdquN0_1AC6CMbc2Unj8dULfiZLAeUnHd51QEJOajY4_FIZdbqC7I-jQjeGFSm9sXHQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jbANK0RcbMilv9664RNpHify8I-IM2DSBsc7I4d45Kg&oe=69D4E5A6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWJHglq192EQ7kNvwGGx4K7&_nc_oc=Adqb1M9R3ueIg407l_6aBdKlMpL-JTmoa3nA3KSjcJw8kGV2SEqUaU6pVYMz_d0FbUc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Ed6BPqrJ43K1x4ugfztWsHGqZM4Fhf4I7WsF1WTp6TA&oe=69D51332"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4zj9iIfY84Q7kNvwHhyqz1&_nc_oc=AdopF6BdIF5fprJg4fjrrDpxcXcT1GXC96UKo9mRkFw2qY-EFaJKN9DWxXmH_xFOHyE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UX7GtzAduwz7qW2zDZGTRRbuDH6zJZZIzubJWSXtGTw&oe=69D50CFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFqcwGcADLsQ7kNvwEQSmgt&_nc_oc=AdrcoqLYe-yyIgm0aL4pKY-acmXxd4oNCBBFYPJ0ETUctACPb_sbAYH7wPhCmdzh4aM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-_l5uFBjHR8PKwdLb344t6TpHbSG39QLfGVFPdVPoDQ&oe=69D4EA33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHi1zblhaKUQ7kNvwEPLyIP&_nc_oc=AdqQ5E8KUuzmQLKEpKZnbbGiOwzKZtRDYmeehtuBU3Lo3RremV_b2uwN8XwhbmkPFOg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IIMwO9G-0fGFcLfSpV0xR_MZONJN1aemQmp9fxUm-FA&oe=69D4E832"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iETFOFXOumkQ7kNvwGT4S2b&_nc_oc=AdpB45NB86_z6Rw8KdqCN5g1fFUbiosCi9EN4vtKhVUYwN6il2NClCR9UUG4m1HEWgs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0h0Kg-FoMTgSIDkY0HHD4qHsSOUjIHdbSUItbpfscu7A&oe=69D517D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i94FGfosZZ4Q7kNvwEj43l2&_nc_oc=Adp9ST7jeatgq5p72_wjKqCEinfqwQscETMO6j2rE_b0XKXfwx561YJKjjUZMQuGHV8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zASaBLrEItWlnpbqDZN3iIKdr2IC_wq0Tz84yaZvSMw&oe=69D513EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8U7dpu5Dg8Q7kNvwESfWmN&_nc_oc=AdpZQ7cBwTq_anFY9BQ3gHXAd6u735MPmlg4ItXqKY4CPzhSWiaTqiF45EQQUvBoZiU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ys6RcdVqv_ZugRR3X110xeFVIyAePR2TDfKdAxUrPxQ&oe=69D4E762"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
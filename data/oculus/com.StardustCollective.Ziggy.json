://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jmLaPmaXL0Q7kNvwGy34jI&_nc_oc=AdrqleDeY3B8uHl7o3apvPxqw7V78u0I-_uT_nyKNajclpiJB3beNHJcPz3PnI6PWDU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE29zrjK4NvK0Iy3NGaez4PeObTydTLVfaHtderzm8IJQ&oe=6A74A366"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXIo7rccmDQQ7kNvwGxWXTs&_nc_oc=AdreTykLjllLqrW9demF2N1jt-QcrB3TCMjWbEwEuZWGAW15ii82TUyGgxn8XDNICVU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9oWToZyrHgc8X4YAZCXoBm4sQIVr1m71ci5LdTnt5OA&oe=6A7498B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T10B7D4O4F8Q7kNvwHzj_St&_nc_oc=AdrJm0SSgl-91qjGO-9OUeK5ec424bR5Un28-JjBZibzr5-1EjiQfmq2-9l1iyfwA0w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrlv1zrUIHEiNL55lTIOr3oCZ5Z-vATqmavb-U93v-BA&oe=6A74927B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoPpvYN4oYYQ7kNvwFhV9Su&_nc_oc=AdqViorto6GqV_kMkqPvh6JpiOiFuBbgA9ZFj3-bY4PRUEUECztpnlE5G3Y-OUraJDs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmvOIDbTV4BXnvOYmtS7BogFQUoKrPRWcJ8ZLQMfbPzg&oe=6A74A7F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRj2P9TuJBsQ7kNvwEQbiMA&_nc_oc=AdpxS1ECd88d641QB9ccejtYxuTmq4NNkLAHsZBFRqDwZVQ1MMWKG2-GbWdl1b9cDhE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFV042378HFLC3wYiWc8APqWFVPB9OPbAumJZk7xL6_Rw&oe=6A74A5F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8KcZegqe0gQ7kNvwF2f_nW&_nc_oc=Ado1X_psVbS41HPHa2Awp8XgvZaSPs50bzl3lgrtv9713bJL7N68FFPa3yU-UWYpMRA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRRuWlNdSZVgTkZJ1ute_Oz9bIdQmI8PvEYoeuI9jaNw&oe=6A749D53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fql5EfOXt9cQ7kNvwEoyqjl&_nc_oc=Adrc2HGSo01is1YsmqK3x9mTySthU7eKA8Q6Y0CIBKclOtXxjpqlP4jYrSL1tD0Vsmc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3GgsUKzRRPxNk0yeZkuLT4YPyrif6pCJhr1_RPRm5Qw&oe=6A74996F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKn0jE-MOlgQ7kNvwFyul04&_nc_oc=AdoeUFGrYyaJDGsqH-ATzUO1r9C1IA8PX_9_XkQaKRtYyYUt67lZNnaghLZ5mBCMV-0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGex_-ZWebAHKAWbLaJ3u_gegkxcQUgLG9RKNAmZqlJAQ&oe=6A74A522"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
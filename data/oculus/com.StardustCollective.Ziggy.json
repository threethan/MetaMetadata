://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AxMMzou-UsQ7kNvwEW6oaT&_nc_oc=AdojZgBbYA5wYi_c2tGcz8KZNPlQPNHHUFYNAJnSmynFBAL78HCIx2xPJYjrX9a0VoI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNv8H6NimJDXA58KWAc-caKvqC63oeXIv-ArBOgfVVRg&oe=6AF87966"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnuCi_isvLIQ7kNvwHsgofT&_nc_oc=AdqPnW2LWhodCipTBw1gSGXAGRa9DBrmeH0u7nhjMNcDRTAK0UEotHUO1pzYcv5Izyw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQw_hDqWbTxe5_plOs5vy2l7UyUd-Cidc6QR2hRaDW86w&oe=6AF8A6F2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4P6b_A8PDMQ7kNvwGGYaph&_nc_oc=AdpVxstFkfIuSnGzYQ7MoyMMZCyKre3mrOJ8kE9ZIj-nnfHcwqfqYEP_qbdL_SkdfNI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqatIi--JTZlRcpRFyJPT-auZs_ETvsM9eieF0K98Duw&oe=6AF8A0BB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBpWyyHWMAEQ7kNvwFyW7Z9&_nc_oc=Adro-TKUhr0XV3oGOjDNIb-ZjBMX2l7bb0SYMz4no8o5C7TSxU5szeBc6g4KmJiQhN4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPRkhdREQqCBd665JLLoDmp3pml0Ng6a7YvwfPAzPBNA&oe=6AF87DF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ilVTH6dq80Q7kNvwHtNpwP&_nc_oc=AdpoAc3c4q4LYETuCX8CxrXFTLGL2R15ngS-Pt8b42OGz_e9zJgvIv9PWqePkB_r8ms&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsEX6dVhCAKbVQ2RYPl4j7uYbPh0k18-oOMgxLVMZ80A&oe=6AF87BF2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-j7DEaZ2FroQ7kNvwHJAjdL&_nc_oc=AdqQuaO2FQWLnw6GrrHqSf4-03BRf9Ny1aYyeSmh5IiX-jpBCH2r6JTo1ZxItsWKrgA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuyKT2A-H5u5Bg6xAbKcTFBA5OsWskRGjr-Bgg5Fw7uA&oe=6AF8AB93"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HYWapTegE0Q7kNvwHPmcBt&_nc_oc=AdpPsqnPT8GqbvzNWoveYjA3wkAvbk1x3PznNeo7I0it00hFJ3v4MSstAsuTidB5mmM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-KZ9qGu_VSV9l4vN8x65qS7-DX45otWWV_HQ11yVL1g&oe=6AF8A7AF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPhaLpRRGXkQ7kNvwEkGQZQ&_nc_oc=AdrI_N2TxSAfbtcMGFnGBFEKP8ss9EKbqV5PPlBgXJ2qkG3j2U4HeSEyiUmR4L2Ct_o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsOZjXjQSNlXxqLzq87lU3MLODijvOypYkl2NhWly2Rw&oe=6AF87B22"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
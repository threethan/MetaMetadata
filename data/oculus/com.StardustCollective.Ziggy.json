://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-2TLpIiFrcQ7kNvwFn69DM&_nc_oc=AdoCYA4udNV9bg8cxnKSWS3GwPYUngnI_0Fw7r8_Bph1miygK5pmyv_Wp_NoZpzrkZ0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3krRzzH099cPXD3u7MrOmYsgc56MNkWy83Tv-rWdGqRQ&oe=69E75AA6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUCpy1wfw-kQ7kNvwEmEcqf&_nc_oc=Adp7URer0IoSmdQbDUIm6kOOEXHlpIFd5g2kylyhgHnla3qawoT8f4U2XDbnO6EIAss&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2p_WtO54arl8mL_i8qeeT92C8FeJF-u5vbzvFaBwgl2A&oe=69E78832"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIYStPQ8ixsQ7kNvwGLVKsn&_nc_oc=AdoAw-NCvmV_nt1QBCjMwidpZj6Labn1wGSJU0WcoXMW6yP_D1mHwLBMe0s63zjDGp0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15dm3QlC86EXevCzHZGAUhWUU6Fxp4d2ukeieqXVu2Bg&oe=69E781FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ool6VIdopNIQ7kNvwElKn19&_nc_oc=AdqI_Wh2-mEF-97Ik6P4xt3ZYyy5k-CvIo4VyfhlZy-PpwQzOaNtjDrlyw-NEExumhs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SqBtT5m4Eh6ryfE8R0qPjm23y9BF9xkF8izviZa2IXQ&oe=69E75F33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jY5aVWUWpZAQ7kNvwEk0je9&_nc_oc=Ado9jspNyixn-egrACbEi4RwDvmoqNeJ4wf1075N8FUrNCdantCsMZZCWrV-4GgIs6o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YEJl1zOoeHJMtqAjT_kfAlfXebsod3y5Z2J0vNZ1dzg&oe=69E75D32"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYaiU7AEa3IQ7kNvwH0sXgw&_nc_oc=AdqG3qh_K806IGmLV8hI9JU9NZA3svkqZmyDNt6HXzUyfVMQ3e41XLCapTgKbUaZGxI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NZEbvzWSRrjvbmRgjhfoL8As4jzuWj7TdlXStn6iOog&oe=69E78CD3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0orWX2LN2rwQ7kNvwHl9GcB&_nc_oc=AdoT1aovYXkrAfRD98EyX3jTYhhHDWBEGZDSaL62PVnEQ9UoDlippOqvCYXNLzXOmC8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37RZJv_yOPD-RE5sZyfh6VXQ1fgsbkOsrufU_hN3g-GQ&oe=69E788EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skFsZVQNVT8Q7kNvwHIs6l0&_nc_oc=AdrzLBT3wsE8sVjNy_8M-HkYUHzJvJu23moA_bnOaeXC_nYuH_B2H3ZdXbMYCIsqRzk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3F6cN5Stcw-Xz17yqMl8vaA9Se23Sp2NSxECp2XbDeZA&oe=69E75C62"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
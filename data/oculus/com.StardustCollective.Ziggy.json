://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__Ie2crSSA4Q7kNvwGOhuVT&_nc_oc=AdoVCG5DWFwEL10-87GuZfIQHdxWXOwWmbmOdo8LBcjQVBmOc_F5Ln8vCWtgzkyzG9o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2EGz-t7HFpGdi5OpAvVgqCD9be9rN9HSlI4CBEsXl2A&oe=69C3C226"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdOP3Z9fT2cQ7kNvwGSNSJr&_nc_oc=AdoeswGWH9lj78XNVTG_DIF3870cWGGToDIh0tvpEYEWyl7Ydg6yxcF6daiEDrvbQxw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQyxDbSeuyDUxtyA9C-ZMLtVCjPvaMQhDwFJ1tIHSpMg&oe=69C3EFB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aldJuxzDIcQ7kNvwF82KTA&_nc_oc=AdrpWWKoXvDwPRPg5Y4iSIkYRqwVEJSZjn7Olpgps3GhqBNGw0AOCQVAJxoqtaBZBRE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxit15LhCyoLcwtcKy7RlQWJETJ_6RC22sfyAI-jbjn3w&oe=69C3E97B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_o00Yl86SrkQ7kNvwFQ9hPE&_nc_oc=AdpIlXylPcTHw0GU9CzL4RBvwxTvTiCYuPnKA3GXA5a6z0G_Y4GK65dOK_4wDiVJ864&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZNtzbcOYGNO7Oj2blUdmhr5dcBEyJeI_fDpMhFnxkcg&oe=69C3C6B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKETgkPLEuAQ7kNvwGJExqt&_nc_oc=AdpoggXOBBBKeirtXJP4BncpjSHVb3YAfTJkKBBIV1Vs4rgb4mEX6iBbgBnfCzSw70k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy7WsvzhErWcHaF-vTfjjJ8ozKvk3z41lwCfn5J0Smd9g&oe=69C3C4B2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oor_MplDE4QQ7kNvwHqWdbQ&_nc_oc=AdpeIt4phxVpmybR9QP8JbOmFeLU_VXErlzRZZ288qgvhqvvLC8Y50hKtZT321mJ01k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwWdgE20SSjvDD5fJqHN6LTX06Ryb6zOy-q04ETReOACg&oe=69C3BC13"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3imNgL93vjsQ7kNvwG15N_h&_nc_oc=Adqcba_PaH4mOT3hrLMtjwEwPuLElpXunhL4yTU7WXhG1EVMeIiY9HdIYPg2BjOyALc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw3vSiS4cvws0t7KCrRD7_im_3fUy5FDrGb51vfuUe9QA&oe=69C3F06F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OL2aXUV7jhsQ7kNvwHEY6ia&_nc_oc=Adqe2qrSDiWrqBApbx__4wTc_oy3vxTX6dEvD5nx8if-2hjVfPQ7fErbrAetIbbx74E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyU9KgP2XeDxDgTCxB9uwSN0NyylwIQFxO2ME91vdpVQA&oe=69C3C3E2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
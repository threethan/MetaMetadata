://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckZlIBGXrNQQ7kNvwEiN4dN&_nc_oc=AdpI1fBNHxAZ9y1gnXHcCSEPtPNHhHeok6L6B1ke6PwyYdizUtQxa-yax3qnz0mQK34&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFS8jHBJq4b4PpmcLyqknW0prO99v0H1AIDaA8XTe3_w&oe=6A95D126"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64yNypORczAQ7kNvwGUHHc7&_nc_oc=AdowvYsktyQubClnF1wAOEUFvSduEkhHvOrAc0m6xrk-AjXPTEIQssHCzO5baJ2fhLE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2rS470L7YVevjp2mOyb7cQ42Ql636u3iHoOmrHHT7HA&oe=6A95C672"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GX_PT8iacJwQ7kNvwFtF4TL&_nc_oc=AdqbCQkiNr1HRSSMosI6yBhrAa-FvklPXwK8rxCnAinXlWfnsj3cq71oTsZKNf0sElg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlLuu8OmDyGHQRUwlDPDScSwVjp4t3d0RbH3mBiyn0IQ&oe=6A95C03B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chWXIVlxWk8Q7kNvwGesXpM&_nc_oc=AdpbhsW6NGVMA63GrW3u9EpqE4SjrJLXHi4zclYmak1QSUlwa-H_00BrQzL7BHqg7bQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhbrqzsmqsU-y44beYzcokm46-JwPjswye86mFdK3z5g&oe=6A95D5B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9L5gOC1A3cQ7kNvwHi7nZt&_nc_oc=AdoUgBQi0Q215V73wLFLfz8CGHXEi6ErsUOe-pxumuJjIAuptoo3FGSHWVfAA7rkbec&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFVDmZQWDkUr5IytV2RUMdcKIJAFo6Prqn_zMaZEJN4g&oe=6A95D3B2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6g8S_A7dkUQ7kNvwFpfGRg&_nc_oc=Adq4mGvKaCEGE44bqwL2mCIEWthqsyXrr0XCfAtSEBEfkE8ZtuvNyf5LIGYfNAULrf0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdxzwC0FIcb7rIEC4VBo5ke6_dFalbhe5m5DI95P1mMQ&oe=6A95CB13"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YuM_2ztdk2sQ7kNvwHzluXD&_nc_oc=AdpUUvVpVgCeg74SA---jCIyAReN5ca5VnJ0EZG5ODuLBt0XlHpqi7oZWJp5yLh6HkE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNnBt8QF_iRFlv1jHJpHTK5sNRNNLXAewLlpy6hu9W0g&oe=6A95C72F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-Ue7LE8UjwQ7kNvwGZBpuF&_nc_oc=Adob8XcRycApLnKWOcCLEQpWsSuK93INpY_259RLFjAjTYgqECI1HMHc4SUercxW4oU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3zG48j11XHTCL9GbEriz8Nmp-vdcIPcoeWzhx2b2m5g&oe=6A95D2E2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhBpQQXNNNIQ7kNvwEGTMs9&_nc_oc=AdqZm4aW_sBecgQ79tM70gbUO1zlJJ3J46JbbxZR7LJRuIXwWwIxYY4Ke4RCVUgdYVQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0zob-ueWKEOHTDy43b_kSU0NEsVbSBD7q2ADaFoFknLg&oe=69EF7BE6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGGJ0P1yxBcQ7kNvwGGDio1&_nc_oc=Adrqymm8YXdTufzdfkfLggHTTLfakPqCgiXjsj5PF9JL2k7quC_KDM1MZo5YM306y9I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1w_MFESylv6p--IMOKwvJtbfQIQDp1aoucAhybaIF0rg&oe=69EF7132"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-4Gu8IXLj8Q7kNvwHAIB7B&_nc_oc=AdrGKrcwhHK9Kp3lCsWpjkDqS2J955J55YFiYjClIDk6YNmbQThBR38gZKbw-9vpfL8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2dUEa-7_Avo0R0e7y5w_zuXYxlwVJjfGu5LIvLvHIWyA&oe=69EF6AFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUB7dJdr_LAQ7kNvwHiu_zn&_nc_oc=AdqxxcJtqZvfUjNQu4HiZfrYpfef01Ih6jZl2p86OaOOe56A1D7gGU6PmDkL2guyBU8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3CEnIEwLR29rMtSwJdKYIIkQjLhrEy8FBWu03e7w47fQ&oe=69EF4833"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_YOKydNnMcQ7kNvwGUf6oi&_nc_oc=AdoJE0j7mKisJP6L23D3hqLHfcAZZ0cYJTspcb5ZSMeNsyovPSWegdjr915fS7qinLA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2XU5F2OrssM1HQ8-_nXKveyLhPs3vWSfSV1RybHD8m9w&oe=69EF7E72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpM4Rwt7cEkQ7kNvwH3q1wg&_nc_oc=AdoHJ8D4j-L2r4DmX-zR1KLr_glKffcvrbqKakDrKb3F957EX7USgdQkJiLCKKE-V0s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0yJKp5EmRrkxhrvFGHHkbCLSqhiQc7xfIWayd2sMZT9A&oe=69EF75D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrzC33g79KQQ7kNvwFRt4oD&_nc_oc=Adr-PBWf-a5f03rSBV5XDyZArbG3czHeRYAqDdWIpHDp6ju1S_luS2HPiB7NZ-h8r-8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0rsjLH7_9ucj_uOqy-L2tBZbNXKKEMPJpiRBmYz_wY4w&oe=69EF71EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aM0hAywnrjEQ7kNvwFng7jr&_nc_oc=Adrb38DYr-ceJp2CvTChm9s9Fi5ad03FmEMdtGyi--UPYTE_9GI4GGAR1IpVEEYxrtE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3oyIo7PEE804Qq8dNSc2bmTf3gnPnuutf9Ps8erzun6g&oe=69EF7DA2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
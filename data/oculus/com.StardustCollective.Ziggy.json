://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsQrjowssMQQ7kNvwHAjJ6T&_nc_oc=AdpM-5yg-rdKh12NP31TwDrQCbu6OUmNVOL0shwpJITeIfwJeKgJakHbbQLGfm-1LL0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Cm4UNjVhOfgoaoPVMiCPM8GzdS5ibPV1_M3d6iOfTQA&oe=6A3409E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMt4V8YWAhYQ7kNvwFCUuaS&_nc_oc=AdocWKGa6NDclCgsB2R51kDRQhml4WtX4Lddc3ww7eNmYPBcDvmAFP283ueQi4cnUDI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-19fwbZvQXsbfLjEJcx0k-vLSto2QH12NLoW85C3xRMQ&oe=6A33FF32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0wMguOSIRYQ7kNvwGG8s9C&_nc_oc=AdoN8i75dxF3zDxyezOy1Mc1zGRbyLFFg4ICnNe3A8SHp8HZ2RyvVI-doVW2niLfrLs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8RzdHtg9yiMPwBTF2M3bvNACCVmSjbsgOTar9olzJwQ&oe=6A33F8FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TI2-Bi4JZroQ7kNvwFcc5rZ&_nc_oc=AdqPCIfbEHIjDNTLAG__1WVzPzbJsqoG_imJeMbF8Dg2sIEUQda0u4BpYGzcNGrZl9E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SSXnSkuPsDXEPpHFnYgxBreF02E4JcpFGV5ppIC76Sg&oe=6A340E73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziI2UDQahXsQ7kNvwHM3V7l&_nc_oc=AdrIjkOKq4PSUPtr2YhHLobOjpAQtZNP6vrM6AlORvDRyRIj_HN6pULM5Vm1XSALZ0I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OUygSiGOQEXA0bQgwDKuuLv_FVALnLVwzAYaaIrnmMw&oe=6A340C72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuESm8h1jLkQ7kNvwH9wvQd&_nc_oc=AdpDKyziWLfoqgr3U_x-LYb60baxebaIxcRV1AaTi1CUJ1CUafW8DS6f2ahkggDPIyc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xdhhq34j3pxVT_iAiSvFeksU8Ht-HyI3kX7hme4VZVg&oe=6A3403D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5xkY5iyjRMQ7kNvwF5yET4&_nc_oc=Adr9nl3JaJCoj774bXjwD4sZSSaRTBnyRQgGImoLtePWozqmo3X_dad35vvjYu2NWbQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EM6qXl0J-RiKvmCb8YpeTPgS5T3xbMFTPXL6BlMD8BA&oe=6A33FFEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQsn9xe9MBkQ7kNvwFIAFed&_nc_oc=Adp2mm29HWfN7_F_6Rnj76hfcOTQ4WAnL27hP-659hUWp26U5GXgQYmgju10O1yFFUw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-v6P9t0o_qRhmZJdK7XuLzjZXtEguAzSpRD5oz6T_17Q&oe=6A340BA2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
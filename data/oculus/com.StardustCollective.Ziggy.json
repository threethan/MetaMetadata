://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2bq1_T4aLsQ7kNvwHKvpEV&_nc_oc=AdpsmWtgfDUis24mHiu2X47M-fNeF0wT7UAnLvhiOqHwSuPo11nkEBzBp_upZH3maoI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5tMIjGfCk1BeGaozEytISfbaCfxcTveDEzgNN49ZM3g&oe=6AA80DE6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlpytenryFYQ7kNvwE-SgFk&_nc_oc=AdoB1f75hBBzdyie_BK-x51XVCDoUfaWONuh-25iKrtLCVIFFMWHWf9hAMO-DesxTeA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFE5qY9M3mZ0w4bUYywGioBy1avEDw-nnQeeoR39CCSA&oe=6AA80332"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h42lcGFXunAQ7kNvwGV82mu&_nc_oc=AdqB89uN4sLg02DFIV3Qjw5dGuD0J3DRNQwMUTfu40qIygt6NR-TiLRdE7PWLs4ELQQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaAp3-BfAKA_o-JOaeH8LCClDs7iSg47_KBaaON4q2kQ&oe=6AA7FCFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izK3hvkbFXcQ7kNvwGFudK_&_nc_oc=AdrEgihvXGAx_6psS6r5PHk54YCxUZagfFclTvlS5yuSe_wHfJgnx8eIRIPjjmrGji8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkZCZgtN1cfSEs_OQy0RpET87AzXyanbAX03YOamC9Hw&oe=6AA81273"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ig4NtRkYxHgQ7kNvwHcNFlo&_nc_oc=AdouqiK2JbVk6DuorMzVAupfjLii-5pEjCBrW3i9q1eQorC22qKd7nKpvddm-A0baiE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuTyZZpdoRjEkjnKxPizd4aEFNKLs4VpQJn1CkyG_klQ&oe=6AA81072"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vh5oSu_VwN8Q7kNvwEVWL96&_nc_oc=AdpV42uc9k_7f1sXAAq3aVtf-QRAVBnmMBEp3pTtgXGZclrt6jJXIqv2uFYru0m6KuA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVMfVa65-vRhw7cg7336VRcgeTL_sYIekyin0mGRtj8A&oe=6AA807D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVHJMU1iA-YQ7kNvwGTnqA0&_nc_oc=Ado7YWJyCvc_u6lp2OD9G9hR8pt61uouLwK6vo0GTigMrMYP2sB9rS01-tQysfDguVQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtdGA4QUG6_1Pq6YFIj7Ue-7WY5sus8-MgANjy_uW6tA&oe=6AA803EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucW-tXt8GjEQ7kNvwG4frxY&_nc_oc=AdoLoPXmc2sCGiU7G1qWgON33FjS0drOcqX9gPmgHaruqG0S7cGwdGMgOwB043axRDk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcCwZaosKk6KWixQi2NJ7LbLs4mU2_tM397mHz61Q3aw&oe=6AA80FA2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5VQDcL9XLcQ7kNvwF2Ojjz&_nc_oc=AdlV8nCVwD_ePHO1oxCDpayUxEZ44KaEoeY0CBp6uh_p1XysjJJqK3UioGhwOSDB6uc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxS-LmABN8iMpymYmhgdBt5a3RyRa5w37KJz_xWdSxCxQ&oe=69B29EA6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuGaSXlpFUcQ7kNvwHJai2x&_nc_oc=AdlX6VYzKwVF21HuPv3lw0iIjO2wBuQpcssXpWiNquJq4aX8gS6wIF912ACeix2afcU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyV2krvm7Lbitl7dDcZdlPNZpU2ZD9urWfwHWdawZtdUw&oe=69B2CC32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwCrTMN018UQ7kNvwFctJ4T&_nc_oc=AdlN2av_vvjSxIlwTJ0BTFTk6lQOhsk0dEOQZBTIp4YPqRH6frWcyEZJlYso3bf-ewA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzD3RJPs9RKW7ZOrphF3KXcjBRq2OeJzdOxJuZf6K4NlA&oe=69B2C5FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73hoyC5WfLwQ7kNvwF4IKVv&_nc_oc=Adn0hc5iUYJaB0LrlZCInMBqyFXd1uhwQgbaYxLxaYzm-LCbyJiKZAHz1SF0v6THtdo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx6uEIgDO4_5YSEJ6e6QUMGJXk1c_pv5AQYly1guf6wMA&oe=69B2A333"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=727WTxuPY_UQ7kNvwGU3fXL&_nc_oc=AdkcVUIHzoOBYH0m1YBJbTbgsX7WPnfE0lTmPNzokf_qVJ6HzXgiXs-PjyKz_IA_5nk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyeQ5Y8BvHbtePBHr1jW60q9hmPdrCxofhI1sM7cA3gtg&oe=69B2A132"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pz1EBEeMyRkQ7kNvwHGJAtR&_nc_oc=Adl0659dCDZBCdaSd88eUt4xs1ZgaUQ6w_7CHARHwlOgNbDhjrADNEabY3teZe9rGWo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw5bZG8KGlYZe6_hxChd0Uw_7tK9QsW6UMYo6isD-0Jog&oe=69B29893"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vC7dyQSvyyoQ7kNvwFWXdVQ&_nc_oc=AdmDKkgiw7XUMjXA0k2R9N_CLFVuMlU-nxIKRYajtTHZG7R_H3Vnh5tYw_QmcdbckVw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxwkeA3JrAreiFpfBu7EOHQ4cGpR1-3lA_wwhuxdNHqgQ&oe=69B2CCEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGxKqlW0mPoQ7kNvwF1E04T&_nc_oc=AdmyIbmKgGbRkH87A4w2tJ0i1WPWJ5cI5q1aHIiICSdnZg6SSbDEpjRWmWDoPYofrac&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz3tP63I8nTHXBWHo6Dd_I6dLXuhKSFWvOqiTuLicPlCg&oe=69B2A062"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_5218087471640407679_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0evlyoZRsjAQ7kNvwE38eX8&_nc
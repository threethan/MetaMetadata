://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jmLaPmaXL0Q7kNvwGsq4F9&_nc_oc=AdrmJJWxdwETptwqjdOF0N1i6h6rWL6XjV2fDZqwLgVvQxAS17ISh9SE27BcEkxzdTM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlEva-o_u5nHax6Mpar9q1ENszChbIDohujAwb_eC8rQ&oe=6A75F4E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXIo7rccmDQQ7kNvwHE5V-o&_nc_oc=AdqC1IvZ9oGyTJMWC1g9EVlRtOksZ1jqcxQv0iQRsdbmNobscdOBlK6HTXS9d-R2jwM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6lBAna5HD1JkFFvWMGIrg_PV-ASJf9OqcCYBkVr6pBg&oe=6A75EA32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T10B7D4O4F8Q7kNvwGPIsOR&_nc_oc=AdpDA8cIhIAb0eiHSprKMfDMVbyz0qmtrhy1PLKwNFhe9DBNEY39JznosyJMZox1pXM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrOkJ1ukWj_5pxQX3A4vvvcvNU5pi-joaYZDudIJWATw&oe=6A75E3FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoPpvYN4oYYQ7kNvwHYsv-X&_nc_oc=AdqvHT3i7_244F4Ed0bb565Qo8jIXXUcJqVCOEJZRDZhH_IXfENInCwu1vy4kn5r76o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxlnOl-q3Y-a9s3MXb5m6ODQVFjkQfDub0qE_SOLdfUQ&oe=6A75F973"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRj2P9TuJBsQ7kNvwG2T86p&_nc_oc=AdqB-Fg9Lsv6im9BZjLVd7qiOh4bguhZDOKnm__f-m6a4DOgvZkCOGb2KlAnCyZrH2o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErix6ZYYjgOOakoZaDMmRcQxXPxj_uQwrjsLtEjrOIGw&oe=6A75F772"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8KcZegqe0gQ7kNvwErvlQl&_nc_oc=AdpayRWNqa2fNnYyvH2OzpPqfPddo_Xec3XnfHDXA0gg8PHjioBnZDQOAnLwaztIpz4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE09DJoEoPdR9aZ83wlCn7LvcOMEgNF-8ylwq6jlBngtA&oe=6A75EED3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fql5EfOXt9cQ7kNvwFbH7ZY&_nc_oc=AdpySaKd5xBZfC5392GD6nsPgoWfGU7iFhlTjWj9FYnQeWsRvQZjS47DgczKcTQKytU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7oVmB3-FCqrukyWyoPiFavE6l1KGJ7Jkt0HvH5QkAmA&oe=6A75EAEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIIEtNKMxBEQ7kNvwFlT53o&_nc_oc=Adpt5J4LXZ5Am6fDBogP1ey_RGMXLZHMSWatRvKD62oCVz4dSdGh60x33DxmbfiqrS8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFU-X0CSzGmTTS11gszvZTJBqNQjxQ2tUmBVWXpn5_VcQ&oe=6A75F6A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
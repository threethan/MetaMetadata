://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtsFOF4Yg94Q7kNvwHc4uP2&_nc_oc=AdpNnKGe93gg9sEspvYBHWspeT7E5fXHK6p3eXBJHvqHsnr_vDZ4iXOWn8s0KyfPV3A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHb-kLDYBdjd8Od2eGOunriOVRkg2OL5H5DzMoyWkE9Q&oe=6AD0EC66"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlw-5GrfUsEQ7kNvwE2uIhZ&_nc_oc=AdrYR39WTyOnHAx1l6v1C8N0lgdBb1q0MI3A48PDAYLZL6l45oHhHlwG-nugNIIRGnQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3UF7erLWU1fRA6PFnHU8j1BesQ4yiZlzLtAnYj71bbg&oe=6AD0E1B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1c-2PJoAZpcQ7kNvwGJ0GdO&_nc_oc=Ado3Z65L49D49ZATe1C5KQzJVxGWhR1-3lMEoii7lrdlKlnc1655dUZVSQA_MvfqEOA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdeQmmrHWnVE7GUedWC6YpXiOXQkFq4D4gCte5ocEVwQ&oe=6AD0DB7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=911kPicwawsQ7kNvwGnhQSQ&_nc_oc=Adrja5RIHHUIKDuZIt2i0Q0xJAoXu8cbyh7GuZEZxDH4BUkidw6m6C6ryEyG_dMb5r4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyw4-nO8hQYSTwp0ysJpNCspGkkXkfi8boe__kixPbtQ&oe=6AD0F0F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3v-jCT-IbBIQ7kNvwEjM4AT&_nc_oc=AdoYgyk3aiEhhtRQZvHSeSF33J70u4lNMso44sQIoWsobQaOTikkkASj3jMNEGWPKvw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFlkIjfRGERg4Dy00xoSGwe2hDzmcWXbD9NDPuQOhx6A&oe=6AD0EEF2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtvOLp5-DfgQ7kNvwHL4Q9d&_nc_oc=AdpXzybWXXLF55OWZC2okbRCZ02jndQGx9dzBaxEmiAEJjSZU20q-4kDTE2BJh-NmcM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvpmnwacangVHG-VKh6aCqg7MK43mqjXCXlTQVeZ2ynw&oe=6AD0E653"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x80Pw4U521IQ7kNvwHN9MF1&_nc_oc=AdqGmg2v54kp9A6iCNeh-lDBwtYfqvuXFhCh82-rXb4Dow1DuM2EBJeNBDpBt_OLa9E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMl1gsQStlUugM49y37gXinErjaMXaVieqHTs9xC9wvAw&oe=6AD0E26F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYOOsyIBcakQ7kNvwHteEBC&_nc_oc=AdrMWW-575aNyYOVQc206fGdAWssKZabtMD5PjtoE2Ycs3TvPsMSeX_Ko0auoiQmb-I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvx9JdVsanRJfAGuxMGdb4T0fYn4b_Jqv4D1cqTL77SQ&oe=6AD0EE22"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
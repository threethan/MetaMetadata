://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZLS-3eCxM0Q7kNvwGAMe0S&_nc_oc=AdoYtjUnpl-dbP4FTeez5QKrOnmXpQnjxK4HwGeLxuCyMh-7mK-D7Y6oaz87r0hVyEw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MqjYAaqfaT95IiM1e7_JaLLgrP85GGhh94DFgKXE3xQ&oe=69FA07E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XT2zv73pSWAQ7kNvwHthNfD&_nc_oc=AdrkSQijANj_UcyHMKrNI75yUldRYd9PB-a6eqEsuI47qPlIsq9gdqA8tARYbbEHSr0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kwvm26IXvV09eRdiI21q7N9SMB2X0Hvzf1WSfB-A8RA&oe=69F9FD32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAkoNK12VEwQ7kNvwFV_YW7&_nc_oc=AdqAPiLgWnqly0b9yoVFofmaXtBnCxv0dJ-N1O4SYDEvTZJoHEwor4eM07QufRMSk7A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Uwwc1DhGddQ3IDJInJsCrSE0yUTL-54XDyQmtOmy5Ng&oe=69F9F6FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7aFZMHJ5SwUQ7kNvwHCK3Wv&_nc_oc=AdqtggmUcSKj9L6pnLV8Pdx8uvKeBcBOQ3sOqbtgITzeX-05UeFBDipkbQMsU-Vl9kg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UjixL0h-s3otXjy-s4hBEW3Cy62hKKQgc8qU9-9oORA&oe=69FA0C73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQwa6OR64vMQ7kNvwGuqtMn&_nc_oc=AdrHpx8nco-GBT9sPs1zU4xNLcd5eGPukbF_5Qr8s6jInixYZnHe7NjVsGKxIJy37Fo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NYDGSGNnK5o_YTVMq9Vzcw6Oh1joQG78EkNCQIMPxeg&oe=69FA0A72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SX4o6SOFiUQ7kNvwFVcluI&_nc_oc=AdrvKSsIk23dsSMIxHtWfj8iM2Hu3a5Zo5YTvgO3LGN6YpA95kn_u-2XqmD0ZEVAXYg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RzFno3k7O554_pile2DvvMn5yw-ceqCl72CHLjmyWBg&oe=69FA01D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7_SZG2_AP8Q7kNvwEoncCK&_nc_oc=AdqDrWUSxkZtz5MzdFhbLohRm1uHbEPb5xEr4vrPOEXEpO_DIgKqMo3QdcQwe_SpUBc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5A31_xanoe0VFIrCBDRxlgm5Xd0TFM7YxinSs79spaEw&oe=69F9FDEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqSF3BY7yzkQ7kNvwF9RitN&_nc_oc=Adpp7CBXo4mtj4pmKjPVTPZvG7P2tb-H_01dD6PkB-6oki3pxqym06g7jHpBRDxgMgA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UsiyqWx6OLxhEFY_2rRQYE6pIsRgrZn-g53eLXgnlgw&oe=69FA09A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
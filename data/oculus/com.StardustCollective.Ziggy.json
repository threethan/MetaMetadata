://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1Af8T-BCtAQ7kNvwGe7kEX&_nc_oc=AdrTe0bKYpDuY6MX3rLTcIttOgh-b2ofEZwQyo8sD4K5Wb7pqwuE6WJdjEXsHjkfmf0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfcpQDOmrUTe_fNne6eOTgCOAqf8lYUGB--DTyV-x0IQ&oe=6ABA82E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfJ6orsfkfkQ7kNvwHHOyRL&_nc_oc=Adrnjb_F-9NGNgsW6Mw9iPtqKmpERHMy3GngLSEelmiOTsk4Xoa67aWRS-cYJXIZ9b0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIElsoGBf22amuD54vo2zu_IfCiS69AVHFzdSaZLeYFrA&oe=6ABA7832"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8QlNcx3ls8Q7kNvwHVSCBs&_nc_oc=AdqfqvfyyPVzH2t9eiBi_VT8_gUB0DRHyhC9eluDKRm-tRocfE92Rg655THdnZsxyus&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLM4bxc72OJHjhDfd--7BreK4Rv9-Vf9bMl8JkUzW4OIA&oe=6ABA71FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPZy-u_bssQQ7kNvwGKRJLX&_nc_oc=AdpDB7UKj98qi2ZpXnej4chwUxOnQwVgXYmyFPagDbY_CeqRh_zvuxv99mq45N6OwQc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3HFl6TldkMjdpMVjS7SbsdUNat214d9w848vPdZWyNQ&oe=6ABA8773"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJ64gWYP2VgQ7kNvwFQ6b98&_nc_oc=AdpolH3mvpI0pgF-uOUGIx9iOWIXF-Mh0lRm9S9B3kuA1okm1auj0nix8HFwqQyAZJU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJ8umc24Myc3RCgyY75VGuNdDnBR-KVHfbx00NVKLiJg&oe=6ABA8572"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVYwb3xqbkEQ7kNvwFjYx6f&_nc_oc=AdqcNdy29542lxW3LDVw38aDkJEyk06IHIc4-dnKVjDvUTaS0puSlyce37U91o_2cDg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHlgI_5mHXWoyUkjTvkpfx72woG5wkqieI6xv1CGAe4Q&oe=6ABA7CD3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5w9FNcOZyHMQ7kNvwE4_uww&_nc_oc=AdqFCBj2YBjruQvDrmo2WCqsguKEpasdwxQ4Dk12ueLqbZuqQHYZwN98q0Bf4-SzWvA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3ltxKVmCvPa6lyFcu3aIJ7DdHUf0PdStTxGn5aoRf2w&oe=6ABA78EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTs9ctW2HgoQ7kNvwGnD5KY&_nc_oc=AdqsDy3u2k_ur6lnSl__F7CpG-wnQXhGI2aDtcJ0FT91tRJ_h4qe7SKARUgrxv-3i0M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKT_on7msFfm6lwHSmbFfPteuAMKu1GOXicc5AHtOdung&oe=6ABA84A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
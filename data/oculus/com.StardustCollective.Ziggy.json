://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wjdLf3dzbQQ7kNvwGWxqmU&_nc_oc=Adpnh2M3GvqrQX3bh5FQRueeXcTVBbkRV-AnPfcYhiDi7Oxs5D3S8Dvucq63g5mHHRA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbbfzLDvWM4R3ZcFGCuPpk3UK1KgsVBjck_i6nfmzTsg&oe=6A7076A6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwrnLhGkf7gQ7kNvwFd7bDw&_nc_oc=Adr3FF5tzsQl0wGmuaXcWVP72xAfGO2nw5IUUEZMHLgJ0KPNBQhHuxv_E5SbJe6ks78&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEM200c1ST-NITQ1AiLV9ssReRtqxCCMJ83ELOW10FCoQ&oe=6A70A432"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztavDlYQEuUQ7kNvwH6W6RS&_nc_oc=Adp9YiFlmS5vPnRo_KejhiX7-OaYXv3jpTQbNpLeqCU8zwfeJKngW0RoDvc7kBpg-qs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuCYWOwgDMeyYjF4v_xkQFVvFvQuHeM5v_xfZfeKGGGQ&oe=6A709DFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TN8OXaSO9twQ7kNvwGSE7d5&_nc_oc=Adqypb1TQ2tnn9AGltnVS4O2F7Zfa4eONlKN-9AXOTR6L5CJp5_SXUyxex7WXCacO0g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzx6rEw7xcsY23ag6UMYY6EkRcu_UyTgt013CwRxXN6g&oe=6A707B33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTdigYJjDjcQ7kNvwEG8nMa&_nc_oc=AdojWOGFoVqaivb2ql0sEZvG9b6THef3qyJf-JXH_Ktt4cIKV2AAcFEsjL8zimnTwUc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWfqK-S4wS6Y9FDcln03jWadrFmMrI08YnqBobgRl0vw&oe=6A707932"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwPf9J2saUMQ7kNvwGR8rWz&_nc_oc=AdooajFvq2xGaNZewkw6MPQngTwN4VsoOz-NXikncBS9qSQN2QO2AEDU9UZB8mxGkgo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9ADqsgM3QsPoKaG8TxXqf7PZIUz9AShMlCsobC_2MmQ&oe=6A70A8D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohjzD3n0tAEQ7kNvwFrBZYe&_nc_oc=AdpgHOVenEwwTkPNFOHIb0pe9tKJtnFWL9PftYzi8vtHCHteZ7g5OFVN986NSuomBJo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG97kSzswnz6NvyFgluczvxp-IF6p6Sya7zzwmsKw4wLw&oe=6A70A4EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g57KmkVHgRYQ7kNvwGAw8UT&_nc_oc=AdrcH_IKII4hkwadj7FBfgHgXRnDtJFc7djiHSGpnKTvpY9EJkkFzeid7N8QlafI5Eg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGVdmMZ7Ctgh-VaSy3d88YKQ1u0UxeT9WNRw5r-vstVw&oe=6A707862"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
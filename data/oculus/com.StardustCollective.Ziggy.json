297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3RF0rX4S3QQ7kNvwF20lFS&_nc_oc=Adntz4qWE3PVsRptVMvswAysm9qhRrBJqb7myGtJPl-mz26Sf06hsyku5aHHDv5lkCg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftMD4Qz_N8E9MpYkhxnJV2dCcR4z-arYQKm1Kb6UGDyzA&oe=69A96426"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RnZ4u1bxhKQQ7kNvwF5MS7Q&_nc_oc=AdmN7EEgcWvRH3mkQhsYXup65kd9ynObcY9-9gVcTT9xLjK23_DHMHQ4fzTQGRjJixs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afshs3B5alMzwzn6kTpyXGMQkLkmwOqFEf2ecohddqEYwQ&oe=69A991B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJG__4xjWM4Q7kNvwFVG_Ep&_nc_oc=AdnmaS9tKOceEfhphEPlnFLkz7klr1oo_FI62bmef5UwJJKqnKc0eyqo1I6KTJOV99o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aft33ZUcqW1aR0aQXhYpFEYYVnflIl-P3DY4M02FjC1pYQ&oe=69A98B7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCQtM_DgidIQ7kNvwEkecPM&_nc_oc=Adlut7uEKnClT0J__vpncbUYixgBec5R8_3QSEpdc_dANkSbqV9n3NEKqA-ibz4zSgI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvDv4VF5AiA9Y-knIVLLQ_-Uyzbm5V2Lkhm6yC-pr-qTQ&oe=69A968B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pB6blBMFjhkQ7kNvwH71sSF&_nc_oc=Adm147qFl9Kdu9lKRvmbjiO_Ay7NOpdHDXhGDwehL3W-uvTi9iOrFdJSZJIlhPiX_PI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftqAXZzS_2ZgEH2-d9Dq6VcReBdCiNJsekej3KP_JqWEA&oe=69A966B2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LtKbTfTNqvQQ7kNvwEn-gbx&_nc_oc=Adnfk3fxuqPexA_cABQNs-ML24GfaiqJ4YGCdDGFWyC_uD7O6NR7ohLqL7nHUt4VMG8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsmUgemt2E7bHwmBjirRxdkVznmnHz5DNm2ZwrBCqnvvg&oe=69A99653"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlWkJh7UqnAQ7kNvwEpTCQX&_nc_oc=Adl13KeHV_Hav2mNcdkVL1MZW5Tfi4yBFQyRJceDAftwAOs-zR85OU7ouQihaUX06RY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsE7LQBzGiOQDKsXPhAI6_EXw5iFk7W5Vbhh-PnYfVfiQ&oe=69A9926F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwKS1q80pVkQ7kNvwFUbiP-&_nc_oc=AdmLVYClDk1U-KdBeUXzGMBRwoR8ADlmk-K1vlGYayTY-GxDCYzQU62J74Phqgcf2t4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afvta-bxQ6M-EOIvNVeUHD0XKsNV4HROw4FzOgWLqwZ68g&oe=69A965E2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_5218087471640407679_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Auyv-4CFdKsQ7kNvwHLyCm0&_nc
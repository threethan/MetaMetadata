://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgiYxYCA1OsQ7kNvwGQs42d&_nc_oc=AdoO_DeTmxVURNjwFsfCqnDXLOCD2zTu9JQGEfpoQzCQQ52ZTtmBP5B9t9DEEBnvAes&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcQtpH6n2GSQoQy3yYHvbiQm_xpxZZnAlbeY2QH39zqA&oe=6AD38F66"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjRjnvGg3H8Q7kNvwEuvbO2&_nc_oc=AdpzA4H7Jd5Cr7qCOYSMGbOZSTFj3iQOvvdUQhy36cvraGCDhFjV3f6dopaxJPDwr6I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjaGzKGswyt4L6p4XHvo1Dz9h5HnJs_1eprOlqGDzK7g&oe=6AD384B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CpbTJ3S7kjkQ7kNvwGUk5xQ&_nc_oc=AdpmCwc6TH9_ZGvzC8qWSy2j90hJy6e8ArCxXDeBMXHOgyugVEyXDoHg_A3mcTaQNR0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhTZ0y9xg1UZQdcIeVo8LzaUZZetRfTrAi9qcvDDM1yQ&oe=6AD3B6BB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsD4akLqe4wQ7kNvwGceJur&_nc_oc=Adq-0zHYC9pz9VhkckJDaYECvpDm5ZRwaZV6X1nALACG-jJuM-fN8qqDxh51fsPXBcg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlGQn_f0MT_8H448nGjWFuLP4mlflMliEf8reidpnthw&oe=6AD393F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNlCgeozuBUQ7kNvwFrVW8u&_nc_oc=AdpbyKDFdlCPlkQQc3Vx_ADWbqUzUG9YIEKnNSlUgVOitkImu16JCJZzhMMTBwJbjg0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdJK87ADsieOZiojyh74JyU8tBtuQ37bt5I_28UoKR5w&oe=6AD391F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ny5GH6tLYMwQ7kNvwED1p_h&_nc_oc=Ado9QxhT1f0d1uylZka-AYpzRakrHMFzIMId2im3eNay8hSbFIwpURdvhp_ZqbCnUcE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrTFO8YgkW8erxalUcpXL87lFRgEWD9dpHtwVSSfl7nA&oe=6AD38953"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itkDDKdYDVkQ7kNvwHh8CXQ&_nc_oc=AdqNE4Ph-7Oaf-yNtQIngPLzyGu6GOdK80Dsn4hvWVisgUaq12YaovbZ2qFvo8KxABs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYnqS4WgSZ83xMJ4zH5kLrQGD40WdIOfCsWhZHcz8UaQ&oe=6AD3856F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYOOsyIBcakQ7kNvwH6gDjV&_nc_oc=AdpNxEX5C5Q87Xddj9FCF_4LzbR5dBZ59cn-kc0jsq8tkuuWnbUj-NHWK9RfR4XI9Rw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNwp1iWR6OTRmU39u42khjEdiAuga1tQEGVmrUoO-fTQ&oe=6AD39122"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
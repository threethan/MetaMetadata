://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trumEFzd8MkQ7kNvwFikBPp&_nc_oc=AdqeQMXY6as2nWPJjGGZq5jvdTedmN4XnDzQG9X6pguyVQSITQyFSCP91I1zft0iC1E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJR0kulaiYK0FmGeJZ9-WZSvofAL7JjO7hfX7Pz1KXY-w&oe=6AB68E66"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4q1wMum-GcQ7kNvwG5QKSZ&_nc_oc=AdpqyFSeft2gYBMXhRVloI9mmfVul1n2G9beJ0uFXrFkYk6Cl0ZRu7MlmfIh1ZO25Z4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKy4NmV8_UyrpCei76pnCRpatDA8UwJf3NDjoF3fZ9J2w&oe=6AB683B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIm-u0h6wikQ7kNvwGXrM5W&_nc_oc=AdocruQVO6XXpLkvvKNnyMPw5wZg4rsi_gof8yQIzAU3OHcL5dLiXMdI6I1kic4LXDY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVtphQP4fvlxzihkUfiCw2kn3BPrtMbcbBL0jseUurbg&oe=6AB67D7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lUvC6q1bWcQ7kNvwE-Ohnd&_nc_oc=AdpB9cIJOk4lNgBaAUf-wY-aD7iPSo1QqOM0Y-fQW1CHh99N8CXH8A9QoREHLME87DQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKI2Qov9UstP6J7SdHxNNU_BLoa_Gi4iWqa1xou6QcGcw&oe=6AB692F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ueuGzCH02cQ7kNvwFLXf2X&_nc_oc=AdqYii01493LTLQhkGbUfm_TeVHbcix6HBX8ffZRgliNwq8vb0B9KtF0lDORPDjgHfM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkEtJ9NuDxRwmj5DSB7VT2zDAXh3rybFeCgdite8404Q&oe=6AB690F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Bz5AjutPRoQ7kNvwF8b7kT&_nc_oc=Ado0l-pZ_Xp00piQVWjyM4ALPDa4EBSawE8_um31wDTxkFXPkwLYAemxrb65-mQ0YZI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfxVkBzqP9NWIM6xs6QnavZBXShG4iM9hV2AIYNOTCdQ&oe=6AB68853"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlXQbtTOaHQQ7kNvwHgOm6G&_nc_oc=AdpAdZwHZevIghkLFcLQtw33uIwGI9fHFGsw1JlExsVOMloR-oCV2G4IbQWWVsPgTT8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7HvERbfPh_pXD_haQmtyPeRtckgC7w8ZkdKZ25SxtTQ&oe=6AB6846F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5LPpcwPvA8Q7kNvwFE86IH&_nc_oc=Adp2H4WbttERFBMEU_A7w5Ka29WPnqSc1Dtu65Duqg8wa16wp3spT_01eJDrBrPk3iM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJokoLuDQXcEu48_xTn8gIOnFqS7amocKuXNd1gN7bV1A&oe=6AB69022"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
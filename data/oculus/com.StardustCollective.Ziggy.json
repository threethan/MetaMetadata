://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Xlff_-E8bsQ7kNvwFAKwXh&_nc_oc=Adpnk9YG2MrVT1SJkffm4p5O5gOhogzyaMxewgGz-6RpypNUEZFg9Kfj3-Zf1e0PaHQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHPxblsJz-x8hf9yA9orxCpyo0dS0zvkxLtU2JE7J1rA&oe=6A5F5326"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbNEaNWMAgoQ7kNvwE-PDEW&_nc_oc=AdpfFNsD43CERJkkrB-vVxt-n8mCZ8Kz7IO5vcRd6PeOCeXnR4mDljpnogFZ9Zy8GjE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFvdUDjMRCfvPOMPNA-AnD08c1DCkR4I9uMn8DtKgK4w&oe=6A5F80B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GRSB34GlHIQ7kNvwFaoRa1&_nc_oc=AdpORlE_YNWZAJbM4gKGCYdJ6IprL16EikNdrSeD5TGt03bImJyzjll06r2lcTNwRZc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDO9dPaWuEg1LyvuE5nZGE6_BsAtsj2dGTOGt7uGpwoSw&oe=6A5F7A7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wa-E7B8bb9AQ7kNvwFBZvdj&_nc_oc=AdpnyPlQNQq1X9MqrtiDBey_q6p40dcvmrP2X6XimOLSYwi0J29GAApZ4P8KNQEO97Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3-SJ3xQtiAczmzNhPh2sm_8MBA0WW9Bblb9YtxdTOmw&oe=6A5F57B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWpiEnAdLXoQ7kNvwE0LnnU&_nc_oc=Adp66C6IrVDncqcztfnYWzEF3doNz8jMiauUmlgbQYALFb9d7TkLPVyK9b5Sz4zitrE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASgbdcmy7V0fQmj78AJ0EFRP4AoxuqnFNkhzlmRN1pbQ&oe=6A5F55B2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruiqhZivKLsQ7kNvwFjnhgg&_nc_oc=AdrXHA9oCmTDWOxldf3NSeNL73ymNBA-PO0DExWRRW0Ls1HzFCJXxwFdl3uxUi_icZ8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpWsSxCiD_on0KWujtFenITBtGsLhhQU8RXC11t3I6kQ&oe=6A5F8553"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vZ9r7R-0NYQ7kNvwGp0a3S&_nc_oc=AdpVIhBH-UKrIJzJz4E74y_09BbxkCzc0Qdb0AnvF1PyvQ_BI6YdhNrjvOUr9EJWLkg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoi6XFxl5z_Rptd-eY0EU4QAIXKumQif6mdYSuvbnBiw&oe=6A5F816F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dF5O_EP4SEsQ7kNvwEm0lEB&_nc_oc=Adp9eDZ5r0VJ_FxF_ILWiXdj3abQoU7UNTM2qjkdDsuVKgiJPXCu0Fiz_1HUQsJTqTA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpsS0NVd2vtD3xlP7epxkwsw2srtkzSE_1w2JkpwG99g&oe=6A5F54E2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
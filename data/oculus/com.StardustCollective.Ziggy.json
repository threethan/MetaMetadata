://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZLS-3eCxM0Q7kNvwG6vCx_&_nc_oc=Adowu09SMEshr3v57zDlwAnZwIq53lyCSSkYMu6PJETyzLuDWZiimqZm-noitkVDn1g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DpwgLGXhj4t184mwugkBjaQBMf7zx4ShaXDPj1y49YA&oe=69FB5966"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XT2zv73pSWAQ7kNvwFGmsbE&_nc_oc=AdoxwLuXMVxm-DAxnOuVz0Bt3CKoaQxHDRKUEVdSzu0rg7NEJ_BmyexXuHffK7869kQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52bxw5kHfYEXSxIg8xzxZZyJEFuI7AdVeEk61NlNWA0w&oe=69FB4EB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAkoNK12VEwQ7kNvwGP19th&_nc_oc=Adoyj07bxV_HRt0MwifsnTejHJU3sS7vF0dWXScU2XtYAWgT5jwtkZNLkIyUzASAZJo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77-BODxP_1B2PBByxQuUwEu9yc_sGVjmpGPKGrxOzO2w&oe=69FB487B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7aFZMHJ5SwUQ7kNvwHqRSWe&_nc_oc=AdoG5xaF_VUu7t7pDyb6eGfCp8kTCebJgTipAsiaNZ2pUM-fdn3aE3_x5xNtQ3UgE-A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af510hddPaC7Xft_E-mPwv93GL9FtMC97xUbWu8u5bsXaw&oe=69FB5DF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQwa6OR64vMQ7kNvwFwbaNs&_nc_oc=AdrVmq2IlYouYwMYDuDim_RFH21TPCwqWDyVqgpjSHKv7K3IQXkSRuC0bB0MJ-Jpf0I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eGyOg7eTHog-uLcHVyre10FORAgdjTlIusBOnyy_PlA&oe=69FB5BF2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SX4o6SOFiUQ7kNvwGiElyV&_nc_oc=Adocpt6a6T1nwm19-vJ_A3wbw-bWyTpKXstd8cO1cuTPX-djyeDoa3iMxLpZVAQNplU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WhhFaKY4OlKANx4C51YnSr0HbntekC6mn_PEfjnOICg&oe=69FB5353"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7_SZG2_AP8Q7kNvwElGx4b&_nc_oc=AdrpxsYyvz5_P602f7d5O49ZVmyUEvtzpReHw-k-pDRjPiKC38dqWHpk4-mY8FLz5Xs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ANFWxV-1fiTFspDIfJZiqVeOIhl3xPGVGSiv_YrHRKg&oe=69FB4F6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1oQSxSLafkQ7kNvwH75sWB&_nc_oc=AdoZ-6ei7FzTNKU8Bt5pV_p6kAjF-Zz9Zb_w4yLRd0rFKSstLA5JPmFVdR14e2fQI5I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77Kcfo96UWhHsif9-6eQt8NfQruqwGPabo8itESdjL4g&oe=69FB5B22"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
=8&oh=00_Afyt2_g5ncdQ_jJQ4aEddzIfmT9Wd46vd0ByRhXv3E5AHg&oe=69AAE022"}]}, "id": "541518491983209", "locale": "en_GB", "screenshots": [{"file_name": "S_music_Trailer_Short_edit.00_00_00_09.Still002.png", "id": "357803599946774", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75608437_357803603280107_2576302017580185961_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9KWOXaxrYcQ7kNvwGJZvIT&_nc_oc=AdlauXqm4xzEHRpjlj1T4tyPYXpxXAbFq_D--quoE-4jTXTcvkLdySn8WWxmWKDQ7V8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfwXI6n5q0Ea6rbg1ecplexOtiO0_YrAGkcDcQQEns6R-g&oe=69AAB6C0"}, {"file_name": "Desktop 2023.09.25 - 20.42.11.10.mp4.00_06_23_38.Still001.png", "id": "1364267400965138", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/57574723_1364267404298471_3901792330843810654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XzP4NqCOz0Q7kNvwGFIPqw&_nc_oc=AdmTGf3v-WTSiaUh3NOKshHiSfgKFuX3h9lz3md6BFcc2erWCWAsDE2wdgHNTFosyC0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfyBs6D1KZ1exK8fu3UMutypEvrhvLXwlASv0SDqkUUlUQ&oe=69AAD97E"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "1275611523126200", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75340707_1275611526459533_6871146870692278099_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-29TWG1C4oQ7kNvwFvBJUj&_nc_oc=AdkJP1kSGJADVtZUx_2IEJxiB7HC2iiz10rahrrJIHcFgJ6dJeFE4dKJyTDdQcWZYmA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfxApVysm9Y7sR5zHqIoGV4rPnm1oMWAs3tQQPEyL7lmDg&oe=69AACC92"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "324528640192467", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974575_324528643525800_8777739433598943558_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJFexuSFBGoQ7kNvwHIQVZo&_nc_oc=AdlpdCVFLz0g_oCwS8Ipl6ijn5MAVFY09BIll29NP26rQTX7BtaNEnZ4piou7kjh0ic&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwTzE4R3fYQR60EZiJysFvCBDPgorYOZ2ZvdfOVIS9cow&oe=69AAE31D"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "6757908704317420", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974691_6757908707650753_3424585239064189609_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNS__lnd8KkQ7kNvwG1Jh2H&_nc_oc=AdlFYY69TT52Yf7UPuNLcbKezmmvM4gfkFhBOH1_C6u6PpVoQPCu4Qlxo-lN3FbftZg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXL6EwlTjlZjxNqKhX_HwOHZnT9t2rYl79hKpKNrzRLg&oe=69AADB28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "312845394416247", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035359_312845397749580_7295644085646795585_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1P6lDj4FQY0Q7kNvwFvjm2b&_nc_oc=AdmQ73SrhV2sITzKOTuawFqKH4rHqMyav9tNy6g1BTR4EjhkWy2LzXc8-iY2ZoRqR1c&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afywj4isIQjFh611yrb9525TBXIuHuH2LlOS2TFsFAUj-g&oe=69AABFF9"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stardustcollective.dev/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Stardust Collective", "support_website_url": "https://www.stardustcollective.dev/support", "website_url": "https://www.stardustcollective.dev/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_playe
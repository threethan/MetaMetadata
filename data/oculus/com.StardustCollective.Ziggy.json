5_2778603811108028476_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYw3h9F-0kIQ7kNvwEo2sH-&_nc_oc=Adqax33qsfKg2m9u9Fhcu8_DZjxiEWEQ6xFSDdsX_aTN5Jvkb2ArtrdMWZlr3RMt6E0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FvKYDhOpdKNGLnsVgWw6zD4JwRktpKru1VXlnLrL8LQ&oe=69D265A1"}, {"file_name": "HighresScreenshot00040.png", "id": "807733037419699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984472_807733040753032_763200239777074167_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kf7iggrrmuQQ7kNvwElPbwx&_nc_oc=AdosDa0SRKx2hmrMP1i0dN54C5e1Z74ZibCToTVBKBc-JQLFqbTv7TiPQWH5UncaVdk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bg9w2WSOQ10wRLNDlvKkg_w2GcC7Ws1vbPd2Ss7IOkA&oe=69D25078"}, {"file_name": "HighresScreenshot00146.png", "id": "163970600033098", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566678_163970603366431_5435931785999963108_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsqTPlF4ascQ7kNvwHgOny1&_nc_oc=Adpvfo-9o3IezvV_oNXy3j7SY_KQ0UDuwblrWN1VQir_WTf47sQU2rrRONf_QE5csEg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35AR1Ud6fjjiNE9whwEQaaxzRASq-as35KpMcExr7EQQ&oe=69D254F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7Zl0luW-jAQ7kNvwH4xdIw&_nc_oc=AdqNx4MHGfu3vJuOVm7jghZivs4paDVOCasU4rl3EpfgK9tF7AIH-uhMy0hE06w5dBQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2A6W_COwWjX-X3Vc_ieEYCf_A8T8xU-Nu342hRdN_lcw&oe=69D27D72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "1324311035174797", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984472_1324311038508130_2610
://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_7lpbHic5cQ7kNvwEpnX72&_nc_oc=Adr-uL11U2C9x2UXTsQi3ASL3dtpWx949IF1QEKUpmDShhdf6ssedfOkThx4yv87Pjk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0tJpCXITac9WQc90jIp3SFlqqGydNVPKfL0vrN20Yecw&oe=69F61366"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klyMQuV0FBMQ7kNvwE9aipa&_nc_oc=AdocswUiKoiB2OozmUyrNyxVV02DHu7GgUZftzJf__3o2-LIrNLnmk5ZGkClWltPOaU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0iR2VWLofgVtPlUp2H21WfrM_5nmS9sUEpsRTYPHGx4A&oe=69F608B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9us6HXMIkgMQ7kNvwGVDlBb&_nc_oc=AdpJY_Wh9QPRwULl2DcYTI7WYGBvMfFJi-kh5DeoRj5u2gxXHlRJ_OQYNDIVLdXIvuw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Btb3tbJXrTV3AralcG9U8yuaBwJKtAsToTcmcfP507w&oe=69F6027B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtnUw1QxGhoQ7kNvwEIxOXh&_nc_oc=AdrpyvN1q0dSPhKafFRmXpxyb5_7T4uR5-h3bpH2HA7lYvghFx0e1FgO7mQbB7roxag&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1yyF6VbTnmB8tQhdSsZ3v69NLGRBJ8YnMPb-rkxHNr-g&oe=69F617F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mONezTx0q1AQ7kNvwGv2pOP&_nc_oc=AdpcjHDuVi4oDWFvsmrhh2WN6xKRJ8XaCl6p7WG8uTodlO_huNHSfvalcFL7gGZTaOE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2eTn2ZIJnr8iKeeP0h1ga_G5cRaA6U7uPwKWn8T-_ulg&oe=69F615F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pGFGNhoyJAQ7kNvwHX8HmG&_nc_oc=AdqvAlOPjDxffPZeh5YqdLOnA_NRETTdpDy7y5UgVLnlaTCcMz6qVGH77dYgoWMtSj0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1EmFLO5FajnANnFvVfnC3kELBQJvSiaODzUM3-r7WRMw&oe=69F60D53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbQmRbQVmLEQ7kNvwH2hr4z&_nc_oc=AdrLXVMFleviH84mUBEsbd1ZfG5mlazLwf4SivelQQypP1RrOTLBJ8jYvtGdJ2hNaow&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3yU9z-4-bRp6tWsnLJO2rByDvlit5BzE5VeZmL5bw1Eg&oe=69F6096F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vmOu23LbvoQ7kNvwEATEKg&_nc_oc=AdpQ0kX5TfCPjgtXgQGYo9XV4f3g69MjHr9AwCfZ7TnJaS3cFxWFzpVKaEY4hij7sCU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af11CtaCzsz_AY8YLLGmgOKY25fZMIqeveVlgm7zoSaVuw&oe=69F61522"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
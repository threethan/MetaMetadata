://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Xlff_-E8bsQ7kNvwG-yBi-&_nc_oc=AdoPf6S0aZN7KteAMBD-h9LEKbLEOqkvYGTfr6hq_EiQo3I-TXffNh3VkrzMsf-evvU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNc_q4scmV1rYn3aqzZcP7rV-JZ5dbaiwo8v4l0A6A-Q&oe=6A5E01A6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbNEaNWMAgoQ7kNvwHWkf1-&_nc_oc=AdodpB6SWUHVdvGDCo79511Q5HIh_Fjx7ifghsjEk1U2oxqEl-VOZR6hgMswKt4vgn4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpOh0yVt45tGzUV2oghIyqus_w0DhIsifJ94L3qBCLcA&oe=6A5E2F32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GRSB34GlHIQ7kNvwED2iib&_nc_oc=AdqBbyeJkHHrGdiL-RUGw2isk0VyIzMkEi74bOJ_J5486GIbepqrx1w7TOkUzqw7ubQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQ1vBUMV6RXjaAGpv5CfMHg_vhHNV95xp443J0ghkDeg&oe=6A5E28FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEQb7WEzRBUQ7kNvwG4zovq&_nc_oc=AdogO-cANEm5s2xX7H6H9Fba9rOjIDKQPsk8ANPzeOlIHdNxg5ARqgFDFPEVfoLQhLg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5Ildo83oy1FQ39KfzujsuhLvJolAOdpHnL1TijpDO0w&oe=6A5E0633"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_qz4QeuJx8Q7kNvwHkn0r1&_nc_oc=AdrmKWh2oilzIClEaNoFW_DC48RxYHaWrL91RiKhT2_BvrIIamOsu4t3oiAzjHFN264&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSKxXlWJa-XCuHZn_LjKdCWYXzmsWrGOXk2gXU1xac9w&oe=6A5E0432"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruiqhZivKLsQ7kNvwHT0Phc&_nc_oc=AdoGq9ELbCLqLzSG14EYFaSSLIm5BBQq7_HunkaLZQeLDtCQofWfn7g5YdhBo4P_SpU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMaNx8I_SX0gH5P0yjxC6QRQpzzjk2gcTExBeJ-dvMUA&oe=6A5E33D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cI9Ydly4DO0Q7kNvwEezUpd&_nc_oc=Ado41VHBZbu2jMc2I3TpMRcHxbU8A270lz1vwddXMEN06YUOHjxRrST_lWqjNY2uIRQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB244tGR6PSYb5iCs-Hg2A4pmuGwOWO84AvudjNRdtppw&oe=6A5E2FEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dF5O_EP4SEsQ7kNvwGfs-IF&_nc_oc=AdoqbqFsZjPsbGvHt3x_EHkxq6JNC1XY2YXO5-OhuuX82geJopmAGa3X4x8-Ke24nWY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1CLZRp1c3balV-D49MT3Z5KcgTFR2uSi7ZEu18-KOkg&oe=6A5E0362"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
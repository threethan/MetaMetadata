://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhBpQQXNNNIQ7kNvwHxgQy7&_nc_oc=Adr_hFj3Wo7Y28Jwr9SMPGBeLJrSiMcx9zCgV5yysozK5T_-kXWQqrN3j12F09YV8Bc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16V5P7BB6N1afiuH7h1_Nw-f9T7WRoiXyhSMbgk-IPGQ&oe=69EDF226"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGGJ0P1yxBcQ7kNvwGu0hsI&_nc_oc=AdoqJqe6RIiOTCS157MMqd-TcJSnzo_VsXXgpsrvsHRDGIDc_hQu8VUqdDgpsAMXsyQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CqJXYwMo94MHm7dN4JOaoDVHG2X71DQa8bkZNd41Zvg&oe=69EE1FB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-4Gu8IXLj8Q7kNvwGU9xPG&_nc_oc=AdrCdYacnL3MnHXkkim3rFFMjPN3rbAkVWzqZ213vA3n7_gvHczhmJyPto_SnEfkRDo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xXZ6HDTgvZVyiXiOIhC334R30jHCuTe_Z1IZh-ueqPg&oe=69EE197B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUB7dJdr_LAQ7kNvwGtMTG7&_nc_oc=AdqYy2JllSBxcJ9WS-RjaET5BhZxOqZeT5KC2rYP7e1cnajWWN8GeeIP49ji6FwjLw4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0d2S_hR6IWMEb4V0eWcgl5AYakwd0An7TMG09ktLLrow&oe=69EDF6B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_YOKydNnMcQ7kNvwEvsmBZ&_nc_oc=AdqYWWsyXaSENNdxmWw49rku9rA8kICE-UMZ3sx7vsgpo4Y8-7aW0gPfqhEz-IVKFRU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3w2WPp_wf3mSOXB2VkVNEMXSJL4neY_y-inQvvn4IV9g&oe=69EDF4B2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpM4Rwt7cEkQ7kNvwEYTvM2&_nc_oc=AdrwpTbYBpqorFeyFXdmVyg2vHnmiDl4UM0rX34vceJri2spLbwr5qB1NYxZi29xnLc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30fO5MgqOWPN8V5DlGrAzH8ZfQIsxYLtQOG3GZwNHVIw&oe=69EE2453"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrzC33g79KQQ7kNvwFybssk&_nc_oc=AdrOuw5Tjc_bZkaoo9RIAXsY4pN-Hh-hsbeVVf548yyiXO2ZzdWWYMPJiOmzAI6acrI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iL0ShVt_agkVPdusBRY8AuXUpVI9I3CBu6yeoit9pyw&oe=69EE206F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KORvDL5t20Q7kNvwHo4CAu&_nc_oc=Adpwvos74i6DnLfdAUBQ0oGJ2zPQ3t6E-0EH8AyFxlq5fQQ1vh6mtXR3SIEjMMLY3Gg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Vl7pZWFy0zdkmHq4why5NfmDEBBELCmh2Y88U-vSDcQ&oe=69EDF3E2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
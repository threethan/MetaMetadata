-25/38974500_800214781605120_8880468551637015930_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_phd5AKgtCMQ7kNvwF_nnje&_nc_oc=Adm7ARw1HlD4eu7Hpl95eZ7G0ZUVrTAOpvhMxOoTH3jAyCNB2S2W6HZMjTCQQtrjqw4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuRQ4kJz9GrZiCB14Cw1F35prviMLJNVUAZIEe1Sv1Bhg&oe=6999B86C"}]}, "id": "1005005773748906", "locale": "en_US", "screenshots": [{"file_name": "HighresScreenshot00011.png", "id": "1326199667974786", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035386_1326199671308119_4397089309417940909_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8OcnLjhvrgQ7kNvwHJmWd6&_nc_oc=Adkh9woxeP3UAXAEDELQbqeBTs1D-4oBRMhf7JfZ4U0LRsqLcODZipNva_04T2OMYrA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftmndeATQxb5Y7HUSRgRj8Ahtbc7S-8PSg5ACp5AbA-qA&oe=6999B1DE"}, {"file_name": "HighresScreenshot00028.png", "id": "2412721535575051", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974577_2412721538908384_6467288184304840049_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xKnvECUSiEQ7kNvwHwKuBi&_nc_oc=AdkCH2RuTG7VNGYnNL4pfey4P-PJhSTVNeOdCuWQdJEbUw0HG2fuoJ_OXFirdSdY2Z0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftbKVJwWnPep_UUQgk8w8zU0WMlY4N5DiqcqmftgVt9Ig&oe=6999C24F"}, {"file_name": "HighresScreenshot00014.png", "id": "997351624641332", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982456_997351627974665_2778603811108028476_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojUrAV5gnSsQ7kNvwFo549h&_nc_oc=AdnbxWbZFwq8kAMUtvPBrwHIn7gO7m3jMYsD3zuNPRZzSE7DZWI5ufkxhOyjvcLy_j4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afts0FOO_ZMN3X1rKnLIKOJMz6eSQQrljw0wakU-5gZwOA&oe=6999B521"}, {"file_name": "HighresScreenshot00040.png", "id": "807733037419699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984472_807733040753032_763200239777074167_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Xp3G7j8DzkQ7kNvwG4PlT1&_nc_oc=AdkJQZTJIQ-c7k85WdefcleD83u3KbUUc9zDTuG-MJsNInoszlBomgmxQH5-HTY75BQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afup7DbYPp3s-VhFsbCmdBjXtg5E05XH3JEQX7m_o2Cruw&oe=69999FF8"}, {"file_name": "HighresScreenshot00146.png", "id": "163970600033098", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566678_163970603366431_5435931785999963108_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORtughLsAnQQ7kNvwHtcj3Y&_nc_oc=AdmuLwdnv6EaujxXoXqhiSHnNqgcfPkrazSJ4m-VfjF446qwN4ogPvbr7YnPWB0RtSg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvrXjJzoovgFQUrGHCGZ0IcZOkv8sMdukIOsNJtAROQ3g&oe=6999A471"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6F-VfBMERloQ7kNvwGV2JmQ&_nc_oc=Adl0PR_ABn6F_k3PkKNApf7UtqZDzWWrRVI9tRAtchebRVDaWJolYWM3eCU6UTwCI0U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuHQSFB0mDlsdhvRKzqzGZdODK_KO6MBxWz8pEHAIwIJQ&oe=699994B2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "1324311035174797", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984472_1324311038508130_2610060411856834928_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZVDrw7626AQ7kNvwFqperX&_nc_oc=AdkoQC-232ltoRAHBKRJuPpORbAi-8RTmqMx1pXV7K2Tqr68E03P7h1YtlwxJsXVod0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsPhpVMTqW2y32i7p0EHsZJANJiu7QEZDFqwS7fkfSiBQ&oe=69998D78"}, {"file_name": "CoverImage_Portrait.png", "id": "1021944422558335", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031612_1021944425891668_3460677483354056217_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pyu0ojg2pEEQ7kNvwEJgm1X&_nc_oc=AdnD29gnbL1Hr5y5TytOuuOwEowgisyQ2T4X-PWZWnc5p6wlhKHCbbLhj4QS50MmPF4&_nc_zt=3&_n
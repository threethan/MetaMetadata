://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THgIJt5eU8AQ7kNvwGwr18y&_nc_oc=AdpGXmNHerQKubxtZDlkA3Ng_r_pEn7t02uzZQm2d4ojlCSDdDGLjTEkrGGIxfHd9W8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw-FFWODPzOxdVV_Yvgk0UeZpOCpn2xJvk0uzhq8Jw51g&oe=69CE4E26"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xPxJB4MvCwQ7kNvwHXhEFF&_nc_oc=AdqjqN1QRUuSZFFEQzaxIHvPJ6qIqFGzARVM7MHq0GrH-y9EHnhx2yvyhL6mdAonZi4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx97kFhi8uFOhNfFEmLGNEXjtKvGQJDBhtKNBIDhnaQ6g&oe=69CE7BB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zwh9cx0BLToQ7kNvwGU4P_f&_nc_oc=Adpfz1aguOtZwMitYDewQXrGLrgpL1J2LlsS0jQH65KHeI69ybc69V133a_zx2yVfio&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzgdoY3mfrKxGyYwt-ieQFPVLmn4bV_q1CpTQeTlihhgQ&oe=69CE757B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAytMV6KTccQ7kNvwGtcGM0&_nc_oc=AdoVHvolMx4mSKpSMYmqjHmHYVubnmgUAYFh_nUyJJEC9qNiuOkzaVL9bAMzW4Zdy4U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyCLEBSAMFpvqRo7W6jYo416nwRa8-uX7-rQVRE6PRwFQ&oe=69CE52B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6QRA3Zb8WAQ7kNvwEH-pG3&_nc_oc=Adre3BmEx7sYI3SwBzyH2zC_YWwHhrJDFZvSmj-oteBxfeE0EbSRKbtHricBjP0gO2k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfykX1vwXsquUuehQMhclbb5z36DKsfMG91dCFm8hhlayQ&oe=69CE50B2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ah7mB0POWEQQ7kNvwH8T2z_&_nc_oc=AdqTrrC8pyb6UWG4ZK6ofVPSnWylxOalDxhV4xMGqzfHX-cr6GQQXhnwDPw5OUtdpwg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzrFpwIkHcSRWAQSg5AhB9lYfp_beqslFZuH8_4I_g8Pw&oe=69CE8053"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GiRju4NmD6wQ7kNvwEewLg8&_nc_oc=AdpVa9gsjWR1Ud7zeTaaG3EQOUpktgdr0KEREWid4IEMBdVkxozX-WlthKwf_ygUKks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzlucRBOFF_CFy9DLCpAedefNyeSGVq5nSz87EOFptVMw&oe=69CE7C6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnsDOVS15JUQ7kNvwF1Tqo2&_nc_oc=AdomUaa9HW0oOpuBWDiVQlqVkghySPve9xuN5j5qGoX_zYMi8sKbpZMCZit50fkOapk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzEEnfxZlTvgGZ2Unhgh0NUNG1joYN_W7H7Mf5fLV_whA&oe=69CE4FE2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
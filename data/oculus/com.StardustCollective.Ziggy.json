://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atEi0bHJUD0Q7kNvwE8AXa0&_nc_oc=AdquWo1oXJhhPzmc7XS3GbvAkix52M30NuHAdR3OW_FL39GcLP2X-OiAtBSfQ22QbNY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTCDN_R5Ih1xsUj6zVNT18RnVGsQBfxFvxI0HEkQk1Uw&oe=6A7B02A6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAyzJOKX6m0Q7kNvwEgv936&_nc_oc=Adqmw1skG22sP0Ui4hX6SsDl7RPW0mnwY8EI0AucGtJR2JSad7N965B9lFcmtLVIQmE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOcLvLYhnhRHIfreD4VpaeBxrxWN4h7ePvhC391bkwfw&oe=6A7B3032"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clkyehyzS_IQ7kNvwFaB8ug&_nc_oc=AdqAN2yaxGjGOIlQrmEGb4n3fm7l48HCJyMrfaDAKji0J9zq9mxlR3QAMeAqnPwvG8g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeeDLUrGrBtcGDtuwmTZWK60_T99EMYObL7jo_y_aD4g&oe=6A7B29FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcjPA6W_6vsQ7kNvwH7YtVB&_nc_oc=Adq4Rkv0hbsLuVHplKo7yN3E62Gk2Oc48jCyZtJdD_muG5f9-iN9aPmwYbpkEHYQMMo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFV66I1xd_bqayIHL4LDdoc05cOqbNPB_ePTRv3lfmb1g&oe=6A7B0733"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5l2swxevyiYQ7kNvwHdxgT6&_nc_oc=Adqa3UuF9HtUVcELQq5Hvf6fB6pDHTlQZ5KFGF3NgiszgfIpaem8igATChsyuNl93ZA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElpHwIPS00-OJYV0r4H1snSd04QfTa3B4_sKaOtyz8yg&oe=6A7B0532"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVhF6k-2IsgQ7kNvwHW9P5v&_nc_oc=AdouRrdr2T7t5qxi--a210JWUUYw3vDKfD5MRrXaB1eGyzDWVAQvBtQkovdAuNXY3aM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECAWWprh5HNYdf9uCnPgFcdhvMyUlYEqqRTRCVBd9eHw&oe=6A7B34D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-tgXMLcwdkAQ7kNvwGRgu5U&_nc_oc=AdqPpv89Kztw1sQu-Qo6rUZO8CpTz4jSZlT89JCiiRiRsLec9cjkQY6pXRrePQ52yW8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0gx0u1uXTMsA8XDgLFNbfagOlazhdajhV5gRZL02NBw&oe=6A7B30EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2xMlnErQbIQ7kNvwEAUM8w&_nc_oc=Adr_WLWFNyiKxBNnQQplpEhnqlWL1HtciFJLmFKAMRTPgVqOpTl-ErWVfgll82ISW3A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxKqIvH0TjRGz2xY2nlEyO6h0uZYfU_YIo_yAVINXLXA&oe=6A7B0462"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
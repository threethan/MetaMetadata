-25/38974500_800214781605120_8880468551637015930_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_phd5AKgtCMQ7kNvwEDcBR-&_nc_oc=Adk3TX3GMCd59QnFVc2lymelEg7KgLtjpky1focTy5xjBvwbWGr_YJ6nZ3q53E1RkZg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfstaxxW-gHzRV1jyopY3MqVVSOJnVpqDepzjah1cMOqVg&oe=699C5B6C"}]}, "id": "1005005773748906", "locale": "en_US", "screenshots": [{"file_name": "HighresScreenshot00011.png", "id": "1326199667974786", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035386_1326199671308119_4397089309417940909_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8OcnLjhvrgQ7kNvwHeC_za&_nc_oc=Adn0XD5Kvp9PfEJaFJ3nPv7ooW03zBBQ8of5DBy3kWP_GyOc_YIZ3kxrcqOgi4t4GMA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvjzq29xWZyzDwJX0m0E816zlKc-RKhH2pgk-NJ2bkUtg&oe=699C54DE"}, {"file_name": "HighresScreenshot00028.png", "id": "2412721535575051", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974577_2412721538908384_6467288184304840049_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eef6D4EjPBQQ7kNvwFTJPon&_nc_oc=Admt8mAp5b9TWZ2JHONq4A8JqjtU2hOgo24toGNGhHr3uzK0G3H81KjtyV63HQ6wMyM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvgh3DoFKnfQxAaKtL-_uDkg9Yy0ssZX2b9hM8I9obD3w&oe=699C654F"}, {"file_name": "HighresScreenshot00014.png", "id": "997351624641332", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982456_997351627974665_2778603811108028476_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bflFh2Mmr8sQ7kNvwF06hpg&_nc_oc=AdmFLaeYAwnM4UzpBAdbmbZ3o_ng7lUEuGa_B5FmfNQLHPfMp-uw_DBrX91Wn5iy4fY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftWM7eGZwmswRZ0jPgV-AqLB93DVG0sJPc-z-0KNba4_A&oe=699C5821"}, {"file_name": "HighresScreenshot00040.png", "id": "807733037419699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984472_807733040753032_763200239777074167_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Evpv0UShgXYQ7kNvwExJzxU&_nc_oc=Adl7lBWHReM2JKVH17KShpUy5d6y3qLXkn62uUpEkXV7ExEHkrJfhcveA5CocMdO4vI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfukivXH6regwkRuKoWGFZj_YLMRiRK6j42ssYvqLFVyyA&oe=699C42F8"}, {"file_name": "HighresScreenshot00146.png", "id": "163970600033098", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566678_163970603366431_5435931785999963108_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORtughLsAnQQ7kNvwEm9NgH&_nc_oc=AdlUcxbM_kvvBot2yvEDh2kHwx_UATxqyQknpx1wrLC7BPBCxYyJXhwzwURCxZz0baI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvUp4nHvWHFjJ9awgvOVXGSEmxQpgfjTcuAoYjbNsrvAQ&oe=699C4771"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6F-VfBMERloQ7kNvwHvnY8p&_nc_oc=Adlh-KL4DMT7ip3KGVCXfr7kLC6s-w9Dy4w4mlyzIxmmEbFA5o7PEIgNe2pQf0vgTFk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afto2xSvK6CRjHIYZq0_uAiDko4KL0ATT9d6ax9eBZZNzA&oe=699C37B2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "1324311035174797", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984472_1324311038508130_2610060411856834928_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_RNerigqeOkQ7kNvwE6_eJy&_nc_oc=AdmjzRzQ9zpSgppXMhFX6YbFJR2EVpc_ZZvKxl9n4TgdgKYwNmKOgh7rJaY9kmXYTSM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuzqsabtZazR321VJJfWu2QBKUKEidADuZrp034lqcncw&oe=699C3078"}, {"file_name": "CoverImage_Portrait.png", "id": "1021944422558335", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031612_1021944425891668_3460677483354056217_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dFthXXWhpwQ7kNvwHvq78K&_nc_oc=AdksRHiB81m8D0asLkNsDeYx3Ru21lFOie1yR-esiX66PjV32wx7GRo1D2bR7SbbW50&_nc_zt=3&_n
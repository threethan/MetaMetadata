t=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw1xxa3pFmvb18adWsVrP2Rceed3OyXeWFKA6QajCyGpw&oe=69AD7BA1"}, {"file_name": "HighresScreenshot00040.png", "id": "807733037419699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984472_807733040753032_763200239777074167_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGgu9opZZokQ7kNvwE3fCbb&_nc_oc=AdllWMc7hwpSgiD5gtbI4JotQ2ff5G9L8IjqPv08EbwUwQz8GK4TSUAWAiyGrPEat7A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwkBuzi-wNYLNPwUU0mGUg7CXRBW_c62PrTM5gdlDwnrQ&oe=69AD6678"}, {"file_name": "HighresScreenshot00146.png", "id": "163970600033098", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566678_163970603366431_5435931785999963108_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaIyDVibxWgQ7kNvwG0RtGa&_nc_oc=AdkNl4c8eNUjwX8J6ocuE9sPvXcYqn21eB3632zOfTOdSLEvTfXbV4Gmf7_8KhqWq4s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1daUh7SCGXf8nl9Whw5ZBAcBaRQhvP5yEGB00P1HqQA&oe=69AD6AF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRYVlzmWzN8Q7kNvwEeytj9&_nc_oc=AdmwwGrSxXIQb4cz1qrFQAwFaBlCTgcyscqed2oHRpgLXF80cQxa9ewOgbPvoBrEMEQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8x9xPbPIBB5C_x7X94n7_LWgLOobyyu476bUSesscqQ&oe=69AD5B32"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "1324311035174797", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984472_1324311038508130_2610060411856834928_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDFMrsFLWZcQ7kNvwFYkSfQ&_nc_oc=Adl42riIZ1ePSnVuZsIhCqxbRAomIHWx5Wpy1O8PUrkLniEIqrA88CTbqm3O4x3XKfk&_nc_zt=3&_nc_ht=scontent-ams2-1.ocul
297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJIw57yLoUAQ7kNvwEZB9oN&_nc_oc=Adll0OA8-7SX-Wnovl1A5l7laGwo_dSafIRc07uggeDWMkhZgXdbpYyt4fxGic7AYAg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwPTCsb8jNVAKdK_B5lhgmCIvJdG2GIuFqUeiz6Z2hYiQ&oe=69BA87A6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23F4_WpeSZoQ7kNvwE0AWxY&_nc_oc=Adn4rYCuz7vevewbBtDlNYhDUgWe4UCGvMLzHYgIKUkXuntzm0FlMj3LkpjMKtUTJLc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx2DRbfuIlVl2q20Qoi2LKPn2IfnezvQXivmo3eEa9q7A&oe=69BAB532"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXTZXMoYIIcQ7kNvwHx8Yv-&_nc_oc=AdmYuJxXnFOYOdOkJb-sPqGWnAcS4dwFI8QjOFDFQP9wK6NotXR1Hmo7rAl8fN_sSV4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyoteyEhL5h925qmcVlY-TvI_LHEV06k6CNa62NL3oH1g&oe=69BAAEFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nyNgiSfm-EQ7kNvwE3abUv&_nc_oc=AdkIaQg1Y7k4zEg2_57Za1n12ieVGzkprAHAj_7T4DcBCrboZzA6LvFonHM1bv4qI1s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKHNo3IDEMm2AUYeTQCmL5D-Efnaq6zrdU4keG4RNJqA&oe=69BA8C33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJ54nuhplfcQ7kNvwE1wA8y&_nc_oc=AdkRXzAKeVngjpYuUKNeBjttvhkW8uQ0xduXV5a8SSwQQc-u9MjvVD0JPcVDugPX0y8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfylnJK7uGQ_nad4yQ7xQCBy6gdA_CGEOIWIwXb15Qdv-g&oe=69BA8A32"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyonzzBKVNQQ7kNvwE4Fz0C&_nc_oc=AdmrEA0UENfj_J6PljqwiKxEPOHredyonDfFQODJ3w7xg1M65pxECWZaqhNjCJper2o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxWevojVhvAd2oWngbTDoqq86UPQLZ9aylhK_RY5662Pg&oe=69BA8193"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIrWnLo1LYkQ7kNvwH4_PSi&_nc_oc=AdnIiJVOgeaUG2nwFsbYueGLl6brr3wK6cPXVJG6LsIAReaUEP1JJsM7BCH-zrFoTBE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzAPYMxubJgbGGUhJmW7lI218T8vtUa1dC4t35gQNQpGQ&oe=69BAB5EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymxXHAtIAb4Q7kNvwHv4aGi&_nc_oc=AdmI9zoeC31l6n0F1pSsqIlg7gdXRgFJW8-K2ENcms5735X9Yp_ZVobGZTMukTLiXXk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxnJ3Japi4AGW9jmwNsCBAGnD0qF7hl-Y_jVVZ680zivA&oe=69BA8962"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_5218087471640407679_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIwCzAApnUEQ7kNvwGTN5hX&_nc
://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feVB6urHA14Q7kNvwE0BdYo&_nc_oc=Ado1cq1WaUnZUkTeYBzlKv-jtREjmBO9V224AaVwpuwZgXZy9uVgkl7LYVaVF2F0nO0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Vr_9UHxQHel7zXv9hyGnlz8PJvzU8FiGR030CygBmdg&oe=69DF71A6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dculky-qumIQ7kNvwE2R5JJ&_nc_oc=Adrea2zrjyTPHMu9pSwKihsxQsFN6suzs6bMP1lrj9d1ooxGHXoYexspcLgw5o_K1rw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FqvzpsS-OkqLUG1V3gPFGAr5JiQmUD33t20klMTgCSA&oe=69DF9F32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Veomvi6MtyEQ7kNvwGjr7pn&_nc_oc=AdodW4n888y2U2Yx_TvD6rLaVWyiP5nQAjS0Pmq9DKvKISMGSG1Gm0uViycslm99ino&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10qepghhueQ9doPsFklERr734dB0ywJfRjcAMegNW84A&oe=69DF98FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JqVnoZ9E-4Q7kNvwHNw8oE&_nc_oc=Ado0lshfH7g7ia1zEp1oKBjQHGQMs1DDbfj7PeMjVm9-nNAXj-F6bACLG_seCW-LUn4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3m2PCH3f5cvYIjJz8qp_SOfJ_1ktnbk9F4l3wFVwx6Ug&oe=69DF7633"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qB8XbHtEG3kQ7kNvwEDViVg&_nc_oc=Adq-QUHHDJPKkDRkXVpDQty9Zhgz1VFnjG89Q8ni5XqJ9O_XPI86nXIFoJ2dz09k3vk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0y25KK9w7FAeThmwfuicqvoVFWgAEnAPWBmpyRfkpFqQ&oe=69DF7432"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQRhLi_Y798Q7kNvwG8Qrvm&_nc_oc=Ados4pd4Fm-ll7g-CAoP3EmE70n3BOw9UkV6v-ww8NsU8CymVHMzgwPcw7iqyfLUZRs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0laLOzjsVp9xRokYjgjrmBrqosKNkfuWf3vAiI4_dZ3A&oe=69DFA3D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAFy-LNghNsQ7kNvwG4e_PL&_nc_oc=AdqPndPRJLqPHKHlZn--AN993usbQWvMBQqqlPlISBg3gige6Ge-slvOhOPlppcZcZ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FBV7TO0_wH2DMR_ylh9zUdGdNuuXJrPZLDF6uqApCPw&oe=69DF9FEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFWtOxiG5mYQ7kNvwHtCmBw&_nc_oc=AdrvC8HF8nAr-DrK2pqAlHRcUqTD8SoCmrHmqVsnE8VSoC8Qn4EmVxn-WQDjUUQinHk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UpHjtTKf2KC0YwkEy2rQrrElS64sD1oIBMQSRBuEDfQ&oe=69DF7362"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
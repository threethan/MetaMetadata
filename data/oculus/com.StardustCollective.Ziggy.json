://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feVB6urHA14Q7kNvwEDftci&_nc_oc=AdreDptmFEHHId2Er-HzqtikDDIrqWkBZpYQJe-PIOWSaRHg1Kvpij12rLNwqHDAsjA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EUfEEXTTaKjk9tDI_vgmONprx-K4NtaIeo6t-4rv-rw&oe=69DE2026"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dculky-qumIQ7kNvwEct3tu&_nc_oc=AdqUaRZGgbMJK2agpLJHzZI_lsSNyf4S95Hjn8bQXjs5roRKC7CXOgRbLxSwDc5P1o8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XqwXrqRb-K1MZZq8weGLHPH125iGAzqJvtQCuKfmygA&oe=69DE4DB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Veomvi6MtyEQ7kNvwGHevxa&_nc_oc=AdoV3cJuMi358zoQmgao6dPZHVrI6Y_lmDKkayRPUT7ZS1Ou9Rq3IW4zmdfnx0xmAAc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2N1GqGGuj1DuT6f0jMnHocTOLi0uFAuCit1ox6lF9izw&oe=69DE477B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JqVnoZ9E-4Q7kNvwElZkka&_nc_oc=AdrC9EGF11dkr89ixttJlaT7F9vS0tdF2X78yPwbwtKPVhhmRkrvMwaPZ-ZS2-YoYUY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1j35HS0RWz91Q2Ornm-lSBeSjIrKOwsMcu0zynH3lYpg&oe=69DE24B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qB8XbHtEG3kQ7kNvwHMS2ty&_nc_oc=Adpz44Hq8FsN0MOE9U4X9BHXv3b0t5HRiwECS9D5O2omgzYidB5VwH3OF_lvTirN9H0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pIcOtEEK_bl3F093T7v6KYTHnSlIXkTBqtYZmeFQdCQ&oe=69DE22B2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQRhLi_Y798Q7kNvwHLwje4&_nc_oc=AdpQp5D0y7d5JySLOWHtAd35n5ZH5PMgQdZBe9uf5jcdSAOfPPlwmJHqSdx-os8trHY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tjY5GUs2vIwwwqJ5lP7BIK5nb4KAhoN5hbVOXziVYpQ&oe=69DE5253"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAFy-LNghNsQ7kNvwGJn0l0&_nc_oc=AdoOgvnihirXfTW-rirjHA_3VVsnLv6nP7s-y1-h5vkPtGQ58Zm3SFJXhjRhxg_Xmc8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kuvUCZbi3MrTI6kt_6g59fRHwNy72Kxw59idJAUMXBQ&oe=69DE4E6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHCqXcF_MX8Q7kNvwGXjJyV&_nc_oc=AdqxYTb0eau1vpmTueF2oA64Szuxhv_NxHq3zOJNq3xwTw7T8qHy19l1e3El9wJeVSE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af032OJ4kuM8cpIn2qZ-7C6A-XQHkFXselJtcEiy8R-Qtg&oe=69DE21E2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
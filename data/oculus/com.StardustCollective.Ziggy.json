://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1H0L7Z_HktsQ7kNvwGubSgG&_nc_oc=AdqscJjxe_O9ZR15bfEEG2GoQaFDc0wTiB7FjHYtsMhq7wLIV9PDuZRsPz56nT91JOk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClhZmQShNwushflvrvSxcuBGUcXf5wJvy0QPv2ryelJw&oe=6A5B5EA6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGtpT49CGmoQ7kNvwFablTc&_nc_oc=AdqYpT4pQskOP10BfGL-gy9SOaVh035Xt-_sn1g0OViesYCeK7StzdqEUiiVhDxDeaQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXRiNSNXf152jn1S9OnDqZcb094LhjK2-zSfCC8FH6Xw&oe=6A5B8C32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6t1QsFCiUxgQ7kNvwE3S4rr&_nc_oc=AdpbnmDLKNBN4gmP99C3vJLMIECvIHC9nZORXCQf1cvVFr9WMZdFzSkEtSccDRl7LSs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD05d0oD4uxqbRqklsFz6nXiDl7ZMjBp3-JyJhpSGZkzQ&oe=6A5B85FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEQb7WEzRBUQ7kNvwG7AJvU&_nc_oc=AdqIozLWJ9JNVP64HXCeZMHw1WE8gojYRkouh_ZuxPN4kfLKxcky4IbPLF3mVcylanU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7Y591LBOlZ7lr3iKzSoW9b0eD-sJn6jaPa8qbAzrpUQ&oe=6A5B6333"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_qz4QeuJx8Q7kNvwEvgmeL&_nc_oc=Adq4ocVNE1P_At9X2DXZ-1m31XtGNL3V1cT-hLfPfxsgeyUl7e3Etwp7cK2iyAbs4w0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCgKN77DWmGd9-LX9kMs77rZ8KTiy5rElYft1ynpan2A&oe=6A5B6132"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxMq-BoOiYsQ7kNvwFiKdDK&_nc_oc=Adr9V1jmM474d2vYL0GPh4GuySo2DV7evRMZlryfx6OwDJA6g403G8tJxc4aWpdEjrk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-JWJzQmzY9XYXKFPwO24p2CmAzHt95_SiS_f2sNKc_A&oe=6A5B90D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cI9Ydly4DO0Q7kNvwHfu6UI&_nc_oc=Adpx3-y5M23dLZd96EPocZiVxP8Wx-J7qZ427Xw1oNO07qxCFH93Q7X70VJTO1l0oi0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDx67ACius3CGiL3Af8kEJfGaqRLtqBm1tA418kAy2r6w&oe=6A5B8CEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lau5SP9-74wQ7kNvwEQKNGR&_nc_oc=AdrMuFNFnJnAAuG-BubnzzVpM2SRphBVD-iy5yce-V1uO2UuTq43Krvayn2X6ydY20k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJN0inKJtYaYmKooV9IokgskShIMoHWKPu6nx60jVPKw&oe=6A5B6062"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
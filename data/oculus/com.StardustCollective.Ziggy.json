://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXLvW6JooG4Q7kNvwFqxUjJ&_nc_oc=Adrug3rg1y4ak5LPsSNhy5ki0CpkqddzC2QR9O6BEUrDU1ZbZAAm4N2fWU2ifPb0SG0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69_Pdk92sQVYvUZ3cwsVkfk_YxsWLSNGwBqSmp_dcnoQ&oe=6A0DCE66"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W53Jj2SLPP0Q7kNvwHKB_hh&_nc_oc=Adq27TLw3aEbn-vkJ7ryS6sjutT4gdqqAmUMj6vh09LUhSAyqfpScLQdHGQhgndRYZ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72_GY1l0elL_oDTSdtBpqRcnWDtJph2TxJ2kYShhkE5w&oe=6A0DC3B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltRqM3gP_1QQ7kNvwEgwKUw&_nc_oc=AdooNouxiSsN9vbIuVqm2AbeCigP0DhTtzKTJGQiLErkrUkObdXlzesKoy7df5s4evk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JRutzA2fluYD-HXthIGFTidCaRgprRa1zM_ibn9tFDA&oe=6A0DBD7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1r0-lQqRr0Q7kNvwGkcvVV&_nc_oc=AdpRzAowsXYfdw0FNtkVSqejFWgdbh8igkr7T9GseW267zx0VD7t9SQ2sRW0_X9I4Tk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UsvI-oG6Gah6Oi6uBVcg5aW6taFI_8oP6MAsC9SgWbA&oe=6A0DD2F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3D8cUufkl4wQ7kNvwFNJwYj&_nc_oc=Ado6kn3Av3z4Ax-3T-B1UErVMapGUvYCQExe3K5wqAkOdbFCKbdPV3xDeBQHy7myyvU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-CcBtwM_kUCaoTp0K7qq-O3T_LWpbrnwcHmmA5WK0xg&oe=6A0DD0F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5XIMSFryhMQ7kNvwFjCVs6&_nc_oc=AdrJzvGw0ZvmpCHwT8gb4aQC7mFSkXPjplouvKdKEU3bZasCpk5j6ri3_t8COeMViy0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4os3pxrwHqu3p8tvfW3Y6VQuwcIKFqi34cRP0pu1h0Yg&oe=6A0DC853"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2f8c-B3JZbcQ7kNvwHsRkGR&_nc_oc=AdqaP4r7WDR_oUPygH8QJa_iYJFB-iQokVg-3Q_mPmAaKu_9a4_FWlFrkRZvSU2uMFE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EO6KSdFtZooVt-ynmDnrjZxPqmUAO0rq_iVPyJwSA7Q&oe=6A0DC46F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wNLK4PjmdQQ7kNvwHvUrb4&_nc_oc=Adp7-V-eE70WgMm7newkhbWuwpUdCrIXEbfZCmC1R5CYdnp4fE_WN_AP58EENXqZa1I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VDxJLxnYGw2EGRH1e6RAB421XGKel7ej0Ex1bl7OqVA&oe=6A0DD022"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
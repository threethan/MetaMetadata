://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpWhw6GdSOoQ7kNvwH9tNvq&_nc_oc=Adq2KZV39JoM3AMJk0PxWSV4TnqDcv7GtC0hYdjbbACc_xitygCgAkZeRx6PEek8pNw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4H-ASuvG89XllasN3srWKzSXJal-5qzL6NSKijqAFjg&oe=6ACCF7E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-X-FpO0tFegQ7kNvwFiwdo1&_nc_oc=AdrjMop-rQXxNmWCKNcyqzdMngIZkPLnw7oY0s9VzsQTLG8TFAgP1-LSTdOak33Xjs4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLtsuT3gGTT_5jvsR523x4tWQU_PoL1He-dzcdvvVPTw&oe=6ACCED32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfD6rWni3ZoQ7kNvwGA0rxF&_nc_oc=Adofgl_YNPsp-7WPZYPbnyF_ozxYJ2_C1sYfwC37C_jNCdjyUMSB8skgIy5HGEAxrUo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuuDhEr2oixfOlVAo71N1SPSIVI64F_7yVfgzJBE-dVQ&oe=6ACCE6FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EA_sH433ekQQ7kNvwE7ELqW&_nc_oc=Adr4_21QGmYjt8r4NBDOSdWQZ3b8uZulyIBxaxgd_NyMbt1DRqIGfs73oO4XvKxFJ4Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFT8v6ox5_8bDlA0oaP2qVtWLLxxCv9ueoSGrsxZTinw&oe=6ACCFC73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOXETB3GPAAQ7kNvwENUa5d&_nc_oc=AdroG7QbNVxbJEycxSziXRlI7ZXASINvAXvkonyhns1NNJS0jQJ4-6UuBxGl_fVrHGQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrv-srSavo5jtMq0nr-fyuyXWY1ffTZ4lefKan-bh0FA&oe=6ACCFA72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLMt1VhTcQAQ7kNvwEvZJos&_nc_oc=Adqw9t3fzh59l1wgsgvzbUCmFShgWmDCpdAWerkbjiFXXiHgBCNpdAWN813e4jEi3Ms&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP66aLIiHIJnciO9_5KNnI8cfeHsvhs7im0EbKVPdXykg&oe=6ACCF1D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4j1P29ddOMQ7kNvwG9AKbU&_nc_oc=AdoLo6HC67qiTSlRRvthjcm16yj9eEBeuMW667ppLfZEhA8MfAQMMaMzqCps6MsrXt8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-gYzxRB9R7ztXZINFa-dmtxu8tmtK8D10Xq-vhCOChw&oe=6ACCEDEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZbGQPw16DcQ7kNvwELNybl&_nc_oc=AdrUi__FYqpJSsJxr2_h76nWd2GdNYx2TLO41nXuNZrvzCXGc7olMV-iU6f-OLppw3U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaLfAFwsalFnKzVx2KpKVpS7vaKDYZ7eob6oLZeDjpRw&oe=6ACCF9A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
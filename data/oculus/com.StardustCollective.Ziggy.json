://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHi2mPkhfuQQ7kNvwFL6lpe&_nc_oc=AdrjfKabz-10Zkh7GZIeREdCDri5LAI-P-QrYslpygV2KWkASC1aD9HSJ-7Lx753xZQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGT2EEiIqsRrEiZfy_FvjiV_qWg1_epRIRN_WDaMTlKRg&oe=6A843D26"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVn92GfvH8kQ7kNvwEtoBTO&_nc_oc=Adox9nqNq2dhmeFXLAtHdY8WQLQOejfs7X4emJrhyyT5Wx6rrBHpo84WZpYQSN_DPp0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLcHWgyUoUxCYoFj3GMxEm9wrI9Ss3Gjh3_c5RbWYmcw&oe=6A846AB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGL_I40DGtIQ7kNvwFHM4I-&_nc_oc=Ado13EmgU9HRHXoQJymBZdM4uLzDDkntcOV6JGV7bgH_Ffp9H68bI9zJHgyjC0SKpQM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF76ya8sbOifAt5hd4fjqTel8hJWoW0c8lHAvqUF0Jrbg&oe=6A84647B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HbkJ-vgsPikQ7kNvwFcTwQf&_nc_oc=AdrdxnplN8hHb8oOsSAWtejJeyGSEsbylgYNdJzGu20oojkVfmn7giSWdft8SkCEpdk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEBSvDt9BaG7QKyiYc7OaHbbC8AbAwUNDhBObKU2vlfA&oe=6A8441B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTTD4b8hDkwQ7kNvwGyyrin&_nc_oc=AdoCXlM_yb2P8yMAX6d9j3y1zwE2a7_psLhPqESBfdbzRZW6OZx14qfez5cTglwmoi0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBffagfu3e2xOIhO0WmelYYqGbdbU-6TjfDp30-SEySA&oe=6A843FB2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7xXMsHaXukQ7kNvwEtSf1M&_nc_oc=AdqR9Tacw6djgfZuxubYRN-K9qTB5zxycceGskrtLakIK7qC4wkRzcpc8pXiS2AM3PA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH76g5xPtWW5BxQvrMa-jytA8kVGI0M83Wpd2OZm_tYxw&oe=6A843713"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4TNZF63JEkQ7kNvwHTfuxj&_nc_oc=AdpClb41w5rae7CgQ2Y_A5_zcLBWqIVKgWdBE_dCJSREBOoo7hC40Eev04D7ALxRNjc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6Dh7-0mgnBQD7DbDgiFKpU4BO7pL8M1cCEgeCZhZ9ZA&oe=6A846B6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=liNx6kCqlUQQ7kNvwEMw5Ni&_nc_oc=Adqg1LVsp-rkhJVSkwxNetz_EL3222rHrkuUpqyAmU0RlgWcEeEpEelyfGxPcvEqnSc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgXDw15_LuVYYqvdy_Cnc5DHrTLFUrFYOZ6xR5o8bhLw&oe=6A843EE2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gy1Y35qYGTgQ7kNvwGbViFb&_nc_oc=AdntUzecy5i60QlsdBrEQgM7bJIiujUlhnly7uxpK7nQdm1kf77gco82EftpLGrSo5M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyrFgIG9uO3F0wfepkfdBC28D4qLxD4R1sUt2F8ONdNMg&oe=69AEAA26"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38C9jselHLEQ7kNvwGJrV2c&_nc_oc=AdmkTO5PkkbBhEYa6vtcxLq2USb9SH3aHntpgKsHPGnygpbA2v42ONr3PbLBl9n73Eo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyMiatS17KQ25wJ6jU-WaWbXpRHfzZB9IdezqwMQOJp6Q&oe=69AED7B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_kDmJaw7wQQ7kNvwEfPiIs&_nc_oc=Adl3LhCZYVTBKj7ooyFJrPeCgaHq4VYloGV3sDaagJ1-gPFxtkmZ2SR3jYWNpzBh1Wk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxtxH3khQjI4P5zR0aDxwusW_ratGhwGNbHXVxakw814A&oe=69AED17B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sr2Wh6zvpXwQ7kNvwGLzzsu&_nc_oc=Adn26ZWPZku_m5YGG5_dLuvOJP9N_aYx8V0i5KGfQR5XV3-ykKgubBc7OJZE3Lh6peA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyigwTkTOuvuLZ8SX605_bFEOg7SzEF5eTDKPqvgZff5A&oe=69AEAEB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRYVlzmWzN8Q7kNvwGwDZgA&_nc_oc=AdkG79hepocWHTM2i7_Hg947sJyrz1rNaCpko29eidpMLraHpRIMO0Tn5Iv1mv_0qV4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxPLZFcdADAnikc7P-LogTYf-FZo8-G8Sgg2JJI8fp86A&oe=69AEACB2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyvND0Hp5sMQ7kNvwEzACo5&_nc_oc=Adn7DctuBswy8HqUkBF1SUSObNyU2sFg1feIvTKU8SqgAsW0MoXnv_tQj-hofCV49Io&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxKmIIMEEE5uLRkH99wQx8FIAvRO6OkxvxWDhpqX0evYQ&oe=69AEDC53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9V81JT5h8fkQ7kNvwF4OP6h&_nc_oc=AdlMusHC1Yx_47h6G_V_0CxHsvNkGxftox2lmqYszedNVaHiTbXDVkrsj3QClKfPXhI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyoWERu589vR0ZFK5Tz95VWDhvRi7dRJuqZ_Braqw4xDA&oe=69AED86F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKh81YE-gxUQ7kNvwGxdX3H&_nc_oc=AdnVCl6W9o-NCze0IUscY_CSV9ocmkEjHi4cMn_iVv1qCLHJkDvXqTQojgfe5-JRqtQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxn3qHSn6deslVOf-f0mm18Twhh9HZRo0x6OkBkpJCPag&oe=69AEABE2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_5218087471640407679_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmpDdppPgXUQ7kNvwEEmVxZ&_nc
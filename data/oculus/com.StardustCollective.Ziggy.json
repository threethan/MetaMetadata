://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W633f0qsrjQQ7kNvwF5Gx6e&_nc_oc=AdrgKe3sn27OVaolRsbXCSUPVEndC9GV7k3KSnN8tq4GJJx6HTzYl-fSD6cbKi3_2Vs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkrfOPexC0wVRbmF_rdfdz1jPLMhKmsRjHpqUg7Zm1Dg&oe=6ACA54E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfboocHpKtMQ7kNvwFeLNC3&_nc_oc=Adp18LH_enA3bErDV_MQgPqP9nka3YbFy7AOpZtGeOWzoLT53q_TZqy_995g_DpDkV4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIjk_Dv6WFJrNzdd97svhPflRM0S5gIr1ALoFC7URrJA&oe=6ACA4A32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlMAURGTep0Q7kNvwGd5147&_nc_oc=AdoKEDWvtXEdw0dv87CUX27VGIBsDUuQM5vUObdV5iYfAiWQ9x_gb9J6qxRehOPJ06M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2ohk1sbjtk641gIRUmfzRsE_-4ivVAUGayyXV0sUFMQ&oe=6ACA43FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EA_sH433ekQQ7kNvwE2o5TW&_nc_oc=AdoOHzOwtQaidTFeY9yqoBbM5iF93is6UA9tiM6HbsnmovQAZWMRan_jVX0pWjIlZgs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOABGzaNkTIPNha1twKBwTAAM-XUuL8HAaIJPB5pzHmRQ&oe=6ACA5973"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOXETB3GPAAQ7kNvwG_IQWT&_nc_oc=AdpruodEWqQdIulC4yNsxXHKMu9pxHuOpgAttz6FYgebxjzG8ypgXB1feql7SPY_vHE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXK4pp5Do5TgF8I9i7Bgg7l0yTOTvvbYfjFSSX_epocQ&oe=6ACA5772"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPr__UsGfFwQ7kNvwEKtsNm&_nc_oc=AdoGx81_WenABWFIpJ-IyyWb1r4J98ucFcY1b3Pj6gvTP67akLoh2hjAYXc8bUP8me8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMjh_x5b5ILqSaLs2F_29Bs9zdoRdtVNW0KPw-ABkveA&oe=6ACA4ED3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4j1P29ddOMQ7kNvwFcbVt8&_nc_oc=AdpsHSKrLtAPygWViAQN7R-GD09d01TGUaPKYgIHlnLgLXaPc90VQYCeTi8J16-hGTg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwbrLDfiU2GhSXlaj-7dVuUkKC5uQ5l059mQof5pedQA&oe=6ACA4AEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kKsQLFQofAQ7kNvwFcQYos&_nc_oc=Adre5XZQPUI09GCVOhART3VNLhhdptS7CpYpnJVPdjFnOg80eX_LB9xXcq3UTLs7Y_8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNECk7E2qI7NYsC4KUNbo-9BXgVzGzEcbUVHZujZpRr6w&oe=6ACA56A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__Ie2crSSA4Q7kNvwHBAX8k&_nc_oc=Adq1tJXA6U8mzQzj_aaMgSztyZcG1ote67CP7lfz3gC5KJ6n3oez5TEJT7o5Y3ntHJw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxgs-sBgk3naHNwJMc7MNaoy7XruF4T1-F_0OCGj5cJ6Q&oe=69C513A6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdOP3Z9fT2cQ7kNvwHvqzXK&_nc_oc=AdrHNXAw6g8yRjRQ2NFFrD9af9DDgHe2YVt4HcVoLkcwfJesyRcJTn695OO_tODhTWQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyev3Fd-2fz6rLgWZgpKB0h5fETEh3f8oBHd7Abh9N7mw&oe=69C54132"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aldJuxzDIcQ7kNvwHM44s4&_nc_oc=Ado2QdrfMbpOKFiqImz7S1PJMmAOIJzRcpTegTlqUcr0JSKXkFXbwM8GJMNTKyqk0Jc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGGgPEX3Q1JLeFUM5Ihro5s1hEqsrZoPKvuPOBvoSDDQ&oe=69C53AFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gr4d3bQnlzYQ7kNvwEaoxB7&_nc_oc=AdrtdgjM2IBGIgYF_uxtC-ZhyJxbN9jFyEK7v5ErI5LElpmWUGdJIrYOHaS_qHGtEXs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxGEZMiYbYEn0lR6ESAGsYdPBm6anVXnCnNFNpeElbpVQ&oe=69C51833"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcyM2BrIJ6wQ7kNvwF-Vtx0&_nc_oc=AdpFJnpV1SL50tEecRfMrArMlTmLIdHC9gHj8VmKTyGRs329w275XlFG8Ry2vqNlSOE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVrB0yOMnBWPmVq_5HKphJLMNuYTw6-tjfhKI7ecN2xA&oe=69C51632"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oor_MplDE4QQ7kNvwHB5DVc&_nc_oc=AdpsPRWO8f2E8RRHMJ5e3HXNdtdsXIHH9SacE_L1_jA9UpCIp38RkW6L_tSwKQgh15Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxOqeUfXECF6X6iYNKD9JyYcD1IQXofg7e1fFco8RZKhA&oe=69C545D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PENtYrkBRM4Q7kNvwH0EPIb&_nc_oc=AdojlK-1G0HBZP5utqfRLeRwXP3_w4xIaOiOpSZrJDi04IoxwjNJJdvg4E3t9PaaFPY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwoJGKRNkzH6kHtvM6BpWPnWMAUJBpZvE_HUXD30mrpKA&oe=69C541EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OL2aXUV7jhsQ7kNvwHmAJh-&_nc_oc=Adr61TOTwt6bgQaT45imrEAeaZK6aGU0FuvJmaP0cXvqU7d8iTmkRklCoTEpzwRtWI0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyftIxBMH1i8v3GX_gYDvQDU-rCul0AomxEUGa0uPC9lg&oe=69C51562"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
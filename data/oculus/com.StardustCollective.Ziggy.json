://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhMcoJbofSYQ7kNvwFkyxYM&_nc_oc=AdqpEMwLV7WiCwBmolHLhKUXUEAa2-CvloR1hpiSSiVwpsyLL3kZmH5RikizL6xZNTU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxlRdxTl3TZ2E7eA0CoEzxhampzV6GKiPJbav3rhXw4w&oe=6AE4B2E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43tyTF968CAQ7kNvwHeTYh3&_nc_oc=AdpIsFnZQXDRIgehhYtqBEN3jIL__Ke_Zt03uL2W8bWch0OcM0O9y7f4YcNPUqu_l9I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0hV4yuyfhEZq873uIpCpQER0XMFp2FeaBQV1wLV5nFA&oe=6AE4A832"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LoZHrqH6t2IQ7kNvwFBajT0&_nc_oc=Adp0fKrUWroXNjKa3TtaRF-As5hQ8FTul3ji2EImMPkeRiVLevY4ITfNOSiiO3VW39U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUbtmpiMZnRrU3-E68SaS7-uzMSPqaRgYGSjzn_tcYtQ&oe=6AE4A1FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywk3_dPgWNgQ7kNvwGNmQxY&_nc_oc=AdoDrs5CGk_uS-ZFzey9s1b-emfnqXoDST2bhpWhn7bdKgTYHLSVabP8pRXRS0Rd5pE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQr3e_4soVpdw6OAE3kDRdKEBFMEVU-SggbDQjzuAg8w&oe=6AE4B773"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLQiHs2NKz4Q7kNvwHH3nCZ&_nc_oc=AdqkzeXGsUZUWc5E70oN3cMIoAq0HBqHA8AfBSRkgoZlaEqFTEHEySLYq4lkTgavL7M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRhETdetF1BVu9KwqY7V8bzP7MWbPld0jljF6bl_spwQ&oe=6AE4B572"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwWjS9JDLogQ7kNvwGgGMIu&_nc_oc=Adokm466Ce59xp9qU0LB1nxoX1S-MLz1ALwcX-hFWZQUJk3OByECBhhHSHs5uu5LKxE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIcmYYkYnyamKx_H56LY-z00RHC-3-qU50qrGtFQQF2g&oe=6AE4ACD3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2Zwn0XKSWgQ7kNvwH34kag&_nc_oc=AdrSFGN_y_OVv67FX7AV2ypBVBVQekZaW4-geXyfMP6-aRvCwv2_Brq5vEcUU6-DG30&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5z_WI5L0ReW3InXlPNst8sQEVLvk0gkBavNugQ9cYWw&oe=6AE4A8EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaqx-cg432UQ7kNvwEjafrS&_nc_oc=Adr4MS0qXAa03R2FUv285T7N5WOBDmF7H6v1LLOGoIyUBQ9uPA5EFuBPardhXUp4mLM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTlmxvHJsa8C1h0EO0XJ1XcUmzllF8PTrbkbJOemi5AA&oe=6AE4B4A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
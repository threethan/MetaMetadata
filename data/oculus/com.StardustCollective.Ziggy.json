://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmmOhSJ_1b0Q7kNvwG9X9Vl&_nc_oc=AdrRhxBTg2PQy9CbZ8WXjC1cP6y1lJemY03kEXXaw64VMXlTBSuhuS4o_yqVphygJZw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPjrLqXu4eiGpoj0w392vuJLI13SSfZikuDbo5RBRzCA&oe=6AA17666"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGsPdfsVQCQQ7kNvwHBH9fG&_nc_oc=Adokks4GGgVXFbUu5mQ-sRJGrnB_rVKOYez0FYst_-uxQ2qBbm57imDY6-FtQCY3elM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKr-RGEnFwGWAXXNM7wJOfqZG6SMHPLQUIoZU8mU5HCIg&oe=6AA16BB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RGtyg5CxAgQ7kNvwHFzYfJ&_nc_oc=Adqnu91u8kn5tbkfi1Y1sV8ZjXyWS1cR6LwB3KyRSh4bIcd71IbTJUM_zwZG-M4Mf7o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAYhSarO0LJxUVBi9fJKLAs3IX3g2Kr5FtnM4MuVn3TQ&oe=6AA1657B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teMlkUImr_sQ7kNvwFNe9cY&_nc_oc=Adp33cO__FdqCbkDCWOms2rWbvlVxY3c2pm1T4nRFInshloFvnDi6NZKBop9PozZtl4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKf4nu9JAlylSBeLhPEwSAACLNwjPUw8w7959sC-UX3kw&oe=6AA17AF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HysH_-3VQbUQ7kNvwEjqfuz&_nc_oc=AdpIuJLr7q_1PvOOtfGkNLAekWygxiblAmO9IlPzvj7A1dYOiCD7RrFXcyJorgs7OJU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINo1-b7W83gOO4ltlxWbQKF2g39l_l8EPUKgS4_MUdzQ&oe=6AA178F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RC8zYPYRVkQ7kNvwHt9hUD&_nc_oc=Adqxb_BfwVF-wdSQDnp3_vchbCE-kOL4KE0ByQWVpCWf32CZ5BRzZ3BPG3ZZM1agwsQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXpcTfJ95s3QUnHpXzPeJ2nDcOGl2h2fHMKYhb7gILWQ&oe=6AA17053"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oj_Mj6Ppa_wQ7kNvwHbeBqM&_nc_oc=Adpwj7SnFyZPvuzg5q-Fy0NjRCNYM3lmSLRKGTFkfwY2VvSryx05tVpdx2hBbZsNx1A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVnw76XBkIQSi0eqQ654FtXmqsQL2WdP8G9Y5hAh60BA&oe=6AA16C6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-z_7dGUoEAQ7kNvwHuAYfn&_nc_oc=AdoltE45N-hOokcI6QYL-nUj6wEoLxcW2eyxvBfFNqxwcYE0BSo1GVrwmQ8irLmIbAE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFpqn0YKAJJXB-BzT9t6MrGvyU0rBg7EkD1VtYpmhoyg&oe=6AA17822"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
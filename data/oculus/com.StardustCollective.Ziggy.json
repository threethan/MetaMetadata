://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDDX38TRq8wQ7kNvwHcFPqN&_nc_oc=AdocvCoxwcvgfFD0YDsKhsaEJAO8jE0P7PpStGDHQ5ZDrqZgmXZ913-uoxr1_OtgQjM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWJluR2vWszvI6AsNiK6LeEShvS9QDHmqxUlGDWZkq6w&oe=6A6F5D66"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-EIlQX1KSEQ7kNvwE-pLO0&_nc_oc=Adq8z_Qh3-iZ8ps26swshmxEf2zURN87Rdehsa8h_OILH8KoqHED728uGiRZInVxvm4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAT0CKKtXozGRnFhBkNYtYbrE0vm24J3ajbWZoK2Wll4Q&oe=6A6F52B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYRXUk4n5EMQ7kNvwGqD_mI&_nc_oc=AdpMcCC6P1upx_7kpBTJbsAizKz79rk9II-kRN8J5EVN3FZgiZ0NZicfERousc-G_K8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBffQTW5oqBzE_MrH7HoT6hViDYyirH4nRsvUoe5NiuMQ&oe=6A6F4C7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TN8OXaSO9twQ7kNvwFtdFUn&_nc_oc=Adppm9jKMoz8oh5hrBN1ebV5iVawOjEfQ0Pp9qJB3iegypxOXlZ-2qhWnEhTiy2Tgg0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB217_ztez7RvYgc3A6Pm--80HGxmWwdjvUDQfXlTgk_A&oe=6A6F29B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTdigYJjDjcQ7kNvwFvdH-W&_nc_oc=AdpSIpXrWokWykDSO7bD75xUiJvI9UQdgEB_onkSTHfsezMDH-q3F2Ko-q2tqh2-bT4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOkP8y7N3x9B1cXWNgQh3jf9_GBBqaSW2RuKxebPWi7Q&oe=6A6F5FF2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDA-kN5wHpwQ7kNvwE7ANXl&_nc_oc=Adp-EZDGsXBNwHsJ0UdETImSnW7UaUReK1HuzBjDtdMg8GOXBr5K1nxItowpt2fK684&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDypl3R1OiMdIPLl1gX8m8NghOqlB9mtUiukkd2mga6QA&oe=6A6F5753"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohjzD3n0tAEQ7kNvwEYkwVL&_nc_oc=Adq-h50L3IiaXyfp7Bef_bVnKeyHO71a9TW9RgTST9EK-LwzVk0pHnCOmcDd77iPjiE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAW47jt7Fi-JWcJ4HtoO9Djkju4O1gkI2Gz38U0whz8Mg&oe=6A6F536F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g57KmkVHgRYQ7kNvwHWav9r&_nc_oc=AdqeAJMpB2aWoOnL3yDNHZxQtl40XQ7DuCCp-zCAh1MNDlpCCAnhnSeOFCD7Sd47BbM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoYW1yJeO0hxSSaFsJbC2Nc-7nABi6sY9CunHztWe6pg&oe=6A6F5F22"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
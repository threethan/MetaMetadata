://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiNPnv8mPtsQ7kNvwFLeGdI&_nc_oc=AdpWJHjsVrChBdSJsQDzuwj4NANRMI2fcSXNbC5Q2VASnsF7SRudd2x_vrxnZp4UkXY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-Sx-xNvtVGQzt5K1LBCn91Z1oJ7GnPiTh0Kn3n1T0XQ&oe=6A525C66"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVjGhNz8bW4Q7kNvwELoEYn&_nc_oc=AdqGK7XKwVzGD8OzFQnFFM7WfBIcZYoxaDKM45Z4v24XGVxPO64yupacUA8KS7ikejs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBeBInBonDDJt-C2xoY0CHWYrPUi5ZN49wBFq9ckIBrw&oe=6A5251B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGu6uuTD5Q8Q7kNvwGmwN17&_nc_oc=Adol-4CIYaSN1TWmXI65Z1M_qIXJYLUbJGCnKePq1z-re83d-NsCN8zdqJRwjd8jYgc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBN3Y3w3nV8EO74n7VQY3SalTyVxr_6C3juNcpqKtsxVA&oe=6A524B7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsTqiTwGhu8Q7kNvwG0HGko&_nc_oc=AdrxKDe7XuEDg3Y6hOFhuhaGkq5godHL_KucReZ1ygMaqyKHfIxQ8UlYcUsxsnvDH5Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5JWy1GX5mhZ5E_qtMBIOf0h9PoQFFxWhSBLUopKd0fA&oe=6A5260F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m29iaNER71IQ7kNvwFb8AIf&_nc_oc=AdqMcp91udK0398470a2c8F4NAxUp6L1omEni6XYZUHYQ6W1QFdM8ae7pKRrflz_apI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2ktX5OLQ9KguFy88Bru8qQ-Vsdtyf7Y5nANv_A8eJGA&oe=6A525EF2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efb3FcGcZSwQ7kNvwFaMTBi&_nc_oc=Adox8m6kzUK4fAwGJyfddufmc31MGRRRkiDLnkGV5O26O9URdBC5i0W6SCEsHhqta-A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCM8vRQIKU6f9Q-q9A5V3mal8dNugePOjRXYYL4EI9BWQ&oe=6A525653"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPsKP0xQVe8Q7kNvwFfBF6s&_nc_oc=AdoT3GhntZvMKyD3Q8bkV7RC212gdJheBTHGTr0fX7z_7EHVW29rKTVyFZW2OkQ3ZdE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-DgpzleRjEP8cBFKci4O8VjD2PjesMcaSQwRz4f0U-w&oe=6A52526F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IebodLp0zvkQ7kNvwELmIdt&_nc_oc=AdoDLGaQZ0YEu_bbkhIfHetKqvWIhUpp3SgL3UwykrP3Z9FH-e1fYmR8wBjuQNtXiAw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSOl83D_kEBgg11J0oqjOKDAr0BMyaxyvqBjt9hV0bSQ&oe=6A525E22"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
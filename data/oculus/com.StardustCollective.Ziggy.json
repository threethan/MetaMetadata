-25/38974500_800214781605120_8880468551637015930_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_phd5AKgtCMQ7kNvwFQ8J7u&_nc_oc=AdnNcvv39ehiHVfris4zT8qaNk-TPnTdhpjpLf7k_LG6lVYGMg4AHai9h5fjd8UroPc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv9qpiSJhgzMcA4-HVici0PlfWb2hCgnQxeu4Pj3X3hxw&oe=699B09EC"}]}, "id": "1005005773748906", "locale": "en_US", "screenshots": [{"file_name": "HighresScreenshot00011.png", "id": "1326199667974786", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035386_1326199671308119_4397089309417940909_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8OcnLjhvrgQ7kNvwHhnE_m&_nc_oc=AdlSOyY5-WvVIFvc7aWJ4mm2zL_EY6Vg-0GfzRvGWwvhJ75peQCP81gciqaaKU_yLsw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfumRMIm0SP6DcY2q9GHY-KfJe7aCl-Vq1_GxN1Doz25Kg&oe=699B035E"}, {"file_name": "HighresScreenshot00028.png", "id": "2412721535575051", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974577_2412721538908384_6467288184304840049_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eef6D4EjPBQQ7kNvwH57-ee&_nc_oc=AdkRG0jpUssjt8IC57QURetZJ3oEMdaTAxfG_391V7VtIJGcJlraGMwSlmYDDcTE0EI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aftr3LToGIzA6OtElfQR06bntp961AjtgRXbXtGz4Ptjwg&oe=699B13CF"}, {"file_name": "HighresScreenshot00014.png", "id": "997351624641332", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982456_997351627974665_2778603811108028476_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojUrAV5gnSsQ7kNvwFiUwRx&_nc_oc=AdnKhVFHEbUndO7bxtIlnP5LZZtVMNI60hr-tHV_wRk4_RnRdXM8gtzhztrlOmTLWow&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsfpO_tfy5rLtyWJknWN8QiZzZL-rIxt5UquDvv5n3qJA&oe=699B06A1"}, {"file_name": "HighresScreenshot00040.png", "id": "807733037419699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984472_807733040753032_763200239777074167_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Evpv0UShgXYQ7kNvwGZ5Qh9&_nc_oc=AdlgJEx1s0J9D7aMUg8SWnxtLCUQbJPRsN9XgfjCvXc0PafvJKCObcAnVrORzKcVM-U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsrZQYJCc7NgAzlVB9qOlj0wSnFDsF1zbiARZON51H5aA&oe=699AF178"}, {"file_name": "HighresScreenshot00146.png", "id": "163970600033098", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566678_163970603366431_5435931785999963108_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORtughLsAnQQ7kNvwFQ2rLe&_nc_oc=AdltZm732VxcID4chbzcMFCl5mjxtCVMps_Buhhl_aWbNAmua0OXF8s-Bwu7uoZU2IQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuTdxh4q3UDOVWG1c0mu20-LpWA2aSnB_jJURMzlfpx6g&oe=699AF5F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6F-VfBMERloQ7kNvwF2ZvzF&_nc_oc=AdnquOuAskDXFVMar-LVFKmc8lTzhxAzwuhgmGJ6exal53WuzSUhqJdbbjgH7kR0rn4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsxvW76t4U15sWKNDydo6Dz4xSTpT_EWX4CqVUwr5g8Ug&oe=699AE632"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "1324311035174797", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984472_1324311038508130_2610060411856834928_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZVDrw7626AQ7kNvwG_sjuN&_nc_oc=Adm0B3GlG_dewxTZ4_VxVMrk60cU0W_PupqixetOYh8CIneM6-2zKHOKjvuzM_1bA0c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft7EaW4kufZPYwQ-J2fU7uGk0kx8bXiT6eyL39WbQiPmA&oe=699B1738"}, {"file_name": "CoverImage_Portrait.png", "id": "1021944422558335", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031612_1021944425891668_3460677483354056217_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pyu0ojg2pEEQ7kNvwGYWk8V&_nc_oc=AdmK4pj3sBq9xT4ecW45ABAkMWNb0is-LHliQXlP11AgeEnTPaaqf4EgYS6TT6oQEuk&_nc_zt=3&_n
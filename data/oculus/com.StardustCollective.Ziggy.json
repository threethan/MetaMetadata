297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJIw57yLoUAQ7kNvwFfzKu4&_nc_oc=AdlaFQWIEs-2AKDHip78PJbjJNzePzx94PR3lCReNQbWtILNoITVlzfsqZg4cfaeJZc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwxGGvpG5UzHfesqKCytZGCI-4Tgo96GDgu3g7mwCevHg&oe=69BD2AA6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23F4_WpeSZoQ7kNvwHz9Hsc&_nc_oc=AdkP8GChSd0wNfF6xhdoZ9TP7pgnzMg85Y8JQRMj6-wgmhj0E6zC-4U3WFOnH4lHcaM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyv9hwMMowOJLZ5mmjIXHe7z4BMgiW41YYKy1YNg6I2Dg&oe=69BD5832"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXTZXMoYIIcQ7kNvwGspvFe&_nc_oc=AdkCHaJ_Zv5BUr4U_BY3wOeEU_cQN7dmiH8ZLlDdKvYZZEEJDXe_mScJDiY4ONQJ4po&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8ff7X9lNNiQWlSubzlUedb63Kajo71ZIB6WeXgQkGsg&oe=69BD51FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2JZKGhomU0Q7kNvwEuHIBk&_nc_oc=AdmIeLBdR7FSzXXRJbFwnVtKunH9Pz1HDc9q07uCy-3z8l1pC3PDOtiI2lixmdKTd7c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxNZ9mrKnP0I2Fx7j4yc7Vn4F5rW2uOOThsD2jCqAYfIg&oe=69BD2F33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkdF_b1gRgUQ7kNvwE6Y4W_&_nc_oc=AdlAGy6oPneXrhAuJ6TboHPmhmCAUKmoXuHLu31M7R7gMx5qv2b7_iSfnDJ8ar2_t7g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyTLjUIpJfPe3QT2EkwynTUlrxB9KuySTknRHol4KnuFA&oe=69BD2D32"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyonzzBKVNQQ7kNvwE_ce-k&_nc_oc=AdkIqkZ9OTnrYMEvfLWIXEF9e52G4SLtdIifmID1PlFa37so2UjW-dcQnFEQRFY5Zps&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxwnI1PFrEdW962eFQDAS8INDkGYoaIdwxBmbXQ2xlgGA&oe=69BD5CD3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QK7bockyLEAQ7kNvwEZBX-P&_nc_oc=Adn0D499ZEwgOhe-DinRzn6Rf9JLg80Of9fjcTA9oqJrGBLnPFrj9QQFec9KlbseFzc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-0z-Nt2kamiM9Bz4_xLqnYf7cc-7dDkv2nsu8rkFzSg&oe=69BD58EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8x4udWwTXOMQ7kNvwEfp313&_nc_oc=AdmuVHQP1QV7IusKpW08E-VbllvZ3Cf0UlwmWa1OI9yNVeJVZXP5A8sEJCJ70ametoo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwc7Kdhuogpt_z0sGVKvanklbt2Wzg326mcdPUGuKj6Vg&oe=69BD2C62"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_5218087471640407679_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Zc1J5VHLtoQ7kNvwGAeGXq&_nc
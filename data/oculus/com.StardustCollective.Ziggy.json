t=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwml4hyRXSzs9z79uvxD0F2rJZlmq-Uu8KuMw0j0HHe0Q&oe=69AC2A21"}, {"file_name": "HighresScreenshot00040.png", "id": "807733037419699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984472_807733040753032_763200239777074167_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGgu9opZZokQ7kNvwGTEGKm&_nc_oc=AdkSacPtL_gvNtskG_ojk7CTGQK2uPbBgO3sYfLfH4Q1D77oX635r-IuFdPclu0ih5g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxTgz1l5UG9pwDCjEXjsSWyY-n2ukSv8BxHs-PFgrw_Pg&oe=69AC14F8"}, {"file_name": "HighresScreenshot00146.png", "id": "163970600033098", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566678_163970603366431_5435931785999963108_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2iKElSCFqF4Q7kNvwHWxuG3&_nc_oc=AdmalnEXwdIgP9gRA95s-IaPC-bjPTvyBaa2c5GeARcKFDFZqIKVU9rfz8adYrHcrdM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxiSa1YisqfvHkS1zbdUdfN2m7CeOV_NN-gFZHwpL2Xgw&oe=69AC1971"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pB6blBMFjhkQ7kNvwFjgUF4&_nc_oc=AdlY4F6Wb0gJBy3OBveIc0cDYHZisEw3QlRxnh1zAdrgMTWAv-2KNLnCxKi4XJWHPZk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzQTyCQQhIBNJsLAkPqcAr0o3z77k4mxLwCEvZ2uUxqPg&oe=69AC09B2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "1324311035174797", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984472_1324311038508130_2610060411856834928_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDFMrsFLWZcQ7kNvwFEVn6G&_nc_oc=AdlmRP59GHIWJVqHVV091xAMJe9rIPjC4J0iuqBR894rr7yf3qotmdC1lB671S8HFqQ&_nc_zt=3&_nc_ht=scontent-ord5-1.ocul
://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1CfSDA9w74Q7kNvwH2Ttbq&_nc_oc=AdppeOGSICQClANe8uVVBoXJdL5FbwDIUo_od7oLLVmpS5KHldhPquke5_oIF6kxPWQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FK-29DIcWWS-EwSdswazaIUS2IKayZNlB7ajkvt_XOQ&oe=6A204366"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBgILoPbA44Q7kNvwGUeyJR&_nc_oc=AdoFGIrSpLUzCIwLSzERjoYPL97sl2NQSjfYvcwew4vpq9qh_KCoeRoOiiZLMnLdMno&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tXMyHqs4ylLZtIV1XKwbN4FjrvZU-rj5j1T5rOiQG8Q&oe=6A2038B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGxALAdyLvcQ7kNvwGbAwJJ&_nc_oc=AdpwL6zGh8okz2J6hQJRxTpLwIHCJPCAfyhcL0H_epCPOhBrFGvBNU5CZhOrl6B7sQY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4e0KzFyTDjGzB0gd1FB5Qt-88RZkTEM_0EJD966ehAuw&oe=6A20327B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edsVGq0vqecQ7kNvwFmnkS8&_nc_oc=Adped7rUg42xlZGmxwT18A3Cs_pIWvmTblXy0PYhtr0P2pNHPmrqxHKIrIYhO7Koz48&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OzI5ifMBzO9mo4HlJMJeTrK_bJfM95KvMUnpnan4wJA&oe=6A2047F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTNKCj5zsscQ7kNvwGOS4gM&_nc_oc=AdraF_Uq2df5ME9HffGxZ_JCecZvKDy6VKWXxoWa_pW7iRvLqz-v4mhYwWMo6dh9hG0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZAuHpXcT605qFRdu1sW7AfLqXhWOzlkEOHxMYw_h5Ew&oe=6A2045F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R647fDtS5zwQ7kNvwGCmSpU&_nc_oc=AdrVFHVvsJnx-LZB0HNLllPI--12NoQ49h0IjPhvAYao6wQsMN5SpKut4lm8jYpsBuQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58k77a1Qi2AX62Ui0xX0aoD_LKPk6-Y_7WKsACXcTHlA&oe=6A203D53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2PxylizDCEQ7kNvwF85yAu&_nc_oc=AdplwE7lspV-7RMBKYYHWMQpwIgAtsJ6ygtJ59j2pGd-rVrjZVOBZmaXYTXRsFcM9hA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oH9We-kbJwsKgyLADLuYrs4UN7kUtk-v2Lhe2uEWQUA&oe=6A20396F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1Lpoj-eucUQ7kNvwFjKJ3B&_nc_oc=Adoco9Q9nK94dwi1M_QEdEtZV2MrwExjMytMaRuVcN3lv2WECHOeAAaqLiIesLDSvO8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dXKUPQxIRFn7s1A8vY9O5hsaQ2QydKfwDtfMI_avxmQ&oe=6A204522"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
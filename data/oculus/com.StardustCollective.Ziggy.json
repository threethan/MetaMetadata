://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iOouwm4DOEQ7kNvwFWvcPV&_nc_oc=AdpqCnsRvDKKE-AjXJu1sjNrkY43t4WsVEyuE63BZizJdO46MyM9-0FcsS8tf03lyZ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sdIW2WZbKKyui9Z9J3M7xfOUquPBwACiOfbnFj54tZw&oe=6A258966"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBNcUhc0RhwQ7kNvwFQvmka&_nc_oc=AdquZfyXKG77ZVCv4dmc60moWJBD1i1xhmYBG38rSp9kriLdMh43JQ1ojp8lxV6ESzo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8byGmJUipd0UofgjxdDDHPqzH15k69ymiHqBeEA1CJ2Q&oe=6A257EB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0wwCoFS0vgQ7kNvwHq3WGc&_nc_oc=Ado49flBt9TOBWNazwhgveWkCaGEUuquYuE2wLoIn1m8yTS1Q1v9aQV94m5-o-y1tmU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9d7dFd-K-i1navWout3zGAac95rl48-guaxbPVhTdljA&oe=6A25787B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qP8QH7sF2oQ7kNvwGbpI9S&_nc_oc=AdqImTUjc66i8cYVLLHrVwMk1kxUmyTqwgwU7R4hMmhMV_wZcb3ofWiEHW1KzTnaD98&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89g01T6EwWUcPl2HOPTFtMNSimLU82sHoB-9rMIgI3dQ&oe=6A258DF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NISfU9rDmLQQ7kNvwFtqWZa&_nc_oc=Adqg8EjVjapFiAWtbOjTXVfz_GCSrVw69NLWG5NDnYKE4a2EJA_bOefOixWhJvubgS0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fVd5Dlx_Pwn88sGJA-kWMN_FgRfSMZjo8-1RpM2a1Ig&oe=6A258BF2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wjlx6RLrH0EQ7kNvwElMwmi&_nc_oc=AdoC-mdc0dqkkzy_1m83jQODU1I1-VlViQIYXQjkhDPRqaSRqPQzotDHEacy8S7Y1EI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-B3IKBAw6SBcrF59DdnEYqoYNJEK5E1Nc-vifdnBK9oQ&oe=6A258353"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ki9hMcdvfdoQ7kNvwHR5UOw&_nc_oc=AdpSX2JJ-ApeujerquMTjMNWj7evinbntsFf8IRL9iUYArdwELZvX__D7VjJZKbSYpk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4H4neLEDy1y_5kfDO1i31m26m18KYG72ntAAn3VoOpA&oe=6A257F6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zRcX_NqFg4Q7kNvwFiR6ZD&_nc_oc=AdomQQR5dNE1nZfHSKqencYfY2D8Z0mZCBpnljlPQsuutsO1amrrqnFCrBS33nq6MlY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DZaVHMfgUa7XnTxRU0BLTJfk2jQwchX3QOBb8pJacHQ&oe=6A258B22"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
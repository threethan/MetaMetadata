://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__Ie2crSSA4Q7kNvwGwdAnD&_nc_oc=Adq865rVdfPMKVNwgOM2ZMSJMd3sNNj-9KQaSlom8jkwm8he75tEgC7XV-yNc2wFwFA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwRaFk4uW2WH_gwW8CiURliQaZE8OU51f-Vvoukc8aUIA&oe=69C270A6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdOP3Z9fT2cQ7kNvwHYRIfT&_nc_oc=Adoc94eZFMdn8AoJh7eNe0fZlK4e4IS6DbGCrGg0MAv_F2XFRp6fB0OqvgngDYCbepc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxqO1Bug6nSy4nNh6aRvoTa6ruhRceS_h4G1SfdKnPcOg&oe=69C29E32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aldJuxzDIcQ7kNvwH27p39&_nc_oc=Adryji5RizZ_Ts9Mv0jdKSZl9NqZh_CIINqHVaHqjeK-Zf3y91W_OPX_VnDGJu2rpoU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxvGrtySMNO8xvR1zP2YFjwmWKgZiZeXRF_9Fp0c0cUMQ&oe=69C297FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_o00Yl86SrkQ7kNvwGsuY5X&_nc_oc=AdoHaUPHnM7a5i1n_FIbcd7h9ygyp2IgXGapG9JN2l19Zat7BOYna6381GY4miWVBwg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwIzXu3iGUVrxFbUisHs9glPIbwCM0Hfd6J08wjhXBm3A&oe=69C27533"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKETgkPLEuAQ7kNvwEanLc0&_nc_oc=AdoXenn73DB-fvi5ctJq22PErLl34GCzPrwPyZ40CbWDS6uN9LFayW7Yk5-POj9TOE8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyg14DcwiZEUzUftTm3ocGQwRETrgE8u_4WrhFXNhWP1g&oe=69C27332"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oor_MplDE4QQ7kNvwF9IvH5&_nc_oc=AdqSiOqs7SsynF6zcDxA-minkJZEd7YIuk6z9JKqfZlvDFqd8-pNAGlkAgAwD16r3kY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwf35HsiC4Nu1gHHTibXHstN5KQPCCJ5XQqLGS2TMUTNQ&oe=69C26A93"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3imNgL93vjsQ7kNvwF-Xtb0&_nc_oc=Adp7J9XZdWuwa7LMXU0EE2YE_QZRV4okHpIvEcLo8vaW-YTFNGZbRPCanjtWGn3sqtM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyCaAJNjg_Wdnx10X_nen5Xch_g-xTRnGSJCANfX4uUfw&oe=69C29EEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dx4AL9ijJZcQ7kNvwHs3S6I&_nc_oc=AdoSOduI5HH95asbXX-yTxmQFjTQJFLh7eGJCbL-0v3WoYvasXSMvXiDMz3QpLcDyak&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzcMNdK37d9EcRDlLuc1W-XowP3h1Zk8281jqWO7C1wfg&oe=69C27262"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
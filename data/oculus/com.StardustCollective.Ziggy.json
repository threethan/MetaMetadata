://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SY4gFd4euzQQ7kNvwEwt1tw&_nc_oc=AdpngQJx_NERpz7a3KdQg8Ix6BpQqUdrfKkgXmq0LM7zQzsKWos5yRf5V_XWzMavWNc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSm1x24U08wRz6t9HUKUdsdKupeZglKYoHbsOoz0rCoBg&oe=6AEC9BE6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZFDya7iyxkQ7kNvwF48Bgm&_nc_oc=Adok8nRizWiOpwmlfUfY3I46XMQd0AUo_vfNvZYiSbbPqB91wWu2hY6OIEzre4cXK1k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMtiamQyDNjY8ReNYqilKxUhXUb76NjNRpOLNpEQ46_A&oe=6AEC9132"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAiy-VU3YsQQ7kNvwGYwBfi&_nc_oc=AdrHUzxhvauZzGqjE_5Ttf9giwQ7uLzaoOU8QOa7LV8KA5r8_GNUJw1yjqhoT_PUYWc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3T7WxD6Riy-x9ESdbVZ5419eNgjcVuZ1fhYHxS1Jdrw&oe=6AEC8AFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CvF8UiU18o8Q7kNvwGCsuc-&_nc_oc=AdqFw3596EWfBdgDZpdbP35aJq9R7KVvHnscYfK3NiD-cHJsvcvy0xQ1j30Zyvpv0zg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPtMoZId2d4bL2psSqW8JGdxRvQYcWkv3ljMvy_vz_2Q&oe=6AECA073"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vntvolyDIcoQ7kNvwEtN9Fr&_nc_oc=Adr2LSoCgrmQ3CJvjUG7kyvuA1crSeBxvQVNYq-_IlA14m8NCipkV0ZCdjxFu_3w1fw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTL75v0ORI3a0WUJP9sub4Ou3r2oJCC3vIzK11j_FKfGA&oe=6AEC9E72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfQr37NojzwQ7kNvwFvCSod&_nc_oc=Adq8-W4yqZWeU2TQOfDjy0igOHreBdYt5T-j2mSYqkfaoL0OaA86ippgMe8OS2JJ1io&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp3QLe-ReLX0moRNHeNn8d21yQvlez9j35FyI7Y2vMZQ&oe=6AEC95D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfzZlzr05NoQ7kNvwFpwZCL&_nc_oc=Adqr9pFaSlySqIUpSTPSTNgz7b1TKGTU2QlynkCWVmZeGSlQauLgEFVg_9XD1vLwlHA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-gFMSPtrWd18wi8bA6AuPzPPsixakep0pDVkjEYzczA&oe=6AEC91EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIhZLsJJPQAQ7kNvwHCdEQJ&_nc_oc=Adpih-ve2RBKqUQ5CtsHHESX4n6hTHd_lNczbrCBSVNOlqezZcMqoaPKTRJ32Jgj-Lw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT430wrtYoyFQFf7lvJqd9O95tLzUx2o1ylXNneyMZWXA&oe=6AEC9DA2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feVB6urHA14Q7kNvwFuTRWx&_nc_oc=Adq0i14FcqhLMBBIzaKAeqvCHhwX87LNTBiQDH0Kmaq_Lhd65gn5XqQhKWJqpnHrjtE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YZRUuY2KVl2ucyOP8abnl2C6_gaXOsPKzQZk-BBCs0Q&oe=69E0FB66"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dculky-qumIQ7kNvwFq4R5c&_nc_oc=AdqTjp2wXv6JNUrEez8g1EgpmwVO0VIKvbOGjrBn5jyjdeOXefTq8T_RrT9aciVEGP8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24Jr2vjQXYkpVJ9FEyYu7N4LeJ8Y5zzVgKhKyJg9RI9w&oe=69E0F0B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Veomvi6MtyEQ7kNvwF14dLM&_nc_oc=Adqb7HOGyrpM4F6VeE0W4bYKmsvaOichNfDpEcNozs84ItJGZgq2UEamzUamXSZLuBg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MuisFKwH2Os1ecybUANse9heWLFZSMqRKQAG74kEMSw&oe=69E0EA7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrhyzrJvuLwQ7kNvwHg0Agt&_nc_oc=AdqLvbNSIZYkI9Vgob2NTj_joGC2tA3JHHSi32NGCWGnP4R7F0genOhhpvvYutCOd8o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dQtrV_TYbBfUG4Y8FAAn3m4f-ATRO7W-_nnoGaEVDcg&oe=69E0FFF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3h4XAkx9Z0Q7kNvwEBxs_4&_nc_oc=AdqqdZBW6UpGk78gZ0Fv2ZPR6JpgpHaVbUH1ZQ9p_wM_h07KxC2e22sfk6XXxWF2k5I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wN7_jryCBnoGYYumOWLlTIInx8GUVAnaMPts96tf6Ag&oe=69E0FDF2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQRhLi_Y798Q7kNvwFNC0yc&_nc_oc=AdrAnJXcZQRbZnqwDdfVBX_o95ACBUmJnFbuMqrsY-HCBvC77DM0nc71Cltq0YTbJ1s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jzKckDq7CDHQw5vE81FbVmR3XBnl_r8PV27Ag72x_YQ&oe=69E0F553"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0GxSF5nMr0Q7kNvwEQsyCK&_nc_oc=AdotKVzEH8MNthU1pV14iEl0z6cJAkooOdcJt4UHx4fBRO9yr0vKAYnCbrBjk_60w4Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fdxo52SjatJIyz9zNk384sgoNcFioRg1X8LffBKkIvA&oe=69E0F16F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFWtOxiG5mYQ7kNvwGVYtEn&_nc_oc=AdpD9oK3Q6EcDGasNYNH7AZSUtR_5YAi0SiqOhn8Aqv-m5i-ZIvkfAQBpHyyH9rkrLg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WY0DuuTGE6puVpa96TGvtmhSBVVPwrNLw8rzjS7dWbw&oe=69E0FD22"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gy1Y35qYGTgQ7kNvwENzW9d&_nc_oc=AdkWHyHAPul-aLi25CczI_Wd72epQXKXZNXuL1GknyXTX_Nk-WUeV6cgVJmrx_cvjkY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxIe0RFHplZFimAtgYrHuZSzFbPIE--vefaW31oC-G-ow&oe=69AFFBA6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38C9jselHLEQ7kNvwFpwZ_Y&_nc_oc=AdkBrpOMJvpDY0XwZdWVS6iPqHYR7KJt4JXNRRNP_p3fWhYr4teVQOeoVGGXY_BEB9Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyv8sPY-lzZGPWki0Kndr-t_7azU8EMVOps1f6pcEGSxw&oe=69B02932"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_kDmJaw7wQQ7kNvwEGz8qs&_nc_oc=Adn_2PLyywiGHztTo0AQxTeWds8Ez4UCS4o498MLI7kYda-nyvq1IN6VubfCcM6xvNE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8iK1D9sAg7cSZ9pphUOs9WvZgEF95plQ1UA024ca7jA&oe=69B022FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sr2Wh6zvpXwQ7kNvwHSXVFW&_nc_oc=AdkC-Do1HKPjaFn0RqafxqCfxpF6MALsnu4wVG7dyuCOMqDCHuC6eSdv0SJXE5ajJ7k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzsur3cluKP6iHxwn0Xp55jxRKTyTfWvsnSch2MIFK7Kw&oe=69B00033"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRYVlzmWzN8Q7kNvwGlhnTn&_nc_oc=Admgi9BklwFMUuJI19YlHUrhKw-GluLI0Rf7BJ690EnFEwLAGxr6QA7VQyr1kwRbpBU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyAtZWNd1IFEgnjx3172Hj5sXigFtpg7OpdR4Tbwn5Kuw&oe=69AFFE32"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyvND0Hp5sMQ7kNvwHUH1JM&_nc_oc=AdloJ9ZCDXmw4ltBJNBJlg5qiR-Kv63Tu4YhfQaqwTjMpRjc6OuxrQ8_qyTj1O16FAg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afygi6wdz1Rk2OS5S44TyZ6wzdJB5VONeSUNy8ULRhkmHQ&oe=69AFF593"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9V81JT5h8fkQ7kNvwEzOORQ&_nc_oc=AdkAuXFAPvR-bOH3bUkbbi0cgxVmkxnJVUyjK6JeHd_cKpZCtu4YZ2G6Guf5Fku5JGY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwvS7xVMkO5DCIXW_Z7p4q5YLrsOi63F734R3DlCcbIXA&oe=69B029EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGxKqlW0mPoQ7kNvwGm8_sI&_nc_oc=AdmUv-h_mtbViN0CwDMHvyrFMo5nVgMGgd_PyiYn2_oyU1cb_TN5fErTOBdbAb76x4k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3y4iQg5NxebNZ7su6Vkg1RURe8_38WbElkO9vhbf_Nw&oe=69AFFD62"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_5218087471640407679_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0evlyoZRsjAQ7kNvwGClTmQ&_nc
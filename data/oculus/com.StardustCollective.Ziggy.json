://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9ZwWfcHcbQQ7kNvwErvxP3&_nc_oc=AdpFXctlKtp-cbqfmgjCPwkPGdPFBweHK41WiMu7lKEXLWpdgPzZe-zAFo0zLDpuwIg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJR-NUk98nPrMnoRvPhXdITZiSWJMCUa9MAsVrpVhVyw&oe=6ABE7766"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCHJFqYVXjEQ7kNvwFGqVOE&_nc_oc=Adp1GwKzOy2niuAyVMYgQEkkdBG5z3I1NNOyWJNm5tAkQuTZzHnRcXSgEY2vQ5JQeWQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9MGXhdK-QAIPqWy4rOA_z80arjKFN5tcUVdrylOZx5A&oe=6ABE6CB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KavXWznbi7wQ7kNvwGn5Pr-&_nc_oc=Ado-9kwBaSgdSibJT0GamLW6pFvQsXt44vHoI22eX8oX4fgxVkx07cAb2qU32DH-KsQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaTkp7Kgfx7IplxaWF4Ukf0TMWYbzUjt3I5tzYt0paCA&oe=6ABE667B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBuCLL5Ko0oQ7kNvwF107Cf&_nc_oc=AdqYz2FZvWQ1GDGYpNrHG6kWb4iCKD4JbGh562feqSNDhn-r3Y8go-Fu7jYmYnWsrqA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8YgJlBaXAMFpFe3CkAz2t_zIuKWu79CeGQGqPhXFzdg&oe=6ABE7BF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXBi9eK-2D4Q7kNvwHNHNNS&_nc_oc=AdppsLEWTarJEfzn5xaFlFbTd1id-b-UwxRcURnvSme9Alcq6Lda3hz1Mqotenn0Otw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxIbIKHrZeXY0IfqSRa256ohX5VvzFPQr5dIOsHczNsw&oe=6ABE79F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uO9M6mgKzNkQ7kNvwGEMfD0&_nc_oc=AdpuVf_1tugs6xQ9BE33rfCei_qMsB2PZTfPVmALtlyi-vtAp7MRya2xqzEtmIFX3bA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIv3V1K3N9c58eYOpvOyo8skqeumGp5cxDHK81PUTDwbQ&oe=6ABE7153"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wg2nHFPEhhEQ7kNvwG8cVoR&_nc_oc=Adom1GBSy2cM_fruHjwY6i1FuqIzzRGFokfEwhcS4n4m1RUxTGKZn_m8jgWFwS8QxGs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOhJEN5KkF3-Rc_Kp2uOz1OjK4C63IjVPASehU-cAw8Q&oe=6ABE6D6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfCn015q-q8Q7kNvwHXbFeS&_nc_oc=AdoxVoEx2zQkYK2PUt8QtIPzmwZA7Oi79TsSNQRwPXYzFmWzIquIZpqS6NVh-YcAO-k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeOxQ4_dkNYx8KiRlBkg0B7vkrvU7A04aLr2n2_dKceA&oe=6ABE7922"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
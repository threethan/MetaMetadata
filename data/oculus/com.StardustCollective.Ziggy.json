://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1CfSDA9w74Q7kNvwF--hUc&_nc_oc=AdpYWmjAc_CRK_lwPFElm2v_U4xC9kTiIsMqNnsWJ2z1UQejIrvSgUsvDW6_BF3eCzc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hhb4QZUSJ9g4TSyzbO1j1ngez_lY8oPYkd3Q42s6hSA&oe=6A1DA066"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBgILoPbA44Q7kNvwE-Hq1Z&_nc_oc=AdqAfXPTSmHRERZ637EzCs6liYD_DoB8QTZ2mWyvyJPgrYeTK4pNtZwTOVXeAIuwrmU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NKZmG9b8it2yqjJjhadjgDVb7aCJjdhk6Ed6kZmGSxg&oe=6A1D95B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGxALAdyLvcQ7kNvwF-BvNg&_nc_oc=Adptpxx3LVQwE1RJkntHP5_L16u287S3UCdrUv60mAGT8HNVz0GBHJvzbfQPJTqwJmQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vQIRW6Fyt5BN7I6t9Ybu1VbxLeuijzVuMgxC7f7Zwtw&oe=6A1D8F7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YaIBhnGYVMQ7kNvwGE8t_o&_nc_oc=AdoHVfQYBK90FddIg349lFEHoS8uhTnHomr66ISicjP1FXAfDAbhwyw-3dS1eqTjXeU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qpimak-lFmV-FveGkEbWLIpyZWyTZwg-qY9SQMXfldw&oe=6A1DA4F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_bgjQ-UmV0Q7kNvwHLN2IV&_nc_oc=AdoJHQIAllsWKrEKkOORAvJTJlSDHNmIqcDbsg2PxdE3FsCnAE4Ih2s8uQZv1OrOCD8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UF2PivCrQE11RWj4TtJS0VCdn8gW5zviAL7PiyeIY-A&oe=6A1DA2F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R647fDtS5zwQ7kNvwG3rdOv&_nc_oc=Adqi5QyehWF5YjXCEjt3KItdgTh6n7obn5G5b--GyBD9PaK0YspfNmGPnj33okidAgU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oFWHJg5_9ILYsZKWfDkbu5eXExCrEdC9FfEqqXImdVw&oe=6A1D9A53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoeC19QD5roQ7kNvwHTXF4P&_nc_oc=AdpxFrWmrrlcX-408_JwiR0n9RWYtgvnxlFScAAyWLeh1l4IIJcdwjXI7rneKtGwMKY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jfJgLbnVuQd-Qgp--JiURxb-GaXUNz4YDV7MR-foXVw&oe=6A1D966F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLqXoDChmZAQ7kNvwGkI4HY&_nc_oc=Adr8rrEl3xyS_URNL_v6PgBQ0SUAQSXmsxehKFv-qlO92Q-9i5yXoHkPACGIiG8kJow&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mEkGyJG-D0X4YExY1acUt1O4LSDcxY4H7vNpBHTHNyw&oe=6A1DA222"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
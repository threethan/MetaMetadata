://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LopokHCA9KEQ7kNvwHER3y_&_nc_oc=Adq8hB-rF2euTYC1CCoYYZo8ieBdqhc6rdGUddHdATDfobWbYDVRoz6JwwYA7TezuiA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQ-Scaz9wYjOKOx813XBYk9kEprB_gIFAdNbIZc1lK4A&oe=6AA6BC66"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJZOq8aa-2gQ7kNvwFk4lqV&_nc_oc=AdqRxOgdnBQHJoBFNbhKjT1hQomQc3FWi5cydlX06vx2vLsdT9sOrk8d3oaSohb8Pz4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWtswWIfAdMS2WvSYw_KH7PLzhiExJMytxpZX30qsBRA&oe=6AA6B1B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ic0g2C8pDvcQ7kNvwG0wL8K&_nc_oc=Adoik0_svCcfWVEdT5zU7hQ4x0e42M1Zl1tCxsh4jZSTRd7O9TkUGw0Ce3RdKG4rS7g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIvPobZYaZ8zu97fNTo9ssv0b0eyxOYxj4WWx81lGH0Q&oe=6AA6AB7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izK3hvkbFXcQ7kNvwGifNo5&_nc_oc=Adr3gXUGxon9k0BY_4aKTvbKasTXd64I1LzYZO7Wf28gUMxhK1eeCFnvnqaEAQ0FGnA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIR8Wt88oTKug9cPo6P7Y3xtI6_Gtu-WJTZV4mZTMXLpQ&oe=6AA6C0F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ig4NtRkYxHgQ7kNvwGvUQ9n&_nc_oc=AdpcqPXv9iP_0pM13892iaoKHuWuNorXSNeRidmmBAvgt8P-8HPzacoaJzlmSOqNF7E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaZVlYzzX-Uw75fI6BNOPNspr8RwsSrKDQr_1-_errVQ&oe=6AA6BEF2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bliSWWWVDuwQ7kNvwEaADNT&_nc_oc=Adr3-bxzA61xgKkyegp2nZEtcbTS8sbmXVUxKpscJFWcyzea_5zn12Hf8pD03KGI_Pk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrsTlIh5IvqCmm8V8PNSJ6Igo3BOGqqpGFnREzfK0UZA&oe=6AA6B653"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVHJMU1iA-YQ7kNvwE5MyWI&_nc_oc=Adqft-RQzu_oQA6puOaXnmdRfq_-S9BRif0A74so15eJ8tSbiiNpJm2PlOziz1uuUNo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLISFfdj_kB9PZ7SRkla_Ml8TogmSUvGl0b09Uiy18kJQ&oe=6AA6B26F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucW-tXt8GjEQ7kNvwGYsf1Q&_nc_oc=AdoRQRoMHsMSE-gH9dH8_ChRYJnFkNqzcK8oPZnhEGdfRYUtbeNIyGQWgFqs6tC694w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLntlhHOEO5wSKP-jLVXuJ7LbHhhzs9b3_c2gG0yC5wjQ&oe=6AA6BE22"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
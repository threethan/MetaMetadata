://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9ZwWfcHcbQQ7kNvwFuUwu-&_nc_oc=AdrkosKn5ofDBdksG6ZkmXw0hhPmpDWuipaCNAfBCrYjJvfV61Y59VqbAikq0wdpUmc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8g44MBFOt6d562qxGkNUoa5upMxws-Gauj6u6LSGhrA&oe=6ABBD466"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCHJFqYVXjEQ7kNvwEjtUSJ&_nc_oc=AdpwcY4E_xmceF9qvb1esnpqRwyj3RMf18VBsXeCutUJzZ4n89Pkih2Y4pyVVvwb6OM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKurlCucloQXNoxp2gWkGQm-DF37bOfCt3VfbIYZXhqPw&oe=6ABBC9B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KavXWznbi7wQ7kNvwF5q8U_&_nc_oc=AdpJFGhiaeu34uvaYDOEJMXdV3-zIQl1SIKIbLyHrS_L_WoqrFQ3emXsnyP8EMpGYas&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjcI2f9MFxzlBN6jBJK212LlcNEheWhy5Xnfei4ixLDw&oe=6ABBC37B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPZy-u_bssQQ7kNvwF1zGz8&_nc_oc=Adp1FaGxUTvfKYQ2-ZdwALspjGhtjwOPE2SEoCSbbF75mit8TIWxgt8T6RwjGikTM1I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLS7osfq0B7c3dwJa0m_9sX5CzqjOdFQ_Q9j0sS79FEgA&oe=6ABBD8F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJ64gWYP2VgQ7kNvwFWmFnH&_nc_oc=AdqQx3NkRrqKEGpY10SNZsWJSDeUGV6IhbFVZWEJm03uUD8IFV4UaujCBjrODaf5L28&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi6nMly0XJHgagLGZHkZg44325GFKMetM2kpKvpp8o0A&oe=6ABBD6F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uO9M6mgKzNkQ7kNvwEJymTx&_nc_oc=Ado05jrsf1oOHg3nlJNAdxAoW2bdTtEW48lv4xyHyhtajVZoGQGZEc2EIWOcJOdGVh8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInDwmONAb9IDo4GeOp8XStO3u2DS06zsxKg3RuWSN3hg&oe=6ABBCE53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5w9FNcOZyHMQ7kNvwFM9FyJ&_nc_oc=AdpK-AZt3WCOV0pMlYXCCU9G_CuhwpmnFLiKO1J2erjZUrMefPHJcnGvz4hKZimz1eM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFK-KBOcLewSVwOUavJ7TGQf9axP9h2dPTAKWEGoTMMQ&oe=6ABBCA6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTs9ctW2HgoQ7kNvwHUeJ3_&_nc_oc=AdpGHE75Sf8jQDelBKHKP_KHMgvh1NFiBRCGY43DOmJIEp79WhrIL413U7JQJhtHb8Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6vdS9vyZvuZG6pr9knEECCEqXJMEXn-rsuEz-8ORaMg&oe=6ABBD622"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
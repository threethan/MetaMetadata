://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W633f0qsrjQQ7kNvwF3xTaI&_nc_oc=AdpeupbRYn4TUd8B8atlrgXhCzUBrYXNuIkr01tzzZOUsshJT1IqArp25YH_BnHxCYA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGB52Fli8x6x5ahMZJc_ZDGYQ9FCXKN5-lfafQuf201w&oe=6AC90366"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfboocHpKtMQ7kNvwEfPo4y&_nc_oc=AdpOivMLmKB9rrwbTAXKROs7nV-PQnubTFXm5dN9SSWyJLjWaQDPDzVN8xgk21WejvE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrsS79R4kz9AxRCmiIlD7_HD0pUrTUS-Pb8CzMIynkQQ&oe=6AC8F8B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlMAURGTep0Q7kNvwE4XfDA&_nc_oc=AdpfVZguLl6PaSQlRz_KeAdsjWW7CaMz8nbnbecZC8fiRiEAC_Hfg7uTz-Wkh63QFZ4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPabpk1TW7CDwfpRQiuB7SICayCYIVFM7fPLH8PujEFQ&oe=6AC8F27B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_MpNAe_rycQ7kNvwEnfsx1&_nc_oc=Adr1Wd1PDdDOkjBAbDS4OHRkTmd9-jNKe5oSZW9ajA7hKxrZgGO6ZUZ8jc-nFFQPiAg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTx5DRcgQx8hwcq7crV_oSUekX8YehHDoW9nOvm5RekA&oe=6AC907F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMarFGWl20kQ7kNvwFZTvqv&_nc_oc=AdrRSrAHgxWfSua1m9mEQOlpNtiXXV6NP3cOK5UHrVAOd-iZ-_xs1fDlIcwiu91w2_c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMt0kMGgM0IXRQdpe9o0R6V8nqz44KJ4inMKuMkc3U0yQ&oe=6AC905F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPr__UsGfFwQ7kNvwGfbPv9&_nc_oc=AdpOt8_Vj4H9xMDRXBRp3R5Z7URpQuLdpZmxvh_Xg_aplv72RLK-Dc4muLfveC1Ehe8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsrzEtuPOyQglbijXpMtoAGpYc-WI89tbmYSHpxp6rmA&oe=6AC8FD53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDjPR2LTliwQ7kNvwGGSGzE&_nc_oc=Adpe2kjGuDb5nTrM5uKdcHDj3Il--peCGoOLUfc7XyEH1Ibv_Soczq3ERJuI9mJFbys&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwQQDBLVY2I8Fm06AW354bOwmfrhlJMP5z3C9lIGpmnQ&oe=6AC8F96F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kKsQLFQofAQ7kNvwFa8Zuv&_nc_oc=AdoXVchY2qoF_0FP0OR2deSNIKe5gOXHUq85lt1xWcDCOSjR3zTpAIJ6BxAl33uj8fw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXPY-ZYOzJyP1MpntYzUHcCLVL1RYQ7lGeNzhGnHnh6g&oe=6AC90522"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
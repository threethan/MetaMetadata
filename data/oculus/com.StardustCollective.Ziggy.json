pt6mKErlOKVYPKYH44NPmpFRpnvs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2mbsMSSIvkT9rn6EP8t3FF_NxtAfCSG2bfQ9tgCxUUug&oe=69F218C0"}, {"file_name": "HighresScreenshot00040.png", "id": "818138872994656", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982499_818138876327989_2509640883979337008_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUPPppqMZjcQ7kNvwEU-GCL&_nc_oc=AdoP1MJ7Fpw_10ayC4NMU6bvO1Scpkr38w_MXxD4uC0mz0XiMrD7PMUYF7syMMnmhz0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af36cS0Gsc08aFCwQ_u-OW8anw8fiMPbTTa_766uxISnqg&oe=69F1ED3F"}, {"file_name": "HighresScreenshot00146.png", "id": "6528405093884480", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982442_6528405097217813_7617801026990639966_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=689COT1riGsQ7kNvwEQw22w&_nc_oc=AdrkqVNpSEFUv_c1Oz8jVCICNL1TLLkp2iHzRNHUovvj5yd_59XIFZdBwYzynIF8rCM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3HHmypSiyjAya3px95ebGLmnAgUV93W6i8JXkt75scPQ&oe=69F209CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "312845394416247", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035359_312845397749580_7295644085646795585_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CuwOhO1ZPRsQ7kNvwEXS6rh&_nc_oc=Adq07M-Is0iWIn4xQ_80sfgvwfmfDQHlzF81JnE3VMeeSzTm0h1fHn5Px81N2Gj3mFo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3rig1ftLcFNVhm5QxN8JED-g4S3V92nK7urCOu5R9yHw&oe=69F1F0F9"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stardustcollective.dev/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Stardust Collective", "support_website_url": "https://www.stardustcollective.dev/support", "website_url": "https://www.stardustcollective.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOM
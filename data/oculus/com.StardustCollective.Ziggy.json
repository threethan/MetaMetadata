://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvhRA5wHjZoQ7kNvwFkPjHw&_nc_oc=Adq0xxx88oE0YWIAbyEqR4AHAcdrqVRitxWAmrlTH7zdSqRdjLTDgsZY74CchqgV1To&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aVoaLCOGAiBxol8D6OdzkXprJ7V3lanaqQYsGWwtaMA&oe=6A131466"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVMSceJongEQ7kNvwEvJMSU&_nc_oc=Adr24JN8wx81onYyylreGrEo2WTn5I65M2KUtEGh_qlc3eO89BQzcIOocgXIIqQaE6A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vwY_BoHu_l2Jtypk1GXMdlSq9YEHbNYuy-3pQrsEj4g&oe=6A1309B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUh0SbZVYTwQ7kNvwGbQL9P&_nc_oc=AdoViX1-vZL7UJbc5H7ZUIjK6mRZRwfVCGtgphxFA0F1sQN3KJy5WkfBeWnuxsVB7-8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZGFF5iSofEHyN9jSBChs0g6RYxm9xvi5G3QgA3t0RlA&oe=6A13037B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZzsu_04UpAQ7kNvwFHj-2n&_nc_oc=AdrafjcOzcI8_fnHRyPbI8NY05ijsE7tXYipcTFyi3pfngEmzFoUiqfL3meIWQ8U9OY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FZvSRFp74z3chMchIQNATLnK1czGYKT1_IR8kjltJEw&oe=6A1318F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJVzxP2iZksQ7kNvwFPrH7G&_nc_oc=AdrmRE6XQXg4tSMXZnfsadf71QNOND0MpcqJSMCr-L-GqgxqA0ZVzbdFnOeCpSEQu_w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ccvjtdEo5I1UteYQz_L3Nbz9BmoEPmrvzWs1xl_gzHw&oe=6A1316F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-JENoYhcPoQ7kNvwE4_AG6&_nc_oc=AdoOcklGLKAuZdox_AKmaul0DQW1jJ-UUZX99G-RxFJXgTcnspW4GHgnrE60hCvqLZI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-7EWD2l_0lLOcIKL6tJKmXkZkhmOjTl03NeNpBjRF2A&oe=6A130E53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKd1ruGzH6IQ7kNvwGzVn2p&_nc_oc=Ado-Cr8s2HW5-cva3PAXMRIRF-R5RXZlI7f5qO_MoLxnWjnCqPbbMtgksWf5EJf012Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kOnzt9rjg8okPz7TyUMCSqgIpnBN2QV5Xtiw9DGRvjw&oe=6A130A6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMqRzdo6PK8Q7kNvwGq6f5j&_nc_oc=AdroPvCIdgZQ5V8ASAux2DmncDRBBfNlsfODHoXivqCUdXpaMroyOHB2JCR0xY5CemQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6y8Cl1BKQ3XlewF45U_S5eHQDJhdjaIuimeksBDBEFsg&oe=6A131622"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
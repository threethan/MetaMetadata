://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vEwSfR5nQoQ7kNvwHtX5pm&_nc_oc=Adp_Uz-3Hveve7ONUvDpbKVIrVBlxus-oWVnsDPV5P7_F4cFEJ72QaMLhtYCVN_lQ-A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mkUsmkmNfxDFp8i_MvPsxSqvMCjnW-xc0IUi2K7n9rA&oe=6A2437E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uofgqLrdr5kQ7kNvwFtkv2l&_nc_oc=Adpmmoc1XT2Y3SlcJNegKwUmPA393TCdTuN35928c9BU71vr-EBPP_TXt1R5PwnRXQ0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VZZtln_qk-2QOqTm5Km-R9Bao5NkG_H9o9fyYAJFWlg&oe=6A242D32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bI6wkHPZ6IAQ7kNvwFLk1rq&_nc_oc=AdqqCNsKKtSjaFq5l3OO--oPyB1BojjSI608yD-NStlZStTi7kqNdrCd_NHuRqMsHYc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KL5gD9lRHybq_v1x8bUCd3lP68Bf9Ai4XRXRKl8AHOw&oe=6A2426FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qP8QH7sF2oQ7kNvwEtDlv3&_nc_oc=AdoviHtfofyUnhr9bVqSjgmGnr6uXbfZE2wa6BwOy52H7QxckURxc9cW5RhMR0fdycQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oTfLg_fMkhanbNUuNFLqlYCGEwQaenYioga8l-o_34w&oe=6A243C73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NISfU9rDmLQQ7kNvwH7_7qP&_nc_oc=AdpRAzf1zVATevX42fXfLloPZeZZL9iw9eTwS50yoqYEk76kTKWyFAwyKBUFURX0048&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8y5x9GfxjWwNVm2dGLY-CZeCzitDZzK0pFpEJmBUbq5A&oe=6A243A72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qgea1z8xoYcQ7kNvwGYhqSZ&_nc_oc=Adqa105eUZWJaDhaJj8GZyE_re6uAtFvhVU8SaQDcKy4wczJB3MgKf3cbNOvUUygg0M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yDz0QBOmY8fcWmVnI_chjiI_pFGS6cpTwypfdXwyWKQ&oe=6A2431D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ki9hMcdvfdoQ7kNvwEs4p3d&_nc_oc=AdpCl2tJhOjkzRYRXGaVvYEvJNKHGoLkR9mSZl8ghq_rHk9tKwb2AeSKKupXlAapBLE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bKf1wGG3gVSVpn0TJQDTldO4CiFWWc46Pj1stV0ol-Q&oe=6A242DEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zRcX_NqFg4Q7kNvwEJ0thF&_nc_oc=Ado2binluqfHNPyk6RCHKS71QN8DWYwQRI61qA5-FCiD3Ext08K8ROggSXp1V-_6iBA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_26hctxtxgLnK3lo4OY9fop9UEXWdtxPKSMfE2intzWw&oe=6A2439A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
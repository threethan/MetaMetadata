://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuwqTjU7vTIQ7kNvwE6Smjv&_nc_oc=AdrqcVud1lc1whfHKEhaVyqkCIvvWn7MuQLpNAtFczINBLIFBdCdZxkxNauZriNDhNQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxbH9-PCBN1vpgqYVckPkgKMGbRYxfpoJ007ePGQZlQJA&oe=69C66526"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wpz5Rafh-KwQ7kNvwHK2U7Y&_nc_oc=Adrbb1c8KWsOhZStaQ5A3kNgQMzVB7fqg0F1_aKvK-R9X5W0bV2U8phjQjNvV9C_7ug&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzfGx7lc45dMJ2u1I84Y88lyqtLgofGg3Tz0aJo6rfNSw&oe=69C692B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eadb3tPJ6qAQ7kNvwET1Uw8&_nc_oc=AdqPIZopwiajEvtwuVq_52zv9Vg0n1VSEVWZz6qeor4q7LMevmPvTRQAzUY9rZAMbuI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQ7q9cdNntGut7vUU9GjcOKar_v374OdDy5gARou9kXQ&oe=69C68C7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gr4d3bQnlzYQ7kNvwFyN_gk&_nc_oc=AdoLCT77aO1R5Eim5dP1VwLc39GHjLgY5JiG51IQomgmYOHWP_Max4k5SkN4qnpMM_Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz4CQanrmSSj_nVbruRaO98KYpTqKlV_JKn3Stg559SUA&oe=69C669B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcyM2BrIJ6wQ7kNvwFcloTt&_nc_oc=AdqKvMlWOaYyHII_owzfjlo88yEilLl-yR6_vLMxC_-A6bYjg2MsYNEkvxDz5bCZb5g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwEn0kqUK7ElrzQTuF6pazCE2CGhvwCKz9eNW9N10ZNDQ&oe=69C667B2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSwpXktnSgkQ7kNvwF3jyJU&_nc_oc=AdrC5uriCzXflhxH1lSiaCvtBDJkqwiWQI6wcd8Gqdo46ubYdmD4pdAIbTV5CnDXw1o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy33bGrNU2U0vW3QOPlg-KyGU8tUPzi3lYdG0q3vhNapA&oe=69C69753"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PENtYrkBRM4Q7kNvwFMmKmA&_nc_oc=AdpOG-pgvUUhaq9SyBI-2h4ZZRf06NPRlEhoGLsB0dkau3QR3UfaLGCqU5vapVHj7_0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyOI_vJjWt-OPX4T7iDRooO9S1CNYnZ0e4RWusltaLAMQ&oe=69C6936F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OL2aXUV7jhsQ7kNvwGiogXg&_nc_oc=Adq2GMzsbdcWCCOWJrQzpi8hXLiihMKdTrkiPI8ZLv1ZUv1yzAAjY32tfD_0aQe_5Cw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxYsaFnr58DuUBUK85TUTlnljIMqlQ2bOTQFMCt9o5exg&oe=69C666E2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
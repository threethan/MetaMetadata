://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtsFOF4Yg94Q7kNvwFBK5PH&_nc_oc=AdqQYjO5i0pp5e-lO9w2DAC_eOLZLXkCW7z9_v5sdRolbxe6WM4CKpsHsXF67Rd3Tzc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzP3whm3AzQxLUzxP4o-eTeCMav3jkX4DVyCyhR-nyYg&oe=6AD23DE6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlw-5GrfUsEQ7kNvwGV_f1i&_nc_oc=Adqn9Xwfhy2g1K_DRa0biY6RBgaW7r-5ND2H0flE2npxmZdKAly2R2-oKopivAIs88Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJGE-pGYu0Wj-yVrfBSzLd5ZBA2Ho-ctErCawiq7VW3g&oe=6AD23332"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1c-2PJoAZpcQ7kNvwEeSOs6&_nc_oc=AdpLU_S0_SmhtYG6AdciC1acFWTnCGEPxDtQ86bQCpdl4joXRsuavbH0awy3Zz-h4Yw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMU1_Y0YvbZqWlxDtUlhYLxcCtyua7fhkrfQWclGBCWGw&oe=6AD22CFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsD4akLqe4wQ7kNvwG3lE-p&_nc_oc=Adro0n1wYErgyYSbW4wVTfdNN-ws99qUzGPx1Qd5DroFipjGW4sgFv3gkQCMCR-jsek&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKNQalCS2dq-MoxGzrGbcpGPXJXaE3ERCr4yJA1IBRxA&oe=6AD24273"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNlCgeozuBUQ7kNvwHg_eRf&_nc_oc=Adot2B6C98hs9537YItakOnIyVIqBlzy6cgKWz66eOdsbC5Gb9MX1JwckcQWKUdlTWw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZZVjB4kXKtoiXPpgrQiDtP2zLQKDUKFhnpwczzzgnwg&oe=6AD24072"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtvOLp5-DfgQ7kNvwEQH9p6&_nc_oc=AdqLxVrZ5qZYit-wTEDTHbw6hTpcB8Vg88jN_3OMcL53CuJMq-cR17aus2JGxfWojSg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaeNrZc0BrnHpBwCl-1OlTgzo_rM_pSxXpa4h9eOviSg&oe=6AD237D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itkDDKdYDVkQ7kNvwH-9EvE&_nc_oc=AdqyA6xgjO4lJe7hwy34Mxd6kkErYEfeT8JqSvAbNSjw6EUWGz0RypGJz73AuHRO0ao&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPf0Q96kf3e96jgy1LXjaHM8ZtWLWUoS6pbglFPZqh1rg&oe=6AD233EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYOOsyIBcakQ7kNvwHa-54E&_nc_oc=Adq9_tq8R5F3ftUEHi1Yoveq_AD1qxeoYhpuWqB9qXlrWvTF7tvRsyZyC8TrDgBl2yY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLpmVO5jk4_KZp30mjbRzxGoIj147Uh1NliCyb2g5RoQ&oe=6AD23FA2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
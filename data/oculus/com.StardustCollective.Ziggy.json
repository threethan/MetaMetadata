://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDDX38TRq8wQ7kNvwFcKnxn&_nc_oc=AdowvAO_q2VJ3MKwtFXzaU4v_oy8bqweaqWVGdfmmFTNFzKDSDjLR9ANqU5KCwqMDxI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEUDrO_Qw-dNbJQIHK4412i9EatfcKi2V7E3gRYc1Tyg&oe=6A6CBA66"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-EIlQX1KSEQ7kNvwH663eu&_nc_oc=AdpwHsKFVBvOohMiighvJ7koWy6f3OLn2_OXdLD5oozxs1NOTNng2g7HodDaeqxDFBw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDIOKUf_q70uUAt5o4aqFDVQ0pXvBlsG_ybl5IWrhhaA&oe=6A6CAFB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYRXUk4n5EMQ7kNvwErmJVr&_nc_oc=AdqWZTFnkDCwvsHWbG6dd1bqEedY2u1GMv5w2obVOgUzKchWB-_Ao4iPvXVuWckLU4s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-V_tuIcLq_1AvVyLWlXLaxqi8JWBnrWlF8kkT2CCmtA&oe=6A6CA97B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBLG1go4CRQQ7kNvwHqyK5R&_nc_oc=Adq2EpUUmBkGdvxSk7QbB4im_J1E8n7JQYwY2NiWOtPU5mr7z25k7mgfLDBkX6mzP6k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlJp8SMsStI79g223LGJdMhgU0geuroMPyQOyq14u_sQ&oe=6A6CBEF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ptgfmgjNlcQ7kNvwF2OWjl&_nc_oc=Ado3laVl6UCYHd7nijl5RzRdlcfN9VR9iMUmzxgvgW5P5WHZ36eQbuaLN1bYJoayUiI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDujrWwfIWYul5Qny5Vii37h1VF75Kd5IR6zTPdlIrUdw&oe=6A6CBCF2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDA-kN5wHpwQ7kNvwE_FLIK&_nc_oc=Adr_nbz33OAtbWElNwM_DYiihg8V2FsjdWF-Un13D1glKMGqVzDKbnNCKdtkz-qMk8I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-tjOZblQHIx_6OfP4snI_2qxfRu0f3yjMXnab6n7cFQ&oe=6A6CB453"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYTE6GxdO3QQ7kNvwFT5F7h&_nc_oc=AdqwlSeLKgroSxxbahQ_ApJ2mbTFjTrDqzJ0NmiRoJbewdkkMJO0WdW1CRDBolGC3cY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpjElHZPFaqAKGvv-Cw1RvrSv2QMEAgpaHgqcEQhvfsw&oe=6A6CB06F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wP-CABP6swQ7kNvwF7Z06P&_nc_oc=AdrtWrLgf4DJbn9XEGz3cMuC-plVqENlk1TGQ7B1FARdSMe0E-QmQQ-v6m6Qf1EeoJA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmZf2kv5AerZw3lv-J9K99OuK6kI6X2gNsr2O04FJ66Q&oe=6A6CBC22"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOiE0c5z96IQ7kNvwFd7ie4&_nc_oc=AdnWkd_KPrSWD6HQwlGjzap6ToYfSeBPaMx_1-Z3AAUwYcRt2MJVMn-5Ffx5Rbe61tc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyyWfZgh4EzyPn9BzxuImc2RZWhtA_YCZbJ0mIv_iMMEQ&oe=69B7E4A6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFR0hb4wrE4Q7kNvwE4w1oK&_nc_oc=AdnmfaeOML19_iZtGNUvIhuWr5MJFBLXmvGmElvjgWl-fmAyNtZIkKNkI1b50mzCY4w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxUGw6OUwwG4uZVpCeuajQPNqUsgvEuEn9xEeZHEtZRdw&oe=69B81232"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_13huUlfXTAQ7kNvwGMz6Ii&_nc_oc=Adkw3zVtm5_48_mtYkoDmV7nOkwZ_HZGVzgB14Rpqma44D-4aC3ZiFmzyrUyeNAmLS4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzQJsTkHkUgXAaNzSuwPQBRsJwA2suT0la2FGQoJ-gMlQ&oe=69B80BFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzfEGqogszcQ7kNvwHJCTiA&_nc_oc=AdlIYvSK8nrMBZcKLH5h6710nLu3vUzxs1UJmXH4qRqKadRzEUshcVs1O7MkaDFHPao&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyeytcra-oxceqFGa5Jb1j12rr8SE9UFEymWSp4-Q4New&oe=69B7E933"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBP6uxLyW7AQ7kNvwEcjY03&_nc_oc=AdkjWoPHCW1e400KTnvyYgrz66nzuir8hV8v2AmLPLF3xggzunYgKw4fhEAMqLq6Vk8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwaeXm_bRFtR4u_cb0HfN_TiTmeq8BIbey94Hdg_XwwNg&oe=69B7E732"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kM1UI010Qi4Q7kNvwHCLNPb&_nc_oc=AdmbnBXKIvaWkeEQbLoaB1xiY3BJVnWR5A8wZLTKlgMu7vkHIqabt6YA03RdS2vs51A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwqrdP4s0G2UYa-Wkwok622IMi95vSdhMdYXqZSfK3m6g&oe=69B7DE93"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4thfnm66VuQQ7kNvwHgiPkx&_nc_oc=AdlFmMIO5sOeGZgRE86OXHROFpe5ZQpGYHAG0WWp4cUWXKbFkKxPtdG5sGdn2n9Ym5c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxpBsS_LgYFsKU40Tkz23jQjczXLN3afzrW6K55wAHp9w&oe=69B812EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymxXHAtIAb4Q7kNvwH4-Plh&_nc_oc=Adl52ul0UUYdg_ls3xf3lWbJHS3k6aqvnBV8O8C_-NzK29mYjdkeFb7E2ujaNDDYecU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyfXtcSElVyclavzce68voduJiII9Z_Qxl5yq5CibYJhQ&oe=69B7E662"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_5218087471640407679_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIwCzAApnUEQ7kNvwGk1ncW&_nc
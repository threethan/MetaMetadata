://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trumEFzd8MkQ7kNvwEOzWgT&_nc_oc=AdrWwVlyl5EA9liSOYhLUOjlEpipjVgv3YAric_xYNmQyoE4ap3pocbkMEhzevBsc3k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4ZjLBRndYVCmDebt2gdoWSfTBvFhiqapnSZy5gi9Enw&oe=6AB3EB66"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4q1wMum-GcQ7kNvwHFkeZW&_nc_oc=AdqeBvZo8M9Fq5tf-WbAKdYBKPiMyOSJ-mMGLCboXhuV-xVhaljDo6OnrrSLf6PV91o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcc337ExZje4nbK77utj9WLYV0xCKAO7cd8FXSUwhMSg&oe=6AB3E0B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIm-u0h6wikQ7kNvwHKvbWC&_nc_oc=AdoudfinhpgUzDkYZAO32whHLjAu2WhSuunxXro7vPGDeS_CJ5jONmk_zRNok4DzFwo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_EnwDbhRfc5Btw2Br1OIfltTakG9rq0XyFPJGe27G-g&oe=6AB3DA7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OC1VP5eFEn4Q7kNvwHrHgZO&_nc_oc=AdrZ8ILbENewNrdqMUmx6pj-Y442ZjeqgR1t5RkGJNWGoegyz7IN1KcjMR0s4bT5G-w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4WKa1ItRcVpEzWppoNGUvBdi01Nclyp_RziD2jdYqmw&oe=6AB3EFF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owyzbcgZ7RwQ7kNvwEeEUui&_nc_oc=AdphT6rYR1vShwnkKrgFOhqjnfSi5pqzdHSIy_4CxWHpmWy9fZ5Sb1SB-x0z8ikKg2k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7i9gxyyoOWeBTuW1-0sM5yfv1WUGFjmmuqGgG4aD17w&oe=6AB3EDF2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Bz5AjutPRoQ7kNvwE0RhTK&_nc_oc=AdpLBdFr8rcIdULHnvAiifsF3dkxV1pL_GThWQThwH64s13laU4I5X4NCHyE2QXgRmQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbDoVnuG1vKF1bSFfxB71Gs0f53w65ytNm40_YptCnOQ&oe=6AB3E553"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64QFoZWFot4Q7kNvwEEOqu0&_nc_oc=AdrjEh_u56fxjNSqQgZVASe4aJdnT_hPGSA15t2a_WpWyF3ey0MM7jhZv6PAnbUSMGc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0quvpsuifiFY5rPHqGDpMy4z6CyaRn3XfAlTi48PWUw&oe=6AB3E16F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmfdI-EMUuUQ7kNvwFcaJQ_&_nc_oc=AdqtFbeguTBXX-lfQN_nOs7gG8ZvX3wk7JcQk41vj4QyhhtgjB1ChQzeSpg-5Aufg2s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKb5zzChlkYo8Rlq8UhaToAkyVUXyPL4ukEubx-D8rMFg&oe=6AB3ED22"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vEwSfR5nQoQ7kNvwGlYE1X&_nc_oc=AdoVj8N7DFiTTL2li20TrjqeycqkLI_pPhU10KUVKMwTW4SEBNdcEtgQLuZzBbbZjzA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_k-Raj1DWaytaAivqF8v4pa2qOOKvrp_kQQOX_aKIXqA&oe=6A2194E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uofgqLrdr5kQ7kNvwHdGdXB&_nc_oc=AdqknfOpntJEFg4j8sp2Evn-dZeJvna_UJGVyTM3y8c4Xvm_kY-FRZq-tPB4N9u209Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hC7qv3a8-cTz1EBim_7mAMtEVprKGX65UOxKyp9hAcA&oe=6A218A32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bI6wkHPZ6IAQ7kNvwEWHuWv&_nc_oc=AdpXVH_Th1ElDtOxvCKejnG9cvooYGonquZv3M_ab-5LJdfqzxuwVcMk14Ye8HpXpIo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PegJF2OoZwZLEVMH5NWZVy04ItpXxGFEv5mkJJ9zE5Q&oe=6A2183FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edsVGq0vqecQ7kNvwHOpbNH&_nc_oc=AdpWKih5z1ZXywBhiHujv5qgeWhDhIR-dvAIenRqmoxn_UubxSGPDre3pcTyE8PSegk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PkyEiPjr4zlHzT--QYQZd7ovWeu2aeS93y-aCIj32Gg&oe=6A219973"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTNKCj5zsscQ7kNvwHA3JT6&_nc_oc=Adpoh42rEnfJM7dfgNk9nW8VOadSggDetjHp3RV8gORQBPXdILFOb9kLYxZsEXYw1qE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_m9sGz_BLe4Wrt_IoDz79VE8sjB_ZvVEbPwwNZfNYNYg&oe=6A219772"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qgea1z8xoYcQ7kNvwF73c5P&_nc_oc=AdruzdYxPOm4Y-d2i7TDJIfEJU_XfGzUBnS3V6M5dia-OfOLgCY1yDu26eCiXfJvQBU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86WIrZEFpMmL0GGbN4hwrVR6X3hbXro3BWqpbLEWBLjg&oe=6A218ED3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2PxylizDCEQ7kNvwHH-BEX&_nc_oc=AdplBYwFQRVB3haifXCvrcQo98yHaTK5aHbkhVbnJwnOdurSDs_acpHvnSa5zOHvKNg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Q2LG7II4eUX1xZ7Tb8fbvR4K1lowBNg0JQKG8pSsIQg&oe=6A218AEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1Lpoj-eucUQ7kNvwE5hdfe&_nc_oc=Adrde41M1Jax0DDvDUWbr8HRF10oi_lP4urnndEKoiRorHQ0NLfZAEzLtpN1tI_0D2c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rIXm9C_lYS7LvRhGHyMWm6j6bnvA67jwYoDEB10alhA&oe=6A2196A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4FTdF5-QdcQ7kNvwEc9Qlf&_nc_oc=AdpyZcHz-yGhprdzPiGkWRYKnLFOeZDSSDCztFnKMM1uCHExQxmGTP4LCrZ0eRz8gMg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5WScv8vS1NOkOSfSasi1a-XlY2bsYRH5RMmy6eAZqDQ&oe=6A7C5426"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAyzJOKX6m0Q7kNvwGuC1Gu&_nc_oc=AdqD-Ous6dhr2Y2twvsmd1jDzdFbNFyvwbSD4ImLdiSFBEzt3Qekc2pP33R4c5rXJps&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-WlHLMm3hmarfqT2cSfN3Il1qrS7ooE6dGNuIkkJJ5Q&oe=6A7C4972"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqOPdOXhQWYQ7kNvwF1KbvH&_nc_oc=AdqYH7aQ4WBxP27jZpjSUrQ0SWFHH8c-HpPiVazVcesvnwP8mV3mjvSMW7ns7-8I5VU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyvg-LNizr3MIm0UfVx4VSe16NjNSn7o_kTcWQgcdrFQ&oe=6A7C7B7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcjPA6W_6vsQ7kNvwEKApe6&_nc_oc=AdqFEDBkzEhvzAKGnisAI56wxurxeGiWFb9e7NTl4ilrlqOvMTaL5u508-8fDbZYIEY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHy7v8TgZ3Jvd5hOIKF0SRi_gS4pTqkHSukaQIvBnquog&oe=6A7C58B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5l2swxevyiYQ7kNvwFeTifV&_nc_oc=AdrSEE9I7vH8mKbE2e5SZB1XX1ndx2DeOy866nluMr44ZG8mwVbCKQGfPXKVKxk2JJs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHl7Oed4BbHedTQZjEK_ZlDG7cyJaz_PwTADbGwLGnDMA&oe=6A7C56B2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNKNH4Da8aAQ7kNvwGubcHe&_nc_oc=AdobBv5a5z_xxZph461pnA6OItkJ03Q0rOuErU_IBs-8-KZJTJAsvxxkDEwb5jyLl9o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEtfUKdEzrgBfXbsyo2jv7VNeJUyh7j0X0EZ0gc-1Iyw&oe=6A7C4E13"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-tgXMLcwdkAQ7kNvwFbEk9E&_nc_oc=AdriXlCOepsl8OoCNzOUcROe6g38kZQXvuWknATjqkQom6QWvy1kk9S4a7y7YPJNhzs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHFWruA17KDnYAQKC5plnzrn85xHt-sY_GwGgobpY_tw&oe=6A7C4A2F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2xMlnErQbIQ7kNvwGi95Ua&_nc_oc=AdpNv0O_BOmyKJCKjBrcsfUf-QnkJV8kVcvlv2v9tHksB1IeS0IMFOWwe1ojQoZNHrI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZ4w65_ymCxROta_2RCQrEbdgghqgRjQUwhtG24EOzvQ&oe=6A7C55E2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3gRtY9kfikQ7kNvwGdInJP&_nc_oc=Ado_c299kNOhNmIFbmLhnoK3om59bFqt6DUNv2hRIMa-o2yEhdzU52YkVUwNPafHiOY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87KO3yOdoqJMaisaEM02gHVicdsxHYyV8Qei4n-awlFw&oe=6A43DBE6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgsaSTgQ7J8Q7kNvwGT_tsq&_nc_oc=Adpd_ZeILgvv9m4vPrAC3KHyOifl5VOCNIKdzzX_m85CJvwE4EDMMiVdcn7iAQ9z4i4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vJiUosWmoIeDAHPexhVvdtwFBjlIYI6VoESvAvC6y-w&oe=6A43D132"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsTHZLD91WsQ7kNvwHmZWdr&_nc_oc=AdpD730R5u9stxYR5M_E39MP5fYe4ZwYL3XFol4e4VGa8fWVyMTczmtdI-ublZ6NKQo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aoV0IdoQqa7DjtGqC_QKFAa8CkzHY9hOSzD5iXkLjeA&oe=6A43CAFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qXKhA926ywQ7kNvwFsrFT5&_nc_oc=AdrmSJ-x5ftaGrC_Rd4HSzXpg0HXZH5v7gui4jGOFnqF5IYT36PNZeOsuFJ-nu7NUck&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uIWO5dryD7nxogIhZaB3AWgS7Hz_J6wgAJ8TQVvDH1w&oe=6A43E073"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiLQ9cg9YjcQ7kNvwFXAow5&_nc_oc=AdoHhxz53NDGsZ2NU7DHFzm1ZWOj5WOtozjVTXYVp4Fea43I9d5u_YJ5VgoL1H61Cnw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zPeRdkN_c5B19TONJ5atg7gpz5gVqHsFP1Gm8X3a-_g&oe=6A43DE72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2y76QMd0v8kQ7kNvwFWpjxX&_nc_oc=AdpPtY-DLnQfwG3u1acvhWmgNODxCB2r5XImHYNaJIA5ua64nNhdcu3sw8ugCrKvzUw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kepjPYVgEdwwx8BEGYX8QqidzHHBzHb8WqwIV3mcaAA&oe=6A43D5D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTZGhPrvrLoQ7kNvwHDp7gf&_nc_oc=Adq2jC7qA_sABGP896SuBHHeuVLwq5CCBhQMHxZh1YmtcaR18WCbjKEC6sA_WBtuTok&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fqHYMcBBwrvNvnG446QuYtPVUqBEjgA66VI1q4krWGA&oe=6A43D1EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RtTjoFdlbAQ7kNvwHYRoAa&_nc_oc=AdoUK6_Ad1PCxbTz1kbDiTylFSiq-vxz9C4ldA6ecMbUdwIx9x8BKEK3Wn69rtw-HMo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Sa-HtefRZvIiZZqSvnnBUcrnwGWfv7D2SUJOPXHYQtw&oe=6A43DDA2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
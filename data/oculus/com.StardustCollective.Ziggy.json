://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ir62lG6SYAQ7kNvwGR64dd&_nc_oc=Adp79nxwfadFrheXNUfPJDM3dmfwrC4od11nolpuI6wYKN9vxSes2ydFRKz7M1LiqMU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhfp4Dkw-j9KpSfe_9QPp8jIDUJvLe_q0TI7lCSGgXAg&oe=6A901AA6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VemnkiexRZAQ7kNvwHm4mP1&_nc_oc=Adoees2_0-WKagJGpe5xfcF_8n6kaJBq_PpTSN9Z3lA3Q_oxQtVcyD4-8pyt3sVWj7o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFypt6uZAKE28mxR6BRJEBFXf9hOicNzF3cdCYajntx5w&oe=6A900FF2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUfZH39-vFQQ7kNvwHM3MvM&_nc_oc=AdpK0KorMFIiBM4gHdh3qdgGvPfVeFouGUKFor1TpLY3n2TU3BfBH9HWhKkd7NDMR_k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyri2mwBcr4aer1P-X-wqXNOMjtO2Sb8_BbS5kGF_2sg&oe=6A9009BB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqW1np3k-iMQ7kNvwEkuKj6&_nc_oc=Ado6kwxgnZFd-TwBK-DotX2P2MpSNdhy97NeB9EUIJ5F8SCc8jaTnZGjheA2MGFY8Ho&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPWRtULRYJYgpsVFexARyvcj0AUa-Qy02aaH3Gv7tWrA&oe=6A901F33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AT5KqgFOdS0Q7kNvwHAmQTe&_nc_oc=AdpPdbfLLJFMjd8r2jWWNYlzWsSbhQqcktG82ukJJLoSfuSSOLoIiAhb8VEjP4tnHBM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5zNwraZaJr0fdrKb7Vwj7Bue_IQHQQfhgDps37TPEQg&oe=6A901D32"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTyxa9DexSIQ7kNvwEey7mm&_nc_oc=Adqf4hKDNS5nGAxPuYlhSc-YBsUfHFoAd3B7CyUrUmQ_iROjW3bK3A6womdxLeFGCBU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzTwzOvyro1PAoiY7-c5VO3xNOV0AJNBeSX2CIvIaNMg&oe=6A901493"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vR2hP_tibgQ7kNvwHXEEYn&_nc_oc=AdrGQ6fOGShhBvciQuTgkTBHihqtSId7yRllFY07-DMJYK9RYY3_NNDwTkX_diIIb04&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmyYNFua2qnerXJh7mIBmsl_2veLzN85umRqRmJt0mZg&oe=6A9010AF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouzgnxWan1kQ7kNvwHv3j7Y&_nc_oc=Adobfpm_2C-uVWJwp-raVm1ZHx03Q3u8vwGUvF0iLZSw0XJC7ertp47EXodndUzXozE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGbM8FBuovo3n6zv8jR1hQLn2R0kgpcgnwxFewdJKhqg&oe=6A901C62"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
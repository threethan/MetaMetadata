://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jd50IPtiUbcQ7kNvwEcTzf_&_nc_oc=AdrjAYTy5OGo83znk3ABfoNyibsvioYoJodhX-FSNBR6-9e1rvj939g1NhgAdzsPnOA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57KClyuBhRyqFs8NzMvUfyJfMk_P6Vl9h2Tl9WWjh-7g&oe=6A05E566"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAFEb1z4dEcQ7kNvwHQD3Aj&_nc_oc=AdqW0brRPgRq6GmzXcLXZTPtZ8e4WmNX3rcfTEtY-8En9vtuE0Uiy7P_IL9YG1Mh8s8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IqvbOoRz-2wXnf2FVRVkKwmgRF1ZSOcXRDTPGwQINQQ&oe=6A05DAB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4aDgGnhadV0Q7kNvwGqcbkT&_nc_oc=AdrhgiKUE2tT9Z_k4UzifQEzBZTFBWHBMGQdxcb86OICrubEgahXjx5YAY1WMHvRHvA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4njUS_AoeLd6eD0f6ZD_Jo2FqywUDsHooPt_U6GXwQKA&oe=6A05D47B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPm7grmbxjMQ7kNvwG1nKyD&_nc_oc=AdrDBvL56OXMBSvXyQ7VSChEGV3ae1ENUYaGQTpnZIM3KTVOqHeLlWwayRBBL77BFHs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HQpKWnZ6HFzp9JpPRa0YbOs6nQyBuf_Onex8XfSbPIg&oe=6A05E9F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fzNJYdWtY0Q7kNvwEyPDsG&_nc_oc=AdpC27lDjSu7YTXA4sK26ikEzhofYVx5QtxAkUzlkU7FO-mH8QJTnapXc58R6F14-NQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QRAHFJKE5LEcVs0eVQZdZv8syAe43jhi_7HIxklnY3A&oe=6A05E7F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvH5jCpyiiUQ7kNvwEbHh4g&_nc_oc=Adqb__i1k7qkNnw77cZ2D7js02WgGsnHTmCo9T_S7Za_l76AxV00hyNE4l-lhQMaxRc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vQgv-y-_oNjkiae5GvBeTwrc4OfI-9IhQYSMIKEXBuQ&oe=6A05DF53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AML2gQoP6gUQ7kNvwH2ipw-&_nc_oc=AdrQu6oNK9ELpkKgWT0UrP_ZkdZJpFv2QPbE5lSe9flR_oxBY1jfVKqCRmB7ng7GYEo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jx0-rf3J51cNKReodY4wvGH3XPDuFj_89FCfRXAdbYw&oe=6A05DB6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvC9FfvFpTAQ7kNvwGhG2Ct&_nc_oc=AdoN5QoVgDWAYMuYuOqHca0Rp00kZ1qLHVmnKZj8o6Cf0XVgFf9YPEeujT0pe3_DVBk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57MRNCGLTLMcmNRIGmhyOu_90beBmecK-9QdEA7LFuzQ&oe=6A05E722"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
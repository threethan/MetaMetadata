://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ir62lG6SYAQ7kNvwFsDCvi&_nc_oc=AdrM8FmYW_MpP2IfkQ6CF-cFvSbrWyk_86biXS0hJCgSdzKFohwLPKqI_FRlljEMylw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjEywt10llWfDvOVFk5_aBkbJkzUu5KiI5EQ_SuKXFWQ&oe=6A92BDA6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLYK9B3Ym94Q7kNvwH8ogWG&_nc_oc=AdpoH5EJ2yKevTZ92-kYqXOD70ii1Br3OaAanCTRvZdXcjqT4ejFFx3mtK2cdtRMqKA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7Blk5TvKt5JG8ag-VFHWohpNiPEJrYnbAa9m3hMsYkw&oe=6A92B2F2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUfZH39-vFQQ7kNvwEHAmIt&_nc_oc=Adr4z0yA-OvX2xq14RMhxpeezKRoFpLPee7CMJtuR759V4LW7JouR3-hn-RP0VtLNtw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjjcxrADqQh3QQdpVv6rWoo_OzulDo26KGWzrH9ef20A&oe=6A92ACBB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqW1np3k-iMQ7kNvwFwQRWg&_nc_oc=AdquqjabfAlCjHw8G-P55ZbcVC7nmdWezBtTj2PqAk2GMJWZRZ8fDVoz5rITOgMgEa0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGolut0Hbgy5X406RfE8Aiu4NZN9L-pnvL3GApK6hpkXQ&oe=6A92C233"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9L5gOC1A3cQ7kNvwF1caXP&_nc_oc=AdqfHYd4YgGA5W9Q1lkoTdZcH4UMqPyJPyZ5z-P--IWlsP2TVLiEwagOvtV2wCB_ZmA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOLvOKLpwqO32xGIDBFXboPFkex8i97HarGxqvaIwrdQ&oe=6A92C032"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTyxa9DexSIQ7kNvwGuda1F&_nc_oc=Adrd6I2Sn_ZfIISmzokL-QwpZz8aMcP9BUY2o1M-y8BocXqLkAyDtx3QEW3cbzsjVbg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGclk1S9NvSCau5Ij5eqJmdnhvdUm0I9UsTN4_wEOb0EA&oe=6A92B793"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YuM_2ztdk2sQ7kNvwFYNzYB&_nc_oc=AdrRZCJlrmLHd7iOYsqNXFfgjKNjEoR1XxP52M1iS5ZHcTma2kgzkPUW1L0Sc8m3eQQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7wrP4RzSlOPT6HTOOBLVYE-lI1vmHKkdkyteZKiEHIA&oe=6A92B3AF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISjkoO4kJgsQ7kNvwEbIX2q&_nc_oc=Adpyjvglq-uNgBT9pYaBdwpsISlPUyrJfiEOswe5T5luHvzPLj72XFr4zW1jPpFwKZY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHopJ8fmPQOwwWizxq8BMqw5XTOfSUM6mZzRYrNbnX3Aw&oe=6A92BF62"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
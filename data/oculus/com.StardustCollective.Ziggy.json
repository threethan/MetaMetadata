://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8ZDx-_uiDgQ7kNvwFGPwWP&_nc_oc=AdoKVcGGJIGfXul5wrSI3ErKRRzI66jHPhh7hb6jD2uhNSo0P7WHI04qB-yZQXEA0O4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YeR7W5t-9plF0lXtKWuObOvRHPwXKJvLYzmIutylvzA&oe=6A2EC3E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vW3hm4SChMQ7kNvwEXNZyL&_nc_oc=Adrs569o5QSSYoFZbX-IRqcm32Dd9OpEiiUp0ROtfYToymlVV2aNyvkoL9xEMl3hKR0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-U3oZtdvtKz1L6gNA3ZR46BggJnvp_nF06UAWg1XcSiw&oe=6A2EB932"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7q_fUve-dVQQ7kNvwFtFa_5&_nc_oc=AdrtTionqI6JKXA4IBP_lZFEgGBGfB64OMy_M1l8pSwVlznHwy3VKPE0YIlSRjFSW0g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RWbVIZ5ilwTJK2hZlVEQOSCy-V2rJRSDDVkU3u8Wm1A&oe=6A2EB2FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9DAoOL1NUcQ7kNvwEnjGYe&_nc_oc=Adr_SS0qgXdyEDp42cFBeWSqeg2wslb0exgPV8tKoP9P_bkpuCth0r-W1e_O_kmCD9w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zlg_h0vF5UnlgKT8sZ4HIm-FAOrIhh11hEJy3LGkimA&oe=6A2EC873"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8aXx5dMMt8Q7kNvwHVQcM3&_nc_oc=AdoZ_tfYFYcTZEf_6ovxGC_UZi23UU5zchIvmatX_tItoifkL642UMhHhIGbF31tzAs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wtSsL6bQSxghIinmN-nGLfm0tqXyaVnHumhPEQCxGgQ&oe=6A2EC672"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAUyLtQh9VsQ7kNvwENZdNP&_nc_oc=AdoaOVY5IBBJ9yQCV_BrfpFX7GYbEV8prTuhkOg63fbLJgnoY7pbdQJz4hU5P38pvBs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-N2NLsjzomgKenKNayTcjDu8lp3Qe3gduGV4ZSIOQpcA&oe=6A2EBDD3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5HR2LicKj8Q7kNvwGF4Yrd&_nc_oc=AdqvqnauBUl5fZS5pvRHjJzT_MpRQJe9T6HaSiZBsdvzElBoeX6O4MPxSaVPUA3cZVY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sbFJlm25sePA4tFmnUNro2gQJfV3xuP32hthOdzKDYw&oe=6A2EB9EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRd3-7MmdQUQ7kNvwHkDyLV&_nc_oc=Adr_LVRmWoeynzyEqCsfg4XxQcNMCpVEfCKmawvJVhGNlmdHjvdn3R_zxhry_9iGNdI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_swVrEGUSdQpOWCwG632j5NbgnSVNvUeeZVkQTrVoXow&oe=6A2EC5A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SY4gFd4euzQQ7kNvwHtdxyq&_nc_oc=AdoZN-OzvKkKhDqDvcNI6DaSV1Kl37Cn2Wwp6-gGpl0UWstGLWMjlig3vd1En3Fybeo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSv-fdgFb2bEOAYBqCpOBgTjFhGYXS6grLPxDBMSK_Sdw&oe=6AEB4A66"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZFDya7iyxkQ7kNvwEJtqcW&_nc_oc=Adpkblo3GKJ0UrDTK9Y0pfN7xZNOcn04f082VnLIZQ5DpJUvWpe-JB_elD7p8Jl_erY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBlXz-gnqg_1rfgYTX2hj4-uvH-715pC9aJ7NuzjThbQ&oe=6AEB3FB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAiy-VU3YsQQ7kNvwGgOOhM&_nc_oc=Adp0Sl5NMPYJqLdvcRJ_6cnLEr4MACAPec5rtn9oRSHb4GklF7fXZhzjhbR1wkRyCqE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrXLIXgR9VSNctBm9fzYnDbGIRLWcbQmYuEZo50aWl5w&oe=6AEB397B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CvF8UiU18o8Q7kNvwFRkc2B&_nc_oc=Adqe_WfXAedCrYPt_OIDSKMpH-ENze7cB8MftiTxSUjXkdyO99jVwzEhM9mLnIW2kRk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPy685g_RzgckgmQnP2hGMnsZ6JKFMe07RS8lbeD8jpw&oe=6AEB4EF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vntvolyDIcoQ7kNvwE4nJOQ&_nc_oc=AdrhgLtJHPHwJ6X8v2mHBw0ppLOQeGLGP6uQyA6SCS-p_nJRKTiPg5_AtsjzBuw5aig&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_5cYObRBOvacFDh3-2zJwEXNhuygFkpYhU3oUvZLE3A&oe=6AEB4CF2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfQr37NojzwQ7kNvwEKsmpe&_nc_oc=Ado03uvcbsGgjtZFXIx56Z8oPLNQxA1R8SUNG3oHw_gHNsvZ7LSNQfP0LFwwuT9uNZM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUUXYr5QuZ5lFoVf8wgmHxfnK4SAMH_8q41jCp5LMuXg&oe=6AEB4453"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfzZlzr05NoQ7kNvwGLesxy&_nc_oc=AdrEQg3F7hsBDLQ58m38jjLS0gtO80J8wLWX9IKa4-jV-9Z0deYE2R4zXbgIRUOXEHI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9k7o3zO-LGA_u-soK4maaS_rGWlpEHQAbVuPL__baWg&oe=6AEB406F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCCxIH77Q_QQ7kNvwHzqDax&_nc_oc=AdodiAtM6hlaiG7XvVHrQXxeqy4rm4-QM7UcB88zl2NTkRrfRjvjniA7CADRo1Wm8zo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUMX6RlD5xn0HSYJgZtL_HqFr23aSEBzktoprIsckIow&oe=6AEB4C22"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
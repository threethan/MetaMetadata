://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHi2mPkhfuQQ7kNvwGgBdmH&_nc_oc=AdqH8QAhkXmNGp4rGnYLfjVx6vKkVlR8dcbAjQJR0ltxo73Gs7zLq8Y8ZVYCFCSrFRA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMexBXuNkC0uYx5xyz8Vfpxu6YCQtrNwy29b3P4OiolA&oe=6A86E026"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVn92GfvH8kQ7kNvwFHalet&_nc_oc=AdpAUnBhASH_-mvj_9K1ZL_LrJoweKiLx2GLmHaxLOv5FErgGdWHE85QOBS3QRqnG6U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMlVE0ZUoLIB-m2vksx6UpSIkdIbcOZG1Miqv-37oJEA&oe=6A86D572"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGL_I40DGtIQ7kNvwHXZMn1&_nc_oc=AdqXVQYpy4dBok4nMUTp_vfTgCl54yxzLDxIzE7qzdZS1fLpJ2fj6y9yeEQAsW3k-Vk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVFywP4q2XYitihOSz9wu7dNFNmWVmtLmywwltS9gkyw&oe=6A86CF3B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HbkJ-vgsPikQ7kNvwEPVmf5&_nc_oc=Adq9hFqd1989W2TktNup_xj9edhpcb8-LSOdQ_tFQ_ecc9Z5FmH8OE7fLxeTOg1MlY0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQaUqcgH4U8XzlyO4oiCIjbRX_C8rLK32l72GA7XlWjg&oe=6A86E4B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5g_xLmOtzFgQ7kNvwEtPcWV&_nc_oc=Adrp6EA29zeZHVDaMUOnpjbVARK3hyKC-BL2OoH-beuWie5uCwlVbTF6xms-pM-WsRg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHplT61XHGQudmoiXK51LQ-sfgoCOcPvIwhGgtHUwLCFQ&oe=6A86E2B2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7xXMsHaXukQ7kNvwHDhtMO&_nc_oc=Adpi14HQ7ulhqp2zMWCsF8P8ZZAv3hvXWKuJ_gMg-7ULomTr3uMc1VntVRunyYtjLNA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGb8B2_uJP8OD7AxgzDHfq8Hbk-6n7hCwTUtEM4IdaljQ&oe=6A86DA13"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-gpIYsQBWQQ7kNvwE9D_z6&_nc_oc=Adojv7nCKVG0gKpNjo22ZfyCfddkFPrjAsM5VpRGq9w_mnOCHT7mVjduZTUQURJ5NGY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZuBn3XvzcEnvEwal6z4xzC0M0nQCSaC0HZH3zx68-sw&oe=6A86D62F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4i9cOzLWg-4Q7kNvwHMe4ez&_nc_oc=Adrr23t3j5jAXgfgdQmKm-FV8Ci2-QpfLqKHXZCBlcAfhJXHlYbK5WG9FJsq0tLv-6E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLmBJWm0z3QXWzRWr0QG8T1dqANIO-axw1fxcxXoIUiA&oe=6A86E1E2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
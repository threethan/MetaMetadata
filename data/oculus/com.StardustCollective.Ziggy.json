://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVKpu7DD-HcQ7kNvwHlzcLZ&_nc_oc=AdqE8ehSA7Q4s-FsdnXofosMGT_qfpDOLaC0g0BG15pxvGN7F0g2FrfNJJ4vKl9bdDQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQId47VUJImGhhDSzSVIdbCpXvZqHZFF2mvjkQtSk2-bPw&oe=6A9C3066"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRo4XHEVX_gQ7kNvwGtxebj&_nc_oc=AdrgZfuKCIw5NMGoUXqrLhOve2i_l5PKkEDHMdtdVzo6rI3Y4U6WfQk8p_HW7L6BQa8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJAbFEcgMdVhL08YS4WTC3_CdYdXJT4FQOliqeL-Xf5Q&oe=6A9C25B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzidItOMxrEQ7kNvwFnC-aL&_nc_oc=AdrFELes1Fncf8YkYz40r-IYWOxT8Ki17mBEhXZcUKYZtlZU7YJ2HLJps1dTFyE7oYU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQ33CYHN5IcdCgNsVxaqyucCMqOilDiVt3__TOLeCVGg&oe=6A9C1F7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTt-2KnIby0Q7kNvwErmffv&_nc_oc=AdrbLcp7C2aX8i5q2_THoD99hQJz6wnzctdj9Jh1P_5SiBZvsk8YL4YHj6xu3YhESY0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVQZsMtMTJub0HW18yhvXGqRr554XBXBVe3eDKQZyXzg&oe=6A9C34F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cf5GYe4F6gkQ7kNvwHgZ4zT&_nc_oc=AdqNGgrqjN7mlC1NTdgzIHXNKYNzRscA4Nb1IvGbwj3Zm4JjVHXLdtMSdwqcgD7NpBg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkdWoilrx9Va1wEG2hCpvt3Dw4OFEG5zpXTUANdlypyQ&oe=6A9C32F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVBA4vXmMQMQ7kNvwFMHfYz&_nc_oc=AdoCvJ3c2ojXrWMhoji4X6YhyOyd-0uv0NSP0xGjRWhXERoeVeDwUDXleZMAuSPr_24&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvJRaPtVrbLkt8-nAYwnMK-JitO_ly_S-AldwfBN7uRw&oe=6A9C2A53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drxmCIGV1kUQ7kNvwEH_35G&_nc_oc=AdpObFklNP5vFFA0iDdTmaKEhIAVgxlx0t5Q5bpa5nNx0KOZy5RtTeKKBveF1SdRb1c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIm6c9iVwd21o7lnLUqa-ZvH-eEJAQ3gybbe3vO8tO6gw&oe=6A9C266F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3XTfD6Vjt4Q7kNvwFcEJcB&_nc_oc=Adq3L8RVjd1whUtH1x-KHMgttTZotOnW2U-TKKUiGQ-sZrkfG6bai08-04WjxUlI9sw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRRhFh7vU16ZpluTNrEn_Cfx2_zd0-CQeOiVcyx5CvEw&oe=6A9C3222"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0U7Sof_VE0Q7kNvwGZvpGu&_nc_oc=AdrQDcEQy8f8vRsR_NwALGk5vJgD6ARQd4HY4RMXYGGbZbxpGg_KrjzBk21etJ_19vM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmOQprOY2TCTCmzOInl8L8O8ypbym_hJ-mInMlCpPLmA&oe=6AF484E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJS_ASHPjFsQ7kNvwF0Co3o&_nc_oc=Ado_mnzenFBB2SK9VTybAR2KyN-VitUiOz647jRL_TposK4JGXxF2DJUHB35IEKvdPA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRH4_ytL2i7pbOtXrNjeplr7iq48JAD_hfhCKBCB-Lm9Q&oe=6AF47A32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_KlbG2wGJYQ7kNvwG2rKs2&_nc_oc=Adr6uBgz-ty8odczhZAKTxgior6CgCptuQ_RRXxDC6ea4LHhTnKZj8pegvlNHi1A-CI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHGeAVTIuyTeV9HcSYPPfGzCIWQ5_aN7pRhScRyhVJpA&oe=6AF473FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HDihKH6bNgQ7kNvwFvDBTa&_nc_oc=AdqQg0xIuAl-hd92j7H2zTLkZ0Q72mhiouXzGo_7p8C2pnFB5yVW2EzHHNWSejc595g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-p4hyidRU-7RqZ-RHWqbiRC2D6Ir2P7mwD_r8A8rBuQ&oe=6AF48973"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCjrm6EmlYMQ7kNvwHUpE5V&_nc_oc=AdpBW_S6mQx3UXrcFkFNAffWv0ORq7dHHxwP7pW9LhPLYx-2paBBnD7kuJpyVqSga8E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHZh4CTV8jhjSvelovMAvjb82Ixkxve3zjUsgwpsEEFg&oe=6AF48772"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6l3s8qGznYsQ7kNvwFaoUNT&_nc_oc=Adp763NP-GhWONAizaF9GmcNUUEORjwAw2fGqK6vs45MlFyC7G0AUQCCTUORwS4tcEg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdI8K5mM15C-zF9Ycuc4u8O2ewMNr3eJz6XP6bl-jQlQ&oe=6AF47ED3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JG_Z2SdHtEYQ7kNvwE7Im5M&_nc_oc=AdqYWAKvrkqzjbhs0V90xYQI1011q_9qVmu_pCyY0SCAHfrEZy-w_pCtuJpI6RgrJJQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOQoIyBZ0MCocTngo78bFZ_KRdpJVLq96dO-JpMy2wgA&oe=6AF47AEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4P_h63S1tIQ7kNvwGD06ci&_nc_oc=AdojBSauvoSbmxK3O7LT1RQfrYaDTPjUKQQQQzvipSFc2lTwHanl9bdtw7wnJZeWTW8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVCVd5xQkNJk4cEJzrfAkZHCPOv6wyyzyjd2HryWGLCQ&oe=6AF486A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
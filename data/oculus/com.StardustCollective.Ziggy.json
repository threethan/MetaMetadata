://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ksaSm9ZenIQ7kNvwFTs8nW&_nc_oc=AdrdzXmBcyE6HHjRK0HAqyyMVPhJ1SAo0DwOc7E0QRkFPNMqHz8HbbDQ-5NfXuaBVPY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxemKQd6o8x-Wx2_Ua1yOZL7gwsGVgoiaHx-pu-Fi77Ew&oe=69CBAB26"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47yHSEBCTpYQ7kNvwHgduSW&_nc_oc=Adq5yPiI5D5GrD1SZSlZhCQ8Q3_bznIPVvI0xB4IsHMhm3uBnAGhqKj5kvQa9zNsGIA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwrXFfeP_BJpnhlKtVt7vcFKHXhYR5zfsAFABaRg_iXzw&oe=69CBD8B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYR8-XeIyDAQ7kNvwHXsVGd&_nc_oc=AdrutcZScAIyrtGGjJqg-ryisf5EXRYEk6eHs-UPa_FmGFL-njiBzLx5sJa7ouMzPvE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwabVIwiLjBbc-64wPsYZQR2BbXEmghn-AmsV-GnRymng&oe=69CBD27B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okewTs2jiGMQ7kNvwHQJj8L&_nc_oc=AdrtgDminSyBLNReTBDtvwafDKQP9X3RH1lLqC5QC6z2iL7aAwo-LkAFksRO5qmzNlQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQ-nINXtdzLnMFUdVgiKVwMXTRWh3imHI4gos1lNfVCQ&oe=69CBAFB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJpZ-dX76vMQ7kNvwG7XzlH&_nc_oc=AdpGAWjYWxJG_5E_Ygz_02MIsKemS-LBRlbg1sbQ4j15wbuRAVJmqsy7nwR7C8kLV0I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyyqfbG8UQkMNNys_H-148kPPMASwumEv4721KDWGZFjA&oe=69CBADB2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6c6etC-yGVAQ7kNvwEdyBye&_nc_oc=AdpD4oTOVdzCJrY2ZoM8COLKqruuefcUjDqvs2txbfH4n_TafYySHpqOWDIhUt98284&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQ5z6C07vVE6VSPAJB0QiN6vh7sGtzQ6bAslCzf9E7RA&oe=69CBDD53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqA7lLDF-HUQ7kNvwGf33Hg&_nc_oc=AdqJrEnGxk1aOymBFpEGVmH2U2qHSh9jAwn7QxTtY9Ct66pzNgHC2WWr6eSkRChRkH4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwxXZ6SdbTOLWcEdeuCDA--huv76o-BzXbOfxvs7WzW6w&oe=69CBD96F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnsDOVS15JUQ7kNvwH5GC4F&_nc_oc=AdpeQk_0uZUoIqN2N9m0BVB8UnYzTy2RihuTHqOdkFGPy-sI00g6I6xLn3EDFVPacNQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwuEfTaoBfhyZ18ZtaRm-c3-fX6Elo2dT7pl9dxTx6yaQ&oe=69CBACE2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
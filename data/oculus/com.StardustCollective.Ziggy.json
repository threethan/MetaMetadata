://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEhCwU9Oaf4Q7kNvwEauDbl&_nc_oc=AdrbXvIFP5sktfhUmiNzF7GbD--89TgjHQlmQQr847sfmUwfDDLaiZ2TqOj_L0VXJZk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKs7qhyq64YP3ojq8IDmtGzvFNjK3Z0h3HTrSCM8Eidg&oe=6AAD53E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CB-r51l8t2QQ7kNvwFHhF8Y&_nc_oc=AdqT0hlUxTPyX3o2Wx7RZOs0SlvabqtBgA6mt7PU8woEg_HSHkQEp1iIj6IsrkMux3g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmgI5bN8I9nWOxa5Sd-YcCboNZ4T6_Hd-BhLMp5fxmWQ&oe=6AAD4932"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9sopW0ycAEQ7kNvwE-2Ts7&_nc_oc=Ado9-BF63uc6S_V42g9WULVhd_YWF49JPoYqW5OBl9YVwUfcEMy4UkbU72cwoLdlkS0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRChx_sOACncGs-tS-u1c41IILK0Jo_VHfp4Pz_gil5Q&oe=6AAD42FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjKyU_FZXsAQ7kNvwGrYgmC&_nc_oc=Adrrg7mD9-U-RHw3o0AzBvkaU5fcTCvaxk_id0W-Y-GK3VU2hUyc_g24ZMzZyj6__Qc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjw6ZeDrvjdnn42KRLydJYtzMhqHu3_bjHiZdcwvf6qA&oe=6AAD5873"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIBYjbJ0woQQ7kNvwGIa-wA&_nc_oc=Adoi9SnBCpNbJVejimHQRGOIwDIvkR4IxbPYggb1L5n9EyixUEk5jG5TX42JzrBcVrY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmt_qK6IdDfwyqsUZ1_0JAtX450iIeAtZ_sG0EdLF0PA&oe=6AAD5672"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9xQTq9xapMQ7kNvwGX8LqJ&_nc_oc=AdrOtmnGM_QAJztSspMpXxl8jmktfXrVcws57vMcizkMxy86AhXrrm-eATXiCE97Sc8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgNJ6fVhhoQm9HBNllD-9axqNmzibqdMiuXjW4n5Xpng&oe=6AAD4DD3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zn0CwGbL3pAQ7kNvwHVXKlY&_nc_oc=AdrDUs7fx5FHR2HUFzSn9icsNZ5t9bSXaajTdlfQh0husydutTKmoi9VBOKBB-k_t6I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoiLlA3PTX2nneps3OTWTSlsOZ_Wq6RVLoWpgp3UpjUQ&oe=6AAD49EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIg2doElMgAQ7kNvwHURTl9&_nc_oc=Adouk57kRyGUIWh2wUwB0uDXnnLe_cdHtKm2qvQ6d7VYz7EttpdCuFmjdfsgYlMiQ2k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-l6nX6gl8JQzhdshNbTVDQYSv6KCsSbVSjSlwJpJRVw&oe=6AAD55A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
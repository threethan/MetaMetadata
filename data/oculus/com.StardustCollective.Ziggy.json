://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7F_0nK18joQ7kNvwEcWVKm&_nc_oc=AdoLc98GB2q1HPojVjoXwNgbWym44Swhwl2wDOjiZStpOBHub8ki36a1M5QS1romLCk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04CDR6nGSPCTkafiK0OXspcSyiZdjCQ37vYRHKDBcQ1w&oe=69D8DA26"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6-t3IkG9hoQ7kNvwHN20bV&_nc_oc=AdoMyvCvzzA5oJphAZh3q2_Ljz9SvBObHu5Gf5nJU_6Y0UOfL7OKs20fxAPIlUuvLYs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1486B5VWOkmaGpwK8ISspdDjLR92cOxysowvccFXHX6Q&oe=69D907B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3HBvv2D3a4Q7kNvwGJUk2Z&_nc_oc=Adr3_bQ2wJlWuobXcJ6Bqg1adgGlQ8dkvvsFVam2vvDnukwSL5fqF-O4PnPeNU7jo1A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tSJv6tEIigcvtwZ2vHxKzS_88QV7VeYAFDPD_HdUIqA&oe=69D9017B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Frghk-7ttv8Q7kNvwFgCKQT&_nc_oc=AdrAXi8CG9aDA7V8iUrZaN-bUKbyQr5h1P-yB6jRoF7jvY5Pf9kbO6svHoXsZcsjRXM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29Y8fXy0LcR0OJecvDG5FvbSImlDdo-9OJLYM9SYYj7w&oe=69D8DEB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iu4T4qUawlQQ7kNvwHD9I-n&_nc_oc=AdpT0lkBkG7BBrLuru9hTKgQuU7I71dti8vRhG-fC50gn2Zgh0bSS1dBQt8WvyaMbHI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zC_BTza7c0J3rcqGp6pOAJGisfywDLzaL4iVGLvNqRQ&oe=69D8DCB2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRryL-BPXYMQ7kNvwHUqZ0s&_nc_oc=Adrl94AkITRBQgL_cBZIjhOSnnm0hKw8BPL-6KWdJWHj7iOB6pfYG4AJfFjDO0mySc0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TVCUCKzGJlGtp3wJW0qibWUklRQsS9iDNdlXTyVNHOA&oe=69D90C53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ph_iEldEPBcQ7kNvwHnET5-&_nc_oc=AdrFavatwSh6qSSih2cS6TYcylODm4jc_j9RgfzkBLaZDGGOtBC37UTeJtPoUsDTsVs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kz1oXFfET4sSFeBx--OJ_xvGa-UyLfmVz8RrCtsT81Q&oe=69D9086F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJ4EY80hF8cQ7kNvwHxvJ2R&_nc_oc=Adr6gEv-cvyve4uPuW63oUGbVynIaKhhBLn4AgmFMhArYlKr87dkuiC2qpp6i1Ib_os&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07_ac2Qsnfbv1OoMuF8wxZUbcxPSN9tTyW0zgw2OL_pQ&oe=69D8DBE2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3gMhzwicXkQ7kNvwHqJpZA&_nc_oc=Adqitc84KkalQ_gNmoDd_Om08XV8aGHxaLse94o0kA0LbXpIbaSm7OtP44sqXBLW7qw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BmcmZz92iTslaaCq0S0z4uAj9gtl-TGEhXOu_FF7obA&oe=69E4B7A6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHqwNH3eIHAQ7kNvwGsFsh4&_nc_oc=AdpSiQwwxvuGH5C_yNSwC2tiFwUF-6braFFEeZF1NQh0tcz8jM0vQHcPFN3hhOyRT3w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nchlNZAoTtKw8N6P7lMU3QJUF7za73-179cinXu02GQ&oe=69E4E532"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAZFMz0uQRsQ7kNvwHeCNKs&_nc_oc=AdpObGk1H4EiBNg7w5d6zNkaREY-v336lcLwa9xoMocGAlx4TctpZaiDZSWcJ-42GsM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jhxZT2LZvAGVSip4KBeMc_3-FAODjUrOhWwGakwJw0g&oe=69E4DEFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ool6VIdopNIQ7kNvwHXT1Bm&_nc_oc=AdqqHrIBu9ujsUyeewIUCf7rPJj20rsaH3_yVTX7CVQ79yQsUgjjx6qoEwBq98WV2qQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Gdy-oLuX5nHhhRZxYP3UuT765Z1GKT2ZAmo4Axe9T5g&oe=69E4BC33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jY5aVWUWpZAQ7kNvwFkFsig&_nc_oc=AdpYIX-gyjNnSknmTflSHvcmkqgnjmWHVwTkkIvTxKJhS9aopPEi5fkRzzvx-wohFcw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pIts7eJOYu92wsugTUHXY6z3ss8i3w0FJG9lMJtn6_A&oe=69E4BA32"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DloYo6BghFwQ7kNvwFLnGId&_nc_oc=AdrlWFv1o280TzZboqQ0dXFl5YoUnvk4eMC5IEdf-a7A978spjgOdGW50D3-9lYEet8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19aaBRIaL-ZRThQlkzs_FnpkItdP88XOBD06cycnUjGw&oe=69E4E9D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0orWX2LN2rwQ7kNvwFc4AJl&_nc_oc=AdpKSB_YCn-vjxbpfvgx-537iwO0ObLCEzadlKZ-uaFdbaFsS8_nu47SyKlcxp_rl1s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3psXWT3BSw-H_CbBvDHJK27eOx_K0IOaEjT9hwJBKwBQ&oe=69E4E5EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvQmiNx7pEwQ7kNvwFttgfl&_nc_oc=Adqs0vRloTlGsPkiY3vVpa9p7Q2eBY3zlfYhKugPcAGUou4ISo1Egfgv0U_7-2yu5dU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2x1ITyjbPhs5cYGPOGOXOGFDI_8yubODekftW1gPcTIw&oe=69E4B962"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
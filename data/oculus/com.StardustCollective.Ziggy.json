://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvhRA5wHjZoQ7kNvwHmYo7f&_nc_oc=AdotqjwBSQskExR23SK-KOdMMzaTksIhfDeclZ_DgZ-FeJKmXrHkDfrY4ZM8L4GoSXo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6f2lqbclCzEXc6teKf0AEHmzB1rgqFpZ8c4fBPQJjbFQ&oe=6A1465E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVMSceJongEQ7kNvwEaEPLC&_nc_oc=AdpyH-uDfocg14zYOFCjDEebH17Mz9OaIWyWv8JS3Uj4x74eBRy8IG1OxoJ9HsyBZWQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6o8nxftgKwxBeEgc-W99ocGgaPVt6pWnE5UvNRJUyviA&oe=6A145B32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUh0SbZVYTwQ7kNvwFVY9Rm&_nc_oc=AdrXsI875YO66Yll26ER1RfPVQ8wcpM5HIFUIrl5cSrZxLm-xHxvzU_nt5rLXloQykc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XnXd4xCTvPds6aa4xrCD9t2C0XlTqi0Xe9iOT57QSbg&oe=6A1454FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FL0_f13upBYQ7kNvwF9bj-Y&_nc_oc=Adq7DttbLa_4n2I4QWGC2_fk4Kg8zC3lPeZiUhOtGe9e7vkENI-uRuaX5Z4hCl97Gy0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70DHRKYEFAVYznSQUaidLqc4N6BG2ifW4167ALXrOwQw&oe=6A146A73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t283innD3PUQ7kNvwGeqE0u&_nc_oc=AdokUYH-02QKepjlpfrXzyIPhV2Kv1VsDD2nOyRMVQvkGhL0E_e6dmEF5IvBRPgfas8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lVWONZtiWxCQ1m2_Izg-ZMpBGELkpY_7FnWVpXr2-kQ&oe=6A146872"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-JENoYhcPoQ7kNvwFxtvZc&_nc_oc=AdpxxkgF4qDsBN3KjeSa2QnaK3k6F4NFY855iyVmx1emyXvQ2As3L8SQboUPEcFQdic&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XHr5QOLhk56p_k-9STpA5kdq76Ye97rnE91Dk80-H_g&oe=6A145FD3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=91EDiX9VaVAQ7kNvwFjzcCN&_nc_oc=AdokAC9cTwLMVorRm1AZy02lO_r1SipsPORRKJOKxcJuTt44bXVuP-5oMA8WLFXCQEQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tcKNdKKReHmzMu8ZPJ6n76KFUyOGJKJwdu56FVHKc1A&oe=6A145BEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMqRzdo6PK8Q7kNvwHW9gDD&_nc_oc=AdoOZ_kPfRG3xXy7zSiQ8cmv67rpeHDxWXRGX54yCb7SQT0YRj-qTSJgu3-lFwY858Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7P-CAEO-qfOjnzwyDYXH94cjRYlRNz0mv7R2Btzj3upw&oe=6A1467A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
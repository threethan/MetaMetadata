297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ahUF2uIRj0Q7kNvwGfAG1E&_nc_oc=Adq_ujY3AtDLOgoJ4ym6ejNxC4oXTYbaHhNg3Fu9cZ2VJY5dcnW28diSvtXk0rhiGys&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwwu2DrhQ0tFIs1Lu_n4AHszZzLPLXg9GD4Z5Mubr4IwA&oe=69C11F26"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpBygzxQ2XEQ7kNvwFZ1jmw&_nc_oc=AdpWrM5xwQLySffsznmc7LSXHUdOjIrKDxJ1HwJgPlxlTxo2Nl0pXkBm5FRhABpP85w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxB68vC5-LBUecGI4U1V-nzbShStMFXrJN2DlpfsTiB3g&oe=69C14CB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Luo5fnnwEgYQ7kNvwHgxVtm&_nc_oc=AdoiUTdWypu2B2F-6bWmNa-dVvMM8i0bx_nwf1WWIqS1X2QgdK8e4sibQEgrfGFNNIY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxB5EtEh8NvYfj4iMTsZYPps3Y-FyPyfaexV6UOdx42Yw&oe=69C1467B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_o00Yl86SrkQ7kNvwFt6k98&_nc_oc=AdrULx2LUL20xzLHZeUhfxqtLncVFboYBR3JAHUSWfvrH-B1HX2c9vUpIoUjb4qje2U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz_Lik9FpvtX5LlovFczvP4dBLqc6rWPQZ6ySyYqZ-Fcw&oe=69C123B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKETgkPLEuAQ7kNvwHm2CI8&_nc_oc=AdpGtim7Ypv0e6Zim7PFCYBDMEbaGEW8RzAtfK82HZerJ78_e43OrJ7Sn7K7lanQ3Ws&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-mc8Z1mr7E3VgV3vWbEjP5fiCntBODVctLhMUF3FyNA&oe=69C121B2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_ATv-AvCP0Q7kNvwGYAjwB&_nc_oc=AdrKOTbmu3XM27_3oSELpMOLP_daK-9UPHtJjtUmFixkCfJsFva51xmDH7yN7Q2n014&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxYfkjoHFr-UIENchK0gugbYQe3LNsP7DydhkqoT3oDtQ&oe=69C15153"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3imNgL93vjsQ7kNvwEN0C-r&_nc_oc=AdoloY5yEkgV3cSkpMzC3H_92Je8xe6dzILnlJthZg51zLwrlaZ1DriPIpl9d10Av1U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx4OVk38foRlzmh6x1HAuIGg9XmJ-T8QH1I803i1UnVSA&oe=69C14D6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dx4AL9ijJZcQ7kNvwFjij6p&_nc_oc=AdqSNrSOi3x2fgfmdw5zVEcmYmTFVdZ10NSlrcR5m9slG0tbuazce0D8hx_YG-pX_Fk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw7bKzHK1hguinFbRd_x1w5tvPcJY9dA61wVmgwsb3Trw&oe=69C120E2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_5218087471640407679_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAZYf4IG85IQ7kNvwEN-KlQ&_nc
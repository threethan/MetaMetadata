://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmeJFASf0bIQ7kNvwG0Cagn&_nc_oc=AdpNgPlOT9Vn3bgx98LT0y44AJgDqPiQKOezCHXosHGE0Vk86c_oqWHNjEvq5Za1PsY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgaMsQdMH9LziTxuHsEBq5m3g09nVB1UDymO7qml6Z9Q&oe=6AF1E1E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QKuUG9UDu0Q7kNvwFaZHUC&_nc_oc=Adr_CTNq8csSgyqNZH2nZ51uLAgnaYGX1wiwnQ4xXfaAdp3j_84WvYyDbzkAAaJ1XuI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHhwvSEfWb4hBuCAV5MJAVg2-6h5ELUwtgM_JisKolxw&oe=6AF1D732"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=758FGbHUOlQQ7kNvwE5uR2P&_nc_oc=AdrGz7drh8AyM7V2FCDcBN4gX_4s22qPI2HSP4e9lllkoci8tWx6moSrn5q6DZPOQd8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEnwHy9R_4tIWEioaSb41K3nwLvqyLHcBhBMLoGRl_Zg&oe=6AF2093B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HDihKH6bNgQ7kNvwGGokq2&_nc_oc=AdrYXKqq7BnRp6koy93OyBeXEt72WNrfTXGOgBod39aYqhMiz8_vwnz8BRT_YH4sIFA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuhFNj5gAs-DFUoAKCkOt1B-lmdg_WbKE6s3NRH8HT4g&oe=6AF1E673"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCjrm6EmlYMQ7kNvwEi97Of&_nc_oc=Adq_EasVCOAf_6kdbH6Zp5zdDXyJN1hkkFx31CBp9SeK0h1Dycg0NKKDqdvHxcfRlls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-zKnhLMhRBUh21K2kDjl_Q6d2MK51kLja5WIJ63i05g&oe=6AF1E472"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaOpp-NxpuIQ7kNvwHEOEsQ&_nc_oc=Adpbn_-mpYWJFwVa_SzbnyX1eqKfNKMq5c_qudMLezWoI5cuB_n2GaXLqEizDkR4ysc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTF8QgWPVZq_OOFAG-hmNr8w0_BJNhEQK3gEPG9Mlex6g&oe=6AF1DBD3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JG_Z2SdHtEYQ7kNvwFBc_CZ&_nc_oc=AdpN0e2cJHANXuP6lncesj9dUUC8FIPQ4hluUuWZ3TCEuNL83Mj_AyxrvIhAlOBIvfw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6RF4c_l_nFSWrhFjioq_hRpFltVajgAK2-z3DuwN2-g&oe=6AF1D7EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ynx5Y3XbMOcQ7kNvwG5Yqlh&_nc_oc=Adpl0VmOwl7TAsVffelnsECcsXCGV4Hyjs2AeaFV-9GgSy723BEMojAM9FCSEdiw4Ws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrv8R1GLbVu4xQT1fbNQUYXKRMgq9IDa9BsBJ7QUYK7A&oe=6AF1E3A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
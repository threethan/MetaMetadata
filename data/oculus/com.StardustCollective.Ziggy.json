://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVKpu7DD-HcQ7kNvwF_KVul&_nc_oc=AdrkSxa6MhimiLYYse4Gb5f0OlY0qG-i0EyCJIfZDtQayTJZN5I-lrp61vneNl2e880&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjTeL2CcyMEygSq5BZQ9hIS3MEWNTcYdgslnT7NlePBw&oe=6A9D81E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRo4XHEVX_gQ7kNvwHA_pge&_nc_oc=AdrNi4Vh5aCWt4yFhPhIBy66NDZkAbf60JtinX7Wva3b4rN7X2DzhXyeVXH-GePnMhc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhKUHqN43NaIYj0rpCcIKlrUyZSe6i1vfiDMYMpb5ImA&oe=6A9D7732"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzidItOMxrEQ7kNvwHpNfyT&_nc_oc=AdrcG6XX9Md8I4yjujsDUpRShuzO-b3xgBGkeWJGsznymCruyotc28K8s4NOpljYmrU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIM10lNmkkpRdDOUdhT11Rdh2Y5VxlUwmwhXFnXS0EJbw&oe=6A9D70FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTt-2KnIby0Q7kNvwEB3u9o&_nc_oc=Adp1N38oGqmlA7BkkjRXW5JSWtT2Tz2uGFflCat2u1kx4rfqJYz1QSU_HbHS9Sxq09g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6F_QeUp4HpGYQcFteVCaxnTRyWMXBQA8jDgnLqdz_Mg&oe=6A9D8673"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cf5GYe4F6gkQ7kNvwH7eIzG&_nc_oc=Adoaow_UCk3lsPjSStkaf8b03tQz2nRmUbAbbcg4YBolIWYcwSMUXsnYsLOoQ9nHn1A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDJPm6TA8F8Zv5Aw-ZBkzj5Tq4N2p6WdSDdaZ4xbvSqA&oe=6A9D8472"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVBA4vXmMQMQ7kNvwGuDZA0&_nc_oc=Adoniy-72oGhDn4tuZ7Kp7mKSuz10twhIywH5IIT0-2lvdtIBfaHkSHNayAs6K_Ojjw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRAFznNgbQOS8Q3Y23Eg4O26yiVPSo36g59UkVlfO_RA&oe=6A9D7BD3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drxmCIGV1kUQ7kNvwGBO0Dm&_nc_oc=Ado_AwGgCFrij-TohErZTMbMCTefEELCezEAhd17_pTyq-7Qf6n7fcHU8v-4ZWUUuWc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIixOI944paor7jVCyfJh9kWiggTb8DUDfKUCNOjqMLwQ&oe=6A9D77EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qL5sBLNkM84Q7kNvwG1LhSk&_nc_oc=AdpLnt4O_LF7BLIoT6GZnJI7SoLGUtemUUH4sLu9N21elTLIT6uaRN8qfPn2Uc96gA0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAR8SihwLIZhTXs0dR-1gVDHA_mPhfrmBmxwdTukGKsg&oe=6A9D83A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
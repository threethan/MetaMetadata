://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmmOhSJ_1b0Q7kNvwHY_iVb&_nc_oc=AdqbJlfZRVmB7Snc_31gQZNIC63fat8kmb5pYvZsNhRu9ZkBG_gVQIPCNgKhba2zT4U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIh9-QrZwWJWSfb6bcsRCLU9zDrh66_jeoMnHgWhnplvw&oe=6AA024E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGsPdfsVQCQQ7kNvwEnzC-N&_nc_oc=Adp1iC78Hin-yt4m0niiGqnGnhg3xIrgF_yNdGbNVwM1QRlnp0cmwnCTbudq53jLwO0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBopCGLaGwDNzFJQisfc7S1XeVmgm0zaQ6zPCg76EB5A&oe=6AA01A32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RGtyg5CxAgQ7kNvwFK7g9k&_nc_oc=Adryu7Jp1_QW01uhUqPxHFZK1batc_FXRtsf44HNV7xRI_mNmQascQMLiZ4PydbOFTQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeZe7f9DD2YBAp2F2vqyvdOvlywWS1aOG2F8I7ueW5Ag&oe=6AA013FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teMlkUImr_sQ7kNvwHBXiV-&_nc_oc=AdqTvDaKfVtYhuQ0BfVXuQA-krh1qDt2nIPfZZ3sLRFuexs7g2ize0L3j1-yQoJoxAQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQiN8esjBpN2-4e5Q7Mh6PP2d7J-2RK3QwiD1jyPlsmA&oe=6AA02973"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HysH_-3VQbUQ7kNvwG5AIf8&_nc_oc=AdpMjzncxBeua-qukmSCYMrENawEbN0aXEqJlXkHs84kzFxyUxY8LWGhq9Fkm5QyaSo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5_bzr9UiHkfenRbkEBrM4NivrVMi37-5lPtk9AWGxGw&oe=6AA02772"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RC8zYPYRVkQ7kNvwHyMp50&_nc_oc=AdpUbxXYAKWAIqnZ-G6IqIYdbAZMQ2hvZFTUnsRMoEYwY0psJIbo5clAMgdqXIA95-o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlECzsLdDBPY2OMdltATdfAbeE4Y6fz7a5199G95AmsA&oe=6AA01ED3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oj_Mj6Ppa_wQ7kNvwGH7127&_nc_oc=AdoUQ9BcpIyy-6-osjrCu2U8rL2a1q82CjfvL7DyEMRj8KCKaCiXCvUNO1Vy4JfSa9w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBrriN21kROv949KyYKL8SCML5J4LN8wRXDdXb74CZhw&oe=6AA01AEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qL5sBLNkM84Q7kNvwHdeI2s&_nc_oc=AdrzpHO7BdzKgG9Hb05YLhR-XdOAHUyqoZktm2k7Anjp1Kr9eLoQnDbFu1pNNM0vF2k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMmlUt74nyya7Tw5JQlzmbT2CB7XKv8ZAIAouMliUgdA&oe=6AA026A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
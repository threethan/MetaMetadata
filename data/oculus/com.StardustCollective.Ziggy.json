://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wjdLf3dzbQQ7kNvwG0SjGu&_nc_oc=AdpMCtV-JMX3C1rjvw87Ktf9A309HakOWWS0whHJ0ZWiSzM5Wb50QOxsr82fvCPTj8s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXJmWNQP5kYlCwpVOqPBOxZLX0U7teqrUko6zGletCkg&oe=6A720066"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwrnLhGkf7gQ7kNvwGCLSUR&_nc_oc=AdrZ0Oo9lKm2Ep8jNm6Ky1Z8msITH8Mt126ZiKvUo-2Vx8gGgTipzMdS94OZVuT_g2U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzFa8Nn97D_VEIoOZvQc2fj_8GVLTT931ogV-QDFHI4g&oe=6A71F5B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztavDlYQEuUQ7kNvwHuMCR_&_nc_oc=AdqMB-GnljQSXL2OayAw3rIgzuAHoeNdnTPbC7stiHezhYhP3cydx16eE01L7o3ToQQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZvHqf6CL07u4BnScc5zDmXofO5kpC6qT--ZySBmfzqQ&oe=6A71EF7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TN8OXaSO9twQ7kNvwHUs3yv&_nc_oc=AdrOH_X-q3ua0piRqxLQU3idjebV2EQmJF3BFQgsO-1awWNN5JdIFdV8EpUTUQ1ONQM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuk1U2zUbxsoQzXKTQkopHI_VEYRTFqJwiONx0MRIGdQ&oe=6A7204F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTdigYJjDjcQ7kNvwE96XNR&_nc_oc=AdpiEh-8eAHW1z_48YgUg07B9LZh_nWsLr6Vg-SmNqKWYPnJpeKFw__69b4esaLkSGI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsb1orUOBNv2sXUmCLAeUtb6kPMnj_dvlc99w47c2mvg&oe=6A7202F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwPf9J2saUMQ7kNvwHyOHbc&_nc_oc=AdrYZm4nft_1w3VYhnwhfHBAFWQphxM5YflfSI7HGO2DRkxTDBFxSQxfjzUMuEfjM_A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlA-bz5sKxgKEevFuVhYX2y9qZEqz4A-TPg9yWDSJyKQ&oe=6A71FA53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohjzD3n0tAEQ7kNvwEw75Op&_nc_oc=AdqNtzReneOMjZG17imNAlfMTZK6zNde3cu7Rmj2rhKSsOms_Z5EQQBXnztcD_6feBg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYOgfBBCATZcyi9y1-q-ltc6Dj1A1kZAFM_vy7Y5ZPEA&oe=6A71F66F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKn0jE-MOlgQ7kNvwHH5YTZ&_nc_oc=AdoYcIjr4_XljquCDo7NVDD3O166zhWtuktoqdEUikJWpCXuOMzx9RCD_gDYvutUc6k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbAXnAFJOzV_Q3smGLnxHsRH99Z00udQs82q0IOCOMJw&oe=6A720222"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NtLZlWomAIQ7kNvwFlNXI6&_nc_oc=AdoiVqJlgAZMVLcueB86eNZenRqvrq2g_gkDXNm7MWTfhAVjA7G-tUVD5RKGvhYvkQk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7i-ST9o_owwVH-am1592FGpZXfTA27pwQzb5QVK3IXxQ&oe=6A1AFD66"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2GeDFvrMc9wQ7kNvwFUdOeY&_nc_oc=AdqJzWET-LSY0xs7M45GVdNsMj_THHrTjcwiRd4SGwXO8PM6hJoMB7i07ybGLZFL_M0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4attVq9QfGUuhtR7j1E_iwzEeiyDSsGyokKAqijf35SQ&oe=6A1AF2B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlYaauoXQg8Q7kNvwGR54gu&_nc_oc=Adqi5vbcquJDr4v90eOWuWgFKvDN1vnGcjH7LZfeogi39hyhQexwPj5dK_W3_TxDxxI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jnrymKLwYlUMmaOAyOGh7lO7F-ElavWF2f4dBhfzqgw&oe=6A1AEC7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rOgulmSyRQQ7kNvwEHtoN2&_nc_oc=AdpaIKD9en4L0D-shjA971eWqxyiAglAt3Axe1CRCjSEbe8DsdNAgVnoIMJreNZAJtU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GhP4EjyFRGefJIP7LwSu-Cku5t6Y3Y5oP7YkBV0iI7Q&oe=6A1B01F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=019DTDpec3AQ7kNvwF08Txy&_nc_oc=AdqP8hw-_zVTX9QCNCdkm2nl5PWwNfRDTNfdtmZHWOLNOeTzhTUpp2QExP3z8t8SwqM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dv_9t2U8Lwf2mKNIf2P6kUEajS07ZzPGuKTsMCM0Blw&oe=6A1AFFF2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCKR-nvqDhQQ7kNvwEvMLiR&_nc_oc=AdoSmkxtX9nd9AWQu4cmyWSJWuAlu4MZKqkijUcBfyBe5hX29oTSIX-aSLZB1MRut40&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZpmJehhPPcF491JmfE1SzpdKr1PGHlR5kRWgRVeXCYA&oe=6A1AF753"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-2wpzAEzfcQ7kNvwG1XzQ2&_nc_oc=AdpoM46zz_WrakbovDUNd0W0vwdRPr3pGmsnHd0ErNtet1zLsWeB72NeSJ0uElhlkOs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PN2TPdq6DYYeD2MUWCGfD6hdamZ5Pen2Wqy7eYMQJow&oe=6A1AF36F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLqXoDChmZAQ7kNvwH3SuMK&_nc_oc=AdobxjOTEtQeC5qQcapMaGkxA7WawhqVCEZGNjn05R0CRUVOcyub7RoIz0OZijVRp8U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4u-NfTupOvkUnwuS2jPzpAUIzLiuUJ9wbPzolSZlwH1Q&oe=6A1AFF22"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
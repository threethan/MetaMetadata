://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1H0L7Z_HktsQ7kNvwES9Oso&_nc_oc=Adrpag33If8lST1dKnU2TJrfrQVo0Kfa95PufyIFvjMvMVC8V7hXa5e0ssCT2saXRUs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD81GWgsdj7oJaQCVfWmWsVjxjwU7_yPdJKk5sTBIWxdg&oe=6A58F3E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGtpT49CGmoQ7kNvwHhWQNN&_nc_oc=AdoXKRYIU6zjWOH_9E8PpraN99dzvrYnpTFFxs7C4jmHPLM7X2jalHLod2Kma8udIDI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpvZzRjhUYNbYhteyNbLetRbllADuJJp6URjL1aJlx1g&oe=6A58E932"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6t1QsFCiUxgQ7kNvwHzQQm_&_nc_oc=Adqijvq1debqNxVQbNjZtbnW0rE2DWs-3PN76Mr6_2iJ1XSf064K6Ec_8pQGS-SNkDE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYVR15GmLH1CM13AidaJuE_gsLSDBP4mlSBoAULAZ7qw&oe=6A58E2FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7GE93-U7rYQ7kNvwE8cPnN&_nc_oc=Adoobk8BSCHb-tbr9n_npTrGGHOam8-MLFD3GgetxXqNxa-RUOnt674xPC4stJ0V72k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAL3Zl9NSehv4s9TiITZQtbjJaZsTP2TwrAGVn2nbzW5Q&oe=6A58F873"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfr4UQ5wGzAQ7kNvwFul9Gt&_nc_oc=AdopwXMCAxqSBjS8KUnrDAdmFTkro43_o8A86sgzNNRK2BKQxMwUjdQZjY5aN2pTvGI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhNSCSFcYNGvuUem3WXADnhqXM1f-mRYb2BVAtQq7XdQ&oe=6A58F672"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxMq-BoOiYsQ7kNvwEB7Dae&_nc_oc=Adr6ltKsgWDgoZgimRlIJK5L1mzZTxqUixxgJxVFNc2p47jdTcykhxZaua9WYnd3UQ8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsa0aHXfVZuOy4L4KlHMOOsYxltayBHk4hcGrSe08E0A&oe=6A58EDD3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4lOp0N0x4AQ7kNvwG-eFpp&_nc_oc=AdpbyB8JNHRyukMwVKn0oUXXLFl2L4ulezWCxhlMy0BSy00g0YfzFj4BBm7PdBG9Y4Q&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdyIre32J0SBIV2QrDOd0tataE6BGClYAhieAi6_EMew&oe=6A58E9EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUI9bLSGKrUQ7kNvwHeHHhc&_nc_oc=AdonVs9cMeW7_MVtaLOsF3aSDBaOF91rpOf5nE5tMFn8ygTJUc9skBcuDppvVDnB9jI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_LeaN6SBobZZ5-fqHpGm3gG2l2PmROaOsNvQ2tswSzA&oe=6A58F5A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
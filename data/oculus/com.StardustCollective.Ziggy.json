://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3gMhzwicXkQ7kNvwFsL-oA&_nc_oc=Ado4QzdhMvW2cTg8BCFfaOMYFlzeZJxl4oJ5WwQJMtDJ2QObZbqE266fkJjggONCT7I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Xd4Q37RQ0oMlZKU51VePyJrLJtI3wuB6Qu5MjVbKkCw&oe=69E36626"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHqwNH3eIHAQ7kNvwFgcN2X&_nc_oc=Adp5cfTDiArbKdEdwwnw50QkINklScnKwK_EGgZ4dymOsEo6NmWiz9OLD1W8tXiPsVc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZC-YVqJClL3ptJlmHrG-wqtEo2E6xklUZhqEMDawRXg&oe=69E393B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAZFMz0uQRsQ7kNvwEoij1x&_nc_oc=AdorLTw6ctlLiRG0zIYS2UzGQ1uG3EmOVcwqeOzO2qSN5Wmtop4wMi9ews6BtC3M7oc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lluzExnwGr0iiXtMgANVrgzIye38NvBx4I5eiLccmHA&oe=69E38D7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrhyzrJvuLwQ7kNvwEPNZQs&_nc_oc=Adq6ob8IlSRWlywrtDNes-trlPKO7VSDAOJ-LzuTMP50YeX5hGMgD4kgAIUq9zTJ2-o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3T4htvyUAR5FqcCpYiZMBEKL6RFSPaK6D7JxYtm0P-dg&oe=69E36AB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3h4XAkx9Z0Q7kNvwGX3twl&_nc_oc=Ado6kXepca3W4kQHFkurhVCHMMs-QcHCDHfw4dO3QFr7JtRaMMyuR_EErFwA3AOgsjI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pblUbvSnS8EbCDVngi0XyPGDKAiU-Goy1BeVtO8bKgg&oe=69E368B2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DloYo6BghFwQ7kNvwEP6Q4d&_nc_oc=AdpLUsWW_cWB9M6fb7zB5xuWA2cfLB9-0PHdkpm7cZt4QPDQd65k_eRhBlYN6UdxUsg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Sw_h6iaxXJHvAZjKdyFWZ9bVHitzAnRlgktnRQH_ysQ&oe=69E39853"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0GxSF5nMr0Q7kNvwFf-lpl&_nc_oc=AdqvV4OhFGv7HhHkdSsJm5fg9nBknhDZ81ns0m7J-c8Zri84R51kOrJdcBnTBIG5Cl8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DXiBAv7JwapYdSuE-lwKzypRtcSc6oA_VJw1xWdFg0w&oe=69E3946F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvQmiNx7pEwQ7kNvwEYbYVv&_nc_oc=AdqTlv0ob_H687a94BFmfDMrZ47Cm-08pW5p9cka--M-ZVdRFHUMZp0n1g169Iw4438&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0k6yuAQ1AFSkjv7z5FdKnQ1LAi5yaIqON1vcrkQV0YeA&oe=69E367E2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SY4gFd4euzQQ7kNvwHaVUu9&_nc_oc=AdoEmUXshOLkHoTUaG1hKeZ-QLAEtz9mTO0WqSOzExFJUCZb36dQNup0qput4xCNZRs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeltWqZjdrmPCGYCv5Gfjiz65bppB7sHZsJVtWo_Gr3w&oe=6AEDED66"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZFDya7iyxkQ7kNvwH1qmeV&_nc_oc=AdpBRoTOqlLf-HJsc073mWpnyfREhf0muxlZNVsfk0hkVYxr-E-1n19ILX1btnSVhaA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhiAiJj51phQ2G4Zno8yooKqB2oQEOkSQHu6w69h0-Ww&oe=6AEDE2B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAiy-VU3YsQQ7kNvwHQewgB&_nc_oc=Adp7iF97y6xuw-V_vmYVFta-jGFGvIhbMbQ5y9dvKTfmTA7pm8j7UOPfhz1-Yt8wnxw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBMGRo_gblUNa7MzINzuIcH6ED0RO27_PR-v5LApdudQ&oe=6AEDDC7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlBhCq83ruEQ7kNvwF9wYwK&_nc_oc=AdoCWN4xuXdlw0BZ3sGjxTolocjLs33zjZl1xJPvOuKdh_7zjHED7v9Oa0baKahe9F8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRc3m1LC4CFtyE0Ov8IGF-DYLOaBA7pQu9mLuYadJfpw&oe=6AEDF1F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLlG4-r5OBMQ7kNvwFAOw4E&_nc_oc=AdqEOBk5rQhm8R-nl4EQKRZ_mNLn8fpl-MQUi6uaYD_Y5ZoPSiQynbLUIonuo0Krbbg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzZt-qXdmV7FpoDoXmuMDOZszbttHKD0xXdTSP9iLU9Q&oe=6AEDEFF2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfQr37NojzwQ7kNvwF7VskN&_nc_oc=AdrkLNT78nBJPMNo95zprxz46xcHdpFqO1mHAhkHTvWEZYAnHofHqLogApln2WrpRIY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJN2R6dDhPdbDefq2GBkOgwGDIINC7FmNaasXZI1VtqQ&oe=6AEDE753"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yAAvHtwUfkQ7kNvwGA05E8&_nc_oc=Adp0lwApWrIF_bWp6mQdtVRwkcT8Pfoqh_b1qMYjswK2k313GB5xR-v1AsTMxL0taE0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiO3ktR2X5OU1MeWKTJ9VtlSHFX4lbsmaIBu9PtYirhw&oe=6AEDE36F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIhZLsJJPQAQ7kNvwFLySwi&_nc_oc=AdqpzyhHqdwQ10tmg5fHQm88jo3Fp_gCV-SxV62K-_jSv20Sqe3G9zWT1xZ7d9SW0Tw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtmofLLuIpEE1YaJ_2-13KF1lWtPXq2fZv3v_IgT7UUg&oe=6AEDEF22"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=am984PQXrkIQ7kNvwFnxsb4&_nc_oc=AdrMS_Q7pVcNAdp9Y82EkTfvGutqT0PuKhuwXxVKwE8mlncRUkhRs0t1egLRnJcjrGA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFzByCNJ5o2Cv425OTmFW21JNb1ZBSFIlBPQKAfgg8JA&oe=6AE9F8E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVSvhgQ8AKAQ7kNvwGYwdv7&_nc_oc=Adq7gPhHew_WoqFOZRWb4gbb3dp3_DMVnsDJhRYPNx_7OXOXSAqJ8i7acgoWPZ1mOWg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSy2BWwLoe45pglBiltpjt9wYEh4SGkwPLjfzrQqhr8Xg&oe=6AE9EE32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1BFtLVfuK8Q7kNvwETXZ8x&_nc_oc=Adqmk_CbzYoJymJKZI6kyP5MZqBhoK9RKCo-mbPWAoadsQXL60T1tPs8ldo1tczMR6g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQ1_BAXaCXIXuSX4VJJx1HcQIUd-ukXDvlEW2jq6Tpaw&oe=6AE9E7FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CvF8UiU18o8Q7kNvwFSKpfw&_nc_oc=AdqclMAHDc4foZrD4GJXa0eJLyjEiy6VS3kiPyEDglex9GnUTBEN-u6f6buqJyznOyU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3OI3I9b-2OEu0btR5LWM71VTXCyU66-3y777Gp6TIYA&oe=6AE9FD73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vntvolyDIcoQ7kNvwG_26KT&_nc_oc=Ado1KU_R1km7IQKASvLgir0kN8sFBH9YknANMoqd5s4RnzREjfEc6h02Gnz736JHATk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTINK8rRg5cNu0kfv_utpP_G4NS9gqWuZXgM2I3HNEXcg&oe=6AE9FB72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nucILE1KFi8Q7kNvwF2DWYA&_nc_oc=AdrDcIDtfdnodNs1mUWhD8KjhvZZDDJ9vIC-fzCOb4gYoJdBm-cPk5QELTgSA1t_QPk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRn9h7tlZcymk6V1AvH-63s-OsZn7KM7xdc4plRlxPPHg&oe=6AE9F2D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfzZlzr05NoQ7kNvwExk2TU&_nc_oc=AdreCexO7Lvzm2-P0tQqmoUwEuY3abKYWcL8WXlInPhR6nIQYu4JMfm48NjEx-wl5pc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTh1V0jBWKqq64jAcBnU4uEU2pVsOq5ckWCOeNfFwh-8A&oe=6AE9EEEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCCxIH77Q_QQ7kNvwFPRwsG&_nc_oc=AdrNVYcB2lTSCtLUHPZgZGbKMv8CkupR4YXDldG8RJk0Kvksdv0hjDk8wmvxF4bVHvI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrVBVQM_QjYYWfsXEJXp64Cye7b8gk4uVX_3klz2PvBQ&oe=6AE9FAA2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
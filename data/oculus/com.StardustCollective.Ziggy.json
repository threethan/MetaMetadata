://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75zJ-AE6z5QQ7kNvwGl-9tn&_nc_oc=Adrpx8-8E6z3OkCvCe89hG3_JWlUHk_0E0ptU0fCGuzR2d6zXxm-42VtbkCd71uL5N8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPnaSKUeqQXvqqcMGYqX37ehDD50Xs_C_o6pzxkqktLg&oe=6ADE1B66"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRgCbEDgxw0Q7kNvwERS9bZ&_nc_oc=AdrB40yJZK5slblgCgYQxqSX0FcpIuBP3NfaayYoiHUsUDPwidpPm3aJ6pUYOlNFcuw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfRFdT2QKdK3VVER6wi8MgfnyLbIwl2ejtLe_0Sa58vQ&oe=6ADE10B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TQDoiBP11gQ7kNvwFCMnJf&_nc_oc=AdrRlWidunCz2BscHkfjDZyNBOVl3914BDNe2iUw26L2w4uPqDEqUHbqXtc8-2Cm-nM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcSGXohQF4WQrMyynL_KfsZruRE-tA0CNx-lFYI_0ESQ&oe=6ADE0A7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fKwbhiZ0VkQ7kNvwHD9ioC&_nc_oc=AdoRKXA4XKe4aDSpklDcEIxyTHDbskn-9_YMHLfT-pGfsAlI92r5ZNyXImPv6P6XmtA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9kLYGotU8w-_19P5dww7yo_xIAtN9viwQ9GVVw64E_A&oe=6ADE1FF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8v7vSv57HsQ7kNvwHdbm9q&_nc_oc=Adple0rwbHBMrWeTu3b2TyFk5BOfw-8DViqzZBLDxY4O-YNUnHrvqzrNNmuGvL9Oir4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMw1Og_1Td2vm12Y3g8dCdZnGbYEBC9SGIrpRx4AXGmKA&oe=6ADE1DF2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CXEoYXr3JMQ7kNvwHdsK4o&_nc_oc=AdpmlNVvxiDF_-ULvRSVLuC1y9-QQwhMNCtis1kk2N5H_MVJg747GlAA-ImrupZAtBI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtojViTWgsTFzS-9Y8RwxGtjRMRxl2vU7dVjwhlXm9NQ&oe=6ADE1553"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22n6V-9YaokQ7kNvwHfMGZ9&_nc_oc=AdqZT6WZYigpI_g7BaZEXg4y2Tgykiet10xalx4yRdJPj3R1EhCa7NXyfPOg3435iA0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEG3-nV61zJCq4Lc5CVcezO__UWpbst6B8ZdnoLA-z8g&oe=6ADE116F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxBfLC4gGVsQ7kNvwGWC7_7&_nc_oc=AdrsHGEouzyHUgSmX8vTQni4L88U3FuMNSExHvRkzPRfKlKoMZFprdzzS_7Rbkpd4Qk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMldlmHrX09fMK1KVthLprusZD57XScAOg5NR1swH0V_A&oe=6ADE1D22"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
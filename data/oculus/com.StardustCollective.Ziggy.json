://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2K4UalzTCAQ7kNvwE3L2FB&_nc_oc=AdpzDfrNG0E5pnHLzfIOvJNyGIvSmwEha7WpkLUIEQCJgG2njPAgRngquRMOZ86KB_I&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE22gwgF_G7jSssgmgfDLfBuQaEL0c4qp24Q_4y4MrW9g&oe=6A8831A6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVn92GfvH8kQ7kNvwEBKCuQ&_nc_oc=AdpMG0G62lAbCWL_6RFrydKgSUYAyOIOMj16qBZE6Oa8xI-fMDjVGoKX2FUGhtp9WhY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTjlU-EbmNWYvDC3m_XvhbT4F2GXJzwJ51_BbAqFPNwQ&oe=6A8826F2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUQYp3VRyRUQ7kNvwFtVWDr&_nc_oc=AdpQyoDHykuBZIrdF0xmlB6yHRfg-LAvonN62o5O_awx1P_6uHVTGuoqcX4viVOzJII&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEA2cOO0tmGuW3EmA0o00Tc3GB5Tgj49vJdGvHVEDd7eg&oe=6A8820BB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7C2DbaNeHZEQ7kNvwHvs1t1&_nc_oc=Adrsbtlh8GZd1S2PA_hzkaJqivqdbcaZqEIm3gPEpFm9WiJS4_88fQdeUzOIFBkRuvE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFV68dPlnCs9B7SsGYgxotyXD-MbhPSLJOlxQJ7qd7DfQ&oe=6A883633"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5g_xLmOtzFgQ7kNvwGmFm71&_nc_oc=AdocJYNfAivjMAHl1ZPGAOd7-77ppnMVTnFAvq-R7m0jbSt9QtYKRba5fMyQQQ9ZAM8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGg6rfsNaFylyihcGtYRocLinKECUQKCA5yK6gB01RwOw&oe=6A883432"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jw8l7UU4FRkQ7kNvwGJy5em&_nc_oc=AdphaTfCM4GAdK3DEPGUmYfOEgdpA4Hsrv3EXXPhEzTfqH8h2v2-qhXqfYRsy1oTI7s&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHemkmlCCUhxBrtmwEmEvWZlZz_HUcX1Pm13tTpJVY6TQ&oe=6A882B93"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-gpIYsQBWQQ7kNvwEddCEW&_nc_oc=Adr3o2tzS3PBwfZxZpuNzEDBAIt3uu4n1p7N9dhpHm2Jx8mQmaV_l2G2507ATBeTeY0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsgePcvDHdDb2dcMW2JYfu8FlCHJmz7bOo0OLTk8Ypxw&oe=6A8827AF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4i9cOzLWg-4Q7kNvwFabvcl&_nc_oc=AdreVYrEhd9CwGe7wZcO1eebJP9iSA_3hNob0HkvghkioC6zGIM-T2zjulT5g_uUgpw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvTp0EkgS8IszPMr2ZTDZRMMnpBm7Dnrsdvh3MJYmbqg&oe=6A883362"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
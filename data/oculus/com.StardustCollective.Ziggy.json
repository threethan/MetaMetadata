297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ahUF2uIRj0Q7kNvwED3xpD&_nc_oc=AdlpK8Z3MJCRUF6f1gQ7xcuPPIGSKZ9C50P3scrBPIaImLc4wVBWYZ7nKMW0x9F9eco&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5ZqnuyrADttio9gOBaAqINy1R4lgbOgOh8UEOL2YkFQ&oe=69BE7C26"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpBygzxQ2XEQ7kNvwF-ev5A&_nc_oc=Admo9Fddv1gVNXhBXWYKrS668jsmbS43XrgQALKrwaY-fg1te_-FnCC-lFIpK0S9v8Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwzVTHboi5ObuoGVOzS3nFLqqJxhjjPV-mPYXSoh12PQQ&oe=69BEA9B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Luo5fnnwEgYQ7kNvwFXqoIh&_nc_oc=Adngd0Oqy__pIpnAXpJxEneCeldqGHRyylyT9CQH7iRSOlqarZcGZO0ZlTeUrqJr9oo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwKejwe817MNP4tElFixAmTCqKM7bkv8JFqK8ydTYFczg&oe=69BEA37B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2JZKGhomU0Q7kNvwHl8ZQv&_nc_oc=Adn-8duJrsr7hMo9UWbNO47BK54IZF8RzOgclWtxTcv8aI140aPjsVyJp-XAkviWPsI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWJhBeCCYU4h74dKZOdJ0WVKUorW5wemfv13hRW1jHwA&oe=69BE80B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkdF_b1gRgUQ7kNvwEr5y9c&_nc_oc=AdmtIFEFs6uVSTLEP51ZAqgCBglxMlPyW8VwYH9GGqYVSjcja0700Is5lzzIdDYquJA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2oM-6A766xmEPkYjtyPhNHzpt08RLQ4rQRmLeissjDA&oe=69BE7EB2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_ATv-AvCP0Q7kNvwGrMYYj&_nc_oc=Adl5ZyFtFNoXlzSF_kGGaSFoFxdKQRfUbjeToUWioV5BCv1IfcqjXeqJEuuZHuCALNk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1oqYccdgViwSGl0f14bJKXaGe7bki77HznOgmsjZjDQ&oe=69BE7613"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QK7bockyLEAQ7kNvwGF5KNI&_nc_oc=AdlE4hnwvhX4h3Ljx4Vgz5VTohO1lag3OSAdv8IGXaPYD7KlG_gF0RsWpB1a0mgRuJs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxbCH8wUJF_YptWT3t8B6AhxRbq36y-MP-f-mU9nkbDfQ&oe=69BEAA6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8x4udWwTXOMQ7kNvwEnqhh8&_nc_oc=AdlHXlG8j2juj8elcjEimnpbY5SCBHda4eyZZsw1TsCwfLTONtKeVOS13reFqUM-Yag&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzW7Mi43XP513TTeivlk0fXOHTgz1OvYeUbAcTfU2WeRw&oe=69BE7DE2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_5218087471640407679_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Zc1J5VHLtoQ7kNvwF3s1Bj&_nc
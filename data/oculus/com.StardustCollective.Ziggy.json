://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AxMMzou-UsQ7kNvwE6yNYB&_nc_oc=AdqJ0Kfzi1Xv3_3Xd8O5iVPG2HFEGzRm1VUagsHfHZbhUirarCjHfV6dc6h6tqEBjnM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_er9fqIb4wtqkJSkiDhcAHIKfJlk4UPZlhJDlRXRqhw&oe=6AF727E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnuCi_isvLIQ7kNvwGvV9Fr&_nc_oc=AdowKsrNf_95aoZBs3NY2BiLR-IYO70MkBgoTb5zE8KOD65ADK0NA_Eta2pjs526ADo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdsWpbuYitgn6ziiQqjta7Vkz0kJle78hv76x6JlHMHw&oe=6AF71D32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4P6b_A8PDMQ7kNvwHNcpsT&_nc_oc=AdpROCua8xErUumy24WMjMQF3BQdh8wuCtRnwjiDx84ckYmBkqxOe9LcL6l19rcv9nU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMMH9Oj57w5Q3ADK7kGcSfTX5kPmXn1IxWEZNPRDr3FQ&oe=6AF716FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBpWyyHWMAEQ7kNvwFwN8Rc&_nc_oc=Adrj_i3BEf2eHzckg-C_FyNgd3r3vHWauOVgX5aaTRDSGEL-7i3pWkDqRSUuo85x3nk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTG8L3tfgKg5T9FVO7bY2lOoVnT53jxSIeoAyyIWjgwVw&oe=6AF72C73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ilVTH6dq80Q7kNvwGOooLQ&_nc_oc=AdrG9oUw2tur9FoXNHc6HwjFVuJviJlWBElhHI-0qoSHlXxGW9hydjeXqwi_huGSW_4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmsTwA__DFcKKHo6mdJAvkDPtv28T1JHAaYmkrWPP--A&oe=6AF72A72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-j7DEaZ2FroQ7kNvwHSSERr&_nc_oc=Adri7eoZtfO_fufPfAqHA85veBH5Yo7hLktAAqsYEQxaGRmN9iA9bHcHGTzisx4rYfI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXGmkjlr76FES5oHaEhHPaVycRtr_DXQYctNJVqVYyog&oe=6AF721D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HYWapTegE0Q7kNvwGFd0Zr&_nc_oc=AdpzmN1klQLjnPOrxwhpU11wDRLEo-b3lNPEl0WQqiaxH8aVv_sloVmXGM9wQy-5pEw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6jzSvtmFrc-k8zshS4veO4SHkrVyOH46c3erqVIKOPA&oe=6AF71DEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4P_h63S1tIQ7kNvwGYHZ_T&_nc_oc=AdpoQ28Z9ZM_iszT3hPq8zr_V-nkofuNo3olXmB8brgItXC4U1YTEgazQ3aULgtpyyU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQioXZ-BMd9-oTMQdyyN06Itv0pBRM5cuN_1BbHWpK4Zw&oe=6AF729A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
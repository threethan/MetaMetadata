297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3RF0rX4S3QQ7kNvwEXJwAY&_nc_oc=Adm8SICrjqY3OOCvxhMigrEWkcoJNvqcNpipkoFEAMVqVMh2Nn1DHBltaFiM5m5-Ia0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvDCTgtFGb1aGalJtPe8PgAuvIMPYi5oMlYWDTLHXnZjw&oe=69A812A6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RnZ4u1bxhKQQ7kNvwFncugl&_nc_oc=AdnxskiN7Qxpre7S6pTorV90UD5P8ss_YqH5lA8cj4AmFyTJj9HwJLzogVz3tcE5RTA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftfiWvxWxGobVnOINY9EZpSO3TMoLRSJgA1dp_IsdaLRw&oe=69A84032"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJG__4xjWM4Q7kNvwHiQ4TW&_nc_oc=Adkojanmw6NFOqUUqiUPQna7MByd3rLvj4MiUFVoEI1kjKLUCrXIdeaDxzBDpo0fAq4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvfF8Jps2fjj09Dw61JpHXw4XzRNuBz56WHe0PUwdtp3Q&oe=69A839FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5knjStWAbPUQ7kNvwHpXfrc&_nc_oc=AdlB6o2ISBlR9zohYYvvYt-t8l2dmc3pC0a6E1n17nBphSBZU5mhrucaYY-E_FakNKw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvYKf5K7e0V-vnsNsMeJ_Tt91n-xz2Z4114rLOvOTHFeA&oe=69A81733"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajUktLZuk0IQ7kNvwF21Cm0&_nc_oc=AdmQX5uOIegSTjj2AlqI7Sof8b-OfVoc8YybgT3ZRgZHMf4jrJ4rFH7Aycn7E7jJ3VQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvzoUvp-OrI3wMTX4ozTOAaBGG3At4lnHCG5YgkzE4feg&oe=69A81532"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LtKbTfTNqvQQ7kNvwG61FEI&_nc_oc=AdmhOHkw8oIOg6FbBaaRTI2rDzcIwEJs1A-dz70tf7TxrVDA56bpo0IX_Ke6ej2TAy8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftYQ6ENBG9lKBllAlmO324D69BibvAiTEsMllBQUSQ9Pg&oe=69A80C93"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qeXgF_lHT4Q7kNvwGM6A2-&_nc_oc=AdmFthBjHjiWHDIJGvPh6Wd8N2xIgIraDsvXE-Lohs9-3rVTHQclLQoGHVz8mqvOcBE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftUxK8p5wUNiXpu_lg859V_XRA7kMYDDBdMnSajbQoREg&oe=69A840EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwKS1q80pVkQ7kNvwE65_tT&_nc_oc=Adld7Lg0GSBlVW-Bu5IQP8kzxbbFZg2qFTenW6YWSGI7JXwnBExm7k55yv0htdYuI_c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvNb-meK0OKiTbz5FYVq9ccKw7aXMGuGVEgP-5r0gWVSA&oe=69A81462"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_5218087471640407679_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Auyv-4CFdKsQ7kNvwEqe4WR&_nc
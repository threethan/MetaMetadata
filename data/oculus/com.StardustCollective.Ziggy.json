://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1Af8T-BCtAQ7kNvwGxTle-&_nc_oc=Ado90zWgbko2LWIQJ-vH91x5r7qwWR-Gb43jnvFUJFsiLOS7G4WcPvaR7_qYld7G4xw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIi_ralmfNrWP5CkJVUbzOEpAZUwVYMQnR-gG6IDDWtTA&oe=6AB7DFE6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfJ6orsfkfkQ7kNvwE_N7hY&_nc_oc=AdpiPa-_LXqA8AFalgcJeDGDm4RKaijjiJEI_UYkzyh6PSGjITL6zNmokBJ8gB1ztOs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL31eAMkD_YgNt-tAI356be1__bEDdrNTPynYK7o_wxzQ&oe=6AB7D532"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8QlNcx3ls8Q7kNvwEs2kRH&_nc_oc=Adr6MakXKmIhlzJUVOiFEBSzhtT86WtuWD6Q1MVlQC7h9ltBj27LH2SJR4v47R7qU5w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzlpcvsNoQ1Dh3pB4JtlY5uwYmJNiOUDUA61MXn60ziA&oe=6AB7CEFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lUvC6q1bWcQ7kNvwHvXR_Y&_nc_oc=AdoG4lB72MlUVY3YLcMoCu8udSTcZe08Hg5XPL7wDa0WtGKIN79H-uCS0Hl2bTaMRtM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXL4Y7oDRVdZUlJCP4w0GpT0e60FtnQQZCAkBHEYOOyw&oe=6AB7E473"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ueuGzCH02cQ7kNvwFxvNrq&_nc_oc=AdqDOvAPNmRYFTxzMOwIs5FZEFdwFojIf5wsvXMl_0qP2cQSpSR00wYZm2tBNreN8_g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsFi_399XmHO0gI0U4NkPWdMiHfAaLqSOnoGev9ZXIEA&oe=6AB7E272"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVYwb3xqbkEQ7kNvwFa4VNL&_nc_oc=Adr4YHPI3W_CoKtuKkH9CjWqevJr4meTegGdXXXjtFx5Ie4fSwk2HniiuwgNq1tS-qA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLn9F-j60WVjg81bapz7BvQitgV_fi2K8RDkhm-791t6g&oe=6AB7D9D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlXQbtTOaHQQ7kNvwHqVdQY&_nc_oc=AdqY2aPQZdkEk6BEE31t0slfyxH0YoFp4ZdJ2crMQGMdwDed0gUrLvJmwVzpa0hxIb0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6z6Pmd3I8UVFMNFxPu5U8zurgKVErujEw05c_Yy48Xw&oe=6AB7D5EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5LPpcwPvA8Q7kNvwEsPNDB&_nc_oc=Ado2CXZPhFT1KIG8BkYw9ClpO4rHFD3ZsUllrIx6G-8h7eayhOCRsb1VlWfdOTKB9nQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKn3IUiiTPAZKgeOyL3ULC7uNNG6aruZn5CEkDBpKxZgw&oe=6AB7E1A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
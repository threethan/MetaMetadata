://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-U_kazPW2hUQ7kNvwFZ3fXU&_nc_oc=AdpJ8bh0Md5w3BH5GRvmF6DfPaQdbh4r40nXRyvId2Pf5kSmG00oJNVe0omyNCuGhEY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSlQw7z-PhesV0GIVBBUE8gjOhbGpDmOk-udasJvgnWA&oe=6AE20FE6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBWhtXK_rkkQ7kNvwG23jR1&_nc_oc=AdpUIuMiSvVgJFWHA3eogXkbaxPcpBB0r1XdBv-q3pDMI2UozKiO7U4R8j7r33aZ51I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-EhAIo5I5tnUd9mHRykmNZAXpwulLkWVUH0DIV1c-Dg&oe=6AE20532"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89k3Ns2DwxAQ7kNvwEuiChJ&_nc_oc=Adr83MySYakm3iuPnQ6WAY9c02i4Cuqn19rMiuVneEqcUxOYF0n6HTqc755UHbqkm7k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjRoKZ3CaFEbV8-75428Zf5GUYrvlSXhyda2Moy_yS5g&oe=6AE1FEFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywk3_dPgWNgQ7kNvwEio0G7&_nc_oc=AdpIu9EI-x3DRkQVWWNrRzrzFb7dZ-HBc-huEKRrykvVYzV0NAMjUq5jvDyl7MezFxE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRhj5oFs4P0eUIlb9TKZZLpvCBVQ_nm42SJVDep1-eAA&oe=6AE21473"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLQiHs2NKz4Q7kNvwEN1a5o&_nc_oc=AdpmvXLh70FWOWx7LjBjUhIDlsnJXKFY51iPT5ooYMGg0k7B4N2jnY4XCDlAgG30o_k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXYJuZdXayBY1__JMCbqRvM6LgFc78oOHfUaX4vX46KQ&oe=6AE21272"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6PuKFxJA9oQ7kNvwG3SUJs&_nc_oc=AdorpnV2QuvtI8ihOXpajWo7IFI0_vCrOLdjv1AkbwJGPJREYd2AyXl0zmlXVdizBBs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWPsGax67KG0m-zdoEMRbZRluQQ_GWabUdIVZJx1c2VA&oe=6AE209D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2Zwn0XKSWgQ7kNvwEZUhsD&_nc_oc=AdqckgiX7Okrr1xtUQAM3iM-Q86hXmK_6KY4qrSGUppb8j78MMHS1DTla_p0gDtWmFw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGR1nv256vQr026IbqdJPS7Os6gJsOfDjp8j0OVZfTow&oe=6AE205EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nszyXfCWVm4Q7kNvwHEkg8v&_nc_oc=AdrhJ7osC3UwkBsKsP5HwoJTMQUCzty2j1ITJx7pLB_p6ALkmv8M58CSHBVtizydG-w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhz1jQCJR1HUWgW3API3WRKqzUgzJI80XuhKfOOp8wgA&oe=6AE211A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
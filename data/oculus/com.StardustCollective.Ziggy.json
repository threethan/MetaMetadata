://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uecXPY4v38gQ7kNvwFKxl7p&_nc_oc=AdrL_0Dcb3NPN5d8FV1nF6k9ST28Yj6ANWMtvgVVmmshNLBfpBsGc7qMRA3kzMFJNZk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbg3355bINvttlTecHku9MrC53DIZVyaf99upT9gfM5A&oe=6AAFF6E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IfS2oQVYJUQ7kNvwFVd2IV&_nc_oc=Adr8-eDQCsBd4hXw9Fug8Emg_iwZfrBpRbFjZ0p1JHwfz1bxs0zyxH9lO04fGWjkxDU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxZAAf7-AAupIMPDPwTDqnSTtajWW2oc3-2MBvQoBcVA&oe=6AAFEC32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8QGIrXuE6bAQ7kNvwEnC8bW&_nc_oc=AdoRHGOngRorTommVoPMGXbu-2EbPk3LiQVfXkVIxUQMKfQ3xpK4k7kgOlXWPtOspf8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxF3xIHtdoxfh0FfWMAglyDwJFamkidq1-PpHWI4dw8g&oe=6AAFE5FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCWg4j0J9xMQ7kNvwHAxPzS&_nc_oc=AdoYYLyda1RUDY5NPXHPlmmVdU4DKbjfOb6-jSAy8AvyWMYoC5qnB-_gLLG2cEq7I08&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6S9fW1I8XGy9OLTcuh5owMObMF2t9wz9sUZx5bltJdg&oe=6AAFFB73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zc99tTTZU3QQ7kNvwGVXBUl&_nc_oc=AdosI3s7to3UEROXwqY-6qeVQtutngWnCH7JRcvDBi_EbYOC-q29dbAPu6RHtSK-Bns&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_QjfgaJtzhMNwsOdzUK2DS1s6Khro_ywOVN3INvPa8Q&oe=6AAFF972"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Q4nsPhAykcQ7kNvwEEFYKP&_nc_oc=Adpv0LCeQx1XrWKtPzaBw_g_MjUNeqbZWOwkpwe7Pc_oxfjnBJy4Qh9Cf7wyXo4anG4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJldrQGnvdQSEci7btzsixFPMZiVpYeUKAYW6yWvfzqg&oe=6AAFF0D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8UAs_CaBrcQ7kNvwFNudYd&_nc_oc=AdqKuVb27DAw2CzYRCXU9VsCxtHcgE5WvUmdFh7p4HNMpzxA1DQ9AYUhSHiysihHjyE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOx6TfYmlUXn0UlVr37dVxm1mt8BfP5jQht9f3F7HdHA&oe=6AAFECEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIg2doElMgAQ7kNvwGhkER3&_nc_oc=AdprC4l6XhvlL_gXhlilL2QsEOJPIE2zAE2Y23Igq0pXYDBECZHtu38iNCFJKp7Ec7w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYDy0q3Jq4ut5HU2yNBK5S_Y0pQipaEqETfGNkUHeUJg&oe=6AAFF8A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
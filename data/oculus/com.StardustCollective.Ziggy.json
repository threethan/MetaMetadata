://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zFFdtH2e5sQ7kNvwGUtL0g&_nc_oc=AdrrkU2Epns8lQLafRVOV4UJeJKHvXRcluhz05Qf2wc3mA94lAVgvOnyVtKbAc0Ul_E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdKCuPyeNAHVRpkM9ec9vzSjrxbTq2oHTj8wx3pdXaww&oe=6A8048A6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-eaHAvEGSAQ7kNvwEAm3sT&_nc_oc=AdpqRXde6FpZmAeIz95356nZYhCmVacfcQoPtG24yrA-9g9eUT_mwUYA1Cc7wYkwYCo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3bSk1ew7lApxoXfUidX_WLuHWx1cLCcrGpebveajsTQ&oe=6A803DF2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mt6KAdifDvkQ7kNvwFCDZxo&_nc_oc=AdrtOxQF_EHya_6hXA3wtLUp1lNlZ0pFILhOlIqAlblUzpw9-Kz6eE_vY1Vd2gCAY8Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRST6_vTzJOPahjzwxya-n4hHHiLsG0j9j8tXGMklgFw&oe=6A806FFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjdJFNYL4Z8Q7kNvwF-f9lD&_nc_oc=Adp2MuvoqQV5KYIHB4QcYI44kX3RKZmG7s1GVHYfJ6twaW9xIAeZtO1l-ppx728UG9c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkFY15ksBoT4F5HOwNALXBVexb4QkhBxXNeRgU9s0R0A&oe=6A804D33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIkh6lAR_8EQ7kNvwHK2a70&_nc_oc=AdqYUvC0eY1PbI_N8fOxJT8jt4mge-Q5dkmBcVq92jmdj4xFCjN5xiu7eDH1Hw4K67g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4m0FM7ydP7dc9TJNCOO64pHUjmn6ggJ2REi1-F4TS7g&oe=6A804B32"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0-n9kq-9VcQ7kNvwGuOGiY&_nc_oc=AdrpsyYxVlbFzmpIGX-9u8a9K6iI9c1ouwIGDXR7ADrw3QZ5ll8uS0KIhQVq-4e8jdQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzKxJinMMVMUbT1kvBcn2MCXWdqH7fPJSlbwvxBr1RnQ&oe=6A804293"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvoqOyrCTeQQ7kNvwGLTBSC&_nc_oc=AdrTn_VvQ6Cri-xEX-NUVwCklFauef9qQ6-fAvz9WTxxVLH65xvIcb6fLgHcHXNRGmM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkALf3oWmQjAXBzlpTIFUL-Adz61D5eAZi7XKicR2RYA&oe=6A803EAF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PgYSrfLGWrYQ7kNvwH-7yWc&_nc_oc=AdrcsHCM9qO4gsBJoaBLQHYvFeMoOYAxu7-qT-PzsiyQh9Ls2_NmkNriOdWhuAapgoo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0u7W8GObzLnri3QgHPGd-9vrDFEzXukO56UQHFNdJdg&oe=6A804A62"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
3gCzjGT9RV8qTLi05oJiiw1aYBJDxhaiWxpw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOcLaeokmRstQVhokb8HYBVAdhJkCffLxfQcx7XMjGTQ&oe=6AAEAE8C"}, {"file_name": "HighresScreenshot00014.png", "id": "618881680223104", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39035330_618881683556437_2621079300486050521_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJB_zIH6pYgQ7kNvwG7rgZO&_nc_oc=AdrF2isgWGZYgw-O0hxEUpTFzNUk7yU6zWWCDjea7QwNWVT4Hy2WTDRDwMHiaObkaQ4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKc_kVl_7wAIe0fpDtP-W7k2SlCstBkOzv0TbEUGtkdrw&oe=6AAE9F40"}, {"file_name": "HighresScreenshot00040.png", "id": "818138872994656", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982499_818138876327989_2509640883979337008_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tdrc0C_IWmEQ7kNvwEQRd03&_nc_oc=AdqwjqVPVlavno01pQX4dfskCsZRTg4x32V7iENkBDLKuVZfP4wOD-3HHh-9ZHTSr2Y&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXgRA-L8KogpjyySiCrF-PPZlOGxUCDIMzHqwPzuzDWQ&oe=6AAEABFF"}, {"file_name": "HighresScreenshot00146.png", "id": "6528405093884480", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982442_6528405097217813_7617801026990639966_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qp9EAN2j84IQ7kNvwFC9Nti&_nc_oc=AdrIXn7CZ1VMnD14HYXu4u3oE6l2SNSI0Mg1LBcUW9aua7L2RE3Ght9gXlqIlGkt-0g&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCMP0zXKbQ1kzv4wHkbkYGk7Q_a3OJqYCej1WUUC9lKw&oe=6AAE904E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "312845394416247", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035359_312845397749580_7295644085646795585_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cUgttkEx9oQ7kNvwHRDDc_&_nc_oc=Adp4F8-D8BVWvU-65vy2NbqeZEaBC0_mFHZo56J53ErCp_r1KQbuF1vb1KpbIybObhE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeD1uIynF8AN9rVYZAz3M6YD52cdvgEAgOOwif5rgCBA&oe=6AAEAFB9"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stardustcollective.dev/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Stardust Collective", "support_website_url": "https://www.stardustcollective.dev/support", "website_url": "https://www.stardustcollective.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "965817280986280"}}]}, "scheduled_offers": {"count": 20, "nodes": [{"status": "PUBLISHED", "id": "1267037942025398"}, {"status": "PUBLISHED", "id": "1909913366556621"}, {"status": "PUBLISHED", "id": "1206964031569042"}, {"status": "PUBLISHED", "id": "4086645571583167"}, {"status": "PUBLISHED", "id": "788391147027224"}, {"status": "PUBLISHED", "id": "1217562296835398"}, {"status": "PUBLISHED", "id": "974831478138931"}, {"status": "PUBLISHED", "id": "1341415813678539"}, {"status": "PUBLISHED", "id": "482460867853991"}, {"status": "PUBLISHED", "id": "1349603786644386"}, {"status": "PUBLISHED", "id": "1982503008855173"}, {"status": "PUBLISHED", "id": "887729590037365"}, {"status": "PUBLISHED", "id": "993089155820641"}, {"status": "PENDING", "id": "1084527819222992"}, {"status": "PUBLISHED", "id": "1036968480947929"}, {"status": "PENDI
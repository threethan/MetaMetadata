://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THgIJt5eU8AQ7kNvwHYPDtc&_nc_oc=AdoiVilP61hoDXdmxxXn0PVbkq9GtEYKZsMmAVsBmA28UE7oqUjAfYf-s2SoqwtR6gI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwFRdlnsnyIFcfUhwejDDb_vqXaPxgLuJlkyHPTatmlqQ&oe=69D0F126"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xPxJB4MvCwQ7kNvwE1UfYB&_nc_oc=Adpjl6JGICmEIosZ7voZUHInHebZavBkqFUuJ850cQSVseDUD-DfshhjdlquPKVNWbE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySP4khm5PHK4EEZDPcSFiejWXfWqvHoYJuP3SaC4zhgg&oe=69D11EB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zwh9cx0BLToQ7kNvwGr9P3z&_nc_oc=AdopBN5SMLLaSh5-q-RxZTbk641lzD-27MAlhrIaaEKSxkYSUkzd4s8lrdFQpfqNw_k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwUZpy5kFglht0pVQBvA6WvSRB6WJQINxhlWH5FIxybdg&oe=69D1187B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L14BBg54fnQQ7kNvwGsvdym&_nc_oc=Adp2gcomzZ56jNmk70F_vUfga1QDqjRfzq7YhuI5MgKvt0PKFP-dYtWzRqNMaqjJL8Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwwVIs4scsh0mG900eTjyEtWQd0G_CN4K4082vkRy0qmg&oe=69D0F5B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7Zl0luW-jAQ7kNvwHz2OR6&_nc_oc=AdpiSgRw3p6oH3hM2B6_kETzyoYkm-Ne1ieWKN42yGdDK-833gzQTTYngP5WYwIQitc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwxg6WYIXHkMZQuyHekYivgVhTFcQOIbiOvoviA0WX1uQ&oe=69D0F3B2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ah7mB0POWEQQ7kNvwHV1axh&_nc_oc=AdqSFnE-oiigdKIj2Dim0ivJb3011ruzrG8L9gZIwAW3Pn799jiw3m7x5Y10goa42tY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwHH5AX6jeseizdh6uYOtdMSVRZQKhSfgf_xcC-XzKo1Q&oe=69D12353"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNldto8865sQ7kNvwF0VE99&_nc_oc=AdrJkFwWxKEkvWQBV9GFwu1PCF6oNmKf5NovNgpUHAaRutONfycZUL-ec_JH8ASbULg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwWREh_QDXyDIJk1yjS99xOyyY8kFCi0pMHaZLQjffqyw&oe=69D11F6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krfcRAB55oUQ7kNvwHPyp7d&_nc_oc=Adq_8S5IphAoHJ9iyY9220TnOVqtkGbby7xamlXg02bPeDLo8_FlBWFRvYzEfgGRnQI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyYhdJ63nu_uwtqFWblki05TxNtOhfSocio_LRynnhOPA&oe=69D0F2E2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-U_kazPW2hUQ7kNvwEWZ6_N&_nc_oc=Adr9LpWKDNGqxhRYe1TjOW6-fjo_wYQXOfJK8TjNVIaFLgCzl_Ubk88vA1d8pXLjTn8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNI6lUjWOSBuwAtclHKjegYFuWjY954hj9RWwnoBa5s7A&oe=6ADF6CE6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBWhtXK_rkkQ7kNvwEwjuEJ&_nc_oc=AdoZ3Wt0HF-7Bn8peuNPR8Sa6Ak11rPf3a1OoYc2lTruXsOUSuhZB40DrMJxdu9DQ18&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbMpmf2C80dR8LXcDXKGyqwfBku8-nWdMnF0ZV-djtdw&oe=6ADF6232"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89k3Ns2DwxAQ7kNvwEGzhgb&_nc_oc=AdqS3FpWp1Xt12zHVfneEkhBshrd3_OA5bWrxIQe_JXtRVPmUMyGkVpgiJ4SDqFvg5A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2Yn2D7KUMuuGZqhko_4g7b0CR_D1ImW_NcLdYu1y6ug&oe=6ADF5BFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fKwbhiZ0VkQ7kNvwEU91rd&_nc_oc=AdrS2-1O1pQqMYmichMfAByZD0y5pS-LifCch0IVZVKDRZuhlZ0h4pKGLPjYAGQbIAg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgW09j6loExLlSLlJKK8S1SpJaUSGzgoYxzXwSnw3QPg&oe=6ADF7173"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8v7vSv57HsQ7kNvwGMBzc6&_nc_oc=AdoyQ1ljty50_Q98Z2VNbzCmvqKWPnIKR-MvZMuhl1Nr5rgp6gpKMra4i0JDR67-WaQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOi8ssaqDz6GsBiwEb_gzygpQMH9K65bXP7EcaLKcftA&oe=6ADF6F72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6PuKFxJA9oQ7kNvwGMTyoG&_nc_oc=AdoBwIaHQEESddYBT1hnyh5hlycnmBO0FHyV6t_UdS4eaxxDH47L9YegStbcgEZlc_Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOBS7PAOK_Iro25ThyGJLB9H2Y9YIgRns2L9q5wZFTCQ&oe=6ADF66D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22n6V-9YaokQ7kNvwF-0uvh&_nc_oc=AdoIpye34JOF540JEN_zoCzzDvicYZ77AKCkQQfDgYh6lRFboJ0RkmailAgr5hwCYvw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9aBrBev2_ebSkXm7NjtYGKvpEMnSDDcHcBmRsnMWTYw&oe=6ADF62EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxBfLC4gGVsQ7kNvwFf__XV&_nc_oc=Adry4JfwPCsHrr25K6iqcsxaRXtVw2t8AWPQEg_Bs_3nh1vIHpaZLMZA5Uta_i6XUvk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCoDtyHuKOdM_pYi78cGsN5L_Kidm82vN7MXAkL2CMBA&oe=6ADF6EA2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
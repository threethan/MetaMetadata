://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsQrjowssMQQ7kNvwFKr1VV&_nc_oc=Adpp6mW4-IjomgpxLBHy3prYmrvvKItkFJlXF9noN30JHoBbc4h1qmHKXKFUk9NXN6E&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DPuQUvePLmhBh6843lMm5TCaCaHv809N3gqVfciPyag&oe=6A32B866"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMt4V8YWAhYQ7kNvwEYyA7w&_nc_oc=AdqBHazZkEIn4-CuzkHPgPhLFw0PabpcLNhcTxKLILXdRN7D0J7L_VyT-niWqOE6qoY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-w-gIAWvVR1VNPb-it7ydPmq8qAmm5u6yXUVz3ODBfSA&oe=6A32ADB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0wMguOSIRYQ7kNvwHtg06C&_nc_oc=Adpi-UQFvQ-ZFY7c-LIGNmIMi0MFXi3_f7f0eZZY05IAw9zXbMYMX_OkeLIi58aBl7g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qRb0cwH6NA26YMHznfbsCW4dtqtV-h0Rhtmj4c5hC3g&oe=6A32A77B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fm_AocvEEwAQ7kNvwERY8cb&_nc_oc=Adq8GlwH3jU6UZ_9hWQdVhI16Tn3Ix9-JYre0aCIKHOhQvZRGGl8e60OIfZXpb1GwJI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84P01B33mbKJD3_8CbABVcM-i7jOytX8uxlllahWDsMA&oe=6A32BCF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80OdS37cvrUQ7kNvwGG6RHj&_nc_oc=AdotaOk_FhoK1xn6_L26mxSRBH6Isig53nu6OxKR9WY3fGOMItGpleEloOr5c-aMX1E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RVIUPV3a70Xv8EpRa7lBn1ctvMkY-iDpTLJIx96sRlA&oe=6A32BAF2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuESm8h1jLkQ7kNvwHAhBzY&_nc_oc=AdqwpIiLEIb0qvJnMRMduOHGdIjpGDz7oW0SCtYgTJfwXBn7qKr49SOkxmEP9tfPkv8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84O05d1dGO8c76uipmctfRITM35LZ_qOqeZH1W5g_d4w&oe=6A32B253"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HoaPH0WnjgUQ7kNvwGSGIni&_nc_oc=Adr8efMLzRkWIKI8lDQ7XTdwWyV59qHGulidTzjun0e7a_nUFdz6wRu0xO686YjLnL4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gDZEud8LZYVu9xo1DXTGITd2IS3AKpuge5jjtlOcCVw&oe=6A32AE6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQsn9xe9MBkQ7kNvwEQMuaa&_nc_oc=AdoSDft4W5tZ5sFTMo8Tt46scxvbC9usNPzhXwfMZZly2rAEbqpZgO0jFIiy0li1ZO4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GtcTAaDw9fDuezFc46S0uAQImZpAEyEA9q0vDlm4ZTw&oe=6A32BA22"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
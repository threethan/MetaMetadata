://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiNPnv8mPtsQ7kNvwGLm0iJ&_nc_oc=AdosW_ndDZcWnUz6100E2j8qEr4Sk_2Ii0d1LqnIjIPV1iOtvs4enWHPOrxGHiCp6OA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBobCGItIXGYp909b4LK4bEoTnQE7lBxHgkE_7lFgIqw&oe=6A53ADE6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVjGhNz8bW4Q7kNvwFZfdYm&_nc_oc=AdolikEE4zVONfBY_bVorOqj0RwJRX634c2JPzHJYQ-VFtQY6clRVwkqBaiIxheFlsY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGhCiOZIHxO80inovuXLkvptUGYlg-hYzqoP3-LeeexA&oe=6A53A332"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGu6uuTD5Q8Q7kNvwFPLhY8&_nc_oc=Adr_YJmpZZoTQM_MgvLQ4yyjbaW7EOhvvEAd0znAPkdpgKEBEw62wqdFfKWyvJQirSM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQ7dbMMB1KH8Wj8kfJaO5jY-KoLveSsy9kjVbOgBwM1g&oe=6A539CFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2l8hGxD7SAQ7kNvwHdrd1D&_nc_oc=Adp-u546AeIKKzOVP8MyHbQhhKd669pGjtgT7T79DEYeKU5Yd5Mrs1vA5pqv8p6fnyk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0nd3cIfDMe_D4sg9VkbatYZB5MrZVrCYtR6uZe4UV_Q&oe=6A53B273"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuDxD3zG5cgQ7kNvwEUY4Ug&_nc_oc=AdrBGhepaBdd4cSyC7lqAH2h-l1txX2bbgNmeVwBuKPmFNVXyNfR7x4vTA8pGNQFqCs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCO_PGNfD_WmX3PGOWR-SX40hty2A2UliNXhx16uecNWQ&oe=6A53B072"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efb3FcGcZSwQ7kNvwHK7G8F&_nc_oc=Adp8jCKqjESCJU46ssM6tYP7xeag0OxNIAHbeUNKG589tlOAjbXuooZWsQXNLotQa2s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3e49SwVwOku9pWMZ2QadxNNi8W7JQ-mXDERK-FcOLOg&oe=6A53A7D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VpWNp0OQxJUQ7kNvwEHRGTL&_nc_oc=AdqAFXVmnvca63Q8UpW8-JOQgYZ7sAUM_oQMVEJa1M4eOcI6E-Yl_xzaMSURjh8hiL0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBULbQvmdA5Rq2H9kfZ8IiG0EYSl7SyShVoxjdeckEcDQ&oe=6A53A3EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IebodLp0zvkQ7kNvwFaNvGJ&_nc_oc=AdrmvFNTLTA2pSE10V7q6iApoPAmGQRHSyh_kpy5aQGxcElrZcY8FdHUC_tg-hqB71M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrrfG21IimI181iBRZ50cR-pV-zoQlCCIqtirv7jL-YA&oe=6A53AFA2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
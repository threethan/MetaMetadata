://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3gMhzwicXkQ7kNvwEpIgXA&_nc_oc=Adp2G9P3wSaQW70A_MJkpZJXKT32kyItASvYOXcOVscHY_VWdfoP812-77k-K5unkNQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bfUkRZ9NbsLpyuk2WgMnGDCl29qzL104T4i9_jau54g&oe=69E24CE6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHqwNH3eIHAQ7kNvwG52_Oi&_nc_oc=AdrKVjUPZPZfGT_h0oDXzru9uHJtrecL5jyS2722YwvzE9gTdkNEjM3cJefNBb0XgUY&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ugSY496bszxiJyOaeXiHmT95rhV_X4Zph8XXtcRm-Cw&oe=69E24232"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAZFMz0uQRsQ7kNvwED6tBP&_nc_oc=AdrkveXtUQ5bwwyGP1i135CaCrQY3RDoNBLjdaAvx8FftXBwBAU9rpv-USNYQ_oREbU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-HU1JH4DA5PeCq_wXI0urZZAly1PcV7RMy9nQt6zliQ&oe=69E23BFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrhyzrJvuLwQ7kNvwEINkg6&_nc_oc=AdrSWbDcqmp0J_7-KdOXeyt8nAz_UJaDvRRWPeS-VJsa5mtjUoMp_lWuapDhhhAIgzc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03g5fHSWFA7z1lqA_pYg_jkjcS9_z3qZJfFU_dHJ-GGQ&oe=69E25173"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3h4XAkx9Z0Q7kNvwG-Df1E&_nc_oc=Adrf8R80kOTIUyyUGJDdobyRM4txfNFVfJ0CFOeNeelxwb6TqD8d2z8aZ6deZh8vNVw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1K5CXDe5Op8qo_WlCs7WnecUJM4EzOBaUqTCj85mdcGg&oe=69E24F72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DloYo6BghFwQ7kNvwHTzAX1&_nc_oc=AdpFRcHJ95w2HJFk8syqqwAi8hme_B5s6Lkc9zhC2Zr78O26MvSnSzrgpqLBbisiIVs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gj3qPtrvO35Wf9hyqAVqFVbz_RZntY60iYfxRstmVVQ&oe=69E246D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0GxSF5nMr0Q7kNvwGEOrfN&_nc_oc=AdoEHCz7iU-m3iZ_fga3Gu5ICfF37I22yc1oVg1rhlJI-rQuR4E9o7xyIHF2UQxhse4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nINxGJdONfSwf6CnstwTHUJoy56TnMj2eGAiiAqbWeQ&oe=69E242EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFWtOxiG5mYQ7kNvwEALqVW&_nc_oc=AdrSUXpqKpFidRRgpjILZqLv2lwbZ1cqF4iut-_uP6cfYcHWbeozghBNbnJHBbBNOEE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_Ldx3ljfNOnBlSkSm-KYFAElcbntoPNOrKaKtOBqCew&oe=69E24EA2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
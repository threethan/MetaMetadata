://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75zJ-AE6z5QQ7kNvwGNO-RU&_nc_oc=Adpu3KCgLcd5vSW2KSkDm9qGUVod_HvcJM_FBX3kyeA8yO1A7wwfdj4OCo34gQtZesw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO24vRFDp0UK__sjffuXFOhv9supDnkAgBT0-3lufXLgw&oe=6ADCC9E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRgCbEDgxw0Q7kNvwE7GfTh&_nc_oc=Adq_ouN-aPbBbOKwGLytDYAP4dq8pYPm-HZSPryWdwfTsLR1G1QgLeF2v261cW3ZvJ0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuPdvFUF9RhUUh5jyEWZoWNhc2v3eEf7a-4MCJjH6ojg&oe=6ADCBF32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TQDoiBP11gQ7kNvwGkmm5K&_nc_oc=AdqDcTnuGIO8JWBXhr-CU1LaGk0QgqG0Hpwd31DzypVY7lb1Y5Crfk8kdoocFPZhYMk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgF7GMnP4aowtTbtJqQ2zKpL4wUdxA3m598ow-YNO9Qg&oe=6ADCB8FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJ4tFPMRRr4Q7kNvwFvkmY-&_nc_oc=AdpQ9yC4SJDoGXt9dV6V6NqG3z6f6T4lYA96S2S83PTVSqcBo5mfEuI_eF5Arm-eHo4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHspmO4BVhLFOcxxQd37Xc2zngxBZ8fJvpQm-VXJufNQ&oe=6ADCCE73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwRABHHB2QQQ7kNvwEntkII&_nc_oc=Adr26zk3Vs0OQaTrDMHkF462I8ickBTI0OOy14EclpSR7MaOJZql1Dit7G01-H3QlqU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFdf9CEcQ8yle59vUn35EuU0ym77-iwZTSDwatJbnInw&oe=6ADCCC72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CXEoYXr3JMQ7kNvwH4kfAX&_nc_oc=AdpPF7puhwdpT4WUlLQIwVpu4384tt6CxiKB8FxDgSCXjs4ZQn0EYByM7ZXctbTGNWY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP95lhmnvWLFw4FoWadSN9Znx5QWO7qQboh7_bpmkQAeg&oe=6ADCC3D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPUC-T7m_GEQ7kNvwGLDtzX&_nc_oc=AdqnvvL-1YOWwOeSoIKvjAUwJyrpr_6zIocpKFA1K4alxlrsJJmn6YP0XFoljQccUkM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtX209ch0HsTKouTRR5HmZPpuKlHGuTdRGkvzhmnEtLg&oe=6ADCBFEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxBfLC4gGVsQ7kNvwFS5v5T&_nc_oc=AdqDC4CdE2FZfAKaTknnWd0m3Ow8tFfJdw6OJa5uhRuP5nzNO-SBnUaMnO9HE3zxBm4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDf4yNXYMLY9nFEpCBmBH2BgxgbFy1iYHjARpigXLBow&oe=6ADCCBA2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
t=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPiJaW5azKwk6ZtdNeBVCFUo1roTrXbIGzqlboQY5xsw&oe=69B2C1A1"}, {"file_name": "HighresScreenshot00040.png", "id": "807733037419699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984472_807733040753032_763200239777074167_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZMK6-UlHbcQ7kNvwH2rt7l&_nc_oc=Adl3EvxuFcmoQyoE-pRayc-22LJjHkPlURoHnI7x5WXC3RLbT_t2T9ZfRsDE6vHIksc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWVdiNB545cHlruhNP0S3vynLLaScp4NByDCG1_my5Hg&oe=69B2AC78"}, {"file_name": "HighresScreenshot00146.png", "id": "163970600033098", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566678_163970603366431_5435931785999963108_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-fqUK6DY_oQ7kNvwGRfujk&_nc_oc=AdnD2HzDHBynksV-WUuxGSXZ_y2YOcjPdsMSjbvRIOYKXnPNWxQVTM7nbosdFkpkhtw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw0Pg3UYNF5iTlCPpLO8O2cZpmwVYlo32bY7slVO0k36w&oe=69B2B0F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=727WTxuPY_UQ7kNvwGU3fXL&_nc_oc=AdkcVUIHzoOBYH0m1YBJbTbgsX7WPnfE0lTmPNzokf_qVJ6HzXgiXs-PjyKz_IA_5nk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyeQ5Y8BvHbtePBHr1jW60q9hmPdrCxofhI1sM7cA3gtg&oe=69B2A132"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "1324311035174797", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984472_1324311038508130_2610060411856834928_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFj75-GwWO0Q7kNvwGUIClh&_nc_oc=AdmcL7fjVOWSV_8-DfA75-WV9kqhiBIlrNPdWvDwt2VhkmwWffwEXVlmbwT2SJDe1Qk&_nc_zt=3&_nc_ht=scontent-ord5-1.ocul
://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_7lpbHic5cQ7kNvwEs8kS8&_nc_oc=AdqnrG3qQ-fmWeBqxgg1bXAfMap-v-kMAi9Rfja_pZWOg56Kh4t6FExlCfUsHwPzH9E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af39rkTGqH0pJ2C5KDPc30t5Zzj7GRBW8LlTPop0vvZZaA&oe=69F764E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klyMQuV0FBMQ7kNvwFDtb1z&_nc_oc=AdrGL52X6EySlzzhKGsTrw40fkBuXrI8WkIQG_9nY3vO9JkJ-RYCjs3yVzDVUMFgseM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1lle314j1-tlUDWuF3aFUBn_9G-hMw6oFULlVUC3kj6Q&oe=69F75A32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9us6HXMIkgMQ7kNvwGBxO6B&_nc_oc=AdoZeRKRZbigVE_KhnpYQ3lXE1uYCJIlN-o0eOfL2pdSQnHN60XnwJAFwFaMZBx-srY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2LHPvjbm2qX6km5A6KGDfyMBA1L67w_zQ2WXbTmaG35A&oe=69F753FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtnUw1QxGhoQ7kNvwEojDNy&_nc_oc=Ado3FEVfP-uVnjomeQZ0pO-EVuwEC6PoYkhCTH7LIjHJbQI5OK_MZO2E63yaeN3BuS8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2jBBkFRRmjrtpuLyPgd7ae4boOOBwit9fiJCbyPvgegg&oe=69F76973"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mONezTx0q1AQ7kNvwH5sQ_N&_nc_oc=Adq-7K0DgBjGJTxVksI6vh-rXHAAyh9f4fdYQ6zDjGO3bJmcgBAb5-umOrWOxbUMIPc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af35Ib3HTvX7xbx-nrsRQS1Akw0X7WnBW2RkolE3vacCdg&oe=69F76772"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pGFGNhoyJAQ7kNvwH6p-xS&_nc_oc=AdpedfZ09u6TDCEbxnM3y-0kiYCP78VLpLnqPAoBe--64mm3oKf5uYhsoTIm_b3LkP4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1wpkaRvYMIo5O7YukCbjgVOy8687OEdl-X22yLbiJ6cg&oe=69F75ED3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbQmRbQVmLEQ7kNvwGyxlhd&_nc_oc=Adpm5CbfleIHRQPEHpuMDua95aP4SPFojGegesSE4YfaQrLTc9stfcQARecr51DfE3o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0oIQISTN61hpNcQXxVge-xyHlX_pFujLW03rJwb5KQaA&oe=69F75AEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqSF3BY7yzkQ7kNvwFgHvUZ&_nc_oc=AdokZpq_CAnzPPYxrwCp6xj0Pv07bWADdaLbpAZKjE71Y5Ruc6Uk5bik2kDu5LwzY0M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2AKt5CtJpr6AzierSZrcBQ4UmNN720S2mGVjPz5o01Xw&oe=69F766A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2jYiXKsxuwQ7kNvwGjQCbQ&_nc_oc=AdrRDiTaF7mqwPVYqHQCsQlYDg1WgGVg5nI9xmL4TJqW7TonBq4PXHsvS21HbpwPmJk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqw4qL5NDx3jRZ-FYQLkoylvk08MB5QygteRyZLbrDyA&oe=6A4BC4E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZudRNErDo0Q7kNvwFRsz0-&_nc_oc=AdqhIAE2nDbmV2d2s0-Ie6782V8ITnVUIrD0GhG8yTY1xEUJ1YExsyuu7GkL5j_GAqA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8hZ3udsmLpLE5nF1b04j9WFXXhhnanU63aK2qUQslyg&oe=6A4BBA32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7FwsVjIDeQQ7kNvwGSTiqF&_nc_oc=Adpv6RxdcWvcq4pHxJh_ueK2UOT-6gUpIEG-27pe9zs6yZF05a2-E1p3QSn4xBoQGJY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmCETdGhRfkE7fX__GaFDM_wIKWxzn2_FW9xle6DacZA&oe=6A4BB3FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IUuK_tL3ioQ7kNvwHmZTrY&_nc_oc=AdoGeHhV5fjWCmh2P6fIi9sZVqScUOptNomUtlJD7Zf8oCmyM1r0y5EmQldsjAeQUoM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6b4X_niNq1kDM66j67KDxEEGkQwEkiAdoccPwKuA9TA&oe=6A4BC973"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWIWgHrl9aoQ7kNvwH8w6O4&_nc_oc=Ado_9kFqTScU9tX1lItfg0mbPt2ZfqOOioP4I1vUQnXs3fAv2VI1YnwKxp4WUPbq4X0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAELiAxfwPGZQdQ5hztFldZLNCGfGrCAznV29f3TJGWlA&oe=6A4BC772"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEtS_pKrMhIQ7kNvwGOAo0p&_nc_oc=AdpWKHJO32Ukmj-sGFh3_RS5fmw4NSQNWOKUzwA5PnEckVqMtllhjEOYqZyGr_UoIYw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVYcVNLn58sO0Ovx2HhYEYKGC4OzGPXt8Bg5U_YmUY4Q&oe=6A4BBED3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUbVCrp9vy4Q7kNvwHt5efQ&_nc_oc=AdqN7hP1t0SvbjFJl-jxT_nHjqnShbAoHcUnDvDvnIC3ECKSlDohU2fDVPbMvJm56LU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeeaNwR3QW0gTEpGkT1qlrJjJOb3OCjJ5lC8J-fyfhsg&oe=6A4BBAEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChICjic4TT4Q7kNvwGAXzJP&_nc_oc=AdpSJKOxBXiaOUlBNLmmGhLLfGZ7oYpsqK1a-L2iT6DVvn0cPAqdTi-WyzyeVr2nHIU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDt6MJ8n-7WLZdaT5n7KSmt1LP-XHS9cSgQC_5iTdzmFw&oe=6A4BC6A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
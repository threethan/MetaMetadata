://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtsFOF4Yg94Q7kNvwGvtsGw&_nc_oc=AdqD-McY4IXojvDYpZslynnV4LBWUitKITWgK01WhpQvIOK660I_IyPGXy2WaBo-YTc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBHHCzAEJ7QgZVWhv2GOdYwnbnlGg30HaIzv0ATUiwzQ&oe=6ACF9AE6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlw-5GrfUsEQ7kNvwGJWZQb&_nc_oc=Adq8NBMfPfjLRyryfS2qsTk9QX097qs91ZXw975t1r7TVxfAoPf4OmgILhBRzqEABFg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPn4J-XZY2X8IH0d-S2T0fQntVxcZRxazlB-Ikp121KWA&oe=6ACF9032"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1c-2PJoAZpcQ7kNvwGEhb56&_nc_oc=AdoBbspqNkx-3_HR5_mju55hbUM9LzvRulqFziCjiuUiF0loIswu1Bc915V4m2HH5eo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONExdQfo7GXAagbviiZvFgFGsYba5Zs8lCok1qjCZiBQ&oe=6ACF89FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=911kPicwawsQ7kNvwHAS2G1&_nc_oc=AdqsMgOVqKlfXLxvbV8gMnpGTBXpIElijtsbUGpnjFL3WB4T9WHM66fHk1hnGKttI5o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAad_Vyo0W9uy3NSF2XDifEkbY9yKNY4CCetY3QgqaHw&oe=6ACF9F73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3v-jCT-IbBIQ7kNvwEgnrEg&_nc_oc=Adqpi4xhfBOlJxWbIP7CjIcu_cUb-c42Vq1aKlJx4TdiaFn8xcxXfgRJeaq02ZfAV68&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCpcQWA9ElXgrxOpUKWP2VrZkrdpdGLyF-1PAAXGFiAg&oe=6ACF9D72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtvOLp5-DfgQ7kNvwE0pJ0R&_nc_oc=Adq8msqXcVJqhiTaMIg39BHOeFMwhFaLAkVJK3Re9HuQCHRkHdqSMo1EYOac77sPkTI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODG1JhD87h9Fq836aZWd0cyXNoSVLeJb4iEZr9jTAWkA&oe=6ACF94D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x80Pw4U521IQ7kNvwFDoAMo&_nc_oc=AdoW6Fohir-g2Wr4LDPU4-NK798jK9WqFmpm-NSypYGaVqJMst-VTNCzjrfydLfVXBo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0BGAjMB91iwWgn00dgJJkukOJN-BHvrcG69ld27MzdQ&oe=6ACF90EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZbGQPw16DcQ7kNvwHEj7u5&_nc_oc=Adokamcn_jUgBwrXloFbgDo264kez2bUh3cF83WX5usDpCtAOnVdt-N7Q9VBrKswtf8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0nrOR2GoAkxMq5TBusoJyfUg2sxuT4YO45PVGN0m2uA&oe=6ACF9CA2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
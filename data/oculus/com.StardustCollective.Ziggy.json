://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=am984PQXrkIQ7kNvwGxQyZH&_nc_oc=Adplw75ApcqxRtTAwNx3V8mDEmmBPyOCNVDWJEETEf_G4UXD2TbmiTmhe56IbTz7Xcc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiF8pbmgdMwqMjL3-nq0eNV3xE6p_Layvn3YaLk92K5A&oe=6AE755E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVSvhgQ8AKAQ7kNvwGTJaTM&_nc_oc=Adpj3_r5lZ1ZviAA5vFZoHOyZZQYLcr9oCdiIcNdTlXPuNXR-643_zrp51TU0DaxXKs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlh7FU6dyyeSCb2UCNl2L73VSqqArf1Iaw3xKWfo3T3A&oe=6AE74B32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1BFtLVfuK8Q7kNvwEhCXu9&_nc_oc=Adp8JFV5y_lRK4ZZys64JPEeCee2eABIyohzXBQ86lSZebMXnLs9EJENCi2HzFbWiiM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4Br6zJw6_6TzAL2nmOx58WdQ6XD_WsojkZYQ2ySd4kw&oe=6AE744FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5ie_ioriUYQ7kNvwHspLUE&_nc_oc=AdoAE_51Fc-gvvY0mYjflLF1daVhg4cGcEaPIc4zg661l7XiHG4RB0RJOYLNMmopuq0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBKZbZPM69Wl2AV_oNg9SPvkaAiJ-2ZXilgSuNKaLo2g&oe=6AE75A73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBO5d6MiPXoQ7kNvwGmCESm&_nc_oc=AdpE_dLFxie1_FMZYcK5BaXuza9Uhls-F6pNBZ5GgGtFMdwi4yVrdQUkOJUc-DToLxg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsBHEiz4iShOBQo5CNE_QGl8kpBupqgB6wa_Gt30UrFg&oe=6AE75872"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nucILE1KFi8Q7kNvwHcL5p7&_nc_oc=AdoAQzYaHjv1uOTWKrBe28s4NiYdm18HhGgY9U9KdCMGpXwQKp35p6WrXRO9Y3pfzEY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQw2qWS1Slo-pqvIRE393fytiFNwE1vRwVybOgl9fls3w&oe=6AE74FD3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ub_MIQhLEn4Q7kNvwG6fGEF&_nc_oc=AdpskvjkgQzuiqBeh3AVOTPuRHwZ-R6FF-HhEKDWbLlKqnFQIU5y5INytIx0OkS2qHs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoid_ifyiDdHi_8TekK4Fz4Nu6DdRPeVHSFM2Lo5uHpA&oe=6AE74BEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaqx-cg432UQ7kNvwHdJpea&_nc_oc=AdqvKeHtBUZiHre5OzUxqbicesuRq_XC6ai060E837bPg81Ij3VSUFo4DnMDmo99L0w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZolctycsjijZjkpvseiathbFun7yVY3buOI3zIhScJg&oe=6AE757A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8ZDx-_uiDgQ7kNvwF2QGMu&_nc_oc=Adrc3_auasbwwjHxyFlsGnM69K7QxAtno54ThnVPNv6vz3DAsomAX8mFmRV-Jaju14M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wVYN0-eha61t0wkcQ2TXuX7qli3c8IHdmC1F5QS1nzA&oe=6A301566"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vW3hm4SChMQ7kNvwHWokD5&_nc_oc=AdqT_M7hBCIAtmKoRlCxChBhhvBv3n1aB6Ei02zoAaMwzBj6uB07s_Aw7-JLbuaxnUY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nYV1PYbr2SokDao28J3-z2mAcPb8xAEcKhLjUIN8Y5w&oe=6A300AB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7q_fUve-dVQQ7kNvwGOpir9&_nc_oc=Ado0exLyf5KIXYsADD4IfritZ7zm9km9yHo0wPZNYX74C-2QDzWCRH164WFpcGCDOnA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Z1hKbOkEKTa8MX0kcgELo-DmbValmmw_MhBX_m3mvHQ&oe=6A30047B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fm_AocvEEwAQ7kNvwGf812n&_nc_oc=Adr3ZjPX0v9nRziZPaH-mOww5zGRhfwpV2Q6NDSUgvenku00DWTxygJUySJc2UgaYAE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yjEsZAyU_Uwr3ZqYI0QN8l3uFZYJxpnP9zED3Ncw2kw&oe=6A3019F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80OdS37cvrUQ7kNvwFAaGOs&_nc_oc=AdqBTDm4IVTCPxFUR1Yx8v0OEefOeFlGaAp8Bze7c1lbeoGPpLYtxgc3QSIoWd1d1zM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rB0RczL9rW9e9qSUyQk57rXJUIeI-5wF-7XuRm13xiQ&oe=6A3017F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAUyLtQh9VsQ7kNvwGPjvRg&_nc_oc=AdqiYmohLh1uNWJjdGfOq-Y9ZYBXaFdYw8CxhXoaHTB9oKEJ8vT1PagqkI7MW1WK6tQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Y7lVAQ0YIraIhCLnci5Lb0wutkJ0FKf5Nz0NEGxMkQg&oe=6A300F53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HoaPH0WnjgUQ7kNvwEbEHu3&_nc_oc=Adp37Po6KYaDO8EVCD2Yf-BM6OjIxfpjAevpewXHWD5XpyU8e6paOjbWnfpshxBKHxQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_r3xqBCaqUGk2xpySc5EXSCqgm-oxPfh1sObj_alz2Gw&oe=6A300B6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRd3-7MmdQUQ7kNvwGa-iu-&_nc_oc=AdpgoO7S8eJ68KF2b0OU9yqKQ88hrZ6ysxx7HHdtD5bsMyvejeDZD93SONNpLOblzhI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8K3O2_s09JyQZosYf3Qm8GdHOP2iiyIm5yhTncySPblA&oe=6A301722"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5ETmaQ_3ioQ7kNvwFSQSxF&_nc_oc=Adp9NKWP0VviYypvkDeVXVEVtBQdtSF8Kiv_I-_OQsNicGgKV9RNCS1FRt-p5GR80nQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hhCF6SzyfrirESZt7-GEuLkhWci8l7anl6GN-rlO5FQ&oe=69DA2BA6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMSVfP8B1hEQ7kNvwFIhwe0&_nc_oc=AdqtUBh8ZK8HMF_SIH0v5Q6mYfCyuFD8WlYBrgCVVueCTgPcifyrbsKOHbm0lFH13r0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3i505Yv7kF65AZFG9039_6_r4SEx7sbWR4COysUocp3w&oe=69DA5932"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x603PcS01vQQ7kNvwEG8w2j&_nc_oc=AdpZxgDZ2t02fbTKepBcebv089PgLZBKo_VdpTukKXXM0WcXBr7GrEdyjC3YdA7otT8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tEh4ItCE8F5PKHeebURIR3GLvqyR24-L7vcAfqAehCQ&oe=69DA52FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Frghk-7ttv8Q7kNvwFicvX7&_nc_oc=AdqTpTbm1Sr-jRTz0IKJcvxVU_SiA2kuH279AaRwS-SPmORdrc25Ueow4GI-1tgnwo4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zQxgEjG2Hm8puZToGyhwPES949KhndOTio-K5WfsBhg&oe=69DA3033"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iu4T4qUawlQQ7kNvwGI_dK3&_nc_oc=Adq3zglnABjlkA2VoeIEdmYYvK1bBGc3Zxz7IuTtuK_qiypJvOOZoUaQcVfd3GZie5U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mYWIlAjOH_ZlJDVtMpiXnHt7ciJezzmAsGVr1ZGstXA&oe=69DA2E32"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GFNrtHzvG4Q7kNvwEcOaa6&_nc_oc=Ado0A66AJ7NfRfDsyWT7nLRzzBvybp4_r7QoAa10r4o_8IyAemnhL91F8s6UKCU97AQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0th_xNaOfEtDEtLhwxGOYzP85-J_ZdjTCFeFFrMtVZmQ&oe=69DA5DD3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ph_iEldEPBcQ7kNvwFrzcu_&_nc_oc=AdoSjt1ls0L9-zmTu0gnet16fgkoGL6lnoXaSfQbIr4d0AYu6-cTId8hWtrToGZc0vM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tQ8BEKT9noySCoD91zZ5-ZdpeBetr95Mq_oj8Gmg2jg&oe=69DA59EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJ4EY80hF8cQ7kNvwFIrLYI&_nc_oc=AdrnrTMnrADu6I9B7MBHc6F0CEAJYjqs8cXpzsyBFqqolCh5XpDwTt4VpwMRpQ5lSzU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AONRYVXKRs06zeSz7Z4qi13K21s-v-xtHzwWatjfSaA&oe=69DA2D62"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsQrjowssMQQ7kNvwFffp7u&_nc_oc=AdpMqYUmIVTzSOZbDh7u3wh42FsO2zc3QCfusJAoR1MVnq9hIbUoX0JkWJ4GNpyTPHw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9T7POQyxJ9o2hrWBzjhOTCL8L617A69NV0O5CbUuA56g&oe=6A3166E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMt4V8YWAhYQ7kNvwENsu9n&_nc_oc=Adq_zH9t1CoH0AlJcf1hpBmmuDxEiet5KJzRKvbe-uBdfqitOcbcEXuZ2a6rS-4XMxk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_7rpGIh3qJZRl6hd40gLAZparyQEBd7Tfc3BMYdOC4A&oe=6A315C32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0wMguOSIRYQ7kNvwGtZftt&_nc_oc=AdrdiUO5HUQuBjhWmWA4uOtO7IY0oO4SKxGX67B37yjpahhepINyWety2Wm65LHaV4A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lRd2Ld0wh3uqA_twQrhmEGg6uGEQADndKdQTgj2GFBg&oe=6A3155FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fm_AocvEEwAQ7kNvwH9iO8R&_nc_oc=AdrW6BSS-yqcaGsW2oNEWXqJGur_CzmJqiKepx3NQZvQjQnkhDUciVv9cT6VUz_6Q0I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VGz4tEBUZVLHkblem19elKp6rZ2rc2vxYTFZ_3BItOg&oe=6A316B73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80OdS37cvrUQ7kNvwE-cDqE&_nc_oc=Ador0Kc85UP7SUhHGoDCIMSYQVXFjiPwmvK4XxLgK11hdl-U5P-nz2qHXyXyJAzF6XU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QgRwGmRIphFD4CXshaS65LU1iFBlM3HToxPYLL9L63Q&oe=6A316972"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuESm8h1jLkQ7kNvwHmMdM4&_nc_oc=AdqmE6vTkH7OeVIYuewGl2RzwOXVCSvVBBpLAPdb4lTYQ5M_W4b6_olLlLLFaH5wuO8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NhtZ1jp47ytuCfSKPEHK69YTXvv37GZ7-j6sl1ZqSJQ&oe=6A3160D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HoaPH0WnjgUQ7kNvwH4hcSH&_nc_oc=AdqsYZB-0iV5n60_BVfXBUscxCmhS2EMPmD-OTKyaxekPVq5sIlIrpOmX4g-I95Jg_4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Z2EfY0mTfm2GowvBrkzNWwLNgNDV7GUqZN6SZlo3yPw&oe=6A315CEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRd3-7MmdQUQ7kNvwEyVUhR&_nc_oc=Adoa1IsNuASLOMCJOHFscTJl0UIc6sbWFMEQWtbFA6biEHudrI8ZXuMmIKnSzneijY8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XzDZpO8wUDGTipkD5tGSROk72YEdmY0LuSI38w14Dnw&oe=6A3168A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
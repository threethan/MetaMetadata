://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1CfSDA9w74Q7kNvwHsuoe-&_nc_oc=AdraO_zP8CASyLjegmSgIbqy753gZFVImcRH99o8sWvMUhcuZ3Nonfkbk2D3IMqXc3s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Hf23ZqWD4gnq81N74xDsOW52kEZPNMobYhBvh54-1kg&oe=6A1EF1E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBgILoPbA44Q7kNvwGbaCA8&_nc_oc=Adrb7fxceJmRiBCPBB1xsF3e_BEmOUzCU-tzM8tFOOn2BtsI4u5c3gFXAeweuTKzYHw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-2-hLRXD5kENtR4gB9AB3ecLtetsi-rWwQp8Kwv3FXA&oe=6A1EE732"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGxALAdyLvcQ7kNvwFmkNeY&_nc_oc=AdofHGnlbDwA2OxJj6FPIzfmQiWVUJZPWhBMPBaIcZpEbDUpWC5LQ0ZCW9yEyy5OrN8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60GBFVx9YlMpA_BctXCIw20CHAIykKpKiWnKPktHPHBw&oe=6A1EE0FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YaIBhnGYVMQ7kNvwFjt-Bm&_nc_oc=AdqaiZTY8BLB_SbHdhorIaWOl8jg_UehRwhzdD068CN1wLFptQe3szbsOBHIrjJg2Nw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7V0Nxzc1cRXt4i_W6gFkpPcanWX7sjx9qfAX2yRFHXVw&oe=6A1EF673"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_bgjQ-UmV0Q7kNvwGVkaKh&_nc_oc=Ado7KUt5ETKSu-PMDoe2bMLtb6P_bXuQ3D8sG0RtU41v9ED5c1bzTb3jbryUqm9mdTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CdqH2m2ScDlDOPsY92zXXoQRqx7sFDZ91kzXq0Kki9g&oe=6A1EF472"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R647fDtS5zwQ7kNvwEIyMUn&_nc_oc=AdowAyJweBI9dYqiBzl1jUM9VHfw2dGkrbylZxd9ZH0JOVMkmmjcTTHvfxfvhhNMeuI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ATEr3gjs8QHwzNrbQbJso2SZavfPBy7cpOrfc8mM9Zg&oe=6A1EEBD3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoeC19QD5roQ7kNvwFWSvjK&_nc_oc=AdqVhQ12JeBNxPaAAWAertmE047N6N80EQrwrkULht3WxqIaTboah1b5tcR8CK1Fpsg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Skrzus3seHcreqtsb3x0-2JXZ3YxAEwiUCQK8IH-yCQ&oe=6A1EE7EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1Lpoj-eucUQ7kNvwFE0npA&_nc_oc=AdptM_sd3d9kJsu3l5U06X4Ub9LaySTCg6ZpSmDo1lnRK3eE7RsKSNyRINyJBU-YnJU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RGaCfnBO6rJbhLkqooKctONvrMEhfQK0xtrJayok2pg&oe=6A1EF3A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
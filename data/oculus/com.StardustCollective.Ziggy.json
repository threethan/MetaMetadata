://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3gRtY9kfikQ7kNvwGPMc7v&_nc_oc=Adqx-r8jSH1N6o_1Z0IfDkFL_8LFPDo-RUiKSxYPp_q2e_mM4jvQ6dFULh0f9maEfJ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kJUjaaPP3fNtrxq5nkKdwMnFfkIIS_Iocg9R9gf-Glg&oe=6A428A66"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgsaSTgQ7J8Q7kNvwEwHjDA&_nc_oc=AdroMiTokIFyZ1oahWy9elQs5a4jEABu_-ziUgYPgyRG1QFL-17ckUZ6OGku3VYtbsY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HimKJnaQ24xpUv9pNau0E1oTQADSLU1ev-mggPz2RoQ&oe=6A427FB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsTHZLD91WsQ7kNvwHVfD_J&_nc_oc=Adpm5zaPKE96X9MrFLFg4mp2KB2Uf9jzQPLSiDWp94IZyHZlc2Ow6KvJ-OuhOa2wNUs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8feeQRgy7PGqefBzcB92dOU7g51jX-RtnJPkZq70iZJQ&oe=6A42797B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBa_65XLf48Q7kNvwHtPyIv&_nc_oc=AdqJr1s0DLZIUArKTaDXduFwxOeMNA5vNhJai2EwP7DzqLeZpeqK6xV9PeuAt9B8kn0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rUbF-TTmgjjY8ieArbLUVCC0qrbGfyeJZmwF8loyi2Q&oe=6A428EF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uiwz-RCH6jkQ7kNvwGQRHlc&_nc_oc=AdpU9YySCljfmnqEzlIyVQfOiY8jWQejX45wM4JsLxdByEJnrC09seGqmBja_651Onc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sOzmQ9jWnhnJarLwqX8D_0zXO5LUEAt4Oh_5D3yqO2g&oe=6A428CF2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2y76QMd0v8kQ7kNvwEnViHA&_nc_oc=Adry3XDCkNwGEVjx48bMUgKYG_lSsWizOA9p_RrqAxj8h0vJJlcgKgZevyJoQLyNR6Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PdRaNw361bbFMoP2GKGKqMqYHmv2210PWirHr4DIXkA&oe=6A428453"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWP600GDStMQ7kNvwGz7kj_&_nc_oc=AdombeX1Cnll-FjLRjleEfxbbJkBq1UsW_2IDgNrCZ1yzb5NtMlheA9FfebJT-KWXI4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8b0SgEk6hl_W4q5fgrupc2vx6uLuj23eH--LQrobPm-A&oe=6A42806F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RtTjoFdlbAQ7kNvwEpfAHW&_nc_oc=AdpDQcRkYDMlzeyhadkad1dI2LiL5hn1DHzuYZloAkZLqJEfrdBdY0O0jwtwIWfJ9rI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CL41KvYv28fJrExvsDAG4E5C2Uz2b_nxdYdhlDwTeFg&oe=6A428C22"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
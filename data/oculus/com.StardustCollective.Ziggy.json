://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuwqTjU7vTIQ7kNvwET18mD&_nc_oc=Ado--ffoirRLh5c90FmiEhPV_G07_vW8fmPabHCjetGuebT9JJjP3nN-6yT98Ll34xw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw0ZwWtME4UtCqOTnsrdkncvElx1hv1OAAOsnXWo4iEzA&oe=69C7B6A6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wpz5Rafh-KwQ7kNvwFir9xM&_nc_oc=Adpzem74_jZXP-s2lRsMaSILq3joi1gOTskIcWy4r0_X3csI54x-q6pKrH4Bgd_7AwU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxJXvzm83Qb0h0MiiCp4CGN3ogCZeuXRCn-A4tZgRtjBg&oe=69C7E432"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eadb3tPJ6qAQ7kNvwGauR9v&_nc_oc=Ado1CSTW7hGmqpNUib3TWzRa7xxnaM_cs3Gy0Bdm1u0UZDTQxr4UHsr0jfwt4YLLcwk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwkGXYLkqy_S5nJyrW8kBGVXsR6tYdQTfuWjrZYhpd2vg&oe=69C7DDFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gr4d3bQnlzYQ7kNvwFiFakL&_nc_oc=Adqmep0N7wmiKLKd7kM9Gb4Rz3z4gn9Hrss73aHU56OlSC5tWMVvbDxD1oXGUXR4mCU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyaDvIMlIDuoAiOaOtFE5jo99C0V2q5-ONbnwWae_JIJg&oe=69C7BB33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcyM2BrIJ6wQ7kNvwFrTJP_&_nc_oc=AdpLcazyDBl_MUIS-iFYU0OmWNiG4SXXSlUyyludb9hr3-oY8lsvuAHjd6mdz-Z3rSg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2CxPC18dEhPZU6ejxSyfTnPzFsF8_RQPv30YSwo6i4w&oe=69C7B932"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSwpXktnSgkQ7kNvwFfEYEM&_nc_oc=AdprpMkIZT5rmyCCr2bcGnnf6lIz7BCTHT4ZijAMhU9uA9aiqxrionpij8Ok9HK1t5Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwr3uubljCZBAb1_V1gRsrhe6yvYBH-J4bkoDQDNQEosg&oe=69C7B093"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PENtYrkBRM4Q7kNvwEUfJuC&_nc_oc=Adp48SeV8HafDvzBH-FPQrm3JRhgTMo_uFPEHL5kVnJWvP1inKTYb-N15eCQvw_8UPI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySNcuhiPE3HEnTk4OdNMOsanRSdb-dTNte-o2jEGbifA&oe=69C7E4EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OkaCxC3BmEoQ7kNvwF9W4YN&_nc_oc=AdrRkFHn8cvMImk3ra4MOHHpfNOJn5ZPVML5tryXmIkQcCEgX3L8lNUaKLAjSQQjC_U&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzxIUF0WBDzkiZYrmv9UcBLI1HKXZ8AUHHydRfC_STIgA&oe=69C7B862"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DetIDdytafUQ7kNvwF1tgfE&_nc_oc=Adqb1OsV9bOv91KIQ9FJ9r8igHgYt0qMhRahTi7uGhknxbWL6kEGJGUzLp_WdtSJsvk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAGkud53KULImokcV168fErbKPdgTyGhC-7CLtRwwImg&oe=6A637FE6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WByXZkWWcN8Q7kNvwHqNkVZ&_nc_oc=Adod_XXoY6Egs3fLG_CNx4yB7AKKkNG7rNqM6JsuiGuJJffvX9cVnVOFgxZqFS2JJxk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-p_FtocdVWDlGWajU5ICIQ23bb3JA0Xu0KLRqVFcOCA&oe=6A637532"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qV70tQQKGsQ7kNvwFmOyYb&_nc_oc=Adqv3Hte8-yY_RGstZzsIWQWWmsGQUduK7J5zXkOAtaoXp_AdZzonWqJyPTqPDjCbBI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCywFwkx3w0pjX6iAI_PrBsC81sj9E43fr4NSHWWnis-Q&oe=6A636EFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrsqvrxTGgIQ7kNvwGsGdlK&_nc_oc=Ado_FMW1-_oLeD1RihKEw2cLcBCivHDL5NTz9gyBfeX32TqAesCjAcnCCRxfJkTnWq8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3PPR0b09GTtIm67riUxCNuB0qa3Vci8iPpPi-N7lLNQ&oe=6A638473"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1BwaXsFFVcQ7kNvwEby_Z9&_nc_oc=AdrOjMw5R7PcUw3qdWWdL3GaYa1WhNvd-1FK9ZtwdDA4xcpQKUmxNarjmbd0sOM0rr8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUYMHjVWEcmPYg6hjzkqSUexWOGKJnYPL46ubR5GqJ_Q&oe=6A638272"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4j6p6-cLuoUQ7kNvwFAyIA2&_nc_oc=AdopJmtDAnAifamyhkC0cZoKWJ74ITrO19RZs5bM2l-nvR3YqNdy7acRmqgx_BznyTY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDO_UKUtcUwWhabcrOf8rgImAWMpleBhDPZv2JPdEaIvA&oe=6A6379D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiNAPrXbPD8Q7kNvwFPWXcp&_nc_oc=AdoYEOjgRJnY0-qp4v5wt1_Au6XAKBfIpT1MUJtbA5slV3uPQ7fuzqvr1hCin0XXM8I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAX_bIyTdZyR2mtb7tD4Zp5QVnrIiAvuwOsInlKk9mxHA&oe=6A6375EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XjDdI3s2hgQ7kNvwEiCafc&_nc_oc=AdpuNRiQB-Iorxbd88a86PzdI9oAaayFfLZbL-lr3spXJehbqZbtI0ehCn6dKPJF5m4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjqDaUhBufUuKRBwqn-hcKJsgVHfcsBnlUBs5rFhQEfw&oe=6A6381A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
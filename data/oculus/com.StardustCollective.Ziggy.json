://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-HfoBRJFoQQ7kNvwFit5Ci&_nc_oc=AdqCCXqh9TVWcyIuy5HjAzDHy_CVawBOJeJ_T0Cx4GBvf6jpOa4PXZmxHRsmt3PPS-A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98CWAJ9_EkdEarOfE5GMHqIqAX5qzwmUMRJGuRYVpwtA&oe=6A452D66"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3B_i0ZtJO8Q7kNvwE-2GfN&_nc_oc=AdqN3WxDQEQpA7oVvVPauAjiKkCge6AQRV6SFt6-MQd0uuSUv9eiVF9BVYZsucs-3zQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ncXg8qdXCkFGy3dLATEPFREx5f4uZmCcf_C-ipZhjoA&oe=6A4522B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YZMj2dJs60Q7kNvwEISHTY&_nc_oc=AdpJRdRNob1psGil8PRSzI9Ol8wfJ288vrGJopLs1N6634Wr1yOFHvoGIXmqp7ajDOQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xaxV9J3RhzukDZ0Zc8Lt_PeN-zrWnxYn6GPPTkxd3vQ&oe=6A451C7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qXKhA926ywQ7kNvwEFVtex&_nc_oc=AdrxavVci_0vOkYcubuToOgZcjqlhIgVdIyby80XmBw74apCSoWt6hSL7cPNsgFRsZo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8p6gQ5wzTl0LOIL8pRiJVjULME_Kt70NVak4ncLnrqog&oe=6A4531F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiLQ9cg9YjcQ7kNvwGAbScN&_nc_oc=AdrGGocxx8ZKDO3_hduSiqEao23HOgm9gMfDEhyEp9tjSKfbMY6UGtCNtbL9ugV0mLw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YhRcLUtHx4HZjpA5_oUaMC8BSyQ3MdCdDyZWRT3Zm3A&oe=6A452FF2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UW4f3i5H4aYQ7kNvwHwHQ75&_nc_oc=AdqFB1JauxM8MkPAKz7adGawRy8aS6UDbWJSYw8JGIFzlL8Bjinru8JJGBlU5eCM5gY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GKDkiEkqyU-ybC-GyYEspB0-GTjuHp4u78g1pD0Y3zA&oe=6A452753"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTZGhPrvrLoQ7kNvwFqO8E8&_nc_oc=Ado7ah04bdyMp1_SqxTp3LVWBYvwYUwGAjxFbX2xAzS2RJUKVxq0V9K7H60iMNghgnU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZgLK8rTc6ujS-2g-5BaZcr4kdXr1_JkmYJxp08JM4zw&oe=6A45236F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RtTjoFdlbAQ7kNvwGxvH9A&_nc_oc=AdpUM-mHDGRG8ZN63pHshGG6rvNtMGruy2lOtx36BFuq2gYpcBL4osu_GFjmciiKWVY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81vFcMNahCJsCRNCeaun2cc1Eq1FeuhcUNy9Vtv_Ld8A&oe=6A452F22"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
-25/38974500_800214781605120_8880468551637015930_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYNfBZ68SmMQ7kNvwGTJze9&_nc_oc=Adl8zlo0pWgGnR-IsEeAPDOwHC5uMC1GW8P7CcbRTgJzG9v3rfOl-FNXzTiBfCo5Fdw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuFUBDivRpzkBJkxVl-CtE3wNpb13MFDiXV2TR2wr4EqA&oe=69A4446C"}]}, "id": "1005005773748906", "locale": "en_US", "screenshots": [{"file_name": "HighresScreenshot00011.png", "id": "1326199667974786", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035386_1326199671308119_4397089309417940909_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTJ2D4DP0pcQ7kNvwF7oYmb&_nc_oc=Adkh8eiI7bRHsIcPQrMYoPewo1nM5yjV7mirIpgfaNEWWYd1vHRq-wGIL2cqJU_crNs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfupBTplZ5l8mPMc2jjlR3e1-37c1Rn6W5agpfaFcj2XyQ&oe=69A43DDE"}, {"file_name": "HighresScreenshot00028.png", "id": "2412721535575051", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974577_2412721538908384_6467288184304840049_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3APH0lQ1-IQ7kNvwHuHGPI&_nc_oc=AdklNa2AFYX1fUGO2pEjfdMH5XF7SOcEfn6fWZ1_yS6HBs3xb5JlA2W31rg4EhoRy0Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvKUOqlhKHtuDt0Mekdy9nNvyTWwDGXsZ-bFggbXbouCA&oe=69A44E4F"}, {"file_name": "HighresScreenshot00014.png", "id": "997351624641332", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982456_997351627974665_2778603811108028476_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0Z20bs1l-8Q7kNvwH4X9KJ&_nc_oc=AdkPUgVgypdqZQ8clf2D0bMPhPWWKAADX_5jhPl79bJJpRMIParcAkKMp8Tk3iwPriQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv14T24FekZM0r9FcgunXXkiTeLSHg37XqNzkhz_KSgrA&oe=69A44121"}, {"file_name": "HighresScreenshot00040.png", "id": "807733037419699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984472_807733040753032_763200239777074167_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMe3Bn5Cs38Q7kNvwF8P7GE&_nc_oc=AdmR63yLY-z6TehacLqPOoKt614bZsK6K29xR5CIjXSyS6KzYULmKT3PPgIqsGWzAew&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuTo0TLh5IlqMOoF_WI2UqJjb_O-yxJKJOTiMny7P6J8A&oe=69A42BF8"}, {"file_name": "HighresScreenshot00146.png", "id": "163970600033098", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566678_163970603366431_5435931785999963108_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TBtXw5R6w8Q7kNvwFXqSGJ&_nc_oc=Adl_ghRj26n_fbxUzcPbh5aQ_T2ZEqcn_31x9Vs6C9WlwuY1YbsSR9gu06CZM-Cp6iM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvaRe4YeiQ86PmHOJ0BfSO34L90TMni59mqoBYheywIEg&oe=69A43071"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNvL5MxtVJkQ7kNvwF0lXSr&_nc_oc=AdnSK4MJQ9ZDFYPJxBzyJ8A5KlJ8rZz4dNfnxuc5IZl85HdbY8E9rfZ8QkW3yoJqY_c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftu6rJfB91ztLNVr1ZkS9K60DDSF9PqI59vgON6230nKQ&oe=69A420B2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "1324311035174797", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984472_1324311038508130_2610060411856834928_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Od9BhgDvdckQ7kNvwFbEEF0&_nc_oc=Adl1wzTVNqcSAGugG3DJjEQOMc2QwjU3JnxcXzPHwBU8k_HgDVoiYypDabaZ9N-J_5s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftRCk7IHzsrnDwxe3-TwdS5AOplFCiLzpjXtR5m2UgqXw&oe=69A451B8"}, {"file_name": "CoverImage_Portrait.png", "id": "1021944422558335", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031612_1021944425891668_3460677483354056217_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGBGiqGBJJQQ7kNvwFbJGll&_nc_oc=AdkcGd67L58rd3tEriBSpCYXq_e2mFIk7I4Xb7ZgDUqTWDnWjxZiTVnFWAvRI7d3I70&_nc_zt=3&_n
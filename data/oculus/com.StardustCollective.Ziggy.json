://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DetIDdytafUQ7kNvwEvxCYh&_nc_oc=AdpALWcYR0q-91RE2bHtme5N0cDalmm4UvkmvFhRT1YfJnsqafr3lmx8Zc1LBOeNb2E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAT5fESyVHv5Gc71mowWkRGgYrkg3-AI9x1hkmCQD4ahw&oe=6A622E66"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WByXZkWWcN8Q7kNvwGvoMnQ&_nc_oc=AdpQe1fDFMyQhVYMLBFatITkLJmb5e-IdO7NEaftPpq0Du2C44A6tUrc-UvK1OWH680&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZcogHQeOnDFs2zyKNoi5vJwXbl9EHLozAQdAzb6zyfg&oe=6A6223B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qV70tQQKGsQ7kNvwGwJ7zc&_nc_oc=Ado4faNALjSx4xyWN8G6n0UWh4xbgdmvXRt94Q4Jfye5KOATL7P1ROc_IvpHkxaZGL0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJ45X5U6hbvgIIIi0hjSbZZwCECSn3s7_GT4w_0S65BA&oe=6A621D7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wa-E7B8bb9AQ7kNvwEOX2gZ&_nc_oc=AdqE6xZGWno1Y4JTvOt8UhPow3u-aLFJzkXE-OC14zkfq4-iDmTUKknzxDIc9-6saIA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxipmmrOMFTTsZQdU3vx0TD2VG6IbjO3x76KwayNDGYQ&oe=6A61FAB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWpiEnAdLXoQ7kNvwFbr8pR&_nc_oc=AdpAntQbgFNqr8CErqSk0yv_8wiyPjG7JkbGaNY8cD3Q1rQlauyHQWANeY2BCAUgQXA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB35pd_X5YBvhD4kGKl0lIzNnUs4pvA5vxa7_2ZXi1KKA&oe=6A6230F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4j6p6-cLuoUQ7kNvwH9-7At&_nc_oc=AdqdnHenJNm5_QmM3rNNVWzkoMB-M7009l3uMYCJ5PismfgI0hC0_sc5j_be3TulYWM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGro4A0Rxw1jUum0tqPdV9xiS9Qmp_wZjy4Cr0dWDJow&oe=6A622853"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vZ9r7R-0NYQ7kNvwEfb77z&_nc_oc=AdryeWnztruQmHz0FMsJjBj1sAhjWKlhPjDlsjclQrUYowOvqW6rBZjTluLd35Px2jc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAblsiWs0RV6Y0VkeG0Q7K5fYtENE9cFGr-2zbkUBLbWA&oe=6A62246F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XjDdI3s2hgQ7kNvwHkDilf&_nc_oc=AdoCwNgUWuBXsV_xZ1EqU2FqMrg_mwgX3QZQ37IyrrR7GLhiFujfwj7nv_-4S3vXqfU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAopMlGlMkdZz9dYMCzK-Wc4TD6IMK2pOr8MuOTM6DbyQ&oe=6A623022"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
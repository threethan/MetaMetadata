://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEaLofCur9cQ7kNvwGIYsMZ&_nc_oc=AdoAR4ipAkvNTsTUZdPidZIMvec8D5wMAqs6uAMXa5KH1O9guX0MTwqoCaaBtbkvdgE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJl-aVPrBrK_vY2sFS2PeBk3Ww_hWt-P6nslPYfg-FZg&oe=6ABFC8E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1OwWld3rtEQ7kNvwFgUaQU&_nc_oc=Adrlm7uYi9lVA6NQKYvqpJtXGW-MMDM2b6XZgcalkEDfQdqAEX4OBDddV_Yu2GLxVro&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7go2KIVjRCVU2kDizF7E51f2a5So3hP-J-cyqXhnL_A&oe=6ABFBE32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGjXVbdGZl8Q7kNvwEPtaO0&_nc_oc=AdqC_nkt08lDx7LrRzTgRJ5GC_kCLyuia8lOMewcNEQJgsgTwV7_VZgfU8S74tjFf9U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsZu357Nu0vKEsjbiHNnx5ydWt4x8Ja8p0xAukLi_j0Q&oe=6ABFB7FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBuCLL5Ko0oQ7kNvwFkIPhJ&_nc_oc=AdrJfnL0JZ6i4RGr73VePFBjf8iKsLBwwa8EyL8VtR9UlIx10ElDtHCKSMIpuMrnLkc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzCJu_9gxKu4eHOp2Y_pk2EPnsaWrhIPt8HLtb0VEWyg&oe=6ABFCD73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXBi9eK-2D4Q7kNvwFgxp8V&_nc_oc=Adq469Jdl_V5A8JprhEzP22XrkvmNVZv9PM1S4PYnjgoA6MttWC7vPb03wseCtd9CvY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOz_XvdozxheXG9AYcGK4LrTMFvKdnHWFUT7HYDg-p4Hw&oe=6ABFCB72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8_NmGfeak0Q7kNvwEoRU83&_nc_oc=AdrAR-md5uCEVaR01rM5oh7KrMvkHLYgGprrzg6EnySSClQ3xSOh3vvOwn6VvN-x4to&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOIAyFophO2gUHq8RkWT5M6oUxE8pTjkysa4rpjeBg5Q&oe=6ABFC2D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wg2nHFPEhhEQ7kNvwE9sKr5&_nc_oc=AdpZZns5pHd53cGiIDnaY9L2WH-QqCJQC4obQrbs9FqQOP3BQtDEQijphb7k7AHC_0c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrv6vELfUHBdjAgCp0kVkeMZFlfcuGTkHwSzwQuFVd6w&oe=6ABFBEEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfCn015q-q8Q7kNvwGUyr-R&_nc_oc=Ado8mFy6O3pa8m5ThfXyNuwv6p8DNhCTi6ylSpIk9XkZs39YPJMmYxoAuhGEm4RfY44&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_UjCh_GYoCcMFgdmUnm63Sw3avaj9grxy4a43YhxzpQ&oe=6ABFCAA2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
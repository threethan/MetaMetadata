5_2778603811108028476_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6SFG-LPYt4Q7kNvwFHd4Wh&_nc_oc=AdpUWOiacCB3LlbSnRA_rvg1Nd6DZEn2WyxiYLj4KrvmbcFHXVp8AxdCuJ5O_uIruX0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3V1JCZ9NyDkMWYvt396v-A8e3dhxkhO89mLRHpbqEkA&oe=6ABA6DA1"}, {"file_name": "HighresScreenshot00040.png", "id": "807733037419699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984472_807733040753032_763200239777074167_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0715uUSCEsQ7kNvwHQ-MOR&_nc_oc=AdpBVIDEiWhbPwF0odvaI__cNVaCvzXpvy5EvMzJYqevEo0trN7UFbDXDWvCB3MfObU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3eC1H3MtlVRy1w1L46TnB8hkv5ImB6UDIuWmdpoUxLA&oe=6ABA5878"}, {"file_name": "HighresScreenshot00146.png", "id": "163970600033098", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566678_163970603366431_5435931785999963108_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A99rgVFP_kwQ7kNvwG_qbNy&_nc_oc=Ado3vGg08MRDevOrv5ZF9H8LQ03FGU0hc49fMc6XBd0RuTmvmKwWqV6VldHrZc2eo34&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVaHJTBxVULktqPJfUX3ggnxYEdrvR2glkntVyTVIUOw&oe=6ABA5CF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJ64gWYP2VgQ7kNvwFQ6b98&_nc_oc=AdpolH3mvpI0pgF-uOUGIx9iOWIXF-Mh0lRm9S9B3kuA1okm1auj0nix8HFwqQyAZJU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJ8umc24Myc3RCgyY75VGuNdDnBR-KVHfbx00NVKLiJg&oe=6ABA8572"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "1324311035174797", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984472_1324311038508130_2610
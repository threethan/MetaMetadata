://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KdOznZlMtgQ7kNvwF29URr&_nc_oc=AdqmAotLSoYBMG_HqsSyFQT1TFKoqjMpcg11Enkp37c2pJ9fAGz-BR-6bio-PGol3xY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hQhz9KQGUAD0oj7Z2xtusxq1K_Zl7bt0ZnhKaNwJ_Cg&oe=69D27AE6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWJHglq192EQ7kNvwF7xaAD&_nc_oc=AdrS0Dadk_UPsdNqdg_jOjcrx_pruQpDnp06NN3upamWDMS1JOkAGA_Burb-1Tw1o2M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CCJ8zmJsYwtc-n9_NPMRZ_qyRa701Ul0DCIxZRouy8A&oe=69D27032"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4zj9iIfY84Q7kNvwGqHq0D&_nc_oc=AdoQydrzZLXBKfenLaowCSGjuZAoZekCGN-6h7fU5Xs6lkljCNr45al25-on15KixT4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0opOOiwqMxiUgIjRfZTwBIEvu9N1K-yN9rBTLGHibgCg&oe=69D269FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L14BBg54fnQQ7kNvwGRzgNF&_nc_oc=AdrhWCt4UFd85nDgC_jU3byvveJYPlpcGfJKCFTxgsJ2TUDzUml-n2CssW0rMwgRnow&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_7f9c7jnxPvcsCh6i_4v4tbn4VnLjuhLYQ-Zb62DMZg&oe=69D24733"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7Zl0luW-jAQ7kNvwH4xdIw&_nc_oc=AdqNx4MHGfu3vJuOVm7jghZivs4paDVOCasU4rl3EpfgK9tF7AIH-uhMy0hE06w5dBQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2A6W_COwWjX-X3Vc_ieEYCf_A8T8xU-Nu342hRdN_lcw&oe=69D27D72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iETFOFXOumkQ7kNvwG_GQxp&_nc_oc=AdqWJVRCVIsLUnAqg86_oIKh2LKoCprbBIw3uSLC7XbMWSSjTiW6y3UedaiJaPuDKSE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kSMHalLZe0oXq-PtXPt1FD-8omq5yrunnWxvbsJSR8g&oe=69D274D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNldto8865sQ7kNvwFJQnhl&_nc_oc=AdphN3_Tsynwz_EAnTyGCRPvkHMFvnFhQ05gNPNZ3-BFzksrqqjXzPpBXG3JXBRIfDM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3T_MdmO84jpFooCLUB37SFPhd6jB6NZ29o7C6uHVX83w&oe=69D270EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krfcRAB55oUQ7kNvwGbQLvF&_nc_oc=AdovCVSVxA2JKTOXlrexkrUhPqz-fNqt2Gnry6NayfjEPm97r_26Zif_FX4FYeToLs8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3djoNZgvJ5P5ZDoDTecy9R-6pqw3bwCtEp7Y5VXipeIg&oe=69D27CA2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
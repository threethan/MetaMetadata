://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pnuk8L0fWbMQ7kNvwHVhi2D&_nc_oc=AdrfQYxqJ707p1iKe2OpQ-MvpSPZr303HLQyN834WEuHpoOM2WxxN_J34gcRCd0j7VY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mneH0jdIezIuod7jdsSOxBooheZE_jitaRaAJT4jmqg&oe=6A3E95E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofFsaku1qWMQ7kNvwGLpAYS&_nc_oc=Adofem8Sw__WL4fCc1g0wf99ceMK_djxmvoWIqamVL2Qp5E2LZCtHRkIJ4tPLrGCiPQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ejqTGyrQMGXA03LSDaGBkbOFZGfUAj5Z6raQs27Wukw&oe=6A3E8B32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R71rhCxdK6kQ7kNvwGq0SUq&_nc_oc=Adq-Q5LHYPq2UnTWZG4-3RPpl-435K36_61H_kTNB8c3NHrKxXMsO1RjZhZyjz9dwgc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Til6wk-O_u2LlpfCB-szNK7DgMKiHT5VYV43lYvfA2g&oe=6A3E84FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnNoqoAx-7YQ7kNvwE36lrw&_nc_oc=AdoQpSnB-PA7PksGC8p3Ni-pqK-B8m35xK-4dUb96ICZQc5ZiCKW9qB5p-c4tI91NcA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oKboPlEpmP6PP7AjbitrnzXvVm-_meRcp_C6C-jIZTA&oe=6A3E9A73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qE61PpJq1F8Q7kNvwGP6r1t&_nc_oc=AdoimD4Q1ET6wOnxcLrqo7ck5hP2NWdrLM12r2WsM_w-77rBkX0Ik4E6Ruks4NuU5nA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GSGczacYvGDNQkbZEpjPdsiNZifnPmnuaRjbAzy23ng&oe=6A3E9872"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6nHq94d9doQ7kNvwGvwkTr&_nc_oc=AdpGpKwDbaJKLUxDZjg5PxUl4DZBBFkU5moPBsvNO0L-W1ZDeiC_6tWjNi2zLtpxts8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hZHVPrQJJwY_8cs-8Z4Hd3VidldZwO8PvG4Y-TPvFgA&oe=6A3E8FD3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccBTfcSQY-UQ7kNvwE5HzdO&_nc_oc=AdqiUqfNEWau2FYr7k8iIm_wOCwziN3sOfCNyO4kxLdD9bmeVzwNb9qUEytMPma5ZYo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8a0mfMIstH5AfPOjF0DAwFEZlkYoctEQamY4ZboiOg4w&oe=6A3E8BEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PyLqn44s-EEQ7kNvwEj7TRn&_nc_oc=AdoNcqm7QIO8zNM9AVmPLZtQPtYD5q96gXM41UD68pIglTRVOF-5YIhPjn_znyri7Xg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nU3wkNOGaoZ6wbUSlEhOGhd9S5X9ai7_r1tALDol7EA&oe=6A3E97A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckZlIBGXrNQQ7kNvwH8iAJX&_nc_oc=AdoEFVIwahova_508ZIDTfhhaz1NErQknxbqtNM4IxYnWv9n9lizebFXYrBdKk-O1vM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvUlcUJR3kTBDQONk9ti-NXiwcM6fzkzHt2oG9iG63FQ&oe=6A940F26"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLYK9B3Ym94Q7kNvwG0qbSc&_nc_oc=AdqXDwDUmBCnIynYf14Kgg_Zib1ySDZ7gx3aU2Oa86iyAAaudBgPcPeFyDEFGgMHyV0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAagUeYcCBfn-mUYHTNv_vY_gzlLZhaB-6_19Uh98f0Q&oe=6A940472"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GX_PT8iacJwQ7kNvwHv3Y3j&_nc_oc=Adq20bTGZ9_tnfH_U0NArdku7KQBSGkU2S7NfdYu8SCYWFZ3yhZEUDhhBYvdpggTQiI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMHxtjs0hiPYWaC7gkfVo-RConfAQv4oD1wSChPNS4kQ&oe=6A93FE3B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chWXIVlxWk8Q7kNvwEt-JWQ&_nc_oc=AdrNo2OJWZI_NE5dR9cmGLfnND5SRBYObkZFgqvqEYszMe1JNIxi0dYLzXQIhsr7Ibg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7pFUG1p3iAJfH9aIlLYaMaWQNh1TN_Pmp591cIypYvg&oe=6A9413B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9L5gOC1A3cQ7kNvwFYnGpP&_nc_oc=AdpRHGbH7o14ddtYS1k7RcagNuT4IjSjQmsHsNlWyem42gN1GlNAZlNhpJ2tbQQuMKE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLfWbWvAmBLaYwYcgKpw7hgGHOyHYE4ot6mkAe5ALgOQ&oe=6A9411B2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6g8S_A7dkUQ7kNvwGRpbyL&_nc_oc=AdrwoVG0Q33jqD7u4Rtpdm3Tv5lxvKLDM-m1CqLZe8HutBaA7AdkDNeCMY5nHIZqMEg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGay4rEAPvYWcjqB-Ob_3YKvcbqgjpGAB2a5_5qH4aBiw&oe=6A940913"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YuM_2ztdk2sQ7kNvwGQKINw&_nc_oc=AdoXN-qbjdC45wwQXjYW4xcWzDNYSV6OGhi1i9GWwDL72jqKwVxh3js1kbK93B64oS8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGm0kIXh7uHHomqiiFaptNfFDsblHBpG15WrNXPEOGEFA&oe=6A94052F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISjkoO4kJgsQ7kNvwFg6CGR&_nc_oc=AdouAd9CXno1SUZhisgrw_uNGz_K84-ZSx4MYzrunarZNwPoCRtiuqtpYKruuBkvDzw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECQTgGNSC6c3uZ9vy2FpdrCNBpB79_ac3u_vyOIeSCJQ&oe=6A9410E2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
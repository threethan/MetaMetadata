297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8lNUMZfRC8Q7kNvwHltYJv&_nc_oc=Adm_D9zwaKt6juhsRp5crMjovKlRCyO-LNd8OHfAfu5rIOrlAcTMnmCrfXo8SjOP9oc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxaY08pPthSoHmVqUj2QNN_45u8Kjocbkgd3my97G8UDA&oe=69AD58A6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4YPcAJokpUQ7kNvwHmWe2U&_nc_oc=Adm3Qeq4Vy5sLsjDZu3VdAQby0LHeVK0jwI2lYXfKQC44hOLuMSVCJSIxyh42K4KWrA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwdvzkUMyW7PRdyj0DfCzOCbhR1OhFTCdAnVlfQmHabBw&oe=69AD8632"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XCBjbq5bhEQ7kNvwGZeob0&_nc_oc=AdmJHtZXLlx23_c4O0dmWv4l3gOvSi-wLCN2WTi_kXtl0G1zANUr5jK5eXjhpwbjdOE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFkgaIAkDMzx_QYJJ31voH7FovMiOxy4rQuvR2QFSMvg&oe=69AD7FFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sr2Wh6zvpXwQ7kNvwFZS-wa&_nc_oc=Adn-aYJJBPw2S3d1d1hXDFeW9SgTBfAYGMr0v5SKYyap1Muc7DXTmQ_4oZ_f4RnmANY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyy5860yf6s03UmReRiL5Cfc1hPej1yWj4ot56xmpW5Nw&oe=69AD5D33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRYVlzmWzN8Q7kNvwEeytj9&_nc_oc=AdmwwGrSxXIQb4cz1qrFQAwFaBlCTgcyscqed2oHRpgLXF80cQxa9ewOgbPvoBrEMEQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8x9xPbPIBB5C_x7X94n7_LWgLOobyyu476bUSesscqQ&oe=69AD5B32"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-CKTAz2W9IQ7kNvwGc1hTp&_nc_oc=Adlepb_g62MTlcv3DfLwVJ-1BaPPD0oD1j4IVosOGeG7qMIlBlxhwjxFWkYdI-Pux80&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-fGhVbCDO_JfUKyWXGQYFoWRM1btFW-2D9uvMTAfv_w&oe=69AD5293"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9V81JT5h8fkQ7kNvwHZ5mMZ&_nc_oc=AdkCX7hpy7doYVI_EiSPQ6StYobD3M6urQW4lfYKj9v8RgiwBFBSlGgVLrrii-sexNg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzRhSxkthHksvAvsvIhDXmZMPLuleqpWii0cSpG0GqJKw&oe=69AD86EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKh81YE-gxUQ7kNvwEttt8x&_nc_oc=AdkTt6-TXH1Q69dvqRnRDtaxg-h2FvJHErnJuVMQfYv3VZ4QzDnt191XqJ4cpozhr_o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyhRCNX39swR9hXt8HLL_EX8G7FeI59SZU4bHp9z5JLZA&oe=69AD5A62"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_5218087471640407679_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmpDdppPgXUQ7kNvwHm9mwH&_nc
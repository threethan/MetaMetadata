297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOiE0c5z96IQ7kNvwGlipuA&_nc_oc=AdlI4dF7OjTXMsLhNl7zgVQKYIHTzHQLvzNPnfdcROp8rFYanXU23Wl4VntLJlptqvw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJIFOI4Wn0q0eiFslhgzd-Na8aEj1Y90HPmOdv_d2N_g&oe=69B69326"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFR0hb4wrE4Q7kNvwHbyYGM&_nc_oc=AdmIDB2ADUSklDnMOCfXgu5IolMf5KKnDS9aSr6zXMdaXiXw4tnm3nXsLwZMsoLALJI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzvuMlFh98TjDxeVGd_mVegJWyFV6H8981YuxnggpOvpw&oe=69B6C0B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_13huUlfXTAQ7kNvwFxW4gQ&_nc_oc=Adl_1qI0-RpC4sPNcDY-YBFp5w8wPOHwWxkrzwcXoGhzY7I2MEYgE74jMMIxTSZSevU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy97xujh9C9YS61INH1-eve6f8fUeuz3U8vexcMANpq5A&oe=69B6BA7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzfEGqogszcQ7kNvwHWocsh&_nc_oc=Adlyt3x0FRXnubAAMAUb1rJcPb3Hd6P4cf2Z1FAG9GTHWw8F1Y8cKmlGPl6OXlhdb60&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4WS0FDpNGWPc1ZtKxCBRRhJDpsg1LBTQabPghgnkOxA&oe=69B697B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBP6uxLyW7AQ7kNvwHAY-Cr&_nc_oc=AdmMsO8FJ0Z-schdr-GwGAWV9jes4o0o_1hsD7Q-TDd6fkiE6pZ9-3C7Z_nK6NEEbvw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzX-tE3o2tFeGrL742A0JOKjy_ryav8VFFHBB0DDDnmpA&oe=69B695B2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kM1UI010Qi4Q7kNvwGtAj5_&_nc_oc=Admrkujw02W4MKRx4nr39bIJrLlJlPMU22wCq8AaGjKBZu_i0TigkutGAgNtra0_ycY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxp_-KweiFnjpUkuEFGrA23IDURFQbp4TDC6ve7nlUpKg&oe=69B68D13"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4thfnm66VuQQ7kNvwGJL2kO&_nc_oc=AdlnUQLnTzTjtmweUHG1Wkto0-CFDtgXyHNPZU9W_EOBPrdYpXu_rFvrDcKjorQuu9A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSBdJWab8NyLUsqykeGUKEUw_na4MIpRb_xg4k1E6Q0Q&oe=69B6C16F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1eUF4H3HvsQ7kNvwHAqoIi&_nc_oc=AdmjD_59pucdJSNqomZdEAFF6ejn9-srm3hw6RTjOaK1cto33nakn7qo24DUkRhMuKk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLWcVHU2XQIZCK3nM93kMXwCIQVhT0vYyaSDkJthOC1g&oe=69B694E2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_5218087471640407679_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CuSpcV1W2CMQ7kNvwHTs8yb&_nc
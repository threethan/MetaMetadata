://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0U7Sof_VE0Q7kNvwE4N0An&_nc_oc=AdoM-BGxERNWcL1uDN7O-Hya5-prCa0Z_3TSnOrJrAQxKsf0lWypgHCUqZHQZfWszZs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQB5rSIMZWW1ajbsmBciAoBD594tt8TvYeg6wh-Lk8Opw&oe=6AF5D666"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJS_ASHPjFsQ7kNvwHoByo6&_nc_oc=AdpdUcevYVE5pGpIQ_vTJzQYhT6NGd5mqjYtBaKKNsFpOMHelhpwVu1coneyuJDmcvc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2YhmYKIeX3L-vtWOUyCd9GVStQZ9ey0KZ4h3eLAv8jA&oe=6AF5CBB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_KlbG2wGJYQ7kNvwEh8nT0&_nc_oc=AdpIlAVzGsPvcuKbOWk-fe25mVyAtQ6xLe8Z-zkm3_bhVuiV4KZhDBKdNd7brJl7ub4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNd2-aSOmwJQVR53lHRXqTHjXF2k1R4KWOGYSryLuabg&oe=6AF5C57B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBpWyyHWMAEQ7kNvwH8rIEY&_nc_oc=Adrk0173bKunmR0NkPs-WBhvJ81vkiTNQB7arns1kTyOBxC7HE6rNbHo2vGwrIjoXo4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTl96hhHLB-hJWUoQdTlu1XKVJVSSnmaSbBl2QC6K8ZMg&oe=6AF5DAF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ilVTH6dq80Q7kNvwHeOVVj&_nc_oc=AdrjrRwcXp04z8Et_GhrO1tI8m0yvEkDoFY6RNjEJXbu8vZoPSSjqzQfV5TtoeINiNY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRIOTr3Q23VHVf-SCi_2pDjr3m2ZzBXqGCU3dysOqPNw&oe=6AF5D8F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6l3s8qGznYsQ7kNvwEdjVr7&_nc_oc=Ado9GPhKNQqXCgYjIHshS5N5paWP1AORrnp1jcb89eyxWkZCpMJB_H8zMueanOc9IBM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREEa0t_TuHPGi5bIn8yoGdVIhZnM0HU-s3jT-ouwgJmg&oe=6AF5D053"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HYWapTegE0Q7kNvwFfiPW2&_nc_oc=AdqPCoJ3JJu4JrzBFOeKdfT2spL1L5KaujzGQVPlB2_vKLKDuSKO9cP4kgCxTq1Ie9A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQot_Y88224lte3QeH8lre1gDX-3HAnEiWZsHCjjIt6QQ&oe=6AF5CC6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4P_h63S1tIQ7kNvwG6gai7&_nc_oc=AdovEe_5hXltm4_qtFu6oiqxzQZuTCbVMdJ3yCsH9tIQ8cY2TT6iKoZQ2bkz8X9iWUQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNtHSseiDk19zSO3k8YnS_2gw9iGU10V4oeCdnuXYVoA&oe=6AF5D822"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
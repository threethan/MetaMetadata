297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5VQDcL9XLcQ7kNvwF5LqR1&_nc_oc=AdkCcE6qivhdu38JkhzA6LqggSOqZ20bOu8YsF_OfTLexKt12bZ0ZyLzftA-SCr6jA0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwd5cuah5ZC-E5TXo8M13R0-SHWfA8ZHeCCG9oxGFxzWg&oe=69B3F026"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuGaSXlpFUcQ7kNvwF3k-nE&_nc_oc=AdmvJWtBo4pwesskypwR4FjUHWam6nA-J2vu3DZJ8gGIemHaMgNGSWX2ctSE5-adyw4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfymBkx_gQjTbR_0BTCiNcpDglcQOFCIyNoSAV68kSOX2g&oe=69B41DB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwCrTMN018UQ7kNvwHYbX_D&_nc_oc=Adl03lmloimo--qucg3X3dF06I-aec_ZzT9i6c2lcTTA5pHAjmB3fCDK9I52HFyWSGI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwVZpZ1VcSsg6gpWQd8EdheAFinY5X5fH2O45dENc33jw&oe=69B4177B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73hoyC5WfLwQ7kNvwHdNDri&_nc_oc=AdnKxHTwhyzR3B1Ue7fPtmVZOVuev9_hl0Smwz-kc8K8qC4hET7qnkh94DiwsvO6RnI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz65gY3ga0lPm4mvgM45g0zP7YnTk-TWUWwCEloxIODJw&oe=69B3F4B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=727WTxuPY_UQ7kNvwG5HXI2&_nc_oc=AdmFtdHBp3NSj4qO_lMd5XoMZnIMBQkYcgXalksflSiNBF5FDrDNqeXaPhqStuk4yLI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzZVeDfuFMdLkCmCKOAeyCOLaCphIOdkD_YxWhf7aFilQ&oe=69B3F2B2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pz1EBEeMyRkQ7kNvwEnbBqg&_nc_oc=AdnTD9cmTuschPwvf__UbG-95ej9TgxZR0_lKLYVxMAdcSP3j1UYXbilKbSpEi5y0Yc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx13i-73Z9QHRdnbDxS0ICdDYJjchjVrxKPxtwx1B-gCw&oe=69B42253"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vC7dyQSvyyoQ7kNvwHxX2VQ&_nc_oc=AdlEGSwtgoEa5Qe_5-np5-Zy5-ukDiDmjy62HttIBqeGnzIkysCo4fH8G4sRDPCJxIs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyGOGFQAS7citcBascIDdVAMC2uGgzh-okQ69CavRntgA&oe=69B41E6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1eUF4H3HvsQ7kNvwGcfh9N&_nc_oc=AdloWDCDiTFZqHDYMGF2MSs9GICLgg-HJXgRljRXmF8lUyATYndy98gHA5KnqABjYW0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxzEIJLCtMyFqkgdg6d1131xKqdcjGGuZ9_gGYffm-93Q&oe=69B3F1E2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_5218087471640407679_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CuSpcV1W2CMQ7kNvwGe1EE1&_nc
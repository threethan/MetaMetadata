://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVj1mysARScQ7kNvwFvkbZR&_nc_oc=Adrpqi31juca_3cfizkZKcxFiwFEFkTkOX8Jyw2vI0lylX8hEB56bpPVE5Ms3cIK45M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2zrMyAzJOjbB-aNgBuBQZjTe1qG-gus8ihj8GXw8HVbw&oe=69F37066"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3DjPSAbjyoQ7kNvwGrayww&_nc_oc=Adp4K2ET6HaSBHej9LlkZztdZrOgfE9lqQlbC0ol7cDarVRt_c-RrUWU2qPwCXvL7s4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0zvoR0LRRt4vDrI_wQGGLa_IqliquHE4Qz83pEUVC0ng&oe=69F365B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdMd3XnUPV8Q7kNvwFg6HSY&_nc_oc=AdrJEPGESyJBlgTZqzrjON3v1IW1WmXBmDoOSjuPs708ZjK5YzCOMHuKQryyHuINCs0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3s1Ga9c6KXL8J7Xvd-DvIaaiaq6p-jQQlAx0G4wAucwA&oe=69F35F7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6q5Esev90kcQ7kNvwFWRRQV&_nc_oc=AdqhFb1k1Mv8QxnIxUjLlPcx0iQTCFzGzWdks-qB6Ssly1TjyfqGWH28H-weKDRZ3E8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3DStnJmnjyUX43H-Uy2XIhttIdXbg9EGtxDvjPsToeiA&oe=69F374F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FilA7R08BfgQ7kNvwGswv-H&_nc_oc=Ado5-_4uHqkK3qRP2zKOcHyBzBUk5HBSVAgezSp37NngYI91_NX4oLhZB2PtxUNwEkU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af12ll-UscC13omcJlO_uVveaxe3dSnBdr8mFE8AIDUVDQ&oe=69F372F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypVzJ0yF3TUQ7kNvwE92ppX&_nc_oc=Adrpx244dXFdjOODJQKB1K1YC8smUOqP9v-yuUtgY5DvNY0E9WyHKlnqltWDwqV7Tsw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2aoKJHlSHSCHlZEsMtgPeNJx_ZfwnwRp1zCbz51TZyrQ&oe=69F36A53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6I4S94hI1oQ7kNvwEGlp6K&_nc_oc=Adrv2QZnL5R3WzQbQBG1jeTPWVKXnkrFfkrY6xwlS3HNIHOtQ30wKic4C6l3FKBY_uA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af11ldb-2YmAtxIz0fAOxaKCAuT7OPbJrUCuixzYhdBT1w&oe=69F3666F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vmOu23LbvoQ7kNvwGGUoH2&_nc_oc=Adpl9YR_PXToVJW9G945RUSuhmtEe3h7cwC2aJEhto_cWBzXgnKVjuhNxLwBWNhZkok&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2cXC_8LrNl6bpAtahHPhwKbK9l7HOF447ZgI0L1-fZ-w&oe=69F37222"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
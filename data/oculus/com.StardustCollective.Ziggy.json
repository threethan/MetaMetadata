://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uy9rk0aSIN4Q7kNvwEqFbS_&_nc_oc=AdoN4TNcnjWpgrGluRFryHGxPZ9ioo99h5gwsd7HkTlqKabcjyRD2ejMn-xJUl0FiM8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMl_EMKaHvPV1I8OCJikw3fRTla6aRKF4JKbVwgL28T_g&oe=6AC50EE6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=480SsQLejjsQ7kNvwG8-BCg&_nc_oc=AdpTtIVUAlgRS-pxUZVGraJpsKz8ketVVTFQXuir6vqzyHQOUUrWFZUk2JYOITVrc9g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7huTONjPb0zzyYGXiakuuqMujsXb13j79KvTDTtujjA&oe=6AC50432"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHkI3CRF8scQ7kNvwGRB6oK&_nc_oc=AdoLnaLBoRtntFhZ4R-np4go4i1h0P_3GTNdnoaICO6bfbMU6fuPCVdJyP4FreZ__n0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxIIcqZ0HwfXgvTBdKzQRMmrLz-fit_cIHSU-hvGhxRA&oe=6AC4FDFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFyFGjRQN9YQ7kNvwEkpes7&_nc_oc=AdqbDXKqqqIYYWYZfgI7ivhNe21UfGN1rVwkD_T0A2Tzve4vyChmSsLMMZk24VFf1j4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeslX7l5xGhkr0byqnZcbJMK_WZBCgzVCcotkSYh9u7w&oe=6AC51373"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDtT8ZW4BEQQ7kNvwHLbCKK&_nc_oc=AdqCIaGcwDxIiOHcywsUiwHAYBL3lZgScbtJibGHha5ltp42SIq7lOyvt_ATLo0NCLk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4kfC9admFARQgskyb9Uf-raX70bG9V23Kg0ykpmJWLA&oe=6AC51172"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GGKZ4RhhrAQ7kNvwF-XJyx&_nc_oc=AdqEwy1eZC5Cx3YubsHgWTeTFtf_WzRao1qKdYYyNPPfneEDomDQsxFY9EYCWgs6KMc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPo9YK0V641nr5feV8xEgTZTHH-NSTlbIwoFGBK1GYuAg&oe=6AC508D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WIxuTvjIqcQ7kNvwHwkcU-&_nc_oc=AdoWlF0oHw-QT8hdk1OPdvzXMBSGcU-Bc6_zIPyeJKv7XKrW8kTtz8bIhcQ-1SE9nSk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPU0kOFCzndoMkB9aTRHGLYqmINQbPvx9MaVBuZrTBoA&oe=6AC504EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvcDViSmE-sQ7kNvwE1LobT&_nc_oc=AdqfF8qdgZbiajRjYdk31XIqyJyd_cjVB03klS5P_5ba4AendQsgHq6GYqzoasUSvnY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtGPpdlYnmoBLshj6192NhWN__b7QFDCizhHYmX3xdkA&oe=6AC510A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
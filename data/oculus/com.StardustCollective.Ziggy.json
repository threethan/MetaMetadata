://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZLS-3eCxM0Q7kNvwFPh6L6&_nc_oc=AdqgLQM_wEOS2VimI4JeiOnPJSt6HrSua7ddlNc_yxIeIlRgyKh_I4wRfiSNN8oNdLY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7o8G-tBnEn1kIAlbxv_oMLG7Xhk-IeLicXHVBdRiNbHg&oe=69FCAAE6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XT2zv73pSWAQ7kNvwHc94-9&_nc_oc=AdpFD9bI0KLbV4V3Wtm9jvAqYn3t8tHXYIu0GETs4rOVykY37Bdlh-8WXhktYW-KvF0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lRMQ6gGdF4ofq2DCDaQjomimccbRib6lIkOukYuVhgg&oe=69FCA032"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAkoNK12VEwQ7kNvwH8ov9h&_nc_oc=AdqLEyNuGYaSjdsVyh6T0cR2SFzjpwWQBdZbsOhNdP7sZ0eg3Grl4cWqdickGDaxepI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-V5hL6-xTpYgSktzBCXEBHdmqLNHYafurrpgk_xEyfw&oe=69FC99FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybgpRGzu1xMQ7kNvwHmnVPz&_nc_oc=AdrDA5PZ61H6hfNW0mSIM2aWOUHUBpghF8FeI_aqwcmA9FTKrrHPZZ9Iz0wjsbvzXEc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bktuL67PtOAKBUAC3oBEd6-rj5YDUuEITR86c0FP_dw&oe=69FCAF73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52AtH7rPXS0Q7kNvwEG2jXf&_nc_oc=Ado3dhYfDwcFBJQcm62uLJEUDSpnoFmH55vzq_o1f_nWcoJlSxhOCjcnW0Nv1fSrVoc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vgbj3DchDJW9d9gxH_uGKwSvgeg5I4t8JWsAJXm0S2Q&oe=69FCAD72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SX4o6SOFiUQ7kNvwFHAxd0&_nc_oc=Adpc_yZjTk2zjWq4f2dbhQc1l0T58T9RjfZo8Jiy4ITYXbIgxFi4s8tuT2xnHFK4-F8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JURAOD7bD4_KPIyVkDz3GdIsADUzify0vLGMzTXkKyA&oe=69FCA4D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGT4gLG4XMkQ7kNvwEJncZp&_nc_oc=AdqBsK4NW3GkI-N45qylZLujWtlceJ0Wtvr2VdGCV6TVT8nHIcElVGGdiFf8DOPZoOM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FSWe8y2H0mNtUWKjk04r-rKdKiSd57tl62tr0hKSBYw&oe=69FCA0EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1oQSxSLafkQ7kNvwFBcd-H&_nc_oc=AdrBe-eyEgjQ02JH2wQND8qFeyUjnOTaVED-nBDRibXr_3zq4Wh2WbbpHmxowpsJDPQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EJ_JTOebLVq0C3p28GnY-LscRP5o0r1acJX4TA3K9dg&oe=69FCACA2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
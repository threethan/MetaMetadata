://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5ETmaQ_3ioQ7kNvwEqmGze&_nc_oc=AdqwJy2aC75F7rYCbkOz11-SbGGKzRfM0XOp92iHMWNstVjniJb2jWy1RiCJUzf3Q94&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0p3lbrZQiRYgp72_BEu3HALhF0Nphvxi1zij2ErnhRRg&oe=69DB7D26"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMSVfP8B1hEQ7kNvwGMiVU3&_nc_oc=AdpgCEpBEKFvm9SByl4HPmZLES5qVoNoIZKNYI7qS8wzunzCzQSn6scszmNyUYlZMXU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Vg8U9_i-UxM8F6pO9ZQMw0ZrhhvxKolZWYFeqsSvCvw&oe=69DBAAB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x603PcS01vQQ7kNvwHWRwgj&_nc_oc=AdpPM3vWnSpKdcBw7sHdjCokXeD_gMgiNj-q4UokYqaz93mvoixM1WslePOYqBT-WT8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EZQgd1Gb7pAzML0p09hz0f9_-S7GszJtI94xqG8Qjyg&oe=69DBA47B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Frghk-7ttv8Q7kNvwExqhVJ&_nc_oc=Adq9HANrtqDh7AwHOwBjcBsnT-fiANCMkbeezU7raXmhbq0CuAColO1t-SiMlWKF1II&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VUThqwR3kY7Ytky7fClh_h7yP0XIHHP_QutE_7FnQww&oe=69DB81B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iu4T4qUawlQQ7kNvwF-1MIi&_nc_oc=Adqaz9VgTjxbNOghvuCPty3KF_BNqQsPuMN6rmnngJa6b3rPbtM5jE_YLdeLyK7Z5e8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KcT2n9iXyT6QxmN4FVhBaGPdmQnr-Q1w_uRqjvoQC3g&oe=69DB7FB2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GFNrtHzvG4Q7kNvwH9OpC7&_nc_oc=AdrLR4BDW8FtirU2QeeSHO2xYXE4iWQhco995g_gdV5wXv57O8wMmOOThVjVcus6evI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oPM4thLLdrzvIpJ3GZku2jGm5eYKlG2195SY-Vapf4w&oe=69DBAF53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ph_iEldEPBcQ7kNvwE_VS1b&_nc_oc=AdoYRXoYND32TeTMvjY4iruESwIAUaiwdXnSwKgjjgDoW5IEuWy3V5D3Vm2fYN477eA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZlX5XcmcbiNZ37tgncVLWRw9Hrx5QnL5_uYE71o_JUA&oe=69DBAB6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHCqXcF_MX8Q7kNvwHklzQv&_nc_oc=AdrDS-piw6GxfR4WlGv35C722YOZvrMUyCFJLJMQR8FjFNjDclPMz5V4xtNRXYJbHgQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YEfhTtfGFkTCYq31Kh3DSOhvC_Zs-3eEu2WvVO6ed6w&oe=69DB7EE2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ksaSm9ZenIQ7kNvwHVHMm1&_nc_oc=AdqHZatDVGJgV1tcBjrXN-lSsTJmtTSwVSZnBoF9Eu-g5of8oGS2I9mfIGUQleJe4Ic&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy8ekLf-3uMeYGJRj76Bmundr1B3TjpWWmlUa8dWMfWgQ&oe=69CA59A6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47yHSEBCTpYQ7kNvwHVLWy1&_nc_oc=AdpKXv98Wvr7o5ASKxNo1lzj7ThRa9Nko5rd4WV5841JtPfWU-43ebIZqaVeNm1TiU4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxmEbLisdHp_33Kp6dfHtNNTf64zxYc30MLmpVF8aXu4A&oe=69CA8732"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYR8-XeIyDAQ7kNvwF6VwBY&_nc_oc=AdrOmJqtefPJgB5x1rnDraHgKrirsJ6HXUDJwEwVaO21Yo5SiRDG9nxhoPe7SelSkyw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzkgz-G4eBd1b06jciHzSoST8KpFPpkxPrTCXpp_RybEw&oe=69CA80FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okewTs2jiGMQ7kNvwFGIR6J&_nc_oc=AdpDULft99EnJ5yS_VrgjqBJDdJP-mXhe5TjTaOHiY4zmoiiZar5dGZnQHLGSqln4WE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzqG7INHrlxObfuxkAeWzGrDfnSs_jkHYCF57Pne6kavA&oe=69CA5E33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJpZ-dX76vMQ7kNvwGLgG6L&_nc_oc=Adpg55HfkiiwCl94uVy2gNJFSMX90JoooGuIOvsvYaFtgi-mSOls_CecyufYGFddDzE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyD9vju0RKK5tMHtvhgU7ifqmPSDQwqcqYXuLxVsu9rYQ&oe=69CA5C32"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6c6etC-yGVAQ7kNvwGh7o-Z&_nc_oc=Adon-J0Wi1wns6_I_ZxKv_d0d6fi_Np2uUDFByVW7GqcZ5xT-4XlkBU---U7_6BpJEY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5a1g_9tMYrRhlPyGNAk4Cfi0HBjKCFeVqkO3Q27Fy4w&oe=69CA8BD3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqA7lLDF-HUQ7kNvwE98Vdc&_nc_oc=AdqsCS1a1lkOuPIZvBC3ri2FOOhE_l5wvsc7DejB4qKMvHyV-vyoQVbMUHCCC-srhis&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwqlrI8iY7_41PVDV-ubcN-O4e_bVfSEG5iW36WfFxvbA&oe=69CA87EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OkaCxC3BmEoQ7kNvwFbSK0P&_nc_oc=AdoesSk-_oitHKoPeRmZuyRv3G8VnmKLMG2No1KVFjNmZYnMsgcKQD-ZU49glqo8mGk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzRA6IDuFB_9UeYhfNb53HjFgxofCpyFdsIDPtcAnmfSg&oe=69CA5B62"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
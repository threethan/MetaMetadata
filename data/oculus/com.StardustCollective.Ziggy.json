://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MH_Wc5FS1OcQ7kNvwH17n-a&_nc_oc=AdpS347l80o29MjuExA80uzGU7Nd4-gkxsiLgl9fkEL5qzz8KpNV2uSvKXva5amkiF4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WBv0jBN_GXoLmVNCflCv6ozMKgw5lZPhxPKlwqaHhPw&oe=6A1708E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvOgAVDdLuwQ7kNvwH1gkaY&_nc_oc=AdpXQKZxoscL6qRlhtblk0gceT1Xl9OZNWcMPxBkqi0djjBGxhpbCdlQYvTN0GBnaVM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KGd8Icw7RZN7TSxkVZUPU8tAc8iIB1PKvxAlqeXHplw&oe=6A16FE32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7pkTNiWU54Q7kNvwEXkope&_nc_oc=AdoOclxusRFMzFQMwq7Al1ck0hkFlNXdoQ9Uo87s_457NU5fwTXq-BoGAuX4FUHLoMw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71XydS75Y1THKAfTNA7jIRvjJ6dzZk3qcuXfv2felk0Q&oe=6A16F7FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FL0_f13upBYQ7kNvwHfTaGq&_nc_oc=AdpxcHLdbEoxHl9sS0pT926OMZs0s--PnYd-cQMaJbMjBsUyE0pYuy9QH-46B_YpTho&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4i8MoHY9zIZ3WeQyVQpPPXSXQrj77AeEhzCyDu05raaA&oe=6A170D73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t283innD3PUQ7kNvwF_KWFj&_nc_oc=AdqL5GjgA-MtdbDNqCPv0Xxqu7U0c_wfHWBWOnlf3HKb0xNdFpmoeT7NLUMzr522934&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64MCu-ooS1MaxXCB_m6gOO65lLS-ZqR4F2ov6uxMfUJQ&oe=6A170B72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4Xvd6uoSsEQ7kNvwF2583R&_nc_oc=Adr_hsj6B-ws7brse3_pS_jkDcMoQ1HHt4z5LU25NCSz8IxUgOhOAcA0PNBh00zClAQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7W_xfxCMYm5IQuoTQ1UFWxhok73XX6N1yYE3I5HCuMzg&oe=6A1702D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=91EDiX9VaVAQ7kNvwE7TuuI&_nc_oc=AdphA8Lq8q6KB_wmfESn1Ocsh6qwoetJCs6wA7W7bPbWXwF_1sBi-wjKrXS2S-UeKbY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hTqfdelUNRhHRh9TukIUgvUdcDSUDMBBmwMoiL2AY7w&oe=6A16FEEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZj5tkmUprYQ7kNvwGB3QK2&_nc_oc=Adorfy5hPtadv5PkZMk4hMOZwiCNoZEFwfHs-HhwxLQF48zk4hsok3Pr896zH1qdEs8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jZ2QYcvvaykyAk5GMOs1X5hak-NCyxbSocySkq_E88A&oe=6A170AA2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
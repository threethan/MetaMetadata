wU1A0Ej0VMzPa1kYg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBziOpSvQYaT08KJqCPByejXKrR7ehIfnaIUIsTRKQ3Q&oe=6B09CF00"}, {"file_name": "HighresScreenshot00040.png", "id": "818138872994656", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982499_818138876327989_2509640883979337008_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0_9KFZId-UQ7kNvwHHHWLC&_nc_oc=AdqZnHQC9qFiWf7muqghPo_E5zUtwlRcf8GqFwValWK0H-lt45sVo3LE3swM8o0aLF8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRI-dxNow8pcy88brYLZoM19huIgyDDMk_vCFSy-6lefQ&oe=6B09A37F"}, {"file_name": "HighresScreenshot00146.png", "id": "6528405093884480", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982442_6528405097217813_7617801026990639966_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTeW-8m1tHYQ7kNvwEA5ZLw&_nc_oc=AdqCvvLd-gYCpWgnWVNPCs_rxoS4cgaUihB38lB_LSjO5opQiWVrJyv4zvBwR9oKFMA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSp_7MAfTX_2_QWBXxC2RP25bagrmG1A6HjisbPpdPoEw&oe=6B09C00E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "312845394416247", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035359_312845397749580_7295644085646795585_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJcfbON6I8IQ7kNvwGYGpbJ&_nc_oc=AdqIk6kOno-HeJIVYVtwiKp94DV9Z4rHEblZrRA6c18V_NH9PbuZyKiSSRz5Yc24R4E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFQpuKPYnDVUbI1g_rD9BtZ6Xx4cOk2VsH_cZA6pKNfw&oe=6B09A739"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stardustcollective.dev/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Stardust Collective", "support_website_url": "https://www.stardustcollective.dev/support", "web
://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uecXPY4v38gQ7kNvwGWWeZt&_nc_oc=AdoaKUhqGCgUH__66xinqsRPAPVmSgg1f4EMUO1cd1iWPRe2DMAaoxmE00J0Kcd17MQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNFy5BXukq-1lj-6mOEAQJOI2cSSuvhpc_gigkM3wjeA&oe=6AB14866"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IfS2oQVYJUQ7kNvwFP-SBH&_nc_oc=AdoYbsty2LyNgyO4Znm69NrWVHLFo9sdA_-fRIHIU0fQa-hgHiojfe1EnASepyqr970&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3f8JGq5S-q6RQnmgkhorA6gN-HOZOt-fq7Qm4yHXjyQ&oe=6AB13DB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8QGIrXuE6bAQ7kNvwHSK2Cc&_nc_oc=Ado1zcFxK61lMw1yM3-3BhH5JxBwuv4T07an6rISyN3dgFdWffUjI4uck8O_D6JMY0U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJkKnqOAVo18wFhQvY7FfKxiBMFv1PFKI_wif8X5re_w&oe=6AB1377B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCWg4j0J9xMQ7kNvwGOB8ub&_nc_oc=AdrxqDUJNgadJrUCdkzeR1WAodPX1safIL-ro3D54reZ0LbJR16AHuQmeift4sk3XyU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIywbyDr0kLp557kw-v_BAR19E0saihG9T2Yi70EsHOeQ&oe=6AB14CF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zc99tTTZU3QQ7kNvwEhiops&_nc_oc=AdpqiX8qPMjvp4yokE2_QPf_twPlgE607eZgdVNGtkJ-rT_4_Behx4FGs-vgxHmACHw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZwXOGqGAYnIiDJMereVI4YMEIw22vECPKiWnVhLvZ7Q&oe=6AB14AF2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Q4nsPhAykcQ7kNvwGYegjy&_nc_oc=AdpWbdQhuSkHTCi6wbNmoGflsDhfXEbGAXcsr9yOFrg8sqwgz1NEXyj5gkw3l05mA9E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWRnCtNdT9zPvPGh1wWB0M_RU0ndyRILvLwO2M9sGk0Q&oe=6AB14253"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8UAs_CaBrcQ7kNvwHbGNj5&_nc_oc=Adr6Xfki0SOQIe_toDebHZrmsLZ1uZZNn4dw10hWpTD86hoBoxmybu3OXa-qDT0XVv8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGeRz8ZXJEtAy_iSPixonnUTYd_plriTCMsMMDUc-Vtw&oe=6AB13E6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmfdI-EMUuUQ7kNvwEJtM_W&_nc_oc=Adr_iytsvfyLohxFovAVTVqr7sOcHVoqkk7IqJ25Nfa35EyHYrzeP5y5MR13h0ko0js&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-aHiFvijnenOYN8adXm6aOS4AG04D_6u8ZNJlPCkfXg&oe=6AB14A22"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
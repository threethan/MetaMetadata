-25/38974500_800214781605120_8880468551637015930_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYNfBZ68SmMQ7kNvwElOx94&_nc_oc=AdnTjYIWsEPmFlIwwwNBfNqwwXO2EjPweS7jmvdT0m1JSK1FZ8NN_ev1QWDz3d1QtMk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afuc8WMfqVnQJpWCoU9900ObQdH11fnWB5Ruqdsrd5EAew&oe=69A1A16C"}]}, "id": "1005005773748906", "locale": "en_US", "screenshots": [{"file_name": "HighresScreenshot00011.png", "id": "1326199667974786", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39035386_1326199671308119_4397089309417940909_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTJ2D4DP0pcQ7kNvwGDczQE&_nc_oc=AdlYGkBOsqY4ELVCpG0mHeK291KkEyhCkFdPzpnC82Z-YIgEdMaVjtyUVqTqOpJ9qaI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuzTYseyDxl_SJc6LCnDR3LoMBGrDBBdniZatIT9UD0Bg&oe=69A19ADE"}, {"file_name": "HighresScreenshot00028.png", "id": "2412721535575051", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974577_2412721538908384_6467288184304840049_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3le10Pgju8gQ7kNvwGcBIEz&_nc_oc=AdnQ9JA09nbBH7_1U0St7zY8b-lP-9jKd8jEV3DBwatY8vvx4yxHpoQYdy2w5q8vJHg&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftiDeuZmzySjBOtmwsqswd17gvhAh6HzinOtteg77B64A&oe=69A1AB4F"}, {"file_name": "HighresScreenshot00014.png", "id": "997351624641332", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38982456_997351627974665_2778603811108028476_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3cSCVyCRXkQ7kNvwHR8Cb8&_nc_oc=Adn9HCXYj-MOMoxKi7sByrQ5ydKhqD77N4g4Ns_-N0GFWKjrhFhpk9jio82E2_1vnKs&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfvY-R44B8fcRRgR0IOmf_HBPth5X_YEeDQAJ1SXywlyBg&oe=69A19E21"}, {"file_name": "HighresScreenshot00040.png", "id": "807733037419699", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38984472_807733040753032_763200239777074167_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Flj-NkAo3_gQ7kNvwG7bpFA&_nc_oc=AdkCMvkpl0MEd_VXGmOSwUlq4RmEdiw-Oy6PkrnVGVcNCyZKo9cG6sV2JAnlPQRuDdw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afs57MWWxhmthQaLs9dOPimK7FIYGn8kKuUVv13o6PEs0Q&oe=69A188F8"}, {"file_name": "HighresScreenshot00146.png", "id": "163970600033098", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/57566678_163970603366431_5435931785999963108_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TBtXw5R6w8Q7kNvwEO_zrU&_nc_oc=Adlu3txw1UPz7WoifGmw4dkKMQdx64fame79-uqjmghmrtg-ni31ggYNBWqeRXPsJy0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvoBIRmPHf8MzGB5oUWXfnG5XiDkUwFwkNjDl93guetHg&oe=69A18D71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNvL5MxtVJkQ7kNvwHM4RWu&_nc_oc=AdlN4Kxcnr_Q5pPZMx3fqCp-Krn-Ux-qbQj26qOF9Tv9U46-94_mRJf2dDdKpv5SntU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfswM_uS-knjw2UUYxbmLt02rzUHPqCGovnKdcptDeLgGA&oe=69A17DB2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "1324311035174797", "image_type": "APP_IMG_ICON", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38984472_1324311038508130_2610060411856834928_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHM-hsvpQcIQ7kNvwFrSdRR&_nc_oc=AdmRCyDg_yjRwOsFaiaSZa1k2LAuqbxS7XWlejMx7-cEIzRh1D0xEAWHELjmognqYGQ&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Aft8q9GRHQWyWX25f4M-IypxT1dShwTpGXM5MQE0Dk56dw&oe=69A17678"}, {"file_name": "CoverImage_Portrait.png", "id": "1021944422558335", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/39031612_1021944425891668_3460677483354056217_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=beYxZtRFy6EQ7kNvwG7l3LK&_nc_oc=AdnAPOug2ZheRoZQIVf590fTEBD3n6LWnIdm9MGDd7wE9j2Nt25XeAZtff69huoDM14&_nc_zt=3&_n
t=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzcxwKx903VaYKHUZIR8QEAofuOml_i2-CujCr-RUwvwQ&oe=69BFF0A1"}, {"file_name": "HighresScreenshot00040.png", "id": "807733037419699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984472_807733040753032_763200239777074167_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jz2hufrJArIQ7kNvwFjc9qv&_nc_oc=AdkageVtCOdQqOE-qWTghWwUuY8o-nSXEwTfSoB6Z_TLDlJxfpqkbw3i8cJjV4ps8fQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyBOiQU6nRGciEla3pm87dLKxqUkO5jet0fA697zmU5AQ&oe=69BFDB78"}, {"file_name": "HighresScreenshot00146.png", "id": "163970600033098", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566678_163970603366431_5435931785999963108_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcoInVH5-p8Q7kNvwH1NwTI&_nc_oc=AdngUtSuCZrHz6RVz-3WwTrWDkrPfJwo1WLtey4WJKh-9pwH_UvPxWC4FrzwBb8JfSA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz2IY6Iug8Uk_maTNDDltYWVbeiU-lfcrIALS7QHunr_A&oe=69BFDFF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkdF_b1gRgUQ7kNvwEuS3qU&_nc_oc=AdmqZaZKzaW-Tzi-1e2hUftlUNqRWTAiDXZl-gVkIdO9aLybYpQYHySDyPnHkDo1hAs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzhtxltEJmUz7Hj6v9aIOCdoVd3B5UHy5ibCHRNW0RR0w&oe=69BFD032"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "1324311035174797", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984472_1324311038508130_2610060411856834928_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HGsqUG8k38Q7kNvwHGt0Go&_nc_oc=Adnk_uRNXTsJ1QLuu0x1IEglvtsjtG4nwY8D2jQH2ljDzVZP7AfWtggEMPkm0SMsAlY&_nc_zt=3&_nc_ht=scontent-iad3-2.ocul
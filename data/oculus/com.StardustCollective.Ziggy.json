://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GE_dgxh0pEIQ7kNvwEnxgNf&_nc_oc=AdrYF2zFa62S45RhodEOi0eJzj6jAdypnopSZd0yOQzGtyrwcZtOMNS_mSOdPbBlWyo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hUtdwcVZLUv4oKeWaW-u2HP8A7_CNj2rcThke89RJGA&oe=6A034266"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYLxIrSSR6EQ7kNvwGUBLun&_nc_oc=Adpr1Qqms_3_FSDBIV5f_cHjwI22BnxdgulnPpAAMxwWx4DbxkVWSXJbbPPI427Fwkg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4G_tVm46LQr1EpTlCBcvn4gNPsIxm_sHxx-7X3l-UsbQ&oe=6A0337B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5-0uG7j9sMQ7kNvwHRiQvw&_nc_oc=Adp2o_T0ejEv51K_0K_IEz4iUap7NrG30qAOlRQyJ5A-3eIQHQ-nz9abRoUR544FeeI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kpE7B-fkK6Je_7_u1vzHew2679q7suRC1nDUY6gJyKw&oe=6A03317B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4v-ooudRnAQ7kNvwGAl4Vu&_nc_oc=Adq-TL1eR6DRdImHAcdWucoFA8zzcsfBPZar-DVAilvhGftESbkg0MlrjKUrZJxVo6M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qlBfwXVZlA5uLqNW7-cQwaPz5_azosUVuB9cJEF5RaA&oe=6A0346F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5e2Bm_HAbkQ7kNvwEee9tI&_nc_oc=AdpF9z3PaYOvYv7EUy3TnXcSaMKV6nqCDAu6830Hf42nraXyYHfPcADtvHXN7Vd8lNQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5J0NZA5MWydy-LJt6pqR8zq7GQmBEGulMAI-Xp6Kb4Kw&oe=6A0344F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-FGah8s3d4Q7kNvwGv5qiD&_nc_oc=AdoWCQYWl4VxyoQajIdCYhvTIRQTLkcZWQscMSX_U16zRcYRDXB8klAcoXPzeMwyAPI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jhaapzcmy5kMHX_dLB3PP4Vaya03I6JsbV4tU_8evMg&oe=6A033C53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ih-JvqLFDyoQ7kNvwHCNdQb&_nc_oc=AdoA_IGoOjOynB8c7VvnIpzUMYLLyZ1w4sMUYlf3acSb9SnRAXOr8_SGqVD0Xr1CdG0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XAF0lFib8Qlfs8aA9gqF8x8tUU-fRPasj-aIKtKPf4g&oe=6A03386F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvC9FfvFpTAQ7kNvwGBAOvq&_nc_oc=AdrBNrh1_-s4hgvugLKiTfO5XGP094YCaWXpXt3qhCY6xKIUpk8bcVDVx2RTYxG_R7M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TTCPiRwMQ-mH9jSX4Iq-HHgwxtG2RS0MHTI7uRostDA&oe=6A034422"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmmOhSJ_1b0Q7kNvwFpEEjs&_nc_oc=AdrXKLFeyJIouringoPOeqL4JnHkaTkr0pcb4XDRR1-iRGKHOc6hlLSPWoMwBlyMRmE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZzM3O2VjD6c_OH2WPp2iB3Lz38NBMiHtuGFtYZ2wdVg&oe=6AA2C7E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGsPdfsVQCQQ7kNvwG_2wk3&_nc_oc=Adq3m3QJgxMKpYIsECuJMqIbco0FZipCO97s0p6NM_Q0FmgRiXZ3VwbbKpUw2tvXbq4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKd9vLwrAkWnX3q_yKbwsTEpH_LTfniUlr_fNMdSFbsQ&oe=6AA2BD32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RGtyg5CxAgQ7kNvwFGUvwW&_nc_oc=AdqnBIDaxx33TeBtB8BFNn88LFsM0t6fozMULsapKs7dPIKOrrtXhUJj08H845o3tzY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCyQu1UvsyhF0dW1iNqkqyGw6hu6EqVlv8RkFH8_6G7A&oe=6AA2B6FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixEY9A5VnxQQ7kNvwFlmOXg&_nc_oc=AdrwvFbr121PgG6DbPh0Pi_Uu7e-mwbU3pmlGy3Gscl--_hj2H1FJgFmXsMpF93L9Vo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJR9SLOn-4duRIVdMYm_DFMg5cZQYSRPi8X8gYIY5JsNA&oe=6AA2CC73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92MaOnjPJOUQ7kNvwG6TSRH&_nc_oc=AdqakcneICL5QQRss3BTdORTpIO1mNZE5EK7jfvHaRH0Ji9dGIDExsNEwqM5cne9qCo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3bYGZleQKIumjXh_Rems55cK4_Q9k_veGQW0dkqBLIg&oe=6AA2CA72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RC8zYPYRVkQ7kNvwHw87TM&_nc_oc=Adp3oYxf8wOxhVLzJ8G1gaA-Psq7yCnSlI_cnGundbHdV5DyzN3xBpx1rFXPQjZXf9c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJF1yDf0T-9NRKjkZnDBrDWCLL-K0W-S3anbJ7HehWH0A&oe=6AA2C1D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGyHAQfJb4sQ7kNvwGzWe2-&_nc_oc=AdqmQRzMQ6KRpYxO_Gx17QzBO2fAu6-Sa1i3roIg5XypDUWsmuqDUDrCxBktPYyNpKU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4XtzFmrCQv9ajXYBGK6Sk3veeTeieHIyqn4CqMTn4aw&oe=6AA2BDEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-z_7dGUoEAQ7kNvwEUDlZE&_nc_oc=Adou0-D12h62FWtzvNCCjljFb4ZB41q51QV3BoWpaUGEU3BlZcX7ILKe0Fhvj9EUke0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWVB0Hba9-AZgdjfkSjB377XO_ogrka34gNapN3HwqWQ&oe=6AA2C9A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GE_dgxh0pEIQ7kNvwFvk_Yp&_nc_oc=Adp1YevaVqwsD79rrM9tcqATa-8uFG6lH6O309bFuLvuj2HWrbRe_brCH-I-igJ6TB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5P8e9_W9iPGYE6We9XWTu9NjJLJ1ZTKdRdBNnh5u2m8Q&oe=6A0493E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYLxIrSSR6EQ7kNvwGtTRwY&_nc_oc=AdqPI975lWQ_UcCZmewbS_33dE-q3I8HKf6zGDmX3Tc-yfiWkVNpyoe1JZPaBVwmlZo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7R-vYCk-gJOmJ8R13CsicL7LMomKnmkFsOJd1ZxBEsUg&oe=6A048932"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5-0uG7j9sMQ7kNvwGNJQAA&_nc_oc=Adq-touVWcPr_v1KlGPWmJtkcuQxKNe1G3IOXJK7wdVNquGT94EsClKVa5XsJHBoYlE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7De2pZ3JdIGRAMUZEXSucNSmhDeUvAmUC7SpzE3ebJ2A&oe=6A0482FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPm7grmbxjMQ7kNvwGUqYrJ&_nc_oc=Adr-X46dePaAUalGLPU8uRTIuYAbHzFlcYTOJTAaRbsfApvvPhPrvVUePIYYNW8mRd0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af543usLE3VQP2gQrqBgHbgvakmeoqd0n7yLeFRr9wTPZA&oe=6A049873"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fzNJYdWtY0Q7kNvwHupUPU&_nc_oc=AdqJOVBGxc6ij7DKTIqYojZ0vtdijhXC4hOSbSh-Dh3jGQ2ulml43TfOomZZyO9Dyw8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Jy_bJID-veeIy-nISWW-4alXxktZP7x9tu4eWo7LR_Q&oe=6A049672"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-FGah8s3d4Q7kNvwE3NLfn&_nc_oc=Adq7OVJUooKgHgxoJX1kvcGG7eQ01ZAghcnY5DqYsC17N5svcGSC_bbJOjcxQWtEH7U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74b23k34VZfBsXdwb0vzdiGjkJltHR2FfTMSFKeU9NSA&oe=6A048DD3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AML2gQoP6gUQ7kNvwG9l3Te&_nc_oc=AdrDkGOj04au8So-ujj4d68vhfhNIUXxf8FTpaLLsV5t5MpLTLJnkAQyEodlQUdwoZU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TZMutRo1zBy2QK3LeBgVaPio05LZQ0PWYx-cmRPZT_w&oe=6A0489EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvC9FfvFpTAQ7kNvwF8J3FI&_nc_oc=AdodDI58ll97q0IT2ebBZotJ1WkcR-DJn2xHI7hAnMntBaPQ72iOqbs2k1xnlSC1qzg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CnbDu0O1mCSffgcH86sY2sxHvDYpufLt5ugkmpMEisQ&oe=6A0495A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
-25/38974500_800214781605120_8880468551637015930_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxPE2rY_MRoQ7kNvwE2S5zZ&_nc_oc=AdmRkXc-C-S5t3eAdHSPTcc03maLAY8DwYApG_aiswG1MmikD_ndibbTTjNsH2ItIjA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftnE1F9C4vXj6Pa9WFsdFdkujesWaXiJNEPj6lRdYuoOg&oe=69A04FEC"}]}, "id": "1005005773748906", "locale": "en_US", "screenshots": [{"file_name": "HighresScreenshot00011.png", "id": "1326199667974786", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035386_1326199671308119_4397089309417940909_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzJqRMOo1sYQ7kNvwFcxTSs&_nc_oc=AdlLZIuaq0kki_xYusSYZCEwELJuNf137sR4ynRlw3Esmd1MIsKKYFM1DDSPAQRyoAo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvbgo2Ozhedwa69kbM-D6FbmPcGgYGAIozgNPJkrySgKw&oe=69A0495E"}, {"file_name": "HighresScreenshot00028.png", "id": "2412721535575051", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974577_2412721538908384_6467288184304840049_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3le10Pgju8gQ7kNvwF8aksE&_nc_oc=Adkc9Tlisocg0hXn-JJ1ojOmD8pQCHspj0WFnfT1b8g5lKnTI1_igCQbwP4FOYgxP-c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvYYTQJozWNlBU3BKqEK0JUrUbGnaOuS15p1DqqNFT2Mg&oe=69A059CF"}, {"file_name": "HighresScreenshot00014.png", "id": "997351624641332", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982456_997351627974665_2778603811108028476_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3cSCVyCRXkQ7kNvwH3wm8f&_nc_oc=AdnA2buOmgPAZUI7A841AbJjkJYESJLGBUcDwmXYqgSIliHmDEb7Oh4OvX52EY_ZxL0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftDgMBc57de2q0dMMySck66Quq08vprwxXSNugdGWwDhQ&oe=69A04CA1"}, {"file_name": "HighresScreenshot00040.png", "id": "807733037419699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984472_807733040753032_763200239777074167_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Flj-NkAo3_gQ7kNvwHZUgKs&_nc_oc=AdlSdiiDTWv_KPKOeo0v5HbnpJ4BXqZBgZ87pQbjizyswfxHS-Zy64SqPfCv2ADsMA0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfunDAVP3Yo2Y62puFbv47gRF9EHHxqLCGNkfT5hkx2cCg&oe=69A03778"}, {"file_name": "HighresScreenshot00146.png", "id": "163970600033098", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566678_163970603366431_5435931785999963108_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itW7mJm_wDcQ7kNvwGMZx-U&_nc_oc=Adl2Zr0ZFexV5EONlQvOYpyx30ECHbz1TEHmTYyLg5IMRNNXgRAhb_c5rQVBbpMPo0Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs5bmqgDf340xLyjeHZSBWdqFg6FJYQ1wogBC1HEKdR6w&oe=69A03BF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6SBMLMqEqsQ7kNvwFTbo_q&_nc_oc=AdmgwMj50COkk9dRrx5JdUwJ7si6OuMRn5ZOpg2JBD8jU2FWctra5ogTtosGstxv6i0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvuHTD1STmyFbhOpwBzSOz6XsWQjZBzkHR1qr4XmffwnA&oe=69A02C32"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "1324311035174797", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984472_1324311038508130_2610060411856834928_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHM-hsvpQcIQ7kNvwGKuo1z&_nc_oc=AdlD8UKqrOD1z44dwtyoR8V4xhIypWGxvzqinNXtdwH3b3Re5fHPUR37VKQqysd0lmM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvrx6mIc3tbcu699DjwwciXZGZ_taV4yrPyrLRL9tApMg&oe=69A024F8"}, {"file_name": "CoverImage_Portrait.png", "id": "1021944422558335", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031612_1021944425891668_3460677483354056217_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=beYxZtRFy6EQ7kNvwEmA8II&_nc_oc=AdncRhnbmcS7YjHy8muKp-1OFq2UwCEtZzqu46f8kSVCX_T_Y1PDE0Sfgic5YjgUIJA&_nc_zt=3&_n
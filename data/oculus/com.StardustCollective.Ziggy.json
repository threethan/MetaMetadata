://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-U_kazPW2hUQ7kNvwEafAY0&_nc_oc=AdrUV0vZ9I8sGQE2AS1RG3VVx8WM-56Xux5509cc_aefKMJiDES0cgujkFYPEQv5vVU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuPR5Hnom7qnaai76zMAY9oYZraOT-fHfOm5eD6Q0e4A&oe=6AE0BE66"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBWhtXK_rkkQ7kNvwGaMsqa&_nc_oc=AdqmV62lAbBUkwJrUZ9qcxwSIznUfJ3QtYSUyvSTUEv3OsMzMXPGaELox8Xqp9a-o30&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQPa8GMvmJst2FjKMWel0e6jNnOWGmF5w7aW5CSbRCEw&oe=6AE0B3B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89k3Ns2DwxAQ7kNvwFo4v5V&_nc_oc=AdqsxK46XAXP_PZwMN6uSWyqi8iYIBwOP7ZcHX_IMYpEMZ1dj23xXaDQAtvatlJk50M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHlsMfPYpv5R2pL76GGJDCScWvolmkGXKL35DFxoCXwg&oe=6AE0AD7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fKwbhiZ0VkQ7kNvwE_VRGN&_nc_oc=AdrZp8nVOUjG-qlS_g2m3Bif6zDxXY6_5TalLWlonT4pki25-tVrYyGezJuYK2UOLCg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsoFVrosqjuG2G-nEM8n4EWBnU69hTS6P5hUNrreGzpg&oe=6AE0C2F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8v7vSv57HsQ7kNvwEfgODP&_nc_oc=Adql910wm_AVIfvVH8aFPsaaL1JWANxvlhsHZQB57WuGxZBO34uws3hFYYqpvo0HyQw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8xAkyyX_0vC9bQ6I7on6JmGXGttdzSB6GsNb6hpapBg&oe=6AE0C0F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6PuKFxJA9oQ7kNvwHF6pph&_nc_oc=AdrANSPhjOAFPg-44tXwASPwQ-Bo-H96hyYYy11ez8oAsmqkhUa9-GREdx41eQiyzzY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnq7sjJZZVO898iI5XobOLmf9jthzfG4ADIwmR2S9ABA&oe=6AE0B853"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22n6V-9YaokQ7kNvwH4ZluG&_nc_oc=Adoo2dmeA530F5em68wsP3IAOLvEAHbWp5kwJ6vFGuhmun8K2R4wzAUEI_6ToRKP0hU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-789xMuN6tOQHe2KMFjiCEI9VEI1yHmy19osffajEww&oe=6AE0B46F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nszyXfCWVm4Q7kNvwG9uLS_&_nc_oc=AdozlFwUN-0eITdhTnJT8QnwKJ4VhrJNPTdQLSByQb_Rx1clsBKlfhATcnez061PxMA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGb3GyN0MpuXOSzm3oQrrdSD4J7KYlo4CxzrUfQbfPtw&oe=6AE0C022"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
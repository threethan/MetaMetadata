://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9a7UaEwRJ8Q7kNvwGBoQt_&_nc_oc=AdpmczLaTs2XaZaHkx5LXPKkU_JSCY8Q4Md_h5HZA7U67saqL9ZNk01l0c3ZJtX0388&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHAk8W7puAd63XJUOm_mLUzDLoYfQ2_R-3fzWhjFK7Cw&oe=6A54FF66"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOzstFeULY4Q7kNvwERCUmx&_nc_oc=AdrGnFH7KfEHagPGzg2SGueSGG8qnGwT058GTevo6jqNJi-LbNi9gRiqA-jDGS-YHwE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVSmu7Ffp4bXA2w7RE22bSjKtVLTZ8koqUUQuu0s2dOw&oe=6A54F4B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QA0TwLEca7MQ7kNvwGVZPai&_nc_oc=Adpmi-1IcoMMDibuSJqblj8SCSSOdW3hvcO287-bcCyUl_8qOdao8UHmEm4CTEeWSvk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZB8sOb6v2HAPwUq24u_6dq4ymEfGOJFwOWCq3QUyNcQ&oe=6A54EE7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2l8hGxD7SAQ7kNvwEJI7xa&_nc_oc=AdqWejvMgDnCgYF5ovIPCSRbifaL45dARm0KmOk1YaFccDnHYWKMHwBJnL1YWiEByN0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzWDBDaqITUCIwiJOqQ2hJeLQShefsetTpRPbGNfm_xA&oe=6A5503F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuDxD3zG5cgQ7kNvwGkHw2T&_nc_oc=Ado20Rk-_4B468aLKgDa2beNLoKWrclJwnqw3z2eYGQKOQtoh_KXJQJGsTNuotnjVOU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRVld6doJKM1NjrIhi9pCw3DvXbvLCQdH6v3K4BhM_0A&oe=6A5501F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtProRb2TZ4Q7kNvwEXWy4l&_nc_oc=Ado7LxlLWWPhj_y2Q52e_S5_K3OXmUBBhxy8A5BacedD6aIbHdHPgMx9XU1xUpVR6u4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzbTIE3Zrv18Ok9eJZZnezC3j-ea05zszReEnsltPdjQ&oe=6A54F953"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VpWNp0OQxJUQ7kNvwG1sS8w&_nc_oc=AdoL0xFjL1mfYd0elXAm2fLrwPJjadR1PzfP0jRkZkYfstsomnNNks5vib_5f8NukRA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7VtgDNKV0Kt13UlQREgwWo0GrYCozFvRunrOFEwIBFA&oe=6A54F56F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IebodLp0zvkQ7kNvwG8eEeR&_nc_oc=AdogNx156gAPoIN_SX-r4-qda_Xk1QV6lN8_rN3Xd4YJusyrqBoDIQ4hNc_g4h3n2z0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeMA8_bd99zlEBAUJQ69uepquhtDas3qfDIiqKzivdsg&oe=6A550122"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
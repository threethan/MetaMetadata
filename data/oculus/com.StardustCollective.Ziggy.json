://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmgI3qXplFMQ7kNvwFATjR4&_nc_oc=AdqPPSwVjmjSwEnHby5oSGQqTnP4VSYAj_6G1VIAcRC7XO1MmLMRQBu-StZll-QRUaw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Dqu5hDw1eRwn7ZVuDtXXoavPD3YnCRuS5NqnyStgZQg&oe=6A09D9E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUkxOmZakgEQ7kNvwF4PULp&_nc_oc=AdqEl5d3hFywmxofGr22dfqwKf7g_AykjCeFxQyIg52KuWUGmFpY-h7bWLIhxBP48U4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4e60PkLRU-HNf5j_CWbrLG82uzC9yettsJwXg5nKxqXg&oe=6A09CF32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97A4tKsZON4Q7kNvwEd6bJr&_nc_oc=AdoFrwYxYA22pv-z53EXddBWy0MXZIRfZiomSiTq_RX4IKbr45KjiXXRsq6sF-yPHBM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4C5m-KdjCFRkawAS-x1vKXz4-8f2paapHNtk-Z_LgJxg&oe=6A09C8FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5RJfNOtIecQ7kNvwGb3sXT&_nc_oc=Adpd2TEdaZtYV80GesacP5DbflqgHcx-ZJK39Hpk_fwCPCq6jCvph9bxoP6wy4zxGvc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tn5PGx3ZbEgQxw62D-v-Y-AP3J42UdYa1QBkToUyErw&oe=6A09DE73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBQSW-Fii8IQ7kNvwFyiA48&_nc_oc=AdpH0FW_l_UnBbg5n-7NMjYJpuNcHRuFZvo3LPpq3B1sfV-niuLEzUnkZq4xFyIgYTM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ajWGxuDjYFJOeOKNgO2egXLwUVcLLU94gtTucyQf0GQ&oe=6A09DC72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLrq8rjasxMQ7kNvwGHprlr&_nc_oc=AdrmdUjSiZAYOLKyP-HEa_cRcqh-aJsrzF6pLoLOSTyOvGzZjj03mytQUxhHD4fTV3Y&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Rn8zh1T_5ohfCc4q20pPPgpDUBN_5wb-PBRqU4qMy9w&oe=6A09D3D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3Yb2B3dwRIQ7kNvwHl8hZd&_nc_oc=Adoa1dhXDoItRx6LNupdLshfR48U9yUEYz1-f5qdcfCkBEatkuQJpOqDvdFy9t5ky3k&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HKMK1fV5wSZNPNCuEf1258ClIjkW2ASWVRzCeuiS4cg&oe=6A09CFEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bdMUaO4IgMQ7kNvwGOKx-K&_nc_oc=AdpUVmrbk_Avceie7E5uPa-_LuxY5UydF5H4MVZZJHdW0xCKAJ32Oj17JnApnbniOag&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AaXDRh282hHsmLT0TiAg53xaPVwUKId-Y7i00SBLqoA&oe=6A09DBA2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmeJFASf0bIQ7kNvwHQVzZx&_nc_oc=AdrQze4cR_U9-W_h6HhhoKNHaQMrXArRKrl5UUQvWMtqrSZ-vKOJ4Q7mhMd2IPFhrpk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdvvIg-ft8NoSBoUBPxlM3pEPF9yLlNrDnauLCehSbSg&oe=6AF09066"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QKuUG9UDu0Q7kNvwGEUXdq&_nc_oc=AdozL44k0yaCu5NRptyhqYJC4AhCilIgVtJQ0gEDe7Ag3hMMMq1SH3lXvefOC-54XHo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1OlAeW2NuL_BiqX5G92iXoCIdRpAX2X7T-8BcUJjz3A&oe=6AF085B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=758FGbHUOlQQ7kNvwE4WcSS&_nc_oc=AdpnT0Dy5Xjst8V0mn-8bpLUEPEFXu3CzlsRGFqQoKyBhxUJZR0KSvm2BWf_gonuZZM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbjhdZMSKhiV9KITx7htfOs_AAQslXzka323TV-6vqPQ&oe=6AF07F7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlBhCq83ruEQ7kNvwGxfCw7&_nc_oc=Adq4zvUQtvjOFc9KhWZz_tfBVuC4MUnmwN_cEr32b18ik2nLfWCtb3-2Uw8Vw3klmms&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTunMhto3V_dfqzmyd5MPFYGgLJrDFf7V84dnbfE_cVtw&oe=6AF094F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLlG4-r5OBMQ7kNvwEaJ1Sg&_nc_oc=Ado6Sx1W2LpEs_qbMkriThpMyiM-DIYroPYMX-pgsuq3Ad-oVYIXb4n5ZDVaQwvnH8g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTm-vXQLcQ_ABX40I-Qh7iaiIA1ZjeCrP2w1VlKz3Y8cA&oe=6AF092F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaOpp-NxpuIQ7kNvwFa9_ap&_nc_oc=AdqicI-BkWj1n2zvNFEIBcCYhd22LWdRJ-Ehd2LBwmmgLB3BPCDXVY27QkZAx8iuv-M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRb599053YNqDETY9uiBcMhHBB1qZFuOz8LOIVk6y_1eQ&oe=6AF08A53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yAAvHtwUfkQ7kNvwEO3t74&_nc_oc=AdrMS_vpTWkdyOSTSXuLfAskAMaCK3IwEk35bRynSSLQanZrIem2FyMw2HQRKXD2YVk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHAb796mPL9Q0yHz48QVvZFVfKTGq4Oz4o2oeA6Sbmzg&oe=6AF0866F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ynx5Y3XbMOcQ7kNvwGnLl2u&_nc_oc=Adoo_Lp7RquinB8UcTSIgGCt7jvDw9uxziZw7aHL-2sI_vk6puUgj18qCTPhtw2gAns&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQstFaswTzROfGGplBn-hjPtMGYC4U6irPWO25mISfPSw&oe=6AF09222"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pZ5s_bmfZwQ7kNvwFcPwDp&_nc_oc=Adpmdh4LxWRwsa9Pv2V9TE9F8qXbcDPUSjKbCocpBRkYm7KHdcYI4lW1hAdIVLhsHUQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdFaY05kNbh37mR9Q0ilsdi0QrAOOdBe9hJVGsD6T6Dw&oe=6A983BE6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfZcKa9TXt4Q7kNvwGG1JqO&_nc_oc=Adp3OO-VSdww_WBgcJqlgqv-RSLYPsXDGW59gkvpeRfqxBwts7ufXSnB2AhhsMMH5K0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIqFd7YH42Q39RkMOsj-_5hf4so5Lkgk6InWwKLxJ1EA&oe=6A986972"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AirhR6q1gjwQ7kNvwHY150C&_nc_oc=Adr_FbrubOLzPetTKrANHszD9aAC0FYI6kIZ4asQmCWwgMnyeb0-j3yORTCiEFAsZYc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrIomZbDc2KArp-uJVGNnBfQNSalviXSUTsm7bHZvp0A&oe=6A98633B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sO5OUW9-DSYQ7kNvwFq7rjS&_nc_oc=Adq8woQZ1Zwp7wK2kkX-vMCOgriMpkWW6kWyG4dHxQJSCWvAHQ0V8rLqhui1kHsGc5I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsdqAHIDJtYFO-tA0kMOZEOqab6Agbs2axNyWFLoEUcQ&oe=6A984073"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FjWUodtgOkQ7kNvwH39wHs&_nc_oc=AdpzwC2MUOE27rPrNOyxeV2zgwJb96GRtTy6FfbDZ8vl0FOl0v_vJJ24EXbw3HohNKY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLo12TUVCdFQME7LU065k6PILzXvx_ZoC14EEyfQfWZ-g&oe=6A983E72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73q2wSulox0Q7kNvwEqd58n&_nc_oc=AdqKwZFdJfNOMtEP3cxfPUzl0l1pzDRwPR_iQU9qZRsjng0wym_Eh-4Ys5QeJE6O9Q0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjCzALW7opm6UP8JHoYtPDM8kyy1V163j2pZrvdxkMBA&oe=6A9835D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ea2L5WoFFncQ7kNvwE-ZVbr&_nc_oc=AdpUpENRrwgSvfLFa1Y9vqvOVCfdXpi9XVI5hhhF24rjEybzDTCRCcvcUT-5RHs-MG0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfWKziVgaCJYO6-BrjOguRUD2j7ndX3QzF_mS3NmD-5w&oe=6A986A2F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-Ue7LE8UjwQ7kNvwEM_sMZ&_nc_oc=AdrVhHhKqdjNjPn_Mz6ENQ8dejv8XEosd-4DsKCDfVPGDMROh_v9YV_mubnvtg3ERJQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLy4WWc-JFDHdO1zF14T03c635blkUSO1Y_jlUGOucVzA&oe=6A983DA2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
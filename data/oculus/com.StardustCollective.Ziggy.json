://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhMcoJbofSYQ7kNvwHB_r3Q&_nc_oc=AdoPkFs7FyA6avrEo-hHQP6THDkijwBBW9K9PKKoLFfw6wBhxePBjka7bgHNLSX0r4Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvOTmqaBbpI0bf_zcRkXPkvPWzQw02qdJrcUflbMBsUA&oe=6AE60466"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43tyTF968CAQ7kNvwFhtBUT&_nc_oc=Adov99lHrGgyVyt6B_xkOJEbdYrVmLQ1uZJWbSCSx9dpNqYn6RgoyrCLV4mKgeBy2CM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXfDiyNQWbjuAyeeKIVSBRCt7HEPOw2iWtduIEMPv4qA&oe=6AE5F9B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LoZHrqH6t2IQ7kNvwEO4twY&_nc_oc=AdqWCs3ohgxfVizQhBoMuQIab7TMJoPROBIaD42IzoOy5aexxPblp4h91QccM-eVbeE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVcX_4uK7vz-prmCLtV30MzUIH4i5z_wCatjOOxRZ4WA&oe=6AE5F37B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5ie_ioriUYQ7kNvwGl56M6&_nc_oc=AdrY9FBPqLacISTVS3B3wLPNhd9zAMTamA17vxpj6L3al8jOwXtmX9cRmj54yf-e6Z4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTUYGSghwa1_v7HdTX6PmRLh7NrAyY5O9UePXq13BIzA&oe=6AE608F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBO5d6MiPXoQ7kNvwHgAWwW&_nc_oc=AdrYSf6ij8RYwAbzN9l1IHOSCpRpI89WGeZbStHWAkY2oRCgWrqqtdNoKFeOpd-GLZo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMg3wl2n2wSC5kHPsYetV7DRTlQAAjEA2GOtp-TQsUPAw&oe=6AE606F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwWjS9JDLogQ7kNvwGTr5Mo&_nc_oc=AdoRA_kipoNqGtl1DjB1Pr7wPaV-usuHARAOgebijARKfBz_ENNowWCtrfYRbLxMbc0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVd_4ycOCVDukyBXTlB7XXyLiDrwdWB0t8efbGb4L9Rg&oe=6AE5FE53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ub_MIQhLEn4Q7kNvwG1e3_2&_nc_oc=AdrSRjwpH0L3s44bjUPYH8g91qjtDsXVMIMJDiVxUmH0rhBTakidjyA9n6lkX40ZWS0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYsEyWamA0SWrEcEtCECfSlUdP3usteZZHFk3D3dSUjw&oe=6AE5FA6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaqx-cg432UQ7kNvwGSQG9D&_nc_oc=AdoMfmyVzdqJWOQm7zTz0evoFG1pmlWo7q9nFaOXoCkrujzy3Yua_pTM3IH_kZ5bbuc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQSzAlUen4BGthOXqiv9JAvBgIKEcCUMYKhN7v6gY8EQ&oe=6AE60622"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
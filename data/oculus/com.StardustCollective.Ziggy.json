://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19YxhNzTRZ8Q7kNvwGYWHHG&_nc_oc=Adp9Ewka0Bm1-ddtUsstmVGjlL0rubegnEpsjK8Y_lLoa0_HSZF4NntNQdSMUOamObM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlxgiSrHO5CqtFmfrf9QEavyLEmknet3vxEpvWf00AGA&oe=6A677466"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNwmHGrCs4wQ7kNvwHYLpR0&_nc_oc=Adqi-xysHnodp-moeJJt81LdNJuKib-fmvVQyggYlT5tOl1kNCZ6Ed-C7SEpSgutubY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPKhp5b1g_N96KtRyN_Xoata2Nw-jtmpI7YgApbiJAxA&oe=6A6769B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-50NHvRlU9cQ7kNvwFjAl8D&_nc_oc=AdqhMXf4KG--ulghGw69XNzZ7yyBn3WcwKEe4wxB7ft3cBqLAvNK_fo6N8i4aekD5jc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxDLE0Bx7mxtGMozTrpYv3Im6NH-wjGpruUr2q9twbkQ&oe=6A67637B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFzyBmxR8DoQ7kNvwFOBj0p&_nc_oc=AdpJSK8yaGArN9F_hHC5D72eUqXl3hdscWtgEdH9jLptjzbUjScVGGx4Ia32Ul7Rkec&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOY78Wnk5Y8_NWAXtbLlpqz4_vL7E4TO2hIX7ijJsbNA&oe=6A6778F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lre99IAv6EQ7kNvwHkeJUO&_nc_oc=Adovc4GqNJcu801HDAhGJMIOkbjM5ERlY8Vzm2Aik47yWeqZ8pWy1Vuq5u7mrvTp_gU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKabykdeOWh6JxqCJPCQZONXlBE2tplU8B268boTOlsw&oe=6A6776F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llQBKdD8iZgQ7kNvwFB_r_E&_nc_oc=AdoeUE_6CGNHPOT5MyoGhFy1tfGc0SoBpWCdlHzD3CAyDOKC9AStwWu4zKrhsHbYdPE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1ZWoP2wEp8PRyzvhbzziLdgGulRKWzz6-BrSCGWa2Pg&oe=6A676E53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uv5KlQmJSgwQ7kNvwEPPXkq&_nc_oc=AdoGemvwu4pyxUsqaUZQAsrkUUlXSPPDJEL6S2S7HkYQKYRioZcac8Dc6wJFpzTb29E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDzHiKy_GAkyXmv5a_W0tUU6ui4xAhKX-LwURI62pdMQ&oe=6A676A6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHSoCadxUWYQ7kNvwETphBS&_nc_oc=AdoLwyHGBx9XrHXo6xIE-NXt6TugKP7_cA_bWkWalfHDbmEjfty7ZqA9xjdwGtToawo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCTVzcYyGlaQ2zblB5M-GzXpcdlio0FqpPr4sAbjoYEA&oe=6A677622"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
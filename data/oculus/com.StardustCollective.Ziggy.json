://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NtLZlWomAIQ7kNvwEixCZD&_nc_oc=AdpgfvoImsO-D3DNx6U5zT3wdrFRu4u6hd8xRC5iE-76Yf8ky5Bwvxi48RAXajdCe-k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5L6FblU9_JaA2HcGZGf6c7SD4IUiMoXbpkqF8FybAAPA&oe=6A19ABE6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2GeDFvrMc9wQ7kNvwGoVFg1&_nc_oc=AdoV-vO-Mxv_ypGq4c-tiFi3Fhu-pJ1xK5dith0vIIp6zYdiKhXRQDHi_r34aW3UatI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CoE-Geqm24cyPPMiDiMnawAaPd1I8867Qk12_8fZD3A&oe=6A19A132"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlYaauoXQg8Q7kNvwEoS836&_nc_oc=Ado_AVEF5J0LUFmq_5823vlc_B7DyWiwHbI4RUKGaL8HcLj5rSvBvDG1UcFA9FO_b6Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gJdaLy0076cpKv1U0XJ2ZXaHpt8CuWC1QTYErikV44w&oe=6A199AFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rOgulmSyRQQ7kNvwGlHbr3&_nc_oc=Adp3Vx9qJXX703BG5jyFZJ-QcoxkWejcT95vJR_xPAaUMuDnjVB-gTMymOm7mIfIRBo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LyoE9SQ1e4f4fs0yRddwurj_5NzUkSxwywQVAxWlP1w&oe=6A19B073"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=019DTDpec3AQ7kNvwEZTYZn&_nc_oc=AdpwUoTh7y75-zFV8wdpS-AZNApkAIi7VOTMxbtstCNozRiAKuquqlNrljw9tcyYKdU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tqxRI8hMpo0hWJTYJjtQIFuNw3AmEc_g9-vW898xUZg&oe=6A19AE72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCKR-nvqDhQQ7kNvwE4XmOq&_nc_oc=Adpdns-kNpkM8R2d3mmUBXBz8pGLftuDTlu6vBvuadZ_FyirBPRfOcwrLQuSjTWjqB8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4n8mH1-yZEcw6DduFFC2RXIhw7P-uG29BAqRGGSBoz3w&oe=6A19A5D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-2wpzAEzfcQ7kNvwG69f_1&_nc_oc=Adou78lNgIvTtMxrCRoB8PCGkDnQ10soMRiQdeXGnEoL-BXqRizT5SE8xzA7JZb0KGA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HqeozymShXkCDm4eSQ5ThI_MweASjMtgOWVXOKTBmiA&oe=6A19A1EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZj5tkmUprYQ7kNvwE9beOP&_nc_oc=AdqFuAnrKfI86X9Knf3Ua_qcIlzEmIOCAxHKrr2gy_ofJhccRJtVbz3aFCZvGsd2L2M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JU-VhWGO7OvhqjlmGwPamUmEbVLypRbFXbn2NTmGoZg&oe=6A19ADA2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
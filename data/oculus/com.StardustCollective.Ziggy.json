://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9ZwWfcHcbQQ7kNvwHjeZY8&_nc_oc=AdrmGgDUbfpIpviHC2Ft2O7SLt1AFzZR8-qN26p4yPQy1yG8J7Vk_wzlL_gNxR8Gqik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpFHQo_Fa87zQrv5dQHqRkGIjHoNOefcldPJeaQ-l-jw&oe=6ABD25E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCHJFqYVXjEQ7kNvwFPdz5Z&_nc_oc=Adock4HofZRoEEKki5xoGR6avTHbckukqZbNgmASZLHP_gjl3EyH2wiNbTu4MN1XqgQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL26y4ARsI77q_9gaHN2pKDvWt5fgNpqZAQXg2L_YJGMg&oe=6ABD1B32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KavXWznbi7wQ7kNvwHA5HII&_nc_oc=AdqAB8KRYXH-2IIkHHgCLY3wvs9O2ErdQK4SBTsvznYwL_MS3YYZcKhQImRs1YnSmXw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJV4GfPMLk_u7xH4yZhvHFW7e_SbHJ_tKemM4dfdzXDew&oe=6ABD14FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPZy-u_bssQQ7kNvwEgPLk8&_nc_oc=Ado3vHKk5v0PROKIKUyeXU7zV49raPQKtKbwS3wtJZBoGXJLjpvZChAQROIxjttZVjQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRjUSSj6CINvqLyo5vFRHJi9GRgxJdRCb7onUGH0LZpA&oe=6ABD2A73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJ64gWYP2VgQ7kNvwFTgDru&_nc_oc=Adp2QRt58khK8nFhxPwP6olpL12c1CoIeVjDA6iQJf17xnShHkTCf6LcSQyrxUQMLJ4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6uS7cswiC535f7X7q3LJyA2uVoKi7YaSVkAH8_XpCYQ&oe=6ABD2872"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uO9M6mgKzNkQ7kNvwFiJ3J-&_nc_oc=Adp7F5EXFmttLC1Fzv7_MZ9ZcLYwKygw5q9rkazyHm6LJhvZP9yzGT8-KFZIFCUlDe0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxGCviJYLcEGFcHH4Y1NKb0t0n6RCMDIWqD8zoNDTJLQ&oe=6ABD1FD3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5w9FNcOZyHMQ7kNvwEVDAV1&_nc_oc=AdpMlRV10Z6qy_LkuHtMO2b-os5nCPZYjCQ8l832WubOPmTpBVU8ZMe-jE4tI-fhh8g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIebuk2lTKS1mPTxO3q_hZSd_yoZ7qxXs4sDCc5TWZCeQ&oe=6ABD1BEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfCn015q-q8Q7kNvwFA6qDw&_nc_oc=Adq8ijb28kgR8vfVaIxCg5-olPDurSnhVTmcAM7GaQfF0wC-wWQyN3JqR95fncwfEuc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIY3BxFXLCB2yXGfcK4mDramYYsnT6lo2T0YaG44jZI9w&oe=6ABD27A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
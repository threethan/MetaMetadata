297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOiE0c5z96IQ7kNvwG8kV8c&_nc_oc=Adm2FR6LC_koWqMvkWTe_ykMx8rp92pDyb-falKKqgEF24nsIjtbasirhhs6_zck3No&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwv2rxFsEp1fRAYnSYhM0iL5S8Et6Wx3yQeN6RLc0QXZw&oe=69B93626"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFR0hb4wrE4Q7kNvwFO6Pcg&_nc_oc=AdlL26CZdhfVpQ2S98FoG3EYRniyM7pqNmAcUY69K6p_HdBhdABLpgHnr9D3RtwoWfU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwKuq-jVOVGuemAeyv3Ak2RrdF2e3S29Zf-Na2UUCxAVw&oe=69B963B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_13huUlfXTAQ7kNvwEA_s16&_nc_oc=AdmNZWgUYh0tOFaXxw6d1TbLuZopNm16gP-rEgP6e0l255D6nJ7vtGOQCk-DKqAJ-5g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzEKjgCQ9Yjkxw1_Q-PgpMH8iwkEZPqd7sxOuvoNc3Sxw&oe=69B95D7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nyNgiSfm-EQ7kNvwGoa_9w&_nc_oc=AdluMfDgv00U_ENZ7lsJEEEbK5_m8vMqa_iSfKJ7LrOQEr11FekzECkNyLD-vjPDENo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzmhxswlMcNV75TGYO2cw9lps9SrKQ26yaM7jaJsNCH6w&oe=69B93AB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJ54nuhplfcQ7kNvwEdrxr-&_nc_oc=AdnehQtElu5A8pjdvvoyoS20RYEOmc7uDJh_uj4-nagUqW5oKgWlgjInGeicfpYxxDY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwCL54vi1eqwd7cEsSTgL6QBMb2dkbocIcxZ-2C4bYyTw&oe=69B938B2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kM1UI010Qi4Q7kNvwFWxkH7&_nc_oc=AdmIzu-gitfyIZScSFUnrqB6aXH5lLiNQ7153Ia0cZCLjLhAJpJi812JN7GqF5rXlag&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyWg0b4-afV07BYMnIMypwUr8zCqrKnVZtcnwKYptKMUA&oe=69B93013"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIrWnLo1LYkQ7kNvwFq2FhH&_nc_oc=AdlUUpifpxio1q89SRRTDhyjxeyR6TXcazrTfWrm8-rnoJ-LS6JqhgK_YJZBmLk_K2M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzfOKiFMFJ7RElBPJaRpbrl6Y6qDajZTyLAHjXoVCJ8lg&oe=69B9646F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymxXHAtIAb4Q7kNvwFR9BnN&_nc_oc=AdlNFoRVYWMqTtI4WzuilbUOaui-_SEuqR-LXN279jNtFuDJ4bBoiNKSTqmEJpsIVB8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxuU8hM5I5RwuOsp2mKRLg8NB5JCT7vTbzB5rD4AuuLxg&oe=69B937E2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_5218087471640407679_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIwCzAApnUEQ7kNvwEU8FIM&_nc
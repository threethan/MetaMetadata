297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gy1Y35qYGTgQ7kNvwHoCyXy&_nc_oc=AdmGaQ_8m6JJawGXxf6XC6Axjg3Ilr3TVSiFt-RmwYxWTCR5GJbgf2RaiLwROq4SRko&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXUg8hkkoztASCB8c_9rteTjqQHPUqL3xBbELPp1jzzg&oe=69B14D26"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38C9jselHLEQ7kNvwGC07wm&_nc_oc=AdkYYPbs0vhMatHKONL3jj5JRNjV1TMbKNzBKxR_oAdRCBIE8AKOdyW2Atknn-AJ3ak&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxWkkhmDOJkNmBe3bhjYeVcYWuCiKbi07oInns6jTz_xQ&oe=69B17AB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_kDmJaw7wQQ7kNvwEwaqwz&_nc_oc=Adk3LtACev22Y4EWPfINHRU3hnstOI-Kd0UZyvXeiR-nRKZ0BuMM61wotO6FdQPeSCE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzCNkQ3lQG_7RRvvCp5x680rN9wgETLyoAbPj3yO8NxaQ&oe=69B1747B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73hoyC5WfLwQ7kNvwFj1yZn&_nc_oc=Adk7PoCMC3urMlKIHAozB48CbI0xFt6Xmz7kwTOVEaMmr3xwhFpgAVPGvQYM_HeCVqE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz4AwWhIHDfBcYNIRrpwvCu9WNPGj3NqP23IBJPXANl7Q&oe=69B151B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=727WTxuPY_UQ7kNvwErDGmf&_nc_oc=AdkADSknxizXomkvRbeCjKUWGXjBE_7AWRkowxv5wGRHVnmKkw78FRYUZfSU-sPEb1s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyupAvkuEtrXcw4yCKzpsfGSFT92lzA_e2my8bnrpKvlg&oe=69B14FB2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyvND0Hp5sMQ7kNvwE1AMOL&_nc_oc=AdnqI0agLHyHJy_w-uZQywaT1KshIuKTt9pdsbwVleep-4-gJ2Xbz3xnTq7k22cBut8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxet_75kS2wilYVezN-wx6nWYeffNYbcmNUnzLTYmXomg&oe=69B14713"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vC7dyQSvyyoQ7kNvwEMydfk&_nc_oc=AdneIQsAXMvXjUxO-cA-UIZtghMOf-Qn6vexDUtARvs_M-Ng-WFfP3Sy-rCVNUpLW7c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxF4bIzEbGLDzcCe5qjH5dvcmi7oNgYTmDYvADRi9y94g&oe=69B17B6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGxKqlW0mPoQ7kNvwGmv8JA&_nc_oc=AdkOH3WlmpYXyDubgqRjYEORNeGqaD5StmxfTK8VoczXvh_BuxdeOmx2-AKNo8qmwn4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfztlmSc8voK7iEevZbdQDbleWQYuF8x4hQ2urbyNBo-jg&oe=69B14EE2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_5218087471640407679_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0evlyoZRsjAQ7kNvwH2urPQ&_nc
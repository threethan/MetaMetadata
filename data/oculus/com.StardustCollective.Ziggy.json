wfgQhq88EZeXR5MSw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQ_P8-fjnw7tL8ehEWe0GKbpYUnw1aHi1q5nVYbvPTww&oe=6AFB1640"}, {"file_name": "HighresScreenshot00040.png", "id": "818138872994656", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982499_818138876327989_2509640883979337008_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rsey8ABiu7MQ7kNvwEyDZm2&_nc_oc=AdphGXQxUQ_Xe8P9V4LIak-6uWV0DMb2dGbKlUdlqwJQ3fsY9z7WA2bN-d1e07skGDk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyYSw1RsUDGaHgL4qgyThhxwWF5DitUTvhsj0r9AiDmA&oe=6AFB22FF"}, {"file_name": "HighresScreenshot00146.png", "id": "6528405093884480", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982442_6528405097217813_7617801026990639966_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFhdDisFdAAQ7kNvwHyxyYy&_nc_oc=AdqxETl7196ujhS_QA1UY3Xrlcmmrb0Mcrclw7mw8ZwSSPcgka7SK_86r5tQHutOCys&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqmt4SxlxHBrH2fi6Eo1hjNF525J_7bdU_NREh7uH5ZQ&oe=6AFB3F8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "312845394416247", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035359_312845397749580_7295644085646795585_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqJrBsUYzVIQ7kNvwHJWbs_&_nc_oc=Adov-n1Ak6QhpJUo678xtw18jeKGszoLyu_-232OrAbWA2b4RSE97N-VfGrJmFM49Mw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5165jKS8PHmRhg76WvdfaIMwLRNCwoTOGzc0A1AqJug&oe=6AFB26B9"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stardustcollective.dev/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Stardust Collective", "support_website_url": "https://www.stardustcollective.dev/support", "web
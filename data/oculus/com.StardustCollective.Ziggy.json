://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ey9R3jDzUJMQ7kNvwEoEPpw&_nc_oc=Adqb8XvXe9YqpGDqighfR34PvZy1EyjQvYSKCiDBq8PaNONGUByrxk3enCXur8tuRGc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hVLriesOXimUleen8FpJnDZTfIhm_Tzq37m8whkBs4A&oe=69EB8766"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWuski8Si3EQ7kNvwGo1TaM&_nc_oc=Adovd1-GAv426Dj25MbECew80Ac36MVrkJkMvF9KL7PyP2nsiLiVb_8D9D0DPGQeIfQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rc2iMDQ-ayXBXOQgEeU6gRw7_mpu94EOZbHPElH84xw&oe=69EB7CB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjPwS4dF_MoQ7kNvwH2rDmN&_nc_oc=AdpAH_SFnPSo4Z1Lo0BVskClqmsEHZRtdDFKSpLgkJQz3KY6RUJA5THlX-b7O-d-gDo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2of-3UsW5vIbMWnNIVoTacGtK7eZVmdySCIQodQnRTWg&oe=69EB767B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mT4C10reXMYQ7kNvwGnxitd&_nc_oc=Adqg2uOkmozPrN0cxuD98fDbWpvsp2SZP4HjnxpkOhCNtgeTzSOLLqxB11-q33o651Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lHZKEsV1oxUn0GexUHketiHclfOW1BURq7NfPMsODYw&oe=69EB8BF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RaxToFlIqWoQ7kNvwHGjl5I&_nc_oc=Adoz32Gblc0ZsRJ5OsV8Au6DocToxLIM_xRgBlVPQC2Wnj6gv9oZJddqDgBVPy5GTog&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DRsAttIUne40wbHi6AuYEnnhzcPLg33NQ3RoCOjTz1w&oe=69EB89F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-oYnU-8kGBcQ7kNvwFI0UfB&_nc_oc=AdrRBHeC56ZUv71uckiICjvuYysPeRhcap3OjPmaeXosJbB7eth-m8w68gaS4jUV__c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uuXBtcX_E7TS5LWX5qkXnYXLpmuVpLjfuiY_opxX7fQ&oe=69EB8153"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4LqY5YjWT4Q7kNvwFCwSGz&_nc_oc=AdpC8o70IKIz10pHCJ__FWDfncoK9gxam2tQGWFgYWZ6ascEC7voa4D1mXbAdTw2PB4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QoRZPDr675W-jKEXcKoyaceOyZ6129O7-DCCs0ssiiQ&oe=69EB7D6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KORvDL5t20Q7kNvwGDsAJm&_nc_oc=AdpqHdPFjVeHOtr6PE0gsdGo_QX1eXFhXDw8nA8Oes1jJt88HNkIwSE7m-45iYPf1vY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pFq0QChTJpmZk0k0tfFKeKCEfJVXjABXHOkBM7L_nnA&oe=69EB8922"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
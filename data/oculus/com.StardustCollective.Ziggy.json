297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8lNUMZfRC8Q7kNvwH4yzix&_nc_oc=Adkvm_t-9rVzDIcBIw2pXnsUNWGtsd62RP7USyo-sEAyUss2BXkd2C7cpGwgz6UAhsI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyY5HWfGsgvJqhrxt5kgkIH8DMoAs7dtRWM1VL-O_arjg&oe=69AC0726"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4YPcAJokpUQ7kNvwGxhxEa&_nc_oc=AdkrWWf5mLcUnmjwFAArvdOsq1k_nDA5vgVaqxGHTHo3MFtLEIt9WyTu9WwxTLpp1I8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzG1rMhvgi95892uft-wZZpVcgYazodm5IN9iejkME8-g&oe=69AC34B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XCBjbq5bhEQ7kNvwHCreAT&_nc_oc=AdlP1eEzNI2vFZIOs_Z-d8uuQHtE3_V8MCy6QvAHnYKZrKXlE6HfaqGrJTH-qyqQI5c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwGHZE5uChsdbvVwPiXFlhGk_steUYucNKX3HtqnjQ3vg&oe=69AC2E7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCQtM_DgidIQ7kNvwFkJx1P&_nc_oc=AdkS5jzDHAXRQOHV4YiqTjR5Q6yRYwpiGM9uXZaQjZbAEa8ScVWTIFOS3EsPLzKcsTA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxeW_qYxyy9iHAUTi9Ep7FQavFCZNedLxrjpo6jYCNPBg&oe=69AC0BB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pB6blBMFjhkQ7kNvwFjgUF4&_nc_oc=AdlY4F6Wb0gJBy3OBveIc0cDYHZisEw3QlRxnh1zAdrgMTWAv-2KNLnCxKi4XJWHPZk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzQTyCQQhIBNJsLAkPqcAr0o3z77k4mxLwCEvZ2uUxqPg&oe=69AC09B2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-CKTAz2W9IQ7kNvwEtha0V&_nc_oc=Adm2lEO733KivGar8krP1Wzo-_wvr2Q1RbnfcKhCnXhoGpVlwsPjUMwMq0ROVeFVAEc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyOQ1L5GX8tDC1kDhYSckHdo8QIwpd2j-ZmNcVR7WS6WA&oe=69AC3953"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlWkJh7UqnAQ7kNvwF2ePN8&_nc_oc=Adm-XHpR_snY8WyRHweDAl49Btuy4tizutQ_L8SoFtnLdgkiq3YnAu4aUc4v04ZO380&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz_vL67G68OQ_soF2iP6JQu_n6ia_6f9D5PWeO8eq7E_Q&oe=69AC356F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKh81YE-gxUQ7kNvwF4NQXA&_nc_oc=AdkNZQuSEWFjJJO35XlsAhWC2PkMaCWMzQZPQU99a1Ml41MRBF_fopJcFNLmDx8fSQQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfypvxK9fDz9xgTfmZMznW-PBZEVmP54l0XUbPZowUnJCg&oe=69AC08E2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_5218087471640407679_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmpDdppPgXUQ7kNvwE5rU1e&_nc
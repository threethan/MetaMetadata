://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atEi0bHJUD0Q7kNvwFgNbMG&_nc_oc=AdqRzFDU1SVu5BBILKmJl0NrWouBgMDJVaDbL8pGaswRcDgtKFCbM9pcKrUoSwp2qdo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAkCNDp4MNHlxMA34k6WAqv02EDx6Hx1G5sspTCaDZvg&oe=6A785FA6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAyzJOKX6m0Q7kNvwH-GShF&_nc_oc=Adpmvf_D1PHzvYH1VCM4qqjA-hZALHCtJJCWWRBlWfX2fn4Q4V0eGwJOELvXotKU-d8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdrbr99nkJVYFeMX2TZ2E34puA1g2RTBY6hP4phusWZQ&oe=6A788D32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clkyehyzS_IQ7kNvwGzQoAM&_nc_oc=Adpop_pPszODwY_r6tmmVOj7WWwDxI8nrq76MzOgBriuO3IBrCjWgqAtNI91MqGqc_o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZLcdqANeL_5EwYpskSz3oXtBL_Rz6sJCurdildtPhtQ&oe=6A7886FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbchWdK09XwQ7kNvwGKxf1T&_nc_oc=Adr3uVJDje2kjMkS2s5-a4bxzZ4CQw4ViXsxglZucDmaFNLqCJU1ZKKYpP29d7u9eWE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQEtxl4u8iutf0YHF3iNGpN7gV1sAkKj_3zYsIjx0w4g&oe=6A786433"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzy8y1Il4sQQ7kNvwF9mBH7&_nc_oc=AdpEalJZv87VeVEnm6-5oROT530GQjDLcyuvERjYJCuaocM1Xk4hqjTr1XFrEKbL46k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkWuAfyPHuPr7vBLRco_g0uzwsDm3CQ8bcAA5PW8HG4Q&oe=6A786232"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVhF6k-2IsgQ7kNvwErYIXz&_nc_oc=AdrSii-ko_A6d86I8HqY8y1mf3WFgeq_3cOm6aMuxPeQC3UcdZcRDKa7ix0ScRIvpdQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8GgNDS0safcfDVFbT4_GZYaudQt4EB0J1mdrWBludyg&oe=6A7891D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gvrwM8kR7EQ7kNvwGXCr_n&_nc_oc=Ado56lVVOXzgMNaDE_elNxMrliaLmSUhNKDfRGY1NgwG2_NoYclliG5MJNPT_f7sg84&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjXmqEcge4EKWbwcpOHQ2XlSF-9f52J4-cZCEjv9nrsg&oe=6A788DEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIIEtNKMxBEQ7kNvwHFsCTl&_nc_oc=AdoimqyvYnRAiVK5V8NCn-Bq0XBsICzHOy6D3O-B02rnxaK_4TIZgDuNJg0qsHzVk3Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEo1mnA-RTOA1yyuyHA-cfLSSw46afTJK75j-FWUgO_sw&oe=6A786162"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
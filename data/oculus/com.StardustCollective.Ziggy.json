://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pZ5s_bmfZwQ7kNvwGYHN8S&_nc_oc=AdqLFSHUyEeS0tUS9tyAyw4spAJ0xyr0LSS7EHeJ7ZiWuPlDO5FrC1UeQw1Toi6c9lk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdyoJLAcMVVrsVePZ1MYCBLOy8xC8u49oLM_i_6B_egg&oe=6A9ADEE6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfZcKa9TXt4Q7kNvwEG6K1D&_nc_oc=AdqGIwdYMdICt7v7E6sAI5_DfuG7M5vC40lqoP3XyW2wL9N9sDHHwJqF5cuem1xGSsI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsQO9rYkjyu7TrNbLvjh85aF51yGYo0_6Pv0S07e4Rog&oe=6A9AD432"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AirhR6q1gjwQ7kNvwFbJ-Rt&_nc_oc=AdohFxvOi3YLOocVomKIDdVPVHXrJjEmnSct1-tgLywlX_o35W2ysbZHjkldrAPHAk0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGCPZ-Lf547YJRCYkc0T41KfXiTLpvEDy2-8ctvA54ww&oe=6A9ACDFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTt-2KnIby0Q7kNvwFK5SgC&_nc_oc=AdoHcVpi0SvW9ZIisgGnz1n1b21myNQOgAMwi1sZM6LMqY4OTZaRm3j-BwTN5dNwtlQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9EGqXA8ZzTjCqv1sSe1tIKgvVGlRrZRleDbWuc4uUSg&oe=6A9AE373"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cf5GYe4F6gkQ7kNvwFnIMgM&_nc_oc=Adrrse4Y_y7FOAxziYwTZvbyzC3zFWYVC_DAdCBOvLqO4pow98Pf-Z71BWORqcOBiJg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9rZy5kDMbMm5WcggiRdVxjNXLpyG3YhSQbOFz7zdN9Q&oe=6A9AE172"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73q2wSulox0Q7kNvwHON9b2&_nc_oc=AdqfMTV9V4pn_QVWbfBjoI7T003Qc3Y92_cVhSWoGC7GaNac17Nft9lWxrdsyBq5aVE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI77AdSdaq7iIlGg3rTOxqvKsh970SRiuxdFL8IFgNF_w&oe=6A9AD8D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drxmCIGV1kUQ7kNvwHQ_yFh&_nc_oc=AdqSh0__P-QcwQFi43ws-uprPWguujVTwQpaXO4e672PCy3NPWJ51gq5xqioOjmziwE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7_1x4EFC9TJBfAvU-W4UtpM-ukvJZwy4HbtiCFlkcuQ&oe=6A9AD4EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3XTfD6Vjt4Q7kNvwFlz6ZT&_nc_oc=Adp5X982WClEUpkUo3LOfMbzvM5fi_IhaarM4Rucj9D-SOWLLuOoQCuWF27EKAUljws&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIya00Aumxe8m5rYO4AtAAUmKpDEKpFD6V06a4TThoCJA&oe=6A9AE0A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
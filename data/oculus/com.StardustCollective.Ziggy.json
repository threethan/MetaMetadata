://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6m-Og32apQQ7kNvwHLWrZ3&_nc_oc=AdpLePz9x1BvgAXVdTtjRfAVjZe2_4XjGFw9CBps7hJUlQhrcT_VuWf_HIh-qj_wlhY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOdQ7wUs_FThy67lc1-NPh5XMtNOLgtcTpi0p7tsvaKw&oe=6A4FB966"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrFR0YUezFsQ7kNvwEHmU38&_nc_oc=AdqfArMHiO1MeCFzDkYWQb8JlG79LCgH8ZelSauA3SC7PwXixY7ftD2y2vq5RYh6leg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABd3Ev4e_3yZ4z7OF1MnoaaB44eVPao2oF6qjoWVXnPg&oe=6A4FAEB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygXe9nLvFrcQ7kNvwGOJbcd&_nc_oc=Adr4ww6KgU5hMPKpsKNVssIVjOkBkJwjfSoR7DehaLHPra_VIGRy4WjfFy1_-tv4Opc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLmDKjjfz-3Cdathvfq02Mc9TwqI_lglPNuXRQQY3HeQ&oe=6A4FA87B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsTqiTwGhu8Q7kNvwEuZ5p6&_nc_oc=AdpLTXFu-wjYGo5i7vl0-WcuBuSQsrHFzdScu_ZNBzdakzdqQh-rkoDZTBn4Y3toT3s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmoyYF_FkZid6lnd3awX57vkmfDULkSvZrPr_V3mUMxA&oe=6A4FBDF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m29iaNER71IQ7kNvwEEVtEE&_nc_oc=AdpCaC7UwadbWl5KFRGYq5CpDeZDTOkolnwf-ywXeeKiVg9v1K56wF5HcLL8jGe3qPA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXYCbv7mtTgHJ5hHhWf_Jd_jLpNTxc9RTcv0FpIIJUfA&oe=6A4FBBF2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xacldVUGVsQ7kNvwEWlV-i&_nc_oc=Adp8Cj520N78ewYhiIPGr4-EsSF72EqbLS-KQKwg4gCPHXQGx26LUvtt9k7zYkRM9us&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoMe-5IgaLikdhwEhfNLvNZFM1s7cC9Vc_6u0LJE-2lQ&oe=6A4FB353"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPsKP0xQVe8Q7kNvwGGFY54&_nc_oc=Adp81uTVcHuwec6PdX6-WdYGGsimq1cCN0R3K7awY4dv11bG8Okdre8itdJl1KVwvOc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIS98OgrRj8wyNugl-YOM8aQMB6bWeh0QWtZk0Rr56_w&oe=6A4FAF6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hNwqHbDgGYQ7kNvwGp7TaQ&_nc_oc=AdoV2rsauaUGfRlmrZmrwL-mc1Um0YzQ22i0iJmlWEzu2x-XIu9eW0r6fW6J2cfjsoo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCp5EzNjdoGBMRSxaHPD4qKBmwXVyYtj0HcdLZ-OYGDeQ&oe=6A4FBB22"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
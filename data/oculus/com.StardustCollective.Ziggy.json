://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uy9rk0aSIN4Q7kNvwE_XFOW&_nc_oc=AdotlLgiCxV2l_Hq4IbdJei2xML-GjJr_7K50riMpc6HjFUCv0M398vWhDqkDszFV_A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPF9AMZqPa_GOc-D-cRerXUg01RsIkTYqBj0OlD9XzbUw&oe=6AC66066"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=480SsQLejjsQ7kNvwGlnlIa&_nc_oc=AdoTlGLolXTH8FXl0ckPNchrONjlzccdLwQICw95J_9cTKVSPIbUo8VXG1RHz7R7MgM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMS1wQ11uh7md2trfhkNnvJSKnSsc8BkZaHtdg7S4Xaww&oe=6AC655B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHkI3CRF8scQ7kNvwFEe9iv&_nc_oc=AdpF9Az7upC6J6fdVd3-OZCZucxJsISNcQQWeZziY37-J9CIOS_7jt3hmF1WNbKrp6c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtQ3m6lH-GrDpSX2dqt6bg8kiLI6i7tQmnT2P7OH-4tA&oe=6AC64F7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_MpNAe_rycQ7kNvwEEWiAI&_nc_oc=AdpSyw_kwpoUNHQMnNP7xyY2lW3k6-Qgb-ayh9zih85dPSOB3Iu4Otap6775i0iRAE4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbsvWKfq2mltwn1AW30X0zuoEXgIIb5AHQkesVNV7jPA&oe=6AC664F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMarFGWl20kQ7kNvwF426Zt&_nc_oc=AdpYZ4PtCziF6E2r-aiKqBLijLb4lLu8WPUa8x35NeIWJiuH-PdIClgnRh8G5xEh5yg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPE-Ye0UFHoq70_CxJEFb2-pAr_D-Tuw8F7gVnp5TzKow&oe=6AC662F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GGKZ4RhhrAQ7kNvwGlW0Ui&_nc_oc=AdqX-yl4iAH1-xGR6eq4kbbRfEDmZnyi1ybPc_JvrjC41WPZvWEk9GMGS-2lwByQ1eU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6w75td-CSNwzZwRo2VoNgwYddpncAlhjqoM00P2pxkQ&oe=6AC65A53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDjPR2LTliwQ7kNvwFY0aeq&_nc_oc=Adq-ionQkvSUf77BlFPXsdtKdAZoawjsALxeb_MOFW1HAqio1AC3VrQTQhfhjpIWBFw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPw8E0yfkbSjkskaHmIgfEAlH2toGf88pjSFi4HSAAprQ&oe=6AC6566F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvcDViSmE-sQ7kNvwG6CxHN&_nc_oc=Adq-Ezf1Ikhqls-MOn6EfV4YtpeI-e7HaWcpnRb_hK9jlf6_S2KEUPAnA4f2NktSp54&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMF6aeE2Xg4qHhHwggGJ8a2KWQjgVNbZsg1kkR_EQra5w&oe=6AC66222"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
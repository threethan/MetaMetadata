297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ahUF2uIRj0Q7kNvwFCsOhs&_nc_oc=AdkCV1Bw1tWzmfX5AVmvh9OtVJS3oetBWayYUQhPYtgR93Inn-VA4cQUsaELq4i-DdM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzpC3Ur2lXkcANqVCPX5q4o1eCKc6YfPt9JB1YaRqA2ww&oe=69BFCDA6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpBygzxQ2XEQ7kNvwF73Ggr&_nc_oc=AdmiPTUfJiGyAh5TFTwOnnPlcmhn1emeWWGZVpxtAVb7Kjy3jGQRRyutRkkx9ALJOqk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzql8AfooieeWsWJuDJ3ef2QL6z9nhU-hJpKVUaRiJVEA&oe=69BFFB32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Luo5fnnwEgYQ7kNvwF2JPIh&_nc_oc=AdnCOA8CfrJUYffj7k06PeB23nz-Pva1gMGq6KXcuiruvi9HX7AFytNRBQRJXBinZRY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzsb8gy-Aw-xnmoa6-PzqQ-8K7atNyR96Xjac0fwMY0sg&oe=69BFF4FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2JZKGhomU0Q7kNvwFVDTD7&_nc_oc=Admy2bXCHe52die9KrBhS1yHdb8kTWgOFnhRAV7sh3ewBvWeh9sSC6zesomY6YPyYm8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzY1IYzX3tYEe4tnI-8344Fw0Eos3xGZlgZOlLmUHvv7A&oe=69BFD233"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkdF_b1gRgUQ7kNvwEuS3qU&_nc_oc=AdmqZaZKzaW-Tzi-1e2hUftlUNqRWTAiDXZl-gVkIdO9aLybYpQYHySDyPnHkDo1hAs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzhtxltEJmUz7Hj6v9aIOCdoVd3B5UHy5ibCHRNW0RR0w&oe=69BFD032"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_ATv-AvCP0Q7kNvwFc7D8W&_nc_oc=AdkIxqT4ReTLq8ZJQ4eDAV9WAndd2LWyOl3pc6XKbxWc0PfwEp3FMAQQuXVCbMvSHyI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2fpYuYX1uOeVy3IThoAgU5CygttFynfdGKsJx5cpROg&oe=69BFFFD3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QK7bockyLEAQ7kNvwFDoQm3&_nc_oc=Adm3imHcD8MoV9_K5cUbG5_zNdPd_yvDXOhbk15R6cLZVAmfq7k4eJWFpYeL3Ln1veU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx9C5SUlZCuwGZQcv7xMm-xgwG25dkJbMKaSrmSNyiBAg&oe=69BFFBEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dx4AL9ijJZcQ7kNvwEQUAN9&_nc_oc=AdloiMUk1U_LFSMh8r9DgfAeJTKRnVfhGAx0Nmnp_rKxAbx_TzHOmKccXL70sdN8Fj8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzpnAt_rgp6GFSN4hqdp_9M7apyJTe5412MxmTq1WUU2Q&oe=69BFCF62"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_5218087471640407679_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAZYf4IG85IQ7kNvwGtOlIE&_nc
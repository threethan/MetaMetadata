://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atEi0bHJUD0Q7kNvwHnTKh_&_nc_oc=Ado3Qr6u0g9msebh9DfcOIjp55Cz5m2ZkvcfaX7t_Pnj630QrsRCgfgzyOOvKtZo9ow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSUtiMSCmkLEGNvLjGATHh1wN8dPQ03GAlJ3H01TA4Iw&oe=6A79B126"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAyzJOKX6m0Q7kNvwEy3ka4&_nc_oc=AdoaOQ4265UgtQLBYq_o4qUj8236VHm8_LbdeavtsK9CkwUfegPJG9rK9Y37eJtSrvg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdxZVIzztGYr4y2qTqvXPp7d7yBaKwFZ9fEIDhQ28uhA&oe=6A79DEB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clkyehyzS_IQ7kNvwEueQkv&_nc_oc=Adqc-fWzaYVit2Ol6dJ8l3AaOwORGhaE4ZWGrs5hRJrc67rxQ-bmhErcQCiYoVa0234&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhHUQ6AinXfq-Y2lpVpIb0oGg7_v3zMgz4HXIK0goaMA&oe=6A79D87B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbchWdK09XwQ7kNvwFgmurf&_nc_oc=AdoBGWI8n1H1LsIoAXwjklU1Rh35VC6EaP4_XO1nnwz-1-LFyYi6BOC5DF8HJ9nYVcs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDAxpTBF3-PEQXT5uy5-rJtn8Wci_aDki5ZOJ195BI6w&oe=6A79B5B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzy8y1Il4sQQ7kNvwFf1gjk&_nc_oc=Adp_uVzqoH-rqstFVCj6hP0BV8FNgKgNp6Tlisk1D9Lebor-DkeBROpMb5JCBQC-KSs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaatY2wJQjho9LybFqe_Lfv9FOq5jjaMoJez7tmD4haA&oe=6A79B3B2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVhF6k-2IsgQ7kNvwHdSJsh&_nc_oc=AdoLj72PHO-AzNSG0uebLFfiEcSHDRaV_cD9kZ0GCx4UWB5wGHi5kkTQHVDsy81vsI4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmlM8Mnzr6vOsvLjoiA4bs6-zS9-rZrhkDx1XAHWmYnw&oe=6A79E353"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gvrwM8kR7EQ7kNvwEupj7o&_nc_oc=Adr0xJNpsOlgGuJ0AU2nCcIT6JdeENA8H6JaCRiH1K-RAb5tEZ4jhrmgG8yFnVF7www&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGse8zG84o8y0Urvvg_KxlGa6FQN4GMGWvwy9hFkDBiA&oe=6A79DF6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2xMlnErQbIQ7kNvwFqDua7&_nc_oc=AdprrpHMH_3kDsHWWoheiLuM7SLu3XiNpH3bcKlWEotpzdJh-NJ7cih5iGPUcKHj9D0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhlbVobRibbuQ-C42rmxen50FlnfOYxJd0yOIaamivGQ&oe=6A79B2E2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
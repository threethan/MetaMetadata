71-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8lNUMZfRC8Q7kNvwF06OPg&_nc_oc=Adk0_7vucww4hD-C6DMXEmaJ7G1-wT6lkYllcUrM3grgETfrnUVp-JX-kpW6vKizQzE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfxpKA35KysyAuydUbivz-y7wtz90V7MMa7RlX-KqPLjfQ&oe=69AAB5A6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4YPcAJokpUQ7kNvwELGYzb&_nc_oc=Adm-iu2eD7j9G5R5OjGz77MgtJPRML85Vb2n-1YAtEcRQa-HhVYXhbBejZ25a18TVAA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afyq9e061mWbiWS_n_w7tpbj0qpencFPh-sH0P__FLILzg&oe=69AAE332"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XCBjbq5bhEQ7kNvwHLZKFb&_nc_oc=AdkFAbJ3hx2wQs5-0fBnRo9T2EW7Qjabt_iGeQbbDEXDS2_Hdjhf408E9j5aR7yU8Js&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfxPYc_r-dCrL6fZvLSMgO9khK9HnzPU-d6Trc6bZgrQjA&oe=69AADCFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCQtM_DgidIQ7kNvwG81hLe&_nc_oc=AdmbqN8qZHEsozmBmGWmtEkmZoP8p2eDGU9dI21nF7fYY02I48zDfkbLDRGGbRA8BBA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfxgZ5e1KLQ09djRjDGoqif7IOddQdO5vcXCgPfJRxmFxw&oe=69AABA33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pB6blBMFjhkQ7kNvwGBrR1m&_nc_oc=AdlwyB2MIcSWxwqSbeYgQ7LfVsm1WH3tWJF_tVM9kmwIbnmxKShO3NZJqE4lwihA1Ow&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afz9IW4wWOCf3Uk1tU6QV4gZbPUnEiSsXJ2rEXGl0i_lUw&oe=69AAB832"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-CKTAz2W9IQ7kNvwHnR97h&_nc_oc=AdkzsZVe6PnQywwUzoviJwJXz3gNIwcl74wawGYUKx1qgE6wa2qxzdxHWHotShk6yIA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afz_ilTptJh_8B3CNezp-wM5vc7x9x90OyEpg2s5ngFL0w&oe=69AAAF93"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlWkJh7UqnAQ7kNvwFaKAZY&_nc_oc=Adnjb0bgpELTk4bhqdjMgZPGdNW69a_luiSMqUo3AvwUjbsV4uXXGSKO1o-FyMaI0u0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyf9a_b_sPfiQaq7pTATm7hQE9FEnh-4kBfSvVo5AkRSw&oe=69AAE3EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwKS1q80pVkQ7kNvwEw9BAr&_nc_oc=AdkM6xRRoGznbDq-DkcjYRZ_BB4MSC1wejHt2x3ExQEyuFwc3Z7kZvm19Jv9PCR7vdo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfyUMjR2U8NK7uzAs2XmKx8wkdtLoUdkshaDq6PbiyowVg&oe=69AAB762"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_5218087471640407679_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Auyv-4CFdKsQ7kN
://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zFFdtH2e5sQ7kNvwFkQ_aG&_nc_oc=AdoClTA1z5y81EAth6u-yN0_3e7jy4qZgjOTL_ZzOxH_PXcu3c1Dv-HGZxfxgjAxxZ4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqRouygJXuk1J4fH8m8ghteMqc3eJu531tPvq2i0IyNA&oe=6A819A26"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8729SZgOXMoQ7kNvwEPoJak&_nc_oc=Adqc4ebl_sW48dvnm-5LnlqK1oZP71T-gWXeYaJmgmoa79uJWBYUfXS7o3oP7ji64ww&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYx0oyVuQQF3eKi1jSfrXr2D2fuT_MH-smQVllaj6_tw&oe=6A818F72"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mt6KAdifDvkQ7kNvwFJJAwh&_nc_oc=AdpqUEATAX5SHpRhEMYAkUuN63Q1_WInjEAUcdOYbt8DRRcrbLXo-lm5UvIv79qpS-I&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsRidbaxr2yjo1UT75GmC8aLIAkI9rh956-YcyFEoZaw&oe=6A81C17B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjdJFNYL4Z8Q7kNvwECmt7R&_nc_oc=Adp-NLNCDBblTQUXrprrk8-bwmOc9bOa-PJQb0Gcztfr676umD7xjAxZYDAwlF1uIds&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4_oc7-XASk8J-3kp2BGqehOnUdYabE1yF72D0oxHn2w&oe=6A819EB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIkh6lAR_8EQ7kNvwHS_nRK&_nc_oc=AdpmHY_4SYIdBbx4eV5-NWuUcXsxJu7aqJmR9PHY51R9Fye2qYrEzBoxl58pEGPgIH4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESHgzIqUKp5LtqVeD4ebLYn1t49mLT7qteK1dB5TGq8w&oe=6A819CB2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0-n9kq-9VcQ7kNvwFPVb-d&_nc_oc=AdoXNnIR_I7amyR_9AyMttVLa5OPmCnfb__td-a8I2Y3_FtotyHCyJxQ1fcsIH2jvZc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLAV679cGIBlxbECE2MqEZpB0cOu8PBYIlCFqFGp6gHQ&oe=6A819413"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvoqOyrCTeQQ7kNvwEetfzr&_nc_oc=AdrDQmW-h9nrm9zPjNZ-AZuvmzv_XbNkdZZ9YasJZ4dqPBr4zSrF9YBae_gP7ZJj8YQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHur8PZstdwNcIiNOMSf1rTkm9WSiCXCnAf7O9kDNNtig&oe=6A81902F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=liNx6kCqlUQQ7kNvwHQ_XVD&_nc_oc=AdouiXyTdh0qomG_NmenO8gy151L7AiDf_PZ_GSuu__RKms6yMNouhu9HdAeYWI45GI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZQAVH1xxO9lb4QrKTMUWeMV2_iWWtajiZuOHbwfxGBw&oe=6A819BE2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDDX38TRq8wQ7kNvwFnAD7P&_nc_oc=AdpHLchGcmj_Sjb9oGyihRDA0zsUq_duWUjCoQiQuAxrRQ47GPLbdwOaduAJYUoZzAI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZYFK-UB-a8PmsXi3746P_w2NnQTnbBeWGSuYTDaAp8g&oe=6A6DD3A6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-EIlQX1KSEQ7kNvwGes7Tl&_nc_oc=AdoWy9rC8AKJsMmbBmpl2ADhs847rZJQnqFtkdcvfgLC_yx-IbM5o3_DzBnvUinzltQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYkh7C7cwN-gNX0RGIpODAoF_tyBbmI132v89tm9bqHQ&oe=6A6E0132"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYRXUk4n5EMQ7kNvwHBy2TJ&_nc_oc=AdrFpz7a8-Oj5L6Ih5hCIHegdwLxPUQE6DXXYMrazh8bWcUEV4h90UACAzNRy8Y0Dhg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzGeNNjNVUg-VW0wUX16sFhzKSzsPpVwqdG8u05xFYzg&oe=6A6DFAFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBLG1go4CRQQ7kNvwGy6DLJ&_nc_oc=Adrrx635rA3oDCd4g4kjHthPL2cX5ohp14IPtfQfiNpNI0QXdUA1WKfcZz7xpf_wJyY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBv9qbqaxrIpTMvNE4OoiXcEfiMZL7_KCG-Cv2SNGosbg&oe=6A6DD833"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ptgfmgjNlcQ7kNvwGApCye&_nc_oc=AdpA1qUniixeI-PqKKU9qAvC1fraEn2hvvdik-YSyYP7uN1SL2Q-g0qtRMEj4e4vcVs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD04F_wIE12GFGHF8fhiFQL2aFEjiIXzKfnfI089CuBKQ&oe=6A6DD632"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDA-kN5wHpwQ7kNvwGkOTQi&_nc_oc=AdquHFoAavhIyFDj9hC5txYISkBVapyqDjtcsVcESbqkkdwiyLavu6C-Zpt4lNiBINo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4Bb2aCmL5_7guPFPmijFHcPeRZbspR5h-upLvWorjiA&oe=6A6E05D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYTE6GxdO3QQ7kNvwG4i9gF&_nc_oc=AdqVz2ZjdkbOWs2OFtrQTjI4fBTvdyl3TX30OgCaRBABGF7tox74dNL7_c7u4TSbozg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAELo4cL4H98RDhP6OwqvvZ1lElhIiIzl9mhKC5Ow1Mwg&oe=6A6E01EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g57KmkVHgRYQ7kNvwHS_DOS&_nc_oc=AdokIdnZ2nKopcW3bYpvjPs2xjVTAgSsmtiuAbHaJtx--CVRp8wu_7I8dIfutXrPhFw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASJxanZ2yKY6D_kCNz4LicLPkYIe9v6rFueIvAbfHGWQ&oe=6A6DD562"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AxMMzou-UsQ7kNvwGpGk6a&_nc_oc=AdqZqgy5TNojGmnI_YifQPDIyuJ5zBDgEoQHqcgTEz7GgEUHaY27xPXVFACt2oxc6YE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGuAvK_4dbGkaqMn05CNKqxiB4egqdgIVYK7fg-KFYPQ&oe=6AF9CAE6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnuCi_isvLIQ7kNvwFDbZAy&_nc_oc=AdrK24NvXRMqve6MqwdTssCh4pDSMXanhsV8yIQqoIbX0UodjQFGdM3jDMOaaRRZsF0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKv_WeF1u7qQXoX7E_GKNbM1ZI4qa4pYuXRGhzImQ__A&oe=6AF9C032"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4P6b_A8PDMQ7kNvwFzZXnh&_nc_oc=AdoBKK_O0z4UDqfgxSntdK0jf6FG-mxXWtwqDVU4UtzVYTAGgn63OKWyGlaemrZb14g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1tUP91ONXNDqDZHIgOvn81RT6_BVzRlCxTfHpAfTgXA&oe=6AF9B9FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0MlLCyQeBYQ7kNvwEUadOr&_nc_oc=AdrEPhUYbFqVNJwFliMyzeW1SyguE4dgcUTW2Qz2Pvtzp1kSio02dV-EL4gkolAm7MA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-7i0u5WUDijErh3BR0s0-LdMIJfUBfdU_3sr4u61uLA&oe=6AF9CF73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iA1dgeMgeiUQ7kNvwFbCkka&_nc_oc=Ado6lMPSFGpSz0UPp6UvUL15vOs5-zf3w3Vc2EgLgzdju8JmNvhC4YmpN5fL1PtXq2w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSA-1y92hPtZ0_deaV-6z1M6dEliQpKDQxTCdgDXHctqQ&oe=6AF9CD72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-j7DEaZ2FroQ7kNvwELuQ31&_nc_oc=AdrJpZQbUrDqm6da1DPrRJyWKHyg6juo9FC7FfGfOEHSjjSU0PSi9tn8tRLYHSrQX04&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_tEaTLKs8NTt9gkC-tcUr-7RKzatr-sFKZo_ulRHXsw&oe=6AF9C4D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRlRZeJarLgQ7kNvwHMgY_6&_nc_oc=AdrXpGmVRuwQLqAwZeK6bptGAX50fQeVxA0ay1It7VrL7t9pisc-NKjpgto8-zxCHD8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGcln_oPUiEDk7OFReyaAlXiCIDiEssAGiestK4f8QRQ&oe=6AF9C0EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPhaLpRRGXkQ7kNvwE1vseX&_nc_oc=Adoch8v1LwWZ89qSqtqYv5V3QYOZ3iRtKMqFePjZ99WUhHkIUIkSIQDWOVyqB4_SRuA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpmKNXoNEJnVKzsvHppkJsyDG7LSg_kwA9zRfTuRZ0iQ&oe=6AF9CCA2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
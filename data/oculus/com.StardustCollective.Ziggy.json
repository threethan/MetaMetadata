_nc_sid=6e7a0a&_nc_ohc=lVj1mysARScQ7kNvwHkS0oF&_nc_oc=Adro8XaGL9e7ZUyndc6F4hPZCC9T69OAApOhij36zLispaLfHbBaHab24s99uLeBGjI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3CKjlRVu7w7-tBnIATRlyEr0u63ErXxmd_rTQZ1yi6BQ&oe=69F1E6A6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3DjPSAbjyoQ7kNvwHOnWDo&_nc_oc=AdoZkXMmXVyiwFKRE7JVZPymlJjhd6O1OPvngIJ2NW77b3qoW8I6pAKK6M5nIIL3OE0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2F9H2ctXtlJ0g0ncX_30cw8u62aYx-1lNFkcIXQyqszQ&oe=69F21432"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdMd3XnUPV8Q7kNvwFPXBob&_nc_oc=AdpAjNOtjbewpMvyPbwFQGPjiKp0r8A9Ttr9alXyTchxkwHyDvXpn10d9bboOv7HITs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3-xD1z58b5DvZopzPfSYSGqa-EKtoq_qvdnYLXfVhX2g&oe=69F20DFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6q5Esev90kcQ7kNvwEVeQHB&_nc_oc=AdridSgnMbAt678gZA4QI-BzKP590JSeGKtbU_Gg1ipPt-8AEfxzu9-Ks-Vt5ietaA8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af35ExIm7xZT8nsMxfXguCqJsFjGyUkkTVwMkp1wWqBE-Q&oe=69F1EB33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FilA7R08BfgQ7kNvwE2f87p&_nc_oc=Adpd6FEwKbgqnlBa9I27POtFf89Qff_wCdQ2eeM0cYPfemwii464nb9lgos-tZFpB_g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af15jyNlOoRqrIQvWpvhHD38_Lln_5NPLRzjACV8Ekd1Qw&oe=69F1E932"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypVzJ0yF3TUQ7kNvwEX84qC&_nc_oc=AdrH9zusxIKxVsKSkuydpMUZRluX3nEhdT0geUdI1X8aZCJ8RtpvlgC0xDzoWOfJzbY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2COZMXJ4voDlmNyelJpdRxqIwpHCDr6I27eTE7ia6voA&oe=69F218D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6I4S94hI1oQ7kNvwFWa2b3&_nc_oc=AdqcvBq4yV_pVvWLd4fifjvLQ97nDWTCdoiYdi79eR8FL2RuapaZd3HIqVWMrMcXi0Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3o3imv9gKJIXnKGvckzucv0fbUuUcJQSxP4Lgb7QJoqQ&oe=69F214EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aM0hAywnrjEQ7kNvwFc-by5&_nc_oc=AdrlmRAPZsTdj6S0H0ZkbWGaomm_GYaSKCGkjac_D7jNMy0sjlcMJz_1GvWgVoNDpgI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0xcbqW9YbErMTaKDap0Ju108qMQleOwpRP9ooig1_qgg&oe=69F1E862"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_5218087471640407679_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txa44IxgvHcQ7kNvwEc4VMj&_nc_oc=AdqH_yQahivqKHhPlTxkxrXGoLbxQ1gMsbprTqCDHZG_7MGRsmhaXnsTUMlZxEfm6yA&
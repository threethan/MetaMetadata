://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19YxhNzTRZ8Q7kNvwEIxlcq&_nc_oc=AdpCc-N2ZG34Kd5umvP-t-DI3lzqsofrN6S-xU8WeXtsdgNm0wTvCEOhAG43nrehFBU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBA8kywHvsi8wLFS8-ZfytivSQelRBZLXGZiwjK_13jQ&oe=6A6622E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNwmHGrCs4wQ7kNvwHKyLFt&_nc_oc=Adpjk7U4N6LwlIHxl6KX8D2-Lt9cstWjXY5IpDYeKOJVur3MFSau5kxydAVXux_XvXI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpjo4pkIRLPwSBi0EPGY3kb0bjnq8V8WIrKBYizroK3Q&oe=6A661832"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-50NHvRlU9cQ7kNvwF2Socl&_nc_oc=AdqAEBDQzp8G_-8hBdggIkcsJun8KZkrp-vcZmDQSLzvjJtzihYTkwdA5R---FHDyjs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxW9fWS_UjoJVuKU-l4W9W8lP5hGvk-N_YkP6TgtpS-Q&oe=6A6611FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrsqvrxTGgIQ7kNvwEJBcMo&_nc_oc=AdqxIG3vR5bV5VeQ0T2mvD08vmYMn0xMhJyWJlfKnZAbvt9IkQydlQdDxT7NI7F2K7k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSKCgc6PmYtBabMpOhyhz90oojPPcr2aDpGEhACrKoZQ&oe=6A662773"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1BwaXsFFVcQ7kNvwHAbbKa&_nc_oc=Adqj42iJYGpDyXLkBoOfKoEj5dj_bqZVEKdiE_xTOOJP5HNoZWCKNKX7rbkqOORL4vY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqKuVpFPlh5oQ4vocWhfrk89cXe8izPmrLJltuf1hdgA&oe=6A662572"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llQBKdD8iZgQ7kNvwGHhDMk&_nc_oc=Adod6wwgU9WL7BRhvXlxW9ywsd7X8JNTKvOH_wOiJSNae__KamMOTkATEuomKhcAZ0g&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmNRWKAEhKw74qTaPA2yu7GvQOe3SLGrsHi_17ypumnw&oe=6A661CD3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiNAPrXbPD8Q7kNvwHoaFBP&_nc_oc=AdqB1aT8tIBjiFgOArJ9leUnf71G_p6qRzxAfZDKgUWMEJ9PiGEsozP5frF5FQPiHrc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjQI4gvhqD8LulOHFKYgbqj-PykeatE6V0Us7Q_F89uQ&oe=6A6618EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHSoCadxUWYQ7kNvwFllIFa&_nc_oc=AdqcIJ52ZzAEJKPLE_NCZnnt2wl24w4eL5dcisga6ripKjER_KJjjT_plZs_xxcRbCE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNeVKhxY1mxAbcjwS5-n8jnQNL3bHoqTlyDRQdjoMGHw&oe=6A6624A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
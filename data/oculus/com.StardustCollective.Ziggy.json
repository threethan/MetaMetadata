://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trumEFzd8MkQ7kNvwEQogiH&_nc_oc=AdorJkltYaqCJrtB4Qg__ieWcuY2obJqW4ra9DlpLPz_1CTHAU0-cwJQFE-90iy4ZFU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIf-VbqU176jn2YEeJ7ldvvG0NOs4s_sxhRJidmREhKeA&oe=6AB53CE6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4q1wMum-GcQ7kNvwGqHHY9&_nc_oc=AdrHeAbkk-Hxl-jh-OgKU2qNhmr2Ti_dnonMi1kX1eZeSMEZaUyv1N_CpY8513TtTsQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNG04zyCgaYf3fPZanPF9RkmxJDvK9RxiDytowSG7Gkw&oe=6AB53232"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIm-u0h6wikQ7kNvwH50zXJ&_nc_oc=AdrOvvzZJrGY0z6kfiLKQ6asxWDmddc0CBsCRm19jQ1vKi1fFN4vQz5qYA9_-uUdfwU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCFslks7nCNK-yGP2TKul8RnolnuaLw20Who1aDPM46Q&oe=6AB52BFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OC1VP5eFEn4Q7kNvwFvTCvG&_nc_oc=AdpiSjHo4g3MHYrULB0qOPnaIYoI73iXHir1XQWtnqq1EcqPcH35owUUbz9o1dhL5as&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZlPx2eosQc4sEDU6xHEyux1XvHpGeSe6H_SwNGBT0NA&oe=6AB54173"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owyzbcgZ7RwQ7kNvwEBAPn4&_nc_oc=Ado-rwfwDgIjUvOXXdkuANHNyPD9ns56YeDab7oIrLbTb9HZdIjrTmLpztqmZcknFEc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIv0sywB6GRKGDNh-rL8T4PHS_d9akJpZQ9hvuWi9l6ig&oe=6AB53F72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Bz5AjutPRoQ7kNvwE4y305&_nc_oc=AdpmmK3_sdStMT1Zj7vTrQgP0OgBQhCofXrcdv4wTUuc2YqkhQ46jewdF0kuPwx21XY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtDphlS3g45RU0CekIV4OUbOrT1KswubQygB2YLfGiuQ&oe=6AB536D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64QFoZWFot4Q7kNvwE_uVDN&_nc_oc=Adrf1PVoRLoXz1kiOEZdBWRvL4YqSRj9m0QkdbWj1Hr4Jq-RYGupKU0leIqM9TageJU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWOroJ8faXZPpHjKLOAsZhIxNGDK7WcpKFA9OpWimXrg&oe=6AB532EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5LPpcwPvA8Q7kNvwEN9tkv&_nc_oc=AdoOlzc0ZwJydQYEPSZg16YVshN1fat4J6KWHAYCb1oqjtVW-LK9uKtEfix_423JzXE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJaiTCGQgLYrBOfGF4qSsyfZIi_CNreVyBdyXCvVHjyg&oe=6AB53EA2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJ4CTmh_lnsQ7kNvwE18xTq&_nc_oc=AdqnXA6oIVZl266xMrQ1Rmi0MQPapzhBpVvGksRHfktvmExCN49bsK3D4HglBXKiuo4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGk0P3HVwsr47_vyHy7ONI904nAB2-DQQimUjCM5TA0mQ&oe=6A8C2626"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6DafNHLA0EQ7kNvwGfIva5&_nc_oc=Ado9Fa3_M768YzeywqROcPhG_Hf6Fg8CzPDUIyCVL3FQ5teCKDpHlqWbBOsZUSwNibI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1ThUzTLJ56D2f_-8rRoqt5UXw5XhX4E_9-XgKd8A4zw&oe=6A8C1B72"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6c1p9Er8ngQ7kNvwHHH6iF&_nc_oc=Adq3pdpKQVL28hJBqzUAVFh0LPzSpzVn_x9p74BUQhremIsA0Nag_qoblkh6w9FNxbU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCijrFfFlYum07xPFfv6prgwDAPg-K1nW8qh9LoE7AUA&oe=6A8C153B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwL6aJejfqwQ7kNvwHE0YyV&_nc_oc=AdoxOwrh8Lsu1iW_HQAXxgcfUfxj_lagJRQ7DqPjp_Gij6-0fG7Bptr7owKNmkneSN4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBS1J_8zEJpEDVeIpAe6-O2RN7mPPZwve3oRXRaYuM8w&oe=6A8C2AB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0p5VBr5kc_YQ7kNvwFnarEM&_nc_oc=Adp8lWzWoZ559C-ap6rYaqWLQo5feRuF9LaNelygpxTiDwmi0LYSnTP7RtK15xkFv5k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEA0RalqtyTUMfgY4VCiAG8istLavpm3sH8g0NBR-HIEg&oe=6A8C28B2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjPON14CnA8Q7kNvwG5urVM&_nc_oc=AdrWfX09xG-5kKAQWVmYLgks9OEqIoU6Z_BepeuIgEmqHGquJqzxqGFm7cnnjvFCd6k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZLlakojCb18-uu9ie2yPpFcdmRDujJVzItF42B6IPkw&oe=6A8C2013"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MA5jcB9wNqcQ7kNvwEUQuEH&_nc_oc=AdqBbV5pQirO_Rh0ScHXDJvgS8_exHOCT9V9_3uCZOXVI_OqYMcv-lful-C6FcguwaA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTZntcIVNN0oUrKnTrc0qIO_NeYvH7s1Tc4eE-SOSxdQ&oe=6A8C1C2F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mV3ZqFt81S8Q7kNvwGn4BWo&_nc_oc=AdoHuzedFfPdYH7X-DIVfAsd9W_IDStqKkrUawDbP0eQRkZE8NcZ1bvSKdfgQeM80Hk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJDfLORuMKnjdHGj-saqciq_WXM8J4LoV7AZCZzudWyA&oe=6A8C27E2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
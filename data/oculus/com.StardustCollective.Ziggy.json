://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0U7Sof_VE0Q7kNvwEgcvij&_nc_oc=AdrcWqLuRCbqaJPTSmC2X1Lz3m1rTzc0MbFg6KN7c1P1KT48P0GZqPVofihTCY0BrpM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREDZSEX5pB6-BFVkNMaiIBxXVqcM5z1m3U7w4EIownig&oe=6AF33366"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJS_ASHPjFsQ7kNvwEJOzoD&_nc_oc=AdrHMzNdg60FgSYG4fMWQyWygSXC9VporSz9jvxb4zkI4oFlGXvTWUiZvjj-MZFxH_c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMa-4eVo44gHviIirzLT5FPNIBbL0Ppxh788EvdD3V_g&oe=6AF328B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_KlbG2wGJYQ7kNvwETtMbw&_nc_oc=AdqGuLJh6iSlsprAEOVqy3NPmVXzvX8iEejoln3iR2jyPl7CVBOLAlu-8yJu-Sb1UOY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlmo930eoSqygHXfVFkr6bKGcXyhsObRAc5ElfU66Taw&oe=6AF3227B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HDihKH6bNgQ7kNvwG1N9Cg&_nc_oc=Adpb6ooLiNWQQ9FUbd1wvE9w6GIkfpoqYLSzfaLWpIf0gYDSn-PWUBMXNRPM-Ocp1qI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRd-ahFmf3OOP_s1t1-dAYJIqmHkci0No0lchvLMkak0A&oe=6AF337F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCjrm6EmlYMQ7kNvwH3ZHCf&_nc_oc=AdrqswU8LZT9ArdV8TSoDC3fRD0SwUP3uIor4CPPmrzBvoEEecjjZWzwpd6thH2urRM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_PjQB-kSB1DXZjQLiEBu_av9FLU1bQ7MxRz2kujg-eA&oe=6AF335F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6l3s8qGznYsQ7kNvwGTlGNS&_nc_oc=Adq7jaABWzTnG02qLBTbq8Cr7CiXyjEdfCOTMM8Ovr6SbWkDp5nZu8UWf1-ajz_NThQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ68hX4N3MSN-J0TDBl1E9W7Gu_n3exnuMpzrHAEEYw4g&oe=6AF32D53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JG_Z2SdHtEYQ7kNvwEX9V5_&_nc_oc=AdpGg7a5EqnIw6b_ZidmkSo3PIolvNoAdjP6ewxRLBmjMktHdfBYltED0BQ900fJ9m8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3QWlZVcGxYo08yvAAonrl9FVX39HGeuelgHMgfKY5sA&oe=6AF3296F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ynx5Y3XbMOcQ7kNvwGYxVnS&_nc_oc=AdoAMUn9Ofz6RPfR6jFgoTSRwnCaWUuX3a5mHT2lA73CzL2A61fP36tV3xQv_4ENyUM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYPnTbK89eaBbwhWwvtlWxpSvRNfew5ANU8aM8mQ02vw&oe=6AF33522"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2bq1_T4aLsQ7kNvwHHFren&_nc_oc=Adq39WzuMvQlspCmGl5Ta8qWDSGNniEY_wpvlKl-IaJNF9ZV7cV-aRCpCHNJRPKyHWU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTkHv6Kzgrx5yZrj2qvWTZWgyfaGORllzV4AGSVUc-0g&oe=6AAAB0E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlpytenryFYQ7kNvwHND3Iu&_nc_oc=AdrsWIfmJcoZGfoUizsHf252QzTBSxYPV8vG7yFuGpj2AGmfgtTyz5Y-gfNeBThTzRI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLE3aQ8UMRTBeeEdSDheqxEiWeVfut2M9RGxjUAX-Njgw&oe=6AAAA632"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h42lcGFXunAQ7kNvwFkbsnu&_nc_oc=Ado8QI__j5klNZ-9aNyu3xPCkUe0XI5d0YHJ1Dscf_tvmEI65hrbJdTdsDO9Fo--BrA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaveOTTLI2JhCIRS2zVQX-5MTzW5MfD66Gy1I0JnmrSQ&oe=6AAA9FFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjKyU_FZXsAQ7kNvwFkkb2u&_nc_oc=Adquocts3BmfpdlvniZ_4fevK3IsgPyWSgWfIf0YwAYDmP0CJWvkWof3_F07GmAUlho&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFKjUHzVEpUcUTzqXMQVDK5J1J1BoIl89--cD4ojXFxg&oe=6AAAB573"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIBYjbJ0woQQ7kNvwHLXC8t&_nc_oc=Adqers87bA0Y_BzDzz4ROY2aq6dM5ZIJ5f0pkBDkq1Amjerofje1semuiA8FDCCOqMk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKK2s8uRbP5BMmA-CHbg_NStS4Kic2fA7XLkZsFqyj1Tg&oe=6AAAB372"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vh5oSu_VwN8Q7kNvwH68lYV&_nc_oc=Adrj8Tbt9m-uSxK4MLpBT4Po2v2nHGWHMetlG04y6pHshQAgwx-OohigCULh5l1foc0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzsW2y1zdH5JrCHujwWx0rZUNw4O1pe2pD-eNLaOhC_A&oe=6AAAAAD3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zn0CwGbL3pAQ7kNvwEbxU5e&_nc_oc=Adowwx6tUVprC0QVZSBRpN1xOKABW3uaOehCH944D8gCjeIellKoaQRmha7XbxwdTHA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKq6eQc_CQITe-H0QUrMjFgOrEwUXtoQf8WokXc-5c28Q&oe=6AAAA6EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKJJqBo3pnIQ7kNvwF-J1bG&_nc_oc=AdogfBaX7bWTqJQDuY2vlAzAYJAbP8qizMFzmGQwPJ4ngYadf_1dFqGIZeO0A6ELsWE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKU0KNHx1eWjH5h9-46raQuVSlta1uDYKMyQxb3KYqURw&oe=6AAAB2A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXLvW6JooG4Q7kNvwHWiwLa&_nc_oc=Ado2fc-AQfik4iG45V7PhSFOYh31OW2EZLBNXkjP34OWaHEgNPY1188p-ealYJnGATk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jcpC0dU5svm_uPUKVmJ9cI5dbNN1h3c7DKR17Gxs5FQ&oe=6A107166"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W53Jj2SLPP0Q7kNvwEBhErC&_nc_oc=AdpuDBkMP-ro-qrgc32CJ7JEpzxwJZTpdO2bwe4NhVnZouoERtDOeFJY2HEo9Ohl-9E&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eSUrtkETHjSWMxkQn1gjyG76h3NCqKySHP6qv6dUHNQ&oe=6A1066B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltRqM3gP_1QQ7kNvwEN7voW&_nc_oc=AdrMEU57M7QMLKmtsk-czn8BKgO6-oq-fsSFIx0FvHDmFRRuVn8RcGNMvi1sOOiMarA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qdWRiHmFJ6cHmF7LgOz0nAMBZyNq8c-U7PbF_QcX57Q&oe=6A10607B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZzsu_04UpAQ7kNvwEZumJU&_nc_oc=AdqQ4IKwtdkOG11OZCM3YdS91DVLyBYT13zadzraNmXb1DhnSXbvh_d9fjVSUZaYUBo&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5x5J-noE5XY9MqdZGvO8bEbAq3z9kkTSMWwaX1NZJUtQ&oe=6A1075F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJVzxP2iZksQ7kNvwFm3-WQ&_nc_oc=AdrlP9I-M1BmDKBMmOZsNuWX7GDDyx-DdKRZQq4B9Y1tiwjfdSSumTJAtGx78Wfvuwo&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bDJBEjHQJOfnyKV5f6RRsO92MCRlPCtcHf3Kj6BzR1g&oe=6A1073F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5XIMSFryhMQ7kNvwEv_WTO&_nc_oc=AdqcykFGoEFVSK5PBj_LUdw4giMvZ5uqRnEEjD0MdnMglz2T06b0qPDBVi0SyzkNukk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wNS4nHLqtbmxwghbMykKEGd5LspYHj9xpJ8F0z5oSgw&oe=6A106B53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKd1ruGzH6IQ7kNvwETa6vb&_nc_oc=Adp7MW4AfKTuDpkIJmWaVtJgPhddKfZeFYCu-TuvkWtmKXT_3yXMCbDThAjb1Z26qcU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pCxm-qaWSY-UYNdOTctICw6kQVmKjD5pNS41DctmBZA&oe=6A10676F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SH4KcdVL2hoQ7kNvwHVx5GW&_nc_oc=Adpovq8YlLW_2vrSgJkvJIXK9FmDRK9hw2_oXx08u-dZ3feJbRNNJ8NF0UJYya7bV_E&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_bQcSn65VINFrrJ4QgeykheaiLPTUMPHvoYD4qPBkiA&oe=6A107322"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
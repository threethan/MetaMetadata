://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pGKQpLtv5kQ7kNvwGmiv3q&_nc_oc=Adp2igtrqsOFhpnVZA_faYoBu6mfHHy0arHFMk_heXSH3ZrybAMmfqh6w_cwXc-gQM4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pP2PcVmiNHZ0omQ1lV-z49TGtF1dASpXyYogo7Uz4Yg&oe=6A2C20E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rVhsS9XBjYQ7kNvwG0Wkba&_nc_oc=AdpU-COisoh-W9seH1qWoWaabk3--3xCKstge5DTibl2NiILCSf4KJ5mh4qIezY28Zo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LJftSccSQTb_JB0Tb6Hf0P7f908a6whi95K5k2fQh8Q&oe=6A2C1632"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dmQqObgZdgQ7kNvwHy_qB6&_nc_oc=AdoHQtkhn_oMWEtvHh0F0ZlASHlF0AfXKE2OqDlsDX5cujg2vlvuYZaAwgifDoxXl8Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_92i8w_o-4oc8_c6ehlkFk31DEILqK9ufOdwxNMdecEA&oe=6A2C0FFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9DAoOL1NUcQ7kNvwFj1koH&_nc_oc=AdrwJ3PjfoQP3q8enwOgzzfSGjmermqOgWvtOsBV5U9KP8LYg66BruVGPIIHDGKRGZQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8D7sF56yii7C_9U8--crEQBQtgGpw_e5Py8Z-hpamQeA&oe=6A2C2573"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8aXx5dMMt8Q7kNvwGDZM8W&_nc_oc=AdqSduONBgYfGWktTyHn_iMqgNeYfqENrVB3GmyjaCySIv9Ewukwq9v56P308CxA3VM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DW6pET_GJiZ2z-Hq6NC8IsvDUNa-i6A6mVzhzr2O8AA&oe=6A2C2372"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4JapuD10mBcQ7kNvwGJ3A55&_nc_oc=Adqa_cpVrtwbN97zn4xydgvVVYZ8oZ-iIG2ob0lmjQSaMhrdjsGnOJaSWbjt2oQN0Yo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pGVtSJt5YNFdGwiyp20trXlMqaqb0uuBwhCALo5n8bg&oe=6A2C1AD3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5HR2LicKj8Q7kNvwHcC_na&_nc_oc=AdrULQGexnUWt8mcFLMLV8rQhq4leHSM4Wkfi_eZ3ZEP4cXj_NCXr5SRS5jOzC8YfwU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XsnhSOiJkZilzDKUBSl_8xp5iSjwBJCfDTbVIFTon4Q&oe=6A2C16EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7p-GokOIksQ7kNvwE_X85M&_nc_oc=AdqJWJi7Bh4N6178vmI5nmqCgcUxIcKFPe5EOqBFrTcDFtkHShrZqzGpbvt4rg4_Xng&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9f0YmZEolzpNQ34CaUbIVa6i-RphD4djeur2_9uX5SFA&oe=6A2C22A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
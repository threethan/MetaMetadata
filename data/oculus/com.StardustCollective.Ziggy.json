://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4FTdF5-QdcQ7kNvwEbuirr&_nc_oc=AdpQXvrQZ_VJY1vVNTI8zrdb0vlsxQLLaRMx-SNcDtCaquJmKIvHg7vK3TOgndcw_yo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJJ5eZQ6sY3MtUW67YAXyr7K46azgKbmK5GA-QmoDYvg&oe=6A7EF726"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-eaHAvEGSAQ7kNvwH1bCFO&_nc_oc=AdpXVbnvNMVbhv9tfGSGcvY2m6LSxgEfnLBuOcR3odLzeYErRNxGPtC9zHzsaJdVM-A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGY8zD8t2F3rn36HWwWilSH0hOf9_coLkOkHrfdsdBxRQ&oe=6A7EEC72"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqOPdOXhQWYQ7kNvwEn04xQ&_nc_oc=Adqc9YenS11Pk7a3olRoNXNiu5rXE-Cv24htnq-Cy-xW1l3WJyniZSLLRtEEIFcKRNs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPprcx0GkVOKESROH49KoOUJ7vUfutd2MZ6uIhWZvOLQ&oe=6A7F1E7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjdJFNYL4Z8Q7kNvwEMCjrm&_nc_oc=AdpKzQ_gIOtPSSkjJ32klkoiHrESdFJBzuosX687wIZg7h_MM3hJFj1Wibqis2-cSJY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJOZM-09-mi-Zx16dwGdFkz2clN0iqUP0pdQ09MVFQXA&oe=6A7EFBB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIkh6lAR_8EQ7kNvwGYVWtI&_nc_oc=AdpwmTUvxoF6VRkxC7DCS3bnA8tKadB4WMCIopYiL8Tq74jA5smFOtskmFAk9Z4OS2c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZWG8hpTTxwOuziXMzrKHcdnKLbjkQWwv1qggVlhrRWg&oe=6A7EF9B2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNKNH4Da8aAQ7kNvwHJlYNX&_nc_oc=AdoMNIba9PQTiWC0x8yDCb5c1JdihOL047VmjtXuPxnZoTLwkpKfJDrG8kvdO20BKlk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkzIRnVPqOgbdimVtZ4N2lIvEAJerq1Fvq69rnv6NTow&oe=6A7EF113"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvoqOyrCTeQQ7kNvwEaG_jg&_nc_oc=Ado9KIFG9o7gmfzEC1m9xXu3jHgVOXXqE6kDeasn-2SZUh6znW2DtM2w2VbKAx1HGaY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0pkCCjiLFbBW0BXiRRsJPMkpvyHjMbfRHTlJt767l5w&oe=6A7EED2F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PgYSrfLGWrYQ7kNvwHFbK7x&_nc_oc=AdoE-b8nLzXAzDs_9R-I-c3jRtNqNeZUTi534jqeog1vko-awpA8PdbEG3Qrbo33zYg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG81RwX9GFGAWYfPGe5MREh2613jTRVf69azWtd9sJJHg&oe=6A7EF8E2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
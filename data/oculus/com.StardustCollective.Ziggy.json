://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5ETmaQ_3ioQ7kNvwFcfETm&_nc_oc=AdpgOR1FP5ucyC6HIUimodS0AN_jiYNnfFQdJicKCgqDC9IwiBbeRi3S_WE1ypQWlW8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0s50HMj39PBH13PQI8gDHWbkHFaNaLFsMhvZZda0CpLg&oe=69DCCEA6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMSVfP8B1hEQ7kNvwHv5joX&_nc_oc=AdrLNPzBscyaBTwzN63VOyw3I7LLKkyoi1-vaxkUkQDbaiiSenoqlHN-KyuwN_Pnxz4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nXcnrXyM75opPnfJuIx9UFQQMz_A_t1HvP6Lp3yIAeg&oe=69DCFC32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x603PcS01vQQ7kNvwHb5mSr&_nc_oc=AdrcCz6t6vPuYRxHQzwfQAlZ603-pPbbg9ZAJlsZJJcJE13xg4W0ppasQgKpQMaE_eA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KfRTipANapQsDV6AlVytDU0bDOu5hr-SEKWtJYkWToA&oe=69DCF5FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JqVnoZ9E-4Q7kNvwHQO79R&_nc_oc=Adp5KFTRQFSCfPpXJPnADkUu-lTXmHO_dV3OXc4Yhf7z3ccUJB5H-7fEPThzB0qe2ac&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ePkqgjC3j9VY0d_1MtrUeP0JviaZ_GMt3_hSH2HliXQ&oe=69DCD333"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qB8XbHtEG3kQ7kNvwEie7rn&_nc_oc=AdreVnK76Fhvl1UwHqK1ztBPpiGVOi3o_c2ZCYJ6suSeasrzgJ6maN0z7JVqbZd-X04&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zd6qoRWcljQ000QBOThhrZ9zcwjs5ijqP8UpNhBNv4A&oe=69DCD132"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GFNrtHzvG4Q7kNvwHb4ZFB&_nc_oc=AdoB0iR7sFMYVoD60TPQ9Fi_4dbcvWDxNQConMJGHDXb5vC48XvpYjt6jAhb1l5FUag&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QBchTGbriZp8Ic26kTQ63lhEPGY3CS4kpv3OjKjze5w&oe=69DD00D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAFy-LNghNsQ7kNvwEeeJjA&_nc_oc=AdrlojR8LweY5EnbS2S9xmCwfqEOEf6bfmx5GnPbCyhn06lqe_ORjxnzhF0JGNw9XtY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1P9MjKH4-0CHx0jVeurfRNE4D3jXo6qOeyH_FTut9YXQ&oe=69DCFCEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHCqXcF_MX8Q7kNvwHzAefW&_nc_oc=AdqjrM0ApGL8otuxy6pOG61kzebX82agIvInwnRVulzuUcBERlGCsvjHyabdpRZFzB0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MsVqLxPAbZ3LSXCu8TlDrx1UOk4zYR-R_RiOTwUBb9A&oe=69DCD062"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
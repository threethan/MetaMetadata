5_2778603811108028476_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvj8C_PdBJwQ7kNvwGoQwQv&_nc_oc=AdrfFTLmxjhd4w6UmtrhAGelzsyTlTCHPHRQRLtNTeLVb3qrKUkarHPka7xSIBMBqus&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aF7xu-JlLzN5jqiw5DBKvWYOPro3iBAZDDbV54UkVdA&oe=6A1450A1"}, {"file_name": "HighresScreenshot00040.png", "id": "807733037419699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984472_807733040753032_763200239777074167_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Te0oXXyq0X8Q7kNvwGQ1dX1&_nc_oc=AdrPOsd5zaagT9F3onILjq7IBC--Xj0Nqq1xbZmAfObu0unXDZVy-es0STHnxQqHuhE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nSKMsd0-4Gjuu3qqjzZeQzQeiwBtjJy2VfGsjt8p9Xw&oe=6A1473B8"}, {"file_name": "HighresScreenshot00146.png", "id": "163970600033098", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566678_163970603366431_5435931785999963108_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98tYzjcTTc0Q7kNvwF3q1eu&_nc_oc=AdroC7CpVtFJFlvAE9GILItlrzUAFU1Vfidw4e5vR5avU9-JdhQa9QMFNmv7HryXLEY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VEk14quI0-KfQG85Z3ceOSmLL_caH-65mE6aIcP2Spg&oe=6A143FF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t283innD3PUQ7kNvwGeqE0u&_nc_oc=AdokUYH-02QKepjlpfrXzyIPhV2Kv1VsDD2nOyRMVQvkGhL0E_e6dmEF5IvBRPgfas8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lVWONZtiWxCQ1m2_Izg-ZMpBGELkpY_7FnWVpXr2-kQ&oe=6A146872"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "1324311035174797", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984472_1324311038508130_2610
://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmgI3qXplFMQ7kNvwEOWj5V&_nc_oc=AdqAV_AwFR3jQC70xIuQYVuSPYa_r55y8Pi_ttdQ767PYPfOE6ssrjgLEm71I4ykoNw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69EcmhbwCXvUtcvdXGSHjBg74H7SByqoJ_FK_G8X3OyA&oe=6A0B2B66"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUkxOmZakgEQ7kNvwGtfbvN&_nc_oc=AdqvFHSLnecLeR28TPOMvdDqOq7x_HC0Q8yr9xGZpRZlWzKn7ByFu6kONRO6LiWonZw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af778z4BcO1em67aj-wLlVd0kN0JVzkBeIyQPQexVjYUjw&oe=6A0B20B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97A4tKsZON4Q7kNvwFrX0al&_nc_oc=AdrSv21XHoSnHpMro8dq0ACWczb48ToiIj_jFqPVGyjAVN2OFEcKCM0MKYYsJnCWMpM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tOqFcd72ao9WQXF-Mj--36_Btl3SeX6ORte3y4PLCaQ&oe=6A0B1A7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5RJfNOtIecQ7kNvwEkiAnn&_nc_oc=AdqKPTfie71hpnH1v5AMaZOWugmewUyB6B8_YT_bomUmH-KQJUZjzv8-DfEZ9s4DxOY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zU8QkP9KtHMzBXU-Rp-X3jsU-fgyrQxFWHVoD6pfMow&oe=6A0B2FF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBQSW-Fii8IQ7kNvwHzULqf&_nc_oc=Ado1GZXfdEheLcjtREbFOzpz7SnZV5KDPcF9Aj4LqBjezgGeh52UJKlo2pv31mexvAU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wQ-e99LCrRFm0B6rPXMdPO8DpzWXbgfPffk9ArXmVjg&oe=6A0B2DF2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLrq8rjasxMQ7kNvwFhVQ21&_nc_oc=AdpBLgQ7_fDZl2NVWqvh9yqRQ4z_z0siTAKivzaijH2iyZdnYzgjJ9TTEp9hiCQw9ok&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NndQdfjFBc-MfSriZX0uIKq5G-yEiFWfsHTfVY8PGGA&oe=6A0B2553"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3Yb2B3dwRIQ7kNvwE7XMJp&_nc_oc=Adr7SK32Jy-loUB7gQOWLsblDVWpvRtRBBmd-qBXp0O5IEJIDedeiIQa2yPCghPxovg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XQ52WJiRCMvkuvwVegLxTnfpTZAJ5kjOgogA7p9Vq_w&oe=6A0B216F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wNLK4PjmdQQ7kNvwGQpDsj&_nc_oc=AdoNVQsBo8r3W6XqKamNdoaXA2i5TqO5ReElvi1GvxttNoOu3h9_fisKNPs3g4MJNO0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7o_cHLzAfh0LxI7wKn43VhaLYQuwRLG7ziPoebYkIDVw&oe=6A0B2D22"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
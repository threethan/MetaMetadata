://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLpeA4FXlbwQ7kNvwE0gC8g&_nc_oc=Adr_LBw3lrllc4hrga0FLIft_lghOA9KbCpEkCNYIQYgwOvfQ2qXh7Kk7uniQjiH4MA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vwho3kfNVEkztMDOVnuIou88mocfmaOVpjQNI4CEhZA&oe=6A3BF2E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXQlVHXg3pMQ7kNvwHMaeAF&_nc_oc=AdoqUin9u9TQedFIqPJkwvRO7C9X8zG-VZ-He91v23J6krvmo7Yn9RpZjFuhfjfk9sA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9w3RXJaOlRFn8aJJdwHyUPVAlvsBEY7d1gD88OVziMsg&oe=6A3BE832"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGJ7BDYZp0sQ7kNvwGx_jwV&_nc_oc=AdqGl-0yVlqj08eVHZbkrSEC97lSdjFD7pCFWEvNYTjAaCnhoGGeUNwyunvQ8oc8K9I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iKtHYoxZ_hDBaaVe8X7kEfXeZhXdvK9VCQA4qlZm9Tg&oe=6A3BE1FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnNoqoAx-7YQ7kNvwHZbbeq&_nc_oc=AdrP1oLihcA9Tb-5KS3d8VfduJV2hWXD9fYAto3G_QDIhlTdkttwIZJpuviSbHHosL0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vlej7A74k-WA2RLx-_7ljNdNLg3meMLp-zTEjo-u1vQ&oe=6A3BF773"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qE61PpJq1F8Q7kNvwEE5imJ&_nc_oc=AdpfVde-lrXZ0-ROWEd-huj-Xq536v08m9aqzKjuEFO-ddwh_Uqgwl8reBO5nM8umXM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RAj91d_-hcyZ9PlUDw6lzYtnmR7iz0zfsOhU_Q9LeZw&oe=6A3BF572"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxcdWN0G72AQ7kNvwGqo2QH&_nc_oc=AdoYreV6_ObTDbsBJqkPqZn8kFLCOFXPAcEIfA77vHqjFZ6ZxJH4MVHnuVelKba-wNY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lL6q9WR8Kjp8qA1zxqELYxUdnVnq9Ajx9Fu6PzM4ceQ&oe=6A3BECD3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccBTfcSQY-UQ7kNvwGWk6BS&_nc_oc=Adp_BCIEUpASbEuEJ2z-fQQn0b_jBHVmXjnA50MSrT-pMNhXrMglNflSHeibvXOMP-0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__M1reYRB2xWEb1c8fVxA2PjCk9xIesCNA4mDbcy4fFg&oe=6A3BE8EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIse-byTlP8Q7kNvwGS99us&_nc_oc=AdrHEzo-QdsLE44xc_iIzNj0D348ecobV6c1qXySRR96EpxuMSm5af5uBCqjHz8GFuQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-l4PQcGzUIk3_J9kPYd523IBVreCO2P6XAUx3nigk28w&oe=6A3BF4A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
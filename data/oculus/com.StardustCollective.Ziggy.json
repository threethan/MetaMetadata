://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVj1mysARScQ7kNvwEk0F8C&_nc_oc=AdrKu9DaiOXbXPxJQcQHTCOFBb8GdD7S8qT-dE52TKUvgun8G8paWfDospGQvoIaG2s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af08aj9Ye7xCtRRzt0TWGfCSed6tTHpg4JgFby9v1vZ6eA&oe=69F4C1E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3DjPSAbjyoQ7kNvwEkF7Sg&_nc_oc=AdqEzr5NgfmEJagT0CG_RO0SYWDD3gYQQCQ55t3Q_W1e05UNshMwj-qD_Lv6ManFOgY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af21g_e5KP6c_f1xNDJi4RjGjCzzICoOMcGvvD8CsdtiQQ&oe=69F4B732"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdMd3XnUPV8Q7kNvwFBfFJD&_nc_oc=Ado_Z6Hl-dv9BQkg-aJ-HpBFps772p7hMpflEcgmX9gfxfGp0fhLJbREcjy1idql5E0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2IW3ARKlyW2Il9crxFoUOlqFNR5CVBIXqlLz6hJANOqw&oe=69F4B0FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtnUw1QxGhoQ7kNvwEv35l4&_nc_oc=AdqXLRmo9TKBnTHJUTKgmiiK485RfbhayBhXzQZTmJx8UGBKDHXRjyabBO9TeIJxVEs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af18k5qHhOO7M-UV1ImCVsNOeHEfL-Fvavzp01FSk0xP2A&oe=69F4C673"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mONezTx0q1AQ7kNvwGOXK3Q&_nc_oc=AdrR_v_UULVM6P-QpKhbP1EfIyhnH-UZkIKF9eCjqAX-aSkok3JChANP-pLidTKM-c8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2E9MtLa1DQ9934zxKAjR4itdfjMBVEbsmo_NFHuCowyA&oe=69F4C472"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypVzJ0yF3TUQ7kNvwEItb_i&_nc_oc=Adof8nDDbfcqcT1-fcg6xeS3IA3bukLzEOlcRlfBZshyE9MnET0-QlKngaViBYN96U4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ISZkc93iPXNO7iF79aEiq0wRsgWWoLFn9n9hUp_26jQ&oe=69F4BBD3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbQmRbQVmLEQ7kNvwGd2odf&_nc_oc=Ado0eSi2zYEOrd1MUUybaBQGsaAh4eoErEfbMl4EVW_DNpHGsUeRi2N8ksOKf5NX9f4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1_uHfaUoV6hd2cuuyVjnJ-Gp6nXN9z3jye4dyw4rchSA&oe=69F4B7EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vmOu23LbvoQ7kNvwEiVuWJ&_nc_oc=Adpa7T9vtIErJ8jl1i2_usWo44y5jSDwuleixztTnehJuNNZVgjdpZk3hcvsBHKkSTY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2RU9GQ77dg6PnwqnCC1rF_h_swnrKrUxapOQ2_p2aOUA&oe=69F4C3A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
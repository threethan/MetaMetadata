://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3gRtY9kfikQ7kNvwE6h0IM&_nc_oc=AdpYR-iQxGwdGrlXuceQviXd0hpXMxlhNzWIsqz220q7NjgKwA7CEZmQpRqAlve5-5Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Vlf9jOYmXpIqoVqkODd9bbskvJKXGsD3SMb9PbwOHtg&oe=6A4138E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgsaSTgQ7J8Q7kNvwGmGHC6&_nc_oc=Adp-RCFAB1pT_i3DrlLQlYHfmndeHxBb3PL8w1tqxsASXRGRpgLtyFJCvKAlTVfD_wY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XjiplU6XAScv_RiteyWLWRRlKbS6ZyZOTbSbMW0hxaw&oe=6A412E32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsTHZLD91WsQ7kNvwGcXoBa&_nc_oc=Adqy9l_wHT3olXlEwXvspMn1lletUGNKNvVZvFI5wLSnutdD3ZeF4xH0rOe0qBs9Rt4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xQb8P94Pg745utZ5pOD0qmNa2X26tunFG1g6V4Oc1Jw&oe=6A4127FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBa_65XLf48Q7kNvwFxb8Kh&_nc_oc=Adqd-3zIbkfvumAAXBNGER2-DoH8nQpHe6s9eYr9G9Zhi58fUDB4s0xVn9D6giJ-8MI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ESucIAYUcSOScMnAQtklwn9T7U8FrobIpOdYJBcPM3Q&oe=6A413D73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uiwz-RCH6jkQ7kNvwHJKYe_&_nc_oc=Ado0r_C18J7He26L7aEOdYcsZXsAgawvdjjCL88YtMkL-g4LD6RQ1_6RQNH-kssFNug&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9U0Du1XAlgDgkk_Z7wYNLi7FYdSyjMCATcW6NYOib-A&oe=6A413B72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2y76QMd0v8kQ7kNvwEI3Iyp&_nc_oc=AdqUKvgb5UvmpWlNDU7KDuKFp7c6tt_fOkRb29j90Ql1__WjDCSdw2xR6EsNH1iMX90&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90dYYwfmD9AajUEGDjeIWZepAXxIChToX467MYbehajQ&oe=6A4132D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWP600GDStMQ7kNvwHwd18X&_nc_oc=AdoZJYXCZsloBYctif50SC_KPK5sat8YhT5fyzGjb_WDcvAWIVjZqNeN3fGX3kVtPvw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-x4n1cgSSgSo5lDqCHPevhX8A-WU0WqfH6E5-jKUnYmw&oe=6A412EEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PyLqn44s-EEQ7kNvwFQr1dm&_nc_oc=AdoJ_KH4J9tnZyC8BDWFB7gxin0E6KSr9t7jY94ihCUjszNTqC8mfyLDbwQKJeFU8M4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_12KxQcvpd0NbrDqTGgNHPqtBnQjVEloc1_g0sPOJTqA&oe=6A413AA2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
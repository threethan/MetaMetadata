://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-2TLpIiFrcQ7kNvwHXuMfT&_nc_oc=AdpYjkJUjLO8ESOEwuvgfPdmjdZ1l_1_bNqVt916G4k0cndeIhMT3km6UFxEM7o2dek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oZzSZ953oqWP1biJTReG78NycjExd2cXnUPkUaKTzew&oe=69E8AC26"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUCpy1wfw-kQ7kNvwHOGO54&_nc_oc=AdqZKPdNAEzXhGDBCdCaIFar33e6mFONt4ubmZZAejc3GgGA4gsVYCkmdVxPnhkPQQ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ESIW9TDJ836btOEpueY9X98t6O3mrRc5UpBe0xUj3NQ&oe=69E8D9B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIYStPQ8ixsQ7kNvwG7bG6J&_nc_oc=AdoaH9xXk902pRA9JRMHDulfWaZ3vrnLeSGduwSXrABeZYynR4TVCKi7Uuo5mKxEiUk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pt4bl4e_oQn7_y4h38j9iFt9-_CjTYFFZkeeejPagTA&oe=69E8D37B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mT4C10reXMYQ7kNvwGBaGRs&_nc_oc=Ado_Y_KmnupCBxIWCinjN07hOezZBvJTnRI3qSj5T8mzCUivQ57-d1ACrJv0fG1d4bo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38Bm1LIiNlfu4PUZjmiQ3hg3SXXm20I8uhfAlg5jvDgQ&oe=69E8B0B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RaxToFlIqWoQ7kNvwGyai-6&_nc_oc=AdrySVZJdxUyF5S4kJwVnf-LgqeFvy5Gr7DGBGrKia6_j8PwV2MiWuXPfd_I-OwbdWk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1miJc5wZx0wbz4mZjcjHRv_IFB3gdw55NGQRlrNp4afQ&oe=69E8AEB2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYaiU7AEa3IQ7kNvwE9pmLL&_nc_oc=AdqVK19K_-0tCHE5084emeqXZopDRozuA4OPbVoSkc4TIkV5qmRjcUHUR3tGfQ0M_m0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cCbjIlBhxDz8E_gphtjNHnEkfyooEGnLw5F1_EqgJHA&oe=69E8DE53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4LqY5YjWT4Q7kNvwGgMvnB&_nc_oc=Adonacg2O3FeHFKZu8jeqPqC-R52nByk5kIR3Jv9AELTvBDHB2lk1PA7Y8BmqeaUg0s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16zg1HU8yfvFw_Fg3PYdTN_492dOEWKdqlwRUURkXHHA&oe=69E8DA6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skFsZVQNVT8Q7kNvwHXAHqA&_nc_oc=AdpW_1dPGMEmgnBWoZm-pWGgMJRGRzFqHxsGei_Im7yzyBFzEuj65iGtNj4MrbDXWCs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kzEetW_oGL_HfOUwyXT3NNU4omL339jGx-EbX99TeIQ&oe=69E8ADE2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
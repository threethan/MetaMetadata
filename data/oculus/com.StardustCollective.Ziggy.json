://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7F_0nK18joQ7kNvwH6mLfX&_nc_oc=AdpozfgT682Hx-A5FtmBc5VolHZBuvh9fABZmD2YyvDR6gryNmZNNbdgKEMkn7KAe8g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3A6eKVNnYvDpxHEZJNrFuSJUJaKPBzUdvYPLG4JX_tMg&oe=69D63726"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6-t3IkG9hoQ7kNvwHAk6lh&_nc_oc=AdpUOps0Mbq_bzSLm37jkIqh0qi-ISoE4pj8c3GmTnN9rJvN320vvsaaD3rOJRjL5_E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1A5lvuFeUrTou2dqxWdikSMHMmxRcp_vWPHn1RR61ILg&oe=69D664B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3HBvv2D3a4Q7kNvwFawHVh&_nc_oc=Adqfng0blG1ns3EzbRphAuMeqj-Ik1YhJixTeZ03cGqoE0gmd5n6UC9VBEPvFF8MC-8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Mu3benMqcB64t5v74hYHvpQsb7x_rDml-g6CPuWQCJA&oe=69D65E7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFqcwGcADLsQ7kNvwHoacAb&_nc_oc=AdqcXz5zQVp0G-L4A92f9VA266ZRDbJAnhtNU-zigXP-XD7LpOBGKXxopU2mfos4HFI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZeltHIje7_GH7kyvDW_opgFV--VmGv9zASuhCO4GccQ&oe=69D63BB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHi1zblhaKUQ7kNvwE8ZSfQ&_nc_oc=AdrHXJzCjm0XAXIwz_niowKUtJexYnT6tkiXIE0Vb4hbQfQpvhe2YXKswzP9xbfhiSA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24UKBrpRjAfRnqNPtTjqwaqfhNa1IL3ULEC31ubWEQxw&oe=69D639B2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRryL-BPXYMQ7kNvwGxLQiZ&_nc_oc=Adq409jPYWjO2JWbEH9T-eQNGmIAlXHwVy3hb3_QmkjjM28u4rd2mQrNgG8fjPqG_7U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PpByaKGo9Uoz_8nScF0PoYYLJix9aQHp5WxPhPk1lHA&oe=69D66953"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i94FGfosZZ4Q7kNvwGch1mN&_nc_oc=AdqUq1i41grKOscl4ONKJeDx1K-7BX6XW3g1dPj6hvNmxBIt2DCFYH4SgQ4OA8Z5mnM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oGKY_JaG8kGK2SV7iCtImFy15lZ0fL6ah_jwwfwD2mg&oe=69D6656F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8U7dpu5Dg8Q7kNvwGP7Ohw&_nc_oc=Adq-BnvuchMiXYI7T8Pqe4pBgC7JAQr31IPGRSmDfylGv6qVm0Mov3SFTujg97pV5QI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mhqQv4I-VMiXNPvg1xjmOxZln04W8A6ODVwrwagIKaQ&oe=69D638E2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
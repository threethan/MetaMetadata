://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MH_Wc5FS1OcQ7kNvwGn0rii&_nc_oc=Adow-yRwtYo2A3HKnV0GFwXkr2aLm-t2XXhbdIvJOOg-_lD-Gm4pGIhK_aBZf0DigYQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uS14BqI0pTBjBKHazE3t049d4QZpuVWT9THGuuyjeag&oe=6A185A66"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvOgAVDdLuwQ7kNvwF7EoQr&_nc_oc=Adqu6SyXfOk5E0gu8o3-ddVeCLxY_TuW0Z3Da4Y3FGhrjQ4rPzDpCCo431qaNBLMPow&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6raC9aG4EO1HfL02Tnd6v0SykmPwamulmvd1MebBZAsw&oe=6A184FB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7pkTNiWU54Q7kNvwHnHcK3&_nc_oc=AdqgTGzf1H6kpSIlzR59Zl4iO9tz0c9KzXTdstDTeWbtDIlhxW9G1Apg2VCIPlXTbgQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uzJeOjuZqUmSbTGdoZ52jwWQ41Pu5n6KnHtuh0jYbGQ&oe=6A18497B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rOgulmSyRQQ7kNvwGb4fvz&_nc_oc=AdrSqdc2DmYyWlxsaChG52V3AEXx9zOQ6et4IFamSulhwpXs0t3FfhHjrb_JOxr02os&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Pgw2zunYAZSZph5s2s_E8hRhWZn8nhm-41-4W9gu1Iw&oe=6A185EF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=019DTDpec3AQ7kNvwFQ8p9P&_nc_oc=AdrIK5UjvA4h_uuu6qNssuOv5p9WU-8AaJO4MqbPZFY4RO43mneoK21rjdfH8c5EYPs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_aQZz6yx1IvevJmdzrt_6CLJ68fsoODx1ZEhkwgra9w&oe=6A185CF2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4Xvd6uoSsEQ7kNvwGKNJmV&_nc_oc=AdpcL1TXFkb0_gF6o_FDpWHDd7INaQji6lBbbsAi7nSB0yztjrM3Bp44g9vmyX3ALao&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wuw09RZUBeymD8GnMrIQ7z_D3DaQbEktKQ6QPBoZ4tw&oe=6A185453"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-2wpzAEzfcQ7kNvwF_YV5E&_nc_oc=AdrVhuDhbIDwsH-NHcG5TVFHp97w0_0KR2c4EYpRNhHxQcyO9xbyE1DR8oN8-GZ8T9s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KvvegjJfpqWf57QyYRbZcmvTkwTtrm_VwG2DUfWxmrg&oe=6A18506F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZj5tkmUprYQ7kNvwFVrXP-&_nc_oc=AdqFVVdonK5D48CnSRx1ksIIVesZytbRowQCTY1Zl86gty9gRhibDYIZeOPeIJS37lI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6r11yBIwT3NvE8VqRce9UPRDsJ8-0gZ78KDALwtIkmUg&oe=6A185C22"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
-25/38974500_800214781605120_8880468551637015930_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxPE2rY_MRoQ7kNvwF7qVi_&_nc_oc=Adnck5JtbI1qx9KcRNGGkoBRUKEVjzMHgwuu3pEj0Yi0Tn6hgUU3vhvDfAoZdG1GPcw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftnxRIcYMFEkB73Z7_qRRIRHpZnhQEWcmSruf3z4djKNg&oe=699DACEC"}]}, "id": "1005005773748906", "locale": "en_US", "screenshots": [{"file_name": "HighresScreenshot00011.png", "id": "1326199667974786", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035386_1326199671308119_4397089309417940909_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzJqRMOo1sYQ7kNvwFI01H_&_nc_oc=AdkjeHAo0XclPScrUj3Q2rXaM-1U8Gum5Mi9SDlAJzesknuknmKayhQG7tZ5EvR9zfk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuFNIUFgYcrS3CFCrEquCd0j07oOu7ze3_0tGrD9wRW8A&oe=699DA65E"}, {"file_name": "HighresScreenshot00028.png", "id": "2412721535575051", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974577_2412721538908384_6467288184304840049_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eef6D4EjPBQQ7kNvwGIm1gF&_nc_oc=Adlhyzw7olAtUhWsAKXnGVFDlqRe8xPG5sainDLMTamZVzq7_ZoiqXxljqlAb-RTYKo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvUHq5-a3X0uE5fO7OoZmw3QCAngg_p0D7xMYlsfmDzqw&oe=699DB6CF"}, {"file_name": "HighresScreenshot00014.png", "id": "997351624641332", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982456_997351627974665_2778603811108028476_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bflFh2Mmr8sQ7kNvwFaeKiZ&_nc_oc=AdmGamrCGki43NC0DzNzD9kEoDOtCAdcFA4AlQu_iUo-Hl2iNuHEc0P-dwF1vdtjSKo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftAb29Dh5CyIJY4ZCH8OqKTEjkaadPvMhLgpyj4J2MBVQ&oe=699DA9A1"}, {"file_name": "HighresScreenshot00040.png", "id": "807733037419699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984472_807733040753032_763200239777074167_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Evpv0UShgXYQ7kNvwGLK7Ro&_nc_oc=AdmRBlLXZVvaf84sQck4bDLEK4I8g84cUqwNuCoW230Ln8u_1YX4VQuMZfoacwkFRgg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftxpZLHFXW0_cJlirRHTT1T2auYzrvLMk4SI8Gjo4kwfA&oe=699D9478"}, {"file_name": "HighresScreenshot00146.png", "id": "163970600033098", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566678_163970603366431_5435931785999963108_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itW7mJm_wDcQ7kNvwG4fTt5&_nc_oc=AdkjTR8dbyjDogSDurwsccXkG4GxieO3bGgTZ1AUdfumWnw5iMwqVSCRmpPdFGp8-2k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsiTqCzbsHA8dMSfQ7j4kjX8QRF3FuexTXJJ8MsjY_lWQ&oe=699D98F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6SBMLMqEqsQ7kNvwHSgYC-&_nc_oc=AdlaJJ16SQRi1rif01CWLcTaaBtInSOfCNnxVLX18VmfIxT2Yks7nbPH8gbDBf-lR_8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftdnSH-Zxw2dyBkekXronSLkXWnVB0rHLWgyBbWc1jCbQ&oe=699D8932"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "1324311035174797", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984472_1324311038508130_2610060411856834928_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_RNerigqeOkQ7kNvwEU0KMq&_nc_oc=AdnRs1X2Ln9X7zw5IkuM3P7bxOjlQ22SlNrd0XQe_i02vuY14jFHBuMpl4wm2-ZlOgo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvC3afgYG_4q7o9J0oZfQVTUrE63pALvN_7KEbLChPhcg&oe=699D81F8"}, {"file_name": "CoverImage_Portrait.png", "id": "1021944422558335", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031612_1021944425891668_3460677483354056217_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dFthXXWhpwQ7kNvwHI8x6m&_nc_oc=AdngQW2n-6Ecb-rtb5z81Uv2z2oIts_CutuZJoO6uu4Av0jg6YSJXXnljbwFN22MlHQ&_nc_zt=3&_n
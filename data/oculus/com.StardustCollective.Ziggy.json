://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9a7UaEwRJ8Q7kNvwGf2RLL&_nc_oc=AdrBX-PHkby4W6BE62tYoA73yBDQ5OUbEB_gh1GeQ5eEA9PGIyhOnoHfak0z1bc_ksU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnTtKx2QaZa5OtCEVM8rdXauSQEEpoK5cdf16Aas1Ltw&oe=6A5650E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOzstFeULY4Q7kNvwEHtEnq&_nc_oc=AdrJhkg9JdG-_s-V3wwMVTnA95OtPeNR6qgscm2nM3Gazj6UDrKBWv6znI1OYqvvc2U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCx4Rhi7h0GAjjXkCE23apM4TWyakhTY7S_xj6uFwZT8g&oe=6A564632"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QA0TwLEca7MQ7kNvwFADv-Q&_nc_oc=AdrpRMm__HdqspBExHAiTWdr-Zid97EyvqOf3F6DU4k5fImkqBqWXUVU8ZEUYNExny4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDg2gC-TuqvZpBVbqZTGLyGl-2C4uSCyjD7g8LaGNyC7Q&oe=6A563FFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2l8hGxD7SAQ7kNvwFeIPL7&_nc_oc=Adqu3JQ128-g0XRu8SSMiJ2EuwCwdiEeqZO13ZRPkAhWOe0UbsmjNyQYBETZkxv1FNc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKZdnyPTWUMkp3yx4lp3ygoTERhQOK7ShIq10eK0B3rA&oe=6A565573"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuDxD3zG5cgQ7kNvwEn2RLG&_nc_oc=AdqtW0hex65iOgzKrFmfF7Gx8Z7ZLsY2Fh0SoVPq9vtq6mNLrZLOSm83Ptksi3SBKEI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCccnczAYByD4hJlrGrjkrlFxYr3gaJyLQTjwD4AAa3vA&oe=6A565372"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtProRb2TZ4Q7kNvwEtMTDs&_nc_oc=Ado4QV3QE9k3cIXDtAEjkZxQesZnLZYc9w7kORhjVKH_uuqGbrGs7tar2rywSeUXBw8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_760eyXvyT7CsahDtiJm-x-vmr-Qst8H8b5miu1FgKA&oe=6A564AD3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VpWNp0OQxJUQ7kNvwHpQ9lg&_nc_oc=AdoJCF6rqf7y1MMqQWoUkr6URfzUF3h15ZxEm5e2blrpw7d_vVV-IaJ_qpXiOVmtNq8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5ZkL1UrFD2w3tsm4B1hq7sI-LCNciYcyekvIX3r-RWQ&oe=6A5646EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUI9bLSGKrUQ7kNvwGCBiEi&_nc_oc=Ado0ubhUPf8ZKnvrBfQ5zIiGcBDKYGK1sMOQgOtoWS2mA4fuQfaRFz2REdHbLqHqXg0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAR6TpLgfKXltXUVt-SxtLZaLjgpnd1Ovc0GhptbQRVw&oe=6A5652A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pZ5s_bmfZwQ7kNvwGd_8P9&_nc_oc=Ado2v19wE-yqnjRM1MQeTOjGqTM8jFglDrL1BPonLmIRQDTCCBSWAO8NrFIYweBfnkw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsEKPWSiczk51INzPc3yxmS17eW3vDwxm-IiY7ONzBIw&oe=6A9722A6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64yNypORczAQ7kNvwFLY9x4&_nc_oc=AdoidNEBGPINuXKvmDE1aMdsWi2jAl0cXMbt9PomcNu-Iuzxu6AFQ-bqw9GzptNU_wk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaZEo7lHNXzEUdGcyfZcgfCaZYBkk_FiQKU2pmUpMgsw&oe=6A975032"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AirhR6q1gjwQ7kNvwHqgaDQ&_nc_oc=AdqT5Zrg_TS8C3Zv0r5-O0Uof7bwbPtlNiju0_E7gBldjuv3SUGn1C5YZpoJAN96CqU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFKTRjJEcIXyZkZ9RdpD5Gtp88FybGZOMag8DbXzEdzg&oe=6A9749FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sO5OUW9-DSYQ7kNvwHdfDGN&_nc_oc=AdrnIvtDqIaCowY_ceymqCxL0kBYXuMz3Tzg9uY8nlD5_ZTb6yNpA-v-xn1trS77sAk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF91qbEIz5nVNrh3s6O9ENogF1fDlPAiaU5v3CaxEZvDg&oe=6A972733"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FjWUodtgOkQ7kNvwEEbLcR&_nc_oc=AdpgQbLhH4F_3x35QN3TFij6JkUMmTL-P0Plj3MRVKdCBb2bEWHKizAWSeBLeELioK8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2m-QqQlwDSxlwWkhBrYCoRB31lWCSx4vRonAp0Jt8Cg&oe=6A972532"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6g8S_A7dkUQ7kNvwH3_5EJ&_nc_oc=AdpWvVADlQ5ckkniO2sQt9teRZEy-QtrDnDJmXLxqbLPdplIpau-3NRYKnEHzKPEDSE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhoesrk5C-sbcNFV3lYHWCd8zoAA1fVlrLnDKtrW-WyA&oe=6A971C93"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ea2L5WoFFncQ7kNvwEy_BjI&_nc_oc=AdrXtj2DbdtuWyWdI5AYXLKHT9207Km1BfJFV72_-IgxIIGlr-iG-0LrP4GFfZtAdDo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFk0sNPc-Eq1vNRdKl08rmhcjNqSQRdm7XU_NAsCR_6yg&oe=6A9750EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-Ue7LE8UjwQ7kNvwEfIl3t&_nc_oc=Adqiftc3IZAcC91osxbdyTPV-J-dpl9cwZPJW1Fqk05LnCsi8kRmF7VUmWc8LJEfbnc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETGWNdgZtuJeTlRW-VtU1skoujh15xeY_xNOhMSEU22Q&oe=6A972462"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
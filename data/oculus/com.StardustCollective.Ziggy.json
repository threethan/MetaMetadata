-25/38974500_800214781605120_8880468551637015930_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzpBcI3eyngQ7kNvwH-9K-6&_nc_oc=Adr227ybDewmRkfpjywR-kBN06iqQXKdV617sEp_-sK8Z_gjph1LpYmANgn28FAXzp4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1n-SqT1rAAFeAEofk9q0lIPTh7g5n8XL78Z-YKgKu96A&oe=69F0BB6C"}]}, "id": "1005005773748906", "locale": "en_US", "screenshots": [{"file_name": "HighresScreenshot00011.png", "id": "1326199667974786", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035386_1326199671308119_4397089309417940909_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VREu-spvSwQ7kNvwG2Fcwi&_nc_oc=AdqJermpKV_62D5EI9UNR1nyOSXF8bAjRoTRLS7jo2gB6UPCfxptarG-TjSwMTXXBaI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2gxnuZfH7EFQNW4UgGhJeLILkfUsdxean11CRCZEZjlA&oe=69F0B4DE"}, {"file_name": "HighresScreenshot00028.png", "id": "2412721535575051", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974577_2412721538908384_6467288184304840049_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vN60ZYPEZL0Q7kNvwH2410X&_nc_oc=AdranxCe76jeF3WgKFZ1nG6FcMn5VjvPqQaiu114oJgndlbtfm9rvL9JRvaUlGCb2W8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2v5sT3P7DgCyrOzHjfnet0lxYKYc1aO47_lX_4P6Cn8Q&oe=69F0C54F"}, {"file_name": "HighresScreenshot00014.png", "id": "997351624641332", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982456_997351627974665_2778603811108028476_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOyRQviXyzEQ7kNvwFRhbEt&_nc_oc=Adq7awUzFPxh3BoXyVht1GEJOx9XxhwQKUM_wjJY98Asz84w2y1Fwy6uZ0mD76KMVfA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af24-hnsAVxglMM1z9oySrp1sodm4vGHph9LTYVKg2wU-A&oe=69F0B821"}, {"file_name": "HighresScreenshot00040.png", "id": "807733037419699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984472_807733040753032_763200239777074167_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtp9XVYC8UoQ7kNvwHgu6h7&_nc_oc=AdqWXm2rrsJCk91uwSlDkz0ZsTttvZyRz-8jmmbuktoGpCuYY-mIWVOaSX_jA93DusM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af24iLT0p1oSvJHCOaUIu61YFcq9PVs_WrifudEON_RHkQ&oe=69F0A2F8"}, {"file_name": "HighresScreenshot00146.png", "id": "163970600033098", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566678_163970603366431_5435931785999963108_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYlld8d77QQQ7kNvwGIHzIU&_nc_oc=AdoeLQ52kcZTSTYiVfsaBcnSty8fFilxl2fJQA5ycVWaM_p9Kl8qhSzhk5DsZZzPiyk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3irT1JV2ZuM6lvSaaWtFiEhnCaP4H4HLOhRUPfOg_CKQ&oe=69F0A771"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FilA7R08BfgQ7kNvwHPxXOQ&_nc_oc=Adq9lX1e8zFT0NLGbRw4H-fP6mFCNWgsUKe05X4YC7Hd4p-Fn59hcxlMC6frIHMam5Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2MPLw55y56smnk1UME0cbydpM53NpxtvmGULFHqMYvTQ&oe=69F0CFF2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "1324311035174797", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984472_1324311038508130_2610060411856834928_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prvU0pLUb5EQ7kNvwH-o9L0&_nc_oc=AdpQ6_LgniFkNuQpH6QIxvqCfJK0gBFj8WRJG4_lOH63pg_Jtb6DtvukZ7uPApTYFdY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af18jffgzTdQQVvczn1JYiU_ZX5w9Wmk14byZtb3QyWeDA&oe=69F0C8B8"}, {"file_name": "CoverImage_Portrait.png", "id": "1021944422558335", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031612_1021944425891668_3460677483354056217_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CulsrNX1y8MQ7kNvwF33Ysc&_nc_oc=AdqZI8dpe03jcZWTIsbf3rrRx85XKvQdvkZsWsVOedKTEG05cAB_tNNp8it7pniE2PM&_nc_zt=3&_n
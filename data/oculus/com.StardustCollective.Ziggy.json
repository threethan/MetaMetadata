://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THgIJt5eU8AQ7kNvwE00rdx&_nc_oc=Adp9uU0ipjnv-BzYkbWJrID4QwOz42fe2Jdz1TXMIcGQnGwWUP4njai_mlKbqwFfTv0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPFHOXuaKFTmZW1B_FUetPo0EK0Er4VO2aI-MB_aL43A&oe=69CF9FA6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xPxJB4MvCwQ7kNvwGcKjFq&_nc_oc=AdonkKmOVd19_BCIVXp_YgYoyNt683ZfzD0Kt4SdCe_X6lB27jUJlW6cUkiQ3zyRZFE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzes5TQc6Epz15JEh-RZE4fM-5McII3tghp9ef1yoYU8w&oe=69CFCD32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zwh9cx0BLToQ7kNvwER-q7h&_nc_oc=AdpBIsPYRVKQHajGDLFAMsibN_Ock_JzZulAIT5nDxAhxxy-lQrGkLo0_cTvzTxeDEc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyEJrxNXbXYK0f3DDJP2hsA9PZ_jcRdir2gJlzNVnnCQA&oe=69CFC6FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAytMV6KTccQ7kNvwG0CJP8&_nc_oc=AdrotIk-EK2iwe0mqKM4QyokrRXvFHi5nc06rIL3zb3AB4byqP5ZFplgh_1Sw4rlvD4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYVtor_ziekxQqyMyguQVGlol09cVOuoRg2Iy91n_Gpw&oe=69CFA433"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6QRA3Zb8WAQ7kNvwG9QLgH&_nc_oc=AdqRw0EBwxbZ3XYbq7VJbI_oVsPwf73Z52GBloWfKMwC5TkobSmARLo_PItcv2CsjXo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzmfu-N9tmEaRuP4xiw3t4QDja8Dv7ak_N0c_o9uP9elg&oe=69CFA232"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ah7mB0POWEQQ7kNvwFToCPu&_nc_oc=AdqifLcnvY4netPrPfIG5K3Xiky45fg8TZWwYXMtkWrdjP0ovcMEznPp_NEMJgYQEHA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyuMSYIwwyqk8zqEaLROM-m1bDmEnmYyg4d7NjRd3c9ew&oe=69CFD1D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GiRju4NmD6wQ7kNvwEm6b-C&_nc_oc=AdqlNteJ00Z4nf0XHVMCxj9XxFM7O1iYvNswCXD6cS52REHQAtXILf1iLNzZ_cEm-m4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfykSjeh3uoA2Zm269AGWAf_lo4eIm_3j88uSrXFETpc-g&oe=69CFCDEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krfcRAB55oUQ7kNvwFvurIn&_nc_oc=Adqe4GxWUuhxkGxiOtcXcw4YqOaQxnLggnSqBB7XQPw311kKJ0SrVfXn-1t6pDGKlcA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzqgc8pfgskCWP21dzpRZISPH4f7EVGAiNyEz9vbyj0kg&oe=69CFA162"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
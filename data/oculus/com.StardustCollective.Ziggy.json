297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJIw57yLoUAQ7kNvwG0ebEo&_nc_oc=AdmA5GyL9sChEGhVgCAw5DQsHUSmxXtd6rJjq0VQvm2iYry4R_SNAyqtyuhliDkGGRE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwTnRQ29kImGGfpr7ZjQ8nZ9P5LZUcQnzvSnuZDHak8Iw&oe=69BBD926"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23F4_WpeSZoQ7kNvwH-GezS&_nc_oc=AdnloWD4_HfnUMriPoychBsCPs5Llkxr_7SlCPs3oosuSJ7gNF07Txan86OmYOIZ1Rc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwwKBTL7KrkAYzaNrKFoWDXvoJvTZko8n09L7pEzXV0dw&oe=69BC06B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXTZXMoYIIcQ7kNvwHLtN0t&_nc_oc=AdkQWjjIaEA4k_RQDzXIVPuj5pq22m435b6mBiK6yUMsHbi4O4ufVT7PEp6JNcwBZoY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwuO60J4rfrnQxmC6vsMFr6FHbvcbTiAM189UlslLLqRg&oe=69BC007B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nyNgiSfm-EQ7kNvwEwPWLm&_nc_oc=AdnmV_ZqQx-3kqBAfdvqjYCG2ef5Mgb-yoG4UHrYvleXP1XuTBSjMZdJlMxEym1O_vE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwOS31oU6LBsE92I6u18ngZBoElqsSDdGEYM2rMEV8hkw&oe=69BBDDB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJ54nuhplfcQ7kNvwFHW4Vb&_nc_oc=Adn5W_Cax6dGb0pAQek4_NhtDobAQu9545Bl-1dHm0ZsKA5-YykHk1uLv_KqEZOU7oE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzGSMKrCII9j2MnOGGXK9PsX4LwCnNFLr1Ek3aVJl1wJg&oe=69BBDBB2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyonzzBKVNQQ7kNvwGsjkeX&_nc_oc=AdkNgOksyPY4lSI0o6odVevV5Wf5WUatnnn0QByJX-gz3CcVag74YVkLGvbLOFCs7r4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwHwsoLYBC0vfl8jQSeFWYNfM-hARwKo_gDhzxVceci_Q&oe=69BC0B53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIrWnLo1LYkQ7kNvwF987ad&_nc_oc=AdmKiExMj8QRDjkFoZQvq2EZcYbnMJ1E8ToBYsBOCUAmwjIQfrXudhtap4Ux4X0ISjI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afykik-iEEASlSUn4ts25_1qlE5AOcLZtMY-d2-8b13vQw&oe=69BC076F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8x4udWwTXOMQ7kNvwH9GD0x&_nc_oc=Adk2ZTJn1E9-jYPp1xQ1G3v_3il3554D_zlEuKMHsjsnkNK6ukPPKmD8NzmXaoEZyHU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyGPRPac_z3OhpumTrq001-CHDcl-jpkWSi0hKd9hAQ8A&oe=69BBDAE2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_5218087471640407679_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Zc1J5VHLtoQ7kNvwHSvfen&_nc
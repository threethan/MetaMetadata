://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6MYpYgZ_PYQ7kNvwF-paqj&_nc_oc=AdreYTeYd9Sey35B9zGr-KjscfCTc0Sj5m6FUq4E6ziDi-_WaCc5ohoSG3gZdXLGxBI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JjdX3cU3XVmny802fk9ipdyIKC8VoV9T_ae_n-zSPFQ&oe=6A37FE66"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Q1VE6fHMEYQ7kNvwGYM6XO&_nc_oc=Adq5bwxA3a45T7EB2FQxivUhnYRhsvee_DMsqCgIvGZkVGBmmbVsrH_Nl5UDgOFe1os&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95cWaxiWHnwNni61zPgTDOFVFaBOF2cNYsr388G9KKyA&oe=6A37F3B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivIK6GtFRXkQ7kNvwHU2ZWj&_nc_oc=AdqvPsmLa5i6RBX162QmEjLaJDDU5rYS949C-n1A6PoDnwkRXHS9tXLzWoJ46Em1FSc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cOalk8kxbdeA7qdkTmpfFxXdZY1aioBsP51kCQw6OnA&oe=6A37ED7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cw4weCkEIYAQ7kNvwE5eESH&_nc_oc=Adqop50TMs-YixfDMoidLtsY4TI4yGWNIZjmtLS9Tk_RWMD4ucFZJX4MS4oQ_slWffM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_fVmv5mQ6xcaxsNg2XJMUJwuKh3Vt86OlqWD2cvJRGQ&oe=6A3802F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omdJlpGb0ZAQ7kNvwEWIW-E&_nc_oc=AdoBquPCTXlqJ_7XNgHnzsjHJ19pTl9z6udEeCgvc6sH4iHKfhO1GNeCRRx0m_3e3AQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tV2SH2ZSiWKYx1rILBGl4fVLUkyyfOMZBbTqECCq0Nw&oe=6A3800F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSse-nuZiJ8Q7kNvwH2yBQy&_nc_oc=Adr3sCXXbtdkwLX1RPVPXW6n9dKJ96reCSOfaGn1KPFqmEZGY4JMyov1FbnTJxa_HhE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZjUoYKmE0xpXN5g9TrUyIgjeT4o-FvPFXczr6XFKFUw&oe=6A37F853"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWVpz5KxhXYQ7kNvwHzHNqt&_nc_oc=AdrXo8gMFbf2vWjfZMNmgjKTEYVkHxmn16aiXSA1-QaZ0OpgFYa-FkXnhnkM1JQ2aI4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BIIAMVz9HZMAPJE7ZR5a2jbbHBDznfqGr2YeIDmBJZQ&oe=6A37F46F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uW13wfkkKicQ7kNvwHESC6y&_nc_oc=AdqPOF1aWIch88jlXnuTefMBKTxtHz7q038OmlBfpR_hyBBJskM7CwL2CBWAUHAVZwg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QSpCRAbRWMwL-c-5zE7_Ig4XsnMa1pLQaJu8KkAG2Qw&oe=6A380022"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmeJFASf0bIQ7kNvwGjPng-&_nc_oc=AdqlwxYnRi7mcvD6vxQYdCWbCbt-DzhxoASO_MIhG1vfcqyqQ6ODp6dVkqKqVDoqLP4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQN93SHTZd81aUUDUECtnfmrHB0E0MDlA0Ah5u0bkK0Dg&oe=6AEF3EE6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QKuUG9UDu0Q7kNvwERe2vc&_nc_oc=AdqG6bZv2RW2LvJ9rXKZ60xcO9gEu7L6NXsDpGHCYAw825K7gM94aM2zRJfimaTtfPw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSCDOEX01R0qFcsiNedBY25yknWOjdA7GJBqKM2z_HVg&oe=6AEF3432"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=758FGbHUOlQQ7kNvwFql0mf&_nc_oc=Adqd6krFDWiXK9OfG2h99aUgkuZ4zJzGox7PtFnCYkxwBYY8iKK1lvVz06kczzLLaSo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRICbNeZnZFhAlTRhIsSS3-X5TF2QK7qI2swLMtrKQug&oe=6AEF663B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlBhCq83ruEQ7kNvwFuPArd&_nc_oc=AdrJ22U8CUYfnh4pv81qRNP5J1JLYvvVqO4PmJvz7wj3vGTlE0_hi3vx2_tzYS-89io&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPpTf7-ey7TSa1U8gKXrwgQcUN2HBhU3lDv2j9hY8wsw&oe=6AEF4373"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLlG4-r5OBMQ7kNvwEpp1e_&_nc_oc=AdqpOiLMO-pnl_CjpzKgxMLydTtS8_Nn1QzMad4_wtJGtPGZ_696gTIdlBM3ZBWLfOk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdBHnlf_WHY_xVdN8MgXy7ZtXNRIWw3FZDwHtFWxzWHw&oe=6AEF4172"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaOpp-NxpuIQ7kNvwFLGJvI&_nc_oc=AdpRBHJiLfdW2GxjANANbcHqm0_KbLeb5Q7xqjPSU-VGj08n8mscDJCzzzZwNg3Cv_o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuZSUBjcNw2vNUUl2ezDmdYTGY0aqZue_CRrbWBTlMDg&oe=6AEF38D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yAAvHtwUfkQ7kNvwHjjSGG&_nc_oc=AdrscbuPlJ4eqWlS0wi6QCie5FR73_SPEpfGNZ4VuKHe9ybIAvgnAWfaBs4x5ChhOwk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSObZS8dChNLlhN5abpdCbpk5p5kmYyhdGRFZm1-3Jgeg&oe=6AEF34EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIhZLsJJPQAQ7kNvwG5JjZy&_nc_oc=AdoDQOHo5JQJDnbdYbtnwFYkWFJzznhPQ58f3DpW5H0Es-AFtd9TLXgtlm3zCwmW8kY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf78Y8t3flFFn3zKzAAoQXccU8OsiVpbhAxdW5t16piw&oe=6AEF40A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
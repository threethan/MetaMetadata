://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aev0XDausoUQ7kNvwHmVsXM&_nc_oc=Adr-_HqIHZc0nzxzbYYameucVLQeC0RaPfHyS-feClWBPMCvOTzkQqPZBZqigufnzVQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQ22p-w1mP4aL1TTXOESfbehXO0fZc7oJr7M-xeMyALA&oe=6A6B68E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcZU7R9xGCwQ7kNvwH6by5N&_nc_oc=AdrJ0IWyB0kZccS1ipMQNbnudMEKZjNUBf_pIwdyJVEZ1iXt0H75VvOiKcJ1Xpk-Ylk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCe8RVGeXZ0teMEiGDabshPgJBgNA0XFFX-ctEhNqRgIA&oe=6A6B5E32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fmUOWhZsw8Q7kNvwFSpMNI&_nc_oc=AdqXoNhlI0HZjIlhCwQ1uonn6XFylBC1XzcA60hpyTlN5CUuC0_Nz__sQk1gJxIcKIE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3OiMdSsAvVVjF60bcIMd3QQP-0jGi-T9RBr1-1yjX3Q&oe=6A6B57FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBLG1go4CRQQ7kNvwEDalMk&_nc_oc=AdpWYia-sRXKO0lEhw9RXejvrzGhaIFPUfKij4OKtJzFEJrpCqZgRJoqejGUSH4jj-k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2BO3MD10kqnvLx9YxbcG--VB0y0zKWzh9QG6G7xLqIA&oe=6A6B6D73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ptgfmgjNlcQ7kNvwGAE2Xk&_nc_oc=AdpXbDr2OUoeWKNWWM7TbilqSxvIHkdkzLfDZaPxee3kplU2tkXH8_4qfpBcbqhulRA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwD62UtoC0nezZ69jjapVo5TAiRUbhBqGFM-ZCoenOOQ&oe=6A6B6B72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNNbUBDA_8kQ7kNvwFMdgQ9&_nc_oc=Adrs6FW8P9VmIEBzre3Uac1w5SmM5wr_xgo4OFEMy5Zdftjtcv9S6XP9ImvPwCO62Ao&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPnCvn5M-_8r3l2UgXl4ojsaNmQE0RdUVaF2RW2hy7PA&oe=6A6B62D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYTE6GxdO3QQ7kNvwFkvt0Z&_nc_oc=AdobDWHj66k8Zgl7tVwmdUZH38TkXD7jLHSYm6IL1Rx4HGDaM_ZFbLOaB_4yZrT0wGM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABp_4t8d3Z2PjlTt-_zV2WrmPHd82L1Qr4q7_QmIYNrQ&oe=6A6B5EEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wP-CABP6swQ7kNvwEWw1rH&_nc_oc=AdqANmfIvnr0OnrpzxH7kL7-IqJX3wJJ7uholq67_Jb1knEt4FU7Q0mAKXF4jGP4jxg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuktgI2H4Sd1n6ghyiiw0SNrh3xfj9U6lGZVBcCBAJcA&oe=6A6B6AA2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
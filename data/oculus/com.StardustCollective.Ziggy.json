://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pnuk8L0fWbMQ7kNvwFCqq1I&_nc_oc=AdpjClb2_DBfElWkPuouwrjtC95rJmZ6o-on5iSK9RUZSX4uLBD_ioGZ1HnWWuMi0Fw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rPtfhUQ2JGP_RQC4gQvR-bwNKMN8zxAjW6DncUVtq-A&oe=6A3FE766"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofFsaku1qWMQ7kNvwECKzcf&_nc_oc=AdrpFGNsNdEGCgcMqAGfx4wlo78eqbC8KBl_yqZzSdtRJQ0j_3ozRek8mX4Wgvs69KE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IJ30U2LHDFcDgMZ2pjnu4iFczHjLZx_gD_x4rSZN96g&oe=6A3FDCB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R71rhCxdK6kQ7kNvwGsBXo-&_nc_oc=AdroXUpb1ucQ90dj_BKwn_LrLFpDnDrWU8tmZLDlDNKYeZ5lMLb4rZRpml9Rcb8c0L0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Pf7TeBKhCQufdPQXFcFxFDmC8r2XC5hG82QK8pU59sg&oe=6A3FD67B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBa_65XLf48Q7kNvwFWMZKG&_nc_oc=AdpHRsCAImaVdBbvBjHjtMIoSCPpxUZrsNB9TSzchtr-4YTr-qLyIpHd7STrlyjDnxM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7kXbnvJ6nfw6rRxNn99baArbqD5rEf928dRvIUnwCxw&oe=6A3FEBF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uiwz-RCH6jkQ7kNvwHbPjwV&_nc_oc=AdpkAusjWN-8Qnr0p1jrIlzBPBRwUQBdMw615ekEN5UW4jnVMKz7bgGLLKLP9mkryx0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hCbuReYltWb6QajDX2O5dBI5dSjm-0N_SXHrGaN3xfg&oe=6A3FE9F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6nHq94d9doQ7kNvwGXFkhB&_nc_oc=AdqCeNJWu7vKei2WyI2x46_S8JRvmeNvXB0c1QQyhw-p0uwaoVQ3PasJZhvP9sjKnK8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89lfBRHapWPqhC8Nzg1E7LkSjTK4VIr9u_0jW0cs0TiQ&oe=6A3FE153"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWP600GDStMQ7kNvwFG748S&_nc_oc=AdqucXokAaZlYD8ZziWgwWKhtxe23hDtycNjyQw10N09WFY2tEMzHtvSYP8EWE9MNGI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uySqQcpK3O0qOqFNO6OkzRwQKLE45woPthQzsLnZPSA&oe=6A3FDD6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PyLqn44s-EEQ7kNvwEBire1&_nc_oc=AdqrfsgErEDyl-IJjCn-Qf6gGtBCA5KH5cIveS3n4txeCw_2nEDPab02ZZm0HkYBnJA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WdhhsZNgvKfeovF_AmVXTmhPv4j1ndgEqHYAij3rxCA&oe=6A3FE922"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
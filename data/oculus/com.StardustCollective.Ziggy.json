://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ir62lG6SYAQ7kNvwHG7PTj&_nc_oc=Adrf1FkqHg9MM8pW7zztW1ZJPCkTkLTmvsIaF86T1ML-tkPto8IkCRrvQ57fjIYDZAY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDBknkFBDRGDCH_1Lrr0M2Y0EHlY3lh0h1U9me_oKKqg&oe=6A916C26"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLYK9B3Ym94Q7kNvwHJhb7S&_nc_oc=AdpGo4t2SntpGs9_MS6tnBa_WbIZsG99Faxy1Ex58wfQP9N4_krfMsq-CJPpDCv7M_w&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHugJSpq8XFlZx5H1XSIL8DU7_7McDHgA1avUcO65z2pA&oe=6A916172"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUfZH39-vFQQ7kNvwEPHli0&_nc_oc=AdoyRvw7PqDivILJcbTsp9Par_KNhXDvXBZfzSflELIJhu7a85giKWPuVcri1TLIIG8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9vioT2ppZzwwFqWcixQRLw0gPWhopTH9TDGkvDUb_nA&oe=6A915B3B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqW1np3k-iMQ7kNvwH_5x8E&_nc_oc=Adqsmfx1PRotiVHIh-kx8cnCIPUyAdgiFUGY9GYIkSJ77FPhql6CfB9RwBpT6TRKjqY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPw4qX5Y7MR7OWc-dUR-vkh7KKBqCcAQHWSKptIcyw9A&oe=6A9170B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AT5KqgFOdS0Q7kNvwGdequC&_nc_oc=Adq24ETOJpaspSPuUPt4WIGcq3kYWVa_AQaWsmqOtyPe_aiRHEBDRzpCjolpqJv7EVc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFg6uuSDQSt2pxZ2t3Ad-XiexWvRYyQzGYvzTOm0b1K0A&oe=6A916EB2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTyxa9DexSIQ7kNvwHAeMsC&_nc_oc=Adqe9HvzHEMn0P_g5oHjqt88rjMBYs7M-fO0rbp6AyHFUJfaIfENG7A6nNVWd5twnzk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHEehvVq4PPnjlAfQlqTd9GfvGbKJc5eNlyUFUPGwW5w&oe=6A916613"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vR2hP_tibgQ7kNvwH-Ysgf&_nc_oc=AdqaNFVBebniJ_RdlHw9pHcvD6Am2AKVF9duw5512n9BqW1rEkwfvoLJvBgApjUwUPQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvPzai0lc49zpqWWuXHiDmeLZOqStFl9KVo79uSsgtQA&oe=6A91622F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISjkoO4kJgsQ7kNvwG8Rmy2&_nc_oc=AdpCrNM5BWAw7eOb0cHE5tad9dqEFLlY66m4wA33TQagyXiVLMWKbIGjcH6XHsKB8mA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFE2VB69htYJlq3RArnJEjkgJrN_zPN8k5zAxkMbZlY5A&oe=6A916DE2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
-25/38974500_800214781605120_8880468551637015930_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7pSh-h0fmwQ7kNvwELloJp&_nc_oc=AdlLRwsFCXnQrLpIWU2vF7PKlv_wg-tSn41SFZic_oHPsqTFu8CbXqVlK2uaShm0pfI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsF1iuYtdADpZj0xmUaVylOWfKgO5oZWjgAu8s0HeTu-g&oe=69A6E76C"}]}, "id": "1005005773748906", "locale": "en_US", "screenshots": [{"file_name": "HighresScreenshot00011.png", "id": "1326199667974786", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035386_1326199671308119_4397089309417940909_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvRS6y-c0GMQ7kNvwF-fVZg&_nc_oc=AdlMPKV29kJMYSwF2txXx-lrvOqoRlMNK9iF9m6J2unW8DqVP3RWql4u9E5OU8P8XMw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv9mWdbt1nGtlBtX09YfaR7eOdenHWMPfgabKzE9IuaXg&oe=69A6E0DE"}, {"file_name": "HighresScreenshot00028.png", "id": "2412721535575051", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974577_2412721538908384_6467288184304840049_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUFcdYVsvtQQ7kNvwHTgidL&_nc_oc=AdmSpVDmGejvzubBPFBVVqvSWh1lu4sZ_h_8eucmbeNrcM1Lmku9-MQAA4_xtjhul3I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvLEUZDc18KPDI5tkU9bpg_OPqKv4JqE35s0k4KSUEJNA&oe=69A6F14F"}, {"file_name": "HighresScreenshot00014.png", "id": "997351624641332", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982456_997351627974665_2778603811108028476_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0Z20bs1l-8Q7kNvwHKfgfA&_nc_oc=Admw00d-b00aF_hCsCo1BSdrmLgwsRuf3YEXtPrwD3s7Uvk3ByRlz00WmbDq8stValU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsZFN8f8D_csxt22piv1N_abiLdOYS_YXYMpzdUsSW6eA&oe=69A6E421"}, {"file_name": "HighresScreenshot00040.png", "id": "807733037419699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984472_807733040753032_763200239777074167_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfNnxXJXY-oQ7kNvwH158nJ&_nc_oc=AdnmB4XQjbucsWCnlvBj7pswZvECsm5xg2zxESQLjfZCyw5sBqx7CEGDXIMPLii05aI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuJPSKj8l6zNpuaq7-zV_UD11HQ8DTkLFfMQOzvueVH2w&oe=69A6CEF8"}, {"file_name": "HighresScreenshot00146.png", "id": "163970600033098", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566678_163970603366431_5435931785999963108_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pk6tQQYNYuMQ7kNvwFMBJwZ&_nc_oc=Adk8FIcQ7oPHGuzUrS2VKlv5Pnrlfb8Wjg2pQfuvY7Fo1apx0HNCpIVFZj3-5npisT4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsqZb0htzLroQT6EfiRjchHE8XhbUXFJmS59HVVPLJzQQ&oe=69A6D371"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajUktLZuk0IQ7kNvwGF8KOC&_nc_oc=AdkRX1827L9XigU0tRUwZ6t_Q0uNiiv7NH8HDv5SRQodi6HHhUeSd0-GkcgRtVugsb0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvl6ZTpIzqN5t-uk9Jbm7jkRDCdYpOxv4CW4Vv8-oFsYA&oe=69A6C3B2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "1324311035174797", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984472_1324311038508130_2610060411856834928_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Od9BhgDvdckQ7kNvwEj2S_W&_nc_oc=AdnROpQlku6JJgcBXlXAWqUQmWkI_ocWpM_MRVsrGJBOxa-SexyfHgvpOTs-amS75-E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv-GhMn6-TbQ1hovcsp5ywEtgBpDjEUJUZpT4hmtht2TQ&oe=69A6BC78"}, {"file_name": "CoverImage_Portrait.png", "id": "1021944422558335", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031612_1021944425891668_3460677483354056217_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGBGiqGBJJQQ7kNvwH4lySc&_nc_oc=Adl1QFIsaiD72ioc7ym6dRerduUIuxi0ZIE8hY4rTThAygGdvvfzZ8Zu7SQIn5HL_aA&_nc_zt=3&_n
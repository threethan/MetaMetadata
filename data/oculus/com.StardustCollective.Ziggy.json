://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wjdLf3dzbQQ7kNvwHbP57o&_nc_oc=Adqr4wabwqQlxCJJJG3qTKLD-cCDYCIGv_lKczMeHVLiMIJVUCHOpuhpKwgFaU9X44U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlbtQy1Vmhut8w_fdg-mrg8iPPVQ5U7EqdWdF8NV5IOA&oe=6A7351E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwrnLhGkf7gQ7kNvwGWx2jJ&_nc_oc=AdpnGbnl276Dnw__LXH-ggN7tDA7PIGNYcdJHslsGznsGMlQ42yBDfCHFZbKx7kBm4g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUKjSf0sTW1XrqVZBohc_2JPc_wyzIgMqUOyHwgmQozw&oe=6A734732"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztavDlYQEuUQ7kNvwE39PBt&_nc_oc=Adqp7I8v_RKNi-Me2PDHelPJSQ29Ps0fbBp8UK12fbfaNkTcx3XmEB3-Ajh7jT-IjuM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuwDeP5cENg5As6u5ncWMJEtlpeiFp5k40h-NUD7BbqA&oe=6A7340FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoPpvYN4oYYQ7kNvwF87wUA&_nc_oc=AdrMV2GySx2X0LX3v0J6iV1Gp59J726TIVxTi34BmkCHvHoFio2Xb9boLcAEL6BtJjI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRyd0F-4_E3vwe1SYha5ka9gvv1Nf2an8fxZAouJ6ZxQ&oe=6A731E33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRj2P9TuJBsQ7kNvwEalD9U&_nc_oc=AdpormYoj0Gjot3CaV3AKbm0iRP6j4yBzYLDK5lE0yYFk68Uollp-11M6kfksDIQZGQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJ2rgWUnTFAyOviFxLsD3hdoN2TsKDeQNG4NBJ9-ErBg&oe=6A735472"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwPf9J2saUMQ7kNvwF3w7nm&_nc_oc=AdrR1Azn7SeAXbkP_94687SsheLZIf7I-cZ0qtoYM5upjiLywiVXIgHd9M-e2kgLd24&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHU7JAc5BWf0j4D8WSC_bnoAwzjBEYOJl09JbrXLErOMQ&oe=6A734BD3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fql5EfOXt9cQ7kNvwGlG52I&_nc_oc=Ado1ruPRb_e7YiKDydhTJavJT0eqZbzMPMlzntG8tc3ch2oecDS7rBe87YXBezrbeBM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdLUoFnbirOcVZqjNo5Gk8MW5_ZLOSw6bwHzwG8BQzgQ&oe=6A7347EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKn0jE-MOlgQ7kNvwGia6Xh&_nc_oc=AdpqfUd8naqgxuP4rWfpX1pxl8nAw4cLepb-DzCAMUlcb9xla94DZQg599yeI9BPpkI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGz9DOvSAvajAXYElZbPZXPEY-jsKcIgkjVjfYIUghv_Q&oe=6A7353A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
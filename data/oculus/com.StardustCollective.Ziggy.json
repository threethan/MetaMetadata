://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2jYiXKsxuwQ7kNvwHEehmw&_nc_oc=Adr_VCMkzbTffoKRXL0KLAytCa8HWltd49c0gKh6lFLBKcktIKr85Pnr89hgetLAnRs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2_oe0H2G9P2zMvdbHGefqcGR-Aa_l-9fKD2JV85BFtg&oe=6A4A7366"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZudRNErDo0Q7kNvwGDjA7p&_nc_oc=AdqLxN7CujJ6JSnU-5e2Q75fq3flgMHufoOfi--WJfNm1ediHBc52Fk8CoPVpBGb198&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCzNewL-kVyR9PT8zqkeb0h8USQbW6bdVnSBOlR3D3rA&oe=6A4A68B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7FwsVjIDeQQ7kNvwFRlgwk&_nc_oc=Adq7FPoQBHZMuY5jXS5tLK44o8TYGxIyGJKmJGYpNMlqSywQnBdLtvOn4HEwSLXFie0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQ-_M_HZ0F9qghUB9l6NT1eevyyDe0W7e6H0lp6BOWLQ&oe=6A4A627B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpsKlLm90EsQ7kNvwGhqVxP&_nc_oc=Ado3redz5OylK7M9VcgtcJHE195lJd7lzuf5vIDIXhtI_wdSzADfdWkUmWJIYxnpD8Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCw_yCKmyFY0g_YeeyoguWDzAYeLfMeXXTpxXw1lyVJsw&oe=6A4A77F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1E0TxzoZrwQ7kNvwEev67j&_nc_oc=AdreX_B64JmSrwmDbDMGqxbjonigcuhuOALI3zN07vOiBjX4nQxjARpMVJR-R2USIRM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyk9znjV5_l1cN6pI0y7j8_Y3taIp7BrxuDkZlWXrLuw&oe=6A4A75F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEtS_pKrMhIQ7kNvwF0nWyM&_nc_oc=AdpPUsCfjOyf9q1Y5SZvC0ph7FUsMeFrxoU8HIMhTB3K6iccihIy5AvC_XLfqnr7XF4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGHDxO1wsl3CghIFNIzX3D0yvZXbPNm6VWWrwosQiR4w&oe=6A4A6D53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xcc6MK-n_g8Q7kNvwHLp39y&_nc_oc=AdqcEGvRqLnLsyKDQ_QuAPlg1R7mLt9xerzEbImSC8Ij_wyX1OH01leiGgHW6gQW7H8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBfc99TCTAgXmj6sh2z5FihyFKPpne8SD2KV7Hvdn68A&oe=6A4A696F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChICjic4TT4Q7kNvwHuQ5pm&_nc_oc=AdrViM7KV5iI4ykzUTcP4NJm_E2cTFjiqRzKV2Nf3J36wsQq4VyME035-EZH9p17PBo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD43Efjfz9EkR8vpSwEOpmZQcATeTmZgO8mrGKeuM32pA&oe=6A4A7522"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
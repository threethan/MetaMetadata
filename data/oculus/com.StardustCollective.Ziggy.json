://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uy9rk0aSIN4Q7kNvwG0xd_R&_nc_oc=Adqxw2PYJSewkMMm_gz8o7fPwE2WgOSJhXMF8oWo_hUHxDF4SfwOoTL0-9oxnVU4l1E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqxjE8z4PxOznU7BP-LwC7vAuw2cNZK6wZJowLcQuv9A&oe=6AC3BD66"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=480SsQLejjsQ7kNvwFgTfJT&_nc_oc=AdrsGnsLbVeQIpazS9AqzYgcfKKQ9AkSnooe_OYxQZSj0k0GwJ7qTBNK6kuspiXTEkE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5IdDv8HcwwwOPQWgE-O8Y2OOUKEAbC1WnOIjo71ofIA&oe=6AC3B2B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHkI3CRF8scQ7kNvwEA_2xi&_nc_oc=Adq3H_-Djv312nfTz3pSx0JeNH7P5W1JXfsRoLHnxHQoJ6_q_D6PsS59hPZBZZv_CYA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOT7jHm9IjVSNJo-LoT_e3w2GTpUzaD4_U1hAWxZGh0ug&oe=6AC3AC7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFyFGjRQN9YQ7kNvwGplk7h&_nc_oc=AdrdMjQZb9LiKfOEsKhynmBX9avu1p9RI9iu-GVKal2-t5dHc940CqZOZFokVKNmdB8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2o06_Etsmz9c6DZpe2XWgVw6m54caGzBvJpavGgkPCA&oe=6AC3C1F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDtT8ZW4BEQQ7kNvwFm5jeP&_nc_oc=Ado6Hcqaby_mEv5DGt3DYOfaHoJ_kyVkjN36dOVnvCK-rR829z4o4nsYNXQ-nzUe7Cs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_9iT8VnpXerzrHFPMIsTVOKCW3ZSg96Yu8aIPCiRzJw&oe=6AC3BFF2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GGKZ4RhhrAQ7kNvwH2Ijas&_nc_oc=AdpqzH5AUvB1PhDPcLYRpM_fa5RjyHBmPTBtdV_wAWzXaOp3-o0taA9bu3SoiaONJ64&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUsqNUMnXgjz5XKZCQ-_CUbwjzVBNrP9cPD4xolumT7w&oe=6AC3B753"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WIxuTvjIqcQ7kNvwEZTt0x&_nc_oc=Adr7-qnmL-OpeB1wmSgWZhlErhppUCP4V1JTT5ygR-mqNNA-Uw22hve4OpbCun_I2dU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_W5p-qkTttSK2esIEWCIqqmvvRfNXBbuG_UmJLMF4lw&oe=6AC3B36F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaKGJZYRqR0Q7kNvwFQcwEc&_nc_oc=AdpYsd5GZfdkJ1QdJzMMznykueB-LcdQagAw-WTwQGw1o_2DXGkYOZXRvlzcu7PDi_k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmaMhr0AZ5u034eDpR6oEeFEohTWwA1Ou4hgc3y5xE3A&oe=6AC3BF22"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
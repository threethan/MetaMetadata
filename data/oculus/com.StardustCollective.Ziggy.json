://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6m-Og32apQQ7kNvwEUAhZw&_nc_oc=AdrjIZ4mZkTDXozYl-iLl8vTKgYzI2Q7mCnf0WV8UMtGPdftsF-CRAqnm8tMAHbxL5Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWyuQz3P0el0OOkbc-Ug7vzPLE31W37lK16FuOrqnPaQ&oe=6A4E67E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrFR0YUezFsQ7kNvwGkZt1-&_nc_oc=Adpz75TSbqXrpJD0IwfLvNd4mnBKfX33YVlVkZ6cAHRkMUmbbpf_0WQZJYmR1uU58Hw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClVz-2eUXHFOj2M__-v8R4m8k27s8VSHlA59IfmFxt_A&oe=6A4E5D32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygXe9nLvFrcQ7kNvwH3QB49&_nc_oc=AdrBSpFsPSlk7KG91HjOFZZjQ9NgKbTjFfAbS50dK5xhIfOys8iGShq3lA_mmOUZmWo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQrML4x85FiMuivmvJdLkuAJTQ8XkMjIi4pmOGBRfqMw&oe=6A4E56FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IUuK_tL3ioQ7kNvwFhfHzD&_nc_oc=AdrjivUD6JaPu6LFez_H22cSd4ahbljARGqGLyDojzYmEgrmlNXoVsErPdRSyd8_mKA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZ_8x-dUVCFl-NFl6JyCBaq3EfY1ZxWfkqJfhpJiHY6g&oe=6A4E6C73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWIWgHrl9aoQ7kNvwFRfpzl&_nc_oc=AdpbvSpxDuHGzjVcGIazDtSfS-HKrLar8oSS6EqGNJZFAmPMd9lBP0p79FQy19mcjS4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiaiaZsTjlsULR1S0a9yL6YqHryqIWbPa-AG31CHwnRA&oe=6A4E6A72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xacldVUGVsQ7kNvwEJ3KgT&_nc_oc=Adoaxw1dddFHKUCJHW6i5sNR9eGtoOWchV6dyZG3DI-4oTLjREFAe0vkjQ13wQJniQs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA14Gkh2m7D0SnnTKiA6w1EoY4zYbJ_FiFvjk7gyVkg2w&oe=6A4E61D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUbVCrp9vy4Q7kNvwEHWTpn&_nc_oc=AdqsxUlwh04-yB12vdy-IuxFrqDofsDd31uc0_Jw1_S0ylZHMVe1Bbb1kj3IpJdsZxM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3XJ9RHN67hx7X7NIZz_zwZP9V_eYjiDi_Ci4NUvOtlg&oe=6A4E5DEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hNwqHbDgGYQ7kNvwG4q-n7&_nc_oc=AdpxGBlU184pUgn4fKVwDHlv_ZHD7G13vYJlG-piRt0T-esV83XG9imzOJYpxDo5zUs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoHGLgo97OAtcttHjXG-5mjZTmo961wKtQ1h70tjGpFw&oe=6A4E69A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
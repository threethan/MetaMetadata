://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXLvW6JooG4Q7kNvwE6I3IG&_nc_oc=AdozKvX0s8aZ1jGjRZvngflTa6LNcDYiFz2zD7BDhNp3KZj-8FFJG_QLy4smbNU57ck&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5P3EtJuNtZO-4JhjHrm7QQtxH0omb4i_T-n8s0ciO8Pg&oe=6A0F1FE6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W53Jj2SLPP0Q7kNvwFinUmf&_nc_oc=AdrlBYXXGOmOsb5uhcm8nLxwqXX4ho1tjrjiRI1LOxRChfcQzsW_3Hj_qhX0gWGkBhs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_Hca5WYRE9bF9qTgDTNZqEqlv1rTvcuCVDP4mIO0g-Q&oe=6A0F1532"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltRqM3gP_1QQ7kNvwFjn8RW&_nc_oc=AdoeseMLQAOtkGNP_bihriceNhT1d8j6eUer63JEzxtSROHqo87YZaV1npU4if0FmAM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70rIEYpZEHOTxZHfbIvKmDk27uweyQ-AHTxNh8azNtdg&oe=6A0F0EFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1r0-lQqRr0Q7kNvwEtKD6B&_nc_oc=AdropIX1G30itW3fipYqIz7aRtBRfD8KexfqA6bk-02iP_pBoyjLsgIBLZXhbSL9wGI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5A77ag0bVjbaUQn2A1vwnf-oPjueG9d8kPdpx_BjrAiA&oe=6A0F2473"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3D8cUufkl4wQ7kNvwHUwAVB&_nc_oc=AdpaKTealROxrFKrd8emZYMa705Bx5OlDF10fQ9pcjW72_u1nS6Jri6fa7LMv69u_bI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pxjW6cA_e7k-vxeaP1ricl1qGmaIFN_BXzfuHhZRjng&oe=6A0F2272"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5XIMSFryhMQ7kNvwHX7lef&_nc_oc=AdpSwmdHI5Wd6AbP8l_drqjxWhAYVAor981WmbzY44zoEmLeDOuC8yDdoCXxfzhoEOY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5r9e3nikO-PwHp_gnZiFOw_EmL3L7KyL1WE_iBY7VXpQ&oe=6A0F19D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2f8c-B3JZbcQ7kNvwG6Tk_S&_nc_oc=AdowGUcz4aj8ekZFToUib1R3LjxZPEXQDE2e2IP2IS0Eu-w8hV-Yc6i129inA6k7Muk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NC_5r50YXpNpRMbglf_wKAuVkx8-4piGLbvAqSUKaUg&oe=6A0F15EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SH4KcdVL2hoQ7kNvwFJjkdF&_nc_oc=AdpfvPyu2w24h0yjDQ7sASlqpTooqtHvFedjktEfiIcH7fjB5U2HosFwHhqa5C5GLCU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hGYGMgS4rhE27v1i-2WXzMZTKfVrrOQJsg31TH18hjw&oe=6A0F21A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LopokHCA9KEQ7kNvwFl8dCm&_nc_oc=AdrFzyf8k5dk2tS-2Z8ytM0YMbPrG7ToPU4sNICwv7Qd_prQOk6U7kakRXR7DY4uDEI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBgoW4MxiYCECM85nhMX1J6mgWUe-8aT4cyjVC01FRnA&oe=6AA56AE6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJZOq8aa-2gQ7kNvwFd1RZ4&_nc_oc=AdrejWMsqr3ldIU0MUhpuBIg2JEl-TgLf2kXYXCbEz7KQ0ZXKJOnoS5gCcmb1aEBA90&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQvfCBxlFSdv6Um7ILrPOh2cWj1639GW7E4X4jNgpDtA&oe=6AA56032"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ic0g2C8pDvcQ7kNvwHBMthR&_nc_oc=AdrlI0UeY_6C5iU1lhE8xvwsd6K5db4TrX_Ooen6GWh9Cbnd5awfv-8syNYalCKtBYA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvLqFjzeBww_zyauoN-lIERIzkvyC6c7yv0kP5rYQ7zA&oe=6AA559FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixEY9A5VnxQQ7kNvwEeMwSL&_nc_oc=AdobvypChnhowzV3I2z6QDto4QhIzwLJrCgTldFHijt1Ydai0jXooeJC08ADfVil7r8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLh6W2Vc054cA8i3Jz5jB4N4q-WxzzpHcINmDg7IFldvA&oe=6AA56F73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92MaOnjPJOUQ7kNvwFmlF_8&_nc_oc=AdpVfyR9QcLc_ovWqG8qpMW6XiCWcAGEzwZgTlK29lMIbxt04DCFL1BQg_n2WMZ-3Kc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlKh1ESqt1e-NFrUsiIJT9hk5caw2ecWB1GHUGu0X2hQ&oe=6AA56D72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bliSWWWVDuwQ7kNvwGXX6zd&_nc_oc=AdqulobFjg4Q3J7_bb3DdBHTwGTIY6BRjYCn6mwVbOwo3BwegqW2nYivIUjzJp54N2M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxZaVB1s-C4NIsVGoVGMUd7hEb1BdILmutx4_wU3HF8Q&oe=6AA564D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGyHAQfJb4sQ7kNvwEYIP7e&_nc_oc=AdrUBa-NeuSYUUdjlK9ZG6vJA2QimCU-8pz2LqnXXmkQRihXhiHet_jykaNCCC7NomU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLB77gKOzS8lrcS43PcP7Uhakg9y5wrF9MzGe1qK1nn1A&oe=6AA560EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucW-tXt8GjEQ7kNvwGzmr6O&_nc_oc=Adr2OtZ985oc-YRHglm1sqst9HKqEKV8il-EtzhjgbT0AA9yll0KnZsQq7M5-5ApM8M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISpVH16OXhJOlJuGF9N7jJIV0xTTYxbidj1FnjyhB8BQ&oe=6AA56CA2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
5_2778603811108028476_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2DUeyKhdQAQ7kNvwEkYK16&_nc_oc=AdqmcvFkaIcQfpj_jq39soQVWK6VLsE8vcAUPpJ3Bgs-ya5pVCUhdaOhOSmoZc5B9EQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwX3o_5Nf0S53M9ij0Jm2S2fckLbDKBjB7VyH_j71oSA&oe=6AEB3521"}, {"file_name": "HighresScreenshot00040.png", "id": "807733037419699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984472_807733040753032_763200239777074167_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIi-QlFpR8kQ7kNvwEuesTA&_nc_oc=AdqvM_oIOgDh7YQINmWTvfF26Ltm71288L_sahd8Y9kYEtvkMCWTOhqmtGfxNDmkc2E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYEJqKpf_9F18adzMeEPXxK7hO6_QFqxDiMEhwVHrEeA&oe=6AEB5838"}, {"file_name": "HighresScreenshot00146.png", "id": "163970600033098", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566678_163970603366431_5435931785999963108_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BaicgV7CHQQ7kNvwFy-r2y&_nc_oc=AdrTzEhezQX8z7iwJvfSllvUvU_QjuzSBzzuPzHhwv3fPG2WuuqYHtOQz9n9w6qHSAQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7jlq_LdISOv1eVnlQvvWk5uqeRSnSoT0O2eqGqartBg&oe=6AEB5CB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vntvolyDIcoQ7kNvwE4nJOQ&_nc_oc=AdrhgLtJHPHwJ6X8v2mHBw0ppLOQeGLGP6uQyA6SCS-p_nJRKTiPg5_AtsjzBuw5aig&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_5cYObRBOvacFDh3-2zJwEXNhuygFkpYhU3oUvZLE3A&oe=6AEB4CF2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "1324311035174797", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984472_1324311038508130_2610
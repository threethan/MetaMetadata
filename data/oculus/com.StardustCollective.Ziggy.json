://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEaLofCur9cQ7kNvwEf2GnQ&_nc_oc=AdqeARddWbuzpj-QXaSTDrAvloxS_oijnsJSEq79nr3bkhbVrZJ64W9sbr5GDdS3c0Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOL13a6f8wxgvaFT5oXRFMVqx5OORS0FlbPt6VX70oPgA&oe=6AC11A66"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1OwWld3rtEQ7kNvwFrXTUD&_nc_oc=AdogVtRps2pIE2JU652FisYcevgUsgMn47lGMFHo6Aq1xghQ2fFsYZ5QA9duqun4C4c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxShN9UihkJkXjVwlvNUScP6BT2AFfKh2jjLmc_pd69Q&oe=6AC10FB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGjXVbdGZl8Q7kNvwHmLdBi&_nc_oc=Adrmc2OrYTbuNF4r8BGsPcMblVtBzRg7twaoe8TItuSkG3_B3hzhQCEji1hgex_RZ0g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMysHUWCtyaxWBX2hYQAsdgx_m46nePfn74iowcdzVB2A&oe=6AC1097B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBuCLL5Ko0oQ7kNvwH-HNC_&_nc_oc=Adp3uKhAoC2Deq1X-dJTMdAN2nCU4rmEbDL16QmMYetRJve4KHLIrvX1_Fq98DFsWAg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXSKd8zQhQVtjo16Pf49xxv5SiOF-4b-Jzx3d_ghA55A&oe=6AC11EF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXBi9eK-2D4Q7kNvwFtY5ry&_nc_oc=Adr2jA6cc0tF_YEq-SYsmulTGfyQ2cCzq14BZShx_JKj0P8yiMhlS8fycQflfUnVvGs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpWB4Ir3tH2E5-k0ka_v5Y1ooAnCH7UjLg1OQyZs1XAA&oe=6AC11CF2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8_NmGfeak0Q7kNvwHUcnzr&_nc_oc=Adp2Bdq3G247hS8amVnEd1estbxb_Ribm2iTzrd7sE-rHWMxlki7rJIZB_2lx3IFIok&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvY-2n2UaxVqs1_B-cQzO6_tb8s0LiV4WwERIFRihRfg&oe=6AC11453"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wg2nHFPEhhEQ7kNvwHfKXsN&_nc_oc=AdodfMbiRAxYTg1ApSELXt-SoamEIuHrdCM4Q5dcWs_nCNjhhVnRBVt5QXi1koBYpB0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkBEvO2UaLZeER-teN8h2yG8izcbqbTL2VlZiowKU90w&oe=6AC1106F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaKGJZYRqR0Q7kNvwHBcHo5&_nc_oc=AdqY9wl5WBxTTLo1LOJ7qW42pgX5B__8PyTq4u8H31PbS2FTTGIfqj0B6sbhQIfoVqs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5ppHQ13yQHyiHXIePRNrmNhqJLXgnwSDenJna05bk2Q&oe=6AC11C22"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
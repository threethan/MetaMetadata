://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2K4UalzTCAQ7kNvwFMMUHs&_nc_oc=Adqpg-a9oDMYKKUOOrfdohLZAV7XNA5TLhcd88aw0pMQ5Yx9hUjDzDJmyqxVSIppSQw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgSDvLmETiKFbe5WJgPfLhI1wsaCfT2oa80e9LxoVxLg&oe=6A8AD4A6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6DafNHLA0EQ7kNvwEN717G&_nc_oc=Adq9Hv4e0_Z6pUjSw_qILA_6UXfp7ZSFyZIM-0Xu8Z4AJiovnaslW3AM4PTYXYWR-2g&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCjr4VYRqnbF6v6ZdWUIAtd5zWDlUhAj6jokMYguKRhA&oe=6A8AC9F2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUQYp3VRyRUQ7kNvwGuf5G9&_nc_oc=AdpiFll-BTddbheTpk3GjyW46PffdJJiI8ttk9w_tXvMvaEisQJYGLgUDc4RBwBwSsc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGibZiOf2V29Ka-LHSgwKf1TcXZBhNZuY-nkXabNsuu1g&oe=6A8AC3BB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7C2DbaNeHZEQ7kNvwGiSsgb&_nc_oc=Adq5AAIn006b_PgqJddpLS1VxwqmkDjU7IrYZ7fZmSMf6PTUbBzxhwRJ9MZWb__qlSQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyId4djDATGY5c9VDLTlsqV3FQVoZl8w9ur4gUeg8DuA&oe=6A8AD933"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0p5VBr5kc_YQ7kNvwFHr3uk&_nc_oc=Adqn9o9hi4ql97JVQoAV3iaVR1bTcT04ipji54pDEjsYeLHMl8edvSdCRVezk8UUfxA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRv21V1c59pdZeIJZ-c8TUr-oFjTvBow07sMDu8-0DNg&oe=6A8AD732"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jw8l7UU4FRkQ7kNvwGcqTMu&_nc_oc=AdqMZuBCNUQdCPigeSbgTkiW3tmQnD2iPQg6py-4oA5Wr9eeLvO2hiTgMWGWmAwbJcs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEO9LjIJ6zAfH2e5nX4E9pMTr_t4wsgb3eW5bnEiNeKCg&oe=6A8ACE93"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MA5jcB9wNqcQ7kNvwE3Xjf3&_nc_oc=AdoD6obxE8xInzrbsgnieN1-DyBP-HgO00gJ3S6NsneyixLkwXlogjwRZ43uIGdKoLw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHed0ccfqs6RU64t_dTyRPEM5MjGu3t1Hh7c_lVQRagw&oe=6A8ACAAF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mV3ZqFt81S8Q7kNvwGeeip9&_nc_oc=AdrIwRw74qOTJTeYRc4ax_dfjTDbvVSTKrggfPG_q2rNityG5hfNX6nIQahVpEXmys4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFp7s_ApZ1UbXJrSLI51KJ5qvN7lwuDVN0xFgPlpPgv3g&oe=6A8AD662"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
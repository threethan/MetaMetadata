://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuwqTjU7vTIQ7kNvwEKTEVe&_nc_oc=AdrWSMHpTk0Mlb_7g2c2F3CCea9DK1HRi68yj8OA1b2GGOAxMrIWexgAC9Yipl2dC-k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfysTmcX7teNcOnxa4o0qxmqiPgflBknpAJKsHljNJK0hQ&oe=69C90826"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wpz5Rafh-KwQ7kNvwE75h8Y&_nc_oc=Adq0UkrYCOm1DKBVKzn8cs5PYDmFWy7xWfNDOOynllH216gnfckNs3gcFdDQX1qGRCE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw40s_6vkqec-hX6CTpuoXSkJLliyfAxPYuXL_H2Yqjtw&oe=69C935B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eadb3tPJ6qAQ7kNvwHMkSgi&_nc_oc=Adp9zUYwPnjWHYmE8gygcYybMXjsDBlPnRiiMfmFfrVzjC84rG4bKYEGnvPzwBfDP4w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwdYyX5nJhABseFu8R8vhVrOSlNsoegqxw623HX-VUuGA&oe=69C92F7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okewTs2jiGMQ7kNvwFb1rur&_nc_oc=AdpBMlUnYeKFC6T4_8DR76Lzk60HrkQmFP0l2y6Q35XH_n63CUBG7VyLPezEJ820pjU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8PUGYdrwMDi1rp2QGk5Dhz9MekHfl8hF-HKD2NK27Og&oe=69C90CB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJpZ-dX76vMQ7kNvwGuFTEe&_nc_oc=AdpWaZQ3XzEtA871HOERmW9vb623ZSJ65S25QyG3rPieCphOjbyLrndVBlprdho0ueg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwGCI_Fc4jHhrAtHcu7WuPC-bPBgMJ4P4FVQxRGue-W0w&oe=69C90AB2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSwpXktnSgkQ7kNvwHPWQHZ&_nc_oc=AdrmtTfL71HyRY_TWNzsdJUU2VPfyWVf9mSGzpcDDoOAzLiEBEGQ5XKB2QCwLKyulJQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZGwBWIPY1oInOGMRjv4ISGV-INhHHytsBin1sxKwq2A&oe=69C90213"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqA7lLDF-HUQ7kNvwGQMMgQ&_nc_oc=AdqV9R6jnXvvd_tUD2583nRUjTVembIL22O-mRR09cEDRM_yd362-7iE0Caj9TOGzhU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy9QJ1qGhN6XvEC6az_fo0KVvWf_jTQy-ts7z0hBJiS5g&oe=69C9366F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OkaCxC3BmEoQ7kNvwFPN7HN&_nc_oc=AdojSoyr8YFdfcrbbiywXQFkZDbKYp2DqmSFiCl-X3uBnNpFvkz4wAaDccjxrvLUWPY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUETbokjWNfWJQmJOE76ZJHuA9iXUM6jifdBB7kEDSUg&oe=69C909E2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
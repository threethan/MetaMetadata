-25/38974500_800214781605120_8880468551637015930_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdbNDZwqyIgQ7kNvwEDmI5h&_nc_oc=Adnp23s7TV0UVgEdRNPTMo3x05ppEAQ2vAU7z7-bMPs9FBuTVt24jpEjgsoosyiGhKw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afsi7f79eaQ2xm_wxMSZgMFaVsIe3x33rF-lXg0EH4YLEg&oe=699866EC"}]}, "id": "1005005773748906", "locale": "en_US", "screenshots": [{"file_name": "HighresScreenshot00011.png", "id": "1326199667974786", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035386_1326199671308119_4397089309417940909_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeYcKmS9uZgQ7kNvwFGZM81&_nc_oc=Adl-0Pt5yJXV1mOzFGDLGutwWe_62TaBn9y9caIhhKVRW__WZRC_APjjj_cr9Lojo94&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftzbGdBqz6q_TFzYW5NNB5P2vi5gLsGR68rC4hOiPLaQw&oe=6998605E"}, {"file_name": "HighresScreenshot00028.png", "id": "2412721535575051", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974577_2412721538908384_6467288184304840049_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xKnvECUSiEQ7kNvwHunv2M&_nc_oc=AdnmBA5ZbbVsjiUhK9dQw8JTTr6CWitDBo6RR6bpTkJJhcWnfe3b_bHoS5REQ05qCY4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvPSv3gZXkCzN8oV_wIAaxGxhETtlPdg_FvXuUinJnviQ&oe=699870CF"}, {"file_name": "HighresScreenshot00014.png", "id": "997351624641332", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982456_997351627974665_2778603811108028476_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojUrAV5gnSsQ7kNvwGICcAJ&_nc_oc=Adm78xmSeiDueYJSU4nqNgqEAY9Mf6VWMewKG3QccD34cvT_G4DRWz6SgU--KLs0fhY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afu9FdpXja-i31DKoeevj6nL8N1ybWjzPDBf4AsDhKyOOA&oe=699863A1"}, {"file_name": "HighresScreenshot00040.png", "id": "807733037419699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984472_807733040753032_763200239777074167_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Xp3G7j8DzkQ7kNvwGQt0wO&_nc_oc=AdlDZkGT7Az24cjij9O9zg9HSQkEYKtUdnswDpBah4LQK40Z3e8sMy80kUrLjLXw5pA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aftd3_rUD6aDzddlbhDHFKLaK9dlxe3Frg1kB5YLf3OxGA&oe=69984E78"}, {"file_name": "HighresScreenshot00146.png", "id": "163970600033098", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57566678_163970603366431_5435931785999963108_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNfgCNMIMQMQ7kNvwHrq_yS&_nc_oc=AdlQQGo8imuJP82j1ZlfS-56J1towE-zgIc0mISlYvLP0zYVTkwvq94pkksjGDOtMa0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsNYjtCVw7QpzE6Ra8xGRiZk5fXzxYm9keJ-otNsQJsUg&oe=699852F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLEIEPvpDVoQ7kNvwGW1u8G&_nc_oc=AdlswfUTvTsScH6SbKAs3aG1pLoUYY3iHcn-VxnA18LRLHGkJNa8CADF83HnQKLf4ZQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftcRcdwkvsToUsLaxnUOB6f7_nabDEb4gYdtvS8lcUmNQ&oe=69984332"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "1324311035174797", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984472_1324311038508130_2610060411856834928_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZVDrw7626AQ7kNvwHmxd0A&_nc_oc=AdlilWMfvsxFZfKqtQeec_NsgelXm-G5zd3kI5TFIdJ4Rzbvif2dR7GYMx4dIaLuC40&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuXBfVIdBZVB5n7AWi0SlGCM_4sA3YpJ99qHkWwLO6k3Q&oe=69983BF8"}, {"file_name": "CoverImage_Portrait.png", "id": "1021944422558335", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031612_1021944425891668_3460677483354056217_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pyu0ojg2pEEQ7kNvwH0_Uv7&_nc_oc=Adm0CSZ2i7q1dExpgNMR0YRBWLM6K3jgR4DtP1e9VS4B5CFP3UPjHDGkpkqOcF9rhX0&_nc_zt=3&_n
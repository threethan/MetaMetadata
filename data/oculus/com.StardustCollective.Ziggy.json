://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEaLofCur9cQ7kNvwFqMEMW&_nc_oc=AdoFlYMpBR_6P4vTgWVN85ApPpH_JfvW3AV5PxQCsJENGlDfQBNL1Yh0OgMOj7VLuNk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3RsrtHSmrYm73iwhqwNX1giq0dJD7UbGqfaMwDbXEHA&oe=6AC26BE6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1OwWld3rtEQ7kNvwFlZLj5&_nc_oc=AdpkLGxGkSF79fpt7nFN28OzFTNgUqi0kxyq7QaVpHDVZJWSjorhSqAW94aPpUJmUlQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOwQ3GvfztI4dqN5rc5zXd8zpNslqpFcLglXH2gGNfpg&oe=6AC26132"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGjXVbdGZl8Q7kNvwFsqzOb&_nc_oc=AdpmPsQ4zKLboYwCUoi4pbquFThm8hJz9tCMgCej-A4jVFAovDkhpm1St3kup4w3OgE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJzPlekHs_Ht16tihxXJiN3uedZ4sel4y9ssWRVWWy2w&oe=6AC25AFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFyFGjRQN9YQ7kNvwGiO6Z9&_nc_oc=Adopcb9BLdRxgGJCvQHt9zqVS8w9BYIxUhHej-ZTrtY9MOkE-rvt-pnwiwSz3qx4xo4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMi93xg_jikTIypnw6C4LPUX3Q4X6wtFKC2dxXDg5qIIA&oe=6AC27073"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDtT8ZW4BEQQ7kNvwEfEHSs&_nc_oc=AdpUXLSoP8yA4K4PVb8frwA8_nzB7mbhkcG27hh86By7QFmAYAXDGfCycY6qujQrqFg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3piXoKMPrzW0aP0Pm5gB01zFkGQKpwAUEw6vsrPkFnQ&oe=6AC26E72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8_NmGfeak0Q7kNvwH3GCCW&_nc_oc=Adq37n-r_WrtBaShC_ZL1vswTDs2nr_MoYAbBETWRi8JNJv6sJHUpsh5IV2oOZ7-GD0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgUdCAocLB_5SHsIIhfuzrDD0LXBQbIOnC7A7JnjroZQ&oe=6AC265D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WIxuTvjIqcQ7kNvwG5eIqn&_nc_oc=Adqz29zsQVgHjCsZDDEZeqlzAbY3LVQcPASyrmqsGuKK4VGU-gXG_UkDoqQQdcujivI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPm79GbFuGPECbsNdMFZuq3u7lTk1Xkut95PGrFlH-jQ&oe=6AC261EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaKGJZYRqR0Q7kNvwH9fHEC&_nc_oc=AdpEDeMlmJH15BfgUj51yFjXuVwcQ49RlLQK-97k1HnxDPLWQcBS6k14EyfyYw5hULM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMw4-q8yQVYnUYZ7h6XEOKJXvna2LfGzMucsRIMcVqMkA&oe=6AC26DA2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
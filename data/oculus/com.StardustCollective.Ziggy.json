://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-2TLpIiFrcQ7kNvwEm-VDn&_nc_oc=Adq6Ou2ZvvQenaf09favUfyCzb9uwx9ZWoAnyNFenZBhysENdG5FV3vsSla3onAoSEM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oBGAGCOrwLifizDzKuF9PaSAm4DFZOx0v5aqblfsVgg&oe=69E64166"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUCpy1wfw-kQ7kNvwHVDwxs&_nc_oc=AdohB7KjIJiCtOE_P2ZtKzJpzQrzSIO_YkAimqfmdjIOZuC-tqylJAla2aMH_Au58js&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Tgdu8eRlro-yJaQPBmNYF8n6BjehpU5Iq04qCisgT6g&oe=69E636B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIYStPQ8ixsQ7kNvwHm53mq&_nc_oc=AdqqxWBBHvlmY1FMavOgLnTl7MXT2d6wQVvzrkPnKE2VVGafvJN0lbQUhgvvJ2Bpgy0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05bd50dGpsSeKH91jmqMOG1OVUc5D0tv7D_DcqL7pkZA&oe=69E6307B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ool6VIdopNIQ7kNvwGGCF9O&_nc_oc=AdrNEqcbJuKDDSEf_x6gAItOk3GudNGvPkX9-hlzGY7LK31-79dRlhaOoCKXso0ERhA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1srfyGU3jfJJ9EVFQffWbamAy7iiS-G_M-DNq7DvKgYw&oe=69E645F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jY5aVWUWpZAQ7kNvwH7rZb3&_nc_oc=AdoVJmpchm1kgo5KHxk494rhJmz7xZu6bsHfxXkYRuIXsEg4RbFusZl3p4575Qbk59Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27dXrhP84fo5WY3je7XRghbxW5Y6kSK98UwWwqOwowqA&oe=69E643F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYaiU7AEa3IQ7kNvwHXX-nx&_nc_oc=AdorO7eOe068Abe6ftroWPuBgovO0MSs6ksULl5L1z09JowLq70lEyrLZFWcx5fqjII&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kDzWDhv6hCTluL9kbH_nRMlZByEJ4QB6VzzaKFrN1Ag&oe=69E63B53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0orWX2LN2rwQ7kNvwFHYmgs&_nc_oc=AdphxjpJAX6xG4YPoW9HgczUF2xNXJS1zI6QoI7RtudMLe98vJyhogG1iyf4DEJTdyk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GaAMu1jblS-A9YpIgHoH2XVm3jDB5O-dWnWXfs_2Tig&oe=69E6376F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvQmiNx7pEwQ7kNvwGsmDDI&_nc_oc=Adr17VlRIyoaAAfJcTxo54Vz8VshJ_LfDYBSoL5jnaoS88yzyJWf7RnIva4BWkukE_8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19-dNkvYXPAgLms39BZGDnTxIrwZbvWWM99rqwy7n5JA&oe=69E64322"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
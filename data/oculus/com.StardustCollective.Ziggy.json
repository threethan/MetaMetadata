://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19YxhNzTRZ8Q7kNvwE-U-_j&_nc_oc=AdqbPoJsnCzckJTbq04M8-4UkBCmn2SVVj-wEBGbIBZafTx031VzpcUquYU9cmIHVJU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWUJHHg-xUNbHHU9IGNCT31qN7eF9Jr5u6Viiv0L4wOA&oe=6A64D166"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNwmHGrCs4wQ7kNvwGs03a8&_nc_oc=AdolcOmMThEP1GhheH3ISSKha9wfxgj-RVT5SCI-K0ePkpnH_LdgMqla0GXz7BxihPs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcZrAgNRSaoi7o7BoZWjGXl_cqZbmsKswBGxGkakh5xw&oe=6A64C6B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-50NHvRlU9cQ7kNvwEb136C&_nc_oc=AdoDKjFCTH4EBR6-t1UQAQPmXJh1BR1fZP2QHw5kjt4LkM0QeVIj-nDKoVP9s2CxzHs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB92dKMjLuo2yVwPGN003-aljh2uqq_VsVd7CJikczsCw&oe=6A64C07B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrsqvrxTGgIQ7kNvwEeq2oh&_nc_oc=Adqt735HYF5TB3FkKoKJUBr5wJsawOT7kpgN0iKmtCTtXQS3prwU1kgie2bokYm2ejM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLRF7XWYK41XHdJOb0Sqx1PU6_LhXZxDEIi_0cE4pZAA&oe=6A649DB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1BwaXsFFVcQ7kNvwG3SO-B&_nc_oc=Adp7uMEBTy19Ze9vFvY9FBr-GKbKEPcH-s39fMvdCgWje-PCxDk-diKoVCAigoUIiUo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEZDEkEqtZiJho3gFCUpdXxj-hw6MyT1zGai20Wbs5bg&oe=6A64D3F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llQBKdD8iZgQ7kNvwFh6aGe&_nc_oc=Adoe1pRrixb5Mh0vIF8WmvXjlpyaxHEky_dNy4RHo5RTP4PORyUarvi9Riya-o3wAfg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOJVwmcDUuk4iO9ZqPdjIyh2nSxJGixuLEWV6zBHssIw&oe=6A64CB53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiNAPrXbPD8Q7kNvwELZh35&_nc_oc=AdqVsFDQgDBfx0sul_dz83GHqY9fbDxU9cvKtpjkRomkcaHWkOFO_qmxsszp6tG_mNI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCihhE_Xd-WPb8NraG0Gg_9OcZeYKH4skmzeqVsKTx_tg&oe=6A64C76F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XjDdI3s2hgQ7kNvwHC75Fs&_nc_oc=AdqjvVTQLM_-6eZYA6n7GZ6-Ltwr181v2-bvUZdjFXgW80wXulLfVdFXGDwnc0xfg00&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkbVJeaAJ6GGGwj9eiGHaoJPI3CaqTUtbyGcJjj_WQ2A&oe=6A64D322"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9a7UaEwRJ8Q7kNvwFexJXY&_nc_oc=AdqlmJIT_z0PYP47CLmNRjsyJcVACaYQ-6PBUzSZo2XF3DNxmGVvs6-nNXKkfURfnSE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvitXW7dr_74Hklnr2YwHFpu_xtxV8VqufGE5ZQnrZ6w&oe=6A57A266"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOzstFeULY4Q7kNvwGlpkqa&_nc_oc=Adr4sHetua9nQe7uX4-sjVgAmftRgiTQGaZIzok00X5ria8So_nq8BXkno-76syPJ1k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjaFBtkWuPqewzJF9_F94lHY9vZUkjkhvd6LfHV4A1aA&oe=6A5797B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QA0TwLEca7MQ7kNvwEk4fTx&_nc_oc=Adqr1n-tWID9glGbc9-wZx0isTlPMv2b-ViypGDBDlfFgwFwLE3-HarFcH9FWzEeyxs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDX6U1L8VhrsjD7jfs-83a4D0E4E2UgFz2jTMaD6EDjfA&oe=6A57917B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7GE93-U7rYQ7kNvwF1Rqff&_nc_oc=AdpAudGqHcI0EaYWOibfU05LbXFGqMHpDxLGQkjDpqijr29sVHP78uc4r_D9YnwRTkM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7TCwW-L8gJdE7qJUjXJ_ft0eJChIG7766LBN9Pxi2OQ&oe=6A576EB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfr4UQ5wGzAQ7kNvwEbBByI&_nc_oc=AdoiNMzYyjb0XCS1bSOA6Fp3lUcZ4GfaH36B-YWwhpC43JXRJSmRKFaT6epD0Sb6nUA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2opk79T4U2tirVD9NOT2OVRBS1H9xpGP2jlTzgDlExQ&oe=6A576CB2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtProRb2TZ4Q7kNvwHqWeqm&_nc_oc=Ado_3dHSjwzShQLcGQEe5yvJ-mh4wkacdnEYVKt7G5R3r8smr2NFg_8ZO0Nc20C_w3U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7xX1y1x2N_78UcjwphMJlknoc1QfnCY5nui5az-aISg&oe=6A579C53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4lOp0N0x4AQ7kNvwHdH2-g&_nc_oc=AdoCcPBdmIhfCDkb5xzGbyBKRDmpi0dz0w1DtRu7DkmrMZBjVnY85pqumoF5Bj4D5m8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAurbmBCangcIodzRc-uRa49utvgBFQWfFZ0xU5IHq1zw&oe=6A57986F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUI9bLSGKrUQ7kNvwE3Ildi&_nc_oc=AdqxXxwbTgLc22Wxn4KJlOWFL-DfSNuJwb5Nl2bMlCkGC_BR3pjocMxEct7TnEO6K4M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDYCdGGXuvfDsy6yI7U0fXpGxYtLQn0ceN-3AEFt2GlA&oe=6A576BE2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
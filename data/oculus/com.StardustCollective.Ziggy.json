://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2jYiXKsxuwQ7kNvwFvq8t1&_nc_oc=Adq8-mlP9k_IrkideA_MT2k260qcYZRcAOWhbohl9mnQ8ZtDlU2kMwVU6UvPa6myWIM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDq_b6Y1khW5lKBe03MT4Dhw4Rl3EL7KWfzslCTjQQ18w&oe=6A4921E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZudRNErDo0Q7kNvwFrw0cU&_nc_oc=AdpCY4ixx2QxlVsZXAEz9qJ65tVIqVkYb0oJTwc8o1XsB05vqr3zcfHrp5NyfqRFl9c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCheG7dDzIaIrYP7J78IEFcEPD7aoaOf7TlBGaY-j6xOw&oe=6A491732"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7FwsVjIDeQQ7kNvwG8YRWg&_nc_oc=AdoRddZ-Aoo3ue1-ji09B-QiIGKjmO3hvrMNbyBhXsyzXwe9CrDaus6MHHaAnePmNNU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBE9m4b42NvMfWXJsUR5NHTpmOiQIeP01PcZZbRdlM2DA&oe=6A4910FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpsKlLm90EsQ7kNvwEkMR_q&_nc_oc=AdpYJwN1aq6iZ-AFqxJkT5Ehxz0iIUfBejPnkMNcSCp-xfuQNtQqv5PYb0uf7ft264M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYFeaPRYKqgNbrL9DXz_EfpjC8SbyoH51lPI4ZZa2KKA&oe=6A492673"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1E0TxzoZrwQ7kNvwEVZikD&_nc_oc=AdrhyKZB4MazlwDUiq-cSItJ7SdhA3-me6S2EzECwfe03OZ2R7CChs7E6paIV-xOuKY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTJYPT2R7X8WT9qDt-giGBAs4iy9RQ1zTFkbHKeyXlQA&oe=6A492472"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEtS_pKrMhIQ7kNvwERrivl&_nc_oc=Ado1ANTBTdycDDYyZgL266iUqi6cecNaM3VAgyLJmkzzNftS77aQ2aCfHn6gybDZQ1w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9LVmN_MB-sVArrPH2ny-1X__hYb4vbWdIAeI2CI8MNQ&oe=6A491BD3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xcc6MK-n_g8Q7kNvwGLsApR&_nc_oc=Adrl-LhW4C0V7yijrGTKReX66F3VA4U9gtGaXU3AOMpJesOR48jSCNmIJm8lG_-MQ1s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjrpbEdjGxzE6kZiO3cVzJwrClbXvBMvhTlNsLc04SKg&oe=6A4917EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZ7Zt4a-gnMQ7kNvwEIDPra&_nc_oc=Adp3HKOXbptaXdpSc16AXFbCd09ROk80pGPnIFxNkXbylOIr4rSXsqy0GN6RpeK_D70&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhZPAmN__nYKyT0Ia54fjmoHqwzG55P2Dk3cs0FXGtWg&oe=6A4923A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
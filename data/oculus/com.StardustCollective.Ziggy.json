://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpWhw6GdSOoQ7kNvwHdB1tZ&_nc_oc=Adp5wjX9wr3Stvub7zZyMpjTx5botZbUIp5fODPuwPQYReNpcuHnlQ-i04M5P9V9nqI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7erfl5CY1t1ENYULwRlh6Bf8mh5ODHoIiT9MzVkwUDw&oe=6ACE4966"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-X-FpO0tFegQ7kNvwFaL9cn&_nc_oc=Adr6Yo9H3Orp6A4Q4gtQdS7Caxu2VuB6moN9Rt8gcBIMLsYW5cCVju4_U4o_VwN3gfM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyf-VqIY7fNG6hrakTwuQcN1h5F-PzCtnSzHqvp0KxSw&oe=6ACE3EB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfD6rWni3ZoQ7kNvwHxQB5x&_nc_oc=AdpNBSqI-lI7wqSdn6COh4SWWL-0M3656oecSO7kww4sB1AvxgQxc-Q8FVF4pr9AeYU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwNAbpz1Sk5IcTjndBoVo_v0oVXMxJFBb2LaUbuDA8mA&oe=6ACE387B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=911kPicwawsQ7kNvwHGwhND&_nc_oc=AdrJaZ1SYqTXuNEfrnDlj3IzK7yipRy48nAOhZnh60Kz_YyngotjEsB5vSyXjVn8Y70&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnHJwYbUVC7UBSn41kNoNyLynD8AuaUyGEnfpwmQvgSw&oe=6ACE4DF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3v-jCT-IbBIQ7kNvwHm-e6t&_nc_oc=AdpHk418LpGKXfOAiQjfOeM6HKMCWijyHPAexzx_Y5_ei4NjwoLSiFrYdthqlDkTJdE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdw4E2kXMdj805GRc8GB2y79slhS_yxZH_BtV44VVA0w&oe=6ACE4BF2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLMt1VhTcQAQ7kNvwHOWEkf&_nc_oc=Adobvo0K433rT0rMIiL5v9kwHJdoSj-fe0pte-sVsu8rCy8y2_OgL5y3DuyzJEubTqc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcxM-xeGae4kTnZ98_lXgE_d0eHKK8g9ifhkrybRc0ug&oe=6ACE4353"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x80Pw4U521IQ7kNvwFtZcQb&_nc_oc=AdoHAeI0klZ0TPRvcJLoqA3iuLUuHDQVWSsUYPnOIn1NQjRVmGcLtl-mwhlMdSZhOd0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8jPBXOKED46upISAxqbpG93zBaVpMt45YsEZZEMOgVQ&oe=6ACE3F6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZbGQPw16DcQ7kNvwFXd-LT&_nc_oc=Adq1Ld1zQnB8HV0nMceU5LzySlHXwp03rl9ko9ycPP1UtAei31o2zOmlV63Exa4AcUo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxhzl1xVffGS-aXx0TXjSUY49hkGQGtaG7xDMw9-A1DQ&oe=6ACE4B22"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
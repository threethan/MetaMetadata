://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Xlff_-E8bsQ7kNvwHUM3ai&_nc_oc=Adop4oytFauxUYD5Hz7CGLykR66hMhYX7vqx4Sar9MQZFQjoU4A6o6kQczl9gXBICjc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDf9wVA0ZQfek6Dte9Cgh7VLnO6ijJsq5SCjESchSDpig&oe=6A5CB026"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbNEaNWMAgoQ7kNvwHInWYA&_nc_oc=AdrFsUb-213garTvY95u2uc8IAAzxqS7iW5fGUEeKqu3_ATYjo3ik11qijWsAxdK4Kc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCt1PerpTB2fzQ6cmemcFkiy7EvYpZp9h5hu570xmJdrg&oe=6A5CDDB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GRSB34GlHIQ7kNvwFcXkkT&_nc_oc=AdoQvPPQr2zskTbpT0WZYvW1rVBsk14w41w3YLTsvBWUxJsL5kLDv_pFkBoHIa1NNiI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBVJIXdsso_P2bYrA4Ww63wOOkMgPRj7VeOzDzHZbeYA&oe=6A5CD77B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEQb7WEzRBUQ7kNvwEd8XoF&_nc_oc=AdpztOBpkjxZYXHmePF7658APCaERDtz6Iesmz0H57h3PrIuUaOaP5e1NL__UKpXJWU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4pAGCfusiXF6kCaw1dHy1JTbyyKkfOuE1CCfF2mQbyw&oe=6A5CB4B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_qz4QeuJx8Q7kNvwGAkI-H&_nc_oc=Adqv3fU3jfjBrzJgEE5BWsuFoOJRiFQRntZqi0M1Nm5vSBp4nUCgSekCZhjyJiufyTs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBljED3oFjwK6QKvjcKw_QwYwkNE6NBbX3QTYpVPrcvDw&oe=6A5CB2B2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruiqhZivKLsQ7kNvwECuDYT&_nc_oc=AdoAbi_DoX5JGNI014AS7kKj0plZjR2K94vns4ABORC4vD-MP_-MOvNwQgoLNVI0cO8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2Ny1-0b8c4wWAVvTMeQWqp9-kn5teQ4XkGBrtvSgh_g&oe=6A5CE253"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cI9Ydly4DO0Q7kNvwE91Nji&_nc_oc=AdrGiZ1uT2ISRXpRCUZ3cG6RTGdRfhwfKIBagtzzl85iHXhY-BUAR3IIDLXN48wRKeU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8X-ctiYirrp9h206WMpxYwpQ5nhFeh3IeJrcP06NUoA&oe=6A5CDE6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lau5SP9-74wQ7kNvwEcRcie&_nc_oc=AdohoAOrd1FIgvOV8Tp3EZDetCrj3F3_Ji0PGybelbF6-M2EK5ieb2uV5oN1TBFoQ64&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAL9PmICVCiVINh12TgjskdwjBNPsLHad8I7QT7YBGLhA&oe=6A5CB1E2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
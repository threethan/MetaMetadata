://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6MYpYgZ_PYQ7kNvwFoKpNY&_nc_oc=AdoSmbgOo3VhFfhvbC5lYqKgiVnCKI59rBJSKb1WK9nPqNcmGVyieYtlticMsOmM7t4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WDMzOzNjrghtfsUitwIkU5k9JGh6sgpGAFCmNADisIw&oe=6A355B66"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Q1VE6fHMEYQ7kNvwF2GvFo&_nc_oc=Ado5XSY--LpIU13mEP5zaCsnYQapagtDMpv2h_z97oXJ8DNX1cCCxGqqvIPtk4ic4SU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nGfxS9kHemAkqaBk-X5davi8wWs861wVmpZMlDjkyig&oe=6A3550B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivIK6GtFRXkQ7kNvwHCi7ox&_nc_oc=AdrXClBohEceDhjrs4qDhU4Kwdx6vrYr7nc2-gzsFC5euYSTv3Iv6TRRNdjSu6qmop0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SLD38MGIRLQUCPB-nEKQR-J7JQAel2wFTlsiLP1CCIA&oe=6A354A7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TI2-Bi4JZroQ7kNvwGXEURs&_nc_oc=AdqVyVUl1u2DHvj21QMgZTBl_jAudOdieHpr9uMspPaFQiBQK7KDf2RKli6GzNYP4AQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iehuBZNemfYK0HGNTs-eYLHosr1X2-NWBLa3ON8cmBQ&oe=6A355FF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziI2UDQahXsQ7kNvwFn_MpE&_nc_oc=AdrgFcyOG4QJcf7IhNeUq6_qfKVYs2XhMFE2jkKDBERjcrAlAmN6qvtofI9BQwIlq7k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9urdU5_hgMW-cIbAXLg-oc1mF9OtjirHSK0_ADx-K_qQ&oe=6A355DF2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSse-nuZiJ8Q7kNvwHggalF&_nc_oc=AdpHoI5X7T7cK75kJeEWKUuZYw9Zs2w619HbOpnvtPsPVifOJue_wfC5nB9azggwg24&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qzOvWYYcf-F7LWE_LlQCIVJP00lW00srubSfxp_m-HQ&oe=6A355553"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5xkY5iyjRMQ7kNvwEtcBhT&_nc_oc=AdqFurfHy0OQmo4qLPe_W4AYn4EAqaSuEZB5UAecKbRd6viXvW5b930IPHMJCcoR56c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GdwMo410RW2qi-FBDp75iuoy0g3LpT04hhfY40Sdz2g&oe=6A35516F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQsn9xe9MBkQ7kNvwECtTEO&_nc_oc=AdoFKji03zEe1kEc0xuMaI5BblUkvypSC52NLavkBNnMCi4mH3Ir8JbrAWDdTV1XiYY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pRmCSYxsELWp1INsCD_6siWHplV9AZNmk4CLaP8US0Q&oe=6A355D22"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
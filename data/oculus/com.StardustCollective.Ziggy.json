://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GE_dgxh0pEIQ7kNvwGZ_6WX&_nc_oc=AdoeCY2F0urxam2ULTlLmAkbRqm42iXIYFlgO--dneJd1CioegK_mbzCylqL6e6BQOU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4p-hW-8Eq9u2YsNN-lcbXB7031mfThSC-pqLeKMqgqxQ&oe=6A01F0E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYLxIrSSR6EQ7kNvwGTmDrY&_nc_oc=Adqyk-EPrwqp02p2cH70PgiH-ejg0KDZPp4lTdUAe1A1I8z3CCGfpVKrlXElXoKQd7M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wRUi5UVE0w95KzkyzOeglEnRia1abOjTZ4q1pL_YSWA&oe=6A01E632"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5-0uG7j9sMQ7kNvwFGhbdL&_nc_oc=AdrE1QW6-3ey5douWWiXUCERuY04FX1P529Z6aNrm97q_aIVtbiyvlcvjf5p47f8hos&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-zywqsLbloTHMx8iiPXBFdnHm_SSbMKCDqbHgx1SMPA&oe=6A01DFFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4v-ooudRnAQ7kNvwFQcQ82&_nc_oc=AdoOPt6AywDBSGX9o04OXvBJw_sO96vtnBiCTeGZ8z1B8A99eFfEXquXBWsYV7x9-So&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TLTVLyxtnKmy_QKOOsXkrq1EvxdXByuuwFS8JLsXQTg&oe=6A01F573"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5e2Bm_HAbkQ7kNvwHRY169&_nc_oc=AdqNBoMSdBzwv4k1pYRSHWVf1vwqsEJml7D9gw91mJUPtbDoI_dZudBCRRLqZY4619s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6K7NMURrysHJakuUZEw0pvtdZ3dYQ_gMQYkJWCvrE0Mg&oe=6A01F372"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-FGah8s3d4Q7kNvwEI4hQn&_nc_oc=Adp-FhN6XCtM0frW6Z9jTFZM6dxMNlVAId-Kvpn8Gn-TOmR4ILHf1aFRvlev23iwwgU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jfdcHOAUCGegX10ByZwx9LjDtiT6cfaRCJ7QbMqXbbw&oe=6A01EAD3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ih-JvqLFDyoQ7kNvwEDhoNK&_nc_oc=Adpo-gIhoqfXbDuQ87EYJOLKH_YURqNImW9KfdY-JvDXWH9QKCoCXV2yICanniEThT0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5S1hkcBwIFTS7FZ31CE-WlHZVmkFTy8lVEEHDjCA4dfg&oe=6A01E6EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gqBpOvAHTrkQ7kNvwGxjlhc&_nc_oc=AdoD3_LK1yWjurLLzOYgl-gr_Q9lxNnULxFIRghSiRoVd9Rp8mOr5ZQRm9k4mCb5KiU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EaRlYatEUBGrvehTq979UxRYfBDzzc4PsghwfYi7jJg&oe=6A01F2A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEhCwU9Oaf4Q7kNvwF6N6IR&_nc_oc=AdpR43N3CrHLUhpHG07C8GYfKUOupEBRDypNSffnpQA6NZw0mBBVAKLDX5EcXHJ41po&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4QfZkAo3WLL0Ae6VybeAgeiViDA7apu1vIRRiuIIMDQ&oe=6AAC0266"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CB-r51l8t2QQ7kNvwHjGY7_&_nc_oc=AdpEmoWpxM2x4E3rcyOY9t1VkV1f9ZV5FZXPhvmHHqtiEw1WDD3iJ14UC6juMif4oMo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIARMd54afVXlJGNJlMC4jd2P1WZhpV0gVIctjUaxqFg&oe=6AABF7B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9sopW0ycAEQ7kNvwGGMMB1&_nc_oc=AdoKL43IrWS88inlfxwF2Pk-Zt_d4GbCXyDCCEG4vWq82HOrhRKcOy-1JQXmf555ZIo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcHTBa7PeHOQt7Lm47MyZB9kr7ExIcSh6645dEKBGifQ&oe=6AABF17B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjKyU_FZXsAQ7kNvwETjTuq&_nc_oc=AdpLJVTRZY22tPnMNOEOoYhoTxTmSzWW09avd435nQE0ulROI_O6bLZOEuW3AVSXHdI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJepRRolqpPRinK-pdMcUDpWJ6JXN_rZ37G4Ialn9-myQ&oe=6AAC06F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIBYjbJ0woQQ7kNvwHLW5N-&_nc_oc=AdpTsMRhHidpJDE6S675XlBMtvBTND76YZawXCVmjhNL0F1j4wt5I3D_cwHbIhGXJ3c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIskHFSIghWy6fy_pVuGo3gih4WsJQ4sHKtBU88oc3Q7g&oe=6AAC04F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9xQTq9xapMQ7kNvwGxkTGD&_nc_oc=AdqP-r8rCLJDdsl2KyyYPjb-8UwQIxcaqknD6VmdR_A7IU4GqdVTW3E1htGfRhZqaBo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLehzsCdeOGK8saqG1uUhpAAnrcMwj7EYxMpkO5nd_gBw&oe=6AABFC53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zn0CwGbL3pAQ7kNvwFj4yNk&_nc_oc=AdqAuov757kbQgbc29Dak5aBwVa-G1DHmMv35q8Ml-l-Ih6VvU9gx2G_V07eJgoaW88&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3jT-M0WPTIpwWyUFr3r9ZD34xiNWl9tf0b92-d4LDQg&oe=6AABF86F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKJJqBo3pnIQ7kNvwFj53NV&_nc_oc=Adq1TKRcwf3fuQJsa7piGvS32bTyx3593VRHu-VirV-xBBu7uYIEwlztxuCA0qeyRRE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXgK2D6AMhLRSbd4vyW6PSzmgMUmS-ObO17jmCvRV8Ew&oe=6AAC0422"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
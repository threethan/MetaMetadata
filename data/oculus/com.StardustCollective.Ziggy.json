://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pnuk8L0fWbMQ7kNvwG4l-Hj&_nc_oc=AdqhPiF7SiOPmKIWxKAnY5gsWNlI3U_E-otE6wjCQuxNA1wYVPWbtOUzKlHSd04zgJg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8p9b_1ZI1PAJBDZ9lQIsx7UEJUDyFfJt-69PnQtZa2w&oe=6A3D4466"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofFsaku1qWMQ7kNvwEp6Ugl&_nc_oc=AdqiMLPW51N-zOvsfZCXESN0oS23c6zvEWft7gpdAUM97amt_8xm1VAjdTZF2_YeNU0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gVDwbsErldb9jfFADNUmh6ywOUlyraebWm1wEjUdvZw&oe=6A3D39B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R71rhCxdK6kQ7kNvwF_OvKn&_nc_oc=Adp_wCqnbpTWVQQAmu8-wPmqfaH3v6C2AIXk66rtDztUmfWkcIn0OajPGep4vWudcDk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FQ-lcreFhxDZFof5poG7b-IgFVqe1V2u34zQu5KvDeA&oe=6A3D337B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnNoqoAx-7YQ7kNvwHDUo_n&_nc_oc=AdoLsADb7VEj6cQEx9BJqLtpqqwEC4uauY8m5h-ThzsYGGRP2cZL_AHvi2K3piFcUN0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zlZJMKJ8c17PLlH7KGBT_7H5GLI2CdiaXmYJGCmrn_w&oe=6A3D48F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qE61PpJq1F8Q7kNvwGrrgtM&_nc_oc=AdoP1Kqx02w7kL_PhaEKuTzU0t47M8OcCLB9Ek-yxQez90kolVDqK2J8lYCoySW4JzQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vusZtfDbnuIaroE3HZzWltEfmV8iGEMQEPBrFA8HKuw&oe=6A3D46F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6nHq94d9doQ7kNvwF-1-Yi&_nc_oc=AdorCpVXm9pZ3ChtPTpuJ6KvHrvbGA-c4AIg0Pfi5p9cGLv72--aM-AaCHi4GYT4CZg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JOpdPF8vGgt5M7JADczDEIGNVY9wRYSK3F2u8aPQ0_Q&oe=6A3D3E53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccBTfcSQY-UQ7kNvwEbI8nv&_nc_oc=Adod4Wz0evx38HqLTan5bImrYW0N3uKj3RrJPn7hEALmv3rtG-4sExGnZFIhjPbSDuI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RbsGMKA3w-hXnkp9V7Atc0kOCPgR30o8krzs_zz3xVA&oe=6A3D3A6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIse-byTlP8Q7kNvwF0E_Lj&_nc_oc=Adp3rwStIVvvjqE6V_Yceye4qyWYuUS-iiJPwPeItF3KnMs5ILKb7fNl6QCl_Uyp1m4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eKvciHjYYx0w2Su5Ob8haisgvOQdsWhQJATm1Qmnjrw&oe=6A3D4622"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
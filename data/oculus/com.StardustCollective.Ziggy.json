://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jd50IPtiUbcQ7kNvwE1bwRK&_nc_oc=AdrcWwIs_uOquq6l29Je1k6FdflMVrbKfk7cPiPAZiF9axoT9KquB9MpdWxk_drBw6A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66OVrh7ku5ZyjknxjcaWOGq3ccCqxXhKy6C7RIqH0sQw&oe=6A0736E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAFEb1z4dEcQ7kNvwHFowBU&_nc_oc=AdpRONKsLk7TH0O60oYeqStM_yXFNBUYr3nDife-CkB_QTsltb-mARbSowyQv7JWY5I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xA8qFy2hdqEWpoW6UnCoJpQo5hTbY0jg7PcBaeKOutA&oe=6A072C32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4aDgGnhadV0Q7kNvwGOSB4w&_nc_oc=AdpGZ9_5ejfxP_6UuHos_lMsWIFOq0BJv2l8Z-xxkrPbYfHZPH-sDlVC1ip44bGiaFA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aNVSF1vT2QCLtNWfFx-NsoCGscXl9EGWYc8uuCXTmZA&oe=6A0725FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPm7grmbxjMQ7kNvwE-OIi0&_nc_oc=AdojaqZsDJoipMKIQdlSdO7DJs2X0JDbLu6azRZNBLYtihuQB_GUe502fziPRIZ4MgA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Rr_zScTNPovOlCkcZKBV4VvMwjOhnQIJ80FdTlRy8ZQ&oe=6A073B73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fzNJYdWtY0Q7kNvwEE9Xg8&_nc_oc=AdrTnF6bSaarMk-P2h-I0cz0onDowp655woAoc_uKZCw1CehtnvKRU2fPmapgYtoMSg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FWcvR9W6vOq7w5VgFbLCVMS245aTOAHdK2FKecAahHg&oe=6A073972"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvH5jCpyiiUQ7kNvwEEFx8m&_nc_oc=AdpYnUrGUpNuix2Bm4-KEm0J6baN45f2FFI56eo0gEJh6JsS5g_X2D19qSZamzYVJ5Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_ViF1pBR7oLiD1XcAMuCYW3KcvAaKSLD8BTQL1BYddg&oe=6A0730D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AML2gQoP6gUQ7kNvwGN0cAv&_nc_oc=AdqQepxKs7_gyGQ6PikBpM4iRO8VPY5u-cg2tcjY58v-mC96AE7HMBQqaWoaL4k0pds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41vckFmJKG2cVWu2-nvOAfrcxfzEZMdbKsaa-hUtDKHw&oe=6A072CEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bdMUaO4IgMQ7kNvwFn7CXE&_nc_oc=AdodaRL0aVnTJqJKaIa8_UgkvGRnDCxIn8qYUhHUG-aJM-CeZH1yeyAcVk_RGciCQQw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IlZmeZKQP65n9s3JOXgj1EXXKeQpn3WEdmgmj6uXpKQ&oe=6A0738A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
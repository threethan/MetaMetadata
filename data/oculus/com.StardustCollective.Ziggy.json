297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5VQDcL9XLcQ7kNvwEg7Ft5&_nc_oc=AdkTmfAWJwe8vJyENi0UPlDgjS0MMveSajih4K0xByLZzWTMwbuLWNMh0Qf6Ako0M0o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxx9Ri4KUCcKiga3tCCBOlSvNjMD9xQsG1B6HqMCz09PA&oe=69B541A6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuGaSXlpFUcQ7kNvwEp_Iza&_nc_oc=AdlOjJW77HmVxlPJNMqKRcrtfszrUdkjrTVcELT5rfG1c8o3PPQnk7cuC0lftPxx6FY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxIYIUe5Ffn-B8YH1TCLolPLqg1HlLhzHXtnOLRYUeyVg&oe=69B56F32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwCrTMN018UQ7kNvwEtEiSF&_nc_oc=Adm_zQ2Jpr7voig0_p2z08wIpgf1oSPif4WcOghLsqZAiNwyQN3jjqlaBCB66caRJuU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzCuUBOjINMnVouT0sqIUxZNwWFXPmhW5NLGDrwbEqEIQ&oe=69B568FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzfEGqogszcQ7kNvwGnzGMH&_nc_oc=AdlNs06U4hz5YHewiJyOHPUa7gPuOBXxXxAPfdCVcau02uqWLEUtcfJn4K83NyjmPfs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwZM70xFEdf97tiLivRHPE__--b4JTYwsAI10dAa6Xdgg&oe=69B54633"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBP6uxLyW7AQ7kNvwFs7CnU&_nc_oc=AdkdkNnSYW90GwViv6MeCpXbyjN3lBc5YWim-Hq0elc8WPBE4Yw2TIgheOhVwpy8NzA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzjIEtx_AIgkFno4ldRclf4tB6wK0arq55SDDg_QG460w&oe=69B54432"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pz1EBEeMyRkQ7kNvwGVo2D5&_nc_oc=Adl6lsHEe9cB_jaYKMcOWx4zoaIpjVkR4zWrnNqqxnjrI1530xvgi-Qg2ZLFUOGTP94&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzoRanWf2yGss7LiP7AZRwTS1Z_Q1yud_PWXAltFuyE3w&oe=69B53B93"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4thfnm66VuQQ7kNvwECNjBM&_nc_oc=Adl75WcNDeul4ELf9K3PcCrj9CGDxD5UxyeF1fGrkl5Xp-2T3woiRboCDAErBc_-i2I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzAU34ewQnlGmYjar0-JgwIcTqWMaS51viEw380kAMO1Q&oe=69B56FEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1eUF4H3HvsQ7kNvwF85s8Z&_nc_oc=Adl2ozXuBkRyRMlu58T6Du68iC2rkBsZE683Gltwbc_2Fw1f4LpEfsOHV3MQKLYfiE8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwbdS8RHxzEm3WKTDV6ulAtySo3BlsPaj9IcjpAdCrACQ&oe=69B54362"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_5218087471640407679_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CuSpcV1W2CMQ7kNvwErqyrq&_nc
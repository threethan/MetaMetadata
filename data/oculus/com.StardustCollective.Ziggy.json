://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iOouwm4DOEQ7kNvwGxXmtV&_nc_oc=AdrqNkjcFAs6y_lP9mYcLjlbXkwloPXjkNCW8s2fFDQI0fcYEW-7d4Pf-0ILIXOgkSo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WCz8jGf6M6fiVIrnCVpUbtvGNv1t0xMTLNe1mxaBgpA&oe=6A26DAE6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBNcUhc0RhwQ7kNvwGsGZPh&_nc_oc=Ado85u2iI83zwxoGqwiLl0z4baNB1VYnUxIW8W0vaMMJ3J5otm-kkZIh__7RhTQGbdQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ceseeCII8Zd-74RM3HgATYSDnB9k1PrDcrZA6V5Uxdw&oe=6A26D032"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0wwCoFS0vgQ7kNvwGcxqfL&_nc_oc=AdqlGiVBVSwNL19tD_4d72Ocu2z00KleXmn8AtgdrtmdSq1mAmiLKh30Kcfce6Ej6vk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aFMahfeW9T-inUuPlbtlZb728hbGONnxAOaRwwYmb_g&oe=6A26C9FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qP8QH7sF2oQ7kNvwFbwNHB&_nc_oc=AdpUX9Il4EtyW2EwLiDSi3MDV-mp3Xd1ARc3c5VRMr5xof6owlnlWgksDXzkDMQRkZU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bCkK_8WmilE0MetjH4pKCXQZT_5Jch08bwlyrfbDjdw&oe=6A26DF73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NISfU9rDmLQQ7kNvwFVIITi&_nc_oc=AdqUkDNYqWle16ei8RHud8OzJxR17XrTzGyNL_N-Cm_etopClNZjX4wdIaT8gzMWbAU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VViYXrfiuPydmgStDeBSGqaduqwpuuGnqYglN2NUUKw&oe=6A26DD72"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wjlx6RLrH0EQ7kNvwHZsAXY&_nc_oc=AdruVIGrSxq3QLvJQFiew54cDKK1Qnmb0kULnx9A0MyTEhlrel_SStl5c3jUQYoUD2M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93169XLt2-pIsCdAQgezYL85-vRejvhSL5izT5f76gDA&oe=6A26D4D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ki9hMcdvfdoQ7kNvwExhAQ_&_nc_oc=Adp1PMraSyB1UpssP00P20X7XcTMdsQhzy-aiuhfysrky0JiODZZbH8CEOwO7qm_j6I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9I0XLc5U9m-XpXk3oxJ99V65zC7H13SaoxMdMnAvCeyQ&oe=6A26D0EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8WQts-972sQ7kNvwGfeD4o&_nc_oc=AdpIcMJHcZoCX23pYKaqHJ2KshSCz5gjw4rpTgXwnZoanpgl5H47l_yZKQUmhtaNuCE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HplOvv4L2NuVk3O8btU1Mdys3U8H4bFrIPqioH6pBOg&oe=6A26DCA2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
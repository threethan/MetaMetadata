-25/38974500_800214781605120_8880468551637015930_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxPE2rY_MRoQ7kNvwEsqm0R&_nc_oc=Adl-SWKHiq0wLvwohJezP8_Bef7V1KhBYEA0EJcvxZaA7laUBbRUKn7Pc4_H8Ccdv-o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfucBSWI1Z5d4oJoJseHcqPiRruv3t9KnKD_KY1U8ZWaFA&oe=699EFE6C"}]}, "id": "1005005773748906", "locale": "en_US", "screenshots": [{"file_name": "HighresScreenshot00011.png", "id": "1326199667974786", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035386_1326199671308119_4397089309417940909_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzJqRMOo1sYQ7kNvwEmIHG2&_nc_oc=AdnHIJT_QW6zv945QO_EN2GacWWXUVuz8EshkhcIXSMfBvonEDSPAz5BGXP_0tb-vto&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfurCrAxPh9u7qWgCIfsa_DQXoTdg4hVVKApiGI30Dlrfg&oe=699EF7DE"}, {"file_name": "HighresScreenshot00028.png", "id": "2412721535575051", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974577_2412721538908384_6467288184304840049_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3le10Pgju8gQ7kNvwFy11qc&_nc_oc=AdkEISvzFl-DfCre-y4jlF9LswWmM3QTXyCDPJ_GpJ8gmSeA4si6zvqjHlFaP1c1LR8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsQ23iGGbFxNEU0hC3EQwoHaqSZpOkRp9ORlvWnN-_W5Q&oe=699F084F"}, {"file_name": "HighresScreenshot00014.png", "id": "997351624641332", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982456_997351627974665_2778603811108028476_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bflFh2Mmr8sQ7kNvwHPMNRH&_nc_oc=Adk-WToj4Y35rsHY_pT3JPbnDXAQ4U-6y8edtb2uvjlBzBV4bT3rnprx9lJDVAJTvkc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfslekqhPeun3D5pzowVP1yS27K9HvMFKqtcOsZ-h6rQCQ&oe=699EFB21"}, {"file_name": "HighresScreenshot00040.png", "id": "807733037419699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984472_807733040753032_763200239777074167_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Flj-NkAo3_gQ7kNvwGuD8aA&_nc_oc=AdkudWs-nb32fB9RjZiEhErU2A7YGaQu2Pc6V6buIWheJ2Bf_QTRpZxVcZUI5SiSqfI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu7rBF2kKfc3roW5huI_5FUI_r4EsIETRFpcXm6kNNz5Q&oe=699EE5F8"}, {"file_name": "HighresScreenshot00146.png", "id": "163970600033098", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566678_163970603366431_5435931785999963108_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itW7mJm_wDcQ7kNvwEB-fuU&_nc_oc=AdmLOKR0Aowb6XQu3KYbI0vOmkY_QZLDzhq4zHpGhjh7wbQbyreDG5RZxtWuroLAj34&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsAESvy2gM1yR6RXbrLhUHFNKgJ8xlh1epwOCD3obW8Wg&oe=699EEA71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6SBMLMqEqsQ7kNvwH8OZ5R&_nc_oc=AdkV3g5XeiXVePirP9karvTGMDv3S3E0MwQ9xm73QMmMP65gXlxjvn2DdW7SD4w_7tY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvCHBG7H7ZIFEgKfm3E-qWb7Mjx0da3jYFDleIBob-NVw&oe=699EDAB2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "1324311035174797", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984472_1324311038508130_2610060411856834928_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_RNerigqeOkQ7kNvwG4lUHo&_nc_oc=AdnGiDKWXKZxAfTipvDYiT4f3Dllta5oso-Pxu7GqXyjlJvPRKozptIder-Ag0tk_Pw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfslSQdIp_Nb7xj56dBcEK0pfp7KIyoFxj3LAsGk3JgGfA&oe=699ED378"}, {"file_name": "CoverImage_Portrait.png", "id": "1021944422558335", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031612_1021944425891668_3460677483354056217_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dFthXXWhpwQ7kNvwGcPwxS&_nc_oc=Adn7SZ2ckbJxVEEaOUlmzX92ioELcYM7LH0tmlaRg8eR3w48O-WCSMjc3Ey2AgpvKZM&_nc_zt=3&_n
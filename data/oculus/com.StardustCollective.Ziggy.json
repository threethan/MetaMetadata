://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jd50IPtiUbcQ7kNvwFve6iL&_nc_oc=AdpL-NL58jecGkD6XJZdjkjanzwPwjOaZN_-Av5UmRVZ4D28ot_vw8pCV-AeFVeO6mc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VFk8mTUL6iysgf4Bgu2E0_PbiBOoEuwEWRwmn-64r0w&oe=6A088866"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAFEb1z4dEcQ7kNvwGd6A6U&_nc_oc=AdoObHP9m_kaAwc7uIgMrpizA2q8UxCKt8HK-E_fmHafWYeX5nFejaG0euBZCEHJYVY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6q3K27ANjfOYyqXO4Fv2aBlUIFMYPlkEIdK2ayCNOrzw&oe=6A087DB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4aDgGnhadV0Q7kNvwFewTf4&_nc_oc=AdpIViE0bq8mEb8eVV6Pq1cT6vdmfHsgjWjshYbpEgqHGitm6wNQk0IeDuq2TQpeWHs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EUZSu0Pf29dxlPYeUtBK1Lt_cC6qAu9PO6a2sUpnMlg&oe=6A08777B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5RJfNOtIecQ7kNvwHYLisT&_nc_oc=Adp1iumCFbz2W724sFILM0LaSPRlRiqGiDRKYevVeQj_J6ATAgGGcFBPxJseoMBfeko&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tjlMpvgueRGxCF0UNqTY4ZE8i9GpQpE9NjgyPZqG2pA&oe=6A088CF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBQSW-Fii8IQ7kNvwEEkFyF&_nc_oc=AdpFL7F0tssKY7Ib4SukVu0ds9KLS0XDIb2wDJFx9YA5Eb-9T30A3bUwABXxwfzvkrg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ccYo_iWiNt704UB_g7iYLrkb7FiqwNoWhMqmXWUMWMA&oe=6A088AF2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvH5jCpyiiUQ7kNvwGPxHyj&_nc_oc=AdqvatKbDZhbOAMf2cHMw45JRkprvz82maQ_0S1K8dV6ItHskeY6LH3UMRjjihkGwYU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RE29PCY0uy7dIDNyr25_imtIyag_jAippr9Qy0vea8A&oe=6A088253"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3Yb2B3dwRIQ7kNvwHKncXE&_nc_oc=Ado_XgzpE2_shkY6Rrhwe4I3CCTxSIHBLP6AiMHNHJVmiiobTABBYobRAuMVFTdxAkM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VWDuXhODPLL39XU8sCROXPkXcdCxjRvipEsebn-hCUw&oe=6A087E6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bdMUaO4IgMQ7kNvwHGDU5V&_nc_oc=AdqY1P3kKAwq-j0pE5y86gxd167vIcic4-wfZL2c9n6ZMdCa4UHD4k2YZyHQzXR7eYg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SpfiJDwbbMmWEUXD0acLoNq94CbajTALwYgoBt-vppg&oe=6A088A22"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
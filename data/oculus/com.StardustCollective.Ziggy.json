://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DetIDdytafUQ7kNvwEJLPrb&_nc_oc=AdpLkl206AXkKhpe6NP0p27rBhj6b6CXlfZ0zc5wCfs-W5BhKy3ed3zGqLhF1Bh6kCw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbOw5V_iBXzcGhsv250fz-OS1AG7B_vgtkVjwKgqEoSg&oe=6A60A4A6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WByXZkWWcN8Q7kNvwEk43Kh&_nc_oc=AdrAB4xZoInYDC7Hpt1sjdmqn11Y3CLSbqOoatQTuaNWW7Tkab9lhVKlaiu43qaBwmM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVZvXrkja8Qw8ymTRiNkzr0vLvify8MICGrLrvftxOCQ&oe=6A60D232"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qV70tQQKGsQ7kNvwHivhEn&_nc_oc=AdrV9-cQHGZpGwxJk2vgla2NIXTWoH6I9oEu6ph87TlfJWc5l-ejluEm_hX4HGexO50&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGYB_zoXroeK98avjGIu62G_mosk3GcdPY4alaf3fMBw&oe=6A60CBFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wa-E7B8bb9AQ7kNvwFBH5ej&_nc_oc=AdppINWuRO_tND-FMwzymw1Pt1V8JxAjZxlcqehEilg9wjhjXfVLzqzgq7G8Y-LvYSs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_WZ3xHIsBQ59fF0a_YOikT5oQLgOCDxQsjxjxCFEoiA&oe=6A60A933"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWpiEnAdLXoQ7kNvwEM-McA&_nc_oc=AdoythBn8bHajOQt7AZA7AmcRIQsANV41skkoD6nyrqHmxx0ltybXY6O9hbcjKnO8PM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXTStuxTz32qWOSk0oeylD6MkT_XEwvt6NAEIxS9UuQg&oe=6A60A732"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4j6p6-cLuoUQ7kNvwH1eNrn&_nc_oc=AdqrSE4khcbqC3DckvlO7_jfVwXM4VoK59tNY8ybvzVTiiKRfoW7dRgpx0bxn8MiEMA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaQo2e3Q-Blh9rN1bQkq1Gw4sVtq2ULGaS1Hbo9TsEjQ&oe=6A60D6D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vZ9r7R-0NYQ7kNvwF4zG31&_nc_oc=AdqUXQwzlbYMWL3Q_Iy4KuMafXQgGTEZgj4-j6DYGQLXnuiUGFIU1Sf_-AIFJP-iIwM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmvPuz4-vXz1cEKd826acUZ1l2Ta0Ute5e8mBL02_QbQ&oe=6A60D2EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dF5O_EP4SEsQ7kNvwHcmYU3&_nc_oc=AdqL2D85V6O4rlDGmD6Y4r8pKFbSsABIhkQvR7JpCEcOq6ZHQzn-YdlUtEKXUSvBpOM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARFrKbEY041A8zQyquSBr4xsybkTsiVqJW84rnLFaaXA&oe=6A60A662"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
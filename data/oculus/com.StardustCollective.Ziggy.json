://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhMcoJbofSYQ7kNvwFn5B46&_nc_oc=AdrGD6poKOnN4rWUZR_c64suBoU-Wz2uEFUsrsfOyNXBEtdWU5yreN3dyl2giOGrvg8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJFOb_5MuOh29nmHdCSV1g6XO5XcTnoqMYiq7cik6sxw&oe=6AE36166"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43tyTF968CAQ7kNvwEnIS2N&_nc_oc=Adoa5kBEmprVRV4RK0O6zmqwFDBgWgYI4Gxe1J5GValw0VhyrAC7ETaKtmxJTlAeApY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWv3SE8isnD4dFzlJRZBt9o-Eedg_rBHjeE0YmO3JxTw&oe=6AE356B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LoZHrqH6t2IQ7kNvwGKseOo&_nc_oc=AdreqF0sriPzbhEKF7bDctB8-s0LVKO5aPmt1_Cvt6V1X5tvBt0GZlF_okGHyzW244U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdM3FJozjXYPfawbZdOp_a5wHXD23EykRHNfsGAWZzOA&oe=6AE3507B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywk3_dPgWNgQ7kNvwGLUaDN&_nc_oc=AdoSfk3zpmSqXsjEgJZyq5fcEN4Abi1csJDGgQtV-uH7q-ZnQlPQ5h25pIQNQPuZp_Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFi-4GqR92ENf3suo6NkBBSb6y2_k_124j_v5CHAPoZA&oe=6AE365F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLQiHs2NKz4Q7kNvwFdmxVN&_nc_oc=Ado8yg9W_biZK9E1bp83LisFWYeX44vWDVhPYqXfctuS0D2gTRHlLOunWASVGrSsC7Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHkzgeUJpwbDdaQ5Uu_rqpt9KmvtSDdfbzwv2yLHJqOQ&oe=6AE363F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwWjS9JDLogQ7kNvwH7ivgL&_nc_oc=Adpmct458npZKcRXQKNOIH8MjbB6ytNNvGQOYR68x-vQfDfpQXkJULPV62s3Vpkerwk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNWpOTl6H6XINeOFGqUdoZDaWRO4zpzhx2rn8MthCRGA&oe=6AE35B53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2Zwn0XKSWgQ7kNvwH_91_e&_nc_oc=AdrYihV-Yi4z068l3_tD0_AbrbE_8GYdhI3waYx-kVXB_q8hyAr_FfingEAxm2UHXBY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDMQT3xPOIXEMKir41SMVpTB8IVYKkappVsIZB-HpIXg&oe=6AE3576F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nszyXfCWVm4Q7kNvwH3b9F0&_nc_oc=AdpQj38NMdwlY7JMLVJ2_dL_hW96Q7MqBGW-ebC5fmKAmnKJrH6TriQviSnkRIm1XGM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP425Sjy-NJRgP2a0pajaOti1D1PcEJFyp-gl-R9lF6qQ&oe=6AE36322"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pGKQpLtv5kQ7kNvwGfvqmF&_nc_oc=AdpNZBUsZbgACIGwHQcJOFIF7XqUOF_O78Iz-WbcgpC3xZe-xm2dvKGubiz4NPzOWyg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TG3Ka3DwZZQ7IUcXk_0zcinE_4cgdHb0lXiXYnXa7ow&oe=6A2ACF66"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rVhsS9XBjYQ7kNvwH_Ckfa&_nc_oc=AdrdscwmYbNNJMde3cV0jm0HHpu_Ly4reN39HBO6UyeFbO0NSFAf6a-f-jU_v9yNTto&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-o2Li0vPVGp8JYn3o0mLam1X4k7bl0__srRjLw8SfQiw&oe=6A2AC4B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dmQqObgZdgQ7kNvwEeQ9tx&_nc_oc=Adr0E3Skac86pRofVU90bMSVk4_KjWYaX2cjL-HNoudTlEz03zJ3SelYdPLPMEPSTtE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ES7RrC5xDzppphV8PQGtld45tv4K2b47x85ggL9-K4Q&oe=6A2ABE7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkM-harkerMQ7kNvwGtxe3L&_nc_oc=Adp8Fkawr1Ab7Owj6vaDKpwg19FYlr6QeLnUC4Ek8kEcSoSex9MAnEZ33753duD3eZo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nk0heaVdsHwkwB4T2YX90Tud3RiQZK7RCJsqsftmYiw&oe=6A2AD3F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOc0Dd-2sZgQ7kNvwFduNVU&_nc_oc=AdoxVb40hKI4oJ3KXs5Po3PR7A9mT_77V6D55n73qG5kYV2g2_xHBqxEpVysEJE7Vf8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lejAIxOpN5AjQrMBA7CGWmWDOzgAXfrfq-WkAG6ngmg&oe=6A2AD1F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4JapuD10mBcQ7kNvwHpj3Mt&_nc_oc=Adq_xDXUCpfszWScMPxGO8PCQSM8eqphiK8xyABEuFNTmfq7FR4hBgbENs8OkkRBUSw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zx82_NNNJKoMw_irSi7MOiIb77jK0DsQa4QOSMVdLQg&oe=6A2AC953"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZgX3pZuDRkQ7kNvwFrr5nL&_nc_oc=AdquJTCmkXP3lxOFDPi2NHQWOZicO-ej19HCYrzG5YAudM-jbGDT16Bt2XJpug4KELQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Au6YmI9yqwAj3VEzu7sZw9VsCyQi6H5wj18bNHDR4lQ&oe=6A2AC56F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7p-GokOIksQ7kNvwFGiB5t&_nc_oc=Adrw2BSWrruF3sQgHVdQEJVjUtEuYu1AkUM4-mWQMzrg0duVysXPffj6x_RT0WNZhMA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96PG_pacYRABXSEdwLhIHFDv630xXrCr-TLCsAlmimbw&oe=6A2AD122"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
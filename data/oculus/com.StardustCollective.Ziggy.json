://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVKpu7DD-HcQ7kNvwFQJaDv&_nc_oc=AdqlZfJqoXV-GrolbWSXzwxwvEE6Gs9UjhM7-Ro6yijxQ-s7i-6rBMLxC1Nt5KIhft4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9QazB9HIGZxRl0vcDfMl8YivvjAHy8jYfI99rs2Xo-w&oe=6A9ED366"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRo4XHEVX_gQ7kNvwF4UziN&_nc_oc=Adr37EYmP3l0WSSgQGJE3O9L7t5HTeYCWY1MvYn1woxegmheSV3ZJgSqjz0qA5yIy5w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJh3LCaB9NxCCxYlVew3AKpJPSJkoIo9ejg2GUXuWnswg&oe=6A9EC8B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzidItOMxrEQ7kNvwEai02H&_nc_oc=Adr1kEXH0Tp21465dfbl4be-WLf7N1xozDy5uAgSFagaNnDZ_mdV7ymS0tAZ5RTHEBQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNBPWK-NUf8Gk-rqr6ihLjJfqybk_EtleuNqSLUX7OHw&oe=6A9EC27B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teMlkUImr_sQ7kNvwHQ3z7o&_nc_oc=AdonKLAc2RIJ992C8FsJTJ50IFKXHtTlp2NPth_vuEK5hsqE54Eq7MVcM5gN7qKa2yw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7ZTT4V2JB2WqqjSdy16AeNHMsSBTI1yvzkBJPgLaMVQ&oe=6A9ED7F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HysH_-3VQbUQ7kNvwGArKzz&_nc_oc=AdqRw2PoRNMeEYVwOYsgZytRi7HPtN7SBr_q-lfiiTw_CB_aq_HkXHaFV2ADTZQlQwI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUp9n8-n3JaPebVyh64inL6fZIaA1YdIpwaUxFsGTvbg&oe=6A9ED5F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVBA4vXmMQMQ7kNvwEBo4F3&_nc_oc=AdrZHbXEt-jCeUXYJ1_V2S_mbw2EqyDjt3IwSOxQVuc62cNwG9Y3TwP713qbB6cs6Q0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhiPKEr2vcViTNZX3V_CpBVLo0qGEvxsT1F3eFp3OR4A&oe=6A9ECD53"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oj_Mj6Ppa_wQ7kNvwGXvysa&_nc_oc=AdoAQ-sZA7OW9UlehCCog2JumeTqeOxGsjj247FBTHW1VPglfo-Ua5i6PIYp4PLvqCQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-PCseqefgF-zNLAw-XyiMJN8gfv6eVwlG7AG1lvrfNA&oe=6A9EC96F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qL5sBLNkM84Q7kNvwHlQmUF&_nc_oc=Adr1jlLJRDP5KOvwM0Zs3RIXtO5K1KC1xHhUeGCNITw3j02WgH-bFwAwWWEvnBr9YMA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGKLg_j2DJLQoc_bEMaUgSE_d-ZphFmULM2_rympWxNg&oe=6A9ED522"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_7lpbHic5cQ7kNvwFDou06&_nc_oc=Ado1JeqWQTTIJZgwTb0bPo1ToJ_zGrEz_m4JBPTYD2HVTw8FBB4HYO5HPJGJl70Yt3k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0l9TWtGBRdMA9qRazcSBn3oaf2C0muu-LdRow8pNQ5_Q&oe=69F8B666"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klyMQuV0FBMQ7kNvwFE8CBy&_nc_oc=Adrh1LTH_mqZwGOCh_sFI6_8Nxw7Gylb_ANlYGx8w5CbNwvju8UNbIVjC1ZQjji6vp8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2sB6Tfbsw-R6JkrSR1ANFCcwLh-CMhkzRtG0QU6HPnFw&oe=69F8ABB2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9us6HXMIkgMQ7kNvwGENwUG&_nc_oc=AdpcpEpoyGaswG3Xzbz0VnwtT7ZVOuPpvXP92mRGfoZXebAvF0cFbh65UBDL9mWD1p0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2SSHx_LeNiCmx-IMrPG-KVxCcQwvuI_WtDYl6TUQZJew&oe=69F8A57B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7aFZMHJ5SwUQ7kNvwG8PKwe&_nc_oc=AdrdAahQa6Z1YEyx2iRzwKgRAlCfnkg-_O06JoqEj_e5trCe0XQ4rQlrxQa7_PjS-KE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2oaauRhYNN5DebRWiyloUPe6w7qPoHEz9mlNWtwqTyew&oe=69F8BAF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQwa6OR64vMQ7kNvwFmD9w1&_nc_oc=Ado9XdoKxNdjM_xOojZOAOFeNrFP5omI8PEBvnkE_2NYP8OS86WznANw1vE-eAZvPGg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2iVinsMNqeQeGyRJZDyuvs9y1_i2LLRXpuzaKYFmox0Q&oe=69F8B8F2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pGFGNhoyJAQ7kNvwE8qzgp&_nc_oc=Adruu5flE-TR1fzys1gFhfZr69RThyKXjB0fWhoBsbhEeLvut7Zh_pgw0kiNQni3OYs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0qxff5wcxa7UpijLQg14tYWCTYW2vJYSIqvI4erJF8sg&oe=69F8B053"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7_SZG2_AP8Q7kNvwGL7ZMD&_nc_oc=Adr2VgiU6ndtu2gY9_I0gCgS0Tcq4rUaCATi8nYT4MDDrTDoWdPhUgi2O81UE_GNKxQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Y3reHpksm0Ig9XD__IzEitppL6nPK0sqIoZ9ovRwJPw&oe=69F8AC6F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqSF3BY7yzkQ7kNvwGiUYZj&_nc_oc=AdrhNFLoxgFnWdrPn33cLuzi99-KTHycy7XGNyPKSjlofBiUie-SXGOoW8yNwVt4164&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3vSHJwd0qI2fZt1FEt2WDOi4-AofObISKS01eDggsmiw&oe=69F8B822"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
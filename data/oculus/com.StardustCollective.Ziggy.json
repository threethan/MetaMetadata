-25/38974500_800214781605120_8880468551637015930_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYNfBZ68SmMQ7kNvwHXCizg&_nc_oc=AdnahFDFkVducCmaYvEf9rd2qm0Gf6PsH6WYLHHuvb8atPHlcxy-4Kv7mNDrXriowdQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvXpw5YGEOzy_FkfUVIFLYGb9VZlOnf0gFX7S8UqTSPAQ&oe=69A2F2EC"}]}, "id": "1005005773748906", "locale": "en_US", "screenshots": [{"file_name": "HighresScreenshot00011.png", "id": "1326199667974786", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035386_1326199671308119_4397089309417940909_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTJ2D4DP0pcQ7kNvwGlG3Qt&_nc_oc=AdmjCmgDSPAT0isb_gKezFgtoqJA0VBgBSuvhqC59IjYhITewWnjezlPFCBzSR9O4u0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuoMLYvCNAyLjK10n80MYy-X3ecTm96POpXifh76EMvCg&oe=69A2EC5E"}, {"file_name": "HighresScreenshot00028.png", "id": "2412721535575051", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974577_2412721538908384_6467288184304840049_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3APH0lQ1-IQ7kNvwGQ7kTX&_nc_oc=AdlL-j4cCyZzHzbY48EbPtJPPr9mDiXBC5enyahbBmFIL1r_iKryop6nHBoOY9j0Vg8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvI42dMzX22TFlyVEadsdq5FKM8Xg3c6yRV-NoBn1AsOA&oe=69A2FCCF"}, {"file_name": "HighresScreenshot00014.png", "id": "997351624641332", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982456_997351627974665_2778603811108028476_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3cSCVyCRXkQ7kNvwGpEBQA&_nc_oc=AdmZ0piEhJxrHLc1Y8G_SbBcSlH3JOpoUKzvNYwfh5VbDIUMZEOnuru39Y0fDSVAL0I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuzzkcWzhVdLuqDaRWXCxRpDWIkG7IQHoQaYpRE0-hPFQ&oe=69A2EFA1"}, {"file_name": "HighresScreenshot00040.png", "id": "807733037419699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984472_807733040753032_763200239777074167_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMe3Bn5Cs38Q7kNvwFSppah&_nc_oc=Adl7924hBXnQcYtNxyvw6FJKf4j4b_YIr7u-XK7mOwx5BOg6z9NAReV5yoEO0jTii3M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu4_ozcDJkJs8cKsEKNLN6WjoRqbK66LJP_hPthBtSbJQ&oe=69A2DA78"}, {"file_name": "HighresScreenshot00146.png", "id": "163970600033098", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566678_163970603366431_5435931785999963108_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TBtXw5R6w8Q7kNvwHiluK3&_nc_oc=AdlbaRwAwxgmECosOTOT2SBuY-fbbcdXo4KR1gj2SwewtHj35xfb-1ggMebUlHdK5_U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvkkI1sHtK1_u3iPhD2n5IzgdjazEqEjtkscw9dtf-hcw&oe=69A2DEF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNvL5MxtVJkQ7kNvwHaaWsw&_nc_oc=AdneSC3jJ0XyyaE6uMgcS0uptvSZ1Vpw6ZtK-4toNIInzRnzlBTfpscHb6VoEkprtKQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsFNn4uXKp5EMr6sIxfs1zlqEdxZP5ioMUc1Xkuc95EcA&oe=69A2CF32"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "1324311035174797", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984472_1324311038508130_2610060411856834928_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHM-hsvpQcIQ7kNvwF6Ltsg&_nc_oc=Adk5MQdeBXJbMgqfzydKuI5i39INhqEMcCUajEtIIdMHG1PSOpBQOBkpz0n3bxPpoCA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuKFU2ySqhOJL_MoDpl6lzMUGJ7CwwC6944L_Um7M3pyQ&oe=69A2C7F8"}, {"file_name": "CoverImage_Portrait.png", "id": "1021944422558335", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031612_1021944425891668_3460677483354056217_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=beYxZtRFy6EQ7kNvwFm6C9l&_nc_oc=AdmKacO7I3YFpU-lJ4e8NooYSMuoif2RHIY4ZIiwK9tJgCIyR_YyEKvY0glY8XE0Ab4&_nc_zt=3&_n
://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NtLZlWomAIQ7kNvwGAoipA&_nc_oc=AdoGlGrtp2D1xLUGm93gdQz83sBgoPvH8dheNrJAUBwAoCu99Tg0e5C98mF081ePQo0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4V7RLvesMpgZ7N6iBwzqSwOiL-_SKU07k1Aq-LPgZYww&oe=6A1C4EE6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2GeDFvrMc9wQ7kNvwGU74R2&_nc_oc=AdoA5so2T-fhRocBQM_wqkgMAxfXaq0beLRQBll47WdwbtK-ImekMEunEbfAFlR_QxI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VVdLQzwIqZELrFfT8HpEYP64_VUdwl7W8Xjes2iCffQ&oe=6A1C4432"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlYaauoXQg8Q7kNvwHRFbzP&_nc_oc=AdoXJXXg3K5G8yB4SG5-R23akB88V6KE0bM_1r7j9i8ymq0b3hQC41yKVvr1ppfGAuU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QZfV5QWYKoP8KakREkzOe_1wf8lVMZ7c1Hn5Fyjk7xA&oe=6A1C3DFB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YaIBhnGYVMQ7kNvwHQ4CAf&_nc_oc=Ado8svhvyLK9N89wxA1kv5ut-xji_s-BN0dzaCR90jmU6lsQZnj--n2VAUQ38i7CPgU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5V9UQ8lVgBbF4Fem7Jg8VqjU5J6zOp_epyTWushp_Wug&oe=6A1C5373"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_bgjQ-UmV0Q7kNvwHpPQmK&_nc_oc=AdoTv61CS_9M5zDdOuyRoOiCZO2uYCHaEz8ttSmNKZ8JJTnuNAGI_7-_P_fcqOEjcXM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AxktAhl2QOTdaVH2lFtCNjx5GzK-FVQI84ThY_1VBxg&oe=6A1C5172"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCKR-nvqDhQQ7kNvwFljted&_nc_oc=Adq1DrermCPYjmS8of1Lc8VwIIlWvw5T9WYI1gz1IcZnWEjWEqNCwMNyGjZdJe7w3oA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IZQSAm6jBMVTnru14Tg8YxSzrH9QrOzPlwJawb2FvdQ&oe=6A1C48D3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoeC19QD5roQ7kNvwF63ttt&_nc_oc=Adr_8tGZxRA85RXuCYL4aixZ9jCwevw-eaW8Y7WFI2LeRh8mLhyYzLgG_aF1z2RmZUI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cnrNK1_ey8D3G_vg_afl6oGd4NmI9VxlOIWuEA8f1rA&oe=6A1C44EF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLqXoDChmZAQ7kNvwGG6ipQ&_nc_oc=Adr8ntlEotEy1CLDXlMVT71gRsqncRkYfQ8Pa9HC5Yv-00Kxpa_wNA8uzrU7u-FqdCY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IZre8kFBtdEW6JArRVqiDZiya9RDA3VJDqJQBcDMbuw&oe=6A1C50A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
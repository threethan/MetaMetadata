://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YA9C4ssr3g8Q7kNvwGSVbwO&_nc_oc=Adq-xjIqVnd8FXDpjanHlKx_2QPKiHys-rD1OmSPDV74PEkmZfKCYyLrhFJLiUu27QM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QogDn3YjkaJv43fre6RN7z5ZgKAXck9afIUf2R1aGYQ&oe=69FDFC66"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OetNdfLtJPYQ7kNvwHyaIlK&_nc_oc=AdoykaB2P05hy9SrlLFrN25voPqNfGBuf2gUwSfusW7kEpWsztY5jGSYwEzlLR_R7Fo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5O2DItUDJ6EuHTEeIZiKBX5dTck3R3vxevY_v-AuThRA&oe=69FDF1B2"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWtzgZw-LLwQ7kNvwHX3Uj2&_nc_oc=AdqBPvgavtiIQ_OSxM8A3HLieXxV8dK6OnBpKIqgYvysnKTnko2h5FSHPwZJaaVNN60&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UxkZzYP2-vv0IhMP2otpfaT33Uapytg2oDEDfj2wyfg&oe=69FDEB7B"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybgpRGzu1xMQ7kNvwETk8pV&_nc_oc=AdoKZ6BraW-3ZG6PujOP_c44YB44LUsfsK2VAZMp_vrfmdacDJgKJNS6x6P30NacMAI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60bSiKikCcHcuD_DAcEHPyPXNuXtsjsK13vhOhKz0a_A&oe=69FE00F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52AtH7rPXS0Q7kNvwHljySd&_nc_oc=AdphBjhQFxLLG58MF3ZnoL-B8hQ-mgEd5BPvonRhXcqvtYJNQfUtnhAY7eKFfG9cmc4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72J4_MtSkdbAR4afR1h9zm21LDhLWfH1WkJySbFhsCpA&oe=69FDFEF2"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-DNkzygpnwQ7kNvwG2gnaU&_nc_oc=AdpY_0qIBGtheRSaWXCk5z58jC5fopg8UEghjd3SAbMYYAetcqpRMYUfYdxUlISTVvI&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af590CdBfN6zKQ8xmJJdkr8KUyGGVtlVfUSj54ZZDr9zdQ&oe=69FDF653"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGT4gLG4XMkQ7kNvwFKNMEY&_nc_oc=AdoJXQse1LVTPX_iivALuX12WnAgo5InqQP3ZSSKRLwwmbOI06Sw5D8bxi8FZf7KZNc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CoL4gyEv7H4A_jDyIkxywhOGnMmi9lEVZ5dAd3FjMdw&oe=69FDF26F"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1oQSxSLafkQ7kNvwH-WJ_N&_nc_oc=AdqPlfIutJ-SZHzQ97EOe-1VjvbGH7bw-kaNKDjU8k4wIlyk5XhCR96x_vJokXD2GcA&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZCbVS2wuD8pVl9Zo2fKt4T3L-6AbA9qGcQar_5iCADg&oe=69FDFE22"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
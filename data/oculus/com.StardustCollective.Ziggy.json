://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75312297_643955654606405_480568527955268312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ey9R3jDzUJMQ7kNvwEa6Od4&_nc_oc=Adro8HMBejQlRZJm7DcactdxR6yywX4-0e6J18eT_uKv0_6r_IcaQ_9RaGfx0y_bdYg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tNUuapYS4yzGoaLKP504VSRvkaJE4F26RqCNMK5UoIw&oe=69EA35E6"}, {"file_name": "Master.00_00_34_53.Still005.png", "id": "868776144968854", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574721_868776148302187_2395318248093284663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWuski8Si3EQ7kNvwHRfvEN&_nc_oc=AdrJzm-134kUFItumjgZF7G7QMb6SBeGdPVmgEDS9lQCZ_-FbV1jORJLns9Qc0k7VRg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TFShe1HhLT0YdXDoyHfo8K05zMnfr0fTRzgTlXBuI6w&oe=69EA2B32"}, {"file_name": "Master.00_00_25_53.Still002.png", "id": "692760662818107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_692760666151440_1673600769700015261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjPwS4dF_MoQ7kNvwEA9QOk&_nc_oc=Adp0Zz_kdTfPrlZpIcAdsKSrSoH3Kc8EOfIxWKuKKyQNah67jYHfZUUzt95yJ8DEDuU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PwjQJUDQlzHOhiJiGluqaweABZI4BBsXED2BPyyg5eQ&oe=69EA24FB"}, {"file_name": "2023-07-01 19-38-56.mp4.00_05_33_04.Still001.png", "id": "1014728119759484", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974571_1014728126426150_3738956639406327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mT4C10reXMYQ7kNvwFo6PlT&_nc_oc=AdrX9KWwCCMmKdW76lx2Zm9vdOMnEhBylq3hfS3NFVtuj8fJx7tvbn0FjDERV3fSU5g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01jv7gTlgriwPd_ADb0aCoZ9fgkrtEW7M1Zf6jfr6XtQ&oe=69EA3A73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_End_Card-Recovered.png", "id": "273391962004750", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974788_273391965338083_1886064065722113930_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RaxToFlIqWoQ7kNvwEqPe_-&_nc_oc=AdqfxgS0OJZ8sxcAA_HBBY16N3P7gIPSlCQzv5sNHGX-OhT46p32NBCkuvQ3PqPdsOw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0o17bs_almcc0cd0J26aLkzEDwGid5u4ilePXWFTSgcA&oe=69EA3872"}, "display_name": "Ziggy's Cosmic Adventures", "keywords": ["Cockpit", "Alien", "Green", "Space", "Physics"], "long_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?\n\n\u2022 Become one with the ship: Immerse yourself in a cockpit packed full from ceiling to floor with distinct physics-based interactions (Though make sure to keep your eye on them all if you want to survive!).\n\n\u2022 Rebel against The Empire: Engage in thrilling dogfights as squads of enemies pursue you to re-capture the small green treasure aboard your ship - shoot bullets, launch bombs, and raise your shields. It's going to get bumpy!\n\n\u2022 Navigate the vacuum of space: Control the ship with a radical and easy-to-use virtual flight stick design, dodge your way through hazardous space environments, and don't forget to do a barrel roll!\n\n\u2022 The little guy: Who could forget your cosmic friend, Ziggy?! This mysterious creature is a perfect fuel source. You can also play with them, use them as a resource, feed them, and most importantly pet them!\n\n\u2022 The Journey: Fight your way through 13 unique levels total. Forge a different path each time by beating challenges and unlocking harder worlds en route.", "short_description": "Ziggy's Cosmic Adventures is a VR cockpit game combining ship management with action-arcade combat. You play as a (sometimes effective) bounty hunter with possibly questionable morals, currently in possession of a powerful little alien that you may or may not have stolen/liberated from the evil Empire. As the Empire closes in, you'll need to find a way to balance your ship's management with the onslaught of attacks. Do you have what it takes to survive?"}, {"images": {"nodes": [{"file_name": "Ziggy_Monoscopic.png", "id": "1296582511245835", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_1296582517912501_8438674573824683709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-oYnU-8kGBcQ7kNvwFYNEEx&_nc_oc=Adq-fS0jWKSodQ4nSMNA9S7zVn45ccdFkWJczWtJpWuokMX3sAbFX86M6azgevphcqw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3y-wofwGvwDqgDgZs25Py6Wp4zkf2hbvIULkkHO7239A&oe=69EA2FD3"}, {"file_name": "CoverSquare.png", "id": "1124369782419830", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_1124369785753163_6062844584904789074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4LqY5YjWT4Q7kNvwHwLEQN&_nc_oc=AdqbX0crVcZz4mb5BayR20yjQVty-gyMtxx8sVZ9_k1vSTSYWFdu4F_DRONRR6da2o4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DWbyxp0eWaYDABP1E6HFjspl9t6OLNewSXL0HpVglzg&oe=69EA2BEF"}, {"file_name": "Icon_v1.png", "id": "1106448921139578", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_1106448927806244_1890053882317213161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skFsZVQNVT8Q7kNvwFEsx8j&_nc_oc=AdrLnlywehBfAQTwM5rCPhJwvkMJY90KJMuzKBAqPl9HBO0n1qq-QHfbslhYld7Kb-k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Hk84-ubCEdU4WD3rF3wUCW9y5Z7vSKVp3zMXvgjBTqw&oe=69EA37A2"}, {"file_name": "Logo.png", "id": "973425620588096", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610716_973425627254762_521808747164
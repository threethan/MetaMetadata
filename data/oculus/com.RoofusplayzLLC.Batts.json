7a0a&_nc_ohc=iibOzjYBTTkQ7kNvwGWncfO&_nc_oc=Adpiogqzk_MnRR_FczDflTw_0wAjDWiW7wT2PfrgETvUWuSx7kJLbX00rZxz3mfP2t8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-HER7n9CJTON8CR7HWKXMknt1KqVWlEZ6YYuRYRjRdQ&oe=6A369D62"}, "display_name": "Batts", "keywords": [], "long_description": "This is a Gorilla Tag fan game called Batts. Batts is a free to play game where you can have fun with your friends. If your getting bored of how you look, spend a few dollars to buy cosmetics which are in game cloths/items, keep in mind these don't change you gameplay at all. This is a great game for making new friends or just hanging out with old friends. When your playing keep the rules in mind because you could get banned anywhere from a week all the way to forever. I hope if you decide to download this game you have a amazing time. BYE BYE", "short_description": "A gorilla tag fangame by Roofusplayz"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/battsprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Roofusplayz", "support_website_url": null, "website_url": "https://sites.google.com/view/battsofficial/batts", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7457675540954729"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031568_453188434049100_736692235034503
=00_Afvt3KwgCQlWosAsFl-ZIzpB7a6Uh8teXsJdMJMEu4ffTg&oe=69A446E2"}, "display_name": "Batts", "keywords": [], "long_description": "This is a Gorilla Tag fan game called Batts. Batts is a free to play game where you can have fun with your friends. If your getting bored of how you look, spend a few dollars to buy cosmetics which are in game cloths/items, keep in mind these don't change you gameplay at all. This is a great game for making new friends or just hanging out with old friends. When your playing keep the rules in mind because you could get banned anywhere from a week all the way to forever. I hope if you decide to download this game you have a amazing time. BYE BYE", "short_description": "A gorilla tag fangame by Roofusplayz"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/battsprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Roofusplayz", "support_website_url": null, "website_url": "https://sites.google.com/view/battsofficial/batts", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7457675540954729"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031568_453188434049100_7366922350345035966_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yP-fJIR6VOYQ7kNvwHMrYVk&_nc_oc=AdnU2ZdBTiYSKeOVzHCe_TW8eGWp6gZIiPikU8yY5DE8pvr2qdQVNqDYoTxhMzgaxK0
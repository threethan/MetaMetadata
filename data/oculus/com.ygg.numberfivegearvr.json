er.\n\nVisit our official site at :  www.ygg-cg.com\nLike us on Facebook at : www.facebook.com/YggGame\nSubscribe our YouTube at : https://www.youtube.com/channel/UCupqbZyFRH6BXDXT44l8grw\nCustomer Service Email : marketing@ygg-cg.com", "short_description": "The best FPS sci-fi shooter game for VR and mobile devices!"}]}, "developer_name": "Ygggame team", "developer_privacy_policy_url": "http://ygggame.wixsite.com/number5/privacy-policy", "developer_terms_of_service_url": "http://ygggame.wixsite.com/number5/copy-of-privacy-policy", "publisher_name": "Yggdrazil Group Co., Ltd", "support_website_url": null, "website_url": "http://ygggame.wixsite.com/number5", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "614256723200478"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138850_1789001584687510_103302527633588224_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFAKFoZKODIQ7kNvwFDew-X&_nc_oc=AdkQOEukBRfx9-yhCv78bvn_AJlqmpUY8KUhCbDVeue3elKNQJpG5B8Q7N25fXBCVYY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_JWRnRXQIJln7qdZoEWjso5Vd4pyddvq76FDM8f66Jw&oe=69AC1DF1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "NUMBER 5", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1547143200, "lastRevision": {"nodes": [{"id": "5527644715
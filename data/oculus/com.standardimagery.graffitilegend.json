20238789841_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxcZrl3IIrwQ7kNvwExfxS8&_nc_oc=AdkVYiaF7i1n9eT1oId3w86Tl0-iC5mjxRNt3Ofv0nd8EtnFLPgc1xUJ_gW2csc8kBE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuxmvzR65Fc4hm7Qd_l2AQv6D1sI6J-ITlNP_eqb1yoCQ&oe=699ED9E9"}, {"file_name": "03-Pic-GraffitiLegend.png", "id": "905278189030313", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819982_905278192363646_4524258545525534704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KylWNDHKDEwQ7kNvwEzUuVM&_nc_oc=AdnOpQIn1ScUiIsyy-RAsIHxaMgRil_jMJ4L5KmTU2W_d4ZIQGNMKaAtnj1fk7mBeTo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aftt0OaR_SwAwZaeK2Jo0t6_NELI-TnjtTbgy2ihaO-2lQ&oe=699EEF70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "copertina.png", "id": "1238647461459816", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819982_1238647468126482_7610170416135335513_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PEnLOr9OYgQ7kNvwHgKdqU&_nc_oc=Adn3M7wRbjgpxJU7Z9pT0UgQ8-VrrEuzyi3EgQ5c5p6HbFA4n6gXKCvTaYTONkuRTMg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfstvAHJHoClUTf7p7ZwBaUCQT4Y47FKPAkaPm9jadP0VQ&oe=699EE32F"}, "display_name": "GRAFFITI LEGEND", "keywords": [], "long_description": "Paint in VR. The can is the controller.\n\nGraffiti Legend VR is the creative engine that takes the art of writing to the next digital level.\n\nAn experience designed for those who want to create high-quality graffiti, with the same freedom and power of real spray paint.\n\nThe spray is recreated with absolute fidelity: from the pressure of the flow to the finest fades, all the way to the authentic flares that capture the true essence of writing.\n\nStep into GRAFFITI LEGEND VR and transform your style into spectacular digital pieces, where color, texture, and intensity merge with the raw energy of the streets. Become a true digital graffiti artist.\n\nCreate 100% legal digital graffiti \u2014 VR-only.", "short_description": "Graffiti Legend VR is the creative engine that takes the art of writing to the next digital level.\nAn experience designed for those who want to create high-quality graffiti, with the same freedom and power of real spray paint.\nStep into GRAFFITI LEGEND VR and transform your style into spectacular digital pieces, where color, texture, and intensity merge with the raw energy of the streets. Become a true digital graffiti artist.\n\n "}]}, "developer_name": "Alessio Lanini", "developer_privacy_policy_url": "https://www.graffitilegendvr.com/privacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "https://www.graffitilegendvr.com/", "support_website_url": null, "website_url": "https://www.graffitilegendvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25039926675686389"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821725_881723240899067_8068878790723419651_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9sb1cv7UVcQ7kNvwFCz-Ug&_nc_oc=AdmNhBNcNkIoEvLvJx0SMgw7l7k2IAAJdvrNPpf6xc6FXYUcYe-Yot_YKCcFoy03BFQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs6atQ4HugwDYEHqNLLMGQ1wRXkS5Lsyiy8rdDwBg1Zuw&oe=699F0373"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GRAFFITI LEGEND", "platform": "ANDROID_6DOF", "context_cat
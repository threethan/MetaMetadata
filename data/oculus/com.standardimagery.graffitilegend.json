20238789841_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Ss0xk5KLjoQ7kNvwFzSpDp&_nc_oc=Adn34Rnl5PIZcBJ2o5lB7KKcLngPiHLqS5-ScDyorUKN0jFwTTtHjXvtDjg7gXcVW3Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuUz-EoZj49VXcxpma9Pz4I9ppH9MN10zAafsiKfGAH4Q&oe=699D8869"}, {"file_name": "03-Pic-GraffitiLegend.png", "id": "905278189030313", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819982_905278192363646_4524258545525534704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KylWNDHKDEwQ7kNvwHOiPVs&_nc_oc=AdnLhB7z-Qq9BTacOyxApXOEC_-MJGDbM8LeDaBDQZcdp8fMEYlmlN3jJ02kPLtNino&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvpUdmwxvS_bVlNcDA1RjEtx0tD3Aa1Z6fwUEXCtHsRYA&oe=699D9DF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "copertina.png", "id": "1238647461459816", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819982_1238647468126482_7610170416135335513_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVf7vDe8g5cQ7kNvwECe5-d&_nc_oc=AdloICx4fdtTUztz3CtmqdMobn3r-lanRA7golYrMuZSIydXIH1vIHZGVwY_7sKU6m0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv_wRDRMwAN5Crtgy1_vwUXrjuiRwlvt-3To9Oyzyjgfw&oe=699D91AF"}, "display_name": "GRAFFITI LEGEND", "keywords": [], "long_description": "Paint in VR. The can is the controller.\n\nGraffiti Legend VR is the creative engine that takes the art of writing to the next digital level.\n\nAn experience designed for those who want to create high-quality graffiti, with the same freedom and power of real spray paint.\n\nThe spray is recreated with absolute fidelity: from the pressure of the flow to the finest fades, all the way to the authentic flares that capture the true essence of writing.\n\nStep into GRAFFITI LEGEND VR and transform your style into spectacular digital pieces, where color, texture, and intensity merge with the raw energy of the streets. Become a true digital graffiti artist.\n\nCreate 100% legal digital graffiti \u2014 VR-only.", "short_description": "Graffiti Legend VR is the creative engine that takes the art of writing to the next digital level.\nAn experience designed for those who want to create high-quality graffiti, with the same freedom and power of real spray paint.\nStep into GRAFFITI LEGEND VR and transform your style into spectacular digital pieces, where color, texture, and intensity merge with the raw energy of the streets. Become a true digital graffiti artist.\n\n "}]}, "developer_name": "Alessio Lanini", "developer_privacy_policy_url": "https://www.graffitilegendvr.com/privacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "https://www.graffitilegendvr.com/", "support_website_url": null, "website_url": "https://www.graffitilegendvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25039926675686389"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821725_881723240899067_8068878790723419651_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9sb1cv7UVcQ7kNvwEsw872&_nc_oc=AdkPftk-EZf_h7rpf8xy2u9BEfkoUlTolrOQv26BYgJhp-ti_SG0pZwWxuCuk_7kfDE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuCrQ7V49SAF5yy6RoxyyyORDbl9PZLuzNBvexWgUvHww&oe=699DB1F3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GRAFFITI LEGEND", "platform": "ANDROID_6DOF", "context_cat
5647_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JyYQnYcSAUoQ7kNvwFS7oKj&_nc_oc=AdoJBL2ErN28O9ugYe00MAKpLVI5Oko4TuJ_Xe6D8hHyyFthZltvzo2PBYTrCJK0GGE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTFZOxdrEFa_S6HnOJIc8XO6ITZ930f-uLDbJhMvnkRg&oe=6AFC91FE"}, {"file_name": "screenshot_4.png", "id": "1416705437265536", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831299_1416705440598869_8216576832112635594_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtMdrz3nUu0Q7kNvwEHT0nd&_nc_oc=AdoS25RyVrcFjTbtiqMiMsOxJ6OMyWtzY0KCADTLCvqYYo39mffx-O4elnJJsLG7X-U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkHnhN0isuS82PSugP5LPtgZkrgUNHfoC7kupcSHdDhA&oe=6AFC771E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1817090319322741", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/829188179_1817090322656074_6735475833351233322_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bdAHXlQmHMQ7kNvwGsbUuB&_nc_oc=AdrC3xRY0CkctZ71z76Z4GJGnQzXz_OM2ykU5-R7eTv8djLKlsqe4FKP2XlHMjFwkEY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_Ib43kp54OG2hdPQUVQco5R-IKGu0V_CQycCfV2A7_g&oe=6AFC8051"}, "display_name": "Motorcycle Simulator Minnesota", "keywords": ["motorcycle", "motorbike", "simulator", "minnesota", "racing"], "long_description": "The ride of your life, from the seat - all the way round Minneapolis.\n\nYOUR GARAGE\nStart astride your bike in a luxury three-car garage by I-394. Touch the throttle and the door lifts onto the road.\n\nTHE BIKE\nA litre-class sport bike: a live colour dash with speed, gear, lean angle and a map, two live mirrors, a smoked bubble screen.\n\nRIDE IT LIKE A REAL BIKE\nGrip the bars with your own hands. Roll your right wrist back to open the throttle, brake with your left hand, push the bars to lean into a corner. Tuck behind the screen for top speed, or turn wheelie control off and lift the front.\n\n39 KM OF REAL MINNEAPOLIS\nI-394 into downtown, I-94 north past North Loop, Broadway over the Mississippi through Northeast, then I-35W over the St. Anthony Falls Bridge with the falls and the Stone Arch Bridge beside you, past the stadium and down through the Lake Street trench, west on the Crosstown and north on Highway 100 by the Chain of Lakes.\n\nROAD EVENTS + SPEED TRAPS\nSeven events on real roads - race for gold against your own ghost bike. Six speed cameras, and Rush Hour near-miss combos on I-35W.\n\nSUNSET, DAY AND NIGHT\nGolden hour over the river, bright sun, or the city at night on your headlight with the traffic's tail lights ahead.\n\nYOUR WAY\nChoose how much the view leans, bar vibration on or off, automatic or a six-speed sequential box. Speeds in mph. English and Spanish.", "short_description": "Wake up in your own luxury garage, grab the bars of a litre sport bike and ride 39 km of real Minneapolis - I-394 into downtown, I-94 past North Loop, Broadway over the Mississippi, I-35W over the St. Anthony Falls Bridge, the Crosstown and Highway 100. Twist the throttle with your own wrist, lean into the bends, race road events against your own ghost. In English and Spanish."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/motorcyclesimulatorminnesota/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/motorcyclesimulatorminnesota/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVE
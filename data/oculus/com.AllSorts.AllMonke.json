f&oh=00_AQBQY8UlccvcN_m-GzNX5HKmXfesvzHXko4vAxB1zG6uyA&oe=6A510F09"}, "display_name": "All Monke", "keywords": [], "long_description": "This game has floor is lava where you can jump around and try not to get caught by the lava. It also has a don't fall game where you do parkour and if you fall you need to restart the game. There are many different levels of the parkour with more to come. There are many maps to explore and hang out with other monkeys in. Enjoy!", "short_description": "This is a fun Gorilla Tag based VR game where you can play fun games like floor is lava, parkour, and so much more to come. There are maps to explore. Un like other games feel free to escape the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1GI7ZAB5bDchjBDwz4fII5lLmPmGL5uGPImYkqO43XIc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "AllSortsVR", "support_website_url": null, "website_url": "https://allsortsvr.wixsite.com/all-monke", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1529869400815150"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974882_1712485285868142_2812573930470993063_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-HBQ-BjGDQQ7kNvwGNKiYO&_nc_oc=AdrOknAyZcQVAoxum-icTRNw4kG1Rb4T-ksZRgLEx5syANtCtuP
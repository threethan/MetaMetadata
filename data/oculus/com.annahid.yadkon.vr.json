_ohc=_dKFEZy4lLUQ7kNvwEfIFVa&_nc_oc=Adoqw3mXHeKIBoc_0hDTbjk2ZB98-yWYtg6e80ZZnIXtZIy1ALoh7VmIgTv7ZBd-T3c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXJBctECS2UU6vSmrjWE_L5ErsBXbpclB9Ueyj_bXnvA&oe=6ADCC972"}, {"file_name": "screenshot4.png", "id": "29271109632474632", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823310_29271109649141297_7977265845579411909_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iv2d63-e9FgQ7kNvwEd0NaY&_nc_oc=AdrbP2NeFBnHU2X7v-n5YLMD3U8DZCn-S0YJKkEGXZNkqvLsV_HPXSwFMIi6tSKb0Oo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPH-55Gf34DA9Po5xOyesHmWyfoRMPzBx8w7TdoCsDQHQ&oe=6ADCB19E"}, {"file_name": "screenshot5.png", "id": "1088797830417962", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824292_1088797837084628_2030138725379435615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hegLAB-WmuMQ7kNvwF-npKc&_nc_oc=AdoCV9O7ZS0HB3VeL3Ec7OszpklGhkFJa7k6OUPZNT9kUmCjlPv5aFuWO6oJBbqaFHg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfDGkwfhVz5rHKp_2v0cz-iGTi-ddvxncEOezVmeQjgg&oe=6ADCC176"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YadKon VR", "keywords": ["iran", "memorial", "politics"], "long_description": "YadKon VR is the interactive memorial space designed for standalone Meta Quest headsets. Created as an extension of the YadKon registry, this application provides a tranquil environment for visitors around the world to pay tribute and preserve the memory of individuals lost during protests and other human rights-related events in Iran.\n\nKey Features:\n\n- **Interactive Memorial Hall**: Walk through a serene, high-fidelity 3D environment dedicated to reflection and honor.\n- **Flower tributes**: Plant flowers in the memorial space of each individual.\n- **Standalone VR Experience**: Runs natively on Meta Quest 2, 3, 3S, and Pro without needing a tethered PC.\n- **6DOF Positional Motion**: Full room-scale navigation with i
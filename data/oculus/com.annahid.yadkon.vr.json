_ohc=hOYrFkyUXykQ7kNvwGKt2Ry&_nc_oc=AdoK1Ux9XE4dOfi3ye9DH3lD4q2hCJmsQ-UpyNHbQOIdZZAktS4Vsh7NcA300Wma7NY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQglN8cLj-WDG7fAImBJ4dkQw5AdfDrRdT4PF4REYo2tw&oe=6AF08FF2"}, {"file_name": "screenshot4.png", "id": "29271109632474632", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823310_29271109649141297_7977265845579411909_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vc64_WWqjxYQ7kNvwG0PTRa&_nc_oc=Adq4x5TWXtGQGn5_8A-mUfj57WDlV_HFWDKJGx3pGpmu55bt56_HBMfRu0volL6bOU4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQE3ID1SawdV3RbKnR9O0ec9zD2XuaY8x1UOoJBXnEHeA&oe=6AF0B05E"}, {"file_name": "screenshot5.png", "id": "1088797830417962", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824292_1088797837084628_2030138725379435615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPN-_3cPhtoQ7kNvwErLiFf&_nc_oc=Adq7hA7T085mH5b-fQojfaReMwkmJOaRHV-QxsLGvkaRPZxrHOylY3c4zuuE9pwxVHs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi5UO6EKkHCi0cmI8cPxjT80Yhvv7YSEraiKrFBNAaAQ&oe=6AF087F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YadKon VR", "keywords": ["iran", "memorial", "politics"], "long_description": "YadKon VR is the interactive memorial space designed for standalone Meta Quest headsets. Created as an extension of the YadKon registry, this application provides a tranquil environment for visitors around the world to pay tribute and preserve the memory of individuals lost during protests and other human rights-related events in Iran.\n\nKey Features:\n\n- **Interactive Memorial Hall**: Walk through a serene, high-fidelity 3D environment dedicated to reflection and honor.\n- **Flower tributes**: Plant flowers in the memorial space of each individual.\n- **Standalone VR Experience**: Runs natively on Meta Quest 2, 3, 3S, and Pro without needing a tethered PC.\n- **6DOF Positional Motion**: Full room-scale navigation with intuitive Touch Controller interactions.\n\nPurpose & Mission:\n\nYadKon serves as a digital monument and historical archive. It offers a respectful, quiet space for family members, international supporters, and human rights advocates to connect, reflect, and ensure that no name is forgotten.", "short_description": "A virtual reality memorial dedicated to honoring and preserving the memory of the fallen heroes of Iran."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yadkon.com/vr/privacy?lang=en", "developer_terms_of_service_url": null, "publisher_name": "YadKon", "support_website_url": null, "website_url": "https://www.yadkon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "1425208844001972"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823949_1718773362549556_3546915000308292682_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8g2AWs7e7J4Q7kNvwGAS7aX&_nc_oc=AdoDZjOGPh-LPyFQb33ObrZhcDYFm4WMdpEKaUXV1tdw9VCJn8ZziJMrUIcuuob3Y7g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqxcc3_1zO3NgJJQjJsu5FY1Wm4VQnjpCyg1YG4CVLDQ&oe=6AF0A2F6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "YadKon VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [], "
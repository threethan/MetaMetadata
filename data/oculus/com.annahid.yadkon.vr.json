&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQB00AeagCMbyJRIHhgqd7x0ddX4yslYjvv8sR9QnXvmQ&oe=6B006885"}, {"file_name": "screenshot3.png", "id": "1091516593510696", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825470_1091516596844029_7663871741436971070_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hD0JvY_Xh7gQ7kNvwGPpRaN&_nc_oc=AdqdT9QlZ7oqCUX0vFBxAtpLsValhZq8n5Cjdz_ltVzhGAR7S5I_L_dy7oW9oZA9ZpI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3tt943Yk3mlZ5nA99DqfM_E4VeCW7_vuxdEeSYCGR-g&oe=6B0061F2"}, {"file_name": "screenshot4.png", "id": "29271109632474632", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823310_29271109649141297_7977265845579411909_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCt7oEXoR3UQ7kNvwEcFC2v&_nc_oc=AdrETsrL7ZqL9kfVkVhn8dKZEt9SbtEg8wEkj9O8RS0A1eWC-mbcg-5Xl90q9GdssEs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaMlgqSWj5aGUIbW6F6L40o_jWD-lPdf3Yk9QRQoAJEQ&oe=6B00825E"}, {"file_name": "screenshot5.png", "id": "1088797830417962", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824292_1088797837084628_2030138725379435615_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RGlNMf-BjsQ7kNvwHAPB17&_nc_oc=Adrn1X7vY6DF_ju8u-0BS6oPMsQIIKMe0pBrYP54rUEHFsEQ4vNCf5CNS2cpcTO1HT4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNfTXmEvlPyMJnsAKt0ltzLgSqNQUwmTT0Ck1MHJaoKQ&oe=6B0059F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YadKon VR", "keywords": ["iran", "memorial", "politics"], "long_description": "YadKon VR is the interactive memorial space designed for standalone Meta Quest headsets. Created as an extension of the YadKon registry, this application provides a tranquil environment for visitors around the world to pay tribute and preserve the memory of individuals lost during protests and other human rights-related events in Iran.\n\nKey Features:\n\n- **Interactive Memorial Hall**: Walk through a serene, high-fidelity 3D environment dedicated to reflection and honor.\n- **Flower tributes**: Plant flowers in the memorial space of each individual.\n- **Standalone VR Experience**: Runs natively on Meta Quest 2, 3, 3S, and Pro without needing a tethered PC.\n- **6DOF Positional Motion**: Full room-scale navigation with intuitive Touch Controller interactions.\n\nPurpose & Mission:\n\nYadKon serves as a digital monument and historical archive. It offers a respectful, quiet space for family members, international supporters, and human rights advocates to connect, reflect, and ensure that no name is forgotten.", "short_description": "A virtual reality memorial dedicated to honoring and preserving the memory of the fallen heroes of Iran."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yadkon.com/vr/privacy?lang=en", "developer_terms_of_service_url": null, "publisher_name": "YadKon", "support_website_url": null, "website_url": "https://www.yadkon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "1425208844001972"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823949_1718773362549556_3546915000308292682_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLY3raqE_
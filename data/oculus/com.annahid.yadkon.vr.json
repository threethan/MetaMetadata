_ohc=-7ZviyPlhNoQ7kNvwHt90XQ&_nc_oc=Adr7pwd5aEcSXztqhuDqD30wY_jVC74PQccgzbsMRjfibGogrgd-tygUs5xngQUjKRk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7LvtaiHjQWcRCglUn_OQTxgcXh0L63lDQHoF_H9rwDg&oe=6AE0BDF2"}, {"file_name": "screenshot4.png", "id": "29271109632474632", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823310_29271109649141297_7977265845579411909_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MzY82i2asQQ7kNvwEm2DOx&_nc_oc=Adp_IvfthnUo6jREPtnj_YvqHrS5DKAZxLdF8y2jnYP_IQVerzBSEc_3BFEKsv1e_xQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWcvts7DORxglqLhn_wEzP-2k2KChhB3WSHdceVnIM4g&oe=6AE0A61E"}, {"file_name": "screenshot5.png", "id": "1088797830417962", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824292_1088797837084628_2030138725379435615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuMN2jRRQ1gQ7kNvwHoqNHk&_nc_oc=AdoL2NMCDd0GDiVN7Ttd5sx6XYMpU_yKo7DmnYL7iL-zjkixLUhd-tLOEHiaTf7kswo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP36sNiEU9OR4DZSYlzsneos6DOvbF-zYvRVJEtGHstGw&oe=6AE0B5F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YadKon VR", "keywords": ["iran", "memorial", "politics"], "long_description": "YadKon VR is the interactive memorial space designed for standalone Meta Quest headsets. Created as an extension of the YadKon registry, this application provides a tranquil environment for visitors around the world to pay tribute and preserve the memory of individuals lost during protests and other human rights-related events in Iran.\n\nKey Features:\n\n- **Interactive Memorial Hall**: Walk through a serene, high-fidelity 3D environment dedicated to reflection and honor.\n- **Flower tributes**: Plant flowers in the memorial space of each individual.\n- **Standalone VR Experience**: Runs natively on Meta Quest 2, 3, 3S, and Pro without needing a tethered PC.\n- **6DOF Positional Motion**: Full room-scale navigation with i
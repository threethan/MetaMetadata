_ohc=-7ZviyPlhNoQ7kNvwFdL3mf&_nc_oc=Adr-FvzHz8VYMZKsQDBj6HdlrDt0ItlNOmzoJLOsDO0UHM9uiQ40lVwwiuTee2JPydE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbwy79l9W1sXy6ecQvWdb_9vV--_2Py_6KvgP1Sgc6rw&oe=6AE360F2"}, {"file_name": "screenshot4.png", "id": "29271109632474632", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823310_29271109649141297_7977265845579411909_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MzY82i2asQQ7kNvwGEwz1l&_nc_oc=AdoicI5pzqFu9jZOLl1PQU72fRxJAWt1G17_j5NcGazHVGAw0UQ4fbZVSIJB2QOehn8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBKV51HMGl2KGSJBO_gstSYxWRexngmLrU0296YMOSDg&oe=6AE3491E"}, {"file_name": "screenshot5.png", "id": "1088797830417962", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491824292_1088797837084628_2030138725379435615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuMN2jRRQ1gQ7kNvwGQUoNp&_nc_oc=AdoxQIFRzcMJxKSte1MbAzu9-1YY6wrsYgTlqLA57BIK5lBLE18fKuh4Zt_P9iBiHAA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFxKGFWcPn0iyilTPdLcqthNOrvnMlrbguYCO9dm_oVw&oe=6AE358F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YadKon VR", "keywords": ["iran", "memorial", "politics"], "long_description": "YadKon VR is the interactive memorial space designed for standalone Meta Quest headsets. Created as an extension of the YadKon registry, this application provides a tranquil environment for visitors around the world to pay tribute and preserve the memory of individuals lost during protests and other human rights-related events in Iran.\n\nKey Features:\n\n- **Interactive Memorial Hall**: Walk through a serene, high-fidelity 3D environment dedicated to reflection and honor.\n- **Flower tributes**: Plant flowers in the memorial space of each individual.\n- **Standalone VR Experience**: Runs natively on Meta Quest 2, 3, 3S, and Pro without needing a tethered PC.\n- **6DOF Positional Motion**: Full room-scale navigation with i
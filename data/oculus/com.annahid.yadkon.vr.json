_ohc=PBjbW4v0TLoQ7kNvwHgOVBx&_nc_oc=AdqfviaTt5z-yqK5xfH6hm5SL2qVydQNDwBU-3V0ahUmQdI3OSLcjx45VsUzqBoivDU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRF_qNixal1iOXVREzsSwsZkAfv0iQzITmK_NZkEIWVuA&oe=6AE8A6F2"}, {"file_name": "screenshot4.png", "id": "29271109632474632", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823310_29271109649141297_7977265845579411909_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmGdJzYHvcEQ7kNvwGIDumG&_nc_oc=AdrdZxeiPzm5z_lFBDe9zL_RnusZN1L5V97CMFafTrOYenCEYQlplzxL9v-wwY7fC0M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXK_C-S4mxPlS7YscA3bsBQnBEm9Rq1isLVCwo4hG7Jg&oe=6AE88F1E"}, {"file_name": "screenshot5.png", "id": "1088797830417962", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824292_1088797837084628_2030138725379435615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLwFl6QbtIwQ7kNvwFQ5J1u&_nc_oc=AdqoMdG-AWB6GSaGuKnVzNAqBrO0kZKpZ4osbMNJvmW582noE7aEE5_gaRKNQKn9THo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJXXBSjmhlAoxMPz_NcN1BpzoSddf1OvjjXuEjN77czw&oe=6AE89EF6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YadKon VR", "keywords": ["iran", "memorial", "politics"], "long_description": "YadKon VR is the interactive memorial space designed for standalone Meta Quest headsets. Created as an extension of the YadKon registry, this application provides a tranquil environment for visitors around the world to pay tribute and preserve the memory of individuals lost during protests and other human rights-related events in Iran.\n\nKey Features:\n\n- **Interactive Memorial Hall**: Walk through a serene, high-fidelity 3D environment dedicated to reflection and honor.\n- **Flower tributes**: Plant flowers in the memorial space of each individual.\n- **Standalone VR Experience**: Runs natively on Meta Quest 2, 3, 3S, and Pro without needing a tethered PC.\n- **6DOF Positional Motion**: Full room-scale navigation with i
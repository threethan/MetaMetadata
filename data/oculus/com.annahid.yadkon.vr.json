&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHj7_bm3uErpq1ihirlbwrZ3XaDiYwN1RoMZkMP3MJYg&oe=6B070005"}, {"file_name": "screenshot3.png", "id": "1091516593510696", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825470_1091516596844029_7663871741436971070_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVQthJINvLEQ7kNvwFIZGVE&_nc_oc=Ado3x-R1iuUhfEdyGo3FchTt6DfnklRcJJcsI5WoLJXYIkj0tjhr0Wg-dUX6dcqnIAI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTovxMU-gMPR6y1826Xk0VAeRUj2MjS32ORRjRIJ0Z5aw&oe=6B06F972"}, {"file_name": "screenshot4.png", "id": "29271109632474632", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823310_29271109649141297_7977265845579411909_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIWal1_bemAQ7kNvwGOzH-z&_nc_oc=AdoEMDsuDC4k9fvsXFYDFF-3bfMXQaFCO22RH1zEHTrF3nNxFpDy5QZTOJ3_QgSt1pg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1LYyTQLleYBvURGC_MvPgUJhap-8BP9oCmRaYrDZl9w&oe=6B0719DE"}, {"file_name": "screenshot5.png", "id": "1088797830417962", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824292_1088797837084628_2030138725379435615_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afBZJjGSlAsQ7kNvwH2TD4w&_nc_oc=AdrQ5srkjkq8NusnifWvMTuYX0G6ZvrPgafszX_p_OGoGwMQC1zpKmyw9XWPr-Hdvko&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdxZ7pxLoNGZkbiDV34O2j_6uloLOdEupZziJkfDjqkg&oe=6B0729B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YadKon VR", "keywords": ["iran", "memorial", "politics"], "long_description": "YadKon VR is the interactive memorial space designed for standalone Meta Quest headsets. Created as an extension of the YadKon registry, this application provides a tranquil environment for visitors around the world to pay tribute and preserve the memory of individuals lost during protests and other human rights-related events in Iran.\n\nKey Features:\n\n- **Interactive Memorial Hall**: Walk through a serene, high-fidelity 3D environment dedicated to reflection and honor.\n- **Flower tributes**: Plant flowers in the memorial space of each individual.\n- **Standalone VR Experience**: Runs natively on Meta Quest 2, 3, 3S, and Pro without needing a tethered PC.\n- **6DOF Positional Motion**: Full room-scale navigation with intuitive Touch Controller interactions.\n\nPurpose & Mission:\n\nYadKon serves as a digital monument and historical archive. It offers a respectful, quiet space for family members, international supporters, and human rights advocates to connect, reflect, and ensure that no name is forgotten.", "short_description": "A virtual reality memorial dedicated to honoring and preserving the memory of the fallen heroes of Iran."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yadkon.com/vr/privacy?lang=en", "developer_terms_of_service_url": null, "publisher_name": "YadKon", "support_website_url": null, "website_url": "https://www.yadkon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "1425208844001972"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823949_1718773362549556_3546915000308292682_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCCm6q88C
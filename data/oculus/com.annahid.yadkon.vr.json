_ohc=PBjbW4v0TLoQ7kNvwEuuH07&_nc_oc=Adretq5VI2mVP8Bcf3kyJ2jGK3qSAu-yter87fR6EXJ093kwNtlqvyUfWwseFmVMjhQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoXeXLHMYn_92HmN6_oKMa6PQzTZ7f4eWoVpSA6In3ng&oe=6AEB49F2"}, {"file_name": "screenshot4.png", "id": "29271109632474632", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823310_29271109649141297_7977265845579411909_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmGdJzYHvcEQ7kNvwGqT-p0&_nc_oc=Adpe-QGleZJIO3LysMLVY_RuH_lMSp-KwCd9ESx0F8mdNGHDbW918DH01e2efbN1erU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKVMdoiHBeT-eKsWebZ8wgttNFvlZdFTuSrfZyIjOHjw&oe=6AEB321E"}, {"file_name": "screenshot5.png", "id": "1088797830417962", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824292_1088797837084628_2030138725379435615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLwFl6QbtIwQ7kNvwGvymiT&_nc_oc=AdojoTm0lEyzmUUetPRcAf5fHg8dbLwaocBqZaS_Y2aexLwrq9z5bf1hJjDjkX558-0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQltRZJcl8GwD19YlaQABtzlPvu7N4xmgT0qLhHGkM3sg&oe=6AEB41F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YadKon VR", "keywords": ["iran", "memorial", "politics"], "long_description": "YadKon VR is the interactive memorial space designed for standalone Meta Quest headsets. Created as an extension of the YadKon registry, this application provides a tranquil environment for visitors around the world to pay tribute and preserve the memory of individuals lost during protests and other human rights-related events in Iran.\n\nKey Features:\n\n- **Interactive Memorial Hall**: Walk through a serene, high-fidelity 3D environment dedicated to reflection and honor.\n- **Flower tributes**: Plant flowers in the memorial space of each individual.\n- **Standalone VR Experience**: Runs natively on Meta Quest 2, 3, 3S, and Pro without needing a tethered PC.\n- **6DOF Positional Motion**: Full room-scale navigation with i
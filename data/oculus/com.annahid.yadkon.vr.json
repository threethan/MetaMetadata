_ohc=_dKFEZy4lLUQ7kNvwFotdtT&_nc_oc=AdoAIE5XKN6vOw1YD_2QlrcxflHH7UugD8fErdttCTAgICNMcEsO1lRwc57VDp3lol8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvEeWTsDX0kmNb_y9HFD0Nd9IpOubCZEdtMECKbwzukw&oe=6ADE1AF2"}, {"file_name": "screenshot4.png", "id": "29271109632474632", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823310_29271109649141297_7977265845579411909_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iv2d63-e9FgQ7kNvwFEUKF2&_nc_oc=AdpgGW7BwLiHd9p1DjPWIXT1L1KWw1fEGGFMdRL0A10cz7JhuJheBwUCNSXHikXcxFA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMf9rm_oQ2r80b7jF4Mavf5S8HopL-VPpLrBud5IHxKyg&oe=6ADE031E"}, {"file_name": "screenshot5.png", "id": "1088797830417962", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824292_1088797837084628_2030138725379435615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hegLAB-WmuMQ7kNvwG7rH0G&_nc_oc=AdpZU2zvK3LVsEplLknuygG7uYSa8YE0YBWMCYga6zJXNjkO5JPIbnZgIh8zJNGi_y4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNu1Wq6yPTxz71ZlqGlqX3_muDqJpno31_l2XU8p8zcxw&oe=6ADE12F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YadKon VR", "keywords": ["iran", "memorial", "politics"], "long_description": "YadKon VR is the interactive memorial space designed for standalone Meta Quest headsets. Created as an extension of the YadKon registry, this application provides a tranquil environment for visitors around the world to pay tribute and preserve the memory of individuals lost during protests and other human rights-related events in Iran.\n\nKey Features:\n\n- **Interactive Memorial Hall**: Walk through a serene, high-fidelity 3D environment dedicated to reflection and honor.\n- **Flower tributes**: Plant flowers in the memorial space of each individual.\n- **Standalone VR Experience**: Runs natively on Meta Quest 2, 3, 3S, and Pro without needing a tethered PC.\n- **6DOF Positional Motion**: Full room-scale navigation with i
_ohc=4LJnUr_rBF8Q7kNvwFf8DfP&_nc_oc=AdonDEX8As3LzPDiihwcJWKaySJn7lseeT0YF1RF3vz3oqzoURrwlDUslOz17dB7GII&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGuBwiSBgxoddVLYG7kxV5MOcbSZLiW9qDfW4hn8uc1g&oe=6AEDECF2"}, {"file_name": "screenshot4.png", "id": "29271109632474632", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823310_29271109649141297_7977265845579411909_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oj5eR4pWDSYQ7kNvwFnpI5u&_nc_oc=AdrihZRaGE_y_UfUwsgAKIA5y6pqBsYsHYZEhpl6BHAuiKLpkQM_l6oVEvGozpXwf08&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNGfwnZhpXIsWoqt8nDdm99lDHvmE79EWDOGS-pBZ_ow&oe=6AEE0D5E"}, {"file_name": "screenshot5.png", "id": "1088797830417962", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824292_1088797837084628_2030138725379435615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FyzygihApAMQ7kNvwEcNzvd&_nc_oc=AdoY9gwH2DoXnTp4KGOka2PcLP5tQk3i5BWP2UAa0AU-NCoDk3p3eFMBWEPclvDvhPg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_7eIb2j1--PXJKt9mg2aL4cPgYV7iJFPdU9hgJ-tzPw&oe=6AEDE4F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YadKon VR", "keywords": ["iran", "memorial", "politics"], "long_description": "YadKon VR is the interactive memorial space designed for standalone Meta Quest headsets. Created as an extension of the YadKon registry, this application provides a tranquil environment for visitors around the world to pay tribute and preserve the memory of individuals lost during protests and other human rights-related events in Iran.\n\nKey Features:\n\n- **Interactive Memorial Hall**: Walk through a serene, high-fidelity 3D environment dedicated to reflection and honor.\n- **Flower tributes**: Plant flowers in the memorial space of each individual.\n- **Standalone VR Experience**: Runs natively on Meta Quest 2, 3, 3S, and Pro without needing a tethered PC.\n- **6DOF Positional Motion**: Full room-scale navigation with i
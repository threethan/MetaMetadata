_ohc=4LJnUr_rBF8Q7kNvwEqjhoK&_nc_oc=AdoCq-usNE7eb0Z9PTzeNKwVXbXpPliVhxfa4V7pRyuEQ96H-KWshgure8rIn8uRSmY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-DyPHwE5_tfM0r_kOQnzzoi2LA5K45YDlMjybnefkSQ&oe=6AEF3E72"}, {"file_name": "screenshot4.png", "id": "29271109632474632", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823310_29271109649141297_7977265845579411909_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oj5eR4pWDSYQ7kNvwFYMONO&_nc_oc=AdqTR_Sbef5qRZwdePPTqjCSnBA4oy6Nn5gsI12su1eoWH4oDQCUvLID41-YFQb1upw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcpcVuB9iWmJsGulHi9xDtCyyqTcl2efIUu5CrTvCsLQ&oe=6AEF5EDE"}, {"file_name": "screenshot5.png", "id": "1088797830417962", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824292_1088797837084628_2030138725379435615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FyzygihApAMQ7kNvwFBRRPf&_nc_oc=Adr5B2PXT-g8W_zRMkVg8NPOEzlAnW--CLZxovxPBDTQ6aA-r8BG12UHkDK5GsO7i9U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-p-JXFyFbjXfoiZ98zabg2ubwkq7v1m0njIAdZ1kmNw&oe=6AEF3676"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YadKon VR", "keywords": ["iran", "memorial", "politics"], "long_description": "YadKon VR is the interactive memorial space designed for standalone Meta Quest headsets. Created as an extension of the YadKon registry, this application provides a tranquil environment for visitors around the world to pay tribute and preserve the memory of individuals lost during protests and other human rights-related events in Iran.\n\nKey Features:\n\n- **Interactive Memorial Hall**: Walk through a serene, high-fidelity 3D environment dedicated to reflection and honor.\n- **Flower tributes**: Plant flowers in the memorial space of each individual.\n- **Standalone VR Experience**: Runs natively on Meta Quest 2, 3, 3S, and Pro without needing a tethered PC.\n- **6DOF Positional Motion**: Full room-scale navigation with i
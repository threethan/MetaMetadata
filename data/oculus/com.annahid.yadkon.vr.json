_ohc=4LJnUr_rBF8Q7kNvwGbPVY5&_nc_oc=AdoydcY01knA2uunY6unfNAsMZFr4W2H0z0WPOYcZ7quEYw9L1_l-IUptQHtrhh-fSk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ967N1jaoccM8t-Q69RTuerykmtCYwocWWESetX-BpGQ&oe=6AEC9B72"}, {"file_name": "screenshot4.png", "id": "29271109632474632", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823310_29271109649141297_7977265845579411909_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oj5eR4pWDSYQ7kNvwGclL46&_nc_oc=AdrP_PGpj6mcFvIEiNEZhzG1q6Biqwy_ImYB7OCu2kbz-aoq7VHxpSukyVOBxYL64kk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCi5ArZmEVux4JHDb3UYnWvdxeH-vI_YKeA7xSRIobsw&oe=6AECBBDE"}, {"file_name": "screenshot5.png", "id": "1088797830417962", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824292_1088797837084628_2030138725379435615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FyzygihApAMQ7kNvwE7mW3N&_nc_oc=Ado2m4vrPDkuDfsSepILvmEWUonBqNr4cWL9CCkS4pAl0OMQLD9-oNDIO-gSVID9HiI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrRySr8veaNd0Qo9_qYX1vu10KQkGgNVqLgKigYXyyuw&oe=6AEC9376"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YadKon VR", "keywords": ["iran", "memorial", "politics"], "long_description": "YadKon VR is the interactive memorial space designed for standalone Meta Quest headsets. Created as an extension of the YadKon registry, this application provides a tranquil environment for visitors around the world to pay tribute and preserve the memory of individuals lost during protests and other human rights-related events in Iran.\n\nKey Features:\n\n- **Interactive Memorial Hall**: Walk through a serene, high-fidelity 3D environment dedicated to reflection and honor.\n- **Flower tributes**: Plant flowers in the memorial space of each individual.\n- **Standalone VR Experience**: Runs natively on Meta Quest 2, 3, 3S, and Pro without needing a tethered PC.\n- **6DOF Positional Motion**: Full room-scale navigation with i
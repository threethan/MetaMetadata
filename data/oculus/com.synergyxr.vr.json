h=00_AQGh79JCkpq4l3CgGgkp7YyqIrWAC8hYe3BwKHSSNVoGJw&oe=6A8C168A"}, {"file_name": "Image-4.png", "id": "3818475351563498", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003269_3818475361563497_2776151657622171618_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8avX7esJ-oQ7kNvwFwmbM2&_nc_oc=Adqtv2kmIaCVDSeaopo8f7w4x5hTltNx9zF-6TEQQ35IYGmvbeQ9x8am7To0LBH_Opo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHo0FiC6x5HJ1o7IV2DTOsPBY-PSl8J8VulgRujLVWN3g&oe=6A8C12D3"}, {"file_name": "Image-5.png", "id": "3792082917543307", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031609_3792082927543306_9186868645837235939_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7E9F2j0pWEQ7kNvwEPSen2&_nc_oc=AdoGmOGLWzifj8lLOBf15W7MRfPQ-O87X22I85tMK-9prwIAP7KvV8q9uNHiIK9cqvg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSBWGgblTp2XFFbn2D5ZFm5WoQn86SGf7If2HZrGXA_g&oe=6A8C2379"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SynergyXR", "keywords": [], "long_description": "SynergyXR gives users a DIY XR toolbox that lets them easily create their own VR meeting space and add a wide range of interactive content like 3D models, pdf documents, images, and even videos.  \n\nUsers can interact with the content manager to drop content anywhere in the space. Users can also resize, place and interact with content, including playing videos and writing on virtual whiteboards. Even better, you can step inside 3D models to get a fully immersive experience.\u200b  \n\nSynergyXR is free to download but requires a subscription to access. For subscription options, please contact: https://www.synergyxr.com/speakwithsales", "short_description": "In a world where the need for human connection has never been greater, SynergyXR is harnessing the power of XR to help people discover new ways to connect, collaborate and learn. \u200b\u200b \n\nWhether you need to bring your global team together for daily meetings, or need to review the design for a piece of heavy machinery, SynergyXR has you covered. \n\nSynergyXR is free to download but requires a subscription to access. For subscription options, please contact: https://www.synergyxr.com/speakwithsales"}]}, "developer_name": "SynergyXR", "developer_privacy_policy_url": "https://synergyxr.com/privacy-policy/", "developer_terms_of_service_url": "https://synergyxr.com/terms-and-conditions/", "publisher_name": "SynergyXR", "support_website_url": null, "website_url": "https://www.synergyxr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "428928275645918"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1022377918578593"}]}, "baseline_offer": {"id": "1022377918578593"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1627068240, "status": "PUBLISHED", "id": "1022377918578593"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "36266822612933086", "version": "3.6.0"}, "id": "2892576187642885", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5191119437596810", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "36266822612933086"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2892576187642885"}]}, "change_log": "Improved skybox for Physical Spaces\r\n\u2022\tThe skybox for Physical Spaces presented some minor issues with lighting and reflections\r\n\u2022\tThis has been improved to give a much better visual experience \u2013 especially for highly reflective objects\r\nProcedure panel \r\n\u2022\tThe procedure panel that end-users interact with has had a makeover.\r\n\u2022\tSkipping in procedures now happens by chapter.", "created_date": 1780901488, "id": "36266822612933086", "version": "3.6.0", "version_code": 93, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5191119437596810", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "36266822612933086"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2892576187642885"}]}, "change_log": "VR passthrough\n\u2022\tUsers can now enjoy passthrough in SynergyXR on compatible VR headsets allowing users to see their physical surroundings while using SynergyXR.\n\u2022\tThe main menu is now presented in passthrough.\n\u2022\tIf creating a new Physical Space on a VR headset, the user stays in passthrough mode and can freely start placing virtual objects in the space and save any changes.\n\u2022\tIf opening an existing Physical Space on a VR headset, the content of the space is automatically placed in front of the user, with the option to further adjust the placement.\n\u2022\tUsers always has the option to manually align the content of a Physical Space \u2013 this can be done via the button on the wrist menu under \u201coptions\u201d\nRemoved \u201cBeacons\u201d from SynergyXR\n\u2022\tBeacons have been removed as they saw little use and better alternatives are now available. \n", "created_date": 1774253678, "id": "34571285272486837", "version": "3.5.0", "version_code": 92, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5191119437596810", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "36266822612933086"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2892576187642885"}]}, "change_log": "3.4.3 \n\u2022\tFixed an issue in VR where users were offset by their physical movement when being moved by \u201cmove user action\u201d.   \n3.4.2 \n\u2022\tFixed a bug causing Question operation to freeze the procedure playback.\n3.4.1 \n\u2022\tFixed an issue connecting to multiplayer service on some network configurations.\n3.4.0 \nNew Operation: Question\n\u2022\tIn procedures we now support a new operation, the question operation. This allows the trainee to be evaluated on specific knowledge during the procedure. \nNew Action: Move users\n\u2022\tIn procedures we now support a new operation, the move user operation. This allows the users to be moved around the space during the procedure without having to navigate the space themselves. \nFade when skipping Steps in a Procedure\n\u2022\tEvery time a user skips a Step or fast-forwards to a particular Step the user\u2019s view is briefly faded to black \u2013 the same experience when the Move users Actions is executed.\nVR wrist menu improvements\n\u2022\tWe made the buttons easier to interact with - the buttons are now pressable when entered from the side but do not trigger on first press directly\n\u2022\tThe size of the buttons has been reduced slightly, and the depth of the buttons has been reduced making them easier to directly press\nScenarios discontinued\n\u2022\tAt SynergyXR, we continuously evolve the platform by introducing new features that better meet the needs of our users. As part of this process, certain features become redundant when replaced by more powerful alternatives. This is the case for Scenarios, which are now fully covered (and improved upon) by Procedures.\n", "created_date": 1767688669, "id": "33265033146445396", "version": "3.4.3", "version_code": 91, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5191119437596810", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "36266822612933086"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2892576187642885"}]}, "change_log": "3.4.2 \n\u2022\tFixed a bug causing Question operation to freeze the procedure playback.\n3.4.1 \n\u2022\tFixed an issue connecting to multiplayer service on some network configurations.\n3.4.0 \nNew Operation: Question\n\u2022\tIn procedures we now support a new operation, the question operation. This allows the trainee to be evaluated on specific knowledge during the procedure\nNew Action: Move users\n\u2022\tIn procedures we now support a new operation, the move user operation. This allows the users to be moved around the space during the procedure without having to navigate the space themselves\nFade when skipping Steps in a Procedure\n\u2022\tEvery time a user skips a Step or fast-forwards to a particular Step the user\u2019s view is briefly faded to black \u2013 the same experience when the Move users Actions is executed\nVR wrist menu improvements\n\u2022\tWe made the buttons easier to interact with\nScenarios discontinued\n\u2022\tAt SynergyXR, we continuously evolve the platform by introducing new features that better meet the needs of our users. As part of this process, certain features become redundant when replaced by more powerful alternatives. This is the case for Scenarios, which are now fully covered by Procedures\n", "created_date": 1765442704, "id": "32884047537877294", "version": "3.4.2", "version_code": 90, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5191119437596810", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "36266822612933086"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2892576187642885"}]}, "change_log": "3.4.1 \n\u2022\tFixed an issue connecting to multiplayer service on some network configurations.\n3.4.0 \nNew Operation: Question\n\u2022\tIn procedures we now support a new operation, the question operation. This allows the trainee to be evaluated on specific knowledge during the procedure\nNew Action: Move users\n\u2022\tIn procedures we now support a new operation, the move user operation. This allows the users to be moved around the space during the procedure without having to navigate the space themselves\nFade when skipping Steps in a Procedure\n\u2022\tEvery time a user skips a Step or fast-forwards to a particular Step the user\u2019s view is briefly faded to black \u2013 the same experience when the Move users Actions is executed\nVR wrist menu improvements\n\u2022\tWe made the buttons easier to interact with\nScenarios discontinued\n\u2022\tAt SynergyXR, we continuously evolve the platform by introducing new features that better meet the needs of our users. As part of this process, certain features become redundant when replaced by more powerful alternatives. This is the case for Scenarios, which are now fully covered by Procedures\n", "created_date": 1765264523, "id": "32850740964541285", "version": "3.4.1", "version_code": 89, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
": "2234215450454205", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823790_2234215457120871_8907242904001334189_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZENyqaJLJQQ7kNvwEgL0sm&_nc_oc=Adry9U3zmSQ5WxWzWEEjfFSb1o0ZKayqXYhZpxUvcMy5IwWuqgvd17iN3uH5j6AMHYM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-sLCjZ-8jVzeRci86YilkuI7d-pSJQNyZuufHgQ5mRQ&oe=6AB3DE4D"}, {"file_name": "com.tomasvajdicka.lacunaatlas-20260722-164525_2560x1440.png", "id": "4467445506877405", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824671_4467445510210738_3116639057373543709_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMy6AYOIeqAQ7kNvwFB928p&_nc_oc=AdrozIR-J2wW4AzqGaFVXSFDjMcr9l-1R6Y4TwGpkzFKtp9LZEsAYmU2E0ZlMcbV4PI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiwLPPagp84PMTlwc5PFrDAQe2YzfOpxEJ12nkoTmeEw&oe=6AB3E010"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lacuna Atlas", "keywords": ["astronomy", "stargazing", "galaxy", "constellation", "space"], "long_description": "\nAn atlas of the void.\n\nLacuna Atlas puts the real universe inside your headset - not an artist's\nimpression, but the actual sky, built from open astronomical catalogs. Every\nstar has a real name, spectral class, and true position in space.\n\nPoint. Focus. Fly.\nAim at a star to read what it is, then flick forward to glide toward it - it\nblooms into a glowing sun as you arrive. Keep going past Sirius and\nBetelgeuse, out where constellations shear apart into three dimensions.\n\nHunt the stars.\nTake a star-hunt contract: real astronomical clues, no waypoint arrows.\nLearning to identify the star IS the game. Earn ranks from Cadet to Admiral.\n\nThe sky, explained.\nFocus a star and its constellation lights up, with a chart showing the\nfigure as seen from Earth. Guided tours walk you through the Sun's\nneighborhood and the Summer Triangle.\n\nLeave the Milky Way.\nWarp to the galaxy tier and watch 43,000 real galaxies wrap around you, then\ndive toward Andromeda or the Sombrero and see their real portraits.\n\n- 25,000+ real stars with names, classes, and constellations\n- 43,000+ real galaxies from the 2MASS Redshift Survey\n- Star-hunt contracts with generated astronomy clues and ranks\n- Guided tours with narration\n- Comfort-first travel: eased dashes, vignette\n- Built on open data, fully credited in-app\n\nNo accounts. No ads. The universe, as catalogued.", "short_description": "Fly the real night sky, hunt real stars by real astronomical clues, and explore 43,000 real galaxies \u2014 the observable universe, in your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://neutrum.github.io/lacuna-atlas-site/", "developer_terms_of_service_url": null, "publisher_name": "Tomas Vajdicka", "support_website_url": null, "website_url": "https://neutrum.github.io/lacuna-atlas-site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1267192019800912"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825563_2107148823527352_4933674553181956805_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfSM4gMHn0cQ7kNvwF_s8XO&_nc_oc=Adqmp_HEe-OZs4mOCDJm2C9uxdGI_KH2mvwA5Xz8OqsI7Hl11UWESDWRGJVKc9xLcXA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculu
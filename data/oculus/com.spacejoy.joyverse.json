A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Aft7JLYEeDoYJwFlBwbcRezCqSNUv9fo_Ms-1R7BWu0rRA&oe=69A57D1E"}, {"file_name": "MR_3.png", "id": "123923674148648", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982681_123923677481981_5879415335749402459_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2yNxNA1v14Q7kNvwFcr8gQ&_nc_oc=AdmpmFK1iqVV_Gb2ckREOircdCAbVsn3LWNj_p095ycxwMKaTyoc1qTav2G61TXAOxY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftzOP--h0N7PwXhGWf3GjwiITVM5Ff8MhQf5BzzPp7dsg&oe=69A57C23"}, {"file_name": "Multiplayer Design_1.png", "id": "746052134026310", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035411_746052137359643_7542383291808884258_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fXJj-JadQEQ7kNvwFrQSOl&_nc_oc=Adk9fQmo903oTNTMkzYH6UJ-wCjDJITPVXtakusIIVZhjbLp6ycUYDYszqmttDLuNEI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afuz5vgGgD74RANWcUi1BX42FAwfqOJvWFGr2JEFHHCM9w&oe=69A57450"}, {"file_name": "Shop Now.png", "id": "1344829853085148", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982616_1344829856418481_8624653838191249585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NBGMNiForvgQ7kNvwHqKxg7&_nc_oc=Adkm-4Ba-D6lcsj4LJ4PaTmxthICE6BZejPAwfOkm2d_9jO7Hg1VDEpn3ybpLaBW82E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aft79XrNnyPzgZzIJj9rReXLlu7mca2JFtmCOXFfph0e3Q&oe=69A598F5"}, {"file_name": "Virtual Assistance.png", "id": "763683188853860", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/65402515_763683192187193_5727074074602548941_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHxzpU9fuocQ7kNvwEuE0kS&_nc_oc=AdnS7W9ZkDK3HHZGJo1-SGKPWcwg3RO7x5WwiQPUk2DUOJ3u26SP_puG1rUNu-DNrAM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvBdtbtbXB0rBd_Z5q41d6UT4M2timju9QG3pI7lNfUww&oe=69A5838A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art-Landscape (7).png", "id": "647727747563638", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210401_647727750896971_7020544145163601099_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbapUoXkvC8Q7kNvwFMzXwS&_nc_oc=AdnNrgqj_QErw2waSDFqW9Lcle_bgkI8d-_ylhpowF5s8Q7McvDSDOvfaOVobKl7Y5E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Aftsx_BZx2LaRKBmjJTv2RI4Z03G-Ndxuh5q5wzkP9qXXg&oe=69A57520"}, "display_name": "Joyverse", "keywords": ["interiors", "furniture", "decor", "interiordesign", "shopping"], "long_description": "Design Your Dream Space in 3D!\nWelcome to Joyverse, the ultimate interior design experience in the Oculus Store. Powered by Spacejoy, the leading interior design platform, Joyverse is your portal to a new world of design, blending innovation, community, and immersive technology.\n\n\ufffd Design Your Actual Space:\nDesign your actual space with furniture and decor from top brands. Every detail is under your control, making design an entirely new experience.\n\n\ufffd Access Curated Designer Furniture & Decor:\nChoose from an extensive collection of real furniture and decor curated by top designers. Each piece is carefully selected to inspire your creativity and elevate your designs.\n\n\ufffd Experiment:\nExpress your inner designer with our intuitive 3D tools. Move, swap, rotate, and experiment with furniture and decor until you find the perfect arrangement. It's not just design; it's an art form.\n\n\ufffd Connect with Fellow Design Enthusiasts:\nDesign is a collaborative journey. Connect with like-minded designers and enthusiasts in a dynamic multiplayer environment. Share ideas, collaborate on projects, and be inspired by the creativity of others.\n\n\ufffd Learn & Grow with AI-Powered Assistance:\nWhether you're a novice or a design aficionado, our AI-powered Virtual Assistant is your guide.\n\n\ufffd Connect with Us:\nHave questions, feedback, or simply want to chat? Reach out to us at hello@spacejoy.com. Your insights drive our constant innovation.\n\nYour dream space is waiting to be crafted!", "short_description": "Design Your Room\nPowered by Spacejoy, pioneers in design e-commerce, Joyverse is your gateway to groundbreaking interior design in the Oculus Store.\n\n- Design Your Actual Space: Add furniture and decor in your own room in Mixed Reality.\n- Designer Furniture: Access handpicked furniture/decor from top brands.\n- AI-Driven: Learn with our AI Virtual Assistant.\n- Multiplayer Creativity: Collaborate with friends to design a space.\n\nReady to dive into design like never before? Download Joyverse Now!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.spacejoy.com/joyverse-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Neo Design Labs Inc", "support_website_url": null, "website_url": "https://www.spacejoy.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "6889834994465668"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PENDING", "id": "1274079363737919"}, {"status": "PUBLISHED", "id": "972122167111007"}, {"status": "PUBLISHED", "id": "1590185858052829"}]}, "baseline_offer": {"id": "1590185858052829"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1274079363737919"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8918641278251686", "version
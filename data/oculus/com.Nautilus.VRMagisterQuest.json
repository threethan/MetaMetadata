GwDGiwIT0B7TMzIsp4CUW1ZSNXL5DQ9yMKcw&oe=69FF467B"}, {"file_name": "473393887_1263949235067435_4661244716484597557_n.png", "id": "1338607367353913", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823948_1338607370687246_8897892494242285466_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcazGs_grCwQ7kNvwE90gVZ&_nc_oc=AdrlwMIg0YMuWyExVYc1NQ3aKzA1D1NJ5DTTRbnFnjXaC854U-ocl0y5yjBqSFhwCbU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7H3kRfN5nrM3FDhI7Ia6hRSwkAc3ilNorIXXjimGK3SA&oe=69FF34B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PantallazoSS_entrevista.png", "id": "2162474397527519", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828843_2162474400860852_6170067202483492403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wki34-cqocgQ7kNvwFfjuSZ&_nc_oc=AdqIWFIhRrv9RZTnbHcoPaWOmlIzpvaBzK4L2_hN2nUf_vzLMorPiUchW2VTTwlCWIs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51AhtkEPLtMN4YFR0Co56ZHk-vvkMnqEpKxKLONTU7BA&oe=69FF3012"}, "display_name": "Soft Skills", "keywords": [], "long_description": "Soft Skills offers teachers a catalog of courses based on the \"learning by doing\" methodology, immersive learning in photorealistic 3D environments and 360\u00ba videos that increases student retention and motivation, improving learning capacity. Intuitive and easy to use, it allows you to practice skills and abilities without risk and without consuming materials, improving efficiency.\n\nImprove the positioning of your training center with new learning tools.", "short_description": "Soft Skills offers a catalog of virtual reality courses for training, both theoretical and practical, within training centers. The courses, based on 3D environments and 360\u00ba videos, offer students a unique immersive space where they can develop all their abilities."}]}, "developer_name": "Nautilus Experiencias Digitales", "developer_privacy_policy_url": "https://www.tierraxr.com/politica-privacidad-
5/491825039_1212187680315996_7192226203647546198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hzozsi3ziZ8Q7kNvwFFyIXE&_nc_oc=AdkcxmKX4JfUjK6-8F3rnavGxLyYDcD8GHENjFhfFqYOwNtjN3cBwo9Olir2e9WZv18&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftU77rPdZFfllezdfoKUaTtehNosCbUQClXkxfszeIztQ&oe=69A045A3"}, {"file_name": "imagen5.png", "id": "3905316043041849", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827128_3905316046375182_4862813722628740052_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arQwene5PCEQ7kNvwHAjH2G&_nc_oc=Adm4fK4GHGiQy8mA-sMZGQhcQ_-3WaAUr-CHnFMUxHrdFzC-1bf6ux-RaXYxVtJBJFw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftfBN0YOFTzP2uwD6rGZ0GXLYaN3UHFLyvEjBb0WeR-EA&oe=69A03C34"}, {"file_name": "473393887_1263949235067435_4661244716484597557_n.png", "id": "1072497204833312", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824012_1072497211499978_6396207551822594713_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nj3IgrmB3MAQ7kNvwEbKpBl&_nc_oc=Adk-hb3OcsnnmmOGBarTsB61qXEYRn5U-mKrlzU5A_1djzuF5g6p3WMQGpoFI7y-brY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsA0f80LLJj4zCVS6iahsMfVko6yvdM1kw8JxYdtSKBaQ&oe=69A028BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PantallazoSS_entrevista.png", "id": "589037786803980", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824047_589037790137313_7093144907836348429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ay8Xb_owLIcQ7kNvwEhHOR8&_nc_oc=Adl_KF-iGUPerSXbYWxxUTawioZuo4Bdbp3znOCWlGZGWuAWgo0ySLPDtbnBubNw4VE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvGCzDMt_byhmHy3BgEZvoorq8V_29wrdq2rwqKjKYuqg&oe=69A045DF"}, "display_name": "Soft Skills", "keywords": [], "long_description": "Soft Skills ofrece al profesorado un cat\u00e1logo de cursos basados en la metodolog\u00eda \u201clearning by doing\u201d, un aprendizaje inmersivo en entornos 3D fotorrealistas y v\u00eddeos 360\u00ba que aumenta la retenci\u00f3n y motivaci\u00f3n de los estudiantes, mejorando la capacidad de aprendizaje. Intuitivo y de f\u00e1cil utilizaci\u00f3n, permite practicar habilidades y destrezas sin riesgo y sin consumo de materiales, mejorando la eficiencia.\n\nMejora el posicionamiento de tu centro de formaci\u00f3n con nuevas herramientas de aprendizaje.", "short_description": "Soft Skills ofrece un cat\u00e1logo de cursos de realidad virtual para la formaci\u00f3n, tanto te\u00f3rica como pr\u00e1ctica, dentro de los centros formativos. Los cursos, basados en entornos 3D y v\u00eddeos 360\u00ba, ofrecen al alumno un espacio inmersivo \u00fanico donde desarrollar todas sus capacidades."}, {"images": {"nodes": [{"file_name": "Dise\u00f1oPortadaCuadrado.png", "id": "1691235964835065", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391883_1691235968168398_6525438052280577605_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtbMFd3Zb4QQ7kNvwFYgk5H&_nc_oc=AdllS8y7yKlrbJwAUQoDzwlHkSUCSiZKhl1bd4AQ5tiaf3N79FWh6XZgXg2Laj241Jk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsKxeqTu5hq2lOmR01sdkzCykQULtk4xhnr7zXUNdALng&oe=69A05366"}, {"file_name": "PDPArt.png", "id": "1428644331834558", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_1428644335167891_4316965757141775814_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mMcC4PV6RoQ7kNvwFoECVE&_nc_oc=AdmRMpFhCwQrVV6vVy7NGNCcGLTZdwULvzFF0uDfX7KLAOmwbskZqx440lFW1Xapox0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv0r01xsJCI1jnhBH2E83DqxzQb80Wq7tqm8xME58TeSg&oe=69A050C1"}, {"file_name": "Dise\u00f1oPortadaVertical.png", "id": "1316833942862437", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_1316833946195770_4205348472695298425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=538eyWwCIBYQ7kNvwH2VCfr&_nc_oc=AdlYXyg5wzqksPD-7wTnT-I67ItwwJ00PqJP4xyTG_GroFxdroRvL4eKIdik8NV3n5o&_nc_zt=3&_nc_ht=s
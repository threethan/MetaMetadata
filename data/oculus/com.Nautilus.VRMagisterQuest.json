vPh3jJdFh2x_0b30Ihl_yElbVZWzUTaiIcZA&oe=6A048C7B"}, {"file_name": "473393887_1263949235067435_4661244716484597557_n.png", "id": "1338607367353913", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823948_1338607370687246_8897892494242285466_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axUwlC8Xg1EQ7kNvwGB254u&_nc_oc=AdpTCgXh-0d3PWdAxNNebCp2JrUsgIcswst6k1OO4XBM6GPBNzaP7rtJux0BcKAsGbQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_uJiWo0IgsX62I_mwRqzZsK5YNvwdYvgwPnwzs6IgaQ&oe=6A047AB6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PantallazoSS_entrevista.png", "id": "2162474397527519", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828843_2162474400860852_6170067202483492403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgiowTHBhsMQ7kNvwHBXG5k&_nc_oc=AdoGiqya_pOQp-dFfPH2dfLkSeA3GLZevb1O33JoJgAYH19dzBjpdzM5Wo8sKtx-Ldo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JjfxViZCJCYdJDl0nGBCetjGS3ozbfzTfsSFtpbVpCw&oe=6A047612"}, "display_name": "Soft Skills", "keywords": [], "long_description": "Soft Skills offers teachers a catalog of courses based on the \"learning by doing\" methodology, immersive learning in photorealistic 3D environments and 360\u00ba videos that increases student retention and motivation, improving learning capacity. Intuitive and easy to use, it allows you to practice skills and abilities without risk and without consuming materials, improving efficiency.\n\nImprove the positioning of your training center with new learning tools.", "short_description": "Soft Skills offers a catalog of virtual reality courses for training, both theoretical and practical, within training centers. The courses, based on 3D environments and 360\u00ba videos, offer students a unique immersive space where they can develop all their abilities."}]}, "developer_name": "Nautilus Experiencias Digitales", "developer_privacy_policy_url": "https://www.tierraxr.com/politica-privacidad-
2YxLi08-vlzsBceLz3Kz-aScHONOwECX4JAA&oe=69CA8A7B"}, {"file_name": "473393887_1263949235067435_4661244716484597557_n.png", "id": "1338607367353913", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823948_1338607370687246_8897892494242285466_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jp6ambibJQwQ7kNvwGUWdT8&_nc_oc=Adq7xoq6ncg62-PDOA2BzsBYxoKR_hrLe9ahHsIR7fbAfOmKALhCWPRHH6DXXjqqOe8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyjdYzS-b5sCJvdkc_5e933mGzrMfQQzzl2GN__0GvMpg&oe=69CA78B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PantallazoSS_entrevista.png", "id": "2162474397527519", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828843_2162474400860852_6170067202483492403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YdP5Hi12lwQ7kNvwFOLB-9&_nc_oc=AdpgHqc9s9Cky2CIVlrIugmaKGuMiYbH12uO10AEg05PN5abSiY7tmgyHX3aqrwIdkc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzfK7U7aKzJpAs0PlwtwzSoaI0ZOTcecDzb9QUaDfqF_A&oe=69CA7412"}, "display_name": "Soft Skills", "keywords": [], "long_description": "Soft Skills offers teachers a catalog of courses based on the \"learning by doing\" methodology, immersive learning in photorealistic 3D environments and 360\u00ba videos that increases student retention and motivation, improving learning capacity. Intuitive and easy to use, it allows you to practice skills and abilities without risk and without consuming materials, improving efficiency.\n\nImprove the positioning of your training center with new learning tools.", "short_description": "Soft Skills offers a catalog of virtual reality courses for training, both theoretical and practical, within training centers. The courses, based on 3D environments and 360\u00ba videos, offer students a unique immersive space where they can develop all their abilities."}]}, "developer_name": "Nautilus Experiencias Digitales", "developer_privacy_policy_url": "https://www.tierraxr.com/politica-privacidad-
02v9V21TN_oDGVsmWNj1tclcPvY9Fl5hJiAQ&oe=69C3BABB"}, {"file_name": "473393887_1263949235067435_4661244716484597557_n.png", "id": "1338607367353913", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823948_1338607370687246_8897892494242285466_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHeFjpKqC0sQ7kNvwEO0Sbu&_nc_oc=AdrkeWknvkeX4UYeVjDDRCYi-HuU3h-DMUs_EdlwjhAsltrBz2akKwMBjwC2p--rLkg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJHhJrDY5vImHi3sd3bpIqh3bOI3K5KJmrP5TmLzpWUg&oe=69C3E136"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PantallazoSS_entrevista.png", "id": "2162474397527519", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491828843_2162474400860852_6170067202483492403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q73C2ltbSBQQ7kNvwHyQyND&_nc_oc=Adqg681V_rNnArrWZL63dIModBblnFU0OEunyAOR6rUEgmrFZgkNwi8nA9kR_Fzm4y4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxfvBZCOfm7AKbYhilZ9G2lUC_GE1kVhJXgwAQYfFcHzQ&oe=69C3DC92"}, "display_name": "Soft Skills", "keywords": [], "long_description": "Soft Skills offers teachers a catalog of courses based on the \"learning by doing\" methodology, immersive learning in photorealistic 3D environments and 360\u00ba videos that increases student retention and motivation, improving learning capacity. Intuitive and easy to use, it allows you to practice skills and abilities without risk and without consuming materials, improving efficiency.\n\nImprove the positioning of your training center with new learning tools.", "short_description": "Soft Skills offers a catalog of virtual reality courses for training, both theoretical and practical, within training centers. The courses, based on 3D environments and 360\u00ba videos, offer students a unique immersive space where they can develop all their abilities."}]}, "developer_name": "Nautilus Experiencias Digitales", "developer_privacy_policy_url": "https://www.tierraxr.com/politica-privacidad-
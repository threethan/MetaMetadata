z5RZHjqhqVSmJ2JSsH3u6ZhPOI0PrdkX9usw&oe=6A1852FB"}, {"file_name": "473393887_1263949235067435_4661244716484597557_n.png", "id": "1338607367353913", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823948_1338607370687246_8897892494242285466_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8xZo4-YnWYQ7kNvwGbo6r4&_nc_oc=AdowUiQf3EaSuhYh0LAF4aT7aahnn16XKx9RE_klcAZeWy2UfOdp0xJ0yYZVXs9bQAQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bHZWe653uTm_6_CUPjXNx_9v7Mg4PFDUfafOh4-h4gg&oe=6A184136"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PantallazoSS_entrevista.png", "id": "2162474397527519", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828843_2162474400860852_6170067202483492403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLW32fQGbGkQ7kNvwHSQNuk&_nc_oc=AdrtB67u-GH3asXcmPX1MFV4T2Qn5tG8FtJKbGmZjoyBHVmtbuYaOjpRNIxpN4DW7MU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LDHZnEdWsOMaMMnxHFKfXem5kfh2e6_rzH1SziRq5Vg&oe=6A183C92"}, "display_name": "Soft Skills", "keywords": [], "long_description": "Soft Skills offers teachers a catalog of courses based on the \"learning by doing\" methodology, immersive learning in photorealistic 3D environments and 360\u00ba videos that increases student retention and motivation, improving learning capacity. Intuitive and easy to use, it allows you to practice skills and abilities without risk and without consuming materials, improving efficiency.\n\nImprove the positioning of your training center with new learning tools.", "short_description": "Soft Skills offers a catalog of virtual reality courses for training, both theoretical and practical, within training centers. The courses, based on 3D environments and 360\u00ba videos, offer students a unique immersive space where they can develop all their abilities."}]}, "developer_name": "Nautilus Experiencias Digitales", "developer_privacy_policy_url": "https://www.tierraxr.com/politica-privacidad-oculus", "developer_terms_of_service_url": null, "publisher_name": "Nautilus Experiencias Digitales", "support_website_url": null, "website_url": "https://www.tierraxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9516036151812578"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391883_1691235968168398_6525438052280577605_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcNIUC-Ix5UQ7kNvwHyze8Y&_nc_oc=Ado2Q7_UDH4VICSAuT4Y9keNJuWu_LGttLnPwIMqwCUzEZRqJ79VfTupHTsZAMxTM6Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pH49o6c8RpX-fkI_E8wl1nCssrlCi7_L_2t9EcvX41A&oe=6A184BE6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Soft Skills", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1688051484, "lastRevision": {"nodes": [{"id": "4832077010171508", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4525137667569143", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "988796625057880"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1326170474978300", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Magister", "keywords": [], "long_description": "VRMAGISTER ofrece al profesorado un cat\u00e1logo de cursos basados en la metodolog\u00eda \u201clearning by doing\u201d, un aprendizaje inmersivo en entornos 3D fotorrealistas y v\u00eddeos 360\u00ba que aumenta la retenci\u00f3n y motivaci\u00f3n de los estudiantes, mejorando la capacidad de aprendizaje. Intuitivo y de f\u00e1cil utilizaci\u00f3n, permite practicar habilidades y destrezas sin riesgo y sin consumo de materiales, mejorando la eficiencia.\n\nMejora el posicionamiento de tu centro de formaci\u00f3n con nuevas herramientas de aprendizaje.", "short_description": "VRMAGISTER ofrece un cat\u00e1logo de cursos de realidad virtual para la formaci\u00f3n, tanto te\u00f3rica como pr\u00e1ctica, dentro de los centros formativos. Los cursos, basados en entornos 3D y v\u00eddeos 360\u00ba, ofrecen al alumno un espacio inmersivo \u00fanico donde desarrollar todas sus capacidades."}, {"images": {"nodes": [{"file_name": "portada16_9_G_ok.png", "id": "3513080792273172", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974577_3513080795606505_3215861689659065057_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5bbFkVFpz8Q7kNvwHh1Fql&_nc_oc=AdrkTTQ6CSKJp9_QkUO6_ksgzYdDYawo-JJIxmit-qseb2kB_MYzb-ihJphvt3R19eo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4POxoLnRD7TlABOryfydadxnw1maqOZGN3pesV5bueUw&oe=6A18371E"}, {"file_name": "icono_1080_360.png", "id": "952207505834974", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974866_952207509168307_1772874739751962554_n.png?_nc_cat=102&ccb=1-7&_nc_
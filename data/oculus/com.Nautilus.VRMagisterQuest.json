5/491825039_1212187680315996_7192226203647546198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mv0mnxOp1HkQ7kNvwHdEq9S&_nc_oc=AdnZSoUu9O39W5bYDrMp24pyC-nblzxiWtbHF2jK1QGiDoCNyqT8YqEYdJ-cEBVJya8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvgGnSAC5z10bu6aTo3FXu9Agk9Ae_6D3E-hw8M8NOLww&oe=69985CA3"}, {"file_name": "imagen5.png", "id": "3905316043041849", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827128_3905316046375182_4862813722628740052_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1SnYz8qFFsQ7kNvwFmP96f&_nc_oc=AdnZKLgenCXtUDXkBSlbBXVAZ4W8W_tUWy0esNyjH-9YatvH_qb-E1Zou832NjG0-48&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvJAY-0LYsMtdvkNGfxyGvuvxWgbVzWyvt8pNChJiFInw&oe=69985334"}, {"file_name": "473393887_1263949235067435_4661244716484597557_n.png", "id": "1072497204833312", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824012_1072497211499978_6396207551822594713_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNWK3mP30lwQ7kNvwFrz5ir&_nc_oc=AdkY4tN9O6XrnF1umT0ZnIo4K0Q366a9L6LocrjVMZgP2Elc7YniZWIPyiY6Yody6J4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvdYxSl6347Z3vzr7Cmz4QBeBPL8PNeZ8CE3WwiTZfEXw&oe=69983FBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PantallazoSS_entrevista.png", "id": "589037786803980", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824047_589037790137313_7093144907836348429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ApXDnBite8Q7kNvwHEC6lW&_nc_oc=AdkJ8rWENx2jj-uDo27CyEQHtfASbesqWEgOqv5-TuOGRRwNydkSbbBVn-_E89u5lHA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aftyql5hupk4rSen7w5XCAj_XK15LRj5g9Njme0jzo74Ew&oe=69985CDF"}, "display_name": "Soft Skills", "keywords": [], "long_description": "Soft Skills ofrece al profesorado un cat\u00e1logo de cursos basados en la metodolog\u00eda \u201clearning by doing\u201d, un aprendizaje inmersivo en entornos 3D fotorrealistas y v\u00eddeos 360\u00ba que aumenta la retenci\u00f3n y motivaci\u00f3n de los estudiantes, mejorando la capacidad de aprendizaje. Intuitivo y de f\u00e1cil utilizaci\u00f3n, permite practicar habilidades y destrezas sin riesgo y sin consumo de materiales, mejorando la eficiencia.\n\nMejora el posicionamiento de tu centro de formaci\u00f3n con nuevas herramientas de aprendizaje.", "short_description": "Soft Skills ofrece un cat\u00e1logo de cursos de realidad virtual para la formaci\u00f3n, tanto te\u00f3rica como pr\u00e1ctica, dentro de los centros formativos. Los cursos, basados en entornos 3D y v\u00eddeos 360\u00ba, ofrecen al alumno un espacio inmersivo \u00fanico donde desarrollar todas sus capacidades."}, {"images": {"nodes": [{"file_name": "Dise\u00f1oPortadaCuadrado.png", "id": "1691235964835065", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391883_1691235968168398_6525438052280577605_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUN0F9FPIlEQ7kNvwHbNkhM&_nc_oc=AdmyyEpPgXflHRGEeB8Ri6esIga-PioLom9WcMFmnabelIjTvQrDo2FrxoTyZvky-uQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvEdR7iX0DqSTyXJktzCPmol6xmo7P7mPQEEWFI_cMQJA&oe=69986A66"}, {"file_name": "PDPArt.png", "id": "1428644331834558", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391998_1428644335167891_4316965757141775814_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKe8N5ycJloQ7kNvwEFAqAW&_nc_oc=AdmwHD1bhvgqmZgTszZo4D1ErKKLiE5Zl9qeMgNSGnXQhI27aRqjnwoQoaFriNlFYtk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afvp1EFLaYiax9eMoFlC5-14BYerfxz0tEOdFaRpgisZ2w&oe=699867C1"}, {"file_name": "Dise\u00f1oPortadaVertical.png", "id": "1316833942862437", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392010_1316833946195770_4205348472695298425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nm3xWkRWgUQ7kNvwHEJhDf&_nc_oc=AdmYUUiuZB14kE6BbzSGywuku6HafZsozmTev65JdzYHOD6R0dBKBCYZRgbM8Cy9j8E&_nc_zt=3&_nc_ht=s
ng", "id": "1338607367353913", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823948_1338607370687246_8897892494242285466_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtBFiMx2ZYIQ7kNvwH4Z4pS&_nc_oc=Adp7T9WloOjq7gp-CFUSGbiP5gNsEgQtcTFW7od0QLVA-F_HczI9MNtthvPBmTSvvHo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3P_svy570Dg4SuL5nPrkizf4YlloH5CYmHCFl3ZVWqCQ&oe=69F205B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PantallazoSS_entrevista.png", "id": "2162474397527519", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491828843_2162474400860852_6170067202483492403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qccwGItmW_8Q7kNvwGNkedQ&_nc_oc=AdqPB6neGyAwE7jr1W8QGa8cRb1HUep7moeRtwnuJgyxvLulQ4Us3m8s5HxDNz7Chz4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0lK7lus2Ll-gTMZ3kQ_qOnZk4AM48aiSrFo06zgYLmIQ&oe=69F20112"}, "display_name": "Soft Skills", "keywords": [], "long_description": "Soft Skills offers teachers a catalog of courses based on the \"learning by doing\" methodology, immersive learning in photorealistic 3D environments and 360\u00ba videos that increases student retention and motivation, improving learning capacity. Intuitive and easy to use, it allows you to practice skills and abilities without risk and without consuming materials, improving efficiency.\n\nImprove the positioning of your training center with new learning tools.", "short_description": "Soft Skills offers a catalog of virtual reality courses for training, both theoretical and practical, within training centers. The courses, based on 3D environments and 360\u00ba videos, offer students a unique immersive space where they can develop all their abilities."}]}, "developer_name": "Nautilus Experiencias Digitales", "developer_privacy_policy_url": "https://www.tierraxr.com/politica-privacidad-oculus", "developer_terms_of_service_url": null, "publisher_name": "Nautilus Experiencias Digitales", "support_website_url": null,
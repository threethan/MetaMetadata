5/491825039_1212187680315996_7192226203647546198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cw4frsDrk74Q7kNvwEHk4rf&_nc_oc=Adk_K8uoQI2ykhUA_GFphx00xAjBzFJDO0AVaF64XT53GL_xF_YTBN-eXvWq_Kp-eqA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsP0o-P19TosRzLL5_HVUJ4ZSQzzmDnTF36foybhqBYYA&oe=69A6DD23"}, {"file_name": "imagen5.png", "id": "3905316043041849", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827128_3905316046375182_4862813722628740052_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7CIp_O2rxYQ7kNvwFtNfOB&_nc_oc=AdnSfUeZhrj02xqNV4HawIPdt1Wkx2OwpmsSZZYC6hqib7Cw2C5EqLWl4TV0mBWk_DY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuqwfPDgjJEzl-r270MgzaoXhT3xzT1zMRNkIwe3JwWGA&oe=69A6D3B4"}, {"file_name": "473393887_1263949235067435_4661244716484597557_n.png", "id": "1072497204833312", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824012_1072497211499978_6396207551822594713_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gBHf4wIXdQQ7kNvwEM3GND&_nc_oc=AdnqnvmmjlqpeBOqOjHqAsW1Vf77IsChjRJ7zfZGMV4ckzc9d1aqch3qGJ8DkfJg7I0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftTUUHxNY8_aGRzq-aamXW6ZhttYNgK21MZXYyV81rX8w&oe=69A6C03D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PantallazoSS_entrevista.png", "id": "589037786803980", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824047_589037790137313_7093144907836348429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-fC3pQ0RLsQ7kNvwEBbHtx&_nc_oc=AdmCAduAtqUwikNhaZ0J6ZblYmgdPDJTL_Kqw9qnDRsoB0ye-KkkDWXYKg_tvcqllYM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsJqG7rfyz0wUeCx7InTS2TtJj0NYQwRIfwNhQbGGRNsw&oe=69A6DD5F"}, "display_name": "Soft Skills", "keywords": [], "long_description": "Soft Skills ofrece al profesorado un cat\u00e1logo de cursos basados en la metodolog\u00eda \u201clearning by doing\u201d, un aprendizaje inmersivo en entornos 3D fotorrealistas y v\u00eddeos 360\u00ba que aumenta la retenci\u00f3n y motivaci\u00f3n de los estudiantes, mejorando la capacidad de aprendizaje. Intuitivo y de f\u00e1cil utilizaci\u00f3n, permite practicar habilidades y destrezas sin riesgo y sin consumo de materiales, mejorando la eficiencia.\n\nMejora el posicionamiento de tu centro de formaci\u00f3n con nuevas herramientas de aprendizaje.", "short_description": "Soft Skills ofrece un cat\u00e1logo de cursos de realidad virtual para la formaci\u00f3n, tanto te\u00f3rica como pr\u00e1ctica, dentro de los centros formativos. Los cursos, basados en entornos 3D y v\u00eddeos 360\u00ba, ofrecen al alumno un espacio inmersivo \u00fanico donde desarrollar todas sus capacidades."}, {"images": {"nodes": [{"file_name": "Dise\u00f1oPortadaCuadrado.png", "id": "1691235964835065", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391883_1691235968168398_6525438052280577605_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFP-Q3-qq-4Q7kNvwGB0p2K&_nc_oc=Adll9RoZFsIboprqz1TYDz1XTmCIqywIVhIFcUHnCSluXU2BbsQ7M87X7tF-FOG-PvA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftLuu1ggEBZW0BeDxLTIaQVb1jXHrJQ9cd4lRGw9a_vyA&oe=69A6EAE6"}, {"file_name": "PDPArt.png", "id": "1428644331834558", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_1428644335167891_4316965757141775814_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FplHZ8qrtg4Q7kNvwGjfyT8&_nc_oc=Adm12vfAc5xHqt4zvjzGdB1NqYrM4riywwNfJchBhvnRmVJLOc3ljS4jQdpdiNohDKg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuxCzsU618Rg2BWzg8tAIEK1xt27U5XwQqMBjqjM0CoxA&oe=69A6E841"}, {"file_name": "Dise\u00f1oPortadaVertical.png", "id": "1316833942862437", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_1316833946195770_4205348472695298425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnKUPPugkqEQ7kNvwH-U8A2&_nc_oc=AdlxvxL01PXttYQdoTaTYLs63-0A1KUXP0SUKOvSlS5aWkHBnbk_yYpY0sOXWa3BpqU&_nc_zt=3&_nc_ht=s
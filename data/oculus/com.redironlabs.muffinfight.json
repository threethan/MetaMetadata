6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvlbG5kH5VndKdkpXdX90qm2s5UIPzb-6oYia7X6a7Ew&oe=6AB13DE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus-Feature-2560x1440-v2.png", "id": "8593329854117500", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974723_8593329860784166_4557583765103855581_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clLhOSCaGCkQ7kNvwFlc6rP&_nc_oc=AdpnUtpF_-grSGQoyb1LWz0zI-633aMCNjYls9dsFD5zqL7G7OjTtGFRVzcjkTocVaY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJ-Z_y4iKqRM0FK5EZV0cfRlvS8TpOWkkEeh06Y9hrUQ&oe=6AB1240B"}, "display_name": "Muffin Fight", "keywords": [], "long_description": "# About This Game\n\nMuffin Fight is a high-energy, arena-style VR game where baking meets battling! Compete in 4-player multiplayer, test your skills in single-player mode, or take on bots in this deliciously chaotic experience.\n\nGather your friends or challenge strangers in the ultimate food fight! In just three minutes, you\u2019ll collect ingredients, whip up creative muffin recipes, and throw your treats at opponents in the chef-pit. Use strategic tools like garbage lids to block attacks or vacuum guns to steal items, and become the last player standing!\n\nBut it\u2019s not all about the battles\u2014step into the social space to hang out with friends, set your name, and check your high scores!\n\n{3021684594638300}\n\nKey Features:\n- Multiplayer Action: Engage in thrilling matches with friends or players from around the world (2 to 4 players ideally).\n- Single Player & Bot Modes: Practice your skills against AI opponents or practice in single player challenge mode.\n- Social Space: Relax and connect with others, track your progress, and show off your achievements.\n\nGet ready to bake, battle, and have a blast in Muffin Fight!", "short_description": "The ultimate food fight \u2013 no cleanup required! Muffin Fight is a 4-player VR party game where you bake, throw, and battle! Challenge friends or foes in this multiplayer showdown. With wild ingredients and quick rounds, it\u2019s a fight to be the last player standing! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red Iron Labs", "support_website_url": "https://www.redironlabs.com/#contact", "website_url": "https://www.redironlabs.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "8841476195873878"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982711_930985742254633_7903284396787936427_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awNVYTxh-dwQ7kNvwFYkQt0&_nc_oc=Adq_rr4JdifeAtsc-iOXeWT4Fxo7f1poRW0LcJqmR63OgYf0ddvLoJyq0uiZ2Ty8Ib4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJA6DZOo4aIbfYIa8r4z5Qr68P1MQUTRTqvjuzkrjo5ww&oe=6AB12DBD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Muffin Fight", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1687500000, "lastRevision": {"nodes": [{"id": "5375257182495814", "release_type": "SCHEDULED", "administration_status": "APPR
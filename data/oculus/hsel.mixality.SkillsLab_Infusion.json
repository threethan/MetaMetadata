t1e00zwS21xlqIu9L-wplw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaGRPaF6235tiPOw_qBAb6KqmCApwwEVy-aw1TJpw7Lg&oe=6B09B1B5"}, {"file_name": "Untitled-4.png", "id": "1235210823711352", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982559_1235210827044685_4446252330918973545_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNa7itDyw24Q7kNvwHFJGix&_nc_oc=Adp3_H4hPLlagKFzm_lVzTaAzJks7o4k9mOe-V49qTd-nAcRjnyYwiotLkwC91Ja2n0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVRlTrq_TfzLq2QnIewVziFPxiZ5EclxApLh4D1obk8Q&oe=6B09CAD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_CoverImg.png", "id": "899473614737038", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974716_899473618070371_3768622200222813924_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=attqAbovCAYQ7kNvwHCZCHA&_nc_oc=Adom8HLQDl2cZ_xmVookMS-VHGo2b-L-oiSOLJaQdeUZrJn-ZNyB7wx8B2OSzDFg-IQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDpgjFzWEYfwgdfh5C8EMC18AGs05-VXHgQHrMwTvynA&oe=6B099CBA"}, "display_name": "DiViFaG: Infusion Preparation", "keywords": [], "long_description": "VR training scenario for practicing the preparation of infusion materials\n\nIn VR, users are instructed as to which materials are required for an infusion, where to find the necessary information, and how to prepare the materials afterward. To do this, they have to get the relevant information from a patient file and independently carry out the steps required to prepare the infusion. The focus is on rehearsing the sequence of a predefined process for carrying out the necessary steps.\nFinally, users can compare the steps they have taken with the intended process in order to identify any errors or opportunities for improvement.\n\nThe training scenario was developed in cooperation with the medical faculty and the faculty for educational sciences at Bielefeld University,  University of Applied Sciences Osnabr\u00fcck,  University of Applied Sciences Bielefeld, and University of Applied Sciences Emden/Leer as part of the BMBF-funded DiViFaG research project.", "short_description": "VR training scenario for practicing the preparation of infusion materials."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mixality.de/divifag-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MixalityLab Emden", "support_website_url": null, "website_url": "https://mixality.de/divifag-info/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1356557115093139"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "707347177757461"}]}, "baseline_offer": {"id": "707347177757461"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1673544480, "status": "PUBLISHED", "id": "707347177757461"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6195681943809410", "version": "2.7"}, "id": "324581745875524", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4857116434332641", "is_concept": false, "latest_released_binary"
1200649773862294", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031325_1200649780528960_7162269763437816034_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdnFP_ZQSV0Q7kNvwGpQeJb&_nc_oc=AdmKg17M75K6KNVBgX4lIWr08TeDUtUXh29fVUQ-lNdVEXjiCQiAL1EFOvZEiF6G708&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5S5kl-PZwGylThnCwOsqBmL8n2IG4wYVHU2xn89OdOQ&oe=69AD7588"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_CoverImg.png", "id": "2232718963554751", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75371511_2232718966888084_8888000761960422525_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOmi_TYInIAQ7kNvwGeWkaj&_nc_oc=Adm8GdYlrHSCr-faAfvh_rS66Zl9GVkEWaYAMeBiCUvh2T51L6VTQ8le5I21G7T77hI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwyu7_lCNpCAh4HqHMu5o10NH6mTNCtbM8Ay00E9H-KNw&oe=69AD76A5"}, "display_name": "DiViFaG: Infusionsvorbereitung", "keywords": [], "long_description": "VR Trainingsszenario zum \u00dcben der Vorbereitung von Infusionsmaterialien\n\nNutzerInnen werden in der VR angeleitet, welche Materialien f\u00fcr eine Infusion ben\u00f6tigt werden, wo sie die n\u00f6tigen Informationen finden und wie sie die Materialien anschlie\u00dfend vorbereiten. Dazu m\u00fcssen sie die entsprechenden Informationen einer Patientenmappe entnehmen und anschlie\u00dfend selbstst\u00e4ndig die f\u00fcr die Infusionsvorbereitung notwendigen Schritte durchf\u00fchren. Dabei liegt der Fokus darauf, die Abfolge eines festgelegten Prozesses f\u00fcr die Durchf\u00fchrung der notwendigen Schritte einzustudieren. \nAbschlie\u00dfend k\u00f6nnen die NutzerInnen ihre durchgef\u00fchrten Schritte mit dem vorgesehenen Prozess vergleichen, um etwaige Fehler oder Verbesserungsm\u00f6glichkeiten zu erkennen.\n\nDas Trainingsszenario wurde in Zusammenarbeit mit der Medizinischen Fakult\u00e4t und der Fakult\u00e4t f\u00fcr Erziehungswissenschaften der Universit\u00e4t Bielefeld, der Hochschule Osnabr\u00fcck, der Fachhochschule Bielefeld und der Hochschule Emden/ Leer  im Rahmen des vom BMBF gef\u00f6rderten Forschungsprojektes DiViFaG entwickelt.", "short_description": "VR Trainingsszenario zum \u00dcben der Vorbereitung von Infusionsmaterialien."}, {"images": {"nodes": [{"file_name": "landscape.png", "id": "1779633709047424", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974798_1779633712380757_2318654421865421778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygtnvLAA_PEQ7kNvwGDjfRc&_nc_oc=AdmFbRKw2ZlfGVJaGlZvo18JveLQPD1JRcqDb6gL_v296xQH1Ot78kNijL4JoO4cMEE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyrb_hEqmrUhP2iLqE5mKXeJB8_vrBwliNKZgInFtsl5w&oe=69AD69B1"}, {"file_name": "mini-landscape.png", "id": "1155544012016051", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982535_1155544015349384_8958708088103458222_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsxRy8_cQdQQ7kNvwGzXqNs&_nc_oc=AdnU1VU3PR5-ZhYMK1a368N4Qr5lRaqrXLXFH82MsBlap9q3i0FHv8QjsmGp5fDigbs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzqnSaR5Tvw4Rq3Q3fN3lQ9Ehw-RVXqCuloTujnBECPUg&oe=69AD65C0"}, {"file_name": "HeroCover.png", "id": "1016628869152227", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75363518_1016628872485560_7846994916497395185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKJRtaYXgq4Q7kNvwGhr-th&_nc_oc=AdnaU5FSl6xxuQAP93ITUk-AwMumBKx6mI38SMH2B_v1FYSq_KqJPTaFBsFm_HWhLl0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDhcF7m6rSlVyDlB87CAr7pJRpOb9s3HKzzSa6aTfPAg&oe=69AD7EDE"}, {"file_name": "portrait.png", "id": "673810394264400", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031421_673810397597733_7890662955301697782_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-nLrtrqpzkQ7kNvwE6_PEx&_nc_oc=AdkLTIkLZNNkGU9movuiX9NyKA
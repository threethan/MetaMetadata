1200649773862294", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031325_1200649780528960_7162269763437816034_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0RHTATLhwgQ7kNvwFdxXZy&_nc_oc=Adk9Ny3cBiU1n9-Wg2hWbpqjEhRm7SLh-bFLdZUt6fgcCdCxPSSnw2jvyho_Wbh6DKM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZxmZoh4f5sgVlMpFYBgZkqW2jOrOqkJ8t9ELNzKaHOg&oe=69B6B008"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_CoverImg.png", "id": "2232718963554751", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75371511_2232718966888084_8888000761960422525_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksttSDpjo-sQ7kNvwHFJz0R&_nc_oc=AdmK0VH0MFfC68_jJ709RArYmnNKm4tW8BB9NzTv-HaG2jXpJYjZ0kWlGH7f-XdtRRU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfykUtiBEvf2yzDTwKZIbyX8Up4mOlFtMjzmNI8HgR1Kng&oe=69B6B125"}, "display_name": "DiViFaG: Infusionsvorbereitung", "keywords": [], "long_description": "VR Trainingsszenario zum \u00dcben der Vorbereitung von Infusionsmaterialien\n\nNutzerInnen werden in der VR angeleitet, welche Materialien f\u00fcr eine Infusion ben\u00f6tigt werden, wo sie die n\u00f6tigen Informationen finden und wie sie die Materialien anschlie\u00dfend vorbereiten. Dazu m\u00fcssen sie die entsprechenden Informationen einer Patientenmappe entnehmen und anschlie\u00dfend selbstst\u00e4ndig die f\u00fcr die Infusionsvorbereitung notwendigen Schritte durchf\u00fchren. Dabei liegt der Fokus darauf, die Abfolge eines festgelegten Prozesses f\u00fcr die Durchf\u00fchrung der notwendigen Schritte einzustudieren. \nAbschlie\u00dfend k\u00f6nnen die NutzerInnen ihre durchgef\u00fchrten Schritte mit dem vorgesehenen Prozess vergleichen, um etwaige Fehler oder Verbesserungsm\u00f6glichkeiten zu erkennen.\n\nDas Trainingsszenario wurde in Zusammenarbeit mit der Medizinischen Fakult\u00e4t und der Fakult\u00e4t f\u00fcr Erziehungswissenschaften der Universit\u00e4t Bielefeld, der Hochschule Osnabr\u00fcck, der Fachhochschule Bielefeld und der Hochschule Emden/ Leer  im Rahmen des vom BMBF gef\u00f6rderten Forschungsprojektes DiViFaG entwickelt.", "short_description": "VR Trainingsszenario zum \u00dcben der Vorbereitung von Infusionsmaterialien."}, {"images": {"nodes": [{"file_name": "landscape.png", "id": "1779633709047424", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974798_1779633712380757_2318654421865421778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rky9EFFU3PwQ7kNvwGtV50i&_nc_oc=Adnl4PMsb2PVRKnknLNOtbcfDuWkw4g_Uen0W9NPMaQ_KCk2e50dTPH4_y6QA7ENJUE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwnlnsDoSCwQ59M-i53OBwWBt_kTyPqo2Mmzg6Bx6GexQ&oe=69B6A431"}, {"file_name": "mini-landscape.png", "id": "1155544012016051", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982535_1155544015349384_8958708088103458222_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IShfqx26zswQ7kNvwEkLVQb&_nc_oc=AdlDGpQEmJtFXTZd5PSsZ8L_t3vTqoNg67Oz075Z6L4LXkiECj2acDo4s07j6CFT0C0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJCBx_FBf7_yZNyiHVv-iWs1NRZ7geshVagdpoj00FAQ&oe=69B6A040"}, {"file_name": "HeroCover.png", "id": "1016628869152227", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75363518_1016628872485560_7846994916497395185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZM5uZMa51vAQ7kNvwF6fnMG&_nc_oc=Adm88P_RipR2PXFS333WCiuOUoMk9X0yEN4OsDizED1w7aCzBeRb4vtvbWyUmnN2kfI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxV-H2utLPkkWe22WrBmo9F5T1_Zw7HdkODEu39rx2QQ&oe=69B6B95E"}, {"file_name": "portrait.png", "id": "673810394264400", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031421_673810397597733_7890662955301697782_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQZu3rfsv_UQ7kNvwFuR9YN&_nc_oc=AdkmpjXE2XJsEZKNb4riNzXmbB
oculuscdn.com&oh=00_Aft09vaS_aczABMx5mZ-l8XPkbmasbGhl2ptOv2sMQY7lA&oe=699D867A"}, "display_name": "DiViFaG: Infusion Preparation", "keywords": [], "long_description": "VR training scenario for practicing the preparation of infusion materials\n\nIn VR, users are instructed as to which materials are required for an infusion, where to find the necessary information, and how to prepare the materials afterward. To do this, they have to get the relevant information from a patient file and independently carry out the steps required to prepare the infusion. The focus is on rehearsing the sequence of a predefined process for carrying out the necessary steps.\nFinally, users can compare the steps they have taken with the intended process in order to identify any errors or opportunities for improvement.\n\nThe training scenario was developed in cooperation with the medical faculty and the faculty for educational sciences at Bielefeld University,  University of Applied Sciences Osnabr\u00fcck,  University of Applied Sciences Bielefeld, and University of Applied Sciences Emden/Leer as part of the BMBF-funded DiViFaG research project.", "short_description": "VR training scenario for practicing the preparation of infusion materials."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mixality.de/divifag-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MixalityLab Emden", "support_website_url": null, "website_url": "https://mixality.de/divifag-info/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de
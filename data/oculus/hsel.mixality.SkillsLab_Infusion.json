-atl3-2.oculuscdn.com/v/t64.5771-25/39031325_1200649780528960_7162269763437816034_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQaXkZtk0gsQ7kNvwEWTmm4&_nc_oc=AdqcWSWxU_Svi9ylwUYyHnSZf3JNwDcIIx09I82CezgeMDugdhKa8m5PnLFSPQ91ArU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1JA4N3IU-8OYBUg0kn36kewF-XhCecxYK0zwte13KN6A&oe=69F20388"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_CoverImg.png", "id": "2232718963554751", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75371511_2232718966888084_8888000761960422525_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJaOM07nERcQ7kNvwH6mNIJ&_nc_oc=AdqT8sLgWn_TOY0KIjSc2JYwY7Pxt1Yu7qRIXznXAXZqMcLqLA5Aaw4F0b8xkjB8b2I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2hRf3kZbA-1VBi7UCry8T2btKFsJGhPsODDvuKRGdP7w&oe=69F204A5"}, "display_name": "DiViFaG: Infusionsvorbereitung", "keywords": [], "long_description": "VR Trainingsszenario zum \u00dcben der Vorbereitung von Infusionsmaterialien\n\nNutzerInnen werden in der VR angeleitet, welche Materialien f\u00fcr eine Infusion ben\u00f6tigt werden, wo sie die n\u00f6tigen Informationen finden und wie sie die Materialien anschlie\u00dfend vorbereiten. Dazu m\u00fcssen sie die entsprechenden Informationen einer Patientenmappe entnehmen und anschlie\u00dfend selbstst\u00e4ndig die f\u00fcr die Infusionsvorbereitung notwendigen Schritte durchf\u00fchren. Dabei liegt der Fokus darauf, die Abfolge eines festgelegten Prozesses f\u00fcr die Durchf\u00fchrung der notwendigen Schritte einzustudieren. \nAbschlie\u00dfend k\u00f6nnen die NutzerInnen ihre durchgef\u00fchrten Schritte mit dem vorgesehenen Prozess vergleichen, um etwaige Fehler oder Verbesserungsm\u00f6glichkeiten zu erkennen.\n\nDas Trainingsszenario wurde in Zusammenarbeit mit der Medizinischen Fakult\u00e4t und der Fakult\u00e4t f\u00fcr Erziehungswissenschaften der Universit\u00e4t Bielefeld, der Hochschule Osnabr\u00fcck, der Fachhochschule Bielefeld und der Hochschule Emden/ Leer  im Rahmen des vom BMBF gef\u00f6rderten Forschungsprojektes DiViFaG entwickelt.", "short_description": "VR Trainingsszenario zum \u00dcben der Vorbereitung von Infusionsmaterialien."}, {"images": {"nodes": [{"file_name": "landscape.png", "id": "1779633709047424", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974798_1779633712380757_2318654421865421778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QoWrsgOVjmcQ7kNvwGlIJtt&_nc_oc=AdqHw0Yk3qmrebvFrW-Vzlw3ycOJSsnqgp_orbZVA6BVaURZtOIi6YinA16qzeqyXi0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2Nrqg2SAQGOJ2yJtVTvbAsV_pjYQiNyLaPbMvVRNIHjQ&oe=69F1F7B1"}, {"file_name": "mini-landscape.png", "id": "1155544012016051", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982535_1155544015349384_8958708088103458222_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJv0wc6Ru_AQ7kNvwETBffw&_nc_oc=AdqTFI9PvYa631kFEBTOjBqHfaVjzloPmFkW4vY6IaIi4335snVgnl1mzBPozajR1_w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3B7kK9UVU21qjf20Ahh_nVFztlxF6ZX055agKS4f9vQg&oe=69F1F3C0"}, {"file_name": "HeroCover.png", "id": "1016628869152227", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75363518_1016628872485560_7846994916497395185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-Mi9mqohq0Q7kNvwGyX2ld&_nc_oc=AdqpkgHsQdnikyf-jdnw-4kihLpHlB5AoLyEEUUlhKOMuKCO_sCaP77KbYHXnTgzOQc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2S1lZL9janCyWTFrzGAVekjiJHnXST5yANPHh2EJIwPg&oe=69F20CDE"}, {"file_name": "portrait.png", "id": "673810394264400", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031421_673810397597733_7890662955301697782_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QycHQHMkewQ7kNvwF7hxGu&_nc_oc=Adpgt9HbGKu6RZ-2YyasmelP45-M8Owr2why2IuyWKC4KKn7UOW6VLfG8iGDOsFUUMk&_nc_zt=3&_nc_ht=scon
1200649773862294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031325_1200649780528960_7162269763437816034_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0RHTATLhwgQ7kNvwHH4mQp&_nc_oc=AdmIXt-FsCbpuSHDadgXvXkGORhcWDE0dPLOamkL8TfnUFVkuJywqZcXDwL_63pEedU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyTzHmZNDMehgq1m0J6lsYJP94-xyrqlkB0x_pFi8Xh1g&oe=69B40D08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_CoverImg.png", "id": "2232718963554751", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75371511_2232718966888084_8888000761960422525_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yU480AS1qS8Q7kNvwG2EQ35&_nc_oc=AdnI_D0ahtMTf4BaHbolprBdjPX5D3FDZD_ml1Q88wqHvSPmpsVsLMJKzg-sOAm9lt0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfysEnlAUIKLLssJCtDdX0ekGAZoFAeT-1K8-8P5zvfTbg&oe=69B40E25"}, "display_name": "DiViFaG: Infusionsvorbereitung", "keywords": [], "long_description": "VR Trainingsszenario zum \u00dcben der Vorbereitung von Infusionsmaterialien\n\nNutzerInnen werden in der VR angeleitet, welche Materialien f\u00fcr eine Infusion ben\u00f6tigt werden, wo sie die n\u00f6tigen Informationen finden und wie sie die Materialien anschlie\u00dfend vorbereiten. Dazu m\u00fcssen sie die entsprechenden Informationen einer Patientenmappe entnehmen und anschlie\u00dfend selbstst\u00e4ndig die f\u00fcr die Infusionsvorbereitung notwendigen Schritte durchf\u00fchren. Dabei liegt der Fokus darauf, die Abfolge eines festgelegten Prozesses f\u00fcr die Durchf\u00fchrung der notwendigen Schritte einzustudieren. \nAbschlie\u00dfend k\u00f6nnen die NutzerInnen ihre durchgef\u00fchrten Schritte mit dem vorgesehenen Prozess vergleichen, um etwaige Fehler oder Verbesserungsm\u00f6glichkeiten zu erkennen.\n\nDas Trainingsszenario wurde in Zusammenarbeit mit der Medizinischen Fakult\u00e4t und der Fakult\u00e4t f\u00fcr Erziehungswissenschaften der Universit\u00e4t Bielefeld, der Hochschule Osnabr\u00fcck, der Fachhochschule Bielefeld und der Hochschule Emden/ Leer  im Rahmen des vom BMBF gef\u00f6rderten Forschungsprojektes DiViFaG entwickelt.", "short_description": "VR Trainingsszenario zum \u00dcben der Vorbereitung von Infusionsmaterialien."}, {"images": {"nodes": [{"file_name": "landscape.png", "id": "1779633709047424", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974798_1779633712380757_2318654421865421778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldlnYQzLQRgQ7kNvwG4zlgA&_nc_oc=AdlusnNAt1mi6ES8dbci6cIm--UwAUlwBm7QIruB_YGoZJVaghUy7BE0nr1tFmS_0vU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxwo5siGL-9t4fdnMRZEX2j1N0ZHvYDgOg64EVdGaqlyw&oe=69B40131"}, {"file_name": "mini-landscape.png", "id": "1155544012016051", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982535_1155544015349384_8958708088103458222_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IShfqx26zswQ7kNvwH534gw&_nc_oc=AdmUFUSHiRaGzVJR1-eCxj5wqweUqjUEoLH6QNk-Q5MPaf31Pfm0o2qL6RrdYvzMRSs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz-6-DnHLugQno0NDHNo4IGEGIvrkQPB8gqboN7i_yaug&oe=69B3FD40"}, {"file_name": "HeroCover.png", "id": "1016628869152227", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75363518_1016628872485560_7846994916497395185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9oWyprCn9oQ7kNvwFwuahP&_nc_oc=AdmxHy2CtVS3lMrzrLflSD3OMtNVfxPxFD5P_zfz9R6jTwnYOcJylYrOCbsk_bzmnDE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwKlpNPpy41w_7K6tNYsR-M1jk58kPQrKG8ccGmoQGiAA&oe=69B4165E"}, {"file_name": "portrait.png", "id": "673810394264400", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031421_673810397597733_7890662955301697782_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQZu3rfsv_UQ7kNvwG-ydFt&_nc_oc=Admiw11DHCcVW2PeTWmJGieTN2
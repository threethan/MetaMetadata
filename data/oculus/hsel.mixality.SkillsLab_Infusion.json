1996068366042909810_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0v2wtIxpNMkQ7kNvwHd6cUc&_nc_oc=Adp9-ux3eQ0XMY_5SO2_wtOKLAQ5aTyF2c5ixYSw1ZtlUMLXaDAnP7ektGN-T-pFgKo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQShjFcTrWzH1WVYArxcXUxEk_3TcfVoqb7hwcnoq0KTbQ&oe=6B0C52D7"}, {"file_name": "Untitled-4.png", "id": "1200649773862294", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031325_1200649780528960_7162269763437816034_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPcTAPJvq90Q7kNvwGwFHmy&_nc_oc=AdrajEozygV4Y9b-VKTEH1WOwUcvpipn_0C45TjsEBDUcG83wsyZCsJRsM3zME6DTkU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS--1OUEJESWRUs9gGqQLlRPDIkl5lPEVgWejUNgr3BLw&oe=6B0C5CC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_CoverImg.png", "id": "2232718963554751", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75371511_2232718966888084_8888000761960422525_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2F09882Fo0Q7kNvwF8efZo&_nc_oc=Adq8ll87eSdxbtS_jfvXk7Cw-FcmACPgsu-7c4peEb91BEJZdHZ14-g777yyXZXX0u4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ-Hm9ZVTfiGBB4Npl803D8AhfYPYePOO7ERtxoqfDirw&oe=6B0C5DE5"}, "display_name": "DiViFaG: Infusionsvorbereitung", "keywords": [], "long_description": "VR Trainingsszenario zum \u00dcben der Vorbereitung von Infusionsmaterialien\n\nNutzerInnen werden in der VR angeleitet, welche Materialien f\u00fcr eine Infusion ben\u00f6tigt werden, wo sie die n\u00f6tigen Informationen finden und wie sie die Materialien anschlie\u00dfend vorbereiten. Dazu m\u00fcssen sie die entsprechenden Informationen einer Patientenmappe entnehmen und anschlie\u00dfend selbstst\u00e4ndig die f\u00fcr die Infusionsvorbereitung notwendigen Schritte durchf\u00fchren. Dabei liegt der Fokus darauf, die Abfolge eines festgelegten Prozesses f\u00fcr die Durchf\u00fchrung der notwendigen Schritte einzustudieren. \nAbschlie\u00dfend k\u00f6nnen die NutzerInnen ihre durchgef\u00fchrten Schritte mit dem vorgesehenen Prozess vergleichen, um etwaige Fehler oder Verbesserungsm\u00f6glichkeiten zu erkennen.\n\nDas Trainingsszenario wurde in Zusammenarbeit mit der Medizinischen Fakult\u00e4t und der Fakult\u00e4t f\u00fcr Erziehungswissenschaften der Universit\u00e4t Bielefeld, der Hochschule Osnabr\u00fcck, der Fachhochschule Bielefeld und der Hochschule Emden/ Leer  im Rahmen des vom BMBF gef\u00f6rderten Forschungsprojektes DiViFaG entwickelt.", "short_description": "VR Trainingsszenario zum \u00dcben der Vorbereitung von Infusionsmaterialien."}, {"images": {"nodes": [{"file_name": "landscape.png", "id": "1779633709047424", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974798_1779633712380757_2318654421865421778_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zZnbEvVAH8Q7kNvwGZ4zoa&_nc_oc=Adp4SAVSyypRZ7YH9er7fNYulhYLu4FOgTe5z4s-ogC0gCpjbb2ebF4p-ixG6-HGibo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTxlwy05bBYhgAzZAE9PJi3CQq1b3VPQnHCjWqczS-Emg&oe=6B0C50F1"}, {"file_name": "mini-landscape.png", "id": "1155544012016051", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982535_1155544015349384_8958708088103458222_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJeRmVKocuUQ7kNvwHm4S_M&_nc_oc=Adof2aO5AxApZpGnxsg1Lbv4b5MAzy0b0DJwlltfNxlH4YChRMnCciYSOOo8PPAZLX4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRb5UpiN2J8GAlbjgbomRH9d1EbGMIIBgvS3PdgOOmZkw&oe=6B0C8540"}, {"file_name": "HeroCover.png", "id": "1016628869152227", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75363518_1016628872485560_7846994916497395185_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btO9RL_J9OcQ7kNvwGCaYZ
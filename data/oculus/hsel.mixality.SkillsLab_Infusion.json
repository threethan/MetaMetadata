5C017"}, {"file_name": "Untitled-4.png", "id": "1200649773862294", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031325_1200649780528960_7162269763437816034_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=El8hul6PCGwQ7kNvwEPcBYf&_nc_oc=AdqhWUtEtpw7cVqPkqb8p55QxOQCNvmDvvHJ7-zxhVyXEAqvn8w0MX837d2G2JSaFA8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45iUJMs1B__lPjqieblGYeHN-YAfS6hDLbydBTDzUwQw&oe=6A05CA08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_CoverImg.png", "id": "2232718963554751", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75371511_2232718966888084_8888000761960422525_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKSMHaK68WcQ7kNvwFTVapP&_nc_oc=AdqOd0HwXLrpv6_M-xWkvbg0dLpaIcBXl2ezz-10c5epwv7632e3qqcdkk3o2MpKR2w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Umu08XYcnHTrSw_4dT4RTkis4wH3wV2CE9gtt6STtwQ&oe=6A05CB25"}, "display_name": "DiViFaG: Infusionsvorbereitung", "keywords": [], "long_description": "VR Trainingsszenario zum \u00dcben der Vorbereitung von Infusionsmaterialien\n\nNutzerInnen werden in der VR angeleitet, welche Materialien f\u00fcr eine Infusion ben\u00f6tigt werden, wo sie die n\u00f6tigen Informationen finden und wie sie die Materialien anschlie\u00dfend vorbereiten. Dazu m\u00fcssen sie die entsprechenden Informationen einer Patientenmappe entnehmen und anschlie\u00dfend selbstst\u00e4ndig die f\u00fcr die Infusionsvorbereitung notwendigen Schritte durchf\u00fchren. Dabei liegt der Fokus darauf, die Abfolge eines festgelegten Prozesses f\u00fcr die Durchf\u00fchrung der notwendigen Schritte einzustudieren. \nAbschlie\u00dfend k\u00f6nnen die NutzerInnen ihre durchgef\u00fchrten Schritte mit dem vorgesehenen Prozess vergleichen, um etwaige Fehler oder Verbesserungsm\u00f6glichkeiten zu erkennen.\n\nDas Trainingsszenario wurde in Zusammenarbeit mit der Medizinischen Fakult\u00e4t und der Fakult\u00e4t f\u00fcr Erziehungswissenschaften 
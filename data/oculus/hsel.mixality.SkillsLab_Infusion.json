1996068366042909810_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcxFMzk0VEMQ7kNvwHZmiQZ&_nc_oc=AdofnXZban9gfcKXnHo-P9p_zf7l-XLKPdr0icdGMC3mUSj0UqqRKyjd1ztLS0lEbBU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpl6nzgYGx0PUfrjBRkOD76xdQJhud7y8cO-qpjyV1YQ&oe=6B09AFD7"}, {"file_name": "Untitled-4.png", "id": "1200649773862294", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031325_1200649780528960_7162269763437816034_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8H5oJVZ47-cQ7kNvwHqGarh&_nc_oc=AdrWNl4LS7XSSRWa0v6iPpBkS52ZGveKcQndRWLtEe4qOSqhTEaJcVgWtwEzQLTjvY4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvmPiqZQApDRMOvsS5H8C1Q5gzdzFm8dLMAAtU0Fj_Pw&oe=6B09B9C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_CoverImg.png", "id": "2232718963554751", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75371511_2232718966888084_8888000761960422525_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2F09882Fo0Q7kNvwGSCyNf&_nc_oc=AdrTPCWqbScnak4Y2zHfgJtN6kLMIS2Gw1NbNjlAh3zcalKzgqCqFtR98kIz0eUrkhA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJNupIP4f4PKvtwYlZu5LUGO3jtJbXjd2_cyjLqEch2Q&oe=6B09BAE5"}, "display_name": "DiViFaG: Infusionsvorbereitung", "keywords": [], "long_description": "VR Trainingsszenario zum \u00dcben der Vorbereitung von Infusionsmaterialien\n\nNutzerInnen werden in der VR angeleitet, welche Materialien f\u00fcr eine Infusion ben\u00f6tigt werden, wo sie die n\u00f6tigen Informationen finden und wie sie die Materialien anschlie\u00dfend vorbereiten. Dazu m\u00fcssen sie die entsprechenden Informationen einer Patientenmappe entnehmen und anschlie\u00dfend selbstst\u00e4ndig die f\u00fcr die Infusionsvorbereitung notwendigen Schritte durchf\u00fchren. Dabei liegt der Fokus darauf, die Abfolge eines festgelegten Prozesses f\u00fcr die Durchf\u00fchrung der notwendigen Schritte einzustudieren. \nAbschlie\u00dfend k\u00f6nnen die NutzerInnen ihre durchgef\u00fchrten Schritte mit dem vorgesehenen Prozess vergleichen, um etwaige Fehler oder Verbesserungsm\u00f6glichkeiten zu erkennen.\n\nDas Trainingsszenario wurde in Zusammenarbeit mit der Medizinischen Fakult\u00e4t und der Fakult\u00e4t f\u00fcr Erziehungswissenschaften der Universit\u00e4t Bielefeld, der Hochschule Osnabr\u00fcck, der Fachhochschule Bielefeld und der Hochschule Emden/ Leer  im Rahmen des vom BMBF gef\u00f6rderten Forschungsprojektes DiViFaG entwickelt.", "short_description": "VR Trainingsszenario zum \u00dcben der Vorbereitung von Infusionsmaterialien."}, {"images": {"nodes": [{"file_name": "landscape.png", "id": "1779633709047424", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974798_1779633712380757_2318654421865421778_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zZnbEvVAH8Q7kNvwH1sG84&_nc_oc=AdqU7ravvV7Oi0QMbUoIkw13jcakw5knhGKpfv4qK7-7qRsnxHGN-Uxc0w1SPwoKu4c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSV8JkBCU5IrFdwqQQ2un_EPV4SZkuamQW9RKhKynWIRw&oe=6B09ADF1"}, {"file_name": "mini-landscape.png", "id": "1155544012016051", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982535_1155544015349384_8958708088103458222_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YFnxfMZK9MQ7kNvwEfInwj&_nc_oc=AdrUGjbUk6Ad_HRxxtPbk5bRGgQ6XSu8nYLgLnRI7kGn1BQvHYfoPhOJAwkGmV8JoC8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjgudncpgavDYsjN3KGRCsFNZawukPyrg7EB5IyhoIMA&oe=6B09AA00"}, {"file_name": "HeroCover.png", "id": "1016628869152227", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75363518_1016628872485560_7846994916497395185_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btO9RL_J9OcQ7kNvwG7RBW
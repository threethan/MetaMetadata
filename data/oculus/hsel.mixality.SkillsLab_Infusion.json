1200649773862294", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031325_1200649780528960_7162269763437816034_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_kSu0rmKZYQ7kNvwGpdLbY&_nc_oc=Adn6L9JNWsAh7WNkNxHA4Nay6IOiA0IrGv3IZN_Qq9RezezsDgJDZar5jSUxqlFWcwA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyLyjsvXtbfUY1DXoBmkw4WnJLQ4yv485_hQVO7WtNkXA&oe=69BAA488"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_CoverImg.png", "id": "2232718963554751", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75371511_2232718966888084_8888000761960422525_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Umwoam4Z0IQ7kNvwEVk-xo&_nc_oc=Adk5Dcnk_4qKuqal9ItSlmj-kg1tkotCtF0FDUAyJe6MbQ1Fw7JMGuQIjfqEs9YKOAA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw1D2vZ_NHc85p4h3fd8BvUSZQYlKCNsOh_mTneReDg7A&oe=69BAA5A5"}, "display_name": "DiViFaG: Infusionsvorbereitung", "keywords": [], "long_description": "VR Trainingsszenario zum \u00dcben der Vorbereitung von Infusionsmaterialien\n\nNutzerInnen werden in der VR angeleitet, welche Materialien f\u00fcr eine Infusion ben\u00f6tigt werden, wo sie die n\u00f6tigen Informationen finden und wie sie die Materialien anschlie\u00dfend vorbereiten. Dazu m\u00fcssen sie die entsprechenden Informationen einer Patientenmappe entnehmen und anschlie\u00dfend selbstst\u00e4ndig die f\u00fcr die Infusionsvorbereitung notwendigen Schritte durchf\u00fchren. Dabei liegt der Fokus darauf, die Abfolge eines festgelegten Prozesses f\u00fcr die Durchf\u00fchrung der notwendigen Schritte einzustudieren. \nAbschlie\u00dfend k\u00f6nnen die NutzerInnen ihre durchgef\u00fchrten Schritte mit dem vorgesehenen Prozess vergleichen, um etwaige Fehler oder Verbesserungsm\u00f6glichkeiten zu erkennen.\n\nDas Trainingsszenario wurde in Zusammenarbeit mit der Medizinischen Fakult\u00e4t und der Fakult\u00e4t f\u00fcr Erziehungswissenschaften der Universit\u00e4t Bielefeld, der Hochschule Osnabr\u00fcck, der Fachhochschule Bielefeld und der Hochschule Emden/ Leer  im Rahmen des vom BMBF gef\u00f6rderten Forschungsprojektes DiViFaG entwickelt.", "short_description": "VR Trainingsszenario zum \u00dcben der Vorbereitung von Infusionsmaterialien."}, {"images": {"nodes": [{"file_name": "landscape.png", "id": "1779633709047424", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974798_1779633712380757_2318654421865421778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRGGWsXX8f4Q7kNvwFBFTCh&_nc_oc=Admv1eLAShDbGCD9XabxujNrp8bfpZhDH4h6WgLsS7Za4xXzypSojZTHxLOsyc1Q9Mk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw2l49JrUf_v17DdP0fA3pY3BsRjo-EmlFMUBV0NdADsg&oe=69BA98B1"}, {"file_name": "mini-landscape.png", "id": "1155544012016051", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982535_1155544015349384_8958708088103458222_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSFYNef_nWUQ7kNvwGmy1ND&_nc_oc=Adk6d2nduwVytmgXQcvFYlLDNXiy13wNzmGw8SGklz8345v6QaPPhshf8BWUFMjLY2Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwwzQ39M78XdhFf-dJlqc7p0_EHNQ3s6XMy4kReTa73hQ&oe=69BA94C0"}, {"file_name": "HeroCover.png", "id": "1016628869152227", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75363518_1016628872485560_7846994916497395185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kU5130lFbKUQ7kNvwEGbaBv&_nc_oc=AdkggQAfDLXZk0EpimUn1kX1Jucu0NrkxyY02aOzeeyKSfkdnQ8BdMiMcG9UnTtpfJg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxq_MQzLFMjOTAi8NQaZrF7i-9hDzCYia0F7Njk_Kw7sQ&oe=69BAADDE"}, {"file_name": "portrait.png", "id": "673810394264400", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031421_673810397597733_7890662955301697782_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqZ7EGE9NRIQ7kNvwHE3IuK&_nc_oc=AdkdczIzDC6ocOQYSiSGSV1xvh
n.com/v/t64.5771-25/39036693_601308635102955_7333829931503156532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PgmOeROaJW0Q7kNvwEpxEaH&_nc_oc=AdlFKTkpnLlkayhYhOxmVubZg3aB5kB7zXC6pxNr2-7_GQW-9met8v8dwlHOwj0YHtk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsgHaOlY5nIRDjjhWnA15FlEu8ifUl-Xnz7tFVQYnQRwQ&oe=699AF8F6"}, {"file_name": "Untitled-3.png", "id": "960575934903272", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035344_960575938236605_2940614989914722646_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zus1wKaH7icQ7kNvwESodWu&_nc_oc=AdmULNDv9hY4hwFgfMI_FVxMqLxdHXzs_dtCbGVERls6NQ9eldUUhAFZbVA2Dia3FKM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs1ECvkfxguNnSCAoG74vGMf2NkgvNaaHi6Y1JaKePSpA&oe=699B076D"}, {"file_name": "Untitled-5.png", "id": "796200768114248", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031339_796200771447581_2597385095781905687_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dBAz5T7ZqEQ7kNvwHyMEKZ&_nc_oc=AdnKBHCrmsUam5g_Zi7yam9VDWsDMSetxC6PKraM1dXHqI7wL6GPxr3yd6ZI_iJSH0A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftQKBkiUI7EaWRD71Vx2-09uekBA19_uBJ_2uOayObtkQ&oe=699AF875"}, {"file_name": "Untitled-4.png", "id": "1235210823711352", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982559_1235210827044685_4446252330918973545_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sjqO9BxcnMQ7kNvwFdAO68&_nc_oc=Adl8JfC4ya9OORnZ41_cbvkvo_rc1p3IM69YwnfeTcVLeLxBvNNbk6XXiCcGwbjR1ng&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftKlqVjsJOHl5kTs8LJ30AgXHxX6zGy0aLFYulm_jhyFQ&oe=699B1194"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_CoverImg.png", "id": "899473614737038", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974716_899473618070371_3768622200222813924_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xqabdd5DWboQ7kNvwFr96fI&_nc_oc=Adk6CIHDUrKx5j2SoJDQNflJV_x_IWyymc4xAfGLD_Nh1DYnMxAO1x-prnhTtvNr4AY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftgbzSV1sCNFnTblSC2Sg0M27lvw3BjZMYn1-raV1Z0pw&oe=699AE37A"}, "display_name": "DiViFaG: Infusion Preparation", "keywords": [], "long_description": "VR training scenario for practicing the preparation of infusion materials\n\nIn VR, users are instructed as to which materials are required for an infusion, where to find the necessary information, and how to prepare the materials afterward. To do this, they have to get the relevant information from a patient file and independently carry out the steps required to prepare the infusion. The focus is on rehearsing the sequence of a predefined process for carrying out the necessary steps.\nFinally, users can compare the steps they have taken with the intended process in order to identify any errors or opportunities for improvement.\n\nThe training scenario was developed in cooperation with the medical faculty and the faculty for educational sciences at Bielefeld University,  University of Applied Sciences Osnabr\u00fcck,  University of Applied Sciences Bielefeld, and University of Applied Sciences Emden/Leer as part of the BMBF-funded DiViFaG research project.", "short_description": "VR training scenario for practicing the preparation of infusion materials."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mixality.de/divifag-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MixalityLab Emden", "support_website_url": null, "website_url": "https://mixality.de/divifag-info/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de
1200649773862294", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031325_1200649780528960_7162269763437816034_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZD5PXpkaZhIQ7kNvwHLzzzo&_nc_oc=Adlmo8wMYFPWKD0xJsqfv2z9oQXdpcnmymef4bcWXdthhiVATON-tHbXn1ATMvpJ2tY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyiGbVE4IfXojRP0gFdRqJVbnj7RJfon-fWALaF-FbwJw&oe=69BD4788"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_CoverImg.png", "id": "2232718963554751", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75371511_2232718966888084_8888000761960422525_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3QgxPcwCSMQ7kNvwFch08s&_nc_oc=Adn1h8ms6Y0yUTpDw_iDmzEmgJh5TeMyJJtPvj38p-Kw70tHqHjF5nYD4cGWpWLzBL0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzOC8v8hHT7UWXwISfe0BkZcRFPCGZOc0lpdeEYnbrY4g&oe=69BD48A5"}, "display_name": "DiViFaG: Infusionsvorbereitung", "keywords": [], "long_description": "VR Trainingsszenario zum \u00dcben der Vorbereitung von Infusionsmaterialien\n\nNutzerInnen werden in der VR angeleitet, welche Materialien f\u00fcr eine Infusion ben\u00f6tigt werden, wo sie die n\u00f6tigen Informationen finden und wie sie die Materialien anschlie\u00dfend vorbereiten. Dazu m\u00fcssen sie die entsprechenden Informationen einer Patientenmappe entnehmen und anschlie\u00dfend selbstst\u00e4ndig die f\u00fcr die Infusionsvorbereitung notwendigen Schritte durchf\u00fchren. Dabei liegt der Fokus darauf, die Abfolge eines festgelegten Prozesses f\u00fcr die Durchf\u00fchrung der notwendigen Schritte einzustudieren. \nAbschlie\u00dfend k\u00f6nnen die NutzerInnen ihre durchgef\u00fchrten Schritte mit dem vorgesehenen Prozess vergleichen, um etwaige Fehler oder Verbesserungsm\u00f6glichkeiten zu erkennen.\n\nDas Trainingsszenario wurde in Zusammenarbeit mit der Medizinischen Fakult\u00e4t und der Fakult\u00e4t f\u00fcr Erziehungswissenschaften der Universit\u00e4t Bielefeld, der Hochschule Osnabr\u00fcck, der Fachhochschule Bielefeld und der Hochschule Emden/ Leer  im Rahmen des vom BMBF gef\u00f6rderten Forschungsprojektes DiViFaG entwickelt.", "short_description": "VR Trainingsszenario zum \u00dcben der Vorbereitung von Infusionsmaterialien."}, {"images": {"nodes": [{"file_name": "landscape.png", "id": "1779633709047424", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974798_1779633712380757_2318654421865421778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqWDX-88GekQ7kNvwGGAbJ2&_nc_oc=Adm8aXcAGGocWbKX7Ch0oKrbM67lW4JmlWEronXL_OpCS3aToO8fCTh32bY21aax9OM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzvgnlEYAMC9kjwFaqPBd4s6kQk-1Db-KVlrh5p8FT9pQ&oe=69BD3BB1"}, {"file_name": "mini-landscape.png", "id": "1155544012016051", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982535_1155544015349384_8958708088103458222_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6OMSvVJ1q8Q7kNvwGV4Zjh&_nc_oc=AdnjDEg2U1vT4OcK8Wy-TW35XBAdDVxT5nz0G6SbxG4hGIo7vr0JCrymheWdbmINc3M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy2B9TGBs1wskzq9Wy04rFy9Tn4Dtg6wWkCifx8mooHmQ&oe=69BD37C0"}, {"file_name": "HeroCover.png", "id": "1016628869152227", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75363518_1016628872485560_7846994916497395185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecFu28mxx9MQ7kNvwHhylPI&_nc_oc=AdlKqfkY3pJ2S9WcR-OTp6DbYRmnFuMpGWmrQjcXEzsWKzIxNMaiN71kvn_2TG-t9_o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afym1FEsWxloZZvEO2TfwOc-DxCeMXGDJGqhFeYfcLumBA&oe=69BD50DE"}, {"file_name": "portrait.png", "id": "673810394264400", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031421_673810397597733_7890662955301697782_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZcHje9hUAUQ7kNvwE-orPV&_nc_oc=AdmAadRna5ipjXuXNaX_ZxDQU8
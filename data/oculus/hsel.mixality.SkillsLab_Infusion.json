1996068366042909810_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JkhuvEtwDgQ7kNvwGfWiRP&_nc_oc=AdrEWs-kYFwgQdF1NlT_rCKi-QbNXnxMNrIZ-kgYRYwbZb2gKoe-dkAzmAI72bCepJM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcFd9QnltWXMl5o-BiklIwrAinIdB7mcP20ABLz35K3A&oe=6B007557"}, {"file_name": "Untitled-4.png", "id": "1200649773862294", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031325_1200649780528960_7162269763437816034_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUoaeGdZPsoQ7kNvwFFafGd&_nc_oc=AdrMC0JJANn5e8fW0InnwWL2UcAs9t3ElUhHbU7IHIG3p9la0whBPkWDQZOoQATklEs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSR6cRx9jgRa-zkf1Wkg7Hu33wsle0CDPZGil9lBdDluQ&oe=6B007F48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_CoverImg.png", "id": "2232718963554751", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75371511_2232718966888084_8888000761960422525_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vWfrKByPEwQ7kNvwG6uxmw&_nc_oc=AdrCTfkiVsFygFh6_jQC4BvkieJlkzMGc2voTpkKCPcTEn1AtuIpjQ4J6I7nnxMzVMo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLtvUGitniccTMnYwTxuF87twCleovC8iBG1jCBSNZWw&oe=6B008065"}, "display_name": "DiViFaG: Infusionsvorbereitung", "keywords": [], "long_description": "VR Trainingsszenario zum \u00dcben der Vorbereitung von Infusionsmaterialien\n\nNutzerInnen werden in der VR angeleitet, welche Materialien f\u00fcr eine Infusion ben\u00f6tigt werden, wo sie die n\u00f6tigen Informationen finden und wie sie die Materialien anschlie\u00dfend vorbereiten. Dazu m\u00fcssen sie die entsprechenden Informationen einer Patientenmappe entnehmen und anschlie\u00dfend selbstst\u00e4ndig die f\u00fcr die Infusionsvorbereitung notwendigen Schritte durchf\u00fchren. Dabei liegt der Fokus darauf, die Abfolge eines festgelegten Prozesses f\u00fcr die Durchf\u00fchrung der notwendigen Schritte einzustudieren. \nAbschlie\u00dfend k\u00f6nnen die NutzerInnen ihre durchgef\u00fchrten Schritte mit dem vorgesehenen Prozess vergleichen, um etwaige Fehler oder Verbesserungsm\u00f6glichkeiten zu erkennen.\n\nDas Trainingsszenario wurde in Zusammenarbeit mit der Medizinischen Fakult\u00e4t und der Fakult\u00e4t f\u00fcr Erziehungswissenschaften der Universit\u00e4t Bielefeld, der Hochschule Osnabr\u00fcck, der Fachhochschule Bielefeld und der Hochschule Emden/ Leer  im Rahmen des vom BMBF gef\u00f6rderten Forschungsprojektes DiViFaG entwickelt.", "short_description": "VR Trainingsszenario zum \u00dcben der Vorbereitung von Infusionsmaterialien."}, {"images": {"nodes": [{"file_name": "landscape.png", "id": "1779633709047424", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974798_1779633712380757_2318654421865421778_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgQkuMX4WfAQ7kNvwFFWVyQ&_nc_oc=Adr2pr5r_utRoiki1UusS01FDYgaD45OW4WHKetQacN3qYWD6Znu6fS9EEJMu92dS2I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHlFYtFp0k2skSWTb3yoyD9smnecZhaUmt0dubu713EQ&oe=6B007371"}, {"file_name": "mini-landscape.png", "id": "1155544012016051", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982535_1155544015349384_8958708088103458222_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXtDhJh7dB8Q7kNvwF0ckWH&_nc_oc=AdreJADxXcwe7Mvec6b-nu-EjsQ3xtfnbFNNBjFFTNJ1bcVcDzVmrqkHwovMIALoLKA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxy14UNGyvCrFGNbAzl3OLiM_4cHUqLVI5M0ziD6RtUg&oe=6B006F80"}, {"file_name": "HeroCover.png", "id": "1016628869152227", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75363518_1016628872485560_7846994916497395185_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSSO0QxLbGMQ7kNvwG8Inn
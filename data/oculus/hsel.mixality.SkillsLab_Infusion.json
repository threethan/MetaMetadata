1200649773862294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031325_1200649780528960_7162269763437816034_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZD5PXpkaZhIQ7kNvwG8ZlhE&_nc_oc=AdkhDo7n5ywkZPDUgNvghnXR1qxcxjX3kE4rxrjjDOuoU0UR8zOyUx1-z9_TjaeMIXw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfycX7LbMJOSvfuaKpzEVoPqtH-TZvI8D5nZ871xbz1OTA&oe=69BBF608"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_CoverImg.png", "id": "2232718963554751", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371511_2232718966888084_8888000761960422525_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Umwoam4Z0IQ7kNvwEFEwek&_nc_oc=AdlS8ew0CnJCdugj2Xv7UXFYF2pDSeJN8xJcZ_zOH_UxUhm18deUFpvYu7ZSJylPpjQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxJ5nSoS-paQGx17tbk_gdvJzH3FUefAVuaNsk0bfr5sA&oe=69BBF725"}, "display_name": "DiViFaG: Infusionsvorbereitung", "keywords": [], "long_description": "VR Trainingsszenario zum \u00dcben der Vorbereitung von Infusionsmaterialien\n\nNutzerInnen werden in der VR angeleitet, welche Materialien f\u00fcr eine Infusion ben\u00f6tigt werden, wo sie die n\u00f6tigen Informationen finden und wie sie die Materialien anschlie\u00dfend vorbereiten. Dazu m\u00fcssen sie die entsprechenden Informationen einer Patientenmappe entnehmen und anschlie\u00dfend selbstst\u00e4ndig die f\u00fcr die Infusionsvorbereitung notwendigen Schritte durchf\u00fchren. Dabei liegt der Fokus darauf, die Abfolge eines festgelegten Prozesses f\u00fcr die Durchf\u00fchrung der notwendigen Schritte einzustudieren. \nAbschlie\u00dfend k\u00f6nnen die NutzerInnen ihre durchgef\u00fchrten Schritte mit dem vorgesehenen Prozess vergleichen, um etwaige Fehler oder Verbesserungsm\u00f6glichkeiten zu erkennen.\n\nDas Trainingsszenario wurde in Zusammenarbeit mit der Medizinischen Fakult\u00e4t und der Fakult\u00e4t f\u00fcr Erziehungswissenschaften der Universit\u00e4t Bielefeld, der Hochschule Osnabr\u00fcck, der Fachhochschule Bielefeld und der Hochschule Emden/ Leer  im Rahmen des vom BMBF gef\u00f6rderten Forschungsprojektes DiViFaG entwickelt.", "short_description": "VR Trainingsszenario zum \u00dcben der Vorbereitung von Infusionsmaterialien."}, {"images": {"nodes": [{"file_name": "landscape.png", "id": "1779633709047424", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974798_1779633712380757_2318654421865421778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRGGWsXX8f4Q7kNvwEeUNxr&_nc_oc=AdkC_3oGJvsRtA91JsXIfaWCVlf83d8B6e7FnvQiDUUedtu1VVx0cX4K_S_cGY56Fw4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy0ESFtXjBI5Kj4zJL0wLF6IxGM-vYNJ83eN8ztxYVQlg&oe=69BBEA31"}, {"file_name": "mini-landscape.png", "id": "1155544012016051", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982535_1155544015349384_8958708088103458222_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6OMSvVJ1q8Q7kNvwELAFqz&_nc_oc=Adk7--nTXVAmEiKRcWWaN7M2fiPGbeTMqrBNkg5Hm2uuO2xD-WV4ldPtMhGCt5RkiFw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwFjmb9Xcz2vG4wue-EGeDpPw7foc7qQcJoFv3IXskf1g&oe=69BBE640"}, {"file_name": "HeroCover.png", "id": "1016628869152227", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75363518_1016628872485560_7846994916497395185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kU5130lFbKUQ7kNvwHdpwo6&_nc_oc=AdkKslBS_OFqgrKoE05C7dTxGGzZrt2WG_VsXKZeMqQVvFchOMaxIlvUqYzYP9ZEfjA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyYead2p0Z1a6qigi_YC6n04o3X4je_jhfebBQWPM_PDg&oe=69BBFF5E"}, {"file_name": "portrait.png", "id": "673810394264400", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031421_673810397597733_7890662955301697782_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZcHje9hUAUQ7kNvwE476ns&_nc_oc=Adlt5jzKqBQRtLhafXxF19hAXK
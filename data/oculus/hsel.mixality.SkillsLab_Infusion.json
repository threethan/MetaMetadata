76D97"}, {"file_name": "Untitled-4.png", "id": "1200649773862294", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031325_1200649780528960_7162269763437816034_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4_Eetlm3qUQ7kNvwFshDIg&_nc_oc=AdpMSW4M8my6C8_kXLPmUSz9yfcE-mSDKF975fOhyh_kmvsgeK0RLXaDyNDIAT46oEU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24XicwD0pghFZxBFM-p5nFVb82-SiIC0fHOiIRZNNa_Q&oe=69E77788"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_CoverImg.png", "id": "2232718963554751", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75371511_2232718966888084_8888000761960422525_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qplHHootJUQ7kNvwFEHyIM&_nc_oc=Adqhf_0dKUFKp6-r8H6MlAT6iI2FiYc0_4z6_XA8CFWmNnwbmgd8QqQGhQJOrjWUoeg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1g8mv2X7pVk2nsNsbEIx0J7ai-GDycomD1Ffp86lJUVQ&oe=69E778A5"}, "display_name": "DiViFaG: Infusionsvorbereitung", "keywords": [], "long_description": "VR Trainingsszenario zum \u00dcben der Vorbereitung von Infusionsmaterialien\n\nNutzerInnen werden in der VR angeleitet, welche Materialien f\u00fcr eine Infusion ben\u00f6tigt werden, wo sie die n\u00f6tigen Informationen finden und wie sie die Materialien anschlie\u00dfend vorbereiten. Dazu m\u00fcssen sie die entsprechenden Informationen einer Patientenmappe entnehmen und anschlie\u00dfend selbstst\u00e4ndig die f\u00fcr die Infusionsvorbereitung notwendigen Schritte durchf\u00fchren. Dabei liegt der Fokus darauf, die Abfolge eines festgelegten Prozesses f\u00fcr die Durchf\u00fchrung der notwendigen Schritte einzustudieren. \nAbschlie\u00dfend k\u00f6nnen die NutzerInnen ihre durchgef\u00fchrten Schritte mit dem vorgesehenen Prozess vergleichen, um etwaige Fehler oder Verbesserungsm\u00f6glichkeiten zu erkennen.\n\nDas Trainingsszenario wurde in Zusammenarbeit mit der Medizinischen Fakult\u00e4t und der Fakult\u00e4t f\u00fcr Erziehungswissenschaften 
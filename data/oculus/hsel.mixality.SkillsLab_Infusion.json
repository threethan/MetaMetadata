1200649773862294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031325_1200649780528960_7162269763437816034_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_kSu0rmKZYQ7kNvwHcALV_&_nc_oc=AdkOStb9C6i6IKp-qDy23TrIo9SEwW-to3TGxx5hJrcZiWDaZdsd35oj3lYfPWZgexQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw7XLzLVuEkqmceNYyX8x7ZDsGo-hVmmrtCSy_C_qAkLg&oe=69B95308"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_CoverImg.png", "id": "2232718963554751", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371511_2232718966888084_8888000761960422525_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Umwoam4Z0IQ7kNvwHzbQRq&_nc_oc=AdlGgivU9wn_gAmCkKiiPQboiYbcp1wy-eTGliz-bSDazrMQhhNMshYGj6JhPt-7JhU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy3nZULi5JcLN-oEBM86I6L0S0gGN0WTtCZ7GNAZn17GA&oe=69B95425"}, "display_name": "DiViFaG: Infusionsvorbereitung", "keywords": [], "long_description": "VR Trainingsszenario zum \u00dcben der Vorbereitung von Infusionsmaterialien\n\nNutzerInnen werden in der VR angeleitet, welche Materialien f\u00fcr eine Infusion ben\u00f6tigt werden, wo sie die n\u00f6tigen Informationen finden und wie sie die Materialien anschlie\u00dfend vorbereiten. Dazu m\u00fcssen sie die entsprechenden Informationen einer Patientenmappe entnehmen und anschlie\u00dfend selbstst\u00e4ndig die f\u00fcr die Infusionsvorbereitung notwendigen Schritte durchf\u00fchren. Dabei liegt der Fokus darauf, die Abfolge eines festgelegten Prozesses f\u00fcr die Durchf\u00fchrung der notwendigen Schritte einzustudieren. \nAbschlie\u00dfend k\u00f6nnen die NutzerInnen ihre durchgef\u00fchrten Schritte mit dem vorgesehenen Prozess vergleichen, um etwaige Fehler oder Verbesserungsm\u00f6glichkeiten zu erkennen.\n\nDas Trainingsszenario wurde in Zusammenarbeit mit der Medizinischen Fakult\u00e4t und der Fakult\u00e4t f\u00fcr Erziehungswissenschaften der Universit\u00e4t Bielefeld, der Hochschule Osnabr\u00fcck, der Fachhochschule Bielefeld und der Hochschule Emden/ Leer  im Rahmen des vom BMBF gef\u00f6rderten Forschungsprojektes DiViFaG entwickelt.", "short_description": "VR Trainingsszenario zum \u00dcben der Vorbereitung von Infusionsmaterialien."}, {"images": {"nodes": [{"file_name": "landscape.png", "id": "1779633709047424", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974798_1779633712380757_2318654421865421778_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRGGWsXX8f4Q7kNvwHxgRPV&_nc_oc=Adm25_4hClozUL16__8NPB7V89Jx09Bly04OK0HhTScSTw8425dNIupzNUX1rcuiFbk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwLDTxOG7ayyLgyYyBGxQzTWXmaWzBuhj252MZQ0zTDtg&oe=69B94731"}, {"file_name": "mini-landscape.png", "id": "1155544012016051", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982535_1155544015349384_8958708088103458222_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSFYNef_nWUQ7kNvwEHcIG9&_nc_oc=AdnvhxfM5kcbs0n4hmyyDrfAudrVCjEYCbyNiVJH1K1wWhP23GnLtuiKeeZhpyvpKyc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxEyrd_XfINFYrkrLy6m6aPcgZ56tIHJwWWwaEDwi0LuQ&oe=69B94340"}, {"file_name": "HeroCover.png", "id": "1016628869152227", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75363518_1016628872485560_7846994916497395185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kU5130lFbKUQ7kNvwHdq6He&_nc_oc=AdlgfYCgq2P_ua_3zFi2g5I_QzedPxWGcsyyqSm12e440vL6PPq22Onnh7S0O3ohvzk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwL7GE7kL_5k3Kr5KYPqHa92dZWdI6T8JvOe4eQnbgKbw&oe=69B95C5E"}, {"file_name": "portrait.png", "id": "673810394264400", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031421_673810397597733_7890662955301697782_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqZ7EGE9NRIQ7kNvwGURo13&_nc_oc=AdmW6Qk6p9x1IvEaUjC_SqAaYm
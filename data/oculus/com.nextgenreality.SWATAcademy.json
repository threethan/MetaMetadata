 VR controller, SWAT Academy gives you full tactical control, letting you take the action into your hands. Combine that with the insanely detailed weapon models and atmospheric environments, and you've got a visceral VR experience like you've never felt before.", "short_description": "Have you got what it takes to join the world's most elite police unit? "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thebinarymill.com/privacy.php", "developer_terms_of_service_url": "http://www.thebinarymill.com/terms.php", "publisher_name": "The Binary Mill", "support_website_url": null, "website_url": "http://www.thebinarymill.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "238534165011996"}}]}, "scheduled_offers": {"count": 50, "nodes": [{"status": "PUBLISHED", "id": "2369856159902109"}, {"status": "PUBLISHED", "id": "2259671297591919"}, {"status": "PUBLISHED", "id": "1858149204212472"}, {"status": "PUBLISHED", "id": "153058272005605"}, {"status": "PUBLISHED", "id": "198021654177384"}, {"status": "PUBLISHED", "id": "710972035921611"}, {"status": "PUBLISHED", "id": "182844242551481"}, {"status": "PUBLISHED", "id": "650905465518033"}, {"status": "PENDING", "id": "323293298588747"}, {"status": "PUBLISHED", "id": "698537483824504"}, {"status": "PUBLISHED", "id": "155519385387546"}, {"status": "PUBLISHED", "id": "496048507570675"}, {"status": "PUBLISHED", "id": "345200349739408"}, {"status": "PUBLISHED", "id": "1861204392974
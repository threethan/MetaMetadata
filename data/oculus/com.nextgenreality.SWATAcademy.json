-25/12386450_1375567299132815_1742233645168459776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2YUM-EduzAQ7kNvwGjY0b4&_nc_oc=Adrz0TWt35E4SR3azNlhUaLPbIBRRK3OJwde5kJzi5FmIirfjR9UnlmtCMb5cUevkn0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCclbrETUuCkqy0jSxAW8tuZSNX2V5f89lJ0V5m0kr_7A&oe=6A4A766E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swat Sceenshot14_thumbnail.png", "id": "481016222314101", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410487_481016225647434_1033787920793731072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLKrJAZz2R4Q7kNvwHLAW97&_nc_oc=AdpLJFCy4rLPrINludO6lPvOj4sVpaSw86ad6iZpBfjJhur9uuSXtNfO9sw1OUvf5gQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdjYj8V18Gc1VgSqLcC6yDBBwgAQq4FHaN9WI29rD-lQ&oe=6A4A6B3D"}, "display_name": "SWAT Academy", "keywords": ["SWAT", "Shooter", "FPS", "GunClub", "Gun"], "long_description": "SWAT Academy puts you to the test as you master the weapons and tactics needed to become the best of the best. Hone your skills in the intense combat training simulations, face off against waves of hostile targets, and survive the onslaught of the zombie horde.\n\nDesigned to use the new 3DOF controller, SWAT Academy gives you full tactical control, letting you take the action into your hands. Combine that with the insanely detailed weapon models and atmospheric environments, and you've got a visceral VR experience like you've never felt before.", "short_description": "SWAT Academy puts you to the test as you master the weapons and tactics needed to become the best of the best.\n\nHave you got what it takes to join the world's most elite police unit?"}]}, "developer_name": "The Binary Mill", "developer_privacy_policy_url": "http://www.thebinarymill.com/privacy.php", "developer_terms_of_service_url": "http://www.thebinarymill.com/terms.php", "publisher_name": "The Binary Mill", "support_website_url": null, "website_url": "http://www.thebinarymil
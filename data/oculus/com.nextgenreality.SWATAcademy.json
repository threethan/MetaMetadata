_oc=Adru7D3xwC61oxzbSJ875So-u-VmyDb6aMZ0ibLClDBi8pfaRwRA-iHeOy494MQ-ODQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7enqJJDqC02RpY-IpSMxaLi8n4-w7hIpdJ6Hak8BC6cQ&oe=69FA0AEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swat Sceenshot14_thumbnail.png", "id": "481016222314101", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410487_481016225647434_1033787920793731072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuAyEjzrs-QQ7kNvwFFrq2z&_nc_oc=AdqSF4VEzVbhC-Pkmqyspts29jtWACcEaWQLIRHXmXhznuZO25tiRkJdhZbJ066_m90&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4usI2vkQkF7yRoMgra0a8OyjPvTZN7Oot0d5whpcHVVA&oe=69F9FFBD"}, "display_name": "SWAT Academy", "keywords": ["SWAT", "Shooter", "FPS", "GunClub", "Gun"], "long_description": "SWAT Academy puts you to the test as you master the weapons and tactics needed to become the best of the best. Hone your skills in the intense combat training simulations, face off against waves of hostile targets, and survive the onslaught of the zombie horde.\n\nDesigned to use the new 3DOF controller, SWAT Academy gives you full tactical control, letting you take the action into your hands. Combine that with the insanely detailed weapon models and atmospheric environments, and you've got a visceral VR experience like you've never felt before.", "short_description": "SWAT Academy puts you to the test as you master the weapons and tactics needed to become the best of the best.\n\nHave you got what it takes to join the world's most elite police unit?"}]}, "developer_name": "The Binary Mill", "developer_privacy_policy_url": "http://www.thebinarymill.com/privacy.php", "developer_terms_of_service_url": "http://www.thebinarymill.com/terms.php", "publisher_name": "The Binary Mill", "support_website_url": null, "website_url": "http://www.thebinarymill.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context
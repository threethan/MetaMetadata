-25/12386450_1375567299132815_1742233645168459776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwW97B1TsEQQ7kNvwG5E4-B&_nc_oc=AdqkssW-Ifbbc-v08HG5YZfbmBGa-iE25I3o8q73btur9fvCyte8EV30-j511r0hdFA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qAY_XhZdX1xJhAaX4SLKUuTKjV7Y5NV49DqQ2q4mMlw&oe=6A340CEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swat Sceenshot14_thumbnail.png", "id": "481016222314101", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12410487_481016225647434_1033787920793731072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bj9dAAXhyFAQ7kNvwEh_rSB&_nc_oc=AdoWS0DF3j6kgny3SKJ22maJQhIFumLBB9Cs7IF2RYpyQoBbVflIwg-OvyQ3vz2xIjw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yqcFjoGesw8xb7xkE-in5cSZLcY7nJd_zHSXITRmKPw&oe=6A3401BD"}, "display_name": "SWAT Academy", "keywords": ["SWAT", "Shooter", "FPS", "GunClub", "Gun"], "long_description": "SWAT Academy puts you to the test as you master the weapons and tactics needed to become the best of the best. Hone your skills in the intense combat training simulations, face off against waves of hostile targets, and survive the onslaught of the zombie horde.\n\nDesigned to use the new 3DOF controller, SWAT Academy gives you full tactical control, letting you take the action into your hands. Combine that with the insanely detailed weapon models and atmospheric environments, and you've got a visceral VR experience like you've never felt before.", "short_description": "SWAT Academy puts you to the test as you master the weapons and tactics needed to become the best of the best.\n\nHave you got what it takes to join the world's most elite police unit?"}]}, "developer_name": "The Binary Mill", "developer_privacy_policy_url": "http://www.thebinarymill.com/privacy.php", "developer_terms_of_service_url": "http://www.thebinarymill.com/terms.php", "publisher_name": "The Binary Mill", "support_website_url": null, "website_url": "http://www.thebinarymil
wq8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIoDkQpd0s1ACHmlQno-yLXkFRWk4mPjwGZW-4iQNUOw&oe=6A9D8BFF"}]}, "id": "2216829022496287", "locale": "en_US", "screenshots": [{"file_name": "01-six-off-the-middle.png", "id": "4119876334980261", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823746_4119876338313594_2058807665025830005_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7gugc_ofr8Q7kNvwENC4BJ&_nc_oc=AdqWwWb1snByGbspQ_Ml__FfOZFKz8ymCKt4IdCyvr35tsLgoyXg0H5CrI9LW3uD5ig&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIezUEVmEDCWn_3FMCYatZ6_jGyC5x6wS1uml5l8nBrZA&oe=6A9D7D5E"}, {"file_name": "04-nine-worlds.png", "id": "1567384358444245", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_1567384361777578_4261667750943006283_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItPW_oYxM08Q7kNvwGwIxSV&_nc_oc=AdrAKRbtsl2cqkFMw43xhRofTF_AqluJ-g_UXM79ttc4JgYkhhbHCjxD0mtiScJc00Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGrDYoqzOhDlAKdoFqp6121eB8pXHWO0U3c3Uj8f-obw&oe=6A9D8816"}, {"file_name": "02-facing-the-bowler.png", "id": "1347284690855646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823259_1347284694188979_2481720479515376601_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0oH2VRGa9AQ7kNvwE2J7P7&_nc_oc=AdrkWj8-GH1_M2SdnJMe-b5_UMxlUlc6T9keb44tRIukrQ0lb0fpqeHVsu40xLoZxQs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2xF2gkSWodBB9vClus67_QbNLY3O88vQIiTEOb052WA&oe=6A9D796B"}, {"file_name": "03-six-game-modes.png", "id": "1533550971589398", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827585_1533550974922731_1920737863334981423_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-uBS1FMRDgQ7kNvwH0ZU0r&_nc_oc=Adp3LCVIXi93oiK2XZ_daCqDXfQ5m1weOVEfzW7f2rCky32s9oQIoL7mJL4QzLVyaiw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmyPjyiS-94mrkpkZUUMylra4S2iJawvLLJ6L2HlQbrg&oe=6A9D59A2"}, {"file_name": "05-bowled.png", "id": "2504686226661520", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824322_2504686233328186_2138386694095458574_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqXXIfySUWMQ7kNvwF-O_vS&_nc_oc=AdqxtrkKvpQpaFa-O7jevopUbq2e19wUPg5lF9NXnOubyNYeuG_4osiEhUwHiuZ15LQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK430XwuoNS5FzUtRcNR7C-yOlrbgDlWrqydoX81dblog&oe=6A9D636F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1017323314235408", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1017323317568741_2257881866604957189_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOYyEpOa-wEQ7kNvwH7BH5a&_nc_oc=Adp3dcXDsjm3I_0c2bDzUU4LOTAWMNfdPIEHadyt02wfDJH3fRFpTV_w_vBM9vSJkmk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIg-I0V5XPo9nkoBA9fDBYMAOnGghZA9H93nISl7pI-8w&oe=6A9D7354"}, "display_name": "Fast Cricket VR", "keywords": ["batting", "batsman", "sports", "swing", "arcade"], "long_description": "**A ball is coming at you at 145 km/h. Swing at the right moment and it goes 100 metres.** You don't need to know cricket to love it.\n\n**SIX WAYS TO BAT**\n\n**Free Play** \u2014 bat until you're out. **Super Over** \u2014 six balls, go big. **The Chase** \u2014 hunt a target with wickets in hand. **Survival** \u2014 a yorker barrage, last as long as you can. **The Hundred** \u2014 100 balls, ten lives, the pace climbing every over. **History Challenges** \u2014 10 real famous final overs, seeded at the exact score.\n\n**FACE ANY BOWLER**\n\nSpin at 70-100 km/h, seam at 100-130, express pace at 130-160 \u2014 pick one, or let it rotate every over. Yorkers, bouncers, full tosses, over or around the wicket. Switch on **Ball Variations** and the spinner turns it off the pitch, the seamer swings it through the air and the quick reverses it late \u2014 each named as it arrives: googly, doosra, arm ball, off cutter, knuckle ball.\n\n**NINE WORLDS**\n\nClassic, Orbital, Dune Sunset, Thunderdome, Skyfields, Aurora Ice, Ashfall, Lantern Dusk, Prism Arena.\n\n**MAKE IT YOURS**\n\nAssists you control: pitch marker, landing spot, a widened bat, impact marker. Forgiving on day one, brutal when you're ready.\n\n**EVERY BALL COUNTS**\n\nCareer keeps runs, average, strike rate, fifties, hundreds, doubles, fours, sixes, monster sixes and your best innings.\n\nLeft- or right-handed, seated or standing, bat calibrated to your grip. Single player, fully offline.\n\nNot affiliated with or endorsed by any cricket board, team, or player.\n", "short_description": "A ball comes at you at 145 km/h. You swing. It flies 100 metres into the sky.\n\nFast Cricket VR is a bat-and-ball sports game - no cricket knowledge needed. Feel the middle of the bat, learn the timing, and you'll be hitting sixes in your first over. Six modes, nine worlds, three bowler types from spin to express pace, and a career that remembers every ball. Left- or right-handed, seated or standing. Single player, fully offline.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://games.mishti.world/privacy", "developer_terms_of_service_url": "https://games.mishti.world/terms", "publisher_name": "Mishti World", "support_website_url": "https://games.mishti.world/support", "website_url": "https://games.mishti.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1184604248072672"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2071265410419230"}, {"status": "PUBLISHED", "id": "2297210224359096"}, {"status": "PUBLISHED", "id": "1060854253066231"}]}, "baseline_offer": {"id": "1060854253066231"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "2071265410419230"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1195295907003506", "version": "1.0.0"}, "id": "1747294779870970", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1184604244739339", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1195295907003506"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1747294779870970"}]}, "change_log": "\"Alpha build 5 (1.0.0)\\n\\nFor alpha testers. Everything since build 4. This one is mostly about making the app behave properly when you are not looking at it, and about taking out things that were never finished.\\n\\nWHAT TO TEST FIRST\\n- Take the headset off in the middle of a delivery, then put it back on. The game should pause and then carry on, and the bat should still look like a bat. If you ever see a large plain wooden slab across your view, that is a bug and I want to know.\\n- Open the Meta system menu mid-ball and close it again. Same expectation.\\n- Bat calibration: hold trigger and grip, set your grip, and confirm it survives a restart.\\n- Face an over of each bowler type with Ball Variations turned on.\\n\\nCHANGED\\n- The game now pauses when you take the headset off or open the system menu, and ignores your controllers while it is paused. Before this it kept bowling at you.\\n- Hand tracking, psychic mode and the Experimental page are gone. They were never reachable in a shipped build and the app was asking for permissions it did not use. Touch controllers only.\\n- RECENTER has moved. It is now in SETTINGS - CONTROLS and is always available. Previously it was hidden behind the Experimental toggle, so on a normal install it did not exist at all.\\n- The bowler setup page now explains itself: each control has a short line under it saying what it actually does.\\n- Wicket side now defaults to RANDOM, so you get both angles without going to look for them.\\n- The 100-ball mode is now called HUNDRED.\\n- Ball Variations is off by default, and stays off after a settings reset. If you had it on, this build turns it off once - turn it back on if you want it.\\n\\nUNDER THE HOOD, but worth knowing\\n- The app no longer requests internet, hand tracking or eye tracking permissions.\\n- Quest 1 is no longer listed as supported. It could not run this build anyway.\\n- There is now a store entitlement check at launch. You should never notice it. If the game closes immediately on launch, that is the thing to report - tell me and I will turn it off.\\n\\nKNOWN, NOT YET DONE\\n- Performance has not been re-measured on this build.\\n- Quest 2 has never been tested. If you are on a Quest 2, I especially want to hear how it runs.\\n\\nFully offline. Nothing leaves the headset.\"", "created_date": 1785201755, "id": "1195295907003506", "version": "1.0.0", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1184604244739339", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1195295907003506"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1785192828, "id": "1195127457020351", "version": "1.0.0", "version_code": 4, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1184604244739339", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1195295907003506"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1785180162, "id": "1194870207046076", "version": "1.0.0", "version_code": 3, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1184604244739339", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1195295907003506"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1784683781, "id": "1184934051373025", "version": "1.0.0", "version_code": 2, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
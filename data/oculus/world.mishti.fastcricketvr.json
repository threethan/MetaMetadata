40_1567384361777578_4261667750943006283_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItPW_oYxM08Q7kNvwGwIxSV&_nc_oc=AdrAKRbtsl2cqkFMw43xhRofTF_AqluJ-g_UXM79ttc4JgYkhhbHCjxD0mtiScJc00Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGrDYoqzOhDlAKdoFqp6121eB8pXHWO0U3c3Uj8f-obw&oe=6A9D8816"}, {"file_name": "02-facing-the-bowler.png", "id": "1347284690855646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823259_1347284694188979_2481720479515376601_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0oH2VRGa9AQ7kNvwE2J7P7&_nc_oc=AdrkWj8-GH1_M2SdnJMe-b5_UMxlUlc6T9keb44tRIukrQ0lb0fpqeHVsu40xLoZxQs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2xF2gkSWodBB9vClus67_QbNLY3O88vQIiTEOb052WA&oe=6A9D796B"}, {"file_name": "03-six-game-modes.png", "id": "1533550971589398", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827585_1533550974922731_1920737863334981423_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-uBS1FMRDgQ7kNvwH0ZU0r&_nc_oc=Adp3LCVIXi93oiK2XZ_daCqDXfQ5m1weOVEfzW7f2rCky32s9oQIoL7mJL4QzLVyaiw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmyPjyiS-94mrkpkZUUMylra4S2iJawvLLJ6L2HlQbrg&oe=6A9D59A2"}, {"file_name": "05-bowled.png", "id": "2504686226661520", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824322_2504686233328186_2138386694095458574_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqXXIfySUWMQ7kNvwF-O_vS&_nc_oc=AdqxtrkKvpQpaFa-O7jevopUbq2e19wUPg5lF9NXnOubyNYeuG_4osiEhUwHiuZ15LQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK430XwuoNS5FzUtRcNR7C-yOlrbgDlWrqydoX81dblog&oe=6A9D636F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1017323314235408", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1017323317568741_2257881866604957189_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOYyEpOa-wEQ7kNvwH7BH5a&_nc_oc=Adp3dcXDsjm3I_0c2bDzUU4LOTAWMNfdPIEHadyt02wfDJH3fRFpTV_w_vBM9vSJkmk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIg-I0V5XPo9nkoBA9fDBYMAOnGghZA9H93nISl7pI-8w&oe=6A9D7354"}, "display_name": "Fast Cricket VR", "keywords": ["batting", "batsman", "sports", "swing", "arcade"], "long_description": "**A ball is coming at you at 145 km/h. Swing at the right moment and it goes 100 metres.** You don't need to know cricket to love it.\n\n**SIX WAYS TO BAT**\n\n**Free Play** \u2014 bat until you're out. **Super Over** \u2014 six balls, go big. **The Chase** \u2014 hunt a target with wickets in hand. **Survival** \u2014 a yorker barrage, last as long as you can. **The Hundred** \u2014 100 balls, ten lives, the pace climbing every over. **History Challenges** \u2014 10 real famous final overs, seeded at the exact score.\n\n**FACE ANY BOWLER**\n\nSpin at 70-100 km/h, seam at 100-130, express pace at 130-160 \u2014 pick one, or let it rotate every over. Yorkers, bouncers, full tosses, over or around the wicket. Switch on **Ball Variations** and the spinner turns it off the pitch, the seamer swings it through the air and the quick reverses it late \u2014 each named as it arrives: googly, doosra, arm ball, off cutter, knuckle ball.\n\n**NINE WORLDS**\n\nClassic, Orbital, Dune Sunset, Thunderdome, Skyfields, Aurora Ice, Ashfall, Lantern Dusk, Prism Arena.\n\n**MAKE IT YOURS**\n\nAssists you control: pitch marker, landing spot, a widened bat, impact marker. Forgiving on day one, brutal when you're ready.\n\n**EVERY BALL COUNTS**\n\nCareer keeps runs, average, strike rate, fifties, hundreds, doubles, fours, sixes, monster sixes and your best innings.\n\nLeft- or right-handed, seated or standing, bat calibrated to your grip. Single player, fully offline.\n\nNot affiliated with or endorsed by any cricket board, team, or player.\n", "short_description": "A ball comes at you at 145 km/h. You swing. It flies 100 metres into the sky.\n\nFast Cricket VR is a bat-and-ball sports game - no cricket knowledge needed. Feel the middle of the bat, learn the timing, and you'll be hitting sixes in your first over. Six modes, nine worlds, three bowler types from spin to express pace, and a career that remembers every ball. Left- or right-handed, seated or standing. Single player, fully offline.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://games.mishti.world/privacy", "developer_terms_of_service_url": "https://games.mishti.world/terms", "publisher_name": "Mishti World", "support_website_url": "https://games.mishti.world/support", "website_url": "https://games.mishti.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1184604248072672"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/646423555_1526711118689003_4521233894653535174_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mciXVdEqfeEQ7kNvwFdETgQ&_nc_oc=AdpH5mvlBoXCXPNJvsmI24BNjM9eefD6vV7zwA3JBGOSxB7Q00zofkJdyANLaSYar_s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9DnN-17UOqEGgrr57AKRQBjIxns_IIkfzGo3YA-kDFg&oe=6A9D60D5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fast Cricket VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "
154990", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974456_717079339488323_1009385118042236345_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xu2HHbu13bMQ7kNvwHyKF3T&_nc_oc=Adpl_cY6jEXkvCZ4LB2tYQenPJw7iTTfxQSX9N_x9huQRPgnzQnIwxdnbAdkdfLywjY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHs9OUx3TCXHMzMFWvNJTXvmNeez1ICfSf9SL03Kn207g&oe=6A71F80C"}, "display_name": "Laser Escape", "keywords": [], "long_description": "Laser Escape is a Free to Play Arcade Music game. The goal is to dodge the lasers coming towards you until the song ends.\n\nGameplay mostly affected by your body's moves. For feeling the beat through your bones!\n\nThere are three collectible special abilities. These are:\n\nHealth Point: An extra health point.\nTime Slowdown: When used, everything is going to move like a turtle.\nShield: A field that protects you from lasers. (Attention! It destroys collectibles too.)", "short_description": "Laser Escape is a Free to Play Arcade Music game. The goal is to dodge the lasers coming towards you until the song ends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bucchelo.com/projects/laserescape/privacy-policy.html", "developer_terms_of_service_url": "https://www.bucchelo.com/projects/laserescape/terms-of-service.html", "publisher_name": "Bucchelo", "support_website_url": null, "website_url": "https://www.bucchelo.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "ARCADE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_m
66886_1151689555219910980_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X68EAse2k5wQ7kNvwE2twRs&_nc_oc=Adpk7s0nBI3ZHieZD0NLbRscb23qVJ7GfpCoKTRC5fgT-Xmiz9-7yT9JTDAYtWljKtY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRngVuVowIGVK9Gz7Sk8W9lmQ1l3TTn94Po6OjTUyX89w&oe=6AF34522"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Recursion VR", "keywords": [], "long_description": "Have you ever wished that Tron had more than just disk golf? Do you constantly find yourself needing to slice things to pieces, but rhythm games just aren't doing it for you? Maybe seek help or give the Outernet wastelands a try!\n\nSwords, shields, axes,  and daggers -  there's plenty more than that to sink your teeth into with Recursion VR. It's all here with a full fledged parkour system to express your finesse with a blade and your resilience as a Netrunner.", "short_description": "Immerse yourself in Cyberspace as the worlds most advanced combatant AI. Customize your cybersecurity loadout by discovering new weapons and abilities. Train your skills and save the web, or succumb to the storm that is raging through the Outernet."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.recursionvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.recursionvr.com/terms-conditions", "publisher_name": "Reality Shift LLC", "support_website_url": "https://www.recursionvr.com/faq", "website_url": "https://www.RecursionVR.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "27362927396627898"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en
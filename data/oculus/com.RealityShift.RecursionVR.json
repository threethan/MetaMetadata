vQfkq0w6J5Gormgz21DcWSp3mHfPVQAKPhA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlojandvIErrW67RY490LuztoESI9BO7LSZccX8CrkMw&oe=6B085961"}, {"file_name": "RecursionVR_2560x1440.png", "id": "3233339390233553", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974497_3233339393566886_1151689555219910980_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yceeq0z28XEQ7kNvwGeDQYq&_nc_oc=AdpumXDFJ2EjrpnOPkd0aQKYPB-BeUdCGj0afxtSfXeYgfR5z6rs8SwOGizxrfRqp90&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZU2vjX347Hgmw6RlEXv9vyqQ--T2RYwfsBBwscFwgYQ&oe=6B085D22"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Recursion VR", "keywords": [], "long_description": "Have you ever wished that Tron had more than just disk golf? Do you constantly find yourself needing to slice things to pieces, but rhythm games just aren't doing it for you? Maybe seek help or give the Outernet wastelands a try!\n\nSwords, shields, axes,  and daggers -  there's plenty more than that to sink your teeth into with Recursion VR. It's all here with a full fledged parkour system to express your finesse with a blade and your resilience as a Netrunner.", "short_description": "Immerse yourself in Cyberspace as the worlds most advanced combatant AI. Customize your cybersecurity loadout by discovering new weapons and abilities. Train your skills and save the web, or succumb to the storm that is raging through the Outernet."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.recursionvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.recursionvr.com/terms-conditions", "publisher_name": "Reality Shift LLC", "support_website_url": "https://www.recursionvr.com/faq", "website_url": "https://www.RecursionVR.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics
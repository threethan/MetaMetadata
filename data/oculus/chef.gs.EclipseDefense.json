MduZOawM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft5h_h4kbo18Orf7T45Bai8f4ewPnyg0FknCpnV-RG1Vg&oe=699DB23C"}, {"file_name": "EclipseDefenceImage03.png", "id": "1315333866150469", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982517_1315333869483802_8451455932263526366_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2-KQlQObbIQ7kNvwEwy0FW&_nc_oc=AdkoIX6h8pgE_SD6gi1Ai1j1S8-YXoGRg3v7PKQ1KthgBX3jeiLTj9Aov6I8VBqGjaw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfseIWcCKNX8BpFGASyLa6A7VHBHzuuyHJw51eDUhN2VlQ&oe=699D8E9A"}, {"file_name": "EclipseDefenceImage02.png", "id": "600762692399494", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974856_600762695732827_6505960866598570138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLUtg7cpNcAQ7kNvwHbYPm8&_nc_oc=AdmcBAhBMfxqNgkGH7NmP8VPYTnkTdSXodBlozITnBIxDL3bQmCaJe4uWtNQknFngf4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftFlMHR_4Dd361ixh0CissGjVztrROPU4XHW62K4CsAVA&oe=699D9591"}, {"file_name": "EclipseDefenceImage01.png", "id": "2063620994075579", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210888_2063620997408912_6888476953228441268_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0mu2IMVANIQ7kNvwHT323v&_nc_oc=AdnkLGj87zEcXg7I8sTCjYrGdd7_6SlG99KoPs2B61Cy9ZJLbzWE2CdcXX2q1o_AGnI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvuxH_xXl3OJIZEpUngO_NIGLN3cTESRIfCaFyAbjWWJw&oe=699DAFA6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eclipse Defense", "keywords": ["space", "defense", "spaceship", "gravity"], "long_description": "A Hero\u2019s Call in Space \u2013 The Ultimate VR Experience at Eclipse Defense\n\nIn this thrilling VR game, you are a skilled space worker tasked with saving the world from destruction. As your spaceship docks with a massive space station, chaos unfolds. Meteors are hurtling toward Earth, and only you can stop them!\n\nKey Features:\n Immersive Space Exploration: Experience realistic docking mechanics as you pilot and connect your spaceship to the station.\n Interactive Environment: Explore the detailed interiors of the space station, complete with tools, ladders, and control systems.\n Intense Meteor Defense: Climb to the upper levels, activate the shooter cannon, and unleash firepower to destroy waves of meteors.\n Dynamic Challenges: Repair systems, manage alerts, and face emergencies while defending the station.\n Stunning Visuals: A breathtaking sci-fi environment with dynamic lighting, realistic damage effects, and vast space backdrops.\n\nThe world depends on you! Grab your tools, man the cannons, and fight to protect Earth in this heart-pounding VR space adventure.", "short_description": "Dock, Defend, and Save the World!\nStep into the boots of a space worker in this immersive VR experience. Dock your spaceship at the station, take control of powerful shooter cannons, and defend Earth from an onslaught of meteors threatening humanity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chef.gs/eclipse-defense-privacy-policy", "developer_terms_of_service_url": "https://www.chef.gs/terms-of-service", "publisher_name": "CHEF Game Studio", "support_website_url": "https://www.chef.gs/contact", "website_url": "https://www.chef.gs/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9121137954619999"}, 
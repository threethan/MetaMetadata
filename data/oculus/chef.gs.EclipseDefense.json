_1357397732304481_3091330945972944752_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBnJwID7FvYQ7kNvwHQ-DCw&_nc_oc=AdosgFAarT5U8KIBa14Zw6l3IMexL2k-yGRDfcBz7fnWIg-8ahXN_99HeiB1MkTUb-U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGpRCEpYUmzC4qXf_EDWornpn2uYugpseQCGKPR7L7Yg&oe=6A732246"}, {"file_name": "2560x1440_2 (1).png", "id": "1120457513004693", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974568_1120457516338026_3819049469444330578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3MWQZPVxmQQ7kNvwF_WC7Y&_nc_oc=AdqukyAWMBUMTK0n5M8q3_SvFN8ZYePUU5-9ggEODFWdAf5sFCtQYXorRFDmtaU26yY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFP4O9VHY_E9cgcg94BfLtmGIwzkn8QfJXOyUX8p4EcDQ&oe=6A73476F"}, {"file_name": "1008x1440_1 (1).png", "id": "917796330067972", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75272215_917796333401305_8296619983331867320_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUgF50DGVAcQ7kNvwEf1P8U&_nc_oc=AdpOZXZFrT8GFKD5ElwNWF-HBagvHCrnD7Og7jVp1_54DcDDVAidoamjiY-RqDLdhVk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbINbX0IBRmgb26eSQbMob6ztZBa-7PhpAE2RmHce9Gw&oe=6A733685"}]}, "id": "1014478100720104", "locale": "en_US", "screenshots": [{"file_name": "EclipseDefenceImage04.png", "id": "501190145708871", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974758_501190149042204_5641408677421007963_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVUgxaltXQgQ7kNvwH_sMJC&_nc_oc=AdowZl1_bWGJI6lifBPgbqJpsSCFe9PmuOJUVfmSYCb1YWoT-TOug-GPhNQKlMF4nE8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGo0Sr7KzOHDgyjTmy4qnd07w0bUwRtYvU2sg9vpkob5A&oe=6A732D30"}, {"file_name": "EclipseDefenceImage05.png", "id": "2214028069052374", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974702_2214028072385707_966198005100103568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrEQH-mNPyoQ7kNvwFibQJw&_nc_oc=Adrhq5jwPHy5mgKpQXMSIX-ggUvJ1ElyvsgdiwynFVeoyGhypLmXI-JbSFj9L3GEGT4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcnZgLgInadwi4RM_-zXAxk5DgKF1xs2vKP-bXnBe1sg&oe=6A73453C"}, {"file_name": "EclipseDefenceImage03.png", "id": "1315333866150469", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982517_1315333869483802_8451455932263526366_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXiPSy7YPHsQ7kNvwH6N2WX&_nc_oc=Adrw4ARw2PEzZGmYN2M2LCoS3VCFH0YMvIRoSQbfExV7GX_SfKDVSKvCuq_Vwe5711g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeivUpo-CMYgj9EGVUOSJzINPBH84KNll3SmqBo0XGCA&oe=6A73219A"}, {"file_name": "EclipseDefenceImage02.png", "id": "600762692399494", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974856_600762695732827_6505960866598570138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQNluxgqgd0Q7kNvwFWZL7n&_nc_oc=Adqr5K5FPFxiKTiK_j28b3Sic-Kb7YR5t4Yc7svP9cdLjH7YI0VjOn1BmCPYlxYWSl8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHros1NnML9d2YjCtufNSo-mkJgU_LOsLrqPDrmS8D8iA&oe=6A732891"}, {"file_name": "EclipseDefenceImage01.png", "id": "2063620994075579", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210888_2063620997408912_6888476953228441268_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvTKch9-0_EQ7kNvwH_NlBi&_nc_oc=AdqZ8kv3T-9VWOV_TzdujINplGX_qNLRPNZprpDWxOv6q02OAIJN_Oza77cXG8hw_BE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWE9fsdrSWK50Q7-Jm-JhZgf2BM_QEF8dwgvxSwBLzqQ&oe=6A7342A6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eclipse Defense", "keywords": ["space", "defense", "spaceship", "gravity"], "long_description": "A Hero\u2019s Call in Space \u2013 The Ultimate VR Experience at Eclipse Defense\n\nIn this thrilling VR game, you are a skilled space worker tasked with saving the world from destruction. As your spaceship docks with a massive space station, chaos unfolds. Meteors are hurtling toward Earth, and only you can stop them!\n\nKey Features:\n Immersive Space Exploration: Experience realistic docking mechanics as you pilot and connect your spaceship to the station.\n Interactive Environment: Explore the detailed interiors of the space station, complete with tools, ladders, and control systems.\n Intense Meteor Defense: Climb to the upper levels, activate the shooter cannon, and unleash firepower to destroy waves of meteors.\n Dynamic Challenges: Repair systems, manage alerts, and face emergencies while defending the station.\n Stunning Visuals: A breathtaking sci-fi environment with dynamic lighting, realistic damage effects, and vast space backdrops.\n\nThe world depends on you! Grab your tools, man the cannons, and fight to protect Earth in this heart-pounding VR space adventure.", "short_description": "Dock, Defend, and Save the World!\nStep into the boots of a space worker in this immersive VR experience. Dock your spaceship at the station, take control of powerful shooter cannons, and defend Earth from an onslaught of meteors threatening humanity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chef.gs/eclipse-defense-privacy-policy", "developer_terms_of_service_url": "https://www.chef.gs/terms-of-service", "publisher_name": "CHEF Game Studio", "support_website_url": "https://www.chef.gs/contact", "website_url": "https://www.chef.gs/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
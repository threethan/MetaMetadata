_1357397732304481_3091330945972944752_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDHcJALwLpcQ7kNvwHHuxWe&_nc_oc=AdpPjiTh_EXkt27r69P0Q-aHQUCggjN-EkFHPGXiMiSM1ujzGgTz4OFSu2kBK-ObRvg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvDeSq7_Z3OI37LkonNCwYuwTAbq_3tCX7RM9vt0EEMg&oe=6AAC0B06"}, {"file_name": "2560x1440_2 (1).png", "id": "1120457513004693", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974568_1120457516338026_3819049469444330578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRdF6t8GRD0Q7kNvwG6-1di&_nc_oc=Adpbj5WB-oIvA3n7mcJr6tupswnZsCXHAMXY3W4VWRGTmvhxqi69_4T0I1ZlBjh0Wj8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfey7WJXMYeFlIc4PAbGjBhOhZE2JwQpiFH6BiLpPsRQ&oe=6AABF7EF"}, {"file_name": "1008x1440_1 (1).png", "id": "917796330067972", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75272215_917796333401305_8296619983331867320_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h68uJiKxvIUQ7kNvwG8xzpj&_nc_oc=AdqifB8MFevPIbA4OBSOTAVNdzYtXOHBV0Zdmpi0qbXYL--s7yx8aMs1AINoKysSA08&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVuJFZGjmwZyoeZMudAQsvODuzilOwK9kngu3Jho0Akw&oe=6AABE705"}]}, "id": "1014478100720104", "locale": "en_US", "screenshots": [{"file_name": "EclipseDefenceImage04.png", "id": "501190145708871", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974758_501190149042204_5641408677421007963_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2h0_b6GcB2EQ7kNvwGEkPos&_nc_oc=AdoNHt2up7uv_XGdsJ2Zga9-82kaWMQvZ5oEbXTnQ-bLvJoF-G0TUEFzx9oB-Nja_lg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvZKdCHCPRiBupLEUhLxC8g3dY6O3UFfA5k5Ecz01S0Q&oe=6AABDDB0"}, {"file_name": "EclipseDefenceImage05.png", "id": "2214028069052374", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2214028072385707_966198005100103568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVl5m-FlzLUQ7kNvwFw2hHe&_nc_oc=AdozVKPl58Qaa1o_d1Vabociwsq5JWtuaoR8J0yIcf0EXW8hLxRdQCPl-FxdfCOoXBQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiMvvJiK_rzzqoyHvsA4JXMWmzCwMFZUrfPkaN1Oxa0g&oe=6AABF5BC"}, {"file_name": "EclipseDefenceImage03.png", "id": "1315333866150469", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982517_1315333869483802_8451455932263526366_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNCWZ5NY82UQ7kNvwETO8K0&_nc_oc=Adqmgt83Rsmwr-GPWoBWYlkkk0QctYBO9I8Gl8rQYgmIHx94IWtFLpaqn38mHcRFf4k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrgSjhXaQj9XINjvSJtIIYWwvC5YNiMPAfATQCtOnS9A&oe=6AAC0A5A"}, {"file_name": "EclipseDefenceImage02.png", "id": "600762692399494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974856_600762695732827_6505960866598570138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wrm-sKvwJnIQ7kNvwEG6lWR&_nc_oc=AdphHbv8g0K481vjIugZteH8XFZRM91lDkHRujM86wh-eyIN-Wq7rDFTdHXC2amfRZ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFp0AdiNNnj1gGDWSRQBOWiMg2dU637ETCmGuhzr0lWA&oe=6AAC1151"}, {"file_name": "EclipseDefenceImage01.png", "id": "2063620994075579", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210888_2063620997408912_6888476953228441268_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGQipNZVzjEQ7kNvwHGjw80&_nc_oc=Adr_LUaD43qokFGKpUD89seGBvmYtOQwgFL6GY6TVtPXmx1-MmhOipXBy3f9ycArWD8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJARB95vwizT_mNDsRSG37RSiReDl6sxF4fJgtggW_HXw&oe=6AABF326"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eclipse Defense", "keywords": ["space", "defense", "spaceship", "gravity"], "long_description": "A Hero\u2019s Call in Space \u2013 The Ultimate VR Experience at Eclipse Defense\n\nIn this thrilling VR game, you are a skilled space worker tasked with saving the world from destruction. As your spaceship docks with a massive space station, chaos unfolds. Meteors are hurtling toward Earth, and only you can stop them!\n\nKey Features:\n Immersive Space Exploration: Experience realistic docking mechanics as you pilot and connect your spaceship to the station.\n Interactive Environment: Explore the detailed interiors of the space station, complete with tools, ladders, and control systems.\n Intense Meteor Defense: Climb to the upper levels, activate the shooter cannon, and unleash firepower to destroy waves of meteors.\n Dynamic Challenges: Repair systems, manage alerts, and face emergencies while defending the station.\n Stunning Visuals: A breathtaking sci-fi environment with dynamic lighting, realistic damage effects, and vast space backdrops.\n\nThe world depends on you! Grab your tools, man the cannons, and fight to protect Earth in this heart-pounding VR space adventure.", "short_description": "Dock, Defend, and Save the World!\nStep into the boots of a space worker in this immersive VR experience. Dock your spaceship at the station, take control of powerful shooter cannons, and defend Earth from an onslaught of meteors threatening humanity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chef.gs/eclipse-defense-privacy-policy", "developer_terms_of_service_url": "https://www.chef.gs/terms-of-service", "publisher_name": "CHEF Game Studio", "support_website_url": "https://www.chef.gs/contact", "website_url": "https://www.chef.gs/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
_1357397732304481_3091330945972944752_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HaGM2kqNuQQ7kNvwFBDvii&_nc_oc=Adrpg2o6F98OKPHs1lHLr8uTmH4WXbIo9zkSkRWbIhFdGaIRx0HNLCDpTa8wLGLmZmU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_z5Zxgoug23zJIl9fPuPN_1mNBfs2Lu7RnciqvZQYrqA&oe=6A26E386"}, {"file_name": "2560x1440_2 (1).png", "id": "1120457513004693", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974568_1120457516338026_3819049469444330578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkjmqR3p2pIQ7kNvwHHVBy_&_nc_oc=Adq4svm8pL3UiO7GNhz4v6XsFrkyUAKeeoufJkPoAaF9rqUreaIvq4ZeFo-S5W4wW_g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af938u7svJKJ_R4Jt-OHp4QndtzDmCRX_icIzAd29fVVHw&oe=6A26D06F"}, {"file_name": "1008x1440_1 (1).png", "id": "917796330067972", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75272215_917796333401305_8296619983331867320_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SfoAEMwxFewQ7kNvwFfKVLD&_nc_oc=AdqVC4ReSvVH8hakKw2r0vPxjuUszZW1_rjZn01ddIOFipHctg9vWp_KMCPeL64QpH4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yVy3LPIDkVWqizlPPKnXKjMS_Q0lcY-LaQ7fTuP0xhQ&oe=6A26BF85"}]}, "id": "1014478100720104", "locale": "en_US", "screenshots": [{"file_name": "EclipseDefenceImage04.png", "id": "501190145708871", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974758_501190149042204_5641408677421007963_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhQ1CJtLl6MQ7kNvwGDXjJf&_nc_oc=AdqUGd7wW3_1R_2bYsv4zYHzDCUdjAEz28Isi9d3oJcppSJ1Dy0V1ppBLNXIZvbY2S4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yK6N98lgtPizWfrw9IUbfEBdaiaod0fY_b8tsnnz_-w&oe=6A26EE70"}, {"file_name": "EclipseDefenceImage05.png", "id": "2214028069052374", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974702_2214028072385707_966198005100103568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPRnsSFEiK4Q7kNvwG_Tjo3&_nc_oc=AdpjADTAbDYMF8UIcnsLcz2n4iMYw0soy2vVkv7oS5bmaxA3SClRc8QDwpoFrFk1mQ0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jdzACa_oTMF0YeoQQFuDOFY8xoq7UNIqB4WXydab3GQ&oe=6A26CE3C"}, {"file_name": "EclipseDefenceImage03.png", "id": "1315333866150469", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982517_1315333869483802_8451455932263526366_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sg8dBwaMAB0Q7kNvwEpeg9W&_nc_oc=AdqnblmBPIHURawOSkYI2TNgQOoVxuvkRdBhUNuqxAE9L_qr1Bz1cRad8WWcYB8aals&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fVD9RtR0Npe-lzv0UBjiYriRAD_-QOJmYyG9U4omXrA&oe=6A26E2DA"}, {"file_name": "EclipseDefenceImage02.png", "id": "600762692399494", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974856_600762695732827_6505960866598570138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ft5NR_PmjboQ7kNvwFfAjkF&_nc_oc=AdrGIx4YmZ5sYcGvIcl8xwgRA6MwcE-YWdT5kzY76Tb-7ooLuFotk0cAN2IM8tRthnM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AUy-1mcAmHvJViTOwyqGHCAnPTYRCcJMgXsBn8ysldw&oe=6A26E9D1"}, {"file_name": "EclipseDefenceImage01.png", "id": "2063620994075579", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75210888_2063620997408912_6888476953228441268_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQcsVj5qqpgQ7kNvwEN519M&_nc_oc=Adrv_VPoFwyixJj7Ig0qtdz__1lSZOrhzWh5z0UEpm03URn8LFvgtppVVy80w3vfQb8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ug8v1wvEbf0N6i96fhsUEl6JJPTKbFDOdO9PYCQts1Q&oe=6A26CBA6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eclipse Defense", "keywords": ["space", "defense", "spaceship", "gravity"], "long_description": "A Hero\u2019s Call in Space \u2013 The Ultimate VR Experience at Eclipse Defense\n\nIn this thrilling VR game, you are a skilled space worker tasked with saving the world from destruction. As your spaceship docks with a massive space station, chaos unfolds. Meteors are hurtling toward Earth, and only you can stop them!\n\nKey Features:\n Immersive Space Exploration: Experience realistic docking mechanics as you pilot and connect your spaceship to the station.\n Interactive Environment: Explore the detailed interiors of the space station, complete with tools, ladders, and control systems.\n Intense Meteor Defense: Climb to the upper levels, activate the shooter cannon, and unleash firepower to destroy waves of meteors.\n Dynamic Challenges: Repair systems, manage alerts, and face emergencies while defending the station.\n Stunning Visuals: A breathtaking sci-fi environment with dynamic lighting, realistic damage effects, and vast space backdrops.\n\nThe world depends on you! Grab your tools, man the cannons, and fight to protect Earth in this heart-pounding VR space adventure.", "short_description": "Dock, Defend, and Save the World!\nStep into the boots of a space worker in this immersive VR experience. Dock your spaceship at the station, take control of powerful shooter cannons, and defend Earth from an onslaught of meteors threatening humanity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chef.gs/eclipse-defense-privacy-policy", "developer_terms_of_service_url": "https://www.chef.gs/terms-of-service", "publisher_name": "CHEF Game Studio", "support_website_url": "https://www.chef.gs/contact", "website_url": "https://www.chef.gs/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
FDjxfdTdK1kf26aV9UNJs3COEmd1RG2OR4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZPEu5Jq3u1ZLFj8k5y1G36eTBcDaMAdDU7PLdB_pW8Q&oe=6A08905A"}, {"file_name": "EclipseDefenceImage02.png", "id": "600762692399494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974856_600762695732827_6505960866598570138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uayaairXaxQQ7kNvwFeUbDg&_nc_oc=AdpiYPwkolHAmT9ZrsMBV4-FIM3v1CUc5X-THzvVeFD6c9fN-B8gr3xFn-diGr1vVo8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aGUoGx95PiyzL3uIzB8j7JqJMlWZh6xsT6LHBqKQXOw&oe=6A085F11"}, {"file_name": "EclipseDefenceImage01.png", "id": "2063620994075579", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210888_2063620997408912_6888476953228441268_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQROIeLY7zwQ7kNvwEkB2Lt&_nc_oc=AdpG9tM5EICW-iNebBrRr2qY38yYyQuookOl63hdqKAmw3eNaZER8PUa8EfWlJqqieE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56c1vzitRBtLVnSKxlq_jFl6zo5ScV9J-6bjPl1SO2FA&oe=6A087926"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eclipse Defense", "keywords": ["space", "defense", "spaceship", "gravity"], "long_description": "A Hero\u2019s Call in Space \u2013 The Ultimate VR Experience at Eclipse Defense\n\nIn this thrilling VR game, you are a skilled space worker tasked with saving the world from destruction. As your spaceship docks with a massive space station, chaos unfolds. Meteors are hurtling toward Earth, and only you can stop them!\n\nKey Features:\n Immersive Space Exploration: Experience realistic docking mechanics as you pilot and connect your spaceship to the station.\n Interactive Environment: Explore the detailed interiors of the space station, complete with tools, ladders, and control systems.\n Intense Meteor Defense: Climb to the upper levels, activate the shooter cannon, and unleash firepower to destroy waves of meteors.\n Dynamic Challenges: Repair systems, manage alerts, and face emergencies while defending the station.\n Stunning Visuals: A breathtaking sci-fi environment with dynamic lighting, realistic damage effects, and vast space backdrops.\n\nThe world depends on you! Grab your tools, man the cannons, and fight to protect Earth in this heart-pounding VR space adventure.", "short_description": "Dock, Defend, and Save the World!\nStep into the boots of a space worker in this immersive VR experience. Dock your spaceship at the station, take control of powerful shooter cannons, and defend Earth from an onslaught of meteors threatening humanity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chef.gs/eclipse-defense-privacy-policy", "developer_terms_of_service_url": "https://www.chef.gs/terms-of-service", "publisher_name": "CHEF Game Studio", "support_website_url": "https://www.chef.gs/contact", "website_url": "https://www.chef.gs/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9121137954619999"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "457537944061008"}]}, "baseline_offer": {"id": "457537944061008"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1736422980, "status": "PUBLISHED", "id": "457537944061008"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_result
_1357397732304481_3091330945972944752_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLC1Vv-qLR0Q7kNvwEdHCbf&_nc_oc=AdpKEb8VsEUTRWmtp8q95p1-uC200xdqJAYPv6AT3z1XuUiPWok3SnJea5qrtk8IH4w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8fyvl0k7cYFVnbSYDovbMLL55koWanILaliGUTn1wNA&oe=69C51C46"}, {"file_name": "2560x1440_2 (1).png", "id": "1120457513004693", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974568_1120457516338026_3819049469444330578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_ICKqbqk-sQ7kNvwFEzklf&_nc_oc=AdpXsDq417SYuiWdXqiiVtRFTXs2JZ_E3DIq3e6dAw8-OerPLOao3JEtSIu6fmKKnM0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyzP537cJ9p2RBtHNIvuLWroXUAhciEqz3aNNPN-U3U8g&oe=69C5416F"}, {"file_name": "1008x1440_1 (1).png", "id": "917796330067972", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75272215_917796333401305_8296619983331867320_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vz3cXvOH6oUQ7kNvwEAhuvs&_nc_oc=AdqpOwWqBDWrFCuL4KrKjIg4UMQQ3_aYkUtBfXwa69no_nIh0Z8lVqZtfvloE3MYrH0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfywoOTdR4RoLcXOj03Pvsm-9DsezUiVg8MphegHXeMeCA&oe=69C53085"}]}, "id": "1014478100720104", "locale": "en_US", "screenshots": [{"file_name": "EclipseDefenceImage04.png", "id": "501190145708871", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974758_501190149042204_5641408677421007963_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APU7csS-SZUQ7kNvwH95YV1&_nc_oc=Adoe-ddu64fuIZP6qfDg5ZSHvHKYwqZHp-lgqEbd7CsyP3hxbgwCbbCeWnsYDIuq9X8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfynqC-I2uSGE9f1Z8ux6_nJUad6DJ3hVJpt0mmeQY4MvA&oe=69C52730"}, {"file_name": "EclipseDefenceImage05.png", "id": "2214028069052374", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974702_2214028072385707_966198005100103568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rK6tpLh86CIQ7kNvwGGcHTh&_nc_oc=AdrsWrX04jPd0afcqrh60bGz05J1dgb7lGYlb51NoDs_-jvT1KUdWlFHywpYciMqCfU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxvH8urzalCjNz6awY8i-mMR-6F5NL9tT6PtQaII9jErQ&oe=69C53F3C"}, {"file_name": "EclipseDefenceImage03.png", "id": "1315333866150469", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982517_1315333869483802_8451455932263526366_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XZLb9m2pEYQ7kNvwFaiUDZ&_nc_oc=AdqUTNORtVWWhWuOcOfznpSHAuSvC2sTZqwtkMnhhsFc_DDZ1ITz9_b-0ZT0bSHMdk8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzadd3n7Rc4fxpe3ah0zpcC1e2Dl7wXhq6B0nuMULG4kQ&oe=69C51B9A"}, {"file_name": "EclipseDefenceImage02.png", "id": "600762692399494", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974856_600762695732827_6505960866598570138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tp_a8NtNo-8Q7kNvwEi6Asq&_nc_oc=AdqzDECM-tdHTa33PPFRgR3X3FvS-4_Rj0DDRBxtwu2_AzI8BNYLl2k5Sd8D_-kqdX4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzg8577voCieiuzIjD8kXvn9DVh5kUxIxutjkwaJId9lQ&oe=69C52291"}, {"file_name": "EclipseDefenceImage01.png", "id": "2063620994075579", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75210888_2063620997408912_6888476953228441268_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gffjgPm2q2AQ7kNvwGJHAfJ&_nc_oc=Adqd06XLAxX7_rlkzNqKt_ew2N7wnVNp1p1SAH38J-AXxBwEjxjG00S2V1YfQK_mdGA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxov5zYJFR8YdC1_iEuvq2SQtL0Wuap3Ge7lAO2P71uKQ&oe=69C53CA6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eclipse Defense", "keywords": ["space", "defense", "spaceship", "gravity"], "long_description": "A Hero\u2019s Call in Space \u2013 The Ultimate VR Experience at Eclipse Defense\n\nIn this thrilling VR game, you are a skilled space worker tasked with saving the world from destruction. As your spaceship docks with a massive space station, chaos unfolds. Meteors are hurtling toward Earth, and only you can stop them!\n\nKey Features:\n Immersive Space Exploration: Experience realistic docking mechanics as you pilot and connect your spaceship to the station.\n Interactive Environment: Explore the detailed interiors of the space station, complete with tools, ladders, and control systems.\n Intense Meteor Defense: Climb to the upper levels, activate the shooter cannon, and unleash firepower to destroy waves of meteors.\n Dynamic Challenges: Repair systems, manage alerts, and face emergencies while defending the station.\n Stunning Visuals: A breathtaking sci-fi environment with dynamic lighting, realistic damage effects, and vast space backdrops.\n\nThe world depends on you! Grab your tools, man the cannons, and fight to protect Earth in this heart-pounding VR space adventure.", "short_description": "Dock, Defend, and Save the World!\nStep into the boots of a space worker in this immersive VR experience. Dock your spaceship at the station, take control of powerful shooter cannons, and defend Earth from an onslaught of meteors threatening humanity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chef.gs/eclipse-defense-privacy-policy", "developer_terms_of_service_url": "https://www.chef.gs/terms-of-service", "publisher_name": "CHEF Game Studio", "support_website_url": "https://www.chef.gs/contact", "website_url": "https://www.chef.gs/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
_1357397732304481_3091330945972944752_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-VbORKY0SlsQ7kNvwGtt9Ro&_nc_oc=AdqQl6H1vhBkBSBTN3-y6dn7kPl0mqc9iTIInLbJAxRWoMgnxSACArA9iXUibdR56Fk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDq7MC8f0whHVN7E_anYZwg80Fc5lPLhzAoGPzpBDC5Vg&oe=6A69E7C6"}, {"file_name": "2560x1440_2 (1).png", "id": "1120457513004693", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974568_1120457516338026_3819049469444330578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-qeDStO1_UQ7kNvwFW0xWi&_nc_oc=AdoVxv5yJ791sur2YSh-TAoyeV_vLGo0GTeJMemZ0s_EuxlGbaspCHCD5CTXUR4wZqQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDflFJTbxd5PEWizG4rr6C6PAxGAQGTdFaQDUYaHCSPDg&oe=6A6A0CEF"}, {"file_name": "1008x1440_1 (1).png", "id": "917796330067972", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75272215_917796333401305_8296619983331867320_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RS2fpKGgmvAQ7kNvwF_w9vi&_nc_oc=AdqikYc5IKSGDsMsDR2PPMUX3qqEfUatVJcz84YuYx9RTLtGAb74RE3mAs2zHFBUQfE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBh2_R2zarnkONYaV1-LlD2bENCsDonP-UvkIqEigJBDA&oe=6A69FC05"}]}, "id": "1014478100720104", "locale": "en_US", "screenshots": [{"file_name": "EclipseDefenceImage04.png", "id": "501190145708871", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974758_501190149042204_5641408677421007963_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afzgSk17WjEQ7kNvwG-pHX1&_nc_oc=AdqDP75rRcqjc6b2ducRlA6FJ1OfqC5gmtqSRQpoz_pKSyecLUkC4IgwdasBOSpZJmg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTraZBvYkJF3ia-nm1UNht7ClJEJ35Hmrs94S8kmULnA&oe=6A69F2B0"}, {"file_name": "EclipseDefenceImage05.png", "id": "2214028069052374", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2214028072385707_966198005100103568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0cMFrglaQQQ7kNvwHEXMMf&_nc_oc=AdpWbAbGCOL2IV4PPsJ8PsUlym75fEtDtJuz8rgiZzk_cjLKwbkoZvtmNzT0vz4Uz2o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpG5_qH9V86UWkmEWmxWnqiRQzG4dI1Y0e3bC51mn9Kw&oe=6A6A0ABC"}, {"file_name": "EclipseDefenceImage03.png", "id": "1315333866150469", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982517_1315333869483802_8451455932263526366_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vsg3StB68j0Q7kNvwFseE9o&_nc_oc=Adps7TZCCo2vdXZR_Uo4d2eBRhJzE8u8PLyd1knt4kq9I9pBlnPWP5wc4jJPcDDnb5M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmDPvjC5WrW-FLNLZGBXitSWpAHxBsmJvYirkdB0dV3w&oe=6A69E71A"}, {"file_name": "EclipseDefenceImage02.png", "id": "600762692399494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974856_600762695732827_6505960866598570138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIgzqNcdJs4Q7kNvwGZXQ0U&_nc_oc=Adq5qlVvOnu546SqrKRk8-JSbQwj5ICRLa_XV0XF6MeEJPwCITG3s9_OJUa0tfUtUxM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjrg8FcifCn56OoXgGGmdBRqghb-S3486Kstt8krUmuQ&oe=6A69EE11"}, {"file_name": "EclipseDefenceImage01.png", "id": "2063620994075579", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210888_2063620997408912_6888476953228441268_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLnaAe0WYWoQ7kNvwEVIScy&_nc_oc=AdraP7RlAlgT-v6hgI6snpTeRUNS0zkyDTtUU_u23TJlJrxw79e5gVYh1pTdGfnG2T8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEzMOf5ZyDnFy_VVhD70shYZF7QaSccqPjKrm9yAgRrw&oe=6A6A0826"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eclipse Defense", "keywords": ["space", "defense", "spaceship", "gravity"], "long_description": "A Hero\u2019s Call in Space \u2013 The Ultimate VR Experience at Eclipse Defense\n\nIn this thrilling VR game, you are a skilled space worker tasked with saving the world from destruction. As your spaceship docks with a massive space station, chaos unfolds. Meteors are hurtling toward Earth, and only you can stop them!\n\nKey Features:\n Immersive Space Exploration: Experience realistic docking mechanics as you pilot and connect your spaceship to the station.\n Interactive Environment: Explore the detailed interiors of the space station, complete with tools, ladders, and control systems.\n Intense Meteor Defense: Climb to the upper levels, activate the shooter cannon, and unleash firepower to destroy waves of meteors.\n Dynamic Challenges: Repair systems, manage alerts, and face emergencies while defending the station.\n Stunning Visuals: A breathtaking sci-fi environment with dynamic lighting, realistic damage effects, and vast space backdrops.\n\nThe world depends on you! Grab your tools, man the cannons, and fight to protect Earth in this heart-pounding VR space adventure.", "short_description": "Dock, Defend, and Save the World!\nStep into the boots of a space worker in this immersive VR experience. Dock your spaceship at the station, take control of powerful shooter cannons, and defend Earth from an onslaught of meteors threatening humanity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chef.gs/eclipse-defense-privacy-policy", "developer_terms_of_service_url": "https://www.chef.gs/terms-of-service", "publisher_name": "CHEF Game Studio", "support_website_url": "https://www.chef.gs/contact", "website_url": "https://www.chef.gs/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
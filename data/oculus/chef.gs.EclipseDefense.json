e7a0a&_nc_ohc=xOQ95n59LIgQ7kNvwH9BFUm&_nc_oc=AdpiJc8FpvEBJkfwjNFQxVglMuMimQqwzdB6hukaN0XVB3su-j8oWSVcFvUzHwYgPLY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kawUYxpuB5hDXpYNrsq9FIk_dRE3uKAJSTNySmo9rvg&oe=6A32ABBC"}, {"file_name": "EclipseDefenceImage03.png", "id": "1315333866150469", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982517_1315333869483802_8451455932263526366_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrhDMuJC5fYQ7kNvwEORtAp&_nc_oc=AdpwUdm2TgW3VekL0AqNVCEhONEyRkhrjp-njR4eRHyoRwveHaPq-sM-0bG8jlbpXv8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jenSSn2LllgD3OpWLENNfhKvHfaK0p7rbrYZaUWUFcw&oe=6A32C05A"}, {"file_name": "EclipseDefenceImage02.png", "id": "600762692399494", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974856_600762695732827_6505960866598570138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rXSkOXfFo0Q7kNvwG9ThYm&_nc_oc=AdqaHZPfnIYToUkU8ALV3Hr3S2EXWHzhKcUl9urGiPiWga7vCswlI5GLj2s5WwjPYgQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gQnr0LT5KXyq6g8h82_KM9e-iVcjLWGtwg9ojF5sptg&oe=6A32C751"}, {"file_name": "EclipseDefenceImage01.png", "id": "2063620994075579", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75210888_2063620997408912_6888476953228441268_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YoOdSrWMDpwQ7kNvwEOGRE9&_nc_oc=AdpVZkgoWMhWrAmhlha5rErOXZem6tq6uj5H_bTWtKDWQFMMGlZDKcS9YlbI7mML2eM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8omwW0uXnKMrqH-L0SFnLuDPA54J0b-cGGqDI7Qf6PTw&oe=6A32A926"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eclipse Defense", "keywords": ["space", "defense", "spaceship", "gravity"], "long_description": "A Hero\u2019s Call in Space \u2013 The Ultimate VR Experience at Eclipse Defense\n\nIn this thrilling VR game, you are a skilled space worker tasked with saving the world from destruction. As your spaceship docks with a massive space station, chaos unfolds. Meteors are hurtling toward Earth, and only you can stop them!\n\nKey Features:\n Immersive Space Exploration: Experience realistic docking mechanics as you pilot and connect your spaceship to the station.\n Interactive Environment: Explore the detailed interiors of the space station, complete with tools, ladders, and control systems.\n Intense Meteor Defense: Climb to the upper levels, activate the shooter cannon, and unleash firepower to destroy waves of meteors.\n Dynamic Challenges: Repair systems, manage alerts, and face emergencies while defending the station.\n Stunning Visuals: A breathtaking sci-fi environment with dynamic lighting, realistic damage effects, and vast space backdrops.\n\nThe world depends on you! Grab your tools, man the cannons, and fight to protect Earth in this heart-pounding VR space adventure.", "short_description": "Dock, Defend, and Save the World!\nStep into the boots of a space worker in this immersive VR experience. Dock your spaceship at the station, take control of powerful shooter cannons, and defend Earth from an onslaught of meteors threatening humanity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chef.gs/eclipse-defense-privacy-policy", "developer_terms_of_service_url": "https://www.chef.gs/terms-of-service", "publisher_name": "CHEF Game Studio", "support_website_url": "https://www.chef.gs/contact", "website_url": "https://www.chef.gs/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
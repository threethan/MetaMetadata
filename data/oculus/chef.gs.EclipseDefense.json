_1357397732304481_3091330945972944752_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtAc-0f5hbsQ7kNvwG5L7M0&_nc_oc=AdpTRW7SfqCKbhWFDRGOg7zWJl6AvBKPj37aPF9h6P-1VhayCx43E4g_toJHJtQ9OZk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fui0Lh0f9cpmLfzPTjB5EZxAyczGHjcIObCizlSEcIw&oe=6A01C146"}, {"file_name": "2560x1440_2 (1).png", "id": "1120457513004693", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974568_1120457516338026_3819049469444330578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MN9iAlH8gZMQ7kNvwHpKpvZ&_nc_oc=AdqG6BRo6clhNC09IIEyvjMEXw-lXMIMY2qSFt1fouQMGc3_Rz5P_ZgqJtXTTzOdSc0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4b2iSHZH7z6XuWwFJC-U9Q9naYtIyHXO0qfiqTeEgOrQ&oe=6A01E66F"}, {"file_name": "1008x1440_1 (1).png", "id": "917796330067972", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75272215_917796333401305_8296619983331867320_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQIqix5DUKUQ7kNvwHp_ERP&_nc_oc=Adrao8nY_d-3wU1cnUmMAhjoP0QTyStVsi4wvQDmfm4tkXtO1Jd5iWlVyKYJIRlVZiE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62ibTsqqWGQHOTUe1uA23hNFJ_l5NIoU-NMxYF3YyDgA&oe=6A01D585"}]}, "id": "1014478100720104", "locale": "en_US", "screenshots": [{"file_name": "EclipseDefenceImage04.png", "id": "501190145708871", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974758_501190149042204_5641408677421007963_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-J1RY4piM4Q7kNvwGhQ8BL&_nc_oc=Adp1QDmO0qTEe5fKd3MijCNFH_AJH7nighfO_Wkooac1XMNO0iJOt3GHD5tOJpp4PC8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fuVxGzB0jD3nzWQfv6XYrJzGdyoOMq_X4DJsejTj77A&oe=6A01CC30"}, {"file_name": "EclipseDefenceImage05.png", "id": "2214028069052374", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974702_2214028072385707_966198005100103568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C64mMV7H2ukQ7kNvwGAz8ah&_nc_oc=AdpNALGXQNEZZEVJbsS1I0vrKQsfYEj5OUpJ-Z0t9tmr1lOzBbKQkxcFgxwg5TN4kVA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rUYJ0SEXFKqKPVaeo2nb_mul-_GrmlNMeahUJUywhZA&oe=6A01E43C"}, {"file_name": "EclipseDefenceImage03.png", "id": "1315333866150469", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982517_1315333869483802_8451455932263526366_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xz6EtAuXJSIQ7kNvwFeR6-s&_nc_oc=AdoppJbS8cGMH6o_KEST8HdQTOZSQ28O5-yDRwLYV1Yu1k3Vo0jFKfaxlcrfvqk-mGs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XNkKmRjSbafexrbKTc7-wKisKvmGsbCKC5BMVg5UYig&oe=6A01C09A"}, {"file_name": "EclipseDefenceImage02.png", "id": "600762692399494", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974856_600762695732827_6505960866598570138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtvApSP7_CEQ7kNvwHJ53Sj&_nc_oc=AdrEAhKuM9mb0PO3yfusbalsMykDSNRAG9zIp4iwrQuWBJwEF14_Vmay-TqTw3nhEPg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46gA8EkLFifg6W_xPKb1k0GF-WVCibtAdapPQNPSQWHA&oe=6A01C791"}, {"file_name": "EclipseDefenceImage01.png", "id": "2063620994075579", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210888_2063620997408912_6888476953228441268_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CU0cbVaucUkQ7kNvwEs_27f&_nc_oc=AdrQcC8lP05czX3nkEykjFk76TeUpiY5u_LmGwM6r-2mM3m6rIoEBsJQOpSdeZi11wQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uc1db5NqdUb9s-nTCJ_2Du2z8b2Tl8JdtV04GMLL3aw&oe=6A01E1A6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eclipse Defense", "keywords": ["space", "defense", "spaceship", "gravity"], "long_description": "A Hero\u2019s Call in Space \u2013 The Ultimate VR Experience at Eclipse Defense\n\nIn this thrilling VR game, you are a skilled space worker tasked with saving the world from destruction. As your spaceship docks with a massive space station, chaos unfolds. Meteors are hurtling toward Earth, and only you can stop them!\n\nKey Features:\n Immersive Space Exploration: Experience realistic docking mechanics as you pilot and connect your spaceship to the station.\n Interactive Environment: Explore the detailed interiors of the space station, complete with tools, ladders, and control systems.\n Intense Meteor Defense: Climb to the upper levels, activate the shooter cannon, and unleash firepower to destroy waves of meteors.\n Dynamic Challenges: Repair systems, manage alerts, and face emergencies while defending the station.\n Stunning Visuals: A breathtaking sci-fi environment with dynamic lighting, realistic damage effects, and vast space backdrops.\n\nThe world depends on you! Grab your tools, man the cannons, and fight to protect Earth in this heart-pounding VR space adventure.", "short_description": "Dock, Defend, and Save the World!\nStep into the boots of a space worker in this immersive VR experience. Dock your spaceship at the station, take control of powerful shooter cannons, and defend Earth from an onslaught of meteors threatening humanity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chef.gs/eclipse-defense-privacy-policy", "developer_terms_of_service_url": "https://www.chef.gs/terms-of-service", "publisher_name": "CHEF Game Studio", "support_website_url": "https://www.chef.gs/contact", "website_url": "https://www.chef.gs/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
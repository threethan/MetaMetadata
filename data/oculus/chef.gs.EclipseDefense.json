_1357397732304481_3091330945972944752_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Svazr7P3_9oQ7kNvwEJfbWb&_nc_oc=AdoeyrX6RrNhthIHqJRhQrGj6rF0Xl2N0Or_M81LYtjzqlYvphsHuUq5Zzuwq_sbvXk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgSNlPGasIL8F2KbqYkdQM3CgFs8AXNSDNC4l25rfihA&oe=6ABD2E86"}, {"file_name": "2560x1440_2 (1).png", "id": "1120457513004693", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974568_1120457516338026_3819049469444330578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlc13XkszOUQ7kNvwF-m-EK&_nc_oc=AdpT8R_DaGO_SgAWFNnpDnX3fzU3YrS3Co5Ac6rNP13CfuW7DMeQ6h0iihOtO6jAGCA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGvCmLWkRV-Hb_iywfy2kF3ftmiuv-Cs-yHpzCOTgJVw&oe=6ABD1B6F"}, {"file_name": "1008x1440_1 (1).png", "id": "917796330067972", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75272215_917796333401305_8296619983331867320_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11avJu7tcCoQ7kNvwGMs9ia&_nc_oc=Adrk0dXiodw70U_gP99beEV9xiQUxxmWLZugTurwUCOWQhFJOtjqWI26Xyb2AZsLyfE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJGzoFLpyFieO4ICeihSxx6bkIQNUDT609uJo8TclZdg&oe=6ABD0A85"}]}, "id": "1014478100720104", "locale": "en_US", "screenshots": [{"file_name": "EclipseDefenceImage04.png", "id": "501190145708871", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974758_501190149042204_5641408677421007963_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kb_2VJo3sJUQ7kNvwG-W9x1&_nc_oc=AdoU3OQbERvje6IW6ukkumuFNk5FBaPItdL2pTpp65QkgRVQ5jSs9_nDjXv_wgeozoo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEO_bTrVIMWbqQKfbdbH5iGNQTQMNfdKI9FDfmoSjORQ&oe=6ABD0130"}, {"file_name": "EclipseDefenceImage05.png", "id": "2214028069052374", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974702_2214028072385707_966198005100103568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTKdZ7Egp6EQ7kNvwE_C3qb&_nc_oc=Adrbtime2umlIq-WHg32LtFhuGcL-gD8q8MPtFx8xQ0AUN5nTBuJlzqy6iKEoBmsI2Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZxGq9apSsWbPA4zRkb_Lx5_8zecb0cYevRbDzM4Qg4w&oe=6ABD193C"}, {"file_name": "EclipseDefenceImage03.png", "id": "1315333866150469", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982517_1315333869483802_8451455932263526366_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIzXFkzPBQMQ7kNvwHXUpFN&_nc_oc=Adq_SlqNDCCjhxti9AabOLGCd9B6PrBPu2Vzm-6YHiqz1GR_287RhD_Omr7mvD4XRy8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcGdcO79l6eSBw6YWEjcvAps4iZRPsxqufs55_VhB0wg&oe=6ABD2DDA"}, {"file_name": "EclipseDefenceImage02.png", "id": "600762692399494", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974856_600762695732827_6505960866598570138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49GMV7JNvt4Q7kNvwGCrDAE&_nc_oc=AdqauKAWl4pgbgOu-_TBAJs0Phq0ZFx834Di63XdAWbd5l3gXeaue2gLLCQuNq8cl-Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNSpwijTykUSm3E_yXMtiXQab_ZzDaJ7Y3i7uFc-wFUg&oe=6ABD34D1"}, {"file_name": "EclipseDefenceImage01.png", "id": "2063620994075579", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210888_2063620997408912_6888476953228441268_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w26QQDHF51AQ7kNvwFarjHN&_nc_oc=AdqBY173ADUz2C-I0J3uJ1UwNAqzeWRH5OMgMhGeAhdK0BQCtn35qlQcNhPgQFfP4no&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRHR3VRieaPigZfxxzqVFQ0sH46gqQKCG0UNdY_Sovkw&oe=6ABD16A6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eclipse Defense", "keywords": ["space", "defense", "spaceship", "gravity"], "long_description": "A Hero\u2019s Call in Space \u2013 The Ultimate VR Experience at Eclipse Defense\n\nIn this thrilling VR game, you are a skilled space worker tasked with saving the world from destruction. As your spaceship docks with a massive space station, chaos unfolds. Meteors are hurtling toward Earth, and only you can stop them!\n\nKey Features:\n Immersive Space Exploration: Experience realistic docking mechanics as you pilot and connect your spaceship to the station.\n Interactive Environment: Explore the detailed interiors of the space station, complete with tools, ladders, and control systems.\n Intense Meteor Defense: Climb to the upper levels, activate the shooter cannon, and unleash firepower to destroy waves of meteors.\n Dynamic Challenges: Repair systems, manage alerts, and face emergencies while defending the station.\n Stunning Visuals: A breathtaking sci-fi environment with dynamic lighting, realistic damage effects, and vast space backdrops.\n\nThe world depends on you! Grab your tools, man the cannons, and fight to protect Earth in this heart-pounding VR space adventure.", "short_description": "Dock, Defend, and Save the World!\nStep into the boots of a space worker in this immersive VR experience. Dock your spaceship at the station, take control of powerful shooter cannons, and defend Earth from an onslaught of meteors threatening humanity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chef.gs/eclipse-defense-privacy-policy", "developer_terms_of_service_url": "https://www.chef.gs/terms-of-service", "publisher_name": "CHEF Game Studio", "support_website_url": "https://www.chef.gs/contact", "website_url": "https://www.chef.gs/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
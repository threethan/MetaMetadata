0yrDGAx8iKx6T_v6EDNPfGNeuhJOI88kA&oe=69CE63EF"}, {"file_name": "New Project (3).png", "id": "791409305689841", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575360_791409309023174_1743892238196351829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzGydhawWjoQ7kNvwE0U2YT&_nc_oc=AdpPUOk4omZkUay4xr9fpxoqwPgybWGXzWvNeWFg2oE7CKSFooEJ23_baRc_TEyHbPQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5cVrWQfNmOwCR7w0-SVrx532TS0b9wg4EmeXLW080UQ&oe=69CE7AED"}, {"file_name": "New Project (2).png", "id": "628167195833512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422375_628167199166845_2553398347054262883_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFuhNlREZsIQ7kNvwEGiyJb&_nc_oc=AdrR7Zfz5g7JjDsXS5D5BzL3dSPZL4ENWO41HJeg5a8BNbR8ntPble-KTR8v-LZa5Ac&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwcsPBw9kIzGnfbX4JRRT_DRK2KeMUjnDG109l3M2oVAQ&oe=69CE79EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (5).png", "id": "769198991310172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210898_769198994643505_2364420028797580442_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qWesCtVtmoQ7kNvwFxHkxe&_nc_oc=AdprA24RyQmoC5ZBmEa1klvxUWgl3SgcgeCEnwWrs9ucZ3hy2-flzKeLBtznrq9kfss&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz4Djvzg0ayFSv0Xoy-1gR90-Xr0LZYZ2wpD14Lhsv8pw&oe=69CE83DD"}, "display_name": "Scary Lairy VR", "keywords": [], "long_description": "Scary Lairy VR is a virtual reality game with horror aspects. The game uses joystick locomotion and has interesting mechanics. Although the game is short, expect to be uneasy in some cases. Scary Lairy is also a story game that goes on as objectives are completed. In the game you are a kid awakened by a strange noise in the middle of the night, complete chores around the house, and explore the environment. In this world, there is a being called Scary Lairy. Scary Lairy will go to a victim's house, typically a house in a rural area, and stalk them until they are most vulnerable. \n\n(To get out of bed press the B Button or Secondary Button)", "short_description": "Scary Lairy VR is a short horror game based around the being called Scary Lairy. Scary Lairy will go to a victim's house, typically a house in a rural area, and stalk them until they are most vulnerable.\n\n(To get out of bed press the B Button or Secondary Button)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/scary-lairy-privacy-policy/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nimaple", "support_website_url": null, "website_url": "https://sites.google.com/view/scary-lairy-privacy-policy/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1685852365201697"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "213161494778010"}]}, "baseline_offer": {"id": "213161494778010"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1683649753, "status": "PUBLISHED", "id": "213161494778010"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5903671003088349", "version": "0.1.2"}, "id": "131401886585018", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binarie
409305689841", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575360_791409309023174_1743892238196351829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPYuT0buNw8Q7kNvwGnzzkF&_nc_oc=Adm5TgqWuDTcntC5LT_sn_QK1Eyatl-kp7hUygDJc_qLXWpkPe_Q32VC8AHwen0t6ks&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxM1BFlj8CQSjgJVUDhobzBb4REev12DcNuf6juthW4wg&oe=69B0286D"}, {"file_name": "New Project (2).png", "id": "628167195833512", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422375_628167199166845_2553398347054262883_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IiwyTWV9GQQ7kNvwFsCEdz&_nc_oc=AdmoIgUpNqcuWjjVKDfT6_jt7CtwF-wP8TWmr9USmLnRL56T0yGbx-2YopjBEPp6PLQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzjUq6_XAwNLRBpgUty5FlI6lbINQOx-ALnBM69lLAtSQ&oe=69B0276C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (5).png", "id": "769198991310172", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210898_769198994643505_2364420028797580442_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sc3sqswNbHgQ7kNvwG4waTn&_nc_oc=AdkX3oSDIc71PY85UUJCSdvqoWeZEt4tkH_YfkJiFa-8WoKarOdzkeR7PlyZ5gsVGpk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzjrc9OzRbvZOeQHhQB-betVla_043Yt3CdEi4ZG1ms3Q&oe=69AFF91D"}, "display_name": "Scary Lairy VR", "keywords": [], "long_description": "Scary Lairy VR is a virtual reality game with horror aspects. The game uses joystick locomotion and has interesting mechanics. Although the game is short, expect to be uneasy in some cases. Scary Lairy is also a story game that goes on as objectives are completed. In the game you are a kid awakened by a strange noise in the middle of the night, complete chores around the house, and explore the environment. In this world, there is a being called Scary Lairy. Scary Lairy will go to a victim's house, typically a house in a rural area, and stalk them until they are most vulnerable. \n\n(To get out of bed press the B Button or Secondary Button)", "short_description": "Scary Lairy VR is a short horror game based around the being called Scary Lairy. Scary Lairy will go to a victim's house, typically a house in a rural area, and stalk them until they are most vulnerable.\n\n(To get out of bed press the B Button or Secondary Button)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/scary-lairy-privacy-policy/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nimaple", "support_website_url": null, "website_url": "https://sites.google.com/view/scary-lairy-privacy-policy/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1685852365201697"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "213161494778010"}]}, "baseline_offer": {"id": "213161494778010"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1683649753, "status": "PUBLISHED", "id": "213161494778010"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5903671003088349", "version": "0.1.2"}, "id": "131401886585018", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__t
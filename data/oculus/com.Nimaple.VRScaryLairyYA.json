nFAGlsZ84CnwxM0X6d2LNvcW-xyQ3Y9Sw3If9xy_tNGtRD0uIjvkV24sqhLsb7vJk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyjc2s38vsjSnHgNxsVLgehvHmu7nsV7blm_81_DbZXaQ&oe=69B00916"}, {"file_name": "New Project.png", "id": "632398614980601", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75556807_632398618313934_8734007727645540180_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9o-CPFpjKTUQ7kNvwEkWKjl&_nc_oc=AdnQit8TyJB3PMR3J6YpCsQKZokfMxhIDGJjxSBlD-_CNZ_UB6JlPd5uq34PSprArE4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwjDczJK0I5mtkVJabcJpM0qqtKBdQpCrhF5zsAkDg18g&oe=69B0116F"}, {"file_name": "New Project (3).png", "id": "791409305689841", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575360_791409309023174_1743892238196351829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPYuT0buNw8Q7kNvwGnzzkF&_nc_oc=Adm5TgqWuDTcntC5LT_sn_QK1Eyatl-kp7hUygDJc_qLXWpkPe_Q32VC8AHwen0t6ks&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxM1BFlj8CQSjgJVUDhobzBb4REev12DcNuf6juthW4wg&oe=69B0286D"}, {"file_name": "New Project (2).png", "id": "628167195833512", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422375_628167199166845_2553398347054262883_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IiwyTWV9GQQ7kNvwFsCEdz&_nc_oc=AdmoIgUpNqcuWjjVKDfT6_jt7CtwF-wP8TWmr9USmLnRL56T0yGbx-2YopjBEPp6PLQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzjUq6_XAwNLRBpgUty5FlI6lbINQOx-ALnBM69lLAtSQ&oe=69B0276C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (5).png", "id": "769198991310172", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210898_769198994643505_2364420028797580442_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sc3sqswNbHgQ7kNvwG4waTn&_nc_oc=AdkX3oSDIc71PY85UUJCSdvqoWeZEt4tkH_YfkJiFa-8WoKarOdzkeR7PlyZ5gsVGpk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzjrc9OzRbvZOeQHhQB-betVla_043Yt3CdEi4ZG1ms3Q&oe=69AFF91D"}, "display_name": "Scary Lairy VR", "keywords": [], "long_description": "Scary Lairy VR is a virtual reality game with horror aspects. The game uses joystick locomotion and has interesting mechanics. Although the game is short, expect to be uneasy in some cases. Scary Lairy is also a story game that goes on as objectives are completed. In the game you are a kid awakened by a strange noise in the middle of the night, complete chores around the house, and explore the environment. In this world, there is a being called Scary Lairy. Scary Lairy will go to a victim's house, typically a house in a rural area, and stalk them until they are most vulnerable. \n\n(To get out of bed press the B Button or Secondary Button)", "short_description": "Scary Lairy VR is a short horror game based around the being called Scary Lairy. Scary Lairy will go to a victim's house, typically a house in a rural area, and stalk them until they are most vulnerable.\n\n(To get out of bed press the B Button or Secondary Button)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/scary-lairy-privacy-policy/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nimaple", "support_website_url": null, "website_url": "https://sites.google.com/view/scary-lairy-privacy-policy/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id":
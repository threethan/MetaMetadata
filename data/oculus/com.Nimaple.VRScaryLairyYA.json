H6NAQHv82FF-EDG_tnvuZhZ8FLtTguMHafRt7EUMkg2JMjY3kgg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afurf7OOPfaOLa7K_4TWrAd2loo5pjY4zxI90o1HchAGQw&oe=69A44AED"}, {"file_name": "New Project (2).png", "id": "628167195833512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422375_628167199166845_2553398347054262883_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARLnX0faYcMQ7kNvwE0a38z&_nc_oc=AdmS140YuflzY1k4kSWae9bpxI90o54sQQ839L5I9byaacGVLxTkL3qeOILnMKDZhw0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvJCfdPBATOltOp2AGzwFtYaBuJfmNw8zkTFABdItcxyg&oe=69A449EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (5).png", "id": "769198991310172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210898_769198994643505_2364420028797580442_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqfFOd6wGFQQ7kNvwHA47Ak&_nc_oc=Adnn3Zht8gBzC9j_I-iQiit1mg8WKTfSU0K8dvsSA-APl7DjFBk04LWOhhpEM17Bj78&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv1Ki9eArTAvqKFXW3cdZqgV0JGRQY5aDBNG4R_M0lFmw&oe=69A41B9D"}, "display_name": "Scary Lairy VR", "keywords": [], "long_description": "Scary Lairy VR is a virtual reality game with horror aspects. The game uses joystick locomotion and has interesting mechanics. Although the game is short, expect to be uneasy in some cases. Scary Lairy is also a story game that goes on as objectives are completed. In the game you are a kid awakened by a strange noise in the middle of the night, complete chores around the house, and explore the environment. In this world, there is a being called Scary Lairy. Scary Lairy will go to a victim's house, typically a house in a rural area, and stalk them until they are most vulnerable. \n\n(To get out of bed press the B Button or Secondary Button)", "short_description": "Scary Lairy VR is a short horror game based around the being called Scary Lairy. Scary Lairy will go to a victim's house, typically a house in a rural area, and stalk them until they are most vulnerable.\n\n(To get out of bed press the B Button or Secondary Button)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/scary-lairy-privacy-policy/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nimaple", "support_website_url": null, "website_url": "https://sites.google.com/view/scary-lairy-privacy-policy/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1685852365201697"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "213161494778010"}]}, "baseline_offer": {"id": "213161494778010"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1683649753, "status": "PUBLISHED", "id": "213161494778010"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5903671003088349", "version": "0.1.2"}, "id": "131401886585018", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5874550419333741", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5903671003088349"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": 
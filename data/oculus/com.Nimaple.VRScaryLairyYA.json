3-1.oculuscdn.com/v/t64.5771-25/75210898_769198994643505_2364420028797580442_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYSCFWU1mvsQ7kNvwH_PGyq&_nc_oc=AdplagZb1jQW7FpdbxVcvLlXRXt68wFW_SxvsTW2a-xnVbBXc0EznjC78im_KbKGYRk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRyT5hOOaA9LhUozhebZnKlxtW0bkx4TMSfLGwoeuh63w&oe=6B0B241D"}, "display_name": "Scary Lairy VR", "keywords": [], "long_description": "Scary Lairy VR is a virtual reality game with horror aspects. The game uses joystick locomotion and has interesting mechanics. Although the game is short, expect to be uneasy in some cases. Scary Lairy is also a story game that goes on as objectives are completed. In the game you are a kid awakened by a strange noise in the middle of the night, complete chores around the house, and explore the environment. In this world, there is a being called Scary Lairy. Scary Lairy will go to a victim's house, typically a house in a rural area, and stalk them until they are most vulnerable. \n\n(To get out of bed press the B Button or Secondary Button)", "short_description": "Scary Lairy VR is a short horror game based around the being called Scary Lairy. Scary Lairy will go to a victim's house, typically a house in a rural area, and stalk them until they are most vulnerable.\n\n(To get out of bed press the B Button or Secondary Button)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/scary-lairy-privacy-policy/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nimaple", "support_website_url": null, "website_url": "https://sites.google.com/view/scary-lairy-privacy-policy/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": 
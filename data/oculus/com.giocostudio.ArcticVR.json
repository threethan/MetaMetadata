uluscdn.com&_nc_ss=7a30f&oh=00_AfwkqUDTp9XorUvHNorh6NqYFPCpeyEsswBZz1_1sRdCMg&oe=69C538EC"}, {"file_name": "ss3.png", "id": "911042858227906", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823341_911042861561239_3481987615604902449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-phMJ2M1iMQ7kNvwF4wQgj&_nc_oc=AdqurqIa6RQSmKUwAcShHRxOcGuS_G6d3XR6oOJLRZCh4AG5YRiFEeVKcYKhNb50nYk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx4f_uTl2LB_LAU06A5zz6SI2Pmh-E8p4FBW2kf725m-Q&oe=69C529F0"}, {"file_name": "ss4.png", "id": "1940424886610187", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307451_1940424889943520_7436069056989447797_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PCFo2YG3z4Q7kNvwERcWSI&_nc_oc=AdrNs2178kwtFXN8tM0VEdPs4CAYSXH1YRa9unbDnBvb8fImmonspF0Gf1OTfOVfNXI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz220SRhDuvPdPiig0XvPuS1D9883wGc3iIP31cAb8hXQ&oe=69C51046"}, {"file_name": "ss2.png", "id": "26143231335310768", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/585819904_26143231348644100_4706414489069474771_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_edfaepcFQQ7kNvwG2zDuV&_nc_oc=AdpqilyrXwp9otIpWru3eSb8cUEfQOxXusWvMpg8DsSZjvKe5fRo2c1aOw5zo8Tv5SE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZgVxmWMVyP-DUteQmpMEm9MjgADEGMwBk9g_eV2iQeQ&oe=69C5107D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart.png", "id": "1248867616669768", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/585741071_1248867620003101_4232653470607510738_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GGadxbXbPMQ7kNvwFSEIBg&_nc_oc=Adpl6OG3In_rFQ9sqimD_P5gFyhSfm6NDrBRI7qYvz30S_-BEIQ4RXewwOLtkOfFbJ8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyUkQ36FH2g-38YQvlES0j7pryIj39SRQaz05-RJ4wdEA&oe=69C52B3F"}, "display_name": "Arctic Expedition: Physics Sandbox", "keywords": ["Aviation", "AnimalRescue", "PhysicsSandbox", "ArcticExpedition", "FamilyAdventure"], "long_description": "**Embark on the ultimate Arctic Expedition!** Discover three expansive frozen islands in a high-density physics sandbox built for infinite discovery. \nWhether you are mastering high-altitude aviation or embarking on heartwarming animal rescue missions, every inch of this stunning low-poly wilderness is yours to explore.\n{906007749081496} \n\n**SKY-HIGH DISCOVERY:**\n\nTake command of the frozen skies with realistic flight mechanics.\n\n- **Glider Exploration:** Master wind currents with hang-gliding physics.\n- **Aerial Transport:** Pilot automated biplanes to uncover hidden islands.\n{1459649208923981} \n{1225639122992337} \n\n**PROTECT THE WILD:**\nExperience the emotional heart of the Arctic. Locate, free, and nurture creatures trapped in the wilderness.\n- **Nurturing Gameplay:** Identify wildlife in distress and earn rewards for the successful rescue.\n{949699051055866} \n\n\n**TOTAL INTERACTIVE FREEDOM:**\n \nFrom bungee jumping off ridges to ice fishing and mountain climbing, every object from bonfires to treasure chests is fully interactive.\n\n- **Emergent Play:** High-engagement activities including ropeway travel and rigid-body physics interactions.\n- **Vibrant Discovery:** A stylized, safe environment perfect for explorers of all ages.\n{1704570960951475} \n{1270672331642732} \n{1813631812645499} \n{1653635189382887} \n{1436335421378898}\n\n**SAFE & SEAMLESS:**\n- **Global Leaderboards:** Compete for the best times and exploration scores.\n- **Intuitive Design:** Gentle guidance and clear icons ensure a seamless experience for family-friendly play.\n{2108308573299674} \n\n\n**Note:** This title is in Early Access. Content and features are actively being expanded.\n\n", "short_description": "Embark on the ultimate Arctic adventure! Fly across jagged peaks, traverse deep canyons on a mechanical ropeway, and save a colony of penguins from mysterious visitors. Whether you're roasting treats under the aurora borealis or meeting Santa in his magic sleigh, our physics-driven sandbox offers endless, joyful exploration for the whole family. Discover a living world where every jump defies gravity.\n\nEarly Access: Help us refine the adventure and uncover new frosty mysteries!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://giocostudio.com/giocoapps/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gioco Studio", "support_website_url": null, "website_url": "https://giocostudio.com/giocoapps/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27278097961797595"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1591899812037119"}, {"status": "PUBLISHED", "id": "1797332788053958"}]}, "baseline_offer": {"id": "1797332788053958"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "1591899812037119"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27323238310616893", "version": "0.2"}, "id": "1231392348930938", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27012538065020254", "is_conce
IJCef8XSM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26GFkYua-dkL7B6PsGEbVZ7ICHh_u88c6Vi7ip5RKrKA&oe=69DCCB7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart.png", "id": "1248867616669768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/585741071_1248867620003101_4232653470607510738_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_6PjvgSxToQ7kNvwG5zHVj&_nc_oc=AdpwRCQWEJbcatjimmXmKTNxiCTfFXby-4stNfThYy423uaEB6canuQL1ZFFwVRJrWc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-ghtiZ_f6RrVsBq5Gso46GZr8NzII_sozND-X-1O_BA&oe=69DCE63F"}, "display_name": "Arctic Expedition: Physics Sandbox", "keywords": ["Aviation", "AnimalRescue", "PhysicsSandbox", "ArcticExpedition", "FamilyAdventure"], "long_description": "**Embark on the ultimate Arctic Expedition!** Discover three expansive frozen islands in a high-density physics sandbox built for infinite discovery. \nWhether you are mastering high-altitude aviation or embarking on heartwarming animal rescue missions, every inch of this stunning low-poly wilderness is yours to explore.\n{906007749081496} \n\n**SKY-HIGH DISCOVERY:**\n\nTake command of the frozen skies with realistic flight mechanics.\n\n- **Glider Exploration:** Master wind currents with hang-gliding physics.\n- **Aerial Transport:** Pilot automated biplanes to uncover hidden islands.\n{1459649208923981} \n{1225639122992337} \n\n**PROTECT THE WILD:**\nExperience the emotional heart of the Arctic. Locate, free, and nurture creatures trapped in the wilderness.\n- **Nurturing Gameplay:** Identify wildlife in distress and earn rewards for the successful rescue.\n{949699051055866} \n\n\n**TOTAL INTERACTIVE FREEDOM:**\n \nFrom bungee jumping off ridges to ice fishing and mountain climbing, every object from bonfires to treasure chests is fully interactive.\n\n- **Emergent Play:** High-engagement activities including ropeway travel and rigid-body physics interactions.\n- **Vibrant Discovery:** A stylized, safe environment perfect for explorers of all ages.\n{1704570960951475} \n{1270672331642732} \n{1813631812645499} \n{1653635189382887} \n{1436335421378898}\n\n**SAFE & SEAMLESS:**\n- **Global Leaderboards:** Compete for the best times and exploration scores.\n- **Intuitive Design:** Gentle guidance and clear icons ensure a seamless experience for family-friendly play.\n{2108308573299674} \n\n\n**Note:** This title is in Early Access. Content and features are actively being expanded.\n\n", "short_description": "Embark on the ultimate Arctic adventure! Fly across jagged peaks, traverse deep canyons on a mechanical ropeway, and save a colony of penguins from mysterious visitors. Whether you're roasting treats under the aurora borealis or meeting Santa in his magic sleigh, our physics-driven sandbox offers endless, joyful exploration for the whole family. Discover a living world where every jump defies gravity.\n\nEarly Access: Help us refine the adventure and uncover new frosty mysteries!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://giocostudio.com/giocoapps/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gioco Studio", "support_website_url": null, "website_url": "https://giocostudio.com/giocoapps/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27278097961797595"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823351_949296577518952_9186384237756077787_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lZOiXD_3UgQ7kNvwF3d8cr&_nc_oc=AdpVf3PHM4QXnCkz1fAPdOj-I2tJErfHQdPKaS2E-XMe_Yw_beI549Gaswb2HdpAUPg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IIdBvFOcs_uP9CarQhBKRfMTuR617ttfAWhL8yYJ_4g&oe=69DCDDCC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Arctic Expedition: Physics Sandbox", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1772722800, "lastRevision": {"nodes": [{"id": "27012538161686911", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "27012538065020254", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "25798160489833232"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "cover_landscape.png", "id": "2794664254210664", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825462_2794664260877330_3093274264635057650_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoRCxtM0ELoQ7kNvwGdB1VC&_nc_oc=Adr3jE_Dx-ZGiqMz50mj4IxEdde-OAoY74Kw7dhxEZymgj8Y86sEp33W_gtOYf-16D4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2p5EFD9Fxp2GsZ1ws1ESgfgdqY-yZsDzwMEx2fzbO92g&oe=69DCCCDA"}, {"file_name": "9.png", "id": "2108308573299674", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491828087_2108308579966340_2116392406161303783_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZvYQ5CJRk4Q7kNvwGOlzEX&_nc_oc=Adp9ega7M4QQ6DBJvxS9yPpd7hJKppUXDV2
069056989447797_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-8cyexswJwQ7kNvwFbPS4E&_nc_oc=Adq30LVH-iTsNCuOE8IzOPpqaM7215ufoTKgVwkUT5pIw1bFVjzaYhpWNrRvOsurV1Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-d3xGVqmpu91GKchUTlQES-zfqN7DBTQlodQMZnnsFQ&oe=6A452A06"}, {"file_name": "ss2.png", "id": "26143231335310768", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/585819904_26143231348644100_4706414489069474771_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVXdAu8EM1gQ7kNvwHaEVEf&_nc_oc=AdoQhKmf-HazeWE6soqJskem2idKfEyY5OCVCOAnCN9WLqe9BrYclRuTnGDXZKty0n8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HQufvpXAFskmTHaeRYEZH03M0CUbB0OfjSuroObiegA&oe=6A452A3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart.png", "id": "1248867616669768", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/585741071_1248867620003101_4232653470607510738_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wV8Qx-6l6fEQ7kNvwFFclK3&_nc_oc=AdrcNquhntJvLxpcotPPY3C_WLoDiEM4yQ2znOA3MNYZ2DtprLKGpnS_62bGw78kAow&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82g9QTqR70Rg8-527_2me0pwdZ_6Q0EnGW02elTBSL5Q&oe=6A450CBF"}, "display_name": "Arctic Expedition: Physics Sandbox", "keywords": ["Aviation", "AnimalRescue", "PhysicsSandbox", "ArcticExpedition", "FamilyAdventure"], "long_description": "**Embark on the ultimate Arctic Expedition!** Discover three expansive frozen islands in a high-density physics sandbox built for infinite discovery. \nWhether you are mastering high-altitude aviation or embarking on heartwarming animal rescue missions, every inch of this stunning low-poly wilderness is yours to explore.\n{906007749081496} \n\n**SKY-HIGH DISCOVERY:**\n\nTake command of the frozen skies with realistic flight mechanics.\n\n- **Glider Exploration:** Master wind currents with hang-gliding physics.\n- **Aerial Transport:** Pilot automated biplanes to uncover hidden islands.\n{1459649208923981} \n{1225639122992337} \n\n**PROTECT THE WILD:**\nExperience the emotional heart of the Arctic. Locate, free, and nurture creatures trapped in the wilderness.\n- **Nurturing Gameplay:** Identify wildlife in distress and earn rewards for the successful rescue.\n{949699051055866} \n\n\n**TOTAL INTERACTIVE FREEDOM:**\n \nFrom bungee jumping off ridges to ice fishing and mountain climbing, every object from bonfires to treasure chests is fully interactive.\n\n- **Emergent Play:** High-engagement activities including ropeway travel and rigid-body physics interactions.\n- **Vibrant Discovery:** A stylized, safe environment perfect for explorers of all ages.\n{1704570960951475} \n{1270672331642732} \n{1813631812645499} \n{1653635189382887} \n{1436335421378898}\n\n**SAFE & SEAMLESS:**\n- **Global Leaderboards:** Compete for the best times and exploration scores.\n- **Intuitive Design:** Gentle guidance and clear icons ensure a seamless experience for family-friendly play.\n{2108308573299674} \n\n\n**Note:** This title is in Early Access. Content and features are actively being expanded.\n\n", "short_description": "Embark on the ultimate Arctic adventure! Fly across jagged peaks, traverse deep canyons on a mechanical ropeway, and save a colony of penguins from mysterious visitors. Whether you're roasting treats under the aurora borealis or meeting Santa in his magic sleigh, our physics-driven sandbox offers endless, joyful exploration for the whole family. Discover a living world where every jump defies gravity.\n\nEarly Access: Help us refine the adventure and uncover new frosty mysteries!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://giocostudio.com/giocoapps/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gioco Studio", "support_website_url": null, "website_url": "https://giocostudio.com/giocoapps/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27278097961797595"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1591899812037119"}, {"status": "PUBLISHED", "id": "1797332788053958"}]}, "baseline_offer": {"id": "1797332788053958"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "1591899812037119"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28706039655670078", "version": "1.0"}, "id": "1231392348930938", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27012538065020254", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28706039655670078"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1231392348930938"}]}, "change_log": "The Freedom Update\nWe're out of Early Access. Took us four months. Worth it.\nManual Flight \u2014 the hang glider is yours to pilot now. Full wind physics, no rails\n\nManual Sailing \u2014 grab the helm and sail between islands. Mini-map in HUD so you don't get lost\n\n120fps on Quest 3 / 90fps on Quest 2 \u2014 smoothest it's ever felt\n\nHDRP Sky \u2014 aurora and northern lights got a full rebuild\n\nParticle Water \u2014 ocean and lakes finally look the way we always wanted\n\nNatural Movement \u2014 fixed the locomotion jitter that a few of you flagged. should feel much better now\n\nAudio mix + minor bug fixes\nwe're 3 people in Singapore and this one means a lot to us. thanks for sticking around.", "created_date": 1782314916, "id": "28706039655670078", "version": "1.0", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27012538065020254", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28706039655670078"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1772432087, "id": "27385998651007525", "version": "0.2", "version_code": 3, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27012538065020254", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28706039655670078"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1231392348930938"}]}, "change_log": "We have changed the name of the app from Arctic VR to Arctic Expedition: Physics Sandbox. Apart from that, we have changed the pricing from Free app to paid app with the price of $9.99. We have also updated the keywords.", "created_date": 1771861085, "id": "27323238310616893", "version": "0.2", "version_code": 2, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27012538065020254", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28706039655670078"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1231392348930938"}]}, "change_log": "\\\"Arctic VR is a free-roam exploration experience across three islands. There is no linear progression or required objectives. All activities are optional and can be completed in any order.\n\nThis build includes: bonfire tutorial, chest collection (score system), airplane flight, fishing, animal rescue, bungee jump (with comfort FOV selection), hang gliding, ropeway/ship travel, mountain climbing (with guidance), Santa interaction, and global leaderboard (score + time).\n\nComfort features include smooth locomotion, grab-button visual icons, and a bungee jump comfort mode (Full View or Focused View to reduce motion sickness).\n\nNo personal user data is collected, stored, or transmitted.\\\"", "created_date": 1771250662, "id": "27257330323874359", "version": "0.1", "version_code": 1, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
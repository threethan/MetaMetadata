luscdn.com&_nc_ss=7a30f&oh=00_Af2xMQI28f0m-QY6lKoDHs_IZ2EcthlWVmz2vaHAFWzoiA&oe=69E8D16C"}, {"file_name": "ss3.png", "id": "911042858227906", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823341_911042861561239_3481987615604902449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9d8W-Hh7HEMQ7kNvwGp50TI&_nc_oc=AdokPmi1ejU4WZY-zJ3TaEzoRSVfsCullkqdhmqXu713K09Ha_BYc3nhSvJGCSwvGHs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EPAAa8OpykfbbaO_mauAaPaHeHy9w6mtO28M_X4YDjg&oe=69E8C270"}, {"file_name": "ss4.png", "id": "1940424886610187", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307451_1940424889943520_7436069056989447797_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZ6vV3A__IQQ7kNvwFNLShk&_nc_oc=Adrh2kK9tUoTNsVPBbJlVb4m1YYxDhI9BREGlJ0yXMhy6vHQeOHD2p8TcHzXam98kl8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2D3lPTvmht3QUX9UChEtZ9drXQThwbwQBO_BtHwg-DJw&oe=69E8E106"}, {"file_name": "ss2.png", "id": "26143231335310768", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/585819904_26143231348644100_4706414489069474771_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZ6mCEqg4_kQ7kNvwGzH0Gk&_nc_oc=AdpCyqi0x9hY_G8IEssgKXjf6olzadnnuYClAkiOUfv3_9BfWQSkc2QaXIJMWSb-UH8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gmeXMtP4K16CVXgUTbROpDFBZDzhG5YR6R1DPV0nDIA&oe=69E8E13D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart.png", "id": "1248867616669768", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/585741071_1248867620003101_4232653470607510738_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7uAclik9XwQ7kNvwGXGWnM&_nc_oc=Ado7Stnm-3fd9Ba6g8I8F9p0jEbCojR3RiIkl2N6dqP-GG3iv0S0Se2gywX2nkHIqE4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2COdklzWUnXfnsenrWoDoiGfuy687dsjq2WAuiBaU_8Q&oe=69E8C3BF"}, "display_name": "Arctic Expedition: Physics Sandbox", "keywords": ["Aviation", "AnimalRescue", "PhysicsSandbox", "ArcticExpedition", "FamilyAdventure"], "long_description": "**Embark on the ultimate Arctic Expedition!** Discover three expansive frozen islands in a high-density physics sandbox built for infinite discovery. \nWhether you are mastering high-altitude aviation or embarking on heartwarming animal rescue missions, every inch of this stunning low-poly wilderness is yours to explore.\n{906007749081496} \n\n**SKY-HIGH DISCOVERY:**\n\nTake command of the frozen skies with realistic flight mechanics.\n\n- **Glider Exploration:** Master wind currents with hang-gliding physics.\n- **Aerial Transport:** Pilot automated biplanes to uncover hidden islands.\n{1459649208923981} \n{1225639122992337} \n\n**PROTECT THE WILD:**\nExperience the emotional heart of the Arctic. Locate, free, and nurture creatures trapped in the wilderness.\n- **Nurturing Gameplay:** Identify wildlife in distress and earn rewards for the successful rescue.\n{949699051055866} \n\n\n**TOTAL INTERACTIVE FREEDOM:**\n \nFrom bungee jumping off ridges to ice fishing and mountain climbing, every object from bonfires to treasure chests is fully interactive.\n\n- **Emergent Play:** High-engagement activities including ropeway travel and rigid-body physics interactions.\n- **Vibrant Discovery:** A stylized, safe environment perfect for explorers of all ages.\n{1704570960951475} \n{1270672331642732} \n{1813631812645499} \n{1653635189382887} \n{1436335421378898}\n\n**SAFE & SEAMLESS:**\n- **Global Leaderboards:** Compete for the best times and exploration scores.\n- **Intuitive Design:** Gentle guidance and clear icons ensure a seamless experience for family-friendly play.\n{2108308573299674} \n\n\n**Note:** This title is in Early Access. Content and features are actively being expanded.\n\n", "short_description": "Embark on the ultimate Arctic adventure! Fly across jagged peaks, traverse deep canyons on a mechanical ropeway, and save a colony of penguins from mysterious visitors. Whether you're roasting treats under the aurora borealis or meeting Santa in his magic sleigh, our physics-driven sandbox offers endless, joyful exploration for the whole family. Discover a living world where every jump defies gravity.\n\nEarly Access: Help us refine the adventure and uncover new frosty mysteries!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://giocostudio.com/giocoapps/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gioco Studio", "support_website_url": null, "website_url": "https://giocostudio.com/giocoapps/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27278097961797595"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1591899812037119"}, {"status": "PUBLISHED", "id": "1797332788053958"}]}, "baseline_offer": {"id": "1797332788053958"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "1591899812037119"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27323238310616893", "version": "0.2"}, "id": "1231392348930938", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27012538065020254", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27323238310616893"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1772432087, "id": "27385998651007525", "version": "0.2", "version_code": 3, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27012538065020254", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27323238310616893"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1231392348930938"}]}, "change_log": "We have changed the name of the app from Arctic VR to Arctic Expedition: Physics Sandbox. Apart from that, we have changed the pricing from Free app to paid app with the price of $9.99. We have also updated the keywords.", "created_date": 1771861085, "id": "27323238310616893", "version": "0.2", "version_code": 2, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27012538065020254", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27323238310616893"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1231392348930938"}]}, "change_log": "\\\"Arctic VR is a free-roam exploration experience across three islands. There is no linear progression or required objectives. All activities are optional and can be completed in any order.\n\nThis build includes: bonfire tutorial, chest collection (score system), airplane flight, fishing, animal rescue, bungee jump (with comfort FOV selection), hang gliding, ropeway/ship travel, mountain climbing (with guidance), Santa interaction, and global leaderboard (score + time).\n\nComfort features include smooth locomotion, grab-button visual icons, and a bungee jump comfort mode (Full View or Focused View to reduce motion sickness).\n\nNo personal user data is collected, stored, or transmitted.\\\"", "created_date": 1771250662, "id": "27257330323874359", "version": "0.1", "version_code": 1, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
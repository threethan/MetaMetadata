n.com&_nc_ss=7f20f&oh=00_AQR6v_7boLiYNnFW2mccZFpyJKYAwDK2huP8Hl8eeuf27Q&oe=6AFB2E67"}, {"file_name": "Preview 3.png", "id": "1325103456121108", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821115_1325103472787773_8315191427016547255_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnkdHUoyMg0Q7kNvwFUX73m&_nc_oc=Adp7fyD9h8S89P3wK0Zh6S7rrOj62GyxBe-dTqvPP-seg90I6WCP46_ZamDMgmJWXXQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4PjffMjp19mod_1dIEVqRQbQtcOvCMUYHIl7XsVKu9w&oe=6AFB284A"}, {"file_name": "Preview 6 1(1).png", "id": "1957528558174098", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819323_1957528561507431_2007800542844273582_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eiahjQ3qHfgQ7kNvwE4CLZ4&_nc_oc=AdqvmeGmUrMMlHnH9z2ynaFkOaJte7J8LFGg48O32vDMzaiC68m1h0yNk7nxnbijVjY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUEmHj0A8mEsyf0W6IYVxQX6KJcp0fYun0oVptfPaUyw&oe=6AFB2B55"}, {"file_name": "image 2102.png", "id": "2975787845943288", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823271_2975787849276621_2905757349971132314_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCK1NBKVf40Q7kNvwEmasvu&_nc_oc=AdpehX5XfOV321qiktN_l3PzeqaggbfYkDbIg0dbkE_6MR8RfH3ipD6b5jrfl7u2S6o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlLwu6QVY2c09qZlBPiIJulmAXnbMiqMbTWoLYxU9V9w&oe=6AFB2F9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tactive Training", "keywords": [], "long_description": "Tactive, the future of training. Enter fully immersive, full-scale match environments where every decision counts. Train with dynamic, game-based scenarios from a first-person perspective to improve your football intelligence in the most realistic way possible.\n \nDesigned for ambitious players, analysts, and clubs, Tactive redefines how tactical awareness and decision-making are trained. Train repeatedly in custom high-intensity situations to improve your performance when it matters most. Through interactive training scenarios, you sharpen your scanning behaviour, accelerate decision-making, improve reaction speed, and strengthen tactical insight under pressure.\n \nMake better decisions, faster, when it matters most. Take your game to the next level with Tactive.", "short_description": "Tactive Training is a professional football training app in extended reality. Step into immersive, game-based scenarios to train your tactical awareness, decision-making, and reaction speed in a realistic and full scale environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tactivesport.com/docs/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tactive Sport", "support_website_url": null, "website_url": "https://www.tactivesport.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26105220645800787"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1558524545637739"}, {"status": "PUBLISHED", "id": "819075971225507"}]}, "baseline_offer": {"id": "1558524545637739"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785686160, "status": "PUBLISHED", "id": "1558524545637739"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "Andro
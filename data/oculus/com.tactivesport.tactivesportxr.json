U_Ss0Gc2smMyKAc8dGP53aR8aRLWxGzNU5d5He6pVJ4yid0rfhkSNIllczqw1TA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD03sQaBhlg6KaRu8L1P4-I_eyq6hNmh279r9yGDIwuyQ&oe=6A538495"}, {"file_name": "image 2102.png", "id": "2975787845943288", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823271_2975787849276621_2905757349971132314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLCCIr-cX6YQ7kNvwEdwHEY&_nc_oc=AdoifRA0AN7tzCB9WCdIzrcTX14zUhTQM66ciQi2hPR8qVhwUEwQYO4pOgxEhsiUg4Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_nYUtnf-qRQYR6p5kvTTQ9e9kARkCfJNubWgRib35jg&oe=6A5388DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tactive Training", "keywords": [], "long_description": "Tactive, the future of training. Enter fully immersive, full-scale match environments where every decision counts. Train with dynamic, game-based scenarios from a first-person perspective to improve your football intelligence in the most realistic way possible.\n \nDesigned for ambitious players, analysts, and clubs, Tactive redefines how tactical awareness and decision-making are trained. Train repeatedly in custom high-intensity situations to improve your performance when it matters most. Through interactive training scenarios, you sharpen your scanning behaviour, accelerate decision-making, improve reaction speed, and strengthen tactical insight under pressure.\n \nMake better decisions, faster, when it matters most. Take your game to the next level with Tactive.", "short_description": "Tactive Training is a professional football training app in extended reality. Step into immersive, game-based scenarios to train your tactical awareness, decision-making, and reaction speed in a realistic and full scale environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tactivesport.com/docs/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tactive Sport", "support_website_
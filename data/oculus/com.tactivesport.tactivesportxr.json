kNvwGNfuGj&_nc_oc=AdrVgkF66Bp_jtt70q_7NjuIHUEEfiU5xUzNoFQwBqvL6JhEIicY-ekkXflt2_lRu4E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1_oBOYQIdEZFTUUNxR9VnSuRDn3e2aCYjiodJbEGHi1g&oe=69F0A10A"}, {"file_name": "Preview 6 1(1).png", "id": "1957528558174098", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819323_1957528561507431_2007800542844273582_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yc6_PqwbxbcQ7kNvwF9ytJi&_nc_oc=Adqnr5U6idVHY1XDe95_-YLY9_zyyoQxH40B5HPzao8D2amlyMTT7N9IYZQoEGHGNlo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1mXl4_X50R8gJjj8ncHkLZ-YHTxnEFOkRTTT5wiYXUBA&oe=69F0A415"}, {"file_name": "image 2102.png", "id": "2975787845943288", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_2975787849276621_2905757349971132314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gz_wYvRXG8YQ7kNvwEhQFPO&_nc_oc=AdowBOQBm0WovlEZova1r5EmJxy2y6Po_tnciZ8N5SqXDkocOFKcsHPpMhrGBE6e6x8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3HS8DC-gvc9dU0Ibajf9Y8Xb6nFjGzmnzw4vbkZvbpdw&oe=69F0A85D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tactive Training", "keywords": [], "long_description": "Tactive, the future of training. Enter fully immersive, full-scale match environments where every decision counts. Train with dynamic, game-based scenarios from a first-person perspective to improve your football intelligence in the most realistic way possible.\n \nDesigned for ambitious players, analysts, and clubs, Tactive redefines how tactical awareness and decision-making are trained. Train repeatedly in custom high-intensity situations to improve your performance when it matters most. Through interactive training scenarios, you sharpen your scanning behaviour, accelerate decision-making, improve reaction speed, and strengthen tactical insight under pressure.\n \nMake better decisions, faster, when it matters most. Take your game to the next level with Tactive.", "short_description": "Tactive Training is a professional football training app in extended reality. Step into immersive, game-based scenarios to train your tactical awareness, decision-making, and reaction speed in a realistic and full scale environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tactivesport.com/docs/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tactive Sport", "support_website_url": null, "website_url": "https://www.tactivesport.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26105220645800787"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "819075971225507"}]}, "baseline_offer": {"id": "819075971225507"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774017660, "status": "PUBLISHED", "id": "819075971225507"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26332570643065785", "version": "3.8.6"}, "id": "1251462076517539", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26105220545800797", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26332570643065785"}, "release_status"
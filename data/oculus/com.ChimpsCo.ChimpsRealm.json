play, and a vibrant new world to explore. Grab your friends, jump in, and begin your journey through Chimps Realm.\n\nWe hope you have an amazing time and create unforgettable memories in Chimps Realm!\n", "short_description": "A Gorilla Tag fangame inspired by the classic 2022 fangame Monkeys Place. Explore, play, and have fun with friends in Chimps Realm!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1H7a_0x6DvaJ72nFEraimNKIu4nkyLI_yil6OHV6VXP8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zg & Gold", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1gD3S478jtzDMLC6ZY0fC__kNomiPnB6YsagoB4PgTy0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP", "MULTI_USER"], "id": "1584780769861833"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827567_1067297102922995_1534890600717207626_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlEYVxT8AOYQ7kNvwH2zQxJ&_nc_oc=AdoLFB_dJiHOOXoBXxTon9_aIXDZfwph8Wcw9pyL_rv5CYP7nXvxXBT8jTf95yvta3Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJXsOlZowrBUXpG0Lnb3AK4SCacEqHPw8JsYrkdWLB2A&oe=6AB27EC8"}, "is_concept":
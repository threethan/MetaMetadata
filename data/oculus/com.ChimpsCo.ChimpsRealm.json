2361", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491825345_1915081429095694_7810074431558221439_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBJippD69RUQ7kNvwH5UFaP&_nc_oc=AdoPacjvuHAcVGNxLVM-zIDDBCuKegW8soMMgdZLt8N4sZaz8mMymxDKj8-wRxNyIfw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1-7mA2240vGUc6qGerumTpr_7a18WqRUTVdukGBXArg&oe=6AA94FB9"}, {"file_name": "S3.png", "id": "1725602431821167", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491823930_1725602435154500_5401321107349239105_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vjpxsYAUDYQ7kNvwHFwRoX&_nc_oc=AdprJzsSwx7i8Gy0_b62mbnlym1CJx153sUQDPXyqGqLzg0j1lq26pybRe3omAaIaKA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqKoljMqJK-APaXts30LVi4EYtjo0BSEZNqbLvDchBPw&oe=6AA955CE"}, {"file_name": "S4.png", "id": "2518975628527865", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491823351_2518975635194531_4395252132840658977_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJzlpAgqVpsQ7kNvwH2i3oq&_nc_oc=AdqFIJrTCebj71-a0iC5Wpt8DmTVNQ1A_xnhBK655yHUHSqXrgz7UagigjLxguVdXAs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLn3PgA8y56OH1TwgZTFUMMP3MA3CUix-IRtlLU1eUQ8w&oe=6AA96AB1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimp's Realm", "keywords": ["chimps", "realm", "chimpsrealm", "zgmonk", "goldvr"], "long_description": "Welcome to Chimps Realm\u2014a brand-new Gorilla Tag fangame and a complete reimagining of our classic Chimps Kingdom, inspired by the beloved 2022 fangame Monkeys Place.\n\nStep into a world filled with adventure, exploration, and fun. Swing through unique environments, discover hidden secrets, try out exciting game modes, and meet players from all around. Whether you're climbing to the highest branches or relaxing with friends, there's always something new to experience.\n\nWe've rebuilt everything that made Chimps Kingdom special while adding fresh content, improved gameplay, and a vibrant new world to explore. Grab your friends, jump in, and begin your journey through Chimps Realm.\n\nWe hope you have an amazing time and create unforgettable memories in Chimps Realm!\n", "short_description": "A Gorilla Tag fangame inspired by the classic 2022 fangame Monkeys Place. Explore, play, and have fun with friends in Chimps Realm!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1H7a_0x6DvaJ72nFEraimNKIu4nkyLI_yil6OHV6VXP8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zg & Gold", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1gD3S478jtzDMLC6ZY0fC__kNomiPnB6YsagoB4PgTy0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP", "MULTI_USER"], "id": "1584780769861833"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491827567_1067297102922995_1534890600717207626_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEZaOoFeI2YQ7kNvwHlySPc&_nc_oc=AdrtaQ8yp0wpr8SYdU1vYCr1uZixh91-rcwkxCVKOIAVIvvLU3-8zQabgPYQgEndlI0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtFCQCQugq-B8WWZYi6fpTrDMkhBXqa2CiiAe3Leg_lw&oe=6AA94448"},
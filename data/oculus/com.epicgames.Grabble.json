GSgPul&_nc_oc=AdlhEpdOnC_V3LqNnTjVqWMhxbr66nIyixATK1_TDQPGzzTjM0PsB5Har43cC8R-aKU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afv_057f6P0nvzZTID_IdbjjiuwZdWTTN_00yAeGBWgRaA&oe=69985629"}, {"file_name": "Grabble_AlphaScreenshot_ 3.png", "id": "485746983397982", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75318184_485746986731315_7776935392689814472_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhhzm2qjRyAQ7kNvwH2Mz2f&_nc_oc=AdmzG4giHvafYj7okWn470wdtHNbgvlmPlILZxm6ttt7BqgQi6Fjdzi1T36a6ykLrCw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftZdPxlS-lcHTQFwhDHQ5OTgAZ4sVY7AM6fZaPiFtby9Q&oe=69986E85"}, {"file_name": "Grabble_AlphaScreenshot_ 1.png", "id": "1433343603810814", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195902_1433343607144147_5985429000769036706_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uoqo2hIRtOUQ7kNvwGkPjxH&_nc_oc=AdkFTmXt7FF9zV8SyJ3-05qCLZCcCpJAZ_ooPiVSu534mVK0IjJOK-2LQUSoVmu7h9U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afv6TEy2lkJXmerOlnnlCU7VZsnngNZ6xD52B_0ee-aGUw&oe=6998703C"}, {"file_name": "Grabble_AlphaScreenshot_ 2.png", "id": "383730323966774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974526_383730327300107_3310890588087906732_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3wrK-1msUoQ7kNvwHyaKb7&_nc_oc=Admqh40pdVbk8KLPNMdgjiOKnsyfqC9_Z9F8PxTvS0J6M3vPPkydxtumz_4ZNCmOXeI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuTPyhxtaRQSgOGbcKybDjB8wJQMPF6GgBvKa1-krcqeA&oe=69984ECE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Grabble_CoverArt_Landscape.png", "id": "334814025421608", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974472_334814028754941_3850824970804458703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ikGqg5MTtYQ7kNvwFayqrX&_nc_oc=AdmETl5pCS1Yi-jYWVrwVVGraR6OmoTklBy9fNYMTIxudGzIPmUdp_wW35PnUfyRVRM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afvqi7UU0ySD7KQdCdiSQII8BgQls8RTihK6ePi33kNKgw&oe=69986C53"}, "display_name": "Grabble", "keywords": [], "long_description": "Grapple and boost your way through a procedurally generated world. Swing from cube to cube to fly as far as you can. The cubes disappear as you go, so move quickly and don't forget to use you grip boosters!\n\nGrabble is a new arcade style VR game with a growing community and is available on AppLab while we test the core mechanics. Please join us on discord or twitter to share your experience. We are a team of two developing Grabble on nights and weekends and your feedback and support means the world to us!  \n\nGrabble On!", "short_description": "Grapple and boost your way through a procedurally generated world. Swing from cube to cube to fly as far as you can. The cubes disappear as you go, so move quickly and don't forget to use you grip boosters! \n\nWe are a team of two actively building Grabble on nights and weekends. Your feedback and support mean everything to us! If you would like to tell us what you think of grabble, please join our discord or hit us up on twitter. \n\nGrabble on!\n"}]}, "developer_name": "Async Studios", "developer_privacy_policy_url": "https://www.grabblevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Async Audio LLC", "support_website_url": "https://www.grabblevr.com/contact", "website_url": "https://www.grabblevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "
bble_AlphaScreenshot_ 4.png", "id": "1829336150731891", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75340712_1829336154065224_7512508550577896608_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MH5OEntp4FYQ7kNvwG89v2t&_nc_oc=AdoLqmUl1PPOWa5PBY9VBpp-M2HKirVywd0Ylj-rLV_X7chJNHY9sMuF--JMii5G5PY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mDjKJQbhN-59VXA1LcDfXisDMtS0cfXqYmnfue7fixw&oe=69E61EA9"}, {"file_name": "Grabble_AlphaScreenshot_ 3.png", "id": "485746983397982", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75318184_485746986731315_7776935392689814472_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lns5PccN5dsQ7kNvwF8zqPc&_nc_oc=AdpGqwSbAJERp5DJ_nP4iWqeuIiGFHyBZ9NmYhMq3WImNbdtHuYUChS1eqWjDSYm6ng&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MFIKwX2RbTH_Qi2MKNEaBPYXIs4hpQhXn55OI0JTWXA&oe=69E63705"}, {"file_name": "Grabble_AlphaScreenshot_ 1.png", "id": "1433343603810814", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75195902_1433343607144147_5985429000769036706_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Xx4HO19q9gQ7kNvwHlH0E2&_nc_oc=AdrNDnUits7p7S8mRNGikkxD6vb1VO6rpzEmjcSG94rhkv6CTzAqJiWK1IwG2G0olys&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18xu-Bv64kbId65DxyYxBYbQxqHjK2rNFMSVdxzGmOjQ&oe=69E638BC"}, {"file_name": "Grabble_AlphaScreenshot_ 2.png", "id": "383730323966774", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974526_383730327300107_3310890588087906732_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmzgflOTkfAQ7kNvwFncSzO&_nc_oc=AdoP7izfqQgeA84cLQKtjzx_awERTNSIY2QY5lhdPWIdiUqDb3tzwOmNhaMA7AYLc10&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OkXZdwfd7_S06wUeON81-0Uro9PhYZ9KXDuKvZ0USYA&oe=69E6174E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Grabble_CoverArt_Landscape.png", "id": "334814025421608", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974472_334814028754941_3850824970804458703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zMH_nKMlywQ7kNvwFE50_3&_nc_oc=Adon5SLAcEOhXW4Jrkk8q1ojW69MwIV41SMqv6lp0ccooBSVSCjxfvR9G6iUQChxHJY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HAWEtX3lfZ58KizWpsUrsnllXOoiAVSpXop2KL-mN7w&oe=69E634D3"}, "display_name": "Grabble", "keywords": [], "long_description": "Grapple and boost your way through a procedurally generated world. Swing from cube to cube to fly as far as you can. The cubes disappear as you go, so move quickly and don't forget to use you grip boosters!\n\nGrabble is a new arcade style VR game with a growing community and is available on AppLab while we test the core mechanics. Please join us on discord or twitter to share your experience. We are a team of two developing Grabble on nights and weekends and your feedback and support means the world to us!  \n\nGrabble On!", "short_description": "Grapple and boost your way through a procedurally generated world. Swing from cube to cube to fly as far as you can. The cubes disappear as you go, so move quickly and don't forget to use you grip boosters! \n\nWe are a team of two actively building Grabble on nights and weekends. Your feedback and support mean everything to us! If you would like to tell us what you think of grabble, please join our discord or hit us up on twitter. \n\nGrabble on!\n"}]}, "developer_name": "Async Studios", "developer_privacy_policy_url": "https://www.grabblevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Async Audio LLC", "support_website_url": "https://www.grabblevr.com/contact", "website_url": "https://www.grabblevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_co
e": "Grabble_AlphaScreenshot_ 4.png", "id": "1829336150731891", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75340712_1829336154065224_7512508550577896608_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mamziMggLGsQ7kNvwFgGp7b&_nc_oc=AdpkzY-BhszdFXRUrwb90yEsRcf5SiV9l_9GrgblhqK44bgpTfYNpT6xSuYGwtiD_m8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8q4VP9-UKThHE4DAqbujkigm2BwK1XUnRESbNkXkVmrA&oe=6A36C269"}, {"file_name": "Grabble_AlphaScreenshot_ 3.png", "id": "485746983397982", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75318184_485746986731315_7776935392689814472_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mFaU3JlE0EQ7kNvwEv3q8d&_nc_oc=AdrIBLy_W5ezPxEV3egUmCrDNAYjBUQc3QhWuNR7TvyzfcHEEdsetwAUVX-uZbwi6qE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94dDFT20pUHOcJggSjIR7GBIPaZR8OQuCA6de02XHrmg&oe=6A36A285"}, {"file_name": "Grabble_AlphaScreenshot_ 1.png", "id": "1433343603810814", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75195902_1433343607144147_5985429000769036706_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbEpkOY2_KUQ7kNvwHkCTeH&_nc_oc=AdqGyY6Tqtwc_0oSMl2pmvbuKg-K8jopQfuRucmXEHphDZ-k1nhpvigM8a_MNO2Z1e8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kDufqmxGd7npYo2RiNXYfpNcabl1FTZFvRxAwE2_kcw&oe=6A36A43C"}, {"file_name": "Grabble_AlphaScreenshot_ 2.png", "id": "383730323966774", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974526_383730327300107_3310890588087906732_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ijicu0b2mXoQ7kNvwHt05R9&_nc_oc=AdoW75_hh83HpcMnJ9plcXuvmfSafFYeom0y30i0x_BS4gWjGP_rw99ZV4mM8Ya65SU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af910wyo4WaDVF8eKo6Pgp3vxXm4SdCp6VhgO6vMQ8sOeQ&oe=6A36BB0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Grabble_CoverArt_Landscape.png", "id": "334814025421608", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974472_334814028754941_3850824970804458703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Di8vIlJr5xQQ7kNvwGdb4eI&_nc_oc=Adq91TD7VojE2zbYOnyxwcvicNFNxnZ8ntr2DveUKLDSb629GnnJVYyQdLUtZVzBxPc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ncINA4pMSnYl7HZuRXHJFszbyPZK5e4UHPtEU1T3yBA&oe=6A36A053"}, "display_name": "Grabble", "keywords": [], "long_description": "Grapple and boost your way through a procedurally generated world. Swing from cube to cube to fly as far as you can. The cubes disappear as you go, so move quickly and don't forget to use you grip boosters!\n\nGrabble is a new arcade style VR game with a growing community and is available on AppLab while we test the core mechanics. Please join us on discord or twitter to share your experience. We are a team of two developing Grabble on nights and weekends and your feedback and support means the world to us!  \n\nGrabble On!", "short_description": "Grapple and boost your way through a procedurally generated world. Swing from cube to cube to fly as far as you can. The cubes disappear as you go, so move quickly and don't forget to use you grip boosters! \n\nWe are a team of two actively building Grabble on nights and weekends. Your feedback and support mean everything to us! If you would like to tell us what you think of grabble, please join our discord or hit us up on twitter. \n\nGrabble on!\n"}]}, "developer_name": "Async Studios", "developer_privacy_policy_url": "https://www.grabblevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Async Audio LLC", "support_website_url": "https://www.grabblevr.com/contact", "website_url": "https://www.grabblevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null
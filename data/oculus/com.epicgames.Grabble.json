ElnCZ3&_nc_oc=Adm9yjpa93EANkfLlY_RoSBtypUV-7KCrtYN1k3KkK9VyZ8Qem42onNviMbAKrkbIuw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftISCLDzPXNANatBT4iHfKJ30lGyEjpzmcgSBf4LZvIsQ&oe=699AF929"}, {"file_name": "Grabble_AlphaScreenshot_ 3.png", "id": "485746983397982", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75318184_485746986731315_7776935392689814472_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPhHlhUzHGIQ7kNvwEKJcw9&_nc_oc=AdlwRE-wq0KmdevpRDS2G1ebHtpNapNWVs10z-qc4PTePAUuor8S3xLcQFCtiXtZN1U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuZM9py6kwDUGK1Ufbex-vL-UPKxofQwRlquuhamaUPxQ&oe=699B1185"}, {"file_name": "Grabble_AlphaScreenshot_ 1.png", "id": "1433343603810814", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75195902_1433343607144147_5985429000769036706_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uoqo2hIRtOUQ7kNvwFX8UGK&_nc_oc=Adn9YIWAZZiA_i8WA0hP2XPWxNZ4M47004WhnD8ivLqateWnbcRx336n5tERQDJEZRo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsGNdnnjSEXiLBstCmvOjc6FXSNjgZ2wjlWXCQfJiuM4A&oe=699B133C"}, {"file_name": "Grabble_AlphaScreenshot_ 2.png", "id": "383730323966774", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974526_383730327300107_3310890588087906732_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgnQJJBfbYIQ7kNvwEL6Tc5&_nc_oc=AdlXgwMopYdLH39FOYoKxEzoE6NmvYba7HcEA5fu2nDtIs27mFyp4265VQ0IgyyhPPE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu7xZ_GsVH63HDaSP-iWoUp7BCcSm05TPw-wis5GNCOJg&oe=699AF1CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Grabble_CoverArt_Landscape.png", "id": "334814025421608", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974472_334814028754941_3850824970804458703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34uVFavq1mEQ7kNvwFPqQg1&_nc_oc=AdnUKpUl216izJ8FMf2CCz3NB2lG8ChWSuOys8EuNuSp3ixBh2DAF4VJJdrLxS9UOqU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftlFQhKq-VKrib9rVWnP-hVjyKkHYhCRGi3WTmoK9ubMg&oe=699B0F53"}, "display_name": "Grabble", "keywords": [], "long_description": "Grapple and boost your way through a procedurally generated world. Swing from cube to cube to fly as far as you can. The cubes disappear as you go, so move quickly and don't forget to use you grip boosters!\n\nGrabble is a new arcade style VR game with a growing community and is available on AppLab while we test the core mechanics. Please join us on discord or twitter to share your experience. We are a team of two developing Grabble on nights and weekends and your feedback and support means the world to us!  \n\nGrabble On!", "short_description": "Grapple and boost your way through a procedurally generated world. Swing from cube to cube to fly as far as you can. The cubes disappear as you go, so move quickly and don't forget to use you grip boosters! \n\nWe are a team of two actively building Grabble on nights and weekends. Your feedback and support mean everything to us! If you would like to tell us what you think of grabble, please join our discord or hit us up on twitter. \n\nGrabble on!\n"}]}, "developer_name": "Async Studios", "developer_privacy_policy_url": "https://www.grabblevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Async Audio LLC", "support_website_url": "https://www.grabblevr.com/contact", "website_url": "https://www.grabblevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "
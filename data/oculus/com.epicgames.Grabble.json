GqXAoG&_nc_oc=AdlDZnPca51MDJT6lDHk0mXE4_iv01a_7YkCS0_v-rYr4bebjAyyloSpu23R3c628sw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvm0JGd_2rvlt00cj58QvVZxSamJUm-CJXUoIMJm9Bcpg&oe=6999A7A9"}, {"file_name": "Grabble_AlphaScreenshot_ 3.png", "id": "485746983397982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75318184_485746986731315_7776935392689814472_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPhHlhUzHGIQ7kNvwFHEIIb&_nc_oc=Adlw0K4GRZEuu9CCclrr5wSW8dq4u8VrgIArx_bmtUcEoAXe-WyeYA9H-A6dRyK_RzU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvo9neGNnAtsiqQq05huIVG-OPXTQcZWR8uOpaRMdEoUg&oe=6999C005"}, {"file_name": "Grabble_AlphaScreenshot_ 1.png", "id": "1433343603810814", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195902_1433343607144147_5985429000769036706_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uoqo2hIRtOUQ7kNvwEm-A8m&_nc_oc=Adlkfdz8RHzew7qhU98wn3zvWIm26zIiR6xPWm3MQLErvlQ26kSHc3OAL7dhZNS84Vw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsd45Mek6kvZ7tC63uzdaQJ7jO0IpztLP6mzpSvPLDlLQ&oe=6999C1BC"}, {"file_name": "Grabble_AlphaScreenshot_ 2.png", "id": "383730323966774", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_383730327300107_3310890588087906732_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgnQJJBfbYIQ7kNvwGLIcBN&_nc_oc=Adm3VDzIbMusXOGVbyPC5O_egWU2FNAPZPcDniq7rpQOkOEFvUMdf0tcwIHEs-PqXf4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu-FF3fBQDtjXyPk7N2clAuFrdwH0Arsk91SKhhNdTCiQ&oe=6999A04E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Grabble_CoverArt_Landscape.png", "id": "334814025421608", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974472_334814028754941_3850824970804458703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ikGqg5MTtYQ7kNvwFkCI5a&_nc_oc=AdmGH2uJKxbQB15APIiHot6NNdgYZ-2JkjVelqlzqw1rDAZ3HkoxhTjTK1DncSZFfLQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuYmdPecWSXAVuNzdfkNiovAogvhcgt40-h4D5-V9G_Fw&oe=6999BDD3"}, "display_name": "Grabble", "keywords": [], "long_description": "Grapple and boost your way through a procedurally generated world. Swing from cube to cube to fly as far as you can. The cubes disappear as you go, so move quickly and don't forget to use you grip boosters!\n\nGrabble is a new arcade style VR game with a growing community and is available on AppLab while we test the core mechanics. Please join us on discord or twitter to share your experience. We are a team of two developing Grabble on nights and weekends and your feedback and support means the world to us!  \n\nGrabble On!", "short_description": "Grapple and boost your way through a procedurally generated world. Swing from cube to cube to fly as far as you can. The cubes disappear as you go, so move quickly and don't forget to use you grip boosters! \n\nWe are a team of two actively building Grabble on nights and weekends. Your feedback and support mean everything to us! If you would like to tell us what you think of grabble, please join our discord or hit us up on twitter. \n\nGrabble on!\n"}]}, "developer_name": "Async Studios", "developer_privacy_policy_url": "https://www.grabblevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Async Audio LLC", "support_website_url": "https://www.grabblevr.com/contact", "website_url": "https://www.grabblevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "
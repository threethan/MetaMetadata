HHOsWE&_nc_oc=Adnfg2u9C0yysigyji0XZ3hQ9-CIhjaUTVnCIAiBIF_qSfmcCAU01G3xeI-mE8MW6kw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afuq_dRX063xOTIV1RPOrH1AiRw4E6BQkQdM3P0vQR93NQ&oe=699C4AA9"}, {"file_name": "Grabble_AlphaScreenshot_ 3.png", "id": "485746983397982", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75318184_485746986731315_7776935392689814472_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPhHlhUzHGIQ7kNvwHJO3PM&_nc_oc=Adls8ybTuBhzYM0qX7o87DTkwH6uWltKWFtkFwihjyV6Fld7gh8cdt2EJVpQZbVgzYk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftHrvVsXnxcgMAQ8m3CRiBWhU8ytcxV9AU8Im62G8NIYg&oe=699C6305"}, {"file_name": "Grabble_AlphaScreenshot_ 1.png", "id": "1433343603810814", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75195902_1433343607144147_5985429000769036706_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SomjH1cJsUcQ7kNvwGn_JET&_nc_oc=AdlWHiZPB0x429JPVIX_88b0Qs9j4g-DILk0v_fOFdF8xdbqX6kwG9SwVBJFiAiaIhE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv6_-gfKQoc4tz7lZ33rQhPtcjX4C1p79GjV4SqcywoNg&oe=699C64BC"}, {"file_name": "Grabble_AlphaScreenshot_ 2.png", "id": "383730323966774", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974526_383730327300107_3310890588087906732_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgnQJJBfbYIQ7kNvwGwyWz0&_nc_oc=AdmtSjI0VcmBnxX7hrBOJgjfsO559F69AabDaBj0LJcpSH8HUbUqVsK5-dLG9T5t-6Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuJ53xPfrXM7JMdaCg0GwfFMqB1ZcCQ7YZZiZm4a2PrYA&oe=699C434E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Grabble_CoverArt_Landscape.png", "id": "334814025421608", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974472_334814028754941_3850824970804458703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34uVFavq1mEQ7kNvwHE7PIr&_nc_oc=Adn6MbJVZl9orWy6mVJwJWpdgCtCN6tX0-CvcpuoXymG6T7FIHKKQDk5qsaPn8T2c7E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsM6HB13vJ-gQHJ4zKO3zX05JgaWUFflEZ5GPlsh6DwwQ&oe=699C60D3"}, "display_name": "Grabble", "keywords": [], "long_description": "Grapple and boost your way through a procedurally generated world. Swing from cube to cube to fly as far as you can. The cubes disappear as you go, so move quickly and don't forget to use you grip boosters!\n\nGrabble is a new arcade style VR game with a growing community and is available on AppLab while we test the core mechanics. Please join us on discord or twitter to share your experience. We are a team of two developing Grabble on nights and weekends and your feedback and support means the world to us!  \n\nGrabble On!", "short_description": "Grapple and boost your way through a procedurally generated world. Swing from cube to cube to fly as far as you can. The cubes disappear as you go, so move quickly and don't forget to use you grip boosters! \n\nWe are a team of two actively building Grabble on nights and weekends. Your feedback and support mean everything to us! If you would like to tell us what you think of grabble, please join our discord or hit us up on twitter. \n\nGrabble on!\n"}]}, "developer_name": "Async Studios", "developer_privacy_policy_url": "https://www.grabblevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Async Audio LLC", "support_website_url": "https://www.grabblevr.com/contact", "website_url": "https://www.grabblevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "
bble_AlphaScreenshot_ 4.png", "id": "1829336150731891", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75340712_1829336154065224_7512508550577896608_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-1lY4YvnwEQ7kNvwH37XZf&_nc_oc=AdqyfFnl6kmUxHbRg-ZPxtYQ-Xf9z3_fBeMv99avfUmQeqZujvzWRrNzTzJsn70I1LI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-v5ihJy4kQjcE581NM-Yw-3rtRA7ihEbAmL4so97-BFg&oe=6A314429"}, {"file_name": "Grabble_AlphaScreenshot_ 3.png", "id": "485746983397982", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75318184_485746986731315_7776935392689814472_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSkx4J15VK8Q7kNvwHyZycd&_nc_oc=Ado6BUCyXI9Tw011UWiWJ_iQsnzWt-vNmrdKN4XTpcQ2Woq58HtYbdt0skDkbmUk67Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Q_JV7jBTXOZMbgfn_n3f5c5yv00O3KDBULsk1EIGblw&oe=6A315C85"}, {"file_name": "Grabble_AlphaScreenshot_ 1.png", "id": "1433343603810814", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195902_1433343607144147_5985429000769036706_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEM35JVPJLcQ7kNvwGDhuLe&_nc_oc=AdrGnaRfz5prIHET4rqU4Y7rl4cizCIGoZnh4EP5p2sOwCLtPz7u6g7KbPrZ7Dckmeo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GbSZKdxPwrvIrZ1uEkRurmMUy80E0XqPtwfuTctmZuw&oe=6A315E3C"}, {"file_name": "Grabble_AlphaScreenshot_ 2.png", "id": "383730323966774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974526_383730327300107_3310890588087906732_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQ13YK13AGAQ7kNvwFXCW5J&_nc_oc=AdoQnoNKhbDY-CWHrHS8HLBhCpDMSRNIP_eFbp2kl3fbEf6Kjr6JbZ3Qeb3WYDEQr7Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ER2w-T41ll3Tdyg5Gi2V0xeSWyLNv0dhJplswYWUsdg&oe=6A31750E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Grabble_CoverArt_Landscape.png", "id": "334814025421608", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974472_334814028754941_3850824970804458703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2TYRL-FOg8Q7kNvwFj0YSl&_nc_oc=AdqOltayeoPvPuGIVrDPKYWvBBq8bvFUt1JSWQTxV37fwE5KttZJJW10inj3AZ3bmvc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CpR-av30fl4ejTZN7P7V5p6BIN29hqTSUYgUGAyBgzQ&oe=6A315A53"}, "display_name": "Grabble", "keywords": [], "long_description": "Grapple and boost your way through a procedurally generated world. Swing from cube to cube to fly as far as you can. The cubes disappear as you go, so move quickly and don't forget to use you grip boosters!\n\nGrabble is a new arcade style VR game with a growing community and is available on AppLab while we test the core mechanics. Please join us on discord or twitter to share your experience. We are a team of two developing Grabble on nights and weekends and your feedback and support means the world to us!  \n\nGrabble On!", "short_description": "Grapple and boost your way through a procedurally generated world. Swing from cube to cube to fly as far as you can. The cubes disappear as you go, so move quickly and don't forget to use you grip boosters! \n\nWe are a team of two actively building Grabble on nights and weekends. Your feedback and support mean everything to us! If you would like to tell us what you think of grabble, please join our discord or hit us up on twitter. \n\nGrabble on!\n"}]}, "developer_name": "Async Studios", "developer_privacy_policy_url": "https://www.grabblevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Async Audio LLC", "support_website_url": "https://www.grabblevr.com/contact", "website_url": "https://www.grabblevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_co
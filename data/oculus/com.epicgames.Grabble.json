e": "Grabble_AlphaScreenshot_ 4.png", "id": "1829336150731891", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75340712_1829336154065224_7512508550577896608_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZBeQNT0icYQ7kNvwFxZkJ3&_nc_oc=AdqhJFVOXQc-0BYHfs9_B8NlCtszylqRUvEZxLZIYVuR19tySCY91D0LnF2FFe7jPvM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGr60djkoGnGayNGevHanSL6CP6nhnF9KnwgdLSc5Erdg&oe=6A7DBB29"}, {"file_name": "Grabble_AlphaScreenshot_ 3.png", "id": "485746983397982", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75318184_485746986731315_7776935392689814472_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VuNxzEWDSo8Q7kNvwH3DIth&_nc_oc=Adq1ME3q6Tk82D037b9bmfhwf7jrHBZlLiwN9lHN7lf4eAY_hG0CE9rn4IKnby7lz3o&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoquYaPkoodvYLL-fos4OLhPgJcWO1YpYcuDn6KDg2ow&oe=6A7D9B45"}, {"file_name": "Grabble_AlphaScreenshot_ 1.png", "id": "1433343603810814", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75195902_1433343607144147_5985429000769036706_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgkLNZNZo7sQ7kNvwENwU8T&_nc_oc=AdqaCeoyPcx1Rp5UHhMpiey5Qf9tTQuoE50eQI35mYFpNI3o5HnRu8U5R_a2Oz7UKyo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTIe6ycW2NHtSUOiV_Hdg2I2rlwIKjXcJ2WaNxFRcWeA&oe=6A7D9CFC"}, {"file_name": "Grabble_AlphaScreenshot_ 2.png", "id": "383730323966774", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974526_383730327300107_3310890588087906732_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwfoXn82fVEQ7kNvwE2zK-o&_nc_oc=AdqguKeRbUdyl_dO7P2B2VLjQJPPE5T9QApTBH2T832PhPdeV_cm2J0OChudctovZRk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpsnIT2WhqD5zub9JCqNcos-O5gtFpFySWI33i2UnIPw&oe=6A7DB3CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Grabble_CoverArt_Landscape.png", "id": "334814025421608", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974472_334814028754941_3850824970804458703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_RmUw78poiIQ7kNvwE8WNOX&_nc_oc=AdrGoYlpxqDfGn_fruNPIoKm3D30ATIouQfkickoys8LwmYs9T2RY3-YFuenYHw55Dc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQmoTK09K_sv1DeoybL9W256547VInAQkUQSOBH-qtFg&oe=6A7D9913"}, "display_name": "Grabble", "keywords": [], "long_description": "Grapple and boost your way through a procedurally generated world. Swing from cube to cube to fly as far as you can. The cubes disappear as you go, so move quickly and don't forget to use you grip boosters!\n\nGrabble is a new arcade style VR game with a growing community and is available on AppLab while we test the core mechanics. Please join us on discord or twitter to share your experience. We are a team of two developing Grabble on nights and weekends and your feedback and support means the world to us!  \n\nGrabble On!", "short_description": "Grapple and boost your way through a procedurally generated world. Swing from cube to cube to fly as far as you can. The cubes disappear as you go, so move quickly and don't forget to use you grip boosters! \n\nWe are a team of two actively building Grabble on nights and weekends. Your feedback and support mean everything to us! If you would like to tell us what you think of grabble, please join our discord or hit us up on twitter. \n\nGrabble on!\n"}]}, "developer_name": "Async Studios", "developer_privacy_policy_url": "https://www.grabblevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Async Audio LLC", "support_website_url": "https://www.grabblevr.com/contact", "website_url": "https://www.grabblevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null
e": "Grabble_AlphaScreenshot_ 4.png", "id": "1829336150731891", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75340712_1829336154065224_7512508550577896608_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pP-p-Mlzp7IQ7kNvwGuNE9s&_nc_oc=Adr0W27v8Qoqa2zy9oB1NHTKRH5ygqy1WIASl8MJZs3qszXWMtUl0A1D8hHz92UZJDs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pba_5I363IE1dNXzEQGBdU5kc9gxHkkGIm3FHQB-DEA&oe=6A465C29"}, {"file_name": "Grabble_AlphaScreenshot_ 3.png", "id": "485746983397982", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75318184_485746986731315_7776935392689814472_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgXO0_2WdYQQ7kNvwGYQyti&_nc_oc=AdqFylDLsg31VTP8VIGG5BVVSnNgtoMmOPvAxdy6ftvOWL5jxOSHJsq4hsN8K4kaWH8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ds9ScOErqDAR9zMyZbGFJl78_xCzSt_msAMGaz_4_cQ&oe=6A467485"}, {"file_name": "Grabble_AlphaScreenshot_ 1.png", "id": "1433343603810814", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75195902_1433343607144147_5985429000769036706_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9n1xe4iwckQ7kNvwFVZxBc&_nc_oc=Adpu7d5z3I2AJOu8z946UFKJ3Im7uTDa7GslC94cL698uH32uGaaIQ1m5cAmxabhRD4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bH8l7sQLD4c9A7xZmrg0ftAjsxBuHeMCokP81id9Fkw&oe=6A46763C"}, {"file_name": "Grabble_AlphaScreenshot_ 2.png", "id": "383730323966774", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974526_383730327300107_3310890588087906732_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ejtcqfI4zQQ7kNvwFs7LsT&_nc_oc=AdpAaz7PrWRhQBChgu6bfRliXR27ysO3qiUcY2cOzE6c-57fMNN70cl6FvKepkYJnuE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8P65YPoWjsCYRPQrzNKpZ8ta0ujVqHV-ux96LmpVgDbQ&oe=6A468D0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Grabble_CoverArt_Landscape.png", "id": "334814025421608", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974472_334814028754941_3850824970804458703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_jp2ZcQ3OUQ7kNvwGuNwgN&_nc_oc=AdoqO0W1HyA63oYZZi8kMnIYmJYjh5Gd11OSr4f73e9hPZGlSr90lsYhwg0o-r4-e0s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zZMvVThqFqcmVcv5YnFTNelxRktMirSe4A12GHW2yQQ&oe=6A467253"}, "display_name": "Grabble", "keywords": [], "long_description": "Grapple and boost your way through a procedurally generated world. Swing from cube to cube to fly as far as you can. The cubes disappear as you go, so move quickly and don't forget to use you grip boosters!\n\nGrabble is a new arcade style VR game with a growing community and is available on AppLab while we test the core mechanics. Please join us on discord or twitter to share your experience. We are a team of two developing Grabble on nights and weekends and your feedback and support means the world to us!  \n\nGrabble On!", "short_description": "Grapple and boost your way through a procedurally generated world. Swing from cube to cube to fly as far as you can. The cubes disappear as you go, so move quickly and don't forget to use you grip boosters! \n\nWe are a team of two actively building Grabble on nights and weekends. Your feedback and support mean everything to us! If you would like to tell us what you think of grabble, please join our discord or hit us up on twitter. \n\nGrabble on!\n"}]}, "developer_name": "Async Studios", "developer_privacy_policy_url": "https://www.grabblevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Async Audio LLC", "support_website_url": "https://www.grabblevr.com/contact", "website_url": "https://www.grabblevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null
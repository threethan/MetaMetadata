bble_AlphaScreenshot_ 4.png", "id": "1829336150731891", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75340712_1829336154065224_7512508550577896608_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xbbLPlt_acQ7kNvwFvyieo&_nc_oc=AdrnziqBCFgIyxvXnsK6O6wjJRZ6wqCiejF2zH2lufnJcm4zKJNBj39ZyOq_nlLIbZ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZhUwbRiW-XubhwDIOMCEq1_5QZX6F_XTjPOlCQT43rA&oe=6A5239A9"}, {"file_name": "Grabble_AlphaScreenshot_ 3.png", "id": "485746983397982", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75318184_485746986731315_7776935392689814472_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ug9tp4mfD00Q7kNvwGOrIuS&_nc_oc=AdrA32gZWd5sDzs32vfeYtB7VFkGHSbuSdJT-Z54vCfXf6Xr-UXA-kRGBYfTQwQaWEU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZkr0Pc5GzqQznDhmtL9tm5zy8oyBMKFTvTnrwuhWbLQ&oe=6A525205"}, {"file_name": "Grabble_AlphaScreenshot_ 1.png", "id": "1433343603810814", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75195902_1433343607144147_5985429000769036706_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6jSiuMDQ1sQ7kNvwHB9OBM&_nc_oc=AdqEN228RS9lsP9h6qQFP1FMoTcNItGCedH_ujBJsaBSHYt2Q7sG4OcFDdb_kKfzlFY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbkUM7zcKYbXZTVsl4T3pUH430Qp43azKqggJPXZrP6Q&oe=6A5253BC"}, {"file_name": "Grabble_AlphaScreenshot_ 2.png", "id": "383730323966774", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974526_383730327300107_3310890588087906732_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7hojQynTkwQ7kNvwGR3q1Z&_nc_oc=AdpuCoNSMsR2Jump5Vm8Cgz_-lP5Qd9sToFxVDEra0OyxkM5ts105ygBirzpyGhNt_c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDda4HTz_STTvXo8F5vuyCGvO8g4fo_2Z7jntVx3DzFWg&oe=6A52324E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Grabble_CoverArt_Landscape.png", "id": "334814025421608", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974472_334814028754941_3850824970804458703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkJa6T-HviwQ7kNvwEZK0yi&_nc_oc=AdoASd8idHuVYY7hlbQcA9aAqtV4zgIAuRiu6Npqf_kIL1Z9jyKmRQemIQSnDjbktoU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMj9dIAGwYiprRsiHcOqGZMQxyVD37LD662Uf78XFHrA&oe=6A524FD3"}, "display_name": "Grabble", "keywords": [], "long_description": "Grapple and boost your way through a procedurally generated world. Swing from cube to cube to fly as far as you can. The cubes disappear as you go, so move quickly and don't forget to use you grip boosters!\n\nGrabble is a new arcade style VR game with a growing community and is available on AppLab while we test the core mechanics. Please join us on discord or twitter to share your experience. We are a team of two developing Grabble on nights and weekends and your feedback and support means the world to us!  \n\nGrabble On!", "short_description": "Grapple and boost your way through a procedurally generated world. Swing from cube to cube to fly as far as you can. The cubes disappear as you go, so move quickly and don't forget to use you grip boosters! \n\nWe are a team of two actively building Grabble on nights and weekends. Your feedback and support mean everything to us! If you would like to tell us what you think of grabble, please join our discord or hit us up on twitter. \n\nGrabble on!\n"}]}, "developer_name": "Async Studios", "developer_privacy_policy_url": "https://www.grabblevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Async Audio LLC", "support_website_url": "https://www.grabblevr.com/contact", "website_url": "https://www.grabblevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_co
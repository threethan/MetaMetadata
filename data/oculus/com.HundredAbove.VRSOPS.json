creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUJh2fOg5VcQ7kNvwHhrB85&_nc_oc=AdrXXcyuX0NtMaS0ZkuiDTaJSmsdwr-vdP0Hd9cSYOQmY6I4Q2UmyUMS9na5pI_Y_jQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB56ggvCFD4PYVoiIOPNr1JfLZi_0kW4F_VFr3dzVJsbQ&oe=6A60B86D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOsiRC8rgboQ7kNvwHrRCb-&_nc_oc=Adp44Ndxga32zVW_JXMSwom4AcZv98SEpX_2-7mGkCY7IP4k4dOd6YNwr28ggcnfx4Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0XZlrQVHdIpcwMwOU2vetvvVITCMQzPMnnmKF-ZwKrw&oe=6A60C809"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDK0-Yjx_g0Q7kNvwGJB35s&_nc_oc=AdqvHfkcE5cP0lo18Q-A8_ot1uGyUq5wCAfSbXLu-c4ZrkIvVMAU4EplA5cFdNZMNSA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpEtT55K_L3YKvpguE_MPEPRoC-asvt4GK2pp3zNFU3A&oe=6A60D66C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfjRcQrURpkQ7kNvwG-c6UC&_nc_oc=AdrHU89iiOrqzpLxbGPsMJKmlmDs8MKsnnWU7AjQEj2fAswUDC2Oyty1DVxYCZ5SCxs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVU4D60xl5OgVDh202L8t_23aC2xxDipThb3rELFp40w&oe=6A60D6CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5N4F1FlAbkQ7kNvwHjLW-2&_nc_oc=Adq4qfXfI8mZ6KW1k2GGfhf0I76hrlO22UXl4AW3PFZsWWPEZB2-AK0u4y4JmNBzA24&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjxl0zVlGWAHEzeVFiNvOO-liEy7bfjR4-wXc_7URoEQ&oe=6A60AC01"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
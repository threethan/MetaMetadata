creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7HbNArnop0Q7kNvwECH4rQ&_nc_oc=Ado9qp82PvMtvYif-q9wuBbkhswens2WFmMWSSFezQAOuWVJnkNsqKpvfXWI5R2c8Ds&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECrEv1mMvjYMUp66vktu9IXXr-mN4xqUxpHL04QTAHiQ&oe=6A7C67ED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iM4mZ7e8drYQ7kNvwF1mZ-_&_nc_oc=AdppmffnDkS0cpIeWPnpFX6y0uCjoPYLRoO46F7I2AVGeGdWzJC4C5xyMc5MI97VGmc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHS370sIJMB_mLrz79D7c3fSGpXKcVsAaANUqL5S_LOUw&oe=6A7C7789"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xDqhHvTMhUQ7kNvwElGreA&_nc_oc=AdroOK_MSOhXZQHYBmc79NW2F6zu33ClIV5-ZS4h8N3XoL9TOWyeJx13TX9YiTctlMI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGH7i05RmVZvSKnPkMH7rUemfcu7wrC1-KRnfe6MTbKJQ&oe=6A7C4DAC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxshEVhZbJYQ7kNvwFRez4R&_nc_oc=Adqsgh4pRDbEACW_E6BYQXyWEmHk3AasKrfTVIjSc8zx2_NxFetaYwhZGPkMuTqbhwQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzmvIXv5ApLlQWy8fLbK8sZSpaC7_1ietJHNmCA5G79g&oe=6A7C4E0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oj7kqYqRUgIQ7kNvwFPQk6I&_nc_oc=AdotNJMR6_FQJepa4J_r16STyQfUP_-vrC7eu54sGVaHFaMfNEZuqz0o1r7kfPOnatg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMlT9z5aigAWoTj9OxmWgz1MhtLOSl17PtvPUOYg2u7w&oe=6A7C5B81"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
49837938", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNgMLiNGGJUQ7kNvwGHJR81&_nc_oc=AdrdLwvNUgmX0vc3fWVKucbAZh4cbLdAHJzCpPMCq3tvr557YyhUGn9rQ4Rux5VRaRY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyvtwvCVcv_NV-9TNJh7XUHMa2ackhA5f9VMSQ7t06Jug&oe=69C132ED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHIODv5kQ8sQ7kNvwGb38ZQ&_nc_oc=Adr0OtBLjZRf5D5oEwVuhVh1V2b8-uSlOgosZ9oZsc9ssGBYRm3zjOJ6lV12URdnyIY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwPnym3WKItLlW9Wrox1cv8DC2A4QRk8EkkH5BB0ZxxwA&oe=69C14289"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GapbfQbLwBkQ7kNvwHFj81k&_nc_oc=Adp92TD5o4OQfKzoF7zYmg5RbUsqg4KiLPVmVFQaA2OirytFixB6bVhGmDYMi7QQ7O4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxnO3-Mwelu0uDsSi4DeMExjxH7s6hktkzNiQItUR_ZiQ&oe=69C150EC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpb7I149ncIQ7kNvwEJoIZQ&_nc_oc=Adpp5xRA_LF9dm0d97gFFcV9sKr2SY9DghH_C-_dPstEZbn8vNt5mjnHH0uLQQCWQuM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyEiiegEQWsxrMD_I2dM0WDXPu6dSE6Oc0pRBvl2XIo4A&oe=69C1514D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Tf_dlAK5HYQ7kNvwFV2Dut&_nc_oc=Adog7x2XJpnm3I1p4ngf1gtB7DwnJiuHELzvs4xiQFxZO0-ZpxrxKAHiLMC7hNIm7qo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyh3hcF0haEal13vojYQzN4KbItzGaYll5qhW73b2ic8A&oe=69C12681"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
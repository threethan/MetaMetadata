creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3waVMJnxaZIQ7kNvwFVsSk4&_nc_oc=AdpdjhzjCx1wZ-O0zXLygurYTpphBKnvO14ycmXdlL4omMWdrEBwaEiyJLzV7TZb7Bw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxKOaL6ZbfEpudvoCcvgK_DuiiHYKOMex679b7TF06Pg&oe=6ABBAFED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMiTJrzAyL4Q7kNvwHrlxYB&_nc_oc=AdrTtKygiCnC4crOZ8OMG3-6-biQrJcCAtyeQOIIF279O_bXJTzbjDBPZyNLPuTSgMY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKR8W4l15O9C49KGITmDppMvmdFZoYQ7Aa2TTEwrT2YAw&oe=6ABBBF89"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oN1dYp-GK8Q7kNvwFggwX4&_nc_oc=AdpZRgM14OutiLpoz1EV4w1m7aJE6X2DkzShUCsmGs9YwFL7CJZZuuhoHlmiwYklAlM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdUhpxwHPfhiIvROMN8Bb05943yR_K-Q-37fnj3RYh6g&oe=6ABBCDEC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsjExlou4Y4Q7kNvwFwh_pp&_nc_oc=Adr_o24xpgCjfNB3F3QTkcuif7PSwLD4TLi6JeR3Lg5QB8aqF0LYxrvC7AH_hcA0VoI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsksgY_FFTqALnjnfrnrqxtCQ8J0e78TNl8yGcSrMWUQ&oe=6ABBCE4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=It-ZdXIyHJEQ7kNvwHKFrUU&_nc_oc=Adp9OCi7LPwLkb-q547CCiZZ15HGrTwoTkM-hd3wWCUexC2aIKOkSyPooPTPxtMyiBM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrJjXudG9n-9Bn0cEiK-CHbuHY6W0nmYycmM5MXXXRzQ&oe=6ABBDBC1"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
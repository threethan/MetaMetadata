creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvSbazBjXGoQ7kNvwE9sJ-H&_nc_oc=AdrHR9dA-VlnXSlJXPSLkIObfmxMEV5S66vHfgMhaull2cumTQBdd1pd3GiUUj9dnAo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYXM0XN29t0v4Ir1MGFCIv5isbeubEPogHZM-nRCNybg&oe=6A5237ED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-zzNTvp2zkQ7kNvwF87Lza&_nc_oc=AdqynEqh-JjI7t1aBCtkLDHPvB-qTGtXW7amZMULQvVo5RvpX1XqBvMEjrO7DkLTw-U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOBP-BSRmeb0sszRkJVo8H0-e2UkHbwLwish5P-XrLtw&oe=6A524789"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmbQfpV9pGsQ7kNvwFTj0oj&_nc_oc=AdpdA7wEdo_dWZoIN0I-qpNufT_slFxTpkYRsil6kUkwq3Ho7R3AuiTn6KCXVdmc55M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNX0ZQO1x9MITKzuo41VqfjHvXDJd_8upvTPe4w7b_JA&oe=6A5255EC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvNhuR9rrfwQ7kNvwFdKcjh&_nc_oc=AdpI0y9oSuNmKLbC55un6KfCE34s2u_uvK333ybCvs1DaQd0KA1bKyWcyXAk58eMhV0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSrjieFETHAEG9WFqUbTfeHYFGEZyj7NxhEr5DQtkrdQ&oe=6A52564D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hPj7MWWw7sQ7kNvwHBA3FD&_nc_oc=Adojd-p98sEtWMG4SeHr_HGLpuXve4O-Jh_og2-RPbJavEXiN_59PbWlNf-KneZGIGw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAobVtXdkoGBMx-_4xna9DuOeYAcXecjMSAWSciuk8bVg&oe=6A5263C1"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
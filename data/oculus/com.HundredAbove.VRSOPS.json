creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2aTKvktddoQ7kNvwEGOpGH&_nc_oc=AdpHJ5yZn5DXzbiGh5Rc2v_xuDLLoBWxfBG_bOANeTPduaGRVHCec-J2NVElT0SSC58&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaIGunttVeJGMD0ILtj-cWlkvIttS0f4ieWJn408Xkqw&oe=6A9AF2AD"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdzKFOVI_owQ7kNvwEZig1C&_nc_oc=AdqBVTNgIkWNdxwMMNFzstTk5yQo6eEAdvBt0etyrSJdI80SAs5r5GkAdYBfUbvDsKc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI25fZhiQ_ekl1BBki-GFyftMVXrnYdt8wQIAUgvbQoRA&oe=6A9ACA09"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcRgdGjp0RcQ7kNvwGBAVc-&_nc_oc=AdpvvjKMliZDanmsttE4rkloG9JQV3LKtt7tfo1ZX1aAC0YZv_HsDnM57qIkRhYxSD4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhe7dYU_vHaPobqqrNKsrFy3iRf3H64XFj_fUWzs_bnA&oe=6A9AD86C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQNm4WDYzSUQ7kNvwEd46yo&_nc_oc=AdqopWcfK9CCqGJ9C3nn-tsh8uXGMG3LDQa_xS4eaSqXAV6sNUzSRz3W8VRUGOmh8BE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZ941flp6PgLF6P5ERYM65Pt0OnKsGRz3HluFWch9grQ&oe=6A9AD8CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1u47BEdQfMQ7kNvwH9UsNP&_nc_oc=AdrySim4NBbn5LIz99HxKPedv9K4KAKR9zjmGwLK-td_1CCkULzZxCSouuNjfn1IPyQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8wPgJ04fBLPEvDXo0y4Ck12LIQeHhX-VqQp6_zf87EA&oe=6A9AE641"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
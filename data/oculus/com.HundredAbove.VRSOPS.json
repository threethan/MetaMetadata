49837938", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQrzrFJ03NYQ7kNvwFkssyr&_nc_oc=AdlUYo5uIPUM6y_4peEWapIa0pLdSJZVSIpk_4h0tkNH9_FSZLih8cCjPZJCRYES1QQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfslYig5Mt1TE4bQ3OI2cPO8XOxSbJhTr5Lwi5a2LphB_w&oe=69A977ED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCxseW2N3RAQ7kNvwFO2zt8&_nc_oc=Admetlnr9WocRBev6X2MKKDaCBDKIeTSkbM6wdhqEaZPRa1ISKiFmkJVrQuzXuJJXnE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftjofV45LEcUYeOv1twfl-SP9b224ObaBKKbWaZmnPsYw&oe=69A98789"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mm4w57mYih0Q7kNvwGF8Vl-&_nc_oc=AdmEBS44J7LKA9D2gCrSvcx7_V7qu3Bf8xtFwbQwlRDlkUb15rPlDE03hc93NwqhDkk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsJSRVdfvQ24DfTLl20D-G3Xdkdd3dmRuty-t8dU8znZQ&oe=69A995EC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umsPMQLlWFAQ7kNvwEVIobN&_nc_oc=AdlKm9U7w-BsoVZRdXiH5LlJmUI1ionZq6mCbPzUS_1QjJyKm0kwNaRYvvDTggwroMA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv8tdMy8pq5hjfsRGjQ_LPeMKHqPMNkqrHpT8fQMTY2UQ&oe=69A9964D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3x5n5XrYgHIQ7kNvwH_hU0Y&_nc_oc=AdmF2L_2f54D8zcASQr9AnuRYKbIAXSM1U1xgTfWwkhwsHvpIIyQrN3gcvyzGBuWRGA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfslmXHzvN3IiYZiR9iO2BsVHlpwdmzooxZAa_zjZU2ASw&oe=69A96B81"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
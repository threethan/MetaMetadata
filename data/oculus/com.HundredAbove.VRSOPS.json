creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNbAA4ObAyAQ7kNvwEuxvrR&_nc_oc=AdrkqiUtftkQujlo6cMUbgYOOGdEtS-1xTcMCVbWZ9yw6wN4PT-D1I7-TN-3f55aCBQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQII1vXihb0oaij7JTH8L1JL0QzZofV1DNzhAMY5rghLGw&oe=6AA151ED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2shLQXI2LYQ7kNvwEZIOg6&_nc_oc=AdoLr-nqKvfJiTzS-GvZjk64qNw9es2VYO0GLOvKbIZQMztEDQBuR8cDqGTSBw7r87w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK35-NzXWO5S5gOPkqv6_grMxLZrtCIl8-KrQzmVsdUhQ&oe=6AA16189"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQLU71okdX4Q7kNvwFqTEnw&_nc_oc=AdrY6QlZRDRnC5RO_EIb5O8bhSBOAvZa5ZJ7ar1SSPdx20KpDkravM1CbN6g1C-27oI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJOJz_9YkL3dc5_AOo_TRRQcyGa8k7RAHRttQ2gPKrtg&oe=6AA16FEC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgilduseVjEQ7kNvwHzGRjU&_nc_oc=AdpCUWdQTT9ZyAhT7mT6ZIEj9knobHV2PpNKtfYinN1LA1N41Tbw1JFHBbv-8mKuQmU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBAVGax2ijUSz97kKfgOHPvr0o0kfEAOqgPxF5mbgjRQ&oe=6AA1704D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYVSl4BR0ZsQ7kNvwF9wXB0&_nc_oc=AdqSxOI5gK4cwnhMJB8aT3K3nunYU9ftfxF2EwPCP9GORIrxBkzsv9xEM110-JBWgzw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJgWDYuFoXfxlVJjysMGY3DBAWlHdhatPA_cSX7MUE6g&oe=6AA17DC1"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
49837938", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNgMLiNGGJUQ7kNvwGr779K&_nc_oc=AdkZ1JGfxF-x3sZ9uuX6zRwMhsUDgUL3kjJtq7OUiFcLaP4vzine0KAQqCF9btBPrD8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy28qow6kyFmFzD7RJFJyyxHyVRhF4PBUyx04Rsnu7RFw&oe=69BE8FED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHIODv5kQ8sQ7kNvwFTpjsc&_nc_oc=AdkLgG3aFS_Z44Lc0O87JJBWbYW7E-uqSz74h9Gsywt97wuTaQe0y569SyqAqDkI2xM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1B6m65ivWn7HIu9kX2m3fbtt5jQdF3-C1_qR3eB4weg&oe=69BE9F89"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GapbfQbLwBkQ7kNvwHrblUG&_nc_oc=AdnvX6kSfQOI9g6TY4mgeSUBV_nwSpg5zi4eo-LxT8JNArZB8tOGGHO0Q6WIGUKTIyE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx6akfI8Al1NQ1t3c0KeiTmpPRyipG-EfXL-X2hepXmsA&oe=69BE75AC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpb7I149ncIQ7kNvwFAxFPF&_nc_oc=AdnTQ0Wl0qlnOj2HdbThGn0vp2XInPxfAIQPI1wSufbz6wiKCGMSYQRlES2Ixgpygd4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOjWKXYU4AJtZ0yipr8pnk8liZ3Uz-pCWpwd1AHF1Huw&oe=69BE760D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Tf_dlAK5HYQ7kNvwGcPU8r&_nc_oc=Adlt2EZCMPzcjyksW1fxRb1YGdWvjMc-0_pJ_zNZEpodc_U7p7Ty1zkNtJoCZLPfY-s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyAZOaDnBk2-AqvjapzHMGq2sSQxK3jzjr3zop6c4i1wg&oe=69BE8381"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
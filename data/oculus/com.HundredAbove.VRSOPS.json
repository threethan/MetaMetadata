creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPogiKIw1doQ7kNvwFdm5QU&_nc_oc=AdqUALaYMOd77JK9f6t7pTxCQVKDYveCISNoICpXbCL9CqEGYiYfGEYeW6hPcBdyA38&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77NcgotjX161tKmKa2_ACyN1YPb6T9LRLMLvxbukHIiQ&oe=69FF296D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lI2NoPpQwpAQ7kNvwHULUUn&_nc_oc=Adqxx5FoAe1noNhUsOcwEYiliCfB5e3PQMYnWpJtbVMtqfqcGpHHNrfs0xj40jZPVgE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42tc76meNZiEJChBq1dYmfzPSoOF1TpcW91iiqVh-R8w&oe=69FF3909"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aum9KwHdQKAQ7kNvwG2iW_1&_nc_oc=AdoMJgizNryd7-D2HkgBvE5yM4l5PirT8GP4eY22MPV2grNaO5yw-JJt29oVRHMutVg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Konva_wcWIf3s2vrIhm5-4JgJmQNIcQwr4JNTfPhHhQ&oe=69FF476C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRnIVmkgyYcQ7kNvwFZ7YYj&_nc_oc=Adqt90O6PsVuGIpTPHrLnlObfYO4-n4pusqwDLHko_6wGbUCGhAHWJ79552CLgSeGWE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jpoMelS9PS9ha62pNPXM0p9I916A0Wid4wXoLH7VmeA&oe=69FF47CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWxrNwRRUqoQ7kNvwEElx9s&_nc_oc=Adpr5rQhqv1zOA17le1c5gyrtzD2q2E5N5tkNwvNLcydCWfIK9_I6BRYxpDYPEtTnhk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7A-3S2gxxz595uFUMQNEkJJ10uvP57zMUacbfTjHPzmA&oe=69FF5541"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
AppLab Screenshot 2.png", "id": "284119949837938", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZaJqUjxzPsQ7kNvwGBzgqH&_nc_oc=Adow-6NMgp06dTKKMwcZC4-fEQlw3MMkHydvuhoOMF4zwCarMlhEGjQmNQPQy1fjxGY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SbXnmb96rLwN3smY9hasKoVw52yR4Pk9rdaZooAj_cQ&oe=6A392B6D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QrRhhLc_Vx4Q7kNvwHOjaQv&_nc_oc=Adpo42441MJGcdjVYuEqb0bgrPcG-6z_QQzXuXnKMo5WdaxB2_EKMsxsl5baTcFwwFA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8otzNrqCG0Rb-8TRsPLoAPlb96mfkJK8iBvlFLZ__kCg&oe=6A393B09"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9dT3o8ZS6oQ7kNvwFaziNV&_nc_oc=Adph6fc3sdqAqaZ66km0P3eH2VXi23w759Rn14Kt_yf-u-1RVbBo893NCi73Ol5f-rc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WMmpOUC9brV67skgujGx7deVF5KWpB640_z_c24rScw&oe=6A39496C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8oRaNUWn00Q7kNvwEgUJ6A&_nc_oc=Adr9OKK0QiqnGpLsBtltp15nOsWvp-wSvS1Yn71dxCZ4wmNh50RNWDInMjfneZMGwwE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FOA_dTq1z1z2JptpTbnh82FzTLyuXZIwop0w7HAlVuA&oe=6A3949CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxDyPmWHyrAQ7kNvwHjhQT4&_nc_oc=AdrTqKzbnqaeRN73SEYj-MN_o_p6jePyZ8ng6MJHlbFP7w82vP8zLSzYAyqMQzlGvMc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6A97dUgmjS-XtiTeZhLwZKafyE4Ei1jyX9kUp9BQbQw&oe=6A395741"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pl
creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_YD3B4NQIMQ7kNvwEAD28E&_nc_oc=AdoOQh-FO1UmxyCDRTp3Z90zupwHemgcnyp03-YNJ1pwLeaNQnRDC3l9GBMmjL53mw0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4FSfraOnix4V-pFqvyRSGaKYdm1NAMJoQnYw9xw5qyA&oe=6A88456D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFt25Wo34MUQ7kNvwF_63o0&_nc_oc=AdpSF3xXyeWdiAYjCteTD0JRtCWEsTVfh_rTW-VGn9Dd4aeHf25S6aFPOCxR74PTzxM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfngez4GyWqIsWacvhaLQCtGQJtKNY1GAmbPoFXnCdXg&oe=6A881CC9"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPEjHgxgnmEQ7kNvwEjeCEb&_nc_oc=AdpwY9j-93sh9WLoC8eFvuXdQSwsi7ogvJSKZjr22cM5Al9HzdidgFZJXZs_-tOyeO0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1Dv6q1v8QVnclTLI2D3d558J0MBJNtzMDdieqWYrexA&oe=6A882B2C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rzvj_nwJkXkQ7kNvwEIFJG8&_nc_oc=AdpEGsw-r1JlVbld-y1LhiV2pMGb-3r3mXX0h_7DmOoGsf-02Zqlf1vICuLBfYEhsPE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFa_NG882J8ckXS83wGJ59DWvYAdXsM9YxHDHLiuCht7g&oe=6A882B8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AyHGej-c_8gQ7kNvwE759A6&_nc_oc=AdpNTanm5XqgtFSNPKy_TJIAehgOs0VW7Y-wzSKi0JEm-t_ZWDT3TshsDehEnkXOXXk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVg8IZWgYeSsXzyiRQYByD0dG3JsOXt-K9EdxvSH814w&oe=6A883901"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
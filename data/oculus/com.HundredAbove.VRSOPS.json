creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYLk4LrCSAwQ7kNvwFQUb-E&_nc_oc=AdoAhTaSih7_Eg31rmVnLGwU7KLR27N6II6LiQn7ilFHxlXrTOMXcGwKf7GmbxsfkfI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0bgrPRbtavIzLrj7ZGxq5_2ivOEwCteOnAfjHdCpVEA&oe=6AEA0CAD"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3fYDetpKS0Q7kNvwGLY7Ym&_nc_oc=AdrMXPBVpCn9XakGsYDahl_v6jh-XPxefTpbY8VPvdw_hRXhga6vHbKOzdNy4dBtvlc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzDjxEXegc0kYmiCrs69O8fx8Z0JyMGYGY3IKdBfp4mA&oe=6AE9E409"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvkgbZfp83AQ7kNvwG3yZXf&_nc_oc=AdpX3zgeWkdXXHhMP2EjQ-z2MS3bM7fYnqD0VVsL3dVBfuww9tcu1tzmIpoDY-GuNgE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEEchg_jCmhdUDMoSIKVWkyS8MpkKeIVChjksOSWcPOg&oe=6AE9F26C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOtUQ-1uJEMQ7kNvwGhcXP6&_nc_oc=Adp7uL6DzffZVsqmdZpb1iL0fnIEkWKuBjEbd-mtMdbNENFHY5pp0xVCFrFrxfavl8A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRw3cLEY9V2p5pVwbgQFRAizjc8Y1EFd5iIbGEmP_QUyA&oe=6AE9F2CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y00Jec15l5QQ7kNvwGypSN4&_nc_oc=AdqJKPFyNV_HxZXWbZeKayIvYXshRCzxeTMofZOY1Wkeqs8Uh981I0tO_WT81K4w7Uc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1PDP8kpd6J92Nru441PFm7MUzyqxx9TgmBr4GY_wTfA&oe=6AEA0041"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
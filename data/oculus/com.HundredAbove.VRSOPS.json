8", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qa1cCGFTmKMQ7kNvwGsBTLH&_nc_oc=AdoHpZ6SX1DtlXjgJVTFsJdrvF3We4pPiSbZ7c7Aadpko7HAcDMUR5OldHtobZz93YA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ocpnxlzX18chdq4KaQCPyCNAcrtfAjRo1GDQjLsvekw&oe=69F1FA6D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFGXRvv99IoQ7kNvwGEtrLO&_nc_oc=AdqVdfHfXUImKfUt4qm2QNkFKkvYRPPoo6REAGiYSMqJRRciXPa7MdU2tg0x8nEU7to&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1i_an2bSMtGSnjW9hM1NOPHD3_E3IAJmjs658P-rfblQ&oe=69F20A09"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bjs3eGSxI8Q7kNvwFYTohn&_nc_oc=Adoq56f7wIPZGuSYAuzN3WgZiMUzc1a2wL2z8om2mj0P8bgmQkzg4iLneJanMESSAdk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1nZMmFDnKM3lZ9s31dMvOZJaaGKmCUYpXJXQdKf10D6w&oe=69F2186C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZcMqPtlK0EQ7kNvwFzuyOT&_nc_oc=AdqgVSXDdDHavENeCIJQIY-KS_4cUVggCq5jnKHX5eeMfpaGBF5ha3n2TLEN_driTAg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af29Hlaa1C2BgSWtRmeA1CVpfOpjr0r2XTvtBl893iGQhw&oe=69F218CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkv7g47pmTgQ7kNvwEdso9i&_nc_oc=Adqb0Nh8yGOtPrZcE1PuMn2iVRfm7RErlgQl0_LZYpoNe4HUt4ahMD90IIT0xDFdK-c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1p9GScCb-zO61uBHOiHM2caIKP1WcMUJLgRgntTtdB-A&oe=69F1EE01"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
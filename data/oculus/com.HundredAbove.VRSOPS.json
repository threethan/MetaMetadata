creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2aTKvktddoQ7kNvwGb2xtO&_nc_oc=AdodYsJpqSrBrOG4teSbeXGhMHS9HBNAfxzbk82ILiFRG6BM0HQVdGGzhcXZI7BNckc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWUHZh7dqUDLf9UC2aC99wDgwEcW-jclw3sk2jyIkWCg&oe=6A99A12D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgytvnagrNEQ7kNvwFClezS&_nc_oc=AdqbtuiO-5ekE2vvekT01LcjB5LEt7bG7e7vjF9S-qFoC42VTWBvEvegU9MlEkYZp8k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTdKGeIdenOQ8bSPD9JY9fatvhebY--eNw50T_SZAO3A&oe=6A997889"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcRgdGjp0RcQ7kNvwGNLJsl&_nc_oc=AdpDwv093jrHzH_4AaVDc3HgGTJFTtchAW8bgL9h1zpkgsJDlCQor5J9XjNcy1g7pzk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7hogDG00LcB93mcGxyJKrpgLFNSZ2aAVGL4SFWeYl6g&oe=6A9986EC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQNm4WDYzSUQ7kNvwEP9fga&_nc_oc=Adr_Y-uvo2CcPR3Tziln6ph1RSNtuUGfhoFl50OLPpePIMMAFsGiQwGRAw2kvQ-DsjY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKj4GF0aBSt_zmy1CjBryfBK_XqDgpc17bxZy7ZgTzXoQ&oe=6A99874D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1u47BEdQfMQ7kNvwF5O_vP&_nc_oc=AdrTYgsToH0xeNtZ-jrbfTi2yvyQQSaBV73SgVHgQyyPuEv7KlOwxVg2S7Xtr3O2K8w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4-QAYiMsOpFI7PaHkVnFs0ydoiR9ulAOr7o5h9e2qsg&oe=6A9994C1"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
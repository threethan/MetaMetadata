creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SSxXIleIGi4Q7kNvwGm4eoy&_nc_oc=Adq_ouOMNQD-LnzVIs7mCtP6V72bG79eK2gWTgRUhqnIOBwfIJhLNRofM0JHv-MkiOc&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lm6LFAHCS2TBOTodugbBPM6GQVClz5JOiX5UAlZINBg&oe=6A1C2A6D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Ghiqj1IGEAQ7kNvwELQJPj&_nc_oc=Adp-ZcoOG5OlrRU5Ll3jQIk7R7B4Eo5iU5N0Mb7GZlLQsmgVIZ50GbswNwFIzK4fk8s&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6B6up7yGjNhoLkPYmvgvFgw94o2alljroOb0iAZqvr7A&oe=6A1C3A09"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2v0zMKDXSQQ7kNvwHSzbCv&_nc_oc=AdoCb3ZNxSpQKjts7KHHlaePiSGuA8MWC3jC5_Hxh2vhyazIIPfoZCcknSTD7fY4Olg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Wq4PxRDF2CdEFqVlEnzTjq3LY3EC1OpG4NxOlmGQleg&oe=6A1C486C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBO23y_2OAsQ7kNvwFPVKJA&_nc_oc=Adrl7Tha1Wk94MHuDvU0OGIltzl4JJTD0GK-DXy3szWg-zPoql5UfiQv__bp7eyzxmU&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_g9uhhR7w6saJFNfqcyjVUWD_xoizvn3Bagkpxny60Q&oe=6A1C48CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-CXdtkPzS8Q7kNvwEa7UH5&_nc_oc=AdoJJafCczSCayBUvrC5MRdZwIs8x_15Bp4xR5kAqkbuID1J3q_vJU0hOnYIXoszkQA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kr6_RJRX8C9OpNiX7z-4cPB0D57P8qMpBi_aNWmZY4Q&oe=6A1C5641"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
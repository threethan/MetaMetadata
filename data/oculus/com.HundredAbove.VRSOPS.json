49837938", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQrzrFJ03NYQ7kNvwEax_YK&_nc_oc=AdmLdfieH22C7NohwbbEEJZCfF6RoO4UQOD5JCpck6J4FJ1dga4hQul2akuX1G7znus&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afsr8wh-vgKFnxNIJ4dzRJkjodoulFIgNpYb8qUi50r_Kg&oe=69A8266D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCxseW2N3RAQ7kNvwGss7Mq&_nc_oc=AdmFMOyvAPQXzqQrWyxmBMVfk3AmCbRgLhTAdqTufZL4x6KrqO2TfS0Ho1l0fmX2NT0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvOktpdmdj2NMm5ojaWhr3GQBNUh7zo4xWhxJLdO5QI5g&oe=69A83609"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mm4w57mYih0Q7kNvwHFZVHD&_nc_oc=AdmFjhRtyMAqCaZt3KTIX3HSmtIWjEnc_26XnucJeJw_ihd7Fk86t-sZxtQ8iXqCO14&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afujmc77Hpr2DU9ye8j8INRAvXXvRZCO8kcCHs-hCwY0hw&oe=69A80C2C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umsPMQLlWFAQ7kNvwE2r_q3&_nc_oc=AdkKeNN5As5Cou1mnpNS98gU43DTWdbVqWpi14KNLVAgvfzOeobkG4vdjFpU-VEkdFI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsbeyxRe2Y8olAnnersy5O9ze5nvY-Y8XV1uSkypFEzog&oe=69A80C8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3x5n5XrYgHIQ7kNvwEfOePh&_nc_oc=Admyuqrf_hM2alHna2w1v2mToIFsBTU_PwGBRRIScYm-FC2l7c5Pb6J-WDReCNJT6d0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfunuQ-3sZ_hmqmndBRVd1bCvnenJjJCIuC21zs8D1Aa4A&oe=69A81A01"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
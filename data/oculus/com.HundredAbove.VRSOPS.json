creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGqaNnGMcqEQ7kNvwEugxgF&_nc_oc=AdqjrtyKHYg6VwYTxAMvWEDdM-0PyBjkl3rzUX4FtdY4nYRCD4pZ6S4TRZeyM16RzmA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhDuD4EQwC2bXVLM8i_SDLqAAMu_nG9jgji1WZrIW3Cw&oe=6AD3A32D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lS1Y5MiVq2gQ7kNvwEhTA8b&_nc_oc=Adqm5iskcAkb0uLONwL8_bbKdETZ8C0Y-0auAwtmKRvJF7xr1E47H-oN1nQ4Bp6epzs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKbyfk4XcnIhDlguIiSFNLhK4mEL1QZvXy-c6gYJ8DxA&oe=6AD3B2C9"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NRFOvTwqwWkQ7kNvwGxR7gh&_nc_oc=Adqc0K1UfysAjdGsDYa-C436MjtxlPt89BivTeMQiCqoDcD1URbnWCULS3HGnhFUFvg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNS088KBHmFo_7icJQkY0g-9GuNi_o7gbRQSeWp1C5s5Q&oe=6AD388EC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUUrqpBojAQQ7kNvwFK630e&_nc_oc=AdpoKaFGldlP7c_zYsEC-Khak051_uepV-zz_YIzs3mC46SlX5Di6VFZJhZ22WjJGjI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_B0HC-PDT9vOLDuqJvQpwVO3h-O2pcKn_cq_7n1W7gg&oe=6AD3894D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SdGIX-LmrdcQ7kNvwHx638j&_nc_oc=AdqKYsHkHGKDNlIeH-SJb6N-sWxewQTEZkagve8Yl2ix7e0MPPry0dRUB7TvWcrRpMU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVBN2JGOLbJudBaRs6eoMXfMPF4s8zPd07y5D-ke220g&oe=6AD396C1"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
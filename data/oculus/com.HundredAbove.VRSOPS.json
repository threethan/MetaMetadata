creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xe821KDXMl0Q7kNvwETDkRC&_nc_oc=AdpdA0uTtT_TkjSwlbeGQ5mq67o3Fg-Hv-NrCWRgA_Z_8Sh7IMnIfZlfSFQPWo9CPuU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gblIeasdkR-do2A2egMczw5a2OGtUE9KBNR9Rhw25OQ&oe=6A26B66D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OapEs04o2lgQ7kNvwFY119r&_nc_oc=AdoX1j8ua-dQWPjo2-IHO0ihjecQdTdJE0GxC9hZWsx4jEVM95H_zu0s6MF4WgVPs54&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82pIR8cfF5lr8fQ2gvQTPwnlrmrbHLSsZISe0aNFXTFQ&oe=6A26C609"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82dW-8dQvYAQ7kNvwF2tS_q&_nc_oc=AdrQRE795eVy0zEd5XgmHX4lSu432_Q5-Dj0OzmQqTVcTlQ60RcDCkHX-bb3WMWSmZk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XCozHCPNoSJu26bLpDfCh_8ogvLgz--Uh9qkoKUpq_g&oe=6A26D46C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-94srdBaeoQ7kNvwHWGdfJ&_nc_oc=AdptoK9VbYRB_fHhzv-i0aITyxcgdTW6mBzNDZwK5ARrtEu49Ymqq2JGpjhIr5bndzc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IkMpGgJxiV6ukupVgnJgws8ZhRRzcHpksW8eKbNS9ZA&oe=6A26D4CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeieLENnO9YQ7kNvwFquWEy&_nc_oc=AdpPlu6IXGjNjoGZbEq8YiYdpeMDScpbwBwwJWgT0YNS6JzZGsWtpzR1whDrP_yG03c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QjSF8l9defew1mTREzMX9RxAM2Je6-GQgvtSTkAyVTg&oe=6A26E241"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZaJqUjxzPsQ7kNvwEe9y22&_nc_oc=Ado6MbyirtevJ9vSzOYhBpLbQw185wIP9PKnN8wUkA-M-VNxPbhjyWVMAtRHxOZ_kzg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-1Dj0s-To6SH5YNDl-R_RJt_EMTRF6bw5WLMx8nMBtg&oe=6A3BCE6D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3cTe1VrCvQQ7kNvwFLMD9u&_nc_oc=Adq-z_cgx8xRhMRBq9swmGyDsruDcLSPnM6Q43jGxq4RaXlIvLUlicIEk2DQwTUvJgs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XfpuIwx0lI5nhHqzaX6hXxcDqW9-QTPK9FYFlUxjDZA&oe=6A3BDE09"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9dT3o8ZS6oQ7kNvwGDlYRK&_nc_oc=AdpseuiqOqj13GbnDMVr3LZf73MjRz3_dg50rKRImhFaUVdz-B2vJJA69eAqT8UgZT4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WOLQmEoQub7z3i7W_lI9jhEjHQz7kmM-Y5_1Q-B_SUQ&oe=6A3BEC6C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8oRaNUWn00Q7kNvwFyt-Em&_nc_oc=AdqV1Sa1VVgcneOZ41Ll5nkWPqNH63-oqmLrstzf_zeXGp1zheM-wV2vf_3z4JMyT0Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ClKCrYhXNmbfyIKEqXpBi7f8yIggjhACGAhJIHyYXcA&oe=6A3BECCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxDyPmWHyrAQ7kNvwFkLF1k&_nc_oc=AdpEnKqq57IL4Nh5em9_CihtcELsvDogRofSxH54U_5pJGIvuCr7QxitAst-xgtfZG4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89nLfc-5tk_IJ-SUhSRp1k15ysAQQEIt4BmNXazW-sDA&oe=6A3BFA41"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nr_RAEVWt_0Q7kNvwF1jAgk&_nc_oc=Adr9qloJxZnNWrm8qH92CDUifYjj2Yl-_PJ1JwjTloRWVW7S1-QlR13HeOXkphCHQyo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF16Ody2VsGFPQKZ-e5_5TDh93u1sDnTkCqMul7nGQsZA&oe=6A86F3ED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OptZWmiVjcQ7kNvwFJ2br7&_nc_oc=AdreGOSbmcFyGLSzrcWtpoTGZH6S1XMgSdGLD70rKfPH29HaecJiqeaE9oGeW71g3Bw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECKwgwNO-vMJJWC0k3lTpV9A8ld9aQVkhKRQ3CfT-ZpA&oe=6A870389"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pyg-tOQeh-wQ7kNvwGaDlFu&_nc_oc=AdqZIVaQgbqOul79d05-egl8l6uPFNRJPeJj_KsNeb5S5yDIXWVq8wfza_nh8PvFHi8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmmJCXOTditu6jyITxBu_CnMx4NFY5MB_-_0_kqtz6_g&oe=6A86D9AC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qULLaDnu4UQ7kNvwGuu7h9&_nc_oc=AdoeytcFDkzvqS0_LcU89peWp9P_olPX_U7ZiQ1eC4ldJ8SRxFHbo0kKp9Hb7MNcZec&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtOB8wiLS8aO4JHIzzxKYKLYcXHSyspP_XaSn1qiASOQ&oe=6A86DA0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iv5mlbYO2EkQ7kNvwGgblyb&_nc_oc=Adr7JfbF-QP4ptr0VTAM-QeWHAFbaKWJP2US5eUCIwN5BEQCEUI2htnIs0pVOGqmM38&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDyqwsLTWQgY3pp_QA1FfAqdApBBtMv4a1r65hY-EJMQ&oe=6A86E781"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qa1cCGFTmKMQ7kNvwF0NPxu&_nc_oc=AdqkFnn9HOZ4NUEioh4b7UxFU2j_C16Jf053Fk8uGJ6CvNbYejzzUTyLQAM_O78TQCI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3pokHYHlK9m4wlysrpVdSIeUo4uFFVz4a4uiHHuO6Jiw&oe=69F49D6D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFGXRvv99IoQ7kNvwHoRuH2&_nc_oc=AdrGNv6U52G6aMv-55kbXPUzOiShwFcNGlDpb8212r1ncZifbB8r1KisG9RGnMPY2uM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2iE3_ld3IwAp2a-a-_pbx_Y7IXUdLYCmwD7f177Q8S6g&oe=69F4AD09"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bjs3eGSxI8Q7kNvwE3iaTm&_nc_oc=Adoolg_CBm0dRYnRNMt_oD_r46BYVdUxWD3BXzJEgEMKiT0UVZHxZSZzxoISNgbuckw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1a33J3k37Tidn0p0Ys8K54EvMNsB__cwKI3v11rQEBbg&oe=69F4BB6C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZcMqPtlK0EQ7kNvwEL3mY3&_nc_oc=AdpuNElbv3WleWMfckSzBElQvbLixjYqjGXWu_IPb17wg6lJfFJmjC-MFCjYpMJ67_c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3vyI5WDewyUEb4W6gWMljmVPrxoMV50-i5v75aUwm-6w&oe=69F4BBCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkv7g47pmTgQ7kNvwF3C4l3&_nc_oc=AdqF_ZbatMFGuro-0vfsgts5gYbFY4IUwPDsnapMmUchYe3RNVBPCRECn_-kJofJ69Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2A3l1q51EGbBJ1QB-Qt_D_xDvSXMZZ8UWV4d4aHKG5AA&oe=69F4C941"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
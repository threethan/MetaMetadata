creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5tKnDixZWQQ7kNvwGaED6b&_nc_oc=AdqEQxFvbuOw2eR9Q2apceWk6Rexzrhc7hJx7Wh7iRGcawclW-xgk8r7qsWc4lLwXMg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyleKUk9-pJtwIrRuQZFP9eaK6zREwqTwO2_Logo19bFg&oe=69C7CA6D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbkZr05FW5wQ7kNvwGwbCSQ&_nc_oc=AdoUvvSk5O5MCwbz0q_F1FKNx3YKAqsHjfH_tBrxd_2zsLCfLc_yC0X2VHwBZPmsMeI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxND6eoZEqXNVMx5iexfMQyO8pDpkLfV3kTgAOTG8tXKw&oe=69C7DA09"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KF4n1gi4a5AQ7kNvwGz26Iz&_nc_oc=AdqZXrxbT8sjFZOyNcvKBifmQr-DOqTb8ur5R-Pzks5d6y-4Vb7TI-Gctvd3tOPYCs4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy09R5idDN8i4TsnfzcGAIuiPFS3oU6LpvuOAgNzU2Jkg&oe=69C7E86C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQYQWkNiGXIQ7kNvwEZxKnF&_nc_oc=AdqRLkP6hoQwtAvYhEUYw0g4LBwu3IIvG-vuHl2LgMluCkBh42Tenk1LzwBhgiPCxFU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbZBoSnT0VYdC5gZGQAilzxV5Xt9DRKgEuXf0ZPFcBMg&oe=69C7B08D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVTy4neC_e4Q7kNvwGDVQn3&_nc_oc=Adoapz789fby--yLXMdipd7CC7xhR_HH6Z9ZEG2ThWb9cBE6q61u0jNSnHjuhcJF2uM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPhDCOytpjq-yiy1yTlmYsm0SYBWAEURWaE5Dv4LDXzg&oe=69C7BE01"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
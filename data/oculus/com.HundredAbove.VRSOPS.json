AppLab Screenshot 2.png", "id": "284119949837938", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g056zdmYZxgQ7kNvwEBRn3s&_nc_oc=AdrtSziPi93MqaMVZR0X9f1cstkdcp5qx1pnQgRTJFD1R-AAIru83QCjps5Ihoq65tg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NC1KKPFAGmIJ8jVD0jAqHVKgT74ifwBXzWAWMcSBsTQ&oe=6A22FA2D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEnK4K_H2GoQ7kNvwEdbxAy&_nc_oc=AdrydI_5-r3BNLwrVmctHMdj9jG5o2uP7_X7kbokD6KOtXa0tQ_xTpoQbWugrelocvE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yPokUvPoyrIWtJQwuJ8UHEkO4hBgtfsOR2rS89L4OZA&oe=6A22D189"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHJoY8Sy2RwQ7kNvwEIFO8j&_nc_oc=AdqkE9_agELQwHEA-Asfz6LjCQ4ZpGNB_a-oPabB8nbEupU8b378Mn1P1ZikFeOW0Yw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ueuT-6dLe2lxGKA0leS28qWQxZahjMXfjzZ4JJdJNEw&oe=6A22DFEC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nksrO316iVcQ7kNvwHNe-iT&_nc_oc=AdrpibGR5xBEfaNB8HQprMOnF4BKQn-GPzKYPphdFhihj7EW4jdUQ7WU3czli6QS8Iw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yA5hij2YraorHjBykNu6eVuO-xLkCUCLGLYWdlqViZg&oe=6A22E04D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLRpyR5QZdQQ7kNvwGSJQiP&_nc_oc=AdruirP7EdI0-xMBFICN8AZpFRSoSKPY4EuJ-_tuAr4umbyaYo42uqm4GAwyaNgStYU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LkZMk0gMahJEWXd8ZyrwCjD5LYoJIsV99vQYvHGJ3mA&oe=6A22EDC1"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pl
49837938", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yC6h9aQ6BIQ7kNvwHrZaNY&_nc_oc=Adn7GSmKHg14CeY16D-rdRAAc_t2oBvKf4UyIQDWw7-N9WB4IwRTxCIpEiE1c-J8DYE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfycXvEzdacM4h8TJRNEuKbgKn3XTyW37bi8Jf0Oaf1-sw&oe=69B160ED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJbpbaYgx3oQ7kNvwHiCYRn&_nc_oc=AdmtYs3Lh5PzyRzkl-nOleJecUer5aRoi2wA_aQr1rHG-moLPEO6OGvfZ9Gu6txH2lE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz4EFkseZcqNVSsedLnZ6dj7k9RV9t8QI4O1SYXIYZaXQ&oe=69B17089"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-lzE72pKygQ7kNvwFBeWY0&_nc_oc=Adl1layj9oQUIc5EZO_GyXLGy-kZcaIzm2ZrgLVPhO9gLN9m8zasZoJfCvUuO1MPmJY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQWZ0bG4lEiAVv1uP1VPBrIosFgrLVsA29SXh2rVWiwA&oe=69B146AC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhW0fiK62e4Q7kNvwFztDyp&_nc_oc=AdnLtOm3RzfEQA9VNblEABP0wsGREdA9kHUset9gQ1aPjHIyZMF9VDSERzbiQ9iR2DI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_fA6FqetKHHZMmKtETQFzEjqfZaZMDrpMtcyZ8W9LzQ&oe=69B1470D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnVJU8Di4zYQ7kNvwEG6cp4&_nc_oc=Admp0noQb1VPtCD3oSM40RBqd6CKEo0oEYKoWwXqBJ9TNyaQa2OxLmyl9xURJ-dHrhY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfybJPEjsUP_JZDBGwLf7AQ3-V1mZI4F_8glCp_RGc6ubw&oe=69B15481"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
U1INv_IWqJTwjg3NnZXdOfw&oe=699DAA09"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1SBNd_B8qQQ7kNvwGNoWq_&_nc_oc=Adl1KdGxcCHVDAOvu5wI7bf38n_ZeXBrS1h2gcRkKwgQTyD8sVcihVkPDaxIfzkP_g0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsd4vYCYoZzH_qrQqRGibop-ZdsOuJkkkyU4CoHj3GalA&oe=699D802C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBZ1TC50z-MQ7kNvwGG7cQ5&_nc_oc=Adl3Ekxx9Jlz3kfVmq-6NQORxYwgh-E7uZOXg9SNd2o5-K3414zeqDN0dLkkbk3wUSE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsTDgH1tFcAqY6iI8hg1FMEB9N-OP_e7inAZIWGFNLKOw&oe=699D808D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noYty4p_BLsQ7kNvwEsXHug&_nc_oc=Adk0CwXXwmgXkdIWBJDs09ySVc1htlppIlM30OwNDFFZ36R_eETO3o58RsDuMcAXIB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvx_kOel1Ao-EoKsmhHbLmhu0CJgCP78jQc65mIG0D8Og&oe=699D8E01"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n", "short_desc
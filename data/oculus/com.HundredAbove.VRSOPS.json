AppLab Screenshot 2.png", "id": "284119949837938", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKFQEcEwONAQ7kNvwGk1BDD&_nc_oc=AdpvBsUl3AsXKYxUXw4-_FtxfmlCG5e6WprokxVya-BVeQ6mh5g3K4vCW2pdHDmRcBw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LdHV3IOP0o-FLnUkn-VDKB1gEY6K0Drw8OMCq_4NfVA&oe=6A36C0AD"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-97kCLpvHG4Q7kNvwFaxlUN&_nc_oc=AdqF72OaXd6RFTt-C5c7OeEvrPWeg5vLWZbh0_YCuV19De-nwR93AmuBB6NuAaJHIBA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_466CUHc-mcExq7U7ife_8Yge6V_eno6RTOxw6yrmXGg&oe=6A369809"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VW7CdB3FjlYQ7kNvwHSzldv&_nc_oc=Adp6y5sO3mjePDS5oJ8azwnCVsyzXiWuqvLuGQ_5f40Moosyi8gpW9OCbuz44yNs6Fk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__a2Ns2O3I5I8wpK7Ot7TjQNpETdn2o5wYIxtlI-WFZA&oe=6A36A66C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtvPYDRBVmYQ7kNvwEbkaC4&_nc_oc=AdpSLAurKp6KhYi7WcHh-0zRs14madKw2Bk-6hAg8k32-k2qCCVIAwmoqd4q9-iBIT4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pQc1KMTxvXO13RQtrAzt-9tH1hfWl6O-ywohM32dJew&oe=6A36A6CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZS85q1d26QQ7kNvwHmkLRa&_nc_oc=AdpCcSNMqM97wFzOXV-NiqfnjLJLpQk_ISf96nWlj8CXy1DH_vpNBLNf7C4BS2EqAUw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VjtfXAmO7L5CryBCi_NKP4O36tAtaUrydrG1OKXO2uA&oe=6A36B441"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pl
AppLab Screenshot 2.png", "id": "284119949837938", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p59q2ABcrgsQ7kNvwG8iPtc&_nc_oc=Ado4_J0Vc3zdP8rnmt6mP43TIxUYBvvF5wmhNHRn5RyjngwH4aneHgCd8qptKwVvMEk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YBXT3UiwXF6FjjBLedNtLnYaVqtdQYP6ddiBQ7DnatQ&oe=6A119E6D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WQgWHPA-6cQ7kNvwHPs348&_nc_oc=Adq5jF0Nqg4qF6vF966XlsaajQFFpIU_TurEWfiGbaSjAIXM0sJaEnrRJSsRcjX9gRE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4T5IfW2Ch6JerR-EECmpTn5JEDRoJm5svk8FBtTKF_9A&oe=6A11AE09"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6S-FmH4D9zsQ7kNvwH5hBhU&_nc_oc=AdpyIFnH9PdPVyvGewDvQVM9TBMXbmUQcR0NrTDyLMeUW89TAWYMGRJvAYjJ5K3MjhI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lLFG8VUuMwGlLE6ISlUfBthJ47QVG0FHjakbE2q1mUA&oe=6A11BC6C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AW5VecqjyBAQ7kNvwH51MRM&_nc_oc=AdpLsx68EP7WEKAQCeDdi-G-9UojzvF1QWNKdiA29gFjmlIQIUToaUU0PM5V0C5fF_8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gKBd-qa4i9_p1Adsc7AWmuWXPK25aRffjaX2YX0vW2A&oe=6A11BCCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V420UllFPzsQ7kNvwGpxnGp&_nc_oc=AdqKtA9MrmZVYyOiLXuOgpd6v84RyO6V10LPRi7R7zlgLFm7p4JT-sN42SR5uZGDbN8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tQvbj1xrawzsHjArv7u2-Dbw_QqadLOuk642pZx67hg&oe=6A11CA41"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pl
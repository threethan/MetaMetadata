creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3GBkE7_d8kQ7kNvwEANJ3z&_nc_oc=AdrpgmFW2ljhcjsad53K7IiyaDozplw_nZUCMp9zsumMM7YscoN34Hw5bznestgTXaQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmPbAz2BmufA0LVC5aNNqjsRJzwfz5GHNAcXGOwhnx6g&oe=6A92D16D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tn50SM1-92MQ7kNvwEcW0Js&_nc_oc=Ado6Ufs2Efva3JNi07xRjlr_zLzpm4VfY1mCrdqey3GxgYGOL9H8PtZgnHqLHD4DPG0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_XrhsewisVLmn_Gk0HmnVcLDXRa62G2ropml7sxJStg&oe=6A92E109"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGS9Sk0WEMYQ7kNvwEZvWyk&_nc_oc=Adog7ucb7fBIYpXBUvqHESWdTqdsgdaKCWZogjni_jQHyL-oQeTTwC5pWGlRb5uL4fY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPbRo-ImgGgSdjml6_r7r8t3qh8crXp5tkHV0k6tGy_A&oe=6A92B72C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHQtBE4TEJcQ7kNvwEAWT-j&_nc_oc=Adrhud_Zn4gZX9gkQN3_i5N4GuPbpdNJKti72SkqtYrou0Jsf3IOCmtpWSParwZVfAw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESov6bmhJiPt9p42M9CubQWlBIFvDWCAdcb5sozeTKTg&oe=6A92B78D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMKQb9dQkvYQ7kNvwFSiaKt&_nc_oc=AdoRkmHroNPg4KupqjGymVs25qBtmu2-YVVwBm6As_GJD3kFq5oI9GKBXpwynbOstYg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTRBAe8cHUU7blW-BNddi6H4gQU_g5BYnMP3f7tRieAg&oe=6A92C501"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
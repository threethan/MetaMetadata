creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQbvngQ-TJMQ7kNvwFQA-9d&_nc_oc=Adr-eUgQv6IQoeFHUCLgwS8rqUYg_TtKSWl3_yY5iMxwnXkF3bPAJ7q1mqGBn8KDN5s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyLbUF0srjEYihqLnnxNX1tdidajSHFJf761dAGUMnQg&oe=6AC7C5AD"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6IhQ9_-QakQ7kNvwH4X2m7&_nc_oc=AdrmQls51z5mPYy9WFB1KDaXxRTseHf-WcuWHNqX7w3i2hmXmArN3pptB8Tts27XG78&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwqb7bV-1B94gSVL6xOBszd85rLd2xEFc6-s8qOeDIig&oe=6AC79D09"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CG9pq5YJVcQQ7kNvwHvY2jB&_nc_oc=Adp0eSDW9gityIFtsprfd-cPIBS-5L9i1G7QuTIJMnIyBArZshsmDrH4fB8wYqWo8Mw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhBcbRZh5dvC5ExMXCiZzPXckNL9ynDrFa_5hJ5NyzYA&oe=6AC7AB6C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DoKc23c12CkQ7kNvwE1JAPf&_nc_oc=AdqFDjQBnXNBgCxutvwfFgLGkVs1A-RRxub_agPONmVCQvJmlocPiSidHJ4IucRd9nw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxCrfqECqp3igoyYG2lYAB3PNRggD_VPfCKYD8GqIIKg&oe=6AC7ABCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEJDDcXKZZ0Q7kNvwE3kb60&_nc_oc=Adpo7qCpmcF62RD-CikkmPK3PUUp0YyAgmqB56PQY6TNP-E30bUtprMx9gdUAvgNN3Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPe_-NuKZ6HciBj6BnPpM4ZM0DpTXzoK0MEaXzt5Pxp2w&oe=6AC7B941"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
AppLab Screenshot 2.png", "id": "284119949837938", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQ0oPg9JjhwQ7kNvwEIVIs6&_nc_oc=AdqU3t9u5SHkUHfDKw4MOJxkyoMK2nBI3g2V_TMsVFJz_At0j2t3sLPCsm9mRsxGAEc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrg8GICO6_5qsV-dsIjf4MuACdFBrQzHTTuKPIQmg3vw&oe=6AA93AED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyP3NtKeNqIQ7kNvwEsnbU1&_nc_oc=AdrOv5qVkV48pKv67Qhtm3Tb_U4iLlvLWDJK8UQR4BlACl2eDnmvIOXj4iPgR16Of3U&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyZvS4oopLN6QX1U9uz5N1SGYkbhiSH8pWL6YnlvH7bw&oe=6AA94A89"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHbzwZHQI7UQ7kNvwGrMV9H&_nc_oc=AdqsAHeAbWHvgzBTHLHWnbbKruwytljMtds419qpnqwhLL88tWozJKodc93J6BQe_Oc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUJ3ZefU6SZpjUfGB8MiUXRqLjV1by5sYrDwvBV6tgaw&oe=6AA958EC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4WFvIKbo3kQ7kNvwE1tNYo&_nc_oc=AdqeEQEwl2hm1eD2PICzYuPzWDovg4omVLj1mqznr7yYmSmttnyUO9SUAMak2rBMGqI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILOnPSbj-vYMlBeLo0XbIT7eizPmhxcXry6uLrdDeSuA&oe=6AA9594D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlAbX5-5r64Q7kNvwH4hM9B&_nc_oc=AdrRSycRwE9Jav73wBpit8GOMjf45IK4xDSH5TF7FwlgZr_ETlW6iQ7lb6X7AEFHGEs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIovfFEjUzmO7TbmDnyGzTfHsoZkr321oqaMLuI4syFeg&oe=6AA966C1"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pl
creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqVGmMlTIQcQ7kNvwFZVpea&_nc_oc=AdpfjL26knS2YRWkhE1EQHNE3S8Sk1cwTl-6a_5MqGr7SwMm6C0PDWbA5Y5hsZLoVXA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Z84z_cp1Za71V8FKkelzeCdS7eh98SYOj6sqHwNLTbw&oe=69F9E36D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMM5KEZ5yQYQ7kNvwFJQqKf&_nc_oc=AdpY0JGz4jCJJ2eG1p6O1DDQ74BZXGlFCVv5jOuciUJXDkJruCZmUA8f8d-dN-5AdlY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Uh4o1bdpQR-HKNNRy97RE8dczqJ95cf7X6ongNz9ANA&oe=69F9F309"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7cp-QvgyIIQ7kNvwF3PE_Z&_nc_oc=AdrxRQgghq0DHP3P-HMANqMLeqw6iwvuQ8MyCwLpKJyeuX15CL7ye8B-_DXVn3EjurQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gii8-DYmHpYSVxdJ1DlafiFWYGqk4yJevV00VWyMiyg&oe=69FA016C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sl5ploV6yhgQ7kNvwHu5iMq&_nc_oc=Ado6yBuvLRnj60ytvnRDDki9f4iOcWMRoi20845Q2QJhlglWxvOLB0sSpipQ6wTJQO4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vsRbwNJiTsfgHEvYe5lT4jxGwPYJo7eW1vsj8aXWsLQ&oe=69FA01CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLAJ2ZXUUsoQ7kNvwHqtdIf&_nc_oc=AdpBIutzuiq42iFnlnUb33ARNqGzWN4uy3jSwH_wtBepKqGgpwNbyyUeIOHkh_DDxHo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40wRtyQo9yLJPdFVGAGKOnaqwaXeoeQCa60lslavb-sw&oe=69FA0F41"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
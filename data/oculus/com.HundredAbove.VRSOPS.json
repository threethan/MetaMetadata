creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgYsfeaQsuYQ7kNvwFbNmvr&_nc_oc=AdoaGpX0Auk6Lr9W-Yhen0zS7vfzfFrfEV75FpkQVGPoCwq6Z8kIwq0m6rI_aiDRwUs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMGUC69x64nq2zAkakrupzcWiSXt6OsC9CvxnmeRd1fQ&oe=6A9D5D6D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdzKFOVI_owQ7kNvwGBZwMe&_nc_oc=AdrUF7Kp9g1WNMO6zA4UFE0AXOIuVHb1UsaAXbjtmWgIxL7DoFgU_Yc3_EEyxG8VC4I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHQG79KYz55Zqrh1y3QzuYFevyuRUv5AWEFYeVQk7OgQ&oe=6A9D6D09"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3pMg7GVpXcQQ7kNvwGB_eqA&_nc_oc=AdpnJWIKoJDMc6Ko3MqgznwACDbnGGvQ7ccq9uZEA9fWEFUebRwPM5g9ejCSPVJDZQQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGl315UUlRih-i4lrvhRyjhRQG0Y68giiqQGgos0O4-A&oe=6A9D7B6C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0k3I6xqIHAEQ7kNvwGSMOpI&_nc_oc=AdrfOeLHn77Bmfhiq303SY_Sl23OM5svCmUiMFrBsPqbR9D9Q_UvlEbGEmcO9teseOI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYLCIESoNW1pbgBYBEzQQ6Mkp5l3MFyyY49dctCdgmjw&oe=6A9D7BCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxYYg6tH1VcQ7kNvwGBQCzC&_nc_oc=Ado2l-f4s1095qKzMRbJyrBn_78Finq472ZOHpVmH9MEu6grtLATiY7f_i5Bei6yook&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFI_yEJEBSmELvdmUrDQFKd2qNhQmaV8okcsVbEmy_yQ&oe=6A9D8941"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wf_ItnNCjEQQ7kNvwEPmrwY&_nc_oc=AdrDvqrOk8kA5QZdJfvHyLcSGFeuOMWMpwnUqbh_8leO8_dzAMWZHd-rHljXXTI6jTA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQepfYvAYlUJ3e9OMY4YsKIGveaJlFHFS8G48xMjq2WUA&oe=6AF0A42D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRlc4Bue9xgQ7kNvwF_EcVr&_nc_oc=Adp-2dMgCUWCBkBt0rx4vhPq7AUEz4playZzpxkEUgiVtORFcS5irS7dXGANV-zBNns&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbxfbRRlFEwoZF8wpz-NWje8_RjeLRlv_VpXQsCzB0fg&oe=6AF0B3C9"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCiYQ56U738Q7kNvwF1n9dT&_nc_oc=Adr0vq4fIlMgEEqU9Wy7xkOqPC1VssDZ_3G9_dGszyW-ISeluSOYZ2qPVQTBlvbzCFo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvbD9MfTiOxKjdHxP6UhMNevt50yHzXfHyHMKvCw7wwA&oe=6AF089EC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kt9nVY_VGMQ7kNvwGluGDv&_nc_oc=Adqz3sO2KSUAYGEeU2oE0FCp4aHo-HvesJKztUb5_k3mLiZNnxszxYZKK8aXEEr_B2I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlE7zhisMuhIOLlEXwK-cA22rdAp2jRd2ZOPku0-WjbA&oe=6AF08A4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BK3E2IxtBEQ7kNvwHSEAgq&_nc_oc=Adr_VL_XEOxf2wrn1_268SaniWwW9eZW_GQ8-bY_uZLA5CJvF1PgAlIokclulfkqN2c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDit4yL8xqCiCqoQ8hyS3h5mzOZySMu4j8a_N5m5BwuA&oe=6AF097C1"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
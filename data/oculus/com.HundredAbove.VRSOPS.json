49837938", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8B2W475b18Q7kNvwFXblqo&_nc_oc=AdkwS2RJUO0Eva0gtjvJ8ex-iu5dGxocUvVBMWRCaqfP5y8HA0eX3ujxNW3ab5XHyPA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxxNv-lKl8NSxjtfxeH3-NcX9dh4wnPdcqgDHpI9nC-Og&oe=69BD3E6D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNyN0InrDKAQ7kNvwGstOT4&_nc_oc=Adkh-KLqymWbFHyeC0JP5QdL9bdXBLw2VINc13zYOhBsJAdyAslgrbWDUU3CPp0cZkA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyei5cOKWN4ip_4kNS9fkJKFeFz8a_KxbcmYu2MCqy1Nw&oe=69BD4E09"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCnUTdrclmcQ7kNvwEU9-k5&_nc_oc=AdnLAQYEcBltY9AS94KyJtW7zATdUz_HscUFCVujeb0ZQTf-LzdO7pHDeodwRDANt8w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz_M-oLPSP5rEOpQTM3Jjugu7soFmW87GktHcJLAtr51Q&oe=69BD5C6C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzD3dJMnkKkQ7kNvwEBd_CM&_nc_oc=AdkiQa6qSvNb1_uAKqH00F9p0vHvKK_kNK6QzSBKbnoz_8vFUfroFneoZf3I86RhIeI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzVTj33QWPi7HMVx9FAXA30KNRj5kDcfbiu_1aFFvMGww&oe=69BD5CCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srn1MErpU6cQ7kNvwGrNr-5&_nc_oc=AdnUhc1tZKkATMbfIvcKNXDHQN2l5Vhli5S6gsC_FfIiqC8vHU3b7C6pMp-4fsjeRK8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyNJJxaiQ5FgD3u1mZJizEBypto5Lz-RGV1Q1NkMT6hbA&oe=69BD3201"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
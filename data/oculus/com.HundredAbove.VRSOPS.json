49837938", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8B2W475b18Q7kNvwGtzO-T&_nc_oc=AdnJQ8pdpjBVs2bKiecUnbfpNuNGOtEsspT64vPyAt6K5Ix-Ne2LpveYKBZM0rtwZiU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyGGIo0vAUfVf-4SOISG7GE4DEfeM56g_qklZDhD_dG6Q&oe=69BBECED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNyN0InrDKAQ7kNvwGdNHQS&_nc_oc=AdkzHfHMi6smSyP0y_oRms4dn-jX4YEPZ0y7oxNDrO6hKEdys7_p7yMusCdp6Cui24Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZQj6yA7C3Z5QQaIMSR5YLKCm-83e9bA3BWgp3sZtJ_g&oe=69BBFC89"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCnUTdrclmcQ7kNvwGxRR69&_nc_oc=Adn6qNY_mxauzeP8o9d_fEauTs_P_VImfuz98o2q3soa7-sMFJr3789L1z0U_AiFNVU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxvOEBf35l1-Tm2ec9kcS1frpgLfW5aiy89JULM7RMRTA&oe=69BC0AEC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzD3dJMnkKkQ7kNvwG_4YWX&_nc_oc=AdlK8-tI3xXho1KLMsw89Q7CwpOmJKC4SZobR9HMnVaxG1hm63i0byZwTdBPadYGeGE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7MJh1aVtERfsJmGwNQNC4eWrGGwsMYFMboHAQJepb8A&oe=69BC0B4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srn1MErpU6cQ7kNvwH-rIk8&_nc_oc=AdkxZ7wXNKQ8MbP3P1eL93YYnqihjWVSyTQRNiBsa3dP76yATcgfec-6FwsRObN1kEg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxYS5Vqv16aWO26RwYW0JyuzHs0_fU9Aw5YbBWY3XPWvQ&oe=69BBE081"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
8974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=es0WsGpbTL8Q7kNvwGLqzqL&_nc_oc=AdkboCiXW0ZV-GtJ8AuKDmJfoRrJOuUqn8spMZZgFE_-Sc-6_Av8LE3Un6XGfJeDnZU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuJ-K_KMds5BI8huYIDRvzAHIZ1o75prMNNzl04kvAqJw&oe=69A18EED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFg3i8g8DxsQ7kNvwFCM5oz&_nc_oc=AdnAGcNHngJYqWE9gBRc9aFrT7T5ZlLKzc9jm8pIzby15xmlrLEV0_F7fe682sKvpHA&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfuUs4Zn5U3M6chfJLLXKFnw5EhbMIG22LPTh0wtbPoEVg&oe=69A19E89"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCoAWHj0oVkQ7kNvwHV0ZzU&_nc_oc=AdlzZNNdtDooUKM99iJp4dhUArpkWItiLyk87bbmesEdvXL3ejoGJuIO0w5pyyOFJDc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afv85PDEDKR4FyhOMyVMbXacWZqP_sf-BoPRkK2cHNHk2A&oe=69A1ACEC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDSS29qzY4IQ7kNvwGtj7-B&_nc_oc=Adm2EyhxPc9A8FPtGSkPXuuD7SZKtjIE80mi2dnsv5yq8gyUm3P-_znVbpcNZ8b3Dpo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftcmmOiK7PZ5CvMNwhWTudExiP70O5tolzZ6MRjEnjjDw&oe=69A1AD4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fkf7s_I59RsQ7kNvwGwXdot&_nc_oc=AdlM0wlleYMdPvkcUI_4tyJikydp5deolDcLhb0AWuqqva1_x63i-Km4_-3VdrH3fjw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsvRATF8Ah1KbHnDgsD4qJ75HKR2bmVeOdRWcUbgLmbBw&oe=69A18281"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [
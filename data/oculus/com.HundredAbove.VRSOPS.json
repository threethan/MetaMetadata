creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jesw7VwsUxEQ7kNvwEEiqgA&_nc_oc=AdqtzQ3eJB9jD8H5cwKNSTQe78gmDTQy5UlJ9JDo6-bjhvFiCgJ_hk8D_3lki7IPOvE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67uFmiPcXK5mqv-yL1OzpXfiGbDxezFgvOcnACQ_Y52A&oe=6A0DA9ED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_Zkd0cXGF8Q7kNvwHDf3-q&_nc_oc=AdpC3Cu7omqa6MvtzOiqIjWQA-QyXO4WovFKk-_2S5Q5BlIvDrWcP3FIpMlO02P_O_w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VwFvOqsrHu_JbCjMbiZPFn24A4qiC7Twm2L56cJ-JNw&oe=6A0DB989"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvtDxUt7Zt8Q7kNvwEpZxZj&_nc_oc=AdrmYA3G0anPglK9RHNTo2UpXYxMJDLwU1LuxOWFZfQQOC71U0ltJ0KKhP34oVtO2O0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MyLvsxkYiVdRYJTcu30opVX3vXB9OxuNKw_5oDBkX7w&oe=6A0DC7EC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMw4nl-uaGMQ7kNvwH8nEmy&_nc_oc=AdpBOObAIAUgc_cA7mZyHV_7uITEnY_jdfZmtFTi6PCOjhlV5l5tkts3eFmvIgyql5A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-rTQNsJhEygWol9r-wW3Sk6m23pHMOyPuxXRbe3UJPQ&oe=6A0DC84D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MW7FQDYLYkUQ7kNvwFokG-A&_nc_oc=AdqFnfic4C2J51F5GbL8Dy-kZI_qPl-y-EWw9n4TOe-liCQbQKh-xFCTtLLZXciveRs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fPQ8RNKV_2S4KzJUAN7bt6w6uPn9QT9x_QcDkAyabPA&oe=6A0DD5C1"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
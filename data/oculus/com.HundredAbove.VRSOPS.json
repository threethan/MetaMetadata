creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5tKnDixZWQQ7kNvwFNszrs&_nc_oc=AdoTsMyJuEJrPLMKXI-zjXKgvDkWEGRtNysOfzzeM0_jaVwZm3pFlgZtb7tkqrvmUZA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw9ttp6DCBNXi9ggLM6RbL4Q8giy9r78lY7-kph-k8yAQ&oe=69C678ED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbkZr05FW5wQ7kNvwGWRLZY&_nc_oc=Adpj3Fgj0vLq9PgZvlep8EBzKSDqvUD-Eh4HQBUM2PJ_B2KHQeSBo-9q9czE31AoSss&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZTO08ZjIBQBKK3Da2rhKfAKFIiAFLeawFgghrKHR84Q&oe=69C68889"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KF4n1gi4a5AQ7kNvwHW62zL&_nc_oc=AdrIU_psvbdunWaKYiLi_KIxkh-AYuSS6YHwvM2UlYcAHYldwMYFEXpEIJqaZf_gdck&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxCvG19TgF26YJMuyLYQR3my6MkWrkASFMVZb7C3T6dNA&oe=69C696EC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQYQWkNiGXIQ7kNvwHwxWZz&_nc_oc=AdrruPGP95ennx31PYNjxne39kOPJvo8HEj5DtGkRNx-5nTO1kgxiw-Z5lm_8oQHm3A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwWsE7Ch1OrNg4HG9CSz0kC1-xrGPb2oZhpsZKYhUKB_g&oe=69C6974D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVTy4neC_e4Q7kNvwF2wwBW&_nc_oc=AdprS-9pqlFs_xUpvyveBNucQGiX2BLHxdGjAqewVRIeRJuHobOc-g4dT1UQA7ZoTbE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7UVF1-j7w0tFBGqV5bwi_I7S5pUJb9w1XMTcF9LSJeA&oe=69C66C81"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
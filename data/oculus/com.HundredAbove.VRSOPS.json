creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvSbazBjXGoQ7kNvwELZtMS&_nc_oc=AdpZM9HIoH6SOiG5ejy-GTSOwr-b5Q2_jL3vdSSGheBU1pG47QXDJaT01jKkaCl3BGI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSpdUcZ0_YqcHhp-NcAmIc2clUW3fMgwZwvZN4QN7OYQ&oe=6A50E66D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-zzNTvp2zkQ7kNvwGk79U8&_nc_oc=Adpuaka9J55iWUGhf3_YHUcdWeHs6kOongsZa0Us-vc4NGlOryfrDDYWXw9kNreldN4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyOKT3NUN5aORQVL-pwWKK7bWq9blv8YgqDfgLKjx0wA&oe=6A50F609"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmbQfpV9pGsQ7kNvwGBzWa4&_nc_oc=AdrFYTr-uwPtWxQxT8JpDRoWOOOO81TZlNiLl-rjHYLNtYzai1kLFf7gjHISHFV_KZg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcFU44CA-qUdWmv7htP0lx3kWMXxNxBUtEyI12ASFU0g&oe=6A51046C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvNhuR9rrfwQ7kNvwHeqmF6&_nc_oc=AdqAr0-azy0lnicvZoMYUbmDUZXuAvU5qDJ527C7NrV5zVkf9B4tUsJ7NedsDuQvoDs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1aMEArvgH-izFM_2YDwpkMy7gGteSWkgKqxeCYVO_sw&oe=6A5104CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hPj7MWWw7sQ7kNvwHsDMZg&_nc_oc=Ado_Q0jbVYKuc2l4DxjuAzrZlJylbXyjM8mcW1K4fgXcMip-iacl8io_X3O_hOSVngg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQDMnOSuCO5Q-6ATF6_w_P6bLWFVdnQZWbbqMfOBg09w&oe=6A511241"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
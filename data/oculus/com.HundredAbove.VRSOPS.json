creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0daDl2nuSg8Q7kNvwHwn2-l&_nc_oc=AdpBfbgD3Zs5t3kHRXHzAYY7sjV-IUmUfZCIYuy1JD_kEWRWakI51wZjRN3v30uVVp4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjCxJU_QhcPPxGUICNCGVltDvZ-WK8hMICFWYrHOjY4w&oe=6A4CF1ED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3jq7NSB7WkQ7kNvwEgBva-&_nc_oc=AdqV2Ssyirq4pQ_5NlClPkeOue6j_IpCDLpH6rbZ4SKHwEp5NAYaPpJ9-anFhY1d4A4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzBIxnQwVQJ9W2BsCraVzqhE1a8SAZXsq1BEKMJ2nSQA&oe=6A4D0189"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BdzMCi4bxOUQ7kNvwFnN2oD&_nc_oc=Adr2CJOXmthAJv3xwG4W9kX8P-4yoRicw0N17DF3ltUUXDZxX9LuBIGWqiDCqZPc5o0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhEstaDCZvFjyUSay6hGCzoHA94q7h9Z1b_rZkO9xFUA&oe=6A4D0FEC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLZGU11xt4IQ7kNvwFPT-w_&_nc_oc=AdruV2CXKVNkUTT2cD4t2jQ7uTV_5SuR5FojEj40Tj8TCStMPesGq22lHA_GqRASywk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcli2ZHZ9Nq8BYUkLsQctpqoS6190YaCxFzIbyqimTCQ&oe=6A4D104D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phb49rRkzZEQ7kNvwFuhxo3&_nc_oc=Adpa9xtqMjoUhGWz_G-ngCXFaSEuo71E7NjRBL_Q5pkmijSkWbJuCtu_gb4mlLR5zF4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNs-iCYPD2H6KW_ZyjphmCIIVLJWrywHQz3NC52AtOGw&oe=6A4D1DC1"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
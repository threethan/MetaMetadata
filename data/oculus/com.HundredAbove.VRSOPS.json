creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SR_EMGOOVFoQ7kNvwH7yBt_&_nc_oc=Adrtk4o07uoQzl1qnigti3pivh6I9QDkNINB63CkqAjRR7LeG8Rtl-dP5vLXiRNsmUQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3NC8_YmgXVb9-Wwm_JIOhVm0Uv_IWOPfvJn3kvbUcnA&oe=6AA5466D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LW3zfZ1vnUEQ7kNvwFBC49O&_nc_oc=AdpJVgJYc3455zaw8IplErzUrdJ58Om_gKIPUC2Qo-sqoJQpb0ThQf1KAPK8-IZ4Hts&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQO-FtRXWPB2BYkj6lqEKHMVqNa7ADVHsAfLEZjf2xEQ&oe=6AA55609"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYPQEL0tsd0Q7kNvwGtcVsZ&_nc_oc=Adr5AmHNuL4xI4JY89hbkDKTdYAMQWcIKF77ERaSmbnLMuR19zXjOfE1zD_5RXpsDMI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIA1n7GP6VXdWov0xT8ZC9mt63RHJh3-JGCVLcnyvoegQ&oe=6AA5646C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wdZNZ1POn4Q7kNvwEYo6qd&_nc_oc=AdonEruYfxBTVwxCSciCU_7LzLeW-_dYiF7dVcIsYkYwKVjI8ktJdXHParBbG1op6eY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXsMxtrHJS6mZVPFQFRYrRr13Ku_gqaunhuk_Ctpb2hw&oe=6AA564CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wb1gttDv0M0Q7kNvwF1r5Db&_nc_oc=AdoiM7p3uBnNSQ3KbxcFgOfssTi13_ZfKKpUsaYe_VScee6vegjSU0ANfV_p1MG_mE8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5OxKg937VJ8Iv-oCVo2D77icB-QYFo2pWQGZud9WQVw&oe=6AA57241"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
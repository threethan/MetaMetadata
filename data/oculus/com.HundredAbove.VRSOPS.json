creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHRdwTjmzvMQ7kNvwHxIdQI&_nc_oc=Adqxeeb4LGe33fxBkI5S0IkeRVyFghXZdd3PjIewd8ypK93Gc7s8ophuNNvqQf5zcR8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PZXZndIde9cZfDqTta0bguTkJ3j_-nUsKVru3OQy2eg&oe=6A29596D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8XA00qKPPEQ7kNvwHfUC9g&_nc_oc=AdpVDs9fl3FX8UbCdPu3ER9SHC1ze7LH8cAFg-hX63jBt6Uw2ifEqfLpTmv2RCZeaB4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5JnHuYbS0LvIDB6YcMYwTF-1wvqspo8ihRyuUyn74mA&oe=6A296909"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W95Tv52rwGMQ7kNvwFMZ3UA&_nc_oc=AdruZXW5ahhDKXLB8DRIcYgU8p1LESfU4bq9XSTfqC6WNeTJdBMDnRf5axV4C2eLCk8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92dydTdC5Cg85UgDyfri7vpm7xCa6FI5odtY2dYKw9IA&oe=6A29776C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zNgDjHTHr8Q7kNvwHtS8eG&_nc_oc=AdqbDAQZuNhYURyShkP_TgVfZuMxpiPO-YdkyZioMShbFZg-WoDvvavG0hlewOcZTdw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8--ozBP80uzEe9ziO6udbT2RIH5K41nLmF9655QFe88g&oe=6A2977CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sy2TB2qvyWwQ7kNvwGvuiOg&_nc_oc=Adpn4rFW6-pyI3S109qZhhXl_aucoYXu789J4MSb1vx8n_2JNQdVe2y2rn1ny7jsZho&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-T4DN5rUGfYTASQvGFOsxHJfV2_6WrUSdwohAcG_uXrg&oe=6A298541"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
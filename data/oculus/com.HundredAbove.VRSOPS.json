creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1mEfF5YalYQ7kNvwFmegeu&_nc_oc=AdoyRA4YB97bXA721uuKmpg2LC7H0sHBleUWhCgxX6q8gtvLSaZ4PoU00e8KVXzGjVQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvCsT6y9pZgNguFkHbbj-WyMK4P0lMFO9xOeh5eZLwDw&oe=6A54DAED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vCo0FjvC5oQ7kNvwFNoLs4&_nc_oc=AdpMyWP2hcMql-y48MIQ1I9KusL7e4qGxDlXg8-PEl33a1I0Q5M3tyuJJ9GF0cf6L08&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjPnKO8VKpIr-7-jB9q0kRLw8y-8jXbr079stj7_Vtmw&oe=6A54EA89"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8sAt774KckQ7kNvwEADx4n&_nc_oc=Adp4eSVHTY19wfoa4ByEeezovKA_w1zjxUE8yjKaGqz6vUbeWEwUYvgXuhbgn6yz1ZE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqSBivfD9ay-yDrlBsOkBVqjtxc6P7HK04FahWl36mtw&oe=6A54F8EC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DC1_cERtzyMQ7kNvwFp97qd&_nc_oc=AdqaTagJWYIRMVUrb2v_-yY-b0BKfVXbmZ7fS-AVB7kecAvtZCS7_EqvxH0AWok2QD4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAd4djitY4QYyIrfmDoLI0bRtLLRR4bPsd0nooYe0n_Ww&oe=6A54F94D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=McCCdNU0hCYQ7kNvwHpadVR&_nc_oc=AdoB2P2REho1lOjZXnIHWX0cPp8VCtnqQrWXwJ8gwGFxPy4uCoFD1zuHIFYwjZUpYhE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6gp-C53nVf_jN-hXYgyBk_PTy-xK4JDVeyVt3RpPMZA&oe=6A5506C1"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
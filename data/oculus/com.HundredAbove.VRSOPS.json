creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19_nMYI7ma4Q7kNvwHqrsS4&_nc_oc=AdrCvJD3Rwp8lG8Ln1KUImnvuCnvwcDs5J12_SSdSGJb9Zk_yFfNE7FeVXTCRPM1Yrw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKea9jhrPlPQX80yn8Wwc03BiuJgx2UZQA_kuzIU4zojg&oe=6ABA5E6D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMiTJrzAyL4Q7kNvwF9Khmq&_nc_oc=AdqZhFy-p3mhSt3c7kXGFSBHXsXeqJ5nnvLc9409p-9KVYNeonyK1Ry4bzUhJ_ZKiY8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlWPW3HClmG2qnhOWokR-ENS0wchcOKLTgCUNE1wMgPw&oe=6ABA6E09"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06l9_vVZl34Q7kNvwEYEcOD&_nc_oc=Adr5bvuHNzT9MG5K7XTtntgO4j1JqLCTVrPhOQs7klO8OeXcPOzPTqvzcp6F_WMxTI4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIexdGQSlYmht_ch4kcIvoqhdJN94qjTDiXBrfxJpGnuQ&oe=6ABA7C6C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f961j45RffMQ7kNvwEXZCvd&_nc_oc=AdpB2zBU4RL6Va1nUa_JpUEQk6Wt7QBqO97lE1ixjCM5heqtqRuZ4Ha_s1imotpgsfY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4-uW-gjNAtmxlrhce2hDGunF8d6IFTbUWjb3BMl_c4g&oe=6ABA7CCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSHnkKM7vM8Q7kNvwFvyTyd&_nc_oc=AdoNtE0_3Ijw32pZYeMtrtooiCQT8FlxdtGd-vfbipc93D9Ntm_BdlxnAXbPXzoXxGQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqyTJpNq0Yc6UdvoVLfbSZHRytCBTGE-_vIiXudZOkIw&oe=6ABA8A41"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
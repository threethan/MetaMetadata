creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4woc6SzwXW4Q7kNvwEnQX5p&_nc_oc=AdrWeKzFEFbctgAmf6XNrt__v3cBXq1CeC73L804zBuvLyDmqtnGc8lQOHuD_kzTyZw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxxfHLX7vwcJAUVX5GNryGYc8cUSec0fgKaDuwu54W9fw&oe=69C3D5ED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eydpnEi-lCkQ7kNvwGDDEPO&_nc_oc=AdqCgziMng-dptUOo2zPNXk7ABekv0XudrQgUg9RjC4KgMqBtWMnjOnvznVnzeZ05Ko&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBu1QlFDzUKdGtXKB5L9z6qGd10X-fqmqJt1mDlEV3CQ&oe=69C3E589"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAnfSrfwWpUQ7kNvwGtuLzk&_nc_oc=AdpAIi-k7KIf_X1bFUwvFApM2MlsaCXOMNJyGPW5_s9fDDMUJxR7ynug3n8-SRbJGE0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzrLENpyrm9vdXEHDQO1SYaEkZnodJmktg0oF7Y6e1qIw&oe=69C3BBAC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InKEGDvt8PYQ7kNvwHSpk1W&_nc_oc=Adrmc8WT_E50w13Wqw4JMKDdpDSc6I23wnjZIl4wy8VSnz8D00DLV7xm60GAoA_K-DQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbiJqZJ2S86MngmukJZ0ElAVPJjzMf5Kn36EP76MzuXA&oe=69C3BC0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dAetkYzVSQQ7kNvwFkKD6P&_nc_oc=AdozkoYbUaSnsg8YLZ91r2eknFo6xy_nfcDGU4mtPXRwvUymYe50A8iJwtXmVZXF4K0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwV-Mw0zHwFZYli41MMFA9K_EhPdaD1fTkFG2PphOQ_QQ&oe=69C3C981"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
AppLab Screenshot 2.png", "id": "284119949837938", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvZ1LOKD5YAQ7kNvwHrQ3wv&_nc_oc=Adrz1fWQfJNG5VbiqifbMc6m06nUko7ED0ygAq7lxsJg94_KoYSFQEd9DsUQFGYrZ3Y&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiHTpOC4k5ZN8sz76lq_rRdRQ8lymaWI6pTVcjeMqv7Q&oe=6A8EDCED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnhiUyT0tkwQ7kNvwE0zwS4&_nc_oc=AdpRxLV6zH86FVe0eVQRBdrWYJUNBtte70B2CH0UHx0ndKBEirjm0MtA8ZNKLojD1Fw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEI1r61-3A7jGE7u9Ca91eLQHTQiZkY7khMnPKZ-33_jg&oe=6A8EEC89"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBegUM8EULwQ7kNvwEXXI_1&_nc_oc=AdrGq_reD-EL_StG8pUue9XcyFy5FAN24UXt0h5PbaL2hieg-ZZ04aJLYLZq_AOqgX0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENUO6jU1kvdbrpHADUcyc2C70JOVRbRaFkqJZQ6QhitA&oe=6A8EC2AC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znZc_VevA70Q7kNvwEoT3HY&_nc_oc=Adqb3IKWiy6pxqJ9evldlTkaM9JT3pomSXLOy75WSEfnAG__o9K4clyCdu3xbbiEOoc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLrsOMphkd1hkaxzz7Dx2m8dzSg43nE5Fu56lP-NRc5g&oe=6A8EC30D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhJxjFSLV1QQ7kNvwFaTfe4&_nc_oc=Adp7L3Hje8UsSdOmgbxEpmeWU_7dqjue6u1Ew6r6RQDgJuMg7xThdf77UsPA9BA007A&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeY50DBdVRVkxh205Ya7X5p7tIHQ9lS9ItnSiMJxSoMg&oe=6A8ED081"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "
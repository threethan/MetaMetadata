creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_08CKaMmbjIQ7kNvwGsiCcM&_nc_oc=Adpf-Kyzley6LWUS9JI8U-fl21R6ZQZBUa-0_N8Ps2lrqy9ZV53DwK-JVaGYxk1oj_A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNt3G-sHJ2rvD1lGYyTGcUI52E4texRAocm-kJIZt5bww&oe=6ACD0BAD"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5h0HM0YFe4Q7kNvwG46b-J&_nc_oc=Adq2JCWQD5I5ZpQV-yShL2_SejAne7jQfjkQFVZo5Bi6RzVNo0nFm_X279QhqVzQX8A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAvWUnyxaUfx3dhce2cdRfrL54FLUJLS_0zhC0h48WIg&oe=6ACCE309"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApF6TfGHd1kQ7kNvwGgrB_3&_nc_oc=AdqmOLvma9BP0PUU6IMvphTJiLLsvp89MZdjuQy6dr4fIawMOnGmNwtdc9MfuvF9LQU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2T6Xkse1uMwqsbbtZc7ztMdpfcRvihdvrrLWWlEIoaQ&oe=6ACCF16C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVFj6yJLAWIQ7kNvwECR4SJ&_nc_oc=Adr4eO5q7r4NdqprkZQNfyaEhCY_7VLTTcB67XVf_NMsWTRFtTU1cnY1Osqpk9sEatY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkiq_NNFetfGz16dnPpE-hifJb0hyvhWLQBV1mg7WzaQ&oe=6ACCF1CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5oanugZeFkQ7kNvwGc-CWp&_nc_oc=AdpGayUyBi2XgQmTFpUyHuHMbLe9KJaM1lAmORiocZ78Vemg9cKVNQ7ROuzeV2ve2FM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUEPH6412nyZmE2bY2uzBQ3OIqRfZKrKAQc8pwcNhTwQ&oe=6ACCFF41"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
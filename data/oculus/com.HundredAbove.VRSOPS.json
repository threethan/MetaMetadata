creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3waVMJnxaZIQ7kNvwGZ7nFJ&_nc_oc=AdrB7WnQ17nZsfq4dhK-cwT8lWV_q7l6VWgVpjhTuBon0Uo9ykhtnDuPVz8kNO5y2Pk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxON9XBSQb4NOeUhRs161Zc0hc6KAqdONLPtrvhv0Mhw&oe=6ABE8B2D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jP280Rkx9pIQ7kNvwEKk1iE&_nc_oc=AdomMWbOKhRxCAWvswJDGQB-ZBQoxH2__1Qi0n_8kx6IXbUG1FVNqDgtJlNEDwn2SsA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQII9Yu3MIeP2DAQRAdJrfs7T8Lw_d3MWbUOQy_yXtKWbA&oe=6ABE6289"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oN1dYp-GK8Q7kNvwF-QwBu&_nc_oc=AdriUKsMyPHvy-DmvT11T57jLxo17dAsEJgLl-z6eazJDTy_dss3OP6AfO-kJRKAr0M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpFnDqWkmD36D7GcDewDVXhuJtLl3SuVEUcNrtFeULGA&oe=6ABE70EC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsjExlou4Y4Q7kNvwFHm87x&_nc_oc=AdpXA-Sf2U5CoA00PrrP0KoOX8ytg4iBE3_faNboCCsZyUctP9t5Tw8PPkuptdzVb_4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdOHz-qXw3T2GXfJrfaSvgZFz_oXuwZNbGmTxcgscHmg&oe=6ABE714D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=It-ZdXIyHJEQ7kNvwHogOej&_nc_oc=AdpIFgGwGwlyriCi2wbiChhYpvLR_lAfQsFJNuOJd_Dm9TGgezixjSK0Go3MNJ6b-0I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJua08CAVtN-5UhJA1Il5jihP0bctxGn92J8g0HDif6EA&oe=6ABE7EC1"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
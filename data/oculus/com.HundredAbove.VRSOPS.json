creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3waVMJnxaZIQ7kNvwFPYBxd&_nc_oc=AdpQIjYmcJrHAhbL-MH9ZKLAT5AvJKHxNEymsWBxDixVosuQGStEGi4AXVM5p5SXvqY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUgKfYH_P0ElDlPXBU3sI7Pxz1JwvLFC-hpH8vMMihMQ&oe=6ABD016D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMiTJrzAyL4Q7kNvwHBVfvl&_nc_oc=AdqlSszKDYTE5EezYYQmUDhSdgF6unATPMM8Z6R8wta6xz6u_l1WbVEDYQXgsSLxHts&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLw-y3ch3QDKvS4LX_07U-RR48vq1dhq6Du0jkITu0rhQ&oe=6ABD1109"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oN1dYp-GK8Q7kNvwFOejTO&_nc_oc=Ado7w-WVpTYBQaKMlajVItpqo0dxCGemRXJfI4Fv7o5i_G92lTI4LkxkNoo-hzSmySQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJTzS55GmxrHk8rilE-I6MayTodQ2cAZaVkirlCiL1HA&oe=6ABD1F6C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsjExlou4Y4Q7kNvwHg0WzP&_nc_oc=Adq_3Hdchz5j2COCi6-fcyF0Pk3nFLr7nBGfncPwxkE4971R-nR6nYTirUkVOyNb7IY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLe0yhTmxzYWfA290hLxF7OfaYbwCMVHXi9-inQ0Yl65A&oe=6ABD1FCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=It-ZdXIyHJEQ7kNvwGkMAgE&_nc_oc=Ado2f-r8v6XNXJcM0ZCGZ5gE6fM72ym6XmGOrbMEUc54_e0B7Ziy06FRlDZZXABwtVQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLStCushacAsnFwMQtxLe9Cl8_S-f2XTqd4lkyED8-Hfg&oe=6ABD2D41"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
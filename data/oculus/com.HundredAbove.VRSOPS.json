creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3GBkE7_d8kQ7kNvwHf1KG3&_nc_oc=AdpI_IVihrOPq2-NNxAtyydzKOIZCLHKKlfVBKssPsgPYatyNwBgX1o5CpTipcmHpxQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEe7ZxP4mPLnAHa3JSydAF8JNqXDWw2VcO2HPLICo53Lg&oe=6A917FED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tn50SM1-92MQ7kNvwGGncdL&_nc_oc=AdrXi8CXCj6Znc8k9l-Qpy_QnsIv6-La0AhTJ1BgqbHQxqux0mdiTB-Myi36KZZxLc4&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzwGcYBLq80hto5vsLXp3Bp-xVLNWfL9HsemWyroM_hw&oe=6A918F89"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGS9Sk0WEMYQ7kNvwHCghLT&_nc_oc=AdqoWHXXpt-WrZkdcCcb1NVGVDqGOei7AIKJd07vIPIoObqvKrsMw1WOETCQgGaegTc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPx-6hA8ktlIcJk8Z6MVl4v_4nrtMO5sEJDbitbFJ1xw&oe=6A9165AC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHQtBE4TEJcQ7kNvwFUcVAm&_nc_oc=Adp6f3Y6KfnqY70ty26tJq0R9CxFRhfoMB2qDCWrYzn4ObzXxDoKbnoMLssycKR2-vs&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKf68nojo5ODwmJIM0njxIPaTqw1A6MHXxLnl9RiJkvA&oe=6A91660D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMKQb9dQkvYQ7kNvwGZiynm&_nc_oc=Adr5xh_L6Ek44-lDoZzsoC8x5NFWve-PqL2OT85pMH_G50AbZibDY0I_Eczetpm7quw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnPpkxabXaYqofLBADGagF2F-Fup4hLRJvlN-AHGej-g&oe=6A917381"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
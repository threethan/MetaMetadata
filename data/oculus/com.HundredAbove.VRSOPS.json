creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjuGy64NCH4Q7kNvwHP8YrE&_nc_oc=Adpfy7tCsrAF8gaTPfBBtK55ic-I6O7hITFzRUHR8YTuB92AwuZOxO694olag0O3llw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoPpld7gikTIfrnJp_FoZmuV3dS1h7JiX2rSF_47UQrQ&oe=6A4A4EED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAbglGnlGGYQ7kNvwF1yyqI&_nc_oc=Adrt4DN5wjsln72Q0EfwEd2f5GZkvl08hG_Ayu9BxjV7eIw1vHRJV_1zNtXxQF0gq6E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIylvRykZ4V9ka5Qo0Lancth1WwFOa74ImiojjflwQEA&oe=6A4A5E89"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfS-ZILg_70Q7kNvwEED4F2&_nc_oc=Adp12Wei8wX_8dUVEbNRHwe5fl0Ipj_EXNK_wadhIcdKhRaHQ-UqT8jpEmw10_Z9frI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrik-V05-2TZSYS2juWVoqSIkA-TfbiFo33EbTJId3pQ&oe=6A4A6CEC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-XnjAo9ObosQ7kNvwE4xP52&_nc_oc=Adom4KneD0OKd_rykXIGakY7Z03o5IQhDmlnIaKsuVjnXCzwaE4CdV7psWP6_3nu3so&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlR-qMfCoW_j8PSTrdHyGhmoGZKUJhKf18KYky1iEOqA&oe=6A4A6D4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UztxIMVrRMUQ7kNvwG0msgi&_nc_oc=AdoI5t2wq4zOrw7hIvHaXvxt6gIZCC8z6OuBTkz-yBe_c5rINwzdD5Cr3LwratPq1mg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYCCravrZ_Jnil_WWLmD9VxzlntTK4WvBW0JCKi8aXZg&oe=6A4A7AC1"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
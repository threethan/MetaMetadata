creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgYsfeaQsuYQ7kNvwHZ1cjU&_nc_oc=AdrWJjpphU2grWgnuvMBf1S0EObD5f0cDEqorvUXZ-8mIap8efuL3Qpq6pZ-znOialo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITp-GFLf6doh3DhQj7h8RRR2kRcjcSIH2JatNbXokOuw&oe=6A9C0BED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdzKFOVI_owQ7kNvwEtFNxY&_nc_oc=Adrb7LDFKlcMIkcmFZJmLMXy-IwgfkiAJCI8PA0QMeW-kMmnCbUiHwABX0ouruj6dAE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyaMMuhV0oi34mpFx8OKKCXrTfauDf7_vTwHAZe9Eg8w&oe=6A9C1B89"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3pMg7GVpXcQQ7kNvwEtnsgP&_nc_oc=Adod4unC2mYCf2UZi-NaLm8ggTylpwZALgc-69sf448xyJwzKsGyAbtRr163qLAEgOs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ93E4v-xVMsFqzY78RoVhnD1gu1S9YnhX37mEw8YX5-g&oe=6A9C29EC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0k3I6xqIHAEQ7kNvwEjKQ-1&_nc_oc=AdqvB7klMz5x7WMHe_9PgLy4BlRuiVPXyypVR8E5LDC1ahhFddyR1lNijnCfjvhJMrQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLXw_nHtaZdU7QjPXBydRQnjAflZ1ooGeCVwpOoIDfLA&oe=6A9C2A4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxYYg6tH1VcQ7kNvwGEqivK&_nc_oc=AdqGq8H6DFTF20gZKfvkGDx4UGi_rJi-VWGc5enEDBOaQwhdXYwt7ukc_nV4UJHgJ4Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoBt-jeEDzxb98SUto4f9V1kun2X8X3V7WHYFXnz_93A&oe=6A9C37C1"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
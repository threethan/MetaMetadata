49837938", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2ohZp2fzoAQ7kNvwEKVyqb&_nc_oc=Adls72OGQtVMFzyn5X-VOhh_66SHdXHtDqzNVsyGZEBLOpCT2TF851GE8x-PNlGMzlM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyE3_weTaqARZXcyFdg-dRdwKTJjyXvIUA9k2LGnahxxA&oe=69AD6C6D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjWCCcPPf6gQ7kNvwEkpHXb&_nc_oc=Adlmvcb6JdH0q_KRw4G1Wqo5JcPJXV5NUtfYw2-42aLqbKyiLV__ITGduFPC8Vqi2NU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2wxRJZrNsDZGZL9DctBC1-y75-028HR76isqezDuRzQ&oe=69AD7C09"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDrpYjLeV1IQ7kNvwGI1lBY&_nc_oc=AdlHTnQzX3f-V5Jgnxb0BpKIo7atuMwjqyTaiZaEMJTyeaL1pvPzjEJ-CjC5g_dHFpQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwCK6VyKoU6nR9BlbBslmtxk3GRiYSNHV8XoUEnoJ2iJw&oe=69AD8A6C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UykIIiZNxbUQ7kNvwEXi_vH&_nc_oc=AdlbZMoUFP_tYriZBgW7NRBt4fMchYYOwqhLvhKHnzxuUsxEHtrLtYBZHAEwbaj9BKA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMP34hl7wtNkieLi1Op9TUdzsglFssdx3nZ2BRjHp_dg&oe=69AD528D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60mzOPMUMkcQ7kNvwFZj0S8&_nc_oc=AdkpFvSstBglss1hteuJEYFAl7gAA_fQKVMOe_ZZdV-NBQh6OkDBC0N_ycSTcSet_Gw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzVAnX8z_AlOQGvr_fCoHP1xWMCnD1PGeUoMZkDA1_SrQ&oe=69AD6001"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
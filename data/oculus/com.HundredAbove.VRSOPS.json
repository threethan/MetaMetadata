creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6hM84-4KIcQ7kNvwGMO2RE&_nc_oc=AdqVXkvwUtF8kZVsNTnQs20ge6sFpi8CMZuUGmS0RZc5O3Wq5b3JDgKxiRxxTpKvGQw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA25BhSUCi2NCq64P85j4aW5cAtvC04PVr24mBV78WlSw&oe=6A65FE6D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eR9W0RYacNkQ7kNvwFgs2K-&_nc_oc=AdoxD6Lpdv63E_G4DymaUT8BQqLdBKMBLSRNQtSzlvYtTAb5qQDiWsPQknsqjLdK32o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWhRLPB9rTgUG9tKk-COga1KIe52F9iTTOvtIaX5Qgqg&oe=6A660E09"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXYSBsXGnE0Q7kNvwEEzcp1&_nc_oc=Adqfwa76QFbBpvY5PynrUA0AoCRAcxCCRRGkK7ACkhgaLl9JG0dSc9hsWTe-G7bvqsI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6iJeQLeWYnSe9Gd3Iq5OLiR0L8VgQ6YjtNbkcoXZ5vw&oe=6A661C6C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vRUbaP1im3oQ7kNvwFBrZY3&_nc_oc=AdqThh4MaxXWu7LuK0rwlFsRj9sJ3XMJvQ1Og_dlS9nmh5NZlrWTfIDbKvHRt9mH4l0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvDUolUwAftY5ywCEe0UiHxvK8_SBmskbdWlqf2kQogQ&oe=6A661CCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSK_F-zVJUwQ7kNvwHyweAV&_nc_oc=Adqa_oFk_6nRr6nfG3E0wIb-7FBTSNY3eFiAjH6ToIJdAJzWIHbiNcAM0041EplTE1A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAh0sp8UF5XUDNvKmdpAzpIulMbrJUK6H3TtIhPzdfA_A&oe=6A65F201"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
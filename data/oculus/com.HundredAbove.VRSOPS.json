creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzcvyBFfal0Q7kNvwGjhMsT&_nc_oc=AdrnjeBQTmj4fY-p_NjbjbHwgCnqrmuM1QV5PlYuoCCqDlR-CFMvUfTWxOqd0pJHoPc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NH26UN4_21b8GKb45ED0YS8fJb3WJ8W-BQvxJnBMQkA&oe=69E379ED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krDo5e_j4a4Q7kNvwE3bhyg&_nc_oc=AdoRu8hlOmH34m13gXSgLVe5HIR2OMk9px1MeO63JLDp-UjKoXKvdhVIXGJMS-1AULo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2M4gV37v7XK1IA3z0DsrvsNIsB39dUcB1vYgarwX5KfQ&oe=69E38989"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epnDMxBot7kQ7kNvwHs8AYK&_nc_oc=Adq-gzgDSf_CviHo-BbUhQzYcWcuMlhg6CIITV0Ziq_4E6X37lwMmtlcNXpSb-O5MHc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18FbP5TKQH5D1xVmh1dohNVANIIXUjFecRdwc7yOkndg&oe=69E397EC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_KmZzYmRBU0Q7kNvwGnWuvY&_nc_oc=AdraVKXWlLL0p8BspT6Et6MQArC1Kw9UajgYI9henW65ZNmUNuy-rzFR3MmKDvH4Ejc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11doO-uHgNxlLbKfrGzwesAI_tDiUWt_SKypOGmok7uw&oe=69E3984D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vOkccFQ-twQ7kNvwFU4NzA&_nc_oc=AdomcfQ3gxIq_tS9h-jjlEi9NgBF2cDW0KQDg-47-FZhsCC52tOOxd0lbap89gMNM-8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af364lX6uDEprYrLc1UqrYVR5sBRmLPyqpzggqn9YDAjqg&oe=69E36D81"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
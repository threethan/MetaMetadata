creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfMvrE7QYj4Q7kNvwEXhOV7&_nc_oc=AdpYRypyq8ReL9rniSwLYtMlmNkZ1-uJTzJSpaqp_myeb8-J6kpexkZoj4rK0Uno50A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MDe8LLTurRbGuGW1WrvaawRzJqoGi4Cd-_Lv1IDFY-A&oe=6A2D4DED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oolf3P303EwQ7kNvwFTDuys&_nc_oc=AdqXtHo4OYiCja1sg47YgQSWqR9flLbY2cbPv8O5n6ja9Bc6s9NutLCCI-rQCS-f2pU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JVQG4iGyZo2EsN-7N3o2ftvw5iyqMruUaTJhzw3Mbdw&oe=6A2D5D89"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gh3R7EHLukgQ7kNvwGuekDN&_nc_oc=AdodLUmpN9tbxo-J1unK6O4raNA6AhzEKr69m4Ez7xggpsRKpVWvUjv84hqaLC9-nQg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8o18qS3g6fjP1TkYCsAd_537h3sqBEVyqijp81Pqb7PQ&oe=6A2D6BEC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzCv1VGTebYQ7kNvwGzPF4L&_nc_oc=AdrlGRr_iIeEthpMaDrsMRiGq1yF9TCN_y1t-XHvFJHSEjNQcJyGlCdFvXhJxaNQGfg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wFrvxNv5vERez_BK7azUeTGf9UJviIRlQMD7h4Osp0Q&oe=6A2D6C4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GW_zVzmlLMkQ7kNvwHAHmFo&_nc_oc=AdqZg33F_u8f7vg7jvEzfbrPeJ1DH6zHHNWs8ESCthSNRvZ0dVw4e-L4HImw2iWaN4M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UvCq5ANaebJEV5zqlghzg9ZhVDbxssP-UZFIStXLyXg&oe=6A2D79C1"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
49837938", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9MEGTPufqUQ7kNvwGiiY0w&_nc_oc=AdnO06md-t0Z1ZeJMjLe1RuJ46CqVarPYQwXzgoZ4fk70PCFwjdBPafdstUhLHdsO38&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwiHr21aOMoyOvZE_tZxoV2n47Ki6DbHVpKB75DsVktSg&oe=69B403ED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mlV7ZDYIX74Q7kNvwGqA3VY&_nc_oc=AdmOEfbySHosIBAiTtArpUUc8_BhmWWU7LS_Zln6HR-q0muvij95aFbDQt6xpoLN9fU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwlMV8Kiq9-z-GYeRkNVLoaGHxH1xsxYSp0W-BmDA01zQ&oe=69B41389"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8P9MFlVtHxkQ7kNvwHqCMbo&_nc_oc=AdkKYwPKmY7CYzq4RB0dZnbm6-XwRy64SAWDCygQrzZcEUNn0Hf6iK5K3U5l_R4r92o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxPhYNAeEibJB3unvr1PdW8vQWfhCwAffdVMOFrz6cQoA&oe=69B421EC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZr5opWbvEUQ7kNvwGRE5W6&_nc_oc=Adn31EFCrNHz1u4FB3JH232sdkpW7ZpdjuU5rQcXtiou6RebAYOcI35muL3Xr8n-k3E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzbQG11hc2z3SYTUk4kgbq0lMQc4xXCYJ4c2543O01jtA&oe=69B4224D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6wr366q9-8Q7kNvwEBr7oH&_nc_oc=AdkDwA5m7J2MKZ2apT9GVguRuRmHnycpRt3ldGCiOmQryZUIloI-JMtH1sMqJWgtOWY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy2Syst1xo6YBLbEPF5mtKrHRZ5u6KzhVPuOD8Zj2eqjw&oe=69B3F781"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
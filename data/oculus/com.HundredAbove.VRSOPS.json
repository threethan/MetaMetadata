creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgLYjnseNnIQ7kNvwGsxnUl&_nc_oc=Adog3CArMB4Dyb7Yaue7b5ADuPGmNfPQymwsMes6fyyLMszt_lygJZ7zg__P0Vj4Lt0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPa7zBm0DAuwvQgnvQAueQn1zybaVdsu4q4QQ5sYdIv0g&oe=6AE33CED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TmQmW7JmKgQ7kNvwHsJ7Xn&_nc_oc=AdrashwnMx-CyKtmftGIDBthZCY54sb5DS9EUivj1ouPlwG8ryshcyPa_fdorHcCSzg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_5SIUAL7cCZBttsR2ONXfsorHVvsfpjiQV74ds9noog&oe=6AE34C89"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdPmKDG3UsoQ7kNvwFd-fqH&_nc_oc=AdqAhsY3_zkt56oZ3zUCeZcpPNK85DNvfZ2fjlOAkFJ2BANE9RNWQgUtEAmhBbQs7og&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMI5lHYNGM5TY6fHIhVA-ndA5vm9hl673vWmkA0NmbXQ&oe=6AE35AEC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGDbZLvskwMQ7kNvwGj_VPo&_nc_oc=AdowxpfFfvB8fXyYyHlXRsIHMP2tWC1lpI-q6SMFUobsKyHujxbsErz4iVfNts-inVU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTpiJpJG9eWs8eck7YZzUkcH3y_fjTwxog-TXIRnwhmQ&oe=6AE35B4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3L9zZw6798AQ7kNvwEsppE4&_nc_oc=AdqLa1CcfVrQVTuDTGZvkz0KqHNdsskVkyzATHUzHJ2LiJB3bkVrvNeqiGyNQYgr-3Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFW0Yj_OyWVQmQSYz86trQxVZlnIGTml_1W8tZ4WYTCg&oe=6AE368C1"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
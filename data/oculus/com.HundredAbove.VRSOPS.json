creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YO65Cqhv-4Q7kNvwHX5qSq&_nc_oc=Adp5EZsYuo2kmvhq-0x44jhcMeCF49cyMkoYyTpLLgagitrlsA4DkcFXc2nUGK0sjgc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgYVsHOL7gjZmDny8pjooBZikKVAfi8yTBrJVpmpjfDg&oe=6A5B726D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bC7-WYgT-0IQ7kNvwEay8aa&_nc_oc=AdppF6qJ9_yWtxYf1CqcuOOSQYBRXg2wl23REp7CYcBPTIreGhsJGhWy4Izg2VhEWBY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEbfQx6qN5_WtI1A0hSlvbP4VDt8DAEP4RIa9cufFSfg&oe=6A5B8209"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dquImbwekoEQ7kNvwH7XX4N&_nc_oc=AdoZ_6Tw8dAHqiYenu8BYE3_R0kEW4S9vmWMRH69lhsMSu1WTWjw1UKQhqyu3_Gi9T0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOxIW5v880Uo_xd_ssVgJDs5ZVDPdpJLlu0A5HKvfvDQ&oe=6A5B906C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yt71htWxWvEQ7kNvwHGennh&_nc_oc=Ado7DBGoY0du2ha7-xbQOV5nrlGu1pUXJwpEZZuXfjU6ht-G0Q-xr4CZgnsf8GKZnyU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFJGcbjtNS25OZIDhOM4o4-DtZNWYwwB-NdWA4tcVXcA&oe=6A5B90CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsdfmEd4inUQ7kNvwEb7rCA&_nc_oc=AdpTx_RiD_rCec0kz_i-M06HeGfxXZ4fwOhXtuBgIP6XUJtZQN7PKxTZX2Ar0qi5oqI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZ880FRhyo9KM-wIbBReYA9WAg9xFq2Vh2dMLF20sedw&oe=6A5B6601"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
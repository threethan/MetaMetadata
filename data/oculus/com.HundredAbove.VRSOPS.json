8974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJQZVycY_98Q7kNvwFTNASU&_nc_oc=AdlICZqYHHlq7Fu-f7f6HmorSKiFkkhnjz1y7t_6DBw-v-n5SHcovnzDK3jtfUsWeHk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfthtKwIGUS1uwlBOMK2iPu47Fauyc2pVBVKNN2z4wc3Vg&oe=699AF76D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjaNpD97qvsQ7kNvwHZlPta&_nc_oc=Adm0ZWdMbfNAUwN3OEPkC2Daup_T0aB8x3WU1e2JYoywW3zPNo25DYLfaDvZ9jHplfM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft2CjzzTuky-nzm6k4GyqKg487j_MzsIkfDMCAHFp36Jg&oe=699B0709"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1SBNd_B8qQQ7kNvwG2UcEz&_nc_oc=AdkDgZIEa2MQNKlEN-CwVsHiThRnJm9g-_qvqoLKFS9WenPfNhxAJpQ44gpG2zPZEvA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvd2zkeuW6GOKGIUF_r3dcSXpFx_iADnU9wtAjHO9G-Mg&oe=699B156C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBZ1TC50z-MQ7kNvwEw7hZ7&_nc_oc=AdkY9_PADJ7pB3iffN_RWCrRM1nUXa4kRnhu5HtsT4uSzsf1M4NCl3BKegHq1TpX62g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuWqObL530-JPOJq-IQCQLqBxptwffTuXe52_vIV7p33w&oe=699ADD8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noYty4p_BLsQ7kNvwGD0NsH&_nc_oc=AdmiUp8tbInFbXTvrT9WpO3LffwKyuZyMfaqq5KP7UBD2zCjc-xjR3sG7vGbZ3fmprs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft7YrVsV_RiHLh-du5NXq9QRgK2gyVRNQXOBiWVu0sVIw&oe=699AEB01"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [
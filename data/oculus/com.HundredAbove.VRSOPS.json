creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8NRzYyRKdgQ7kNvwE_OSgT&_nc_oc=Adp41PoanCGK2ItKyxuVt5uTWlZo26Q8GuJXUASzENGzTWUeg2X343BNAJ38SJgyz7k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP19lsHwBaLsccBZ0APnuU7Ml_PQN4pka-NGj3yRVTSHw&oe=6AC3D12D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sobqQ8g3owoQ7kNvwHwd7zI&_nc_oc=AdoLkd12Is_TSCJfzmuGCpvtg9_Rj4mU9DN4RKH5ZdoKKZ-nq717V2x5Q8mpcEDuXGY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhKF1zHsiPKmhbGzQs64bUhEW_Z-Zm3AO9eNO4fvU0YQ&oe=6AC3A889"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxDthH0ZXZwQ7kNvwEkTO3r&_nc_oc=Adq8ZAKGKp0WqQkgM7wi0JeLc86xNQULS4bPmvD8NiUthXI2jMo5TUzCa8X86uZYrvI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLnJYY1Ww7f88kVRmKwzAcWIFOXcDv8dlCQJ-R0qXggg&oe=6AC3B6EC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bg0uLlHYrMIQ7kNvwEkC70Z&_nc_oc=AdrEvgGNKqvOJ2o-ryhyJjnTtaIkaQRgaFq8-DsghPdQjGS_-vRYmh1bz_OofWnxuEQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAk077vQJ7U_4hrIRiy69ar62DAmyLo5pcnXvOhVjftw&oe=6AC3B74D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Enzsn95ZidwQ7kNvwFGKhYH&_nc_oc=AdpEKyhzbAcFrvJD7nNKBXb7QMFaRgzkbwSuc2Uoy9yHihnPdp6piv7xYBlF1_BCI_8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGkPuxuQOZweRQSC6KFJL1ZZxQK7eQlYF42bgaPPXyVQ&oe=6AC3C4C1"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
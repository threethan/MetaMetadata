creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l66WjQ8IYowQ7kNvwHPmP_t&_nc_oc=AdoN9kcUHCGpUu9ayk4km4UZmO9VpJO1qGcpfr8zLm-Xlk9gzMIQPtQIlXqe_B0gfxg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Pxuse8JdXNi8SErunfjhOqwK5G5c4yNak9-ZwQN91Ag&oe=69F7406D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rWrJuCQvjnkQ7kNvwGcjc9s&_nc_oc=AdoDQl_Htsy2tbp9XinlMbsY5tjrPVbqVnDW8yNUo0pDWO2x7TOU8LRoGiDWpxCs2lg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1jbnpAK-HN_FQ6gteWrsN9IjU-IB0xSUJW36i5FfF73Q&oe=69F75009"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0hqkDBtgj0Q7kNvwHjY0Q5&_nc_oc=AdpCeq2ECoCP8ucofbDp4kNAs5FoHOzZ6ugBsOJe8vynXGPJMu7f5B13mRGnGMffHIc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1XlovCc_y9LU8AA7wLQqMDx_z8ts4UODlbfnGvNdMQeg&oe=69F75E6C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbUGPVwWEBsQ7kNvwFYvA-I&_nc_oc=Adru1IrRoVojzdsxk53b0PVFIHwVxSnbqtRgeqTymC_ctdQTRyIIQUSXtXE3BMa5Kgs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Mqee581kayqpkMx1nqDQt0JTLtsqJeZlN0IVnE2R_8Q&oe=69F75ECD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PyqnCkSEzrwQ7kNvwHPxSz3&_nc_oc=AdqSpdyvlcRZsOYpTFELMgjapNYdFLE-NJUGaeoyFkrd4qg2uGKalWLfYvpz39lYlqg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1zOIw3HpfN9Ro5hEh01oC4Ld8nF9O0sbp4XAplq7DO4A&oe=69F76C41"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
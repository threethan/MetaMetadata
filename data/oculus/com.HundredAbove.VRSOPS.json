creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8InxOoPRRcQ7kNvwEposLt&_nc_oc=Adq0vF9Uaf-A_pQzGfJAja7KIeEIgYLBXqv186SKVcXHUx1feKkN8lQjAM7LNWHsv5k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QYJK-zrvgHEmLJ2BUTp90YCAz44v2Zdo273fOA4N6Iw&oe=6A3FC2ED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lggDAU1_xOoQ7kNvwFuHIhN&_nc_oc=AdoGkeux7ykcxwFBBVs-tWELuUwO52Lmn_zWmF4MynzzyVOQFAPkH7lt9r6uAnvufk0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IPcLieB3Qxi4Y-cFK4JeLHVXbdC57Ops6l_YiVH_KyQ&oe=6A3FD289"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQIEVeKmhnQQ7kNvwG-91w-&_nc_oc=Adq0fIQgBUvIcqy7eDvepi3Av_GlPFOFK2nnpH9iApxj2oBBbQ3nb2GluTmnW9zyrNE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Yw0gNFqgptpHuFwITRsbMq6Qf1j7rNFal0Vmriifziw&oe=6A3FE0EC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFtzYLFfXBgQ7kNvwFMjKhC&_nc_oc=AdrclvvbcqYIMFMEEn40N19sEJhOMZ-MRBqusYtvsJZTCkDPg2gdjB-un2OsdjG8qn8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hsyjNyWNfH8fY8PqJ7N76SAlnx_mKEZbkc2egWZnOTA&oe=6A3FE14D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blv7Ns6Yl7IQ7kNvwE6QKNd&_nc_oc=AdqsMLE8Pj4nTCQhAwojQsPaC5WvmYI_bbr0hTgsFUmuj93Jk-MX9tmVdAT4m29dr1E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9TuKSrsnA61Us9bcjJKFgrjKUAgZyvp6evVcxxWjKIA&oe=6A3FEEC1"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vS08O4i-0WcQ7kNvwHNlgfS&_nc_oc=Ado_rMOxcAxyq7o5gDMqkRlpvMZAX-5HN-Vb0o-5kqH3AfxbU79rpLprDuk4uZoKlrI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQcnF122puchmQ4mi7zQ_4n5rk6VYdxXx-NEy5D4aqeA&oe=6A7B166D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wu3PvtTiHrkQ7kNvwFsj-yZ&_nc_oc=AdpQlIlTiUqt08F9sasx7JTWmsT2FN6-CAfNk0MU5kgBpJETWXjQJ1pl13Q2GgMRqwk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvEPR5nSKkq6qOERhcrJEgyu9jZgfhCh-nng1rLHu7gA&oe=6A7B2609"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5lNDCxPmC0Q7kNvwE1Qgit&_nc_oc=AdpGVNDsvlgbS1Jthj3fMcOXusrZLrJl3dXygOJFsf2GdTFdzL1QHIUsC3mOsheZ0F0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGe6uBa1VtbMrZf-VrKiskMIeZHa8UaErx6F7MflB5ccA&oe=6A7B346C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InwomdTMa_MQ7kNvwEEKwSA&_nc_oc=AdrYLtqNH6UrCudRVKmtxNLceUwc9ceLy8VV-yD8_NR3qf0BXUoySPiEUfKj-Aj6ivc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtoElpBEJ1XO2sFL6gTPknUIOcxlvV3awwWgGY-DqqHA&oe=6A7B34CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJ_RLkEhcEwQ7kNvwH0OP2I&_nc_oc=AdodH9tg1KikMPGIJJbYoXcdjylh9q2CzydrTFHjpv7zeNMMvvRkXgkL6_JqPCMNJLM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcy7BqmQ5Vco6nYf6HrVOLssdOXbQnjUfJe1Etg6H_EA&oe=6A7B0A01"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
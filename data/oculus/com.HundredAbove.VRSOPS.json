creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8InxOoPRRcQ7kNvwEZgiqc&_nc_oc=AdrKhW31UkRngWuXCOM1VZE94pUxiyU8GGElxutiJk83MrCbFzHsCmUkMQmiE3zZLYY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0So-TN700VXC65fBnnusmPHYpNowkxRQmlgRM5z7xuw&oe=6A3EA9AD"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3cTe1VrCvQQ7kNvwElkoub&_nc_oc=AdorGrm8qLBlpjecLcBITAJhmHQFu6xBi9K4SP6Nwd1MSqAbdR881kwTJPOeuG4Ng3Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vSi6tg5RKYY3g_0N3aXDCs-CZ8Hnhi6T00ZU0EMEXNg&oe=6A3E8109"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQIEVeKmhnQQ7kNvwFlreUE&_nc_oc=AdppWz0U72c03h4UvM8_hek0NCeWQuw1MxzhleYZF84jd47Iykl5m5YLDjAOD3FDh3k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ppNCGVGRidJFogpDNHXtM2I9h2yz5EWsHT1uKXKtexA&oe=6A3E8F6C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFtzYLFfXBgQ7kNvwEY04pV&_nc_oc=AdoqPcNPTDYzr_cAxUWhsE37iF5ny5VdCb9u17iRuHO6D8TixgLXgvZj-DX3yQAd_CA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-i2KufoH-Zbm0kouflaZ56MlNZawa33flaQuvIHzLWGQ&oe=6A3E8FCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blv7Ns6Yl7IQ7kNvwGIBSDy&_nc_oc=Adppl8CL42TYWMDhroEAHqBCHH-g9zpSuhUk2V_6UZJEUiwnOVJYTn_UBBp7UqBIdzo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-E8QbT8U6Uz5vtzcXAg1X2gfHncICyZJzQU3g0IlkJ3g&oe=6A3E9D41"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
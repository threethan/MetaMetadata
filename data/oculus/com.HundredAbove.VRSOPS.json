creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDDZBWys99gQ7kNvwELJr4h&_nc_oc=AdrfQNFrlCYrnXkJt1F-3ywJCj8JLKRWDVIDC17ZBeZlvEqloEcV92YzXPz8DEAqqck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiEe8fz5ADPhJarsMh0LM5h6xwIzwJCxDJc_Azs6wS2Q&oe=6AF498AD"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QSBIpqa9G8Q7kNvwGHrWhK&_nc_oc=AdorsvZksRz790h5X3ZYW1DP-Q-bxoycp2r2XnADrOCaV6I4fdJYtlMkDnrXYMsPJeo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ17wn7qyCmoHUK9S17-muNBwl0PaN9r0x1T1ty5cKEsg&oe=6AF47009"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFRTFiFdBV4Q7kNvwEvUSnN&_nc_oc=AdrdCTkPvyDmtvVK9EGR2407e2UnyhTMAZL3Zx_sKqaBXY3nBbX9j9IiKwlnrVCGs8A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQW1SRbu8OiNanjJ2RCBvnKWmBr9E2BayE1LHg4A-NlSQ&oe=6AF47E6C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRy-Tvx3_ZkQ7kNvwEkTpdY&_nc_oc=AdoXbg7bKeXQaGk_NV8pXpD7dVG7yf6ILVxb2QTeds0Fp3elQYmaoWx6b8cqaVXAgNk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1xBnLuH3_C6XcYpGi0ORLjbmWS-MSEIKP8NbaYgr3kw&oe=6AF47ECD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ge6O04B5odkQ7kNvwGNVi8A&_nc_oc=Adr5w91pSnqiJRmtK0HIN_yCrS8v8zKO0g-LpIw_XK47nB4Whjv5uPF1Z9JCMfUCV8g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZ4XFB2Ujq8uPgjo8tou-AVnDdTsmB7jeRo3pQHAi2Og&oe=6AF48C41"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
49837938", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lf1UwV-voloQ7kNvwGPofyI&_nc_oc=AdkQiSVEAGTzt44eE7RWEtPLt1YsfdHVbSQqCqOr83i_krhdD_Awx8pVgVfKhaDwyYc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwpdxOsca1SVho-JH_vmo8rTK8NF1FX1hDS7ZbAK66pbQ&oe=69B949ED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BM1KyFyi-tIQ7kNvwEh7Ehp&_nc_oc=Adlw3vP0d9AqX1Hq_M00IEicZicRD6bF6lRVhSDcO1tOfAsSj35csWWlBWS36ESyG4s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx4gCAE7lgDX8BfDLHy-dTDfgpW2AC2ARX9xPBPiA6iYg&oe=69B95989"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Siuf_tgEh4Q7kNvwHexVZl&_nc_oc=Adms7Jop7JDhHeWdLaRIlppsZ983e7DLkQgbIXTruglmRNI_cAkkFNBeeMIKYr6x3mo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzD1WlssTdzQqAbKRb_OCl6NA6Id9U81cohK8FEv1tfWg&oe=69B92FAC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5jjosXBvJsQ7kNvwFjvfED&_nc_oc=AdnQL4qi0IGkEebvNHC7MTUn4Z7R1dkbTBz911i6U32LxGaQ5ZQwHODB0aqs5-aSTsw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxmW0VfR7f0BrBwClmSFCZvnZreG6VncqPvR77MAo_R3g&oe=69B9300D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3le987ec9wQ7kNvwH1nlXK&_nc_oc=AdnyoqYCUTeODYTIqfuVZb4zyoMVEc2qo9MWUO9XRV18oH-QsRlOK14MoohgY7Hve3k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxxEfm-bvzRbj83nP6JfXfECSMm5Vgxg3Ek_MdtdDy2zw&oe=69B93D81"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6hM84-4KIcQ7kNvwH7TEwv&_nc_oc=AdrWeCdbRqYy5MJrCyLtL8ScscfPyRCNMh0KDmjzDkSRKP_PeEglur51wwlrNAgyJeU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXiF3_F4dAGuyt2sYkiHyyr3Tzae3QY2uZVRKBuAZGsA&oe=6A64ACED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eR9W0RYacNkQ7kNvwHi895d&_nc_oc=AdoncNhfBC9fpE2bjwSCKYssGbNKlUAx04lnoHut-9H6Y7UOo9Pjv09RDCgHfxffA8A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzQy49CnvFvQ-UFMdO2yKoE8McBe_wTILDSkspeHZMXg&oe=6A64BC89"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXYSBsXGnE0Q7kNvwGGokpm&_nc_oc=AdqX0wXjB8HDWn2CXuLV193H4eh9aqMVigV5wC92zYVptSf37V72Ztjk9T58viGJvQQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFO4aDvAlgFtMJbEM6zNxzjdm0dvl1LJLrkHpvZs4MAg&oe=6A64CAEC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vRUbaP1im3oQ7kNvwGH5lgV&_nc_oc=AdonOD0_OMRydbzxqtSzsn7xeN476d9o2PBjzYxb8x923vVvEAgMhNJBcl7F4j3yzGc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwrjhnGvzXvO-21jlDFaeQNBoFL2hSuMkT3WluaAmGIw&oe=6A64CB4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSK_F-zVJUwQ7kNvwFhF0Uu&_nc_oc=AdqiU6lsFhhoYIcsfLDidykDKRyJVheABtlhmCI8WBosShYy0PC9zXCEqnmY3aygyMg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgFqOZyolTlq8GKOtpKmThzk79uwKXDP4KIyI_1LpLzQ&oe=6A64A081"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
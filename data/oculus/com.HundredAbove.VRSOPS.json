creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klLM1kbqcxkQ7kNvwGxLlnX&_nc_oc=AdpzppKdfpz5Zq25rD7LTzfl33qpyFrRkYQFkP0kvG5N3vtgWr3AyLGr5D8jR860GKY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80yQgwymTQMlnApKjwBQ1JAq0RcDG4i3NTnBADRPjisQ&oe=6A317AAD"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibopffUdNVgQ7kNvwEhK7ED&_nc_oc=AdqhKuDP6RzfgqMp6AIchjGvEUX1UnL-r2TwwP89XPdtxXSBEKQV2u_BySD8qI7Y0BA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8o5ZvmZonVVJMfSp52D6OsmB4sjB76pOqZSuKRbawbqQ&oe=6A315209"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udVBQr4hclgQ7kNvwHGE-w0&_nc_oc=AdqAl4bguTgV-9lY8sPcoMA-ozMiGceQDuznLfOa9u8XdqeevyfIzDXhco5r03o2q1c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DdUmC0QCbiHoskzoaVwQUNMnxokXfqYYcTJBo4FA2gw&oe=6A31606C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hvFj_KItgYQ7kNvwGfJsnf&_nc_oc=Ado3lhWmhMdr9gErnVyefXWFgMhRyPR1NyijQTiwOsOXbLbDXjJtNkSIPHOmgpsQZNU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HdXOFJqcR6Q7dvJaG_eMAuRXhLMAo0460f877VZhZTw&oe=6A3160CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4q8d2WCbjwQ7kNvwFhdHWL&_nc_oc=AdqsSyrWcW_xaYf8q9ZkdhNpmCtM3CC5vIxDBDRioaEM70V2zSvzOEh5EJW3iCnL8zk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ILARD1_LOdAoPbfHMZBr6-Pl1KgqZMcAbU1grozuTVw&oe=6A316E41"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgYsfeaQsuYQ7kNvwFqWqUi&_nc_oc=Adp_18yhdRoLOAbNKSZ2dprkufh_7iksmGyR9zrTudMxvQQLyX2CnnVZnRR8sXkV5fM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6DLW--DXnb0xAx5L8O_BW3AnS4ECU77nwLOweeFW9iQ&oe=6A9EAEED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2shLQXI2LYQ7kNvwE_eK7U&_nc_oc=AdpoDu32UhJTESrccVmcdgTCZ8phOj6N32upyzMVJWe6KoMBObL63EcBi0eQzJxwypo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNC8hrzQr9LlV9btdpkdK1iED-0YSg-7I6NkxDMkZTEg&oe=6A9EBE89"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3pMg7GVpXcQQ7kNvwGVq-kc&_nc_oc=AdrnopNOdgsPbe4lPNf7PEgdPNomKkFY1WI25YpsNle3vdr0YEYji-UKDgCLrRBJHSQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXQ-QocpL0X69Vn-Q_WDfc4RAr-fTdIuKdYRMmrGFyuw&oe=6A9ECCEC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0k3I6xqIHAEQ7kNvwFOUySv&_nc_oc=Ados5AdlfZfzBFjPgDHhbQVsZK8Qt2wT1vD__7X5hg95bFbkT8_nDk7dVajXRL5g5Lo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzeDxDcouhkAYrEvW6lrOhMRpKrh9T_vNpSYf2D286-g&oe=6A9ECD4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxYYg6tH1VcQ7kNvwEzhA7o&_nc_oc=AdomUyrj4pDeZDipUGvd6Hdqb2RDvx8811KS2BXoHtbrtIbH47di8FDXJ_3Bg3DkkFQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhtGkVk90Q5scNrQoj-TVY-sJa8Eu_jG4QraHe1Zx82g&oe=6A9EDAC1"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
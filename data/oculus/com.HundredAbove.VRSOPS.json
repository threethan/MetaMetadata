creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gKJBziqYIAQ7kNvwHUl5Lh&_nc_oc=AdpLKPfj4YVPyd0gXYlJBjp9GhzyNbrz7NnmhToEYpCnRAOOWEzrCiPiCMS8uiSa6_0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAl2HdDfZzaHgueaR3jqo1QD5_uwS_cs8sNvt2ht3x2Tw&oe=6A6B446D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AafdeL0bkMoQ7kNvwGVOtJ2&_nc_oc=Adr_Pka33eu_QIifwzuF0yzNYYQIHhVOM_RcgJnXmNXj66EApPJn2eCTRflIih3WUBM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJBLuNRtC5LxmVZz4M1y-OQwcNartEDTjsdflkyztsVw&oe=6A6B5409"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UajEZhO2fsQQ7kNvwFjaCsD&_nc_oc=AdoURHzhvOnAgyqD5dBhPI9VbMMZdfmACnZhWxFIcaLlY1iTGgbzKxwEvdkPVJt-z08&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzl3rGFPJEAWF22xWT6vvuLWV2NYdChQGXg1VE0xjUjA&oe=6A6B626C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFnG8sKnb0cQ7kNvwFmYOXv&_nc_oc=AdruKCO58Rg4rdL6uGL3YVg12Yuw5APwPtqVnoK3vSZMIVj-DFQUE4HVgN32puUMiMQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqKOuBPdcmvg-JcNCCKQEausdEmJtIXwzv1F1DpDMcbA&oe=6A6B62CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeI-miULBvYQ7kNvwG5z-oT&_nc_oc=AdoSWHOaY3z1uhEgJrm33ttXLcvSCvosbZ67txAtA6InL8YEGMCRMV0WcANYzEBjOM0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0Qe7Ey13-ciP-GkYQZRqeuV5Yj9dEwznrfkIHaR1I_w&oe=6A6B7041"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
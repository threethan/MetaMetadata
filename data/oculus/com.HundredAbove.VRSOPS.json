creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9UFyNl1bKKkQ7kNvwFIZLcu&_nc_oc=AdpYA_kpRX8G4iP9BMkjDBoD13PPUbJOdsL-Y7mQ2plwzzpfI42DEv4urqc2ZYqc4CE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBl87nWYm5ccI9JPMZ6imTqJpBYPaWposaRLOw49tGLA&oe=6A6F38ED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbhyL_UPQK8Q7kNvwFL_kb6&_nc_oc=AdrcleIbv4X4pS5W6IRVQvL_sonbslw11j3MGEng8HTdrbEzPnXX8qeGe6TK8WaMCTg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTFyb3bNW8Q5n58Krj5JzgSVZYNtBzICVWE_2O8s7FDg&oe=6A6F4889"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jK-12NP50y4Q7kNvwGB0j-v&_nc_oc=Adqqk7gm1kZebo-p3CvvoKabVuyGApwq6SIWnB_FHW_8ohDEDRRCPazEuqNUobVtNvA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLE8LBtjCnnIkzGf9-iGMEja67cBRR8cthTcRpKfHFwg&oe=6A6F56EC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPE4bTLX1z4Q7kNvwFcDkSj&_nc_oc=AdpsvzAe1AIPT3tva-2clbrM4uxBXGYW4B76wZpZ3q-8YGWiBdWzj5b5ugI14lBn40Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAF8bKCU9hzdG94P3kiEB9ULAXan-2KTZnuYcTIRs0Zvg&oe=6A6F574D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_B26TupGzXgQ7kNvwGPuoOF&_nc_oc=AdqR9M1Hlm5wDchm_YcFCa3k9dXTX6M-D-bx4BMukC_43K2d4zGhKDETOo5TBvBVhB4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXML3RARy9I1gbgLaiKw5oJPo6WZmOEoO9ricYmil-NQ&oe=6A6F2C81"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
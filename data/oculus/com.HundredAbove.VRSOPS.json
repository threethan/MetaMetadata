creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wf_ItnNCjEQQ7kNvwEkkkej&_nc_oc=AdpqRCurf480Nf9uinNhBQhCSMVeRys8Po3tqO_C4TFPo9CdvsI14BCNEOz6TG3hsI0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNz82jSziBEL4Y2di5nwdo5cQ5KaHSwwXVWpMuBW7VZg&oe=6AEF52AD"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRlc4Bue9xgQ7kNvwF2LuzL&_nc_oc=AdqyLfyFnhRZ6jTkVzDFcWZXVX1dRe4Ifo0L_EImcQrYiN___-O01iU4nz3KhFJYOM8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSL1AkkbuGL-6KK3O-0Knp4sP8AK9llWerpc8QuFgKwUg&oe=6AEF6249"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCiYQ56U738Q7kNvwETJlnj&_nc_oc=Adq5bsIxVSgmCA5f_xXJhhxg6eDgKgqpSKUC1N5qi5mb4tl3cxkrSNplC6-0T75M1K8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKGxeNuitfA1f8FogY9ZU7px_x3qwXNhcseAbFrTGogg&oe=6AEF386C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kt9nVY_VGMQ7kNvwFWTUiv&_nc_oc=AdoYulv2RGT751OZ2ASIegkdEkgTrDgpC8vTD3IiTNAaU3M3CezK39KiNnXuVRsa-wQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR--zBksv4ygtnsJ0ic1ZERdLvtT22Cqg99CcifawvSAA&oe=6AEF38CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BK3E2IxtBEQ7kNvwGUk4k_&_nc_oc=Adr3SD6lRy7pHa4U5V6WWhgNflrAFxbfup4BNhuA0NzBE5lj9XQClDVubbbm_Akl-VA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1hmTCDP1AymUhhl8agCyKBKRQMzw6bQMNHqRcBXByfg&oe=6AEF4641"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
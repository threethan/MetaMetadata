creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BfmaLwyKZoQ7kNvwH0GUtm&_nc_oc=AdrQ8NMcAPcaJSfgc9tYQalBfWruFnK6kG63mV0RI910p8dimtWN_vQV8ppjBrtgvuA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGC-RPdJbwqrHdcF_1oyO0kPIwMc11dMcdEnjNqTtQbLA&oe=6A732D6D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcKOTPV3i8QQ7kNvwFWmXpI&_nc_oc=Adqjy30NSp-z8g8TFcrks8g7hPiyWwVjmguRXFiiSICF8s7tgXoi-Xc-UJZVnJMDV_Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNhHsSiHdtD45c5VG7-A25LWurs190ErUSqJy5d1PNTw&oe=6A733D09"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDuqVrPKPmYQ7kNvwFSqJaD&_nc_oc=AdrwT8yG6TeIuKVwuGcBaHYBg8MgDp9Iates_I2HfR2kQNY2Uzuqx9rdPUQ6_N2n5aM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTxs00DVGw_-rXOzp8JyGMOQNloPFZNjSc5xIYtMyxHw&oe=6A734B6C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GjvqtjoJh0Q7kNvwFUMH1c&_nc_oc=Adqpv7F15xQRD3itgcHY1Po4ASHQ2UTk9vCbl0bAdGVK5jj_ET-46OQ0QwaZsG6obbY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaVwSLCXkV3h1EYXehll_kLFKTt8C9JFs8izTtSjtvjg&oe=6A734BCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOWVXx89An0Q7kNvwETOKeG&_nc_oc=Ado7HUHhCr1X9g0PplnubIbL7kh2VlaD2yMjOimdArsOFiq6xcO8ZsfrZ4edlK-tpDQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeRGYf4abOzlsDYVXCW6FMAs2HYYrzXqsrAc9hzsFxww&oe=6A732101"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
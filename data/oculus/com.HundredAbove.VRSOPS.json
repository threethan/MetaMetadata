creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIzQQo4n4AwQ7kNvwERLsPq&_nc_oc=AdqQkA4HLtFCDCMaJ7ap21u2PeJxnUkn-4FhP42YqwU-7Bjzw8F6P3zeIH2Ub62Ydq4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1fS1ENZOiDFjVxo1Kl-U9DFLQP9cMSPIrvkb81h2iBfw&oe=69EF576D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeEDz88YaN0Q7kNvwF-yJDW&_nc_oc=AdqzDGmXFn7HxV1gQeYcaAEwKnF-WlKhDDg4xbBqGCXPmqmrt4C-hv0ubQAwa188n3A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1AS_kyxONEK7ZKXqyGChWx9JopTyKpzgCk5ooLJ7HoYw&oe=69EF6709"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnFmf0v-C5IQ7kNvwHjqIAh&_nc_oc=AdonRFKzpXv3VRh34s1IdNdVNE9jasclMF-LSMOP2BQLmdnPhxQ6ysCBUl6ezRaDtyY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af34FuKJRK-LA39ohSWeCB2NguCDmZXdHeFV4zA7AekZQA&oe=69EF756C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ON5tEJv9xIQ7kNvwExRW6v&_nc_oc=AdpC6d1wH564xalG07xWW82_mZ0m9gLEZbGTKULdJGgQQfqzCl9XoXAekRB0s7edOtg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0_3pkZgDPWIyhB-yuCYXZsHO2zQzQYPgfLlWu1Fhughw&oe=69EF75CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lO0lk6dEpxwQ7kNvwHcvMWp&_nc_oc=AdqMPJW8UsXO6zF98F8XQESx0bLx6DYPHVYvgVHAVSK3KjVNBcS0yxS2S5xoe6nGDxM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2dRXKXvi8-EyYlLLrEP39SDXwKnIogO0wDyopxTh056g&oe=69EF4B01"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gn0kCePYNYEQ7kNvwGGgReO&_nc_oc=AdoZUO7Dp1GQxoXeCYOGUIzYuZQ_4tCSAtqIZlN0iI23rZbXDU17tAlJyrcSpXu1IeA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPikJMUSn15IdmOB1mp5U7AuevNN6yqqJIRcA4r6uA1sw&oe=6AE099ED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdvoRQ73u-YQ7kNvwFjOV63&_nc_oc=Adp8bNAFcDP2ndcdx-md0SfZ8tAb4abTuPmHD-xYag2FFSlUUXo7n_yZNabBORtK_4g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWFNeGUe_5-fOYzuqhJhvnAV6cZ2NwDYJ7rp1OF5DI9A&oe=6AE0A989"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8afrwS6XVQQ7kNvwFasXjc&_nc_oc=AdrMcxzbwd0_TT68ZeidijyNA02Ide0qMc8ULcNhqM781e5l_d9S35idsfFbraOIR_k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4x2arYqJ-T_VEpoRGUE-SaP1ZX1UBxY_qcG7ZBT4yHg&oe=6AE0B7EC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_Q9VS7cqeIQ7kNvwGFYaFK&_nc_oc=AdqxcqmnEaMX3QbOmrlSMZinKtbd2P_CP6aNpzeSmJ-nkjQ_PlQ6SrTni13jigCiYD4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLDo-9Q08t8sVOKmc-5Bvv8jEX9m05jNeUMW-6zyHq_Q&oe=6AE0B84D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04WtBCmgQ8gQ7kNvwGdZVWj&_nc_oc=AdqcC3wzzxADuZ7DcDlgM7C1-1O4yzZl-jtxZtqO9v8ocmg3XfNQ6RfQ1YPV4XOOMXk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvkf1agtie6xYOXqX11zY3cYcTeJ95KGk5SN0eCZUgaA&oe=6AE0C5C1"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
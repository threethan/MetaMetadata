creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvZ1LOKD5YAQ7kNvwFSeAJg&_nc_oc=AdpE2ez2l8qeNPLCaj1MKbY6UIzYe81Esb5HTyu3P0yFDdVCNxsg0b7ik05doAbID8w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqvfYf3ZsFGhHreC7eFhJcx8ftof_NNYyqu7hvIODQ4A&oe=6A8C39ED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnhiUyT0tkwQ7kNvwFZq7XB&_nc_oc=AdpaO9KBiwxcLBactz5nfIisAxKwiu79Dx5R1b1Ji4IwoKqXpRUWMTJ9rMdwGU-FK64&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzAeIoYtlUkaFNoLvSq_4aMOrUns743SM5rgvwJCbc7A&oe=6A8C1149"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBegUM8EULwQ7kNvwHzcUbv&_nc_oc=AdplnQNxe7E4_tabWM0WLYKWcZsq87tF-bxwvPu4T_iSbY-hsOrlHbMbLANuA1px4Vk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQED1UGN0nLNpld9g5k7y0blCfS4B5gkoIJTCe3XaFbkNw&oe=6A8C1FAC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znZc_VevA70Q7kNvwFfTv2b&_nc_oc=AdrsSZQdXvT3Rz1ZNPY374-bIxWypcpPYtpsSI4qmxEu2dmPRwLg45Idcmvtv_QoDTA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCaVcFD0pRncNGth-mERsrs4Zuu7ALEtvG04EQqjmBtA&oe=6A8C200D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhJxjFSLV1QQ7kNvwEsAl5p&_nc_oc=AdoO8YGEV_m5jh78ptcO6vXn5UGEfTj-tRFOWa9xHtqkb4iL8_CEbycNsA6PMr5Xaqg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxaOJinbmTK32RgtVVNkzyH3OOaouAW-KwAMQLQ2vh9Q&oe=6A8C2D81"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
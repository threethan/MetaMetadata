creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4woc6SzwXW4Q7kNvwGQI354&_nc_oc=AdoIktcs2D9Q40_PhBXCse3NSZNsI029C_sk9jfaN2i-fbHaHh7jFDt-4NKVc5YCeus&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxmWSKNQckrJuRh4wd_BrZFY8vTLUrJSV2nqiyOFgRuIg&oe=69C5276D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eydpnEi-lCkQ7kNvwGDf27D&_nc_oc=AdpNHYyAu9cXGOAr39Zg1FHyztbx-GyvvUFSz_fwmmIwXZgpjnpZs7KoZ2l-F2amCLg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxvuHGKz9eDHmyQ00z3lx-wEhf2wVTmokbnvnK5aede0A&oe=69C53709"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAnfSrfwWpUQ7kNvwH__Rvj&_nc_oc=Adp2eKYFgMXlETT2KgrYmtGeXFGHkgu1UZqbrW9ne6U7nLYDD8ln1-AXYnL9pMm5_L4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwwh33SkZtfB9G4I4qlAvZzo-1IeL53pCTXcDGdI7vjGA&oe=69C5456C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InKEGDvt8PYQ7kNvwH0aUtC&_nc_oc=AdqBqlhiVqqDtNM5RSLOdmmbI2m1eSIZNR35GkoPdM6YKDGHFFPAxj9T401Kb0F6Ka4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxg4slRBk-6BzSz5KaWaXIlPSH9__-mCtxXZJvoz6obgA&oe=69C545CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dAetkYzVSQQ7kNvwFdhqN5&_nc_oc=Ado4gYgXxpmTg7qdRb2WkEytksL1wlFE0cYDcu7OsyY4C_PVqcg44doDQRbqBf1R754&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHGM1S6PKmxFya_1YhuYote6unaZTSjTUqFnOspecmIQ&oe=69C51B01"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
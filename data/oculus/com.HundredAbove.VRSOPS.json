creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E97qpKivMJIQ7kNvwFoA-c0&_nc_oc=AdqdO8Z9pC9zH8x9VN6moPiLpUbzg7VHWbczoTNh5F2mY1TCARB-oPau94KsVL4lZi8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTD28KPWEe5OgbCHZrmO_6qpx562HbrSnZNGrSETr-04g&oe=6AF88D2D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_19GZCgEHxoQ7kNvwGz6sGw&_nc_oc=Adq3q8S9RKbOpOm_GQFBAHYCB5UYgf3vbZ34A9O2uRYR4MNUZo46NS8Y_wNx0S8zqS4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxTEFzob6GPBcBT8gTZfa1BWaaaiL6D_BQvfpwWahQ6A&oe=6AF89CC9"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYzN7O_fQ3YQ7kNvwGAdVFf&_nc_oc=Adq_Y785wurW6rhc1putOpjcf-Hz8MrxUJvWyoi0sZ4ipemadkHLiyLVtMNvyu3GmBk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKugHMi4JqkGmbp2_j-HS9zt9YUP23Y4_vs73vzBsd3w&oe=6AF8AB2C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMcUUFWJm5QQ7kNvwFNDTbT&_nc_oc=AdrdHwCgsqXu_xTnsy9vePuYSIhdCd1-ldStGnnMK_OPErUKqvUFXHoQgGIv70Gv2Og&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqSla4PkleXmA8NzbQIUP58rdW9jVFbHG3Fh2DGqiUbQ&oe=6AF8AB8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsfbtSjnF90Q7kNvwEN6S5S&_nc_oc=AdrkvQKSXORZQ3xVfOWsRCcPrfxwT76WmfykwIB6UWC_IDcMfK3tf96bQ5Md07vbkwc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVAyw7RP5hZgKPcXI1WnD5SgSDvbjoobxekVKIxdZqxQ&oe=6AF880C1"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLus_FAMWOwQ7kNvwH1C8lD&_nc_oc=AdqVPfeu7XxmkEDVYr7WwIhbfLzt9u8z5hXtf0GvFgOmKE3OaIS6CL1lN3aYo3qiWmM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wHBjRZQdAsdGznDTfCdm6ZBatFEuf43Mgtskim1bh9Q&oe=69D64AED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DSqmMLf8wQQ7kNvwErZkkh&_nc_oc=AdpZbSJeC9bQO7EorrJ-imHwzu4uQB79bbfM6McIuBuHi78ThG1uNEnXR2B-GnvYbpc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2u5W_wtTGan7w6G6KegSeRstcZlOvkybxaGMpfpiZV9g&oe=69D65A89"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phcpCZgyDdgQ7kNvwEE477Z&_nc_oc=AdrJQXte-ts_0c1dGxdqsX9bcWnKnboi70fW_a0nHC-iFmHj7DVgUM4a8zAEvQcScDY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XZLA6fXXJ2eyAK7jWA3XFqjlW-Bnlu-kAewT_uIpJqg&oe=69D668EC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPCysjMuJN4Q7kNvwGScBHN&_nc_oc=Adr9tkwQhTlV8C9yhAUn75zf6_nyz4zNn1du3i7yj6FooEsikH7krGDcu_1iSf8o6m0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vKS67vXB727AVMPpQ9VLO7HGfraQ6icmu3s6iJgTwlA&oe=69D6694D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHzZDKOrjTgQ7kNvwHlpUDL&_nc_oc=AdqYXfw0cIAeyHRdJzPK68tYULGAqWtRA6TgzqmuiTOiAbmvni9RVc1Q1oHbnqHqgEA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tIRjqWHnkB4LChDscHcChLsuaGEcEjWdsx3l_ZD9Rgw&oe=69D63E81"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
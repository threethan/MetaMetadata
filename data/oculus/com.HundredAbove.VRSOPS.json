creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xM2R0k8tTsQ7kNvwEu9s1d&_nc_oc=AdrxIvz5O3NZ9tUMomlYlFzvbtu_L9cWBM_BGoKsjhhxRHwiTpzP0ruwwFULRjIjAio&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhQHiNZZckIbhzykR24U6pdbDmKgOW1vqKtikukxwLOA&oe=6AC27FAD"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sobqQ8g3owoQ7kNvwFosP2y&_nc_oc=AdrW7q0-i6B8_ydMF-oTNB7X_HzSvmyaSeSoTofY2hH_HG8Cs_DyInMLbpyPgR9Ga2E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtwk4L-Hp1o8ThSxE4BaFibRGvsF94FcLAmVkOcBDtmA&oe=6AC25709"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LmTbilFwMIQ7kNvwHKn3Lp&_nc_oc=Adrpv1NA9l6oKTR4iP0dsvSFD9kaKCCMh6LXmurNJ9eQNVHDRNrJwTT3odGTOxfxPbk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjoFY13Eucmn4tOiucXxsu_T86nUx2lIHI1JFR8ptBEA&oe=6AC2656C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOzOc9GT6AIQ7kNvwE5B9si&_nc_oc=AdqeB2Nl2URAB5zPz5y5zoUzvmG7K2ys4IBwrggIs-EK6M4_MAXZK4QXr9MN6cn81FA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRxUhBudC_Cc9MvjPAi7RryPdUjM0oOXNfRD6-41LufQ&oe=6AC265CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64v1BrVY2VMQ7kNvwEfUTWE&_nc_oc=AdpAnayN7Rr_OnXpU5UC-Z2Sby2j3rYk3XW6flgHtdpR9Hfu98-RRpwWq5UODuGcoho&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVeITToLx9fc6xHeELWh8UDd7O2l2PzMxVXtRXQOOaMQ&oe=6AC27341"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvC7PizLuhwQ7kNvwGuCRE5&_nc_oc=AdqA1Jfwiqx8gIjjF9i8cYiURenO6TyeqVA_O-OITH_ufaWgyFFQYW3aij53Gn5xC-E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iTP8mdA4q_nwNl5FC6KORk5JYQ8TCcaLywa7LyGRllg&oe=6A05C0ED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbmYL29RbsMQ7kNvwEG59Uv&_nc_oc=AdrhA_iHZ_SdHzfm3e3hTOYuj49FvEV64I9aOk6pBGVtP26U688240FlXQTNZhaloGA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62x4G8nEM6nW6Xwkj3j3yIXVDeK2OPjKsTfE3xeVDBFw&oe=6A05D089"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVP7W4WViUQQ7kNvwEdApXc&_nc_oc=Adqlb2OEPR913DBftIRuAmjjsarwYq3Sn-Qlkx9_KYpXQa8j84OzwmOt6sV9akCRPnc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vSDbhxKF0xg68b3oGiVSAN28BbcwD9HYj6hCv-1UhJQ&oe=6A05DEEC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VyG6yjg7tEQ7kNvwECjxfv&_nc_oc=AdpteYs6KHJmtz6YUzFQu1gIDIukry1oBoxrHaIe9_7rW0ToPWaPQ6SN_il9LmhecaA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ymaYP2B7zbHmeGG2UwtRl8NU3YCRP15vzYv11C3yrJg&oe=6A05DF4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20Ttrbj0ZzkQ7kNvwGY9tnK&_nc_oc=AdqKl6nLFhBCxez0HdhYcuvItjc0rKa_KdDuBjAVNsY2Gm2mGC2ZjemZRU-KDT2iSN4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XFFyl9RfWdp8dG7mZVHZtXWdXm-thC59Gp19kAP9HmA&oe=6A05ECC1"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
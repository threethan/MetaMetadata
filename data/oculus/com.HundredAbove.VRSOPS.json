creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9TVdKYiTfqAQ7kNvwEcB_fq&_nc_oc=Adp8Xz6ySEB-KmqLbzW5yaKOtw0A8LvqqR0wijPXIPFlMCqmoMlkVSZNngDyaZ1lVlY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49JdwLsjBObxRvhzPYM76rhNCm8OOJoBfm_RONWM9Uew&oe=6A01CC6D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKVNl4HgXioQ7kNvwGkEme7&_nc_oc=AdpXHzrV5dlu8OWKmdHOtsAaObj1VGS8qajzVY4xQD5rzGoU6im_zE2L2ww1lOX-Mng&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YNl1hHHFq3-_IVcyjjGSrPWPQJUbrcPtgs7ziBwkiBQ&oe=6A01DC09"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNLyu00e9R0Q7kNvwFu_Xx6&_nc_oc=Adq1LU0P3hskqpuFDTYo1P_aKAbVljJb6UADj-VSGKRuPiTS0-BzLJEBCtRYxEU-tAk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cbGZZuIj5zFUOhU2Dp6vM97K7ulq6pOFZav5jLCjUSg&oe=6A01EA6C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z35LBJ928LkQ7kNvwHvudV_&_nc_oc=AdomHlTtLMDVQhx6hh8wz7xd2TfURQ5SxkXwIH4jfxpNiP6TWeW6CYC-Mt9aacT5bBQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4F5yfnSbvKkRxe52zYqkaG3_XckvLEDY-yVryAR0Im_g&oe=6A01EACD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sM4gwZmB1MsQ7kNvwGshdQp&_nc_oc=AdrcWeeLIW7wEe4ONCzKKYUE8GJ5G_za03LUwboyLtniQJPwdc3zofhlVvK9DpYQkbE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rjnzUrfMJNgfPVUDQ2tequTrP3J6D1dekvSpzcjjGqA&oe=6A01F841"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
AppLab Screenshot 2.png", "id": "284119949837938", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvZ1LOKD5YAQ7kNvwFMIvow&_nc_oc=AdpZ7Na4gobDrAzHbicXyeqMA2X5afYG3fWXMKQ26PmT3dUpBfs1Ka6ALrmNP9zF024&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8zXZZg2qRcNdZeSbVp3uNDJVYn-_Kn_44Ne4crf3TBg&oe=6A8D8B6D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnhiUyT0tkwQ7kNvwFffyK4&_nc_oc=AdppyM74Jqk2Mlne8V9O1j4VnnN-GJZXfXE5JiPAubA39dRvkBpwnUUDnhY6pymdtck&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9zwP7LH7vQS6vrMAQRConYKwFmg9ZshcJl5xktzZhsQ&oe=6A8D9B09"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBegUM8EULwQ7kNvwH9OSEr&_nc_oc=AdqqJkPNAc7ixwryFDEPdvlQ32wE32n3-UD8rFc485T_jNnAVvcno6iYEn7UJ3g5TKo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdOXog2hFwj3J9vXSO0fNIZSk6SdA0lBXahrKDxrqkVA&oe=6A8D712C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znZc_VevA70Q7kNvwH5SNph&_nc_oc=AdpC5yRhNFtKYXJgc3rPW-DG71ou6EaQ11ulKHDCw4ZM51iIYDB9uJHEsNUXmg7oWAM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4OS4Odsh2O4KKgU104Ec7QGNO5zp6hGr6cme0gROL6w&oe=6A8D718D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhJxjFSLV1QQ7kNvwHdRlH1&_nc_oc=AdreuRWw_Fp8UsAEF_EWxA4wOiJbldXtisa1wUSn4wSqrI5s36EgTHmBmUkRVGYh0Wk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVnUUarKvRue90kyhIAh9ccHMPSJXe6W2eV4udMdCXYg&oe=6A8D7F01"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "
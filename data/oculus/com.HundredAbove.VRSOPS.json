creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E97qpKivMJIQ7kNvwFDk0hL&_nc_oc=Adqh4Zk0tHCRrLxa4CWekYd7t3sDV-nG53LsVo61XC2hCQxgUEtMppBBz1laCfQ7aoA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxvc97TGHuhq9YTs8_fwHzXWWwUr0qWpsrCMJCJRnUgA&oe=6AF9DEAD"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFw9NQs5SOUQ7kNvwFmJeI5&_nc_oc=Adr6pwlbVZnSNZwmzJfO0wlrSfvDUompgxZ0ERN8HskmvyyolJnXdONpyBvZAsscvew&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8NQzQXT8NeVOiCtwV829KtANlLJac1buGXpGY-e4FlA&oe=6AF9EE49"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYzN7O_fQ3YQ7kNvwHjaunc&_nc_oc=AdpPVysIbWW84gZSLL4aNND2I_1H87DMDxmOjAwD8PwLmoszKdu-hVx9CIDX0n0V-5s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3cKsKat5NYnb2PjihFjtMhnKlMTBcXeN6aJoMtt3y-Q&oe=6AF9C46C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMcUUFWJm5QQ7kNvwEQakQR&_nc_oc=AdoqoSofF8h2kKrZqyaid0r60QUJeCgIZ2IvGWnDAvG1abIeRPX6aYzhRb07qSZqdKQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHowkSwdhrEA09nWm9JXQn4J_zzoemzdIYCydkKHC6KQ&oe=6AF9C4CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsfbtSjnF90Q7kNvwGznmB2&_nc_oc=AdonatBgOguQ3qes9BBdXE_DgRWteSIdUqv4NUgGApfIVbXf9Imn4CvGfZJi1-gAqqQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSd7c4LAmiKP09O5Sv6U3950I5Lt3GTzXQQfsJZu8icMQ&oe=6AF9D241"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
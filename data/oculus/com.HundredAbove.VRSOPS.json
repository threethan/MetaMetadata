creenshot 2.png", "id": "284119949837938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9TVdKYiTfqAQ7kNvwE_j7CE&_nc_oc=Adpw23FP0slqbgx_ZcAqhB3l96Ozwoz0Cj5JeC-hBQu9fbAqKTx4PV_posJXldokPRs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OC6CUg3SioYBLbBbAwzlZXMnLv0UCVB2d4M-9WnfdAg&oe=6A046F6D"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKVNl4HgXioQ7kNvwGtouxa&_nc_oc=AdqA6-lRkZjem3WJ_HIKAw1WVcxLr2HVcSbFAT8tGloOHG6qAvF1BqEn9DushFtHrZ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wgmv6LKrRCg2RQehlm4Kv99vtuxJM8_17-pNu8Xf2nA&oe=6A047F09"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNLyu00e9R0Q7kNvwGzvxrZ&_nc_oc=AdofPjmrVsbOwtcM6PLsMOfGBFjH_OOZ2jtWjnIVA6ZIAHNhwviBlIKcmTpeib8Pl9Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FO0v0Qba9f5W51uPWlz7FiIITMyEQhC2uAAk8ogWFww&oe=6A048D6C"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z35LBJ928LkQ7kNvwF1VKIh&_nc_oc=Adoh3IXWAffMjFniRGBUmn3Mre0ISBASA7_v79BV61qoCYuhqOC8HmXVx7eHOpwN32E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kmIQYdOu2Pq_4_Y9HPbBIutzfGbVnbxhVrYKHHM_CZQ&oe=6A048DCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sM4gwZmB1MsQ7kNvwFI9mo0&_nc_oc=AdqAXzK-xwmfqz2mEk5c3Vj4ogqB1A1M48GPZBEE4tAO5LQJIf0m_PwDXUCS72c95kE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LQOGqx3X4agDPXnx443NDN2IG2ZhUNyr0-iBKTcVG6w&oe=6A046301"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_
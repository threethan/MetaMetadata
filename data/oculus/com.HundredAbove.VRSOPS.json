8974450_284119953171271_8790641444681015375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtpuTrq6h6gQ7kNvwEW0oy2&_nc_oc=AdkNSmjePKr5YVeNcnvf_kJDIWlqb4oWdLID9GMD46L54xOzaDwHj7vnGxodLyOnlig&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftrM8UCpprs2XYqbNMGu5Wocd872NmuMlTNiMhwNfVlOQ&oe=6999A5ED"}, {"file_name": "AppLab Screenshot 3.png", "id": "880768772646094", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570301_880768775979427_3486734161103675895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7y-nFl2xyskQ7kNvwGEjYvg&_nc_oc=AdnYegY1j_tpbSiy7f_LDpBsvEio9CZaDWDGwSksyPvobpz6qyqD5gm5jNYobQhNUo8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuAAUS2WsVw9fOpTWBpIpLNjI-4g-kqxH4ZThLfN0Nmww&oe=6999B589"}, {"file_name": "AppLab Screenshot 4.png", "id": "209451007882379", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_209451011215712_8478063626258908555_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKG-e_5uA6EQ7kNvwEwUB1y&_nc_oc=AdmNjD8UZuJVrLhrfKcSa58fzNwYU7cDeszuQ7ZyCNs-1f_9hMI2-bxS-bACFWSx-48&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuxvh8rhrDro49y66RpfJVYjE09vJFxdeClHQR_cddAWA&oe=69998BAC"}, {"file_name": "AppLab Screenshot 5.png", "id": "1495615514140159", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_1495615517473492_3593172291752190047_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fG1OOW76BDgQ7kNvwFTt6xu&_nc_oc=AdngvC8wRVSd-BwLn6coe0NQqrn3-0GReJoUyjG9ZWwpzf-CaHoAZljMKmV-LaQJ-2o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs9393Ligz1rAR_cuKROFVlDHDtDGLE0DcqM3Xc5eF7-A&oe=69998C0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab Screenshot 3.png", "id": "373560870810024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974861_373560874143357_4189159873596381403_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGn4DsugxAQQ7kNvwHZPIUa&_nc_oc=Adk4bTuLmqvRYBYsRG7w9dTRyT0141hMBi06n-i10JrfXJ2DfIH9Wg06UA2CN5rBWPw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvtWEdw3AovJ8nQJu0Q2R9aw98Kxnt2rxNcrcwEqakjcw&oe=69999981"}, "display_name": "VRSOPS a320", "keywords": [], "long_description": "This is a Virtual Reality Standard Operating Procedures Trainer. The user can practice step by step the checklist items of an a320 aircraft. With each update we will be adding more checklists. Starting at the gate with engines off and external power connected. Low visibility for taxi, takeoff and landing.\nThis app can help users memorizing the checklist and increase the motor skills. Each step requires the user to touch with the hand to reach the item. \nThe app uses either hand tracking or controllers for interaction.\n\nThe following checklists are included in current version:\n- Preliminary Cockpit Preparation\n- Cockpit Preparation\n- Before Pushback or Start\n- Engine Start\n- After Start\n- Taxi\n- Before Takeoff down to the line\n\nWe are working on more checklists and we will be adding more in future updates at no extra cost.\n\nPlease visit vrsops.com to order a license.\n", "short_description": "Virtual Reality Standard Operating Procedures trainer. a320 version.\nStep by step checklist for normal operation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://walkaroundapp.com/vrsops-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hundred Above Software Design", "support_website_url": null, "website_url": "https://vrsops.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [
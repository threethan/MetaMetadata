QrZB3FpdCWsyjck9ACtl0Ku7fHV7hoL4Q61b-FYtIXd1wQtM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxKIx7RD7mB62XYWGb90OH1vo6G_hqXE39uGZF-SGsmfA&oe=69BBDF34"}, {"file_name": "screenshot_2560x1440_2025-03-08_00-52-53.png", "id": "1030307155612662", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_1030307158945995_2838552443727721109_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsvvLEtOdbQQ7kNvwGocKXl&_nc_oc=AdkrA3NoBXf16pp0tCW3Qo34Gwv_lyFFetsmov_hUT2A9dP2XK_oLMWEzuLkcSLGNSU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzGrKztanTsYXJ0-p98oL5hq4fYH1_XcPJmNrmjnsaQ9Q&oe=69BC0577"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Personal Leadership VR Training", "keywords": [], "long_description": "Experience the most advanced way to learn personal leadership skills in the comfort of a VR headset! Complete adult learning activities and watch at-home and at-work scenarios in this hands-on training. Gain the skills you need to manage your boundaries and time, ignite action and create personal space in order to live more intentionally. It's time to be empowered! Take the 15 minute training modules at your own pace and complete a quick knowledge check at the end to validate your learning. You can email yourself the training material and explore further resources provided to you. ", "short_description": "Experience the most advanced way to learn personal leadership skills in the comfort of a VR headset!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://leadlivelearn.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Lead Live Learn", "support_website_url": null, "website_url": "https://leadlivelearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "gen
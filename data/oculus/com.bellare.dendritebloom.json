_nc_ss=7f20f&oh=00_AQQjvTVdRIMUpwVrR_I-ah_VAldD8Ees2-izkaH36BYEzw&oe=6AF203EA"}, {"file_name": "05-missed-holes-marked-2560x1440.png", "id": "1533855135175757", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593776279_1533855138509090_7248296849720717676_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiHFyhrKAJkQ7kNvwFyz4q6&_nc_oc=AdqKkXEaukSblkEnukj2SrGTQENAmGJwV4Cjkg8ukKg6EfPedlcRVWyMCMijghyVRpQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJX5CbK7mvU5prpDA5uS6OUpgJ9I4m40A0eQbuceL0pg&oe=6AF1D7A6"}, {"file_name": "06-a-connection-forms-2560x1440.png", "id": "1655517742582867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623179_1655517745916200_5870243155966219478_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDpTMa09A00Q7kNvwG2CDbR&_nc_oc=Adq9SsyHPUimh3h9WhdvyuXgH95yvlfUhykflzm8L3J3MeSlLsaYyYmeQr_vyqMSFEg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStVGRWs87kVwfE7C8zfylMhxsRfPej0vVJswPYfufpCQ&oe=6AF1DC87"}, {"file_name": "07-roll-the-hue-orb-2560x1440.png", "id": "1100078655997526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628893_1100078659330859_8923934001109069712_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsXaBqUekE0Q7kNvwG5Udzt&_nc_oc=Ado5-xY0s5Kn8tiG76Z6w_mASOHohT78buBZaZiwfXYN6OL87NHJ_bzUlNwE40-VJX0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFrp5UWVV_duIyrkL3OkvUHxIaohZqV_JZ5VFUfNGUng&oe=6AF1D86E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dendrite-bloom-trailer-cover-2560x1440-v2.png", "id": "2867063676999670", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593716858_2867063680333003_5293190039769962085_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1R-sgvFZHQQ7kNvwHWv8Nv&_nc_oc=AdqNcACqSOZU4LDjKgUpfWpl5Qvd-Q-F7gPmS4jQ-o_pebHWfHqqe3p5tNf9_ukhXwo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXPaHQnPZYUUglXASO2jik0dIx1-jHozXhWVpmvabvbg&oe=6AF1E2FE"}, "display_name": "Dendrite Bloom", "keywords": [], "long_description": "Step into a quiet neural garden and give your spatial reasoning a hands-on workout. Dendrite Bloom turns cognitive practice into paper-folding puzzles you can touch, explore and solve with your own hands.\n\nFold virtual paper, imagine what happens inside the stack and mark your prediction. Check your answer to watch the paper unfold and reveal the result. Each exercise adds a connection to your glowing neural world; returning to a tricky puzzle and solving it strengthens its existing dendrite.\n\nDiscover 20 progressive levels with 200 authored exercises. Begin with simple folds, then explore short folds, diagonals and layered patterns. Work backwards from a target, find where light passes through every layer, follow ink through the top layers and fold entirely in your head. The final designer challenges let you choose your own creases to create the target pattern.\n\nComplete level 20 to enter Infinite Bloom. Fresh puzzles are generated on your headset, with an adaptive mix that gives more attention to the mechanics you find difficult. Missed exercises return for another try, while each five-puzzle session grows a neural flower in an expanding spiral garden.\n\nNatural hand tracking, an introductory tutorial and optional fold help support your practice. Move the paper into a comfortable position, revisit weak connections and enjoy soothing ambient music. Your progress and garden are saved between visits.\n\nTake a quiet moment, think in three dimensions and watch your practice bloom.", "short_description": "\nGrow a neural garden through hands-on cognitive puzzles. Dendrite Bloom invites you to practise spatial reasoning with natural hand tracking: fold paper, predict patterns and discover how holes, light and ink move through its layers. Explore 20 progressive levels, revisit tricky exercises and unlock Infinite Bloom, an endless adaptive mode where each session grows a glowing neural flower. With soothing ambient music and a garden that remembers your progress, make time for a little mental growth"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dendritebloom.com/privacy", "developer_terms_of_service_url": "https://dendritebloom.com/terms", "publisher_name": "Bellare", "support_website_url": "https://discord.gg/Gb4tP2hff", "website_url": "https://dendritebloom.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1275035385704440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620414_927133440225239_4632915514655117540_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x12Fj4Kbd90Q7kNvwETzuFw&_nc_oc=AdqAEXQUaXrBn69PexIdHIKPqXE2WRnjy1EQ2O_m6kh9r_DGOwtb6HPGGo5e6ttGT7A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1IO_M9Lbuf92dvrXWT4V_3NHHqnWXRAQZLTpxRKf6XQ&oe=6AF1F622"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dendrite Bloom", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1791836280, "lastRevision": {"nodes": [{"id": "1275035395704439", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale
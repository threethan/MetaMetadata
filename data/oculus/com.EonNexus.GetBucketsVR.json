{"file_name": "04-SCREENSHOT-2-arcade-2560x1440.png", "id": "3568530729994190", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491831569_3568530736660856_348959873833664569_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdUMgwFzSPYQ7kNvwHB0d00&_nc_oc=AdryMIOdCZ02AQbxgPNg6XbzfB6sYN8ZqwHUErxVYNhHcJKH3tx_BoEfWA5Z92JeElc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCgzoSX1dSK1k9-Fkcu3nWN9o0SoJOTY_ZiT3j-tJryg&oe=6AF9CFE1"}, {"file_name": "04-SCREENSHOT-3-3pt-contest-2560x1440.png", "id": "2143057199614618", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491831393_2143057206281284_6759429296646740533_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgzoXKgmMRIQ7kNvwEd8-SA&_nc_oc=AdorUFHe4pqSLECF1AYo4O76uAb9zOcADnJ11JhgnUX_7-DCD-nSUsV3jx_bZ6s6X5g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQv2Tk3UkS-OXoMl2eBv1O73kdQMVNExUbl6sQTMeHIPQ&oe=6AF9EB5A"}, {"file_name": "04-SCREENSHOT-4-challenge-2560x1440.png", "id": "2653672971757131", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/595129854_2653672975090464_5361257169100265712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRsB-Yb84soQ7kNvwHe8smH&_nc_oc=Ado-RJBNUTNJDNT5l0C9WpGjvtBF36DZn_epxJmAE8J24-Sf6WgyGiipY_QtCftTSsA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWxa0g7TDj4-86lfDuU9M2JWlNu22P9x2ZDYu2SlATSg&oe=6AF9EB6D"}, {"file_name": "04-SCREENSHOT-5-limitless-2560x1440.png", "id": "1741008347173243", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/673536876_1741008350506576_4635242853193952879_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-rk28u8RhcQ7kNvwHfgnF-&_nc_oc=AdpIqsRde3fVFWLIk7M3QLapKGmnneBhejAYV25zTjyNcr-GYMP7mG33OU8U7PjZ0fw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0f3hWgc4WJT0yn9ILy5_SR2-pQ7HfICxZce3trVyBLQ&oe=6AF9C7F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "4579358639016379", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821796_4579358642349712_5050127631611745503_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0TzNzweT9cQ7kNvwGcVT0A&_nc_oc=Adr2pKKcAUzpvkxNhZVjnwKTzSm56amf5lKaNEbimVJoT9SSy7d_bskYwZy8_V-2bnE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDU-EkWtBqpD8MMM0QRcsVj7p4bESSDG6XlnYuTGyY3g&oe=6AF9E2CB"}, "display_name": "Get Buckets VR", "keywords": ["basketball", "Basketball", "sports", "Buckets", "Shooting"], "long_description": "Backyard basketball without the part where you chase the ball down the driveway.\n\nGrab a ball off the rack, feel the swing, release at the top. Every ball returns\non its own, so there is nothing to retrieve and nothing to break your rhythm.\nJust arc, release, and the sound of a clean net.\n\nLIMITLESS\nTeleport to any spot on the floor and shoot as long as you like. Corner threes,\nelbows, the free throw line. Every attempt feeds your lifetime percentages.\n\nARCADE\nBeat the target before the clock runs out. Consecutive makes bank bonus time, so\na hot streak carries you further than a steady one.\n\n3PT CONTEST\nThe classic format. Five racks, five balls each, 25 shots. Regular makes are\nworth one and moneyballs two, and you choose which rack is loaded entirely with\nmoneyballs before you start.\n\nCHALLENGE\n15 handbuilt trick shot levels. Arc over blockers, thread floating rings, bank\noff angled boards, and time the sweeping panels. Three makes clears a level, and\ndoing it in your first three balls earns all three stars.\n\nMAKE IT YOURS\nSwap ball skins, recolor the court, lines and spot beams, and set the music to\ntaste.\n\nYOUR NUMBERS, KEPT\nField goal percentage, threes, twos, best Arcade level, best contest score and\nevery Challenge star carry over between sessions.", "short_description": "Pure shooting, no chasing. Grab a ball off the rack, rise up, and let it fly.\nFour modes: freeform Limitless, timed Arcade, a five rack 3PT Contest, and 15\ntrick shot Challenge levels. Every ball returns on its own, so you just keep\nshooting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sidescout.ca/privacy/", "developer_terms_of_service_url": "http://sidescout.ca/terms-of-service/", "publisher_name": "Connor5477", "support_website_url": null, "website_url": "https://sidescout.ca/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1428331807024028"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491831393_976629175488600_1263798423226620829_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GG_tKEjPCVYQ7kNvwGPiEar&_nc_oc=AdoATL8DlJHNBOvkjGQs0Z328ilLWXf710yg3NKB7CB4iQicUojTgvmJ7jrj9P_RHGw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfJhcrPfNn0bKmYLAY6ou_epiWCMXkI1vbX2ED8iOvAw&oe=6AF9C028"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Get Buckets VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1789945200, "lastRevision": {"nodes": [{"id": "1362626870261189", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1362626856927857", "is_first_pa
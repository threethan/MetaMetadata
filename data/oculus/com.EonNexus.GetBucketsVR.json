s8CK0e1soJHE74V6d1fpQ7EJ8ixX11K-NFLGYCQGaY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSHJsAhalSxg2k7pDR2L1nysPPjYE-Nrxc9nZ5vFpd-kQ&oe=6B0B2D2C"}, {"file_name": "4_challenge_arena_night.png", "id": "1435517015403848", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/908842257_1435517022070514_1476981230218883514_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ojemEqo3MAQ7kNvwEEn_7Z&_nc_oc=AdrBGlQm87RbWSl5c19WrZFHZaKQa7wyhBrENe4zcumT17PRGL_iwaKK2fVswxHMHVg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQoZugiUECIW6sSC1Eh3s_HqBT5vHLPqBVPa8jmaiv_OQ&oe=6B0B1074"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "4579358639016379", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821796_4579358642349712_5050127631611745503_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsspf-DjMFgQ7kNvwEUYg0p&_nc_oc=AdoeifetC1KCDfFGMWOlfbJTKJaQCnXSIKGtAfTtBekN-5I2X-Q_WgOQlDRoZQ_DyfU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ2ZcgkQK6d1jY9YxaI9zoFJa1GnVlKX7M8eru49Yzhsw&oe=6B0B3E8B"}, "display_name": "Get Buckets VR", "keywords": ["basketball", "Basketball", "sports", "Buckets", "Shooting"], "long_description": "Backyard basketball without the part where you chase the ball down the driveway.\n\nGrab a ball off the rack, feel the swing, release at the top. Every ball returns\non its own, so there is nothing to retrieve and nothing to break your rhythm.\nJust arc, release, and the sound of a clean net.\n\nLIMITLESS\nTeleport to any spot on the floor and shoot as long as you like. Corner threes,\nelbows, the free throw line. Every attempt feeds your lifetime percentages.\n\nARCADE\nBeat the target before the clock runs out. Consecutive makes bank bonus time, so\na hot streak carries you further than a steady one.\n\n3PT CONTEST\nThe classic format. Five racks, five balls each, 25 shots. Regular makes are\nworth one and moneyballs two, and you choose which rack is loaded entirely with\nmoneyballs before you start.\n\nCHALLENGE\n15 handbuilt trick shot levels. Arc over blockers, thread floating rings, bank\noff angled boards, and time the sweeping panels. Three makes clears a level, and\ndoing it in your first three balls earns all three stars.\n\nMAKE IT YOURS\nSwap ball skins, recolor the court, lines and spot beams, and set the music to\ntaste.\n\nYOUR NUMBERS, KEPT\nField goal percentage, threes, twos, best Arcade level, best contest score and\nevery Challenge star carry over between sessions.", "short_description": "Pure shooting, no chasing. Grab a ball off the rack, rise up, and let it fly.\nFour modes: freeform Limitless, timed Arcade, a five rack 3PT Contest, and 15\ntrick shot Challenge levels. Every ball returns on its own, so you just keep\nshooting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sidescout.ca/privacy/", "developer_terms_of_service_url": "http://sidescout.ca/terms-of-service/", "publisher_name": "Connor5477", "support_website_url": null, "website_url": "https://sidescout.ca/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1540255515831656"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831393_976629175488600_1263798423226620829_n.png?
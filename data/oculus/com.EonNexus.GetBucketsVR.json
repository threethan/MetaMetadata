id=6e7a0a&_nc_ohc=1sKevOYG2TYQ7kNvwGFznqR&_nc_oc=AdryFRVb1tnFjlgi79CeMwyr0mQhsQbgOP2_-DlexOEP8-yO4o3PwQg3IEr5gkF7_LQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQzCyK0iTDYV9zBptMnnUBqJO3yFNO0Tn1jnWzdSlK0Ng&oe=6B0B2BA1"}, {"file_name": "04-SCREENSHOT-3-3pt-contest-2560x1440.png", "id": "2143057199614618", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831393_2143057206281284_6759429296646740533_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5bpQrQTtRwQ7kNvwES26as&_nc_oc=AdqlQd2ZJTXJnKMNj0gxul7bjh878Rp6yJAPXDZsbKeS1x2d425ve49cnj4LzOIQ9Vo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSCaCcdWLAjsUsOmwy93DxJ156_W4Cq8WinhdM33l11cg&oe=6B0B0EDA"}, {"file_name": "04-SCREENSHOT-4-challenge-2560x1440.png", "id": "2653672971757131", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/595129854_2653672975090464_5361257169100265712_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtfFUFCcMXcQ7kNvwHPuyAv&_nc_oc=AdqnEsbx9bn0cvXW8a_YBkW6mZ83-jWjj7IcvoKWoAjzjYJcDBzpNW8lbEErODhO-s0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR4exL23syrPuWyTFLtO0Czw2PfCO0JKMdqPcCAiIKrjQ&oe=6B0B0EED"}, {"file_name": "04-SCREENSHOT-5-limitless-2560x1440.png", "id": "1741008347173243", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/673536876_1741008350506576_4635242853193952879_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PlWT7ewlk0Q7kNvwGkNpHC&_nc_oc=Adr59RaUnapw2TFpDAAd6Z1bLMYkKElg7ODilexU1KV2XQTzTRTs5MJroli4qRz9xcU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ3-YpaoVbPME046vr8ENYIkcwUtWaBBxItt5z2YSCu_Q&oe=6B0B23B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Get Buckets VR", "keywords": ["basketball", "Basketball", "sports", "Buckets", "Shooting"], "long_description": "Backyard basketball without the part where you chase the ball down the driveway.\n\nGrab a ball off the rack, feel the swing, release at the top. Every ball returns\non its own, so there is nothing to retrieve and nothing to break your rhythm.\nJust arc, release, and the sound of a clean net.\n\nLIMITLESS\nTeleport to any spot on the floor and shoot as long as you like. Corner threes,\nelbows, the free throw line. Every attempt feeds your lifetime percentages.\n\nARCADE\nBeat the target before the clock runs out. Consecutive makes bank bonus time, so\na hot streak carries you further than a steady one.\n\n3PT CONTEST\nThe classic format. Five racks, five balls each, 25 shots. Regular makes are\nworth one and moneyballs two, and you choose which rack is loaded entirely with\nmoneyballs before you start.\n\nCHALLENGE\n15 handbuilt trick shot levels. Arc over blockers, thread floating rings, bank\noff angled boards, and time the sweeping panels. Three makes clears a level, and\ndoing it in your first three balls earns all three stars.\n\nMAKE IT YOURS\nSwap ball skins, recolor the court, lines and spot beams, and set the music to\ntaste.\n\nYOUR NUMBERS, KEPT\nField goal percentage, threes, twos, best Arcade level, best contest score and\nevery Challenge star carry over between sessions.", "short_description": "Pure shooting, no chasing. Grab a ball off the rack, rise up, and let it fly.\nFour modes: freeform Limitless, timed Arcade, a five rack 3PT Contest, and 15\ntrick shot Challenge levels. Every ball returns on its own, so you just keep\nshooting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sidescout.ca/privacy/", "developer_terms_of_service_url": "http://sidescout.ca/terms-of-service/", "publisher_name": "Connor5477", "support_website_url": null, "website_url": "https://sidescout.ca/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED
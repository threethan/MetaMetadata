id=6e7a0a&_nc_ohc=sm-XqKLY_NAQ7kNvwHrGZ-n&_nc_oc=AdofajS4OBoQvWQC2jyqMKvY2r7UHD9LJ1niWqsTYljogwQi3KLjOXy0jETvR0io9EQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWH3iJ6zya3VWRR6JFsG7voFR3YYS7M755eLkP9Lsf6cA&oe=6B0F2021"}, {"file_name": "04-SCREENSHOT-3-3pt-contest-2560x1440.png", "id": "2143057199614618", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831393_2143057206281284_6759429296646740533_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3HYI_Q7ni4Q7kNvwEM7l91&_nc_oc=Adrdk_CIfzdMNPqcbURkOM5AAvLW_rIezPU6BBiFAdZUS9PwZNCyRIDWmQeItXN3r-4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVu6fnKWG2cOHLSBCudYP8DhDYgeYc5vau7-DWcNFAUVA&oe=6B0F035A"}, {"file_name": "04-SCREENSHOT-4-challenge-2560x1440.png", "id": "2653672971757131", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595129854_2653672975090464_5361257169100265712_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93MJmYsDH3QQ7kNvwEYCfew&_nc_oc=AdrLcOtmny_mSbwfeLSnyN5-p-FeD9mZ4teTSe7junOS71Sb0Fd7vFuLqeLql2aYPKI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXqN0mFmUoj0ZwdJp5w8PDPvxB7fL433GTV5hosWBNk4w&oe=6B0F036D"}, {"file_name": "04-SCREENSHOT-5-limitless-2560x1440.png", "id": "1741008347173243", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673536876_1741008350506576_4635242853193952879_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4LHsiT4gFoQ7kNvwEcPRzu&_nc_oc=AdoMvdYowcQ-ICrSPiOhrkhLMyc7Cyd42gyeH6v_GvJMhvNirbx3svZwhS85jEGiKck&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUGMQSYwnlHz7LVQjIqTH3JmFaMX7ovOM1fV3bfEJWWJw&oe=6B0F1830"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Get Buckets VR", "keywords": ["basketball", "Basketball", "sports", "Buckets", "Shooting"], "long_description": "Backyard basketball without the part where you chase the ball down the driveway.\n\nGrab a ball off the rack, feel the swing, release at the top. Every ball returns\non its own, so there is nothing to retrieve and nothing to break your rhythm.\nJust arc, release, and the sound of a clean net.\n\nLIMITLESS\nTeleport to any spot on the floor and shoot as long as you like. Corner threes,\nelbows, the free throw line. Every attempt feeds your lifetime percentages.\n\nARCADE\nBeat the target before the clock runs out. Consecutive makes bank bonus time, so\na hot streak carries you further than a steady one.\n\n3PT CONTEST\nThe classic format. Five racks, five balls each, 25 shots. Regular makes are\nworth one and moneyballs two, and you choose which rack is loaded entirely with\nmoneyballs before you start.\n\nCHALLENGE\n15 handbuilt trick shot levels. Arc over blockers, thread floating rings, bank\noff angled boards, and time the sweeping panels. Three makes clears a level, and\ndoing it in your first three balls earns all three stars.\n\nMAKE IT YOURS\nSwap ball skins, recolor the court, lines and spot beams, and set the music to\ntaste.\n\nYOUR NUMBERS, KEPT\nField goal percentage, threes, twos, best Arcade level, best contest score and\nevery Challenge star carry over between sessions.", "short_description": "Pure shooting, no chasing. Grab a ball off the rack, rise up, and let it fly.\nFour modes: freeform Limitless, timed Arcade, a five rack 3PT Contest, and 15\ntrick shot Challenge levels. Every ball returns on its own, so you just keep\nshooting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sidescout.ca/privacy/", "developer_terms_of_service_url": "http://sidescout.ca/terms-of-service/", "publisher_name": "Connor5477", "support_website_url": null, "website_url": "https://sidescout.ca/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED
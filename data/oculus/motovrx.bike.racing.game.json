om&_nc_ss=7a30f&oh=00_Af0_ghJYiU2wU9IEXXtnrZQcoknRB2SgOyWe9dz2wq5FEA&oe=69DA3132"}, {"file_name": "Screen-5.png", "id": "2019536228834071", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819982_2019536232167404_5597961447745592371_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tx82BWU5oIIQ7kNvwFLTVg8&_nc_oc=AdqEFWWlpdFG_kQJ31zZk_jIfdZL9UPYlbBq0lX2Dehx6FE1Z00BC8-Vl0hdAJXqJcI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2T4Kdi-AxW373WxgWiTlfQ1mLZ-XZyBKMLn1Td3FYLuA&oe=69DA4F3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-1.png", "id": "1929819555081086", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823783_1929819558414419_7468795062657877876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01V3V17sa7gQ7kNvwFhMFIG&_nc_oc=AdpYPvHvYid57F7DPO3KmBjCGq_k96neXYmOacDE7dscq0fGvjd2qAQm5ZFwJCps4gk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oc74SwgCZHl7nPMyN_4DniQgewQQ6ebmyUoKqJ-YiOA&oe=69DA2F90"}, "display_name": "MotoVRX - Bike Racing Game", "keywords": ["motorcycle", "racing", "circuit", "driving", "bike"], "long_description": "MotoVRX is a racing game that boosts your bike driving skills by taking you into a fearless racing smash. Release the crazy bike rider within you, prepare yourself for new motor bike driving games, practice on the real racing track with other street racers, and set the bike race tracks on fire. You can also select your favorite racing bike in a mega bike racing game and enter the classic infinite highway ride among heavy traffic away from the mayhem of city. Hurry up! A thrilling bike racing game with a fearless bike simulator experience awaits you.", "short_description": "Enter the classic world of 3D bike racing! Become a bike racer, gear up for a real bike driving experience or burn asphalt on the highway in this epic motorcycle simulation game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skippyapps.com/privacy.ht
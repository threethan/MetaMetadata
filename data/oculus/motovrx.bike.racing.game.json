FLtnQ7&_nc_oc=AdrEN57ako0NM1Qc2W5vAzsbA88vAklnxkKtOEmMoamDajxeePlXtq3PLe-36YLG47s&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzc4sfN8PIK7o48fUCnXiVp1H7b21Y9nQ5AVS4leatAw&oe=6A58C132"}, {"file_name": "Screen-5.png", "id": "2019536228834071", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491819982_2019536232167404_5597961447745592371_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nv_1uWdK6m4Q7kNvwFUIdct&_nc_oc=Adr9vaTYsjAjDu-n-5lpE5WInmFHm1A1xGJoHySnZ3h_gw7xfrLtolXhmSVTx1Zwj4E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDatFhGHnqKwCYxTkpAC98zKkjYLaOg0KGiq52QDDV4XA&oe=6A58DF3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-1.png", "id": "1929819555081086", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823783_1929819558414419_7468795062657877876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWsQFy3LyzMQ7kNvwGG5RrZ&_nc_oc=AdpzqXk3ddSf5jjRtinaJSrEIlNNUzFOM1Sj1vysuRG6TrBmFZ66KQKaYx-QwYo6sno&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnM3YkRkP9n-AtRbIul4FXaGgdVDB7R8L_5nB4zK9-_w&oe=6A58F7D0"}, "display_name": "MotoVRX - Bike Racing Game", "keywords": ["motorcycle", "racing", "circuit", "driving", "bike"], "long_description": "MotoVRX is a racing game that boosts your bike driving skills by taking you into a fearless racing smash. Release the crazy bike rider within you, prepare yourself for new motor bike driving games, practice on the real racing track with other street racers, and set the bike race tracks on fire. You can also select your favorite racing bike in a mega bike racing game and enter the classic infinite highway ride among heavy traffic away from the mayhem of city. Hurry up! A thrilling bike racing game with a fearless bike simulator experience awaits you.", "short_description": "Enter the classic world of 3D bike racing! Become a bike racer, gear up for a real bike driving experience or burn asphalt on the highway in this epi
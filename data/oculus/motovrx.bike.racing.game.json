om&_nc_ss=7a30f&oh=00_Af35_J_OhaJtzuqv2ZnpX6IsVityKcuiNNyjAbBQEbDTaA&oe=69EA3B72"}, {"file_name": "Screen-5.png", "id": "2019536228834071", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819982_2019536232167404_5597961447745592371_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzD3aJqb7AEQ7kNvwEulS6K&_nc_oc=AdqmXLEq6vyA08_uzQQHDiiQyJsqu5zLtY9pnLQQQvkzecibei0kfmR7prqYdSKMAFw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KHCm79rfionmuZYNjzqLDdGR-njNcZ-FHLkNI356ZmA&oe=69EA213A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-1.png", "id": "1929819555081086", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823783_1929819558414419_7468795062657877876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXZfW8CWLUcQ7kNvwG7yk62&_nc_oc=AdpUsPJvY0kVMRggsCk4ODISppqNI8IHLVceopgr1vjmSfmvzMbD2jih_haH99pGaj0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vY0c37RlNCEMYs-M0-QCjgib_WKiBrNtAbJ1dI8TMXg&oe=69EA39D0"}, "display_name": "MotoVRX - Bike Racing Game", "keywords": ["motorcycle", "racing", "circuit", "driving", "bike"], "long_description": "MotoVRX is a racing game that boosts your bike driving skills by taking you into a fearless racing smash. Release the crazy bike rider within you, prepare yourself for new motor bike driving games, practice on the real racing track with other street racers, and set the bike race tracks on fire. You can also select your favorite racing bike in a mega bike racing game and enter the classic infinite highway ride among heavy traffic away from the mayhem of city. Hurry up! A thrilling bike racing game with a fearless bike simulator experience awaits you.", "short_description": "Enter the classic world of 3D bike racing! Become a bike racer, gear up for a real bike driving experience or burn asphalt on the highway in this epic motorcycle simulation game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skippyapps.com/privacy.ht
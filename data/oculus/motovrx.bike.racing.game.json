EiOqg5&_nc_oc=Adqo_NOp53UgmZUW7MN-6OO2aIZwX5xM5gReHbhMgIZiyFKhS14JSnZJz3Vlq5je_RI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArK6lbID0ZnBT-Qja6YMSDqAsBAULM3RNMlJ58VUa8Jg&oe=6A576FB2"}, {"file_name": "Screen-5.png", "id": "2019536228834071", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819982_2019536232167404_5597961447745592371_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUeGWfyLUUgQ7kNvwFEyqwY&_nc_oc=Adozu8q8csCyG6dBSELYGqrPRd0TyWJ5Ma2cNI71zGtQXep41ywjIMjYnfcxDdLtxis&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWHRauPdk619a6GE7nXIfNiCV1F_K9rHSatiMWSTDlaA&oe=6A578DBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-1.png", "id": "1929819555081086", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823783_1929819558414419_7468795062657877876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWsQFy3LyzMQ7kNvwE-e1k9&_nc_oc=AdoBURRwo1tKsXATc78NAKAiavyB1In1q00at1AR4vUAqB7ocAWyPbICRI3xfhn3h5g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0r9T9INc04AZL6xS4mJfCC4DsbySA1XNr_nJlEXnWCw&oe=6A576E10"}, "display_name": "MotoVRX - Bike Racing Game", "keywords": ["motorcycle", "racing", "circuit", "driving", "bike"], "long_description": "MotoVRX is a racing game that boosts your bike driving skills by taking you into a fearless racing smash. Release the crazy bike rider within you, prepare yourself for new motor bike driving games, practice on the real racing track with other street racers, and set the bike race tracks on fire. You can also select your favorite racing bike in a mega bike racing game and enter the classic infinite highway ride among heavy traffic away from the mayhem of city. Hurry up! A thrilling bike racing game with a fearless bike simulator experience awaits you.", "short_description": "Enter the classic world of 3D bike racing! Become a bike racer, gear up for a real bike driving experience or burn asphalt on the highway in this epi
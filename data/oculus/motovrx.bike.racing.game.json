om&_nc_ss=7f20f&oh=00_Af-TUi9cv1LEMXhu8NRCazTXMUSScCSm1tPHh3khXd5Fjg&oe=6A2C2672"}, {"file_name": "Screen-5.png", "id": "2019536228834071", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491819982_2019536232167404_5597961447745592371_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1crTqYf4y_8Q7kNvwHdzLUn&_nc_oc=AdrfGXE4YZjmPNb2d25nd6fm0wdinycgv3bnjsTKzyK3fUa8UbuUPlvU_mxnrP1rFT0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af919Vv6CoJHsRK6xYSjJRVwMx03J3bNIEz1svnHzGRTRA&oe=6A2C0C3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-1.png", "id": "1929819555081086", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823783_1929819558414419_7468795062657877876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSTyucfoiHgQ7kNvwEwkRg7&_nc_oc=AdoYpywbcY4c7VRp4IM1zu1HXtP00kiSX98qNQHulEl_1433U2-hDEXCXYNXncf50ao&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wSWHUsvAqZjt5Xsgc_bR-7uM_BPz8uxgqDd7xBgB5Nw&oe=6A2C24D0"}, "display_name": "MotoVRX - Bike Racing Game", "keywords": ["motorcycle", "racing", "circuit", "driving", "bike"], "long_description": "MotoVRX is a racing game that boosts your bike driving skills by taking you into a fearless racing smash. Release the crazy bike rider within you, prepare yourself for new motor bike driving games, practice on the real racing track with other street racers, and set the bike race tracks on fire. You can also select your favorite racing bike in a mega bike racing game and enter the classic infinite highway ride among heavy traffic away from the mayhem of city. Hurry up! A thrilling bike racing game with a fearless bike simulator experience awaits you.", "short_description": "Enter the classic world of 3D bike racing! Become a bike racer, gear up for a real bike driving experience or burn asphalt on the highway in this epic motorcycle simulation game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skippyapps.com/privacy.ht
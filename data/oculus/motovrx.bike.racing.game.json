om&_nc_ss=7f20f&oh=00_Af-B0mBoxBZ1ToBw2jjqkNKVwzu6kKUiRv1Y28I_3EoAhQ&oe=6A428FF2"}, {"file_name": "Screen-5.png", "id": "2019536228834071", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819982_2019536232167404_5597961447745592371_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjNWCpO4xmcQ7kNvwFAUyUx&_nc_oc=Adrbj7QIHLHAo68L7zMh04C3rIfrVmnPkExNRyFRNmaiR3mt7t7WgcjXn0JTakhK1tQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8p132fdt0iGr54P6vl-pFP27mvOpQTSQzGcfCUAo5qmQ&oe=6A4275BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-1.png", "id": "1929819555081086", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823783_1929819558414419_7468795062657877876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n60w2G4cJCkQ7kNvwEh0GjO&_nc_oc=AdqZxH8pQba4ce2-_Gz5-NHp08Od6piiSKTA1ngUdaG_AvOP5NspMXRcUZpnuwIiDBc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89VJpA4U2qDSjGv9EeKWBEK4GEduTJs7MGsa_8M-1p8g&oe=6A428E50"}, "display_name": "MotoVRX - Bike Racing Game", "keywords": ["motorcycle", "racing", "circuit", "driving", "bike"], "long_description": "MotoVRX is a racing game that boosts your bike driving skills by taking you into a fearless racing smash. Release the crazy bike rider within you, prepare yourself for new motor bike driving games, practice on the real racing track with other street racers, and set the bike race tracks on fire. You can also select your favorite racing bike in a mega bike racing game and enter the classic infinite highway ride among heavy traffic away from the mayhem of city. Hurry up! A thrilling bike racing game with a fearless bike simulator experience awaits you.", "short_description": "Enter the classic world of 3D bike racing! Become a bike racer, gear up for a real bike driving experience or burn asphalt on the highway in this epic motorcycle simulation game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skippyapps.com/privacy.ht
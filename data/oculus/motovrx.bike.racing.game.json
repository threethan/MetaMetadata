om&_nc_ss=7a30f&oh=00_Af05r1juyxxJzQsvhA_TkVTBxkM_s3yMI6iffypOIDEiyw&oe=69D63CB2"}, {"file_name": "Screen-5.png", "id": "2019536228834071", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819982_2019536232167404_5597961447745592371_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egpI0Ohld1oQ7kNvwEwlFmp&_nc_oc=AdoeHZsXipZV9EEv3eIRCGfJwLTcoQETv7RAzKWgMnNG0Rvfndg6xPSNuwoMSJRIxFM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HcjN0dH3TPb3OW2b8ftQSyuHFYHy1A2eOlSO0pJoVrA&oe=69D65ABA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-1.png", "id": "1929819555081086", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823783_1929819558414419_7468795062657877876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d93QPOfqX0YQ7kNvwECwrh-&_nc_oc=AdqJ3dOjiJi2o0txUufiSggFzpCY4ulYN_uod0taPO5dFIOZw6V_Qv17vta247Dbo8o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wOwDDIZ9xJ7A0lUzj7Gq2C07nWqHPhUSpV0N43eVxmA&oe=69D63B10"}, "display_name": "MotoVRX - Bike Racing Game", "keywords": ["motorcycle", "racing", "circuit", "driving", "bike"], "long_description": "MotoVRX is a racing game that boosts your bike driving skills by taking you into a fearless racing smash. Release the crazy bike rider within you, prepare yourself for new motor bike driving games, practice on the real racing track with other street racers, and set the bike race tracks on fire. You can also select your favorite racing bike in a mega bike racing game and enter the classic infinite highway ride among heavy traffic away from the mayhem of city. Hurry up! A thrilling bike racing game with a fearless bike simulator experience awaits you.", "short_description": "Enter the classic world of 3D bike racing! Become a bike racer, gear up for a real bike driving experience or burn asphalt on the highway in this epic motorcycle simulation game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skippyapps.com/privacy.ht
om&_nc_ss=7f20f&oh=00_Af_v-7zsfrKJ1N66MX6ymWq3DPyepwM16k6rQScZ60_toQ&oe=6A3FECF2"}, {"file_name": "Screen-5.png", "id": "2019536228834071", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819982_2019536232167404_5597961447745592371_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PQcaudEku4Q7kNvwGwsF2y&_nc_oc=AdpzgbNp7G89QBZHEuS8MTqNFaAL-NomhGqqWuppPyHt4I_1GxeMcBe3go-bWc1TupA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CVf7i9P0Pa_cP7HiwAu_ZwasbE5EG0NLxm_Applc--g&oe=6A3FD2BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-1.png", "id": "1929819555081086", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823783_1929819558414419_7468795062657877876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pq5aNA6QC0Q7kNvwGtTFpJ&_nc_oc=AdqhtQzNQxk3DdWGUOVTwsTKQjarhgmBJEtIpmkQC0Or2vN_0KmeIB11bmJXPJIZ2aM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5UlaPV1PDU-g6Jf7l10Lw-jpmu6f2J14zh-eTE4ZYVg&oe=6A3FEB50"}, "display_name": "MotoVRX - Bike Racing Game", "keywords": ["motorcycle", "racing", "circuit", "driving", "bike"], "long_description": "MotoVRX is a racing game that boosts your bike driving skills by taking you into a fearless racing smash. Release the crazy bike rider within you, prepare yourself for new motor bike driving games, practice on the real racing track with other street racers, and set the bike race tracks on fire. You can also select your favorite racing bike in a mega bike racing game and enter the classic infinite highway ride among heavy traffic away from the mayhem of city. Hurry up! A thrilling bike racing game with a fearless bike simulator experience awaits you.", "short_description": "Enter the classic world of 3D bike racing! Become a bike racer, gear up for a real bike driving experience or burn asphalt on the highway in this epic motorcycle simulation game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skippyapps.com/privacy.ht
om&_nc_ss=7a30f&oh=00_Af3cGiCqSrLsLIsYkuSIxPReipdrj4MQk0mgTtQeUED47g&oe=69E0C8B2"}, {"file_name": "Screen-5.png", "id": "2019536228834071", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819982_2019536232167404_5597961447745592371_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6mgyxjwjsUQ7kNvwED9Ifx&_nc_oc=Adp5z0sZ-ljOAW2byXPz2i8dIwp_QI3V5dRTqb0tSarCNU1kB--cpIjcIONBOxReKZg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3prTgpyJ94YkWb7pxe11trC69NQdxTPyCu3SZD08WxhQ&oe=69E0E6BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-1.png", "id": "1929819555081086", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823783_1929819558414419_7468795062657877876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-gg7EZ-WioQ7kNvwFBZFcy&_nc_oc=Ado17fmzH2sBufZUSgRYWU0paS7X_E1nAi_KooUzTXvz2dLx4YQSDTSX03gWSD_1xXI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1udwJPm0FZJ5VuDPPdBAwkowRQt28rV8qUlBdg1kjcNw&oe=69E0FF50"}, "display_name": "MotoVRX - Bike Racing Game", "keywords": ["motorcycle", "racing", "circuit", "driving", "bike"], "long_description": "MotoVRX is a racing game that boosts your bike driving skills by taking you into a fearless racing smash. Release the crazy bike rider within you, prepare yourself for new motor bike driving games, practice on the real racing track with other street racers, and set the bike race tracks on fire. You can also select your favorite racing bike in a mega bike racing game and enter the classic infinite highway ride among heavy traffic away from the mayhem of city. Hurry up! A thrilling bike racing game with a fearless bike simulator experience awaits you.", "short_description": "Enter the classic world of 3D bike racing! Become a bike racer, gear up for a real bike driving experience or burn asphalt on the highway in this epic motorcycle simulation game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skippyapps.com/privacy.ht
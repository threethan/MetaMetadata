om&_nc_ss=7f20f&oh=00_Af-GeOVsaLEIceSQvwo-SMofBBx24J_3FoareVuBuZtsrg&oe=6A3BF872"}, {"file_name": "Screen-5.png", "id": "2019536228834071", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819982_2019536232167404_5597961447745592371_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oK_9c4fCT7QQ7kNvwGWFdq1&_nc_oc=AdoX7YMBpH2Kd4xxCj7gO8i0gfOR1uvxjL8DxzdcxRXpsvy42xhlneP6Jbxhljb4aZ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8X8tfjURVPf_61nO4tRUa9YKagtopnsqfxCjvTchKog&oe=6A3BDE3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-1.png", "id": "1929819555081086", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823783_1929819558414419_7468795062657877876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzAXdMIaSngQ7kNvwF6PX8n&_nc_oc=AdqUELQ4zFmaBKV3SGuWPXLnOX7SPuf0D8dOF7Bw9qFHilJUdi8jn3LUnsb-ry1U6R8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WIqQ2mYIWSqVxCiOg96fH4-AVIvs9GR1Bza2YXVxF8w&oe=6A3BF6D0"}, "display_name": "MotoVRX - Bike Racing Game", "keywords": ["motorcycle", "racing", "circuit", "driving", "bike"], "long_description": "MotoVRX is a racing game that boosts your bike driving skills by taking you into a fearless racing smash. Release the crazy bike rider within you, prepare yourself for new motor bike driving games, practice on the real racing track with other street racers, and set the bike race tracks on fire. You can also select your favorite racing bike in a mega bike racing game and enter the classic infinite highway ride among heavy traffic away from the mayhem of city. Hurry up! A thrilling bike racing game with a fearless bike simulator experience awaits you.", "short_description": "Enter the classic world of 3D bike racing! Become a bike racer, gear up for a real bike driving experience or burn asphalt on the highway in this epic motorcycle simulation game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skippyapps.com/privacy.ht
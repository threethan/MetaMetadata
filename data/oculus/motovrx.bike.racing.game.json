om&_nc_ss=7f20f&oh=00_Af3P30vWs9KPqQaOnvTiYTBhisqv5dI4yelV8tEvcozU0A&oe=69F618F2"}, {"file_name": "Screen-5.png", "id": "2019536228834071", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491819982_2019536232167404_5597961447745592371_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXqRH_6ZSgEQ7kNvwE8nkL5&_nc_oc=AdpeVSl6rKYOClSJCRLOyw-iCjgI-5De4UqQOuDpEPR3izF2cfeK9NXRj2ibRpQ1Ly0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3p71y0aouFpcf336Y0kTPJHynkH8p45mfLExHvKD1Ytw&oe=69F5FEBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-1.png", "id": "1929819555081086", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823783_1929819558414419_7468795062657877876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfkaBXfNXSwQ7kNvwE2X9Vb&_nc_oc=AdqO06ilHZ2itl7CIWJLI3GgKh1JH7eX4XwZ3duCG6wpMARUVASl4rKv4jygVli2YlU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af25xBDtAq06-B-IM_yPGZoT8cjXd7ZjRaFvys75JtS_0w&oe=69F61750"}, "display_name": "MotoVRX - Bike Racing Game", "keywords": ["motorcycle", "racing", "circuit", "driving", "bike"], "long_description": "MotoVRX is a racing game that boosts your bike driving skills by taking you into a fearless racing smash. Release the crazy bike rider within you, prepare yourself for new motor bike driving games, practice on the real racing track with other street racers, and set the bike race tracks on fire. You can also select your favorite racing bike in a mega bike racing game and enter the classic infinite highway ride among heavy traffic away from the mayhem of city. Hurry up! A thrilling bike racing game with a fearless bike simulator experience awaits you.", "short_description": "Enter the classic world of 3D bike racing! Become a bike racer, gear up for a real bike driving experience or burn asphalt on the highway in this epic motorcycle simulation game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skippyapps.com/privacy.ht
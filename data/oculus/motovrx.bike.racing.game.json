om&_nc_ss=7f20f&oh=00_Af7RyXKBootyc1ogsI_WP23y-wo2_QXSeZNE3odXRwmzpQ&oe=6A2048F2"}, {"file_name": "Screen-5.png", "id": "2019536228834071", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819982_2019536232167404_5597961447745592371_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtIb8reLGZwQ7kNvwGjNsMl&_nc_oc=AdrPWGTlWha_NCEATHByALncLJ74h5TwItJrr7-8ME-ImCOeBtP_xhVUhN8i6rL57HY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tbbf5FIVd9H-12bBlizJyBPOSqv-DuNpxvyKaBjo7GQ&oe=6A202EBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-1.png", "id": "1929819555081086", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823783_1929819558414419_7468795062657877876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfdGr54g0hIQ7kNvwERb0rL&_nc_oc=AdpBbExccEdOxZaH05V1E9w9AGXadXXGc1sJXlBV7PZDOBWhFVOK7VkjV6Ews2aL4y4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75GMblanCnoX41SpMVRUSJLyrQc0eAFm597rJodToGfQ&oe=6A204750"}, "display_name": "MotoVRX - Bike Racing Game", "keywords": ["motorcycle", "racing", "circuit", "driving", "bike"], "long_description": "MotoVRX is a racing game that boosts your bike driving skills by taking you into a fearless racing smash. Release the crazy bike rider within you, prepare yourself for new motor bike driving games, practice on the real racing track with other street racers, and set the bike race tracks on fire. You can also select your favorite racing bike in a mega bike racing game and enter the classic infinite highway ride among heavy traffic away from the mayhem of city. Hurry up! A thrilling bike racing game with a fearless bike simulator experience awaits you.", "short_description": "Enter the classic world of 3D bike racing! Become a bike racer, gear up for a real bike driving experience or burn asphalt on the highway in this epic motorcycle simulation game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skippyapps.com/privacy.ht
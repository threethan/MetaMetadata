p37wDFfYYxJO6NcDQnO8fXed_aVA&oe=69BFD332"}, {"file_name": "Screen-5.png", "id": "2019536228834071", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819982_2019536232167404_5597961447745592371_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WrpTmdqvqUQ7kNvwEymnOq&_nc_oc=Adln1ul6bFcbVxclHiXtzdy57-a7seFLjS-p-_21MQrFBJEDvsMmyt6hP9ya5DuEdtk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx99a_qdDvVJCPCIzIc64R8XtX5tbhUHeLkJwn3oRP9ZA&oe=69BFF13A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-1.png", "id": "1929819555081086", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823783_1929819558414419_7468795062657877876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AD-qp2Jret4Q7kNvwELTQkJ&_nc_oc=AdnAuDf4MoDnF694hQ1Nv2rV-eJ1KjY-f_s6osLaw1PhVJyxDQgqrU7JjmiwJbudAGk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyIfUw0H7_67UHFNS62WGUdz4o9uMqMCuyqEO-0UUIvhw&oe=69BFD190"}, "display_name": "MotoVRX - Bike Racing Game", "keywords": ["motorcycle", "racing", "circuit", "driving", "bike"], "long_description": "MotoVRX is a racing game that boosts your bike driving skills by taking you into a fearless racing smash. Release the crazy bike rider within you, prepare yourself for new motor bike driving games, practice on the real racing track with other street racers, and set the bike race tracks on fire. You can also select your favorite racing bike in a mega bike racing game and enter the classic infinite highway ride among heavy traffic away from the mayhem of city. Hurry up! A thrilling bike racing game with a fearless bike simulator experience awaits you.", "short_description": "Enter the classic world of 3D bike racing! Become a bike racer, gear up for a real bike driving experience or burn asphalt on the highway in this epic motorcycle simulation game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": null, "pu
om&_nc_ss=7f20f&oh=00_Af5BF7P4-S5Z99l6vfsVMXMGIb7Pwvyhw6NNx1cjhNDh7g&oe=6A1C5472"}, {"file_name": "Screen-5.png", "id": "2019536228834071", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819982_2019536232167404_5597961447745592371_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OF0Sbr1WFkQ7kNvwH09L1Z&_nc_oc=AdrfpsMvOWVpC-fjxNVWB_Mlwuy8iPQ6xn7l_hN_dW5HGAPuYd_a5yOLhgs5LcXRZkY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yACNMBpKiCEVKxW5lo4Ph_kSfRkH5Dx_c86PuJLFkUQ&oe=6A1C3A3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-1.png", "id": "1929819555081086", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823783_1929819558414419_7468795062657877876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rr9UBSJqVnkQ7kNvwGg10FC&_nc_oc=AdoPYPsjnlIR-PcnyWgDn4Z1eODEkqTKkRbLWOQYs6CY_6TlHQWSddkoRaTARbH3mQ8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77mJsZtWjbwJwEZyIUhrQqbVb4Kc6go5iwZJDi1pJ65A&oe=6A1C52D0"}, "display_name": "MotoVRX - Bike Racing Game", "keywords": ["motorcycle", "racing", "circuit", "driving", "bike"], "long_description": "MotoVRX is a racing game that boosts your bike driving skills by taking you into a fearless racing smash. Release the crazy bike rider within you, prepare yourself for new motor bike driving games, practice on the real racing track with other street racers, and set the bike race tracks on fire. You can also select your favorite racing bike in a mega bike racing game and enter the classic infinite highway ride among heavy traffic away from the mayhem of city. Hurry up! A thrilling bike racing game with a fearless bike simulator experience awaits you.", "short_description": "Enter the classic world of 3D bike racing! Become a bike racer, gear up for a real bike driving experience or burn asphalt on the highway in this epic motorcycle simulation game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skippyapps.com/privacy.ht
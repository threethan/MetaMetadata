om&_nc_ss=7a30f&oh=00_Af3RBdsBFyPd881QcI9mhkpP-pb-cnljLQedfThC4bEXhw&oe=69E8B1B2"}, {"file_name": "Screen-5.png", "id": "2019536228834071", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819982_2019536232167404_5597961447745592371_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lP_r0HUhQdcQ7kNvwFYImSw&_nc_oc=AdpaBieI9Z7LapGMIEhMDIFMh0kiCTfNxYuHNlwdPLlk8e6FbO-sSHuVfrdO2V7pjSk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FmbfaFZS_5t9mn_r0qBrENKvGM1OGXTCLwVRidZggUQ&oe=69E8CFBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-1.png", "id": "1929819555081086", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823783_1929819558414419_7468795062657877876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXZfW8CWLUcQ7kNvwGGCVaO&_nc_oc=AdqJj_7E437-iKjsGaDrOtZKWVPYyLkDuQc88-eMN7V5-eVQM-_A4NNV2N3l6m4fylY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3NTEDqfMmYZDMgnifgXNwN1ELC9yFy0NbgPPtlOBYAwA&oe=69E8B010"}, "display_name": "MotoVRX - Bike Racing Game", "keywords": ["motorcycle", "racing", "circuit", "driving", "bike"], "long_description": "MotoVRX is a racing game that boosts your bike driving skills by taking you into a fearless racing smash. Release the crazy bike rider within you, prepare yourself for new motor bike driving games, practice on the real racing track with other street racers, and set the bike race tracks on fire. You can also select your favorite racing bike in a mega bike racing game and enter the classic infinite highway ride among heavy traffic away from the mayhem of city. Hurry up! A thrilling bike racing game with a fearless bike simulator experience awaits you.", "short_description": "Enter the classic world of 3D bike racing! Become a bike racer, gear up for a real bike driving experience or burn asphalt on the highway in this epic motorcycle simulation game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skippyapps.com/privacy.ht
GfGaZR&_nc_oc=AdoqiN3t_pb_BSDBKk5Bnh2d_W03Q4sXBSpp-zb-fjKCYVmjeDYrZaCmwqP7_A_KQMs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGMO_UHPR_fbmod9SKPzmVBkdtvQP5OlMupBI_6QHG0w&oe=6A537B32"}, {"file_name": "Screen-5.png", "id": "2019536228834071", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819982_2019536232167404_5597961447745592371_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVAKL3kHhvkQ7kNvwELfR9_&_nc_oc=AdqJ6uJAWA8T9HThtLPkqnlvl6yQUQMEGZbeSKkbTCMBfLipUKrfVDQKQKL2a-YDcdg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDayaNh65loqxOkWKCgZGgapGdiImph4YdD9oNqqcvw-w&oe=6A53993A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-1.png", "id": "1929819555081086", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823783_1929819558414419_7468795062657877876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iykhOhz6DH4Q7kNvwEINf4j&_nc_oc=Adpn9ZsL6BzjURb0bdQWCr04jtvx7_SbuEI9da1_TXFTvQK6XWKPmiJT1P0c7OBGCbc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlarSl3LZW9gx9qgQPs2qpGA4QbdB7WGHpxZDQtmONyA&oe=6A537990"}, "display_name": "MotoVRX - Bike Racing Game", "keywords": ["motorcycle", "racing", "circuit", "driving", "bike"], "long_description": "MotoVRX is a racing game that boosts your bike driving skills by taking you into a fearless racing smash. Release the crazy bike rider within you, prepare yourself for new motor bike driving games, practice on the real racing track with other street racers, and set the bike race tracks on fire. You can also select your favorite racing bike in a mega bike racing game and enter the classic infinite highway ride among heavy traffic away from the mayhem of city. Hurry up! A thrilling bike racing game with a fearless bike simulator experience awaits you.", "short_description": "Enter the classic world of 3D bike racing! Become a bike racer, gear up for a real bike driving experience or burn asphalt on the highway in this epic motorcycle simulation game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://skippyapps.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25376488905375208"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491824741_1537374947301717_1353165170245657485_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAaGmDtaRp4Q7kNvwGSxwhc&_nc_oc=Adra75DxSOXRZZpgwCzccQURdMcfprXgyDg35qXL1Ykyxve1Az3vt5ATCXIhat1EAz4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAs6v6BaQMx1krYhtJJkMbwWgbU_GC-egqZShbqUXaaZA&oe=6A539D3C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MotoVRX - Bike Racing Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}, {"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1660671090, "lastRevision": {"nodes": [{"id": "5480786092038784", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "i
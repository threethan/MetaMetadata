om&_nc_ss=7a30f&oh=00_Af0lqtj7kt_f5xlQGCWbBRfjmAVW2nwaOyBjYMpJegRyKQ&oe=69E4BD32"}, {"file_name": "Screen-5.png", "id": "2019536228834071", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819982_2019536232167404_5597961447745592371_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0DjykSxKB6EQ7kNvwEN-zBj&_nc_oc=AdonRlWB-uX4LcO8LCc0rElZmZShujEMmRpxAAckMY1hglt5Gr8Ou5vy8FYRbDF44wY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QlYuvg_wFk9Hirn77tsh1Cvkw-DDtQ0CkyevXj_Frqg&oe=69E4DB3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-1.png", "id": "1929819555081086", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823783_1929819558414419_7468795062657877876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-Kl-dvoRTUQ7kNvwH31Quq&_nc_oc=Adpf9bu1DB3I1bayqGPQ4gxw2cKyYzrqY_H7vWHtk8kNUQaNRsJkX-DJ3nt7S-lUfjU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14nKD7orBuXRz7O7m4OUemm8vTzH3Xqpg3X4YreRqFcg&oe=69E4BB90"}, "display_name": "MotoVRX - Bike Racing Game", "keywords": ["motorcycle", "racing", "circuit", "driving", "bike"], "long_description": "MotoVRX is a racing game that boosts your bike driving skills by taking you into a fearless racing smash. Release the crazy bike rider within you, prepare yourself for new motor bike driving games, practice on the real racing track with other street racers, and set the bike race tracks on fire. You can also select your favorite racing bike in a mega bike racing game and enter the classic infinite highway ride among heavy traffic away from the mayhem of city. Hurry up! A thrilling bike racing game with a fearless bike simulator experience awaits you.", "short_description": "Enter the classic world of 3D bike racing! Become a bike racer, gear up for a real bike driving experience or burn asphalt on the highway in this epic motorcycle simulation game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skippyapps.com/privacy.ht
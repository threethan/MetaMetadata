om&_nc_ss=7a30f&oh=00_AfxqiNJKjB0sN5NVTsv9c202up0iZwLj7vVYzoB-Tt0olw&oe=69D0F6B2"}, {"file_name": "Screen-5.png", "id": "2019536228834071", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819982_2019536232167404_5597961447745592371_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcSldhNQnbcQ7kNvwE-ZtRO&_nc_oc=Adrt0QTRqwSy_dsgVc9bOeXzjUPhRsaepCWNuGkL5YLgyVZHQqO_apm1Gnl7e0QjgIc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxXwZZ_O4REXmLikktUC-6pzS4ddbr_s8SQC5NfsZBqsQ&oe=69D114BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-1.png", "id": "1929819555081086", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823783_1929819558414419_7468795062657877876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0R143-ne_goQ7kNvwE45Ev9&_nc_oc=AdqM_HaLFAQlpaQcgsjupx1PlaFBgD-cLW_Q2fFHllqgKwyO1MJC0LSwFmQHqPdMWXY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwpctuKYeq4it3IxsjQg951HnWYgdum0vmBf4Ekvy44QQ&oe=69D0F510"}, "display_name": "MotoVRX - Bike Racing Game", "keywords": ["motorcycle", "racing", "circuit", "driving", "bike"], "long_description": "MotoVRX is a racing game that boosts your bike driving skills by taking you into a fearless racing smash. Release the crazy bike rider within you, prepare yourself for new motor bike driving games, practice on the real racing track with other street racers, and set the bike race tracks on fire. You can also select your favorite racing bike in a mega bike racing game and enter the classic infinite highway ride among heavy traffic away from the mayhem of city. Hurry up! A thrilling bike racing game with a fearless bike simulator experience awaits you.", "short_description": "Enter the classic world of 3D bike racing! Become a bike racer, gear up for a real bike driving experience or burn asphalt on the highway in this epic motorcycle simulation game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skippyapps.com/privacy.ht
om&_nc_ss=7f20f&oh=00_Af-gmv1vkv90Wv-Obr_rcfMybtohKBu95swQBSMHhkdzQQ&oe=6A219A72"}, {"file_name": "Screen-5.png", "id": "2019536228834071", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819982_2019536232167404_5597961447745592371_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mq0xPJwx86cQ7kNvwHcWmsd&_nc_oc=Adr47w8h6LHg5zkp1mz7A-Gu2m4WJpu2WrrWY2qrrZVuLdp5nnWplMdIEMp4DjVnU0A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2LEf2lJUgZSEGT8tl1e3iUKlWwKQucrTiyYlgS49mFA&oe=6A21803A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-1.png", "id": "1929819555081086", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823783_1929819558414419_7468795062657877876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfdGr54g0hIQ7kNvwFIjXy3&_nc_oc=AdqAm6oeMVPrUH_GMgJL1Ky3RSb-dNlalFSiEq1MS5hwc_YhvGK_Y7Oe_jAXxuVQE80&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zi8uGWMjzviIG4tqFq7IM6cc7TxhktEhwyRmAC_9AXA&oe=6A2198D0"}, "display_name": "MotoVRX - Bike Racing Game", "keywords": ["motorcycle", "racing", "circuit", "driving", "bike"], "long_description": "MotoVRX is a racing game that boosts your bike driving skills by taking you into a fearless racing smash. Release the crazy bike rider within you, prepare yourself for new motor bike driving games, practice on the real racing track with other street racers, and set the bike race tracks on fire. You can also select your favorite racing bike in a mega bike racing game and enter the classic infinite highway ride among heavy traffic away from the mayhem of city. Hurry up! A thrilling bike racing game with a fearless bike simulator experience awaits you.", "short_description": "Enter the classic world of 3D bike racing! Become a bike racer, gear up for a real bike driving experience or burn asphalt on the highway in this epic motorcycle simulation game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skippyapps.com/privacy.ht
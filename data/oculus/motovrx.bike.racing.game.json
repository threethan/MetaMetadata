78C"}, {"file_name": "Screen-3.png", "id": "1568462254166979", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820387_1568462257500312_5303296500774924397_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nzls8dmixYQ7kNvwHUYJt4&_nc_oc=Ado8Coh0tRJB_ZYNsFdIQie18sWpnSgTG9qy0KHt5PGorBHWEyWfsWQnE8VNlZLiGbg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsSlcdq4tVqDIVnB3nFI9qB3YWUA8_VJRk8rA7vTCSaQ&oe=6B0850F2"}, {"file_name": "Screen-5.png", "id": "2019536228834071", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819982_2019536232167404_5597961447745592371_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzKU6ugelscQ7kNvwGfqNgP&_nc_oc=AdoLnWpshEjGYWKFMDdYj6GHqGPCd9XdPGtGumaJffTb6GxVQ5itu4Mlt8nf4TEDM10&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1wZpuLq6TwLO9-Dm--YMpHX3WtSRw4Z0bw2qY2_nrlQ&oe=6B086EFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-1.png", "id": "1929819555081086", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491823783_1929819558414419_7468795062657877876_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_dgAX-79jkQ7kNvwFN-vvJ&_nc_oc=AdoilUOnGOPmw0A85Yz4MKacujHeDTtzd0G5dOuKjbfrV8CxtVnEAytFjMpF8ebyB3Y&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ55QnB-AKx7-VtlLQhnrQiz9nqukzkte-5__DZDj33ug&oe=6B084F50"}, "display_name": "MotoVRX - Bike Racing Game", "keywords": ["motorcycle", "racing", "circuit", "driving", "bike"], "long_description": "MotoVRX is a racing game that boosts your bike driving skills by taking you into a fearless racing smash. Release the crazy bike rider within you, prepare yourself for new motor bike driving games, practice on the real racing track with other street racers, and set the bike race tracks on fire. You can also select your favorite racing bike in a mega bike racing game and enter the classic infinite highway ride among heavy traffic away from the mayhem of city. Hurry up! A thrilling bike racing game with a fearless bike simulator experience awaits you.", "short_description": "Enter the classic world of 3D bike racing! Become a bike racer, gear up for a real bike driving experience or burn asphalt on the highway in this epic motorcycle simulation game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://skippyapps.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28974571415566921"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824741_1537374947301717_1353165170245657485_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KL4OKcxXjWMQ7kNvwGuEmBv&_nc_oc=AdqIX2AkaYMKWV_t_duX_kprchWogRq0zIQ2L7c5eQurYOSmJW-i3KeFkPSUPfH16Rc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROcG2bai0qj5EbRtYH-DVd_AjzGWJTtJ9vAFXxT8zC3w&oe=6B0872FC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MotoVRX - Bike Racing Game", "platform": "AND
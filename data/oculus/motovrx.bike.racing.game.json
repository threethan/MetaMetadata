j4ZIUo7dB0zsGFVsz_gZgv85H3ew&oe=69B54732"}, {"file_name": "Screen-5.png", "id": "2019536228834071", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819982_2019536232167404_5597961447745592371_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XI2I1MEPFu4Q7kNvwHr81dM&_nc_oc=AdnGgc92Y37SfFuPPLA-sfo2vbqyDBz-oFJzxuB0UQ5dsIUpyYJlZSK3nKTNJD4Ylyg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw558P7C66VXTdP2iAPbpjX4LGVNGtEQyslVkXZEMVmfA&oe=69B5653A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-1.png", "id": "1929819555081086", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823783_1929819558414419_7468795062657877876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IziVW80_GaUQ7kNvwHjJwyE&_nc_oc=AdlUhtiQteXVI4n0DsBTq7X11BKphQVqr_smpPE1MnXX6f02ul05NdCphSaf9Gwb--s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz0Njle_qo2VZ32cWiFUpOtaXzu_Rk2f4iiPxcidcJ2tQ&oe=69B54590"}, "display_name": "MotoVRX - Bike Racing Game", "keywords": ["motorcycle", "racing", "circuit", "driving", "bike"], "long_description": "MotoVRX is a racing game that boosts your bike driving skills by taking you into a fearless racing smash. Release the crazy bike rider within you, prepare yourself for new motor bike driving games, practice on the real racing track with other street racers, and set the bike race tracks on fire. You can also select your favorite racing bike in a mega bike racing game and enter the classic infinite highway ride among heavy traffic away from the mayhem of city. Hurry up! A thrilling bike racing game with a fearless bike simulator experience awaits you.", "short_description": "Enter the classic world of 3D bike racing! Become a bike racer, gear up for a real bike driving experience or burn asphalt on the highway in this epic motorcycle simulation game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": null, "pu
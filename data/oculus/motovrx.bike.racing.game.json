om&_nc_ss=7f20f&oh=00_Af_HXUlSBwjPt0G76TPgsNbv9kxp0ZVaFmBKHlvH1a236g&oe=6A3E9B72"}, {"file_name": "Screen-5.png", "id": "2019536228834071", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819982_2019536232167404_5597961447745592371_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PQcaudEku4Q7kNvwGJKTAh&_nc_oc=Adrx5Zy7yGkMOTTny3xXM_V4hWmj3UVn0DVz9OiFT-51z4ET2elqaTLEw6paUU-M3DQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Pl7eR-QAiIhEqEVepRx0BUJuuYkDArmn7Rtv94H3Iwg&oe=6A3E813A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-1.png", "id": "1929819555081086", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823783_1929819558414419_7468795062657877876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pq5aNA6QC0Q7kNvwF0mpMv&_nc_oc=AdoZJ83U6jMk-dL1Z2MGXEw_Pe35ddMjAIiJeHMfoFlLXbDREn74rV4NikaXuECAiz8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hQxxAngCXzFABcfjgS2sfRYNxo6Sfb9ARcT3TzqGLgw&oe=6A3E99D0"}, "display_name": "MotoVRX - Bike Racing Game", "keywords": ["motorcycle", "racing", "circuit", "driving", "bike"], "long_description": "MotoVRX is a racing game that boosts your bike driving skills by taking you into a fearless racing smash. Release the crazy bike rider within you, prepare yourself for new motor bike driving games, practice on the real racing track with other street racers, and set the bike race tracks on fire. You can also select your favorite racing bike in a mega bike racing game and enter the classic infinite highway ride among heavy traffic away from the mayhem of city. Hurry up! A thrilling bike racing game with a fearless bike simulator experience awaits you.", "short_description": "Enter the classic world of 3D bike racing! Become a bike racer, gear up for a real bike driving experience or burn asphalt on the highway in this epic motorcycle simulation game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skippyapps.com/privacy.ht
om&_nc_ss=7f20f&oh=00_Af4pr8DNMjOABuemUNZxHEsIUKzYItH-_8nvVu3rw7l0xw&oe=6A0347F2"}, {"file_name": "Screen-5.png", "id": "2019536228834071", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819982_2019536232167404_5597961447745592371_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1W-ZjM2BB4oQ7kNvwFTCVRO&_nc_oc=AdpuvAJiayC-gmOTUN7DIEwg7e0EVu05BeBVzvFLyQ_xvOqaqy_Y44OM2yQRGKNwPg8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af700QKt0fO5JEVFi28ccjdC_p4SjMI9_C1TYBL3oNAXpg&oe=6A032DBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-1.png", "id": "1929819555081086", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823783_1929819558414419_7468795062657877876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7BGk4nvXFUQ7kNvwFQHQbE&_nc_oc=Adr5uCUnj2sQ3AzpSEyD7K6TC852EBI9YnOjHDRQBqoWZqWIKyVAZS6MimokLz0mpWw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LzhZ6iYy9sedYvJT1hU7fOXfF5xIWzOmx1hV6jzUgqg&oe=6A034650"}, "display_name": "MotoVRX - Bike Racing Game", "keywords": ["motorcycle", "racing", "circuit", "driving", "bike"], "long_description": "MotoVRX is a racing game that boosts your bike driving skills by taking you into a fearless racing smash. Release the crazy bike rider within you, prepare yourself for new motor bike driving games, practice on the real racing track with other street racers, and set the bike race tracks on fire. You can also select your favorite racing bike in a mega bike racing game and enter the classic infinite highway ride among heavy traffic away from the mayhem of city. Hurry up! A thrilling bike racing game with a fearless bike simulator experience awaits you.", "short_description": "Enter the classic world of 3D bike racing! Become a bike racer, gear up for a real bike driving experience or burn asphalt on the highway in this epic motorcycle simulation game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skippyapps.com/privacy.ht
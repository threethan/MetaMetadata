om&_nc_ss=7a30f&oh=00_AfyAS1jJxo5_h5mHlimn7ZxlRRVHoTa99iDGlEvw_KC36A&oe=69C3C7B2"}, {"file_name": "Screen-5.png", "id": "2019536228834071", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819982_2019536232167404_5597961447745592371_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4aGToRHsF0Q7kNvwHsDALC&_nc_oc=Ado94lgL0968nTpN6uyZdeijBV55Jupv9DoBCbVg_sNynxGO_WVZ3PHAqrhLa2nSttg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afygsc9YWDRYDjz4fZ0t-jWgJyZ-KUfgXjYcooZd1hv9fg&oe=69C3E5BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-1.png", "id": "1929819555081086", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823783_1929819558414419_7468795062657877876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OADzXmmCVpsQ7kNvwEX989q&_nc_oc=Adp2pBZHVLAtEI9A5KB73odABP_vRu7vds2TrF3GQZvxnfoyHYSJOpsxwJOaWQwnrgw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7_Y9Pn2J0mR13BTgwD3Vx0JPWz0Bh6VmiUXe39FOSvg&oe=69C3C610"}, "display_name": "MotoVRX - Bike Racing Game", "keywords": ["motorcycle", "racing", "circuit", "driving", "bike"], "long_description": "MotoVRX is a racing game that boosts your bike driving skills by taking you into a fearless racing smash. Release the crazy bike rider within you, prepare yourself for new motor bike driving games, practice on the real racing track with other street racers, and set the bike race tracks on fire. You can also select your favorite racing bike in a mega bike racing game and enter the classic infinite highway ride among heavy traffic away from the mayhem of city. Hurry up! A thrilling bike racing game with a fearless bike simulator experience awaits you.", "short_description": "Enter the classic world of 3D bike racing! Become a bike racer, gear up for a real bike driving experience or burn asphalt on the highway in this epic motorcycle simulation game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skippyapps.com/privacy.ht
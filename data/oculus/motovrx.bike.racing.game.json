om&_nc_ss=7f20f&oh=00_Af3YuFEqbfxayskPOKGG-c2OmJVkNZ8F8TqsU4Npc45oYg&oe=69F4C772"}, {"file_name": "Screen-5.png", "id": "2019536228834071", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819982_2019536232167404_5597961447745592371_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAHT0i0U0lwQ7kNvwFqJjRV&_nc_oc=Adrg0qYiCqSGOSrq9N_ashIK7SeLVsMFPYn7VqPjZDGZO7KwxjQUjQGpEfIaNu0tCfQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3XJfygL2L07-O3uw3ITHs-ew0G-RRdqLpmfs9nNKRr3Q&oe=69F4AD3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-1.png", "id": "1929819555081086", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823783_1929819558414419_7468795062657877876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfkaBXfNXSwQ7kNvwFseTgB&_nc_oc=AdosT968itNhF3__UAOJga5-Wl4GtdiK_Pj9ZwOfjPW8rBiFt-d4786-t0Ywzd47cdI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af04CnkhO8G1-KL9ItU9I9G158sRG9vejvLY1F53YvtcRg&oe=69F4C5D0"}, "display_name": "MotoVRX - Bike Racing Game", "keywords": ["motorcycle", "racing", "circuit", "driving", "bike"], "long_description": "MotoVRX is a racing game that boosts your bike driving skills by taking you into a fearless racing smash. Release the crazy bike rider within you, prepare yourself for new motor bike driving games, practice on the real racing track with other street racers, and set the bike race tracks on fire. You can also select your favorite racing bike in a mega bike racing game and enter the classic infinite highway ride among heavy traffic away from the mayhem of city. Hurry up! A thrilling bike racing game with a fearless bike simulator experience awaits you.", "short_description": "Enter the classic world of 3D bike racing! Become a bike racer, gear up for a real bike driving experience or burn asphalt on the highway in this epic motorcycle simulation game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skippyapps.com/privacy.ht
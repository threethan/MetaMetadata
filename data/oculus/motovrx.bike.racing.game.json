om&_nc_ss=7f20f&oh=00_Af4A3d4NcVTZ3ej0jsTX3LE4Ygm307JLXRB2eAjclbFbHw&oe=6A0C8272"}, {"file_name": "Screen-5.png", "id": "2019536228834071", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819982_2019536232167404_5597961447745592371_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2X8urVJhNkQ7kNvwH8mfF2&_nc_oc=AdoyqD9FhRA7Lamwfg7GPvdTW_rAn2D3L88Q9bj5f794DhZGm-FBgF1NauVPM0MvkEA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vwn1pmt4WBfYw9tA0NznmPY1J5Bo_2wLvityeVp69Pw&oe=6A0C683A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-1.png", "id": "1929819555081086", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823783_1929819558414419_7468795062657877876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=in7uu8FwuW8Q7kNvwGr_Iln&_nc_oc=Adozj8nAFp8ripRM7f6aeNpjQ_4fhPnV6yMpUTbq1bhqXK-jgvL13NfZQFjf_Xmd9Xs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OT59cZijPafwK1w8t4OW6MCn24ynbCpDxiD44QL6I4Q&oe=6A0C80D0"}, "display_name": "MotoVRX - Bike Racing Game", "keywords": ["motorcycle", "racing", "circuit", "driving", "bike"], "long_description": "MotoVRX is a racing game that boosts your bike driving skills by taking you into a fearless racing smash. Release the crazy bike rider within you, prepare yourself for new motor bike driving games, practice on the real racing track with other street racers, and set the bike race tracks on fire. You can also select your favorite racing bike in a mega bike racing game and enter the classic infinite highway ride among heavy traffic away from the mayhem of city. Hurry up! A thrilling bike racing game with a fearless bike simulator experience awaits you.", "short_description": "Enter the classic world of 3D bike racing! Become a bike racer, gear up for a real bike driving experience or burn asphalt on the highway in this epic motorcycle simulation game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skippyapps.com/privacy.ht
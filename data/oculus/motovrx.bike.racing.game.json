om&_nc_ss=7f20f&oh=00_Af6NIrmRgDTX3e-c80T4GTwc2nbIIuZlGCBu_SUwbA-13A&oe=6A0DD3F2"}, {"file_name": "Screen-5.png", "id": "2019536228834071", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819982_2019536232167404_5597961447745592371_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOi5gbw0o1EQ7kNvwGEd3UU&_nc_oc=AdqbPf8SN-84d-6DQR3CQky_NhV30r6iKbQaQ9tfzr4sJhfa_sIko_Eo3bVok0F7abg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7maPF859ih7qmubYdmx634EfGk-i_qhR-DUYkM-Xlnpw&oe=6A0DB9BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-1.png", "id": "1929819555081086", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823783_1929819558414419_7468795062657877876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=in7uu8FwuW8Q7kNvwGJXooT&_nc_oc=AdqJZA3Ia-lDalC1WQJ22nfdNz42eQt3i7xG1hNv2ll8Xy1q_cT-diSbz1W2A3ADpMg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CC6XkxXCYazgQkHLTnkLBFHPxNSiIm4dxGHTbxF2hvQ&oe=6A0DD250"}, "display_name": "MotoVRX - Bike Racing Game", "keywords": ["motorcycle", "racing", "circuit", "driving", "bike"], "long_description": "MotoVRX is a racing game that boosts your bike driving skills by taking you into a fearless racing smash. Release the crazy bike rider within you, prepare yourself for new motor bike driving games, practice on the real racing track with other street racers, and set the bike race tracks on fire. You can also select your favorite racing bike in a mega bike racing game and enter the classic infinite highway ride among heavy traffic away from the mayhem of city. Hurry up! A thrilling bike racing game with a fearless bike simulator experience awaits you.", "short_description": "Enter the classic world of 3D bike racing! Become a bike racer, gear up for a real bike driving experience or burn asphalt on the highway in this epic motorcycle simulation game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skippyapps.com/privacy.ht
om&_nc_ss=7a30f&oh=00_Af1XeifWsiP1-1K3231IIk5ScDsYwKEsV1-KmCtYBxVe5Q&oe=69E76032"}, {"file_name": "Screen-5.png", "id": "2019536228834071", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819982_2019536232167404_5597961447745592371_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lP_r0HUhQdcQ7kNvwGsNJxT&_nc_oc=Adqa3TqGdH5cR9joIAR1fnuc_8M618ymCkHP55TvOBonPX6iwkdX-9IZtpIMWVzjzMo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MTO4soeLTxD7NmKfGZbQWFs67AUAmAkknVsMAiqhJpA&oe=69E77E3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-1.png", "id": "1929819555081086", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823783_1929819558414419_7468795062657877876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXZfW8CWLUcQ7kNvwHQN3-6&_nc_oc=AdosdqFwj0l3a8EhpLXMawes7dmz6Hq8h8z_Ga2R7FTG22iWAdAml6O9B4lWCidH2yI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iXQAbM_k-C_6B5Ps8tE-nDwZ3I-C7vmgslFYubFcQKQ&oe=69E75E90"}, "display_name": "MotoVRX - Bike Racing Game", "keywords": ["motorcycle", "racing", "circuit", "driving", "bike"], "long_description": "MotoVRX is a racing game that boosts your bike driving skills by taking you into a fearless racing smash. Release the crazy bike rider within you, prepare yourself for new motor bike driving games, practice on the real racing track with other street racers, and set the bike race tracks on fire. You can also select your favorite racing bike in a mega bike racing game and enter the classic infinite highway ride among heavy traffic away from the mayhem of city. Hurry up! A thrilling bike racing game with a fearless bike simulator experience awaits you.", "short_description": "Enter the classic world of 3D bike racing! Become a bike racer, gear up for a real bike driving experience or burn asphalt on the highway in this epic motorcycle simulation game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skippyapps.com/privacy.ht
om&_nc_ss=7f20f&oh=00_Af9yvF88cILade8d8qiCDNC_fp7ONxc4ZBQM4BfYoQzFdA&oe=6A32BDF2"}, {"file_name": "Screen-5.png", "id": "2019536228834071", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491819982_2019536232167404_5597961447745592371_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfpu6XuPrr0Q7kNvwHR9UnB&_nc_oc=AdqmcFL2c1tff3X2NI2oR8xcixN9h128qKR15QYkD_VuH9OUXNNPXddQIYOVjaDuQtk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DhFhx1vNDD5ZYOnBiwNNXHaiTvyJpUaXUrr4sA40ayA&oe=6A32A3BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen-1.png", "id": "1929819555081086", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823783_1929819558414419_7468795062657877876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2q57XODaO7gQ7kNvwFa2Lf_&_nc_oc=AdqJC2QVrWmQU1mTB9ATmrdAEDdqRoy1rTPyIbqe4vNY8f2Y1wXFOwoP0GKzay3Fcgo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_G3i_73sB2BVtw5fNAl04_HIMT6bn_-VHDcYS6Va1f5A&oe=6A32BC50"}, "display_name": "MotoVRX - Bike Racing Game", "keywords": ["motorcycle", "racing", "circuit", "driving", "bike"], "long_description": "MotoVRX is a racing game that boosts your bike driving skills by taking you into a fearless racing smash. Release the crazy bike rider within you, prepare yourself for new motor bike driving games, practice on the real racing track with other street racers, and set the bike race tracks on fire. You can also select your favorite racing bike in a mega bike racing game and enter the classic infinite highway ride among heavy traffic away from the mayhem of city. Hurry up! A thrilling bike racing game with a fearless bike simulator experience awaits you.", "short_description": "Enter the classic world of 3D bike racing! Become a bike racer, gear up for a real bike driving experience or burn asphalt on the highway in this epic motorcycle simulation game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skippyapps.com/privacy.ht
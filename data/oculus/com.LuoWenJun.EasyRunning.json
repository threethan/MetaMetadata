ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8iYTBo-1KCgQ7kNvwGCPt5x&_nc_oc=Adqs2_IXY3wLmJoXBZ6zd6D2BYYbtX4-S0m4ojBFJ8M0loEGtLvAmVw6MjBNiYhV1Z8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWPxnY9zM2CngySqcvNi7321VdyiemOwCx-LJcqHSWNQ&oe=6AB27D67"}, {"file_name": "EasyRunning.png", "id": "722457840870346", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618499_722457844203679_4206377367152050587_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDbNS1d2id8Q7kNvwGmYvWT&_nc_oc=Adp4yzu0P--vDCOQxWsz5lJtLnzEUP4x0sJbwwBrPBareCbgMmkpbC3CW4WiQV6-ZGg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILJO6fsHOnHvrSd9DdL77G1IpF5VkZljOo47azZWGgzA&oe=6AB2890A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "25601440.png", "id": "694805087039857", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619646_694805090373190_3091408056959959092_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-V9lieKfhJYQ7kNvwFqb1PV&_nc_oc=AdrfiTbYpgKyvYAMbV-CBciz_Qmrfi1Zg3vPaiOnpMHvd2FWf_CRRXk6S6awcW6CT9I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4VtfvBvUCks5UCUhkV3zCXQcg1OBbBp6bAU8aXoQ4Ew&oe=6AB27742"}, "display_name": "Easy Running", "keywords": ["indegame", "indiedev", "running", "sport", "fit"], "long_description": "Easy Running is a VR sports game that integrates health concepts with immersive experiences. Specifically designed to address the health issues caused by prolonged sitting among modern individuals, it focuses on exercising the gastrocnemius muscles (calf muscles). Leveraging VR technology, the game creates a series of dreamlike and vibrant virtual worlds, allowing players to enjoy the fun of fantasy adventures while completing calf exercises effortlessly during immersive running.  \n\nThe goal of VR Virtual Run is not only to provide players with an engaging VR game but also to promote the lifestyle concept of \"easy health\". It aims to break the inherent perception that \"exercise = boring + time-consuming\".\n\nThe development team hopes to use VR technology to make healthy exercise more convenient and appealing. By doing so, they aim to help more sedentary people develop the habit of fragmented exercise. Through these short calf-running sessions, the game intends to inject vitality into the body, allowing everyone to easily safeguard their physical and mental health while enjoying the fun of the game.\n", "short_description": "Easy Running is a VR sports game combining health and immersion. Focused on exercising calf gastrocnemius (human \"second heart\") for sedentary issues. Wear a VR headset to run in dreamy forest, Island or snowy scenes. Just a few minutes per time for joy and full exercise,Get health!"}]}, "developer_name": "WenJun Luo ", "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/easyrunning-privacy-policy/338a017d-23e4-46a3-9304-ae065a9bc149/privacy", "developer_terms_of_service_url": null, "publisher_name": "WenJun Luo ", "support_website_url": null, "website_url": "https://www.youtube.com/@luorob2087", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "ko", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25155686037403133"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820586_1333013441306698_4980040149982595994_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQWp3D5y
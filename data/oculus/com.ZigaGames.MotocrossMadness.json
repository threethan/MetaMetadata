A&oe=699C35E2"}, {"file_name": "1.png", "id": "287101797414283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974887_287101800747616_6923576556665363668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vMh_1vssa8Q7kNvwGWqmpj&_nc_oc=AdkH8nV04Jo9qNuOfUCEKe7RH1uCH3syD5fIr4KK2XYdrJlQIPNlavhulVRMHQm4HWA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsQ-ZZ0MmLdqB_kxoAbxAqm8NvrBjUk5ORE5akwdpb9Iw&oe=699C488C"}, {"file_name": "2.png", "id": "913216820263891", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974602_913216823597224_3937792375945948995_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTmmoZF6KzMQ7kNvwGss6_q&_nc_oc=Adm49fC7KTs9TGvmdlp7k5uXZb8WZgS-YOhOpl-NgS45LfghBXgy_7PrJRCp1i-ni2g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft6_AGjlyLulRSpTyKc9VzTJ29PGojLerC3D4YN-NruMg&oe=699C4016"}, {"file_name": "4.png", "id": "874566964449518", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031379_874566967782851_2446572475816525780_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFlZc5lxXVMQ7kNvwGwoZ3E&_nc_oc=AdlwRU05DURNhNGaTzo_yJv21bFzXWbYEp2whzUWnuUdWJWtwCE2RqGxzBxhynU0erk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuFNh_R21bVO39jGbRPM-a42nLNf0m_a7jvzeIe84sZ3g&oe=699C33AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "806389935000693", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031547_806389938334026_550285380725149568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bm9VZaot96QQ7kNvwHEBx-6&_nc_oc=AdkO5zS7z3YZRAaSOHuDoOATOoB3wGT_SBmsaBXadBxT8ilusdvvt1IWYR5DmYNqRE4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvlYI6smpJNb6bteMnybAoasRE_k37hOfLhCH1cGDA08w&oe=699C628A"}, "display_name": "Motocross Offroad Madness", "keywords": ["motocross", "race", "offroad", "bike", "motorbike"], "long_description": "Picture yourself straddling a powerful motocross bike, the engine roaring as you tear through rugged terrain. Whether you\u2019re racing against the clock, competing in high-flying motocross events, or exploring vast open-world maps, this game delivers the thrill of dirt, jumps, and adrenaline.\n\n\ud83c\udfcdPhysics :\ud83d\udee0\ufe0f\n Different dirt bikes with realistic physics without motion sickness. Each motorbike has unique riding experience. \n\n\ud83d\uddfa\ufe0fMaps : \ud83c\udf28\ufe0f\u2744\ufe0f\ud83c\udf24\ufe0f\ud83c\udf19\n Diffirent weather conditions (snowy, rainy, desert, night) , unique challenging maps. \n\n\ud83c\udfc1Remember to wear your virtual helmet\u2014it\u2019s about to get dusty out there! \ud83c\udfcd\ufe0f\ud83c\udf04\ud83d\udd25", "short_description": "Certainly! Let\u2019s rev up those virtual engines and hit the off-road trails in our imagination"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ketchygames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ziga Games", "support_website_url": null, "website_url": "https://www.zigagamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8736428626457803"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65227368_428636153505026_7942958988621684894_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EssWD019JkQ7kNvwHZomRX&_nc_oc=Adlxd
cdn.com/v/t64.5771-25/39031591_932845801194582_7363100007233063463_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYJ-HWZY_bkQ7kNvwER196k&_nc_oc=Adp-1deJBsp1jVbJGUkrV6OYMyh7CZyxsXbTbzgTJfnwepUP4ccwxZUKdikI63x7q9g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW5YP7KqDJOzFaEXyQoqK1_T7IMn4PxsQ1ePePwRm6B5A&oe=6B103522"}, {"file_name": "1.png", "id": "287101797414283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974887_287101800747616_6923576556665363668_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJvB1-ypdh8Q7kNvwFI7q1G&_nc_oc=AdqXLfcw008522yCherqcJqoT0FFoFV9HhwIUtHmgVy0alDaDMmHNCjji8Uf4qItE4M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX6nbKJf40GRPF7dg7ghvf8hK2dUYx-nevzG6ljhz5MeQ&oe=6B1047CC"}, {"file_name": "2.png", "id": "913216820263891", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974602_913216823597224_3937792375945948995_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDzccI6-iiAQ7kNvwFbE6lc&_nc_oc=AdraytbXRGerNX75_f2mPST3hOA4XV3NxP4_S8QJTMKr8DjAyt8IbvOqLayxR7_P4VI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX7DdUllCXD-Ps-uO-zqJUyjJpnhfmUz3P1Rf30zJTQLQ&oe=6B103F56"}, {"file_name": "4.png", "id": "874566964449518", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031379_874566967782851_2446572475816525780_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-Q_-Ygl0sMQ7kNvwHvwHgV&_nc_oc=AdpZv50KIZUeX1P1PYP7giJ0BHMTtpjMjR18u5OOORIcCAliw0JO3eeMfJcAUiEYCvY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWeraOYhM349TgAu7adKVAp_jDnwf2OqW7Rio0mwNfEUw&oe=6B106B2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "806389935000693", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031547_806389938334026_550285380725149568_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzc6Gkghj9YQ7kNvwF82i9S&_nc_oc=Adr__xhecLRVXRzJrdw2A4qjP52pvQLXIYnTtLFr0xAMsUbL6q-fw7mz3IknO7bYR-A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWnYSXWEAmgxxiveBorMp7LV2mfEVhaSvbsPuC--NwGmQ&oe=6B1061CA"}, "display_name": "Motocross Offroad Madness", "keywords": ["motocross", "race", "offroad", "bike", "motorbike"], "long_description": "Picture yourself straddling a powerful motocross bike, the engine roaring as you tear through rugged terrain. Whether you\u2019re racing against the clock, competing in high-flying motocross events, or exploring vast open-world maps, this game delivers the thrill of dirt, jumps, and adrenaline.\n\n\ud83c\udfcdPhysics :\ud83d\udee0\ufe0f\n Different dirt bikes with realistic physics without motion sickness. Each motorbike has unique riding experience. \n\n\ud83d\uddfa\ufe0fMaps : \ud83c\udf28\ufe0f\u2744\ufe0f\ud83c\udf24\ufe0f\ud83c\udf19\n Diffirent weather conditions (snowy, rainy, desert, night) , unique challenging maps. \n\n\ud83c\udfc1Remember to wear your virtual helmet\u2014it\u2019s about to get dusty out there! \ud83c\udfcd\ufe0f\ud83c\udf04\ud83d\udd25", "short_description": "Certainly! Let\u2019s rev up those virtual engines and hit the off-road trails in our imagination"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ketchygames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ziga Games", "support_website_url": null, "website_url": "https://www.zigagamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recomme
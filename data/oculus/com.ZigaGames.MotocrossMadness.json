cdn.com/v/t64.5771-25/39031591_932845801194582_7363100007233063463_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYJ-HWZY_bkQ7kNvwHQgmPI&_nc_oc=Adr6djkijngA_-LNoVKiAlxP3RNHuMUYBbymeIsmPneBn4kU2E4FnxvzJ0eONejqNCQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQX4na6cQaFWD6tej4tBJZnJk9v6Jhsf14HwRE-ieimcA&oe=6B0DCA62"}, {"file_name": "1.png", "id": "287101797414283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974887_287101800747616_6923576556665363668_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1sLhIQjEPoQ7kNvwGomiIo&_nc_oc=AdoXRCmbEDvLucHKsvJsLUh_LE1-H4RzGFbhpdbZSZl0si-JsutyvdmG5QSAc2k0jDA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSrsjWNDAz6J5aRwXUpAZVbTTgAEfRRhSm-w1NI4E2xMw&oe=6B0DA4CC"}, {"file_name": "2.png", "id": "913216820263891", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974602_913216823597224_3937792375945948995_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-7WbwPzYPgQ7kNvwEGX3M2&_nc_oc=AdqEKi36EjopmNfbdlj_PwO3FEuPniuke6yU7oYfVXlLFSIbZbZS0lAOFQ07iVuG7LI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSgoyfPDZY4gc4IJcdyhHmYmgQjN8GltDaGWqlGFzaeig&oe=6B0D9C56"}, {"file_name": "4.png", "id": "874566964449518", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031379_874566967782851_2446572475816525780_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jn4KJbc09OgQ7kNvwE6biy3&_nc_oc=Adqul6Yt9E9khYYK9RMR3uri2ziriYt2xyuAJNW0o1oOP2s88M6TxnZOuDoY2Q4uQ0s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQEvL-sct3gjAUteSTMkHTqFc3xvOrZyzt4cmNn0rfhSg&oe=6B0DC82D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "806389935000693", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031547_806389938334026_550285380725149568_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqOUMmW6zl0Q7kNvwFuQNHk&_nc_oc=Adr7VibhCbSWLt0F3ZIRZfc4oYtcZYMRQBfz-AYcv42_rKrazzY_7eT4giThiLu2kuk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQPswkh03TRUOXsjq-pNWY-DP0tjoM0_RuWaRvJpsMfAw&oe=6B0DBECA"}, "display_name": "Motocross Offroad Madness", "keywords": ["motocross", "race", "offroad", "bike", "motorbike"], "long_description": "Picture yourself straddling a powerful motocross bike, the engine roaring as you tear through rugged terrain. Whether you\u2019re racing against the clock, competing in high-flying motocross events, or exploring vast open-world maps, this game delivers the thrill of dirt, jumps, and adrenaline.\n\n\ud83c\udfcdPhysics :\ud83d\udee0\ufe0f\n Different dirt bikes with realistic physics without motion sickness. Each motorbike has unique riding experience. \n\n\ud83d\uddfa\ufe0fMaps : \ud83c\udf28\ufe0f\u2744\ufe0f\ud83c\udf24\ufe0f\ud83c\udf19\n Diffirent weather conditions (snowy, rainy, desert, night) , unique challenging maps. \n\n\ud83c\udfc1Remember to wear your virtual helmet\u2014it\u2019s about to get dusty out there! \ud83c\udfcd\ufe0f\ud83c\udf04\ud83d\udd25", "short_description": "Certainly! Let\u2019s rev up those virtual engines and hit the off-road trails in our imagination"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ketchygames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ziga Games", "support_website_url": null, "website_url": "https://www.zigagamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recomme
cdn.com/v/t64.5771-25/39031591_932845801194582_7363100007233063463_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=li6VI4ZCgiwQ7kNvwFNoZLF&_nc_oc=Ado7WLPCSz3uAPV_aAjfhJXNvcn0eTAtgF75R9QTr0ckUbIxIF6-5XjM-cV-8fapJsc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkR2jzAwcqCOoAEgW2GGvlVCDv1K_6r8ID5Rv0_pl2_A&oe=6B01ECE2"}, {"file_name": "1.png", "id": "287101797414283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974887_287101800747616_6923576556665363668_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQshPsbncq0Q7kNvwFdVZ9s&_nc_oc=AdrgXKq-gWGWzKSAhPf8nJfbst9-S5FM9ZELks9uLhHr4r9TGi_f9YBXa_kEPUa2iPk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTb3zAn3B0713MjFXKZLL3k5e22FOIzXOD103T3KorSkg&oe=6B01C74C"}, {"file_name": "2.png", "id": "913216820263891", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974602_913216823597224_3937792375945948995_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEXFJyFW6xIQ7kNvwEeDPc_&_nc_oc=Adrt9Dp1-Yuy8VRL1aQEThMzuk9jZEZC-VnPqXO2laGVzmi95vqed5gO_xuZ_nMf4KQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfixmO_zwyBdDXLlF5yZdHn-bDdCxmrXv0Jlvw8qH2vg&oe=6B01BED6"}, {"file_name": "4.png", "id": "874566964449518", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031379_874566967782851_2446572475816525780_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sf6hePnghKAQ7kNvwHlll-C&_nc_oc=AdrTxfU7zn1YgqOcivzaFfHN84J6Ej0em24R9esbZSieJvRDd_d7MDMkGaZHkMqL_ug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJLhy2cIxD-wTF30FrlzJXTdsinF8o-7VyMei3uLTwYA&oe=6B01EAAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "806389935000693", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031547_806389938334026_550285380725149568_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3X83S-gFZXcQ7kNvwE-vkzK&_nc_oc=AdrSri2MZVfk3wvInKxm0x1RzRESfM-cKDEYSYZmDj1ziOLauD5EVBNsEJPuVQYGtoE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFKw8aRzllVTV2G_efG1O-EQyja5U27tpgw_2P8qx-ug&oe=6B01E14A"}, "display_name": "Motocross Offroad Madness", "keywords": ["motocross", "race", "offroad", "bike", "motorbike"], "long_description": "Picture yourself straddling a powerful motocross bike, the engine roaring as you tear through rugged terrain. Whether you\u2019re racing against the clock, competing in high-flying motocross events, or exploring vast open-world maps, this game delivers the thrill of dirt, jumps, and adrenaline.\n\n\ud83c\udfcdPhysics :\ud83d\udee0\ufe0f\n Different dirt bikes with realistic physics without motion sickness. Each motorbike has unique riding experience. \n\n\ud83d\uddfa\ufe0fMaps : \ud83c\udf28\ufe0f\u2744\ufe0f\ud83c\udf24\ufe0f\ud83c\udf19\n Diffirent weather conditions (snowy, rainy, desert, night) , unique challenging maps. \n\n\ud83c\udfc1Remember to wear your virtual helmet\u2014it\u2019s about to get dusty out there! \ud83c\udfcd\ufe0f\ud83c\udf04\ud83d\udd25", "short_description": "Certainly! Let\u2019s rev up those virtual engines and hit the off-road trails in our imagination"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ketchygames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ziga Games", "support_website_url": null, "website_url": "https://www.zigagamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recomme
cdn.com/v/t64.5771-25/39031591_932845801194582_7363100007233063463_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CyK_Ei6Qq4oQ7kNvwF-XPYi&_nc_oc=AdoDNIZ6edxBlTPD0ho7EIxNzKzN_fxTbhEPKCT83QqqapAZFvfmWUB4snoNCJQLQmM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUJu7nkGEac09GT9eafvxpYCRenhMVpCNDVR-QsIjC_Q&oe=6B06FAA2"}, {"file_name": "1.png", "id": "287101797414283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974887_287101800747616_6923576556665363668_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7CRPS6-OhUQ7kNvwH7_3XL&_nc_oc=AdrEDb7wvt1c-rjfE81OBdzEi_luiTToROFU1osaVkzn667G7_48RP9mJFKxXeOiPgE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkWmrMbN1qnEuN5WH8yr7qaENXLGPCRGatXCBVz4WoKQ&oe=6B070D4C"}, {"file_name": "2.png", "id": "913216820263891", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974602_913216823597224_3937792375945948995_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDW5JLmjrsAQ7kNvwG3V3Az&_nc_oc=Adq_adBmaCNekPD8s8CG-f49rdoaqUBQyLcPPDyAJ4a4DE_aeAzf_il3_S5tLMWmF7o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR66RlHuRhvXPFws7jBqYjDvVjAC7o8e_PVBBdfUor6DA&oe=6B0704D6"}, {"file_name": "4.png", "id": "874566964449518", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031379_874566967782851_2446572475816525780_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cG9bvGHO1Z8Q7kNvwECevpj&_nc_oc=AdrhezxFiQ2rLUrxdmQ-QhAGe8JyW0yDjvBi5RUyi6ujPiFY5RUqjrl9xfAcJAHa2O8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScIpk-BOH9sXczWOwqw6zP5eO8RpkUFI3mBpFb-BBXjQ&oe=6B06F86D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "806389935000693", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031547_806389938334026_550285380725149568_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBNCvA5tXZAQ7kNvwFs6vNU&_nc_oc=Adpo8tt6O5kM88iRog6kPya5OCuQ5AyBOSZQu2nCqxCsvpOwFlqJJwnCriPgnX0AaGw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUaonbBDkwwFpq0eA23miCQEeA3dl_uS69GXZpEeSeEw&oe=6B07274A"}, "display_name": "Motocross Offroad Madness", "keywords": ["motocross", "race", "offroad", "bike", "motorbike"], "long_description": "Picture yourself straddling a powerful motocross bike, the engine roaring as you tear through rugged terrain. Whether you\u2019re racing against the clock, competing in high-flying motocross events, or exploring vast open-world maps, this game delivers the thrill of dirt, jumps, and adrenaline.\n\n\ud83c\udfcdPhysics :\ud83d\udee0\ufe0f\n Different dirt bikes with realistic physics without motion sickness. Each motorbike has unique riding experience. \n\n\ud83d\uddfa\ufe0fMaps : \ud83c\udf28\ufe0f\u2744\ufe0f\ud83c\udf24\ufe0f\ud83c\udf19\n Diffirent weather conditions (snowy, rainy, desert, night) , unique challenging maps. \n\n\ud83c\udfc1Remember to wear your virtual helmet\u2014it\u2019s about to get dusty out there! \ud83c\udfcd\ufe0f\ud83c\udf04\ud83d\udd25", "short_description": "Certainly! Let\u2019s rev up those virtual engines and hit the off-road trails in our imagination"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ketchygames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ziga Games", "support_website_url": null, "website_url": "https://www.zigagamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recomme
w&oe=699992E2"}, {"file_name": "1.png", "id": "287101797414283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974887_287101800747616_6923576556665363668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvrB4oDYlnoQ7kNvwHD6spR&_nc_oc=AdknDpIgVCeWHnXAzts7OLI-n8WUhUMenQCEN5kDzDhWmMUqswfqrXRFL79quoxshkc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvDrNJlHxh5NVPXtKPdp8w-bvt-OdSZGaY2ouNHR-TtcA&oe=6999A58C"}, {"file_name": "2.png", "id": "913216820263891", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974602_913216823597224_3937792375945948995_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ES5UwdQiEeQQ7kNvwFkuM48&_nc_oc=AdluWSINcL4htkr0jPpIto44uj75MOrKAtMXUzFxpWE03fvj2K9DRN-REIy1GywosyM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsX9COTswEPuz5nEOhmDA5V17QSuoLreIkIi6Pdljn-OQ&oe=69999D16"}, {"file_name": "4.png", "id": "874566964449518", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031379_874566967782851_2446572475816525780_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bRPjUfUfp4Q7kNvwHrywmG&_nc_oc=Adm2P1Drv7VuTP-6Br2CeW7e9tEAzDlpcwyGTcXW3plkKIqqIMGp4ZMbl5cnELCo-_8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftWoNmzqIaEQT7ba0uLDwPltHk8uU_jKZOlrsjiVv1m7w&oe=699990AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "806389935000693", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031547_806389938334026_550285380725149568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEHvdtDZgcAQ7kNvwE-5gQp&_nc_oc=AdnurKRU4x-qTlEPhjs2hA3nAsvYVGqytCPp4vkb21HzKGxul_w5rZi7NJ6GYpbWfvs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu5y_ZH6UVXiiSsFcyO2xho_s67NFu7kfqqbvItzwiWYA&oe=6999BF8A"}, "display_name": "Motocross Offroad Madness", "keywords": ["motocross", "race", "offroad", "bike", "motorbike"], "long_description": "Picture yourself straddling a powerful motocross bike, the engine roaring as you tear through rugged terrain. Whether you\u2019re racing against the clock, competing in high-flying motocross events, or exploring vast open-world maps, this game delivers the thrill of dirt, jumps, and adrenaline.\n\n\ud83c\udfcdPhysics :\ud83d\udee0\ufe0f\n Different dirt bikes with realistic physics without motion sickness. Each motorbike has unique riding experience. \n\n\ud83d\uddfa\ufe0fMaps : \ud83c\udf28\ufe0f\u2744\ufe0f\ud83c\udf24\ufe0f\ud83c\udf19\n Diffirent weather conditions (snowy, rainy, desert, night) , unique challenging maps. \n\n\ud83c\udfc1Remember to wear your virtual helmet\u2014it\u2019s about to get dusty out there! \ud83c\udfcd\ufe0f\ud83c\udf04\ud83d\udd25", "short_description": "Certainly! Let\u2019s rev up those virtual engines and hit the off-road trails in our imagination"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ketchygames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ziga Games", "support_website_url": null, "website_url": "https://www.zigagamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8736428626457803"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/65227368_428636153505026_7942958988621684894_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wU-NtakhfbMQ7kNvwHgoWEY&_nc_oc=Adlcg
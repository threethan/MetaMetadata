=6e7a0a&_nc_ohc=3X83S-gFZXcQ7kNvwGgGAON&_nc_oc=AdrXJWmKE21_zRQM-nDDzPyL1PDBraBeUME3if91ys11p_mSi0aPQCdgaUOndycsXRY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNzb9O29P1RSely0EGarCFvpcDsb-167qH-4Sqz4i5kQ&oe=6AFF060A"}, "display_name": "Motocross Offroad Madness", "keywords": ["motocross", "race", "offroad", "bike", "motorbike"], "long_description": "Picture yourself straddling a powerful motocross bike, the engine roaring as you tear through rugged terrain. Whether you\u2019re racing against the clock, competing in high-flying motocross events, or exploring vast open-world maps, this game delivers the thrill of dirt, jumps, and adrenaline.\n\n\ud83c\udfcdPhysics :\ud83d\udee0\ufe0f\n Different dirt bikes with realistic physics without motion sickness. Each motorbike has unique riding experience. \n\n\ud83d\uddfa\ufe0fMaps : \ud83c\udf28\ufe0f\u2744\ufe0f\ud83c\udf24\ufe0f\ud83c\udf19\n Diffirent weather conditions (snowy, rainy, desert, night) , unique challenging maps. \n\n\ud83c\udfc1Remember to wear your virtual helmet\u2014it\u2019s about to get dusty out there! \ud83c\udfcd\ufe0f\ud83c\udf04\ud83d\udd25", "short_description": "Certainly! Let\u2019s rev up those virtual engines and hit the off-road trails in our imagination"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ketchygames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ziga Games", "support_website_url": null, "website_url": "https://www.zigagamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recomme
g&oe=699AE462"}, {"file_name": "1.png", "id": "287101797414283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974887_287101800747616_6923576556665363668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvrB4oDYlnoQ7kNvwFDi1QE&_nc_oc=AdkvQnUglb8vdE2DhOyAneEG7C07XMG_lwMpG4vDC5vU6C3X3hi5clvetUze0c_rL04&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfszTLCx3VSGfnI8k10T5QRgC44q4ujjm8GnRnsswLEjgQ&oe=699AF70C"}, {"file_name": "2.png", "id": "913216820263891", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974602_913216823597224_3937792375945948995_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTmmoZF6KzMQ7kNvwFpKcXw&_nc_oc=Adkrjk3cdblwPi9ZZzsSemZUSf1kIrdtBmv1NchibX9Ra_vO8SYKR0tLCZTMFzv5ffM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsamDDbZ3o0PJ7ochpwx7uXbJ0eSl-Dn5ynfdO5pgDpWQ&oe=699AEE96"}, {"file_name": "4.png", "id": "874566964449518", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031379_874566967782851_2446572475816525780_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bRPjUfUfp4Q7kNvwFUHtoi&_nc_oc=AdnHFYP6s0so2UPvTV0eZWldxM89jXX-mBaVQCsOouQZyHIaCV-E_sV_MV33P9rR_WU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuXhzcJiVdZzQ7pBbN0TO4WMUFzyz3xzfF7Jax1Y0GEIQ&oe=699AE22D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "806389935000693", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031547_806389938334026_550285380725149568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bm9VZaot96QQ7kNvwFQ2gBF&_nc_oc=AdmMBz4eNnV1pFv0-uLW8mVBUcZPVvVl-BPJ8AkGPYELwu3rY3xDUby9ni3yfUm865E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvBFmkmwER5RpSaIbT8jyLXZZD2ntP_2H8lVywv_ws6hQ&oe=699B110A"}, "display_name": "Motocross Offroad Madness", "keywords": ["motocross", "race", "offroad", "bike", "motorbike"], "long_description": "Picture yourself straddling a powerful motocross bike, the engine roaring as you tear through rugged terrain. Whether you\u2019re racing against the clock, competing in high-flying motocross events, or exploring vast open-world maps, this game delivers the thrill of dirt, jumps, and adrenaline.\n\n\ud83c\udfcdPhysics :\ud83d\udee0\ufe0f\n Different dirt bikes with realistic physics without motion sickness. Each motorbike has unique riding experience. \n\n\ud83d\uddfa\ufe0fMaps : \ud83c\udf28\ufe0f\u2744\ufe0f\ud83c\udf24\ufe0f\ud83c\udf19\n Diffirent weather conditions (snowy, rainy, desert, night) , unique challenging maps. \n\n\ud83c\udfc1Remember to wear your virtual helmet\u2014it\u2019s about to get dusty out there! \ud83c\udfcd\ufe0f\ud83c\udf04\ud83d\udd25", "short_description": "Certainly! Let\u2019s rev up those virtual engines and hit the off-road trails in our imagination"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ketchygames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ziga Games", "support_website_url": null, "website_url": "https://www.zigagamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8736428626457803"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65227368_428636153505026_7942958988621684894_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wU-NtakhfbMQ7kNvwFy9tDm&_nc_oc=Admnf
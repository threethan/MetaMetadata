cdn.com/v/t64.5771-25/39031591_932845801194582_7363100007233063463_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CyK_Ei6Qq4oQ7kNvwF-G19Z&_nc_oc=AdoMT4xn8_0-GadpJfWQPmklyxOiFkw3EWQqyyZgi7Ey7BZUjCgJmrdEbzzrdzOhtFU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRY8U-0gIRFduq7WrzPWGrPEKcK0XyjoAxeLrAQ1gmrFg&oe=6B084C22"}, {"file_name": "1.png", "id": "287101797414283", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974887_287101800747616_6923576556665363668_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWqrV0NNrPkQ7kNvwE3xrJe&_nc_oc=AdruaKEzKp93BzmCvmss_ech5aFaoNIfbwXyEDFnOLd7yZruwb50Xpq6dInDQMeQm6o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGR53zj7lyQXPn8rb5kVmjsIklBH2B_Mumipi3sD8m-A&oe=6B085ECC"}, {"file_name": "2.png", "id": "913216820263891", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974602_913216823597224_3937792375945948995_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDW5JLmjrsAQ7kNvwF4liP1&_nc_oc=AdomvPVXcKsRd6Cwh-W3Du8phGJQzPW_9sAD3Ufn8Ct3yDNfGHLdTvEVK2X70o1URrk&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZSu7vXvgeLPe8zioAfNw_r8Sluase8DfDedZ4MgBPpg&oe=6B085656"}, {"file_name": "4.png", "id": "874566964449518", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031379_874566967782851_2446572475816525780_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDBg7gdjfNgQ7kNvwE0g6AK&_nc_oc=Ado2CQqUCMx0mJpgEmBTLAByBbWX8K6ydNJVR1pb58zHTQvdxCc4qRPnU0W1dz6b5i0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7NtGcJu4EtexDJQHX9JOCdscI_FAiz3eULDxNY6lO_A&oe=6B0849ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "806389935000693", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39031547_806389938334026_550285380725149568_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBNCvA5tXZAQ7kNvwF_pQnH&_nc_oc=AdrWXf4qJ2bcezXcGmHvQL_0HgqztEROtWqnkbEwjjly2ybx6HOQ43cdC7jK5EfkD4c&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4JFz6AzzjDBizixHzKPH_xrQLhpLu4t9xG0Zm4-fLow&oe=6B08408A"}, "display_name": "Motocross Offroad Madness", "keywords": ["motocross", "race", "offroad", "bike", "motorbike"], "long_description": "Picture yourself straddling a powerful motocross bike, the engine roaring as you tear through rugged terrain. Whether you\u2019re racing against the clock, competing in high-flying motocross events, or exploring vast open-world maps, this game delivers the thrill of dirt, jumps, and adrenaline.\n\n\ud83c\udfcdPhysics :\ud83d\udee0\ufe0f\n Different dirt bikes with realistic physics without motion sickness. Each motorbike has unique riding experience. \n\n\ud83d\uddfa\ufe0fMaps : \ud83c\udf28\ufe0f\u2744\ufe0f\ud83c\udf24\ufe0f\ud83c\udf19\n Diffirent weather conditions (snowy, rainy, desert, night) , unique challenging maps. \n\n\ud83c\udfc1Remember to wear your virtual helmet\u2014it\u2019s about to get dusty out there! \ud83c\udfcd\ufe0f\ud83c\udf04\ud83d\udd25", "short_description": "Certainly! Let\u2019s rev up those virtual engines and hit the off-road trails in our imagination"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ketchygames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ziga Games", "support_website_url": null, "website_url": "https://www.zigagamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recomme
A337"}, {"file_name": "4_HighresScreenshot00085_2560x1440_v2.png", "id": "1557195071137500", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031449_1557195074470833_8142168027763823661_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdagAEvR1fgQ7kNvwFa1XeG&_nc_oc=Adli8FFqSPwwgBV_QhgJslIr_x38Q8y6jELE0KtBvlzjYL32hFGo8LTOQ6p6vWty8u8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxHCulk5Eph08sTW-HLss7tzYqZyS4qFLS9kKGBF3WChQ&oe=69BA88BF"}, {"file_name": "5_HighresScreenshot00087_2560x1440_v2.png", "id": "712461356131687", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974453_712461359465020_8539607468778894284_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7TiLc662i4Q7kNvwGxqPeU&_nc_oc=Adn4ejASubxywui2Tu2dnjoO4kRyMEVXKfYSG60fX1U0EwqLSs9BBd-945oH2am6WuQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyk8hZXv1cp0lsou-XPFglp8-RINPZY2IO9YHPcd8ujMA&oe=69BA8D07"}, {"file_name": "2_HighresScreenshot00032_2560x1440.png", "id": "751530432138512", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974879_751530435471845_37787088935008532_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gtmIE-7ZtwQ7kNvwERcxjx&_nc_oc=AdkFspR30wd8FrzsSUvR4LhLUTyyjOjN1kOhmD8fQ1RWOcAif4TMDkbX1OIR-T6n-Ss&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxuUMmMPOpzrLJ8IEHLCf7gyow7HGzbf9VZtNyD1FKKDw&oe=69BA8E5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "first_steps_handtracking_poster.png", "id": "135378945161578", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031528_135378948494911_7379521461747766087_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLHrSuSPRnwQ7kNvwENbm1Q&_nc_oc=Adn8Okny7FZ6miIaf28ATDCIYfpBA_MPfo-tF4jl24a0Yfo4Pgtg-TdOUuIJ6JKWf2Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyZNEbGPB6k01hvzBCZsGnnTg0tJTYVNKRj4R7W0Pt-FQ&oe=69BA9C8D"}, "display_name": "First Steps With Hand Tracking", "keywords": [], "long_description": "If you\u2019re a developer, you should check out how hand tracking can replace your Touch Controller experience. This experimental version of First Steps showcases how your Touch Controllers can be replaced with hand tracking, and add a new dimension to your application. Our development team did not have to redesign new mechanics, but were able to replace Touch Controllers with Hands without a heavy lift.", "short_description": "First Steps is a highly acclaimed introduction to virtual reality by Oculus. First Steps was originally released to showcase our Touch Controllers. However we\u2019ve upgraded the experience by adding hand tracking to this Oculus Quest and Quest 2 experience. "}]}, "developer_name": "Oculus", "developer_privacy_policy_url": "https://www.oculus.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://www.oculus.com/legal/terms-of-service/", "publisher_name": "Oculus", "support_website_url": null, "website_url": "https://developer.oculus.com/blog/adding-hand-tracking-to-first-steps/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "989231825072538"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974444_2904288433175713_13193717315425637_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMJ2cvlLVz0Q7kNvwGGURmM
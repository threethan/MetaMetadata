F4B7"}, {"file_name": "4_HighresScreenshot00085_2560x1440_v2.png", "id": "1557195071137500", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031449_1557195074470833_8142168027763823661_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdagAEvR1fgQ7kNvwGcKTVv&_nc_oc=AdkaNygSKDcVI6C4WdWGIQoXVZpj7U1RX9QkprsfVrswgkde5eh4FpHkvY-9iCfm1AQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyutTki5wjZpO-foBI64FefNyn_D_PrXwW3B-P4fKCQQQ&oe=69BBDA3F"}, {"file_name": "5_HighresScreenshot00087_2560x1440_v2.png", "id": "712461356131687", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974453_712461359465020_8539607468778894284_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7TiLc662i4Q7kNvwGB2aRX&_nc_oc=AdnaPQwxlCy1nkvnwncHQwXeWQU5ZhIcgV5zp4tUFTHQiilJICdgi3INbiaKNXzFN30&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxSQFbxY-nysdFcuTK2ddBpis82C2D7J70ob1Zb_QKV5Q&oe=69BBDE87"}, {"file_name": "2_HighresScreenshot00032_2560x1440.png", "id": "751530432138512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974879_751530435471845_37787088935008532_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gtmIE-7ZtwQ7kNvwHcC0OF&_nc_oc=AdmAnclRAREBn5gjSxKe6As1ljA9hBn98AldDjaApxCpvgkJL-p9LNjoOtsb9rqlwg4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6zbOVHPkY9l04xjpACZULo3Nmj2UoGuR5tC4NQm2eDQ&oe=69BBDFDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "first_steps_handtracking_poster.png", "id": "135378945161578", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031528_135378948494911_7379521461747766087_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8mCOvGS_zkQ7kNvwF7r6UH&_nc_oc=AdnK2ErQNC5Dt9OQERLR5Xksq0OetWCL4L3zJeDtptS_C9XcBRBIg-3M2DVhQX5mZ8s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwtg1m1W_P5g3J2Y0Mo5PxG82rLEADTvOHrFjW4ptVBlA&oe=69BBEE0D"}, "display_name": "First Steps With Hand Tracking", "keywords": [], "long_description": "If you\u2019re a developer, you should check out how hand tracking can replace your Touch Controller experience. This experimental version of First Steps showcases how your Touch Controllers can be replaced with hand tracking, and add a new dimension to your application. Our development team did not have to redesign new mechanics, but were able to replace Touch Controllers with Hands without a heavy lift.", "short_description": "First Steps is a highly acclaimed introduction to virtual reality by Oculus. First Steps was originally released to showcase our Touch Controllers. However we\u2019ve upgraded the experience by adding hand tracking to this Oculus Quest and Quest 2 experience. "}]}, "developer_name": "Oculus", "developer_privacy_policy_url": "https://www.oculus.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://www.oculus.com/legal/terms-of-service/", "publisher_name": "Oculus", "support_website_url": null, "website_url": "https://developer.oculus.com/blog/adding-hand-tracking-to-first-steps/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "989231825072538"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974444_2904288433175713_13193717315425637_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMJ2cvlLVz0Q7kNvwF7rgOC
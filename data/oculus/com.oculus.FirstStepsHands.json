E937"}, {"file_name": "4_HighresScreenshot00085_2560x1440_v2.png", "id": "1557195071137500", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031449_1557195074470833_8142168027763823661_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTzADxjBvdcQ7kNvwGfj0GC&_nc_oc=Adl4p83axYFF77gOFf6SjlRblZS3J0kK__TAogsUeqBwiC7AJ4juc4z2Uv4AycQXCKk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxhfdfekhqU0eahdKa8EkQ6GRk6Ow47E3OBYPgvVY83CQ&oe=69BFCEBF"}, {"file_name": "5_HighresScreenshot00087_2560x1440_v2.png", "id": "712461356131687", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974453_712461359465020_8539607468778894284_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z0bfQSl_ucAQ7kNvwEZJZQh&_nc_oc=Adn7smrDagnrc-S9PB1HtbwcTcHyL4j6QTlQyG8afvJg0lKrUB554Qyq11IZD10mYHM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVo1lsxFjWwSNSvQW5LYxVxBlYQaXf1AhUXxVUoj5LLQ&oe=69BFD307"}, {"file_name": "2_HighresScreenshot00032_2560x1440.png", "id": "751530432138512", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974879_751530435471845_37787088935008532_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49LKXeswRHEQ7kNvwHHUlDY&_nc_oc=AdkE679Yhf_DVtd7fUaKu1H7g7iCeoA4AAJW8Vo79saeqnEk4ruPwBA1qxZiC-F68wQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzrsx0gxHNac4LHFbyLFRKv8f3O_gTffQR0QVqQ_IhpHg&oe=69BFD45C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "first_steps_handtracking_poster.png", "id": "135378945161578", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031528_135378948494911_7379521461747766087_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdjOQxzzivMQ7kNvwF7i3RX&_nc_oc=AdlvRXqhLMAo9RaMvbnLea_7VwlzQ-RLH0P-ctQi-vnsLRDsv0ZwoUCnuajh8vb2vw0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy1ywzjJCAhNqwPkF0nxTlrC_ZdsZskxCv8H7dWZ063MQ&oe=69BFE28D"}, "display_name": "First Steps With Hand Tracking", "keywords": [], "long_description": "If you\u2019re a developer, you should check out how hand tracking can replace your Touch Controller experience. This experimental version of First Steps showcases how your Touch Controllers can be replaced with hand tracking, and add a new dimension to your application. Our development team did not have to redesign new mechanics, but were able to replace Touch Controllers with Hands without a heavy lift.", "short_description": "First Steps is a highly acclaimed introduction to virtual reality by Oculus. First Steps was originally released to showcase our Touch Controllers. However we\u2019ve upgraded the experience by adding hand tracking to this Oculus Quest and Quest 2 experience. "}]}, "developer_name": "Oculus", "developer_privacy_policy_url": "https://www.oculus.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://www.oculus.com/legal/terms-of-service/", "publisher_name": "Oculus", "support_website_url": null, "website_url": "https://developer.oculus.com/blog/adding-hand-tracking-to-first-steps/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "989231825072538"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_2904288433175713_13193717315425637_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPuL8Ts1BWQQ7kNvwHJ1Yrh
jILaEymVzILlE2NMwRTf8wAVrPb9X6wEw0A&oe=6AF2090D"}, {"file_name": "backrooms_3_2560x1440.png", "id": "1315098800582595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_1315098803915928_6950611714737823793_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKzhx9pypsgQ7kNvwH-5sTE&_nc_oc=AdrfKqvgO8ti75COuCoo2vZW7K2IwwgAsCGM7-GurlAg_6VmmN3LkC6qfLjIAUQ8DUc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0JqFEFcLcb9xIqcJe9sg-tDorYjCXzgVvm0HYmISo7Q&oe=6AF1D2EB"}, {"file_name": "backrooms_4_2560x1440.png", "id": "1087489556993214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825305_1087489563659880_5583937633057025447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9u3HKgeXeCMQ7kNvwG_CUHK&_nc_oc=AdropsGTEEtiRWnH0EgYM1esbP864IzrDHlhTmShlMtTZ8tdWvZroL2w2eKAs2Vx8JI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2cJ1euzwSgrKN6mLtszrC2YBACPSxZCnemHrEfatZ7g&oe=6AF1EC3A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clark Rooms", "keywords": ["backrooms", "scary", "clark", "rooms", "lethal"], "long_description": "You weren't supposed to end up here.\n\nOne wrong step and you've slipped out of reality into the Backrooms: an endless maze of damp yellow carpet, buzzing fluorescent lights, and hallways that never seem to end. There's no map and no clear way out. The only way forward is to keep moving.\n\nExplore the Backrooms in VR with gorilla locomotion. Every level feels different. Wander through the classic yellow halls, get lost in silent flooded poolrooms, and push into darker, stranger places the deeper you go. Some rooms feel calm. Some feel wrong. Learning which is which is part of surviving.\n\nBecause you are not alone.\n\nSomewhere in the dark, things are moving. You'll hear footsteps that aren't yours, distant noises echoing through the walls, and lights that flicker just before something shows up. When a monster spots you, there's no fighting back. Your only choice is to run for your life and hope it can't follow where you go.\n\nHow far can you make it before the Backrooms catch you?", "short_description": "You noclipped out of reality, and now you're somewhere you shouldn't be. Explore the endless, humming halls of the Backrooms in VR with gorilla locomotion, from flickering yellow offices to eerie flooded poolrooms and stranger places beyond. But stay alert. Something is hunting you, and when you hear it coming, you'd better run. How deep can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://clark-rooms.netlify.app/", "developer_terms_of_service_url": null, "publisher_name": "JJ", "support_website_url": null, "website_url": "https://clark-rooms.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1364113113454606"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1642658804183752"}]}, "baseline_offer": {"id": "1642658804183752"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791329340, "status": "PUBLISHED", "id": "1642658804183752"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1426364100562840", "version": "3.41"}, "id": "1346712803970433", "channel_name": "LIVE"}]}, "is_
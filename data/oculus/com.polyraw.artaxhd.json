30f&oh=00_AQR519FoFEfdIaplojHUYLo95L5tzdCjjKeyEs0-WY9Ldg&oe=6B0B2185"}, {"file_name": "Screenshot03.png", "id": "1026259675517039", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75371503_1026259678850372_7429131818924124256_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFQQu83YTgMQ7kNvwHiksz0&_nc_oc=AdpAk1ehouSYdrCv99pCFiMoWDP6hE-LbLH0dJVTU9OJ91jGflTFBPh2FRBksNxLaFY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS36FYKsmCbmLkcL5GN4CPHu3VpGcUfbXuSbTb_I723AQ&oe=6B0B2E9E"}, {"file_name": "Screenshot02.png", "id": "1008481184020716", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQA0bXvW0v8Q7kNvwHpgMHl&_nc_oc=AdrZjiufIgwSTWtf_ftRdJ8No6ihIgMThoIeWAW17DvwA7wDJ4AFgrHusJ6uzQwMW00&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSgl6_xGrL9fhhx4e3b6YcO4lRIiYeUh4C5KAqVrnon1A&oe=6B0B41C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A57mMCQqhm8Q7kNvwEIxnsY&_nc_oc=AdqG3x2AwuExwHHVlfVEl8VCG9Mnzng2FJABmN67QSQ-b65uDJkkixGh3OiKs9gyxew&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTZ6ACouGLrv1gsJdXEWH4N2Y6fne-dPEw_oVvpqGvplA&oe=6B0B2423"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribu
ord5-3.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLFH9EFLugcQ7kNvwEF2U9V&_nc_oc=AdmTd700PCv39O5mXS_ctxNaG1OEAasDSw0d_IlxFI05t3CpLGvXltNCFE5z3qEohR4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuPvw_T2-TF79z3yCVA2y44MZ0pYzCqjNNXr4KSJ0861Q&oe=699C5045"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4lWwpVQTIIQ7kNvwGB8S2V&_nc_oc=Adkqyc1W-msDw__Qb5uwG-0019h2d-KAZQ1-BJ7vfRUwUe2YOJ8ho20FrZp82UndwJg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftEG2WptHvIEVDu0psTQ71J66yxa_IZZwBxsvLKRoZuUg&oe=699C32A3"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribute to a captivating visual experience, while the innovative gameplay offers unique and engaging challenges. Get ready to embark on an unforgettable adventure in a magical world.", "short_description": "In Artax, you guide a toy soldier through a dreamlike world in search of Bulf, a character who has escaped from his box. Explore a fascinating miniature world with incredible details, an engaging atmosphere, and innovative gameplay. Help Artax overcome obstacles and enemies to return Bulf to his world and restore order to their magical universe."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polyrawdevelopment.com/PR_ArtaxPrivacyPolicy.html", "developer_terms_of_servic
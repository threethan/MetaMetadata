zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyTgmkHWfH7A6ImQgbBYr8-rtO0Gis6-lFeNDCY6TC8Q&oe=6AF48CDE"}, {"file_name": "Screenshot02.png", "id": "1008481184020716", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uz6lLmdWnBYQ7kNvwFGDFAn&_nc_oc=AdolG3d9fhqspJaSnp0OSVBIENVawb2H8_BpV5ILzYeqAiiE1ndfzfAV3cEC-C302ek&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjf_FdBK7Wj6hdMxAn9hy2RwP0lh-8yxZLtZV-6_ETiA&oe=6AF4A005"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kdb0qmgTM54Q7kNvwGB8Gc2&_nc_oc=AdoBrf1bMLL3R_5a-NqKyZjs0OgEj5bEbG7rSPqVVZHVwT3Mh_JnP0w6tyKJqYw41SI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRh3ig-bPgMrXWzKeECrzEV5j86kKZ2WAXNZ5u7CEEHgw&oe=6AF48263"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribute to a captivating visual experience, while the innovative gameplay offers unique and engaging challenges. Get ready to embark on an unforgettable adventure in a magical world.", "short_description": "In Artax, you guide a toy soldier through a dreamlike world in search of Bulf, a character who has escaped from his box. Explore a fascinating miniature world with incredible details, an engaging atmosphere, and innovative gameplay. Help Artax overcome obstacles and
2Frn4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CikL7xQ0NZqokVUtzcc0G_Wz0deWVM9fagS89jvkvHQ&oe=6A3957DE"}, {"file_name": "Screenshot02.png", "id": "1008481184020716", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7ZnMP0QJQsQ7kNvwGCQJL6&_nc_oc=AdoYG_6j8aNPUp6jyZN_fSheAdIf3Wz-RKW4lKLZtCCXpzr3pn4kPm93ZJ8XTpMg74w&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hZcO1PXsAE6qbVXLl-LWbqEIKG9GwfpcMxwgJNVJ-Og&oe=6A3932C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fi343I8BSR4Q7kNvwFALbmM&_nc_oc=AdqXvKd9mkIk6dNmxvOg6XyxWr5z-_S3sfJurk3LOUxtHkzwDtodXE1MyOrkFaf2wBI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IdWvP_OnG-DtAu3AeXfVaxeKp-BBCMFq41vKX32Ps0w&oe=6A394D63"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribute to a captivating visual experience, while the innovative gameplay offers unique and engaging challenges. Get ready to embark on an unforgettable adventure in a magical world.", "short_description": "In Artax, you guide a toy soldier through a dreamlike world in search of Bulf, a character who has escaped from his box. Explore a fascinating miniature world with incredible details, an engaging atmosphere, and innovative gameplay. Help Artax overcome o
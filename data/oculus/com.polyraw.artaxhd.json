zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IsWHKV1XHwprMimSr-yF5MbhaHhuJdIlMebKmiSK3Fw&oe=6A2985DE"}, {"file_name": "Screenshot02.png", "id": "1008481184020716", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeZYSLnfrRMQ7kNvwEQ737q&_nc_oc=AdrcBpFtPvp_X7aGKrYE_aFEZa-oZeD0oy2TMmep_p6MHl1jcnl94zWbQuix0llOuYA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Oceq9JpodwByGM_zUfvc-XiKWltQ688EfFjWDFTNHww&oe=6A2960C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StQ38br9wWAQ7kNvwE6GULZ&_nc_oc=AdpZF7TxqN8WzrDezkU5WgNGij4-fE9aaHVkYL06c23ImVL59dFtaOVTPuCBNbAaVo0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5EvdGbHSpdYhcGcwgln0sNj2x2LSc6YHLzw3l9Yo66Q&oe=6A297B63"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribute to a captivating visual experience, while the innovative gameplay offers unique and engaging challenges. Get ready to embark on an unforgettable adventure in a magical world.", "short_description": "In Artax, you guide a toy soldier through a dreamlike world in search of Bulf, a character who has escaped from his box. Explore a fascinating miniature world with incredible details, an engaging atmosphere, and innovative gameplay. Help Artax overcome obstacles and
20f&oh=00_AQT3yzY1msweloBrtAmnh_FZQQLXs-qAkz5nNXf3UBqr4w&oe=6AFB1745"}, {"file_name": "Screenshot03.png", "id": "1026259675517039", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75371503_1026259678850372_7429131818924124256_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Prl2bQys4RwQ7kNvwEhPUpG&_nc_oc=Ado2G8QIEEogBJ7Fyzy1qI5htzSZFalYU3u3AKRJAoXbd7lNDGtF9TnhcagW4ckeTNU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHBewK4W6g35Wxbrs3QBTGKDzanY4Y6RxR8-L5Dk5iTg&oe=6AFB245E"}, {"file_name": "Screenshot02.png", "id": "1008481184020716", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTGmhQxGVoAQ7kNvwEXrOAo&_nc_oc=AdoHotE_iMQOBMAmFf_ul8iyzP0CwA5GpRO77HTz9RmA17NGrmwf72ob1KsNEDVnRHY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpre7RkBm6oSMgIbB1skkaq5aj5lBOdvQ2WChuarVhIQ&oe=6AFB3785"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQ3SMUCEEG8Q7kNvwFaAncw&_nc_oc=Adp1EN7_TjxxYVbqQi14ZWZId731vJUhvgWqt3TucBuvzMWZG8MQxDxVJhlSBD2BTKA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMGzleHXBElY-J8ILZGUcSRzQWJuS0udaIV0yT_asGxA&oe=6AFB19E3"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribu
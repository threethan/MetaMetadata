30f&oh=00_AQWtPMyw1szAupjkl3R1iEY_avRcd4g_AQN8Kx5yfS8dwg&oe=6B106785"}, {"file_name": "Screenshot03.png", "id": "1026259675517039", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75371503_1026259678850372_7429131818924124256_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T45nRDMI9roQ7kNvwEz2din&_nc_oc=Adr8AqkdiMh-EKEUzqGuT2LO6ckzQLhTDSHxjI6YKW1tJAGU3P377SxJVTd60Ft1PAE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV8qBXEwrUkG9lrWD94H_znRoRWjjzQahmU9sHYaNovYQ&oe=6B103C5E"}, {"file_name": "Screenshot02.png", "id": "1008481184020716", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HU7XzfU3H1wQ7kNvwER8C5m&_nc_oc=AdoUGfHPbACA8q8NC4WodBu06Y1lYQRHfyV40DXQc3Uvnypwl7cRqZw-HtVouIpMBDs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUBuommqdeyMSlpNAqSievA4dw21KvhAi5cnGjPB_l-cg&oe=6B104F85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8u6GpfTtaQsQ7kNvwGMDaw_&_nc_oc=AdoLkZqWmzEiBCBMFPqZim-4lIJMtESHE1gtCpwiUrrbs-R0uxko6v5mVk8gCAgOhHA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWcr7bSD7KF7rfSsJnF1eSjC7yq7cuaoPJXmapoLPuXrg&oe=6B106A23"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribu
zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDcurzxExJ8ehxqVvZsSNMxzM5LD2e-iiIZ6Scvast0A&oe=6ABFD0DE"}, {"file_name": "Screenshot02.png", "id": "1008481184020716", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2Hc-1SK6s0Q7kNvwHT9NKa&_nc_oc=Adp3ynCA9bg1GFwoAMkcR7aw4-jOqDwLv-u33yh5wYOu5kuVZ7iUFw9nsVvpKPu5fVI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFilC3uzLXCwzlyScwDlu-8yQf42NNZERxd5amBCrn3w&oe=6ABFABC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fE8b3gU19UQ7kNvwG_Dn9G&_nc_oc=Ado2TlXSgbZvZeyf9cTOPm9lo2wKRlSWyZ_xqQYStFyog5T8GoLh3p6b1gPvr0fTQ9k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNk8C60T8cTGSjO2x6omCW5y9y_fx2TKQHNDZi61kCj4w&oe=6ABFC663"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribute to a captivating visual experience, while the innovative gameplay offers unique and engaging challenges. Get ready to embark on an unforgettable adventure in a magical world.", "short_description": "In Artax, you guide a toy soldier through a dreamlike world in search of Bulf, a character who has escaped from his box. Explore a fascinating miniature world with incredible details, an engaging atmosphere, and innovative gameplay. Help Artax overcome obstacles and
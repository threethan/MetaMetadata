zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0B5yaCkivtX55-VJLjz8xgAPr778H_m3aSmpYRVvrEag&oe=69F61B5E"}, {"file_name": "Screenshot02.png", "id": "1008481184020716", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=beHnVVICsBwQ7kNvwG8jHuv&_nc_oc=AdpF712e7BtoOHz_lplVAyHKbGwKSD6Rb0mFVUGD--kFLeCmNsBR9i9hjtU5zmBPFMU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af19ziiaYVW-pDpiGtka0xNk9_YHlQJja0W4HXxJ7xCQPQ&oe=69F5F645"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkQnyB6vXc8Q7kNvwG7TVOF&_nc_oc=AdqVk5OjUhkkKWvj1nvex1y2jPcBcxdD94tN6OUtSCnd26RpFspOgRaJAvrTSLzdrn8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af05PQjdkPF2fgNdwSt5kRrcRNmku-XzTjNGURpdqmW46w&oe=69F610E3"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribute to a captivating visual experience, while the innovative gameplay offers unique and engaging challenges. Get ready to embark on an unforgettable adventure in a magical world.", "short_description": "In Artax, you guide a toy soldier through a dreamlike world in search of Bulf, a character who has escaped from his box. Explore a fascinating miniature world with incredible details, an engaging atmosphere, and innovative gameplay. Help Artax overcome obstacles and
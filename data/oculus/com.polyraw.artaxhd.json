zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZcFexzkRLnRfJNm8vLoTtef4ifTEXElK-qUKMnav6-g&oe=69C7BE9E"}, {"file_name": "Screenshot02.png", "id": "1008481184020716", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfalVN7IylEQ7kNvwF6Zj3i&_nc_oc=AdoYa3Nwz_gR1aHmKTPyU75ZKykMCk-1ywoUmk5XfWCCkTz7VIXgVC31bvVh8JkoEb8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyqtRRZaSM-va0QY2etJ5DXkuL-VHBwdsYwla2kpI5Qig&oe=69C7D1C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ol5G451S6CMQ7kNvwGbuSoh&_nc_oc=AdpPFKvGYl3HRB4PEngIT1u25laeX0_5iQKm3MrxE3PyNG62gfAOv0mHfZAMJ9f1D0U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyMPTEXQn7s5LGZ2PVtYSmOaj4e2-B5dV9oX0b3jtAV2w&oe=69C7B423"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribute to a captivating visual experience, while the innovative gameplay offers unique and engaging challenges. Get ready to embark on an unforgettable adventure in a magical world.", "short_description": "In Artax, you guide a toy soldier through a dreamlike world in search of Bulf, a character who has escaped from his box. Explore a fascinating miniature world with incredible details, an engaging atmosphere, and innovative gameplay. Help Artax overcome obstacles and
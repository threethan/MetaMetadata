zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GIKrZQScYfL-vLcEJ8u1vzgHKUxL27QP_IvDW9qqNEQ&oe=6A03121E"}, {"file_name": "Screenshot02.png", "id": "1008481184020716", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcUmAMYkxjgQ7kNvwFZshHT&_nc_oc=Adrez_5gHqPdxBJZjXY0z9Tgd2DEAGQmcNufKlf7f5SW_JLCADe2GaY-HkaKS2Wo57E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70_ntFH47fRLyuiW11Irmytq0ZbkSENUmgxQ2Uwh-9Qg&oe=6A032545"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEOHWKo_M10Q7kNvwFtWmXV&_nc_oc=Adri9LdtXolGx0Em8lElk_pW-NKRDH88NMik6uMLDuToEONcbxHaVkdFOG1J8XO6lIY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GH7zryoM5xEuRY6sFzcjVKJEhxPTJOEHDhVhs5xrBEg&oe=6A033FE3"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribute to a captivating visual experience, while the innovative gameplay offers unique and engaging challenges. Get ready to embark on an unforgettable adventure in a magical world.", "short_description": "In Artax, you guide a toy soldier through a dreamlike world in search of Bulf, a character who has escaped from his box. Explore a fascinating miniature world with incredible details, an engaging atmosphere, and innovative gameplay. Help Artax overcome obstacles and
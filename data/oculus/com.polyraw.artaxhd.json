zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0svfbJw0_oR-4OV4qF5VI4opH9K_vHW1wHIWCYHFUHw&oe=6AF33B5E"}, {"file_name": "Screenshot02.png", "id": "1008481184020716", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnGY8RiYhsIQ7kNvwGdVZVT&_nc_oc=AdrCoHsJMIGLXQJheWrDtCLLS-5UF7cX815ukkWPX1E_YkMUfmtRbvHnke7DRBqRqpA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROttA8pibHi7JUQQY60I7gdvlxYBw7gYNSpr2mGWHKRg&oe=6AF34E85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kdb0qmgTM54Q7kNvwEaQa48&_nc_oc=Adrsn3AFCSMbKKIDA9Etejri7IFocFghka8m4vO6hO9QxBBagMa1QCnuxJdROZh3meM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwx1FrBDOdZ9fmiM32QnLE0vUbWJAhSPjcQcdlTz1nvQ&oe=6AF330E3"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribute to a captivating visual experience, while the innovative gameplay offers unique and engaging challenges. Get ready to embark on an unforgettable adventure in a magical world.", "short_description": "In Artax, you guide a toy soldier through a dreamlike world in search of Bulf, a character who has escaped from his box. Explore a fascinating miniature world with incredible details, an engaging atmosphere, and innovative gameplay. Help Artax overcome obstacles and
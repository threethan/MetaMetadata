20f&oh=00_AQSVF71ZmnIfIKkeK6CK_S2eyS2fCi4Rmf-9lkcLQ-h6TQ&oe=6B005D45"}, {"file_name": "Screenshot03.png", "id": "1026259675517039", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75371503_1026259678850372_7429131818924124256_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCQnNFPOr14Q7kNvwFugZPc&_nc_oc=AdpkgJpE0KbPSUiqhZo_-EXClSSWjV14S-fReXOKtsxswh25X02sQP4531oQlPNuJ0M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsQ1Xzto66lxSPn23QBWN_1H1VFNLtt97wTOnCKAANJw&oe=6B006A5E"}, {"file_name": "Screenshot02.png", "id": "1008481184020716", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQJ5W8NFEQgQ7kNvwFfZfoW&_nc_oc=AdpZHSRQ9aPPvFXDXB22aZZxsrThzz1EMQknW7PZZO1OubVGSmxjRTXwNzTGnpp-XgI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJ3HTr82EmW0zevDiD4MEJ0JmImGmYUBtp16OZ66dOkw&oe=6B007D85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVjP_STrlPkQ7kNvwFtfKqW&_nc_oc=AdpBZwVMkuGoLGZuBeq8ZxQfm1j6rqCSCf8gx7E-nIL0t8McA6UJQqp_H4KbAV1Z9gY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTytWoM4SyB69rw0OK7fEbdGv-JG87zXeURJLhGv5jXHg&oe=6B005FE3"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribu
ord5-3.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AoyFSiaDAWkQ7kNvwG5XDeL&_nc_oc=Adlr13gSocFI2e4r_eQhrrijhx7JeodJkvuWZ9QkNdRxqmn1_DBJQjbyWCGNTXeM7Q4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftHY8YkOR8DikkbPxSBVmRzXzTfvu58ar-7LtKATc4pMw&oe=69A43945"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnS2YM8Stt8Q7kNvwGUiaOA&_nc_oc=Adk8FOh8fPiLWwvo1OaxGUn1DDY7e7jVceRheTu68JzhVH0MNB7DRehysaqhMxPje5Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afup-Y2lFUol6H4KnAXsuCpssfyiwtF9gaZTeYAM8772dQ&oe=69A41BA3"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribute to a captivating visual experience, while the innovative gameplay offers unique and engaging challenges. Get ready to embark on an unforgettable adventure in a magical world.", "short_description": "In Artax, you guide a toy soldier through a dreamlike world in search of Bulf, a character who has escaped from his box. Explore a fascinating miniature world with incredible details, an engaging atmosphere, and innovative gameplay. Help Artax overcome obstacles and enemies to return Bulf to his world and restore order to their magical universe."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polyrawdevelopment.com/PR_ArtaxPrivacyPolicy.html", "developer_terms_of_servic
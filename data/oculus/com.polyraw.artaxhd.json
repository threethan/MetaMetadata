zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOVLH2_-0nEZoP5ufsBq0zJ6M4ayxRwCBqjPYse9NDBg&oe=6AF72FDE"}, {"file_name": "Screenshot02.png", "id": "1008481184020716", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uz6lLmdWnBYQ7kNvwEpWQw4&_nc_oc=AdqNVbpBbdiqs_K2mnmE9B0N6WO8VXm5gkEk9qNkkKuCf79XgVlZrT1HIKmvbAX901Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvD0rm6AsYkXEfEPLPnZ_j8yI_cS2pqSE1KLYT1mjyTg&oe=6AF74305"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCTcbtd9yc8Q7kNvwHTWF4j&_nc_oc=AdoOg4c0YaWHIcT0tJTVkqktDoFWqxFiyoVSr4m7D2cvREthu2XCXeWJcA7n2EPxsjA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6kIOcwkNgXCW-FXMGNj83-YoHrZUx3otxO0f5lXnKNw&oe=6AF72563"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribute to a captivating visual experience, while the innovative gameplay offers unique and engaging challenges. Get ready to embark on an unforgettable adventure in a magical world.", "short_description": "In Artax, you guide a toy soldier through a dreamlike world in search of Bulf, a character who has escaped from his box. Explore a fascinating miniature world with incredible details, an engaging atmosphere, and innovative gameplay. Help Artax overcome obstacles and
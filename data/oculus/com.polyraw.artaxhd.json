20f&oh=00_AQRieove6jkoJ2W_FZg5eM_pJN_-EJRJhzc_H41XeHFEmQ&oe=6B033885"}, {"file_name": "Screenshot03.png", "id": "1026259675517039", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75371503_1026259678850372_7429131818924124256_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmtKAOhlF6MQ7kNvwFnKKfv&_nc_oc=AdrVX6EpqlGj1eDGWYbuuzNMQ-rmdflqbYrfQ82WpUvW_uYMSgMAB30bWdqO4YN2qMQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReSj0TspfXCXTXMe0ElMckTDFlSHSLJaGD2to2EYnn0A&oe=6B030D5E"}, {"file_name": "Screenshot02.png", "id": "1008481184020716", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQJ5W8NFEQgQ7kNvwGofWpC&_nc_oc=AdrkPxy6U35hI5NewJ1Y4WFSiTn6OL0mH1moae6cSUlx_nuv6hCuGZcOXToEXULdGqY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQu_Z8d4kClIG9SeCNvNT8ktWYya1sGVb5mFoIB3f0CBg&oe=6B032085"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmYQLsP0-WkQ7kNvwG4DaWN&_nc_oc=AdqoFPkGEteAcYTaRTVmEbeMVT1YgjB7o9F7_-bpnLEBSk1PYJU-M6vl5oq3FfxaAqA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgBw8BduK9ZfzyyMotbHVA6ZvF9bdwiV8-w6rOZ5HPrA&oe=6B0302E3"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribu
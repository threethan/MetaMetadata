20f&oh=00_AQToUETecnrxpQfKjjBIN111dzPEdwoxSwJDJ6OVnZIFwA&oe=6AFF0BC5"}, {"file_name": "Screenshot03.png", "id": "1026259675517039", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75371503_1026259678850372_7429131818924124256_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCQnNFPOr14Q7kNvwFCkZm0&_nc_oc=AdqBDiRP3CxGZBclU1TS-szOkhDz4H0HRPm_sAwNuO74lSwYyNFiRVzULZACTWx-bc4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvTxP897KVSMve-Kfq2fJ3bbx5QIayhktf_X5aTutESQ&oe=6AFF18DE"}, {"file_name": "Screenshot02.png", "id": "1008481184020716", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RatpMONYQrAQ7kNvwHYgNv4&_nc_oc=Adoxm8FZOe2vRRe3SwIEdKY-FUHsHnWcqhFk5sxXF6d-rDOGtH3zbld_hv22yA1TPEc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIyQx2Iiq61D9kN1s_UvcP0M7ALuhFR2ep-6e9dEY5DQ&oe=6AFF2C05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVjP_STrlPkQ7kNvwGY6OPh&_nc_oc=AdoHmGI7W5DAqaIoJ4Kkq4KFgkFHWSZXnzm3r32muu14YnQ6bG5E7vhIGGf-2IRmF9A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9vv2lhKrBgBlo0Y2YshU9nO2jdJWfX4N7Xs_m2AgMyQ&oe=6AFF0E63"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribu
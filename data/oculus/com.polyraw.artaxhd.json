zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mNkfc-QUnJyRCTXuuPL6haZ_LUOqQDk-k6GL737u3CQ&oe=6A219CDE"}, {"file_name": "Screenshot02.png", "id": "1008481184020716", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHedkKAyrQMQ7kNvwEf7zkz&_nc_oc=AdpY00JAm0Q9ZFrv6ByWMF28sIlnk-b_xa2laXZKLejHJs8xlqUoefx1eb1pp9YHNHs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wtKOUwvz7PeCPuwSnQVvzVLRSTeertKjJjL4_6zztTg&oe=6A2177C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poar1L56xeAQ7kNvwFOdlfY&_nc_oc=AdpgusYZwbetxpE6in7AFMdAh1QPNCYvuxkqSUzg4UctZGYqZRa2HLOtbprvDIW1nyc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fgvGvzsJWKL-6k_Hf0eKpqRsTKbW3j64rVTJLSE2Wtw&oe=6A219263"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribute to a captivating visual experience, while the innovative gameplay offers unique and engaging challenges. Get ready to embark on an unforgettable adventure in a magical world.", "short_description": "In Artax, you guide a toy soldier through a dreamlike world in search of Bulf, a character who has escaped from his box. Explore a fascinating miniature world with incredible details, an engaging atmosphere, and innovative gameplay. Help Artax overcome obstacles and
20f&oh=00_AQRnBYyreh5AQQ699S7On3XNDFN-lTbSZosK-LeOcepipw&oe=6B048A05"}, {"file_name": "Screenshot03.png", "id": "1026259675517039", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75371503_1026259678850372_7429131818924124256_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmtKAOhlF6MQ7kNvwE0-OUH&_nc_oc=AdqyYlvZk3AvZSt8xKxLQuxkn6nZwegZRtCvV_J6FPC1rHhIHiLXAOIklOSGjw02pJ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwCwci_WuIjNv6vOZP3a49oBnvZqjFWAByfGOqnGrT7g&oe=6B045EDE"}, {"file_name": "Screenshot02.png", "id": "1008481184020716", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQEeBEXZJfcQ7kNvwH4WZwr&_nc_oc=AdojvXcsN8w5F7VTtRRC0AsYTbkUGwPVvS7Il_y9Esoy8vzbr7hBQQxR0MIGCL_jITo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS64JpLJ_KXdqJj6aj12ik66S8seUiAp8nmvypXQLcFmw&oe=6B047205"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmYQLsP0-WkQ7kNvwFUPNzq&_nc_oc=AdrJTCNcf2P_8IbncS4U_xRyeFqc5ZhaGVHrq8Wmakjpn3xgitcEZXYgwj5FyTEP_Ss&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFge4LlSqVSgG9dl8R78YYkF9KmnTSI2XgMkKA-mRdFw&oe=6B045463"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribu
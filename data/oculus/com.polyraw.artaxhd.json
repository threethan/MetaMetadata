zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy7QkUdLh7H5tegmgaEk3l47ItmlYpdscCjQ17P5ED4Nw&oe=69C3CA1E"}, {"file_name": "Screenshot02.png", "id": "1008481184020716", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0OWuLnSAcgQ7kNvwHNcJC8&_nc_oc=Adpu4cUPtxTlKByndPCKZE7wWPDmUbzOx_NYy-niMB1_wB0tFQ1uSTIOGmq4XL4d1Gs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz9ixB07BLxZLjjhu4_6FtxOQFktFheswDk7XAIFX1PaA&oe=69C3DD45"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7uSeP6a0uMQ7kNvwHKMFDH&_nc_oc=AdrsiH-Ho0iAO2-eyxsOxA4VqOvsSG7xCH34e1ZrIqzLV786yNMyJRfxRpYKveTI0_Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyjXsTVK4f4A_CfK90SSSBsH3RYwnJAC7Bb-lGGqWblpA&oe=69C3BFA3"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribute to a captivating visual experience, while the innovative gameplay offers unique and engaging challenges. Get ready to embark on an unforgettable adventure in a magical world.", "short_description": "In Artax, you guide a toy soldier through a dreamlike world in search of Bulf, a character who has escaped from his box. Explore a fascinating miniature world with incredible details, an engaging atmosphere, and innovative gameplay. Help Artax overcome obstacles and
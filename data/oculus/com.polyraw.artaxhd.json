30f&oh=00_AQTdDgRA3hZ3x8mElMNiv0WnDcb-NkrhRdm--sjUt1h-qw&oe=6B0C7305"}, {"file_name": "Screenshot03.png", "id": "1026259675517039", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75371503_1026259678850372_7429131818924124256_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFQQu83YTgMQ7kNvwGbROdd&_nc_oc=AdqU1CaKuHVdNDlC0soIKX1omBePl1qTlTPVc2ya5sTNYGRuKG9_B-XFTP_8zD7QLQs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTN6GO6Y2yb9AKRj8FQ8t8QlJDQXbJxYpm9EoiXImbTKg&oe=6B0C801E"}, {"file_name": "Screenshot02.png", "id": "1008481184020716", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Woe1dJLK6wkQ7kNvwEMsqcG&_nc_oc=AdqY7M2wRTZAJkra6tpcjLeMFRIcH660EMkOhAH9DUM824YaJNeWqb6XYHDW_-NhOzU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ5qgCekbx17Fbt9cf5e3pKaZ64NsoFaMHxlYZAhWlspQ&oe=6B0C5B05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A57mMCQqhm8Q7kNvwEPhZVt&_nc_oc=AdpTF46-wCR1TZsyelYjxzDTnGZCvAIJvmpdpmzy6enc3m77I5LwM2o7nCY7ggoPjxw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSjyeFrumGTqxD6h_9Cv3BryUcm11z7mCtgJ6XJzWm4qA&oe=6B0C75A3"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribu
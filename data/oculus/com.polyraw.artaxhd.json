30f&oh=00_AQSeU6ZIeF6V4l709IEXnNIho4JPAmt3ffc0TM5hBu-dFg&oe=6B0DC485"}, {"file_name": "Screenshot03.png", "id": "1026259675517039", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75371503_1026259678850372_7429131818924124256_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T45nRDMI9roQ7kNvwErNXO0&_nc_oc=AdrOvdi8JHYpP7fglFcHiHBw43UEJhUga-gM_0fmVMSzzABdy5AJQIEt7VDaj41DbIY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQHX3PVxmNDj58la_xkOUWl7Jhkdkxrk_a3DSmPrJMooQ&oe=6B0D995E"}, {"file_name": "Screenshot02.png", "id": "1008481184020716", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Woe1dJLK6wkQ7kNvwE_pKVU&_nc_oc=Adq8zC_kZiDoZb1TaAcfiBy2iZTYVnwn5EoY8WgifZGvjsYevZ1E2mHcJwZbBMpJyvo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSDTtiTpopo1z6bNu7V0QkhG0l-6cUVYRn3Wfe0FUP0xw&oe=6B0DAC85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8u6GpfTtaQsQ7kNvwFLT8Jv&_nc_oc=AdoIsAIFIZ821lVfQbPKQ4XiToztA-rlcwdqqCfQ1DBpNsHW9NBkVDPGbdin4as2LIQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQStq8VCiR0aINytsFgpNWA0Tk4x1Z36O8HHYQhK8bAuug&oe=6B0DC723"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribu
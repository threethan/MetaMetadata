20f&oh=00_AQS7F0Pex0sdd3qHZEfpvh-ZjGNWhFuCua5cuhgv5ad_iQ&oe=6AFDBA45"}, {"file_name": "Screenshot03.png", "id": "1026259675517039", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75371503_1026259678850372_7429131818924124256_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCQnNFPOr14Q7kNvwG9hgCJ&_nc_oc=AdrHuVFkjuc0hWxXJvAoU5PP02iEv9Zs-Qlkks82BdZAeyhJvd9pPF1ZGxHhXOhD_NM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRz4ZEfbEUgPnnupSK6yxJ7-WiBZLlGOGmL4_x4eGAt0w&oe=6AFDC75E"}, {"file_name": "Screenshot02.png", "id": "1008481184020716", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RatpMONYQrAQ7kNvwG6ZhrH&_nc_oc=AdrsmEbOuvf2EnI1GC81d-eBPpx1bI5IgUKKYIX-M8LU7fKmHSFCKxBnplZWoIm9cDc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNuxLwkygIrzNFEiw1VdKQR6lrdykgQ_jW1KEmdCISfw&oe=6AFDDA85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVjP_STrlPkQ7kNvwG2I6TJ&_nc_oc=Adox2pcvNKWcgcgTpOHQHGoBSY-_7JI-AtYI3S619eKkUyUpsDfxZdRiyuNlfDy-308&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOZkfj4hrjMlVgF38Z_mpiXv7OGbYjDqFR7--_15W0yQ&oe=6AFDBCE3"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribu
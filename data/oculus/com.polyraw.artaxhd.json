zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-4-sNZPyf8ov6mFbxgC6tdiEBqzQ9KBHsJ2UYLG_crg&oe=6ACBAE5E"}, {"file_name": "Screenshot02.png", "id": "1008481184020716", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vN2i7a8DxToQ7kNvwGDFQkj&_nc_oc=AdoPtXb6KotRLVCfe3aKvrk3KFrFHuyOQpLzpjp1CriOBnBoghCR4y6C5Y7bKwrG7hc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXmjFfrfdzXIsBRrtbDdE5_lCTYc09FGMso3-lIeZ7ww&oe=6ACBC185"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=raAAIdpgDrQQ7kNvwEaXDz6&_nc_oc=AdoMtbFILJFKv9uORD9fMVCHD14ZxZeD4qGjBhRXPicjroFB_sGjU9KLLunnh4TDEcQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO47rIxFk8q1pRAZ9f8YPxFCkZcgKjMBA5TXK6iRDLVCg&oe=6ACBA3E3"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribute to a captivating visual experience, while the innovative gameplay offers unique and engaging challenges. Get ready to embark on an unforgettable adventure in a magical world.", "short_description": "In Artax, you guide a toy soldier through a dreamlike world in search of Bulf, a character who has escaped from his box. Explore a fascinating miniature world with incredible details, an engaging atmosphere, and innovative gameplay. Help Artax overcome obstacles and
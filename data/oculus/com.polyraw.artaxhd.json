20f&oh=00_AQSJuET1teamXPrpM1mRiloqIaTv9PyEi1rra2ul-VjQYQ&oe=6B01E705"}, {"file_name": "Screenshot03.png", "id": "1026259675517039", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75371503_1026259678850372_7429131818924124256_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmtKAOhlF6MQ7kNvwHUwlq6&_nc_oc=AdoJA-aD-9HWhBYTI2o_O0QItq4vy0M8XIH_7uHr11CGjGZ53aD2RUJeyv3Ob6KwLbQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp4LwneVtAhPDuyRPMXHNVDyEmeOVq-jtc_3pHlaJT2A&oe=6B01BBDE"}, {"file_name": "Screenshot02.png", "id": "1008481184020716", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQJ5W8NFEQgQ7kNvwE_wdJT&_nc_oc=AdospUHcpuyF--J1g8HRJcv7L2jKC82VsJAJlDgBKXRpMV3gylKRDibsStk5KJtXoGA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmQIU2IMZVtKcc9S1aQJd6VzGR3ZsSlaBacK_PdRBxhQ&oe=6B01CF05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmYQLsP0-WkQ7kNvwFrMmHo&_nc_oc=AdqPMijFcC797z8bmE_mCgePT0ntA94DvCIxcH4HKQQyumwvkTbPeIDgaSuFRBDp_U0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmpzcahyHTqwYELq53p7bo08p6aetfHKX_LP7d7YDlmQ&oe=6B01E9A3"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribu
zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzFeD6cd8ByRi4gDHELMm-Z3DxocbvjkByBjaxsDaZ7Dw&oe=69CE561E"}, {"file_name": "Screenshot02.png", "id": "1008481184020716", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkEP3ilahhMQ7kNvwEOl12i&_nc_oc=AdptEm-2sNJoV6_cRaIKSPWQvROdKKIy4oldztQrzVwRb-iv9C4CWHHh6hzg0McEUYc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzsWsDoEaVlM1dpUySwb5ZvJ4pU1o2_UgP10PKFB-Kl3g&oe=69CE6945"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQRbQm_wLcAQ7kNvwGh2iQF&_nc_oc=AdqkenHxA1p8c1EdC_Ri3FQCSYfFwdpL_Ku_0Ehrm4aLJVM6jQ8yzZprMOwpuoMeD2I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyal17R3_MnIlgx3noRre4c4RULzqWLHO3LgNkDks6_uA&oe=69CE4BA3"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribute to a captivating visual experience, while the innovative gameplay offers unique and engaging challenges. Get ready to embark on an unforgettable adventure in a magical world.", "short_description": "In Artax, you guide a toy soldier through a dreamlike world in search of Bulf, a character who has escaped from his box. Explore a fascinating miniature world with incredible details, an engaging atmosphere, and innovative gameplay. Help Artax overcome obstacles and
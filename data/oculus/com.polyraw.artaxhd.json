zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3Ygrew23AvijZzQjF_iZNysikrHjCUAcKQ5V13RE1TQ&oe=6AF0985E"}, {"file_name": "Screenshot02.png", "id": "1008481184020716", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnGY8RiYhsIQ7kNvwFYQaW5&_nc_oc=AdqPj6_K36Yh8dyF486MIxXEQow-eEFX2yv4jCJTENAjefkVyeftIEWsDG0Kg3C1wtk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwBFjF8gtLClQrSFfU1nVJZZ4UHk3oMQ58eJE7RIHnzw&oe=6AF0AB85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-w3fojx1rEgQ7kNvwEbyC9b&_nc_oc=AdrMT2BVtkDY-Zbb1bUm37Wzy_UMVF-vundC59mhGCECurvQZYL5pj43ifaZizoInwk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiqFTx8WXvi2Y4JTBP2BRYFWQmdr-m_UTY6ExViVr-5Q&oe=6AF08DE3"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribute to a captivating visual experience, while the innovative gameplay offers unique and engaging challenges. Get ready to embark on an unforgettable adventure in a magical world.", "short_description": "In Artax, you guide a toy soldier through a dreamlike world in search of Bulf, a character who has escaped from his box. Explore a fascinating miniature world with incredible details, an engaging atmosphere, and innovative gameplay. Help Artax overcome obstacles and
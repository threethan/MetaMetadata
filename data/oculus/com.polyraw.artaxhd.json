zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXynO19IUP4Sujwj0sStK_WlABG03B3if868sRhersUA&oe=6A58C39E"}, {"file_name": "Screenshot02.png", "id": "1008481184020716", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IzpgLUoJhMQ7kNvwE8u3YD&_nc_oc=Adpg3r9dk09-i918ejz4YGmp-rU6aNPQksEosodS2MIHjM-rs5JVF8Z7ilps0mEbJy8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCY4Lstt4ERLlCBGFC7HiA8Wt1cUklo8aPVddrSMxtfew&oe=6A58D6C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4dJp2I5pekQ7kNvwFPTqDZ&_nc_oc=Adr6W00PRn7Y05hl7ni51wkyPZYt9M7J-sAaPHQEI5fTqgcbWBsuvoKDFGMebQ54C5o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQlta0aEc86WWSNEzGWuDe0Mxt6X59Yb9pCVGOq4C3bA&oe=6A58F163"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribute to a captivating visual experience, while the innovative gameplay offers unique and engaging challenges. Get ready to embark on an unforgettable adventure in a magical world.", "short_description": "In Artax, you guide a toy soldier through a dreamlike world in search of Bulf, a character who has escaped from his box. Explore a fascinating miniature world with incredible details, an engaging atmosphere, and innovative gameplay. Help Artax overcome obstacles and
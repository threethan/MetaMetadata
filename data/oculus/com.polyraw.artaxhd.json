zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzcWbPdTVTSY2e1txUBKhJ6OUug9UHa-KTY-inItW2aw&oe=6A92C59E"}, {"file_name": "Screenshot02.png", "id": "1008481184020716", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81-3-YvvAs4Q7kNvwFBqUTi&_nc_oc=AdoKdaSlrAuRDks2ji0ewpI0xA8AsBUd7pcaWER7IbTkPdQAEs1slIaOgaoeYFyc0Sk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgFGiSj97SHtLmi9LwFUnja2FE4ueGTuvhyQ7jyVow6g&oe=6A92D8C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKSGqcmSK9oQ7kNvwED0YKD&_nc_oc=Adpo1kCIQ30cL5Xj8kSPJ4l-MfU-I4DYJobXx64oA5R2erVDy6LQXg3y2qqxNWRbycE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFll91BU7CT6TfmkDqPP1W1Dt8RadZIZzgZeAW0ADc0tw&oe=6A92BB23"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribute to a captivating visual experience, while the innovative gameplay offers unique and engaging challenges. Get ready to embark on an unforgettable adventure in a magical world.", "short_description": "In Artax, you guide a toy soldier through a dreamlike world in search of Bulf, a character who has escaped from his box. Explore a fascinating miniature world with incredible details, an engaging atmosphere, and innovative gameplay. Help Artax overcome obstacles and
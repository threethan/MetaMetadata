hkg4-1.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WwRbowI_zAQ7kNvwEDThaT&_nc_oc=AdlnPplG2SfQ-Lgg6-GvJk05gVcDXYkOYOiwoLoojYU333hk57kbY2qq2Vnl_tpl6vU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afu9M4T57MO7sArZt9qRt671BiHCxx8xw4rULA_abDwB8g&oe=69A19645"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gE_wuEiCTjQQ7kNvwG5c6M3&_nc_oc=AdkPSGcbi2lZIpqCICgl8UJiTNtl0HGRQ-zxabf7-ST5eP5FmErf0PNR3PcLo8Wba_o&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftSj_hCoUztNynJO54XqJKilSJnIn8AeF3yLoWdxmzOpw&oe=69A178A3"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribute to a captivating visual experience, while the innovative gameplay offers unique and engaging challenges. Get ready to embark on an unforgettable adventure in a magical world.", "short_description": "In Artax, you guide a toy soldier through a dreamlike world in search of Bulf, a character who has escaped from his box. Explore a fascinating miniature world with incredible details, an engaging atmosphere, and innovative gameplay. Help Artax overcome obstacles and enemies to return Bulf to his world and restore order to their magical universe."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polyrawdevelopment.com/PR_ArtaxPrivacyPolicy.html", "developer_terms_of_servic
VjzAE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfLowPhPvtjyjLwco8ERWjsuksE9WNV28kRhKRAdZFyQ&oe=6AA9675E"}, {"file_name": "Screenshot02.png", "id": "1008481184020716", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EhEyOGGjwd8Q7kNvwGh_-7V&_nc_oc=Adryi3xPuHRgCN-nmE-c6CUON0gvYadUp_oRkx0gH8-5NVlnRou9NxXuB7jQ5cOwufw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbZMgWaiBCY6WTHeyWaigfyZ81GEVrkt3WHtb1GgXpzg&oe=6AA94245"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MRL5kXWmTYQ7kNvwEsNZ9i&_nc_oc=AdqIwgznwjDO_8GqwR1f-QgLQry7wlIts-nofcpSjVL6Ei7gdho6R7SNPNRr-Ocq8bU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLE7R2GfRA9BT1mzTK_F9iJpEm0VhHXpF6dOBIEicb6jQ&oe=6AA95CE3"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribute to a captivating visual experience, while the innovative gameplay offers unique and engaging challenges. Get ready to embark on an unforgettable adventure in a magical world.", "short_description": "In Artax, you guide a toy soldier through a dreamlike world in search of Bulf, a character who has escaped from his box. Explore a fascinating miniature world with incredible details, an engaging atmosphere, and innovative gameplay. Help Artax overcome o
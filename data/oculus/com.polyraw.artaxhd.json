-t1LA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RdGEh5w8q4vI2a1Ld2xTLZz_u7Y0JGMlZ718ALtjHOw&oe=6A22EE5E"}, {"file_name": "Screenshot02.png", "id": "1008481184020716", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982577_1008481187354049_23600633797903052_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oZz-gqITIIQ7kNvwH92dMM&_nc_oc=AdpRGl_fSSdCv3n61L-iVaYiZ6PU1nbzKiPLtftGR8lHdiEU2vdgd-hQ1eliAUrGYY4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_o0-cmd5QBV1mv4nU2KIoQsSXnGlDzCtz6451ICVSu0g&oe=6A22C945"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_per_video.png", "id": "840494258075006", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031409_840494261408339_2720833867148154916_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poar1L56xeAQ7kNvwGF8Lzi&_nc_oc=AdoEUYCNbjTSgeSHPmKOIUBbI5gLhAHGs6x-p0mONibyB2igS_lCANCw2anWypJeYhc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90kNSbNiLTeNclkYmSl3Lhj4QwTOvBDOnuYsTNWRejNg&oe=6A22E3E3"}, "display_name": "Artax", "keywords": ["artax", "knight", "diorama", "castle", "toy"], "long_description": "Artax immerses you in an extraordinary adventure. You play as a toy knight who must face obstacles and enemies in a fantastical world in search of Bulf, a larger and villainous soldier who has escaped from his box. Guide Artax through a miniature world characterized by finely crafted details for an immersive and thrilling experience. The high-quality graphics contribute to a captivating visual experience, while the innovative gameplay offers unique and engaging challenges. Get ready to embark on an unforgettable adventure in a magical world.", "short_description": "In Artax, you guide a toy soldier through a dreamlike world in search of Bulf, a character who has escaped from his box. Explore a fascinating miniature world with incredible details, an engaging atmosphere, and innovative gameplay. Help Artax overcome o
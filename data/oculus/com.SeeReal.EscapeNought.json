{"data": {"node": {"__typename": "Application", "id": "26484055437846795", "organization": {"id": "788539911000585", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "26484055437846795"}]}, "id": "948145104405811"}]}}, "firstRevision": {"nodes": [{"application": {"id": "26484055437846795", "release_date": 1774055220, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 2}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26892942680291400"}, "id": "756874080632234"}]}}, "binary": null, "live_binary": null, "created_date": 1774056721, "id": "26583153704603634", "is_initial_release": false, "name_with_fallback": "v2", "pdp_metadata_with_fallback": {"version": 2, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "26583164734602531"}, "release_status": "RELEASED", "id": "26484055437846795"}, "id": "26583164734602531", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "26484055437846795", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2759277447781680"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2702846926764690", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Escape:The Nought", "keywords": ["EscapeRoom", "Puzzle", "\ubc29\ud0c8\ucd9c", "\ud37c\uc990"], "long_description": "\uc5ec\ub7ec \ud14c\ub9c8\uc758 \ubbf8\uc2a4\ud130\ub9ac \uacf5\uac04\n\ud558\ub098\uc758 \uac70\ub300\ud55c \uc5ec\uc815 \uc18d\uc5d0 \uac01\uae30 \ub2e4\ub978 \ub9e4\ub825\uc744 \uc9c0\ub2cc \ubc29\ub4e4\uc774 \ub2f9\uc2e0\uc744 \uae30\ub2e4\ub9bd\ub2c8\ub2e4. \ub0a1\uc740 \uac00\uad6c\ub4e4\uc774 \ub193\uc778 \uace0\uc804\uc801\uc778 \ubc29\ubd80\ud130, \uc815\uccb4\ub97c \uc54c \uc218 \uc5c6\ub294 \uc2dd\ubb3c\uacfc \ubc14\uc774\ub7ec\uc2a4\ub97c \uc5f0\uad6c\ud558\ub358 \uc2e4\ud5d8\uc2e4\uae4c\uc9c0.\n{1289292933099638}\n\n\u25b6 \ud638\uae30\uc2ec\uc744 \uc790\uadf9\ud558\ub294 \ub2e4\ucc44\ub85c\uc6b4 \ud37c\uc990 \uae30\ubbf9\n\ub2e8\uc21c\ud55c \uc790\ubb3c\uc1e0 \ud480\uae30\uac00 \uc544\ub2cc, \uc9c1\uc811 \ub9cc\uc9c0\uace0 \uc870\uc791\ud558\uba70 \ucd94\ub9ac\ud558\ub294 \uc785\uccb4\uc801\uc778 \ud37c\uc990\ub4e4\uc744 \uacbd\ud5d8\ud558\uc138\uc694.\n\n{937467775640833}\n    \ubbf8\uc9c0\uc758 \ubc14\uc774\ub7ec\uc2a4 \uc5f0\uad6c\uc2e4: \ucef4\ud4e8\ud130\uc758 \uc554\ud638\ub97c \ud480\uace0 \uc218\uc0c1\ud55c \ubc30\uc591 \uc7a5\uce58\ub4e4\uc744 \uc870\uc791\ud558\uc5ec \uc2e4\ud5d8\uc2e4\uc5d0 \uac10\ucdb0\uc9c4 \ube44\ubc00\uc744 \ud30c\ud5e4\uccd0\uc57c \ud569\ub2c8\ub2e4.\n\n    \ube5b\uc774 \ub4dc\ub7ec\ub0b4\ub294 \uc228\uaca8\uc9c4 \uc9c4\uc2e4: \uc721\uc548\uc73c\ub85c\ub294 \ubcfc \uc218 \uc5c6\ub358 \uc228\uaca8\uc9c4 \uba54\uc2dc\uc9c0\ub97c \ucc3e\uc544\ub0b4\uc138\uc694.\n\n    \uc758\ubbf8\ub97c \uac10\ucd98 \ubc29 \uc548\uc758 \uc18c\ud488\ub4e4: \uae30\uc0ac \uc11d\uc0c1\uc758 \uac80\uc744 \uc54c\ub9de\uc740 \uc704\uce58\uc5d0 \uaf42\uc544 \ub123\uace0, \ub2e4\ud2b8\ud310\uacfc \ub9c8\ud2b8\ub8cc\uc2dc\uce74 \uc778\ud615 \ub4f1 \ud3c9\ubc94\ud574 \ubcf4\uc774\ub294 \uc18c\ud488\ub4e4 \uc0ac\uc774\uc758 \uaddc\uce59\uc744 \ucc3e\uc544 \ub2eb\ud78c \ubb38\uc744 \uc5ec\uc2ed\uc2dc\uc624.\n{881603824881087}\n\n\ub2f9\uc2e0\uc758 \ubaa8\ub4e0 \uac10\uac01\uacfc \ucd94\ub9ac\ub825\uc744 \ub3d9\uc6d0\ud558\uc5ec \ud37c\uc990\uc744 \ud480\uace0 \ub2eb\ud78c \ubb38\uc744 \uc5ec\uc2ed\uc2dc\uc624.\n\uacfc\uc5f0 \uc774 \ubbf8\uc2a4\ud130\ub9ac\ud55c \uacf5\uac04\uc758 \ub05d\uc5d0\uc11c \ubb34\uc0ac\ud788 \ud0c8\ucd9c\ud560 \uc218 \uc788\uc744\uae4c\uc694?", "short_description": "\uac70\ub300\ud55c \uc911\uc559 \ud5c8\ube0c\ub97c \ud1b5\ud574 \uc5f0\uacb0\ub41c \uac01\uae30 \ub2e4\ub978 \ud14c\ub9c8\uc758 \ubc29\uc5d0 \uac07\ud78c \ub2f9\uc2e0\uc740, \uc0c1\ud638\uc791\uc6a9\uacfc \ucd94\ub9ac\ub825\uc744 \ubc1c\ud718\ud574 \uc228\uaca8\uc9c4 \uc9c4\uc2e4\uc744 \ubc1d\ud600\ub0b4\uc57c \ud569\ub2c8\ub2e4. \ub2e4\uc591\ud55c \ud37c\uc990\ub4e4\uc774 \ub2f9\uc2e0\uc744 \uae30\ub2e4\ub9bd\ub2c8\ub2e4. \ub2e8\uc11c\ub97c \uc870\ud569\ud558\uc5ec \uc774 \uae30\ubb18\ud55c \uacf5\uac04\uc5d0\uc11c \ud0c8\ucd9c\ud558\uc138\uc694!"}, {"images": {"nodes": [{"file_name": "3000.png", "id": "1714821133024504", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619672_1714821136357837_5903904203876133136_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXdMc47GPe8Q7kNvwEQ8dIk&_nc_oc=Adofg5rlpuzH13V-v8LYh_tX3cR1ayMYdrTiv8GoeccWTFEhwCO0SxxadxaGc6eLw6U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af16YZW1CISq7ueIZX9aD1h9UsxHASIBoljL2J3p_KiEIQ&oe=69F21B12"}, {"file_name": "1008.png", "id": "1504660354408509", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619672_1504660357741842_8867953929630766149_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_w5_2MPVN-sQ7kNvwEyrcSZ&_nc_oc=AdrjPustrxy7RcJMhp7HEbaMx-4PI-RIZy7t49E_jbHIroOwnhlnijvb23f0auPJSpk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2NEN7dIlK3DlXohO2VHtghbhRSRX7ujbf36bcw3me6Lw&oe=69F1F887"}, {"file_name": "GameLogo_default.png", "id": "1240441161615823", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617831_1240441164949156_5988612890399129273_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4RHwj8F-qUQ7kNvwGY5l9W&_nc_oc=AdoZxmNPjW9WL4V2-3G2AHk5P7_H1VHiMJRlvNXni1H_R5tUDMIAanp-ON-Hxuhf1UI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ttx5wLHrTe4zON_JxYyj4ZyK
://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821150_1390855776085438_518964886247908172_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jm-Riro0H04Q7kNvwFj7cxh&_nc_oc=AdqcFURVgULqQ0-s3JB5a118OWckCvy2V3tCZ-Q4fgfXzlg-55g7qU1zHZyxqr2pQk8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2clqdYUGucFTJNsJYxutShYrlPLZtxhSpQBBCKm4yZ7A&oe=69F1E766"}, {"file_name": "Capture_20260315_155317.png", "id": "1245249911030697", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618515_1245249917697363_6858689425687578518_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMcTnoIYLs8Q7kNvwHh7ymT&_nc_oc=Adp52VspEtOJsFsS-TH9p_AWt5EQtoVsalptBJazrCGCessLJ-vMBUAKhaAoY24awFI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2RJbuPdJETnTcyTCziTv85LfXvz8BrQ2KgH17mK7H0Kg&oe=69F1FDCD"}, {"file_name": "Capture_20260315_155550.png", "id": "2084145212382932", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619096_2084145215716265_2997334577020385787_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7sSxH2B5NQQ7kNvwEnDlf9&_nc_oc=Adq8nEvFuTGXNGKhU7hlfyoD-xikfKXIYn0DHK_5evhz7743piZlNfueeV7rmsgkeiQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2PXZg1i3kXkT4seHKMkgtD9A4TfGA_6epPp4Zxu1qr4Q&oe=69F20E85"}, {"file_name": "Capture_20260315_182338.png", "id": "1426078055863789", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499296119_1426078059197122_3984945434794372216_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjsr7m_Pg9UQ7kNvwGQfc2C&_nc_oc=AdqSk1q32JYxzFXCk21ztZVPeOAimb4Jk7c3tQKxWbGwlDmtM5jVk0tG1aAfUKyfNuU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1iNhxvaVZRZfRgbNZtqAhRNm7Vi2Ujz821GWTPkSYa7w&oe=69F205FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Escape:The Nought", "keywords": ["EscapeRoom", "Puzzle"], "long_description": "\u25b6 Multiple Themed Mystery Spaces\nA single, grand journey awaits you with rooms of distinct charm. Explore everything from a classic room filled with antique furniture to a laboratory researching mysterious plants and viruses.\n{1295233762508130}\n\n\u25b6 Intriguing and Diverse Puzzle Gimmicks\nExperience multi-dimensional puzzles that go beyond simple locks, requiring you to physically touch, manipulate, and deduce.\n{1234634868879854}\n\n    Unknown Virus Lab: Crack computer passwords and manipulate suspicious incubators to uncover the secrets hidden within the laboratory.\n\n    Hidden Truths Revealed by Light: Discover hidden messages that are invisible to the naked eye.\n\n    Props Hiding Secret Meanings: Place the knight statue's sword in its rightful position, and find the hidden rules among seemingly ordinary objects like a dartboard and Matryoshka dolls to open locked doors.\n{1234834418631090}\n\nUse all your senses and deductive skills to solve the puzzles and open the closed doors.\nWill you be able to safely escape at the end of this mysterious space?", "short_description": "Trapped in diverse themed rooms connected through a massive central hub, you must use your interactive skills and deductive reasoning to uncover hidden truths. A variety of puzzles await you. Piece together the clues and escape this bizarre space!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://seereal-escape.notion.site/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SeeReal", "support_website_url": null, "website_url": "https://seereal-escape.notion.site/escape-the-nought", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": [
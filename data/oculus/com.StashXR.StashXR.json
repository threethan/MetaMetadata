0406704899_1341905288226819_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AeJ1aDBr64kQ7kNvwHlFMpv&_nc_oc=AdoolesrsCe2-PSgoUsTDeWz8yQqQITJhmXz1h8eIFcvaq2WZgWs_q5V8HzkyRTJfFs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzMP-gUqa3J23F16EAoyy85ZzbpE-d_Fni-yF6Vitkrw&oe=6ACA4D43"}, {"file_name": "Image Sequence_008_0000.png", "id": "1271997874486273", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302483_1271997877819606_1969445876879584338_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBbCEsHJs-AQ7kNvwFrkrTC&_nc_oc=AdrnfgQbOEsJjUdusGqQMp1N1o_Wdg_BihHT_xe7m0tAz58f90rcpbCbrwN17FiPgcE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNH8i9GIXdNF-Dz3XOu3RRWp_aTnqnfPq4GH_4juC3dhA&oe=6ACA59E3"}, {"file_name": "Image Sequence_010_0000.png", "id": "2344957619364689", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304019_2344957626031355_3695640148420276034_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gmSI3G93CsQ7kNvwG1-_mq&_nc_oc=Adq6eHvK3jRoPXGictbw1KxaErCm3TffePNOg7b_J8wt94ODB07zIM68Qsi9rc0jWUA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiKpmbgVdiFnyQrhKF3Fw33YtV9O0pNG9bLzFAB5soiw&oe=6ACA5FE8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "StashXR", "keywords": [], "long_description": "Browse, search, and stream your Stash library right from your headset. StashXR connects to your self-hosted Stash server and puts your entire media collection at your fingertips in a sleek, immersive interface.\n\nFilter by tags, performers, studios. Sort however you like. \nFind exactly what you're looking for in seconds.\nWatch your media in flat-screen mode or fully immersive VR/XR.\n\nFeatures:\n\n- Full search, filter, and sort across your Stash library\n- Flat-screen and immersive VR/XR playback modes\n- Connects to your self-hosted Stash server over your local network\n- Clean, fast interface designed for headset navigation\n- Private - your library stays on your server", "short_description": "Browse, search, and stream your Stash library from your headset. \n\n- Filter by tags, performers, studios\n- Watch in flat-screen or fully immersive VR/XR mode. \n- Connects to your self-hosted Stash server.\n\nYour collection, your headset, fully private."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stashxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "StashXR", "support_website_url": null, "website_url": "https://stashxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27145614541707893"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "2350466075714323"}, {"status": "PUBLISHED", "id": "1018768854470596"}, {"status": "CANCELLED", "id": "1458538138865130"}, {"status": "PUBLISHED", "id": "2074081040116468"}]}, "baseline_offer": {"id": "2350466075714323"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785520440, "status": "PUBLISHED", "id": "2350466075714323"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28956118020657527", "version": "3.1"}, "id": "2099286957579265", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27145614515041229", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28956118020657527"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2099286957579265"}]}, "change_log": null, "created_date": 1791246394, "id": "29440830662186258", "version": "3.2", "version_code": 10, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27145614515041229", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28956118020657527"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2099286957579265"}]}, "change_log": null, "created_date": 1788138412, "id": "28956118020657527", "version": "3.1", "version_code": 9, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27145614515041229", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28956118020657527"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2099286957579265"}]}, "change_log": "# StashXR 3.0\n\n### Flat 3D Mode and Fisheye FOVs\n\nYou can now choose new player modes allowing for playback of flat 3D (OU or SBS) videos.\nThe update also includes four new Fisheye FOVs (180\u00b0, 190\u00b0, 200\u00b0 and 220\u00b0).\n\n### Refined Design\n\nThe app's design has been overhauled and many tweaks have been made to keep a clean interface \nwhile allowing you to reach everything you need within just a few clicks.\n\n### Added Marker, Image, Gallery, Group and Folder Views\n\nStashXR 3.0 adds support for all native Stash menus. It also includes a new \"Folder View\" in which you can navigate your library directly through its underlying folder structure.\n\n### Improved Settings\n\nThe settings menu has been redesigned and restructured to give it a nicer look and make settings easier to reach. This also includes the setup screen.\n\n### Customizable Input Bindings\n\nYou can now change and customize your desired input bindings for the player. Controls like \"Play/Pause\", \"Mute\", \"Hide Controls\", etc. can now all be bound to up to two inputs simultaneously.\n\n### Improved Player Controls\n\nPlayer controls have been changed and improved, allowing for better and easier repositioning of screens and interaction with menus as well as controlling everything using just one controller (if you so choose).\n\n### Image Wall\n\nSimilar to the Scene wall introduced in StashXR 2.0, the new Image Wall allows you to browse your image collection in an immersive way, allowing for infinite scrolling.\n\n### Picture-in-Picture Mode\n\nThe new PIP-Mode (accessible through a new button in the player control overlay) allows you to keep a video playing while browsing your library or interacting with other elements of the app. You can move it between corners of your screen and quickly resume whenever you like.\n\n### MultiView Mode\n\nMultiView allows you to play up to four videos at once. Simply add your desired videos to the MultiView stack, then start playback. You can choose between sync (all videos playing at the same timestamp) and async playback (each video can play at a different timestamp) and whether only one video or all of them are audible at once. It also gives you the option to rearrange the videos in whatever order you'd like. \n\n### Advanced Filters\n\nStashXR now supports the full range of Stash filters. You can adjust all the filter options directly inside the app. It even allows for loading and saving/overwriting saved filters for easier access.\n\n### Hand Tracking on Windows\n\nThe app now supports hand tracking through apps like Virtual Desktop or Meta Horizon Link when streaming from your PC. Depending on whether your headset is able to perform hand tracking, you should be able to seamlessly switch between the two input methods.\n\n### Improved App and Quest Keyboard Support\n\nThe in-app keyboard has been redesigned and improved. On Meta Quest there's now also a toggle in settings allowing you to quickly switch between the native Quest keyboard and the in-app keyboard (whichever you prefer).\n\n### (Experimental) Funscript Support\n\nLast but not least, this update also adds experimental Funscript support for devices like The Handy. You need to have the Handy connection set up using your connection key in Stash Settings -> Interface. Once this is done, you should see videos in your library that include funscripts highlighted with an icon.\n\n### Bug Fixes\n\nThis update also includes lots of bug fixes, among them a fix for passthrough VR videos. You should now be able to play alpha or green-screen passthrough videos without any issues!\n\n\nThis is quite a big update I have been working on over the past month, so apologies for the wait! I hope many of these improvements will make your experience more enjoyable.\n\nEven though I've done my best to test everything thoroughly, as always, feel free to reach out with any feedback, bug report, or feature request!", "created_date": 1787970113, "id": "28932513679684628", "version": "3.0", "version_code": 8, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27145614515041229", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28956118020657527"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1786549426, "id": "28722428104026521", "version": "2.1", "version_code": 7, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27145614515041229", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28956118020657527"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2099286957579265"}]}, "change_log": null, "created_date": 1785253754, "id": "28537147665887900", "version": "2.0.1", "version_code": 6, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
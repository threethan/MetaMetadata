{"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27145614515041229", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28537147665887900"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2099286957579265"}]}, "change_log": null, "created_date": 1785253754, "id": "28537147665887900", "version": "2.0.1", "version_code": 6, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27145614515041229", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28537147665887900"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2099286957579265"}]}, "change_log": "# StashXR 2.0\n\nThis update includes new (requested) features, design and performance improvements and over 50 bug fixes.\n\n## New Features\n\n### Hand Tracking Support (Meta Quest only)\n\nYou're now able to put the controllers down and fully control the app using Hand Tracking!\n\n### New \"Scene Wall\"\n\nThis is a new way to explore your scene library in VR. A big endless scrolling canvas will surprise you with random selections.\n\nAccess it using the Scene wall button in the Scene Library.\n\n### Transcoding Support\n\nYou'll now be able to directly select different video resolutions which will trigger your Stash Server to transcode the video files on the fly.\n\n### Improved Video Player Controls\n\nThe player controls have been improved and cleaned up. You will now be able to toggle passthrough mode and reset your view from directly within the player.\n\n### Better Support For High Bitrate Videos (Meta Quest only)\n\nPlayback of high bitrate videos has been an issue on Quest devices since they are limited in decoding power. This update adds a new custom video player implementation which should reduce buffering and improve compatibility.\n\n**If you have any issues or feedback on this update or the app in general please reach out.**\n\nEnjoy!", "created_date": 1785104166, "id": "28517173404551993", "version": "2.0", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27145614515041229", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28537147665887900"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2099286957579265"}]}, "change_log": null, "created_date": 1779466696, "id": "27730483566554318", "version": "1.0.1", "version_code": 4, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27145614515041229", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28537147665887900"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2099286957579265"}]}, "change_log": null, "created_date": 1776115853, "id": "27265689443033735", "version": "1.0", "
356106742574_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksu1QyNgq-UQ7kNvwG3LyGM&_nc_oc=AdrXqCFhZcgCD-pWipi1B-2jnhSra9H-S11HhYER9f8Nd1syLwlNgExKwV_G5m2L_eg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dYdXsOzixhJPKctds-r4AvaRsPIyqHu0-8aXcHi3g5Q&oe=6A22FDD2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "StashXR", "keywords": [], "long_description": "Browse, search, and stream your Stash library right from your headset. StashXR connects to your self-hosted Stash server and puts your entire media collection at your fingertips in a sleek, immersive interface.\n\nFilter by tags, performers, studios. Sort however you like. \nFind exactly what you're looking for in seconds.\nWatch your media in flat-screen mode or fully immersive VR/XR.\n\nFeatures:\n\n- Full search, filter, and sort across your Stash library\n- Flat-screen and immersive VR/XR playback modes\n- Connects to your self-hosted Stash server over your local network\n- Clean, fast interface designed for headset navigation\n- Private - your library stays on your server", "short_description": "Browse, search, and stream your Stash library from your headset. \n\n- Filter by tags, performers, studios\n- Watch in flat-screen or fully immersive VR/XR mode. \n- Connects to your self-hosted Stash server.\n\nYour collection, your headset, fully private."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stashxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "StashXR", "support_website_url": null, "website_url": "https://stashxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recomm
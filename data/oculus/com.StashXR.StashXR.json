uUl6zU1cCw&oe=6B05C694"}, {"file_name": "Image_037_0000.png", "id": "1694234772174910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827585_1694234775508243_6406313351808101539_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7J9VmxXOWcQ7kNvwHNYc0v&_nc_oc=Adqu68vbahy8jHs7COXmGdK_9QlaheClqS2i-qz2Sn5M0IBQuDIL7u49WxUF4MKJHoQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQK7kZaZ0kfCoRi3qDmP0E0G50qyTIhtBoMcV11GWyicg&oe=6B05CA98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_010_0000.png", "id": "1447407283909179", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823812_1447407287242512_392531427748138905_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NfUIL1FbggQ7kNvwG9VPYq&_nc_oc=AdqWtsLUF7RP1h5uq3NYGuEjvBSY0WBW7Vgq1CYxVW4b4DZhkFVFoCM_JpSKbGFNTYQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOMbAa88buc7p_LUENrqlT-x2AMxPmiZqU2WYv2Ja9ZQ&oe=6B05D65D"}, "display_name": "StashXR", "keywords": [], "long_description": "Browse, search, and stream your Stash library right from your headset.\n\nStashXR connects to your self-hosted Stash server and puts your entire media collection at your fingertips in a sleek, immersive interface.\nFilter by tags, performers, studios and more. Sort however you like. Find exactly what you're looking for in seconds.\nWatch your media in flat-screen mode, flat 3D, or fully immersive VR/XR with multiple fisheye FOVs. \nPlay up to four videos at once with MultiView, or keep one running in Picture-in-Picture while you browse.\n\nFeatures:\n- Full search, filter, and sort across your Stash library, with support for all Stash filters\n- Scene Wall and Image Wall - Browse endlessly through your scenes and images\n- Flat-screen, flat 3D (SBS/OU) and immersive VR/XR playback modes, with 180\u00b0, 190\u00b0, 200\u00b0 and 220\u00b0 fisheye FOVs\n- MultiView - Play up to four videos at once\n- Picture-in-Picture - Keep videos playing while browsing your library\n- Hand Tracking support allowing for seamless controls\n- Customizable input bindings\n- Funscript Support\n- Clean, fast interface designed for headset navigation\n- Transcoding support for easy playback\n- Private - your library stays on your server", "short_description": "Browse, search, and stream your Stash library from your headset. \n\n- Filter by tags, performers, studios and more\n- Watch in flat-screen, flat 3D or fully immersive VR/XR mode. \n- Connects to your self-hosted Stash server.\n\nYour collection, your headset, fully private."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stashxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "StashXR", "support_website_url": null, "website_url": "https://stashxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29977149031887749"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304131_823031563600127_7109551878957280637_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkeQNbAJrYIQ7kNvwHT2KY0&_nc_oc=AdolZinqYeSB84szsj5bNdO_6GzOqvv_HTdB6bYVoPoEaie7BYidYQLwoq3bY3eb1LI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-y5kwL2CeBCsbvbV9US4EKzmhoooUTpargRNh44qeyg&
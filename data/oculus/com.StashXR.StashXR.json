R_exdpdqlA&oe=6B0DAF94"}, {"file_name": "Image_037_0000.png", "id": "1694234772174910", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827585_1694234775508243_6406313351808101539_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5fOLhYL7nUQ7kNvwFWfIEx&_nc_oc=Adot-gV928YGNns2Le-2vArUWQmMHTj9bJ5fCZdLZYSRarWGRwa35YGg85eEGFLBFwY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR_x88TslebJsuFaLcPNoltEGDW5oIY0Wg8H4lfiiNf5A&oe=6B0DB398"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_010_0000.png", "id": "1447407283909179", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823812_1447407287242512_392531427748138905_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFu6C9N4YG0Q7kNvwHYZq0n&_nc_oc=AdpDPkKIM-ptFbWQwVWAp0p52zUOqZ8damj5kgPlzmX4QqPR5hhvWgmU8O5qhdaVHhM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTSjz6I30yNummCaBMm4HhRSDD7XImgBvyZyjhcN8eG0g&oe=6B0DBF5D"}, "display_name": "StashXR", "keywords": [], "long_description": "Browse, search, and stream your Stash library right from your headset.\n\nStashXR connects to your self-hosted Stash server and puts your entire media collection at your fingertips in a sleek, immersive interface.\nFilter by tags, performers, studios and more. Sort however you like. Find exactly what you're looking for in seconds.\nWatch your media in flat-screen mode, flat 3D, or fully immersive VR/XR with multiple fisheye FOVs. \nPlay up to four videos at once with MultiView, or keep one running in Picture-in-Picture while you browse.\n\nFeatures:\n- Full search, filter, and sort across your Stash library, with support for all Stash filters\n- Scene Wall and Image Wall - Browse endlessly through your scenes and images\n- Flat-screen, flat 3D (SBS/OU) and immersive VR/XR playback modes, with 180\u00b0, 190\u00b0, 200\u00b0 and 220\u00b0 fisheye FOVs\n- MultiView - Play up to four videos at once\n- Picture-in-Picture - Keep videos playing while browsing your library\n- Hand Tracking support allowing for seamless controls\n- Customizable input bindings\n- Funscript Support\n- Clean, fast interface designed for headset navigation\n- Transcoding support for easy playback\n- Private - your library stays on your server", "short_description": "Browse, search, and stream your Stash library from your headset. \n\n- Filter by tags, performers, studios and more\n- Watch in flat-screen, flat 3D or fully immersive VR/XR mode. \n- Connects to your self-hosted Stash server.\n\nYour collection, your headset, fully private."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stashxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "StashXR", "support_website_url": null, "website_url": "https://stashxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29977149031887749"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304131_823031563600127_7109551878957280637_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXO_OH1e37IQ7kNvwGB9_lH&_nc_oc=AdpeLeYV3fLiOjzxDtCRP1xMX2uT4r-wuuZ8EM7_AzRRh1DaDEuAoZUI_BpaS9XZfLI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTaym9NLivyZcO5vTIGRLKNQfyLcj9hQNhEKX9UNy5KHA&
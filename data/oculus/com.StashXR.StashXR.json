S", "screenshots": [{"file_name": "Image Sequence_010_0000.png", "id": "1830085555105780", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824307_1830085561772446_3595307646249392524_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsdE0tKXxrYQ7kNvwEKdupG&_nc_oc=AdqPdwn65crRjwnjr2j8o3_KmqXYWwO-8fQNtY22M1MWiRiL73oPKTfS4kZqqPQJKd4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTrTDZ_aYnU6KxRP8b5-m3dKoMD14Sddj2WbtNTyWrPQ&oe=6AAD5B3E"}, {"file_name": "Image Sequence_007_0000.png", "id": "2208222803297843", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824294_2208222806631176_1526497000885677642_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJDMyqSWhbkQ7kNvwEZuRWo&_nc_oc=AdpmVPS5HbAROoWq-YilcrOswtdxf6Qk7uED9PL5E5Q5zB2j2iRGxflqbtTBxzQ3I8k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZiOZX282KWTQ0qJJNXbiZThtpzQeO1CS8u-vQ5d7Sqg&oe=6AAD513A"}, {"file_name": "Image Sequence_017_0000.png", "id": "1541954790475401", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825470_1541954793808734_7435673770489650864_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnjPNnR-0WkQ7kNvwF_hYTG&_nc_oc=AdprjJ-bZxN-f_BHrlURrep9NroWZ03PYTpy8dCzDfXKFBURavOJXgS4L51LNEuHOfY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLv5ccXhJ39EJp-sKjfU8qqBgzWrFmUI0v_FJ6QhF8V0A&oe=6AAD3343"}, {"file_name": "Image Sequence_015_0000.png", "id": "1064823779261771", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821796_1064823782595104_2579552243318720717_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Do97AJpg-7QQ7kNvwEE_nSi&_nc_oc=AdpuINjT8zW4LPeqsf25FOqFV4qAplBrUqBuzP-FkGC-2ael4IUZRDhJAo8Ip5Tnrck&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOkXvQjOcDYCiMmei0a1328ctNzN6HDL3Sfk3uAr_9bQ&oe=6AAD3FCE"}, {"file_name": "Image Sequence_016_0000.png", "id": "1098140239542607", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825546_1098140242875940_5739824253264502308_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_d8KRPXmJYQ7kNvwHMfTYQ&_nc_oc=AdoQBA9yD3ci5rJUIBodTRQ92GvHu4EFnkuzwYoPLncwydTeyf58o2lFBE0z3WHTHXA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYuOlzFkmvP5N7OAj7u654KpVcatTJQ-uBNwrRGKvkww&oe=6AAD5E70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_010_0000.png", "id": "1447407283909179", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823812_1447407287242512_392531427748138905_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3vx-4mAMDkQ7kNvwEWJ3xB&_nc_oc=AdrCO8M0iVBMenpEuIjJYOdqBKrviOa8EfGKwq1irINXygYfSudWGZ1x2mG0tH2cyTU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGnxjbdcXgS_isck4s_I94svu0n0sEKCJMTIfd5afszQ&oe=6AAD499D"}, "display_name": "StashXR", "keywords": [], "long_description": "Browse, search, and stream your Stash library right from your headset.\n\nStashXR connects to your self-hosted Stash server and puts your entire media collection at your fingertips in a sleek, immersive interface.\nFilter by tags, performers, studios and more. Sort however you like. Find exactly what you're looking for in seconds.\nWatch your media in flat-screen mode, flat 3D, or fully immersive VR/XR with multiple fisheye FOVs. \nPlay up to four videos at once with MultiView, or keep one running in Picture-in-Picture while you browse.\n\nFeatures:\n- Full search, filter, and sort across your Stash library, with support for all Stash filters\n- Scene Wall and Image Wall - Browse endlessly through your scenes and images\n- Flat-screen, flat 3D (SBS/OU) and immersive VR/XR playback modes, with 180\u00b0, 190\u00b0, 200\u00b0 and 220\u00b0 fisheye FOVs\n- MultiView - Play up to four videos at once\n- Picture-in-Picture - Keep videos playing while browsing your library\n- Hand Tracking support allowing for seamless controls\n- Customizable input bindings\n- Funscript Support\n- Clean, fast interface designed for headset navigation\n- Transcoding support for easy playback\n- Private - your library stays on your server", "short_description": "Browse, search, and stream your Stash library from your headset. \n\n- Filter by tags, performers, studios and more\n- Watch in flat-screen, flat 3D or fully immersive VR/XR mode. \n- Connects to your self-hosted Stash server.\n\nYour collection, your headset, fully private."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stashxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "StashXR", "support_website_url": null, "website_url": "https://stashxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28932505376352125"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304131_823031563600127_7109551878957280637_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MpEqzaEHi8Q7kNvwFbsJmf&_nc_oc=AdrFuyyu1E8VuKFLiV-D85df57ZXkjYnFtuD8pEouaayxTaFC75zH0CuRD8tZ9ygdiU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLreNm78MDLVFEaSpO30fXs0UXalOqlc8OJ-4b613WEhQ&oe=6AAD2E0C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "StashXR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id":
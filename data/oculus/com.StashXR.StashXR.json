6e7a0a&_nc_ohc=Sf_aq2b53voQ7kNvwHJCDbD&_nc_oc=AdoBOUYjPmsOfq3VLhOg92LpfdRe5zI7u2L86S_sVnZfzpF1k-B_Pi-w313u0iBkbyI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-MhIpwxWYti--NLNOP9ZS9FavInGiJSb236yqXrMjzA&oe=6A7DB154"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_001_0000.png", "id": "1084731707448113", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491828608_1084731714114779_618887504652387920_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhNdBpAvUyAQ7kNvwFpQ7tI&_nc_oc=AdoUKoJDrIjwDt5HWN-SMMA3s8Mdkbzqw2tEP4EaCFR_kpFsLb1Nd--E7Nj-u0oNTVE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPp_fX-t9hQxwcnwaW4pcpOT3wKcV-PLvHIVpdwrXAVA&oe=6A7DB3CD"}, "display_name": "StashXR", "keywords": [], "long_description": "Browse, search, and stream your Stash library right from your headset. StashXR connects to your self-hosted Stash server and puts your entire media collection at your fingertips in a sleek, immersive interface.\n\nFilter by tags, performers, studios. Sort however you like. \nFind exactly what you're looking for in seconds.\nWatch your media in flat-screen mode or fully immersive VR/XR.\n\nFeatures:\n\n- Full search, filter, and sort across your Stash library\n- Infinity Wall - Browse endlessly through your collection\n- Hand Tracking support allowing for seamless controls\n- Flat-screen and immersive VR/XR playback modes\n- Connects to your self-hosted Stash server over your local network\n- Clean, fast interface designed for headset navigation\n- Transcoding support for easy playback\n- Private - your library stays on your server", "short_description": "Browse, search, and stream your Stash library from your headset. \n\n- Filter by tags, performers, studios\n- Watch in flat-screen or fully immersive VR/XR mode. \n- Connects to your self-hosted Stash server.\n\nYour collection, your headset, fully private."}]}, "developer_name": null, "developer_privacy_policy_url": "http
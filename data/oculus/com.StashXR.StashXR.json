S", "screenshots": [{"file_name": "Image Sequence_010_0000.png", "id": "1830085555105780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824307_1830085561772446_3595307646249392524_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVAuu5xRAWUQ7kNvwFsAR2h&_nc_oc=AdrbfQuUhd5hB0NDNKnEXZYQb_c6kDkcjXuR2TK2aUMbnnmG5JaQweTyUH_OQeKhHKc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxixUisOntLd9tdkF8_ZcYFsOOYsbphsW4yOk4Lged3g&oe=6AF72F3E"}, {"file_name": "Image Sequence_007_0000.png", "id": "2208222803297843", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824294_2208222806631176_1526497000885677642_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xs7Xk-fAjtUQ7kNvwGO1PVW&_nc_oc=AdqWu2iktKsZKW_vLQysfCL0A6Xsn6J8elJKgGki1PTLQiVINvCvOrDEpddKbf6M9yw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3X-lxcQKrHmscqF_L-oQ5OcjbVGoR6Sh-2Hi9rzkZqA&oe=6AF7253A"}, {"file_name": "Image Sequence_017_0000.png", "id": "1541954790475401", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825470_1541954793808734_7435673770489650864_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LtvppT7dIcQ7kNvwGtUHiF&_nc_oc=AdqSGX0tBEqfSuXmAafPEvE-FJzVYzwsiYyV3vjtaRROjrKL588OMOVwyO649YxS5Iw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSED52bNZvypZAny-I0Z7VkDKcmGikDhP-yrKRKSlCYOg&oe=6AF73F83"}, {"file_name": "Image Sequence_015_0000.png", "id": "1064823779261771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_1064823782595104_2579552243318720717_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDR2LHj8vRAQ7kNvwFhK1O_&_nc_oc=Adp50UubCGvE5ev2pJ2v4_y1V0J_gX6QrnvyztTZbG7Kn9t2FUboHLS0iLR9j20WSZM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkFWJFGvHQsaT6x-j5kp1GIvYkgFe4Yhx6kmpatVG0wQ&oe=6AF713CE"}, {"file_name": "Image Sequence_016_0000.png", "id": "1098140239542607", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825546_1098140242875940_5739824253264502308_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZaoQAiB054Q7kNvwHvzUFf&_nc_oc=AdoC4WJU9iZFX3L54EH0LVd8ANk1KK8C7wqrbWRDKzsb_Z0bUjoPs5TF_8BaMyqhoDo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7ZlHQtwYQ9UFbjvtgRi81EiPa6-sfQZH8rf0kyXFTBQ&oe=6AF73270"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_010_0000.png", "id": "1447407283909179", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_1447407287242512_392531427748138905_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xp7Z7qSGgccQ7kNvwEq6GGA&_nc_oc=AdrUuUs0xKrEPDjEVuZ8ROrAhvsSRfySu9wk3rU315hoOPZsdy305o7haD3awtqqeeM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDUz9JjcIQtSi7zN6WYROqmlUOSbePoo7etHMtho3LCQ&oe=6AF71D9D"}, "display_name": "StashXR", "keywords": [], "long_description": "Browse, search, and stream your Stash library right from your headset.\n\nStashXR connects to your self-hosted Stash server and puts your entire media collection at your fingertips in a sleek, immersive interface.\nFilter by tags, performers, studios and more. Sort however you like. Find exactly what you're looking for in seconds.\nWatch your media in flat-screen mode, flat 3D, or fully immersive VR/XR with multiple fisheye FOVs. \nPlay up to four videos at once with MultiView, or keep one running in Picture-in-Picture while you browse.\n\nFeatures:\n- Full search, filter, and sort across your Stash library, with support for all Stash filters\n- Scene Wall and Image Wall - Browse endlessly through your scenes and images\n- Flat-screen, flat 3D (SBS/OU) and immersive VR/XR playback modes, with 180\u00b0, 190\u00b0, 200\u00b0 and 220\u00b0 fisheye FOVs\n- MultiView - Play up to four videos at once\n- Picture-in-Picture - Keep videos playing while browsing your library\n- Hand Tracking support allowing for seamless controls\n- Customizable input bindings\n- Funscript Support\n- Clean, fast interface designed for headset navigation\n- Transcoding support for easy playback\n- Private - your library stays on your server", "short_description": "Browse, search, and stream your Stash library from your headset. \n\n- Filter by tags, performers, studios and more\n- Watch in flat-screen, flat 3D or fully immersive VR/XR mode. \n- Connects to your self-hosted Stash server.\n\nYour collection, your headset, fully private."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stashxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "StashXR", "support_website_url": null, "website_url": "https://stashxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28932505376352125"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304131_823031563600127_7109551878957280637_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rhcl3KhyjUIQ7kNvwG9z_yR&_nc_oc=AdqBwJYaTUhTNSfQ8rZFDUnv4vs39xqcvUT-U6M1kKA-bmPODLPsg6m40HFZWSGLq2s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYVRMbss-5mIeg-xPhl0MoBQC22D7S1Z8uRaAanO99uQ&oe=6AF73A4C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "StashXR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id":
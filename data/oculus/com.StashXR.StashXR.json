0406704899_1341905288226819_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKpsxGsUtDwQ7kNvwFaLF8q&_nc_oc=Adp_PNnfcFT1GMepgfxIjsOQNpZPC_OFaLXpPMNfXEiISROjMHzGpVDxVY0EtQjO2Mk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZLVtuTMrUP5bt3VQu79IKqsWpCkdEzAtBVj6sxCJQSg&oe=6AE89FC3"}, {"file_name": "Image Sequence_008_0000.png", "id": "1271997874486273", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499302483_1271997877819606_1969445876879584338_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4qjpWxd0C4Q7kNvwHK-ijU&_nc_oc=AdoDF9WaSLEPfUrlUyYLgJaL-bUDNZG0jYp08wttaKkCBqsaR3Qo-E7K9oJKgwYfL_0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSFaMh1F-G_y_lWIxfV8Ue5shn-LWqO32tSA40c3oUqQ&oe=6AE8AC63"}, {"file_name": "Image Sequence_010_0000.png", "id": "2344957619364689", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499304019_2344957626031355_3695640148420276034_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXLqLVVKZ7wQ7kNvwGTBJCi&_nc_oc=Ado3JRqYJGKOsD8khDdeqq_-KlyJI9EaYa8Oc6Op5O1WJfuslJSJF-9AoPGR-Erbthk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUXIaOgG-6lnjk4kbiufoVp7A1LlJV33steWoo_7LQVQ&oe=6AE8B268"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "StashXR", "keywords": [], "long_description": "Browse, search, and stream your Stash library right from your headset. StashXR connects to your self-hosted Stash server and puts your entire media collection at your fingertips in a sleek, immersive interface.\n\nFilter by tags, performers, studios. Sort however you like. \nFind exactly what you're looking for in seconds.\nWatch your media in flat-screen mode or fully immersive VR/XR.\n\nFeatures:\n\n- Full search, filter, and sort across your Stash library\n- Flat-screen and immersive VR/XR playback modes\n- Connects to your self-hosted Stash server over your local network\n- Clean, fast interface designed for headset navigation\n- Private - your library stays on your server", "short_description": "Browse, search, and stream your Stash library from your headset. \n\n- Filter by tags, performers, studios\n- Watch in flat-screen or fully immersive VR/XR mode. \n- Connects to your self-hosted Stash server.\n\nYour collection, your headset, fully private."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stashxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "StashXR", "support_website_url": null, "website_url": "https://stashxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27145614541707893"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "2350466075714323"}, {"status": "PUBLISHED", "id": "1018768854470596"}, {"status": "CANCELLED", "id": "1458538138865130"}, {"status": "PUBLISHED", "id": "2074081040116468"}]}, "baseline_offer": {"id": "2350466075714323"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785520440, "status": "PUBLISHED", "id": "2350466075714323"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29775841555351832", "version": "3.5"}, "id": "2099286957579265", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_ap
S", "screenshots": [{"file_name": "Image Sequence_010_0000.png", "id": "1830085555105780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824307_1830085561772446_3595307646249392524_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWO8g_V-zPAQ7kNvwEDZsg7&_nc_oc=AdpVZLO9awjGBJ-wlU9p5OJRCbzyQ3UWTKEdGHe9ePKDIF08wdSqiKscWktB-wwf-iE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjR7ZeAvtjlMTdqi9tiDWQ87NM3_RwbWE59FvJmyTTRg&oe=6AEDF4BE"}, {"file_name": "Image Sequence_007_0000.png", "id": "2208222803297843", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824294_2208222806631176_1526497000885677642_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxWwDlKG_gwQ7kNvwF-RDuR&_nc_oc=AdoR90Ys5Icru4m9brnwPLlDXJV1JLF7k4LVz6rMDfYpfYxOCHTSG9hYB1F27LnflkQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMjLuwPKQOdtsMaczeBY0DPXD3yN5tWrHm9OIaS3dDPw&oe=6AEDEABA"}, {"file_name": "Image Sequence_017_0000.png", "id": "1541954790475401", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825470_1541954793808734_7435673770489650864_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=neVujxdMF0sQ7kNvwE7UJZH&_nc_oc=AdqHeHVmy7lgKvlqjY2shDVbdwD4wfEmTreGHjtfvhoU505t1K-ifOA9HBeu3RruaCc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6cNmCnMCkO3PppR5cYKs9UnRi_J-to7QPUkla7ddyHw&oe=6AEE0503"}, {"file_name": "Image Sequence_015_0000.png", "id": "1064823779261771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821796_1064823782595104_2579552243318720717_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8dK1jWOqAoQ7kNvwHGQ6so&_nc_oc=Adq2zVxlsg9GmSHpVgNkr0QgzLexuDgMAEXxuJuR9G_mvOzLo_yEJm9lOF9_gwqBwG8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBe_FSUqx4WsYNZ1WVpIATWGIQ9LkFHoDSZ-lJfuQt-Q&oe=6AEDD94E"}, {"file_name": "Image Sequence_016_0000.png", "id": "1098140239542607", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825546_1098140242875940_5739824253264502308_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inEzGRp2GIYQ7kNvwEKMnho&_nc_oc=AdqYoHVvefcaOC4xrG-q8STmEnPIzaPEpfcRq8-xK-diUwM-KC9UOaoAcW-RqQU3feo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgNM6i-iXU5jHSr6klAQmidX7U1azPki3ZgDERa_29-w&oe=6AEDF7F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_010_0000.png", "id": "1447407283909179", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823812_1447407287242512_392531427748138905_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1LpPxvSXwzMQ7kNvwGULgnz&_nc_oc=AdoWCPSutH-J5TkD33KHRd37HzmcgIFTyp577s0KHvJTU86kW7Ip800ISw_XnPrrVcM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsGGGJ047d2roDxBjzPOJdh5sAYcNTk2KwnxwNM46osw&oe=6AEDE31D"}, "display_name": "StashXR", "keywords": [], "long_description": "Browse, search, and stream your Stash library right from your headset.\n\nStashXR connects to your self-hosted Stash server and puts your entire media collection at your fingertips in a sleek, immersive interface.\nFilter by tags, performers, studios and more. Sort however you like. Find exactly what you're looking for in seconds.\nWatch your media in flat-screen mode, flat 3D, or fully immersive VR/XR with multiple fisheye FOVs. \nPlay up to four videos at once with MultiView, or keep one running in Picture-in-Picture while you browse.\n\nFeatures:\n- Full search, filter, and sort across your Stash library, with support for all Stash filters\n- Scene Wall and Image Wall - Browse endlessly through your scenes and images\n- Flat-screen, flat 3D (SBS/OU) and immersive VR/XR playback modes, with 180\u00b0, 190\u00b0, 200\u00b0 and 220\u00b0 fisheye FOVs\n- MultiView - Play up to four videos at once\n- Picture-in-Picture - Keep videos playing while browsing your library\n- Hand Tracking support allowing for seamless controls\n- Customizable input bindings\n- Funscript Support\n- Clean, fast interface designed for headset navigation\n- Transcoding support for easy playback\n- Private - your library stays on your server", "short_description": "Browse, search, and stream your Stash library from your headset. \n\n- Filter by tags, performers, studios and more\n- Watch in flat-screen, flat 3D or fully immersive VR/XR mode. \n- Connects to your self-hosted Stash server.\n\nYour collection, your headset, fully private."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stashxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "StashXR", "support_website_url": null, "website_url": "https://stashxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28932505376352125"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304131_823031563600127_7109551878957280637_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGZDpIYkaDUQ7kNvwEoygff&_nc_oc=AdrHULE_K872gMl3opF0z1kGfWG2lyaC1a4noIxtwztAxS0innQ0h8ULA279AHZoWb8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcirs_TNrq2IL0oyWu9vVYzA5DrqLqD54OYuZmbL8XWA&oe=6AEDFFCC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "StashXR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id":
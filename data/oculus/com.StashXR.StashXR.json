shXR", "support_website_url": null, "website_url": "https://stashxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27145614541707893"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "2350466075714323"}, {"status": "PUBLISHED", "id": "1018768854470596"}, {"status": "CANCELLED", "id": "1458538138865130"}, {"status": "PUBLISHED", "id": "2074081040116468"}]}, "baseline_offer": {"id": "2350466075714323"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785520440, "status": "PUBLISHED", "id": "2350466075714323"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28537147665887900", "version": "2.0.1"}, "id": "2099286957579265", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27145614515041229", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28537147665887900"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1786549426, "id": "28722428104026521", "version": "2.1", "version_code": 7, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27145614515041229", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28537147665887900"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2099286957579265"}]}, "change_log": null, "created_date": 1785253754, "id": "28537147665887900", "version": "2.0.1", "version_code": 6, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27145614515041229", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28537147665887900"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2099286957579265"}]}, "change_log": "# StashXR 2.0\n\nThis update includes new (requested) features, design and performance improvements and over 50 bug fixes.\n\n## New Features\n\n### Hand Tracking Support (Meta Quest only)\n\nYou're now able to put the controllers down and fully control the app using Hand Tracking!\n\n### New \"Scene Wall\"\n\nThis is a new way to explore your scene library in VR. A big endless scrolling canvas will surprise you with random selections.\n\nAccess it using the Scene wall button in the Scene Library.\n\n### Transcoding Support\n\nYou'll now be able to directly select different video resolutions which will trigger your Stash Server to transcode the video files on the fly.\n\n### Improved Video Player Controls\n\nThe player controls have been improved and cleaned up. You will now be able to toggle passthrough mode and reset your view from directly within the player.\n\n### Better Support For High Bitrate Videos (Meta Quest only)\n\nPlayback of high bitrate videos has been an issue on Quest devices since they are limited in decoding power. This update adds a new custom video player implementation which should reduce buffering and improve compatibility.\n\n**If you have any issues or feedback on this update or the app in general please reach out.**\n\nEnjoy!", "created_date": 1785104166, "id": "28517173404551993", "version": "2.0", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27145614515041229", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28537147665887900"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2099286957579265"}]}, "change_log": null, "created_date": 1779466696, "id": "27730483566554318", "version": "1.0.1", "version_code": 4, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27145614515041229", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28537147665887900"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2099286957579265"}]}, "change_log": null, "created_date": 1776115853, "id": "27265689443033735", "version": "1.0", "version_code": 3, "rel
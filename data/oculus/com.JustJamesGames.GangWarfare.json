UQ7kNvwG0mpUO&_nc_oc=Ado4TTEmgyWVrCy0q26AkQXb4HlHsC0eV_2ky-8XOaFwRbUUVZzdISv6ptop6yTkmHc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtpUrWZ25uqodSwYV7AcgMafX3M3pR20cC_hR0mZc1MQ&oe=6AD39A3E"}, {"file_name": "SS5.png", "id": "1471024697641407", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391888_1471024700974740_7813733804114978825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jp_XhFqC_DcQ7kNvwHkAQ8s&_nc_oc=AdqulYwo2_ZORz0t8f3rlZByYafnU_OB3Hd6QEvfDN5LiJ-dr0ijikgGyed6kmhxkt8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAX9etOpilUWpHgywOuuJavj8lpSjsp0DYTZeG2YKrJA&oe=6AD39C07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover1.png", "id": "778416861290891", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491818860_778416864624224_5834366279289217342_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PT0hfqae-I4Q7kNvwHHcDbS&_nc_oc=Adr-0pepj8ddzJiaczoXwSX-iDgXDKAU90Jb45gY4SRdssqUZQexsNJh_E4IqlxEYIY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYb030zFUd0mbaltjxmpfPmZnkRy8nZL1DE5TPt3Atmw&oe=6AD3A2A7"}, "display_name": "Gang Warfare", "keywords": ["sandbox", "shooter", "action"], "long_description": "# *| START AS A NOBODY*\n\nAfter a failed raid, you and your cop partner are ambushed. Left for dead, you are recruited into a special unit that is designed to take down the gangs that run the corrupt city. You must make a choice to uphold the law, or carve out your own name in the criminal underworld.\n\n# *| PERFECT BLEND OF STORY AND SANDBOX*\n\nWhether you're blowing up rival stashes, stealing their supplies, or putting a bullet in their boss, every contract pushes you closer to the top. But when the smoke clears, you're free to do things your way. Jump into sandbox mode and cause chaos on your terms. Turn on cheats, spawn enemies, mess with physics, or build your own scenarios. This is your turf.\n\n\n# *| RAGDOLLS, PHYSICS & CHAOS!*\n\nWith large, detailed maps, physics-based gunplay, ragdoll enemies, and lots of weapons to try, you will be kept busy for hours of fun.", "short_description": "Step into the gritty underworld of gang conflicts, where chaos and action are around every corner. Take on ruthless gangs as you fight to secure the city."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gangwarfarevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Just James Games", "support_website_url": "https://gangwarfarevr.com/contact", "website_url": "https://www.gangwarfarevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28052122227731550"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473392025_1367959880921296_5006825450634142153_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nc7VFY9YIrAQ7kNvwGu-Cc3&_nc_oc=Adr0EyY1gbWxp91LBDadu_mDAwBF1VHlZBgFSpBWjWxNtfvN37qtD-bPZ37FAlQ2Fl8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7eodONSzTYK6nHrPLoak72vL9_eZUUlHWRN4CRNNlcw&oe=6AD38651"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gang Warfare", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_to
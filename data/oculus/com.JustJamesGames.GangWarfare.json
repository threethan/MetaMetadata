oQ7kNvwENKsEr&_nc_oc=Adp2thpCKjbi6bHH61KDDBya0BpPzs9P2enymimJR2h8jtav2B6pOBKcd8HPgNFVWWM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbcLPFvZLvwIGyzzTEGvbypFfPBiroNdOkxXhd8m1e1A&oe=6ABFD3BE"}, {"file_name": "SS5.png", "id": "1471024697641407", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391888_1471024700974740_7813733804114978825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WUgdoh3PPQQ7kNvwEFyxuF&_nc_oc=Adp62HdA2BpjHlTK3vzD15zA3hyUgT8sQUesfLNrhsWx2posIFChlUONS-LXQoyvXZk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgO3EJQIGJeTs9bAHehLsrsdyT6qi37RYOGYz41PRSqA&oe=6ABFD587"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover1.png", "id": "778416861290891", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818860_778416864624224_5834366279289217342_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnnmXA7fPR4Q7kNvwEGcwAQ&_nc_oc=Adq1kE-30E9pZ4xu4Nasxu8ooOPwxaLpWU_VgZzNWtUIimVEgbIklVbSxiC4lZ2S6yU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzn06rP0EKoNqS7KJ0n2UY3nnlrHUnv3omdhMXHXnbqg&oe=6ABFDC27"}, "display_name": "Gang Warfare", "keywords": ["sandbox", "shooter", "action"], "long_description": "# *| START AS A NOBODY*\n\nAfter a failed raid, you and your cop partner are ambushed. Left for dead, you are recruited into a special unit that is designed to take down the gangs that run the corrupt city. You must make a choice to uphold the law, or carve out your own name in the criminal underworld.\n\n# *| PERFECT BLEND OF STORY AND SANDBOX*\n\nWhether you're blowing up rival stashes, stealing their supplies, or putting a bullet in their boss, every contract pushes you closer to the top. But when the smoke clears, you're free to do things your way. Jump into sandbox mode and cause chaos on your terms. Turn on cheats, spawn enemies, mess with physics, or build your own scenarios. This is your turf.\n\n\n# *| RAGDOLLS, PHYSICS & CHAOS!*\n\nWith large, detailed maps, physics-based gunplay, ragdoll enemies, and lots of weapons to try, you will be kept busy for hours of fun.", "short_description": "Step into the gritty underworld of gang conflicts, where chaos and action are around every corner. Take on ruthless gangs as you fight to secure the city."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gangwarfarevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Just James Games", "support_website_url": "https://gangwarfarevr.com/contact", "website_url": "https://www.gangwarfarevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28052122227731550"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392025_1367959880921296_5006825450634142153_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gqI8TCmvZ60Q7kNvwEzAbKC&_nc_oc=AdruzD9JKbSF8l5gCLSTx4vJcqI12NQKHhMN9NuIVmbd_k9uSAYtcdC_8Jx1RWmYM_Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwLxWcD25V9TK0POz3O55ZzxK2buPHR8o9jvtIbK-qgg&oe=6ABFBFD1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gang Warfare", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_to
MQ7kNvwHXwpoA&_nc_oc=Adr-KM4b_9JFL9sWvo9dnHqbBroWbbIc_-bmrcCc_a-JOm4KWfWVPwgY8lI06_4jsUY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsd16LRr3_LeZtJsTCmg8UAj-QCBQ5f6Cpb3gMJYpr6Q&oe=6AB547BE"}, {"file_name": "SS5.png", "id": "1471024697641407", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391888_1471024700974740_7813733804114978825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTO3ToYRf9EQ7kNvwHT-g4h&_nc_oc=AdrshcN2JQGaPxU8CfnSiMB_IM3Jnr3PGGvSbv95XAFnW0focAkYo_LE97-qBcTmLfQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpbq10uPk6m9imNMd32axlFj8TXW6SkHzdEUjpUN2GLQ&oe=6AB54987"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover1.png", "id": "778416861290891", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_778416864624224_5834366279289217342_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEHlqDUHYlwQ7kNvwHUTEa7&_nc_oc=AdpvEWGTKd2NqR3li2GkHNbnFcHZUhrCPYynGhlb8-p8rqagaZaewwV_zF5_AuxDxZI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaq41nVCSDM_P_Vkmd3ZubKX6wE5g-QqXAs7u-emZ2TA&oe=6AB517E7"}, "display_name": "Gang Warfare", "keywords": ["sandbox", "shooter", "action"], "long_description": "# *| START AS A NOBODY*\n\nAfter a failed raid, you and your cop partner are ambushed. Left for dead, you are recruited into a special unit that is designed to take down the gangs that run the corrupt city. You must make a choice to uphold the law, or carve out your own name in the criminal underworld.\n\n# *| PERFECT BLEND OF STORY AND SANDBOX*\n\nWhether you're blowing up rival stashes, stealing their supplies, or putting a bullet in their boss, every contract pushes you closer to the top. But when the smoke clears, you're free to do things your way. Jump into sandbox mode and cause chaos on your terms. Turn on cheats, spawn enemies, mess with physics, or build your own scenarios. This is your turf.\n\n\n# *| RAGDOLLS, PHYSICS & CHAOS!*\n\nWith large, detailed maps, physics-based gunplay, ragdoll enemies, and lots of weapons to try, you will be kept busy for hours of fun.", "short_description": "Step into the gritty underworld of gang conflicts, where chaos and action are around every corner. Take on ruthless gangs as you fight to secure the city."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gangwarfarevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Just James Games", "support_website_url": "https://gangwarfarevr.com/contact", "website_url": "https://www.gangwarfarevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28052122227731550"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392025_1367959880921296_5006825450634142153_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByICHIiso80Q7kNvwEPlV6f&_nc_oc=Adp3Yf0qdaWl3JHfd2P_o6Z6rZL4OdjBTanFspc3tUQvmkfXfOdi9xrG-acmMnfS1h8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILEGrpdWlmiZ79iA80UiDbj69WVl_Wa2vUVJpQzxMDfQ&oe=6AB533D1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gang Warfare", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_to
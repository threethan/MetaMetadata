/473393516_1057838972850816_3552852806084483132_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtvsQJpREogQ7kNvwEdNX_p&_nc_oc=Adme--KDlerIPWSCa8R0BwFLItqVv-_04FmzvnhQ2FlwWHmt1BtAlUC0zV5wiBLtcU4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGDiTLO9kDJq2usfYqcbaX1pulIEogor3KcpuaH1KNIQ&oe=69B14D2A"}, {"file_name": "SS3.png", "id": "1034375961930599", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391952_1034375965263932_7134276279578367230_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mRQnXTmHHIQ7kNvwG_9M58&_nc_oc=AdletkWj9O0E7N7MaplKQGggN1vpf7fLLprs57YCi2LV_GIMCLGUaYdhi6V9FURfGdM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx0Pi2N5lQthUR5tKLQ_4dSoR7DbOcN0e2HJX4hTvHbUQ&oe=69B14D85"}, {"file_name": "SS4.png", "id": "641909355389366", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473401067_641909358722699_5446915222927348372_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YC50RCoB7u0Q7kNvwEWsahL&_nc_oc=Adn4GXfPRCurUvpa0hYhOZLFPFmFWCfq4pr3Gb69_JLAsYU0QOS-ml598ZrHJJmvymo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxsq02g86ZSWuKv1tC6OQ-DEs4vjbwb9kA9dGR4qkdaTA&oe=69B157FE"}, {"file_name": "SS5.png", "id": "1471024697641407", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391888_1471024700974740_7813733804114978825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBSz0ej8g9oQ7kNvwFBPTyE&_nc_oc=AdkA7etHXnTz9F6amXr-VJKlBkUx3feMuA2BriSZOgd4XGUdJhby6gL2F9OxgQ9XsDc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxqmoR9kUfjFJ1VK0cA6ncUMkhNRPKA1kDHTxcsOsuZXA&oe=69B159C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gang Warfare", "keywords": ["sandbox", "shooter", "action"], "long_description": "# *| START AS A NOBODY*\n\nAfter a failed raid, you and your cop partner are ambushed. Left for dead, you are recruited into a special unit that is designed to take down the gangs that run the corrupt city. You must make a choice to uphold the law, or carve out your own name in the criminal underworld.\n\n# *| PERFECT BLEND OF STORY AND SANDBOX*\n\nWhether you're blowing up rival stashes, stealing their supplies, or putting a bullet in their boss, every contract pushes you closer to the top. But when the smoke clears, you're free to do things your way. Jump into sandbox mode and cause chaos on your terms. Turn on cheats, spawn enemies, mess with physics, or build your own scenarios. This is your turf.\n\n\n# *| RAGDOLLS, PHYSICS & CHAOS!*\n\nWith large, detailed maps, physics-based gunplay, ragdoll enemies, and lots of weapons to try, you will be kept busy for hours of fun.\n\n# *| AND YES, IT'S FREE!*\nSo break in, cash out and get paid.", "short_description": "Step into the gritty underworld of gang conflicts, where chaos and action are around every corner. Take on ruthless gangs as you fight to expand your own operation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gangwarfarevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Just James Games", "support_website_url": "https://gangwarfarevr.com/contact", "website_url": "https://www.gangwarfarevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23954655877478226"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "
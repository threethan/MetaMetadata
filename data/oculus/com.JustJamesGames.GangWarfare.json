sjc6-1.oculuscdn.com/v/t64.5771-25/473393516_1057838972850816_3552852806084483132_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZG9fhU49QKIQ7kNvwE3lxL_&_nc_oc=AdpTB6BdmRwUwcn8Q00uqG_O3hyY863lCG3aIqoy5O4InXiuGzeJmSrjigAVsUq4ctQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0isbSQSTb4h5HmuK__idSLO194_X3F_nDHXJMSeQPWw&oe=6A2ACF6A"}, {"file_name": "SS3.png", "id": "1034375961930599", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391952_1034375965263932_7134276279578367230_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mkkjxg4NNUQ7kNvwFub3_8&_nc_oc=AdoaRGODGyofbWjQJpC8xsXh88JTjZy9VIlTVisuZ27-DAsY5i1CUFiqNiHxw0O9eYg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8we4NS0jFifZa9WV1UOag8mAX-onmbfOXJo_NcCFPcJA&oe=6A2ACFC5"}, {"file_name": "SS4.png", "id": "641909355389366", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473401067_641909358722699_5446915222927348372_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5twxFaeNkgQ7kNvwH2J6RF&_nc_oc=Ado6M-CN1DyGQlYb_qvyONHNJg71dAnsrkwDxI3vypvn6pAk5gpb2EqWaTctRjr9i9o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kGgu2ptrrFC156We1-QzHuKJcwPN9pY1LVOYLo1Z9Ug&oe=6A2ADA3E"}, {"file_name": "SS5.png", "id": "1471024697641407", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391888_1471024700974740_7813733804114978825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QsVYni6howQ7kNvwHXalD9&_nc_oc=AdrDJPypl_VHed_ww4MUSbPI0QvrJK2UfIm1Is15eeAFevQoRyCOw38gbWrPGuVQY70&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92s83UMorh7Qz9e1XUDM5gBy7hZeBhPTXZtj3hWBrxWw&oe=6A2ADC07"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gang Warfare", "keywords": ["sandbox", "shooter", "action"], "long_description": "# *| START AS A NOBODY*\n\nAfter a failed raid, you and your cop partner are ambushed. Left for dead, you are recruited into a special unit that is designed to take down the gangs that run the corrupt city. You must make a choice to uphold the law, or carve out your own name in the criminal underworld.\n\n# *| PERFECT BLEND OF STORY AND SANDBOX*\n\nWhether you're blowing up rival stashes, stealing their supplies, or putting a bullet in their boss, every contract pushes you closer to the top. But when the smoke clears, you're free to do things your way. Jump into sandbox mode and cause chaos on your terms. Turn on cheats, spawn enemies, mess with physics, or build your own scenarios. This is your turf.\n\n\n# *| RAGDOLLS, PHYSICS & CHAOS!*\n\nWith large, detailed maps, physics-based gunplay, ragdoll enemies, and lots of weapons to try, you will be kept busy for hours of fun.\n\n# *| AND YES, IT'S FREE!*\nSo break in, cash out and get paid.", "short_description": "Step into the gritty underworld of gang conflicts, where chaos and action are around every corner. Take on ruthless gangs as you fight to expand your own operation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gangwarfarevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Just James Games", "support_website_url": "https://gangwarfarevr.com/contact", "website_url": "https://www.gangwarfarevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23954655877478226"}}]}, "sche
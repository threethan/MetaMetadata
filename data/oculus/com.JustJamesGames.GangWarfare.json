*\n\nWhether you're blowing up rival stashes, stealing their supplies, or putting a bullet in their boss, every contract pushes you closer to the top. But when the smoke clears, you're free to do things your way. Jump into sandbox mode and cause chaos on your terms. Turn on cheats, spawn enemies, mess with physics, or build your own scenarios. This is your turf.\n\n\n# *| RAGDOLLS, PHYSICS & CHAOS!*\n\nWith large, detailed maps, physics-based gunplay, ragdoll enemies, and lots of weapons to try, you will be kept busy for hours of fun.\n\n# *| AND YES, IT'S FREE!*\nSo break in, cash out and get paid.", "short_description": "Step into the gritty underworld of gang conflicts, where chaos and action are around every corner. Take on ruthless gangs as you fight to expand your own operation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gangwarfarevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Just James Games", "support_website_url": "https://gangwarfarevr.com/contact", "website_url": "https://www.gangwarfarevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23954655877478226"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "1465173561842918"}, {"status": "PUBLISHED", "id": "737566022559659"}]}, "baseline_offer":
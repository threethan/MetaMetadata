sea5-1.oculuscdn.com/v/t64.5771-25/473393516_1057838972850816_3552852806084483132_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4j4XakrzdcQQ7kNvwGco7UT&_nc_oc=AdrbZIU4ZjCcibaXh4Cq1bGzLhmHlLmvtiCCfb2j49JCDpwyCOtrUBjFT3F8slEBIUs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiobqHz8h_-oAnysPWU1p7OjvmUnCIev12l2F2AifP4A&oe=6A901AAA"}, {"file_name": "SS3.png", "id": "1034375961930599", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391952_1034375965263932_7134276279578367230_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZfadKgOEg4Q7kNvwEY3seg&_nc_oc=Adrdn2hNrP4jbR8yY2Y8IUcxShgnX9GDzaLgU0Nkc28ofKSJfMltEtmt9RYzP_fGUrA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSu1nxVRZwvy4YzwBfI1U48pLN40XHMxBaUriK-1n-xA&oe=6A901B05"}, {"file_name": "SS4.png", "id": "641909355389366", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473401067_641909358722699_5446915222927348372_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7X2trun7Zj8Q7kNvwEp_PQm&_nc_oc=AdrJcxyaTWfq4fD9C-lZgvXEloOX6D3h22m8Zo7GIMJlWAiNzAFK8Fe2Qcg-W6V4GyM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2krntL9-rN0vDLtYvp-p9nxuh2jsgM0f6Kp8bT5gMNA&oe=6A90257E"}, {"file_name": "SS5.png", "id": "1471024697641407", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391888_1471024700974740_7813733804114978825_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-n144EZa-EQ7kNvwHWjdF-&_nc_oc=Adq9p_uTcXaJPTjjxuPlTXd-jqNOmwFXco1xpx_-AoImQIkZapmwBOUfWbyZmEoxJJc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnW_ixqxzB5qBGl3IAFMgTzcaTbL41WnnibKkU6jQk8Q&oe=6A902747"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gang Warfare", "keywords": ["sandbox", "shooter", "action"], "long_description": "# *| START AS A NOBODY*\n\nAfter a failed raid, you and your cop partner are ambushed. Left for dead, you are recruited into a special unit that is designed to take down the gangs that run the corrupt city. You must make a choice to uphold the law, or carve out your own name in the criminal underworld.\n\n# *| PERFECT BLEND OF STORY AND SANDBOX*\n\nWhether you're blowing up rival stashes, stealing their supplies, or putting a bullet in their boss, every contract pushes you closer to the top. But when the smoke clears, you're free to do things your way. Jump into sandbox mode and cause chaos on your terms. Turn on cheats, spawn enemies, mess with physics, or build your own scenarios. This is your turf.\n\n\n# *| RAGDOLLS, PHYSICS & CHAOS!*\n\nWith large, detailed maps, physics-based gunplay, ragdoll enemies, and lots of weapons to try, you will be kept busy for hours of fun.\n\n# *| AND YES, IT'S FREE!*\nSo break in, cash out and get paid.", "short_description": "Step into the gritty underworld of gang conflicts, where chaos and action are around every corner. Take on ruthless gangs as you fight to expand your own operation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gangwarfarevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Just James Games", "support_website_url": "https://gangwarfarevr.com/contact", "website_url": "https://www.gangwarfarevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23954655877478226"}}]}, "sche
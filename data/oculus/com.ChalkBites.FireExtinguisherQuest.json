dn.com&_nc_ss=8&oh=00_AfwoRorrAVsUVyEM-BXD9uhIjZ_UQIvlrrdzoVOdAWqEEw&oe=69BBD91D"}, {"file_name": "Screenshot5_Labeled.png", "id": "252710566573797", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75196219_252710569907130_3268057808010455768_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SswaYEOnJ3sQ7kNvwG35CZj&_nc_oc=AdlUG3a2OkbV2aHOMS5XBFhqDpV5pnZXNF9Yc9sDXVuOL9-ZDcYYP_Y6jGzOklUsha4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwvxY8z3iaizKAjjjowL5Td7ukrDH7TzeSQPv4jT1fOyA&oe=69BC04E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fire Extinguisher Simulator", "keywords": [], "long_description": "Learn how to use a fire extinguisher in VR. Practice extinguishing fires in a realistic environment. Learn about various types of fires and which extinguishers to use in any given situation.\n\nInside The Fire Extinguisher Simulator you will train on the following concepts:\n\u2022 Fire Event Evaluation\n\u2022 The Fire Safety Triangle\n\u2022 Types of Fire Extinguishers\n\u2022 Classes of Fires\n\u2022 Fire Extinguisher Technique and Best Practices\n", "short_description": "Everything you need to pass a fire extinguisher certification, all in one place. Learn how to properly use a fire extinguisher in a variety of situations!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chalkbites.com/index.php/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ChalkBites, Inc.", "support_website_url": null, "website_url": "https://www.chalkbites.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "r
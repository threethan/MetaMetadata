ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KH1snwSL7j4Q7kNvwH2kUyk&_nc_oc=Adoo73ba3wfYpU4-Hhpzar-MF1zStzZO338nUqkoOHO8CsxX_DxbZO78n4Q7fCvmc-M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjqKEoaRXDd0LBDHY8YB20qpEA-ToA9ZwzoB_MZSEp4Q&oe=6AF0A845"}, {"file_name": "04_Screenshot_2026-10-11_081156_2560x1440.png", "id": "1683222376727072", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824292_1683222380060405_1327646999265277719_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yvcpPdbOfwQ7kNvwH1uU7x&_nc_oc=AdqahTNnhKvrv23lptqpblaMof5FimKV5YeXe1gIz0Ed4XJ8RWqdf7ezMAkePuABuvY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZkPzds1RW4LIQ25nHeRx_PdjDlpj6VLsB3QFLlyzqSg&oe=6AF0AECE"}, {"file_name": "screenshot2_2560x1440.png", "id": "1786269482649039", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823351_1786269485982372_861174736206535925_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHyQfnkYrboQ7kNvwHEYHiW&_nc_oc=Adr0JIs_z5VvNJmq64qPzmBXQUrr8waNiZxLYCJOXSJrLFfZOkRG_SkU4j8CiIuCpO4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaUoCllF4lxykzlytR42cNmpNLsCRzKoRvrPM7i_ykyQ&oe=6AF09E74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SurgiVerse_Cover_2560x1440_24bit.png", "id": "2633149310452757", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825503_2633149313786090_7236499602015332055_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WadNugABsI0Q7kNvwGDizKn&_nc_oc=AdrrClNnp-e6oW5-PsMSNvb5sIH1Silbcy_PrviFZc0jMluBQL8Pb0WPwh2LchE1I0o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWKfwsI4nRo77Sl4LghWCJPAeqByK2BfUfpU1NgRdf7Q&oe=6AF0A8B0"}, "display_name": "SurgiVerse", "keywords": [], "long_description": "**SurgiVerse** is an immersive virtual reality (VR) surgical training platform replacing scarce cadaveric practice with safe, measurable simulations for medical schools and hospitals.\n\n## \ud83d\udc42 Pilot Focus: Otolaryngology\n* **3D Reconstruction:** Converts patient CT and endoscopic data into high-fidelity ear models.\n* **Procedures:** Simulates **grommet insertion**, **tympanoplasty**, and **cholesteatoma removal**.\n\n## \ud83d\udee0\ufe0f Core Technology\n* **SurgMotion Kinematics:** Tracks hand trajectory, velocity, and economy of motion against expert benchmarks.\n* **Cloud & Scalable Architecture:** Enables remote supervision and expansion from ENT to respiratory, digestive, nervous, and musculoskeletal systems.\n\n## \ud83d\ude80 Upcoming Releases\n* **Haptic Gloves:** Force-feedback hardware for real tissue resistance and tool weight.\n* **SurgiVideoRAG AI:** Video understanding and RAG for automated performance review and Q&A.\n\n## \ud83d\udccc Summary\nSurgiVerse converts clinical scans into validated VR training modules. It currently scores skills via SurgMotion, with haptic gloves and SurgiVideoRAG advancing toward a multi-specialty ecosystem.\n", "short_description": "SurgiVerse is an immersive virtual reality (VR) surgical training platform replacing scarce cadaveric practice with safe, measurable simulations for medical schools and hospitals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://surgiverse-web.vercel.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "CopticTech", "support_website_url": null, "website_url": "https://surgiverse-web.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], 
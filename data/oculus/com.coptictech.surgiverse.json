20f&oh=00_AQRnG9eQQ6Np8j6X_3wPvvUpvbllJaP37kFlR44J-_09OQ&oe=6AFDB4C9"}, {"file_name": "02_Screenshot_2026-10-11_075928_2560x1440.png", "id": "1389781442909814", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_1389781446243147_5428107693995610253_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjpafwFfL-gQ7kNvwHnfw7a&_nc_oc=AdottafXXBBRrN4jO6LQ_Ui5kk0_nqlHx0UAjxuVyE0XCWKvI1ixmNtFUZHqrCeXCOc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvwz-VS-VQfitKj6iTxS-P9AdScb9Wz-RaNc-NIWxNTA&oe=6AFDD745"}, {"file_name": "04_Screenshot_2026-10-11_081156_2560x1440.png", "id": "1683222376727072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824292_1683222380060405_1327646999265277719_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTpx9sG5sa0Q7kNvwH5nLaw&_nc_oc=Adrpo3W3LqsiYQmmabwCmZ7_R7Yc-AHHEqWU9u63V7s30n7eOA--9mZedxQaZmxQiGw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpd8jibiOZZD-ugsVm0COBjtx7BOgJlmYZxkzLMoW4jA&oe=6AFDDDCE"}, {"file_name": "screenshot2_2560x1440.png", "id": "1786269482649039", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823351_1786269485982372_861174736206535925_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5oook7BmlMQ7kNvwG3SvUX&_nc_oc=AdqG1CaSjzVgNysff-hdStzZUKE3aGgTHEbbawqWsOdyUySMlB3UTUvWWi1yvDUnKb8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgh-qD9Ay-2klRBIt9WEWyGoX8EGqplX0uraROdYRt9w&oe=6AFDCD74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SurgiVerse_Cover_2560x1440_24bit.png", "id": "2633149310452757", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825503_2633149313786090_7236499602015332055_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnVBbt_voqUQ7kNvwFebdv-&_nc_oc=AdrpASQ34k7TtEcq6NZ1v6R1zZgGuu9HKg9SVmzNJE5wlyeGy5irZRDbDrii3-rGZzQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPDNTEV1WZuUQI3Aw5mxA39VqKDXr2oYNSjhKsTyHIfg&oe=6AFDD7B0"}, "display_name": "SurgiVerse", "keywords": [], "long_description": "**SurgiVerse** is an immersive virtual reality (VR) surgical training platform replacing scarce cadaveric practice with safe, measurable simulations for medical schools and hospitals.\n\n## \ud83d\udc42 Pilot Focus: Otolaryngology\n* **3D Reconstruction:** Converts patient CT and endoscopic data into high-fidelity ear models.\n* **Procedures:** Simulates **grommet insertion**, **tympanoplasty**, and **cholesteatoma removal**.\n\n## \ud83d\udee0\ufe0f Core Technology\n* **SurgMotion Kinematics:** Tracks hand trajectory, velocity, and economy of motion against expert benchmarks.\n* **Cloud & Scalable Architecture:** Enables remote supervision and expansion from ENT to respiratory, digestive, nervous, and musculoskeletal systems.\n\n## \ud83d\ude80 Upcoming Releases\n* **Haptic Gloves:** Force-feedback hardware for real tissue resistance and tool weight.\n* **SurgiVideoRAG AI:** Video understanding and RAG for automated performance review and Q&A.\n\n## \ud83d\udccc Summary\nSurgiVerse converts clinical scans into validated VR training modules. It currently scores skills via SurgMotion, with haptic gloves and SurgiVideoRAG advancing toward a multi-specialty ecosystem.\n", "short_description": "SurgiVerse is an immersive virtual reality (VR) surgical training platform replacing scarce cadaveric practice with safe, measurable simulations for medical schools and hospitals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://surgiverse-web.vercel.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "CopticTech", "support_website_url": null, "website_url": "https://surgiverse-web.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], 
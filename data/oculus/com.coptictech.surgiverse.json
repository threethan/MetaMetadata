20f&oh=00_AQT4V8De7wL4UaluGH628UFC1Xwow3t8Dh9IaMn3LuUl_A&oe=6B05D609"}, {"file_name": "02_Screenshot_2026-10-11_075928_2560x1440.png", "id": "1389781442909814", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824307_1389781446243147_5428107693995610253_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=byKJd4i4hNwQ7kNvwGji2SZ&_nc_oc=AdpQqjow4_LT5Bfnq_1NSpyEutFdVS7EBqPL2cA146QQpIQDFgFqeJLKb1YkiRSiXqE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0RNxYf7ziIM9lOFlsQ0_Z_p8RNFUhBqCr9Cle51HY8A&oe=6B05C045"}, {"file_name": "04_Screenshot_2026-10-11_081156_2560x1440.png", "id": "1683222376727072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824292_1683222380060405_1327646999265277719_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvuGeo3hyZQQ7kNvwHl4xnr&_nc_oc=Adp6dlBRxjI1J9Gv1SI3HPAlAvfGAKU6u1l8hUwBLxcmdAxq3mh37DuocL3QaKeCJFU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNYaAUHwJWwKe-YcHKJQ_kQFY6zORpkYgF0ouhOi5LuA&oe=6B05C6CE"}, {"file_name": "screenshot2_2560x1440.png", "id": "1786269482649039", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823351_1786269485982372_861174736206535925_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZajXVrIh_UQ7kNvwH6clPk&_nc_oc=Adr1X0UVbVPgPIQjn62MKpAQInHNdWjjv6iPAj14b7WKAMxRgofsqZUJ0EW9FVHk2Qg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRCKE0Cy2QrPZFzFMXOAOebhQULHk2XIX_Z3WcEKGPBg&oe=6B05B674"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SurgiVerse_Cover_2560x1440_24bit.png", "id": "2633149310452757", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825503_2633149313786090_7236499602015332055_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4C1zP8eyLw0Q7kNvwGOxHWo&_nc_oc=AdrMqkVdvjAo5W-Wjc4qVvc_ChRBBbs62R3keqXcbh1OZHXMunriV49KJiAT8iqREAk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3w4jKjarMESDE4dprnXcsjmajBXTLXD0WGfJ6gRd2Ww&oe=6B05C0B0"}, "display_name": "SurgiVerse", "keywords": [], "long_description": "**SurgiVerse** is an immersive virtual reality (VR) surgical training platform replacing scarce cadaveric practice with safe, measurable simulations for medical schools and hospitals.\n\n## \ud83d\udc42 Pilot Focus: Otolaryngology\n* **3D Reconstruction:** Converts patient CT and endoscopic data into high-fidelity ear models.\n* **Procedures:** Simulates **grommet insertion**, **tympanoplasty**, and **cholesteatoma removal**.\n\n## \ud83d\udee0\ufe0f Core Technology\n* **SurgMotion Kinematics:** Tracks hand trajectory, velocity, and economy of motion against expert benchmarks.\n* **Cloud & Scalable Architecture:** Enables remote supervision and expansion from ENT to respiratory, digestive, nervous, and musculoskeletal systems.\n\n## \ud83d\ude80 Upcoming Releases\n* **Haptic Gloves:** Force-feedback hardware for real tissue resistance and tool weight.\n* **SurgiVideoRAG AI:** Video understanding and RAG for automated performance review and Q&A.\n\n## \ud83d\udccc Summary\nSurgiVerse converts clinical scans into validated VR training modules. It currently scores skills via SurgMotion, with haptic gloves and SurgiVideoRAG advancing toward a multi-specialty ecosystem.\n", "short_description": "SurgiVerse is an immersive virtual reality (VR) surgical training platform replacing scarce cadaveric practice with safe, measurable simulations for medical schools and hospitals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://surgiverse-web.vercel.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "CopticTech", "support_website_url": null, "website_url": "https://surgiverse-web.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], 
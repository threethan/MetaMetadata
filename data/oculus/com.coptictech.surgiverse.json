20f&oh=00_AQQQskErjKS1oQ_cbMkrAjKAw0QtsqGfPtg-1-qM_TjT_g&oe=6AFC6349"}, {"file_name": "02_Screenshot_2026-10-11_075928_2560x1440.png", "id": "1389781442909814", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491824307_1389781446243147_5428107693995610253_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjpafwFfL-gQ7kNvwHg6PnB&_nc_oc=AdqRuRgnxGa_xb6e2VZGz02W1aHlYzvNjr8_rOIrzNpV7Z6qSd4hVLSLhvQgWK99CRc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8h4L8pvK9Cmg_2Iu-kVcAxi0HiiOV5nx1M-vZBtU4aQ&oe=6AFC85C5"}, {"file_name": "04_Screenshot_2026-10-11_081156_2560x1440.png", "id": "1683222376727072", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824292_1683222380060405_1327646999265277719_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTpx9sG5sa0Q7kNvwFqImWd&_nc_oc=AdpA6Oz3QW_daFpk1IVNsv2LHKahuM2rFgv3QBRPx0ikJQDp4olNugPOW2TBmRrhatk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7SC_KB0kiuq9NI7DNFS1DxPhaXJb58BV8b4BiC5T3_A&oe=6AFC8C4E"}, {"file_name": "screenshot2_2560x1440.png", "id": "1786269482649039", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823351_1786269485982372_861174736206535925_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5oook7BmlMQ7kNvwFt9g7N&_nc_oc=AdogPjXDX49pb2zPwEohN9QAYhJUtmkY2MyTK3VurTvVA529b45ihKrUjCp0ZXHTLUc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUtzr2h_sVWaIsCyi0CfkG4-YhnNigm70oAx8KljOYHw&oe=6AFC7BF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SurgiVerse_Cover_2560x1440_24bit.png", "id": "2633149310452757", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825503_2633149313786090_7236499602015332055_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnVBbt_voqUQ7kNvwHyzY41&_nc_oc=AdqaNNTyqhphRIzrqzX4E4BwDWfOS1c9c8rNbe5XF_PfIp-7vdYqSYmgUNVNKJbmT4o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT19SV9UaP2adanM-nCS9LFsuzaOX_u92g2HLj4xfBSag&oe=6AFC8630"}, "display_name": "SurgiVerse", "keywords": [], "long_description": "**SurgiVerse** is an immersive virtual reality (VR) surgical training platform replacing scarce cadaveric practice with safe, measurable simulations for medical schools and hospitals.\n\n## \ud83d\udc42 Pilot Focus: Otolaryngology\n* **3D Reconstruction:** Converts patient CT and endoscopic data into high-fidelity ear models.\n* **Procedures:** Simulates **grommet insertion**, **tympanoplasty**, and **cholesteatoma removal**.\n\n## \ud83d\udee0\ufe0f Core Technology\n* **SurgMotion Kinematics:** Tracks hand trajectory, velocity, and economy of motion against expert benchmarks.\n* **Cloud & Scalable Architecture:** Enables remote supervision and expansion from ENT to respiratory, digestive, nervous, and musculoskeletal systems.\n\n## \ud83d\ude80 Upcoming Releases\n* **Haptic Gloves:** Force-feedback hardware for real tissue resistance and tool weight.\n* **SurgiVideoRAG AI:** Video understanding and RAG for automated performance review and Q&A.\n\n## \ud83d\udccc Summary\nSurgiVerse converts clinical scans into validated VR training modules. It currently scores skills via SurgMotion, with haptic gloves and SurgiVideoRAG advancing toward a multi-specialty ecosystem.\n", "short_description": "SurgiVerse is an immersive virtual reality (VR) surgical training platform replacing scarce cadaveric practice with safe, measurable simulations for medical schools and hospitals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://surgiverse-web.vercel.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "CopticTech", "support_website_url": null, "website_url": "https://surgiverse-web.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], 
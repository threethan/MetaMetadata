30f&oh=00_AQQ5xNbu-daCwhVvK2vPmqeWHRh2Q-vCpm3a65GvykkZag&oe=6B0B1C09"}, {"file_name": "02_Screenshot_2026-10-11_075928_2560x1440.png", "id": "1389781442909814", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824307_1389781446243147_5428107693995610253_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLOcfUd87kYQ7kNvwHHEUjm&_nc_oc=Adrn2-YnWYwYf0t3awj_Rogvm4WHRq90QpXHOnn4F8JDAcJw3xmETjXVtoVSyLKO1jE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQLOlU-Isdzsva35sH8QgzpZukOVmuwx5L8MMA3BdlFoQ&oe=6B0B3E85"}, {"file_name": "04_Screenshot_2026-10-11_081156_2560x1440.png", "id": "1683222376727072", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824292_1683222380060405_1327646999265277719_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NH7FIQVQdXIQ7kNvwE3IaIc&_nc_oc=Ado6pNz9MzzxsRTagvJZ7DIxnoBZ2tD7-Tz8w8SLqGOCytShPFXwDR_Ca_NDecS3__k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSVSS_gzT-KLeRaf-eUmlOZzyj9Kstc3H4tS8Lc8A6SEw&oe=6B0B450E"}, {"file_name": "screenshot2_2560x1440.png", "id": "1786269482649039", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823351_1786269485982372_861174736206535925_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZurGQTX31MQ7kNvwGGQma8&_nc_oc=Adq6osIFUVf2XFv0kXxiuEoLXRp8YkX3AFiQogVAtEikdXF7Em7XO_zEV7KVlGxUKNw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTcg6XjaIAczQ_ncftH03q9fEGWYLAV_wU2-jkOMTKcrA&oe=6B0B34B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SurgiVerse_Cover_2560x1440_24bit.png", "id": "2633149310452757", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825503_2633149313786090_7236499602015332055_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKJSuetcDFwQ7kNvwEVBt5m&_nc_oc=Adqb1dQMdWffDfbIT9uBqE_pD4duUBS8eFBHgkuaAsT7XcojJDwDXotyBcxyngYoiA8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQIaSwhrpytPP4OFvnkhTOpD_IR-tad05NPqoKNWLAq-A&oe=6B0B3EF0"}, "display_name": "SurgiVerse", "keywords": [], "long_description": "**SurgiVerse** is an immersive virtual reality (VR) surgical training platform replacing scarce cadaveric practice with safe, measurable simulations for medical schools and hospitals.\n\n## \ud83d\udc42 Pilot Focus: Otolaryngology\n* **3D Reconstruction:** Converts patient CT and endoscopic data into high-fidelity ear models.\n* **Procedures:** Simulates **grommet insertion**, **tympanoplasty**, and **cholesteatoma removal**.\n\n## \ud83d\udee0\ufe0f Core Technology\n* **SurgMotion Kinematics:** Tracks hand trajectory, velocity, and economy of motion against expert benchmarks.\n* **Cloud & Scalable Architecture:** Enables remote supervision and expansion from ENT to respiratory, digestive, nervous, and musculoskeletal systems.\n\n## \ud83d\ude80 Upcoming Releases\n* **Haptic Gloves:** Force-feedback hardware for real tissue resistance and tool weight.\n* **SurgiVideoRAG AI:** Video understanding and RAG for automated performance review and Q&A.\n\n## \ud83d\udccc Summary\nSurgiVerse converts clinical scans into validated VR training modules. It currently scores skills via SurgMotion, with haptic gloves and SurgiVideoRAG advancing toward a multi-specialty ecosystem.\n", "short_description": "SurgiVerse is an immersive virtual reality (VR) surgical training platform replacing scarce cadaveric practice with safe, measurable simulations for medical schools and hospitals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://surgiverse-web.vercel.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "CopticTech", "support_website_url": null, "website_url": "https://surgiverse-web.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], 
WGCZ8Ze8VYaJ1UNZkZ_dCGqWR5SdL4et1_4K7vEgqTutIs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tEA_MrL9GlOm4YsShMRQSDrgzCPK92q1JU9U6qPEYeQ&oe=69FC8807"}, {"file_name": "VORTEX-screenshot2.png", "id": "889224779199395", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031434_889224782532728_7662599539557352379_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BQ5PVKB6ssQ7kNvwGVbQlf&_nc_oc=AdrB8207WxhP-_S3XWJ7PQdNgy5t-NrqlRxA3GBHfFaGUNHxvnBJEcOFPvCoGhr7iJ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fRVjR05uOLcLiQuVLAJ5phcQGdF3CxilSQoID1AWhUg&oe=69FC9239"}, {"file_name": "VORTEX-screenshot4.png", "id": "1493083344521384", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974762_1493083347854717_4948946191006403245_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85NJPODQWkcQ7kNvwEXgTk2&_nc_oc=Adon05HIt62q1I8ehThwQ0ZqecB0mz8MrqjviqzduBUkbk4xAD32J8Vw2in2jbfA6k4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AlzM4l1QeXFsXzTYXZa29V2YgDl2Q2A980N_mzX5ABA&oe=69FC94EB"}, {"file_name": "VORTEX-screenshot5.png", "id": "671958287895662", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974804_671958291228995_7711441172544796156_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21lUS-4CvX8Q7kNvwFyeQ7J&_nc_oc=AdrmPX4o3cWVndH6_ouICOSh9P6U3KLD-T1hH1RSqTCfy0CafkhnbrD28j1j1D-w0Ck&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kTvVRzwgr6gZWVfH4_m4YPfpzYGQDXcP2E1D6QyERxA&oe=69FCA0D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VORTEX-VR-fond-couverture.png", "id": "908563683424315", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036621_908563686757648_5766878142044206530_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ViIQuWuXO1IQ7kNvwFRBPiB&_nc_oc=AdpEudkqFkjF_C9_s43VOYIsLm6KDgWkf9bbAEoCPz4noDGd7zYswg8V6uvxy3lpVyE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5f806ObWofpS_GHPpkcyDMbcNcy8vcvDbbfwjfD7yLzA&oe=69FC98B5"}, "display_name": "Vortex VR", "keywords": [], "long_description": "Vortex VR is an immersive investigation and an narrative experience : You explore the universe of the VORTEX series. Help the commissioner (played by Tomer Sisley) to solve the crime !\n\n As a Detective, you can inspect the crime scene: hurry up! You'll only have 20 minutes to collect all the clues and solve the crime before the tide covers the evidence.\n\nFeatures: \n- Controlling time\n - Exploring and manipulating clues \n- Interactive narration \n- Actor Tomer Sisley in motion capture \n\nOnly available in French", "short_description": "An immersive investigation in the world of the TV show \"VORTEX\" : you have 20min to solve the crime ! \n\nA Narrative driven game \nONLY IN FRENCH - TEXT AND SPEECH "}, {"images": {"nodes": []}, "id": "341414961763755", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vortex VR", "keywords": [], "long_description": "Vortex VR est une enqu\u00eate immersive o\u00f9 vous explorez l\u2019univers de la s\u00e9rie VORTEX. \u2028\u2028\n\nDans la peau d\u2019un detective vous pourrez inspecter la sc\u00e8ne de crime : d\u00e9p\u00eachez-vous ! \n\nVous n\u2019aurez que 20 minutes pour r\u00e9cup\u00e9rer tous les indices et \u00e9lucider le crime avant que la mar\u00e9e ne recouvre les preuves. \u2028\u2028\n\nFeatures : \n\u2028-Contr\u00f4ler le temps\u2028\n- Explorer et manipuler les indices\u2028\n- Narration interactive \n\u2028- Acteur Tomer Sisley en motion capture\u2028\u2028\n\nUniquement disponible en version fran\u00e7aise", "short_description": "Une exp\u00e9rience interactive o\u00f9 vous m\u00e8nerez l'enqu\u00eate au coeur de l'univers de la nouvelle s\u00e9rie VORTEX de France TV.\n\nAu c\u00f4t\u00e9 de Tomer Sisley, r\u00e9solvez l'enqu\u00eate en VR !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1b9IRlq_orZv8Zabq4NZ8y7uqO
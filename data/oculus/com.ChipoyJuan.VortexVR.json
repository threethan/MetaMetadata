43rTqJ2i9ARsCsDz7-U90o4-18_qAEyApVj_Rkr5_SOtD4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAE_ylN3Fg12OBKtdARKg0JbyNL0-XkYjS6-ZAaCPQew&oe=6AB7BD07"}, {"file_name": "VORTEX-screenshot2.png", "id": "889224779199395", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031434_889224782532728_7662599539557352379_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iA6_GCM1I8sQ7kNvwE6pE4A&_nc_oc=AdoWmtaaBGF-LWnvtOAJCshitKhwqyCJvvegVfEodb5T9f3CAztsxZTFfxIuKlmSAF0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGzY_RUjmw0feFN7FYtrelT90bF2RZYM6LSZLQ-TXg8A&oe=6AB7C739"}, {"file_name": "VORTEX-screenshot4.png", "id": "1493083344521384", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974762_1493083347854717_4948946191006403245_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvHD6yHtu4cQ7kNvwE0amD1&_nc_oc=AdpE1yRJOYX9xdwIiO-l6ORu8ue4vVOhfSLACkWTjDNlZxMjjC4isGtFZjmQRMNavPY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYEXRAO9_maUWrfoequVJ8n7M3M7OSvbYnCyGl2epjVA&oe=6AB7C9EB"}, {"file_name": "VORTEX-screenshot5.png", "id": "671958287895662", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974804_671958291228995_7711441172544796156_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzt2i9q_qaYQ7kNvwETQaJ8&_nc_oc=AdodoQziHtqiO3qSGAoFo0VLfrhL6MVvnzIEn9TzJm0mSo85_3pmo9Mgs1vcnD0EMrA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeSC7rFGJKIJ2MWAVEyR70ecYCpxdMH41MWFVdUaXXKw&oe=6AB7D5D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VORTEX-VR-fond-couverture.png", "id": "908563683424315", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036621_908563686757648_5766878142044206530_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AKn8LJngw0Q7kNvwF6Ylgx&_nc_oc=AdrBX_RZKPrOtgxzR6QstPpfYLyaUrKt_bgk8qhgXWhmGcyh2tXhQqNU_UryTXeja6o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4b4iVTGLUqMNMTPZDe7_aAQPuV005AYX5w6iN2w5UYA&oe=6AB7CDB5"}, "display_name": "Vortex VR", "keywords": [], "long_description": "Vortex VR is an immersive investigation and an narrative experience : You explore the universe of the VORTEX series. Help the commissioner (played by Tomer Sisley) to solve the crime !\n\n As a Detective, you can inspect the crime scene: hurry up! You'll only have 20 minutes to collect all the clues and solve the crime before the tide covers the evidence.\n\nFeatures: \n- Controlling time\n - Exploring and manipulating clues \n- Interactive narration \n- Actor Tomer Sisley in motion capture \n\nOnly available in French", "short_description": "An immersive investigation in the world of the TV show \"VORTEX\" : you have 20min to solve the crime ! \n\nA Narrative driven game \nONLY IN FRENCH - TEXT AND SPEECH "}, {"images": {"nodes": []}, "id": "341414961763755", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vortex VR", "keywords": [], "long_description": "Vortex VR est une enqu\u00eate immersive o\u00f9 vous explorez l\u2019univers de la s\u00e9rie VORTEX. \u2028\u2028\n\nDans la peau d\u2019un detective vous pourrez inspecter la sc\u00e8ne de crime : d\u00e9p\u00eachez-vous ! \n\nVous n\u2019aurez que 20 minutes pour r\u00e9cup\u00e9rer tous les indices et \u00e9lucider le crime avant que la mar\u00e9e ne recouvre les preuves. \u2028\u2028\n\nFeatures : \n\u2028-Contr\u00f4ler le temps\u2028\n- Explorer et manipuler les indices\u2028\n- Narration interactive \n\u2028- Acteur Tomer Sisley en motion capture\u2028\u2028\n\nUniquement disponible en version fran\u00e7aise", "short_description": "Une exp\u00e9rience interactive o\u00f9 vous m\u00e8nerez l'enqu\u00eate au coeur de l'univers de la nouvelle s\u00e9rie VORTEX de France TV.\n\nAu c\u00f4t\u00e9 de Tomer Sisley, r\u00e9solvez l'enqu\u00eate en VR !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1b9IRlq_orZv8Zabq4NZ8y7uqO
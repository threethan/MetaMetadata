nL5uTisotO2URtxjp0xJEexUMBCHjJpU_Jel1mU40mYXQQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbt-DMeuLPSXabEsgYxMwa7C1n6K82DQlJwy4qrLXhSQ&oe=6A81AF87"}, {"file_name": "VORTEX-screenshot2.png", "id": "889224779199395", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031434_889224782532728_7662599539557352379_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Py3Z9I-eLo8Q7kNvwFlVeQV&_nc_oc=AdrnqXw8cR9rjKt4RgSLM57fEJO5G0uXZMOyKIaM7zmyQU5ZRMkp8m3OUqqP-Rkunf4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6B6HnkwoWRFc51m9Ik9wzvVa3y6S8m15V0o3BPKTqlQ&oe=6A81B9B9"}, {"file_name": "VORTEX-screenshot4.png", "id": "1493083344521384", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974762_1493083347854717_4948946191006403245_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ls_mv1AbWGsQ7kNvwEdBIRb&_nc_oc=AdoCOfV-P8XBMIW8KuY9G0l7Q4vdSjIzwJWx1s_NhTVrtZ-i_bslfXGmerOmP54G6IM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhIFR4w71Y6sLrMfBS1XHYmLQfc6Ucf74MOheNlVUkXw&oe=6A81BC6B"}, {"file_name": "VORTEX-screenshot5.png", "id": "671958287895662", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974804_671958291228995_7711441172544796156_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gH9F3_xLXksQ7kNvwGYi4dB&_nc_oc=AdrYA6rAahTur67iG7NMIMPAqLhUszCcWjRjs0Q-ZvaA8dbAZ5kWpakHNkjMOqkdp_Y&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFB91PbkvgLaIQ74WSGXLgd6MdPPh7CqkEjZWqiEAE7tQ&oe=6A819018"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VORTEX-VR-fond-couverture.png", "id": "908563683424315", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39036621_908563686757648_5766878142044206530_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaUJotXiRLoQ7kNvwFnQnmB&_nc_oc=AdoO3p8OghWY0xbrg7E11Ahk_zsRGHe-NXFG5LbR6gor3f_RR-TYNhJf4pRCNJ9w_zo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEr3Pl4EIPQq-qkAUCeS_qa89O2_426Sp7C1fJQ7Dmvw&oe=6A81C035"}, "display_name": "Vortex VR", "keywords": [], "long_description": "Vortex VR is an immersive investigation and an narrative experience : You explore the universe of the VORTEX series. Help the commissioner (played by Tomer Sisley) to solve the crime !\n\n As a Detective, you can inspect the crime scene: hurry up! You'll only have 20 minutes to collect all the clues and solve the crime before the tide covers the evidence.\n\nFeatures: \n- Controlling time\n - Exploring and manipulating clues \n- Interactive narration \n- Actor Tomer Sisley in motion capture \n\nOnly available in French", "short_description": "An immersive investigation in the world of the TV show \"VORTEX\" : you have 20min to solve the crime ! \n\nA Narrative driven game \nONLY IN FRENCH - TEXT AND SPEECH "}, {"images": {"nodes": []}, "id": "341414961763755", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vortex VR", "keywords": [], "long_description": "Vortex VR est une enqu\u00eate immersive o\u00f9 vous explorez l\u2019univers de la s\u00e9rie VORTEX. \u2028\u2028\n\nDans la peau d\u2019un detective vous pourrez inspecter la sc\u00e8ne de crime : d\u00e9p\u00eachez-vous ! \n\nVous n\u2019aurez que 20 minutes pour r\u00e9cup\u00e9rer tous les indices et \u00e9lucider le crime avant que la mar\u00e9e ne recouvre les preuves. \u2028\u2028\n\nFeatures : \n\u2028-Contr\u00f4ler le temps\u2028\n- Explorer et manipuler les indices\u2028\n- Narration interactive \n\u2028- Acteur Tomer Sisley en motion capture\u2028\u2028\n\nUniquement disponible en version fran\u00e7aise", "short_description": "Une exp\u00e9rience interactive o\u00f9 vous m\u00e8nerez l'enqu\u00eate au coeur de l'univers de la nouvelle s\u00e9rie VORTEX de France TV.\n\nAu c\u00f4t\u00e9 de Tomer Sisley, r\u00e9solvez l'enqu\u00eate en VR !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1b9IRlq_orZv8Zabq4NZ8y7uqO
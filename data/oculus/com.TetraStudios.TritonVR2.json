c=PCxoMyWyMpoQ7kNvwGFMMaS&_nc_oc=Adp8qaak1FSeNRLsw69aTdy4Wl8t8eYySCjQfPbbtv0s217FyyA9MYM-h7KclVUTAa4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1QcKlW7rvoYQZAej4Y1K90-qgMQi0UdkjHQx2Nt_chw&oe=6AFF07A3"}, {"file_name": "TestSurvivalScreenshot.png", "id": "8661934777151185", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566682_8661934780484518_8908019271902800624_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25HkUKkFGsQQ7kNvwE81-8W&_nc_oc=Adr8PPGsh-VqHRnq-iz4bOnaOx839UDlPgsu5ubuRDHSiVqrJuIqPoojcE_UdUl1IvY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS26av22UY7Jz3_mq7Xho21pS_N-gp3X9-x-NVi-1Gpmw&oe=6AFF1442"}, {"file_name": "NewTritonXROculusScreenshot7.png", "id": "727400359980029", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491821849_727400363313362_5460358936201525979_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsf7LHrXzQsQ7kNvwHuyFiR&_nc_oc=AdqIdtFzsgXH1t2kOpR99bBWQQETzRyLsrfDOoJ8AXERjKePXKcLMFdjtXLvZm9D6X8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXb-S3T_8zhv6AoH3-NPlZZ-4t02RqykE_NMQ8C8r_CQ&oe=6AFF235E"}, {"file_name": "RLOculusScreenshot1.png", "id": "1872394096877709", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819407_1872394100211042_6637672513816013493_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olmK9RGM3xAQ7kNvwEwXFZe&_nc_oc=AdoJ4hAqJBQsKozEldazjR_1NwlkBEhtIJsgMorfeub3J68WKpnfWhStmsCcFYNULLE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdJelvhqSQl96gfk-9xP9kKPDnh7BCHhBlrZOslpxGoQ&oe=6AFF0B6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape2.png", "id": "873323944373880", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982699_873323947707213_5357903444929597662_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5Xo4gQ0H0QQ7kNvwEoDpzr&_nc_oc=Adot4Ar2xNZstT-2SCjUqfOegSIleUo8wpoNTNOUrc6wfvjxdnmqY_JxnrZZpuQIkTQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqsmai6TiMg9Wi6pN5BgmxT1wtQmjUKABDbDi3Z6AgpA&oe=6AFF28D3"}, "display_name": "TritonXR: Reality Warfare", "keywords": ["shooter", "triton", "xr", "fps", "colocation"], "long_description": "**Turn every inch of your living room into a live-fire arena in TritonXR!**\n\nTritonXR turns ANY space into a multiplayer mixed-reality battlefield in seconds - vault your coffee table to dodge a laser burst, lob a grenade down the hallway, or dive behind your bed to reload.\n\n# REALITY WARFARE\n{1249540903189800}\nFill every inch of your room with friends, frags and frantic call-outs, and battle in either full VR or our cutting-edge XR mode - this is the world's most advanced FPS.\n\n# FIGHT SOLO OR WITH FRIENDS\n{744093408042507}\nFend off aerial hunters and furniture-climbing spiders that learn your room layout in an exciting, frantic survival mode that will leave your heart racing.\n\n# BUILD AND BATTLE IN SECONDS\n{1007957931325487}\nOur drop-dead-simple XR map editor snaps walls, props and more straight onto your floor plan. Carve cover, raise vantage platforms, or spawn weapon caches with easy-to-use tools.\n\n**This is the world's most advanced FPS. Are you ready?**", "short_description": "TritonXR turns ANY space into a multiplayer mixed-reality battlefield in seconds - vault your coffee table to dodge a laser burst, lob a grenade down the hallway, or dive behind your bed to reload. \n\nThis is the world's most advanced XR game - are you ready?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tetrastudios.com.au/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Tetra Studios", "support_website_url": "https://www.tetrastudios.com.au/contact", "website_url": "https://www.tetrastudios.com.au/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_ca
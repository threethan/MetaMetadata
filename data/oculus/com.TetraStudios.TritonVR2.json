_name": "TestSurvivalScreenshot.png", "id": "8661934777151185", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566682_8661934780484518_8908019271902800624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mm8Ana_iBdMQ7kNvwHi8xKn&_nc_oc=AdqOZfcWIfm_8RXjya9u9_1hwfNr-ABpv5jGJ9HSsd048wtF1Itgaua_vVl9lrn6ibw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBBVqelVaSSb4OlEnLtTbZOD2Mg7fKNspaFFC2UUrF8g&oe=6AC11DC2"}, {"file_name": "NewTritonXROculusScreenshot7.png", "id": "727400359980029", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821849_727400363313362_5460358936201525979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vAGp0In-XoQ7kNvwGT5tt1&_nc_oc=Ado6ur9Ma40z3kYAw1v6pqxkSvfLcMS6UXWF9VngruAXfZfhFDbinDbw8qpeDij9ZaU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSw57AP8uk2HSrb_oVQnzgJ3QfNmnZmYFWfGWDLyhIng&oe=6AC12CDE"}, {"file_name": "RLOculusScreenshot1.png", "id": "1872394096877709", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819407_1872394100211042_6637672513816013493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obcExQOmp3sQ7kNvwFRyKqU&_nc_oc=AdreU0CPfHSJF_RnEDgSeCTXiqtJin07a7168zxkRFbfs3XPxqOO4yEb2vr-NvTKG_U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZ1XZafkBrCNicYiX03EkGvVW0TTOz_es31lbcPJNSbw&oe=6AC114ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape2.png", "id": "873323944373880", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_873323947707213_5357903444929597662_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LaFVl_el0w8Q7kNvwGTaXsT&_nc_oc=Adqo1apfzthlAhuTtmC_fwFEkln6ehL9FmNMVrmHftf4a9_bnoVQCs3TTjfm7JTaC_g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNs09tblhh9CMS710RrSQCKmA7O8RLqh2UhEJcPCoJ-rw&oe=6AC13253"}, "display_name": "TritonXR: Reality Warfare", "keywords": ["shooter", "triton", "xr", "fps", "colocation"], "long_description": "**Turn every inch of your living room into a live-fire arena in TritonXR!**\n\nTritonXR turns ANY space into a multiplayer mixed-reality battlefield in seconds - vault your coffee table to dodge a laser burst, lob a grenade down the hallway, or dive behind your bed to reload.\n\n# REALITY WARFARE\n{1249540903189800}\nFill every inch of your room with friends, frags and frantic call-outs, and battle in either full VR or our cutting-edge XR mode - this is the world's most advanced FPS.\n\n# FIGHT SOLO OR WITH FRIENDS\n{744093408042507}\nFend off aerial hunters and furniture-climbing spiders that learn your room layout in an exciting, frantic survival mode that will leave your heart racing.\n\n# BUILD AND BATTLE IN SECONDS\n{1007957931325487}\nOur drop-dead-simple XR map editor snaps walls, props and more straight onto your floor plan. Carve cover, raise vantage platforms, or spawn weapon caches with easy-to-use tools.\n\n**This is the world's most advanced FPS. Are you ready?**", "short_description": "TritonXR turns ANY space into a multiplayer mixed-reality battlefield in seconds - vault your coffee table to dodge a laser burst, lob a grenade down the hallway, or dive behind your bed to reload. \n\nThis is the world's most advanced XR game - are you ready?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tetrastudios.com.au/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Tetra Studios", "support_website_url": "https://www.tetrastudios.com.au/contact", "website_url": "https://www.tetrastudios.com.au/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
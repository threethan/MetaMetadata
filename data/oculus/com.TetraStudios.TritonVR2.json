c=ELxOVnJNtxMQ7kNvwGtdaeK&_nc_oc=Adq2yl2ZFqv-0AjYSB9HW0glQ35p2nURBO-j4qNOjd-eI51nIMUZ1P_RJQS-DjxOh00&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbsRWDRW7-Eai9k53dmfPi6HEMB6QAUHRCf9ycfmfeaQ&oe=6B01E2E3"}, {"file_name": "TestSurvivalScreenshot.png", "id": "8661934777151185", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566682_8661934780484518_8908019271902800624_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeoKnAu_tiIQ7kNvwFTPmRD&_nc_oc=Adoqqs_IIzxLIPIeEZfb12ovhuoFapQD5Bw2waoJ2nY3aRx1ruZInFpIWW2jr5Lwg14&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZMg1sbZ3JMYrDhYfeabLIsYhnqgAJAolqN_NhVuUX7g&oe=6B01EF82"}, {"file_name": "NewTritonXROculusScreenshot7.png", "id": "727400359980029", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821849_727400363313362_5460358936201525979_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azP3-00JbVgQ7kNvwHQ3KPj&_nc_oc=AdpxNmBMNm9PxJXgIaHr6THZV02OAd7ne0PJJlRiGbiswbS9pBUy-znUnG53yeGbK28&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnueTABdYEzHk6WYwObBMgZOLbhhgb7qlZ1yk2wAGomw&oe=6B01C65E"}, {"file_name": "RLOculusScreenshot1.png", "id": "1872394096877709", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819407_1872394100211042_6637672513816013493_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pt_sSkD7dbgQ7kNvwHPwo1l&_nc_oc=AdruQcyywV3cdsCkUUSewiTL-65yBiQMJwYgTICN-W6uCEojCzJcd5SayFbE6jgIcwU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuiU5T2aQ3vkzRd1VvoiE3EYTicX_11VuOkInpmJ-d3Q&oe=6B01E6AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape2.png", "id": "873323944373880", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_873323947707213_5357903444929597662_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWOywy56Y0IQ7kNvwF_army&_nc_oc=AdoZW8fttLVLkmbfNRPaBr1pichqzei3EDUVw32svUOVJDksugX_IIsn2GoEq9nhKbw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4-urM2-tMGEzv5lFjkNJ2qPZLK3YGpxoWSZip9_SdZA&oe=6B01CBD3"}, "display_name": "TritonXR: Reality Warfare", "keywords": ["shooter", "triton", "xr", "fps", "colocation"], "long_description": "**Turn every inch of your living room into a live-fire arena in TritonXR!**\n\nTritonXR turns ANY space into a multiplayer mixed-reality battlefield in seconds - vault your coffee table to dodge a laser burst, lob a grenade down the hallway, or dive behind your bed to reload.\n\n# REALITY WARFARE\n{1249540903189800}\nFill every inch of your room with friends, frags and frantic call-outs, and battle in either full VR or our cutting-edge XR mode - this is the world's most advanced FPS.\n\n# FIGHT SOLO OR WITH FRIENDS\n{744093408042507}\nFend off aerial hunters and furniture-climbing spiders that learn your room layout in an exciting, frantic survival mode that will leave your heart racing.\n\n# BUILD AND BATTLE IN SECONDS\n{1007957931325487}\nOur drop-dead-simple XR map editor snaps walls, props and more straight onto your floor plan. Carve cover, raise vantage platforms, or spawn weapon caches with easy-to-use tools.\n\n**This is the world's most advanced FPS. Are you ready?**", "short_description": "TritonXR turns ANY space into a multiplayer mixed-reality battlefield in seconds - vault your coffee table to dodge a laser burst, lob a grenade down the hallway, or dive behind your bed to reload. \n\nThis is the world's most advanced XR game - are you ready?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tetrastudios.com.au/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Tetra Studios", "support_website_url": "https://www.tetrastudios.com.au/contact", "website_url": "https://www.tetrastudios.com.au/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_ca
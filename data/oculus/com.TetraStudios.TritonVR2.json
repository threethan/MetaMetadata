_name": "TestSurvivalScreenshot.png", "id": "8661934777151185", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566682_8661934780484518_8908019271902800624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLydWEZj2fIQ7kNvwF2vz2b&_nc_oc=AdqyNGQNVKT7G6KerZ63eRsOO5KvvaBEnnTY1crHr-22xXsfMHVluUdrblDolB1nsKA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GcO7U6BN6uwMUXjnl6BqXS-Gm7qD0DQJJfFBqb0Ltjg&oe=6A0345C2"}, {"file_name": "NewTritonXROculusScreenshot7.png", "id": "727400359980029", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821849_727400363313362_5460358936201525979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eI50pwHt5sYQ7kNvwG-JkeT&_nc_oc=AdqyO2iBVJsTgRXglY4pZpdRRR1lw1CbK-FKh03ET8PS01g5H9Cj2ufUgF9qF6e-q6U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_QrY6FV3Z1ajOqZJ9Orv8DZiLwmc2qZQcoiIMpESeHg&oe=6A031C9E"}, {"file_name": "RLOculusScreenshot1.png", "id": "1872394096877709", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819407_1872394100211042_6637672513816013493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R21WeU5qqqUQ7kNvwGEaF-Y&_nc_oc=AdpwxDCHltT2s2Kx9gmGnAJgkrNxQS_dD2J9Pk5YtFbmIvhitQH8xj2WnsIJvPaKzHw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ECAOGKmVe4Yz2AzpydtdRkGMv0VXrSGgdvKH79PpZ-g&oe=6A033CED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape2.png", "id": "873323944373880", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982699_873323947707213_5357903444929597662_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKARVppYKDgQ7kNvwGSL7_6&_nc_oc=Adp1dko1rEyuMbwQie6FuGX18b-yXuzmGCh7vZbyXlskwGdC9skUUBh3o62lvI50Jbw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79rpbRv-zVzr3iQREH0Pe7GP2yfy5VHbsEzLaWDjkNDg&oe=6A032213"}, "display_name": "TritonXR: Reality Warfare", "keywords": ["shooter", "triton", "xr", "fps", "colocation"], "long_description": "**Turn every inch of your living room into a live-fire arena in TritonXR!**\n\nTritonXR turns ANY space into a multiplayer mixed-reality battlefield in seconds - vault your coffee table to dodge a laser burst, lob a grenade down the hallway, or dive behind your bed to reload.\n\n# REALITY WARFARE\n{1249540903189800}\nFill every inch of your room with friends, frags and frantic call-outs, and battle in either full VR or our cutting-edge XR mode - this is the world's most advanced FPS.\n\n# FIGHT SOLO OR WITH FRIENDS\n{744093408042507}\nFend off aerial hunters and furniture-climbing spiders that learn your room layout in an exciting, frantic survival mode that will leave your heart racing.\n\n# BUILD AND BATTLE IN SECONDS\n{1007957931325487}\nOur drop-dead-simple XR map editor snaps walls, props and more straight onto your floor plan. Carve cover, raise vantage platforms, or spawn weapon caches with easy-to-use tools.\n\n**This is the world's most advanced FPS. Are you ready?**", "short_description": "TritonXR turns ANY space into a multiplayer mixed-reality battlefield in seconds - vault your coffee table to dodge a laser burst, lob a grenade down the hallway, or dive behind your bed to reload. \n\nThis is the world's most advanced XR game - are you ready?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tetrastudios.com.au/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Tetra Studios", "support_website_url": "https://www.tetrastudios.com.au/contact", "website_url": "https://www.tetrastudios.com.au/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
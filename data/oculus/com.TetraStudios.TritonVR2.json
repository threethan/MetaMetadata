c=igaGsjf2IBYQ7kNvwHkC-XS&_nc_oc=AdrE_zTECt5o9doax9o5XQr3kSDj1f28KlGyR-l7LnWMDdZA5d21pnt4JBINCZDSfqU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSVLm7IHgVuhXV9_0JaHueGDhVC7uTSEI4MULoQEzBh8g&oe=6B0C6EE3"}, {"file_name": "TestSurvivalScreenshot.png", "id": "8661934777151185", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566682_8661934780484518_8908019271902800624_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oTmpnpxeLsQ7kNvwFUyiAC&_nc_oc=Adov0kcahvMfBN1xTWhT6P1c0nHLS3O_KcqI4CvcIybJn6AvfYsKcwtdqePdspSUZ78&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSEJfBjyrxwdWGiiiU-ieRTtC0FGt2SIJq0HQ6ewcvmKA&oe=6B0C7B82"}, {"file_name": "NewTritonXROculusScreenshot7.png", "id": "727400359980029", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821849_727400363313362_5460358936201525979_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyuYBymRfyUQ7kNvwGV1UWJ&_nc_oc=AdpuOzOOMdNRGBRBEO5dXRf_RpDMoT8TVz3Fet0mK_sWzvQoMjcl4_3R0yVf3e0fwlw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSJQsVZUaFMpo-yTwUzlzaPld-QhV9ENsdpoQA5uI33pg&oe=6B0C525E"}, {"file_name": "RLOculusScreenshot1.png", "id": "1872394096877709", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819407_1872394100211042_6637672513816013493_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2aoOfQmvu8YQ7kNvwHT8shG&_nc_oc=AdoH5d2gQI39dsi9WitCygFR-ki9idzbRfSESsMD7ezBYC5q9FIG4PFfQtGo4w37Df8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRT3qhB9OZ7q9_soGzUKmQ2oqQrk1Ha4MJkLOlOaBJMrQ&oe=6B0C72AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape2.png", "id": "873323944373880", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_873323947707213_5357903444929597662_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sq75-3IwQyIQ7kNvwH9HcTD&_nc_oc=AdpeTknbKEUuguZ2eBIivAZIm1sGbc8GbzGVDSYFUtH2t3d7xKjfSNiOkXwIKHDrtn0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTTlvPyRuJfO4xSblX9ZjEVWKAI1k1L58zxsYlx8dxHzg&oe=6B0C57D3"}, "display_name": "TritonXR: Reality Warfare", "keywords": ["shooter", "triton", "xr", "fps", "colocation"], "long_description": "**Turn every inch of your living room into a live-fire arena in TritonXR!**\n\nTritonXR turns ANY space into a multiplayer mixed-reality battlefield in seconds - vault your coffee table to dodge a laser burst, lob a grenade down the hallway, or dive behind your bed to reload.\n\n# REALITY WARFARE\n{1249540903189800}\nFill every inch of your room with friends, frags and frantic call-outs, and battle in either full VR or our cutting-edge XR mode - this is the world's most advanced FPS.\n\n# FIGHT SOLO OR WITH FRIENDS\n{744093408042507}\nFend off aerial hunters and furniture-climbing spiders that learn your room layout in an exciting, frantic survival mode that will leave your heart racing.\n\n# BUILD AND BATTLE IN SECONDS\n{1007957931325487}\nOur drop-dead-simple XR map editor snaps walls, props and more straight onto your floor plan. Carve cover, raise vantage platforms, or spawn weapon caches with easy-to-use tools.\n\n**This is the world's most advanced FPS. Are you ready?**", "short_description": "TritonXR turns ANY space into a multiplayer mixed-reality battlefield in seconds - vault your coffee table to dodge a laser burst, lob a grenade down the hallway, or dive behind your bed to reload. \n\nThis is the world's most advanced XR game - are you ready?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tetrastudios.com.au/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Tetra Studios", "support_website_url": "https://www.tetrastudios.com.au/contact", "website_url": "https://www.tetrastudios.com.au/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_ca
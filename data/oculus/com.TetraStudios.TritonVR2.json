771-25/57566682_8661934780484518_8908019271902800624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1am94sg45JEQ7kNvwFG7pkt&_nc_oc=Adl8fqteQ_77pAkx80qpXdPI1FEGxiv_yk38XeV97SoMIExXqHIB2XysMLFDJl7aa3o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuwX3N_0wNdl-_0zbagUGv3xof16-x468Ar9MF0ioXmDw&oe=69A2D002"}, {"file_name": "NewTritonXROculusScreenshot7.png", "id": "727400359980029", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821849_727400363313362_5460358936201525979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCHEwBTr_OMQ7kNvwGORnQZ&_nc_oc=Adns05oqAuyqKCAY4HZAJURWloGo_3X1uCrMEOP-IdUCivsjWipuiHk8k9ldChrmSjY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvox7d7jt-11lSVASWMxIVS3nxmQ6Ju05qNPEa4Ty6bHQ&oe=69A2DF1E"}, {"file_name": "RLOculusScreenshot1.png", "id": "1872394096877709", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819407_1872394100211042_6637672513816013493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReQwK3KTomcQ7kNvwERXiLa&_nc_oc=Adl4mapts4aobDn7hnHWe281uhcLVQtKH_aZ59apGOTCh32hTutYdmcoT0cHoHfxxyQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu7PMOm2pOWLMA_D9Mu9vd4WqxtKjOwKsUyiHFEGKKjeQ&oe=69A2C72D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape2.png", "id": "873323944373880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982699_873323947707213_5357903444929597662_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmy2_1gB4FkQ7kNvwFo6NWX&_nc_oc=AdmVhzW6LMC6kkwAsEvW5PkOwGg_vopHhG-5k8qGPOA0uhgeigmb_jx6T1WtKOYXjpM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfupXIlSBF2oW9XMlRpgi5WFRAryl3j86nJaiNbzrzfpCw&oe=69A2E493"}, "display_name": "TritonXR: Reality Warfare", "keywords": ["shooter", "triton", "xr", "fps", "colocation"], "long_description": "**Turn every inch of your living room into a live-fire arena in TritonXR!**\n\nTritonXR turns ANY space into a multiplayer mixed-reality battlefield in seconds - vault your coffee table to dodge a laser burst, lob a grenade down the hallway, or dive behind your bed to reload.\n\n# REALITY WARFARE\n{1249540903189800}\nFill every inch of your room with friends, frags and frantic call-outs, and battle in either full VR or our cutting-edge XR mode - this is the world's most advanced FPS.\n\n# FIGHT SOLO OR WITH FRIENDS\n{744093408042507}\nFend off aerial hunters and furniture-climbing spiders that learn your room layout in an exciting, frantic survival mode that will leave your heart racing.\n\n# BUILD AND BATTLE IN SECONDS\n{1007957931325487}\nOur drop-dead-simple XR map editor snaps walls, props and more straight onto your floor plan. Carve cover, raise vantage platforms, or spawn weapon caches with easy-to-use tools.\n\n**This is the world's most advanced FPS. Are you ready?**", "short_description": "TritonXR turns ANY space into a multiplayer mixed-reality battlefield in seconds - vault your coffee table to dodge a laser burst, lob a grenade down the hallway, or dive behind your bed to reload. \n\nThis is the world's most advanced XR game - are you ready?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tetrastudios.com.au/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Tetra Studios", "support_website_url": "https://www.tetrastudios.com.au/contact", "website_url": "https://www.tetrastudios.com.au/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_m
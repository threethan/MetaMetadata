id": "8661934777151185", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57566682_8661934780484518_8908019271902800624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WipeCn7KT5cQ7kNvwF6_DAC&_nc_oc=AdpT9WB9wtGBCyK9Noim_8XmY2-DrDUQH6KYxigrtqBoMjNXGL8P4ctEm6uCZqBChjY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1pSUPjPEWHz7cyW45psrm4Jg9WdmoUUGfkHL9jRfMUlA&oe=69F1EA02"}, {"file_name": "NewTritonXROculusScreenshot7.png", "id": "727400359980029", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821849_727400363313362_5460358936201525979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjIVH-KC9WoQ7kNvwGZbfE4&_nc_oc=AdooGaAyNRd1AqeL61czrPlZo61-MCYExTOR8ZAkpV2liO_916DTco_bSbdV2St-SjY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0NC782rA6Tj-5ACcZOeS3ITrdtO6YEtYnoZGKv6v25yw&oe=69F1F91E"}, {"file_name": "RLOculusScreenshot1.png", "id": "1872394096877709", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819407_1872394100211042_6637672513816013493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5sJ5tOsVDwQ7kNvwGKea-O&_nc_oc=Adq_oRCqsyKGRhiCFjaQi8axXG-YjdyFaaCzsBTayKVKH4XFCgXFMF7sUFnRkLn1X54&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0wtnzqp8ttAOXeSnvgitizBNSuiNFqipmEvwiec6yh-w&oe=69F2196D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape2.png", "id": "873323944373880", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982699_873323947707213_5357903444929597662_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=og5nYKl-5kwQ7kNvwHXIDxQ&_nc_oc=Adqy3tosAB9iyWh_uKZuy3w8udsQflJjc6vSt7HbOG-rfRmarw7J0XE7PcifPfqhM_E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3OVQNTrtkMZHjgHItYTQPu4Lmkg63N1hja_WcY4T7V5g&oe=69F1FE93"}, "display_name": "TritonXR: Reality Warfare", "keywords": ["shooter", "triton", "xr", "fps", "colocation"], "long_description": "**Turn every inch of your living room into a live-fire arena in TritonXR!**\n\nTritonXR turns ANY space into a multiplayer mixed-reality battlefield in seconds - vault your coffee table to dodge a laser burst, lob a grenade down the hallway, or dive behind your bed to reload.\n\n# REALITY WARFARE\n{1249540903189800}\nFill every inch of your room with friends, frags and frantic call-outs, and battle in either full VR or our cutting-edge XR mode - this is the world's most advanced FPS.\n\n# FIGHT SOLO OR WITH FRIENDS\n{744093408042507}\nFend off aerial hunters and furniture-climbing spiders that learn your room layout in an exciting, frantic survival mode that will leave your heart racing.\n\n# BUILD AND BATTLE IN SECONDS\n{1007957931325487}\nOur drop-dead-simple XR map editor snaps walls, props and more straight onto your floor plan. Carve cover, raise vantage platforms, or spawn weapon caches with easy-to-use tools.\n\n**This is the world's most advanced FPS. Are you ready?**", "short_description": "TritonXR turns ANY space into a multiplayer mixed-reality battlefield in seconds - vault your coffee table to dodge a laser burst, lob a grenade down the hallway, or dive behind your bed to reload. \n\nThis is the world's most advanced XR game - are you ready?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tetrastudios.com.au/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Tetra Studios", "support_website_url": "https://www.tetrastudios.com.au/contact", "website_url": "https://www.tetrastudios.com.au/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_langua
c=PCxoMyWyMpoQ7kNvwFbxzGL&_nc_oc=AdqE0qP4Jx3Bb5rXc9L6tW1P4ghqUvvUAomVrBmLTjCnEtXpKXGiMGAd7VHNTXSOWEQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRE6oIQrp5Fkut-R7VZI1oPOeGnJstL-L8d5HQjSATYQ&oe=6AFC64A3"}, {"file_name": "TestSurvivalScreenshot.png", "id": "8661934777151185", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566682_8661934780484518_8908019271902800624_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25HkUKkFGsQQ7kNvwGoN6zO&_nc_oc=AdoWbLg6qIUR9WuddzYC5ap4uMB1EVEh0LB9ziVnRkvFQ8QHwYLYOQloCyOv1Mw3EPs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwB_Uh_MPk5vhsdiEphxBYQ_cTRIhFIkgxCUwFD1JC4Q&oe=6AFC7142"}, {"file_name": "NewTritonXROculusScreenshot7.png", "id": "727400359980029", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821849_727400363313362_5460358936201525979_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6yMOPSQkd80Q7kNvwEuRSG2&_nc_oc=AdoMRHAoEG9l7_9gQBSzPBbTIaZxLnIpeP5FimJE3MG5YLfIvLZpDLb-if_IWk56Zhc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRY3oloCsdekgJTLy9HGLhlY79KVaaVp_8I5Uf4aE1xA&oe=6AFC805E"}, {"file_name": "RLOculusScreenshot1.png", "id": "1872394096877709", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819407_1872394100211042_6637672513816013493_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTxU-u9G3BEQ7kNvwHICJxA&_nc_oc=AdruXjc8gD2JphyKu1oAB9WNyKZlZhtBxd0abCRBdvRveQQO7l8Gx6RxXapNzZl__gE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQn4xbeP_hYgledNryORk21mU3Fks_fNdKYuhs05m63-Q&oe=6AFC686D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape2.png", "id": "873323944373880", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982699_873323947707213_5357903444929597662_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5Xo4gQ0H0QQ7kNvwHnhnkA&_nc_oc=AdpeQYpvqxDBEzTylP6TL7vaprRN147I3UOkQd-V8rR5z7x3Jrh2oM1l0ZwjUuNfbFA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvXf8o5oQztlcfaokfUrkgHnKDi8DTcAESCZZRjzXZ_g&oe=6AFC85D3"}, "display_name": "TritonXR: Reality Warfare", "keywords": ["shooter", "triton", "xr", "fps", "colocation"], "long_description": "**Turn every inch of your living room into a live-fire arena in TritonXR!**\n\nTritonXR turns ANY space into a multiplayer mixed-reality battlefield in seconds - vault your coffee table to dodge a laser burst, lob a grenade down the hallway, or dive behind your bed to reload.\n\n# REALITY WARFARE\n{1249540903189800}\nFill every inch of your room with friends, frags and frantic call-outs, and battle in either full VR or our cutting-edge XR mode - this is the world's most advanced FPS.\n\n# FIGHT SOLO OR WITH FRIENDS\n{744093408042507}\nFend off aerial hunters and furniture-climbing spiders that learn your room layout in an exciting, frantic survival mode that will leave your heart racing.\n\n# BUILD AND BATTLE IN SECONDS\n{1007957931325487}\nOur drop-dead-simple XR map editor snaps walls, props and more straight onto your floor plan. Carve cover, raise vantage platforms, or spawn weapon caches with easy-to-use tools.\n\n**This is the world's most advanced FPS. Are you ready?**", "short_description": "TritonXR turns ANY space into a multiplayer mixed-reality battlefield in seconds - vault your coffee table to dodge a laser burst, lob a grenade down the hallway, or dive behind your bed to reload. \n\nThis is the world's most advanced XR game - are you ready?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tetrastudios.com.au/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Tetra Studios", "support_website_url": "https://www.tetrastudios.com.au/contact", "website_url": "https://www.tetrastudios.com.au/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_ca
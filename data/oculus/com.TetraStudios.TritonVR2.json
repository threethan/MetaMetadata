le_name": "TestSurvivalScreenshot.png", "id": "8661934777151185", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57566682_8661934780484518_8908019271902800624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxg4mbNc2t4Q7kNvwEK-Rn2&_nc_oc=Adpnabk8LkjI9E2JJjpsq-Yv_U53GaUzW8SxVi9NmuqnaKH-j0G-299D_1feD-uUWPU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MEOhp7E5FLZDwmiWSRVTpRHCaxxffZxrPp63pQcPtbA&oe=6A22E9C2"}, {"file_name": "NewTritonXROculusScreenshot7.png", "id": "727400359980029", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491821849_727400363313362_5460358936201525979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgMe2sw7xe0Q7kNvwEdpQ-s&_nc_oc=Ado0fVBDCBakZjdSeIei13T-z95wraHqJWXPWWi-UYZG0ydr7zqY3ahnnB_uFpuKASk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jlnf4FanSWi-ow8Cai9_EOgdlmcu8Oxs13za4SMgnFA&oe=6A22F8DE"}, {"file_name": "RLOculusScreenshot1.png", "id": "1872394096877709", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491819407_1872394100211042_6637672513816013493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51BPLQLb0jcQ7kNvwFmr-uv&_nc_oc=AdrhdVtcbdVUBmLcboxRLfQg7iPgL2ROKVenItTPbHxtq9l9zsrrCY6doOzQYhcB5bI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98b6lJ459qhL8FsX6xY0Vv1qNS4CZxz3mZR1dk5S5C-w&oe=6A22E0ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape2.png", "id": "873323944373880", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982699_873323947707213_5357903444929597662_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jygDOwANvBMQ7kNvwFr7n1_&_nc_oc=AdqDisp0sUtnf294kIHOr-_rMlVsKUO7lSibxxu6Dp-zYX85fwTQoDew5sYjRAz-T0E&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9W8_13RCdUXjuGW_xk6V7A1zVe6kYzYA1oK1eIIJqGnA&oe=6A22FE53"}, "display_name": "TritonXR: Reality Warfare", "keywords": ["shooter", "triton", "xr", "fps", "colocation"], "long_description": "**Turn every inch of your living room into a live-fire arena in TritonXR!**\n\nTritonXR turns ANY space into a multiplayer mixed-reality battlefield in seconds - vault your coffee table to dodge a laser burst, lob a grenade down the hallway, or dive behind your bed to reload.\n\n# REALITY WARFARE\n{1249540903189800}\nFill every inch of your room with friends, frags and frantic call-outs, and battle in either full VR or our cutting-edge XR mode - this is the world's most advanced FPS.\n\n# FIGHT SOLO OR WITH FRIENDS\n{744093408042507}\nFend off aerial hunters and furniture-climbing spiders that learn your room layout in an exciting, frantic survival mode that will leave your heart racing.\n\n# BUILD AND BATTLE IN SECONDS\n{1007957931325487}\nOur drop-dead-simple XR map editor snaps walls, props and more straight onto your floor plan. Carve cover, raise vantage platforms, or spawn weapon caches with easy-to-use tools.\n\n**This is the world's most advanced FPS. Are you ready?**", "short_description": "TritonXR turns ANY space into a multiplayer mixed-reality battlefield in seconds - vault your coffee table to dodge a laser burst, lob a grenade down the hallway, or dive behind your bed to reload. \n\nThis is the world's most advanced XR game - are you ready?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tetrastudios.com.au/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Tetra Studios", "support_website_url": "https://www.tetrastudios.com.au/contact", "website_url": "https://www.tetrastudios.com.au/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics
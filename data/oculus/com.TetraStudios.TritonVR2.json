c=Rmsk-jcGTSwQ7kNvwGnLM6o&_nc_oc=AdpbA1T-fBwWtV-ctH5XvJIJPJxj8iSIU7ycicb4xWbJrNMCXci5WxngksZy_wrWDMg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTC_wyXApxpRAV1G-IoDnVaxHIzSumribJaVY1UbRugaA&oe=6B05D763"}, {"file_name": "TestSurvivalScreenshot.png", "id": "8661934777151185", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566682_8661934780484518_8908019271902800624_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Y94573tBu8Q7kNvwGqJYUH&_nc_oc=AdoOeGb6Lw-uOgND7kkW9JjaN71NPeULRa4p5eCdpBW_KxsAvJWuanHz4-UKHd0JprA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUxdGQLU9o56JRwj8cbUVtDqJYT84JjZZ8tJbAzSyeIQ&oe=6B05ABC2"}, {"file_name": "NewTritonXROculusScreenshot7.png", "id": "727400359980029", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821849_727400363313362_5460358936201525979_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUJMDt7514UQ7kNvwHC8mP4&_nc_oc=AdpJkrHikIUL9EOtfps1Uou0Myz23vOwAJ_UHbKpNvgZRC5BCC8gbOp6YONViE5P-fc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQeQ3IfVyRza--eD9o2RmXvC0VTkxw6Z_WwFStkZJIWg&oe=6B05BADE"}, {"file_name": "RLOculusScreenshot1.png", "id": "1872394096877709", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819407_1872394100211042_6637672513816013493_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iy4tpUsrwbQQ7kNvwHzJSPk&_nc_oc=AdoHiiaoqjqDPSw7NuSUPo5ay9DmWGFXau1tqCjX2vCXQxh7OfqXC5XfD5TV8GJ_xyM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRP3Oj0F-_Db-KbGsusvOsB2VXVVCN2Sr9nQK2_6XUp2w&oe=6B05A2ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape2.png", "id": "873323944373880", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_873323947707213_5357903444929597662_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebp-3gM3m78Q7kNvwEPvW6g&_nc_oc=Adr8PIrwSUO_FwBX7p7XOK5gwpTI4-tGzwjtkFTmjtAVC-DSgJZTuGHw6whowD0TH3U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQxuKvTPoh-ttISInFHrqDv6rruO-rlf5CwMg2k4Fd-Q&oe=6B05C053"}, "display_name": "TritonXR: Reality Warfare", "keywords": ["shooter", "triton", "xr", "fps", "colocation"], "long_description": "**Turn every inch of your living room into a live-fire arena in TritonXR!**\n\nTritonXR turns ANY space into a multiplayer mixed-reality battlefield in seconds - vault your coffee table to dodge a laser burst, lob a grenade down the hallway, or dive behind your bed to reload.\n\n# REALITY WARFARE\n{1249540903189800}\nFill every inch of your room with friends, frags and frantic call-outs, and battle in either full VR or our cutting-edge XR mode - this is the world's most advanced FPS.\n\n# FIGHT SOLO OR WITH FRIENDS\n{744093408042507}\nFend off aerial hunters and furniture-climbing spiders that learn your room layout in an exciting, frantic survival mode that will leave your heart racing.\n\n# BUILD AND BATTLE IN SECONDS\n{1007957931325487}\nOur drop-dead-simple XR map editor snaps walls, props and more straight onto your floor plan. Carve cover, raise vantage platforms, or spawn weapon caches with easy-to-use tools.\n\n**This is the world's most advanced FPS. Are you ready?**", "short_description": "TritonXR turns ANY space into a multiplayer mixed-reality battlefield in seconds - vault your coffee table to dodge a laser burst, lob a grenade down the hallway, or dive behind your bed to reload. \n\nThis is the world's most advanced XR game - are you ready?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tetrastudios.com.au/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Tetra Studios", "support_website_url": "https://www.tetrastudios.com.au/contact", "website_url": "https://www.tetrastudios.com.au/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_ca
c=Rmsk-jcGTSwQ7kNvwHswju2&_nc_oc=Adqp_Fq-7D3O4_r-VpAY7SZQVs6DW1a5268EFOktKDGAiYaEuF-XH74bw6JIF3V-QCQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6x0FFvdlepeftmmnkX7AyVy46b3HxOu1bgvrY6J6sEA&oe=6B0485E3"}, {"file_name": "TestSurvivalScreenshot.png", "id": "8661934777151185", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566682_8661934780484518_8908019271902800624_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Y94573tBu8Q7kNvwGeEcDI&_nc_oc=AdqGiD1VGdczn4jMaDhTShXnzWi8nQVYpK4fQJIqB1CALQ1NPpg0aPzr_8gGil1HDVs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzwRV6VjSOL5JNif0IHVVyrgDR_CZ3yscym0jgWhPNew&oe=6B045A42"}, {"file_name": "NewTritonXROculusScreenshot7.png", "id": "727400359980029", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821849_727400363313362_5460358936201525979_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azP3-00JbVgQ7kNvwHjlEjB&_nc_oc=AdouXo3ujAf1tQ9suMyq-pffvIqGRHqJyVKmKiUQdqucgqdAsfgfYUDzZyAguWNyNPc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMmHo67xqojs2F_olR4hI4mN2hkghIf-NFKViRuw0oNA&oe=6B04695E"}, {"file_name": "RLOculusScreenshot1.png", "id": "1872394096877709", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819407_1872394100211042_6637672513816013493_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pt_sSkD7dbgQ7kNvwEFb8t3&_nc_oc=AdrFaLAUXxVkI1MrsJQcN0INT22ZAXTjvpRTDIr-_lTu0ciHY4ZBJMbATHsKkjuO2SM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3JFdi5RsH28qXmX97C6mWCcab2IQllAeUljph8AbGDA&oe=6B0489AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape2.png", "id": "873323944373880", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_873323947707213_5357903444929597662_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebp-3gM3m78Q7kNvwHINKBi&_nc_oc=AdpWrnyJCnibQkfRjjE_UtBj33czN4CZVTnRpFPta16z2P0T02xW2VHFSYdnWCwIdUY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTA0lV6R7-_HyzX_xXStLajW7sKtGUH1nTXEHTxLFTjaA&oe=6B046ED3"}, "display_name": "TritonXR: Reality Warfare", "keywords": ["shooter", "triton", "xr", "fps", "colocation"], "long_description": "**Turn every inch of your living room into a live-fire arena in TritonXR!**\n\nTritonXR turns ANY space into a multiplayer mixed-reality battlefield in seconds - vault your coffee table to dodge a laser burst, lob a grenade down the hallway, or dive behind your bed to reload.\n\n# REALITY WARFARE\n{1249540903189800}\nFill every inch of your room with friends, frags and frantic call-outs, and battle in either full VR or our cutting-edge XR mode - this is the world's most advanced FPS.\n\n# FIGHT SOLO OR WITH FRIENDS\n{744093408042507}\nFend off aerial hunters and furniture-climbing spiders that learn your room layout in an exciting, frantic survival mode that will leave your heart racing.\n\n# BUILD AND BATTLE IN SECONDS\n{1007957931325487}\nOur drop-dead-simple XR map editor snaps walls, props and more straight onto your floor plan. Carve cover, raise vantage platforms, or spawn weapon caches with easy-to-use tools.\n\n**This is the world's most advanced FPS. Are you ready?**", "short_description": "TritonXR turns ANY space into a multiplayer mixed-reality battlefield in seconds - vault your coffee table to dodge a laser burst, lob a grenade down the hallway, or dive behind your bed to reload. \n\nThis is the world's most advanced XR game - are you ready?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tetrastudios.com.au/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Tetra Studios", "support_website_url": "https://www.tetrastudios.com.au/contact", "website_url": "https://www.tetrastudios.com.au/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_ca
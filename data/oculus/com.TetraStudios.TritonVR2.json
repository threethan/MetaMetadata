c=ELxOVnJNtxMQ7kNvwHZcUm1&_nc_oc=AdomeAwBCnu_ZFkUi9pTjpN71WlBF20Ua_a5FUt6jayA8Glg8eHYrtp200yKbgUOtEU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNp-q5hmFtAGF5cvCFGSlEFeSU_R9FyNPlJ95xRU_FvA&oe=6B005923"}, {"file_name": "TestSurvivalScreenshot.png", "id": "8661934777151185", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566682_8661934780484518_8908019271902800624_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeoKnAu_tiIQ7kNvwGkEPsA&_nc_oc=AdpnMbl4u72hMFF1c8QwWvTLgwPcessuEE-bUZA0-2FqwGUXnFDpY1mL9dOxZb2OLjM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIKj_PGZfUSY10O_1AjSVsHmiJ_L09SROyGD-S6xkdcQ&oe=6B0065C2"}, {"file_name": "NewTritonXROculusScreenshot7.png", "id": "727400359980029", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821849_727400363313362_5460358936201525979_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsf7LHrXzQsQ7kNvwH81nwE&_nc_oc=AdqrmoT8dWF1Z0Tz-zOZjhFbx8lIVD5HSILztMQsjuDDZ50ANy1ByKth-UNIkjzqyV0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAwA3mJAEUeB0_IaAgLOJyb31MY1ObJtome7VI7czxXg&oe=6B0074DE"}, {"file_name": "RLOculusScreenshot1.png", "id": "1872394096877709", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819407_1872394100211042_6637672513816013493_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olmK9RGM3xAQ7kNvwHaRlgm&_nc_oc=AdoLBH_XH0CzRS0rt4JmXxz2XTGbnfq1bRedDq04X1a22pWSQdzvIa35Q6x6U8eXNjc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9QfhyOhLoIPLFu9eflVpBetS-WvHw_3RO7RUawDK2-A&oe=6B005CED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape2.png", "id": "873323944373880", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_873323947707213_5357903444929597662_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWOywy56Y0IQ7kNvwFYC9vY&_nc_oc=AdoBfAM8Fu3xD369IRUq1LvTJOIFphvaZfcJLB5EWn3ZrFcgf11zARIjRR5HP-58yao&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyNTy6U1mXP3i3ADpsYQwkc7m7ZhCQFOoXIZl4hgzM_Q&oe=6B007A53"}, "display_name": "TritonXR: Reality Warfare", "keywords": ["shooter", "triton", "xr", "fps", "colocation"], "long_description": "**Turn every inch of your living room into a live-fire arena in TritonXR!**\n\nTritonXR turns ANY space into a multiplayer mixed-reality battlefield in seconds - vault your coffee table to dodge a laser burst, lob a grenade down the hallway, or dive behind your bed to reload.\n\n# REALITY WARFARE\n{1249540903189800}\nFill every inch of your room with friends, frags and frantic call-outs, and battle in either full VR or our cutting-edge XR mode - this is the world's most advanced FPS.\n\n# FIGHT SOLO OR WITH FRIENDS\n{744093408042507}\nFend off aerial hunters and furniture-climbing spiders that learn your room layout in an exciting, frantic survival mode that will leave your heart racing.\n\n# BUILD AND BATTLE IN SECONDS\n{1007957931325487}\nOur drop-dead-simple XR map editor snaps walls, props and more straight onto your floor plan. Carve cover, raise vantage platforms, or spawn weapon caches with easy-to-use tools.\n\n**This is the world's most advanced FPS. Are you ready?**", "short_description": "TritonXR turns ANY space into a multiplayer mixed-reality battlefield in seconds - vault your coffee table to dodge a laser burst, lob a grenade down the hallway, or dive behind your bed to reload. \n\nThis is the world's most advanced XR game - are you ready?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tetrastudios.com.au/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Tetra Studios", "support_website_url": "https://www.tetrastudios.com.au/contact", "website_url": "https://www.tetrastudios.com.au/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_ca
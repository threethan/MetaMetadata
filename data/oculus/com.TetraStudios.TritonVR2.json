6g38m3mzW7Y7nRICLdke24Yw&oe=69A41C91"}, {"file_name": "OculusScreenshot3.png", "id": "1422047048384773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_1422047051718106_7215813195562031034_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NOBXjTSYeUQ7kNvwEC_CzS&_nc_oc=AdkccTaSmGyoesgrgWq4kwO9I3Z_vLzk5Kef9Ep4IEhW5tJD9hPLYhw496f6RfECyXM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsaFsadD-XxztFs6fjZlIrQN48telawyq1Qfr3igmboRA&oe=69A42392"}, {"file_name": "OculusScreenshot5.png", "id": "667149165591308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75429290_667149168924641_6609562516381524837_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESmD3OthSpsQ7kNvwGIl9mv&_nc_oc=Adke6kAFvKjxEK-GQ3It7EvyG8_zvSstCAuY3neg15Tlr_QzxjIWYWu89r3xlgZ5z7A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsJyRMnnNg-a6Bru5SEY6-qwWLFF5ZH87P5Cpc57M7VTw&oe=69A4263C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HeroLandscape.png", "id": "277489128156801", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_277489134823467_4204457001143684943_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ncwTVxY_goQ7kNvwGrVuV5&_nc_oc=AdnwBFEW7gXEB8ogPVAsu-1pVwJ9-3Bw4QVsb68rGop-ac_PGU6_TQRI3uG2C1N484Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfudAixfqQgL5LLV_X3w3msWlEhoSlPBqCx9jEk-qE2agw&oe=69A42CA4"}, "display_name": "TritonVR 2: Next Gen MR Warfare", "keywords": [], "long_description": "The next generation of VR is here. Created from the ground-up and iterating on its predecessor, TritonVR 2 combines thrilling yet accessible VR combat with platform-defining shared-space gameplay - you\u2019ll need to move around your play area in real life to move in the game, in custom-built maps designed for any playspace size.\n\nSettle your differences in fast-paced and high-stakes PvP warfare, both online or locally. And new to the series is the next-generation map editor, World Weaver. Utilising the latest tech advancements, this editor will intelligently build a map from your exact play-space dimensions to create a one-of-a-kind map that you and your friends can battle on.", "short_description": "Turn any playspace into the ultimate multiplayer combat arena in TritonVR 2! Using cutting-edge tech, TritonVR 2 allows you to turn any area into a battlefield, with up to 4 players simultaneously able to compete in the action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tetrastudios.com.au/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Tetra Studios", "support_website_url": "https://www.tetrastudios.com.au/contact", "website_url": "https://www.tetrastudios.com.au/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6874326265990615"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1139297081234469"}, {"status": "PUBLISHED", "id": "883813249964350"}]}, "baseline_offer": {"id": "1139297081234469"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1733523840, "status": "PUBLISHED", "id": "1139297081234469"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9145028898920329", "version": "1.9.7"}, "id": "260816166552950", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false
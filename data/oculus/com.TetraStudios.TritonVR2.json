_name": "TestSurvivalScreenshot.png", "id": "8661934777151185", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566682_8661934780484518_8908019271902800624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYoGc6T5VWoQ7kNvwFEZcfo&_nc_oc=AdqbQhygct42pGsVhiUD66xIy4Ppn6l1jBD3z9nIWy9FMkdUhgwt15-bEyPkQL8idW8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IqIRT6gi9Shin-PFx2G3hiINKQ7mxzynzQjaLFLIrwQ&oe=6A3BF642"}, {"file_name": "NewTritonXROculusScreenshot7.png", "id": "727400359980029", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821849_727400363313362_5460358936201525979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3bQt84Ft6cQ7kNvwGCZUm4&_nc_oc=AdpSFHDAPwjx0HgYPYHbrO4CNo1i6m56IEeIFyqkDmx1L8tmLkfo9HMjSVnQdiwcI2I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WWYX0J9SqwmTJUDzt0H69wvrRd8kQOFuAPowf-PdIJQ&oe=6A3BCD1E"}, {"file_name": "RLOculusScreenshot1.png", "id": "1872394096877709", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819407_1872394100211042_6637672513816013493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kG3-hYYElzMQ7kNvwFxIXox&_nc_oc=AdpyE4cIs51IVIaHdTXhMnelQUYmvU7o9ctER5go3ykyluBTooKE5Ame34GAPXXtNS0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8e9uguQlBP-xdg0IssMDv__TuVeMss8kNsHQbarF0AeQ&oe=6A3BED6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape2.png", "id": "873323944373880", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_873323947707213_5357903444929597662_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xO27c5edp3YQ7kNvwFddcT6&_nc_oc=Adrp2VXoK3COEyZ3xdDUfeO_qccNQWEglmA2R1AxJI30eYL-V-lu-L4d-x0JyBAl-Z0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cYQTPkquMccg5J-XnM4XQK1H7nk2avTqPBxe1ubLzpQ&oe=6A3BD293"}, "display_name": "TritonXR: Reality Warfare", "keywords": ["shooter", "triton", "xr", "fps", "colocation"], "long_description": "**Turn every inch of your living room into a live-fire arena in TritonXR!**\n\nTritonXR turns ANY space into a multiplayer mixed-reality battlefield in seconds - vault your coffee table to dodge a laser burst, lob a grenade down the hallway, or dive behind your bed to reload.\n\n# REALITY WARFARE\n{1249540903189800}\nFill every inch of your room with friends, frags and frantic call-outs, and battle in either full VR or our cutting-edge XR mode - this is the world's most advanced FPS.\n\n# FIGHT SOLO OR WITH FRIENDS\n{744093408042507}\nFend off aerial hunters and furniture-climbing spiders that learn your room layout in an exciting, frantic survival mode that will leave your heart racing.\n\n# BUILD AND BATTLE IN SECONDS\n{1007957931325487}\nOur drop-dead-simple XR map editor snaps walls, props and more straight onto your floor plan. Carve cover, raise vantage platforms, or spawn weapon caches with easy-to-use tools.\n\n**This is the world's most advanced FPS. Are you ready?**", "short_description": "TritonXR turns ANY space into a multiplayer mixed-reality battlefield in seconds - vault your coffee table to dodge a laser burst, lob a grenade down the hallway, or dive behind your bed to reload. \n\nThis is the world's most advanced XR game - are you ready?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tetrastudios.com.au/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Tetra Studios", "support_website_url": "https://www.tetrastudios.com.au/contact", "website_url": "https://www.tetrastudios.com.au/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
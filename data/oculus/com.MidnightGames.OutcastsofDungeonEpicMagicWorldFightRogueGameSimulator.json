Q7kNvwGguVOv&_nc_oc=AdpXBk3RutRdlVR-rAQtSvA-c5K3XVasghPeQQcAD5BJrxFxhCEPR_tBADjOfjy4wDY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJutZ6JU8dRwmcr-I1RBpjyIdci_Q40jDI9T6TViNjIGw&oe=6ABD0FE0"}, {"file_name": "screens \u2013 2.png", "id": "842212620549862", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75435283_842212627216528_5618517514263293235_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxEB_wU-IJEQ7kNvwFCGlxk&_nc_oc=AdplNeKr8wTg8m4uH8QERQLGDHWhaZReAksDyRkcm1_0HgoQ68FbyLxHXNtf6J1_eAI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7jhKT5PqPPpmmvNdJlI5_eKtV42rtJrJK7cJUxvd_sg&oe=6ABD3493"}, {"file_name": "screens \u2013 4.png", "id": "439126458253242", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001697_439126464919908_1939579221717236708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MN6Zck5WRqQQ7kNvwG2uH-R&_nc_oc=Adr5z2ukj_ADg_d8AAc0LMaY_oWy7zI6DChWErjQE0ATf_-y6s3ERi23ic1hVCD9ssk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrwLd7dL_-gFtoaFWMIeD4MmJmqIBBV1yUrjbi1KJbbQ&oe=6ABD0B90"}, {"file_name": "screens.png", "id": "771101150621784", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569471_771101160621783_7591652676362700724_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJLQZxSs7QgQ7kNvwH2cSaO&_nc_oc=AdoDgGfD8Ss8SLB8U9-owQca0m7R3VNBBLf5KVSIuMb-wScd3pEvukzBdDF4VOGHBV8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2S6aWWdybBRdv7yRT3XA0DMqyHFuZ50spmeE80m9_Fw&oe=6ABD2D20"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Outcasts of Dungeon Magic World Rogue Simulator", "keywords": [], "long_description": "Being in the role of a brave wanderer, help dwarfs to defend their kingdom fortress from a rampaging mob of beastly invaders. Captured dwarfs need help, and they have something to offer you as a reward.\nBattle enemies through a story-based campaign across dungeon and evolve your combat skills to achieve better results.\nFeatures:\n- Procedurally generated dungeons \u2013 Twisting passages, long halls and wide-open chambers all need a hero to clear them.\n- Story-based Campaign \u2013 Fend off monsters across acts to discover the mysterious power behind their relentless assaults.\n- Companion System - Free and protect allies from captivity and use their combat power to your advantage.\n- 9 Different Enemies \u2013 Including scavengers, ghouls and a whole bunch of ugly orcs.", "short_description": "It is a third person fantasy action game, where in the role of a brave wanderer, help dwarfs to defend their kingdom fortress from a rampaging mob of beastly invaders."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midnight.works/vr/privacy.html", "developer_terms_of_service_url": "https://midnight.works/terms.html", "publisher_name": "Midnight Games", "support_website_url": null, "website_url": "https://midnight.works/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "RPG", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1757710791255967"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422395_1785755378477765_2892380775835781063_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4KkrnMjf3kMQ7kNvwH_6mr1&_nc_oc=Adq7weaGyckBjM1gevVrcELNhjD_rJnavfHw1U42Z
Q7kNvwEs_0OG&_nc_oc=Adopuw1mn3IlMyhL8tzzfdMkd-A3p08CuGnhafIr5S_ggbvDU5FBAoRRGiTZhzlxBj0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7olv2HQFResdJxx3gLu-gZTfIszhOsTOsh6Mk0i6s1Q&oe=6A75DEE0"}, {"file_name": "screens \u2013 2.png", "id": "842212620549862", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75435283_842212627216528_5618517514263293235_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPU8bveOmI8Q7kNvwGiH4RN&_nc_oc=AdpCt_f8lWVd2ujEFw367jwG6cj9QIIiwFaKoFGOBVT8UdX_ULS68j_CIMZYwN9Q46E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSuruTiMcSyi_wTbfB2bsL1l8LmKn_9lmMPN4Xmjd_4A&oe=6A75CB53"}, {"file_name": "screens \u2013 4.png", "id": "439126458253242", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001697_439126464919908_1939579221717236708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ms8GrjJ9t4Q7kNvwHjuxyv&_nc_oc=AdqxM-T8o5z-IDMYMXp-MzPUa8f2lXXQFeqsZC_j8UMBILXU2eJm_daeExJW6F7JvXU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhVJQdMKkFN-BJVpLa13kKoKqFGg3_5x_4gFV97aghzQ&oe=6A75DA90"}, {"file_name": "screens.png", "id": "771101150621784", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569471_771101160621783_7591652676362700724_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZw8TmIlNhEQ7kNvwHbooXZ&_nc_oc=Adpy6FAG5YjxljSbgPvDI6krUmjtEXGDbkWRFqg-G8H_09g0O6ih3QPQTss6zyvB-ck&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoEE_RJTt4rAmossYugqzUWTeUGvowqSZdZIk8R7zlkA&oe=6A75C3E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Outcasts of Dungeon Magic World Rogue Simulator", "keywords": [], "long_description": "Being in the role of a brave wanderer, help dwarfs to defend their kingdom fortress from a rampaging mob of beastly invaders. Captured dwarfs need help, and they have something to offer you as a reward.\nBattle enemies through a story-based campaign across dungeon and evolve your combat skills to achieve better results.\nFeatures:\n- Procedurally generated dungeons \u2013 Twisting passages, long halls and wide-open chambers all need a hero to clear them.\n- Story-based Campaign \u2013 Fend off monsters across acts to discover the mysterious power behind their relentless assaults.\n- Companion System - Free and protect allies from captivity and use their combat power to your advantage.\n- 9 Different Enemies \u2013 Including scavengers, ghouls and a whole bunch of ugly orcs.", "short_description": "It is a third person fantasy action game, where in the role of a brave wanderer, help dwarfs to defend their kingdom fortress from a rampaging mob of beastly invaders."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midnight.works/vr/privacy.html", "developer_terms_of_service_url": "https://midnight.works/terms.html", "publisher_name": "Midnight Games", "support_website_url": null, "website_url": "https://midnight.works/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "RPG", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1757710791255967"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422395_1785755378477765_2892380775835781063_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qj205a3NahkQ7kNvwFGLhjx&_nc_oc=AdrSjWKuVJK5SXQaepjyNF3TlgrA7oB2m7qbixUAS
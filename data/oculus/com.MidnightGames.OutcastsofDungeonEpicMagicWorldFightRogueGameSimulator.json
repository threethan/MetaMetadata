Q7kNvwGTy1oa&_nc_oc=AdpGvFkD8WQhod-IeL7taOyc1BuEA9WRCSP7YJKDJdoD5i_4aQJVszpx-j5MZpPlg48&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0x1FcqypVa1eX5gDvCusyGoraAeQ98KAZbMv0RkVPYg&oe=6AD0D660"}, {"file_name": "screens \u2013 2.png", "id": "842212620549862", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75435283_842212627216528_5618517514263293235_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJir6p4ig70Q7kNvwFlG5v3&_nc_oc=AdqpgKIBZExL7JEzOYGDwpCl9QhlkMjq8RE9s8_fZtXItnzKo05WcENXeLvW0qvCOF0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6KAD8dbdJPJvnK7AcATfIpKUVTtpaFr6siW6A3-6Usg&oe=6AD0FB13"}, {"file_name": "screens \u2013 4.png", "id": "439126458253242", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001697_439126464919908_1939579221717236708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cH7dca9cEZ8Q7kNvwEpiT3k&_nc_oc=Adod2byR043_E1EsxXOVFtUOeS7vcvDJr8xuVjRCAb7mX4m7Jw2FHQTSBtcx15yDRJ0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTyb693SFBv4cAp6TG80jxIY7neG5qa-6AKl1dG5Ny9Q&oe=6AD0D210"}, {"file_name": "screens.png", "id": "771101150621784", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57569471_771101160621783_7591652676362700724_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIqwIVd61jIQ7kNvwH8pGb5&_nc_oc=Adpi98grsEWzoBw-N6ElKtY5O7VRzSAWwjy45F8kdfU5JIW2BSKtw7hakW1cTegdEzA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3snDes3QRM4bGtSDgY5LTGoUV0Dzwq_L3Nslx78aDHQ&oe=6AD0F3A0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Outcasts of Dungeon Magic World Rogue Simulator", "keywords": [], "long_description": "Being in the role of a brave wanderer, help dwarfs to defend their kingdom fortress from a rampaging mob of beastly invaders. Captured dwarfs need help, and they have something to offer you as a reward.\nBattle enemies through a story-based campaign across dungeon and evolve your combat skills to achieve better results.\nFeatures:\n- Procedurally generated dungeons \u2013 Twisting passages, long halls and wide-open chambers all need a hero to clear them.\n- Story-based Campaign \u2013 Fend off monsters across acts to discover the mysterious power behind their relentless assaults.\n- Companion System - Free and protect allies from captivity and use their combat power to your advantage.\n- 9 Different Enemies \u2013 Including scavengers, ghouls and a whole bunch of ugly orcs.", "short_description": "It is a third person fantasy action game, where in the role of a brave wanderer, help dwarfs to defend their kingdom fortress from a rampaging mob of beastly invaders."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midnight.works/vr/privacy.html", "developer_terms_of_service_url": "https://midnight.works/terms.html", "publisher_name": "Midnight Games", "support_website_url": null, "website_url": "https://midnight.works/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "RPG", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1757710791255967"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75422395_1785755378477765_2892380775835781063_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01VaHiGryzEQ7kNvwGpvFWU&_nc_oc=AdrrrUaJqDu_Nth219Y8fCl9ZnMY9-qESDOsG9yIL
5_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9MiA4rQUAMQ7kNvwEPFuul&_nc_oc=AdrEpgSqMAviUUjGKM5L02lY4L0n91qdoG-xxTLjciRfEJUYB6VCWKqS8QvXsuXwpVo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oYoE1QwB-ffIrgYchM8LC0BpV2ipIEzY8FCOffhVNTw&oe=6A468900"}, {"file_name": "screens \u2013 5.png", "id": "1664498803952404", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75340708_1664498807285737_697337633416318221_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AeSBf9ItdqEQ7kNvwHQTjBJ&_nc_oc=AdpwEha2B1i69CZ5wQlkSxJyAgqEZns5cLfbJwhHiNUXSIkL6TGPJ_fQ2fFj3HWnvo4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fYmdTyIDCvEWFoSWTb0m-4sCVbEQLIREAs9-47xgMyw&oe=6A4668E0"}, {"file_name": "screens \u2013 2.png", "id": "842212620549862", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75435283_842212627216528_5618517514263293235_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_l071PfhM5wQ7kNvwFKf6z4&_nc_oc=AdoINSFBcc_0AA4al_38uatmNeZZ4P0Sd1ty_19Wzc_ya54jMCg5JSjOwi85to451Tw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PF-9w7Y88W7qi9pnDgzLnpNupQ3Pzg-w5P6y0wu7YCA&oe=6A468D93"}, {"file_name": "screens \u2013 4.png", "id": "439126458253242", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39001697_439126464919908_1939579221717236708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RKfvqhzkzIQ7kNvwHNyQtB&_nc_oc=AdpHBJQueg4qdNF2vTWvJCpKEPMnELjiEj9m2OZ8yCMw_412NRqiOzZ3bPBVhIRAYcw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-H84BR3qrUucsGBeXP5d8wAb03J_BynTrF4Axr-taGuA&oe=6A466490"}, {"file_name": "screens.png", "id": "771101150621784", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/57569471_771101160621783_7591652676362700724_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkP3nf6pEmsQ7kNvwG08Syr&_nc_oc=Adp_7PmSrsVok2g02qYed3D8nmbRiWRiXB0oDBPAor4cgzbVDwCaPbFAlcPSwdKurtQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZD56GWeu0xOPsCWPhAaXiPz48aoCYx7jXNjiLrG6ywg&oe=6A468620"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Outcasts of Dungeon Magic World Rogue Simulator", "keywords": [], "long_description": "Being in the role of a brave wanderer, help dwarfs to defend their kingdom fortress from a rampaging mob of beastly invaders. Captured dwarfs need help, and they have something to offer you as a reward.\nBattle enemies through a story-based campaign across dungeon and evolve your combat skills to achieve better results.\nFeatures:\n- Procedurally generated dungeons \u2013 Twisting passages, long halls and wide-open chambers all need a hero to clear them.\n- Story-based Campaign \u2013 Fend off monsters across acts to discover the mysterious power behind their relentless assaults.\n- Companion System - Free and protect allies from captivity and use their combat power to your advantage.\n- 9 Different Enemies \u2013 Including scavengers, ghouls and a whole bunch of ugly orcs.", "short_description": "It is a third person fantasy action game, where in the role of a brave wanderer, help dwarfs to defend their kingdom fortress from a rampaging mob of beastly invaders."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midnight.works/vr/privacy.html", "developer_terms_of_service_url": "https://midnight.works/terms.html", "publisher_name": "Midnight Games", "support_website_url": null, "website_url": "https://midnight.works/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "RPG", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "s
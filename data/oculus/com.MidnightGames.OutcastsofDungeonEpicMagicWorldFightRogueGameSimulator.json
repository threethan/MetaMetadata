f20f&oh=00_Af9942sh7YxCm9sBAcE7BjJbY8a5-f9-ZsB-PHzCcmSp2A&oe=6A26E993"}, {"file_name": "screens \u2013 4.png", "id": "439126458253242", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001697_439126464919908_1939579221717236708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-AKWyvaTusQ7kNvwEt_PQo&_nc_oc=Adp45eiZ1iHFkz8ycDo3wq2HeU4kHpIhoEfJUWp2OF6k23vAWZRm2zjeE8b_Dh8LvrM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XqpeEIVg-Z3wHVrywsFe8bINLTCi-2evNqFxz6SiOng&oe=6A26C090"}, {"file_name": "screens.png", "id": "771101150621784", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57569471_771101160621783_7591652676362700724_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bzb9dczqyYYQ7kNvwHeD9_7&_nc_oc=AdqFyAuuFS7mLrtWbNjIWevg4kWDFi4xUQJnd1nmyfsTyn9_PyCfadeK00isyNRMW64&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_L4jhBS2ISlQdQ0h8emIxHL1UJehwKjSH-8Dft-6h96g&oe=6A26E220"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Outcasts of Dungeon Magic World Rogue Simulator", "keywords": [], "long_description": "Being in the role of a brave wanderer, help dwarfs to defend their kingdom fortress from a rampaging mob of beastly invaders. Captured dwarfs need help, and they have something to offer you as a reward.\nBattle enemies through a story-based campaign across dungeon and evolve your combat skills to achieve better results.\nFeatures:\n- Procedurally generated dungeons \u2013 Twisting passages, long halls and wide-open chambers all need a hero to clear them.\n- Story-based Campaign \u2013 Fend off monsters across acts to discover the mysterious power behind their relentless assaults.\n- Companion System - Free and protect allies from captivity and use their combat power to your advantage.\n- 9 Different Enemies \u2013 Including scavengers, ghouls and a whole bunch of ugly orcs.", "short_description": "It is a third person fantasy action game, where in the role of a brave wanderer, help dwarfs to defend their kingdom fortress from a rampaging mob of beastly invaders."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midnight.works/vr/privacy.html", "developer_terms_of_service_url": "https://midnight.works/terms.html", "publisher_name": "Midnight Games", "support_website_url": null, "website_url": "https://midnight.works/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "RPG", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1757710791255967"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5481602405242201", "version": "1.11"}, "id": "659294689242116", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5462304183838690", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5481602405242201"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "659294689242116"}]}, "change_log": null, "created_date": 1666180693, "id": "5481602405242201", "version": "1.11", "versi
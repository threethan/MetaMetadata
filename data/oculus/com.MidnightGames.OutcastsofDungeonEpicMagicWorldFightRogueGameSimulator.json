FNz23EHfKIQ7kNvwEQIYwr&_nc_oc=AdrP7H1wVAC0vTSQFAjIKfZPFNDb7QynXaPKDk_fyaPKVPee6mbSwV0xVnE12GS8W88&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3193lHktmU0zUn_CSX04AVO_X08yDX6ozqMXNq3NlVUw&oe=69D50390"}, {"file_name": "screens.png", "id": "771101150621784", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569471_771101160621783_7591652676362700724_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RzIcRqiMPWcQ7kNvwHsU-OF&_nc_oc=AdruDB8sAqO1rENlIk_fIs421kyeXmOAtOf0UJ0IBe-8hqUmGmOspbzh0mzNk1t5sBA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2c22aegMc5Hy0ruBl57IDiqu7NWpmLRiIWrxmIJxO6ug&oe=69D4ECE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Outcasts of Dungeon Magic World Rogue Simulator", "keywords": [], "long_description": "Being in the role of a brave wanderer, help dwarfs to defend their kingdom fortress from a rampaging mob of beastly invaders. Captured dwarfs need help, and they have something to offer you as a reward.\nBattle enemies through a story-based campaign across dungeon and evolve your combat skills to achieve better results.\nFeatures:\n- Procedurally generated dungeons \u2013 Twisting passages, long halls and wide-open chambers all need a hero to clear them.\n- Story-based Campaign \u2013 Fend off monsters across acts to discover the mysterious power behind their relentless assaults.\n- Companion System - Free and protect allies from captivity and use their combat power to your advantage.\n- 9 Different Enemies \u2013 Including scavengers, ghouls and a whole bunch of ugly orcs.", "short_description": "It is a third person fantasy action game, where in the role of a brave wanderer, help dwarfs to defend their kingdom fortress from a rampaging mob of beastly invaders."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midnight.works/vr/privacy.html", "developer_terms_of_service_url": "https://midnight.works/terms.html", "publisher_name": "Midnight G
700724_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLpD0VyHXLwQ7kNvwFtqxkC&_nc_oc=AdrrdL2r85_-8AucbGIi0Pz1eq_r66go4gzQnPPIvrZcM1BmtzzzqmbaKBJ3RPxDXoI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67kYJzeFmC1EYKDmfS25jQ6cUkLhGJrMDJU_JyXwY_HQ&oe=6A1EF920"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Outcasts of Dungeon Magic World Rogue Simulator", "keywords": [], "long_description": "Being in the role of a brave wanderer, help dwarfs to defend their kingdom fortress from a rampaging mob of beastly invaders. Captured dwarfs need help, and they have something to offer you as a reward.\nBattle enemies through a story-based campaign across dungeon and evolve your combat skills to achieve better results.\nFeatures:\n- Procedurally generated dungeons \u2013 Twisting passages, long halls and wide-open chambers all need a hero to clear them.\n- Story-based Campaign \u2013 Fend off monsters across acts to discover the mysterious power behind their relentless assaults.\n- Companion System - Free and protect allies from captivity and use their combat power to your advantage.\n- 9 Different Enemies \u2013 Including scavengers, ghouls and a whole bunch of ugly orcs.", "short_description": "It is a third person fantasy action game, where in the role of a brave wanderer, help dwarfs to defend their kingdom fortress from a rampaging mob of beastly invaders."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midnight.works/vr/privacy.html", "developer_terms_of_service_url": "https://midnight.works/terms.html", "publisher_name": "Midnight Games", "support_website_url": null, "website_url": "https://midnight.works/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "RPG"
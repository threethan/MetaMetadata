6h-mNEDiAbS_0mb1g&oe=69C916D3"}, {"file_name": "screens \u2013 4.png", "id": "439126458253242", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001697_439126464919908_1939579221717236708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dGIWgAH5esQ7kNvwGpc_9B&_nc_oc=AdotPak7oDtv6JJRQGzP1ETwT9_9U6GL-Mh62RcPmbKTouEmYSbTZQgPJpNnVqDC2O8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyOrrwD4PxR92CpgBZN-GjldYwbkIYyWvY3UpLqCd8IPA&oe=69C92610"}, {"file_name": "screens.png", "id": "771101150621784", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569471_771101160621783_7591652676362700724_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kY5zHJRWRWsQ7kNvwEdatN_&_nc_oc=AdqdicBFjYRqhJYM8Kbq-vdFN-_qWGMrPM90yjEDtXDaPUr-xThU_wkVNNiR-IDO_sM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxhw91EfamQe1Tjy6DhL9u2znFvXWmCRXXjnTlXXtgh7A&oe=69C90F60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Outcasts of Dungeon Magic World Rogue Simulator", "keywords": [], "long_description": "Being in the role of a brave wanderer, help dwarfs to defend their kingdom fortress from a rampaging mob of beastly invaders. Captured dwarfs need help, and they have something to offer you as a reward.\nBattle enemies through a story-based campaign across dungeon and evolve your combat skills to achieve better results.\nFeatures:\n- Procedurally generated dungeons \u2013 Twisting passages, long halls and wide-open chambers all need a hero to clear them.\n- Story-based Campaign \u2013 Fend off monsters across acts to discover the mysterious power behind their relentless assaults.\n- Companion System - Free and protect allies from captivity and use their combat power to your advantage.\n- 9 Different Enemies \u2013 Including scavengers, ghouls and a whole bunch of ugly orcs.", "short_description": "It is a third person fantasy action game, where in the role of a brave wanderer, help dwarfs to defend their kingdom fortress from a rampaging mob of beastly invaders."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midnight.works/vr/privacy.html", "developer_terms_of_service_url": "https://midnight.works/terms.html", "publisher_name": "Midnight Games", "support_website_url": null, "website_url": "https://midnight.works/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "RPG", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1757710791255967"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422395_1785755378477765_2892380775835781063_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkuKHvnr6SQQ7kNvwHtQNv1&_nc_oc=AdqJYKup3FKpwGIBn9a2usEb6IbNLe8UnucM8czS2i1fym-Le3OqWKNbclmuhggWvn0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx6xg69Exn6R02m-SVKXTtdro9zjjllblS4vNDHNWJnEg&oe=69C92341"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Outcasts of Dungeon Magic World Rogue Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1672956000, "lastRevision": {"nodes": [{"id": "5462304270505348", "release_type": "SCHE
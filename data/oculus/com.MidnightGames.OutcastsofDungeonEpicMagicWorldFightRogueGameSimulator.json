uluscdn.com/v/t64.5771-25/39001697_439126464919908_1939579221717236708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_djSJT-E38Q7kNvwFSNIgp&_nc_oc=AdlYIPXlDQ1m9CdIMFcpXqN4I7ByC-s-ZG6hkwMOw_nipzplEQaLFbZUfatfnrykPKI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsvNh3C1EpbgHDnineeN620GXcmuM69nwvk6Ke2eV4HSA&oe=69A04790"}, {"file_name": "screens.png", "id": "771101150621784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569471_771101160621783_7591652676362700724_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuoCHsgJBFoQ7kNvwFzS0oc&_nc_oc=Adm6AD1SYOu3CdU5VbL8VftMSfPNivzlhl0fMCuLDEN42CpMTE89j0IkNcNZmEF4AYU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsI9AhrvU9yJNNlxcBvXsHxCwWhO_ZVrIC_Z2pAT7E_MQ&oe=69A030E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Outcasts of Dungeon Magic World Rogue Simulator", "keywords": [], "long_description": "Being in the role of a brave wanderer, help dwarfs to defend their kingdom fortress from a rampaging mob of beastly invaders. Captured dwarfs need help, and they have something to offer you as a reward.\nBattle enemies through a story-based campaign across dungeon and evolve your combat skills to achieve better results.\nFeatures:\n- Procedurally generated dungeons \u2013 Twisting passages, long halls and wide-open chambers all need a hero to clear them.\n- Story-based Campaign \u2013 Fend off monsters across acts to discover the mysterious power behind their relentless assaults.\n- Companion System - Free and protect allies from captivity and use their combat power to your advantage.\n- 9 Different Enemies \u2013 Including scavengers, ghouls and a whole bunch of ugly orcs.", "short_description": "It is a third person fantasy action game, where in the role of a brave wanderer, help dwarfs to defend their kingdom fortress from a rampaging mob of beastly invaders."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midnight.works/vr/privacy.html", "deve
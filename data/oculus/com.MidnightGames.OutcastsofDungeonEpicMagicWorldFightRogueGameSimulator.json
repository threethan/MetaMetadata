Q7kNvwG_SLpL&_nc_oc=AdoC5n58ozEjgBetfsJ4TSI0Owcx1wmXHHqJD467QswrtlH2KUyKRSKC-VPDYC9KOR8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3AGnkzSHLSLKX2uiY_Ui74zWyzpV0-0I1FrdzRlZfZg&oe=6A5B80E0"}, {"file_name": "screens \u2013 2.png", "id": "842212620549862", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75435283_842212627216528_5618517514263293235_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvGLGfuMTPoQ7kNvwH87F3k&_nc_oc=AdqzXKb1Rj8mFbD7VJWcl3OtPwmFJzJBzLa4by5zkfXcv_uQOYbhu8q3PSxi5xHvnf8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYE2s4SnF2L1aD0mpO3fuQfvGuzsuD2RoVaxiRcLXgsA&oe=6A5B6D53"}, {"file_name": "screens \u2013 4.png", "id": "439126458253242", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001697_439126464919908_1939579221717236708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIJLuMXGuHAQ7kNvwFlO3iu&_nc_oc=AdopR91etBXGhb6bN4HauC0LuFPHyBUQtAm6NbPK6pUVq8Vu9l3v2YH2jiW1kG4pkmU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXoDhcCqk9PRoCNiLZaCWiA9_g9X9S2zfR8h0Y2zvU2g&oe=6A5B7C90"}, {"file_name": "screens.png", "id": "771101150621784", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569471_771101160621783_7591652676362700724_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLfVKwAKx5MQ7kNvwFmh5er&_nc_oc=AdpvMXquQlH0Bj9vv1F0VhxMmy8TW48QKdY7eA-OCvDds1R2rlqEDsWN0PzuhSaF0pE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFmJMKg8rirmnyWVbuvt2hOkVSZ6Q1xHiiWYQxhjM22w&oe=6A5B65E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Outcasts of Dungeon Magic World Rogue Simulator", "keywords": [], "long_description": "Being in the role of a brave wanderer, help dwarfs to defend their kingdom fortress from a rampaging mob of beastly invaders. Captured dwarfs need help, and they have something to offer you as a reward.\nBattle enemies through a story-based campaign across dungeon and evolve your combat skills to achieve better results.\nFeatures:\n- Procedurally generated dungeons \u2013 Twisting passages, long halls and wide-open chambers all need a hero to clear them.\n- Story-based Campaign \u2013 Fend off monsters across acts to discover the mysterious power behind their relentless assaults.\n- Companion System - Free and protect allies from captivity and use their combat power to your advantage.\n- 9 Different Enemies \u2013 Including scavengers, ghouls and a whole bunch of ugly orcs.", "short_description": "It is a third person fantasy action game, where in the role of a brave wanderer, help dwarfs to defend their kingdom fortress from a rampaging mob of beastly invaders."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midnight.works/vr/privacy.html", "developer_terms_of_service_url": "https://midnight.works/terms.html", "publisher_name": "Midnight Games", "support_website_url": null, "website_url": "https://midnight.works/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "RPG", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1757710791255967"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422395_1785755378477765_2892380775835781063_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haFY5dUFtfsQ7kNvwFXNL1E&_nc_oc=AdpNMaxevB9eGsHTcApjM-OvSNLqjTtwgxxldgHTa
Q7kNvwFJCafA&_nc_oc=AdqHxLEko5aH2vK1DUjZwiFzWhMk6BX186cQLcIzPoFi-CDkgWrOy2hzi-ojw_onFtM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEiNz7BFMeH4S5VUiC6MXM3idI_KWELY2cCAvyrp3GCQ&oe=6A985E20"}, {"file_name": "screens \u2013 2.png", "id": "842212620549862", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75435283_842212627216528_5618517514263293235_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVShh1xH4CYQ7kNvwGCajBo&_nc_oc=AdoDGd8-iy46XSu1qh6T4sZzb4ZLZ_bttlbh7mWKTSvxo0MMPDnBHqUof4D5oSGT6oI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuG4E1W5OQbJUrTkCEjk_jI4kIPbeLJcsi-QElEuJUxg&oe=6A984A93"}, {"file_name": "screens \u2013 4.png", "id": "439126458253242", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001697_439126464919908_1939579221717236708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3VkJh75NZMQ7kNvwHr14Vh&_nc_oc=Adogr9UucTDiN5PTXDtsRiLOioeTW5msZhwaeg5Za_uea4R4a68VlvIy25Pys2cmLIE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3mB2acqRWGfeMyhoJQ2J_Q5VLp3mjH8Ri57Pa3mrdFQ&oe=6A9859D0"}, {"file_name": "screens.png", "id": "771101150621784", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569471_771101160621783_7591652676362700724_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEYErjaura8Q7kNvwFE8uEB&_nc_oc=AdoK83GTTDPgFRVMqeNRG_X0OZ3inn_ysXJC1Oa8Qqq25v0Hs9jWHh2yKCC7bVCCy3I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKM_5jKt4nikC4hU5-Ze2vQhVcWJPwwXNqQo8ERg2e4ww&oe=6A984320"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Outcasts of Dungeon Magic World Rogue Simulator", "keywords": [], "long_description": "Being in the role of a brave wanderer, help dwarfs to defend their kingdom fortress from a rampaging mob of beastly invaders. Captured dwarfs need help, and they have something to offer you as a reward.\nBattle enemies through a story-based campaign across dungeon and evolve your combat skills to achieve better results.\nFeatures:\n- Procedurally generated dungeons \u2013 Twisting passages, long halls and wide-open chambers all need a hero to clear them.\n- Story-based Campaign \u2013 Fend off monsters across acts to discover the mysterious power behind their relentless assaults.\n- Companion System - Free and protect allies from captivity and use their combat power to your advantage.\n- 9 Different Enemies \u2013 Including scavengers, ghouls and a whole bunch of ugly orcs.", "short_description": "It is a third person fantasy action game, where in the role of a brave wanderer, help dwarfs to defend their kingdom fortress from a rampaging mob of beastly invaders."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midnight.works/vr/privacy.html", "developer_terms_of_service_url": "https://midnight.works/terms.html", "publisher_name": "Midnight Games", "support_website_url": null, "website_url": "https://midnight.works/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "RPG", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1757710791255967"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422395_1785755378477765_2892380775835781063_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFLMXfifNnYQ7kNvwGDE2-H&_nc_oc=AdpG9ku89Hykp7WGDIxixzUa-7WJt10yR-PeGqGy-
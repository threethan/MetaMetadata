nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv9E5z3i1jcDZGompdzStgATP1C0fpgkLDC13VkmnSYbA&oe=69A2F931"}, {"file_name": "1.png", "id": "645364133986481", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982709_645364137319814_4246812975223359293_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIqIhmOzrh0Q7kNvwH_LyYb&_nc_oc=AdkrU6__kR9JmIJwFRQtj4OVTHnmSW2i37-w6DfFykPyChWu9xO9YKQl_VeVLM3LDGI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsYICHzhn6lZr6HuhyCK5zKbE45UwgzoExMb3aN2TGJkw&oe=69A2F578"}, {"file_name": "4.png", "id": "174394518564426", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001691_174394521897759_6020770035674439214_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSD9r7s3tJwQ7kNvwHtWGTO&_nc_oc=AdnyHRHjY02hP6hxHp-OQWbB-FRgEy_2KZrZzu7cMxdhD35SniF1XpvhKxMI6atayEQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftv2RMS3RqN3xd_adWypwBo5z5Xn_KwJqq9-9KecS7WEw&oe=69A2D12F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "152283524306145", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982642_152283527639478_7679354497362835353_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfLfq9oCI1kQ7kNvwHsHreA&_nc_oc=Adl7MV72rPE7CVXjttGJxO3OTuq7-LqlqEpSkCebLWQPp32USR8rqAVMdKHWqagg3yk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvrUhjOXggjnjdXQPbsVdR1Qb4mlXSFoW6Vd3-4TST2Ug&oe=69A2D421"}, "display_name": "Garage Bang", "keywords": [], "long_description": "Gioco sparatutto in prima persona frenetico, in garage Bang devi sparare a bersagli in un'ampia variet\u00e0 di stage.\nTutti i bersagli hanno un design a tema cartoon in pixel art e non-violenti. \n\nOgni stage ha un obiettivo diverso, che viene spiegato all'inizio del livello. Si va dal semplice tiro al bersaglio (evitando le bombe) allo sparare ai cattivi (evitando di sparare ai civili), o sparare a specifici bersagli colorati, e cos\u00ec via\n\nCARATTERISTICHE:\n- 28 stage\n- Modalit\u00e0 Classica e Follia\n- Musica di sottofondo diversa a seconda del livello per tenerti concentrato nel gioco\n- Puoi sparare e distruggere tutti gli oggetti nella stanza (questo allontana lo stress)\n\nSei pronto a raggiungere il punteggio pi\u00f9 alto possibile in questa entusiasmante esperienza di tiro?", "short_description": "Preparati per un'emozionante sfida di tiro al bersaglio!"}, {"images": {"nodes": [{"file_name": "portrait_coverart.png", "id": "3374506842766840", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035428_3374506846100173_8011868378582857093_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atL63A9UC68Q7kNvwH1ciX0&_nc_oc=AdmLS0adePAUamrOqhwSIvzUDIeTlrX6TP8vyV5P_WBg_IFnnn0qFLZxgEQaeSis7sQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftZsCIocys7SKTWouuGKS6pmQ5_ph2Rb8f2K6DshiscPg&oe=69A2D35A"}, {"file_name": "landscape_coverart.png", "id": "1297686567452820", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001732_1297686570786153_6881590418655907071_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWwqhuioio8Q7kNvwFQbk5A&_nc_oc=AdmkcgTUVlkTTgpOiXRjEaNEWyPvKXYhNGmoUG6_Uk-kXjZc9nFaS_82bZ5YbZmpyRY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu_ak7ERUVjbth6PFuetYkVQZFUCGJNJOGRJbu_4rkqIw&oe=69A2F71E"}, {"file_name": "logoTransparent.png", "id": "545978171068232", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982678_545978177734898_5580729734115745410_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6khLY5Om4cQ7kNvwElatBi&_nc_oc=AdlwmEdiywVU184pOcTEEOIIchEF6eFr7XKUxHTraURML9JEEJX2xz1VoFspBRo4ogA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvVrWU2trKMu2t_TYeVcqxeOYQdzEpdvBJ1aAACQ1hUeQ&oe=69A2E699"}, {"file_name": "appIcon.png", "id": "533320142343440", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569479_533320149010106_1045257127822412130_n
=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfShk2GMRonjREpG1MgPCg7lXDzEwCNmHwh84z9HsMdg&oe=6AFC77FC"}, {"file_name": "2.png", "id": "3793507540947855", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491821115_3793507544281188_6582022873228987267_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_X3cdBN53IQ7kNvwH46toc&_nc_oc=Ado3VzZWGK79S_2i2n15aNKP1k9rUb972PzwD2p3oEUrwLHnr3aMwRitBw2QqPo6cSY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1qnkkhgqgilC-oLzsChOPS7_cs96oBpwiAMUZG1iPPw&oe=6AFC8E67"}, {"file_name": "4.png", "id": "783326441365809", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314641_783326444699142_4086313771985235987_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0FvH6iMM4UQ7kNvwE1vKvq&_nc_oc=Adp9Xt12SszpsDWBswawmbYNX5KeLsa04_kVbcmbjHlqdYkMVpaBfKfjNRhE3wV2Zww&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRu2QsYY4tgY4ptG64iIy1s-DED6cA619wHysGB8U0D7Q&oe=6AFC7796"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1714914015861751", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491821081_1714914022528417_9206870254763378188_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=010A9N8zfPIQ7kNvwEqZSn1&_nc_oc=AdpaKJH6ocYA0KXGGexMrptABF9nFmFotyTndMuNdrOEXz7catXJn7Cj5kMBx9s5CPI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIRLbaBeuSn1C1fSzjPL4Vz3umdWS6CH3Rtih3-tom4A&oe=6AFC8235"}, "display_name": "Pixel Bang - Pixel Art Shooting Game", "keywords": ["shooting", "gun", "pistol", "pixel", "targets"], "long_description": "In this fast-paced first-person shooter game, you must shoot targets in various stages.\n\nAll targets have a non-violent, pixel-art cartoon design. Each stage has a different objective, explained at the start of each stage. It goes from simple target shooting (and avoiding bombs) to shooting villains (avoiding shooting civilians), or shooting specific color targets, and so on.\n\n# FEATURES:\n- 28 pixel-art stages\n- **Classic** and **Insane** mode\n- Nice background music to keep you focused on shooting\n- You can shoot & smash all objects in the room (push the stress away)\n\nAre you ready to reach the highest score possible in this exciting shooting experience?", "short_description": "Get ready for an exciting shooting experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": "https://xsgames.co/", "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24596953860006373"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823790_1324639261997279_5984646233880729382_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4O8Q_nvEVsQ7kNvwGPH1Yz&_nc_oc=AdrMhTY-xwJTvDPGN3NlMqd667jOIeThPfUN2BSWpF4EeN9az5rrGnjD3wiTNui3APg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREMf-4W1SCgsaPJ79ZIMWCV3n94cF_S29tXkygRDQ8-Q&oe=6AFC5D06"}, "is_concept": false, 
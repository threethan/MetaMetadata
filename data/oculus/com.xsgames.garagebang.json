9293_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVKXGzWsQJcQ7kNvwFvPESz&_nc_oc=Adl6CCYIm0gh9vNoi0p8tdMY85KB8GObfmcZ_M5In2tROImnv7S7orvOWPq9P02lAtE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvZnzqkF32OD7Pu1cneiYozpM3r_T7pbOGKAG19R8M6KQ&oe=699B0C78"}, {"file_name": "4.png", "id": "174394518564426", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001691_174394521897759_6020770035674439214_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46kw81k3M4oQ7kNvwEi4nMa&_nc_oc=AdluYFX6Z3JPVL-b7Wf2D3mb-t_scO0-nza0Hdk55_DRn7N8iABtnjgVEw1Yg1EfOn0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsHz0_TUJeffK_qa8NEP5jT1O9yaF8ONuNA3zKp_ykZ0g&oe=699AE82F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "152283524306145", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982642_152283527639478_7679354497362835353_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fooz9i-_LcwQ7kNvwEiBvxk&_nc_oc=AdkSqV4zRPepFl_EtAQIy25gHmN88x4fQ4P-AJpVE-bQELiS3oGHDLoablPFR0-nk0Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs6K0xhkwpnhBDKLVnS2vjIY381C41UPPLa1rd0a7FnqQ&oe=699AEB21"}, "display_name": "Garage Bang", "keywords": [], "long_description": "Gioco sparatutto in prima persona frenetico, in garage Bang devi sparare a bersagli in un'ampia variet\u00e0 di stage.\nTutti i bersagli hanno un design a tema cartoon in pixel art e non-violenti. \n\nOgni stage ha un obiettivo diverso, che viene spiegato all'inizio del livello. Si va dal semplice tiro al bersaglio (evitando le bombe) allo sparare ai cattivi (evitando di sparare ai civili), o sparare a specifici bersagli colorati, e cos\u00ec via\n\nCARATTERISTICHE:\n- 28 stage\n- Modalit\u00e0 Classica e Follia\n- Musica di sottofondo diversa a seconda del livello per tenerti concentrato nel gioco\n- Puoi sparare e distruggere tutti gli oggetti nella stanza (questo allontana lo stress)\n\nSei pronto a raggiungere il punteggio pi\u00f9 alto possibile in questa entusiasmante esperienza di tiro?", "short_description": "Preparati per un'emozionante sfida di tiro al bersaglio!"}, {"images": {"nodes": [{"file_name": "portrait_coverart.png", "id": "3374506842766840", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035428_3374506846100173_8011868378582857093_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9FX_yQafXnYQ7kNvwGzmuyx&_nc_oc=AdnDTY7_OLyWKUXEh2D8KTXP14qW4s-Esr1zmcbNZ31WCYgVylTE4zDI1fasP807heY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsbi2_JUnpJm3KStoxWNG6WlFJYFre1JnaxVxsIiRaPCg&oe=699AEA5A"}, {"file_name": "landscape_coverart.png", "id": "1297686567452820", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_1297686570786153_6881590418655907071_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDal02AeUJkQ7kNvwEckvaR&_nc_oc=Adl6vuQlV1iWZz22BtJNbwLHOpiNW8lB4BonDxgyMVdPXi248lmMJnoPQnzSj6LU28Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftPCCWdWRyvsgOvGCR-eLzGWCjdEDFWN8qwjSRLh4Ydxw&oe=699B0E1E"}, {"file_name": "logoTransparent.png", "id": "545978171068232", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982678_545978177734898_5580729734115745410_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRZpVAI33H4Q7kNvwE2B6V9&_nc_oc=AdnOqQQjvoqUyJnnB_3XV8tiP0appk9MJzbfSEfbJhvNCZkHwh_X0idNzathNKG9xHk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftuEKMAoKUywngpgjS_2GRbYO9XkTmkXqVo0ZX8aiCSYQ&oe=699AFD99"}, {"file_name": "appIcon.png", "id": "533320142343440", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569479_533320149010106_1045257127822412130_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qz4mLlp0LJEQ7kNvwGdE7RB&_nc_oc=AdlqqymmNJBs7lppS75aXARdE4CueiXvm_hj3pieD1R3Vod9a_MkHGc41FZtihqk4ig&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsGrhPNN8By0yaEB4G166HIaq3lohi2RIoDofU1W_Cqtw&oe=699
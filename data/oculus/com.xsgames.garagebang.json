M1jew&oe=6A8EE9A7"}, {"file_name": "4.png", "id": "783326441365809", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499314641_783326444699142_4086313771985235987_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWN8c0U_jqsQ7kNvwFkMUG1&_nc_oc=AdoN_y_iVbS4p_9L_pWkaxULWstZsDBJRfIvsQ6FRFD7RX9W7CAZ2gMhFw30WutXb3w&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXm11QYOCSsA59J9B6_IJ5KzNFHtTmSL0109FYK8L1qg&oe=6A8ED2D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1714914015861751", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491821081_1714914022528417_9206870254763378188_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKhsupR_OYQQ7kNvwH3QrRB&_nc_oc=AdrXVL2K5KLdn2KFHkiJSUOdZKxIa1FG5qx3fpv0rR_QYWXqk2ru5JGBvZt2W1D80DQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErse3PqkHg-HcaB0xTIAioeyy_zqZDTxSdOxF_ae0uPA&oe=6A8EDD75"}, "display_name": "Pixel Bang - Pixel Art Shooting Game", "keywords": ["shooting", "gun", "pistol", "pixel", "targets"], "long_description": "In this fast-paced first-person shooter game, you must shoot targets in various stages.\n\nAll targets have a non-violent, pixel-art cartoon design. Each stage has a different objective, explained at the start of each stage. It goes from simple target shooting (and avoiding bombs) to shooting villains (avoiding shooting civilians), or shooting specific color targets, and so on.\n\n# FEATURES:\n- 28 pixel-art stages\n- **Classic** and **Insane** mode\n- Nice background music to keep you focused on shooting\n- You can shoot & smash all objects in the room (push the stress away)\n\nAre you ready to reach the highest score possible in this exciting shooting experience?", "short_description": "Get ready for an exciting shooting experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XS
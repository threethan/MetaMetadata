nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afsobh4zzawWXZJsVSZF7IJaZqbiQ-YICiXsrUjVMh7sFA&oe=69A1A7B1"}, {"file_name": "1.png", "id": "645364133986481", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982709_645364137319814_4246812975223359293_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIqIhmOzrh0Q7kNvwHLIJKd&_nc_oc=AdlMBRxdsX0cRhGqF0kZWmr4zOjvNbz0yHvzBjp1VU9mzpHzJH3ybkGndSA1bjA1Ujs&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsKLfr0CHmUGY2aTaVMMfG358uE8zRibgPWmJ_mIMitcw&oe=69A1A3F8"}, {"file_name": "4.png", "id": "174394518564426", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39001691_174394521897759_6020770035674439214_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFVx77metzgQ7kNvwFQr8VQ&_nc_oc=AdlNoy1T5Dn4AaHt4qdjqnxoc8FJgCfg8KaIyfgf_XkJOpCjwart3f1Xp9vb7FujwHQ&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afv53w3xdWLMB8-aW0VlG3cv999owgr3Z1Kn414UwKghnw&oe=69A17FAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "152283524306145", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982642_152283527639478_7679354497362835353_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfLfq9oCI1kQ7kNvwGuF_VW&_nc_oc=AdlB7rN5MNa02XPsAGAW-9I6TsA935icI0TE9KHVttbR9-7XoQd2VhRI8VhG908TkZo&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuDZlToBE4N1PSoTn8bbmbS4-uVR9be0GpgwPvOKOiqGA&oe=69A182A1"}, "display_name": "Garage Bang", "keywords": [], "long_description": "Gioco sparatutto in prima persona frenetico, in garage Bang devi sparare a bersagli in un'ampia variet\u00e0 di stage.\nTutti i bersagli hanno un design a tema cartoon in pixel art e non-violenti. \n\nOgni stage ha un obiettivo diverso, che viene spiegato all'inizio del livello. Si va dal semplice tiro al bersaglio (evitando le bombe) allo sparare ai cattivi (evitando di sparare ai civili), o sparare a specifici bersagli colorati, e cos\u00ec via\n\nCARATTERISTICHE:\n- 28 stage\n- Modalit\u00e0 Classica e Follia\n- Musica di sottofondo diversa a seconda del livello per tenerti concentrato nel gioco\n- Puoi sparare e distruggere tutti gli oggetti nella stanza (questo allontana lo stress)\n\nSei pronto a raggiungere il punteggio pi\u00f9 alto possibile in questa entusiasmante esperienza di tiro?", "short_description": "Preparati per un'emozionante sfida di tiro al bersaglio!"}, {"images": {"nodes": [{"file_name": "portrait_coverart.png", "id": "3374506842766840", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39035428_3374506846100173_8011868378582857093_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhjVp-Q7RV8Q7kNvwE5s262&_nc_oc=AdlYm7gPQZzWX8RMqhTR7E-neVvQsI-s50ssSP7TcSl29H4DPFqomxA6DfWpLB9b1GI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afu4llcZimVfKjHKAQk79z8S8UTZqmZfLtfrLWUbCnjgaA&oe=69A181DA"}, {"file_name": "landscape_coverart.png", "id": "1297686567452820", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39001732_1297686570786153_6881590418655907071_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dn9VbEXilLkQ7kNvwFQN9wy&_nc_oc=AdlYhck-Gx0SRZHzB-4doul8gs0XVrqc1BCMRHSlXvk05pTkfKNmUwtXzAlX2wSYv_E&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aful8P1fBj6iMwtUrOIOp_AKjlmBlUCRHCvQPapQZFHG0w&oe=69A1A59E"}, {"file_name": "logoTransparent.png", "id": "545978171068232", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982678_545978177734898_5580729734115745410_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6khLY5Om4cQ7kNvwGzFOA7&_nc_oc=AdngAPJ8GPD3q6a8sR9n423KiuwAh__z2Z82T6_RIZF4X2iUK11oP3TZMKbEBWeAAlE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afv72EbihqTXTZOQxTJ-yFW5mnvQGu78ha5m6rSI-x0GjQ&oe=69A19519"}, {"file_name": "appIcon.png", "id": "533320142343440", "image_type": "APP_IMG_ICON", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/57569479_533320149010106_1045257127822412130_n
=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUL1daHZ-8shz7jPTMjQe93ymGCmM5xAbqSpMqex-UrAw&oe=6B0EECFC"}, {"file_name": "2.png", "id": "3793507540947855", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821115_3793507544281188_6582022873228987267_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87MRJBULmfEQ7kNvwEud2RS&_nc_oc=Adq24LgPm2FJgSUWbnRKmSI24qmfY4INt5A9pb1VVyUndwhVTCPMfD8lpBy5cjV8qN4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV7CJZyKwms8-nBKQ0ITqTpg-EBu2tDCEQ2OnI1RSLChA&oe=6B0F0367"}, {"file_name": "4.png", "id": "783326441365809", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314641_783326444699142_4086313771985235987_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5AfKOf-7mIQ7kNvwFL4SIl&_nc_oc=Adq9gL-u1QYt-HNY6jGTXRXPBSCJ4C40zdSn4MCZjOeNyTMLo2svxUgLX0bwW-EI-7Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVm1oWUZjzFLz2jSxi3GuXNOv2Dme2oHVDX2suepUHc0A&oe=6B0EEC96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1714914015861751", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821081_1714914022528417_9206870254763378188_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gVjITzwAp0Q7kNvwGaPRUA&_nc_oc=Adq6EP_xBlkngs0LPiUh2OOq22_v7RWrqN5erJyPIgMLVBC1fOKl-ElbrxzLniJER7M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWbyHaXNWTLUkU0fRQ5b0HR1ppjhroD7pISD3dEz0vXPA&oe=6B0EF735"}, "display_name": "Pixel Bang - Pixel Art Shooting Game", "keywords": ["shooting", "gun", "pistol", "pixel", "targets"], "long_description": "In this fast-paced first-person shooter game, you must shoot targets in various stages.\n\nAll targets have a non-violent, pixel-art cartoon design. Each stage has a different objective, explained at the start of each stage. It goes from simple target shooting (and avoiding bombs) to shooting villains (avoiding shooting civilians), or shooting specific color targets, and so on.\n\n# FEATURES:\n- 28 pixel-art stages\n- **Classic** and **Insane** mode\n- Nice background music to keep you focused on shooting\n- You can shoot & smash all objects in the room (push the stress away)\n\nAre you ready to reach the highest score possible in this exciting shooting experience?", "short_description": "Get ready for an exciting shooting experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": "https://xsgames.co/", "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24596953860006373"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823790_1324639261997279_5984646233880729382_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNZaJzawEeYQ7kNvwHHmcY7&_nc_oc=Adr4ujj5xd1ar0a82Rny7PMGNphTsAhXKR81LP0T8C0a-DrLg8mzSVmKFwSO-8iOVKw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVr-O1BnyUW1jQcx42cbi9jIZp8IWLG34WS1lzvMP9igg&oe=6B0F0A46"}, "is_concept": false, 
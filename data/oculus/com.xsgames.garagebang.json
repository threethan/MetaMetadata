dAzEYAIc0jOs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvq07r4G7bBv-sjn5zqShGjHVUVP1z9O1ySvq5M2tYKZg&oe=69A2D656"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1714914015861751", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821081_1714914022528417_9206870254763378188_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwlUZ63k2kQQ7kNvwFzUp-4&_nc_oc=AdkSJtNZGfd3H9OnCdksqqc6GmI8EvxW6zGw1Qeq1xIXAMOsWNqXQ8bZ7FdwUo8MHLo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afskk4JxZEt0V4M7SRUaiA2xWldFcISPt76GENd6q35j0g&oe=69A2E0F5"}, "display_name": "Pixel Bang - Pixel Art Shooting Game", "keywords": ["shooting", "gun", "pistol", "pixel", "targets"], "long_description": "In this fast-paced first-person shooter game, you must shoot targets in various stages.\n\nAll targets have a non-violent, pixel-art cartoon design. Each stage has a different objective, explained at the start of each stage. It goes from simple target shooting (and avoiding bombs) to shooting villains (avoiding shooting civilians), or shooting specific color targets, and so on.\n\n# FEATURES:\n- 28 pixel-art stages\n- **Classic** and **Insane** mode\n- Nice background music to keep you focused on shooting\n- You can shoot & smash all objects in the room (push the stress away)\n\nAre you ready to reach the highest score possible in this exciting shooting experience?", "short_description": "Get ready for an exciting shooting experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": "https://xsgames.co/", "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781
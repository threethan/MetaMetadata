rareQ&oe=6A85AF27"}, {"file_name": "4.png", "id": "783326441365809", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499314641_783326444699142_4086313771985235987_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FP1_E0Y0gTcQ7kNvwGASE57&_nc_oc=AdovZTHZO_Ies0NvyBW_xNO72TAzn2Z6wGe2A1G-vHdaw2ngqDA2wlVu7WK9hkkEdNw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJ7Hfy8L89llCE4_cj30gx43p2sjXg8QjwqPC86SaQDw&oe=6A859856"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1714914015861751", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491821081_1714914022528417_9206870254763378188_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oP421ijLfcQ7kNvwHb44KS&_nc_oc=AdrzkZLGpbnPuXjhzldEbmfZxUDD8Y4QmRAZQhUea8YNbojp9VAuu5L9-zqL8BL-YEo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVzHb9iCq3Ub7HUuI2dtJtz-oQ1IQl_75P3ga6HbMbyQ&oe=6A85A2F5"}, "display_name": "Pixel Bang - Pixel Art Shooting Game", "keywords": ["shooting", "gun", "pistol", "pixel", "targets"], "long_description": "In this fast-paced first-person shooter game, you must shoot targets in various stages.\n\nAll targets have a non-violent, pixel-art cartoon design. Each stage has a different objective, explained at the start of each stage. It goes from simple target shooting (and avoiding bombs) to shooting villains (avoiding shooting civilians), or shooting specific color targets, and so on.\n\n# FEATURES:\n- 28 pixel-art stages\n- **Classic** and **Insane** mode\n- Nice background music to keep you focused on shooting\n- You can shoot & smash all objects in the room (push the stress away)\n\nAre you ready to reach the highest score possible in this exciting shooting experience?", "short_description": "Get ready for an exciting shooting experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XS
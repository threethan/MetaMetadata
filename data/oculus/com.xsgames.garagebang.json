A7DC627"}, {"file_name": "4.png", "id": "783326441365809", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499314641_783326444699142_4086313771985235987_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GjupbNu4AOUQ7kNvwHu8WCX&_nc_oc=AdqXosZYHcS5YNAOlPy8vcGzcR9tIFsdNeIuZePmewhEG4GwNXBMIrDqB1yPxZLL9_M&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYPRJKqPevF85_Lv0SWqjJzjyFmXEAyx1F5hAepVVEKw&oe=6A7DAF56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1714914015861751", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491821081_1714914022528417_9206870254763378188_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1iO1c3eCckQ7kNvwFJNR46&_nc_oc=Adr46Hsd2Kf-EyMU352vJmNLnwEOb8NfI3EOPiJw48Mcth-0526caQF8JxO8Znw-LXU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvAYPQyVTUm7n3ewaKwz84zq9p5pf5pPO54BB3ZD8jpw&oe=6A7DB9F5"}, "display_name": "Pixel Bang - Pixel Art Shooting Game", "keywords": ["shooting", "gun", "pistol", "pixel", "targets"], "long_description": "In this fast-paced first-person shooter game, you must shoot targets in various stages.\n\nAll targets have a non-violent, pixel-art cartoon design. Each stage has a different objective, explained at the start of each stage. It goes from simple target shooting (and avoiding bombs) to shooting villains (avoiding shooting civilians), or shooting specific color targets, and so on.\n\n# FEATURES:\n- 28 pixel-art stages\n- **Classic** and **Insane** mode\n- Nice background music to keep you focused on shooting\n- You can shoot & smash all objects in the room (push the stress away)\n\nAre you ready to reach the highest score possible in this exciting shooting experience?", "short_description": "Get ready for an exciting shooting experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "sup
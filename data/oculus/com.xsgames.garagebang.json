nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfucqwN7u3ObuuJaR8FF0teWI-ZGvomt5vhT-_S8J2KBlg&oe=69A05631"}, {"file_name": "1.png", "id": "645364133986481", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982709_645364137319814_4246812975223359293_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcoLJixc8c8Q7kNvwGcCjUB&_nc_oc=AdmlrJWnWKjO2_AMEeaVs0uESAslxemcL7AhWyXR0HTLfFAmmnGUsmtV8NOoTgMuqZw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv_28QTPuTygsP1nSMZ3LHfKpKyclotPMS8rKIKZ8zHiA&oe=69A05278"}, {"file_name": "4.png", "id": "174394518564426", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001691_174394521897759_6020770035674439214_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFVx77metzgQ7kNvwGwqkkD&_nc_oc=AdlFlqk9eaN8jCvVWkifFBYPuw_PjdZeSmG8g2u2IPFFqd0IXwH7F3pNup94jFYJKD0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftLyaruYJGzAM5Wb6vITidxKWckh_GfUhk1QfZ-Zxawaw&oe=69A02E2F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "152283524306145", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982642_152283527639478_7679354497362835353_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKgSE1ZlqYcQ7kNvwHauRV-&_nc_oc=AdkFvOTYGpftqIG6HYhtCZq34C1om-x8T0NdU0XFDlXUdNzo_0TpUgal257RhC47KIo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuayYavRLMSsMVRYnNLI5gehYEBDBWh1FE16OmwvhEs2A&oe=69A03121"}, "display_name": "Garage Bang", "keywords": [], "long_description": "Gioco sparatutto in prima persona frenetico, in garage Bang devi sparare a bersagli in un'ampia variet\u00e0 di stage.\nTutti i bersagli hanno un design a tema cartoon in pixel art e non-violenti. \n\nOgni stage ha un obiettivo diverso, che viene spiegato all'inizio del livello. Si va dal semplice tiro al bersaglio (evitando le bombe) allo sparare ai cattivi (evitando di sparare ai civili), o sparare a specifici bersagli colorati, e cos\u00ec via\n\nCARATTERISTICHE:\n- 28 stage\n- Modalit\u00e0 Classica e Follia\n- Musica di sottofondo diversa a seconda del livello per tenerti concentrato nel gioco\n- Puoi sparare e distruggere tutti gli oggetti nella stanza (questo allontana lo stress)\n\nSei pronto a raggiungere il punteggio pi\u00f9 alto possibile in questa entusiasmante esperienza di tiro?", "short_description": "Preparati per un'emozionante sfida di tiro al bersaglio!"}, {"images": {"nodes": [{"file_name": "portrait_coverart.png", "id": "3374506842766840", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035428_3374506846100173_8011868378582857093_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhjVp-Q7RV8Q7kNvwG5NszL&_nc_oc=AdmLsS13Wyj8il0o5zFcGwlPtsdqifAwjGIKwcjaK1sq2l52U9ViT__CcOQwpEEdlok&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftOeECu_LxH7m_biBbk3AoGl64SQGq8ZoVoA3FlBPIoFg&oe=69A0305A"}, {"file_name": "landscape_coverart.png", "id": "1297686567452820", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001732_1297686570786153_6881590418655907071_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dn9VbEXilLkQ7kNvwHJdxW6&_nc_oc=Adkiyi2Id5KwEgv2uDSu1K9FvY2L9KbhTWIRinBmCjP1D1ZkTpNmZcXspiqH78AMOj8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsZh25AokHevWTt_-uJNihhthbmg9te8bOXbKgG6fBB3Q&oe=69A0541E"}, {"file_name": "logoTransparent.png", "id": "545978171068232", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982678_545978177734898_5580729734115745410_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6khLY5Om4cQ7kNvwEoPo55&_nc_oc=AdnqSWV8NTcMU19Hvu3Atq4wLeEYvTVTGskkI7LmThamUK5ZCydItzO7vOXqtj9XERA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftQezkS4rHRcz6bCixg71X_NndHQ4MTfvnSjIznPhfyLw&oe=69A04399"}, {"file_name": "appIcon.png", "id": "533320142343440", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569479_533320149010106_1045257127822412130_n
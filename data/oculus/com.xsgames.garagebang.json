9293_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uiItzh1_8IQ7kNvwFpecG2&_nc_oc=Adn4-wekqY_8-GWjL4xEslhPvzueObX4dCV757qF_E5O4TZDZqbSz3JBxoXucSKXKEc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afuul4ZCXkcfKJPZxVPeh-u4uRmYaFmJ5yrm9Hp_tkgQ0Q&oe=69986978"}, {"file_name": "4.png", "id": "174394518564426", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001691_174394521897759_6020770035674439214_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxYZshqAMdAQ7kNvwHtWCm7&_nc_oc=AdlGA-pROn0CGQYWd7hDaJE0MqJki6KXuXLI0UTPrKgTtJ-xF60t4abWcU5hrVd8c9w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvKxpveaBCSBYuDYl7pE4KI4Gi5jF57E5zqdIn5hnQYtg&oe=6998452F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "152283524306145", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982642_152283527639478_7679354497362835353_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D46iMM_jpkcQ7kNvwH3HQ1W&_nc_oc=Adl2AuaGw-L6e6hDikeJe5YUh99J1LlbFR-hP17iNXFoXqTSSXo00qr4nSlXHPDdBMs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuYNuig3tLXBSb8cKV57IXizwvDArKpJYHN0MOSYgYFwA&oe=69984821"}, "display_name": "Garage Bang", "keywords": [], "long_description": "Gioco sparatutto in prima persona frenetico, in garage Bang devi sparare a bersagli in un'ampia variet\u00e0 di stage.\nTutti i bersagli hanno un design a tema cartoon in pixel art e non-violenti. \n\nOgni stage ha un obiettivo diverso, che viene spiegato all'inizio del livello. Si va dal semplice tiro al bersaglio (evitando le bombe) allo sparare ai cattivi (evitando di sparare ai civili), o sparare a specifici bersagli colorati, e cos\u00ec via\n\nCARATTERISTICHE:\n- 28 stage\n- Modalit\u00e0 Classica e Follia\n- Musica di sottofondo diversa a seconda del livello per tenerti concentrato nel gioco\n- Puoi sparare e distruggere tutti gli oggetti nella stanza (questo allontana lo stress)\n\nSei pronto a raggiungere il punteggio pi\u00f9 alto possibile in questa entusiasmante esperienza di tiro?", "short_description": "Preparati per un'emozionante sfida di tiro al bersaglio!"}, {"images": {"nodes": [{"file_name": "portrait_coverart.png", "id": "3374506842766840", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035428_3374506846100173_8011868378582857093_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7EQFgyWq_EQ7kNvwHixxKp&_nc_oc=Adl2ql5dRnbSsrTY1h0FWQn-sdzx0g9iEMfsBKu8P2LrPQrW3ItH1al0NIeihMjHCOI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftGvceSf8eaJfuK86x-9frSj8E3xexUUkVmu22Hxj_jbQ&oe=6998475A"}, {"file_name": "landscape_coverart.png", "id": "1297686567452820", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001732_1297686570786153_6881590418655907071_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydV3I6cz9NUQ7kNvwGXJS2S&_nc_oc=Adk16cfaCfwnxsnmJgHKH33EtgYMN20oNs_tDBJIY3CP_d33G018clDxkH0V7GVfHMI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aft3KLQ3B1TfFqbm7INS-TZ3Z-zcztrA4N0IyQN0MD8j8g&oe=69986B1E"}, {"file_name": "logoTransparent.png", "id": "545978171068232", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982678_545978177734898_5580729734115745410_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRZpVAI33H4Q7kNvwGOHU3C&_nc_oc=AdnPURzJep8JJAgIzc3HuByhQuir1x_qXAyauavRHXtiV04vxZ1WO4pwFnZPI1Rlw0Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsuBHQ-Jd7TpG7O5Or1mneqfiqQOx5UZxRac52dJYBkAQ&oe=69985A99"}, {"file_name": "appIcon.png", "id": "533320142343440", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569479_533320149010106_1045257127822412130_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qz4mLlp0LJEQ7kNvwGgJ50-&_nc_oc=AdlZGL08HHOzOIm9SYPTbo9sqeQOeNbrKsi7TpFMFxeJ1J5X_xIEKtsSsoX34XBhc5o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft2kKd8lEWg0dG3FlJ8YiL14lAy7RVPF4gK8vziVp6RNw&oe=699
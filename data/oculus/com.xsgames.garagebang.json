=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3o35xmBoJP9E6Gt0gS-hNieeav08IHXD8fYIbfHDVqA&oe=6B08557C"}, {"file_name": "2.png", "id": "3793507540947855", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821115_3793507544281188_6582022873228987267_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3ireojkx_MQ7kNvwGQK6ep&_nc_oc=AdqK2YG5GIxzW33yx41BXUTO3q9Vlb2RU_4aLWT4U6AYTR6gRkN58m_JIPXKjHMRpsE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSh1iZ2QPliR2CHNQjsNOpQNuHv0YT-tBSLf9KJt73I-Q&oe=6B086BE7"}, {"file_name": "4.png", "id": "783326441365809", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499314641_783326444699142_4086313771985235987_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xu8AoSljdGAQ7kNvwHmswT6&_nc_oc=AdryhUQ50wgxSzCgNneMB6r824VH_YTHOr77ZjHTV58JRwJSlrt11XxuZdcMp7bap9U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTX8hYbooUm1e-PRa1m_6D_91G5XYYMYe6d2thRB5kK8A&oe=6B085516"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1714914015861751", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821081_1714914022528417_9206870254763378188_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAHCVPD9-VkQ7kNvwF0N0zk&_nc_oc=AdqFH5aA6lnBAANpMHGz-6aYdaw-EwbqkD9lZshLg9RrLHUsxueY19iZKsTGFo4mqxE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTGeFrUISlPNXPMBW8nBdUKbNordcLpMm9ztfKcn7L2Q&oe=6B085FB5"}, "display_name": "Pixel Bang - Pixel Art Shooting Game", "keywords": ["shooting", "gun", "pistol", "pixel", "targets"], "long_description": "In this fast-paced first-person shooter game, you must shoot targets in various stages.\n\nAll targets have a non-violent, pixel-art cartoon design. Each stage has a different objective, explained at the start of each stage. It goes from simple target shooting (and avoiding bombs) to shooting villains (avoiding shooting civilians), or shooting specific color targets, and so on.\n\n# FEATURES:\n- 28 pixel-art stages\n- **Classic** and **Insane** mode\n- Nice background music to keep you focused on shooting\n- You can shoot & smash all objects in the room (push the stress away)\n\nAre you ready to reach the highest score possible in this exciting shooting experience?", "short_description": "Get ready for an exciting shooting experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": "https://xsgames.co/", "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24596953860006373"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823790_1324639261997279_5984646233880729382_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlGbJsfnrYQQ7kNvwFJHN9F&_nc_oc=Adq9AnGbSPlVodk35n_kSt-33JXyTUYap9-9IUoDddFRa4YObCKL3RpB-OghKjEa274&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkDh_AHmk6M_yEXHvcHpWutgqv4qi-ZTM48H7PaM8Otg&oe=6B0872C6"}, "is_concept": false, 
7C5F7"}, {"file_name": "1.png", "id": "133236666410618", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974813_133236669743951_3521471306175933903_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCwXUTGJStYQ7kNvwFMgV3f&_nc_oc=AdoXWkYS9mXO64bmxLOWB8YtYP4BlS5k0aXejmVeD1dV-3OhGM0aF09Kqg7EUavtQ8w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBQbb_ZvoJHK5xqZaAgQQl-o5_nJm3O0VMVe7_FTLOIg&oe=6AC79E46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "183098317589933", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974585_183098320923266_7214502441744273375_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TV05h_lkic0Q7kNvwF7_2Hi&_nc_oc=AdqhUS7xROSzwrtoJzuzM0tTyULCm4EOzPoSaP3e4zwBx69RHuMpo1ADIozZ2dsGO8I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOW1nBv1-yARCJ64pEl4K1S-QHY6GpEdF7tPf6Ignjtlg&oe=6AC79C79"}, "display_name": "Garage Bang", "keywords": [], "long_description": "Fast-paced first-person shooter game, you have to shoot targets in a wide variety of stages.\nAll targets have a non-violent, pixel-art cartoon design. Each stage has a different objective, explained at the start of each stage. It goes from simple target shooting (and avoiding bombs) to shooting villains (avoiding shooting civilians), or shooting specific color targets, and so on.\n\nFEATURES:\n- 28 stages\n- Classic and Insane mode\n- Nice background music to keep you focused on shooting\n- You can shoot & smash all objects in the room (push the stress away)\n\nAre you ready to reach the highest score possible in this exciting shooting experience?", "short_description": "Get ready for an exciting shooting experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": "https://xsgames.co/", "website_url": "https://xsgames.co/", "category": null, "c
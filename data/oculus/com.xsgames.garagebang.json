5E037"}, {"file_name": "1.png", "id": "133236666410618", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974813_133236669743951_3521471306175933903_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psay2kgvWoIQ7kNvwFYKajD&_nc_oc=AdqjVZotuFo-0oAsrc8wgnl3e1RYm_rMSrOsowLmVKfA7b18cbHpDoK3eszp0vJsG-Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYLX8lIgOhx3XGh420SkR53j7USlM7NNr4oKZmSEyL_w&oe=6AE5F0C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "183098317589933", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974585_183098320923266_7214502441744273375_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZ8wQnKYy7kQ7kNvwHw_wfT&_nc_oc=AdpaQgoUROuKdoMoRZr2FaK5jdIHFU-Z4UUxBzGT1Qq1UqnEoJ3YDw7uVti_X7qq5f4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQBGOzfMPxvrAhHfAhlpYFQN6G4a_Q1vYRkTinuZ5g7w&oe=6AE5EEF9"}, "display_name": "Garage Bang", "keywords": [], "long_description": "Fast-paced first-person shooter game, you have to shoot targets in a wide variety of stages.\nAll targets have a non-violent, pixel-art cartoon design. Each stage has a different objective, explained at the start of each stage. It goes from simple target shooting (and avoiding bombs) to shooting villains (avoiding shooting civilians), or shooting specific color targets, and so on.\n\nFEATURES:\n- 28 stages\n- Classic and Insane mode\n- Nice background music to keep you focused on shooting\n- You can shoot & smash all objects in the room (push the stress away)\n\nAre you ready to reach the highest score possible in this exciting shooting experience?", "short_description": "Get ready for an exciting shooting experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": "https://xsgames.co/", "website_url": "https://xsgames.co/", "category": null, "c
nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1n6pPG8pWBW2QtP76JfxrMMMptLoFjata80KkQlnqUqw&oe=69F0C1B1"}, {"file_name": "1.png", "id": "645364133986481", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982709_645364137319814_4246812975223359293_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQC4ZlYrP0oQ7kNvwGLP9TN&_nc_oc=AdrH8kjGNntM1saGzHmKPM9BSjxwER6YUA9UWKUu_p8oyTUdlbOW09X5YZEdpIYkbWg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3gyrQ2WKHBmryf4vTYwXRqkn0undXMCiJzH6kYqYhueA&oe=69F0BDF8"}, {"file_name": "4.png", "id": "174394518564426", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001691_174394521897759_6020770035674439214_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFKnFrYRLSAQ7kNvwFDzhMF&_nc_oc=AdpsJ7SBThRKbJoN62wI7jav0VgLbb4sEVWGgXdMBXlMq9oAKPNixEXsANLcXrAb4AE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af07Rdgoz8aNex4C5FhvKcltRmbeM2GahgBEOhXLpE1F1w&oe=69F0D1EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "152283524306145", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982642_152283527639478_7679354497362835353_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MgCcCzQNc8EQ7kNvwH9zCFy&_nc_oc=Adr1NRNAUgTUfyY_TlpoCvRjGr4mia0bPK_qBfwcdZUDqM5BtGjPAH_X51f54biEUyI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2SyfnU8yT5C-eJDODLqALqK-1LlHyQojuqVwETrimrrg&oe=69F09CA1"}, "display_name": "Garage Bang", "keywords": [], "long_description": "Gioco sparatutto in prima persona frenetico, in garage Bang devi sparare a bersagli in un'ampia variet\u00e0 di stage.\nTutti i bersagli hanno un design a tema cartoon in pixel art e non-violenti. \n\nOgni stage ha un obiettivo diverso, che viene spiegato all'inizio del livello. Si va dal semplice tiro al bersaglio (evitando le bombe) allo sparare ai cattivi (evitando di sparare ai civili), o sparare a specifici bersagli colorati, e cos\u00ec via\n\nCARATTERISTICHE:\n- 28 stage\n- Modalit\u00e0 Classica e Follia\n- Musica di sottofondo diversa a seconda del livello per tenerti concentrato nel gioco\n- Puoi sparare e distruggere tutti gli oggetti nella stanza (questo allontana lo stress)\n\nSei pronto a raggiungere il punteggio pi\u00f9 alto possibile in questa entusiasmante esperienza di tiro?", "short_description": "Preparati per un'emozionante sfida di tiro al bersaglio!"}, {"images": {"nodes": [{"file_name": "portrait_coverart.png", "id": "3374506842766840", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035428_3374506846100173_8011868378582857093_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bt6BhNob5xQQ7kNvwFtKI5l&_nc_oc=AdpOaeIsN68uNjclI3dKW_hZ3_KCLTwSM-eRmlArUmu5GHK7uh_5R6hM-fEEvZ8HL08&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1HlXqZSmCTUD04Ep7BsBMh20cDruy7F4RjJIUBbA5cuQ&oe=69F09BDA"}, {"file_name": "landscape_coverart.png", "id": "1297686567452820", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001732_1297686570786153_6881590418655907071_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRwUjCQZf2EQ7kNvwF7KyMt&_nc_oc=Adp3z8yhuuFLiemhM6ebqJ2TqASouxgBbey9SaPDArMKGuDPQDQ_tWdvpbLQmj_mECU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2L4GKLeS_mQMts9Q80332OdFdfCQIMaGlOTt94nMS7Hw&oe=69F0BF9E"}, {"file_name": "logoTransparent.png", "id": "545978171068232", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982678_545978177734898_5580729734115745410_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUNWf49vWjEQ7kNvwEq7zEH&_nc_oc=AdoihvMV1y1mLDrsHAZ233ghfp7Zb8Vwwxojzj1DAXnQj3nscpUOKi9n5SxYPa_LO_4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1xlvr2y9A7KXZ9Dm5p0c5rQJ2F5ju6ZJLECaNxtXw8MA&oe=69F0AF19"}, {"file_name": "appIcon.png", "id": "533320142343440", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_533320149010106_1045257127822412130_n
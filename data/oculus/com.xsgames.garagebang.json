_ohc=Qeds6BrgRdEQ7kNvwGEZyMw&_nc_oc=AdqjKv7A1OoT8qSdbPDDpw6vddLw6TGqAywFQ-z5R2Z4S7bcNqkVJvXLWf9pNvEU9eU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3BCEvZFfUUST6WDjggosJ_Gk6Py7L511e9IzUOcsMIUw&oe=69F1F056"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1714914015861751", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821081_1714914022528417_9206870254763378188_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ni_qn_5889EQ7kNvwFB_JZR&_nc_oc=Adrn-A3ZgjKar1grn5M3QqXuFiqYCPTY_Z9-SRLSJlNrATCgUJFsJ8nacSBJY4JT-5s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2cpvIeGlxdmC_oME3XhpSa6yz-vsRy0cOhHt8eR7zNBw&oe=69F1FAF5"}, "display_name": "Pixel Bang - Pixel Art Shooting Game", "keywords": ["shooting", "gun", "pistol", "pixel", "targets"], "long_description": "In this fast-paced first-person shooter game, you must shoot targets in various stages.\n\nAll targets have a non-violent, pixel-art cartoon design. Each stage has a different objective, explained at the start of each stage. It goes from simple target shooting (and avoiding bombs) to shooting villains (avoiding shooting civilians), or shooting specific color targets, and so on.\n\n# FEATURES:\n- 28 pixel-art stages\n- **Classic** and **Insane** mode\n- Nice background music to keep you focused on shooting\n- You can shoot & smash all objects in the room (push the stress away)\n\nAre you ready to reach the highest score possible in this exciting shooting experience?", "short_description": "Get ready for an exciting shooting experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": "https://xsgames.co/", "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}
om/v/t64.5771-25/499314641_783326444699142_4086313771985235987_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SesNNpjAkl0Q7kNvwEwwqLZ&_nc_oc=Adno3cTLdizFe1QPVXgL0cnQYIkUow3VLySKhgp_sjIQC3Unvw6-wn2K5gGHtMf0Cho&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwmjcwbB41cIe2uoSRo4UuxU5mvoweODbWZQtDhRL_msg&oe=69B156D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1714914015861751", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821081_1714914022528417_9206870254763378188_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wF-2vxMKu9YQ7kNvwEI5n-y&_nc_oc=Adljc0Alg596A1kQrx8Qf7_2_7wEU-ykdHUgykRdOXAShSQqTOUm9I5HjGGJRfFYIIA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyvVHLWjwA6auL9NNEWl5asjsa_b-7n1QBa5Bm_dV8IFQ&oe=69B16175"}, "display_name": "Pixel Bang - Pixel Art Shooting Game", "keywords": ["shooting", "gun", "pistol", "pixel", "targets"], "long_description": "In this fast-paced first-person shooter game, you must shoot targets in various stages.\n\nAll targets have a non-violent, pixel-art cartoon design. Each stage has a different objective, explained at the start of each stage. It goes from simple target shooting (and avoiding bombs) to shooting villains (avoiding shooting civilians), or shooting specific color targets, and so on.\n\n# FEATURES:\n- 28 pixel-art stages\n- **Classic** and **Insane** mode\n- Nice background music to keep you focused on shooting\n- You can shoot & smash all objects in the room (push the stress away)\n\nAre you ready to reach the highest score possible in this exciting shooting experience?", "short_description": "Get ready for an exciting shooting experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": "https://xsgames.co/", "website_url": "https://xsgames.co/", "category": null, "comfort_rat
y5st1Wc-yp1Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsY7vsSN9_0eGXu48yNSk79yyw5wqosl-dXC9eI8gnIJg&oe=699C3ED6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1714914015861751", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821081_1714914022528417_9206870254763378188_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGNTiyRJwU4Q7kNvwHgxEjW&_nc_oc=AdkLmtDcBa47fuSUVjGkgu_foYT9mC8VsL5tDdMpGu4wYi2EmwvoH7P16oD52iA0r2w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsxLyV8UwDF9aaaXYWlOIMbpBFPe6hQ84DwV1aSIIjm7w&oe=699C4975"}, "display_name": "Pixel Bang - Pixel Art Shooting Game", "keywords": ["shooting", "gun", "pistol", "pixel", "targets"], "long_description": "In this fast-paced first-person shooter game, you must shoot targets in various stages.\n\nAll targets have a non-violent, pixel-art cartoon design. Each stage has a different objective, explained at the start of each stage. It goes from simple target shooting (and avoiding bombs) to shooting villains (avoiding shooting civilians), or shooting specific color targets, and so on.\n\n# FEATURES:\n- 28 pixel-art stages\n- **Classic** and **Insane** mode\n- Nice background music to keep you focused on shooting\n- You can shoot & smash all objects in the room (push the stress away)\n\nAre you ready to reach the highest score possible in this exciting shooting experience?", "short_description": "Get ready for an exciting shooting experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": "https://xsgames.co/", "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781
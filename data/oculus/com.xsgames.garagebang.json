71", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823279_1156995949197904_2158910423235276584_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wp2K3Nwjh-AQ7kNvwE2RPKM&_nc_oc=AdnPXupKbUOI7nVt6QLAeehjBh35hdQnspV2dYntETQ522YE0ldeC9e7mJcK8BfBKqw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvkwgbrH0AZOC4r9qIehsR1TWjxxGmz-oJXNMTgjjDYjw&oe=699C549C"}, {"file_name": "4.png", "id": "2314237509092496", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824303_2314237512425829_344367196998090159_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHOBspBLCG0Q7kNvwHvgRkH&_nc_oc=AdnnCfvGnyRFKKtxdWXEuFbG8X9dwqQoGuchfJu3vClH5xtZOHF5pQNiNirdOzGbKnA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvIQiGUVyAb9hP6FhgII9d-_Yr-iPaa-6NSOHA-4Aq8bA&oe=699C5495"}, {"file_name": "3.png", "id": "748326358249427", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823286_748326361582760_6451330397820495488_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xujX7v25IuYQ7kNvwF_Yn4_&_nc_oc=Adl5aK1CCPj9_ZmaOQKOlwb_jNwNegBVIfj7IpuzboLoKqblTPoau07O7GpA0nGN0Sw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfssxhUTrnVkWeg4IQA1w79wn5DG8oEyauhSe5N2Cz70Sg&oe=699C5A76"}, {"file_name": "5.png", "id": "1329941371373355", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821099_1329941374706688_7229251528108922116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WN_fO__bFegQ7kNvwE_w3ep&_nc_oc=AdkyKuLtSZMe3ONs5Lg8o9J7RhMX-YLbKbU334BGUA2AP04qFxtNy9dUhpdG4PKckZQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvovip-QuEvfhWXsVmhzgarKpdnt5-8eKJcunb50jCPQw&oe=699C5254"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "641558478894614", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302344_641558482227947_5931519368310818776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4tKc4xxh20Q7kNvwGLKqpD&_nc_oc=Adk5xl9jG4L7DBW19dsau5TGvbg1lRCaYdTP1gXHjaE0tJkU7-W8DG7OB_Bf1H2KqS8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs4eOLG1croQHSSJ_v1yiN3YKduPE31rs0VZN0P-JvxMg&oe=699C681E"}, "display_name": "Pixel Bang - Pixel Art Shooting Game", "keywords": ["sparatutto", "guerra", "gun", "azione", "superhot"], "long_description": "Gioco sparatutto in prima persona frenetico, in cui devi sparare a bersagli in un'ampia variet\u00e0 di stage.\nTutti i bersagli hanno un design a tema cartoon in pixel art e non-violenti. \n\nOgni stage ha un obiettivo diverso, che viene spiegato all'inizio del livello. Si va dal semplice tiro al bersaglio (evitando le bombe) allo sparare ai cattivi (evitando di sparare ai civili), o sparare a specifici bersagli colorati, e cos\u00ec via\n\n# CARATTERISTICHE:\n- 28 stage pixel art\n- Modalit\u00e0 **Classica** e **Follia**\n- Musica di sottofondo diversa a seconda del livello per tenerti concentrato nel gioco\n- Puoi sparare e distruggere tutti gli oggetti nella stanza (questo allontana lo stress)\n\nSei pronto a raggiungere il punteggio pi\u00f9 alto possibile in questa entusiasmante esperienza di tiro?", "short_description": "Preparati per un'emozionante sfida di tiro al bersaglio!"}, {"images": {"nodes": [{"file_name": "portrait_coverart.png", "id": "3782508775375397", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821081_3782508778708730_1169026514742919847_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZGz7U5FcJ0Q7kNvwHQpfNs&_nc_oc=AdkSyi9QTjt7PHKDwe63P6Q2zFXgihRK7p02ZW3VPOoabL0IkRiqvirFT1cmNnN0KbA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsUAw3tCvrmLPcDyoOfWC0foBAyBVkfNN5zZIiB8rkFxg&oe=699C5E6E"}, {"file_name": "PDP_cover.png", "id": "3689051368066962", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823949_3689051371400295_1057253421009777056_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOnCWVBIitsQ7kNvwHQ9x9v&_nc_oc=AdmCZZD3NaRg74B9xN0rEt9JbCMFaUT2LQ0TSUv9BIA61FHXj4WkxNRoMqaXLdHWEo4&_nc_zt=3
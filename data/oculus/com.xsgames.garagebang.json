9293_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVKXGzWsQJcQ7kNvwEcdEb-&_nc_oc=AdlC0YXMHJWOXk-iWJSAGlmpZ-zWI6NQneYKj7PC8xcPimWlKGmuC5OkuaM9gSgEiWI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuhencf9_JSoCzQmNd5OpPAUADCcnA2vR1MRCO2CaxpFw&oe=6999BAF8"}, {"file_name": "4.png", "id": "174394518564426", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001691_174394521897759_6020770035674439214_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxYZshqAMdAQ7kNvwEILRcu&_nc_oc=Adm6kmKjCcBTlZZ-1Aq0kdbCI0zc6VEI_AzTZ2-aZvNz5i9eBisYPDwq51Ohmd39F-g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv6rpxXDAybuxL9JOcUSrwjwBEODAn13LoZ6N4sDRqipA&oe=699996AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "152283524306145", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982642_152283527639478_7679354497362835353_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fooz9i-_LcwQ7kNvwE8rrmy&_nc_oc=AdmjomE2C9VH5SAoqc2ERZC4-F1sht3cdukMyiQXtVGy5s_QvUq7nsD2e0g8tLBgpgQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsWhnSVcqAsGz6jUOYE-ySMZ3VeAqraE4p7xqY8eW7NaQ&oe=699999A1"}, "display_name": "Garage Bang", "keywords": [], "long_description": "Gioco sparatutto in prima persona frenetico, in garage Bang devi sparare a bersagli in un'ampia variet\u00e0 di stage.\nTutti i bersagli hanno un design a tema cartoon in pixel art e non-violenti. \n\nOgni stage ha un obiettivo diverso, che viene spiegato all'inizio del livello. Si va dal semplice tiro al bersaglio (evitando le bombe) allo sparare ai cattivi (evitando di sparare ai civili), o sparare a specifici bersagli colorati, e cos\u00ec via\n\nCARATTERISTICHE:\n- 28 stage\n- Modalit\u00e0 Classica e Follia\n- Musica di sottofondo diversa a seconda del livello per tenerti concentrato nel gioco\n- Puoi sparare e distruggere tutti gli oggetti nella stanza (questo allontana lo stress)\n\nSei pronto a raggiungere il punteggio pi\u00f9 alto possibile in questa entusiasmante esperienza di tiro?", "short_description": "Preparati per un'emozionante sfida di tiro al bersaglio!"}, {"images": {"nodes": [{"file_name": "portrait_coverart.png", "id": "3374506842766840", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035428_3374506846100173_8011868378582857093_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7EQFgyWq_EQ7kNvwGumW8A&_nc_oc=Adk93gbe3ZroS3jqy6JGKzBZoj9oxFJqPGB8lHyL713QQSGydiy_Tisnk9Uz5p6a6lc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuHPbeKqBDk7fQ2HW7fZrHn4tphOPIA-f8O0cjk7n1m8A&oe=699998DA"}, {"file_name": "landscape_coverart.png", "id": "1297686567452820", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001732_1297686570786153_6881590418655907071_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydV3I6cz9NUQ7kNvwGp4-nC&_nc_oc=AdnXUVKZY0tHlMK73B74LVbSuWB_lxu4EBmIY3RsmnNb04VM1C31EBZ-a1XHW0Z7wSY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuFgE3CcXyTRPNCa5StgHYJzLVui6aqL40mKDbA8tX9jQ&oe=6999BC9E"}, {"file_name": "logoTransparent.png", "id": "545978171068232", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982678_545978177734898_5580729734115745410_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRZpVAI33H4Q7kNvwFhzcOo&_nc_oc=AdnKIwH9U-olfbUVhJSNtXf7Vh7c9L_ceu_QKEPvJkeDFwuc4xd9sL9fYdSoFTMw7uw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft3XRgUOFQJcyZUYRYUksp8NRnw0kskr2w6j81exXPGAQ&oe=6999AC19"}, {"file_name": "appIcon.png", "id": "533320142343440", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569479_533320149010106_1045257127822412130_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qz4mLlp0LJEQ7kNvwF_g0Zs&_nc_oc=AdkjsPCbXK2Z7IIbzCqm0s6YZ7J2xI6GrhdgjSSxETaXaoaQF9Wf_gRMtZ3zKeS6r0E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftcTn5ek0Uiy9UwTjuJCCYRdEI3OT9S8yOr5j3UWFiXSg&oe=699
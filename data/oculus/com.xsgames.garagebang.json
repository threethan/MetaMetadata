nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftE8zhy7Jfr9nwVmW7H000gSENjQz9G41E3JozYdlf2xw&oe=699C61B1"}, {"file_name": "1.png", "id": "645364133986481", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982709_645364137319814_4246812975223359293_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVKXGzWsQJcQ7kNvwF_dDKb&_nc_oc=Adl0WJjEWi3md993DbzWRHKlHfsep1LBcZ01nv7V912tTcmUfwkKg8s_Hmf2sPDSN-U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvmEuKxZo2F8hSMaDofsu9IpZhIYV42Aep6RHC4sdhD1A&oe=699C5DF8"}, {"file_name": "4.png", "id": "174394518564426", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001691_174394521897759_6020770035674439214_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46kw81k3M4oQ7kNvwEFQhjr&_nc_oc=Adlj2xgpnznFpuZ_PLomJYAIDSoLiHbBDUT--8s4_pkHDbGbNOpmG_QBIJyYTuucgOA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu1PegFg_yXspYWqDKMBdbleutcmaPxOfu1x4I912_f7Q&oe=699C39AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "152283524306145", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982642_152283527639478_7679354497362835353_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fooz9i-_LcwQ7kNvwHmpuR7&_nc_oc=AdnF7wvDJynA80nF2_eZhY-gM2UqjXrCpqITzJn3RJlmnt_m7-7GG4mn6zcbvfGCjCo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftnO8OBLmTxdeijuilN_k1m9ryr0jNL9BvGPcSPefqHOQ&oe=699C3CA1"}, "display_name": "Garage Bang", "keywords": [], "long_description": "Gioco sparatutto in prima persona frenetico, in garage Bang devi sparare a bersagli in un'ampia variet\u00e0 di stage.\nTutti i bersagli hanno un design a tema cartoon in pixel art e non-violenti. \n\nOgni stage ha un obiettivo diverso, che viene spiegato all'inizio del livello. Si va dal semplice tiro al bersaglio (evitando le bombe) allo sparare ai cattivi (evitando di sparare ai civili), o sparare a specifici bersagli colorati, e cos\u00ec via\n\nCARATTERISTICHE:\n- 28 stage\n- Modalit\u00e0 Classica e Follia\n- Musica di sottofondo diversa a seconda del livello per tenerti concentrato nel gioco\n- Puoi sparare e distruggere tutti gli oggetti nella stanza (questo allontana lo stress)\n\nSei pronto a raggiungere il punteggio pi\u00f9 alto possibile in questa entusiasmante esperienza di tiro?", "short_description": "Preparati per un'emozionante sfida di tiro al bersaglio!"}, {"images": {"nodes": [{"file_name": "portrait_coverart.png", "id": "3374506842766840", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035428_3374506846100173_8011868378582857093_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9FX_yQafXnYQ7kNvwHKzP0w&_nc_oc=Adkt2sxg_8ExekVga2GEfoqDVeEvsbxWFl3ok-BAmuRc3Nz5WkufMnlq4SPoxHra924&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvw3KaDtF0EXl33hfmO_hVMUD7CRHXVkxpre1SRUMVpDQ&oe=699C3BDA"}, {"file_name": "landscape_coverart.png", "id": "1297686567452820", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_1297686570786153_6881590418655907071_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDal02AeUJkQ7kNvwE8Yt0c&_nc_oc=Admlb1cuDYSSvMiaUuHgVQnp3HG535noFyDdOItgk_r6t0wwd-5rVIXxmSMaU_xgmJE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afuf0NAILTpiVB3JRpOz_DY9975x55nQNvdqg4DgmjM3YQ&oe=699C5F9E"}, {"file_name": "logoTransparent.png", "id": "545978171068232", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982678_545978177734898_5580729734115745410_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YclMF2COGEUQ7kNvwFOYonX&_nc_oc=Adm6FgdgPV8nRM4F78lecWJrTBdXhj4OL_mElpmoVDHwLzd5Zae1AV55i3ukxbNPV1g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuF9UYTyCSIL1g-yjhpwMu1t-SigkGTGLCFbrUEKmsSWA&oe=699C4F19"}, {"file_name": "appIcon.png", "id": "533320142343440", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569479_533320149010106_1045257127822412130_n
_174394521897759_6020770035674439214_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLeVgdN5IFcQ7kNvwHeAJHy&_nc_oc=AdqblNHwz2m13cfkkBs2quzphKJc-0CXvW9AJTqlxvxsuEDaJIH1tUJGDoiVxeQJEAU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgUr7q2Jqn0Ecm50OY2UM1o3RVsmlR9vajo1QX7F-Lbg&oe=6B045B6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "152283524306145", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982642_152283527639478_7679354497362835353_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KeNmokLbszoQ7kNvwHvC_8I&_nc_oc=Adp1VbiCyTa5tYQJS3vlPCbI3rrKKJ-iGTEqdf9X02bxwk6yWLPuMr5E0lq-1CtNM0s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTb3vtNRRbcYWOXFQlkpxEFcMD9vhCjAyYsj6jYdPehjg&oe=6B045E61"}, "display_name": "Garage Bang", "keywords": [], "long_description": "Gioco sparatutto in prima persona frenetico, in garage Bang devi sparare a bersagli in un'ampia variet\u00e0 di stage.\nTutti i bersagli hanno un design a tema cartoon in pixel art e non-violenti. \n\nOgni stage ha un obiettivo diverso, che viene spiegato all'inizio del livello. Si va dal semplice tiro al bersaglio (evitando le bombe) allo sparare ai cattivi (evitando di sparare ai civili), o sparare a specifici bersagli colorati, e cos\u00ec via\n\nCARATTERISTICHE:\n- 28 stage\n- Modalit\u00e0 Classica e Follia\n- Musica di sottofondo diversa a seconda del livello per tenerti concentrato nel gioco\n- Puoi sparare e distruggere tutti gli oggetti nella stanza (questo allontana lo stress)\n\nSei pronto a raggiungere il punteggio pi\u00f9 alto possibile in questa entusiasmante esperienza di tiro?", "short_description": "Preparati per un'emozionante sfida di tiro al bersaglio!"}, {"images": {"nodes": [{"file_name": "portrait_coverart.png", "id": "3374506842766840", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035428_3374506846100173_8011868378582857093_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mo4u5QYIXKIQ7kNvwGPjPBe&_nc_oc=Adr9f4XmiS65ZCMs9qHs8DYzq0805MZz9196n7zd0AA67ELqgGoTIoaFosk6FRTaxi0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTM_u5cQOwlXf_gTlTlzb3_hiOkMuPbKsZWAz5Z_WXjPg&oe=6B045D9A"}, {"file_name": "landscape_coverart.png", "id": "1297686567452820", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001732_1297686570786153_6881590418655907071_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dss3wqbJhJ4Q7kNvwERuSro&_nc_oc=AdqHKaugknNq85FLZqAcUjqdHVSg0ByaKxycMlbKnBbST1G8TQ8G9hpyaDcirfBb3ns&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsQDwX6-cJdkHdW4KFXi3kAMBSRKpRTqKH6UP6dbzFvA&oe=6B04815E"}, {"file_name": "logoTransparent.png", "id": "545978171068232", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982678_545978177734898_5580729734115745410_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIePVkpjmzwQ7kNvwEozM4O&_nc_oc=AdpxHY38Ec3X--4C0OowGdrNcgmDnVdr_nYb_VyhfL5_W4k9FBJ160WJCwtJgug2x3g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-MuVZblyRogvYPSEIh7xQ1n7T4aFXJ6SkoEP3uyHynw&oe=6B0470D9"}, {"file_name": "appIcon.png", "id": "533320142343440", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_533320149010106_1045257127822412130_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQkAYal1wssQ7kNvwF_VZvJ&_nc_oc=AdqtxYaVKiMlmFbLIRCkEuXBRAMez2tfZ_R7NZ59QerPNwBWV58ggYGX_bXEhWgDZAM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcX_D51sjmlXMFVXvpGxs0XGHuYf63JPudoTKEF3zEFw&oe=6B0464BB"}, {"file_name": "PDP_cover.png", "id": "290824139936929", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.57
nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvWY2D20EXOJ76_U59kyBq4fZUTW9ZOGKCAKFhVSJfk2w&oe=69A6EDB1"}, {"file_name": "1.png", "id": "645364133986481", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982709_645364137319814_4246812975223359293_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arl5lnfRj1wQ7kNvwHwhu46&_nc_oc=Adns8NSsycuQchBzsGpaNPO16LhL300jREdORnQGPMIjF0KjdmOT0PY1hl4C1j1HIXQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu6bgwDlSjFpI3vA3GV8vB7s-uADLHQa2QtBnJ1txSggw&oe=69A6E9F8"}, {"file_name": "4.png", "id": "174394518564426", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001691_174394521897759_6020770035674439214_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mnjISk3wikQ7kNvwGjz9ne&_nc_oc=Admkt0zkAVahVU4Ko0zYJiiSYhanlteLazo1nJHi1ujWSoXYTzBA3jTTBqt5emz3G3s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftwtNSBHVVD94XoGiIM-ls7uE_4QUyjxYpg_J04L_Sohw&oe=69A6C5AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "152283524306145", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982642_152283527639478_7679354497362835353_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHehrXn2M04Q7kNvwFkZdET&_nc_oc=Admfy_v3tjbplAgmRaNySbSybzYbFBo1Fi_TL75s5GUsDExeC3ZLv_Rxedhc6Ijx8Z0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvtXCs-sIs6iKHKpKLyKM0F8YUorFPZWb79uEzKnxMpqA&oe=69A6C8A1"}, "display_name": "Garage Bang", "keywords": [], "long_description": "Gioco sparatutto in prima persona frenetico, in garage Bang devi sparare a bersagli in un'ampia variet\u00e0 di stage.\nTutti i bersagli hanno un design a tema cartoon in pixel art e non-violenti. \n\nOgni stage ha un obiettivo diverso, che viene spiegato all'inizio del livello. Si va dal semplice tiro al bersaglio (evitando le bombe) allo sparare ai cattivi (evitando di sparare ai civili), o sparare a specifici bersagli colorati, e cos\u00ec via\n\nCARATTERISTICHE:\n- 28 stage\n- Modalit\u00e0 Classica e Follia\n- Musica di sottofondo diversa a seconda del livello per tenerti concentrato nel gioco\n- Puoi sparare e distruggere tutti gli oggetti nella stanza (questo allontana lo stress)\n\nSei pronto a raggiungere il punteggio pi\u00f9 alto possibile in questa entusiasmante esperienza di tiro?", "short_description": "Preparati per un'emozionante sfida di tiro al bersaglio!"}, {"images": {"nodes": [{"file_name": "portrait_coverart.png", "id": "3374506842766840", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035428_3374506846100173_8011868378582857093_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBHKoXKxiqEQ7kNvwG7Lsai&_nc_oc=AdkLvfmcIJFj0i2KFDpzCBzITqGG22Hz6HyaokNkKczeASMTl-sdYRMEEQMlvjeV-x4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvqez7R46yeMyYhnVRJYz6T26i03uEEDFO4Km0o0fsLPg&oe=69A6C7DA"}, {"file_name": "landscape_coverart.png", "id": "1297686567452820", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001732_1297686570786153_6881590418655907071_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMUib7m_8b8Q7kNvwGE5foe&_nc_oc=Adl_Tca6WJQpeFFOWfPjVk9PdzO4W_YB-qk01ALl3lzGHh1EW2K3ireXAyOaU7A3T9M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsOdJrI_J0h3_PqJ0I6VDTQb3jVpnCU34Hb5UqVAHsqng&oe=69A6EB9E"}, {"file_name": "logoTransparent.png", "id": "545978171068232", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982678_545978177734898_5580729734115745410_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRzOfAD0UUkQ7kNvwF84bje&_nc_oc=AdkE-268o_VnO0BuO8dG2OycnyODKz7qEqfjDidoTJ6btypde_NNIO2Fd9DSY9eWwFY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvshMueZMEZDxEHqFcc2LmdxRKJFH2wWMK2pXOLlEYHsg&oe=69A6DB19"}, {"file_name": "appIcon.png", "id": "533320142343440", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569479_533320149010106_1045257127822412130_n
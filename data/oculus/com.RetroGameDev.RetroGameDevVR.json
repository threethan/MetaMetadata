GameDev VR Screen 1.png", "id": "1188261503383696", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823783_1188261510050362_5472519875604115720_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzxEhrQ_GnIQ7kNvwHr-xh4&_nc_oc=Adp_qxoN2vIrc5QMirNZqdzO36gCdcSdILET3uggAE4YeiI1zi98A2aaIO9ruzTYoAQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_czWhHevionCIKjSeirhqzRQ1vNxhRzbU1LX_xiLD4uA&oe=6A341F09"}, {"file_name": "RetroGameDev VR Screen 2.png", "id": "1014015661078096", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823366_1014015664411429_2624389349405056523_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwujsLvzNGUQ7kNvwGw_xMP&_nc_oc=AdpSD9xNnMHrhB_5bBoDRdqRqyRPloFqyryVGpG01aPtDW3pbdEi-3J0aIdTBHTknHM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8o2SFyw6QYr6oTr7by6QQyN8r0bRXzGbzVZGUU5Rtuqg&oe=6A33ECB9"}, {"file_name": "RetroGameDev VR Screen 3.png", "id": "1389679592970341", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823802_1389679596303674_7247600721434857762_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5Y_2Gf0ckkQ7kNvwFvu7kw&_nc_oc=Adpapx0NCtH9FISZKxesV0qCakRrGgQCyExiROU_P_M_Fdo9PLR4821_24GBb0KUXEU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-j8twuG8XLw4xfvTHIEjbA4c3-0WeYpRtkm3nf7jgpxg&oe=6A3410E6"}, {"file_name": "RetroGameDev VR Screen 4.png", "id": "1363242579026429", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824741_1363242585693095_468145793917944651_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvHgrvuHq_EQ7kNvwEup0Qe&_nc_oc=Adpi3vhXQ7OG1utFey5bNXNvWrJsCaSQ3d6fRGk20Cs7h5hbZ4JjrYVzdfzF5CeTs20&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yHUSF3z6FtPtx-ahwBMzSjJJySU09Z41uEYOD9v3GEA&oe=6A341A99"}, {"file_name": "RetroGameDev VR Screen 5.png", "id": "1517765113051101", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/507883442_1517765116384434_4320304361351719612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9DeBN1a7nwQ7kNvwHXgLYd&_nc_oc=AdqQgYYsgDUcWan83xm7EiwuErJG9rrOU_KOFiWNd_4LCLNvwDAgodRfLUcHqB6Ng5c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8c8XszrBLdEFkP75JRe2vSX0cq2xxhhhZMT_gGZ0h9xg&oe=6A340F41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2225811551578664", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499311597_2225811554911997_2083852182644206799_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sv-Shg4rLpwQ7kNvwHoApT_&_nc_oc=AdqiCj1lV7Szp8--EKPbp_STR-3HVH6OZ1oJPJYAGZmpj-_haW1g1McvZudas-POVqo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-d0fuOk4_CnBKaVt1UpI0b4tFjZXxZzcTvmnBQEVw_wQ&oe=6A340E41"}, "display_name": "RetroGameDev VR", "keywords": [], "long_description": "Pull up a chair in your own 80s/90s bedroom. The CRT glows, the posters are up, and the tools are waiting. RetroGameDev VR is a standalone Meta Quest app \u2014 part time machine, part hands-on workshop: learn how retro hardware really works, create games of your own, play them across the room, and export them to run on real retro machines.\n\n**Learn**\n\nBuilt-in lessons open up the graphics, sound, and inner workings of real retro hardware, showing you how these classic machines tick from the inside.\n\n**Create and Remix**\n\nStart from a template game and make it your own. Use the built-in editors to redraw sprites, repaint palettes, design backgrounds, and compose your own sounds and music.\n\n**Play Your Creations**\n\nPlay the games you make right there in the bedroom. Optional emulator cores can be downloaded in-app if you also want to load your own game files.\n\n**Export to Real Hardware**\n\nThis is where it leaves the app behind. Turn your creation into a working cartridge that boots on genuine retro machines \u2014 real hardware, not emulation.\n\n**Also Included**\n\nWatch your own video files on any of the three bedroom screens in glorious retro style.\n\n**Emulator Cores**\n\nFree cores for C64, GB, GBC, GBA, NES, SNES, N64, SMS, GG can be downloaded in-app. No cores or games are bundled. You create your own or load your own game files, and you are responsible for having the right to use any files you load.", "short_description": "Step into an 80s/90s bedroom and discover how classic game machines really work. Learn the hardware from the inside, create and remix your own retro games with built-in editors, and play your creations right there in the room. Then export your game as a real ROM that runs on genuine retro hardware. Part time machine, part hands-on game-making workshop \u2014 a standalone Meta Quest app, no PC needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://retrogamedev.github.io/retrogamedevvr-privacy/", "developer_terms_of_service_url": null, "publisher_name": "RetroGameDev", "support_website_url": "https://www.retrogamedev.com/", "website_url": "https://www.retrogamedev.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27459283557092415"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491818852_1278797857692550_140055026676144736_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQt9xwEeR9cQ7kNvwF0QN1Q&_nc_oc=Adr7dKKbQCGUZRO1uA9tviY8kQ0B5ZpwIkeeneqc-QzSv6BGPzirxPn
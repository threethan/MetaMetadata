rVFHyKWLq29S47UUxCVJuFOg-fdilW2G0n9kziFUXWvJfXmjn-s-UQ-UWo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vCZQ_b7o9A4KKNsDrqSrH0EBljs7TQ1Tc3LoWSg67jA&oe=6A2AE019"}, {"file_name": "RetroGameDev VR Screen 5.png", "id": "1517765113051101", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507883442_1517765116384434_4320304361351719612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKwvZ6egUoIQ7kNvwFe86DX&_nc_oc=AdpP0Jkfnc5qAtTsC4wxtC1hhy9oL9kAV37ytklST-vCu8L6IwrDhbrAcE03z-5-L6w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zvX2foMFX9ap7lE70KVin3cW9DBflHhLJMQfL-BnULg&oe=6A2AD4C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2225811551578664", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499311597_2225811554911997_2083852182644206799_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WDwvFoa3r0Q7kNvwEQXNZH&_nc_oc=AdoTCOJ6Rq5da-zPwyI83kPailnuQZAYlu9pmkdj29DSDuMgf_1s9qdn9dyuElMxCy0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_phBQf9GrUVQmcUkW8AXiOq-vRQfz1Upv86BAOjnAjQg&oe=6A2AD3C1"}, "display_name": "RetroGameDev VR", "keywords": [], "long_description": "Pull up a chair in your own 80s/90s bedroom. The CRT glows, the posters are up, and the tools are waiting. RetroGameDev VR is part time machine, part hands-on workshop: learn how retro hardware really works, create games of your own, and play your creations across the room.\n\n**Learn**\n\nBuilt-in lessons open up the graphics, sound, and inner workings of real retro hardware, showing you how these classic machines tick from the inside.\n\n**Create and Remix**\n\nStart from a template game and make it your own. Use the built-in editors to redraw sprites, repaint palettes, design backgrounds, and compose your own sounds and music.\n\n**Play Your Creations**\n\nPlay the games you make right there in the bedroom. Optional emulator cores can be downloaded in-app if you also want to load your own game files.\n\n**Export to Real Hardware**\n\nTurn your creation into a working cartridge that boots on genuine retro machines, not just inside the app.\n\n**Also Included**\n\nWatch your own video files on any of the three bedroom screens in glorious retro style.\n\n**Emulator Cores**\n\nFree cores for Game Boy / Game Boy Color / Game Boy Advance, NES, and Commodore 64 can be downloaded in-app. No cores or games are bundled. You create your own or load your own game files, and you are responsible for having the right to use any files you load.", "short_description": "Step into an 80s/90s bedroom and discover how classic game machines really work. Learn the hardware from the inside, create and remix your own retro games in built-in editors, and play your creations right there in the room. Then export your game as a real ROM that runs on genuine retro hardware. Part time machine, part hands-on game-making workshop."}]}, "developer_name": null, "developer_privacy_policy_url": "https://retrogamedev.github.io/retrogamedevvr-privacy/", "developer_terms_of_service_url": null, "publisher_name": "RetroGameDev", "support_website_url": "https://www.retrogamedev.com/", "website_url": "https://www.retrogamedev.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26755986404088804"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://
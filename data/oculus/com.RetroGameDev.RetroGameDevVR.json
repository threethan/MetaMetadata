roGameDev VR Screen 1.png", "id": "1188261503383696", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823783_1188261510050362_5472519875604115720_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fup_h4UKRN8Q7kNvwGnZwea&_nc_oc=AdpCBmWsn_49zbPILUEGvRiKfykWJYkyD-uoz1IC10JnG_3SRgixyieRmsFgAr0xyGQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhF_fc0a-7d3nlAtM9L5oEhh_nIuBRge8bJFpnnkpIQQ&oe=6A4E44C9"}, {"file_name": "RetroGameDev VR Screen 2.png", "id": "1014015661078096", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823366_1014015664411429_2624389349405056523_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmsQrU8YbhYQ7kNvwHteVs8&_nc_oc=AdpXDVs4fI2KcJRI181HI4-IqQm0XF1fq_J1QlV8QMFYM4L8WXq8QEb1w0cr4X3e2jc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9guZ79CDYbImQCYNZdjbCYlUUQroBs2zMRMsqjLif1g&oe=6A4E4AB9"}, {"file_name": "RetroGameDev VR Screen 3.png", "id": "1389679592970341", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823802_1389679596303674_7247600721434857762_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4yONM_DP_cQ7kNvwFozibZ&_nc_oc=AdrKxO2WyUihi9Ngh3ZjQUfwaMBs4Ig2i2mMew6eN1ZHaKG5qAGDDf9ebyrYEEMoDAE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDe3PPI0_80FUj5v59d8fC6bUt2Uc51WtNGNFeAR2PfHg&oe=6A4E6EE6"}, {"file_name": "RetroGameDev VR Screen 4.png", "id": "1363242579026429", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824741_1363242585693095_468145793917944651_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egxADR98YAsQ7kNvwHEjbWw&_nc_oc=Adqq_kfiTOkRuu2efBiRqPPEDgBqdb4m5OtcPOHEcspgQnskjM5PWvXhftVaBVU3EGs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAex5LicO3Cow8NTDcP_E-XdTL6jsjwc6E3hpvAXaiAlQ&oe=6A4E4059"}, {"file_name": "RetroGameDev VR Screen 5.png", "id": "1517765113051101", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/507883442_1517765116384434_4320304361351719612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S39HyeX5ruIQ7kNvwGNLvFG&_nc_oc=AdpCvpk0nha7utFg9fDThFLFwSs68HBrDUiIvw6w7fA0vbapp-x1z6gLDTzc83PucIs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAz5hHE-lX0syGMP2efvtW7zn4A1PwRL_ZXR66GJVXDkQ&oe=6A4E6D41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2225811551578664", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499311597_2225811554911997_2083852182644206799_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5S_PmBFqAgQ7kNvwEO2KvS&_nc_oc=AdrOIEOYaEcVDbWv7Joy6cAWsJFeEwJm1IndCb38T5ikiJ_bSqXuh28WrCBCc1DIz3w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJIZQpGNqE-jYMsRjwUOr_CRb1wMIoIOEQYxheXAAX7g&oe=6A4E6C41"}, "display_name": "RetroGameDev VR", "keywords": ["retrogamedev", "retro", "homebrew", "gamedev", "retrogaming"], "long_description": "Pull up a chair in your own 80s/90s bedroom. The CRT glows and the tools are waiting. RetroGameDev VR is a standalone Meta Quest app - half time machine, half hands-on workshop: learn how retro hardware works, create your own games, and export to real machines.\n\n**Learn**\n\nBuilt-in lessons open up the graphics, sound, and inner workings of real retro hardware.\n\n**Create and Remix**\n\nStart from a template game and make it your own. Use the built-in editors to redraw sprites, repaint palettes, design backgrounds, and compose sounds and music.\n\n**Play Your Creations**\n\nRun them on any of the bedroom's three displays - the desk monitor up close, the big-screen TV across the room, or the handheld you pick up and hold.\n\n**Mixed Reality**\n\nFlip to Mixed Reality and the bedroom drops to passthrough. Play on either TV model or the handheld, flatten or curve the screen, resize, and dim behind.\n\n**Export to Real Hardware**\n\nThis is where it leaves the app behind. Turn your creation into a working cartridge that boots on genuine retro machines - real hardware, not emulation.\n\n**Also Included**\n\nGrab a light gun and take aim. A 3D gun model appears in your hand for point-and-shoot support across a range of retro systems, just like the arcade.\nWatch your own video files on the bedroom screens in glorious retro style.\n\n**Emulator Cores**\n\nFree cores for multiple systems can be downloaded in-app (online needed once). No cores or games are bundled. You create or load your own game files, and you're responsible for having the right to use them.", "short_description": "Step into an 80s/90s bedroom and discover how classic game machines really work. Learn the hardware from the inside, create and remix your own retro games with built-in editors, and play your creations right there in the room - or flip to Mixed Reality and play them in your own space. Then export your game as a real ROM that runs on genuine retro hardware. Grab a light gun for arcade shooting. Half time machine, half hands-on game-making workshop - a standalone Meta Quest app, no PC needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://retrogamedev.github.io/retrogamedevvr-privacy/", "developer_terms_of_service_url": null, "publisher_name": "RetroGameDev", "support_website_url": "https://www.retrogamedev.com/", "website_url": "https://www.retrogamedev.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"]
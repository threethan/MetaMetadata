roGameDev VR Screen 1.png", "id": "1188261503383696", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823783_1188261510050362_5472519875604115720_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=US5m9yu5gXgQ7kNvwGDqXXs&_nc_oc=Adr9ITMoLhHQ2u_ce4vbY1QSB78dFJPiZBGWgd2G9qBOfKvCYgzV5BLtZ5iL0Ctw2h0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HSnriAs3PzBP_AppeZQtT2I6Xo1APzDdcFixWvrK81Q&oe=6A3EAB09"}, {"file_name": "RetroGameDev VR Screen 2.png", "id": "1014015661078096", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823366_1014015664411429_2624389349405056523_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijjHYw7VGAwQ7kNvwEijIL0&_nc_oc=AdpYVZXMTEpjl6BBVlTKp1pxZIaeBacH-a62DIDsbDE24XmEBI93PW9xjjIgp0gB9LY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iLbVm5_2w0s4Ffelb3Y3SAwLn5DRfyIMltVyFUY7wmA&oe=6A3EB0F9"}, {"file_name": "RetroGameDev VR Screen 3.png", "id": "1389679592970341", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823802_1389679596303674_7247600721434857762_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wz1xe8ekr0Q7kNvwHaBt_z&_nc_oc=AdrmzAU36IwzxaF9CzHovAwLzJ-Z_Tij5OFULChRu3YaPKfZeCEMyNuUi-HGhn0NyPY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4wrxmjj7pojRwK4NjAaIWd6FQ6-OCcI6oiMqH3aS40g&oe=6A3E9CE6"}, {"file_name": "RetroGameDev VR Screen 4.png", "id": "1363242579026429", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824741_1363242585693095_468145793917944651_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOoxAuHT5awQ7kNvwE4_nxJ&_nc_oc=Adr13Ih6t4qrCq7S0R3jeMFobYxlG2P-_UpNvxX-FCzAr9dlWvEbu-oV8ZNPFnhRx7A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mCxN71j2s50vNo4Yb0Za6uiL7jIuHZRSicC0B73O0zw&oe=6A3EA699"}, {"file_name": "RetroGameDev VR Screen 5.png", "id": "1517765113051101", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507883442_1517765116384434_4320304361351719612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1wGoeWI-e8Q7kNvwGSVv9x&_nc_oc=Adqk7rsBXIoHWc4EEbRqKkQQ3EdLTnl_xNOP6ZIyxxFts-1YO7FrNLZU2bV_mwPYrxI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mxiWiAeFuYvosR1IVGYhnx9q-96IsWjufP61xi0Eu7g&oe=6A3E9B41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2225811551578664", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499311597_2225811554911997_2083852182644206799_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_isePnfP8eIQ7kNvwHjonsL&_nc_oc=AdolQfQa_skI7p58AQkAo95HbDpCfEfr1KxvlSLGWBCZcLmRSHW0WIQD-GHct6MB-ZQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Nk7JwWUZA_e4luPgrikSaCEKTlDYyPm6uQmWmICAlyQ&oe=6A3E9A41"}, "display_name": "RetroGameDev VR", "keywords": ["retrogamedev", "retro", "homebrew", "gamedev", "retrogaming"], "long_description": "Pull up a chair in your own 80s/90s bedroom. The CRT glows and the tools are waiting. RetroGameDev VR is a standalone Meta Quest app \u2014 part time machine, part hands-on workshop: learn how retro hardware really works, create your own games, play them across the room, and export them to run on real retro machines.\n\n**Learn**\n\nBuilt-in lessons open up the graphics, sound, and inner workings of real retro hardware.\n\n**Create and Remix**\n\nStart from a template game and make it your own. Use the built-in editors to redraw sprites, repaint palettes, design backgrounds, and compose sounds and music.\n\n**Play Your Creations**\n\nPlay the games you make on any of the bedroom's three displays \u2014 the desk monitor up close, the big-screen TV across the room, or the handheld you pick up and hold.\n\n**Mixed Reality**\n\nFlip into Mixed Reality anytime. The bedroom drops to passthrough, leaving the screen floating in space \u2014 resize it, move it, and play in your real room.\n\n**Export to Real Hardware**\n\nThis is where it leaves the app behind. Turn your creation into a working cartridge that boots on genuine retro machines \u2014 real hardware, not emulation.\n\n**Also Included**\n\nWatch your own video files on the bedroom screens in glorious retro style.\n\n**Emulator Cores**\n\nFree cores for multiple game systems can be downloaded in-app. No cores or games are bundled. You create your own or load your own game files, and you are responsible for having the right to use any files you load.", "short_description": "Step into an 80s/90s bedroom and discover how classic game machines really work. Learn the hardware from the inside, create and remix your own retro games with built-in editors, and play your creations right there in the room \u2014 or flip to Mixed Reality and play them in your own space. Then export your game as a real ROM that runs on genuine retro hardware. Part time machine, part hands-on game-making workshop \u2014 a standalone Meta Quest app, no PC needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://retrogamedev.github.io/retrogamedevvr-privacy/", "developer_terms_of_service_url": null, "publisher_name": "RetroGameDev", "support_website_url": "https://www.retrogamedev.com/", "website_url": "https://www.retrogamedev.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27563893869964716"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
GameDev VR Screen 1.png", "id": "1188261503383696", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823783_1188261510050362_5472519875604115720_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=US5m9yu5gXgQ7kNvwG08T0K&_nc_oc=Adr7rgYA7NqBgURh8uhJFpPGBgpXnvMfPolNIZv5M8VWxqrzuzD_I_mCgQsGeXInbTk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qbDbC-fAr9CIoSpv9IlIpsdlGa16HCU00eoJCscszAg&oe=6A3D5989"}, {"file_name": "RetroGameDev VR Screen 2.png", "id": "1014015661078096", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823366_1014015664411429_2624389349405056523_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijjHYw7VGAwQ7kNvwFOiDi3&_nc_oc=AdoYnO8UIRnQAcVHEsot1-Xz-K2C0GpZUXw1pcut3WdcCK6Qxbi-FlaQR_XYL0waLuE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Jb2_OzKkdAP0WVjNT_-6hN-wcvX9wUhBZ3I8OezSPTQ&oe=6A3D2739"}, {"file_name": "RetroGameDev VR Screen 3.png", "id": "1389679592970341", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823802_1389679596303674_7247600721434857762_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wz1xe8ekr0Q7kNvwFBUQFM&_nc_oc=Adq_bKHrObSjY3uBQtpO3RVX097fWDFcSV1WfXaCn8RsXu4yCRSqemiPY2M7Ml16VTw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LfjjSiBv0DGvo8BGsACbzoqOUdA8LoXKWxYBHVot16g&oe=6A3D4B66"}, {"file_name": "RetroGameDev VR Screen 4.png", "id": "1363242579026429", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824741_1363242585693095_468145793917944651_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOoxAuHT5awQ7kNvwH_nUGQ&_nc_oc=AdrfR9lAgH1KbWaQiDOm16DFPp5broAe8SNscRzKpe1ISxo03_MvORE4JDixauPqcYo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FAMGHFgbU_NNxMAq-QIj4tkiBSyzz4DJ0pTNWxgexkA&oe=6A3D5519"}, {"file_name": "RetroGameDev VR Screen 5.png", "id": "1517765113051101", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/507883442_1517765116384434_4320304361351719612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1wGoeWI-e8Q7kNvwE2eMhx&_nc_oc=AdqYXr77xO8z4sQ5U0TzdmzoEVRNGYu8k3GlfNHX_CopZLNIaeIltXJA0J6KHnMSXd4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96CuIFkz28KNNIEximx906oA8ml-ByONj67OAMTrt32w&oe=6A3D49C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2225811551578664", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499311597_2225811554911997_2083852182644206799_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPCWMNz-dIAQ7kNvwHJTXrj&_nc_oc=AdpFT-3PsaDQGJPygoG0eqBZ9eBJNPxIdaqLlG_igo6CP0Gv1BFAwMuo9fMiFD2rGcE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RD06HUrLxE23p_0h1-NUMkWee8Alz1JyR5QkRAbbi9Q&oe=6A3D48C1"}, "display_name": "RetroGameDev VR", "keywords": ["retrogamedev", "retro", "homebrew", "gamedev", "retrogaming"], "long_description": "Pull up a chair in your own 80s/90s bedroom. The CRT glows and the tools are waiting. RetroGameDev VR is a standalone Meta Quest app \u2014 part time machine, part hands-on workshop: learn how retro hardware really works, create your own games, play them across the room, and export them to run on real retro machines.\n\n**Learn**\n\nBuilt-in lessons open up the graphics, sound, and inner workings of real retro hardware.\n\n**Create and Remix**\n\nStart from a template game and make it your own. Use the built-in editors to redraw sprites, repaint palettes, design backgrounds, and compose sounds and music.\n\n**Play Your Creations**\n\nPlay the games you make on any of the bedroom's three displays \u2014 the desk monitor up close, the big-screen TV across the room, or the handheld you pick up and hold.\n\n**Mixed Reality**\n\nFlip into Mixed Reality anytime. The bedroom drops to passthrough, leaving the screen floating in space \u2014 resize it, move it, and play in your real room.\n\n**Export to Real Hardware**\n\nThis is where it leaves the app behind. Turn your creation into a working cartridge that boots on genuine retro machines \u2014 real hardware, not emulation.\n\n**Also Included**\n\nWatch your own video files on the bedroom screens in glorious retro style.\n\n**Emulator Cores**\n\nFree cores for C64, GB, GBC, GBA, NES, SNES, N64, SMS, GG, PS1 can be downloaded in-app. No cores or games are bundled. You create your own or load your own game files, and you are responsible for having the right to use any files you load.", "short_description": "Step into an 80s/90s bedroom and discover how classic game machines really work. Learn the hardware from the inside, create and remix your own retro games with built-in editors, and play your creations right there in the room \u2014 or flip to Mixed Reality and play them in your own space. Then export your game as a real ROM that runs on genuine retro hardware. Part time machine, part hands-on game-making workshop \u2014 a standalone Meta Quest app, no PC needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://retrogamedev.github.io/retrogamedevvr-privacy/", "developer_terms_of_service_url": null, "publisher_name": "RetroGameDev", "support_website_url": "https://www.retrogamedev.com/", "website_url": "https://www.retrogamedev.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27548264384860998"}, "review_messages": []}]}, "cover_s
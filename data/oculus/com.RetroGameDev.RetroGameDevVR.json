etroGameDev VR Screen 1.png", "id": "1188261503383696", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491823783_1188261510050362_5472519875604115720_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lA7BdV0MzwQ7kNvwH5VAR4&_nc_oc=AdoBuaGUewCsQCWsYK-NB_oOfcUW8NtZQCgM44Gre4Sq-hVX0-lDd6-fKe11g21MHxg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xQmWIAPDpQXwMXn46X5j9fPa7BdbljqfHzciZMOllEQ&oe=6A392CC9"}, {"file_name": "RetroGameDev VR Screen 2.png", "id": "1014015661078096", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491823366_1014015664411429_2624389349405056523_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlLv2_HSCksQ7kNvwHtK3_U&_nc_oc=Ado6IEmVxw6VVT8139089E544rDMLS21-r7LhW9-UX7CjCwkdxaXbTdLaSB2J6CvtLM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qAh_7UWO-nnSwsMXp3OTlFZvwaUYabjZGxvHHuRQgFw&oe=6A3932B9"}, {"file_name": "RetroGameDev VR Screen 3.png", "id": "1389679592970341", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823802_1389679596303674_7247600721434857762_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBjWPnVcOWoQ7kNvwHhsJL-&_nc_oc=AdosocLIG-glJ_Rzf4ORCOxJvXCRM3QuLY7HLJ3DgN8X-5piLBLn0Z_qUEE2z4o9vXI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DuV5JJCPkmaFOK1NXjnpZaGgOMDwJI24v6PGPh91rUw&oe=6A3956E6"}, {"file_name": "RetroGameDev VR Screen 4.png", "id": "1363242579026429", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491824741_1363242585693095_468145793917944651_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJJPWcVC3hMQ7kNvwGd3HS8&_nc_oc=Adph7lzvMaG-HfiQ0wzpi-HwjHPcV62HynlG1WF_mGcI-Av7eA9V8WGwmTb-lt0KzZM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_c4TXigIXK9g_01MKByKaAt_DUDETWnUATSScMMj5k-g&oe=6A396099"}, {"file_name": "RetroGameDev VR Screen 5.png", "id": "1517765113051101", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/507883442_1517765116384434_4320304361351719612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjGPDrZ_YD0Q7kNvwGdfp1n&_nc_oc=Adprsj3JF-qVJouawTiSeaj7hz-RuZATUjZBFvAke4ziW__YMPQDYlYBlgnPM_jR-OQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uoTVSFzCojOkrmJz5L3kbNoMOoAvL58XUiYvOjyEp9A&oe=6A395541"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2225811551578664", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499311597_2225811554911997_2083852182644206799_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xa6xnH0YOCMQ7kNvwHjzn1K&_nc_oc=AdoRBIaDwMVQT9fgoMXZ2Gg4byiInBlJfJ1MP9xnJWap6Mdo6SGVRLmU_ZbDttMPlco&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uALNaAYAPUaHgkXMAkjLn8ihwayz5Uh9RGmrp5i5apA&oe=6A395441"}, "display_name": "RetroGameDev VR", "keywords": ["retrogamedev", "retro", "homebrew", "gamedev", "retrogaming"], "long_description": "Pull up a chair in your own 80s/90s bedroom. The CRT glows, the posters are up, and the tools are waiting. RetroGameDev VR is a standalone Meta Quest app \u2014 part time machine, part hands-on workshop: learn how retro hardware really works, create games of your own, play them across the room, and export them to run on real retro machines.\n\n**Learn**\n\nBuilt-in lessons open up the graphics, sound, and inner workings of real retro hardware, showing you how these classic machines tick from the inside.\n\n**Create and Remix**\n\nStart from a template game and make it your own. Use the built-in editors to redraw sprites, repaint palettes, design backgrounds, and compose your own sounds and music.\n\n**Play Your Creations**\n\nPlay the games you make right there in the bedroom. Optional emulator cores can be downloaded in-app if you also want to load your own game files.\n\n**Export to Real Hardware**\n\nThis is where it leaves the app behind. Turn your creation into a working cartridge that boots on genuine retro machines \u2014 real hardware, not emulation.\n\n**Also Included**\n\nWatch your own video files on any of the three bedroom screens in glorious retro style.\n\n**Emulator Cores**\n\nFree cores for C64, GB, GBC, GBA, NES, SNES, N64, SMS, GG, PS1 can be downloaded in-app. No cores or games are bundled. You create your own or load your own game files, and you are responsible for having the right to use any files you load.", "short_description": "Step into an 80s/90s bedroom and discover how classic game machines really work. Learn the hardware from the inside, create and remix your own retro games with built-in editors, and play your creations right there in the room. Then export your game as a real ROM that runs on genuine retro hardware. Part time machine, part hands-on game-making workshop \u2014 a standalone Meta Quest app, no PC needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://retrogamedev.github.io/retrogamedevvr-privacy/", "developer_terms_of_service_url": null, "publisher_name": "RetroGameDev", "support_website_url": "https://www.retrogamedev.com/", "website_url": "https://www.retrogamedev.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27496452560042181"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491818852_1278797857692550_140055026676144736_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid
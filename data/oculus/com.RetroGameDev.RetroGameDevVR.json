roGameDev VR Screen 1.png", "id": "1188261503383696", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823783_1188261510050362_5472519875604115720_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iIMUU3QsigQ7kNvwFcmQwc&_nc_oc=AdoLjrw1URPY6slJfEqIhHmCU7kU6jRD89S_vUKze2fptYi7mwJNTEzsQfd4qxgODQ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBr672r7isb6WE9pVRPrcaFSWrLhqKcEowjRRYEfPangg&oe=6A4A5049"}, {"file_name": "RetroGameDev VR Screen 2.png", "id": "1014015661078096", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823366_1014015664411429_2624389349405056523_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPbzSS2tYkIQ7kNvwHgxOmg&_nc_oc=AdrLT8EFgWB-A4VXK1xnrVIaI4pm_LHMQqrtTKcHFRxtO1QH0g4ZTUhO7131hrxA1BI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKERM45AZgaeLN0Xy9lKlYXgtvTX6LD7kNSrR1fOWffw&oe=6A4A5639"}, {"file_name": "RetroGameDev VR Screen 3.png", "id": "1389679592970341", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823802_1389679596303674_7247600721434857762_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlvjUsfN8HgQ7kNvwGhHYzh&_nc_oc=AdppjaPJc-UkyMODDkfVnTg1ohI74HFFR8hhkdH8vfOwLm5OxEXIGsU_52ir1n70htw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7NlR7M4j3BpM-zl7PV0mLDv9r54VUB1TYczYpav5RDA&oe=6A4A7A66"}, {"file_name": "RetroGameDev VR Screen 4.png", "id": "1363242579026429", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824741_1363242585693095_468145793917944651_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6M7QFAkmMEUQ7kNvwFhbZsa&_nc_oc=AdqU5vxT1dAmQ2gUnq50usp2TuxuyTJUjwayh6oFpAZRh6M77GuUSTahR8nZ5xLtO3k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMaK0JSyvWteJzvuX026Qrlai62udDlO6dDKjNYCtbCQ&oe=6A4A8419"}, {"file_name": "RetroGameDev VR Screen 5.png", "id": "1517765113051101", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/507883442_1517765116384434_4320304361351719612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtY5dhRXDVoQ7kNvwGVhuk3&_nc_oc=AdqOpbV05nRoJZ-GUduTuYZuIQ3LU4J_kGYYckYeKothXc9DgMyiTsAy5rAiZbeMkxU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGbzl6lMOUiLCllkHi4xfDfQhFPsnNi9vwIdh-zcIFbg&oe=6A4A78C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2225811551578664", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311597_2225811554911997_2083852182644206799_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiT12d4daf8Q7kNvwGnaZM2&_nc_oc=Adr28P8wIofVb6OeUccxhZFoRDZQiIoGbE7GzMnK670rKc8jzKTOcGIf2MaHZgq3WwI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoWpmtmWoWZ8uJYutpHoTnFuojufgqce_D3kbr2uIg5w&oe=6A4A77C1"}, "display_name": "RetroGameDev VR", "keywords": ["retrogamedev", "retro", "homebrew", "gamedev", "retrogaming"], "long_description": "Pull up a chair in your own 80s/90s bedroom. The CRT glows and the tools are waiting. RetroGameDev VR is a standalone Meta Quest app - half time machine, half hands-on workshop: learn how retro hardware works, create your own games, and export to real machines.\n\n**Learn**\n\nBuilt-in lessons open up the graphics, sound, and inner workings of real retro hardware.\n\n**Create and Remix**\n\nStart from a template game and make it your own. Use the built-in editors to redraw sprites, repaint palettes, design backgrounds, and compose sounds and music.\n\n**Play Your Creations**\n\nRun them on any of the bedroom's three displays - the desk monitor up close, the big-screen TV across the room, or the handheld you pick up and hold.\n\n**Mixed Reality**\n\nFlip to Mixed Reality and the bedroom drops to passthrough. Play on either TV model or the handheld, flatten or curve the screen, resize, and dim behind.\n\n**Export to Real Hardware**\n\nThis is where it leaves the app behind. Turn your creation into a working cartridge that boots on genuine retro machines - real hardware, not emulation.\n\n**Also Included**\n\nGrab a light gun and take aim. A 3D gun model appears in your hand for point-and-shoot support across a range of retro systems, just like the arcade.\nWatch your own video files on the bedroom screens in glorious retro style.\n\n**Emulator Cores**\n\nFree cores for multiple systems can be downloaded in-app (online needed once). No cores or games are bundled. You create or load your own game files, and you're responsible for having the right to use them.", "short_description": "Step into an 80s/90s bedroom and discover how classic game machines really work. Learn the hardware from the inside, create and remix your own retro games with built-in editors, and play your creations right there in the room - or flip to Mixed Reality and play them in your own space. Then export your game as a real ROM that runs on genuine retro hardware. Grab a light gun for arcade shooting. Half time machine, half hands-on game-making workshop - a standalone Meta Quest app, no PC needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://retrogamedev.github.io/retrogamedevvr-privacy/", "developer_terms_of_service_url": null, "publisher_name": "RetroGameDev", "support_website_url": "https://www.retrogamedev.com/", "website_url": "https://www.retrogamedev.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"]
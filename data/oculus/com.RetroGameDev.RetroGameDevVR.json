GameDev VR Screen 1.png", "id": "1188261503383696", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823783_1188261510050362_5472519875604115720_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znQLBmtlSiwQ7kNvwFgy3w6&_nc_oc=AdqIjPhvQgC5vtoKm-0HB6jlgt22H0R3D0XtreQlW35v7-5rZIHxbOFGMxjKcOfPS08&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-z_UP0uE3v22nF3Kb35aXkWBvSzIGtBl1jU3Gow9J-7w&oe=6A329549"}, {"file_name": "RetroGameDev VR Screen 2.png", "id": "1014015661078096", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823366_1014015664411429_2624389349405056523_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sY_RrFQU3aMQ7kNvwGvFGOA&_nc_oc=Adpo0-9Tpt4x8N-4N-9H2XGEfKQjcpHrTvMLHRtNl3JTpHXcI7E4_MT4RvhAra-nzd4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_s9dKcyWZN-hyKRJ3E5sLFBRWwM3CcnF2EJfvaodkLCw&oe=6A329B39"}, {"file_name": "RetroGameDev VR Screen 3.png", "id": "1389679592970341", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823802_1389679596303674_7247600721434857762_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YEgC9Wpsc74Q7kNvwHEKvzF&_nc_oc=AdppPOsepkK5qQ5ZnNMI6H6Ayy4ufrwKvO8OYSdPGvppBkBMbRYxngMa8rGn0nKAr6w&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lRsq623Ndb2hTcbqZadvcGY3V1cGSPSMYN0G1zRaSKQ&oe=6A32BF66"}, {"file_name": "RetroGameDev VR Screen 4.png", "id": "1363242579026429", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491824741_1363242585693095_468145793917944651_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTraXwrB5NIQ7kNvwHjY8l5&_nc_oc=Adpyqh3430sWPudIXt3AtpQo2ELLGp0jfT2WmwyTwQ7uaWSjouocrryabAIsed9ynMU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PInuZOjv_Diil0mRwUxHIG6vQU4rt9phZg70OXSSdCw&oe=6A32C919"}, {"file_name": "RetroGameDev VR Screen 5.png", "id": "1517765113051101", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/507883442_1517765116384434_4320304361351719612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODeNrXsT-XMQ7kNvwF90qjl&_nc_oc=AdoM83-n9CzezkFDNNPhenoNGt0P9L0DZpcjk_ROGKcJDJOvNF9LrpWnRJ1oG0815jI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qlJReHWC1ngOmkwF0i3BkDL-B3fM4L8bgQEmmRQ0x-w&oe=6A32BDC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2225811551578664", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499311597_2225811554911997_2083852182644206799_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sv-Shg4rLpwQ7kNvwHYzork&_nc_oc=AdqT7GCAGOTjHIatVLPqfXs7j8cpw2d2SRNAezhPfaJTzczdgI064qHUZMYjUU-lFmQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rER7WTDMI5kG4bO0i312AEYKkU_bXwd069OlkEk_Iiw&oe=6A32BCC1"}, "display_name": "RetroGameDev VR", "keywords": [], "long_description": "Pull up a chair in your own 80s/90s bedroom. The CRT glows, the posters are up, and the tools are waiting. RetroGameDev VR is a standalone Meta Quest app \u2014 part time machine, part hands-on workshop: learn how retro hardware really works, create games of your own, play them across the room, and export them to run on real retro machines.\n\n**Learn**\n\nBuilt-in lessons open up the graphics, sound, and inner workings of real retro hardware, showing you how these classic machines tick from the inside.\n\n**Create and Remix**\n\nStart from a template game and make it your own. Use the built-in editors to redraw sprites, repaint palettes, design backgrounds, and compose your own sounds and music.\n\n**Play Your Creations**\n\nPlay the games you make right there in the bedroom. Optional emulator cores can be downloaded in-app if you also want to load your own game files.\n\n**Export to Real Hardware**\n\nThis is where it leaves the app behind. Turn your creation into a working cartridge that boots on genuine retro machines \u2014 real hardware, not emulation.\n\n**Also Included**\n\nWatch your own video files on any of the three bedroom screens in glorious retro style.\n\n**Emulator Cores**\n\nFree cores for C64, GB, GBC, GBA, NES, SNES, SMS, GG can be downloaded in-app. No cores or games are bundled. You create your own or load your own game files, and you are responsible for having the right to use any files you load.", "short_description": "Step into an 80s/90s bedroom and discover how classic game machines really work. Learn the hardware from the inside, create and remix your own retro games with built-in editors, and play your creations right there in the room. Then export your game as a real ROM that runs on genuine retro hardware. Part time machine, part hands-on game-making workshop \u2014 a standalone Meta Quest app, no PC needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://retrogamedev.github.io/retrogamedevvr-privacy/", "developer_terms_of_service_url": null, "publisher_name": "RetroGameDev", "support_website_url": "https://www.retrogamedev.com/", "website_url": "https://www.retrogamedev.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27439603625727075"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491818852_1278797857692550_140055026676144736_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4maAU43TZYQ7kNvwHbJcID&_nc_oc=AdoGRd9-unvaW5mrXunQ0hYdn9aeZ5Fnab5HEaKsEc9DO8UWTd3kGa5mIaL4
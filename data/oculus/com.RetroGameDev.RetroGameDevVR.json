GameDev VR Screen 1.png", "id": "1188261503383696", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823783_1188261510050362_5472519875604115720_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=US5m9yu5gXgQ7kNvwFDynv_&_nc_oc=AdpduDvfqz32RRhbn03u9f-rJBeT2P-YGyl23ENsTjeDVY7vF_XaEZUpl5k8E2FoG00&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lgPZzLGvv7g5sb0tnpmWIN3RO9Jwtd9AuvY_avZ1jlg&oe=6A3BCFC9"}, {"file_name": "RetroGameDev VR Screen 2.png", "id": "1014015661078096", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823366_1014015664411429_2624389349405056523_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijjHYw7VGAwQ7kNvwEIh8R0&_nc_oc=AdoNu4hmREyzkfWytQQaxfpel21rZb-ALolUui40P8IWWS5cbgbNiqboCXLdeVAHQQI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vsRwQcelwpVDRbKXSzlnicmxVGwju6RTGuU6Rb1DswA&oe=6A3BD5B9"}, {"file_name": "RetroGameDev VR Screen 3.png", "id": "1389679592970341", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_1389679596303674_7247600721434857762_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wz1xe8ekr0Q7kNvwF3_kfd&_nc_oc=Adqsc2IkXVFTrHUihGkl8HgJvqUcue4tCdX8wsSPW6Vg2TeI7ou5zq-yb9Ou_4FXuLE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fm-m18mkI5o2HXXi_Xgr22EMbb8qN5OFeQIl-S5kTOw&oe=6A3BF9E6"}, {"file_name": "RetroGameDev VR Screen 4.png", "id": "1363242579026429", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824741_1363242585693095_468145793917944651_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOoxAuHT5awQ7kNvwHkm0Gi&_nc_oc=Adoo4iVpU2dHTOr4WWCzBid7v4AVyUnjtAvvHFvTS9x_A92CCKCbN4fH9HjRa2lT-AY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bZOwj8Hf3s5VZAV_H-PL5BPjaSI-G6J6ryqBVhtWA0Q&oe=6A3C0399"}, {"file_name": "RetroGameDev VR Screen 5.png", "id": "1517765113051101", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507883442_1517765116384434_4320304361351719612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1wGoeWI-e8Q7kNvwEisx8u&_nc_oc=AdoZFck3mo4Por-nbO5fiiDfA4R236o57ubJMmE6fXzS5LnLL-8knpSz70jtSui-HW8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yLfHNeS0zP2oB2HeCW5QIYTtrC0twqsDK7q8hQeSecg&oe=6A3BF841"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2225811551578664", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311597_2225811554911997_2083852182644206799_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPCWMNz-dIAQ7kNvwFOk3dk&_nc_oc=AdoDOxnfJNQD6QdG3xUfPtksmgf93uSoFDEp7gCGQLJP32FllGZzhYUffOI-cA0SPXY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--SOsomGriahFbDLutWVlZQ2fRXO1kXuXcG28XZ51g1A&oe=6A3BF741"}, "display_name": "RetroGameDev VR", "keywords": ["retrogamedev", "retro", "homebrew", "gamedev", "retrogaming"], "long_description": "Pull up a chair in your own 80s/90s bedroom. The CRT glows and the tools are waiting. RetroGameDev VR is a standalone Meta Quest app \u2014 part time machine, part hands-on workshop: learn how retro hardware really works, create your own games, play them across the room, and export them to run on real retro machines.\n\n**Learn**\n\nBuilt-in lessons open up the graphics, sound, and inner workings of real retro hardware.\n\n**Create and Remix**\n\nStart from a template game and make it your own. Use the built-in editors to redraw sprites, repaint palettes, design backgrounds, and compose sounds and music.\n\n**Play Your Creations**\n\nPlay the games you make on any of the bedroom's three displays \u2014 the desk monitor up close, the big-screen TV across the room, or the handheld you pick up and hold.\n\n**Mixed Reality**\n\nFlip into Mixed Reality anytime. The bedroom drops to passthrough, leaving the screen floating in your own space \u2014 resize it, move it, or play in your real room.\n\n**Export to Real Hardware**\n\nThis is where it leaves the app behind. Turn your creation into a working cartridge that boots on genuine retro machines \u2014 real hardware, not emulation.\n\n**Also Included**\n\nWatch your own video files on the bedroom screens in glorious retro style.\n\n**Emulator Cores**\n\nFree cores for C64, GB, GBC, GBA, NES, SNES, N64, SMS, GG, PS1 can be downloaded in-app. No cores or games are bundled. You create your own or load your own game files, and you are responsible for having the right to use any files you load.", "short_description": "Step into an 80s/90s bedroom and discover how classic game machines really work. Learn the hardware from the inside, create and remix your own retro games with built-in editors, and play your creations right there in the room \u2014 or flip to Mixed Reality and play them in your own space. Then export your game as a real ROM that runs on genuine retro hardware. Part time machine, part hands-on game-making workshop \u2014 a standalone Meta Quest app, no PC needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://retrogamedev.github.io/retrogamedevvr-privacy/", "developer_terms_of_service_url": null, "publisher_name": "RetroGameDev", "support_website_url": "https://www.retrogamedev.com/", "website_url": "https://www.retrogamedev.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27524849047202532"}, "review_messages": []}]}, "cover_square_image"
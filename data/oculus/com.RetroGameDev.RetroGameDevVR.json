roGameDev VR Screen 6.png", "id": "1611692083706190", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823930_1611692090372856_309268934422993386_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FglOv473IsEQ7kNvwE6L1Iu&_nc_oc=Adp9uCeFnb_PQegf67YtRBOkdoRyj_ohyhGHOHesu0TvXtcP2SYJA92l3P2jbyRa2bU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUNXhBEcMWHeIBOZLVWFNNJARynl786XrnIUh5AixrCg&oe=6AF88939"}, {"file_name": "RetroGameDev VR Screen 7.png", "id": "1394957845807813", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824307_1394957852474479_3044892132813702717_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXqxvjHbdqgQ7kNvwFCFKYV&_nc_oc=Adozpo_BCGPu6dGqJxypqwdkP_zV4x6a-7XPhgkmpKGClDrvM2PxBy5A7vfSNZldUtY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZVuOXaOInOn0JGXlxAJTbWtljd9in1dSz8sPP_iek8Q&oe=6AF8A7F7"}, {"file_name": "RetroGameDev VR Screen 3.png", "id": "1389679592970341", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_1389679596303674_7247600721434857762_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NduEOnS3d_AQ7kNvwG4G7C3&_nc_oc=AdqqrJrsrGA9SWNUjzptQ3NgwR6TAqm58IAwGs6u3SNHZXUkRVAsB3LVAMEeyvh67Y8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQELgMEie1pRjr0GKsbLb52-Bs1beOAABg_l2jMrxvo4w&oe=6AF88066"}, {"file_name": "RetroGameDev VR Screen 8.png", "id": "1592565665760316", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821796_1592565672426982_5130621311636654549_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRlzxqEBfjQQ7kNvwFmeBhD&_nc_oc=Adr29cf6yyI80bhdWGagtMGMphRYSi4hCZo8_iPvVDiPPwAwv96ngHPtxM1b8es5tyA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg1nmLPDmgxKX6t_7HE_ct5N9P5YWmC6tauRBMQEeADQ&oe=6AF898BB"}, {"file_name": "RetroGameDev VR Screen 9.png", "id": "1576565300850865", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_1576565304184198_3571132988296197481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzuJdGv65zcQ7kNvwHFVNIB&_nc_oc=AdqOuMqE12MOMy0KAOlQFbEnN_fec5BCI_qDy0-BaONgznDxwCyIlRHnO3CIZDz9ok0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSERaB8DI7eafZuoTJ4EX1e4EUp2VjmkTT7n54T6vXEUA&oe=6AF88C8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2225811551578664", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311597_2225811554911997_2083852182644206799_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wd14eZ6BA9cQ7kNvwEokSKK&_nc_oc=AdrBJMyhFOdXDqIVc_EOIA7Ih_fdpFGPITacMy05QovFf4BCdCUtYIWNvok1Tiqalmc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdLUgM9-tP4xjyny-63ENfGLMBCHayrndV2orUZ164SQ&oe=6AF87DC1"}, "display_name": "RetroGameDev VR", "keywords": ["retrogamedev", "retro", "homebrew", "gamedev", "retrogaming"], "long_description": "Pull up a chair in your own 80s/90s bedroom. The CRT glows and the tools are waiting. RetroGameDev VR is a standalone Meta Quest app - half time machine, half hands-on workshop: learn how retro hardware works, create your own games, and export to real machines.\n\n**Learn**\n\nBuilt-in lessons open up the graphics, sound, and inner workings of real retro hardware.\n\n**Create and Remix**\n\nStart from a template game and make it your own. Use the built-in editors to redraw sprites, repaint palettes, design backgrounds, and compose sounds and music.\n\n**Play Your Creations**\n\nRun them on any of the bedroom's three displays - the desk monitor up close, the big-screen TV across the room, or the handheld you pick up and hold.\n\n**Mixed Reality**\n\nFlip to Mixed Reality and the bedroom drops to passthrough. Play on either TV model or the handheld, flatten or curve the screen, resize, and dim behind.\n\n**Export to Real Hardware**\n\nThis is where it leaves the app behind. Turn your creation into a working cartridge that boots on genuine retro machines - real hardware, not emulation.\n\n**Also Included**\n\nGrab a light gun and take aim. A 3D gun model appears in your hand for point-and-shoot support across a range of retro systems, just like the arcade.\nWatch your own video files on the bedroom screens in glorious retro style.\n\n**Emulator Cores**\n\nFree cores for multiple systems can be downloaded in-app (online needed once). No cores or games are bundled. You create or load your own game files, and you're responsible for having the right to use them.", "short_description": "Step into an 80s/90s bedroom and discover how classic game machines really work. Learn the hardware from the inside, create and remix your own retro games with built-in editors, and play your creations right there in the room - or flip to Mixed Reality and play them in your own space. Then export your game as a real ROM that runs on genuine retro hardware. Grab a light gun for arcade shooting. Half time machine, half hands-on game-making workshop - a standalone Meta Quest app, no PC needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://retrogamedev.github.io/retrogamedevvr-privacy/", "developer_terms_of_service_url": null, "publisher_name": "RetroGameDev", "support_website_url": "https://www.retrogamedev.com/", "website_url": "https://www.retrogamedev.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"]
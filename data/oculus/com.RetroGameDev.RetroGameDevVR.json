E3pPp6XHwTB3ONA&oe=6B09BC3B"}, {"file_name": "RetroGameDev VR Screen 9.png", "id": "1576565300850865", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825257_1576565304184198_3571132988296197481_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JT9W16jbdHcQ7kNvwEPVCeM&_nc_oc=AdpwezTy5-X4r3Pza5rotAVtePzNeqTVAUy7IixNlf63VsrT27_hIPyJEa4RveYzto0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLrkYoLPJk1_6_EzwVXk--eaYdkLeltnKHNKp1Gk37wQ&oe=6B09B00C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2225811551578664", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499311597_2225811554911997_2083852182644206799_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=av_zku4P1WsQ7kNvwHgqgkc&_nc_oc=AdqTBwLLDRZvpecCXvb2SHZSPCjNhw7_umgmkDpvjMuRy6rlIC9SD0q74Qhh5alQUUA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQB3xZoPJJRJue7p86B01UiqPD71EsiR6hwD4dsc_Uhzg&oe=6B09A141"}, "display_name": "RetroGameDev VR", "keywords": ["retrogamedev", "retro", "homebrew", "gamedev", "retrogaming"], "long_description": "Pull up a chair in your own 80s/90s bedroom. The CRT glows and the tools are waiting. RetroGameDev VR is a standalone Meta Quest app - half time machine, half hands-on workshop: learn how retro hardware works, create your own games, and export to real machines.\n\n**Learn**\n\nBuilt-in lessons open up the graphics, sound, and inner workings of real retro hardware.\n\n**Create and Remix**\n\nStart from a template game and make it your own. Use the built-in editors to redraw sprites, repaint palettes, design backgrounds, and compose sounds and music.\n\n**Play Your Creations**\n\nRun them on any of the bedroom's three displays - the desk monitor up close, the big-screen TV across the room, or the handheld you pick up and hold.\n\n**Mixed Reality**\n\nFlip to Mixed Reality and the bedroom drops to passthrough. Play on either TV model or the handheld, flatten or curve the screen, resize, and dim behind.\n\n**Export to Real Hardware**\n\nThis is where it leaves the app behind. Turn your creation into a working cartridge that boots on genuine retro machines - real hardware, not emulation.\n\n**Also Included**\n\nGrab a light gun and take aim. A 3D gun model appears in your hand for point-and-shoot support across a range of retro systems, just like the arcade.\nWatch your own video files on the bedroom screens in glorious retro style.\n\n**Emulator Cores**\n\nFree cores for multiple systems can be downloaded in-app (online needed once). No cores or games are bundled. You create or load your own game files, and you're responsible for having the right to use them.", "short_description": "Step into an 80s/90s bedroom and discover how classic game machines really work. Learn the hardware from the inside, create and remix your own retro games with built-in editors, and play your creations right there in the room - or flip to Mixed Reality and play them in your own space. Then export your game as a real ROM that runs on genuine retro hardware. Grab a light gun for arcade shooting. Half time machine, half hands-on game-making workshop - a standalone Meta Quest app, no PC needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://retrogamedev.github.io/retrogamedevvr-privacy/", "developer_terms_of_service_url": null, "publisher_name": "RetroGameDev", "support_website_url": "https://www.retrogamedev.com/", "website_url": "https://www.retrogamedev.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "r
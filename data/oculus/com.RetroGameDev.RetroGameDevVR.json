GameDev VR Screen 1.png", "id": "1188261503383696", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823783_1188261510050362_5472519875604115720_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lA7BdV0MzwQ7kNvwHzrT6v&_nc_oc=AdrPWw7DPFbxqmr4Z-pCLVQ4PoNqp2qUDtkmJiEl5DQ01XkdtCF8jNq3iaFLdQkQk5I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8j5aRX58BXWjVo7NS_d5A1yndGFCkZQ3NA6ZjJuyb2ZA&oe=6A3AB689"}, {"file_name": "RetroGameDev VR Screen 2.png", "id": "1014015661078096", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823366_1014015664411429_2624389349405056523_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlLv2_HSCksQ7kNvwF_weRd&_nc_oc=AdresDQbj_XVi_z_J6TACJEnOmumdp1-e2v3dnNSIp0lK1FfuJirfRj37DHY4HVV8Zo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QDFQRSqX6qFJUtI93YyG4XsCuxzM5x--DHDxMObM_4g&oe=6A3A8439"}, {"file_name": "RetroGameDev VR Screen 3.png", "id": "1389679592970341", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823802_1389679596303674_7247600721434857762_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBjWPnVcOWoQ7kNvwFDX133&_nc_oc=AdpC24DqMNNGp-pRcaellQleEP6xTkv0f5J3fpNAzgutjBIY7lSKpqh7LYQhJSOIpSc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oXH67RUC8XtLHHJ27uYPwcXv5fR6UTYVlXfXbJy-NTA&oe=6A3AA866"}, {"file_name": "RetroGameDev VR Screen 4.png", "id": "1363242579026429", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824741_1363242585693095_468145793917944651_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJJPWcVC3hMQ7kNvwFHOdOf&_nc_oc=Adpnf1QqVueKRv9j7wijGJjugTjIUGr6OAlXzOFIFBIoDp4XVKVn6Fkif1at7quhpZg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xPniIrRdL-7Tl-_0BgVu75FfdmGY9lh1Yvrg1Z0V1MA&oe=6A3AB219"}, {"file_name": "RetroGameDev VR Screen 5.png", "id": "1517765113051101", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507883442_1517765116384434_4320304361351719612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjGPDrZ_YD0Q7kNvwEdXLTh&_nc_oc=AdpJFIPJqpFdG-2EM32hUV_WVP8YAe8f7MQxPwMFeQ6s0SXALNip350U4KNhKOZjDnM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lsdYjl1FnTXCTumosANo5HOFhZji2eUCMc6if-WN6sQ&oe=6A3AA6C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2225811551578664", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499311597_2225811554911997_2083852182644206799_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPCWMNz-dIAQ7kNvwHd2zU_&_nc_oc=AdqOjASCq0JgFY68ygYClmUvz1w99Fn0o2JDZkvop7_nsaN7QSVcgYF7yDKvj4GAfJQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yOFaLfliEWsq01u3Af2iT5JuWui2a4zC8fRzJSevGaA&oe=6A3AA5C1"}, "display_name": "RetroGameDev VR", "keywords": ["retrogamedev", "retro", "homebrew", "gamedev", "retrogaming"], "long_description": "Pull up a chair in your own 80s/90s bedroom. The CRT glows and the tools are waiting. RetroGameDev VR is a standalone Meta Quest app \u2014 part time machine, part hands-on workshop: learn how retro hardware really works, create your own games, play them across the room, and export them to run on real retro machines.\n\n**Learn**\n\nBuilt-in lessons open up the graphics, sound, and inner workings of real retro hardware.\n\n**Create and Remix**\n\nStart from a template game and make it your own. Use the built-in editors to redraw sprites, repaint palettes, design backgrounds, and compose sounds and music.\n\n**Play Your Creations**\n\nPlay the games you make on any of the bedroom's three displays \u2014 the desk monitor up close, the big-screen TV across the room, or the handheld you pick up and hold.\n\n**Mixed Reality**\n\nFlip into Mixed Reality anytime. The bedroom drops to passthrough, leaving the screen floating in your own space \u2014 resize it, move it, or play in your real room.\n\n**Export to Real Hardware**\n\nThis is where it leaves the app behind. Turn your creation into a working cartridge that boots on genuine retro machines \u2014 real hardware, not emulation.\n\n**Also Included**\n\nWatch your own video files on the bedroom screens in glorious retro style.\n\n**Emulator Cores**\n\nFree cores for C64, GB, GBC, GBA, NES, SNES, N64, SMS, GG, PS1 can be downloaded in-app. No cores or games are bundled. You create your own or load your own game files, and you are responsible for having the right to use any files you load.", "short_description": "Step into an 80s/90s bedroom and discover how classic game machines really work. Learn the hardware from the inside, create and remix your own retro games with built-in editors, and play your creations right there in the room \u2014 or flip to Mixed Reality and play them in your own space. Then export your game as a real ROM that runs on genuine retro hardware. Part time machine, part hands-on game-making workshop \u2014 a standalone Meta Quest app, no PC needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://retrogamedev.github.io/retrogamedevvr-privacy/", "developer_terms_of_service_url": null, "publisher_name": "RetroGameDev", "support_website_url": "https://www.retrogamedev.com/", "website_url": "https://www.retrogamedev.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27524849047202532"}, "review_messages": []}]}, "cover_square_image"
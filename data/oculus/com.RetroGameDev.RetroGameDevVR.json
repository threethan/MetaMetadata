_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkIinjJRbZ0Q7kNvwFmL2j-&_nc_oc=AdoEM1nJNkoQDkim9ec-mcP7Qqvk-FepjAj72suVk_0QjyWvcN-qxvObdeSmgkjwl24&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MwIayvFpO2QeBz_h51tK6GVa-2vcL6g3qS6UU_YYjuQ&oe=6A2EA6B9"}, {"file_name": "RetroGameDev VR Screen 3.png", "id": "1389679592970341", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_1389679596303674_7247600721434857762_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPrmmrGrIYsQ7kNvwHFdS1z&_nc_oc=AdqcmBOydOTTnOwIHFqjUn88w8v82u3MKfhyH6X1ExkT0cImAgqla6Q0ngTgXxByz6M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_q53s0PZgWQrGMHB6-Fv8Ovly5y22TssY71Dh4NgRHFQ&oe=6A2ECAE6"}, {"file_name": "RetroGameDev VR Screen 4.png", "id": "1363242579026429", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824741_1363242585693095_468145793917944651_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxKCvN5ybpgQ7kNvwEgAF7o&_nc_oc=AdrUOaugFw5LuPQVuXDe--8AsHZRDlVtEXEDS6M1A7fBal2hNG6_hacKHl3VxEGHnI4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0JFR479KvDY6T-Ixr3vOusf3ohMQ18aB6_25jBrPswA&oe=6A2ED499"}, {"file_name": "RetroGameDev VR Screen 5.png", "id": "1517765113051101", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507883442_1517765116384434_4320304361351719612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndjcUxE3re8Q7kNvwEkesH_&_nc_oc=Adp4N46HRkZv6I2pol47O5-CcBIgAbcms6cw5oFDdSCNtkvsapTDi0DSluwdpo6Ck9g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3p75cDh44Oa-C8w5Nvf5MnCJPUW5pBo2GmOaLPMZ5JA&oe=6A2EC941"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2225811551578664", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311597_2225811554911997_2083852182644206799_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrK8fjWZePQQ7kNvwGa4nHZ&_nc_oc=Adp43ksPwQzxlZC-1-b6NrGJzwIZnoGK02xj_szHT6_SNJn5IxX5ur1pKCcg-v9WxDU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lRpa5T1_ENFHydTfIR4ueoB9EmhsCiUAsNFlmgjd0AQ&oe=6A2EC841"}, "display_name": "RetroGameDev VR", "keywords": [], "long_description": "Pull up a chair in your own 80s/90s bedroom. The CRT glows, the posters are up, and the tools are waiting. RetroGameDev VR is part time machine, part hands-on workshop: learn how retro hardware really works, create games of your own, and play your creations across the room.\n\n**Learn**\n\nBuilt-in lessons open up the graphics, sound, and inner workings of real retro hardware, showing you how these classic machines tick from the inside.\n\n**Create and Remix**\n\nStart from a template game and make it your own. Use the built-in editors to redraw sprites, repaint palettes, design backgrounds, and compose your own sounds and music.\n\n**Play Your Creations**\n\nPlay the games you make right there in the bedroom. Optional emulator cores can be downloaded in-app if you also want to load your own game files.\n\n**Export to Real Hardware**\n\nTurn your creation into a working cartridge that boots on genuine retro machines, not just inside the app.\n\n**Also Included**\n\nWatch your own video files on any of the three bedroom screens in glorious retro style.\n\n**Emulator Cores**\n\nFree cores for Game Boy / Game Boy Color / Game Boy Advance, NES, and Commodore 64 can be downloaded in-app. No cores or games are bundled. You create your own or load your own game files, and you are responsible for having the right to use any files you load.", "short_description": "Step into an 80s/90s bedroom and discover how classic game machines really work. Learn the hardware from the inside, create and remix your own retro games in built-in editors, and play your creations right there in the room. Then export your game as a real ROM that runs on genuine retro hardware. Part time machine, part hands-on game-making workshop."}]}, "developer_name": null, "developer_privacy_policy_url": "https://
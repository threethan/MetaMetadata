nt-sjc6-1.oculuscdn.com/v/t64.5771-25/499618293_3788835808092906_4850649435936349109_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbu7_txNJx4Q7kNvwEPwCt6&_nc_oc=Adpbh1Br_NeVp9DN79pcV_hvDeAy0c40FJbzxmADcrZihYqJjIx4MucQZNmBpT6vnuQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-r-QOcY6UvJO18oZ1Tb5V-13GHNe5VTCiH6ikLWIBdVQ&oe=6A355F08"}, {"file_name": "QBC_Screenshot5.png", "id": "3125865464265474", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619751_3125865467598807_1402525965285496418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIFf_ZFXO34Q7kNvwGFCgA4&_nc_oc=AdpfA4Q783oaYALWii783zXxtvWldi73-iRplhEPP_SIgG8bXee-pqnY_fU1_O08GK4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9I_FakDJGdK36brz7WLNItwUfXS9DIzyDezj62NTV8sA&oe=6A356AC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440_safeSelect.png", "id": "2154842111916520", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824203_2154842115249853_2249206814172059012_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsJiQ0AaTqMQ7kNvwGiQI0c&_nc_oc=AdqRPsH6Vc9iOsTOwnePeoXT2UAMYzOl_AzAcbtAb8xuEQKsiPFjyvZ9rRSqAQOosiQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qCNoITYwdz38x_oLmDOHpMshoqJ6DVB8PuNTHRnw2LA&oe=6A353FF1"}, "display_name": "Elev8 VR: Quarterback Football Trainer", "keywords": ["sports", "football", "quarterback", "training", "games"], "long_description": "The most realistic quarterback training experience in VR.\n\nStep into the pocket on Meta Quest 3 and train like a real QB. Read the field, work your progressions, and deliver true-to-football throws with authentic spin, touch, and timing. Every rep sharpens your throw motion - load, separation, release angle, velocity, and consistency - so what you build in VR transfers to the field.\n\nBuilt with pro QB trainer Mike Giovando, Elev8 turns reps into results:\n\n- Game-like drills for accuracy, reads, arm strength, and pocket movement\n- True-to-football ball physics that reward clean mechanics\n- Full-body tracked avatar for realistic footwork and throw motion\n- Next Gen-style stats after every drill, so you see what's improving and what's slipping\n- Adjustable difficulty for quick sessions or deep practice\n\nWhether you're a youth quarterback, a high school starter, or a coach looking for an edge between sessions, Elev8 Academy VR helps you get more high-quality reps than the field alone allows. Use it between in-person sessions to stay locked into your coaching points and track measurable improvement over time.\n\nSnap. Read. Throw. Elev8 your game.", "short_description": "The most realistic quarterback trainer in VR. Step into the pocket on Meta Quest 3 and train like a real QB - read the field, work progressions, and throw with true-to-football spin and timing. Built with pro QB coach Mike Giovando: drills for accuracy, reads, arm strength, and pocket movement, full-body tracking so your footwork transfers to the field, and Next Gen-style stats after every rep. For youth QBs, high school starters, and coaches who want more quality reps than the field allows."}]}, "developer_name": null, "developer_privacy_policy_url": "http://elev8academyvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Vrtcl", "support_website_url": null, "website_url": "https://elev8academyvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["
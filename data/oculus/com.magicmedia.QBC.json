7a0a&_nc_ohc=J9Z6p6qG7kIQ7kNvwHxOYVJ&_nc_oc=Adr4z_2SJh_zoLYuOB0XGSKm4IjSeuSpMrbn13W-ehFsQIwQHkwGnelV8YHc4Ym-ljk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3eKurb1RPF-bcJrbpfPbjOg5Dx1BhFt7CvE9c-PqNC7g&oe=69EA1D06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_2560x1440_safeSelect.png", "id": "809274431026004", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031601_809274434359337_512299568087743903_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPyTTu4Ie3QQ7kNvwHbBlji&_nc_oc=Adry_PrXYm96BeEjSifgew3eqySKIui8kO_YMaB9orE_F842ZaLhyrSDjILImUBhkV4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jiGhewQVNMUrqvH-RMWDN2tZVP7qTu7nTe5eQn_ZzrQ&oe=69EA13BB"}, "display_name": "Elev8AcademyVR Demo", "keywords": [], "long_description": "Elev8 Academy VR  is an innovative training tool designed to enhance quarterback skills through advanced virtual reality technology. Featuring motion capture recordings by professional trainer Mike Giovando, this simulator allows players to overlay Giovando's movements onto their own, providing an immersive learning experience. Users can closely mimic his quarterback motions, receiving real-time feedback on their performance to refine their techniques. A standout feature of the simulator is its realistic replication of the physics involved in the flight of a football. This ensures that when players throw the football within the VR environment, it responds authentically to their unique throwing mechanics. This free demo serves as a showcase, offering users a glimpse of the comprehensive training capabilities available in the full build.", "short_description": "Elev8 Academy VR Demo offers a unique training experience with motion capture from professional Mike Giovando, allowing players to mirror and learn quarterback motions with real-time feedback. The demo also features realistic football physics, providing an authentic throwing experience. This free demo previews the full build's capabilities."}]}, "developer_name": null, "developer_privacy_policy_url": "http://elev8academyvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Vrtcl", "support_website_url": null, "website_url": "http://elev8academyvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6160971017360780"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1170894288447190"}, {"status": "PUBLISHED", "id": "1099971667972876"}]}, "baseline_offer": {"id": "1170894288447190"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1769618880, "status": "PUBLISHED", "id": "1170894288447190"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24181968508167755", "version": "3"}, "id": "414280224488539", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6010572735733943", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24181968508167755"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "414280224488539"}]}, "change_log": "force register input on controllers", "created_date": 1769293173, "
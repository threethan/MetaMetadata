OGO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035352_364297833382983_8118544330931618513_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0_XupMdiugQ7kNvwF3_jKR&_nc_oc=AdkTijt9LYvZ1vYcXk0UpUsOniRvDxPBVvqBFZIedPOIhyimUDUycVoN4yxTQw54Vb4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuPsVh_e4-sBaCqwjgN9rcFri7yLWwfY-jCe9egx1pSFw&oe=69A57BF9"}]}, "id": "423050574120711", "locale": "en_US", "screenshots": [{"file_name": "VRBadminton Coach SC1_V6.png", "id": "489243040581167", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75469627_489243043914500_4221136426933506425_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3Fu54hg9joQ7kNvwEYspQU&_nc_oc=Adn6f7uQx5e_78eh_olQnZW-tqFORqjOsp7J-PALj4r6z3HcIwUj0U10UWmW2TQ5R90&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvcwMmdw468JzDTh5wqLDAWye9_nPqLBWDAYIU_4axaKQ&oe=69A5779E"}, {"file_name": "VRBadminton SC2_V6.png", "id": "353520594479697", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031466_353520597813030_8586315607528233849_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bM0IOjjzMC4Q7kNvwEW5vOK&_nc_oc=AdmeXjGV1-YKPzwLr8jTleTA95GTrWULDomhL9-HTOtt8pN2NV4AXB9w3_WrwSnw1AM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftkzrFPI-hkK3TCIvjxUTwT3T3vr02MhZ9ZE1U4xJsneg&oe=69A59D30"}, {"file_name": "alien Coach SC8.png", "id": "544576281334534", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75195913_544576284667867_7498898132677097396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybCxwOSS_p0Q7kNvwHByJ3_&_nc_oc=Adk2zhXyvhP26-xi3R-r8FXEcr9aoj3B2IqksYCoEYkIlvlpPpcXon_8r_mD8TgVlKQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afsgq5aG7HCv3mQZT1ZBGWUYxRIPsXl3Z5Ai5vGLVb4peQ&oe=69A58E27"}, {"file_name": "VRBadminton Coach Overhead SC8 V2.png", "id": "994098669081927", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974579_994098672415260_2944749652990827622_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QT9zlmmixlsQ7kNvwGmTkE0&_nc_oc=AdnnB2Vf4aXzQYnzSCllvWMK-DyPMoYKSbmJqZc9nv-JoMzJ0v4_dXUF4eWbamGC7R8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afv4jtFWY_a77h1TpGeoaTR-KVR7A7xvyJXaEzfF_plSDw&oe=69A597CD"}, {"file_name": "VRBadminton Coach Badsaber SC3.png", "id": "1027811275231522", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57569436_1027811278564855_1550186934967238395_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qjhUwfHrZ0Q7kNvwE6mT3D&_nc_oc=AdmMbX2QkGpl-_v4OaU1Zj1NS93vtZ2R7nTHsJ8qdrKTM_nti8CLOWwHd-hUDh2K1OU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuRDAJyDjrUi90sfoHxXOzbvdl7QPLteJo9qiu0lLVgMQ&oe=69A591E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRBadminton Coach SC1.png", "id": "497760182856359", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974758_497760186189692_8720907288320587016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6CfNtXOHwcYQ7kNvwEWhT26&_nc_oc=AdlJLhBTZ5CghHGF4w5zfAZOyq1AVqZW_mzCZqXShshibDmoT8rMFs1M2Ex6_9eKjkU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftA8ItErsUJEtxgk6AJ_aVWp53a5rvCu9OYaljthEy_Xg&oe=69A58220"}, "display_name": "Badminton Coach", "keywords": ["Badminton", "Coach", "Training", "Simulation", "Arcade"], "long_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo that focused on the drop shot. Badminton Coach has added new and improved physics as well as drop, drive, skills, and self-coach training scenes. Our live Coach Connect allows your own coach to connect from anywhere in the world and direct your training verbally, and even feed you birdies to the front, middle and back, on either the left, right or center court. \n \nThe arcade mode, fun trainer (Bad Saber) features an additional level where you can target an alien ship flying across the sky and destroy it with your smash or drive shot. \n\nBoth the Bad Saber and the training screens provide scoring for 10 shot sequences so you can gauge your progress.", "short_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo with  new  improved physics and scenes for drop, drive, skills, and self-coach training. Our live Coach Connect allows your own coach to connect from anywhere in the world to direct your training verbally, and  feed you birdies to 9 court positions, and scoring to gauge your progress.\n\nIn Bad Saber,  our fun arcade mode, you can target an alien ship flying across the sky and destroy it with your drive shot."}]}, "developer_name": null, "developer_privacy_policy_url": "https://smashville.us/go/privacy/", "developer_terms_of_service_url": "https://smashville.us/go/tos/", "publisher_name": "Smashville", "support_website_url": null, "website_url": "https://smashville.us/go/vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26622182787428833"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1099332894794598"}, {"status": "PUBLISHED", "id": "1155024595762350"}]}, "baseline_offer": {"id": "1099332894794598"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1736937960, "status": "PUBLISHED", "id": "1099332894794598"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "31783211244659269", "version": "1.3"}, "id":
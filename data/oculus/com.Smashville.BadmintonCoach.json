OGO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035352_364297833382983_8118544330931618513_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ilFS1a63YIQ7kNvwGqRQ71&_nc_oc=Adn4s_7pYxtMKgwaTTbmS9k0z4jzSDPNNrRuj_RLDd14GV8MzGx0gZ7-o7leGMAaITg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv7sUKYazBTcJgTAiHWcDMRHOTNfguJW__6pjPQJJLzbw&oe=69A035F9"}]}, "id": "423050574120711", "locale": "en_US", "screenshots": [{"file_name": "VRBadminton Coach SC1_V6.png", "id": "489243040581167", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75469627_489243043914500_4221136426933506425_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGtlH2cL1JQQ7kNvwGh6kYj&_nc_oc=Adkl3xki8JSrnagi7MvsSvsXEyH72lC2ySrlunxJCDEDUoqfHCmRlLOsPgr4EcoMRs0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsTytuKi1GQ6qeF1IfAstC2yZy4wSc0apVfNvLDtT4orA&oe=69A0319E"}, {"file_name": "VRBadminton SC2_V6.png", "id": "353520594479697", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_353520597813030_8586315607528233849_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7r8VJlMXUEQ7kNvwEDo3pg&_nc_oc=AdlZin9h62hBrHWsB-A2QExEKllk64XzKH6-sNjrFUg6lFKhQ2iOXACy321Q47NjIgs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvyXjQLuKFBs23ugAU-RPR7tE8P_WEvKmH_wQnk7Tt0cQ&oe=69A05730"}, {"file_name": "alien Coach SC8.png", "id": "544576281334534", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195913_544576284667867_7498898132677097396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMWYTr6aAHUQ7kNvwGc28S3&_nc_oc=AdnpZNv2xkPZPfIXh-K-WJImMp8jncYul35FILZQlGuLxNVrW8uho5tA2SBzppxEtMs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfutAysceI6Ucm5T4vj_YOGmu4fFgslZmpcYRtZ71hMQew&oe=69A04827"}, {"file_name": "VRBadminton Coach Overhead SC8 V2.png", "id": "994098669081927", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974579_994098672415260_2944749652990827622_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Op_EEhzb1wYQ7kNvwHWi54F&_nc_oc=Adn-zwjyiEwITFVLhfpSLtHc5UtJ5pYpaBvGTqr5ppVpE2qpUjCpUNLuC3uVTkkiPHo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvQ0b5yNiQpqdBu6Ar6XvXuDesm4YpiGL2WzG27hgX-Sg&oe=69A051CD"}, {"file_name": "VRBadminton Coach Badsaber SC3.png", "id": "1027811275231522", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569436_1027811278564855_1550186934967238395_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3a0HsQqulDkQ7kNvwF_D46U&_nc_oc=AdnCQY1ZO-GUSmjSzguQsh4BzDh8OT5M4fASV50rPPoY8NVI-AYUOCUhqBKlKALtAIk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsiqlk62KLK7z2-fxonxv75DWczR4xYCVOEd3RnX6rLPw&oe=69A04BE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRBadminton Coach SC1.png", "id": "497760182856359", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974758_497760186189692_8720907288320587016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Kchms3H-W0Q7kNvwF0SewD&_nc_oc=AdnxqFr9CgFi0H7519pkBeZd6hAe50pPT5KEytDmvqUpXC8dxsftp6ruDzb6Sa5Hhrg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsiYfARphahtmOeZ3ZU7muaEfSQBuNaTOYA8AIRwVZN1Q&oe=69A03C20"}, "display_name": "Badminton Coach", "keywords": ["Badminton", "Coach", "Training", "Simulation", "Arcade"], "long_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo that focused on the drop shot. Badminton Coach has added new and improved physics as well as drop, drive, skills, and self-coach training scenes. Our live Coach Connect allows your own coach to connect from anywhere in the world and direct your training verbally, and even feed you birdies to the front, middle and back, on either the left, right or center court. \n \nThe arcade mode, fun trainer (Bad Saber) features an additional level where you can target an alien ship flying across the sky and destroy it with your smash or drive shot. \n\nBoth the Bad Saber and the training screens provide scoring for 10 shot sequences so you can gauge your progress.", "short_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo with  new  improved physics and scenes for drop, drive, skills, and self-coach training. Our live Coach Connect allows your own coach to connect from anywhere in the world to direct your training verbally, and  feed you birdies to 9 court positions, and scoring to gauge your progress.\n\nIn Bad Saber,  our fun arcade mode, you can target an alien ship flying across the sky and destroy it with your drive shot."}]}, "developer_name": null, "developer_privacy_policy_url": "https://smashville.us/go/privacy/", "developer_terms_of_service_url": "https://smashville.us/go/tos/", "publisher_name": "Smashville", "support_website_url": null, "website_url": "https://smashville.us/go/vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26622182787428833"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1099332894794598"}, {"status": "PUBLISHED", "id": "1155024595762350"}]}, "baseline_offer": {"id": "1099332894794598"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1736937960, "status": "PUBLISHED", "id": "1099332894794598"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "31783211244659269", "version": "1.3"}, "id":
OGO", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39035352_364297833382983_8118544330931618513_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ilFS1a63YIQ7kNvwGkqXHE&_nc_oc=Adn6J5R7nPG7aIdzWAQSF0Ym7LUM2YoUfjnDlIMdRe5a8ElmOICoIPC9kUrR4_uQQEc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvnSfW8NSnQszzRBlf1eQ2mwnp4o6VKHjwGBsXBmi9VhA&oe=69A18779"}]}, "id": "423050574120711", "locale": "en_US", "screenshots": [{"file_name": "VRBadminton Coach SC1_V6.png", "id": "489243040581167", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75469627_489243043914500_4221136426933506425_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGtlH2cL1JQQ7kNvwGjn7dA&_nc_oc=Adl6_zVp5uCh4y_oPsWE9UL6U14PI3ZlkvMGLVqMSRFPBnf5dhRr1N9NjZ-MCWDsezc&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftMLpKLvKf1HC1vxXIaW01XO4rmPkKZQ_zFRujM0JxmSg&oe=69A1831E"}, {"file_name": "VRBadminton SC2_V6.png", "id": "353520594479697", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031466_353520597813030_8586315607528233849_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FW3aDgmIRtcQ7kNvwFaBDsR&_nc_oc=AdllTSq56Md4nTGLR_z_fAW9SofWCbTHAZ2tv0DZkpt4huq9bqFceM6bNcivVrvvzuo&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuOwp1ov2x4D6IepYbmOvT3Brv8qVIL_5v27DPvJ1keBQ&oe=69A1A8B0"}, {"file_name": "alien Coach SC8.png", "id": "544576281334534", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75195913_544576284667867_7498898132677097396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMWYTr6aAHUQ7kNvwEB-5VI&_nc_oc=AdlGPi6xQt3dRvyEIqoEM9sSMD9V-2eUoVkz3gH46jO9hyBWkCMLiPxsS6kJbWYUxV8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afs4z-Z40txRG9KX74kEjyEwsEwDkBDWzxb0VKiF0G3Rew&oe=69A199A7"}, {"file_name": "VRBadminton Coach Overhead SC8 V2.png", "id": "994098669081927", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974579_994098672415260_2944749652990827622_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4k3E4R7fDcQ7kNvwG5L2Ik&_nc_oc=AdkxoPq3JqSQ9z27uS9zjGb49AF9ATSOpOOYJCCTgknl2kbfILzdmBcsx9mu9eXqYok&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftC_L6eEF09zIDqdvF_XlEIKj6vmAf8_j_7qhpkvAxTLQ&oe=69A1A34D"}, {"file_name": "VRBadminton Coach Badsaber SC3.png", "id": "1027811275231522", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/57569436_1027811278564855_1550186934967238395_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3a0HsQqulDkQ7kNvwG5WBiH&_nc_oc=AdnSCPTLFjfdOuDcv8jY8ILVPn0ufDLiI95Sm4Hi5KdRQvDFXXe3C5upPlvjtuuFrh8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftnbUciTrakpiRX3mVXsbRp4ACbAo9Ed6NGnm0hVq4uLQ&oe=69A19D60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRBadminton Coach SC1.png", "id": "497760182856359", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974758_497760186189692_8720907288320587016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Kchms3H-W0Q7kNvwGcJXX8&_nc_oc=AdmdISu0D77aOci4YW_NsyXkgWpE5FJnYPnrzbz6hNDEIyHcH2y3_zBXzPH2LF2baPU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftLxq7OTzxIWxLxT4130aeZ4w--BpQv-z319Ufktved3g&oe=69A18DA0"}, "display_name": "Badminton Coach", "keywords": ["Badminton", "Coach", "Training", "Simulation", "Arcade"], "long_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo that focused on the drop shot. Badminton Coach has added new and improved physics as well as drop, drive, skills, and self-coach training scenes. Our live Coach Connect allows your own coach to connect from anywhere in the world and direct your training verbally, and even feed you birdies to the front, middle and back, on either the left, right or center court. \n \nThe arcade mode, fun trainer (Bad Saber) features an additional level where you can target an alien ship flying across the sky and destroy it with your smash or drive shot. \n\nBoth the Bad Saber and the training screens provide scoring for 10 shot sequences so you can gauge your progress.", "short_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo with  new  improved physics and scenes for drop, drive, skills, and self-coach training. Our live Coach Connect allows your own coach to connect from anywhere in the world to direct your training verbally, and  feed you birdies to 9 court positions, and scoring to gauge your progress.\n\nIn Bad Saber,  our fun arcade mode, you can target an alien ship flying across the sky and destroy it with your drive shot."}]}, "developer_name": null, "developer_privacy_policy_url": "https://smashville.us/go/privacy/", "developer_terms_of_service_url": "https://smashville.us/go/tos/", "publisher_name": "Smashville", "support_website_url": null, "website_url": "https://smashville.us/go/vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26622182787428833"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1099332894794598"}, {"status": "PUBLISHED", "id": "1155024595762350"}]}, "baseline_offer": {"id": "1099332894794598"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1736937960, "status": "PUBLISHED", "id": "1099332894794598"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "31783211244659269", "version": "1.3"}, "id":
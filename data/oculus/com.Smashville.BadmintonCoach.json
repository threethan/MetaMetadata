OGO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035352_364297833382983_8118544330931618513_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0_XupMdiugQ7kNvwElorNr&_nc_oc=Adn3-4h9eToRm0u_WzShfZJfeYK-rDIBMn06pW-DJtzZkTga616MGWsyP5x40ZYQew0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aftm1qh7sEmcBcqZQChBFI4DXuOMUC9mzmjDk44g9lyiVA&oe=69A42A79"}]}, "id": "423050574120711", "locale": "en_US", "screenshots": [{"file_name": "VRBadminton Coach SC1_V6.png", "id": "489243040581167", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75469627_489243043914500_4221136426933506425_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3Fu54hg9joQ7kNvwE4Y1Wk&_nc_oc=Adkx2sJVaj6aJ_fCJbogpvg2AkOuc-I2N0HXHPRBkzfZ3JSTGCCuoLuIs733L602Pj4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfucbYVLAFK_GohEuf5OPgnITfpmklsUqGkHDg7CvxbJxQ&oe=69A4261E"}, {"file_name": "VRBadminton SC2_V6.png", "id": "353520594479697", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_353520597813030_8586315607528233849_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FW3aDgmIRtcQ7kNvwFZmqDx&_nc_oc=AdkPi8ecP8xSnnKzNPYMef8Td72E_0iAaVJ7OLS0nExwVFrQsGl0WBxOPS5LhmvuXHk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv5qQNY4opb1sNII7iFo9OE9YQGc1h_3ifFUrcfESV4fQ&oe=69A44BB0"}, {"file_name": "alien Coach SC8.png", "id": "544576281334534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195913_544576284667867_7498898132677097396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybCxwOSS_p0Q7kNvwHSwfgV&_nc_oc=AdkjoepaXLPhKvLvwvm0uUmp2n1cl4DyR0Af0RA6ESvoS_BcrAlZ2d64YdSWXCYdhEc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afse_0T-4MjnANquzo65-rmzwlZ_Sy4yAmosyNBdriycKQ&oe=69A43CA7"}, {"file_name": "VRBadminton Coach Overhead SC8 V2.png", "id": "994098669081927", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974579_994098672415260_2944749652990827622_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4k3E4R7fDcQ7kNvwHVYVGz&_nc_oc=Adn0eQzRH5cAmeVNNd9BH2VO1E9mgYXoytzzSVr48r38hAinmf68b2lpjvhTz8tWH4w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftH0ssPYDbkm418zLXdnduw_X0NRDLn0FiNRqpOxoSsgA&oe=69A4464D"}, {"file_name": "VRBadminton Coach Badsaber SC3.png", "id": "1027811275231522", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569436_1027811278564855_1550186934967238395_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qjhUwfHrZ0Q7kNvwGq5aoS&_nc_oc=Adnkx2Lx33Jce4fwxJoeFuXD_6UcHSQ--52UYCRz055923rpBw61ly5ihOwekQ30BeM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftbbjdsM5_7ewxQL38ub0l0A_zuJguSPhyX1Ua7yNr4eA&oe=69A44060"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRBadminton Coach SC1.png", "id": "497760182856359", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974758_497760186189692_8720907288320587016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6CfNtXOHwcYQ7kNvwFc-FGi&_nc_oc=AdkFk_ZXWNNDEXikX7LYsxdRL8knzZd0YSqfJkdU1l-4dqNMzR9eoH6yDmsVho2qJLE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsT36dvuCrNgvIsR_Ws2LW1hJVFDPIPlabuKlFKmga7Tg&oe=69A430A0"}, "display_name": "Badminton Coach", "keywords": ["Badminton", "Coach", "Training", "Simulation", "Arcade"], "long_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo that focused on the drop shot. Badminton Coach has added new and improved physics as well as drop, drive, skills, and self-coach training scenes. Our live Coach Connect allows your own coach to connect from anywhere in the world and direct your training verbally, and even feed you birdies to the front, middle and back, on either the left, right or center court. \n \nThe arcade mode, fun trainer (Bad Saber) features an additional level where you can target an alien ship flying across the sky and destroy it with your smash or drive shot. \n\nBoth the Bad Saber and the training screens provide scoring for 10 shot sequences so you can gauge your progress.", "short_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo with  new  improved physics and scenes for drop, drive, skills, and self-coach training. Our live Coach Connect allows your own coach to connect from anywhere in the world to direct your training verbally, and  feed you birdies to 9 court positions, and scoring to gauge your progress.\n\nIn Bad Saber,  our fun arcade mode, you can target an alien ship flying across the sky and destroy it with your drive shot."}]}, "developer_name": null, "developer_privacy_policy_url": "https://smashville.us/go/privacy/", "developer_terms_of_service_url": "https://smashville.us/go/tos/", "publisher_name": "Smashville", "support_website_url": null, "website_url": "https://smashville.us/go/vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26622182787428833"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1099332894794598"}, {"status": "PUBLISHED", "id": "1155024595762350"}]}, "baseline_offer": {"id": "1099332894794598"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1736937960, "status": "PUBLISHED", "id": "1099332894794598"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "31783211244659269", "version": "1.3"}, "id":
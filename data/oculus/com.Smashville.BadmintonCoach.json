081927", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974579_994098672415260_2944749652990827622_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqN4365PDNsQ7kNvwF3cdWe&_nc_oc=AdrYLo0fn8x3p8dsK789138yS-qdh_-cVnemH2khXWuoLjDpRAhIrqbwV_cD2NxZn9o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-Zf1MhHY5l659RzrKx-CGawdDzxK0uClQS83BPo0Lzw&oe=6ACF8ACD"}, {"file_name": "VRBadminton Coach Badsaber SC3.png", "id": "1027811275231522", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569436_1027811278564855_1550186934967238395_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yP2_TFegMvsQ7kNvwGrT2aV&_nc_oc=Ado1M0-0qRFtI0cVLOlkeHqiMBM2MxCCPiFRXgK2b8Fv_J1Zj5xaPGJvFbjRa3SXnew&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWFC3vuzlOYLdSIe16zkzBXo_rXKKsz1utPLdz-q05qA&oe=6ACF84E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRBadminton Coach SC1.png", "id": "497760182856359", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974758_497760186189692_8720907288320587016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSP5UtJ-i9sQ7kNvwET-CxV&_nc_oc=AdppPbn2wDSJgKjwXh1G6Cm_vjobTTWzdVoaCVw-SLV6BJNq1DwmihuRsoUPHRo26kQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQXLn1AziD2R1j_0LvnAd5L4rRL5w63k7XNvsdINf6oA&oe=6ACFAD60"}, "display_name": "Badminton Coach", "keywords": ["Badminton", "Coach", "Training", "Simulation", "Arcade"], "long_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo that focused on the drop shot. Badminton Coach has added new and improved physics as well as drop, drive, skills, and self-coach training scenes. Our live Coach Connect allows your own coach to connect from anywhere in the world and direct your training verbally, and even feed you birdies to the front, middle and back, on either the left, right or center court. \n \nThe arcade mode, fun trainer (Bad Saber) features an additional level where you can target an alien ship flying across the sky and destroy it with your smash or drive shot. \n\nBoth the Bad Saber and the training screens provide scoring for 10 shot sequences so you can gauge your progress.", "short_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo with  new  improved physics and scenes for drop, drive, skills, and self-coach training. Our live Coach Connect allows your own coach to connect from anywhere in the world to direct your training verbally, and  feed you birdies to 9 court positions, and scoring to gauge your progress.\n\nIn Bad Saber,  our fun arcade mode, you can target an alien ship flying across the sky and destroy it with your drive shot."}]}, "developer_name": null, "developer_privacy_policy_url": "https://smashville.us/go/privacy/", "developer_terms_of_service_url": "https://smashville.us/go/tos/", "publisher_name": "Smashville", "support_website_url": null, "website_url": "https://smashville.us/go/vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26622182787428833"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1099332894794598"}, {"status": "PUBLISHED", "id": "1155024595762350"}]}, "baseline_offer": {"id": "1099332894794598"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 17369
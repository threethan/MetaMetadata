ashville sock logo3 556-164.png", "id": "364297830049650", "image_type": "APP_IMG_IMMERSIVE_LAYER_LOGO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035352_364297833382983_8118544330931618513_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBa2EULdMbQQ7kNvwGaQ3xQ&_nc_oc=AdmIna0fIRfuik_R3Xot66gpFO4vWTgYhzefdkhlxpP8WaoobM1-SRXK87_7HEtFUEo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzaKztIJuTkJedpNAWknJPECHoWsT2pd04bPfcBRHuNSw&oe=69AC1379"}]}, "id": "423050574120711", "locale": "en_US", "screenshots": [{"file_name": "VRBadminton Coach SC1_V6.png", "id": "489243040581167", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75469627_489243043914500_4221136426933506425_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RX7yv8mlMuEQ7kNvwGOJNBh&_nc_oc=AdltnefaI1apraihVbt2VSeCMEi9atBpSGt459hCB9MzQxe6oXthgaeMFBnQyQ7FiUU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwYIU6PT3_0n83IDpo0Qh6tmlYON7VlZK6D1joPzfsvkg&oe=69AC0F1E"}, {"file_name": "VRBadminton SC2_V6.png", "id": "353520594479697", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_353520597813030_8586315607528233849_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hW7BcaLO6LMQ7kNvwGZBc9f&_nc_oc=Admnme52hraZi__hEmyoOt8Qaj3JZwb7AqQa5_q98SWKdO1TRufjvYC7fSmlth5SwfE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyXGWmKWC3vMG3wP2w3qpqzaAqcmIw7k82N8Il9ZMUJyg&oe=69AC34B0"}, {"file_name": "alien Coach SC8.png", "id": "544576281334534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195913_544576284667867_7498898132677097396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95msfYZVCCAQ7kNvwHtqNHi&_nc_oc=AdkLy5xM53HS1YBpBlCe1-ZhyE9syWuJCskNPAvLlal5wSzVSdgzJtCNdNVUp4In_Vw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyGgOT1Cxi-WOSJ2B1nv1iPlVw4SEwnx4y3l8dB9n2NFA&oe=69AC25A7"}, {"file_name": "VRBadminton Coach Overhead SC8 V2.png", "id": "994098669081927", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974579_994098672415260_2944749652990827622_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQzj1DkoVmQQ7kNvwFxd7Ni&_nc_oc=Adl1CUjNllZtn-fx8G-oQsbHr6nf5CCUvl8kM1jE3ANfT1Ermepv24q_ULnDfiqOSHY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxV5F5r-KTghZxQf9hvg8xgfiw0-XXDoB3wLGWJoF5rEw&oe=69AC2F4D"}, {"file_name": "VRBadminton Coach Badsaber SC3.png", "id": "1027811275231522", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569436_1027811278564855_1550186934967238395_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEzOP0PuXZ4Q7kNvwEhq986&_nc_oc=Adlp3QEdW6q_GE-dz6BMysRU0tTFYktvDmzottlW-r0h3iXiZb3HddUX5_Ou0Ob_bAg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyinJMUmev8Ljf6vF5aPwS28SvVUEsXIVu-asN93yNbQw&oe=69AC2960"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRBadminton Coach SC1.png", "id": "497760182856359", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974758_497760186189692_8720907288320587016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSXOj5N4KTcQ7kNvwFzC53h&_nc_oc=AdnTEWO7RTJ5oEB-pWEZ4M2QV5aKrTTVmlPeIKiRF6Jp7iKa7jLoreB-iazDNmtGeUU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy5ndiigI1RiAjp-kI6wGt9nucNVjU9alrO63lzUXADTg&oe=69AC19A0"}, "display_name": "Badminton Coach", "keywords": ["Badminton", "Coach", "Training", "Simulation", "Arcade"], "long_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo that focused on the drop shot. Badminton Coach has added new and improved physics as well as drop, drive, skills, and self-coach training scenes. Our live Coach Connect allows your own coach to connect from anywhere in the world and direct your training verbally, and even feed you birdies to the front, middle and back, on either the left, right or center court. \n \nThe arcade mode, fun trainer (Bad Saber) features an additional level where you can target an alien ship flying across the sky and destroy it with your smash or drive shot. \n\nBoth the Bad Saber and the training screens provide scoring for 10 shot sequences so you can gauge your progress.", "short_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo with  new  improved physics and scenes for drop, drive, skills, and self-coach training. Our live Coach Connect allows your own coach to connect from anywhere in the world to direct your training verbally, and  feed you birdies to 9 court positions, and scoring to gauge your progress.\n\nIn Bad Saber,  our fun arcade mode, you can target an alien ship flying across the sky and destroy it with your drive shot."}]}, "developer_name": null, "developer_privacy_policy_url": "https://smashville.us/go/privacy/", "developer_terms_of_service_url": "https://smashville.us/go/tos/", "publisher_name": "Smashville", "support_website_url": null, "website_url": "https://smashville.us/go/vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26622182787428833"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1099332894794598"}, {"status": "PUBLISHED", "id": "1155024595762350"}]}, "baseline_offer": {"id": "1099332894794598"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1736937960, "status": "PUBLISHED", "id": "1099332894794598"}]}, "liveChannel"
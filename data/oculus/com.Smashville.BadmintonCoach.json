_type": "APP_IMG_IMMERSIVE_LAYER_LOGO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035352_364297833382983_8118544330931618513_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9ygulPI9bIQ7kNvwGGErjT&_nc_oc=Ado0Q0VT42H09hhyr8F4ao2Y_eWZo9boAm22Fo6afQhqjbbAV-eJawV5053sty2CCC4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXral6zOGDJlemTsb2Y_hl1NZlBEK1uLKTdvEKSpVukg&oe=6AFDCBB9"}]}, "id": "423050574120711", "locale": "en_US", "screenshots": [{"file_name": "VRBadminton Coach SC1_V6.png", "id": "489243040581167", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75469627_489243043914500_4221136426933506425_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cz7nVSfIYnoQ7kNvwE2a4x_&_nc_oc=AdpFtulrnTnvLMAoeAUBZVceFZ_yWCiINaNRg5Kown9PaeWfCTCjApXVhyZADaAHDEA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkLte1JhhAbsL25_r8tdR8lu1x2vr1AjYfBYGb74RxFA&oe=6AFDC75E"}, {"file_name": "VRBadminton SC2_V6.png", "id": "353520594479697", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_353520597813030_8586315607528233849_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0X1DtcXurMQ7kNvwGiqrN2&_nc_oc=Adr_pzD2NeHQaqFO0lccisarmk7bBt4TF0VagmSmFrG8YKymtaeFm05bC00QrMwJqQU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSY4210R9_ZVYKDyt2na7AwzJJ7x5_zEey2vT3FWcYb2g&oe=6AFDB4B0"}, {"file_name": "alien Coach SC8.png", "id": "544576281334534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195913_544576284667867_7498898132677097396_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5EWxrjlprgQ7kNvwEieWkm&_nc_oc=AdpO2qn3pKDWNjlzno5XDSCfhdVBrryKVuYA4WackwAKpF8yt_h-RQ33f6nc78ONmVk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQ5nFLGollj2lku_YurGnWP5jnzp5Wz5_mXEowdNP4Vg&oe=6AFDDDE7"}, {"file_name": "VRBadminton Coach Overhead SC8 V2.png", "id": "994098669081927", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974579_994098672415260_2944749652990827622_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsdITHU05-4Q7kNvwHsOzb8&_nc_oc=AdoFvOg9AzKXxedJ3fcKyZ14RFnphI2xgiI5v1_JEhPHVYeZO7xz5kUcbuYpsKsS5NE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8OfRZpoAPAK2SmqYM21S4iYzGVJhCSdbf3E7jbRz76Q&oe=6AFDAF4D"}, {"file_name": "VRBadminton Coach Badsaber SC3.png", "id": "1027811275231522", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569436_1027811278564855_1550186934967238395_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuvBX3UbickQ7kNvwFmAOo4&_nc_oc=AdqMaHH_bPFxtbBngCEcKWV3ois5QwAnG05K1_U7XiYfGhMuMRqGUM3c38g4UOCduVk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNN9mIHFPvOJryoLcmtekFLuNEhcEnhohOBOpI6hXrzg&oe=6AFDE1A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRBadminton Coach SC1.png", "id": "497760182856359", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974758_497760186189692_8720907288320587016_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ErI33bFDw5MQ7kNvwFYAtlb&_nc_oc=AdrBVTB-NwU5bkhcP2mXMUKirfuORnt8BgNTBP2_0V35YBn9pfx7omFIH_exvPtSeb4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_gSd8HSj1-j3wjhxX98HekCxkHZGH5fIuUcoOke5TRQ&oe=6AFDD1E0"}, "display_name": "Badminton Coach", "keywords": ["Badminton", "Coach", "Training", "Simulation", "Arcade"], "long_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo that focused on the drop shot. Badminton Coach has added new and improved physics as well as drop, drive, skills, and self-coach training scenes. Our live Coach Connect allows your own coach to connect from anywhere in the world and direct your training verbally, and even feed you birdies to the front, middle and back, on either the left, right or center court. \n \nThe arcade mode, fun trainer (Bad Saber) features an additional level where you can target an alien ship flying across the sky and destroy it with your smash or drive shot. \n\nBoth the Bad Saber and the training screens provide scoring for 10 shot sequences so you can gauge your progress.", "short_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo with  new  improved physics and scenes for drop, drive, skills, and self-coach training. Our live Coach Connect allows your own coach to connect from anywhere in the world to direct your training verbally, and  feed you birdies to 9 court positions, and scoring to gauge your progress.\n\nIn Bad Saber,  our fun arcade mode, you can target an alien ship flying across the sky and destroy it with your drive shot."}]}, "developer_name": null, "developer_privacy_policy_url": "https://smashville.us/go/privacy/", "developer_terms_of_service_url": "https://smashville.us/go/tos/", "publisher_name": "Smashville", "support_website_url": null, "website_url": "https://smashville.us/go/vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26622182787428833"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1099332894794598"}, {"status": "PUBLISHED", "id": "1155024595762350"}]}, "baseline_offer": {"id": "1099332894794
081927", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974579_994098672415260_2944749652990827622_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozJC5PngVuYQ7kNvwG7WwAH&_nc_oc=Adok08ewUNHIoD77urY7B0WsJcpmA76BwUsGc_ipmQhakXdUjZ2GchVYASo7vElgpEI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyllRpXG8uq-mUpxsq7i_jESV6LAcEmXWoWnjOJGxeig&oe=6A709ECD"}, {"file_name": "VRBadminton Coach Badsaber SC3.png", "id": "1027811275231522", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569436_1027811278564855_1550186934967238395_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0XEoCFQfRwQ7kNvwEraedt&_nc_oc=AdqdT3d7xo1POIUS3ydxIf2EE3dovqd5RpRDAP70nIbdzOptw3Y6isaNIdtWPYIC0ks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXjpgsRkOVCvbfK4yyJu-tCHAUTveMo_CsfqliLOGMEw&oe=6A7098E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRBadminton Coach SC1.png", "id": "497760182856359", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974758_497760186189692_8720907288320587016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZ56v62mx_8Q7kNvwGJuhjX&_nc_oc=Adq2cwkE5x-8uCorisO6EYtWG4afRoL5SvgJ4xwo2VbX_HihwSFPkH_ksPuf8bWsAiA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFnjEjDXXCew99wrCqmQmVHGRZ0uC5wHxY1gYE43oXMw&oe=6A708920"}, "display_name": "Badminton Coach", "keywords": ["Badminton", "Coach", "Training", "Simulation", "Arcade"], "long_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo that focused on the drop shot. Badminton Coach has added new and improved physics as well as drop, drive, skills, and self-coach training scenes. Our live Coach Connect allows your own coach to connect from anywhere in the world and direct your training verbally, and even feed you birdies to the front, middle and back, on either the left, right or center court. \n \nThe arcade mode, fun trainer (Bad Saber) features an additional level where you can target an alien ship flying across the sky and destroy it with your smash or drive shot. \n\nBoth the Bad Saber and the training screens provide scoring for 10 shot sequences so you can gauge your progress.", "short_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo with  new  improved physics and scenes for drop, drive, skills, and self-coach training. Our live Coach Connect allows your own coach to connect from anywhere in the world to direct your training verbally, and  feed you birdies to 9 court positions, and scoring to gauge your progress.\n\nIn Bad Saber,  our fun arcade mode, you can target an alien ship flying across the sky and destroy it with your drive shot."}]}, "developer_name": null, "developer_privacy_policy_url": "https://smashville.us/go/privacy/", "developer_terms_of_service_url": "https://smashville.us/go/tos/", "publisher_name": "Smashville", "support_website_url": null, "website_url": "https://smashville.us/go/vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26622182787428833"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1099332894794598"}, {"status": "PUBLISHED", "id": "1155024595762350"}]}, "baseline_offer": {"id": "1099332894794598"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 17369
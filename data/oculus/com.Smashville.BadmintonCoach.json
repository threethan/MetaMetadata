OGO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035352_364297833382983_8118544330931618513_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ilFS1a63YIQ7kNvwER1Gtb&_nc_oc=Adki7wkxHyCSV3VivOzfH337nnwlgIaBHzUCMtrCvMfx9FBPTrnWLJJymKSIJ7G75es&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvFuleeSan8k7jZFZsiuhVXme6Ew3GTmSeCsvtT7FiTiw&oe=69A2D8F9"}]}, "id": "423050574120711", "locale": "en_US", "screenshots": [{"file_name": "VRBadminton Coach SC1_V6.png", "id": "489243040581167", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75469627_489243043914500_4221136426933506425_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGtlH2cL1JQQ7kNvwFIOY5r&_nc_oc=AdkQvwYEwWduJcepGDtG-tEhBeta33lLMHHwwq_w2lLA9yiA8Sef9zgbhqfm-akK894&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsI0B0L1xfNRxwc8OG7MCHRhNsfEUp1Da__4ehXAlJ-2Q&oe=69A2D49E"}, {"file_name": "VRBadminton SC2_V6.png", "id": "353520594479697", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_353520597813030_8586315607528233849_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FW3aDgmIRtcQ7kNvwFPFMF-&_nc_oc=Adl2CYKqp0DK49qCtRG6Mul8hx_2wxL5ykJiMYH01fWrVDaBiJGkRideRLNO_tGS6MU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftmniFerGmlDLa7eHG_UCOh-_9J7ZFTR9Nbu3viqsQ_7g&oe=69A2FA30"}, {"file_name": "alien Coach SC8.png", "id": "544576281334534", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195913_544576284667867_7498898132677097396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybCxwOSS_p0Q7kNvwHlhMp6&_nc_oc=AdmDJOgNVM5-M7A2bztNu-3dBiHlNJXEMbn98g5Aaw9gCyHokwNmSzeuhCDN3ohDyh0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvlv9xTik2lmbi5QWmGP0W5xkffHCxv2m7LUtgR4i2rZw&oe=69A2EB27"}, {"file_name": "VRBadminton Coach Overhead SC8 V2.png", "id": "994098669081927", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974579_994098672415260_2944749652990827622_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4k3E4R7fDcQ7kNvwELLXlq&_nc_oc=Adk2SCUDh1KVmt1PGxQCAdu9ea5swNsCYAWkgKD3h_y4Z3xiT7qV3SRKJ81eK0FRX5E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs6kjpbCCWQlBM-qwI3feh6pzEjAOMkpuDi5mW0Aa81bw&oe=69A2F4CD"}, {"file_name": "VRBadminton Coach Badsaber SC3.png", "id": "1027811275231522", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569436_1027811278564855_1550186934967238395_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3a0HsQqulDkQ7kNvwGBzKRp&_nc_oc=AdkKo9lU_Z4zL1ITHlVN2mxjYPgDqia2arMqCAtfTm5rdryWiO-li5ZZURbi4ccJy_0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsidQGVTSBRVtaX7Z000xqrW-eY6gqfftLOpHuEaZxS2Q&oe=69A2EEE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRBadminton Coach SC1.png", "id": "497760182856359", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974758_497760186189692_8720907288320587016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Kchms3H-W0Q7kNvwGzyQtB&_nc_oc=Adm40GbvxRezgn4PUVdtDBG8YMNgcgFr0FwA_9e6dSan3jMbnTlSp_9Sg2U606SEQNs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvihoTTI11tXKC1bKYijBg5Zc6gY8rE_d5_KTWnUjMN3A&oe=69A2DF20"}, "display_name": "Badminton Coach", "keywords": ["Badminton", "Coach", "Training", "Simulation", "Arcade"], "long_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo that focused on the drop shot. Badminton Coach has added new and improved physics as well as drop, drive, skills, and self-coach training scenes. Our live Coach Connect allows your own coach to connect from anywhere in the world and direct your training verbally, and even feed you birdies to the front, middle and back, on either the left, right or center court. \n \nThe arcade mode, fun trainer (Bad Saber) features an additional level where you can target an alien ship flying across the sky and destroy it with your smash or drive shot. \n\nBoth the Bad Saber and the training screens provide scoring for 10 shot sequences so you can gauge your progress.", "short_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo with  new  improved physics and scenes for drop, drive, skills, and self-coach training. Our live Coach Connect allows your own coach to connect from anywhere in the world to direct your training verbally, and  feed you birdies to 9 court positions, and scoring to gauge your progress.\n\nIn Bad Saber,  our fun arcade mode, you can target an alien ship flying across the sky and destroy it with your drive shot."}]}, "developer_name": null, "developer_privacy_policy_url": "https://smashville.us/go/privacy/", "developer_terms_of_service_url": "https://smashville.us/go/tos/", "publisher_name": "Smashville", "support_website_url": null, "website_url": "https://smashville.us/go/vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26622182787428833"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1099332894794598"}, {"status": "PUBLISHED", "id": "1155024595762350"}]}, "baseline_offer": {"id": "1099332894794598"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1736937960, "status": "PUBLISHED", "id": "1099332894794598"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "31783211244659269", "version": "1.3"}, "id":
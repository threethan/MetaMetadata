ashville sock logo3 556-164.png", "id": "364297830049650", "image_type": "APP_IMG_IMMERSIVE_LAYER_LOGO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035352_364297833382983_8118544330931618513_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnVte-RRec4Q7kNvwHctFNz&_nc_oc=Adn218eK5z-mneK0ve3d8PweBQiVrCVzCeuxYhlEAGEtDelOGfO-CbIcJJu1qaMnw64&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfztFZFxWGxvD1dCiBGNCoEz5iik2DRZ47_CWzvZ83tubw&oe=69BFD9F9"}]}, "id": "423050574120711", "locale": "en_US", "screenshots": [{"file_name": "VRBadminton Coach SC1_V6.png", "id": "489243040581167", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75469627_489243043914500_4221136426933506425_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npQ0YZ1mQaoQ7kNvwFTLIDy&_nc_oc=Adlwg750wQFpR1FQeS6LOB7XWjfvfS_XGbw_TvyRiBSYqJmPR0vqQ3qoL8Umf-RngRM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfypPBirUIXq581g8bH_lvPzOhI1zik6WBBKPkpVrY3VNw&oe=69BFD59E"}, {"file_name": "VRBadminton SC2_V6.png", "id": "353520594479697", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_353520597813030_8586315607528233849_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1fc3IRtiC4Q7kNvwFB1P02&_nc_oc=Adk7Z_xr2ZfqF7tsw30dHQX3e0u6Z6f5PvMTxGBUV0xBIqQP40z6p88O775X7sr6qXQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzOgnWs2zLwqw30rX3BFFAsVrGtya58GwJHRgsr3aZ4jA&oe=69BFFB30"}, {"file_name": "alien Coach SC8.png", "id": "544576281334534", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195913_544576284667867_7498898132677097396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kcTU65kGkEQ7kNvwHdI3RC&_nc_oc=AdmJXzUJFh70zeaWotPXUm2CPjgsEqkB1ElBWo1XN3pc4yzF_AQ8OqpJYEHwi5mXaSM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzsdTSbHJ_QPCtnukJjtR4iZWBwEKWZTWh6LqXO3B5xZg&oe=69BFEC27"}, {"file_name": "VRBadminton Coach Overhead SC8 V2.png", "id": "994098669081927", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974579_994098672415260_2944749652990827622_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBaurDqZRqMQ7kNvwE0ZVNc&_nc_oc=Adlf9XctpTaEsNcTXFjhwpwEpj8YF6EGkRnEPocKKCW7zu-prjhOzdkGllvkvvndtrE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyBUCu_AxMH3sT6GE0Cyqg1kRpJt_KalDW_MMY-J4n5vQ&oe=69BFF5CD"}, {"file_name": "VRBadminton Coach Badsaber SC3.png", "id": "1027811275231522", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569436_1027811278564855_1550186934967238395_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-e0W-BO1yRwQ7kNvwE1lRgm&_nc_oc=AdlsNoeeG3nJrGRmV767p2BtMWp89i1OuXgkp7SpeXo_ssXEoxb1RHIvUcToUr7Wr3s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzQMQhRyrNBC1Cel9HyUa8-ruU-cKiByzqTZyEivzwpPA&oe=69BFEFE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRBadminton Coach SC1.png", "id": "497760182856359", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974758_497760186189692_8720907288320587016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8rFUmAjc3UQ7kNvwGMSgbd&_nc_oc=Adkpt2ltE11QkublxVAS43F6PPg8QBM37CDcptRtO4YXZN4amTGRwJ39Z40sYuQ_buA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfznwvCFyfxIY_EqgKq2GivNOL06RbcohjwkVoXvOBl6_Q&oe=69BFE020"}, "display_name": "Badminton Coach", "keywords": ["Badminton", "Coach", "Training", "Simulation", "Arcade"], "long_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo that focused on the drop shot. Badminton Coach has added new and improved physics as well as drop, drive, skills, and self-coach training scenes. Our live Coach Connect allows your own coach to connect from anywhere in the world and direct your training verbally, and even feed you birdies to the front, middle and back, on either the left, right or center court. \n \nThe arcade mode, fun trainer (Bad Saber) features an additional level where you can target an alien ship flying across the sky and destroy it with your smash or drive shot. \n\nBoth the Bad Saber and the training screens provide scoring for 10 shot sequences so you can gauge your progress.", "short_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo with  new  improved physics and scenes for drop, drive, skills, and self-coach training. Our live Coach Connect allows your own coach to connect from anywhere in the world to direct your training verbally, and  feed you birdies to 9 court positions, and scoring to gauge your progress.\n\nIn Bad Saber,  our fun arcade mode, you can target an alien ship flying across the sky and destroy it with your drive shot."}]}, "developer_name": null, "developer_privacy_policy_url": "https://smashville.us/go/privacy/", "developer_terms_of_service_url": "https://smashville.us/go/tos/", "publisher_name": "Smashville", "support_website_url": null, "website_url": "https://smashville.us/go/vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26622182787428833"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1099332894794598"}, {"status": "PUBLISHED", "id": "1155024595762350"}]}, "baseline_offer": {"id": "1099332894794598"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1736937960, "status": "PUBLISHED", "id": "1099332894794598"}]}, "liveChannel"
ashville sock logo3 556-164.png", "id": "364297830049650", "image_type": "APP_IMG_IMMERSIVE_LAYER_LOGO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035352_364297833382983_8118544330931618513_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SI2PEzeDtzQQ7kNvwHRBUZE&_nc_oc=AdkX40fMHGqOypb1YDtqzdrX3Z4Iv6bPbWrrJVUniT8s5JC03CvWmDjLBg7wUnk9wWM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDMqlv6LG1kbksrJgbA51UX8Vx9Jq-F7y10MCDecG5zQ&oe=69B54DF9"}]}, "id": "423050574120711", "locale": "en_US", "screenshots": [{"file_name": "VRBadminton Coach SC1_V6.png", "id": "489243040581167", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75469627_489243043914500_4221136426933506425_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J97CGkvn6R8Q7kNvwG865Dn&_nc_oc=AdmOSmvLz6predAD3Kyl2-pAfsf5hY6IsCBiWTxbYGHFWgrYvI6muSCB8ephQ5gvygA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxjCJcKM1Rcu5QrRIeJuLfpX5PIAwi5JOPL0Ywmrlh7eQ&oe=69B5499E"}, {"file_name": "VRBadminton SC2_V6.png", "id": "353520594479697", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_353520597813030_8586315607528233849_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CR5M3WKHlMYQ7kNvwGHDc2m&_nc_oc=AdlvPBkgH7bmjLl0iPBoQptPPXf91fztNVCtExNXRmAItfL5cqXNDg8MUDbaNjtLVXk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz9a3YVCTU1bLa1iRt-TXzsnw0KPhZ0GDby3H9IEYCt8w&oe=69B56F30"}, {"file_name": "alien Coach SC8.png", "id": "544576281334534", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195913_544576284667867_7498898132677097396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMBsQgDQJnQQ7kNvwHKgMrQ&_nc_oc=AdlgqyyyRPFvbXsdcnZs64eD3fnoP60ItfdQD0tS9AsR0pu-NKQFgRSpB8ecP8Nn5M8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxNdBnh4k1apuolXHBbtacURrJWDoT1stNF-wI3Pt_snA&oe=69B56027"}, {"file_name": "VRBadminton Coach Overhead SC8 V2.png", "id": "994098669081927", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974579_994098672415260_2944749652990827622_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0f0Ou-J9vMQ7kNvwHdfTTV&_nc_oc=Adn_iUjJdAE5M9xTRBNxuDJ5ZKOfUvhMlhsct_5HH8m-SmPtxHJcCIMbspMwrKEo6Wo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5tfKYHkemkCuuDPyV0sTRFg3mS64CTBDhkCPFXc0KQw&oe=69B569CD"}, {"file_name": "VRBadminton Coach Badsaber SC3.png", "id": "1027811275231522", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569436_1027811278564855_1550186934967238395_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPbHBKy8u94Q7kNvwEuHhQb&_nc_oc=AdmCzgsf8SU4tjP28SMdkH5xnv1Q8h-v7d9L1pkEfauhO_tN7OFekHgYPlm0oOL2rpQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwLIlQnW4cbm2Tw9w9HLaoGJniRiF9WHrFpuoQ2hgn6WA&oe=69B563E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRBadminton Coach SC1.png", "id": "497760182856359", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974758_497760186189692_8720907288320587016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0s0rBQGo7IQ7kNvwHL0aFm&_nc_oc=AdmBz_5LXZudRsO5KFZ20GVH-ym-43tAa1FQFEjqrGiGLg3ceudGTmGyyppO_MBOwUs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzpRRHVU2YhDpSaV_hIDT6RFE5-WvbWaYrq09n4AhSg3w&oe=69B55420"}, "display_name": "Badminton Coach", "keywords": ["Badminton", "Coach", "Training", "Simulation", "Arcade"], "long_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo that focused on the drop shot. Badminton Coach has added new and improved physics as well as drop, drive, skills, and self-coach training scenes. Our live Coach Connect allows your own coach to connect from anywhere in the world and direct your training verbally, and even feed you birdies to the front, middle and back, on either the left, right or center court. \n \nThe arcade mode, fun trainer (Bad Saber) features an additional level where you can target an alien ship flying across the sky and destroy it with your smash or drive shot. \n\nBoth the Bad Saber and the training screens provide scoring for 10 shot sequences so you can gauge your progress.", "short_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo with  new  improved physics and scenes for drop, drive, skills, and self-coach training. Our live Coach Connect allows your own coach to connect from anywhere in the world to direct your training verbally, and  feed you birdies to 9 court positions, and scoring to gauge your progress.\n\nIn Bad Saber,  our fun arcade mode, you can target an alien ship flying across the sky and destroy it with your drive shot."}]}, "developer_name": null, "developer_privacy_policy_url": "https://smashville.us/go/privacy/", "developer_terms_of_service_url": "https://smashville.us/go/tos/", "publisher_name": "Smashville", "support_website_url": null, "website_url": "https://smashville.us/go/vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26622182787428833"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1099332894794598"}, {"status": "PUBLISHED", "id": "1155024595762350"}]}, "baseline_offer": {"id": "1099332894794598"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1736937960, "status": "PUBLISHED", "id": "1099332894794598"}]}, "liveChannel"
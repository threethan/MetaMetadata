ashville sock logo3 556-164.png", "id": "364297830049650", "image_type": "APP_IMG_IMMERSIVE_LAYER_LOGO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035352_364297833382983_8118544330931618513_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qw4NWivBrw8Q7kNvwHWc2FP&_nc_oc=Adk8zSwLYw3w8xszK3ODkjzI6B97H8rduOY3MPmOl6YQciM1o1oxivGg3AT2qTZ6pSg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfycITq06GqrWMFLjo7SlNvAciKf6Ty6DmkRdIfm-zyW_g&oe=69BD36F9"}]}, "id": "423050574120711", "locale": "en_US", "screenshots": [{"file_name": "VRBadminton Coach SC1_V6.png", "id": "489243040581167", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75469627_489243043914500_4221136426933506425_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1i9LEfcDRJAQ7kNvwHlNMHG&_nc_oc=AdnRtmOZbCvcYQzz4HfkZa0rRGgVaZrDLSD0u-9B-gs2rvr7HqTiMruTwrpAF5eRfpg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMGw95YuW4KHEcSmEiBYY_1rG4QMwazZnIIHhFG4tR_g&oe=69BD329E"}, {"file_name": "VRBadminton SC2_V6.png", "id": "353520594479697", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031466_353520597813030_8586315607528233849_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1fc3IRtiC4Q7kNvwFl6UsC&_nc_oc=AdlBtw0OnhOAXbpWQhADgxeyDscdpcZh1bKk1XYahTYVZeHO5TkoCDiGDkFMw1cvXgQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwTdKoufPQx_63mW4FiC_WymmyTYDJqcpx8t4X04iDgIQ&oe=69BD5830"}, {"file_name": "alien Coach SC8.png", "id": "544576281334534", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75195913_544576284667867_7498898132677097396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gyd8XTz1fIIQ7kNvwFHpNEq&_nc_oc=AdlmnYj0bkEx_u66COaXDYSTy64qvNn6c8SB-qRrPu8MNjWGqf5opPJkbePCmQ3kvNM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfznLWf20kY7CSXfPdDvDGCUIvcCSUIAhCHQHRmT2Z-QzQ&oe=69BD4927"}, {"file_name": "VRBadminton Coach Overhead SC8 V2.png", "id": "994098669081927", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974579_994098672415260_2944749652990827622_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBaurDqZRqMQ7kNvwFHTXwN&_nc_oc=AdnQhWO5Bjt_OU_-9M62U4w-aeIIZ2NcJfn6-Gs-VqeE38dug8pHjceFGJf70wk0wa4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxEXWxQn9CMb57KAy_nUegqCDnaVl4TVM9dEtq3QvG5ew&oe=69BD52CD"}, {"file_name": "VRBadminton Coach Badsaber SC3.png", "id": "1027811275231522", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57569436_1027811278564855_1550186934967238395_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAuaYnj04BkQ7kNvwFrme4I&_nc_oc=AdlecUfRPNs12T2uZgwdQMdArUVC5kdg_lxBOj1vI0vbjOKZ1txCJSnxg9KjmDZfRcY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy1v-UmA0WDwTmr8tc5zFOQPpXZcE-H554GN3dR-eu48w&oe=69BD4CE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRBadminton Coach SC1.png", "id": "497760182856359", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974758_497760186189692_8720907288320587016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-9in6bc_KUQ7kNvwGExiPO&_nc_oc=AdmKmlwayZcfn-qTuTl7w9Z9NUEAz5SztqlIlJW1hZLk7IvSnDSer_u0BXmb5oPq3Qw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFQ4tDDYFStklbuZttQq9dkd-JHnzKOEUHPR_TET7qUg&oe=69BD3D20"}, "display_name": "Badminton Coach", "keywords": ["Badminton", "Coach", "Training", "Simulation", "Arcade"], "long_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo that focused on the drop shot. Badminton Coach has added new and improved physics as well as drop, drive, skills, and self-coach training scenes. Our live Coach Connect allows your own coach to connect from anywhere in the world and direct your training verbally, and even feed you birdies to the front, middle and back, on either the left, right or center court. \n \nThe arcade mode, fun trainer (Bad Saber) features an additional level where you can target an alien ship flying across the sky and destroy it with your smash or drive shot. \n\nBoth the Bad Saber and the training screens provide scoring for 10 shot sequences so you can gauge your progress.", "short_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo with  new  improved physics and scenes for drop, drive, skills, and self-coach training. Our live Coach Connect allows your own coach to connect from anywhere in the world to direct your training verbally, and  feed you birdies to 9 court positions, and scoring to gauge your progress.\n\nIn Bad Saber,  our fun arcade mode, you can target an alien ship flying across the sky and destroy it with your drive shot."}]}, "developer_name": null, "developer_privacy_policy_url": "https://smashville.us/go/privacy/", "developer_terms_of_service_url": "https://smashville.us/go/tos/", "publisher_name": "Smashville", "support_website_url": null, "website_url": "https://smashville.us/go/vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26622182787428833"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1099332894794598"}, {"status": "PUBLISHED", "id": "1155024595762350"}]}, "baseline_offer": {"id": "1099332894794598"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1736937960, "status": "PUBLISHED", "id": "1099332894794598"}]}, "liveChannel"
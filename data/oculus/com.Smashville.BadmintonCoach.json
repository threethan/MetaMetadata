OGO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035352_364297833382983_8118544330931618513_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0_XupMdiugQ7kNvwF5EWJF&_nc_oc=Adl6S6w2S80V-F48BTlCl4OhkHaAq187l633h-dKdlvPHYNKivX_RVyo9z-cdAXdMb8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsPRuFBzB7878BMv96ZwwzTKgpU9tJPQ9PguC0WtGzYNQ&oe=69A6CD79"}]}, "id": "423050574120711", "locale": "en_US", "screenshots": [{"file_name": "VRBadminton Coach SC1_V6.png", "id": "489243040581167", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75469627_489243043914500_4221136426933506425_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3Fu54hg9joQ7kNvwEo1LCu&_nc_oc=Adm3VGwbBZdaZGL6C4w90f2Jz-F-8yL6dzE2JD7RYNGMchcmKhvCdwvRn8kQesMecRM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs-Kr6MnGTBXcLfj77wMHsMs02Wh9YGPa6ZZ7jXL-yciw&oe=69A6C91E"}, {"file_name": "VRBadminton SC2_V6.png", "id": "353520594479697", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_353520597813030_8586315607528233849_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bM0IOjjzMC4Q7kNvwGeNp2y&_nc_oc=AdlveuBtJAjU7lqrHcn6BrxGB0DqTa4XfzgccEjFTGahWW6cyHQ5PNAUFtdQrTSboLg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftpMGqU7b9JL3OrXuv1S_WzA4_XkIUN67lo0KxjHSkwgg&oe=69A6EEB0"}, {"file_name": "alien Coach SC8.png", "id": "544576281334534", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195913_544576284667867_7498898132677097396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VT6Lvy7rewQ7kNvwFG9Uvb&_nc_oc=AdljlHv9z5-K-M8TdusQPJwEnk5R1YxVrwQmtFcFslydgdelSjk37xvAFGe7QN_LV68&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvj32kd_oHsp4V_8rrIxmTE6pZKs1-H02FLfNF1BThwRQ&oe=69A6DFA7"}, {"file_name": "VRBadminton Coach Overhead SC8 V2.png", "id": "994098669081927", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974579_994098672415260_2944749652990827622_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QT9zlmmixlsQ7kNvwGF4Z5t&_nc_oc=Adkt11y4Oauvn3Ih6E_7-19WXn06J44BwwYSaceUFIYklST1-wA0vKlbTdRepfoSPcI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvggA18IBABQKPHx0LNdxEweHP08mGxZ10KGQQlzXdNfQ&oe=69A6E94D"}, {"file_name": "VRBadminton Coach Badsaber SC3.png", "id": "1027811275231522", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569436_1027811278564855_1550186934967238395_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qjhUwfHrZ0Q7kNvwEY_j8P&_nc_oc=AdnVMzack_4P4Z1JVKB3txIT0dD6fTwxLV46-TOd7EdqSofo9o0Wj3ZHiKbStroWGz4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvI-1Uo02vNA54puKcKgsTIxkRZU8qRMTVfBtKGWQs-Cg&oe=69A6E360"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRBadminton Coach SC1.png", "id": "497760182856359", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974758_497760186189692_8720907288320587016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6CfNtXOHwcYQ7kNvwHCl_M8&_nc_oc=AdnqaT9vMuoINJ25eG1WKIEmvy3YBpwHk3rscx-aqhvqGbRf5VcpfMDL-otHveN6P5o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu50VVTPc_fcZEeRCB3X4Li0s77EqqzaJdQtQJ6QEW9Xw&oe=69A6D3A0"}, "display_name": "Badminton Coach", "keywords": ["Badminton", "Coach", "Training", "Simulation", "Arcade"], "long_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo that focused on the drop shot. Badminton Coach has added new and improved physics as well as drop, drive, skills, and self-coach training scenes. Our live Coach Connect allows your own coach to connect from anywhere in the world and direct your training verbally, and even feed you birdies to the front, middle and back, on either the left, right or center court. \n \nThe arcade mode, fun trainer (Bad Saber) features an additional level where you can target an alien ship flying across the sky and destroy it with your smash or drive shot. \n\nBoth the Bad Saber and the training screens provide scoring for 10 shot sequences so you can gauge your progress.", "short_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo with  new  improved physics and scenes for drop, drive, skills, and self-coach training. Our live Coach Connect allows your own coach to connect from anywhere in the world to direct your training verbally, and  feed you birdies to 9 court positions, and scoring to gauge your progress.\n\nIn Bad Saber,  our fun arcade mode, you can target an alien ship flying across the sky and destroy it with your drive shot."}]}, "developer_name": null, "developer_privacy_policy_url": "https://smashville.us/go/privacy/", "developer_terms_of_service_url": "https://smashville.us/go/tos/", "publisher_name": "Smashville", "support_website_url": null, "website_url": "https://smashville.us/go/vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26622182787428833"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1099332894794598"}, {"status": "PUBLISHED", "id": "1155024595762350"}]}, "baseline_offer": {"id": "1099332894794598"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1736937960, "status": "PUBLISHED", "id": "1099332894794598"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "31783211244659269", "version": "1.3"}, "id":
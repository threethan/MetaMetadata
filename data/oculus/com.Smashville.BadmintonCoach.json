OGO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035352_364297833382983_8118544330931618513_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgjHntYde_kQ7kNvwFpf2Q3&_nc_oc=AdmjrBthAJ2DQa6AiMhRDyIMD9Pz3PC3fLcW2ounGr76y80UY9SL5yz0W8kfqZxSSkc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsKtFctKAi72KssPhDkCy05JL5lnWQUnMjwEOOlQzWh7Q&oe=69984CF9"}]}, "id": "423050574120711", "locale": "en_US", "screenshots": [{"file_name": "VRBadminton Coach SC1_V6.png", "id": "489243040581167", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75469627_489243043914500_4221136426933506425_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvDLBSe3L4UQ7kNvwG0k9on&_nc_oc=Admvfti7ozAzfBfrFU2Ox_-AGkvsxLaF_xJFV3h972MgGRAL9I4sfPw9Ay8nqMgc7ec&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft0VBQCrknOUlWZivYNP9zGg2Qn6eRVT_gZot2FAFitoA&oe=6998489E"}, {"file_name": "VRBadminton SC2_V6.png", "id": "353520594479697", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_353520597813030_8586315607528233849_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGUPn7Tu-l0Q7kNvwG02TPP&_nc_oc=AdnhRfSDAh0R_zpU8kZ3PnwFlvUjerNwYVzx1FS0dYuGrkz32ZvK6howsJn4xPxvL_I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvwtpwbfRTfMefIl-2XKNr0hh97eLUatcC7wmVFTiZeEg&oe=69986E30"}, {"file_name": "alien Coach SC8.png", "id": "544576281334534", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195913_544576284667867_7498898132677097396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TH7qVpVSxNwQ7kNvwE5FK4x&_nc_oc=AdlLmVyH59a-Xy0FThnl4cXpNCb0xkEr6wlgYvu8jjFnbwoO6HJxcBIx2YsjbNCgDY0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afvz-U2n16USciYNErDie4Su4ViAQOhrmKu005w6nCQovA&oe=69985F27"}, {"file_name": "VRBadminton Coach Overhead SC8 V2.png", "id": "994098669081927", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974579_994098672415260_2944749652990827622_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QO9GzXh5bdEQ7kNvwEw_3kD&_nc_oc=AdmZ0BVY0N0TfUE5P1qkJSOVJdf9lUcnHlifzyNqwBeozVsrU7vi-R9PT1auiH8GsgU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aft5n3t_RbN3Z5mXpc5meIEd7WY-VXtMg2U6X0dAd_77HQ&oe=699868CD"}, {"file_name": "VRBadminton Coach Badsaber SC3.png", "id": "1027811275231522", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569436_1027811278564855_1550186934967238395_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZjZKC9qxasQ7kNvwH6SPG8&_nc_oc=AdnZll-xsO_C589gvEdlDLY4f1Hw6wf0QvTV2SGaRQrFpgw5H7x-4Xo7IPO1EwKiPBM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsCAMwx51_SHwrTYvgOcsUhUbBdmGPYXbB4iKd3zgYuBw&oe=699862E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRBadminton Coach SC1.png", "id": "497760182856359", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974758_497760186189692_8720907288320587016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2s812LvzPy4Q7kNvwHfyfbQ&_nc_oc=Adlt_2ltSXZZJzaeIHhOcmaZIhSagwfAk9EOyc9X-m3aJmlw0791EWTPOj9HwznwUVM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvbDOMnehTSziZcJ0-fqVEGSjnpy6rXnIUDVORC-XoIdQ&oe=69985320"}, "display_name": "Badminton Coach", "keywords": ["Badminton", "Coach", "Training", "Simulation", "Arcade"], "long_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo that focused on the drop shot. Badminton Coach has added new and improved physics as well as drop, drive, skills, and self-coach training scenes. Our live Coach Connect allows your own coach to connect from anywhere in the world and direct your training verbally, and even feed you birdies to the front, middle and back, on either the left, right or center court. \n \nThe arcade mode, fun trainer (Bad Saber) features an additional level where you can target an alien ship flying across the sky and destroy it with your smash or drive shot. \n\nBoth the Bad Saber and the training screens provide scoring for 10 shot sequences so you can gauge your progress.", "short_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo with  new  improved physics and scenes for drop, drive, skills, and self-coach training. Our live Coach Connect allows your own coach to connect from anywhere in the world to direct your training verbally, and  feed you birdies to 9 court positions, and scoring to gauge your progress.\n\nIn Bad Saber,  our fun arcade mode, you can target an alien ship flying across the sky and destroy it with your drive shot."}]}, "developer_name": null, "developer_privacy_policy_url": "https://smashville.us/go/privacy/", "developer_terms_of_service_url": "https://smashville.us/go/tos/", "publisher_name": "Smashville", "support_website_url": null, "website_url": "https://smashville.us/go/vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26622182787428833"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1099332894794598"}, {"status": "PUBLISHED", "id": "1155024595762350"}]}, "baseline_offer": {"id": "1099332894794598"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1736937960, "status": "PUBLISHED", "id": "1099332894794598"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "31783211244659269", "version": "1.3"}, "id":
OGO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035352_364297833382983_8118544330931618513_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUG9RDCz8NkQ7kNvwFJWvt3&_nc_oc=Admpp42JLwwfuZpE4I1PrLxagnpl1cFO9JmloXg5RPjGdTlnIQ3ZlWURKksiC-8UvYw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuxsG2kCd56WUARv4l86qP1KQmCaeCKqM5JWxvgDA8-9w&oe=699C4179"}]}, "id": "423050574120711", "locale": "en_US", "screenshots": [{"file_name": "VRBadminton Coach SC1_V6.png", "id": "489243040581167", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75469627_489243043914500_4221136426933506425_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YM02vgBUvgQQ7kNvwG0MHKk&_nc_oc=AdnGFGsZmbahZuOi24tGIkuy83twkST0105ptQ2LY6R3QzRsDSdfkDkIgMqRziE92-k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuAe2TnngpP3gjtf5PS1a1fL6n66o2UItsVXucHAq5vpw&oe=699C3D1E"}, {"file_name": "VRBadminton SC2_V6.png", "id": "353520594479697", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_353520597813030_8586315607528233849_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlIiuw5plYkQ7kNvwHk-uqZ&_nc_oc=Adlb6lT7VuyG_xQa3D6aM-R4-nzkCyMb_rj_4ys-77DnCn5PzDuxgLo2zUz2mdP29n4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsQFMVndqpjajZs4BAtsc9V-Zpmjzt5CGg6a_JHAl5X2Q&oe=699C62B0"}, {"file_name": "alien Coach SC8.png", "id": "544576281334534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195913_544576284667867_7498898132677097396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upJYUMY0aWgQ7kNvwFZpA_q&_nc_oc=AdnSXccixP5ZYdvVJsHd2wE2lh1XY9_Pcje4eQ3BHImJTo6YRZ9UStAmPxVm8sfjAVg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv96jGrbO7DSEE_22k1FexKqpq2CUHEwF513wsR7MCIAA&oe=699C53A7"}, {"file_name": "VRBadminton Coach Overhead SC8 V2.png", "id": "994098669081927", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974579_994098672415260_2944749652990827622_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7z5a-gkRC4Q7kNvwEK8NDw&_nc_oc=AdnWrwUJcGeetSKYeIf0UKTlqgq6vbQqWqnyeqLa2RFfJ62tihbAFIfmppPF1o66HfI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfusEeAlGUIBq8GOJu4_csbAuntk70hVOHlZfdyOhe6d8g&oe=699C5D4D"}, {"file_name": "VRBadminton Coach Badsaber SC3.png", "id": "1027811275231522", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569436_1027811278564855_1550186934967238395_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eW28Tud8v4IQ7kNvwGM5_d9&_nc_oc=AdlqF0fl95DMmrDO7dQDRF2TiI9kiprz-eCX7OhDzWi9U4-vl2z700kOQZ4bvfLKaQk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsG1LQKhOUpg9dKOjp4vYi8h22E1exK1NZrSkxE1M_6SQ&oe=699C5760"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRBadminton Coach SC1.png", "id": "497760182856359", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974758_497760186189692_8720907288320587016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMRJX6GOxCAQ7kNvwFFcF6S&_nc_oc=Adkz87umbhzdWI3kKddtPImx_Z8R51f97vZIBs9QMR2ti5bhH4ld6jGWeoF6UWOudXM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuvtBjrOYhcx1ccQo1AuWM1YO1-omovBDZFRM3D__tYYg&oe=699C47A0"}, "display_name": "Badminton Coach", "keywords": ["Badminton", "Coach", "Training", "Simulation", "Arcade"], "long_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo that focused on the drop shot. Badminton Coach has added new and improved physics as well as drop, drive, skills, and self-coach training scenes. Our live Coach Connect allows your own coach to connect from anywhere in the world and direct your training verbally, and even feed you birdies to the front, middle and back, on either the left, right or center court. \n \nThe arcade mode, fun trainer (Bad Saber) features an additional level where you can target an alien ship flying across the sky and destroy it with your smash or drive shot. \n\nBoth the Bad Saber and the training screens provide scoring for 10 shot sequences so you can gauge your progress.", "short_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo with  new  improved physics and scenes for drop, drive, skills, and self-coach training. Our live Coach Connect allows your own coach to connect from anywhere in the world to direct your training verbally, and  feed you birdies to 9 court positions, and scoring to gauge your progress.\n\nIn Bad Saber,  our fun arcade mode, you can target an alien ship flying across the sky and destroy it with your drive shot."}]}, "developer_name": null, "developer_privacy_policy_url": "https://smashville.us/go/privacy/", "developer_terms_of_service_url": "https://smashville.us/go/tos/", "publisher_name": "Smashville", "support_website_url": null, "website_url": "https://smashville.us/go/vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26622182787428833"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1099332894794598"}, {"status": "PUBLISHED", "id": "1155024595762350"}]}, "baseline_offer": {"id": "1099332894794598"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1736937960, "status": "PUBLISHED", "id": "1099332894794598"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "31783211244659269", "version": "1.3"}, "id":
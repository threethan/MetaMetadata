ashville sock logo3 556-164.png", "id": "364297830049650", "image_type": "APP_IMG_IMMERSIVE_LAYER_LOGO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035352_364297833382983_8118544330931618513_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYsLj2c_dsIQ7kNvwE0-CZw&_nc_oc=AdmKQs4lFpayofW2MXVPkoTb8A5TI_znqvSI8vY1seeMvUDhY0wPsCredXeYYmqZC1U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzKLPR_8eKRlMVb6A3LG6qrHAWbhyG75OnCO7luO3H-Ig&oe=69B2AAF9"}]}, "id": "423050574120711", "locale": "en_US", "screenshots": [{"file_name": "VRBadminton Coach SC1_V6.png", "id": "489243040581167", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75469627_489243043914500_4221136426933506425_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUNMompI6qwQ7kNvwHmHNEK&_nc_oc=AdmrFR3jedScAI2Odh-JHW2bBkAa9qqitadNQXLqP-Z1_C_vd7m-NKj4JFGXuv9J8HA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxZqJ4g8FRv36BACt8l1geFhOJ9K6Fy4loJ1XBNsCsb_A&oe=69B2A69E"}, {"file_name": "VRBadminton SC2_V6.png", "id": "353520594479697", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_353520597813030_8586315607528233849_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Wetub2SIuMQ7kNvwHEz6EV&_nc_oc=Adk3-4JiqD2i7ZUU1l-UuPWxnbOOjK7QQtzrrFa49NEutkVvyVLjMYUWpGX3FbSIFtg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxfPlI4Jkq1x9AcolW7e025i8HieQ0rFKxJSPPvGAU72Q&oe=69B2CC30"}, {"file_name": "alien Coach SC8.png", "id": "544576281334534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195913_544576284667867_7498898132677097396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMBsQgDQJnQQ7kNvwFgTf9Z&_nc_oc=Adkb7e-Um9g2--BgVtQEfmvs72Lv96Tw-NqvmgBuVSI4NEgeNRFZibnsGpyk7tWMysw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy4mNpmOwGdmZ4WlwifieSNkk3GvaN4YqdadmY4OYHYeg&oe=69B2BD27"}, {"file_name": "VRBadminton Coach Overhead SC8 V2.png", "id": "994098669081927", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974579_994098672415260_2944749652990827622_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrOJZHumy94Q7kNvwGe42SO&_nc_oc=AdleR2lJ3U-BGjk5J8kCLGcd7XhwE9m-Ms2dw6svEFndbxdLRM6tAOscHoZhl_0AAvs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxarVLdlx62XY5ewhsGsCntxJBctaYHPTU7XSyza6rfjg&oe=69B2C6CD"}, {"file_name": "VRBadminton Coach Badsaber SC3.png", "id": "1027811275231522", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569436_1027811278564855_1550186934967238395_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dAACTPYjj4Q7kNvwGEPpEf&_nc_oc=AdniTRdR3eNARTf6XxmSywvGFxwUXeyP8_iEx4jslhtAqmjcrD_f0yWlBkfKlBIXDOo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxu9AsngRiAunXa79-zd0E03J2Z7vQuCBrwnsyEPCuetw&oe=69B2C0E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRBadminton Coach SC1.png", "id": "497760182856359", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974758_497760186189692_8720907288320587016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39xo6vXURpUQ7kNvwFxaRSd&_nc_oc=AdlxN0ETd-cnzzHwefEz_PgeukMG8b3LqDCj2XSOaZQnqE__I1nK8397FurT3gvp3SA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwML1BbQoWroUg1NAZmvGn3dafXGIYFvoVi3mH3kYT78g&oe=69B2B120"}, "display_name": "Badminton Coach", "keywords": ["Badminton", "Coach", "Training", "Simulation", "Arcade"], "long_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo that focused on the drop shot. Badminton Coach has added new and improved physics as well as drop, drive, skills, and self-coach training scenes. Our live Coach Connect allows your own coach to connect from anywhere in the world and direct your training verbally, and even feed you birdies to the front, middle and back, on either the left, right or center court. \n \nThe arcade mode, fun trainer (Bad Saber) features an additional level where you can target an alien ship flying across the sky and destroy it with your smash or drive shot. \n\nBoth the Bad Saber and the training screens provide scoring for 10 shot sequences so you can gauge your progress.", "short_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo with  new  improved physics and scenes for drop, drive, skills, and self-coach training. Our live Coach Connect allows your own coach to connect from anywhere in the world to direct your training verbally, and  feed you birdies to 9 court positions, and scoring to gauge your progress.\n\nIn Bad Saber,  our fun arcade mode, you can target an alien ship flying across the sky and destroy it with your drive shot."}]}, "developer_name": null, "developer_privacy_policy_url": "https://smashville.us/go/privacy/", "developer_terms_of_service_url": "https://smashville.us/go/tos/", "publisher_name": "Smashville", "support_website_url": null, "website_url": "https://smashville.us/go/vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26622182787428833"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1099332894794598"}, {"status": "PUBLISHED", "id": "1155024595762350"}]}, "baseline_offer": {"id": "1099332894794598"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1736937960, "status": "PUBLISHED", "id": "1099332894794598"}]}, "liveChannel"
OGO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035352_364297833382983_8118544330931618513_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUG9RDCz8NkQ7kNvwF8kFWD&_nc_oc=Adkyar6zt5fP9RfCbHUilKMoArVd6GPD7MMBsU3qXs-yMTrvJyqkCNofPd5qvcb5yk0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvxU8T1kd4EW99FyBxWWwUCaZYaomOWB9-5mD_EBfY2Qw&oe=699D92F9"}]}, "id": "423050574120711", "locale": "en_US", "screenshots": [{"file_name": "VRBadminton Coach SC1_V6.png", "id": "489243040581167", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75469627_489243043914500_4221136426933506425_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YM02vgBUvgQQ7kNvwFom78v&_nc_oc=AdniTGF27tJKa_-AIHLEzVBGEHw-9MNH0j6_lrdHf85gnDmFehlyDshBJaD5fmInvYg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftuNvH4aUVxO7h4pDaoj9DlOUIEzGxkOuHpfZVmwH07vw&oe=699D8E9E"}, {"file_name": "VRBadminton SC2_V6.png", "id": "353520594479697", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_353520597813030_8586315607528233849_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7r8VJlMXUEQ7kNvwHYnm7A&_nc_oc=Adk5ysV6Qv8ozVCoKih87GT7t1XAcXXuKLlRl0cgzrMMA9YVDW7l6UUl7AbhjkFYP4I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu18FuoXpDU7BiM7Dikl1miwDoiWNK6p_c9mFM9k9aXew&oe=699DB430"}, {"file_name": "alien Coach SC8.png", "id": "544576281334534", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195913_544576284667867_7498898132677097396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upJYUMY0aWgQ7kNvwHNP0GP&_nc_oc=AdkK84sZEyQYAEx4L06QQ8hSduaz1HrfMfXffHZVPcigRrm9kiQPK_Dfj0tAqgavccM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsc0YwYQjokydLzbDqSCoeSmoX7tdLdCPz7KTiTdr-DRQ&oe=699DA527"}, {"file_name": "VRBadminton Coach Overhead SC8 V2.png", "id": "994098669081927", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974579_994098672415260_2944749652990827622_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Op_EEhzb1wYQ7kNvwGWsBxU&_nc_oc=AdkLsVRNh0tllImphKpE_d8jqvj040xhQAIxvUroRU_8mk1TlnQAqJi4Dv2yySBnioA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftc4LiouUVn6uKG0pJx-7bpuEDmoMCWJT5B9q-kQEv9pg&oe=699DAECD"}, {"file_name": "VRBadminton Coach Badsaber SC3.png", "id": "1027811275231522", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569436_1027811278564855_1550186934967238395_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eW28Tud8v4IQ7kNvwH2wYi7&_nc_oc=Adm-UoEqEsx22Xz_xzMJP-MGqi3K0wtHpvm3BDKNRlAcuIYtvd5AsWeLhbvenDlN4Cs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsKsL_VyGzI4Tm0K9ipRhFgKpBXunrkHvwp3ZSr7RDbxg&oe=699DA8E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRBadminton Coach SC1.png", "id": "497760182856359", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974758_497760186189692_8720907288320587016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMRJX6GOxCAQ7kNvwERKMQb&_nc_oc=Adm3PZsLlITFyWtDVl1-NMf8poYnhLjEOXntp30OyTFmcHEV-fOSl6ZxorDmXQDfL7Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfswGybtH4972RwJ7A3r1_voSwg6eSDO63_6oh51ZFdcGw&oe=699D9920"}, "display_name": "Badminton Coach", "keywords": ["Badminton", "Coach", "Training", "Simulation", "Arcade"], "long_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo that focused on the drop shot. Badminton Coach has added new and improved physics as well as drop, drive, skills, and self-coach training scenes. Our live Coach Connect allows your own coach to connect from anywhere in the world and direct your training verbally, and even feed you birdies to the front, middle and back, on either the left, right or center court. \n \nThe arcade mode, fun trainer (Bad Saber) features an additional level where you can target an alien ship flying across the sky and destroy it with your smash or drive shot. \n\nBoth the Bad Saber and the training screens provide scoring for 10 shot sequences so you can gauge your progress.", "short_description": "Badminton Coach, a VR Badminton trainer by Smashville, builds on our initial free demo with  new  improved physics and scenes for drop, drive, skills, and self-coach training. Our live Coach Connect allows your own coach to connect from anywhere in the world to direct your training verbally, and  feed you birdies to 9 court positions, and scoring to gauge your progress.\n\nIn Bad Saber,  our fun arcade mode, you can target an alien ship flying across the sky and destroy it with your drive shot."}]}, "developer_name": null, "developer_privacy_policy_url": "https://smashville.us/go/privacy/", "developer_terms_of_service_url": "https://smashville.us/go/tos/", "publisher_name": "Smashville", "support_website_url": null, "website_url": "https://smashville.us/go/vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26622182787428833"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1099332894794598"}, {"status": "PUBLISHED", "id": "1155024595762350"}]}, "baseline_offer": {"id": "1099332894794598"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1736937960, "status": "PUBLISHED", "id": "1099332894794598"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "31783211244659269", "version": "1.3"}, "id":
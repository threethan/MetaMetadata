": "319755241190061", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974669_319755244523394_9165807040462637955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzaINJlvLXAQ7kNvwHTVY2A&_nc_oc=Adovy4e1LEgvuiTN0Ck5bkbc8CQxcQz_wr0fkAJURaPgPseU1GiSFR2jCmqxW-I_LzI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqvDuyNL8xrf2B7eXrBQtaEosfjLsYDDeTKyeiy76HDA&oe=6A537C73"}]}, "id": "410427738279044", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "8275721799126345", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75375751_8275721802459678_6058021830509629790_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZha1gv7UboQ7kNvwGh-iUs&_nc_oc=AdrE5Sh9fVT1HllZvQIsX5snQp-i7Hf0KhviZymgJepwmYlHYXtZKzDRPM9DYdWnPbQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMiOrlAFgJZMrxCniuBxrgzEi_o08cD1i2r6ys_ZHdWw&oe=6A539829"}, {"file_name": "pic3.png", "id": "2767506536744558", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035400_2767506540077891_1994933407131659407_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9T01E_NcahgQ7kNvwGw2PCe&_nc_oc=AdqXkhP3irY3Mkk3fnyk90gh142i88Wj-_UaShbh_K-lGFMCQeXxroi5FvC9Xle8u8Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1yi-_7yRb6Wa6vhlp-nCB9XguJpP8vBrHj6XqfaQLKA&oe=6A539361"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DK6HCih6vv0Q7kNvwFHMYh_&_nc_oc=AdqlXpnDcaPhuOHYMpu2Lv87-fHmm1zH2jQUdqw5MIoHs5v__oCy1QiKguL3j5WMYj0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjwz7XkGdmKy6JfEksozsufsVaiUv_9zIHVe1-EcJJug&oe=6A53AA57"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sr0_RApA3sQ7kNvwF8TCV3&_nc_oc=AdocEwLgRbF-mRvEy0rkGYI5lHjcxQH3vDswBfmq8i71bb1hwKDWLm3JPUuiizPDn3E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVuOmUNc4PWDWb_asGhLKNdSa97MUUq4NkUR9eaxLX1w&oe=6A539D28"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHf4xcPVBGAQ7kNvwHHREYe&_nc_oc=AdpENPaYDRNgIcQB6PY8rNefEYf9cYUvandeq2kKteYH6C0EjliLYSj9XXzdK6jCGIA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCI7okNuQUuu0Xwz4U6tZAAB_FfzM0jdAhxfSKjTdzGSQ&oe=6A539E86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qyrYSTBOMgQ7kNvwHWUsu3&_nc_oc=AdoS_XOyam6WUacv390Iyy9TwiThCoySVu7UV9Y6mTJjvD_7CeyZ1IxWvmURZQZyjaY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-crlggecFn5RPCq0xD0YoD6uticvGdX-HGp6z6L6QbQ&oe=6A538443"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "840880844612955"}]}, "baseline_offer": {"id": "840880844612955"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1725033660, "status": "PUBLISHED", "id": "840880844612955"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8583845591627462", "version": "0.2"}, "id": "1196272561519604", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8162465477098811", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8583845591627462"}, "release_status": "RELEASED"}, "binary_release_channels": {"nod
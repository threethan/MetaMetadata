": "319755241190061", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974669_319755244523394_9165807040462637955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCRHUGxqM2YQ7kNvwHOZpoR&_nc_oc=AdrKOpQfMLzop35qdHpo2fghZDHcV-HzZQBUU8RdRG5BNWVQa4ZPBD0BQT2qNVzb5bc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWjpzGkiqPmSyMCJfUBw290R3CJ48eENKGaWaH2Mfk0g&oe=6ADE2233"}]}, "id": "410427738279044", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "8275721799126345", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75375751_8275721802459678_6058021830509629790_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fu8b1A7J440Q7kNvwHmbXjr&_nc_oc=Ado6k-VOc6LPA4Rl3vCOoDfgItBFvTiCH0sSWv0waPBMpUpGhGG5gns8aOmOMhICmuk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSUTi3zafSWTYcO_xK5KKk7rR6pNl6SOVYgtF8IrsHnQ&oe=6ADE05A9"}, {"file_name": "pic3.png", "id": "2767506536744558", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035400_2767506540077891_1994933407131659407_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOYffsqx6Y8Q7kNvwH6Nf87&_nc_oc=AdqPXFB9rVnrTAxQhLOVXBUtA_XqkXfNqvjWLfiWxgSAnp_aEeG7VeqaZzP7Unm-bJk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcdxYULhCK_LptASazTJGmEg7eZRItFZxsokWT-kT9Xg&oe=6ADE00E1"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4Pmt55aNbYQ7kNvwFwsktd&_nc_oc=AdpUE4AYiqyHmjILJ4lmHJ5wqM2v3acRvRFkGxcuDLgbJ4GrscRJRh2EhZh-ln_Wbng&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPG3_Pnt7jeo8-BzLj7Ai2PvH1H31pViS8jZkmG4dmOAQ&oe=6ADE17D7"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdcmwJd9AQgQ7kNvwFqs15m&_nc_oc=AdpGKp3ijiWXSJPhp8g7xcL5BCT-PJv601Vqa-mUQ2FSjvx2pEeP6NXPeiF5EuJzSr4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHqRMl0d7hxYtuplpDydIEInwA45Mel0DoRfd2GBDsXw&oe=6ADE0AA8"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abSIgCcd--kQ7kNvwHzxYsD&_nc_oc=Adpghq9Re-mIiXmmJ2s3kT4q-vbIo3AgtzFsOeKf3u-wvpHkf-9AUdqFKsIaKaXUmIs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMG3gMDUPyDiY39f-sW7WVQ83JKYH4I7LAYMsrzNm99Yw&oe=6ADE0C06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwyK8inqlEMQ7kNvwFeDiKx&_nc_oc=Adpbk__mT5YoLHusTtf-MlbD1C1_q6FkrQQFVEFLANBUgu9ufRjk3X6l0h2peAoBSEM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCIikIkHJjyPpqrs8apROLWUKSUQ_QjdCETsi-au6uGA&oe=6ADE2A03"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "840880844612955"}]}, "baseline_offer": {"id": "840880844612955"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1725033660, "status": "PUBLISHED", "id": "840880844612955"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8583845591627462", "version": "0.2"}, "id": "1196272561519604", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8162465477098811", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8583845591627462"}, "release_status": "RELEASED"}, "binary_release_channels": {"nod
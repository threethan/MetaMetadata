923bRSyzMC5LQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB18J9EHG5cz8SMUcdDt5jC7BBnAZ_o5BMPab_BLxOixw&oe=6A563661"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4E_G97Qgsz8Q7kNvwE1PhXp&_nc_oc=AdpjEYIsK8M8X_8HqXd3AhRzhZ-nwf0nLPf0hC4ju4Z9EXhTKtxCvFUkwWqF6K8jgvM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTeiEKyytX-koLz_ietlRmqF06VpKHTAgMMrBkya925w&oe=6A564D57"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bHPFjPpPBoQ7kNvwH59Mub&_nc_oc=AdpJUsJP-lqYgyC-7wWL-8QSZLeBX37m7najfG-hlapwLFmGXpC7S-rI6rX5o6HmC44&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-e8ZZffKr0VYT-4j-bJwpIJvTlBGhqoD5q3Ys2TL5Uw&oe=6A564028"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHSC29GrOzkQ7kNvwEH268h&_nc_oc=AdqWsANjKlxPYcuLO_jPVhNr1GjJZeIZUCvv3aTtqbve1RO3kxAdz8g6TLkpH4KPBGo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUUx9wdjhucAbmSlK9pCk_UVugNDJIiEnhpY7w4t8xww&oe=6A564186"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUdn-arDe1IQ7kNvwHZwWa3&_nc_oc=AdowysFH04rXAhLRMSFhSL10yF4h8fF7ldFG5J3uByb94Bv1hgaNtkd4dSZO9gxCxQo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAafVgiePtSCe0b9YTZFQISxV1IAPBGf0-Lg4xkruSSvA&oe=6A562743"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oc
g9ZvD9zmiQjkxmfDhT1p-cOl0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxTkBQstcgBR30RBC-8PWalM1BuS1C6AsfOmerEEhynA&oe=6A85AC61"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APKSVMiECKkQ7kNvwF79agD&_nc_oc=AdoZIh-fO07hEIhYmi4X4-7oyNgZrpDYOKwn-eaOU6n6XpyZweS_-ViDuW5hZRFqzK4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNzwiKiS7VgTHzb0umbUEwFtOFc5OzfRZQrl6Jr4zSWw&oe=6A858B17"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yK9P5SwpICIQ7kNvwEydw88&_nc_oc=AdqaeRHcumnQQQT4mPNHXGV1_2WUq5qk8LDADb8XUAxIl0WznPk3xTy35YIqbQ4-K0Y&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCZ3sbleIsE9yIwtWlU04TUqdEDnd70OlUld6utlNMNQ&oe=6A857DE8"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayaLdHR8AYsQ7kNvwGzAIWe&_nc_oc=Ado8U5qsrnqs3kqOdGkvDYVZoJwWG2Rnl-ni4V_GSqHNyizyn92Fo5A4lUOGq3Wty8I&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENMAZ3tjbJ8RfFwE7z4zavagi7c8WX8YAPBjTqcjpj3w&oe=6A857F46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8PXzcgvCXoQ7kNvwFP18jo&_nc_oc=AdrYJoGhZtvrj1iN-75NWau9t60KjDI7zhqNWBOHnDKWhOcFe0aEGe6IuKmNWQqx_NA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKMlGaIgLNhiYrY5HcIjUQee0rI5HbrGHwFPX5y0_6qQ&oe=6A859D43"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://
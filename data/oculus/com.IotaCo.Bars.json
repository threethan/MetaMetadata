AaRzaeLz4W4Ls&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jZJ72O4l0O7FsMgHRWs3E27FGals6eJ-pOXwG9w-ymg&oe=6A3D29E1"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxcaQFoQyREQ7kNvwFKnxco&_nc_oc=AdrQhHEmRwCtKwyyRwZLlnQCZFGjjSo5LfbCbR-j9YgFLN7wSqB3B51PjFqJuUXHSr0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DH5Zzo3jcqhSzwa-gBt7k5MhfE9RFNLel8gdKCFn7_A&oe=6A3D40D7"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IxL9ucMcAMQ7kNvwEnQDdf&_nc_oc=Adqani5OUNwscSyNektl0_cS2BSswpBVb0m8D-42Ohk-s7F9paJmJSepp-btrlAo1gs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gM7fFLTNxnKRhdtfK4hYnkjR0nglGJNBdC_EXVZh-CQ&oe=6A3D33A8"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwLQeo0O9LUQ7kNvwHFTxnf&_nc_oc=AdpRXdj_lJ1WTeBgdK_qywxCuVN6nGddu2JmxK-MO3oNcUIaHsIA07YNFq4EQWTk-HE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9l-O8OMd_vFXO32s4WX9c8jS_HkWBhQ6oUWPtWqgKSjA&oe=6A3D3506"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpzmNw1t-XMQ7kNvwE3-Ug9&_nc_oc=AdoZ7yu-gseuh9LEp7nxQ_zN93eYSwOHpkXsouUliEXg0HRPHa151RHI_213C_MvLhs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WFkn6QpjfdaCKlnE2S-RvDcv9YJhBBDIV2p2jnvQ1sg&oe=6A3D5303"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oc
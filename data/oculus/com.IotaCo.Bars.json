yL-mamNA&oe=69F0B2E1"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gq7ZUDP9h6sQ7kNvwHY0rFm&_nc_oc=AdpNAWuPp99yj3DTZchjvADMNOII6H9_DbWu7q4SsncZ77de70_RyoZ3kRLKJJLrP-Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1SH-9PANhPlOjodTkw_W_KRAP9ZFglTmY8U9jYKigJYg&oe=69F0C9D7"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7NR9mKq5LgQ7kNvwFUadGB&_nc_oc=AdpGuhhYUMBXVuQO6tpskOBhjDXHnSjcJdaLQNtCBifr8_mAPwmgZiBokC4btFMPCuY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0cU6s6rZxr4cOD2XQ96fdGJy2zD3zPoGmvvx3kWL6h0w&oe=69F0BCA8"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42ymEZHS-GYQ7kNvwF1SJmg&_nc_oc=AdrSt09_8Q7AeIdPqxdXFIfGiNCgEi_fwR6XlChnmG2zEnHHaFbNeNzWHNbiOEByYLY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1cFXNM6mk0Tf-j98N4n69YABCNFWyqZYVzQZ995h4ZDg&oe=69F0BE06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyeLg5I20X0Q7kNvwGO-1gH&_nc_oc=Adqni-dhgFezqst8FeZBYuin5cMm6OZj6EWS2iSz9S-jts7u94dG5tTZq1b1ggFOVmk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1JkQX_wI2OSdQRnBjEuFg4i2B4s_9y94HwlPrrx5i0kw&oe=69F0A3C3"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75644991_478298924611798_3428034440511380311_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-Aw_YSo4K0Q7kNvwF116Du&_nc_
CIgRgqy8RY1LY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3iB_UqQmJyF35FZ0WkEAyE5OO9pTxCIkJyUnDI23nGw&oe=6A329DE1"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uDhY5MSGNgQ7kNvwEF1Xdd&_nc_oc=AdoUDoTyCIhJgySXUUkcsTkiwxTg5hcDVeNuElx1bwbcIgcpGsX2k2Hx99zhrUYT9Gs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SwWMzznidQY7FgDrrXtwj3RnUvODXkXMl3yR-L-l7YA&oe=6A32B4D7"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCJ6SsxHofAQ7kNvwEUC6S1&_nc_oc=AdpV0U2RTgCEVlf1r-BKT6mxOiv8MI_B-rIBfyNufLeui9xdU0EODUKqS06R0rbdIeU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yjhe5idANcMkwUJ2TyHoOpaDLkhFSFjPc0Rr1MWfAIQ&oe=6A32A7A8"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjRO8kmRgXIQ7kNvwFI7iy9&_nc_oc=AdrU42l5nTV5sxYbOF7LugpxDnhRGbEDi5ZRxV9dSlL_cIQ9HEdVMcW9uWhkDg_3zM8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IHmHL-dS3kH2rn9dMsdljfqvG3J5MREnQhhOhjcUbmg&oe=6A32A906"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R08KQNgBiJoQ7kNvwEVHuTk&_nc_oc=AdqsLBHMlhJJsZsxcZFfd2a-NrPgAI5h8yTFH7XOgT0B5XQbpNxSC2DxTytiFiUyyxg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93lmmW7HwFtdiJY7Ie29rBcWL7hDsond8Fv0pRZlSrCQ&oe=6A32C703"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oc
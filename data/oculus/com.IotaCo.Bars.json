": "319755241190061", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974669_319755244523394_9165807040462637955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQcWe6VxJc0Q7kNvwFkSenW&_nc_oc=Adp-vJs_sUA3nrEUgpSsnPBWSka7sAr6BSQ1eNsX4zyQDXxyHybrmiaAcuDzuUobF8A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0X69kYt8dkBUilvZsUyr9cYiBIl-HntM59q4S3e1W4dw&oe=69D8E0F3"}]}, "id": "410427738279044", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "8275721799126345", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375751_8275721802459678_6058021830509629790_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Xl7jCsn6hQQ7kNvwG1IsfX&_nc_oc=AdrV_mlrX0b25bXj46eiphvd-fa-ev99jfEEDvr7MZ1-o6AgcdMpJA_qSWj0-5E9Gvk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WVuubF4BKEnNDa_jJIt-vfPieXwKrJ5wgPUa6DjkfHg&oe=69D8FCA9"}, {"file_name": "pic3.png", "id": "2767506536744558", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035400_2767506540077891_1994933407131659407_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZLJRU1-h_oQ7kNvwGx5827&_nc_oc=Adr7Dgt4noPMS0Qnd1yq3fhE0ff5f93-tEwQk5s44slSIOP8QegjJsaHkoP8BCnguic&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gQNY1OLldbAgWDs2NGV4dLR1FeTq1hq2HSORsoQXCcw&oe=69D8F7E1"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NX99Kr6q5JMQ7kNvwHaahzQ&_nc_oc=AdqTdvaJcAeWTVV71_w841LvuFPJ-hiw8ZgUT48rJhDmQoeMmzl9keANnRY-jZE6M3o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KsDHzkNL-LkRkRVvfA_ivnV-1Qk8rh1HcIhm_VeqiQg&oe=69D90ED7"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfIIpmqh1OwQ7kNvwEiGy4q&_nc_oc=AdopnWDWvz3FHiWlMVmtavEEFUQO80pjmbhcAIi77NI4cK1s5gug4WFobztJOekUqPg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qCtqDAzl2MjQnSY_ISDni1qvSB1DFXIBfDbvZfAT72A&oe=69D901A8"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5p2J3_PfIbUQ7kNvwG1NhnB&_nc_oc=AdrV-pat8umUuRzpe6i0gXR5suky5vAzQmqD4zA-7ESoMJOmO9DBIZd4CoDuCeI1DoI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0z8gS4vSRCVluIoBDG--w0wrAhZCB0PzXoSrTVfSvwbw&oe=69D90306"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-TseNVk3QwQ7kNvwGdefuJ&_nc_oc=AdpMdP8MPt4lNiu9tM5jCYzcPkeFaqkZS85yi0BoAFbgrERlNpy2U4Q35KMWvwZrJik&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0secizIeALQq0tTXRQS5Pfkf37xmiNRFaC92rTCcYEQg&oe=69D8E8C3"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "840880844612955"}]}, "baseline_offer": {"id": "840880844612955"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1725033660, "status": "PUBLISHED", "id": "840880844612955"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8583845591627462", "version": "0.2"}, "id": "1196272561519604", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8162465477098811", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8583845591627462"}, "release_status": "RELEASED"}, "binary_release_channels": {"nod
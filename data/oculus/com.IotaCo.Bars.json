1zcsAOGhUKVkI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af12wDbL20PrfzXn2p0YlVM_u1TltN0E7-I38rl5nbdGmg&oe=69F5F8E1"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vaH9NajJMHIQ7kNvwEEtmtv&_nc_oc=AdqCwpQ6m8AGJoCmtVDG31-CekCEQbdVGPXy0JQm3yb5DeWoIbiNhZ77tD4nqXSC3is&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1IaQR4zfO051zCBc2_mdTIP2iGqNxBbo2z-QGbZ4Zneg&oe=69F60FD7"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UDK0qV8uxMQ7kNvwF_nYvV&_nc_oc=AdoIk3QJUrsIFD09SIUqd3NOrHZ7xDIDwVs79sOlgJF59f213plouutFjVx2Se_PWws&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2K0t58mx3ScDRvAV5gOcthH-MdXzwTc1_-haUP0O0h5Q&oe=69F602A8"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M65Q9l5RyWwQ7kNvwFZ2XS-&_nc_oc=AdrDOOzHegAtDB_r1NOvQgiCa1tU-ppfPL5lEXG705DneOz1lrhl6sczXRjxiF8WzOs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0cnPTVOhgwT8Pj5Dv_ZihoKji-F70OxiNZf6zDRr-gdA&oe=69F60406"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHeg6mp1mG0Q7kNvwGLjzh3&_nc_oc=Adrysg9auQE7IoZcrEg0QxvhH-Nz2f_7dKkXA6kObyImV_unCzwC_yXcmMtynJH1bSM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0G5CpEO0pSHDFVCiBHks2dOm5FLxgBScIz-f1pGTGvwA&oe=69F5E9C3"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oc
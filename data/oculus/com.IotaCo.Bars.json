4NkUyDQAKrGyznGP3ZVbvPajzEXZgl_551w&oe=69F20E28"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=scPXiZdUe-QQ7kNvwFyD91z&_nc_oc=Adr9t5mFr_7r60Tak-gMn05KoP3BhT4ZR4H0wytQYsgPj9sSmRJPgyuDuypWDK0D10o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3WRdwnZDoVKUJwViiDR53gk8VwjtpHsvO17SE6SGOGTg&oe=69F20F86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIlMYIhGPX8Q7kNvwHPtAR3&_nc_oc=AdqGs4vD8gr9vj8IZFKb7e6lHYJnb9uQ82heIRldk82qwu2ZFO1L8z8LotqP7iP813A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2X7nxk9Y0ioULJD__MQ1tftRaGqxWAoD85RN5uxFbwoQ&oe=69F1F543"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_pri
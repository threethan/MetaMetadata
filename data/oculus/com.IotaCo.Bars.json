": "319755241190061", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974669_319755244523394_9165807040462637955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tj3irL2l8gQ7kNvwHW34E9&_nc_oc=Adqy1cmf_BZ6UNt69e2Ri4goxFNVTy1uI9W33her8myGiw--ADRmkW8pdY-77w9d4eQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiRt3nUL9MpdKL8B5PoTkwkZeG4tIg0XeBHPohe8oxlA&oe=6AB69533"}]}, "id": "410427738279044", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "8275721799126345", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75375751_8275721802459678_6058021830509629790_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=onLrlJZXl7YQ7kNvwHL0_be&_nc_oc=AdogxIny-wRpJpd7cqhGJs3q_d99TG4uqEHxMSvW3rBihsfvT2luvVppWSET_kvCd30&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJU4ge3kqLwK_SRrnalyOgwAYeqNKjrGaEYndDMMzeBog&oe=6AB678A9"}, {"file_name": "pic3.png", "id": "2767506536744558", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035400_2767506540077891_1994933407131659407_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEdCz898WIkQ7kNvwFvKIof&_nc_oc=AdrBMM6gqYNyx0gUFUZvJ0VGsbozAPKlWqN5YxhelseOtdYZPTyvHyfGZxHH9kUdP5Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRk--v15uZd5xl0P_Ycg92ULkZlhvHIu5Bpb5f3mvmxw&oe=6AB673E1"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOFapjAOPQUQ7kNvwGrVVsx&_nc_oc=AdqEkyDzxIJCE6aLre2Go08vOcb92VLmFymq_bR8bNHqURLeR6Y4rdgPe5lPUWgQWYc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgEpUUX1fJtxFw8T74Lfh7XE8pJeCWAK4cWqkV94m8bQ&oe=6AB68AD7"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=httppLOiS7kQ7kNvwGunNQ3&_nc_oc=AdqcDjIx_laWoFOO9q9-bdNVC8hIKYPqv33Exzm_FVe9PoBiu5IxiMXysI-yWXaaGs8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7sN-lYuCVAVwC2tm3S6wYpTxy7cLx8AJ6EMSPOH9e4A&oe=6AB67DA8"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmTWZBGbLq4Q7kNvwHZI36C&_nc_oc=Adp2s5STuiG4w3OAqYjW_MtbSbeS0DI_E0Mm37C50KpwG2evbKRGv8xqV730-9t0WZk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3gdlSKDt6kzlZzC_9Q6aNIvzacTjNViSgWvFndP2ZpQ&oe=6AB67F06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V38JX_CE9a4Q7kNvwF3PaD3&_nc_oc=AdrDaWMy4rSR2fN-Y_a7tGmnGzDxl19tkcsT-7WdQcaoSYv3gsIR3n98yv22YB2KvOw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINF2zfy6oeLN0A8VhvLbePkn28gzfUerBO76m48OmTtQ&oe=6AB69D03"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "840880844612955"}]}, "baseline_offer": {"id": "840880844612955"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1725033660, "status": "PUBLISHED", "id": "840880844612955"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8583845591627462", "version": "0.2"}, "id": "1196272561519604", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8162465477098811", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8583845591627462"}, "release_status": "RELEASED"}, "binary_release_channels": {"nod
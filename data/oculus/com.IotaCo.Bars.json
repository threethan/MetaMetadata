5SnNdcwItUyhs&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cvtLWCmxgH2XjWCOt2oaycouCebvG1k5oVHwT4e5qxA&oe=69E23261"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2X_ytgPl6YQ7kNvwHARpGc&_nc_oc=AdqmCQIC8Xqrqi93BalckGe0MPiGYEZ7eNNO867Mi-eeiFlYT-QVQnmF4t-iIYe_-qA&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IBH8YSvtrpUg4m_3om39af_-rkIZ_CNAI_W_Svj-NwA&oe=69E24957"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlQYsiRSfq8Q7kNvwGjUYvj&_nc_oc=AdqwDsheAGfnl00GQHwSg-7N-dZkTXpKoUhKsZ0bTeRUOB_eFF7iQbf-PMLtD3sztJk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28m6M9z7t20smtVBByeGu1FNWcoQMJJ5-0dU8m0xoxBQ&oe=69E23C28"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09WGnQOgei0Q7kNvwEa_T9r&_nc_oc=Adp_miyoEaisX1PGGyfjUkyivUnNbgQW_v81ssHJq8gjEjTqlIZnKAnksP5TX7OBhhc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Uk_aCNNFATyslRrqoByBkFUGAPIJfojWK_Igx7YIN2A&oe=69E23D86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfZQ2rS93GwQ7kNvwFs-4D7&_nc_oc=Ado-5tCxpsWKWAfntI8_WK1inbm5yRmqUva6wJ0tT2L-NqjeN83CZPgYQF5Xn8-4CPY&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cJABbz89Vj-J6Un_mPagXlaL3KigIV3qqpbBT2jlY9Q&oe=69E22343"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-2.oc
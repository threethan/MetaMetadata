EFT7fPUg&oe=69A198E1"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqedKi9wTR0Q7kNvwG9rWcJ&_nc_oc=AdkkVGgaLbzADJWFg_gIu1d8Umq9XBh0GnaNTdD2tPFsH2IviGGXGkpyiPxRcxLpp0M&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfubHNQkZmewJcaMpucu-FEJiNEZd-Gdbr3KfkOaU1aUMA&oe=69A17797"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Th8-c0ryfEsQ7kNvwESyrxX&_nc_oc=AdlqodNh6wXi8b35c-8CW366O8Mkjv-yO7GPqnBOBO4HPghxq6my6UXfYMPqVhcfUoU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvZawr0fqd_ndEeS8ntnekXsA8v0VgC-IXKH8_woVRJ8A&oe=69A1A2A8"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1S53tsrE2cQ7kNvwFUzMYJ&_nc_oc=AdnpLMMWwPAl1x2ZfoImCpUwu5_w1SB2_ldFpsBWoeOk5zEP1eeyjL4q6k0FJMs9lTc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftnAFSpUVJAnVaZrWLoWNHhZVnSIw0xJYvdfdJdhp9o0g&oe=69A1A406"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TaTlQERm7GgQ7kNvwHNj5OT&_nc_oc=AdlBdjhpssUFG83SzSFH6WPh0CHH9Zd5fe3pg2QafqxUGr-ttUNsG2-FUGYwvPvG200&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afth-iMS4mWIbwyhci812wXtY0GwXpWQ31PrghAn8fbY7w&oe=69A189C3"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75644991_478298924611798_3428034440511380311_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYlMBqyeGNYQ7kNvwHwS7e7&_nc_
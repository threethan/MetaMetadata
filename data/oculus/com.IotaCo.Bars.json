": "319755241190061", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974669_319755244523394_9165807040462637955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KE8WPq72Gs8Q7kNvwGtK2YZ&_nc_oc=AdqZWS0yXEIGmH8I9JW3yysPYfS5pZ6FMmHt4f_Z3WJ33Ji0TEvNzH40hIpwqI72s4I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1roklnOoJOK_28DHcFYSOkjcg485tJ8DQOXlVP7nBMZQ&oe=69F4C8B3"}]}, "id": "410427738279044", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "8275721799126345", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75375751_8275721802459678_6058021830509629790_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmmJ3_zQu_gQ7kNvwGwL1zf&_nc_oc=AdqMvZ29VsDIjIoAHf9mhrRHmwQ2o0adXTIRpqymuSAWLd9bSbemhh99GejhTucU7Hs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Gi8xDEHMBwI83I57cs6THcuPa7DZgUSZy8aslKGcrDQ&oe=69F4AC29"}, {"file_name": "pic3.png", "id": "2767506536744558", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035400_2767506540077891_1994933407131659407_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADSIkjqIenoQ7kNvwHLnYQZ&_nc_oc=AdpkpVkftJQOxsWFH65316yF4y5LkkSBdlqQbLen4qCMPWSN_RGmS_dFGh3C2nqFSD8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2DzQnwYckxpVbO3ESi_k6a0Sd77zWZapYzHErlI5pB8g&oe=69F4A761"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdlWeEGVlAIQ7kNvwGDXucp&_nc_oc=AdrJvAyt_TyfkTZ3J1-MzDXZ9goFuT6Rnc9NLzsX2rkntMrR2tgZY1OK19oEKfAi8ms&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af15wnB00uL4CIvkbwW_sgaweeFjiscsU2Yvqx4CReN9Mg&oe=69F4BE57"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UDK0qV8uxMQ7kNvwGh4I3S&_nc_oc=Adoeeb9fQzfA9CB5jkgR3xKnxxf-4XrDDbVYMgOjSq3_J4nyxiQDSIPUwP5Q7VoEuFM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3DEdPMBhWu0qQVJRsVOQs7B6cXzAxGF76Wic64OPjXWQ&oe=69F4B128"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=scPXiZdUe-QQ7kNvwGg5TBI&_nc_oc=AdqcvuJ6Yz04S_VJKq7ai4jHt5dSLCZO78Kuqb4LVF2Dc8O_lv79OnHtF6sieHfDgVg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1PR4WYxxkcNgzLa003Fxg6d_kBG-9r0Ik2hSwEVXSUuw&oe=69F4B286"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIlMYIhGPX8Q7kNvwEs27SB&_nc_oc=AdqH9GkWQvt0zL94XxGd95Z1etmXoBKT8MZFt4n-YyddgX48IdOd_VXnLiFT456zK-g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2MhU2w4tOhLDIvxi8T9NdKXfbOS6eIF8EkyXZ8NDtaLw&oe=69F49843"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "840880844612955"}]}, "baseline_offer": {"id": "840880844612955"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1725033660, "status": "PUBLISHED", "id": "840880844612955"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8583845591627462", "version": "0.2"}, "id": "1196272561519604", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8162465477098811", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8583845591627462"}, "release_status": "RELEASED"}, "binary_release_channels": {"nod
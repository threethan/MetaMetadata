": "319755241190061", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974669_319755244523394_9165807040462637955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4heOcyfis8Q7kNvwEEcYLe&_nc_oc=AdpqNsi3sMzYsJrbFrnStSBUYlxW7sXchmDDGUWJaSuWoHmofP-H5Yp5mgExbrUFHw0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74DfBA0FhjJ6a_0j6u9yuDNgDMBKH8cDPMn1xwpEHg5w&oe=6A0DD533"}]}, "id": "410427738279044", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "8275721799126345", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75375751_8275721802459678_6058021830509629790_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZwD_1t3r8RAQ7kNvwE8a_Ig&_nc_oc=Adou9GTqgEM7uQ36u_wmLMQuiOK-xhKlqApIgyNajS2kDMv2iH9TxCW9T7QDUI7L-Uc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FBJWruJXq6_GQs2IQw31_jPv74N83d5n_pidRenkjlg&oe=6A0DB8A9"}, {"file_name": "pic3.png", "id": "2767506536744558", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035400_2767506540077891_1994933407131659407_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f97BdHKbvh8Q7kNvwHi2_gi&_nc_oc=Adr6Psiun07BOHrYMyhkI-KrWoikTWeKj7DBVf_bLbz-ZsKDD52mu9PB7YOLZgG5rpg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qgvCoMBGkyNw0UKAVHJzSI0Fl0Mceiy1FNt-8zChlCA&oe=6A0DB3E1"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22BDCoHzvGEQ7kNvwFOi5ng&_nc_oc=AdpEJb7ZX6d4lZP1sg_wlzQnQTHJvECnNO7ZGNR4O-Dep5dnLOxrQUpYMOaqCO0aCl0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AJQ05V5jqW6ggk4Ot-qcppZE9Zj-miP7GCjHdonH89g&oe=6A0DCAD7"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzhM9eXCyDoQ7kNvwHzTlBX&_nc_oc=AdqFsZSe7YKyuWrJwwQqLNT9Mljf9U1DIcnejIfq00IHePE8E1ju6cPJTYQtxDnB-h8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ym9MfDybWE98jVIFGW2apx2FVw0OIO9fKiW9dQlWA0Q&oe=6A0DBDA8"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxi9vmNDTikQ7kNvwGKOYtF&_nc_oc=AdpcJzAeT4ICyZVDu_GH-P0bZHVUBVu1Fo1WFDchrCWXIxQA-0ZHSAeM67Op8WWQHDI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6x69rKzjRB2wsx-f49ozK9txyScb3gymIRWs3dDQPhCg&oe=6A0DBF06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E32-42_DBGIQ7kNvwFvRauL&_nc_oc=Adp5nkWczcCX9vYO3pDtHDbr-nZKiXVuuOGPkFGhDWPL0do90qWy3UkodYCwE9-ZpGk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gNCqCjGlIuy4uvNcRqeNPaZD3UTdRPDj8i-L2h-YdOQ&oe=6A0DA4C3"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "840880844612955"}]}, "baseline_offer": {"id": "840880844612955"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1725033660, "status": "PUBLISHED", "id": "840880844612955"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8583845591627462", "version": "0.2"}, "id": "1196272561519604", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8162465477098811", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8583845591627462"}, "release_status": "RELEASED"}, "binary_release_channels": {"nod
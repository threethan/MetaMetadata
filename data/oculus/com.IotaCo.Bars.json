VA69ySGEYLehI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-mbNGZNBG-VBFw8_f7IPhbRF0eiFA0oqUxeDO-ZjAVA&oe=6A660861"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zctA3KaiJ4YQ7kNvwE2SfFH&_nc_oc=AdoIz1Re2BT_nDUoUYeaxV8BofS7nZafu2hAOrectEqYzU8T8MZ8x10OA-VMayr0Rf0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCepfI3JZ1cMbiFjN9QLFuPJG1YAym4hDSZ9uZ9DpyNjQ&oe=6A661F57"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4ZLqFaHpRgQ7kNvwEa5bcs&_nc_oc=AdrUPz-aRnDoWRqo7tMzNsLKHi-1ggwCdkm2crnd0rxsircRsoK18xWliVAjYlX9ulQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAG-b6se2rP8Tz2vIgdmEfzdyLxENTvoYIgW1xO7DmsHA&oe=6A661228"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjU7xU2AhFsQ7kNvwHG4si5&_nc_oc=AdpQ5R53na8SK5q_DNSGbug8M4qrjc8jQSdGyUIQlQCw0twrOFoRJfc2SrAJcI0N438&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoID6iJCjashalJ_Iil37vPtd6NlCNtb7NcMwIoi3BzQ&oe=6A661386"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZeUh4Z9O5IQ7kNvwFKNKzc&_nc_oc=AdqntbE14LyJRgyfrYQl-4RuMF6xOHO3dqxxU8se9LX1ywdvUgxam6alsLeKJf_3xxk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHaxHt-Nh6v_RasXQ_9N3GWTL-FTZ7AeLZnqtUrbmtqw&oe=6A65F943"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oc
": "319755241190061", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974669_319755244523394_9165807040462637955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0jsNFyyBWgQ7kNvwG9A-Jc&_nc_oc=AdqRNCjGj-KDkXBEay6E6je2sKC9gIWmiKoe0DgywYR-ja1lGx2PfTOXovGoqd9uZ8I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1IALwaxMY6AuUFcOqXnhAHWeeBTYxnRVQZaaZ52wqoZw&oe=69F8BD33"}]}, "id": "410427738279044", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "8275721799126345", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375751_8275721802459678_6058021830509629790_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LfE5hCjcguoQ7kNvwESFrL0&_nc_oc=AdouIIOlPU-9fcEkGZE-B1fWl998E4_L0N5BeelG52eu951VATdMLDsKMnwzBwSIVKw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af07kbROd99u8YoJ8XJx1TVjGPIH_5Cc4art8ilPPnjrTA&oe=69F8A0A9"}, {"file_name": "pic3.png", "id": "2767506536744558", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035400_2767506540077891_1994933407131659407_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8p0ODeb2qHIQ7kNvwETWCZn&_nc_oc=AdrmalpeJZtzhEtce_DcDbYVRZFQDVq4gEBSGKDg_g1hQ-ZnIcLoBgJvlu645Mvg5wI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3PNcQ6gU4fdt1_FxSgYM2gQ-V7iH8nr-OtLNCOUaPoUw&oe=69F89BE1"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vaH9NajJMHIQ7kNvwHu6tcB&_nc_oc=AdpD8KObgmT_9ntyHtYgLDrbxUC_DPKkL8y_88tSOuRQ-4EAVaxrvUrpvVECpb7iKNI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ztoscc39AgojMMomIXSJD4tL-7eQnxathJJgr1QceYw&oe=69F8B2D7"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l066Dg9W7eQQ7kNvwHGT0qb&_nc_oc=AdoR5GRNcnDBI6vTaHGuX1tfz8-4jzowvGw0oyXehu_oOnL4c4IBwQLYAB8h1VcL4vg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af01SertEuAuqj-aqkOQr-iXYX8CyIRtzzpMz18t35Td-A&oe=69F8A5A8"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M65Q9l5RyWwQ7kNvwHjtV_X&_nc_oc=AdqslhbcrpObug-6W0wiwRaWKCrhJLyImgIFvgEdrc3dK0dwooMNqycsx40z9NlV5xU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3vOHkJ9flzm8kz8m5GW1nuajULCSK2ColvD4un2nNurg&oe=69F8A706"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHeg6mp1mG0Q7kNvwFmPZ7f&_nc_oc=Adqp4wTWXV4oQ_UUQLVH5PZo1Xfv2uVM2UG3WzD-LH82FvmglJP-vLJfhHRwk7fZFXM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2CNMiffqJgPKonKovAm6TPGI5vXZj1cjCDc1ThHFN9XQ&oe=69F88CC3"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "840880844612955"}]}, "baseline_offer": {"id": "840880844612955"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1725033660, "status": "PUBLISHED", "id": "840880844612955"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8583845591627462", "version": "0.2"}, "id": "1196272561519604", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8162465477098811", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8583845591627462"}, "release_status": "RELEASED"}, "binary_release_channels": {"nod
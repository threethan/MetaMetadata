y-_WmgJbnEwDo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWdhIArIUq-qhNj6m5JIEd68cuNWV3eFmTPJxmYU3o3Q&oe=69D10EE1"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdxUTa2-vA0Q7kNvwHZTeFL&_nc_oc=Adry_fVarTe_L-IEQ3eL_t5WMqtYOC8floLtyovYoZSrzjeSC1jMaSvsvxs7n1MQ5-E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzwmugEZzti55Q2GwSVsFaokcjWJtg6NWwtJVYp5JNmxA&oe=69D125D7"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-KnIyyk7ksQ7kNvwEad20O&_nc_oc=AdoNxgCMXrGTkPYo5ibM7gZDTCIrqnBTAst5lKupt7--6SW-s1Z09gCfTqMKGWJ1jB4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwffenUHio3RVtL5Uwx4ugKAUKjBJTC6hRbOTyJYttk-A&oe=69D118A8"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_yaGX_dvXIQ7kNvwGNPdnf&_nc_oc=AdpXI5oQV_SZpgiWcEEmG721owwhO28MPBU1uVDGTKua8UKzlVLO8F-eM3l9BaAx-Ko&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySzhRSn7HEViX6Rvd7gUveYFVdpfHlWTVoDZmdIbGKlw&oe=69D11A06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=almQyN9BVrcQ7kNvwGya81L&_nc_oc=Adr0Gz-wb3wLwR4I4rso8e8HT5epgZ-5p9hpOX0adjIQFEZfhkFl6tZmbY6N2_Y-QEA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx4nz-NxPI-DsOkfphsBlEpVJEZwLX_G8kkCPWgaZEONg&oe=69D0FFC3"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oc
SiLrn1GNeDRNE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_SpOkxOkVMYoRqqkMvZUi8Cd-_6X9uYXBDZUjxJahtQ&oe=69C53161"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9NruxtCwKoQ7kNvwH5A4TA&_nc_oc=Adr66YlavhDe72epDeZ9YtqdlTwwRupISp59Iv1lr_8hJT9DueYQVYxhPqGpdcVlxsQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyS6vM-TN1LEiK9Sut28CphAdupdQJc6h09P-iFhvL0og&oe=69C51017"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nT2vo5BVMYoQ7kNvwHggFqe&_nc_oc=Adq57nwu6V7VHufyMMOmxLkihfr9XvrVHR6DMT0nv36oBGERSsyzYgMjHSwe5me4myo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyKeFmfa35W4rjmPllzJkLWGqXG3CVljlQiepu5kqBy7A&oe=69C53B28"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3XnYdHW1jwQ7kNvwEH2kZF&_nc_oc=AdpMKlew9qjP7yMJCgel57H8ixkCCK9EF85GDp3eZemUsXWs22BfCgOdOMhLQUgJLME&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzDjnfRxtPr0UOellI2MAF4wFZU24_GO2tEFvhx9mzk0Q&oe=69C53C86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-oybK5z1F4Q7kNvwH_a74v&_nc_oc=AdqWzQ3JACbIKYbDWkUM6e2vEwTXR5JNmq_Jr0jzli_H_vuy1wzfoXFEwsCcWvtiCjE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwxUlgyRPsC7QkIBthENsyvEc_HcFSejK_TcAtI3Lcarg&oe=69C52243"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oc
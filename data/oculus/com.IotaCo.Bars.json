i5FvC9Xle8u8Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1yi-_7yRb6Wa6vhlp-nCB9XguJpP8vBrHj6XqfaQLKA&oe=6A539361"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DK6HCih6vv0Q7kNvwFHMYh_&_nc_oc=AdqlXpnDcaPhuOHYMpu2Lv87-fHmm1zH2jQUdqw5MIoHs5v__oCy1QiKguL3j5WMYj0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjwz7XkGdmKy6JfEksozsufsVaiUv_9zIHVe1-EcJJug&oe=6A53AA57"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sr0_RApA3sQ7kNvwF8TCV3&_nc_oc=AdocEwLgRbF-mRvEy0rkGYI5lHjcxQH3vDswBfmq8i71bb1hwKDWLm3JPUuiizPDn3E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVuOmUNc4PWDWb_asGhLKNdSa97MUUq4NkUR9eaxLX1w&oe=6A539D28"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHf4xcPVBGAQ7kNvwHHREYe&_nc_oc=AdpENPaYDRNgIcQB6PY8rNefEYf9cYUvandeq2kKteYH6C0EjliLYSj9XXzdK6jCGIA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCI7okNuQUuu0Xwz4U6tZAAB_FfzM0jdAhxfSKjTdzGSQ&oe=6A539E86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qyrYSTBOMgQ7kNvwHWUsu3&_nc_oc=AdoS_XOyam6WUacv390Iyy9TwiThCoySVu7UV9Y6mTJjvD_7CeyZ1IxWvmURZQZyjaY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-crlggecFn5RPCq0xD0YoD6uticvGdX-HGp6z6L6QbQ&oe=6A538443"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oc
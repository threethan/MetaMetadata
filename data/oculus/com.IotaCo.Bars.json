JX-brARSCxA64&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TeFm_icHTVw24Ui1ayhvWD46DDTeSlrIcyfcNl9uZ0w&oe=6A296361"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TV7ioFgfKnMQ7kNvwHud1Rd&_nc_oc=AdpVGUAJJmFC6EGSR-T6RSoYnIONVRdU9MWBRbGWHfMldqTTtLNFwT0yKUohAy1KEy4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MnFqHc7el6p3ofnNvzFyribGK5_gvmg40fdw00b8q1A&oe=6A297A57"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PgGKJ9MqusQ7kNvwHI-tCo&_nc_oc=AdqbwGuTshxOXKdU4WpdlJD86Qe5tE4JNNPXk_AlI2Jj4wJH05tpNs_pqE6AFn3q1Nw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Detj_L079PP9_pMtI6cuN9WGYGY8sz_GNg51nM290FQ&oe=6A296D28"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFrl69kwVDQQ7kNvwFqEA8B&_nc_oc=Adra-5fdNbGjBBi3pdmnwU33V4CDFrIorfMkJ96_lVdXKH4nW6hycbp7Z7PSepnJL0Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af855HK2_jmwrcAq_SHVlSleq8VJPyfcYypHb9zWvBUlTw&oe=6A296E86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UKPJcQ3IpQQ7kNvwGwMgsz&_nc_oc=AdqD4R9d4by8OFtxZ0LiGNEogXZKeZb1Y9FFKL3xHoVdg59ZOjzjNq1Y3CAgjfA39vg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MR1y1jNuQsodUD2h-akEeI9Y2Zm1EhWxddS5-AXY_ig&oe=6A295443"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oc
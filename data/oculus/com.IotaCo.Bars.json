mzYotYhWk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzzqHDozTlFM68cQTQ8y_6vKlyhh0DtoMOujcZUVyb5Jg&oe=69B6BAA8"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_A15b1E7vMQ7kNvwGaIVbw&_nc_oc=AdmZRJgFKCfnoKqJNGN1sxpk1xMVhc6w0dunyEweucjI9IiHBQYMac4kWNQCz_ytjeY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxCtuQXTqzt-9muiaozkNU7FZutwm2TXbes16aRB6xC7w&oe=69B6BC06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKZpOGJbRhwQ7kNvwF8XZvq&_nc_oc=AdkaNHoTJ6ASoXteusGF3JDZGYyNElatirjp2FLCGf-j8FcDMs3bi_myY7Ax0iY6Jto&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxxdOdo60K50qutkqm1yXpyUlWKFKuxfY0ExJ4n1F4vuw&oe=69B6A1C3"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "840880844612955"}]}, "baseline_offer": {"id": "840880844612955"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1725033660, "status": "PUBLISHED", "id": "840880844612955"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8583845591627462", "version": "0.2"}, "id": "1196272561519604", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8162465477098811", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8583845591627462"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1196272561519604"}]}, "change_log": null, "created_date": 1724714969, 
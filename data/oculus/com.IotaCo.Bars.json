HLyfZ_eaZklh4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoplaye_2TzVYdRc_s3kuRbhWkvafP8iwyh7qfLlMb-Q&oe=6AB3D0E1"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOFapjAOPQUQ7kNvwEXsvpD&_nc_oc=AdqIHz8l_p1gp-oaNJBF_nPC_yb3S90nChDUepapxO5OXR9eZy5BshTFfQ3nwTPZCD0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoVLRGEVqX_BzJQ8t9_nwjnREhNy0uz9INC8irEa3Q7g&oe=6AB3E7D7"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNk5yCUR45sQ7kNvwHmaFAS&_nc_oc=AdoT1i8kSW0VRTezBGwRmOLO3pfjJY2d-Pwi_A9JRDEHY4k4YsRS3ZjcwhTcLpsqh3Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRXjJ2BB2CmODz58dS9hQRV6DcmGXxf8I-IV0UkiWBxg&oe=6AB3DAA8"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmTWZBGbLq4Q7kNvwHRj81t&_nc_oc=AdqlT0VDpCfE9Ii1_lI1gFb9Cvb6SuE4IjppqDMdzjqaHglPx1aXzgg-47jbKTdyvyU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJb6xvlGvyfl-ihc9Cz-mRv7X9XH3LEWMVC5yFH6GkMJw&oe=6AB3DC06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V38JX_CE9a4Q7kNvwHy_xb1&_nc_oc=Adp88WOc9y2_aWplnPJ556geOXQZ2bAES9rNrIA9UxFOMa0aRUZ2puAxhfipYdOU_LI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-WiN7W0yaJTgOpLWVRwpavI83n0kiMkGktdfoHFQgMA&oe=6AB3C1C3"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oc
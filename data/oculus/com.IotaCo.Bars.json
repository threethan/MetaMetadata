AmeliUGRvjZGA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7i4iom7-AU6B1ZoWAS48_0znzu-CmBMtrIxs-x-wlAvw&oe=6A01D661"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCUXpL1IirEQ7kNvwHdi2lO&_nc_oc=Adp_jDMjBXF_6wNiOfE_al9G7OzE0a4auIyCGpr_zTu3UYmTcf7yBCmJhqiHaCNSj6I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Mzm8xR7OWj4_CVCoRUY_fTfe4Fr0KaAgPMXzCnhiyrA&oe=6A01ED57"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0AwTwqCLKMQ7kNvwEMz050&_nc_oc=Adr8D_Q2rgC3ssBg7wLUkwm9qy-o-KeT9nn4qJrH3x8SDwTcrHJ3hNsrwrGJbyY_4S0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4u7cv8z2Qt22ImfSf4E-wVNmIPYK2MgQpLyAIH6d6PdQ&oe=6A01E028"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffTw98Y6LbwQ7kNvwEHfkhc&_nc_oc=Adoc4QJnexY0D4KOjHCB_AytMQM9EZeJX36afSE0qwouCtHCLCGw9My4zZcTRRxgvMk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71O6kJpEIaq1fzTYsPU65vj7TrrbmUFd8xpu6abEhdjg&oe=6A01E186"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVdNtrVeAz4Q7kNvwGAf1CS&_nc_oc=AdpO4cg_0JrXGfzskTei1R-W6Avo68B_1QO-JLyVCFgqYZ9GL7usOXcmJwMxoUkPlK8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7d6F-oWopRmh-yYscnZ3hg8OTWtVqO0LJRx5jBjlKBWA&oe=6A01C743"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oc
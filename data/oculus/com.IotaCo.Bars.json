": "319755241190061", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974669_319755244523394_9165807040462637955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yp2fH7jA7DQQ7kNvwGEHc0s&_nc_oc=AdqCe95X3U8CiQg4hP67QWMbxTmCEoSjW2YH_At5wQ7r1i3XF2-j4JSbCxwHB7izrMw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSXsap06IEfNCsGsaWN85II4HtHweDErvcH8u4uHUWTg&oe=6AAFFDB3"}]}, "id": "410427738279044", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "8275721799126345", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375751_8275721802459678_6058021830509629790_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjcLRdQUhHIQ7kNvwFkLmR3&_nc_oc=Adpoddw7W2367g1uGHnHsc2OEmqR0nY6x49p4hBCjVlnDKDl1e0Ws_oerTxtyei1IP4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFmgLjfki0bMzj5kG9BrbAX7v5Id-23I3uWNTIaGaJMw&oe=6AAFE129"}, {"file_name": "pic3.png", "id": "2767506536744558", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035400_2767506540077891_1994933407131659407_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PWW_zCuOL8Q7kNvwE8Ny-7&_nc_oc=AdqZXfw53DzxpYjFpXaBmo_FQ1zwzarzp1NLCWKBnopI-vy4KmbOGqg04W3IYSSWbyY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpsN8bKOgC0plHGaLyDTtrXK5gC0ehLRxm6Y9t_sOwMg&oe=6AAFDC61"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tR-rqR3zmAQ7kNvwEGFGNE&_nc_oc=AdqoxtbUqMV5fJo_yHMxGBx08ieIfVfAsj8dBnu2XRv_Fu1sZkfNSriSk9n1_bYXRec&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1hqScrh7Kxw74iAoDCQLleu_wF4PiTxzW2H7c_7QvkA&oe=6AAFF357"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMRYigFyKkMQ7kNvwGHyKuF&_nc_oc=AdocKgh7nka6B7O53ySKTG1EylYEzz3XCA_k-vNdVczj_cUL6zhCv1G2Nvo2138-Pxc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUB7tzfa1hmoekPbjKEzfLGv9GxyrfCkUcABWCmNKOUQ&oe=6AAFE628"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nT-CLLT0kWcQ7kNvwGf82Lq&_nc_oc=AdpvHSz-BYYn89i_aakwUylTgwTT90J5AElVhaFwYbNRyP-WVtyy8jUxl-4vnSJ5upk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNWfIEXQ0RPZ8qaIpVM9yTRrHb0kmpt3rNtVn3KF4yCQ&oe=6AAFE786"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_7IOhczTLYQ7kNvwG_ipJP&_nc_oc=Adpl5tOGg7wUu-k6G7LUklNINcYugXWWxgXOQO51vphHAkbnkJHpgygMQZPu4ktJQng&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqW9HD_22FgoBzAeFVlI1uTW7e1SCZArh_GpRF6BrNkg&oe=6AB00583"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "840880844612955"}]}, "baseline_offer": {"id": "840880844612955"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1725033660, "status": "PUBLISHED", "id": "840880844612955"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8583845591627462", "version": "0.2"}, "id": "1196272561519604", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8162465477098811", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8583845591627462"}, "release_status": "RELEASED"}, "binary_release_channels": {"nod
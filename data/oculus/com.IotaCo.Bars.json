pYvRex1FYFg_8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwe2Q58Czg4H9ZHdYBA-Ux30rfA_zsv1uQ5dusQXl8ZSA&oe=69CFBD61"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdxUTa2-vA0Q7kNvwFqZ3Ea&_nc_oc=AdrSqUKxgMlcAZ0j6EBKNS9eVoSIYNUh_YqcDalLgq5Hx2ku6cI9IHRbPQpe_UgZU58&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyoie-ymVVjjuhS1SuostozzniDa1Jk-hC-lQAuO3WUfQ&oe=69CFD457"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-KnIyyk7ksQ7kNvwHaQ9bO&_nc_oc=AdoIf5lBKYOSyCPa7xrL0CfVMHYRS0RyVfl85VL0KCPgsbZW7WuQbaBy9sCoUm6CnHA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfypWjRno2aiRgxLrEludwmXK7Gk0AF3NvcOUuKFaiYtOA&oe=69CFC728"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_yaGX_dvXIQ7kNvwHcilov&_nc_oc=Adoa8HwbGeKqX3ympgs_gB4DCxrXjOG-tKHRYK8lqUiotVCbGHs0dW2mKWKcQSKEpUM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxE82Cjmox1Bbcs65hwvMbks8lPBgNotm8gaAzgabsNKQ&oe=69CFC886"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=almQyN9BVrcQ7kNvwFReXgL&_nc_oc=Adq4-9Zos5SJ2QUjWP3zFyyfz70nh1MRGO6ux2hT2zUXkxxyaa2ObT2vEu80n-XmK-U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUN1R3y6HUL7ClOP5-z67ybsFff-9YnmEocm8IMq9ltw&oe=69CFAE43"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oc
": "319755241190061", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974669_319755244523394_9165807040462637955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2VXJLvVaWQQ7kNvwH3uwf-&_nc_oc=AdpoAmiJL_upkkn8g2NUBILcVE6i8txpUh17se8NBxxjdzaDzh2tsTIMtu6THPH62n4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_-qsdB7TjTe1tjVusDkZD2YJu7d9SWBDyYcEf1x0vlw&oe=6ABA89B3"}]}, "id": "410427738279044", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "8275721799126345", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75375751_8275721802459678_6058021830509629790_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjhOgpOa0kQQ7kNvwFG4uQO&_nc_oc=Adomg4thJcOyktNvZTwGc2gYhA3INLuZPPC0jM5mvXxQRFP5zl2FkyPD7vvDeMhNxzI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOst70vMZ46YEQYnRhAZ88rzMEC1z1eE_EIlCN8EaO0g&oe=6ABA6D29"}, {"file_name": "pic3.png", "id": "2767506536744558", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035400_2767506540077891_1994933407131659407_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8KbS2mr04gQ7kNvwHiPhV9&_nc_oc=AdrOY3Juu81Z36tuIIo7UzzJMS8pCI41LLHUjBtNT0X55QT_F8K8EzqSlG1qHjt74Do&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwfb89xm7PaXaaTfPb3_jWOffPKbH54fPKmn_m1hnDkw&oe=6ABA6861"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9V3Idsh26QIQ7kNvwHPsuX1&_nc_oc=AdqU1MBVmR5JZM1iZvUCcaghqv-N4NwOj1m-8Ebq98Gc89cFWgSvFXOg2LQYkqLeX3E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQesLR700M6I4wt3KAypod68h2boiD-1XYxzPeGCb0RA&oe=6ABA7F57"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6InlQd8qQKEQ7kNvwHze26v&_nc_oc=Adrj8LbycSGkYFcoLymwnzdfqj4N9LOPsZRdYdUV5bF-RJUM7VKBekbT78x6gKqvnc8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIK8-WxzjF4Kgog-vKzx9elHSCtPISEbKYJE1cyYB5EwA&oe=6ABA7228"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mhr61Bl4zXwQ7kNvwFwajzF&_nc_oc=AdofTeWpz5IcU333qeOB4qjtZjAV3YaIw_btcnuYJcjVX2r81FR3RKtddAQzieSluII&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhHpQypZj12nAErZ9H_u8NH4xC18KDJZvv972bKv3u2g&oe=6ABA7386"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFj4NSEQ4P8Q7kNvwE8zFP0&_nc_oc=AdqfCYou1QZfucML9j0hJwoDS1GyXPWRVg89ujfotiDMk5juqojSvXkKUCudcJ_KuIs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpS_XSGzTMIBbzojzNziHWvoiMcM7AtT0Ijt4kNQqTjA&oe=6ABA9183"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "840880844612955"}]}, "baseline_offer": {"id": "840880844612955"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1725033660, "status": "PUBLISHED", "id": "840880844612955"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8583845591627462", "version": "0.2"}, "id": "1196272561519604", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8162465477098811", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8583845591627462"}, "release_status": "RELEASED"}, "binary_release_channels": {"nod
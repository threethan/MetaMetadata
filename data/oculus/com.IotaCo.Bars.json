jST0AS6grTE13Run9Quc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PMhRLcM6O2nFzR9_6KL9XJ_Pf3R7IzvR4Mu6cMLgpEQ&oe=6A393561"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NL7ciqklfGAQ7kNvwGeZfYJ&_nc_oc=AdrE_RQuhbq7DJvfeezkqDLCMWNHYZl3GP_iUj885fIb3O5_jnL4KUkiWf8m3hMTWEA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ajCW_jpExJBtg-lO0UD9oUTh1GPV3meqqAxaH1UFGyg&oe=6A394C57"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBcZc1__Kx8Q7kNvwG2TuMK&_nc_oc=Adqa7W-3rwq04WYWF5wZkD5MY8FNPVbWwktQUxciiohn2Cz2f2iMgLPX8uXZWSgYJkI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mIdnzmRGvWIh_FAbyVqo3vyN3MQ4nouVl-l7WAropMA&oe=6A393F28"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-fvqtGAbw8Q7kNvwHY26RB&_nc_oc=Adq8PaIUxTNd3RAoATyJlqeI_aqzldhA5gwGiCla9bRQRkTZOSVP8TbJzb_zBWax3zI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9imKZCRPlM5v7UvtlE0shni_N8zbTHmNHoSw05vFTYbA&oe=6A394086"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRsZkuAb7QgQ7kNvwFhJeHk&_nc_oc=AdpwlbDAay5rflkwpiH_ujRf8kR3jxO3A7t5gb5cJ7BumW-8IVS0FSuKx1MEqwy15Ik&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Exx3puv8vn_fKHpqUAt5GOeNyWigwCgyXfF7LwfMZDA&oe=6A395E83"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent
ontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzdauKk-prcW_DF--xcs1v4_p2PB0b7eelRsQP3YaMNlA&oe=69AD7661"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OiPRT8Y-47QQ7kNvwFOSgmU&_nc_oc=AdmFLnysxPL7aO-0D9MOrxg40PL-3bjZtHt_cnLjvGkR2u0H2ViDGWJrsG9aZkPui8c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLAC-1SnrCQD5RrbfdvBKhOz6Wos6YkewzdwzfL-LwMA&oe=69AD5517"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkDBqP44seAQ7kNvwH9NJOz&_nc_oc=AdnBC-ZLk9am010AdO3IjURrfjRD_4wA5jT5j-p4NV8_f91pDZ-qJn-2QafE7jlhdHU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfztLPISI5xV40y3L9b8YZEx1V3hOTP8bDcdpkoW88ATDQ&oe=69AD8028"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFjGTT4RiLMQ7kNvwFcdFc7&_nc_oc=AdmcmcQdLZvhcTyNqpW4T_svZFbaw94aeqzpg6BeLwl-KUm6nVkevQVMzdl8JLf6tcw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyfs6mbfbSDRfQFnrFTxNWzJg9ff-xOKxTkMsDlGvywkQ&oe=69AD8186"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_zZCZfr68kQ7kNvwEMwjGI&_nc_oc=AdmlJBFyKZ5cUnC_iLvVgSizFr4PJVmawu08_rI0iudCuUwmANIlAXMbdq4LnzIUyVQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzsu4BX8MvLWvlV7EvabRcWKlt6EI4yFbFy7Ekati6yqQ&oe=69AD6743"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75644991_478298924611798_3
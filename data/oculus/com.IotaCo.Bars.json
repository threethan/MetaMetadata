qgKzOPBkFFDEc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDoyf-zApOTFhYSiCb3dH6LescVeBwOsWk8X-wsZsXBw&oe=6AF0AE21"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=im-BpdsiCkwQ7kNvwGhDfdo&_nc_oc=AdrXcQFprnq-6dNB2XEs0D-6N_WNzKQ1UpmR_S7sd_SqDU2Uf060x8elAZRtYLPYow4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlsMBbIk7utFfs6_sXnoCYOWGuWr8eTQMBXznot24YYQ&oe=6AF08CD7"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtvwXtc5yycQ7kNvwGDm8Lt&_nc_oc=Adp-UsFel9dVUnKjzFEmoL8R2XO2AfqvGkxsFkS1e9WfvpYoVhclN-SjN85QlMzspc8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVz4IOMVvqkXLnpThZCXK771a17j0U5YTbbXmlskdzrw&oe=6AF07FA8"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miSq6UehcGUQ7kNvwEtWXLw&_nc_oc=AdrFK9ym-KdDBKj9eqtogmeQ96l7NT-oXfeHCgNnAnchX-4sGPa09gWCXxMrnWrDw5k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWQ2b5PS3LBOx3pa78zXJvG1S1o7mU3ht27n1NHItPIg&oe=6AF08106"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYYrW7Ey8gEQ7kNvwH-OZ_v&_nc_oc=AdrRWG_e8p5lrM3F4yMnCWhlDSr1_IZJm2U3SjRkTmyHfjY82LJcYbJubnfgziJTCJw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRnVt5m_VmnnsVnhFrXVjc_srcnda0-GnTscKyJlrgeQ&oe=6AF09F03"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oc
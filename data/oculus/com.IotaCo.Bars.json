Dtnp9TIt2vHeEOwNy5V0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RQ0Lm7bA5sI8NvpEJDR_HDmJeXYFgZKHk0PvsSFo9UQ&oe=6A11A861"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CvyCmmKuzP8Q7kNvwErZdBY&_nc_oc=AdpefKzEvwKJMmevbHOGuVFcpBd5oXuni5LzskzJFmWipJNQuEXjtCKRKGcYXjuD-vI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Tit6qw7vWrQ5IKRAyGzYQKyspBorYTbdDbVqdHX3CiA&oe=6A11BF57"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cdj2GO9QH8IQ7kNvwEJqHfZ&_nc_oc=AdqLA_IjtTW5itxKa4adDekoO60jMxJS-yT4tPjrZnUVDqwJlO_QDJ2pJcFxe2TA5Xw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XnvQ1YFi7B74ZtNSaZ1Y72AiZHSYIs14pl2WQ7w5-NQ&oe=6A11B228"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpRDKhkc6W0Q7kNvwGenJxB&_nc_oc=Adr2yuPYq3kQeod0NzL_2Im_BQdD8lFaO2VOSdyKsTx1iesYdbzK-3C8rjzJNoWGcXk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7c9bZKMg2qcLoJE0xWmzvdKhNmkh4Nvw47xbGNeF1_NQ&oe=6A11B386"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a78JMb7xNcoQ7kNvwFzjnyM&_nc_oc=AdqqqReP1dE8wOs5gpnKtC6pFn_wWMIEA-GH5tlU5lgTz8KXsxWLi1F1q2tUbWLMQm8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EIYYl6Udn7ZnCgTS0upjRqwr__ed1g11pqqEIsHiiVQ&oe=6A11D183"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent
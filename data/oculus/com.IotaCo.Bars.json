": "319755241190061", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974669_319755244523394_9165807040462637955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kdGTFzAJ-oQ7kNvwENwo9c&_nc_oc=AdrNv91GfWpVrP80UPk7e4B1_jTUz7g-20CHKmINnEujDQVTt9Lre47kDJiFojnV2M4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_D4BwcsNrRp-SZUbH46Xcr6kwc5c5KwItniV5XhsReng&oe=6A380533"}]}, "id": "410427738279044", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "8275721799126345", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75375751_8275721802459678_6058021830509629790_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0T5X6wG26F8Q7kNvwHxR3E0&_nc_oc=Adr2k6xW-HBXAjLlYYihtE4kpaVyJC-ACFRMU3v9Vw37a61MetgRTIdzERN_cNT3Hpo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3WoZC2Wh57CVPmXxXg_YXMV2_FIu-66cBMPDB77SmUA&oe=6A37E8A9"}, {"file_name": "pic3.png", "id": "2767506536744558", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035400_2767506540077891_1994933407131659407_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_o9JfhGtgcQ7kNvwEcenH3&_nc_oc=AdqjIQ06AH0cI2FsYveZj8bvjuYiwOuieyq2QrU2j-VJMAiwR_Z3K20_asMXutTyHJQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HGSiX1DZdCPlFilLUsNbMKysgKNU80FbOIAZW0-DAdw&oe=6A37E3E1"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPVNBX5uTk0Q7kNvwFbt_oC&_nc_oc=Adpo0fZFPxQxewVwR4I6RKiU0pF9Z4SyDvyfiBpCsb2XoMB0q2yYDC9pgjXqNOs0zas&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SL6JjV_K92itAC6EStAaUUZ2oavXzJF_7DJXtBHD5hw&oe=6A37FAD7"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBcZc1__Kx8Q7kNvwGihknl&_nc_oc=AdqA6N2e6J0Am7xef2BFkT8qe95CvsaRWMp1mBBCAVBlXGsE2vVaEJMEBQs99LP1wn4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jefC9ng_ZM-ZhIMi5jcjVoXeC4k2sbmgbkP0xyBYUuw&oe=6A37EDA8"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVqK4Y2GJzQQ7kNvwG882vu&_nc_oc=AdoYzCAnVUHsPgQ5GWYuzApLQ1PoKj_9QSV5Vrc_EszA1M7XKKF4YLK0UfHte3QSSj8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fd9D_GdBvkRGQL-Ur2ZuDq4b8-FpEDPKh0mOXE6z7Aw&oe=6A37EF06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0tAOfGShJIQ7kNvwEkfAfp&_nc_oc=AdqscE1FTL2lM0szafG5Fwiz_C8FB4yokHnqVm29AS9bB6Zfl-EnrVa9FCCCpEJB9eg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tpZsmiGPH1jMgx2b4tyOjrjo3MQXM9NhbS4HnH6blBA&oe=6A380D03"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "840880844612955"}]}, "baseline_offer": {"id": "840880844612955"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1725033660, "status": "PUBLISHED", "id": "840880844612955"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8583845591627462", "version": "0.2"}, "id": "1196272561519604", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8162465477098811", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8583845591627462"}, "release_status": "RELEASED"}, "binary_release_channels": {"nod
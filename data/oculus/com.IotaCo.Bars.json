1lnJGbh308WSU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mbjpXh29b5iqT2akFAiAHXwVLeMU-MSysRF1Au_uS6Q&oe=69E383E1"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2X_ytgPl6YQ7kNvwENfvEq&_nc_oc=AdpUFazqbQAnq_V-c3gi-5IERd-sDywxS3OH9-jdCEGOk_PCXNTZkrzWwMB0hdNH6zo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af300e7wSiySr1rUbiOcYedgHqt_hdAi_j5CYxtDBGi9zA&oe=69E39AD7"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lj73O4t3lIgQ7kNvwGZMaX8&_nc_oc=Adq18RDvYJyxaw67y5cIEpKoXtMmeeB4g5ukCwxYSBoN0jDO1u5itbvBQx4mQn21XYg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IP_nEh-DxjqWZJ_kKSgy0efgt6Khie1E8ZTBFPAkEcg&oe=69E38DA8"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09WGnQOgei0Q7kNvwGFPj-L&_nc_oc=AdpusQeLgyOwNSdHz8GJRI_MlTAQWY4oA-0X-2TlUbQBGCpSw9mdtCGKHzMBoSNf_BQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0n6WmmDEJyeM1e7KKZzxGgXy8Fk6bmJXj0Lpu9C-CVOA&oe=69E38F06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfZQ2rS93GwQ7kNvwEEHUBv&_nc_oc=AdqcEozEW2QrLQxVS5Zj-XzRWWk6BT8jzUxFfFR0N82do8C2LVYb5PJmnPUew1NTQJs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2J7VWP1FXsM5nJVmydnT0mJj_6DpZ4SPHrzJVvnkLkcw&oe=69E374C3"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oc
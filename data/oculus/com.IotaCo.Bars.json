": "319755241190061", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974669_319755244523394_9165807040462637955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnpT3VMq9twQ7kNvwFy3FXG&_nc_oc=Ado8-QIzh7WJZ3aExbrtCf9j4Juzqj-B0PSf5dL1ygp6oNMWW6MHmOtkLNlJbFQ9CG8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LYMKr0dVOn1rRhiV98d0LY3hfYGCZiX-P2ivlM-FOZQ&oe=6A0C83B3"}]}, "id": "410427738279044", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "8275721799126345", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75375751_8275721802459678_6058021830509629790_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ii5qQbH9E3gQ7kNvwGGZObc&_nc_oc=Ado6ObEOdo_5eIUS-YgqlLmUsTGPLPNSIUjzL8ksaWgSs8hw5mIs-1tFvmZZidcL1Ok&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-FMtR-ZRTUxm1C67f_kE3HJJHCKE0bbAzFtGm7G2WFg&oe=6A0C6729"}, {"file_name": "pic3.png", "id": "2767506536744558", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035400_2767506540077891_1994933407131659407_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f97BdHKbvh8Q7kNvwH7lAH9&_nc_oc=Adqn_PzYYO_El6Gbgy_nmfS3T2oPtpSKeVzKJSMT3ozvJiabfNjq-BQz_jlYVdF49rY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wdHoliHE6U6EPprLS-70jun7M4IxzI6W5fj1fF_rh5Q&oe=6A0C6261"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nh2GL4tLV-AQ7kNvwG7aGyg&_nc_oc=AdpTgAz_AlXQ-Yxp9-ZwkwRi0zvl5XiS6LndV5p95gKaZCPYWPnc63pd876-HkmWc6g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EcP7xTcWXUo7KWGPKu9bmUULviwV_X1-UEKqaKgrgRQ&oe=6A0C7957"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzhM9eXCyDoQ7kNvwE-Fugx&_nc_oc=AdpTnOLBSclA7cy-iOMXep6udstnAF2ky3shBrD-iYWz_meg4TWisdumkQvBza3J54s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ucW8ZO8XCOH5BqNkIm1AnH719AqMpV56Bk4xkQmdjmg&oe=6A0C6C28"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1LNckOl62YYQ7kNvwEjkKnx&_nc_oc=Adrv4dHBsZZKxn_5FnUSnA3UvKaKeAAbV3zH52d1I8cKjp1h_DkqM1GweC9U1VTHoXc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43uFuYEe5FNStB_wjxxmM8fLXzG09_FT7NP_Ppbpvjkg&oe=6A0C6D86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4jfS8FkFj8Q7kNvwHVtBUR&_nc_oc=AdqbdxxpXI6bBNYrAEfwnj81t1-UvdxTlJrBeileLn6LFxc_Sbo4zQ0mJWJ_tBdtFXU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_3FZ-Bf-EAhyIykNr3rfcb2cMDMD9_qfM_HJ13X41ug&oe=6A0C5343"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "840880844612955"}]}, "baseline_offer": {"id": "840880844612955"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1725033660, "status": "PUBLISHED", "id": "840880844612955"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8583845591627462", "version": "0.2"}, "id": "1196272561519604", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8162465477098811", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8583845591627462"}, "release_status": "RELEASED"}, "binary_release_channels": {"nod
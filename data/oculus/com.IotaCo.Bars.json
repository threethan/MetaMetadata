8fKrY_lu_oy9A4qTd1uyDIo1g&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzH04Rg2kmpOk-Ahwo0pslJniCjrAc0m_zoWpFH_ARIQ&oe=6A8EE6E1"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLN78s8o-oYQ7kNvwEG89z0&_nc_oc=AdostusSxefyyMdRpG69onP8LUpWNU9mVtcoTDwAjZaMsSvPtpThNV0Ir-yZYd0pv6c&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzTOsO_RRyd5Db8iyKr77aJhCxgBFxWOV2R-myuWdudg&oe=6A8EC597"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7vJEUOej9YQ7kNvwEMq6Ok&_nc_oc=AdovJdW7vQNgVwhsrwZSnrz2upONWORmdf7xDT-qfOZAUQUMBWioeUPFEidKgiDC1LU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQED0pB5xNCLTjaFhRNcJOvA8oA5wZkcxqwiG_oGMYQaNA&oe=6A8EF0A8"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEw-LAp5uZwQ7kNvwECkg1Q&_nc_oc=AdrxVvtYM_Q8-r2lZ10OfrQgGOS7icQo36s6Yvd0Xqt8TxX7hYSdOG9aZz-93oEN-lI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8sRiMdpmJqWeyyDFKgb2GN58oUT7netV6dlJgmBkKTg&oe=6A8EF206"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5euuXrXsb0Q7kNvwG182fP&_nc_oc=AdpwmR_4lflCte0MYujDxHyPTdKcntCRzDhx6wsm6F9EPTnnwTZ9eS0VgB4dnQaQZmE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfR3FU5qvcEgn4FCe9yypjLbr8qEAgJqtQ3QQsZy12zA&oe=6A8ED7C3"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://
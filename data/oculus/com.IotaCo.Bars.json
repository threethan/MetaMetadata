": "319755241190061", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974669_319755244523394_9165807040462637955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KCUfWsn-0TYQ7kNvwF4bept&_nc_oc=Adox8IRiynQsb9TP9yh8al5jzsR5SqxJjzLU9z9iTtFBqwaTEyKZaWb5Ukxv-otx7hU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRq4kgNqdXXUYHfQhQvdDxJogoqTPOLpyPRsHRzwU6vw&oe=6AF9D1B3"}]}, "id": "410427738279044", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "8275721799126345", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75375751_8275721802459678_6058021830509629790_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1EYGRcUqpXEQ7kNvwHi7K8l&_nc_oc=AdqycxaUMiQtL6wZ7jzFNdiKvkYrOkWajnfIadWH-xI5z9UZBcQBjZOmv3rgy9Coq3Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0BM4g92AirFNev8PUUr8EV9XGZXGfqabXdA8s3CfBoQ&oe=6AF9ED69"}, {"file_name": "pic3.png", "id": "2767506536744558", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035400_2767506540077891_1994933407131659407_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBfx-kHWtp8Q7kNvwFAfQks&_nc_oc=Adrt7pHLsqo_X7vX0OIm1tk-GFJDOxUj9-vl6MfWqArT-XrR1uFaCOuFP0D1ZjVJfx4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrVKCP6RURT_0hSBxky0CASXaUyZ7quHHBbnUMxJZsHg&oe=6AF9E8A1"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMi7XyTqMfwQ7kNvwHmp3o4&_nc_oc=AdpV3S4k5R_cj-06Qo_3ucJmwShcqNpvctUv4qNw4mD9JuMMSW2IhTB-0-_KW7SAlIo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp2EPbtZ_PDUV_Q0bL_Gp7CI2SFtRnX9llL2kbOnha3A&oe=6AF9C757"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSM4aflwkcgQ7kNvwG9U4OY&_nc_oc=AdrDf7drE2QOn7k_Q7n1fy-FWGIrNeoxE47efBnPTZNcRqaG-bXCV3AOAi-xv-mSrUw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKvbks_zkr6lixPH1Dz2Ipn7O-4LJl4DRMyfMhBK8NPQ&oe=6AF9BA28"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ConAT4_rOBQQ7kNvwFVVGS3&_nc_oc=Adr6LHe5k-I_Glg_lEX4f1St5Z5qPxZkvUkP1OGxz9QKQj25scM8d2nRGMR9gckvVpw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQysb-o6ZxflGJwLcxec9duIT1MUr4CWkQMGN4pmOnm-g&oe=6AF9BB86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQEOMK3gZZAQ7kNvwFMHcB6&_nc_oc=Adq78npXZoOKeua9ec2cUE3YSYLx1xqMplIb6xeew4e0ucJmUjnmt_GBNSnPjJmJLIg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjprb6n_rKAEStoOVPa2ikpsAJIbPB6LYpwwBOfcYFQw&oe=6AF9D983"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "840880844612955"}]}, "baseline_offer": {"id": "840880844612955"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1725033660, "status": "PUBLISHED", "id": "840880844612955"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8583845591627462", "version": "0.2"}, "id": "1196272561519604", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8162465477098811", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8583845591627462"}, "release_status": "RELEASED"}, "binary_release_channels": {"nod
l2yot4pgh6v0C5zjY5vE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uXkQtnNkJgf6BheSb-NWeDU7Yvhpv1g0ntjK01FnaDA&oe=6A22CBE1"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzqNL_QDNUAQ7kNvwEepYTZ&_nc_oc=Adr8MsIj926UCEK76bcGKJjptpSavg6vWgbmRBHchZiR8_w_XuY-1ZM7XMmmXnK2SZA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mmeVcoCphRMTJ2rGCv9ZhdLZuVDDYSnyIDInqdiF2gw&oe=6A22E2D7"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVs_Ybs8sKkQ7kNvwE9HAM1&_nc_oc=Adoj1vDpqkoPSPxYw7acS4oieWhO_dPFdyFJwdVoNJ94tgveinizI2dFHE0OhPbsPiw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VMGLHB2nanta4ap-P3PhCCWvwyzorAUkCLZSyJoHNVg&oe=6A22D5A8"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAYG9nQtnvkQ7kNvwFiEuoS&_nc_oc=Adq6n1agGYH5NSSRC61NUpFjeyR6lv2e0tjkll2fp9NZpCzBB-vPAp3VP1oNvJqmCi8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HIw7Q4IWAYaR9aMlWsQS1H_qu67cFuoM3cwyAS1Mhqg&oe=6A22D706"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ic6Lis7pMmgQ7kNvwEzD44s&_nc_oc=AdrA3Tgqtc8YTAfPKRmK4IuM_bIpTcikmlG2NdHs-UDDu3j9c1VGvx2UAZEHgzOaSBw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9peJaCJLL0AhySzqgdgj3zKfKauQmmkDxVtgsN1sjYqA&oe=6A22F503"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent
": "319755241190061", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974669_319755244523394_9165807040462637955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3TV-a3_IdQQ7kNvwG6y2ce&_nc_oc=AdqPU9DeHMQPRtJU0ZTMNuBPzKFJT778l0YHIk740Hf4eos1ylU83dY1hmEloXQm-Zw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTr4uJfrs5qn9aHjTPHrMgrLC9ZGe40HpF9_XJSQEZLQ&oe=6AC272B3"}]}, "id": "410427738279044", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "8275721799126345", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75375751_8275721802459678_6058021830509629790_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFKeZD1LkukQ7kNvwHw6DpR&_nc_oc=AdrmlD4oOmbpCsSg2Q8hmfNEnm3suhh6VrUlDR92zX5G9dy3QMLR5fAYHMnb6QteTzA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPucdl7b-agRJsBigYmspvSuarl1r9UemdAwdE4G3mLyg&oe=6AC25629"}, {"file_name": "pic3.png", "id": "2767506536744558", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035400_2767506540077891_1994933407131659407_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFvBNifDY08Q7kNvwFgUfwZ&_nc_oc=AdoQSmlQR98v8zgKzXLOa946kx3uBCQNSlomMplwJYACCoy5kk6tkUhXqvx-vj26jD4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcv95VV2V4At_Aks4XJdQWWJvZtAUO6D9i4Lp8YVJutw&oe=6AC25161"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoWJpCPijFoQ7kNvwF1LWQv&_nc_oc=AdqyyGtTPz-XD2PqSpPXVate4sWIi11q6QUj8vmYXeQ_b7MVfR3Sy5xvNAKcAsjehOo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAkhewAKvLsEALQCK1o0Vp_YO1Q1M4HDUQ58ucb8hA5A&oe=6AC26857"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nqps06cNKD8Q7kNvwGPqEXX&_nc_oc=AdrvPEVui3IdLbwpBbukvnQUZZS0jwrCub9Y0JfiGIwnOQUxE_bMXtCVPzmOPUbKbGk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0k7ZLCE1a4rRrHwQJhuyk2Va8o2UMxsZww2ojEOip7Q&oe=6AC25B28"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9gap25pjucQ7kNvwGuEbrG&_nc_oc=AdpaxZTVYUQL4nyS8wAl6dgsZxtjbsak8m-Mj4CEYC-lZOU4sqAnF9OFqwRfvFJC-8Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3JgNCYGWTaEbTuFTBfPo9uokXaQDzpmS40OmYWB2cmw&oe=6AC25C86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIK5gugwoIAQ7kNvwGFdqfK&_nc_oc=Adqzg_rGsl27L6s5ckB5GpZwhTbf1_bJKh16Jjf4uFPxubWnX-qhu4OJjDmzwCR3Qrg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFoJpWmeVazyQ6Gt8onfrv8lvwfHqsJmDkUTxRbavHOA&oe=6AC27A83"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "840880844612955"}]}, "baseline_offer": {"id": "840880844612955"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1725033660, "status": "PUBLISHED", "id": "840880844612955"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8583845591627462", "version": "0.2"}, "id": "1196272561519604", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8162465477098811", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8583845591627462"}, "release_status": "RELEASED"}, "binary_release_channels": {"nod
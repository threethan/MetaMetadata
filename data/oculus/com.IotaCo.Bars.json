sgoKjS4vkE8oM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzhOwlQMw1dagJGdz5gMfsNEHusq9T4HyQNiIcraMP_1w&oe=69C7D461"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zR3usCt-zG4Q7kNvwGqIso_&_nc_oc=Adoss5yibLBRCJGK0uY3s9WzGltz3zGSKXt_4oB50LvWL8oae6cnGH6Tm5smLK9pzOY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyf3KR-5z9N4DBbbG6GVlhqlpp6mAYUoMq9StjT61tUbw&oe=69C7B317"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwRmA2iNJMoQ7kNvwFJUCJl&_nc_oc=Adoz_3v1hmZVcEQUu84MXV2dYza7N7yToTM4N_jSfo_Yk-He7KqqKqk9h1VA73WbmS8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyCG_MPCTloGHCcSRwWI0SzgXdt1mn7f2l5T4YfTbpHww&oe=69C7DE28"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7D9aGtvwsN8Q7kNvwEhjYxj&_nc_oc=AdpSnnIiEc4IJYOEKkoIK_msiFUcNm6yjbBjsox18cligfEZzINxFQlHu6PEUuMgQBw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxN1UGpBk2xQvNc5zMSI2iJ3QnaytroUlwSlhjcpQEyzQ&oe=69C7DF86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4d_BsYKIe_oQ7kNvwGA6EBb&_nc_oc=AdoGFyzyTVkg5lc_S0d0BYw047pZjYDBLXxCTsKDIwf07r7gO5eQMnpXC10B8y74sxI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyDdsEErestzgrfHSWGhcXQCrT4rR50kqymnoOQy2UPCw&oe=69C7C543"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oc
UQqkMiktVMYzk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYM_GB66WPJ6wYpxbLqLUMLV6eO0G26gUo7_Mr24l3ZQ&oe=6A86FDE1"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APKSVMiECKkQ7kNvwGdFiXk&_nc_oc=Adpv9jbtN1jfKQ1sp7K5bpuWhBsxztqdKoafmxrzH08v_gdb2-re2db2_eGTw66kkP8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESgTSr2f1_04KquZNN0dCIujTS8uvK1al9zl9X0UhPzg&oe=6A86DC97"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yK9P5SwpICIQ7kNvwEauAS9&_nc_oc=AdoqepaEF4Um8Q4U3JMgrZrgtKRs5hOl9alt-9vf-iVkYHu5KTDzPPoTMS6hj0iw_NA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqlBAcBJB4NJbWEitlDU480gtCrZ46OL36N75r-gotLA&oe=6A86CF68"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayaLdHR8AYsQ7kNvwHT8bXI&_nc_oc=AdrmVxQDRChKHiEkq3rh03xuslutdWAN7L4gyyOuLxhymrpAaAFUPSA1bfMzvun4HQU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJtp7Fqh4iyXXFcH3iCBqGbdh2Bvpl3lSGRQ6VC-s11g&oe=6A86D0C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8PXzcgvCXoQ7kNvwGotoMD&_nc_oc=Ado3JTVPm7_oyl5oeIvSBfngnZwH1nj5_lGHWX3vAA6M6dBradON7nGxofoiwaW5uG0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEU3yWx6KLzA8wN5lPSPFiwZZ3Zs1AI7fH1UdwzfT7deA&oe=6A86EEC3"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oc
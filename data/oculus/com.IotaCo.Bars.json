u_rqi2dEaQdBE&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZHb3oRSsPFNe0UalJc4I6DCYGKO0kCNZ-zmI-4H1MhA&oe=6A1056E1"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22BDCoHzvGEQ7kNvwGkeRUP&_nc_oc=Adq9F9Jncgaw0L4uhC2j2T9qUb-4dBkDKCBnIGHSnBq2mDG2ekyjz14ywujwo_GzFIE&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52lFbjocmzMA8pLXicN5lqt1s_V5tSNbnDRuj9iuh78g&oe=6A106DD7"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cdj2GO9QH8IQ7kNvwEiMCv2&_nc_oc=Adqoy3KJqihDcsS22P5ZZPlAv-JBnmGRpOyxbNbX8WkAD1xVkckz_DlOnXC-TNEPMaU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MxvuLARoHCuuZ-hMwhHQZ50T1faReePQhhoR0PnLRbA&oe=6A1060A8"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxi9vmNDTikQ7kNvwFbMuDd&_nc_oc=AdqKXIWKgzrj9r_y2IBW52NypD5Maf-XYPqKtidQNte3THBZdjGonLGpqmDh3KyEy4Q&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PJsnFRJByzJHR2y8g9MjOHvdJUmamr29fUo2a_0JF-g&oe=6A106206"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E32-42_DBGIQ7kNvwFbHt07&_nc_oc=AdotBxEUf19rd_uzyqY7FMR8ijCZfBl3ZlWI6tB6usg149_B3rgsu1BBDZGTj3NeoNc&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BG1RSbCkARUW_Wotcn4z8Egzdcn9Rwb7MZjn4_2Xnpw&oe=6A108003"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-2.oc
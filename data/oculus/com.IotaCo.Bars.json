pQURayb-3Mgdc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sJM_5uqzhpMOelwR8MIxsAujocS4uAvdNn1JhKS-GDQ&oe=6A217A61"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzqNL_QDNUAQ7kNvwGUVkQS&_nc_oc=Adpy69gznhslJhz6HFVsacFS7bTZNMQxTT-IfMMXwHJj53enlO8BCTMFO-U3U7syhcA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VMcpZ9PCbzOOm5LgsmEv0Q-iT1cSe5fwb0lYoMQbTWQ&oe=6A219157"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkZcouPw4tEQ7kNvwHlwpkb&_nc_oc=AdrZxNK2VdFNFoCFV9tCvRJEIUm1KlhsHiBOFAOO2KHO6IDfp2S9GWVD9PUNx9GvrXo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85i7voGAorTouHJIWzJMpA2JTlp1uMAuPvyLz3_RJ38w&oe=6A218428"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAYG9nQtnvkQ7kNvwE6lo9A&_nc_oc=AdpcfgIo6pY8m8YFcpCC8Pru1cAXhQs0_qIVqdRGwB3W9AuxblydWzQ40VKeMQdxiTA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ttZiucSes-lx7jkae3eDsSCRp7GHEhNV1Jv5wMXbKEg&oe=6A218586"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ic6Lis7pMmgQ7kNvwGuqfrp&_nc_oc=Adq2kYjQZ4sV8M4r9i0_I8-N8vBRzp8a5vMJvGFcSmdAYIU3Bk0u5cqufkkS28ensD0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IwdyDipgATvG3OFI39uI-LA0lGivjaKpZ4xc9YqZBkw&oe=6A21A383"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oc
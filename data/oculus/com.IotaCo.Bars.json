_s42GE4JNa7Hg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPpiZNm9OJUViuXgvpvtgS7OUZWersL8k42ZlEYN9UvQ&oe=6A974061"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6ppPSVnORAQ7kNvwGR0Tcc&_nc_oc=AdqnHblvY2PCDR0CA_dYeJYb0KIq_oFG8tKSVLv76zmOSBjMdWt9eU-kOUv3JxBJq0s&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWLxR6jU2FyAB1JC3FVIQ-UdpVkb6zlv8t6C_Dd0wHCw&oe=6A971F17"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5tKMyZ90AkQ7kNvwEz8rMi&_nc_oc=Ado1J3KhY1a1FeYxgmCvHAUezUzv9lPe0_nBX93BgadEjcY0-u7uRdRASdGdJfl3ZmA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3uHQcHLEQ2WbqUjZ03nOe3HU5Tt6upRf7bKvfo6C_TQ&oe=6A974A28"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsTq2EImOZgQ7kNvwGXHI6w&_nc_oc=Adr7yd7GY7G59E-qTHG1scunIn-J_E_OLBfBELT0ryEoEVESs_tW9Sl0UZCFYl6GzUk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0z3-VqvU_qs-hZmrChkgmrAEW1jfbXD6Y3KifsP9zWw&oe=6A974B86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLaQTp-awqAQ7kNvwGFYfQ0&_nc_oc=AdrQFxDi3Zf7ZguJ_laeKUUztLwWBczN34YQZgXHD0kGyev2KjVZ4kIenNuLH2EcaBg&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrrizK40Mi02KMYbz2BSmEirkpGLL-D0MuklXNkxo4dA&oe=6A973143"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-2.oc
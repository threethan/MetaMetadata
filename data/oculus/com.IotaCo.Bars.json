J6nXS_c3C14lE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-t41NdDqzqlyKsw76cRr6Cwnq6sSiczEywVi-PTeHWg&oe=6A9189E1"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIOZh-Nge6sQ7kNvwEc8OTI&_nc_oc=Adr8wgH658AdtIIo9pcO0dY7p1MC2eXE8zAIEHU1s6a5sITr5jEJ3tBDP96RU-p5gW4&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRW5w68yWudE__nbkPmCmv3P6lF3pKW3f128yX3CH46g&oe=6A916897"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2d_sKWJb89MQ7kNvwFoR5Yw&_nc_oc=AdqTYXo6DdfgB7_9Zrku1Ezwe42KnjVwcC_71-skcwBHmu7rrc9oAnWhgOnwoMHwR4g&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7cQ9j6XvVehuu_06W2VaIo5tFyXoIvwjM3v1cWr7Wjg&oe=6A915B68"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JyndRR8PjtIQ7kNvwFMYS4P&_nc_oc=AdpN9RexpZ9EOb8DJICw-pTH7kBqWmPF_VoHfykakqj-_TEHfRSlzTOxpQi6Ifw4Qh4&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRoz4t9aCtKvKulr_-VSJe3Kysx91F098t5bmJC6Zybg&oe=6A915CC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxyhvfIg6jkQ7kNvwFLSynl&_nc_oc=Adp5Q8DIZN5Up0CJSJro58hxDGGDBtfIKPIkwUanlOEN8ZT0HBl6cSDdeHBqOTGu7MU&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGImQKczFiGwervcVPVr3WKMqHOMmud5UNySgvvVG6lOQ&oe=6A917AC3"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-1.oc
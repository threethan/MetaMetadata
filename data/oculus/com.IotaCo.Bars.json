": "319755241190061", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974669_319755244523394_9165807040462637955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlBp3DPVoLYQ7kNvwHKNMiS&_nc_oc=AdqPx3CU6STs19HA2-kL0adyWg9ykXGQTRwtM2GrcSoitEgVBExOjec5zLxN8LlZ76s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7cutWoxAwKztnGZ_S9ctbRh9NFe912nMcHfVbEuA5RA&oe=6AE75CB3"}]}, "id": "410427738279044", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "8275721799126345", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375751_8275721802459678_6058021830509629790_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apbc5uKm4PMQ7kNvwGQMbEA&_nc_oc=AdrgFY5EhhIInE7GLmyV-Pden7YCrzDfUeeTTABvwZy4_WSoNqKqj4LHYIPf8o5KGHA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkNWSfa8O6A3XwC4Qcu9p4VTrvcMa79UgH-4R53ZQ7TQ&oe=6AE74029"}, {"file_name": "pic3.png", "id": "2767506536744558", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035400_2767506540077891_1994933407131659407_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlbE9mm1P4sQ7kNvwFcOHC-&_nc_oc=AdrpLBt5OXO-AkAekrIZDY_R2FpU0gH2Sfh-t-cBasyjZdWYdE4jYCxPCYz4yWbQnHs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaSGtS11KywJjrF5UyeJI-gVacBi7pii4tk5EJDJjRmg&oe=6AE73B61"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCcNv-zsqScQ7kNvwFVJl2e&_nc_oc=Adp8Uu04nDegedjRAiWsQa_Ff16roh5Vek05om14Ony7QV3Fh_pd77E9GiwTKtgKaWA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkCxO8oXkArChuo8hCL0ffqYmDQpTUZk_IKXr-9PiwMA&oe=6AE75257"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMcYq1KNMjQQ7kNvwGBBT6G&_nc_oc=Adq51mhwEhk3xfuOhuTWZC9-MEVUxyS9-g6PM06hmzgzA5w-QtmH4FcESfBbrWaXWYk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUCQDM-ACgy_iP4utggMymeNyyG7BXSb-jOf1qnV8baw&oe=6AE74528"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cOmILZrm_roQ7kNvwFFrHfu&_nc_oc=AdpHkLkvoI9jFiGEghaQA0apvHPyseLSyP5Hulvvl1lpICLzp8YAYNd8JRRGQ2bRLYg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSW-28Cca9iGRLLvf_5uN8r1WKlatRtykmqnBSmJZcX8g&oe=6AE74686"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3Dh9FFvueAQ7kNvwEmxdPr&_nc_oc=AdozjATxec0oSS4NRnnlcbnGqSRjSb0Uq49KB6q-BFZeYCYQromAHvgEcFaqicMBaoc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf7tLK1e2V5g27A-sZrbhJzIXgiv_sJHEu0Bhlzwh32g&oe=6AE76483"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "840880844612955"}]}, "baseline_offer": {"id": "840880844612955"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1725033660, "status": "PUBLISHED", "id": "840880844612955"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8583845591627462", "version": "0.2"}, "id": "1196272561519604", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8162465477098811", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8583845591627462"}, "release_status": "RELEASED"}, "binary_release_channels": {"nod
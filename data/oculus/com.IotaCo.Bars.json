-BtGejVBbqMog&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Q2k8OzJk6PKac7219MXAmArSMXT6GGGJPaxgIXkex9w&oe=6A1C3461"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJe0z4r-5f0Q7kNvwHMrXuL&_nc_oc=AdpYG9p5MOxf5RR22zkXjF3UnNjy7kKtnYAboityFkRkkJYq5fBPIkOOoK7qpUtl2ow&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ph5-vLLwbYxup0B9XSgkPMwPbur92COLZ9g9eAY1CBA&oe=6A1C4B57"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9WxuQdR_LAQ7kNvwGny0p_&_nc_oc=AdqzEkJQMU5E_kCFzvZo0vVhAhtMlhxe-fc418ukG1f1Yi_T-DYBk3TNFcAXBX8w6iA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pPOO7BQRwUE3lQO3hUH3Muyyf7QyIM9ZrejI3DwJGBA&oe=6A1C3E28"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8rEX4pR9eUQ7kNvwEqQPf4&_nc_oc=Adoh3ukbBtqsLFPfCI-BKaQuy7Z-JD4mgQYeEQrus6v-yLB8dbOw0KCaHy-angOsGAs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4w5LEoqlE9_rJluyaby8oi0Yt96yM27Uax-dNxWXJnhQ&oe=6A1C3F86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vBTGbBbbNUQ7kNvwE59o7F&_nc_oc=AdrFEYXr53tWgR7hm5cC5CGrI7jOdktfRVsaTd5cJF-10X6wz5oZgix6p7nnlfTBiwg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4E5mJdZaa0lsT187ZA-5Ac_PQ0pVFS-iAN2ObkO4YKOg&oe=6A1C5D83"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oc
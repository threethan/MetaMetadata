": "319755241190061", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974669_319755244523394_9165807040462637955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzaINJlvLXAQ7kNvwEm5dNW&_nc_oc=Adqc_Gi8hfa5kRPpYa0cPm4Y1jl34QpG1ufVuaBGq3x8nnrR_heevUGHhUboxMxM0KE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5AYyNb8JJXaHVectBwa0DOM2lIIydNi7vRrPrWIxeUw&oe=6A5111B3"}]}, "id": "410427738279044", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "8275721799126345", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375751_8275721802459678_6058021830509629790_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZha1gv7UboQ7kNvwE3DRP0&_nc_oc=Adok2_WAnafaoiAsrl0h0_LfBvYpKkbfroeFICPZ6_o5Go34HDmW9G93m3Qs9CF4s2Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIHvuwmcyL3zjK5HjhSZuY4yeWJ2DUV5qjCcgCFEZ-Iw&oe=6A50F529"}, {"file_name": "pic3.png", "id": "2767506536744558", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035400_2767506540077891_1994933407131659407_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXRKfbvdNV0Q7kNvwEtZaWE&_nc_oc=AdqL8xUCTpyGjiDycXlEr0SVcENFIFvfn01wCoW-Zsx8Muy4YCPqGfR8ETytytJFxRI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDibjZCVFKDCgsq2_r_7dBtHUlEITYaznSTQDCzBVLH7w&oe=6A50F061"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DK6HCih6vv0Q7kNvwEUNovD&_nc_oc=AdoJg7uf_P_re_jnVpT0lJ87r3rRnyyvCT0lP6X7speG-tHm4wGFdiYmOa8yNb0qVL8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRwLZZcweHVL-WPx80eMQmaq3v9R6-CYvTapdc4c4t-g&oe=6A510757"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pobo3EnLN1MQ7kNvwFB4xBI&_nc_oc=Adrnk1EhtAi8DUzHE3yBw2EXAgzZsPVG8Itq_PcXwUJTtsyEKPylytrEza1FtcsEsYY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgFprPTqX_NiGVjAuw_H9S9aeUsLBmCxD-EL9hYJZnow&oe=6A50FA28"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHf4xcPVBGAQ7kNvwFKtVjg&_nc_oc=AdpcaRl6zk3Q4g6Ib0Lj5aBoggxOIbncSEKXY18okJSW90nSZ7Me8k7ersgfo27TrJ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-URPJBr67F6rT2MGh-QpWk-C2z3Yn3aahFQClM_undw&oe=6A50FB86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qyrYSTBOMgQ7kNvwFdVB20&_nc_oc=Adp8X3XDtbAOsDGHegYEP5oIRtTTYGiioIhtrTCY-Yi8ZAVoJ46GcRN7o7LOkxAeCQ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6cIEG47LRn2VLwMUo6GNs9I48P1rJnHqOKiTZYEQ-Uw&oe=6A511983"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "840880844612955"}]}, "baseline_offer": {"id": "840880844612955"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1725033660, "status": "PUBLISHED", "id": "840880844612955"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8583845591627462", "version": "0.2"}, "id": "1196272561519604", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8162465477098811", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8583845591627462"}, "release_status": "RELEASED"}, "binary_release_channels": {"nod
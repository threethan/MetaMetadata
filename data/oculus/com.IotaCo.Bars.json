": "319755241190061", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974669_319755244523394_9165807040462637955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGYWERhb9OsQ7kNvwGUGxiS&_nc_oc=AdrDYHjVdVTD9hA1D0Q9muOFzIxxYUW5Onu8GAZCYb_73Zv9rHm4dCIR9oDin8kqroc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJXyd6_CVLGsjevYHw-52k02MPjnWp-GjXLRbkbPjXRQ&oe=6AC515B3"}]}, "id": "410427738279044", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "8275721799126345", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75375751_8275721802459678_6058021830509629790_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvgXJRZoSM0Q7kNvwHSL5cY&_nc_oc=AdodZ-vifmXmzkyAOXHhpLuJw-pob60PT4B8dmf4D6-YusmiA2pnDvgQdCXdT17XPz4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWLXiUicFML3fRRotG2rJmdt3VSL9HGzCdIWpZTjoKug&oe=6AC4F929"}, {"file_name": "pic3.png", "id": "2767506536744558", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035400_2767506540077891_1994933407131659407_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFvBNifDY08Q7kNvwEG8L7W&_nc_oc=AdoAqHb1uySph6IyviJqhcOXG4MQgtzkPLHMyMCvEBqfLgSgOibGZ4KCBVSFGohlH6w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrN-z_ldnUvvD78-olrKSp2m7-xRdEfNa1_jcVMRa7mA&oe=6AC4F461"}, {"file_name": "pic2.png", "id": "779229031089568", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982477_779229034422901_6541401577901282402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-P2BrkqoXqsQ7kNvwFNAJoA&_nc_oc=AdpbbJrvpVEOhKW5aVrUYhYOSaBaYMZg1C-0MH68b708nTVoq4pcqyuPBwxvzSxAhC0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmqZc7HPWTx6NRv3Bnf8cvZpjJxPayyXXIcX-WI-fBig&oe=6AC50B57"}, {"file_name": "Pasted Graphic 2.png", "id": "3748048768782135", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982451_3748048772115468_8633018979648891634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IskHizdnF8wQ7kNvwF6OC3X&_nc_oc=AdogjLL1wyvgBiHxAWtwnDF9s6GVZ9gprCHItEeq05o_iCkkEUfZgITJp9aO6BoIfBQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZ_ZkTbv2Fah1T-HmHFfcJzz81YGvSSRS54U4Q1cFuYg&oe=6AC4FE28"}, {"file_name": "pic1.png", "id": "1215126202972575", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982660_1215126206305908_7656455983350525662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dg3AGJxEJugQ7kNvwG_PL9C&_nc_oc=AdopXcBnDtYKmeJqUbseLgtOB1LMz6f2ussq32JIaHIOjNMD9BRhPYk4zyuCX4uyQHI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMihaFvf97H76kLA4sR_jldCPaHASZ_y82NknHzMBLnnA&oe=6AC4FF86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "8135831259803033", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001727_8135831263136366_2332711569767664856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vfbikegy8cAQ7kNvwFohZNq&_nc_oc=AdrZgni2bCo6UQqp0snZMmfrQVKdAm6vSeC1SLF-yuu4ftn6jpFx2nE7wD3236YeYTw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoRBfOWVxTFRa_r5UHRVGDSTdfmoMLFivGSn5r0LlsDw&oe=6AC51D83"}, "display_name": "synthesia", "keywords": [], "long_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a captivating musical puzzle game designed for VR, inspired by the fascinating phenomenon of \"synesthesia\" where senses blend and colors emerge from melodies.\nIn Synthesia, players hone their musical ear by solving a series of visually and aurally immersive puzzles. Listen to a captivating tune and then rearrange blocks representing sounds and shift notes up or down to match the melody.\nWhether you're a budding musician or simply enjoy a good brain-teaser, Synthesia provides a fun and educational experience for all.", "short_description": "Step into a world where you don\u2019t just hear the music\u2014you see it. Synthesia is a multisensory puzzle game that pairs colors and notes to train players' pitch recognition. Players solve fun puzzles while experiencing a VR simulation of the sensory phenomenon known as \"synesthesia\"."}]}, "developer_name": "Luxi Liu", "developer_privacy_policy_url": "https://luxi-liu97.github.io/synthesia_pp.html", "developer_terms_of_service_url": null, "publisher_name": "Iota Co", "support_website_url": null, "website_url": "https://luxi-liu97.github.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572254726119882"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "840880844612955"}]}, "baseline_offer": {"id": "840880844612955"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1725033660, "status": "PUBLISHED", "id": "840880844612955"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8583845591627462", "version": "0.2"}, "id": "1196272561519604", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8162465477098811", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8583845591627462"}, "release_status": "RELEASED"}, "binary_release_channels": {"nod
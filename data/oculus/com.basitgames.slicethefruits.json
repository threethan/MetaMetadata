bby_Custom..._01.01.2024_14-10-13.png", "id": "1068974937772955", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75495672_1068974941106288_5860787452886620232_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVaDWgvoLw4Q7kNvwEBCeRK&_nc_oc=AdnLhiirv69q4lI8f_k1tvsVftbmq_x6Fm92nvZEyw8mt1Ytif6-MnlyUmCIrhBGKT8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzPjCQYfBxc882P8ykT6IqV1uLpffFioWAS1yLxh1yO-w&oe=69B7E75B"}, "display_name": "Slice Fruits", "keywords": [], "long_description": "If you are looking for a game that will distract you and welcome you to the VR world, you are in the right place. \n\nA game that is suitable for all ages, will allow you to relieve stress and have fun.\n\nWithin the current version;\n- 36 different fruits to discover\n- 4 different speciality fruits with unique abilities\n- 4 objects that will make your game even more interesting and different\nSlice Fruits! is waiting for you to get the highest score!\n\nThe ideal game for simple fun!\nLet's slice some fruit with katana and beat your own score!", "short_description": "Would you like to slice some fruit?\nTry to get the highest score with the katana!\n\n- 36 different fruits\n- 4 different special fruits\n- 4 different objects \nto get higher scores by playing with it over and over again!\n\nA game that will relieve your stress, try it right now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.basit.games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "basit games", "support_website_url": null, "website_url": "https://www.basit.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "reco
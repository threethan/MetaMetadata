=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AyZpplivUQQ7kNvwGNo61V&_nc_oc=AdrzzVsPA75AO2cxKha3kP2cTWSXZc6Us14IvbiC8hxuh2l2rIKcHGCYXrQBqv7Y5fo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToyN91s9-ogMWgKWKvS44D853uW1YdpIChi0-5YUGhDQ&oe=6AFC8F9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "art_lobby_Custom..._01.01.2024_14-10-13.png", "id": "1068974937772955", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75495672_1068974941106288_5860787452886620232_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2U4mVzYFDRcQ7kNvwHIgZlg&_nc_oc=AdpoIH9k8jMgDDxAnLkh0_jkh9-OWbW1zZexRpKOhrNwX0EdUZlVjIqEXdyjBNSy0Jc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0y9MW2inDFngHGdosWdp6Rprg2OMf3LmgtEos25AG2Q&oe=6AFC709B"}, "display_name": "Slice Fruits", "keywords": [], "long_description": "If you are looking for a game that will distract you and welcome you to the VR world, you are in the right place. \n\nA game that is suitable for all ages, will allow you to relieve stress and have fun.\n\nWithin the current version;\n- 36 different fruits to discover\n- 4 different speciality fruits with unique abilities\n- 4 objects that will make your game even more interesting and different\nSlice Fruits! is waiting for you to get the highest score!\n\nThe ideal game for simple fun!\nLet's slice some fruit with katana and beat your own score!", "short_description": "Would you like to slice some fruit?\nTry to get the highest score with the katana!\n\n- 36 different fruits\n- 4 different special fruits\n- 4 different objects \nto get higher scores by playing with it over and over again!\n\nA game that will relieve your stress, try it right now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.basit.games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "basit games", "support_website_url": null, "website_url": "https://www.basit
c=xf_aFDa7syYQ7kNvwGXCp20&_nc_oc=AdlIkZWbm4twi5UfkfziYow5Oo2K0j_2M1KeV7CwDZejQsEE8qRWuF9GOUAuyfYaam4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxOjS2cZXL17v46RRG-aXwGWiPxK76RNP8E8g5jFtuIsA&oe=69B2C763"}, {"file_name": "Screenshot_20200419-193552(1).png", "id": "375556667693478", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982658_375556674360144_2803613943852729841_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVRyhUvXDJIQ7kNvwH28kBq&_nc_oc=Adkp6LUSIedvXvohRkH7Xu4jpR4D5Dx5XX2fidURcc9a6Gq3GSxxN5yqxWg_MSsJFBY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwB78n8qjUZ6ks8MleqTet-O09uoSptlPtrKZIPc3fkmA&oe=69B2C2E3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Edumersive", "keywords": [], "long_description": "With Edumersive you can experience interactive virtual reality trainings and informational videos created by your own organisation. Edumersive provides training into the palm of your hand. Repeat, educate and explore a training as many times as you like without the disadvantage of using costly training material.\n\nHow does it work?\nAfter logging in, your device will automatically download the trainings created by your organisation. From here you can start any of them without needing any additional hardware. To join a group session you don\u2019t need to do anything. You will automatically get connected to the instructor, after which they have the control of the training.\nYou can see the results of all your previous trainings from the main menu.\nFor more information visit: https://www.edumersive.nl.\n\nPlease note: To use this app you will need login details provided by your organisation.", "short_description": "Experience interactive VR trainings and videos created by your own organisation"}]}, "developer_name": "Edumersive", "developer_privacy_policy_url": "https://edumersive.nl/wp-content/uploads/2024/01/EdumersivePrivacyPolicy2024.pdf", "developer_terms_of_service_url": "htt
ng?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xk-DkMFRFVYQ7kNvwFMU2eJ&_nc_oc=AdrmpofxjWIo7SE_fLvn1wYFH1LlpArR-0g_mnYNbBJZ63GoqThyCxA3eG6gcFxafUc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0y3TtSbFNk9lm_NDJ63z2c4cFzwFcpNnn7XGKdNb7ng&oe=69C53C63"}, {"file_name": "Screenshot_20200419-193552(1).png", "id": "375556667693478", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982658_375556674360144_2803613943852729841_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17ZE-CrefYQQ7kNvwFnKONJ&_nc_oc=Adrf4hI8AyuxfNrkbCzTgvD1hdP7a4E28aQLygseiNC81ddzKS_iSnEWYgik7bmxwOU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzFF6kzy3zIdQ_lF5Hfl7QZXW-oXxhsJEETT8LRKIXIyg&oe=69C537E3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Edumersive", "keywords": [], "long_description": "With Edumersive you can experience interactive virtual reality trainings and informational videos created by your own organisation. Edumersive provides training into the palm of your hand. Repeat, educate and explore a training as many times as you like without the disadvantage of using costly training material.\n\nHow does it work?\nAfter logging in, your device will automatically download the trainings created by your organisation. From here you can start any of them without needing any additional hardware. To join a group session you don\u2019t need to do anything. You will automatically get connected to the instructor, after which they have the control of the training.\nYou can see the results of all your previous trainings from the main menu.\nFor more information visit: https://www.edumersive.nl.\n\nPlease note: To use this app you will need login details provided by your organisation.", "short_description": "Experience interactive VR trainings and videos created by your own organisation"}]}, "developer_name": "Edumersive", "developer_privacy_policy_url": "https://edumersive.nl/wp-content/uploads/2024/01/EdumersivePrivacyPolicy2024.pdf", "developer_terms_of_service_url": "https://edumersive.nl/wp-content/uploads/2020/02/2020-Edumersive-End-User-License-Agreement.pdf", "publisher_name": "Edumersive", "support_website_url": null, "website_url": "https://www.edumersive.nl/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "434961926215971"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EDUCATIONAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "6908348042605671"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "814446781147200"}, {"status": "PUBLISHED", "id": "737099521680884"}]}, "baseline_offer": {"id": "814446781147200"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1757598300, "status": "PUBLISHED", "id": "814446781147200"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24680957584918110", "version": "0.37.0"}, "id": "1709788836078894", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4384978951609272", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24680957584918110"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": 
c=xf_aFDa7syYQ7kNvwF6piPG&_nc_oc=AdlX_ay25oJULePzo5Uoi7bX0wJT9M0EVlV0cUm501sAPDXnUxk0lF1XkpBM6K0tQj8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxwgnNYH-Nbjwf4ZgOaOAGu8zmdt6GvdOfl8HVCmoo58A&oe=69B175E3"}, {"file_name": "Screenshot_20200419-193552(1).png", "id": "375556667693478", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982658_375556674360144_2803613943852729841_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVRyhUvXDJIQ7kNvwEhT7gd&_nc_oc=AdmthEQDjoeYUp0W3f8p2uJxS0r7CtphoEj30vMlWsaRkifKT0uE_a1IVKU5MYVpgYE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzUCnntOVjrxY8DTAGMZi5Hw3p-GNW-uEWUp89MpKJu3Q&oe=69B17163"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Edumersive", "keywords": [], "long_description": "With Edumersive you can experience interactive virtual reality trainings and informational videos created by your own organisation. Edumersive provides training into the palm of your hand. Repeat, educate and explore a training as many times as you like without the disadvantage of using costly training material.\n\nHow does it work?\nAfter logging in, your device will automatically download the trainings created by your organisation. From here you can start any of them without needing any additional hardware. To join a group session you don\u2019t need to do anything. You will automatically get connected to the instructor, after which they have the control of the training.\nYou can see the results of all your previous trainings from the main menu.\nFor more information visit: https://www.edumersive.nl.\n\nPlease note: To use this app you will need login details provided by your organisation.", "short_description": "Experience interactive VR trainings and videos created by your own organisation"}]}, "developer_name": "Edumersive", "developer_privacy_policy_url": "https://edumersive.nl/wp-content/uploads/2024/01/EdumersivePrivacyPolicy2024.pdf", "developer_terms_of_service_url": "htt
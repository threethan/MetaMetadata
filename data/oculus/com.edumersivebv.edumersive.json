c=cbOpa4W4sAEQ7kNvwFyDVBa&_nc_oc=AdlfR1CLr-M4iSf31lqnpaCanPSRecLgbaEmoRZcJQsWXBOYs9rieU91SUwmJ4MahrA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwQYQabsnGLRSfSHT0rmDE4jnnVhFQMZ--5PC8SIEnu-Q&oe=69B56A63"}, {"file_name": "Screenshot_20200419-193552(1).png", "id": "375556667693478", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982658_375556674360144_2803613943852729841_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fp_W3cWatcQ7kNvwFsLxdJ&_nc_oc=AdmvxTWEVZklkDKIuJ3gV0MLhhV99IzfHYKWZAnDmRfWrUwBHJtBgMS8-hngO-leI_M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyt27vjzZ34VN0Poz30nHd4VkQWWukvi24_rqQ91QJwPw&oe=69B565E3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Edumersive", "keywords": [], "long_description": "With Edumersive you can experience interactive virtual reality trainings and informational videos created by your own organisation. Edumersive provides training into the palm of your hand. Repeat, educate and explore a training as many times as you like without the disadvantage of using costly training material.\n\nHow does it work?\nAfter logging in, your device will automatically download the trainings created by your organisation. From here you can start any of them without needing any additional hardware. To join a group session you don\u2019t need to do anything. You will automatically get connected to the instructor, after which they have the control of the training.\nYou can see the results of all your previous trainings from the main menu.\nFor more information visit: https://www.edumersive.nl.\n\nPlease note: To use this app you will need login details provided by your organisation.", "short_description": "Experience interactive VR trainings and videos created by your own organisation"}]}, "developer_name": "Edumersive", "developer_privacy_policy_url": "https://edumersive.nl/wp-content/uploads/2024/01/EdumersivePrivacyPolicy2024.pdf", "developer_terms_of_service_url": "htt
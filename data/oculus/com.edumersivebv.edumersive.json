c=Bcfyatt48ZEQ7kNvwG1dHvo&_nc_oc=Admlk6rNl_uZau-IsCeCf4SlIxKUYcDovK1oEVQcBrkDKVIOeKxYRft3ra8gT4XDGAo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxYhr5t6A8OgE2HKg6KYENgBGbRq_kg23RyFxe8vjK5-Q&oe=69B95EE3"}, {"file_name": "Screenshot_20200419-193552(1).png", "id": "375556667693478", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982658_375556674360144_2803613943852729841_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzFBCBGXnRMQ7kNvwFGr-mb&_nc_oc=AdkQYNPwZ-GQ3nKm8b3VAY7utwiTRUTq7-gVDspafwFNFq46ha2Ka6LValHCby2VxK0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxGQn_yQnJQ52Z4DBH5HCYYQjmEtcPIiBzxgNbCk0v72g&oe=69B95A63"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Edumersive", "keywords": [], "long_description": "With Edumersive you can experience interactive virtual reality trainings and informational videos created by your own organisation. Edumersive provides training into the palm of your hand. Repeat, educate and explore a training as many times as you like without the disadvantage of using costly training material.\n\nHow does it work?\nAfter logging in, your device will automatically download the trainings created by your organisation. From here you can start any of them without needing any additional hardware. To join a group session you don\u2019t need to do anything. You will automatically get connected to the instructor, after which they have the control of the training.\nYou can see the results of all your previous trainings from the main menu.\nFor more information visit: https://www.edumersive.nl.\n\nPlease note: To use this app you will need login details provided by your organisation.", "short_description": "Experience interactive VR trainings and videos created by your own organisation"}]}, "developer_name": "Edumersive", "developer_privacy_policy_url": "https://edumersive.nl/wp-content/uploads/2024/01/EdumersivePrivacyPolicy2024.pdf", "developer_terms_of_service_url": "htt
c=GhqDkh0UTuMQ7kNvwHJWF9W&_nc_oc=AdpaEHk8BT7w5iqGUnUXSYmZ5GWDydYetb0MS4Ht-zXnq0H31OLSYym0VItxikyC-ro&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVudgp0t93X9sMfXZkYgEIIhQF1jH1P2fyljlaZ0ChhQ&oe=69C147E3"}, {"file_name": "Screenshot_20200419-193552(1).png", "id": "375556667693478", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982658_375556674360144_2803613943852729841_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9376OIX4LAQ7kNvwH_dTnT&_nc_oc=AdpnDZeboRSoB9zsSN66GLWXDSF3QIJS7Nw_pu6epXNsFQLqhVhhfJUc05dsfvrAZ6s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy7bfp9LeXI9tVFxnnsM_ep8OqJu2mc_JAw6qeb5klRbg&oe=69C14363"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Edumersive", "keywords": [], "long_description": "With Edumersive you can experience interactive virtual reality trainings and informational videos created by your own organisation. Edumersive provides training into the palm of your hand. Repeat, educate and explore a training as many times as you like without the disadvantage of using costly training material.\n\nHow does it work?\nAfter logging in, your device will automatically download the trainings created by your organisation. From here you can start any of them without needing any additional hardware. To join a group session you don\u2019t need to do anything. You will automatically get connected to the instructor, after which they have the control of the training.\nYou can see the results of all your previous trainings from the main menu.\nFor more information visit: https://www.edumersive.nl.\n\nPlease note: To use this app you will need login details provided by your organisation.", "short_description": "Experience interactive VR trainings and videos created by your own organisation"}]}, "developer_name": "Edumersive", "developer_privacy_policy_url": "https://edumersive.nl/wp-content/uploads/2024/01/EdumersivePrivacyPolicy2024.pdf", "developer_terms_of_service_url": "htt
c=tgFYO0M36CYQ7kNvwHEVEBk&_nc_oc=AdmJ0-lQMlbUx8IBwYKOy31S_2nltRPxUBkdBKSYCNbEbFxyMCLS7nK879EXZ0ivIBk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzzJm1oD2rLvPCjgC0SIv4nUAKQoOVo9gF2qf1khsj6dQ&oe=69AC2FE3"}, {"file_name": "Screenshot_20200419-193552(1).png", "id": "375556667693478", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982658_375556674360144_2803613943852729841_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsjeU4hQw5EQ7kNvwHdaptr&_nc_oc=AdlR9q-C14KgYFol-89uFDz0j5tUTBKBEEE6UVI0zqmPono5KfdPSMAzbibic8Oe3TI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwJAB6n3ma95bV8LQy1MS-W6qsL1pWAr3KbYAUqkvAobg&oe=69AC2B63"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Edumersive", "keywords": [], "long_description": "With Edumersive you can experience interactive virtual reality trainings and informational videos created by your own organisation. Edumersive provides training into the palm of your hand. Repeat, educate and explore a training as many times as you like without the disadvantage of using costly training material.\n\nHow does it work?\nAfter logging in, your device will automatically download the trainings created by your organisation. From here you can start any of them without needing any additional hardware. To join a group session you don\u2019t need to do anything. You will automatically get connected to the instructor, after which they have the control of the training.\nYou can see the results of all your previous trainings from the main menu.\nFor more information visit: https://www.edumersive.nl.\n\nPlease note: To use this app you will need login details provided by your organisation.", "short_description": "Experience interactive VR trainings and videos created by your own organisation"}]}, "developer_name": "Edumersive", "developer_privacy_policy_url": "https://edumersive.nl/wp-content/uploads/2024/01/EdumersivePrivacyPolicy2024.pdf", "developer_terms_of_service_url": "htt
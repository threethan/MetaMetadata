c_sid=6e7a0a&_nc_ohc=0bPpD5rxAnEQ7kNvwF4mciO&_nc_oc=AdqJnEy3zJ8RjqOZt3coyCGfNZy1cl3MoR26mISg2UspqEWWE3QbmiSP9EChi5CQIrY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-3q1ROqaEGk6FNaV4hEhP3tLEqD-SjeLCPxpCrHRUPw&oe=6AFF0C3E"}, {"file_name": "Screenshot_5.png", "id": "729935182888825", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618274_729935186222158_899722612454295584_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0-zbgBYYPEQ7kNvwHt6mxY&_nc_oc=AdpDLDQHEC4Du_wqV9I0klX4bq7vv3HBGOK9dHRIEBeIIXCcLD4D7Giw4sdWervbpKU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDBQ3qQvOqZ16GEZqJV2BBbhDQP5uQpioywx2mgxRabg&oe=6AFF24EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Revive Tag V2", "keywords": [], "long_description": "Revive Tag V2 is a high-intensity VR multiplayer experience that takes the classic game of tag and amps it up with futuristic arenas, fast-paced action, and a unique revival mechanic. Dive into immersive environments where speed, strategy, and teamwork are your greatest assets.\n\nIn Revive Tag V2, players are split into teams and must chase, tag, and outmaneuver their opponents while reviving downed teammates to stay in the fight. Every match is a test of reflexes and coordination, with fluid movement, precise VR mechanics, and dynamic maps that keep the action fresh and exhilarating.\n\nWhether you're dodging enemy players in close quarters or pulling off clutch revives under pressure, every moment is packed with adrenaline. Designed specifically for virtual reality, the game delivers an intense, physical experience that rewards communication, timing, and sharp instincts.", "short_description": "Revive Tag V2 is an adrenaline-pumping VR multiplayer game where players race, tag, and revive teammates in fast-paced, high-energy arenas. With immersive environments and intense gameplay, strategy and teamwork are key to staying in the game and dominating your opponents."}]}, "developer_name": "t4apz", "developer_privacy_policy_url": "https://sites.google.com/view/revivetagv2/home", "developer_terms_of_service_url": null, "publisher_name": "Bigboithebiggest", "support_website_url": null, "website_url": "https://sites.google.com/view/revive-tag-v2-the-website/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23891386873883038"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23915336564821402", "version": "1.1.35"}, "id": "1061690042593309", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23891386863883039", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "23915336564821402"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1061690042593309"}]}, "change_log": null, "created_date": 1749430443, "id": "23915336564821402", "version": "1.1.35", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED", "binary_test
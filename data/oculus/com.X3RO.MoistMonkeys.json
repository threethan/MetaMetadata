fZP3Ol175g&oe=6A917D6E"}, {"file_name": "Shiny_Gorillas_Picture.png", "id": "1351686349869078", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/499310734_1351686353202411_5908252890643326534_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NS2lznZetIQ7kNvwELCQQ0&_nc_oc=Adp7enngFjj7tMshVmvbWRrLdRvIbdHBigqCkakcfaCqN886uuv3wR-XvQD6gOSVUfg&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVEiwXeVtunQYm-2OS8Rc211s5Dbqh8Xiwwrd1t8JTWA&oe=6A917E73"}, {"file_name": "Shiny_Gorillassss.png", "id": "2657510754705066", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499299132_2657510758038399_7439859499735819322_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIoBuT6MgyEQ7kNvwF0iQlf&_nc_oc=AdpqjEem6wndi9HaIizsfRkArvXjKLWpvlGrIpNGoeScmMjFOjTacAfa_PhilW_Bq_0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELIGvH6m1Mw812MPC7hHv-djrrQVlKib9w26yWZHEG5Q&oe=6A9181FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Moist Monkeys", "keywords": ["Fangame", "MoistMonkeys", "Competitive", "Fun", "Social"], "long_description": "Moist Monkeys is a fast-paced, community-driven VR game featuring skill-based locomotion, competitive gameplay, and nonstop action. Master movement mechanics by running, jumping, climbing, and launching yourself across unique environments using only your hands. Every match rewards practice, precision, and quick decision-making as you chase opponents or evade capture.\n\nExplore a variety of custom-designed maps, each offering new routes, shortcuts, and challenges that encourage creative movement and different playstyles. Whether you're competing with friends or joining public lobbies, every game is packed with exciting moments, close escapes, and intense tag battles.\n\nMoist Monkeys is designed for players who enjoy improving their movement skills, learning advanced techniques, and competing in a fun, social VR experience. With smooth locomotion, engaging multiplayer gameplay, and a growing collection of content, there's always a new challenge waiting.\n\nWhether you're looking to sharpen your movement, dominate the competition, or simply have fun with friends, Moist Monkeys delivers an energetic and rewarding multiplayer VR experience that keeps players coming back for more.\n", "short_description": "Moist Monkeys is a fast-paced fan game where players run, jump, and climb using skill-based movement to outmaneuver opponents. Featuring custom maps and exciting tag-style gameplay, Moist Monkeys delivers competitive fun and high-energy action for players who love mastering advanced movement mechanics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lqHVluCfF2F2dRHNZ2sUBUV0tqGAb_DGwmUZitoTBaY/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "X3RO", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1lqHVluCfF2F2dRHNZ2sUBUV0tqGAb_DGwmUZitoTBaY/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "MULTI_USER"], "id": "1222654864266074"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499618271_2972760536400194_3888652833875007845_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clHeb27q9vsQ7kNvwEf
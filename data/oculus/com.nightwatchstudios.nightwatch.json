100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMO_vXE64zgQ7kNvwEk33RN&_nc_oc=AdrUPrcUAKgMTUuLEs1q3LgowmCiWsbGSHgpAga5f1pPcXDd9HEwvaF0YF07kWZTlk8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9t5NfyYO0H6pVoYQunf3ODe8G-ehnt5Iui_zrEYUe8A&oe=6AF74960"}, {"file_name": "807889716_38929377459986828_5426513958794163717_n.png", "id": "2738063406610347", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825345_2738063413277013_3314004231298844182_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IcOW7CUhi_YQ7kNvwG-L0HT&_nc_oc=AdpCBT_KkLKrl6wWgNuxTFbYRoaWUtjPuCojelX-6Rr1p5bPidpxVgJGiGLl-0e_6qs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQW7yJXd8pBx-mTE4f1heJFpOMvBw1GeR75i518Bu_oQ&oe=6AF747B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage (2).png", "id": "1387105016949716", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823812_1387105026949715_4137145136325094142_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFaw_q29NXEQ7kNvwHIfH1I&_nc_oc=AdoRWKTayCGWUG2z2NdJlgoPUWcUfbCZ7OudB5_AgoEYYnqilbz4O068NGgJXhPWNcY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnyvLb3fu8GCJkH3LnU6EYKIg4Vf4wJtuNrtFzkOwPiA&oe=6AF73C19"}, "display_name": "NightWatchVR", "keywords": ["horror", "scary", "free", "fun"], "long_description": "NightWatchVR\nYou are standing alone on top of an exposed watchtower, the freezing wind howling around you, and the stakes couldn't be simpler: protect the tower at all costs. Down below, the terrain is pitch-black, and your only tools are your bare hands\u2014which double as your lifeline and your flashlight.\n\nNightWatchVR is an intense, minimalist survival horror game built from the ground up for standalone VR by Harvey Clarke. There are no walls to hide behind, no complicated weapon mechanics, and no escape. The catch? The things climbing up out of the dark toward your platform are terrifying, relentless living beans, and every sweep of your light is the only thing keeping them from breaching the top.\n\nKey Features\nFlashlight Hands: Use your own hands to aim your beam into the abyss, sweeping the shadows to catch the creeping horrors before they scale the tower.\n\nExposed Atmosphere: Designed for standalone headsets with sweeping open-air spatial audio, deep blacks, and pure, unfiltered dread.\n\nPure Survival Horror: No weapons, no walls, and zero clutter. Rely entirely on your nerves, your reflexes, and your wits to survive the shift until dawn.\n\nMinimalist Design: Drop straight into the nightmare with fast-paced, high-stakes arcade horror mechanics.\n\nCan you manage the watch, keep your hands steady on the beam, and stop the beans from reaching the platform, or will you be dragged down into the dark?", "short_description": "A minimalist horror game where the monsters are beans and your hands are a flashlight. Shine your torch at the creeping beans and don't let them reach the tower!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nightwatchvr/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/nightwatchvr/terms-of-service", "publisher_name": "Harvey Clarke", "support_website_url": null, "website_url": "https://sites.google.com/view/nightwatchvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "
nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsTU8yY796TXbzBM0qLJhjwql9GmPoJk8IlDAeZoKjlig&oe=69A046A7"}, {"file_name": "screenshot_2.png", "id": "2490817431124202", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391917_2490817434457535_854449377750457478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHfw0xWM3tsQ7kNvwGn2a5v&_nc_oc=Adn8-FqkCdZCzWcIF8hoxP2EuSBs2lCYushxqWt1jL9aFXNRWkzvdOvYiSRy-ct-HBE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvlm0rsJb8ycQFcy4M4dm487zaqTZFJOvIAEBbmqJiu3w&oe=69A027C1"}, {"file_name": "screenshot_4.png", "id": "1034560715114319", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391969_1034560718447652_5037507946192597927_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icQIIP3roQkQ7kNvwFQOqws&_nc_oc=AdlywcJAsKZRoao7ks2AA_OTGJJGL4oK-nr2OrULCkMx07jYCfVuicOaSkR1IUInURQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftVACOACKjWHR7II9li-6Ciq_MkK6GHUzQj7ysyPi_eow&oe=69A0479D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Intro to Aviation", "keywords": [], "long_description": "Welcome to Xennial\u2019s VR Intro to Aviation Program. This comprehensive training simulator offers four essential modules for Schools of Aviation that are looking to provide critical tools for future aviation maintenance technicians to create a solid knowledge base of key aircraft systems. This product includes the following four modules: 1) Cessna 172 Aircraft Familiarization; 2) Cessna 172 Pre-Flight Check; 3) Cessna 172 General Visual Inspection (GVI); 4) Aviation Careers Exploration.  \n \nThis version is specifically designed for institutions that require a campus-wide implementation. It is secured with a passcode provided through Xennial\u2019s XR Platform.\n\n*** IMPORTANT NOTE:  A LICENSE IS REQUIRED TO ACCESS THIS APP AND CAN ONLY BE ACQUIRED DIRECTLY THROUGH XENNIAL OR ONE OF ITS DISTRIBUTION PARTNERS. \nTO LEARN MORE: XENNIAL@XENNIALDIGITAL.COM ***\n\n", "short_description": "Xennial\u2019s VR Intro to Aviation Program is a comprehensive training simulator with four essential modules for Schools of Aviation looking to provide critical tools for aircraft maintenance technicians. It includes four modules: 1) Cessna 172 Aircraft Familiarization; 2) Cessna 172 Pre-Flight Check 3) Cessna 172 General Visual Inspection (GVI); 4) Aviation Careers Exploration. This version is specifically designed for institutions that require a campus-wide implementation. \n"}]}, "developer_name": "Xennial", "developer_privacy_policy_url": "https://www.xennialdigital.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Xennial", "support_website_url": null, "website_url": "https://www.xennialdigital.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8485988901431707"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1429124115225437"}, {"status": "PUBLISHED", "id": "1192494909637425"}, {"status": "PUBLISHED", "id": "1182550190012164"}, {"status": "PUBLISHED", "id": "745338331633255"}, {"status": "PUBLISHED", "id": "1175141591113691"}, {"status": "PUBLISHED", "id": "2327517580998335"}, {"status": "PUBLISHED", "id": "933141822282442"}]}, "baseline_offer": {"id": "1429124115225437"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768599960, "status": "PUBLISHED", "id": "142912411522
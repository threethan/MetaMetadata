_UpP&_nc_oc=AdkKzC9lGTOXe2OJBsXYMc4qR-m5J33ePHw_F8b4RlLfX7EfX0lyaQe9zo1qvB_XFMY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwfooX_C8B5WbPFmvaGiSKiTRgLQBv_JFzxxNwZxVd3BQ&oe=69BD47A7"}, {"file_name": "screenshot_2.png", "id": "2490817431124202", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391917_2490817434457535_854449377750457478_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nws34J5kE9sQ7kNvwHZbP2p&_nc_oc=AdkUGawxNfShd8CjauRWkX0hAE41dKB6mJDsJhJEO_yIatWw1J_vBSuYXIpjlfvTeXE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-Fqo1H3UlVAm4GBgPBPVo_-H7hPZ6GvCRSq1qadkKQg&oe=69BD6101"}, {"file_name": "screenshot_4.png", "id": "1034560715114319", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391969_1034560718447652_5037507946192597927_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8LrKjJIkn4Q7kNvwGszCle&_nc_oc=AdlddEKuaesqS_x6FhtxZvopKaYh7W4U1pdWJbVdoGaJFpUKkt_QPvpHTLnRrHprQ8M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzWLxqIpK-NVnnq68kC4Q9lcnt5fRiEaRWKL6PV1vjg1A&oe=69BD489D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Intro to Aviation", "keywords": [], "long_description": "Welcome to Xennial\u2019s VR Intro to Aviation Program. This comprehensive training simulator offers four essential modules for Schools of Aviation that are looking to provide critical tools for future aviation maintenance technicians to create a solid knowledge base of key aircraft systems. This product includes the following four modules: 1) Cessna 172 Aircraft Familiarization; 2) Cessna 172 Pre-Flight Check; 3) Cessna 172 General Visual Inspection (GVI); 4) Aviation Careers Exploration.  \n \nThis version is specifically designed for institutions that require a campus-wide implementation. It is secured with a passcode provided through Xennial\u2019s XR Platform.\n\n*** IMPORTANT NOTE:  A LICENSE IS REQUIRED TO ACCESS THIS APP AND CAN ONLY BE ACQUIRED DIRECTLY THROUGH XENNIAL OR ONE OF ITS DISTRIBUTION PARTNERS. \nTO LEARN MORE: XENNIAL@XENNIALDIGITAL.COM ***\n\n", "short_description": "Xennial\u2019s VR Intro to Aviation Program is a comprehensive training simulator with four essential modules for Schools of Aviation looking to provide critical tools for aircraft maintenance technicians. It includes four modules: 1) Cessna 172 Aircraft Familiarization; 2) Cessna 172 Pre-Flight Check 3) Cessna 172 General Visual Inspection (GVI); 4) Aviation Careers Exploration. This version is specifically designed for institutions that require a campus-wide implementation. \n"}]}, "developer_name": "Xennial", "developer_privacy_policy_url": "https://www.xennialdigital.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Xennial", "support_website_url": null, "website_url": "https://www.xennialdigital.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8485988901431707"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1429124115225437"}, {"status": "PUBLISHED", "id": "1192494909637425"}, {"status": "PUBLISHED", "id": "1182550190012164"}, {"status": "PUBLISHED", "id": "745338331633255"}, {"status": "PUBLISHED", "id": "1175141591113691"}, {"status": "PUBLISHED", "id": "2327517580998335"}, {"status": "PUBLISHED", "id": "933141822282442"}]}, "baseline_offer": {"id": "1429124115225437"}
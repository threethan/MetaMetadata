ng?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwZ0esnEzKYQ7kNvwE4GzE9&_nc_oc=Adq7n-dKKxQYdc2MC4HbkGaAM0517buKkmM59nES35LUr7LORZoZpBUI_eCvyOzj9vM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVeLeVbHc9wB1wmehIGJveFNuNciBb_Ub0PrSOvBb04A&oe=6AFF180A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1472125524727772", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491821704_1472125528061105_8694437258343358776_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ha01W9VsvcAQ7kNvwGajWhw&_nc_oc=Adr8aHJwV-KJuioCDlxijOGlEdbE7JxXxuKt1M4n5wYkb2LFhp01oldnUeCFX0COimM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDN8_tyfR1zIFmUXeSCn32UY1RafxV4kjBuhX8X1zV2g&oe=6AFF2616"}, "display_name": "Table Tennis XR: Spin Arena", "keywords": ["tennis", "pingpong", "tabletennis", "sports", "racket"], "long_description": "Step into the rally.\n\nTable Tennis XR: Spin Arena puts a regulation table, a competition paddle, and the next shot within arm\u2019s reach. Swing naturally with your Touch controller, feel the paddle track your wrist, and learn to control pace, angle, placement, and spin one shot at a time.\n\nThe ball responds to your contact. Topspin dives, backspin floats, sidespin bends, and the table gives back a crisp, readable bounce. Use the practice rebound board or the automated ball machine to build timing before you take on a faster rally.\n\nMade for standing room-scale play on Meta Quest, Spin Arena includes a visible hand grip around the paddle, an ergonomic shakehand angle, responsive haptics, player recentering, and a regulation-size table setup. Pick up the ball, toss a serve, and make the next point yours.", "short_description": "Feel every topspin, block, and table bounce in a physics-driven VR table tennis arena built for Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tennis.nohtv.shop/privacy/", "developer_terms_of_service_url": "https://tennis.nohtv.shop/terms/", "publisher_name": "NahomPromotion", "support_website_url": null, "website_url": "https://tennis.nohtv.shop/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2903793406672783"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1454094730031036"}, {"status": "PUBLISHED", "id": "1727694585012506"}]}, "baseline_offer": {"id": "1727694585012506"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1454094730031036"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2905798029805654", "version": "1.1.0-beta.3"}, "id": "1090036803675590", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2898347820550675", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2905798029805654"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1090036803675590"}]}, "change_log": null, "created_date": 1790720484, "id": "2905798029805654", "version": "1.1.0-beta.3", "version_code": 1
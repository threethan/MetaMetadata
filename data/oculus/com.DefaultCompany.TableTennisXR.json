-QfY7WA&oe=6B1045F1"}, {"file_name": "screenshot-04-2560x1440.png", "id": "3435169563449183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_3435169566782516_6608004398011035546_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kj2PDnPOPQoQ7kNvwGcgfsa&_nc_oc=AdoFooI3dEnH6i1lnJ9H1Xa7emPqauIgcXjGUXvv4U8k8d1l3VEQK2h7lPfIvj_skdA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU0tce-L6x2pTPJPGGzpLDgeRYws9E3KqSE2K58INpiwg&oe=6B103B69"}, {"file_name": "screenshot-05-2560x1440.png", "id": "1058453923843468", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825415_1058453927176801_7937949007742878961_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXitaSYWO5EQ7kNvwGqAhdh&_nc_oc=AdpjVjfwHIyLmohoKJHZbJ5bjz6MeZnBrBJ-wqpUBwRnoTNGQ3BtdgVjOYfcIp31f5k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV8jZj7oMLQyumNO9vFLA8u9vBgRGENLOoFOAV1j8Ctew&oe=6B104EB8"}, {"file_name": "screenshot-01-2560x1440.png", "id": "3304982836357657", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823802_3304982839690990_8650099233404073526_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3na6mqlKlUQ7kNvwEr-HYr&_nc_oc=AdpDRJAyG4gEbhqCBHxWxwHVSxoUI0Sa5Zn2SD6sd7Kg_-vzfEsMwLfaeG9_NZW3DYM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW0SplvkY4zCSFN1tyoO8ENbglcUqruGjc7Zu12NpEGHg&oe=6B103B8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1472125524727772", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821704_1472125528061105_8694437258343358776_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxaGMZ9KiWUQ7kNvwG6uN46&_nc_oc=Adq9pRPniQ8xa1ORoIAyMnoKL-vaCG8F_g7BMnY5uCLETzRQv-EtFbCcmH11C_bX4x0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWOxADS-QI93ZuNaZaCuSZabGSXnt-AZv_pdR5GsBks1g&oe=6B104996"}, "display_name": "Table Tennis XR: Spin Arena", "keywords": ["tennis", "pingpong", "tabletennis", "sports", "racket"], "long_description": "Step into the rally.\n\nTable Tennis XR: Spin Arena puts a regulation table, a competition paddle, and the next shot within arm\u2019s reach. Swing naturally with your Touch controller, feel the paddle track your wrist, and learn to control pace, angle, placement, and spin one shot at a time.\n\nThe ball responds to your contact. Topspin dives, backspin floats, sidespin bends, and the table gives back a crisp, readable bounce. Use the practice rebound board or the automated ball machine to build timing before you take on a faster rally.\n\nMade for standing room-scale play on Meta Quest, Spin Arena includes a visible hand grip around the paddle, an ergonomic shakehand angle, responsive haptics, player recentering, and a regulation-size table setup. Pick up the ball, toss a serve, and make the next point yours.", "short_description": "Feel every topspin, block, and table bounce in a physics-driven VR table tennis arena built for Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tennis.nohtv.shop/privacy/", "developer_terms_of_service_url": "https://tennis.nohtv.shop/terms/", "publisher_name": "NahomPromotion", "support_website_url": null, "website_url": "https://tennis.nohtv.shop/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interactio
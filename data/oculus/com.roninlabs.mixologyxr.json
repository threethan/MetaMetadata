v/t64.5771-25/38982620_878832544353935_6265746873802129159_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVOIF07l6J4Q7kNvwH5FW15&_nc_oc=AdoCSMyVJ5LFPVkXxAH1L3ptCxgQkWKWVhOoOyjdSN9pVtffpR62zBlMISwVij2xNRw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLOrg3m0EuS7gdCNF-I3Ldv6A79fAy5SIZW-oFeqWNDg&oe=6AFB1E90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "1262021735120903", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75355155_1262021738454236_3496734140809192761_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htdqTZjZFP4Q7kNvwF_vVvU&_nc_oc=Adr42AOUHxP_K7rGX5bJ7dCcYUVOG-Y16Dn8j5ux_eIS6HkzZ--u9xodrr5S0w3296U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtlC20-ismHI6_vcnQAEcfDxanF8fkijXyXwvXcstyJw&oe=6AFB22B1"}, "display_name": "Mixology XR", "keywords": ["bartender", "Mixology", "bartending", "MixedReality", "Cocktails"], "long_description": "Transform Your Space into a Lively Bar! Map your table, place the bar mat and shelves, and immerse yourself in a stunning bar atmosphere. Experience the thrill of bartending like never before, using only your hands in our innovative hand-tracking mode.\nEmbark on a Mixology Journey in Mix Academy: Learn and master the art of cocktail creation. From classic recipes to complex concoctions, elevate your skills and become a true mixologist.\nTest Your Skills in Bartender Mode: Serve a wave of eager customers within a 10-minute frenzy. The more cocktails you make, the more points you earn. Polish your techniques and prove your prowess under pressure.\nDiscover New Recipes with Mix AI: Place unlocked items on the bar mat, and let our AI generate exciting new recipes based on your selection. Then, bring these innovative drinks to life in Freestyle Mode.\nChallenge Others in Multiplayer Mode: Compete in thrilling 1v1 clashes with other mixology enthusiasts or invite your friends for a friendly challenge. Show off your skills and see who reigns supreme in the world of mixology.\nFeatures:\n*Realistic Bar Setup: Map your table and place bar mats and shelves to create an authentic bar experience.\n*Hand Tracking Mode: Play without controllers, using your own hands to mix and serve drinks.\n*Endless Creativity: Craft unique cocktails and experiment with various ingredients.\n*Competitive Edge: Compete with friends and other players to become the ultimate mixologist.", "short_description": "Transform Your Space into a Lively Bar! Map your table, place the bar mat and shelves, and immerse yourself in a stunning bar atmosphere. Experience the thrill of bartending like never before, using only your hands in our innovative hand-tracking mode."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mixology.io/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ronin Labs", "support_website_url": null, "website_url": "https://mixology.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "8455797844501928"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "976826157707161"}, {"status": "PUBLISHED", "id": "1458774015063405"}]}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1744871520, "status": "PUBLI
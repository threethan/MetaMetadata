wG6-hxDgFY9lxVnyZ2aVZYTw&oe=6AFB2835"}, "display_name": "VT-Platform", "keywords": [], "long_description": "Visualize and work with your BIM model in VIrtual Reality with our digital tools.\n\nOur solutions can be applied in any phase of the life cycle of an AECO asset, from the design and planning of the project, through the construction and manufacture of the asset, to its operation and maintenance, allowing full traceability of the asset to be controlled. \n\nWe have developed a series of digital tools in Virtual Reality, which allow both operators in the field to resolve their work processes more quickly and efficiently, and office workers to access all the information generated automatically and in real time, all on the same BIM model. ", "short_description": "Visualize and work with your BIM models in VIrtual Reality thanks to VT-Platform"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vt-platform.vt-lab.com/termsandpolicies", "developer_terms_of_service_url": "https://vt-platform.vt-lab.com/termsandpolicies", "publisher_name": "VT-Lab", "support_website_url": "https://www.vt-lab.com/en/contact/", "website_url": "https://www.vt-lab.com/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7325544397571431"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com
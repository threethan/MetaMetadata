ols in Virtual Reality, which allow both operators in the field to resolve their work processes more quickly and efficiently, and office workers to access all the information generated automatically and in real time, all on the same BIM model. ", "short_description": "Visualize and work with your BIM models in VIrtual Reality thanks to VT-Platform"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vt-platform.vt-lab.com/termsandpolicies", "developer_terms_of_service_url": "https://vt-platform.vt-lab.com/termsandpolicies", "publisher_name": "VT-Lab", "support_website_url": "https://www.vt-lab.com/en/contact/", "website_url": "https://www.vt-lab.com/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7325544397571431"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001662_566764585204032_3777626947387670731_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6CSyNeYrZykQ7kNvwHqo2kk&_nc_oc=AdmRqhJTQpzhirX0XIFZvnH0UiS6bhfR-7k4Tz741JH7FJy2VY6Tkb_EM0hj2NFOY-A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfteJb-vB6cQ4-cpmnRBDilsXA00DRURgUQu_Xs-LhrCKQ&oe=69A2D76E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VT-Platform", "platform": "ANDROID_6DOF", "context_category": {"context_categ
26668985022015_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7MlMbmHFTMQ7kNvwEb92mz&_nc_oc=Admy7WBESkGe_99Te2aYv7F0L1KfWKMmyFkfi2wVfVFM-XDl5Ogsx2AZas3bZ8TiYPo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv1zkD8FqJElL4_ajjCapx4V58Tbyti41B9KUsJINFGvg&oe=699B0885"}, {"file_name": "\u622a\u56fe5 (1).png", "id": "1592719478111388", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393538_1592719488111387_503975486996808919_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yE3gT-bYmVAQ7kNvwEqNTsX&_nc_oc=AdllFx-kPNomE9BoOFU8UiScIx7fL5b4zEg6d4Kac_sk1GXmKDRTbPlBqpd0ik7sAC8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu71W8kaeln9kt9Fh-g7UfV-7DzxY9vd6ftuGAk9FVIJA&oe=699B0C7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4 (1).png", "id": "9243308355758740", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393388_9243308365758739_152323236491290641_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4T9Rez_yFsQ7kNvwG-oU4e&_nc_oc=AdnyLaNDEepAlYFTH7gQzvnj6CtWWbRSde1xs0GMbFhDSwjHEbl7Lqog6OzAMPQ-hHo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfusJ8wcHfNQ_BsqDChseSWsiy3KbJ5lCQDCg8LUAuUTuA&oe=699B0B3F"}, "display_name": "Subspace Hunter", "keywords": ["subspacehunter", "sh", "subspace", "hunter"], "long_description": "  The game provides swords, magic, and firearms in three combat ways; players can use any combination of them to form their own unique fighting style and clever use of different ways to fight with the enemy. Players need to observe different enemy fighting ways to make different combat changes after a long time of training and combat to grow into a qualified \"Subspace hunter\" \n\nHand Tracing\uff1a\n  The game supports full hand tracking interaction to play, and Trigger skills by recognizing different hand gesture. At the same time, while hand tracing, players can use blades and guns to fight.\n\nMelee system:\n   Players can use the blade to block, bounce, parry enemy attacks, and intercept enemy bullets and orbs.\n\n", "short_description": "Subspace Hunter is an MR+VR dual-mode action game; players need to use guns, blades, magic and any combination of the invasion of the subspace into the real world of the epic battle. At the same time, the game supports full hand tracking interaction to play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sh.xuking.tech/privacy/", "developer_terms_of_service_url": null, "publisher_name": "SpatialXR", "support_website_url": null, "website_url": "https://sh.xuking.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25058905980413687"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_861577659449790_2174786538634993475_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIBKaUJWrJgQ7kNvwH9uN8D&_nc_oc=AdmEP0_n-BuBpAbkVqtdmMnOL-BnbFdYmThLtq9HAZ84MU3s2c79FxXYpa4laBibVrM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsUoJa80Gx7HcXq6krr1uOI7N5jCU4uSZvMiRMR7ypkoA&oe=699B05D0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Subspace Hunter", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"top
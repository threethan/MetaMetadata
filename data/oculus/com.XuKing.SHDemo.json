id": "1013573930626957", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391860_1013573933960290_7316126668985022015_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgwSRi7mHLgQ7kNvwHiPL4j&_nc_oc=AdnZMzll3aFt-hkZid1webG5UVy3J1W01xJKJ9SZtXUwcGdd6ZoIITrUjqNAGtNK4SU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBvJcTuavV6Sj9p6Qe_25dKBJG0VDCZm497W38ewc6fw&oe=69B56685"}, {"file_name": "\u622a\u56fe5 (1).png", "id": "1592719478111388", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393538_1592719488111387_503975486996808919_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvpLJ1fopgwQ7kNvwFJCQgR&_nc_oc=Adkcx1vNQenLJ0SYcHxZC2n2fvV4Cn4w0NNLE_RouNhDRp-E0T92fOk0xBHiLopLYz0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwbgZ70mpkp5ue9_4ng7Njqaadi8piqu3Tp0QtU5cgOiA&oe=69B56A7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4 (1).png", "id": "9243308355758740", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393388_9243308365758739_152323236491290641_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyhoQepA6MkQ7kNvwFlj1Ti&_nc_oc=AdmWU6Nu56aS6bdDQDZ35Wqpa5mYEGF2wg6JLTzmBYZMOHlrmKdQmTZB9BdWTwmeXd4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3El4UzzSInKU_Sah_CboNWoj5bWKPOieV2lLSVLwqhA&oe=69B5693F"}, "display_name": "Subspace Hunter", "keywords": ["subspacehunter", "sh", "subspace", "hunter"], "long_description": "  The game provides swords, magic, and firearms in three combat ways; players can use any combination of them to form their own unique fighting style and clever use of different ways to fight with the enemy. Players need to observe different enemy fighting ways to make different combat changes after a long time of training and combat to grow into a qualified \"Subspace hunter\" \n\nHand Tracing\uff1a\n  The game supports full hand tracking interaction to play, and Trigger skills by recognizing different hand gesture. At the same time, while hand tracing, players can use blades and guns to fight.\n\nMelee system:\n   Players can use the blade to block, bounce, parry enemy attacks, and intercept enemy bullets and orbs.\n\n", "short_description": "Subspace Hunter is an MR+VR dual-mode action game; players need to use guns, blades, magic and any combination of the invasion of the subspace into the real world of the epic battle. At the same time, the game supports full hand tracking interaction to play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sh.xuking.tech/privacy/", "developer_terms_of_service_url": null, "publisher_name": "SpatialXR", "support_website_url": null, "website_url": "https://sh.xuking.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25058905980413687"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982664_861577659449790_2174786538634993475_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1iR1CVeWEgQ7kNvwFGp-MI&_nc_oc=AdmBnsv983f9emNlkb21bemSCQoB6Ve5QOogsfUAi4Zc4PN9cHlMcacqE5ff_u7ZoSY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxW8ASKpZeYBJXdOb_GM4z92_P36jpJiSWbub83NlEjJw&oe=69B563D0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Subspace Hunter", "platform": "ANDROID_6DOF",
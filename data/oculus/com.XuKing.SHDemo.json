8&oh=00_AfxVyQK0kc8Pi3whhlYwvh7wBBH_Cfii9uUnNvKqkUG4iA&oe=69B80871"}, {"file_name": "\u622a\u56fe3.png", "id": "1702864700634268", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393372_1702864703967601_7486831785403781238_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWWSEdR8vfEQ7kNvwGuaWTM&_nc_oc=Adn9B5GfXG3Q3jWtPKRl_GPg2OzQWmOzW7UdH-aawojYooDayKvK51BMZPYLCYm0508&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxavUveo7l6TPzq40fKa4zlhh80ohH3YNvro9myj5fZbw&oe=69B7FAC2"}, {"file_name": "\u622a\u56fe4 (1).png", "id": "1013573930626957", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391860_1013573933960290_7316126668985022015_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvE3PRNCy88Q7kNvwF9aKA-&_nc_oc=AdmLvg88S7x7tKfmMt8r-Rm8oVUUIQznSAdOtwKcMlrJERy9vIEAdz4csKPwr71_Veo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzBWogDBi66vTE5ie_EVfzB0wgZYDvIURhQ1DzOJC_GKQ&oe=69B80985"}, {"file_name": "\u622a\u56fe5 (1).png", "id": "1592719478111388", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393538_1592719488111387_503975486996808919_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvpLJ1fopgwQ7kNvwFr9ln0&_nc_oc=AdlWU_Lyv82ucmlLh-lJfwquj-K_okfhQ1lIYmoiB67NsFkEWorVWZsHSm-etOvmTFM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAPaoIo-4rG2UO0PzFitYuDV_bs8f-eLgYqiXdylS9bg&oe=69B80D7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4 (1).png", "id": "9243308355758740", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393388_9243308365758739_152323236491290641_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyhoQepA6MkQ7kNvwHil0Ga&_nc_oc=AdnsIOZ6DehMt0MchFmjhxmZfCkV-PJb0xtRFsObZz7Jd8jExV1ROIu8hVkmSpI1vpA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyAsXn2GtRFqH2ZRxZFYu1X5AbrkTDHB0g_pwb-pFHT1w&oe=69B80C3F"}, "display_name": "Subspace Hunter", "keywords": ["subspacehunter", "sh", "subspace", "hunter"], "long_description": "  The game provides swords, magic, and firearms in three combat ways; players can use any combination of them to form their own unique fighting style and clever use of different ways to fight with the enemy. Players need to observe different enemy fighting ways to make different combat changes after a long time of training and combat to grow into a qualified \"Subspace hunter\" \n\nHand Tracing\uff1a\n  The game supports full hand tracking interaction to play, and Trigger skills by recognizing different hand gesture. At the same time, while hand tracing, players can use blades and guns to fight.\n\nMelee system:\n   Players can use the blade to block, bounce, parry enemy attacks, and intercept enemy bullets and orbs.\n\n", "short_description": "Subspace Hunter is an MR+VR dual-mode action game; players need to use guns, blades, magic and any combination of the invasion of the subspace into the real world of the epic battle. At the same time, the game supports full hand tracking interaction to play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sh.xuking.tech/privacy/", "developer_terms_of_service_url": null, "publisher_name": "SpatialXR", "support_website_url": null, "website_url": "https://sh.xuking.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26645591655078437"}, "review_messages": []}]}, "co
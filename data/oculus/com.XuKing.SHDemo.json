26668985022015_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXu24W-NVCYQ7kNvwHqGI0v&_nc_oc=Adk3GsLCy7pp-8Q6NueMKmwuaN0kVBnTn8pLXHvLX_y5NGVs_F0A9M6xcecHj7UXUV4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afujeo5Vr5p1ldnsLtJTZKUdXgTb3xF6hW7rRVqOVHSczw&oe=699C5A05"}, {"file_name": "\u622a\u56fe5 (1).png", "id": "1592719478111388", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393538_1592719488111387_503975486996808919_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yE3gT-bYmVAQ7kNvwG-yR6X&_nc_oc=AdnPRiVcXE9E-kD3oCaWH8pS5q8beg9RogbBgUwMgqkRVe4ltlYPvOfZM6BfaCVx6Do&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu8F1E_wIoE-dbNrFzjdCBQNlQ_QnyjCeHRSPmZ1NTdyg&oe=699C5DFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4 (1).png", "id": "9243308355758740", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393388_9243308365758739_152323236491290641_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4T9Rez_yFsQ7kNvwEj80zw&_nc_oc=AdlvuKAsW6kGFkmK2zoxlTY3qkDewu7R5-1yHJIa_no5dk0u3etIXGt2wiwV0vDgPLw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft-hO-CVvtWerXwyP51HB2fjoK1C8QTkJuOB3kvoXyuKQ&oe=699C5CBF"}, "display_name": "Subspace Hunter", "keywords": ["subspacehunter", "sh", "subspace", "hunter"], "long_description": "  The game provides swords, magic, and firearms in three combat ways; players can use any combination of them to form their own unique fighting style and clever use of different ways to fight with the enemy. Players need to observe different enemy fighting ways to make different combat changes after a long time of training and combat to grow into a qualified \"Subspace hunter\" \n\nHand Tracing\uff1a\n  The game supports full hand tracking interaction to play, and Trigger skills by recognizing different hand gesture. At the same time, while hand tracing, players can use blades and guns to fight.\n\nMelee system:\n   Players can use the blade to block, bounce, parry enemy attacks, and intercept enemy bullets and orbs.\n\n", "short_description": "Subspace Hunter is an MR+VR dual-mode action game; players need to use guns, blades, magic and any combination of the invasion of the subspace into the real world of the epic battle. At the same time, the game supports full hand tracking interaction to play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sh.xuking.tech/privacy/", "developer_terms_of_service_url": null, "publisher_name": "SpatialXR", "support_website_url": null, "website_url": "https://sh.xuking.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25058905980413687"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982664_861577659449790_2174786538634993475_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIBKaUJWrJgQ7kNvwEf-fI6&_nc_oc=Adl9Hfsu1WKImHRNbdePfhSDhPpUWiwkoZRF2-SNeYDB1OFTnrgKtz2s3VuVK82Sjvk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftwXE3vv82kLTIlk9Og0Fzfj2wnvJYaLSl6dCWWVhnErw&oe=699C5750"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Subspace Hunter", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"top
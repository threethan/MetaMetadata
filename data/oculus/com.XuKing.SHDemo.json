26668985022015_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkZ6QyfnDh8Q7kNvwHn9gZ8&_nc_oc=Adm0fdxj9lsWuHitokz2vARJanMGFsrzboHl55dKmUc5phAfrIOpVaaI3SshJqkzP3w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftkYga_TO-Bd9RwEhgzmQNSkDs4iqj6H9xM-9wIf_1cIg&oe=69A04E85"}, {"file_name": "\u622a\u56fe5 (1).png", "id": "1592719478111388", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393538_1592719488111387_503975486996808919_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEG2bHYa7a0Q7kNvwFaw7Zz&_nc_oc=Adlo6oIW54EySEAyM9ESSfNzKO6hIUVEpDM3FWXb-SZHuK9yA9xFxAIjmFEOhTLhdWs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuNWUVAn3RG4wEdrTJ6YB_rvWAFp4WlSoKZ3QR4u8xNHw&oe=69A0527D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4 (1).png", "id": "9243308355758740", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393388_9243308365758739_152323236491290641_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4JQqghfjhwQ7kNvwEd_SyX&_nc_oc=AdlpuKhSfu5F2G7Oyj8YmrflEQdUzQnydin-XnZ5HaM9tcOQOSDiskaYURF2njasiC8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuSGFDEj0f2IjFZEgx_E7XCnX7IPvyjEYhFJZ_u6GKb2A&oe=69A0513F"}, "display_name": "Subspace Hunter", "keywords": ["subspacehunter", "sh", "subspace", "hunter"], "long_description": "  The game provides swords, magic, and firearms in three combat ways; players can use any combination of them to form their own unique fighting style and clever use of different ways to fight with the enemy. Players need to observe different enemy fighting ways to make different combat changes after a long time of training and combat to grow into a qualified \"Subspace hunter\" \n\nHand Tracing\uff1a\n  The game supports full hand tracking interaction to play, and Trigger skills by recognizing different hand gesture. At the same time, while hand tracing, players can use blades and guns to fight.\n\nMelee system:\n   Players can use the blade to block, bounce, parry enemy attacks, and intercept enemy bullets and orbs.\n\n", "short_description": "Subspace Hunter is an MR+VR dual-mode action game; players need to use guns, blades, magic and any combination of the invasion of the subspace into the real world of the epic battle. At the same time, the game supports full hand tracking interaction to play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sh.xuking.tech/privacy/", "developer_terms_of_service_url": null, "publisher_name": "SpatialXR", "support_website_url": null, "website_url": "https://sh.xuking.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25058905980413687"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982664_861577659449790_2174786538634993475_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULoXcJtpj80Q7kNvwEEbiwG&_nc_oc=Adk-dpGlY-CvxuGotQxzh0QLWXT1FBfTbVZA7SjVCInCEwU9Tsmo12lkLVKTWF5Y4No&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs7BmEgFhBTRGxHiiAnXA1iRPrRLY339Nb11gQlk34FQQ&oe=69A04BD0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Subspace Hunter", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"top
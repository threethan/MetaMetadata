26668985022015_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXu24W-NVCYQ7kNvwEkRxCS&_nc_oc=Adm7LXWOcxEimkjkncbfkAEL0nYbe8N3fJLvIdiGjJ863FYqHgqlJnFnHxpsoamFxhE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuV0UOPR-yzGDWf5nrBDvMTC4psm3QKtnqobGnXRG09QQ&oe=699EFD05"}, {"file_name": "\u622a\u56fe5 (1).png", "id": "1592719478111388", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393538_1592719488111387_503975486996808919_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEG2bHYa7a0Q7kNvwFmvziE&_nc_oc=AdlP736mH1uC8r1_xqzQQTvgSippRWhKcLl2I3EGGGIPUPfnNal1CPMt6W-KO4xOL-I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftTPZxJ9ZI9XdQnN1wZl0qA9UJVikS4S25YsXs47HCrTQ&oe=699F00FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4 (1).png", "id": "9243308355758740", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393388_9243308365758739_152323236491290641_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4JQqghfjhwQ7kNvwE9cmbZ&_nc_oc=AdkSYqFn8aEwu0OE7rqW43m61PJ6-aNvlN5PWuSe8V5RiXwE3JvJD1Mt6L4dVhvQ-So&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuVTifNRU_og0o53V8BPputyF9_wEqv-CqRA3MX448KpA&oe=699EFFBF"}, "display_name": "Subspace Hunter", "keywords": ["subspacehunter", "sh", "subspace", "hunter"], "long_description": "  The game provides swords, magic, and firearms in three combat ways; players can use any combination of them to form their own unique fighting style and clever use of different ways to fight with the enemy. Players need to observe different enemy fighting ways to make different combat changes after a long time of training and combat to grow into a qualified \"Subspace hunter\" \n\nHand Tracing\uff1a\n  The game supports full hand tracking interaction to play, and Trigger skills by recognizing different hand gesture. At the same time, while hand tracing, players can use blades and guns to fight.\n\nMelee system:\n   Players can use the blade to block, bounce, parry enemy attacks, and intercept enemy bullets and orbs.\n\n", "short_description": "Subspace Hunter is an MR+VR dual-mode action game; players need to use guns, blades, magic and any combination of the invasion of the subspace into the real world of the epic battle. At the same time, the game supports full hand tracking interaction to play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sh.xuking.tech/privacy/", "developer_terms_of_service_url": null, "publisher_name": "SpatialXR", "support_website_url": null, "website_url": "https://sh.xuking.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25058905980413687"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982664_861577659449790_2174786538634993475_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULoXcJtpj80Q7kNvwErjesZ&_nc_oc=Adlh3d35Dc9SCWrY7CM5WjTooBzxjeDAMMmNvhZkrfzuhhlBBcqKNs86NsoVeF8AX6Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftRqWVmmsNKZqH1D1_qgo5-OLHZoaUW_kmEKn-2lvBuXg&oe=699EFA50"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Subspace Hunter", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"top
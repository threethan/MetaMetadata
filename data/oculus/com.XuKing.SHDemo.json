290_7316126668985022015_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtP0xXkLtqoQ7kNvwE62eyY&_nc_oc=AdmBHZHzrXZc6dMrAv7yeR9GPKdGyylZHOogU8oOE3yPi-KirXOXQeam8UF_kLJJLCs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsKUMcZ9I0aa0h0I1IGrunT4ESatOz95abRQoi3rGsTsg&oe=69A6E605"}, {"file_name": "\u622a\u56fe5 (1).png", "id": "1592719478111388", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393538_1592719488111387_503975486996808919_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIOmPc3cmEYQ7kNvwG3u_L7&_nc_oc=AdnGdBhk2EQQXlMU1a1kt8mlj-timhqRyBvqKCVpHFSTcN_pplH3tmrrt4Kba-Jw5H0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftCiftJuiVg9uGCjvNuy3fGdx5YSla92J7_UQB72azK9Q&oe=69A6E9FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4 (1).png", "id": "9243308355758740", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393388_9243308365758739_152323236491290641_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GEWSSMGs2UQ7kNvwGwquo-&_nc_oc=Adm2GcOJ2B5ZFJCgh3C9K6kNIrXWdeQhQYCq7PXsgvQLKYA94OWPBbX76X5-X7xruTI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfshYpZ3u8s358zDIy7Ac_73sWOKCldn7OOZU0YOJ_y3pw&oe=69A6E8BF"}, "display_name": "Subspace Hunter", "keywords": ["subspacehunter", "sh", "subspace", "hunter"], "long_description": "  The game provides swords, magic, and firearms in three combat ways; players can use any combination of them to form their own unique fighting style and clever use of different ways to fight with the enemy. Players need to observe different enemy fighting ways to make different combat changes after a long time of training and combat to grow into a qualified \"Subspace hunter\" \n\nHand Tracing\uff1a\n  The game supports full hand tracking interaction to play, and Trigger skills by recognizing different hand gesture. At the same time, while hand tracing, players can use blades and guns to fight.\n\nMelee system:\n   Players can use the blade to block, bounce, parry enemy a
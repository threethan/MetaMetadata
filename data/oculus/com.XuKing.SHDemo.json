o1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tDycsLXz8pGZRRg5DfbpZ0cC3UbWhnlVTDg35QduXYA&oe=6A09C571"}, {"file_name": "\u622a\u56fe3.png", "id": "1702864700634268", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473393372_1702864703967601_7486831785403781238_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRxVyEoORY0Q7kNvwHAmhf-&_nc_oc=AdoFNdZJm7Y04DCS6iieo1RC55QzOx5z6YoU78M70ivYLJv1WFDFxU5GeE8v7ZZotGI&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vS-iLHZR3GM2g1wNWmz0vy0nalaDU6BjWaHhcuXvnCg&oe=6A09B7C2"}, {"file_name": "\u622a\u56fe4 (1).png", "id": "1013573930626957", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391860_1013573933960290_7316126668985022015_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AgZNWPUI8BIQ7kNvwFBAWdp&_nc_oc=AdqorRtnYTdDfsot1s3p0qJcgS90D_sLk9AiTrv9rs-E-A8gcZ_keDrqRPLK8qVtFrc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tyjlzwyOCeLkwPzx58FkdntvUtrEI-_F_1WTjFxUcnQ&oe=6A09C685"}, {"file_name": "\u622a\u56fe5 (1).png", "id": "1592719478111388", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473393538_1592719488111387_503975486996808919_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vN6t8fPDxEgQ7kNvwH4LlVz&_nc_oc=AdpiLjEnl4iRynoFEtvwKy372xJVpWpn1vn0B0ZpjoExXAIHJ2I0biHfo40voQ9ZAT0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GpNdapi04-LTy98N7FhV05xEJDHVjl_O0bpEYF-2_pA&oe=6A09CA7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16-9.png", "id": "1574937853811429", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499623400_1574937857144762_2965941216487640120_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCwtM2e76dMQ7kNvwGIWnUZ&_nc_oc=AdrkDWlGejciu7k1LVJT1dj2LfP-KKUxStiWNqRtwqkfkW6lQJ1pmO0UNC3RPPsfXrA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dmwtWlv_NjzWFiXyvBCdYJkq-LHIaYUuX5aZkPIE1BA&oe=6A09DE80"}, "display_name": "Subspace Hunter", "keywords": ["subspacehunter", "sh", "subspace", "hunter"], "long_description": "  The game provides swords, magic, and firearms in three combat ways; players can use any combination of them to form their own unique fighting style and clever use of different ways to fight with the enemy. Players need to observe different enemy fighting ways to make different combat changes after a long time of training and combat to grow into a qualified \"Subspace hunter\" \n\nHand Tracing\uff1a\n  The game supports full hand tracking interaction to play, and Trigger skills by recognizing different hand gesture. At the same time, while hand tracing, players can use blades and guns to fight.\n\nMelee system:\n   Players can use the blade to block, bounce, parry enemy attacks, and intercept enemy bullets and orbs.\n\n", "short_description": "Subspace Hunter is an MR+VR dual-mode action game; players need to use guns, blades, magic and any combination of the invasion of the subspace into the real world of the epic battle. At the same time, the game supports full hand tracking interaction to play"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sh.xuking.tech/privacy/", "developer_terms_of_service_url": null, "publisher_name": "SpatialXR", "support_website_url": null, "website_url": "https://sh.xuking.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2668995002397593
0_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g27mK5a2u-QQ7kNvwE353C2&_nc_oc=Adq-fBqOv1qxQQPWObwScqKhJ6jYwkYOKKI-GFcacyNOW0iFATgnMp6QVNEUKQR8HOY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRqav8kFVsCO4Qr3pc-bRdpRzuTuk86styKtwC8oci5eg&oe=6B0DC5CA"}, {"file_name": "hailsc3.png", "id": "1102610438827648", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596168449_1102610442160981_1853203369070007150_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIhZZPdTFaMQ7kNvwEnjCul&_nc_oc=AdqPHkmmAFs1r1U_Q3u5MyiviQBRtkgku8DdrcTRwMyVztMsEy6jFo2T-B8uDyc2kug&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR4CGnRKTVRrulOS-XgvSDN7k3ISubfYWo7D3UjPdI-QQ&oe=6B0DC3B5"}, {"file_name": "hailsc1.png", "id": "1624604915717780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604360590_1624604919051113_4111282688955190153_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JH9ivlgxIKwQ7kNvwEIdGQJ&_nc_oc=AdoNHphIdOV-djik7Gnt-MyeeryEEEbKJqHPh8hCVMlhYzSzW4iVtx8Cj4G5_u0xulU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRkBCdu91WWsSFFF5e7mJR992eNutxtuoyBwTMO0xUQWg&oe=6B0DAE4D"}, {"file_name": "hailsc6.png", "id": "4487453034828210", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596106838_4487453038161543_6557339881551695929_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTCbGqWcKlIQ7kNvwFBUm1B&_nc_oc=AdoETtBCKPR-DENZ1fMfIU7-IDOh-A1F1-xM4hh6XVROTUGmJNdFQLULiSKgRdYtKzY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ3ZsINCdqBGFouxf_mxHPKEtjGAt3Ci-h0R6lG59vCaA&oe=6B0DB5F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hail", "keywords": ["Hail", "Tornado", "Storm", "Monkey", "Baboon"], "long_description": "Hail VR is an immersive storm chasing game where you track powerful thunderstorms and tornadoes across the map. Deploy scientific probes directly in the path of storms to collect valuable weather data and earn money. The more dangerous and accurate your intercepts, the bigger the rewards.\n\nUse your earnings to expand your chasing career by purchasing new vehicles from the dealership, each offering different performance and capabilities for tackling extreme weather. Whether you're racing to intercept a developing tornado, positioning probes ahead of a supercell, or exploring massive storms, every chase is a chance to earn cash and experience the power of nature up close.", "short_description": "Hail VR is an immersive storm chasing game where you track powerful thunderstorms and tornadoes across the map. Deploy scientific probes directly in the path of storms to collect valuable weather data and earn money. The more dangerous and accurate your intercepts, the bigger the rewards."}]}, "developer_name": "Flixzy", "developer_privacy_policy_url": "https://hail-vr.base44.app/", "developer_terms_of_service_url": null, "publisher_name": "Flixzy", "support_website_url": null, "website_url": "https://hail-vr.base44.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28506666782294874"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595119480_29161142950169886_8653976002636879694_n.png?stp=dst-png_s3
0_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11OwVFw5Lx4Q7kNvwEZk0iP&_nc_oc=Adq2ZSwVcXrqJ1KQK7gI-L3HN9cPAThXbQgs3nJUAGr9AbbEq-U06tqBeR-y-nEyHCw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSEz9ePEGxTRdQjNHX72F4NwEftkJDyRUVycBWG0AndQ&oe=6AFF0D0A"}, {"file_name": "hailsc3.png", "id": "1102610438827648", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596168449_1102610442160981_1853203369070007150_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClgI1ekOMPAQ7kNvwFGv4DT&_nc_oc=Adpst0b8ILxEZo2OgW3j9cLlQJA_8jTIUj58ZJgPqNSNsx_SneLZ7YXcrjhoQfPLsHg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmQMURn2u0ZNWAio6RY7SM3BeIoW_c5AssIOJTXPo-cA&oe=6AFF0AF5"}, {"file_name": "hailsc1.png", "id": "1624604915717780", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/604360590_1624604919051113_4111282688955190153_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BN36EmYAycwQ7kNvwEirz6P&_nc_oc=AdqYqXcfn1ek3ID61ZyKAva1NIRd4QTO48o9MAYBmaleqd6NAvTlgbL9FmNO-dkb-pw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-cHNuD9ioLfjr1KsO-7qSpdxLbi2flJQ4pSmY5m8Asg&oe=6AFF2DCD"}, {"file_name": "hailsc6.png", "id": "4487453034828210", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596106838_4487453038161543_6557339881551695929_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NZGNmNR0WsQ7kNvwG19WC_&_nc_oc=AdpyZ7nIi1VqfzdHRuVBEAG-FJQJhiLPkZ9bkJ-EdNVZzoGSj0hYzzKGFKHfoCpGD64&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvIiBWa6o5bJuEnXNp-NxAHJNgQl8Orpb5Ti3vXML9AA&oe=6AFF3576"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hail", "keywords": ["Hail", "Tornado", "Storm", "Monkey", "Baboon"], "long_description": "Hail VR is an immersive storm chasing game where you track powerful thunderstorms and tornadoes across the map. Deploy scientific probes directly in the path of storms to collect valuable weather data and earn money. The more dangerous and accurate your intercepts, the bigger the rewards.\n\nUse your earnings to expand your chasing career by purchasing new vehicles from the dealership, each offering different performance and capabilities for tackling extreme weather. Whether you're racing to intercept a developing tornado, positioning probes ahead of a supercell, or exploring massive storms, every chase is a chance to earn cash and experience the power of nature up close.", "short_description": "Hail VR is an immersive storm chasing game where you track powerful thunderstorms and tornadoes across the map. Deploy scientific probes directly in the path of storms to collect valuable weather data and earn money. The more dangerous and accurate your intercepts, the bigger the rewards."}]}, "developer_name": "Flixzy", "developer_privacy_policy_url": "https://hail-vr.base44.app/", "developer_terms_of_service_url": null, "publisher_name": "Flixzy", "support_website_url": null, "website_url": "https://hail-vr.base44.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28506666782294874"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595119480_29161142950169886_8653976002636879694_n.png?stp=dst-png_s3
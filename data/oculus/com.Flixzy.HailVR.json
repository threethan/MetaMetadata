ifferent performance and capabilities for tackling extreme weather. Whether you're racing to intercept a developing tornado, positioning probes ahead of a supercell, or exploring massive storms, every chase is a chance to earn cash and experience the power of nature up close.", "short_description": "Hail VR is an immersive storm chasing game where you track powerful thunderstorms and tornadoes across the map. Deploy scientific probes directly in the path of storms to collect valuable weather data and earn money. The more dangerous and accurate your intercepts, the bigger the rewards."}]}, "developer_name": "Flixzy", "developer_privacy_policy_url": "https://hail-vr.base44.app/", "developer_terms_of_service_url": null, "publisher_name": "Flixzy", "support_website_url": null, "website_url": "https://hail-vr.base44.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28506666782294874"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595119480_29161142950169886_8653976002636879694_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WiTB8-NQnJwQ7kNvwGVIujM&_nc_oc=AdpdBxYstRJjqDd7uAbHaHS4y22lcXG6QZhgSfqkeXEnVh99-ne4Vp76Zr5Qm59UmqY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQI-cIhTDb8qPRNkAwlAXHWrUOAAuKLTBepEql3mVTsQ
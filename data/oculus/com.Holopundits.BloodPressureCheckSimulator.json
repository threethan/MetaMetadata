.com&_nc_ss=7a30f&oh=00_Af0lBXYz_0HBr2nb4EQCXnxbMBbGJa0soOQBOthKgBHFoQ&oe=69E4D166"}, {"file_name": "Blood Pressure Check Simulator_Screenshot_06.png", "id": "411851528398966", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982642_411851531732299_2693507955641970078_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBIvJ8xobIsQ7kNvwG1Fc3S&_nc_oc=AdpJBWefW4KWo8zerFAwgtVyiH1h3HCbkcE1ZHIUrSP3m_poP8ISiW3IjLGFgGe78v4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zgl4SdKPoeJ5k8Et96LxrVdwSt5ikq35Fa_7ljlvb_g&oe=69E4D798"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "301541419690023", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974824_301541423023356_4938514156357818911_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4g0MxnWFLkQ7kNvwH_VTo0&_nc_oc=Ado-66BnWb8ZjlLJE59Zjj8AFkkzUjUL-YXy9CazBJZj33GqUOHnoK_rvJb_aMvh9Z8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vt1oi92uRe06zI3D5ZwjKfvGZmW2zNH9PJI_ZMnpI8w&oe=69E4DB54"}, "display_name": "Blood Pressure Check Simulator", "keywords": [], "long_description": "The Blood Pressure Check Simulator app immerses participants in a realistic virtual environment where they can practice and refine their skills in measuring and interpreting blood pressure readings. This application guides users through the proper selection and use of a blood pressure cuff, the correct procedure for taking a reading, and the interpretation of the results.\n\n# Learning Objectives:\n- Remembering the steps of the procedure\n- Understanding the significance of systolic and diastolic values\n- Applying the correct technique in a virtual scenario\n- Analyzing the accuracy of readings\n- Evaluating the results against normal ranges \n- Creating a plan for patient follow-up based on the readings obtained\n\nThis comprehensive simulation ensures that certified nursing assistant's or anyone interested in the healthcare field are well-prepared to perform blood pressure measurements accurately and confidently in real-world clinical settings.", "short_description": "Designed to train CNAs in accurately measuring and interpreting patient blood pressure using an interactive, hands-on virtual scenario."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25580736881573831"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "30551028137877989", "version": "3.0"}, "id": "300889006417495", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25580736854907167", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "30551028137877989"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": 
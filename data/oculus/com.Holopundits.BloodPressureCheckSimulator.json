https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462961_828897662015383_3747885686094884541_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxEy-h8ntNEQ7kNvwHt2GSW&_nc_oc=AdpAqEHwxBqVp-FWuiafyv_joW-IA0xGlyFJU8AB8mlhCH8Qy_zkkOwRD5VWzP7Odk8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6flt8xF-m__4KypdtLQyXSyeWYGPKKjLFbuxtU6sFSA&oe=6B031F26"}, {"file_name": "Blood Pressure Check Simulator_Screenshot_06.png", "id": "411851528398966", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982642_411851531732299_2693507955641970078_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwkt8JSeFi0Q7kNvwHQu7PP&_nc_oc=AdqrbTKt8IE2-NbVoF2C63cOcsSNwzMwXyKgkeQEgctQ6XymEcxCun575YJa-Rt3f38&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_K7zEw_ycRgDRcm9M_UdUE3CyndFImYUjmDAtcDdlYQ&oe=6B032558"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "301541419690023", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974824_301541423023356_4938514156357818911_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cv8ByG_ggaAQ7kNvwGI6fQn&_nc_oc=Adppky-LlnauXlTglliWre6xInNLPMVf1z2z4qs2HLdWyAWf7Eg0dnG8MtYVwN_kB20&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfFRV1LtLAqmDiYItqTPWXIbxZDBpSetrBLBySVB9GiQ&oe=6B032914"}, "display_name": "Blood Pressure Check Simulator", "keywords": [], "long_description": "The Blood Pressure Check Simulator app immerses participants in a realistic virtual environment where they can practice and refine their skills in measuring and interpreting blood pressure readings. This application guides users through the proper selection and use of a blood pressure cuff, the correct procedure for taking a reading, and the interpretation of the results.\n\n# Learning Objectives:\n- Remembering the steps of the procedure\n- Understanding the significance of systolic and diastolic values\n- Applying the correct technique in a virtual scenario\n- Analyzing the accuracy of readings\n- Evaluating the results against normal ranges \n- Creating a plan for patient follow-up based on the readings obtained\n\nThis comprehensive simulation ensures that certified nursing assistant's or anyone interested in the healthcare field are well-prepared to perform blood pressure measurements accurately and confidently in real-world clinical settings.", "short_description": "Designed to train CNAs in accurately measuring and interpreting patient blood pressure using an interactive, hands-on virtual scenario."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25580736881573831"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1759516377976730"}, {"status": "PUBLISHED", "id": "431620179808131"}]}, "baseline_offer": {"id": "1759516377976730"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749742740, "status": "PUBLISHED", "id": "1759516377976730"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBi
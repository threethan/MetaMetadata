.com&_nc_ss=7f20f&oh=00_Af_5DHmSYDRMxe3d3DXGrSohi7tW4wH-EGtSVnw7uG5DGg&oe=6A37DFE6"}, {"file_name": "Blood Pressure Check Simulator_Screenshot_06.png", "id": "411851528398966", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982642_411851531732299_2693507955641970078_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LtnCkFa4GasQ7kNvwGlcjDz&_nc_oc=AdoZIzoCdFS38iVJEdgEGd0_elkQzOooyKxXvjpbQT9PL8y6godNPdtDuOyS74bbuVA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kyHoP6Oj0SynzFjwpN2m-lhgb7BrZLnRaMTA0VfaZ9g&oe=6A37E618"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "301541419690023", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974824_301541423023356_4938514156357818911_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUXIEwgWylMQ7kNvwG90MWq&_nc_oc=AdpMApZ14rKvxlHtH_-yz1NI3Q1T-vBLU7_HwG6mUH5MbAMq29XkyD0h3Y5np1jWCR8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NGteaUmGrwKOHA9_pHg3d5J3mtRz6qrStfVJ1fRw3GA&oe=6A37E9D4"}, "display_name": "Blood Pressure Check Simulator", "keywords": [], "long_description": "The Blood Pressure Check Simulator app immerses participants in a realistic virtual environment where they can practice and refine their skills in measuring and interpreting blood pressure readings. This application guides users through the proper selection and use of a blood pressure cuff, the correct procedure for taking a reading, and the interpretation of the results.\n\n# Learning Objectives:\n- Remembering the steps of the procedure\n- Understanding the significance of systolic and diastolic values\n- Applying the correct technique in a virtual scenario\n- Analyzing the accuracy of readings\n- Evaluating the results against normal ranges \n- Creating a plan for patient follow-up based on the readings obtained\n\nThis comprehensive simulation ensures that certified nursing assistant's or anyone interested in the healthcare field are well-prepared to perform blood pressure measurements accurately and confidently in real-world clinical settings.", "short_description": "Designed to train CNAs in accurately measuring and interpreting patient blood pressure using an interactive, hands-on virtual scenario."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25580736881573831"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "30551028137877989", "version": "3.0"}, "id": "300889006417495", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25580736854907167", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "30551028137877989"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": 
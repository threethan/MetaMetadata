nc_oc=AdrKmsjyoE3lBfgk-NSk4CqiyMhGhwoyERAphsGTOeSxv6GCqcLOxhkG1aNexFlCKgY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-bTlZzdLRyVqG2Q-C2rQ6YJHRI-t_SY6pLa5wzJ-hjA&oe=6A9D6B47"}, {"file_name": "ss-04-16_9.png", "id": "1556301332604669", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623295_1556301335938002_4864557255247926541_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9CSMxfRwklEQ7kNvwENnhlD&_nc_oc=AdqZlYSQFQdkDgKAh7q8STDdaUb-qotDfIkdujD2Cpb9xtbn2VAcaifl76lI5xR_wwc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIjgFVNAVuk5dr_U9xcyBEekV3NSmKtbOfBtQymtMiwQ&oe=6A9D5A4A"}, {"file_name": "ss-02-16_9.png", "id": "1070212392191581", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619680_1070212395524914_8810705500349887763_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNsdLp-gjlgQ7kNvwHgUp7r&_nc_oc=Adqz7PFEqGclXzySAfip_2KLnjbS9gb8aHbFoA0wqOeal9Q4WebinEOn3QMPWUn9im8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4m34uMhztwewqxjmXhrsvNHL3dJfsV-hOcIfL1Nwufw&oe=6A9D8AA6"}, {"file_name": "ss-05-16_9.png", "id": "1407753674498512", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/673511715_1407753681165178_8741067753031307633_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfpCbPDPkcYQ7kNvwG_a5ms&_nc_oc=Adon5wjY1F54pGOIZpBNL-tWYoS-hQOWhgp8SEHUtyRoaQS1JJVrsjbOpEGjySK9Tlc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIIvIo4_xB3HieKXmWu1CThUnwZhobOGiGRU0CHJHRIQ&oe=6A9D55C5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PeekXR", "keywords": ["mirroring", "control", "streaming", "iPhone", "iPad"], "long_description": "# View your iPhone or iPad in Meta Quest\n\nPeekXR streams your iPhone or iPad screen over local Wi-Fi to a native, resizable window on Meta Quest.\n\n## Pair your devices\n\nScan the short-lived QR code or enter the four-digit pairing code shown on your iPhone or iPad. Before sharing starts, compare the matching six-digit security number on both devices.\n\n## Features\n\n- View screens in portrait or landscape.\n- Keep a native 2D window nearby in Meta Quest.\n- Hear supported app audio when screen sharing permits it.\n- Choose a display-quality profile for your Wi-Fi.\n- Resize and reposition the window with Meta Quest controls.\n\n## Optional control\n\nWith AssistiveTouch and Bluetooth setup completed, a Meta Quest controller can provide mouse-style control for a supported iPhone or iPad flow.\n\nPeekXR supports pointer movement, click, press-and-drag, and release. It does not provide multi-touch, keyboard input, general automation, or unrestricted remote control.\n\n## Privacy\n\nPeekXR uses authenticated pairing and encrypted local media transport. It does not require an account, include advertising, use a cloud relay, automatically record content, or include analytics.\n\n## Requirements\n\nYou need a compatible Meta Quest headset, the PeekXR companion app on an iPhone or iPad, and the same local Wi-Fi network. Screen sharing is started by the user. AssistiveTouch control is optional.\n\nSome protected content may appear black. Performance depends on your Wi-Fi and devices.\n\nPeekXR is independent and is not affiliated with Apple.", "short_description": "Keep your iPhone or iPad close without taking off your headset.\n\nPeekXR puts your screen in a native, resizable window on Meta Quest. Scan a short-lived QR code or enter a 4-digit pairing code, confirm the matching six-digit security number on both devices, then start sharing through Apple\u2019s system screen-sharing flow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://peekxr.net/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Corners Inc", "support_website_url": "https://discord.gg/33U3WZnGT", "website_url": "https://peekxr.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "36269221144
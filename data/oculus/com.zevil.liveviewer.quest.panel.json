 "3000x900.png", "id": "1031892449548538", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622214_1031892452881871_5185067683053716543_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9wGgi0KJM8Q7kNvwGxZNMo&_nc_oc=Adr0w9ciWJoQzjiifEfTR7o0LhfudfPLRSbW6SK9jLZzC6SJl31gC-0DV8EQLZtDrrc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4K6DxPvLU0GvmLMgxVnor4VtqYyjXd48R9N3kdjgb5Q&oe=6B008682"}]}, "id": "1711779043276036", "locale": "en_US", "screenshots": [{"file_name": "ss-03-16_9.png", "id": "2226973608135426", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619805_2226973611468759_5039385061144736892_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJqx2ltTE9gQ7kNvwEyta1O&_nc_oc=AdqQ8QhMd4dwJ0NvS9xRXgUBtoNcfCrSnl9Cphh0HVocGgWy_Vt0z4xjxjkXQbhg3TM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_AbiHHa1eJgIXbqvxRIDr8sXr2nOEPdhii-u3yjVpng&oe=6B005D75"}, {"file_name": "ss-01-16_9.png", "id": "2834323743615553", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623370_2834323746948886_2003082809264111891_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VARhXaPIPMgQ7kNvwH1oc9c&_nc_oc=AdoVDMLWRAaBIxOgSoh-TPNZthH18hA6b4RG7LOAvFOzSHK71u3q94Z0DEAoZeM-zxE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzqKTvtvFCtJsbc5IKingsLjG4uFz3PfAE7wI-VeCdMg&oe=6B008407"}, {"file_name": "ss-04-16_9.png", "id": "1556301332604669", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623295_1556301335938002_4864557255247926541_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLV_rgWoMVgQ7kNvwEnifzj&_nc_oc=Adryq3Ep-zwfseHlT1Fyosf3xwht0i9YK855zUEwxnfhd0K5NilgzA3-QOFUxCnG9h8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxxnDlT42T4lULfOtTz5oXLscgrB4z4XDiPWkip5LT2g&oe=6B00730A"}, {"file_name": "ss-02-16_9.png", "id": "1070212392191581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619680_1070212395524914_8810705500349887763_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3giBOYJEdq4Q7kNvwG9cBo5&_nc_oc=AdrpV3K0MaMkVoRLL0xS7xNDSW0L6V3bvBkELrN0D5f02X9OpsEq5FSGLc5fhgTinfU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2h8JdrckaPM0ZR3_ZSUyAW_YemuXc2NN-3SlNPqq6pA&oe=6B006B26"}, {"file_name": "ss-05-16_9.png", "id": "1407753674498512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673511715_1407753681165178_8741067753031307633_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mDW0rBKTW4Q7kNvwG9J90K&_nc_oc=AdqNgj_VRtRMz9BLLqDVglVCquXMsgUZdW8MtWTm9WnS_Wqaeej-UjhpyiN2Mz6PRUU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXkd4YtRMIJtVaIlu5AizVcgkzqJkBL2R_9Z6H65bZMA&oe=6B006E85"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PeekXR", "keywords": ["mirroring", "control", "streaming", "iPhone", "iPad"], "long_description": "# View your iPhone or iPad in Meta Quest\n\nPeekXR streams your iPhone or iPad screen over local Wi-Fi to a native, resizable window on Meta Quest.\n\n## Pair your devices\n\nScan the short-lived QR code or enter the four-digit pairing code shown on your iPhone or iPad. Before sharing starts, compare the matching six-digit security number on both devices.\n\n## Features\n\n- View screens in portrait or landscape.\n- Keep a native 2D window nearby in Meta Quest.\n- Hear supported app audio when screen sharing permits it.\n- Choose a display-quality profile for your Wi-Fi.\n- Resize and reposition the window with Meta Quest controls.\n\n## Optional control\n\nWith AssistiveTouch and Bluetooth setup completed, a Meta Quest controller can provide mouse-style control for a supported iPhone or iPad flow.\n\nPeekXR supports pointer movement, click, press-and-drag, and release. It does not provide multi-touch, keyboard input, general automation, or unrestricted remote control.\n\n## Privacy\n\nPeekXR uses authenticated pairing and encrypted local media transport. It does not require an account, include advertising, use a cloud relay, automatically record content, or include analytics.\n\n## Requirements\n\nYou need a compatible Meta Quest headset, the PeekXR companion app on an iPhone or iPad, and the same local Wi-Fi network. Screen sharing is started by the user. AssistiveTouch control is optional.\n\nSome protected content may appear black. Performance depends on your Wi-Fi and devices.\n\nPeekXR is independent and is not affiliated with Apple.", "short_description": "Keep your iPhone or iPad close without taking off your headset.\n\nPeekXR puts your screen in a native, resizable window on Meta Quest. Scan a short-lived QR code or enter a 4-digit pairing code, confirm the matching six-digit security number on both devices, then start sharing through Apple\u2019s system screen-sharing flow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://peekxr.net/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Corners Inc", "support_website_url": "https://discord.gg/33U3WZnGT", "website_url": "https://peekxr.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_HK", "zh_TW", "zh_CN", "fr", "da", "el", "de", "hi", "id", "it", "ja", "ko", "es", "th", "vi"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "
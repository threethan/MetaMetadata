 "3000x900.png", "id": "1031892449548538", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622214_1031892452881871_5185067683053716543_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bvrPe3p5tgQ7kNvwGiK5uV&_nc_oc=Adr0IsWWxzCNCbfUWsWPRfQSbcfWiE9cG14bmf9eWKhSm4WncE0UC4TT7EPtucQ7flE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6vJbafUm4_lO3YMWrZz0e0-MCDKRBYWqjsOl8xOdTZg&oe=6B032982"}]}, "id": "1711779043276036", "locale": "en_US", "screenshots": [{"file_name": "ss-03-16_9.png", "id": "2226973608135426", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619805_2226973611468759_5039385061144736892_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJqx2ltTE9gQ7kNvwExsdEU&_nc_oc=AdqN6ZWzVqrUYTDUk4GakBjVb3G7NeLR0u6FPQ95-3kBAWMNrosYaStwXNDhbNZ2a3U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_tHBX3e0luW-dKGBTJNavVPGmrfSSA4nQ6LwXLtdY1w&oe=6B030075"}, {"file_name": "ss-01-16_9.png", "id": "2834323743615553", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623370_2834323746948886_2003082809264111891_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uYRnBQsaMMQ7kNvwEXLGU1&_nc_oc=AdoLfdetKAsc-csaFdSwJCZ0smOl2eqqhkHmFf7bJSaSvSr34DYXY5JcE1ATFysRnL8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQigaKEfUfagj7XJ7ZYdUrwasKMr0PVIaA79p59wb7VTg&oe=6B032707"}, {"file_name": "ss-04-16_9.png", "id": "1556301332604669", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623295_1556301335938002_4864557255247926541_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KstNgGnQOrYQ7kNvwFoMV6R&_nc_oc=AdrWqhG1aAT0JY3khvaGtGykvLnLxPZU6djCl_2PFnyjqpB56DG0224zlIkUXjDo74I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpiOjRbApIafuWKyRzOoLS0QlUkHPLL20hlOiIiNDf7Q&oe=6B03160A"}, {"file_name": "ss-02-16_9.png", "id": "1070212392191581", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619680_1070212395524914_8810705500349887763_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGTI9S8qM1sQ7kNvwG-op5l&_nc_oc=Adou2v35w8ePVai1bDWYSQBAhkdFg8VC4OzoM746NG-jTvtQnReQev7JvWXcszmrEJs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlAOst8DhTwKas0DIB2S-K6BTVHXMPF9LRcF-pWaoxXw&oe=6B030E26"}, {"file_name": "ss-05-16_9.png", "id": "1407753674498512", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673511715_1407753681165178_8741067753031307633_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMpAVEeqcCoQ7kNvwHdc6nF&_nc_oc=AdrvIR4WrAbVjsv9nS3dbzTpiuwu1z5Ee1RvVF2L5RQU7Ntyx1c5h-cHEjm7l1qtnVI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIWB9xDKF3pFK1hOoALxsuKRfnrdRAPK4FZhOglqHGZg&oe=6B031185"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PeekXR", "keywords": ["mirroring", "control", "streaming", "iPhone", "iPad"], "long_description": "# View your iPhone or iPad in Meta Quest\n\nPeekXR streams your iPhone or iPad screen over local Wi-Fi to a native, resizable window on Meta Quest.\n\n## Pair your devices\n\nScan the short-lived QR code or enter the four-digit pairing code shown on your iPhone or iPad. Before sharing starts, compare the matching six-digit security number on both devices.\n\n## Features\n\n- View screens in portrait or landscape.\n- Keep a native 2D window nearby in Meta Quest.\n- Hear supported app audio when screen sharing permits it.\n- Choose a display-quality profile for your Wi-Fi.\n- Resize and reposition the window with Meta Quest controls.\n\n## Optional control\n\nWith AssistiveTouch and Bluetooth setup completed, a Meta Quest controller can provide mouse-style control for a supported iPhone or iPad flow.\n\nPeekXR supports pointer movement, click, press-and-drag, and release. It does not provide multi-touch, keyboard input, general automation, or unrestricted remote control.\n\n## Privacy\n\nPeekXR uses authenticated pairing and encrypted local media transport. It does not require an account, include advertising, use a cloud relay, automatically record content, or include analytics.\n\n## Requirements\n\nYou need a compatible Meta Quest headset, the PeekXR companion app on an iPhone or iPad, and the same local Wi-Fi network. Screen sharing is started by the user. AssistiveTouch control is optional.\n\nSome protected content may appear black. Performance depends on your Wi-Fi and devices.\n\nPeekXR is independent and is not affiliated with Apple.", "short_description": "Keep your iPhone or iPad close without taking off your headset.\n\nPeekXR puts your screen in a native, resizable window on Meta Quest. Scan a short-lived QR code or enter a 4-digit pairing code, confirm the matching six-digit security number on both devices, then start sharing through Apple\u2019s system screen-sharing flow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://peekxr.net/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Corners Inc", "support_website_url": "https://discord.gg/33U3WZnGT", "website_url": "https://peekxr.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_HK", "zh_TW", "zh_CN", "fr", "da", "el", "de", "hi", "id", "it", "ja", "ko", "es", "th", "vi"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "
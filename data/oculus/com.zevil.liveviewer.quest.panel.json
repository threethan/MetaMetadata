 "3000x900.png", "id": "1031892449548538", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622214_1031892452881871_5185067683053716543_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9wGgi0KJM8Q7kNvwH876Bw&_nc_oc=AdpzLjdhpkfDUryBOdGnYqNJInpL4bLs_t1kkiv10-g9yYzngUpZ6AHtt76siLwPro8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx8ZNV8B3tPdgG2NPMcbdhaCVFT3XpZscA5f5J-0bS8w&oe=6B01D802"}]}, "id": "1711779043276036", "locale": "en_US", "screenshots": [{"file_name": "ss-03-16_9.png", "id": "2226973608135426", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619805_2226973611468759_5039385061144736892_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJqx2ltTE9gQ7kNvwEmbdeX&_nc_oc=AdoVx_xTZ8i0WSxGl1GDpGs99ySXvG1mKH5DJbMX3LnAtdW6UMRXkompqNdZ8Hi0TLc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjLL4kVbo0O47hM1EiFc_zDPAtasLn_M6nH6eBCVxGnw&oe=6B01E735"}, {"file_name": "ss-01-16_9.png", "id": "2834323743615553", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623370_2834323746948886_2003082809264111891_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uYRnBQsaMMQ7kNvwEixe_Y&_nc_oc=AdpF28dk2Y2jrzv0tSo6Vp7Y7jWIhZyWK3YLpTmJ3TiEyESXuogC_3Hw3tY5P61nHF4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKK3N1gtbB8H9O8TlZCPIilVLy2nXsRH0FpnRBFmZXhA&oe=6B01D587"}, {"file_name": "ss-04-16_9.png", "id": "1556301332604669", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623295_1556301335938002_4864557255247926541_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLV_rgWoMVgQ7kNvwF63Meo&_nc_oc=AdrdsS-IqhR_fr5GWWV-zxWk5SIpkA5l1JJuwb_TdFgYxzF3JwpcdDV79SD6gwBzY2E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFqIBqVQIiKq0Xhxq6xMTfqaftoTKDfgdjV1YyHhi7ig&oe=6B01C48A"}, {"file_name": "ss-02-16_9.png", "id": "1070212392191581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619680_1070212395524914_8810705500349887763_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGTI9S8qM1sQ7kNvwGSlgYn&_nc_oc=AdqX9BcIcmcTVmXNhOV7TxUtpiJ6uYRShwZAVFBubIEWX4dleqGVf-j2pdGFcrxt5-w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFSTAcpcQu7ak_FvGvFrdFKXVcd7bTxEmIMhhHlHZ-Kw&oe=6B01BCA6"}, {"file_name": "ss-05-16_9.png", "id": "1407753674498512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673511715_1407753681165178_8741067753031307633_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mDW0rBKTW4Q7kNvwEFbZqp&_nc_oc=AdohBBXUOlW4jBhqzhozAqq5xr5XFefAJ5_1gaE7Qf-NXvuNxpJdomkgwuDl6Wcb8bk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOjik83h-MO2_u2TNPdwdfb8jno6GLDWR9IyFBTc-47g&oe=6B01C005"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PeekXR", "keywords": ["mirroring", "control", "streaming", "iPhone", "iPad"], "long_description": "# View your iPhone or iPad in Meta Quest\n\nPeekXR streams your iPhone or iPad screen over local Wi-Fi to a native, resizable window on Meta Quest.\n\n## Pair your devices\n\nScan the short-lived QR code or enter the four-digit pairing code shown on your iPhone or iPad. Before sharing starts, compare the matching six-digit security number on both devices.\n\n## Features\n\n- View screens in portrait or landscape.\n- Keep a native 2D window nearby in Meta Quest.\n- Hear supported app audio when screen sharing permits it.\n- Choose a display-quality profile for your Wi-Fi.\n- Resize and reposition the window with Meta Quest controls.\n\n## Optional control\n\nWith AssistiveTouch and Bluetooth setup completed, a Meta Quest controller can provide mouse-style control for a supported iPhone or iPad flow.\n\nPeekXR supports pointer movement, click, press-and-drag, and release. It does not provide multi-touch, keyboard input, general automation, or unrestricted remote control.\n\n## Privacy\n\nPeekXR uses authenticated pairing and encrypted local media transport. It does not require an account, include advertising, use a cloud relay, automatically record content, or include analytics.\n\n## Requirements\n\nYou need a compatible Meta Quest headset, the PeekXR companion app on an iPhone or iPad, and the same local Wi-Fi network. Screen sharing is started by the user. AssistiveTouch control is optional.\n\nSome protected content may appear black. Performance depends on your Wi-Fi and devices.\n\nPeekXR is independent and is not affiliated with Apple.", "short_description": "Keep your iPhone or iPad close without taking off your headset.\n\nPeekXR puts your screen in a native, resizable window on Meta Quest. Scan a short-lived QR code or enter a 4-digit pairing code, confirm the matching six-digit security number on both devices, then start sharing through Apple\u2019s system screen-sharing flow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://peekxr.net/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Corners Inc", "support_website_url": "https://discord.gg/33U3WZnGT", "website_url": "https://peekxr.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_HK", "zh_TW", "zh_CN", "fr", "da", "el", "de", "hi", "id", "it", "ja", "ko", "es", "th", "vi"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "
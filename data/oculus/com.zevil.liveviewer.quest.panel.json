f&oh=00_AQOjDKg7TIxoQycqLGKnQe04nQMlTXaIobEulZSyl7qDBw&oe=6AC7BAA6"}, {"file_name": "ss-05-16_9.png", "id": "1407753674498512", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/673511715_1407753681165178_8741067753031307633_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7OBG6yEPccQ7kNvwGc3Q4V&_nc_oc=AdqZ-OA41ZsS7uB3V0oxiasqDhhB_N7pzSpFrISFBcjCNWA_WoOe7xI7lsVSexoQtMg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlwjJatH89WA3gnl-hhyuzYRC2IVOT-WRlI5nAffpRgA&oe=6AC7BE05"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PeekXR", "keywords": ["mirroring", "control", "streaming", "iPhone", "iPad"], "long_description": "# View your iPhone or iPad in Meta Quest\n\nPeekXR streams your iPhone or iPad screen over local Wi-Fi to a native, resizable window on Meta Quest.\n\n## Pair your devices\n\nScan the short-lived QR code or enter the four-digit pairing code shown on your iPhone or iPad. Before sharing starts, compare the matching six-digit security number on both devices.\n\n## Features\n\n- View screens in portrait or landscape.\n- Keep a native 2D window nearby in Meta Quest.\n- Hear supported app audio when screen sharing permits it.\n- Choose a display-quality profile for your Wi-Fi.\n- Resize and reposition the window with Meta Quest controls.\n\n## Optional control\n\nWith AssistiveTouch and Bluetooth setup completed, a Meta Quest controller can provide mouse-style control for a supported iPhone or iPad flow.\n\nPeekXR supports pointer movement, click, press-and-drag, and release. It does not provide multi-touch, keyboard input, general automation, or unrestricted remote control.\n\n## Privacy\n\nPeekXR uses authenticated pairing and encrypted local media transport. It does not require an account, include advertising, use a cloud relay, automatically record content, or include analytics.\n\n## Requirements\n\nYou need a compatible Meta Quest headset, the PeekXR companion app on an iPhone or iPad, and the same local Wi-Fi network. Screen sharing is started by the user. AssistiveTouch control is optional.\n\nSome protected content may appear black. Performance depends on your Wi-Fi and devices.\n\nPeekXR is independent and is not affiliated with Apple.", "short_description": "Keep your iPhone or iPad close without taking off your headset.\n\nPeekXR puts your screen in a native, resizable window on Meta Quest. Scan a short-lived QR code or enter a 4-digit pairing code, confirm the matching six-digit security number on both devices, then start sharing through Apple\u2019s system screen-sharing flow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://peekxr.net/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Corners Inc", "support_website_url": "https://discord.gg/33U3WZnGT", "website_url": "https://peekxr.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_HK", "zh_TW", "zh_CN", "fr", "da", "el", "de", "hi", "id", "it", "ja", "ko", "es", "th", "vi"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1185054708031428"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623370_1043118735086458_7917264586786631809_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6b2eBzmPF4EQ7kNvwGYMBHN&_nc_oc=AdqCykJ5OO-zBemxJm5YB7m2Liggb_qmJ5K4sQ
CeTVC0z-o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZoqtxP8VsFbAZ0Us1Uui2GIqykSL6k7x2PNnKSiJqgw&oe=6B05A570"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 16_9 2560x1440.png", "id": "632606201707135", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974581_632606205040468_3580057126700440301_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDA-gmHCJLYQ7kNvwH5-a5j&_nc_oc=Adq7JY3PmpUm3qZHsURH8SkAslSoiMq_nOuf7T7UkG5M3s4DltqeXttjMF-tdVFq8bw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfnJCKzQNeVa3B3X8AkkFIx9QQ-eSoDU0PHb6uMadiKQ&oe=6B05AE1D"}, "display_name": "Resolve", "keywords": ["resolve", "navisworks", "BIM", "revit", "construction"], "long_description": "Resolve allows teams building complex construction projects to review large building information model (BIM) projects on the Meta Quest in a collaborative environment. Resolve\u2019s ability to handle the biggest 3D models enables teams to simulate maintenance, safety and accessibility issues earlier than ever before and without hassle. From cutting edge biopharma facilities to wind farms and data centers, Resolve delivers unparalleled performance on wireless VR headsets without the need to section models, stream, or use a hefty PC.\n\nResolve provides teams with a suite of powerful tools including logging issues via speech-to-text, measuring, inspecting BIM properties, viewing 2D plans, review scheduling, issue status and tagging, analytics, AR and more. \n\nResolve requires an Autodesk Construction Cloud account to bring model data into VR and sync issues. Resolve can be used to review Revit, Navisworks, and 70 other file formats supported by BIM 360 Docs.", "short_description": "Resolve allows teams building complex construction projects to review large BIM projects on the Meta Quest in a collaborative environment. Resolve\u2019s ability to handle the biggest 3D models enables teams to simulate maintenance, safety and accessibility issues earlier than ever before. From cutting edge biopharma facilities to wind farms and data centers, Resolve delivers unparalleled performance on wireless VR headsets without the need to section your model, stream, or use a hefty PC."}]}, "developer_name": "Resolve", "developer_privacy_policy_url": "https://www.resolvebim.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Resolve", "support_website_url": "https://support.resolvebim.com/", "website_url": "https://www.resolvebim.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "603979761403619"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "8583692448382792"}, {"status": "PUBLISHED", "id": "383924020622760"}]}, "baseline_offer": {"id": "8583692448382792"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1733343300, "status": "PUBLISHED", "id": "8583692448382792"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "40041013108875610", "version": "2.29.2.0"}, "id": "589675279560836", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7860400317363640", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40041013108875610"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "589675279560836"}]}, "change_log": "# Resolve Quest 2.29.2\n\n## What's new\n- Five quick trigger clicks on the pairing code show a Configuration dropdown for switching between Production and Staging; the same clicks hide it again.\n- The Configuration dropdown always stays visible while the app is set to Staging.\n- Changing the server requests a new pairing code, and a login saved for the other server asks you to pair again.\n\n## Fixes\n- Recording an avatar session without a microphone, or with microphone permission denied, now works and saves a silent voice track.\n- Team tabs no longer appear twice after a slow or failed load.\n- One broken organization or project no longer hides the rest of the project list.\n- Saved views in federated models now restore the right hidden elements.\n- AI Copilot replies no longer show garbled special characters.\n- An interrupted model download no longer leaves a half-downloaded model behind.\n\n## Please test\n- Pairing, guest join, and switching between Production and Staging with the Configuration dropdown, including after restarting the app.\n- Project list, team tabs, and opening and downloading models, including federated models.\n- Annotations, views, recordings (also with microphone permission denied), properties, measurements, media, AI Copilot, integrations and remote launch.\n- With the network off: the project list, a cached project and a downloaded model open, uncached projects are greyed out, and going back online refreshes everything.\n- The offline cache after updating from the current release, after logging out and back in, and after switching accounts.\n- A general pass through all menus and tools, since the app moved to a newer Unity version and unused content was removed.\n\nIncluded: #1218, #1247, #1252, #1253, #1254, #1257, #1258, #1259, #1260, #1261, #1262, #1267", "created_date": 1795079740, "id": "40041013108875610", "version": "2.29.2.0", "version_code": 461860, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7860400317363640", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40041013108875610"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1794222092, "id": "39772966972346893", "version": "2.29.0.0", "version_code": 449803, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7860400317363640", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40041013108875610"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "589675279560836"}]}, "change_log": null, "created_date": 1790194469, "id": "38583139547996314", "version": "2.29.0.0", "version_code": 123, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7860400317363640", "is_concept": false, "latest_released_binary":
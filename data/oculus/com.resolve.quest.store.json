fN3FniwcfgIAT2nh3meJhba_l8jyDJ2mGU4mRD7xtX3nRDW3BM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS-HjPwEt4HN9H_gg4Hjf5waRDHxmpDNI6YW_1AyXZnA&oe=6B05A6A5"}, {"file_name": "screenshot-3.png", "id": "1242489879924074", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974629_1242489883257407_564176362352651660_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yzdKbIIuscQ7kNvwFGBMHO&_nc_oc=AdruJ9pOTYpQowEpvxYdmXSHwG0s_e9J_PdM9PMYMWqDvnE_zkBM79w7YMB_Oa04Vm0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQonBujjo89iazdhbO66XQ819-A6jf-hgk7f1nROFn1yQ&oe=6B05A312"}, {"file_name": "resolve_dollhouse.png", "id": "857851418610760", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572942_857851421944093_1476812933831066693_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9tGxnaSk2MQ7kNvwGSM4VZ&_nc_oc=AdphLKnGPCSTgaF3iEEGJsehUpJAYShbtXSQ9PewEosWC6ZNYJOgP4rKcrW4uE68tEQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4EizTAFUzl7dK8snCHPmS4Q871Xp2aBzfdv1WyJ39EQ&oe=6B05A885"}, {"file_name": "resolve_safety_clearance.png", "id": "508158168162126", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348033_508158171495459_5989792137390672329_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDR0-y7MLoAQ7kNvwGESzfl&_nc_oc=AdrHKy6UTuYp1QqfHWDA7Y7b_8RAx3jSmVDhRc-DsPH7iRoUhT0lYEvV5FUBWd4Dqek&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzTcCSCD0kzb2eYNW-Fi14yJHOM6ePCuRYEOw8MEnNTQ&oe=6B05CD04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 16_9 2560x1440.png", "id": "25629477436709688", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618499_25629477443376354_3487949035158076340_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6GVl0GT1pYQ7kNvwFIqNMm&_nc_oc=Adq-Ea8doRD9Iv277SRPLSvIG54YcEJzR_dzHLcIXkLbsP8hf0TZ1CT8SIRVrvUc4ns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTW3y5fyOyw0rWf9N3rehedNwG-KrBRi6MvFPo4NXXoDQ&oe=6B05A354"}, "display_name": "Resolve BIM VR", "keywords": ["resolve", "navisworks", "BIM", "revit", "construction"], "long_description": "Resolve allows teams building complex construction projects to review large building information model (BIM) projects in VR with Meta Quest in a collaborative environment. Resolve\u2019s ability to handle the biggest 3D models enables teams to simulate maintenance, safety and accessibility issues earlier than ever before and without hassle. From cutting edge biopharma facilities to wind farms and data centers, Resolve delivers unparalleled performance on wireless VR headsets without the need to section models, stream, or use a hefty PC.\n\nResolve provides teams with a suite of powerful tools including logging issues via speech-to-text, measuring, inspecting BIM properties, viewing 2D plans, review scheduling, issue status and tagging, analytics, AR and more. \n\nResolve requires an Autodesk Construction Cloud account to bring model data into VR and sync issues. Resolve can be used to review Revit, Navisworks, and 70 other file formats supported by BIM 360 Docs.", "short_description": "Resolve allows teams building complex construction projects to review large BIM projects in VR with the Meta Quest in a collaborative environment. Resolve\u2019s ability to handle the biggest 3D models enables teams to simulate maintenance, safety and accessibility issues earlier than ever before. From cutting edge biopharma facilities to wind farms and data centers, Resolve delivers unparalleled performance on wireless VR headsets without the need to section your model, stream, or use a hefty PC."}]}, "developer_name": "Resolve", "developer_privacy_policy_url": "https://www.resolvebim.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Resolve", "support_website_url": "https://support.resolvebim.com/", "website_
_uEM6Eih55UR7pngiJ3MEBSW2f_4X9T-2HiISHg6RepZ65qCAE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVf9TR-KP9rA1GrrQrwd2_Qlpbyn9B9zew_YloItZk2dA&oe=6B106AE5"}, {"file_name": "screenshot-3.png", "id": "1242489879924074", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974629_1242489883257407_564176362352651660_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6h5cP1SF5VQQ7kNvwGnUvGZ&_nc_oc=AdrfMIfJwrjV5MGWssO0brZeGkxe_jaVyPzpxz1crWDFgoOvgI52x3pFmLenYckDluU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXucLC1rDbKmE9oNVTcpiMz4zw-2VdU79m1RHbfO6DZtg&oe=6B106752"}, {"file_name": "resolve_dollhouse.png", "id": "857851418610760", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572942_857851421944093_1476812933831066693_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7GM5iOmpF8Q7kNvwF4SU7D&_nc_oc=AdpvDwi6gePgA4idCqHxxpV3PPyBpnyKjym2odS702tF1Pvr7Ccx_S90naRXocy2Jig&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW32PQvIVbT7UY2Z4x5QjCnbyGYJxEVIA8pkAEqR3vBIQ&oe=6B106CC5"}, {"file_name": "resolve_safety_clearance.png", "id": "508158168162126", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348033_508158171495459_5989792137390672329_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0V193HDd1MQ7kNvwESGFFC&_nc_oc=AdorYyfZm2xP9CBfwinKKwT23B97QNVkcjwQpwoDgWAcBlpisX-8Dd9jfAMc5TUZqb0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV_NLnsh3TZ2Qqup9oQCksB3KO8OcZf-LqhByK0FBT5ow&oe=6B105904"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 16_9 2560x1440.png", "id": "25629477436709688", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618499_25629477443376354_3487949035158076340_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_cpFOYmfDMQ7kNvwHySQQy&_nc_oc=Adr8DZMeGEm1lSq6IcB_cQBQqkVn0od3EO1yzk3071NoH_bisn0Jg7kgXjEpTYji3uU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVozG_UvqL-16BdQb6R0PZvDrw5oGnRW6KLt3dodCpqXQ&oe=6B106794"}, "display_name": "Resolve BIM VR", "keywords": ["resolve", "navisworks", "BIM", "revit", "construction"], "long_description": "Resolve allows teams building complex construction projects to review large building information model (BIM) projects in VR with Meta Quest in a collaborative environment. Resolve\u2019s ability to handle the biggest 3D models enables teams to simulate maintenance, safety and accessibility issues earlier than ever before and without hassle. From cutting edge biopharma facilities to wind farms and data centers, Resolve delivers unparalleled performance on wireless VR headsets without the need to section models, stream, or use a hefty PC.\n\nResolve provides teams with a suite of powerful tools including logging issues via speech-to-text, measuring, inspecting BIM properties, viewing 2D plans, review scheduling, issue status and tagging, analytics, AR and more. \n\nResolve requires an Autodesk Construction Cloud account to bring model data into VR and sync issues. Resolve can be used to review Revit, Navisworks, and 70 other file formats supported by BIM 360 Docs.", "short_description": "Resolve allows teams building complex construction projects to review large BIM projects in VR with the Meta Quest in a collaborative environment. Resolve\u2019s ability to handle the biggest 3D models enables teams to simulate maintenance, safety and accessibility issues earlier than ever before. From cutting edge biopharma facilities to wind farms and data centers, Resolve delivers unparalleled performance on wireless VR headsets without the need to section your model, stream, or use a hefty PC."}]}, "developer_name": "Resolve", "developer_privacy_policy_url": "https://www.resolvebim.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Resolve", "support_website_url": "https://support.resolvebim.com/", "website_
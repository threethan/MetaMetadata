d5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yZgHzzXq7AsDQW-KA7Vou7Yolk-KCfhEkJEO1lqWJ0g&oe=6A19A3A3"}, {"file_name": "screenshot-5.png", "id": "1166903220837624", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974721_1166903224170957_8970893775140039993_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvwX-A74Co0Q7kNvwEplWIX&_nc_oc=AdqKkU1ivH1EOofU693LBqBICA9KvRDmY44xjRMAaIhMUKeYBMZgEA1tZL9Ri812fY0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6o4qD_8HRTAKJSFHnlsADHsYejdKMqXdS1PDFE1QHTlQ&oe=6A19A8F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 16_9 2560x1440.png", "id": "632606201707135", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974581_632606205040468_3580057126700440301_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=neXKFMrdKRQQ7kNvwF7uHeu&_nc_oc=AdpAugJPghWwtKcrtdo_-u7hukEhD1BxlZfPKrQKN9Ap4aNMYT5zeGZ2IIm3eVyvLxQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78XN9HDfbb9YZ_dTxjAoxIzQf-4-MlbzKrK3OKaUBu4g&oe=6A19B19D"}, "display_name": "Resolve", "keywords": ["resolve", "navisworks", "BIM", "revit", "construction"], "long_description": "Resolve allows teams building complex construction projects to review large building information model (BIM) projects on the Meta Quest in a collaborative environment. Resolve\u2019s ability to handle the biggest 3D models enables teams to simulate maintenance, safety and accessibility issues earlier than ever before and without hassle. From cutting edge biopharma facilities to wind farms and data centers, Resolve delivers unparalleled performance on wireless VR headsets without the need to section models, stream, or use a hefty PC.\n\nResolve provides teams with a suite of powerful tools including logging issues via speech-to-text, measuring, inspecting BIM properties, viewing 2D plans, review scheduling, issue status and tagging, analytics, AR and more. \n\nResolve requires an Autodesk Construction Cloud account to bring model data into VR and sync issues. Resolve can be used to review Revit, Navisworks, and 70 other file formats supported by BIM 360 Docs.", "short_description": "Resolve allows teams building complex construction projects to review large BIM projects on the Meta Quest in a collaborative environment. Resolve\u2019s ability to handle the biggest 3D models enables teams to simulate maintenance, safety and accessibility issues earlier than ever before. From cutting edge biopharma facilities to wind farms and data centers, Resolve delivers unparalleled performance on wireless VR headsets without the need to section your model, stream, or use a hefty PC."}]}, "developer_name": "Resolve", "developer_privacy_policy_url": "https://www.resolvebim.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Resolve", "support_website_url": "https://support.resolvebim.com/", "website_url": "https://www.resolvebim.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "603979761403619"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "8583692448382792"}, {"status": "PUBLISHED", "id": "383924020622760"}]}, "baseline_offer": {"id": "8583692448382792"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1733343300, "status": "PUBLISHED", "id": "8583692448382792"}]}, "liveChan
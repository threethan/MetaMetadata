Q7kNvwGa7vWX&_nc_oc=Adrn_T0X5nV0EQReX3hAx7K5CyCXBcfHffEVPf6tv5K1exKV8E5ldl4rpHoMfZ5IhPw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7u7P_TUqwvANDbYuXLaU1KTXauf9Ws6-N7MIt1ebQ_g&oe=6AC26821"}, {"file_name": "HomeImage5png.png", "id": "2320810755007320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_2320810758340653_4893841411744106514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQzn0-mSjcwQ7kNvwEqJ0tq&_nc_oc=AdrQN6QM1ZrobfE4RLycHGPIlDR_rh19EtGU1qb8RWX_GkADEP652uIB1aVro81Kzrs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxsrvsBktFhSqTl7cXd5C_WxxnSAbdxSsS0n-Ngmn-Bg&oe=6AC25DD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OfficialGameCover2.png", "id": "815390247797291", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618264_815390251130624_6194725884521364425_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGHB5ZGrI6cQ7kNvwHSo2X7&_nc_oc=AdokNOOX6OBuLK2VskJwtNwUpjMBpU9hgLaN5CkEQ64p_B6LU2CWzj725Cs7dw-AX1k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIj-a85Ze1B7ZB2MvZuotRjQoWhTCrwCOf5cFv8QPFoQ&oe=6AC27ADA"}, "display_name": "Glass Grapple", "keywords": ["Grapple", "Retro", "Music", "Challenging", "Leaderboard"], "long_description": "\nGLASS GRAPPLE hurls you into a neon-drenched world of rhythm, precision, and pure velocity. A synthwave playground of shifting walls, narrow tunnels, and two rainbow-charged grapples that feel like extensions of your own hands.\n\nSwing, slingshot, and bend your momentum through 25 levels, and 5 increasingly challenging Endless modes. \nActivate slow-motion and carve impossible paths through the grid-lit world as the environment pulses to the music.\n\nNo hand-holding. No rails.\nJust you, your reflexes, and the hypnotic urge to take one more swing.\n\nEvery grapple is a decision.\nEvery wall is a challenge.\nEvery run becomes a dance between chaos and control.\n\nMaster the movement and swing your way to the top of the leaderboard. \n\nWelcome to Glass Grapple. ", "short_description": "Swing through neon walls with dual rainbow grapples in a retro-synthwave world.\nDodge shifting holes, navigate twisting tunnels, and watch the world react to the music.\n\nIt's just you and your momentum. Bend it to your will. \n\nFast. Fluid. Addictive. Welcome to Glass Grapple."}]}, "developer_name": null, "developer_privacy_policy_url": "https://glassfrogstudios.com/PrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Glass Frog Studios", "support_website_url": null, "website_url": "https://glassfrogstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25213746181625323"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1608162167137969"}, {"status": "PUBLISHED", "id": "24912306288398676"}]}, "baseline_offer": {"id": "24912306288398676"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775930400, "status": "PUBLISHED", "id": "1608162167137969"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28305395112460399", "version": "1.5.6"}, "id": "1118241703752342", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__type
i": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823431_3938472753119792_6710512630970842491_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ub36LKpM6jsQ7kNvwHqXg1Y&_nc_oc=Ado2UDgqc3YcK-bTt8n1OR_5KGnXgS7mwD4qwSoCc2Xtmi6J65r3ozTI0kDndqWIz3Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJw5wsSSoJmFpOegLzVOkYsJT-SiZXhnhkeE7uuo37YPQ&oe=6ABD33E9"}, {"file_name": "HomeImage4png.png", "id": "1912141250179195", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298360_1912141253512528_21616095703866090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHyj6qWjQ0AQ7kNvwGsUyzz&_nc_oc=AdrvqBWOuvBoSKOr2fy1gQrrzEVWVI7UlFCJD9hC_0MB5DZCWCIjhMlQrlXQxiLti7M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL13Emzob7ZOijs40HPKzIgkJF84HosrP5HC_bWQVtf7Q&oe=6ABD2221"}, {"file_name": "HomeImage5png.png", "id": "2320810755007320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822034_2320810758340653_4893841411744106514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CL2lqX2eBqwQ7kNvwFB9ofH&_nc_oc=AdqUqXMxoZAbxbqoJyoFnEJnfvbKUn9Y10DCGfo3C8E29cD2ATVvUm8DaMgc6caLc1E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLGYLqCy74u8bdgRBhYDfiVi20GBQOR5-o6mb5B4P3gw&oe=6ABD17D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OfficialGameCover2.png", "id": "815390247797291", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618264_815390251130624_6194725884521364425_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_CuVi0r9KIQ7kNvwGRkXTG&_nc_oc=Adqmtvx-741pQYZE7uw0bVs2hWyeigdY2NvTnZMppuT8_cX5xmG1XqNmtc-gwUzl5Bo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKg_35BiF7cQfUqnQuXa8zv7Dj7CnAYusYmGEKbuCTLAg&oe=6ABD34DA"}, "display_name": "Glass Grapple", "keywords": ["Retro", "Music", "Challenging", "Leaderboard"], "long_description": "**Glass Grapple began as a college graphics final project \u2014 and grew into a full VR game built entirely from scratch.**\n\nThe goal was to make a game that feels fast, fluid, and satisfying to move through \u2014 a synthwave world full of tight tunnels, shifting walls, with grapple physics that feel real. \n\nSwing, slingshot, and bend your momentum through **25 levels**, and **5 increasingly challenging Endless modes.**\n\nAdjust the speed of the game and master the movement to swing your way to the top of the leaderboards. \n\nGlass Grapple features an **original, layered, synthwave soundtrack** that evolves as you progress.\n\nBuilt from the ground up. Welcome to **Glass Grapple**. \n\nTry racing your friends through all the levels with **Multiplayer**!\n{2128568781026198}\n\nPress **Trigger** to shoot a grapple\n\nHold **Trigger** to reel in\n\nPress **Grip Button** to release\n{1164215599245917}\n\n**Pull** the rope to propel yourself\n{2325598044622467}\n\nActivate **slo-mo** for more control\n{1630402595038913}\n\nAdjust the **game speed** to your comfort level\n{33291366220477653}\n", "short_description": "Glass Grapple is a challenging but deeply satisfying VR grappling game built from scratch and focused on pure movement.\n\nNow with Multiplayer!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://glassfrogstudios.com/PrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Glass Frog Studios", "support_website_url": null, "website_url": "https://glassfrogstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOU
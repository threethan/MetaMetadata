EMgGI-r6lfoRuiU5E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlcZJbChHgmWZ753DkqqgBAZyObypWF3iU8OHTiBVXKg&oe=6AFB4A4E"}, {"file_name": "HomeImage3png.png", "id": "3938472749786459", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823431_3938472753119792_6710512630970842491_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QMHxfQVoU0Q7kNvwHz-7KS&_nc_oc=AdoC1nE6eZ-Y7t1AS9fe_AB9qNLF_ySDqIvbEcESAeebZkjkaIB2fFdlGtycFwJk5ck&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcOPUbjNE7sfTn1MNfGybePXjz4nhH2LYS8_U9Z0b8iw&oe=6AFB2A69"}, {"file_name": "HomeImage4png.png", "id": "1912141250179195", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499298360_1912141253512528_21616095703866090_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2h9RS5Vi38Q7kNvwE3bkf2&_nc_oc=AdoCnHQkjbn8zM40wnTbav_tuod4w0U3qRkjy4uPowRLV6sp2kXNEWXNRxcywu5yZ8k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVZnotZso2yzxzZB3K56Gg1Z9iZBZBQystaKLpwnsJNg&oe=6AFB18A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OfficialGameCover2.png", "id": "815390247797291", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618264_815390251130624_6194725884521364425_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wk2-dAyngV4Q7kNvwHRq_dh&_nc_oc=Adq2N_YRRxZoQ1rmvQzaMDDFouQGk1usuYMBkAbbQTqcXZ_qE5-OyVszLPZN4IRI2mw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQE--U2lQt7VlvReHQXfX4XTYijZ3fshdfUFlv6SQqoDA&oe=6AFB2B5A"}, "display_name": "Glass Grapple", "keywords": ["Retro", "Music", "Challenging", "Leaderboard", "Movement"], "long_description": "The **first 5 levels** and **Endless 1** are now **free!** \n\n**Glass Grapple began as a college graphics final project \u2014 and grew into a full VR game built entirely from scratch.**\n\nThe goal was to make a game that feels fast, fluid, and satisfying to move through.\n\nSwing, slingshot, and bend your momentum through **25 levels**, and **5 increasingly challenging Endless modes.**\n\nAdjust the speed of the game and master the movement to swing your way to the top of the leaderboards. \n\nGlass Grapple features an **original, layered, synthwave soundtrack** that evolves as you progress.\n\nBuilt from the ground up. Welcome to **Glass Grapple**. \n\nPress **Trigger** to shoot a grapple\n\nHold **Trigger** to reel in\n\nPress **Grip Button** to release\n{1164215599245917}\n\n**Pull** the rope to propel yourself\n{2325598044622467}\n\nActivate **slo-mo** for more control\n{1630402595038913}\n\nAdjust the **game speed** to your comfort level\n{33291366220477653}\n\nPress the right thumb stick to toggle **replay modes**, to race yourself and other players. \n{2182344339160233}\n\nTry racing your friends through all the levels with **Multiplayer**!\n{2128568781026198}\n", "short_description": "Glass Grapple is a challenging but deeply satisfying VR grappling game built from scratch and focused on pure movement.\n\nNow with Multiplayer!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://glassfrogstudios.com/PrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Glass Frog Studios", "support_website_url": null, "website_url": "https://glassfrogstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTIN
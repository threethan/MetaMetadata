i": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823431_3938472753119792_6710512630970842491_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqFaRTTvfqYQ7kNvwEmFtYL&_nc_oc=AdptH9CCOFxCvz-hiiQmlm-xbas4Oqo2DFbxg4hEJTY4mAk0rDNCwTg6BFuaOOP_Npk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPnRL1M6fbFposbCmQUX6C6eFjyHeSi7quoXkAEEQlxA&oe=6AD24BE9"}, {"file_name": "HomeImage4png.png", "id": "1912141250179195", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298360_1912141253512528_21616095703866090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_FrAkW8N15AQ7kNvwH_mZm_&_nc_oc=AdrP21XHoHIqo9LQKwHzkVl5Wi7QJf25UIuzlXkw2HsK_88z4OaifFlxUnkl4Bif9v4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDyfSQSe5edA6SipMw3a80Tk2DdbjoVAEHTBb5jSXdAg&oe=6AD23A21"}, {"file_name": "HomeImage5png.png", "id": "2320810755007320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_2320810758340653_4893841411744106514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yog3SejgGZQQ7kNvwGqocyD&_nc_oc=AdrmLxIn6dx6kHyT2UyDeqgKUWeGrT4L3Dm8YyxbTBiK9q0xJwCUXmPshe640-DyAvk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgGjlU2zYrSKo22mDC5aFrvFpr3DguTh5dv2GVfBymCw&oe=6AD22FD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OfficialGameCover2.png", "id": "815390247797291", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618264_815390251130624_6194725884521364425_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJBJAKvdvXYQ7kNvwGk2ujM&_nc_oc=Ado6gXJotm57Mjjqgzpl4J3J1uCRDubXs61zAh75rQ0wD2BycmU0PQiR99eKvZv7PdI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFFOsDwZEj--OSHX-pyKk8gOk2wNt8aSl5hEGBZuZ08A&oe=6AD24CDA"}, "display_name": "Glass Grapple", "keywords": ["Retro", "Music", "Challenging", "Leaderboard"], "long_description": "**Glass Grapple began as a college graphics final project \u2014 and grew into a full VR game built entirely from scratch.**\n\nThe goal was to make a game that feels fast, fluid, and satisfying to move through \u2014 a synthwave world full of tight tunnels, shifting walls, with grapple physics that feel real. \n\nSwing, slingshot, and bend your momentum through **25 levels**, and **5 increasingly challenging Endless modes.**\n\nAdjust the speed of the game and master the movement to swing your way to the top of the leaderboards. \n\nGlass Grapple features an **original, layered, synthwave soundtrack** that evolves as you progress.\n\nBuilt from the ground up. Welcome to **Glass Grapple**. \n\nTry racing your friends through all the levels with **Multiplayer**!\n{2128568781026198}\n\nPress **Trigger** to shoot a grapple\n\nHold **Trigger** to reel in\n\nPress **Grip Button** to release\n{1164215599245917}\n\n**Pull** the rope to propel yourself\n{2325598044622467}\n\nActivate **slo-mo** for more control\n{1630402595038913}\n\nAdjust the **game speed** to your comfort level\n{33291366220477653}\n", "short_description": "Glass Grapple is a challenging but deeply satisfying VR grappling game built from scratch and focused on pure movement.\n\nNow with Multiplayer!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://glassfrogstudios.com/PrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Glass Frog Studios", "support_website_url": null, "website_url": "https://glassfrogstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOU
i": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823431_3938472753119792_6710512630970842491_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgTyKfeJLnAQ7kNvwGarM9p&_nc_oc=AdqrWDTmNiCu0BnW1ugfJiSSYHF7gQuHDLnUhVgKJPDQ9AVtgD1WBh77Nb-NFUxsVbg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGPAYUsPwzw8pgDZGsvCH_I9OcrcAMoKXPNGIaE1hgNw&oe=6AB26FA9"}, {"file_name": "HomeImage4png.png", "id": "1912141250179195", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298360_1912141253512528_21616095703866090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agfcC2lSmOUQ7kNvwE3FG_x&_nc_oc=AdrZ76YkhrHrTEagKBOaArtnJyQtuk190c8SPTV5ULeTtnCJFBJiM-E7_5KDW1v1G7o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJznuenFa_Wduht-zw_-WAE-Xy6qLyqLFTQeHxqZejh7Q&oe=6AB29621"}, {"file_name": "HomeImage5png.png", "id": "2320810755007320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822034_2320810758340653_4893841411744106514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WtoQCW0NrQQ7kNvwF0CM-M&_nc_oc=AdoVILeu70KQyjXyvS7gcoOG5U-M1fNoXwZ6YsBG5F3U3cw9V9tzqQuDxfHUo4jKRcw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIs5VLafh7SXgYEDts27bn7rujkvRLnasOMfO4Qimqd8g&oe=6AB28BD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OfficialGameCover2.png", "id": "815390247797291", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618264_815390251130624_6194725884521364425_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAw33SGTXYgQ7kNvwHw-IMX&_nc_oc=AdoxqWnSuojj10ZUXcwSjTOAs9SA2xg-gdQqFh4svMld5YBbxoMst-OnaOD770U5jLQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyR9pAcXwANe5z27Egf2xxZizSVtU8sVd_RjuiqGgUuA&oe=6AB2709A"}, "display_name": "Glass Grapple", "keywords": ["Retro", "Music", "Challenging", "Leaderboard"], "long_description": "**Glass Grapple began as a college graphics final project \u2014 and grew into a full VR game built entirely from scratch.**\n\nThe goal was to make a game that feels fast, fluid, and satisfying to move through \u2014 a synthwave world full of tight tunnels, shifting walls, with grapple physics that feel real. \n\nSwing, slingshot, and bend your momentum through **25 levels**, and **5 increasingly challenging Endless modes.**\n\nAdjust the speed of the game and master the movement to swing your way to the top of the leaderboards. \n\nGlass Grapple features an **original, layered, synthwave soundtrack** that evolves as you progress.\n\nBuilt from the ground up. Welcome to **Glass Grapple**. \n\nTry racing your friends through all the levels with **Multiplayer**!\n{2128568781026198}\n\nPress **Trigger** to shoot a grapple\n\nHold **Trigger** to reel in\n\nPress **Grip Button** to release\n{1164215599245917}\n\n**Pull** the rope to propel yourself\n{2325598044622467}\n\nActivate **slo-mo** for more control\n{1630402595038913}\n\nAdjust the **game speed** to your comfort level\n{33291366220477653}\n", "short_description": "Glass Grapple is a challenging but deeply satisfying VR grappling game built from scratch and focused on pure movement.\n\nNow with Multiplayer!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://glassfrogstudios.com/PrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Glass Frog Studios", "support_website_url": null, "website_url": "https://glassfrogstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOU
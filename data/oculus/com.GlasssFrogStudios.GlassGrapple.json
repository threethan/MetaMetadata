_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2bncS00_RkQ7kNvwGIPExv&_nc_oc=AdrPrKWd-KfyNV9TqA9FNZMQf3rNgw1XxIVd58Qo3JIl27qCu3LHFN8nofoKPp4X5LM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4nzOrr7RAct-rCY9TiEU4o0RMZquCsZ2uzv8SWGoCNA&oe=6ADCD7E9"}, {"file_name": "HomeImage4png.png", "id": "1912141250179195", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298360_1912141253512528_21616095703866090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZuk8vlqkjkQ7kNvwEZ8ojo&_nc_oc=Adp0QLZo1UMaNsROSOujlQXLvSg_JXrX1mC20NvuEezEslcrbxteqpHgvijhxNxbwis&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnbheF_TYgjM-5bj7JxFLfzfEA-sGxd9tp0_mZDcmbIA&oe=6ADCC621"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OfficialGameCover2.png", "id": "815390247797291", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618264_815390251130624_6194725884521364425_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=715fzW-svBcQ7kNvwHnP4IV&_nc_oc=AdpbTsJuW4LBwTFBLQbDnV_nYrVc_l1s1GUhilGoEhJoVO9oDrDXQk4-ZfccZVsvhfs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPh1OipgUQTrBPiMmmOVAk0EpKJYfgdKb1RFjKQ56BHPQ&oe=6ADCD8DA"}, "display_name": "Glass Grapple", "keywords": ["Retro", "Music", "Challenging", "Leaderboard", "Movement"], "long_description": "The **first 5 levels** and **Endless 1** are now **free!** \n\n**Glass Grapple began as a college graphics final project \u2014 and grew into a full VR game built entirely from scratch.**\n\nThe goal was to make a game that feels fast, fluid, and satisfying to move through.\n\nSwing, slingshot, and bend your momentum through **25 levels**, and **5 increasingly challenging Endless modes.**\n\nAdjust the speed of the game and master the movement to swing your way to the top of the leaderboards. \n\nGlass Grapple features an **original, layered, synthwave soundtrack** that evolves as you progress.\n\nBuilt from the ground up. Welcome to **Glass Grapple**. \n\nPress **Trigger** to shoot a grapple\n\nHold **Trigger** to reel in\n\nPress **Grip Button** to release\n{1164215599245917}\n\n**Pull** the rope to propel yourself\n{2325598044622467}\n\nActivate **slo-mo** for more control\n{1630402595038913}\n\nAdjust the **game speed** to your comfort level\n{33291366220477653}\n\nPress the right thumb stick to toggle **replay modes**, to race yourself and other players. \n{2182344339160233}\n\nTry racing your friends through all the levels with **Multiplayer**!\n{2128568781026198}\n", "short_description": "Glass Grapple is a challenging but deeply satisfying VR grappling game built from scratch and focused on pure movement.\n\nNow with Multiplayer!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://glassfrogstudios.com/PrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Glass Frog Studios", "support_website_url": null, "website_url": "https://glassfrogstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28687464250920148"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499301549_817770414082433_2685467192197817268_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoBYj-MJLgEQ7kNvwGTCz0X&_nc_oc=AdpO3zIr2uHW
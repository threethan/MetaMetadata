Q7kNvwE3FG_x&_nc_oc=AdrZ76YkhrHrTEagKBOaArtnJyQtuk190c8SPTV5ULeTtnCJFBJiM-E7_5KDW1v1G7o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJznuenFa_Wduht-zw_-WAE-Xy6qLyqLFTQeHxqZejh7Q&oe=6AB29621"}, {"file_name": "HomeImage5png.png", "id": "2320810755007320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822034_2320810758340653_4893841411744106514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WtoQCW0NrQQ7kNvwF0CM-M&_nc_oc=AdoVILeu70KQyjXyvS7gcoOG5U-M1fNoXwZ6YsBG5F3U3cw9V9tzqQuDxfHUo4jKRcw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIs5VLafh7SXgYEDts27bn7rujkvRLnasOMfO4Qimqd8g&oe=6AB28BD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OfficialGameCover2.png", "id": "815390247797291", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618264_815390251130624_6194725884521364425_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAw33SGTXYgQ7kNvwHw-IMX&_nc_oc=AdoxqWnSuojj10ZUXcwSjTOAs9SA2xg-gdQqFh4svMld5YBbxoMst-OnaOD770U5jLQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyR9pAcXwANe5z27Egf2xxZizSVtU8sVd_RjuiqGgUuA&oe=6AB2709A"}, "display_name": "Glass Grapple", "keywords": ["Grapple", "Retro", "Music", "Challenging", "Leaderboard"], "long_description": "\nGLASS GRAPPLE hurls you into a neon-drenched world of rhythm, precision, and pure velocity. A synthwave playground of shifting walls, narrow tunnels, and two rainbow-charged grapples that feel like extensions of your own hands.\n\nSwing, slingshot, and bend your momentum through 25 levels, and 5 increasingly challenging Endless modes. \nActivate slow-motion and carve impossible paths through the grid-lit world as the environment pulses to the music.\n\nNo hand-holding. No rails.\nJust you, your reflexes, and the hypnotic urge to take one more swing.\n\nEvery grapple is a decision.\nEvery wall is a challenge.\nEvery run becomes a dance between chaos and control.\n\nMaster the movement and swing your way to the top of the leaderboard. \n\nWelcome to Glass Grapple. ", "short_description": "Swing through neon walls with dual rainbow grapples in a retro-synthwave world.\nDodge shifting holes, navigate twisting tunnels, and watch the world react to the music.\n\nIt's just you and your momentum. Bend it to your will. \n\nFast. Fluid. Addictive. Welcome to Glass Grapple."}]}, "developer_name": null, "developer_privacy_policy_url": "https://glassfrogstudios.com/PrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Glass Frog Studios", "support_website_url": null, "website_url": "https://glassfrogstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25213746181625323"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1608162167137969"}, {"status": "PUBLISHED", "id": "24912306288398676"}]}, "baseline_offer": {"id": "24912306288398676"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775930400, "status": "PUBLISHED", "id": "1608162167137969"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28305395112460399", "version": "1.5.6"}, "id": "1118241703752342", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__type
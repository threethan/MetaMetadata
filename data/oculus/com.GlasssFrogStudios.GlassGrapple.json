53512528_21616095703866090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCfcxMX-5igQ7kNvwFzgUQq&_nc_oc=AdoH958CmbxrGHihp5XzOPhuptHov2RtzOBxpL-uXU7VbnYG3AKd6GDoeZOdZNPA4qo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNpJ7eGzRPjDpEN2Fi1kbtKCMWumcWeULoRByZvKeqqw&oe=6AA95BA1"}, {"file_name": "HomeImage5png.png", "id": "2320810755007320", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491822034_2320810758340653_4893841411744106514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_sJfLFKRooQ7kNvwH2pkJr&_nc_oc=Adqge5hPh0V3SJ8Jt2TPVmaw2BWfGmhrULcRJw0R6vcfBjzVC8RswL-baZ9ZEyZVf0A&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-UCCCbi09dZOTWVNDiqVDO_cx4GBYCJ5romLD-LeNWg&oe=6AA95150"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OfficialGameCover2.png", "id": "815390247797291", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618264_815390251130624_6194725884521364425_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdiJJeb9dZsQ7kNvwFNCLAD&_nc_oc=AdpGrVmv9kNFqG_uUMLJYVL36CgI0vigvdM6OmkBN5Cn_Ag6gA_mOr0uUabo-XxCDfg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2NW8BZGvl8IWWmFZsBrcgGsvZACIRbc7V-Nnkq_aihQ&oe=6AA9361A"}, "display_name": "Glass Grapple", "keywords": ["Retro", "Music", "Challenging", "Leaderboard"], "long_description": "**Glass Grapple began as a college graphics final project \u2014 and grew into a full VR game built entirely from scratch.**\n\nThe goal was to make a game that feels fast, fluid, and satisfying to move through \u2014 a synthwave world full of tight tunnels, shifting walls, with grapple physics that feel real. \n\nSwing, slingshot, and bend your momentum through **25 levels**, and **5 increasingly challenging Endless modes.**\n\nAdjust the speed of the game and master the movement to swing your way to the top of the leaderboards. \n\nGlass Grapple features an **original, layered, synthwave soundtrack** that evolves as you progress.\n\nBuilt from the ground up. Welcome to **Glass Grapple**. \n\nTry racing your friends through all the levels with **Multiplayer**!\n{2128568781026198}\n\nPress **Trigger** to shoot a grapple\n\nHold **Trigger** to reel in\n\nPress **Grip Button** to release\n{1164215599245917}\n\n**Pull** the rope to propel yourself\n{2325598044622467}\n\nActivate **slo-mo** for more control\n{1630402595038913}\n\nAdjust the **game speed** to your comfort level\n{33291366220477653}\n", "short_description": "Glass Grapple is a challenging but deeply satisfying VR grappling game built from scratch and focused on pure movement.\n\nNow with Multiplayer!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://glassfrogstudios.com/PrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Glass Frog Studios", "support_website_url": null, "website_url": "https://glassfrogstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "28218291797837398"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499301549_817770414082433_2685467192197817268_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISNZLlKGztIQ7kNvwHdkdBj&_nc_oc=AdrX_2Ker1Cm6qz3xA9PtNFQRCvNF0kscHwB4jawwjzlOasjTe-dSzaBNBXrwouUQd8&_nc_
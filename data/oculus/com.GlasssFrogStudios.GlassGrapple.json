i": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823431_3938472753119792_6710512630970842491_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ub36LKpM6jsQ7kNvwE0idal&_nc_oc=AdpQrVbtUXDiKFCtCtZHyM4hm0dXEz4JfX5iRFVosdwPKfHvfcVWoT55p3e-6bc60bc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgYqR8sTqmRKOdiYy0d1vYZv9PnfsIAi7x35NC-J2s2w&oe=6ABBE269"}, {"file_name": "HomeImage4png.png", "id": "1912141250179195", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298360_1912141253512528_21616095703866090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHyj6qWjQ0AQ7kNvwHu3fZS&_nc_oc=AdpwVUJ0TwtAuHE6128U8qowhwKoG6QEXeNlt12VQDGkw5UHBEW8oLsxQs31hZ1TL-M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJij4EEzBVYlSsDtBmslG2pM1tDW-CUj93mo50_Y_edg&oe=6ABBD0A1"}, {"file_name": "HomeImage5png.png", "id": "2320810755007320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822034_2320810758340653_4893841411744106514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CL2lqX2eBqwQ7kNvwF4fLIH&_nc_oc=AdrNhq0cwyPA2ftr4W3f1NQM_xhakXW6xPOXvwcRMcuE_v3mpqwFY-msKgLFaDrIsYA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIZryIozMefZooD95RAiPrRDENBpT2-HKV3FD1Ctzb6g&oe=6ABBC650"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OfficialGameCover2.png", "id": "815390247797291", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618264_815390251130624_6194725884521364425_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_CuVi0r9KIQ7kNvwGQBCVM&_nc_oc=AdqrSnhvndhsYiCZKNRbY3e_Zy3LEXhvDi8Tl-2ZePSTtxQBgcVH4KPwON5fWaNXPBA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6AQq-azA97P7R9KonIBPRpYdo1YCGIqMI9XGPHMMZ8Q&oe=6ABBE35A"}, "display_name": "Glass Grapple", "keywords": ["Retro", "Music", "Challenging", "Leaderboard"], "long_description": "**Glass Grapple began as a college graphics final project \u2014 and grew into a full VR game built entirely from scratch.**\n\nThe goal was to make a game that feels fast, fluid, and satisfying to move through \u2014 a synthwave world full of tight tunnels, shifting walls, with grapple physics that feel real. \n\nSwing, slingshot, and bend your momentum through **25 levels**, and **5 increasingly challenging Endless modes.**\n\nAdjust the speed of the game and master the movement to swing your way to the top of the leaderboards. \n\nGlass Grapple features an **original, layered, synthwave soundtrack** that evolves as you progress.\n\nBuilt from the ground up. Welcome to **Glass Grapple**. \n\nTry racing your friends through all the levels with **Multiplayer**!\n{2128568781026198}\n\nPress **Trigger** to shoot a grapple\n\nHold **Trigger** to reel in\n\nPress **Grip Button** to release\n{1164215599245917}\n\n**Pull** the rope to propel yourself\n{2325598044622467}\n\nActivate **slo-mo** for more control\n{1630402595038913}\n\nAdjust the **game speed** to your comfort level\n{33291366220477653}\n", "short_description": "Glass Grapple is a challenging but deeply satisfying VR grappling game built from scratch and focused on pure movement.\n\nNow with Multiplayer!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://glassfrogstudios.com/PrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Glass Frog Studios", "support_website_url": null, "website_url": "https://glassfrogstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOU
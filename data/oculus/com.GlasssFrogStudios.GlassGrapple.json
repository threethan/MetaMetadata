8uEv0eCH-k5-sk0ug&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyMkXQqKHNW8hbYyLrJ1T98C9qbOuci57EBSA-zuZ5DA&oe=6AFC638E"}, {"file_name": "HomeImage3png.png", "id": "3938472749786459", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823431_3938472753119792_6710512630970842491_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QMHxfQVoU0Q7kNvwGXHsbr&_nc_oc=Adpg0A4kwQbmdnkFaxITcNAeOlizacCVz3YVFmXV8FbdnliivXznNrSjDaxY70vQSNI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXG2N9oBrBdsYc0HhChZ26Bx9m88_iMW4itflzoxokow&oe=6AFC7BE9"}, {"file_name": "HomeImage4png.png", "id": "1912141250179195", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298360_1912141253512528_21616095703866090_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2h9RS5Vi38Q7kNvwFAKtlr&_nc_oc=AdrxDhcV9IhnhGjgvYzt8BMMKd3oGk9CZsZ_ns9Y6PNJAHo3z7ax7g6fq0oo1Ey1WGA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNuZT-3fyDJkI3GbizN4hHA2VrlatJF0k7gJwDtsyA2w&oe=6AFC6A21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OfficialGameCover2.png", "id": "815390247797291", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618264_815390251130624_6194725884521364425_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wk2-dAyngV4Q7kNvwHBu5CQ&_nc_oc=AdoT8dw3EtrJJ7iNU53RP1J6GXuraML_cR6Qr80rt4I0HkBK07X_FzbQK5_rcAhlQhM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0A5u3088itN4yOzmhv3wytVNfTT34PoBR1VJZYLhZkA&oe=6AFC7CDA"}, "display_name": "Glass Grapple", "keywords": ["Retro", "Music", "Challenging", "Leaderboard", "Movement"], "long_description": "The **first 5 levels** and **Endless 1** are now **free!** \n\n**Glass Grapple began as a college graphics final project \u2014 and grew into a full VR game built entirely from scratch.**\n\nThe goal was to make a game that feels fast, fluid, and satisfying to move through.\n\nSwing, slingshot, and bend your momentum through **25 levels**, and **5 increasingly challenging Endless modes.**\n\nAdjust the speed of the game and master the movement to swing your way to the top of the leaderboards. \n\nGlass Grapple features an **original, layered, synthwave soundtrack** that evolves as you progress.\n\nBuilt from the ground up. Welcome to **Glass Grapple**. \n\nPress **Trigger** to shoot a grapple\n\nHold **Trigger** to reel in\n\nPress **Grip Button** to release\n{1164215599245917}\n\n**Pull** the rope to propel yourself\n{2325598044622467}\n\nActivate **slo-mo** for more control\n{1630402595038913}\n\nAdjust the **game speed** to your comfort level\n{33291366220477653}\n\nPress the right thumb stick to toggle **replay modes**, to race yourself and other players. \n{2182344339160233}\n\nTry racing your friends through all the levels with **Multiplayer**!\n{2128568781026198}\n", "short_description": "Glass Grapple is a challenging but deeply satisfying VR grappling game built from scratch and focused on pure movement.\n\nNow with Multiplayer!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://glassfrogstudios.com/PrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Glass Frog Studios", "support_website_url": null, "website_url": "https://glassfrogstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTIN
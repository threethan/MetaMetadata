E08"}, {"file_name": "3.png", "id": "2038744360363963", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825497_2038744367030629_531423776909416510_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpMJta6yBW8Q7kNvwE1frHk&_nc_oc=AdrAnqi555q16SnszI8c_bkLiPr4PrubNGWWlfubp29sVBRDCr-h2vbZ4VzhONFIvRs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCHVT0vOak0FWqfN7oJL412mKlNwyKKTlv3PjYYVX2NQ&oe=6B00894A"}, {"file_name": "4.png", "id": "1291995899679384", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825345_1291995903012717_2742037940334755594_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xn03wvvF4dsQ7kNvwFUqloV&_nc_oc=AdoR6rdpYBI_hyW0-FTAkP969wVEHHxND9FrMJZagP2s99wETw5E3OPTs1oiaJ7fvZU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFNt04TdaV_6B0H6VyMPvGvUJy9Y9yMyD9inkYhKFygA&oe=6B006215"}, {"file_name": "meta_screenshot_6_2560x1440.png", "id": "1531868328388499", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823949_1531868331721832_1160460111598606829_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFYCxV6dOlMQ7kNvwHE0wTn&_nc_oc=AdqV55n4HlSc5fJlIwTMC7WwZAisA2mCtri6p2yeNXiSr0An8FMKU4qdf6sNm11sWhQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdpN_WqA6DhUZeLn3OkCTFi2oe5SktkZ2nqGwySUDxeQ&oe=6B00558C"}, {"file_name": "5.png", "id": "1025998373719148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824741_1025998380385814_7769828330716489350_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DP3_lQaVfWQQ7kNvwHghAS9&_nc_oc=Adr1E3vPMpJ-xguQO5xwSM071Aog_cyi0d277sxGoIURHRlSr9yzGW_Qdsd6BhlMivI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0MBi2mpLM1f8HsuV3CdsjWgbynpo7xol3Ed1I5ZyTEw&oe=6B005F38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "baner16x9.png", "id": "1029200763141183", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499301236_1029200766474516_6232017391836286590_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7XZTonanv8Q7kNvwFyeqKm&_nc_oc=Adr9lWC5rTT6DWmqwbpHxczGAAoM-KrsZG_CB9I8GoZ06ih8X3gAXfW2N7OzReNab8Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9rFMDswioIgtyvY4HV_KGU1jU5ngdP0IsjSUUCikLaA&oe=6B006BF5"}, "display_name": "Smiley's Secret", "keywords": ["atmospheric", "voxel", "horror", "survival", "monsters"], "long_description": "In **Smiley's Secret**, you find yourself in a forest that you must escape from. You need to call the police and find a rescue flare so the rescuers can fly in and pick you up.\n\nAt the same time, different monsters live in the forest, and you need to survive against them. Each monster has its own behavior logic. Against some, you need to stay still, against others \u2014 run away, and so on.\n\n**The game has 5 nights and 5 monsters** that you need to escape from.\n\nTo make the gameplay easier, in the lobby you can upgrade items that can be found in the game: **music box, pills, flashlight, and radar**. Each item can be upgraded to increase your chances of success.\n\n## The game supports 8 languages:\n\n- English\n- Italian\n- German\n- French\n- Russian\n- Japanese\n- Korean\n- Chinese\n\n\"The voice acting is in English.\"\n\nThe game focuses on tension, darkness, and a sense of danger. You will need to listen carefully to sounds, watch your surroundings, and make quick decisions to survive the night.", "short_description": "Smiley's Secret is a voxel survival horror game. You are trapped in a pitch-black forest with only a flashlight in your hands. Your goal is to call the rescuers so they can come for you by helicopter, while monsters are trying to find you. Each monster requires a different strategy to survive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vQDMkBXYna9NG1mIF6s7KR1B_Zp-Nw0HvvK_2Dz7hI933Izf
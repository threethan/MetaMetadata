848"}, {"file_name": "3.png", "id": "2038744360363963", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825497_2038744367030629_531423776909416510_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FqB9ZnyPe0Q7kNvwFeyDCL&_nc_oc=AdqI-0eJGr699uzTAZpjVk9oT2k-VLHgDk43j8ktzjrx_L2-XGb-UdEjp3A0Q49FVLw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVT9kq6fDiJ3kQTYSAFsUynWP2EpJlcejUMn4VfC1F6IA&oe=6B105B4A"}, {"file_name": "4.png", "id": "1291995899679384", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825345_1291995903012717_2742037940334755594_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQwAVSAsrfkQ7kNvwGwQDfQ&_nc_oc=Adq99OBd30XP-7S09u0YTiZLSD7dUKSb8j2v4f3zkOWb61kI3Nvvws7-M1qMyFzJUP4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWtEqPncz0HW5MG3qASQxatuGPkjJDtFs33g9nqPLPiqA&oe=6B106C55"}, {"file_name": "meta_screenshot_6_2560x1440.png", "id": "1531868328388499", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823949_1531868331721832_1160460111598606829_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KV6m7OOMywsQ7kNvwFArS5b&_nc_oc=AdqLaGvsKZHUXZvh8F9b9qRBJekQV2sOxlONihltpTvQALYJ66nfu8hOJIp4MwCt_eI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWle2kdm60edgQf0XoXXUN0Chv563SbKB2EcNb_5dPfTw&oe=6B105FCC"}, {"file_name": "5.png", "id": "1025998373719148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824741_1025998380385814_7769828330716489350_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7h81tS1ALUQ7kNvwGfTloL&_nc_oc=AdphfqDYoVc1wC9hPzL0AVvYWuFkDO1ng6OGFaPzYn5h-BOqRw-JeydI3HD7TXhli40&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXDESkFwVJt_N1NMs9-OqAce57q61kJv6wwfpuYhMNluA&oe=6B106978"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "baner16x9.png", "id": "1029200763141183", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499301236_1029200766474516_6232017391836286590_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQ656B6lUEcQ7kNvwEJ2Gnm&_nc_oc=Adqx9tt-_vJDksFoKwo6_d8m67tSCv352zc_UYKAVFN_PPAOgB911CBipT42gSuSGDc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUjvrxD8irLvnzgJPDpBh70M9l2O1uqo_jN51k771FRQQ&oe=6B103DF5"}, "display_name": "Smiley's Secret", "keywords": ["atmospheric", "voxel", "horror", "survival", "monsters"], "long_description": "In **Smiley's Secret**, you find yourself in a forest that you must escape from. You need to call the police and find a rescue flare so the rescuers can fly in and pick you up.\n\nAt the same time, different monsters live in the forest, and you need to survive against them. Each monster has its own behavior logic. Against some, you need to stay still, against others \u2014 run away, and so on.\n\n**The game has 5 nights and 5 monsters** that you need to escape from.\n\nTo make the gameplay easier, in the lobby you can upgrade items that can be found in the game: **music box, pills, flashlight, and radar**. Each item can be upgraded to increase your chances of success.\n\n## The game supports 8 languages:\n\n- English\n- Italian\n- German\n- French\n- Russian\n- Japanese\n- Korean\n- Chinese\n\n\"The voice acting is in English.\"\n\nThe game focuses on tension, darkness, and a sense of danger. You will need to listen carefully to sounds, watch your surroundings, and make quick decisions to survive the night.", "short_description": "Smiley's Secret is a voxel survival horror game. You are trapped in a pitch-black forest with only a flashlight in your hands. Your goal is to call the rescuers so they can come for you by helicopter, while monsters are trying to find you. Each monster requires a different strategy to survive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vQDMkBXYna9NG1mIF6s7KR1B_Zp-Nw0HvvK_2Dz7hI933Izf
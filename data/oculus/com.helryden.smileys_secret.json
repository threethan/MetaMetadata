6qugFLmW5A1cKnTtYQNz1pw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEgogFpnb8tt8dWGObmwkdxwRLO3bohwsaCCXm0wmA9w&oe=6AB9200A"}, {"file_name": "4.png", "id": "1291995899679384", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825345_1291995903012717_2742037940334755594_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wT2k4DXWihgQ7kNvwE6N8Z9&_nc_oc=Adq_ZmaIlwcskRyiYXx9fF7f7NhF009biAUTB3rFNfgLGPN_YWOO0whcdgasssyRCVk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHdF0LxpjAwTrvhkB4vBOyjMd4ScO_9sXo2zNnfbxKWA&oe=6AB93115"}, {"file_name": "meta_screenshot_6_2560x1440.png", "id": "1531868328388499", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823949_1531868331721832_1160460111598606829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57d1shPowz8Q7kNvwEBRzmD&_nc_oc=AdogI78FCcjeP3M_cFdrva4QAkQZ-vINVp5fo1wbYdTADabOt2zTOlrl9rEES0I9Cek&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCjaRnkD83BMgfDptr22hX3pIn2bHkmFqSYQ91et5Mzw&oe=6AB9248C"}, {"file_name": "5.png", "id": "1025998373719148", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824741_1025998380385814_7769828330716489350_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOPGBYVIM7AQ7kNvwHojzij&_nc_oc=Adro-fpG43F9Aa1oU8VPoyzAyXix99gcA7hXIR7RFO78MGWKdiO-KP0ScSvI09YaEco&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsfN3TgmeGqzHbHuvVu0W5YGPdh6G5zzuuSbCNm-eHUA&oe=6AB92E38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "baner16x9.png", "id": "1029200763141183", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499301236_1029200766474516_6232017391836286590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhtV2juTtZcQ7kNvwGDPX_U&_nc_oc=AdpOHLPR5r3Lc-ffcYbKm_MjX3pSFCu-hc6A0YlDtE0jhCkHsaZ6RsZ1gBIWQJHakss&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLC2tC_1lGEx52IaY02Cu5QYiL1e-cDPKNAkheSBZO2ww&oe=6AB93AF5"}, "display_name": "Smiley's Secret", "keywords": ["atmospheric", "voxel", "horror", "survival", "monsters"], "long_description": "In **Smiley's Secret**, you find yourself in a forest that you must escape from. You need to call the police and find a rescue flare so the rescuers can fly in and pick you up.\n\nAt the same time, different monsters live in the forest, and you need to survive against them. Each monster has its own behavior logic. Against some, you need to stay still, against others \u2014 run away, and so on.\n\n**The game has 5 nights and 5 monsters** that you need to escape from.\n\nTo make the gameplay easier, in the lobby you can upgrade items that can be found in the game: **music box, pills, flashlight, and radar**. Each item can be upgraded to increase your chances of success.\n\n## The game supports 8 languages:\n\n- English\n- Italian\n- German\n- French\n- Russian\n- Japanese\n- Korean\n- Chinese\n\n\"The voice acting is in English.\"\n\nThe game focuses on tension, darkness, and a sense of danger. You will need to listen carefully to sounds, watch your surroundings, and make quick decisions to survive the night.", "short_description": "Smiley's Secret is a voxel survival horror game. You are trapped in a pitch-black forest with only a flashlight in your hands. Your goal is to call the rescuers so they can come for you by helicopter, while monsters are trying to find you. Each monster requires a different strategy to survive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vQDMkBXYna9NG1mIF6s7KR1B_Zp-Nw0HvvK_2Dz7hI933IzfwGOKNDqwkdfs792JU3wH7gBz2F6s9Uw/pub", "developer_terms_of_service_url": null, "publisher_name": "Red-Ray", "support_website_url": null, "website_url": "https://docs.google.com/document/d/e/2PACX-1vQDMkBXYna9NG1mIF6s7KR1B_Zp-Nw0HvvK_2Dz7hI933IzfwGOKNDqwkdfs792JU3wH7gBz2F6s9Uw/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "contex
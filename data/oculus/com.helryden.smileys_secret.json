IVavYGse1zzlGmYfNT-rJEs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDCWCy-dIsqRBZLi_Ak_gvh__cc0iyV-RXtqDm-kyNxw&oe=6AC4FD8A"}, {"file_name": "4.png", "id": "1291995899679384", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825345_1291995903012717_2742037940334755594_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glG-koG66n4Q7kNvwEl_fAO&_nc_oc=AdpuUdEOjT0dcbuz0zbU3TEoOI-ObFzJHAXF8K9onyms4gIuHFGOLxgw-FcECCUeIHQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOq_6vmUF8xkOIyRckXoAJ89ycoOtIhzrsmQPIv1bdqUg&oe=6AC50E95"}, {"file_name": "meta_screenshot_6_2560x1440.png", "id": "1531868328388499", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823949_1531868331721832_1160460111598606829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKwZXFdf4ukQ7kNvwHdmzG_&_nc_oc=AdqxJ_PX5Z5SHvRTkVpxWWwN0dZ3jFV6Q7k03bxi5VU-v-FrXAn9W949T-sWJW7zgGQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-1u_Jmb-W4xqiIcswAWxm7baEZgn3qGHvRw4-mjkEuA&oe=6AC5020C"}, {"file_name": "5.png", "id": "1025998373719148", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824741_1025998380385814_7769828330716489350_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JB2nv0jIksMQ7kNvwHsjUMS&_nc_oc=AdrYVLPUAup9Tassl4YRyVZD4gVEq6tT4S5NV5ZcjT9fDGW2INGpaXb1PyWCV8hmLCo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMX9U7FYadT5dfUFy9t1ywfBC6hkdOY_AowsbwTdpDVPQ&oe=6AC50BB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "baner16x9.png", "id": "1029200763141183", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499301236_1029200766474516_6232017391836286590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0ODsbqbbvsQ7kNvwGZwY9R&_nc_oc=Adr6aqsjv0f_-o12QPtZP3iFzoB7xWfO2veEjdgduW0PDgKFKrNzPVDBP39wZpC6Bp4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1k3xwJ2f6zikAjZlqBWZ-KkHBaJQ_NCa0oDK_WyMrhg&oe=6AC51875"}, "display_name": "Smiley's Secret", "keywords": ["atmospheric", "voxel", "horror", "survival", "monsters"], "long_description": "In **Smiley's Secret**, you find yourself in a forest that you must escape from. You need to call the police and find a rescue flare so the rescuers can fly in and pick you up.\n\nAt the same time, different monsters live in the forest, and you need to survive against them. Each monster has its own behavior logic. Against some, you need to stay still, against others \u2014 run away, and so on.\n\n**The game has 5 nights and 5 monsters** that you need to escape from.\n\nTo make the gameplay easier, in the lobby you can upgrade items that can be found in the game: **music box, pills, flashlight, and radar**. Each item can be upgraded to increase your chances of success.\n\n## The game supports 8 languages:\n\n- English\n- Italian\n- German\n- French\n- Russian\n- Japanese\n- Korean\n- Chinese\n\n\"The voice acting is in English.\"\n\nThe game focuses on tension, darkness, and a sense of danger. You will need to listen carefully to sounds, watch your surroundings, and make quick decisions to survive the night.", "short_description": "Smiley's Secret is a voxel survival horror game. You are trapped in a pitch-black forest with only a flashlight in your hands. Your goal is to call the rescuers so they can come for you by helicopter, while monsters are trying to find you. Each monster requires a different strategy to survive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vQDMkBXYna9NG1mIF6s7KR1B_Zp-Nw0HvvK_2Dz7hI933IzfwGOKNDqwkdfs792JU3wH7gBz2F6s9Uw/pub", "developer_terms_of_service_url": null, "publisher_name": "Red-Ray", "support_website_url": null, "website_url": "https://docs.google.com/document/d/e/2PACX-1vQDMkBXYna9NG1mIF6s7KR1B_Zp-Nw0HvvK_2Dz7hI933IzfwGOKNDqwkdfs792JU3wH7gBz2F6s9Uw/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "contex
iZKXzp3twNf2wzpTkLGDTJw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyp8nanji2VHC0WsJxJn5IzRSivp794vCgvwUuUARNtg&oe=6A915ACA"}, {"file_name": "4.png", "id": "1291995899679384", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491825345_1291995903012717_2742037940334755594_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwbTMBFtgFEQ7kNvwF5p3xc&_nc_oc=Adp81hHdYLb1YZvoSzJQ9RGTR_jIACsZGf_LZVBCn2-h0NeyZEiFPzwSBIOm9XJZ4sA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDgwRInQZHc3bLYh2jEsVBtz55Www_W8jCxat1RNKaDg&oe=6A916BD5"}, {"file_name": "meta_screenshot_6_2560x1440.png", "id": "1531868328388499", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491823949_1531868331721832_1160460111598606829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UL_28Y2kYEoQ7kNvwEg8rwU&_nc_oc=Adqvjpw-z60y_zgPfDS2Ob7ye6260Z7YiSrVXH8u0BMStg5Mj9GWWguH8wq1qz1XoDI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5MvJ7Cb1-f4zreCOLnlLcCjDV6l2DBBUtprKk3eM-6Q&oe=6A915F4C"}, {"file_name": "5.png", "id": "1025998373719148", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491824741_1025998380385814_7769828330716489350_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2QBODGJhb0Q7kNvwH-gWOR&_nc_oc=AdoZrtvJiajs8nO6jKPtbUGKS9ju78If5OQryko-eIdMJx2tItcO8HRXCSdL3QUVgMI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE50tD-KOayjQY9VxaReWHlGfCsdDCc9q9edsuQLdIMEQ&oe=6A9168F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "baner16x9.png", "id": "1029200763141183", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499301236_1029200766474516_6232017391836286590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d36vG2vAu3AQ7kNvwHBvTAv&_nc_oc=AdrYR4Gon0FpObnvSz5SG1Wpz0i9srTLFR8rNFvgiIAQC_7Jbi_N8WliEwDjha9BjZM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFvLkasXVhO9IIChARwvYk-xp6URF_2vvTW6RXU0VQgA&oe=6A9175B5"}, "display_name": "Smiley's Secret", "keywords": ["atmospheric", "voxel", "horror", "survival", "monsters"], "long_description": "In **Smiley's Secret**, you find yourself in a forest that you must escape from. You need to call the police and find a rescue flare so the rescuers can fly in and pick you up.\n\nAt the same time, different monsters live in the forest, and you need to survive against them. Each monster has its own behavior logic. Against some, you need to stay still, against others \u2014 run away, and so on.\n\n**The game has 5 nights and 5 monsters** that you need to escape from.\n\nTo make the gameplay easier, in the lobby you can upgrade items that can be found in the game: **music box, pills, flashlight, and radar**. Each item can be upgraded to increase your chances of success.\n\n## The game supports 8 languages:\n\n- English\n- Italian\n- German\n- French\n- Russian\n- Japanese\n- Korean\n- Chinese\n\n\"The voice acting is in English.\"\n\nThe game focuses on tension, darkness, and a sense of danger. You will need to listen carefully to sounds, watch your surroundings, and make quick decisions to survive the night.", "short_description": "Smiley's Secret is a voxel survival horror game. You are trapped in a pitch-black forest with only a flashlight in your hands. Your goal is to call the rescuers so they can come for you by helicopter, while monsters are trying to find you. Each monster requires a different strategy to survive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vQDMkBXYna9NG1mIF6s7KR1B_Zp-Nw0HvvK_2Dz7hI933IzfwGOKNDqwkdfs792JU3wH7gBz2F6s9Uw/pub", "developer_terms_of_service_url": null, "publisher_name": "Red-Ray", "support_website_url": null, "website_url": "https://docs.google.com/document/d/e/2PACX-1vQDMkBXYna9NG1mIF6s7KR1B_Zp-Nw0HvvK_2Dz7hI933IzfwGOKNDqwkdfs792JU3wH7gBz2F6s9Uw/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "contex
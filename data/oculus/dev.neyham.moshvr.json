ntent-atl3-2.oculuscdn.com/v/t64.5771-25/499628092_1753723069265597_8420117855795126834_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVkZzA8dFfgQ7kNvwEp8EbO&_nc_oc=AdpWU-YKGX7TGuvTq5ERezixsCGSEBqTfKd9qOTkWjrOnPLJNTPr8JQwcN1yWNIxrUo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTKuh1Tde8NkLQeZjTO8OgrSydqYEb2X73JsP19rvd8lA&oe=6B0B3C3B"}, {"file_name": "03-sessions.png", "id": "1488166083370302", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499627527_1488166086703635_7772623835671144432_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_MXQYNSnpsQ7kNvwHa9Np5&_nc_oc=AdrxdAODVu9PON-hCON5qJ0uG2v3W2sKF_U3srd4l6LDaJ9vcpO8WfUdZrrP6sGxTM8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTf0mSGZftYr4X6iV19Ole2ZjkfAMmISCPFG6fS6lDNVQ&oe=6B0B17E4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "moshVR", "keywords": [], "long_description": "Connect your Quest directly to your own SSH server with moshVR. No PC streaming or companion app is required.\n\nUse password or SSH key authentication, open multiple terminal sessions, and choose a 2D panel or an immersive terminal wall. Optional passthrough and a dark digital-rain environment let you choose your workspace.\n\nFor mosh, install mosh-server on your host and allow its UDP ports. Mosh can recover from network interruptions while the app remains running; terminating the app ends the local session.\n\nCompose text, review it, then send it to your host. Optional cloud speech converts recordings into editable text using your own transcription provider API key. STOP uploads audio to the configured HTTPS provider. Speech requires explicit consent and confirmation that you are 18 or older and eligible to use the provider. Core terminal features work without speech or microphone access.\n\nRequirements: a reachable SSH server and network access. Local-network hosts can work without public Internet; cloud speech needs access to the chosen provider. No moshVR account is required.\n\nEarly Access: features and supported workflows are still evolving.", "short_description": "Native SSH and mosh terminal for Quest, with multiple sessions, an immersive workspace and optional voice input."}]}, "developer_name": null, "developer_privacy_policy_url": "https://neyham.github.io/moshvr/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Neyham", "support_website_url": "https://github.com/neyham/moshvr/issues", "website_url": "https://neyham.github.io/moshvr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1340208052512449"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499623179_1663282928557481_7861056218444533338_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tORGpEAPJAIQ7kNvwE58nU-&_nc_oc=AdpoIIgfya6v9N4EBpLdSuGslkVeIyGB84tLzhZfzy7rm2qvARzfxx-qR0RLNNnFGzQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSPOrrDBa68S6pwy_u3HCEiyHCTIs1gCeaYCzMkxrKtow&oe=6B0B1CB3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "moshVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_na
248815503426186_3102150384443732344_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SzaZEP4cbkQ7kNvwEhXtbW&_nc_oc=AdpIzoGFK2rIjnvSbp61onP6bGTIXabaLI5dbKRI0FcXWknd-xFjHpDNzNWfJjGb09M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3txCnbS6RpOhd8cpPzsn2ByeHbuCzST46_ZZRregLNeg&oe=69F0AA38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12386263_1386300711400057_1121902864_n.png", "id": "737356153590454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75196218_737356156923787_581073310781518135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gO16NWCLW4AQ7kNvwH8BIxe&_nc_oc=AdosMMdJFWzba8XOS1XiiDNiIL_81e0J19u7awBDD_ppHWHVCux-5G-my_S0DWhoOQQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1Wiv__kiN1D9peMmh7rjCjB3wx3zeQf04pD_b5bQ6dhg&oe=69F0B8FB"}, "display_name": "Yulio Viewer", "keywords": [], "long_description": "Yulio Viewer is your window into the world of ultra-realistic architecture and interior designer virtual reality experiences. \n\nWith Yulio, designers use state of the art CAD (Computer Aided Design) tools like 3DS Max\u2122, Revit\u2122, and SketchUp\u2122 to produce virtual reality content and transform it into sharable Virtual Reality Experiences. \n\nVisit the Yulio.com Gallery to see some of the best experiences being created by professional architecture and design firms today - and check back often, we\u2019re publishing new content all the time.\n\nJust click a link from the Gallery or from your designer, follow the simple instructions to connect your headset with your email address and then grab your headset - your virtual reality experience will be downloaded automatically and ready to view!\n", "short_description": "Yulio Viewer is your window into the world of ultra-realistic architecture and interior designer virtual reality experiences.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yulio.com/privacy-policy/", "developer_terms_of_service_url": "https://www.yulio.com/terms
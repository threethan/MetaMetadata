}, {"file_name": "12727795_175792849497784_1186982942_n.png", "id": "248815500092853", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974735_248815503426186_3102150384443732344_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xqiYNFQdr4Q7kNvwHecbKa&_nc_oc=AdqWl7DRQGQne84SZL483egMb59bdnMj3X-Id5wOoiXLKP5WNRxvbuIPLE2mZu0kGdA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxC2nKiLusuq0MjwgIPWARmOTOb5LVua3zKxaCzf1Krtw&oe=69C285B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12386263_1386300711400057_1121902864_n.png", "id": "737356153590454", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75196218_737356156923787_581073310781518135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4eXDXS5jjdsQ7kNvwHkob2w&_nc_oc=AdrIqDfmSIlWBXk2Vt83DyoGZ7MRgvOn5kn7uGBjbVaE-nnTojoY4grKxbAwb6Vdvis&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw25z4SEpQIsuunEuuxZPTQYymqz4boQ2KIPPrHK2BOzg&oe=69C2947B"}, "display_name": "Yulio Viewer", "keywords": [], "long_description": "Yulio Viewer is your window into the world of ultra-realistic architecture and interior designer virtual reality experiences. \n\nWith Yulio, designers use state of the art CAD (Computer Aided Design) tools like 3DS Max\u2122, Revit\u2122, and SketchUp\u2122 to produce virtual reality content and transform it into sharable Virtual Reality Experiences. \n\nVisit the Yulio.com Gallery to see some of the best experiences being created by professional architecture and design firms today - and check back often, we\u2019re publishing new content all the time.\n\nJust click a link from the Gallery or from your designer, follow the simple instructions to connect your headset with your email address and then grab your headset - your virtual reality experience will be downloaded automatically and ready to view!\n", "short_description": "Yulio Viewer is your window into the world of ultra-realistic architecture and interior designer virtual reality experiences.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yulio.com/privacy-policy/", "developer_terms_of_service_url": "https://www.yulio.com/terms-and-conditions/", "publisher_name": "Yulio Technologies Inc.", "support_website_url": null, "website_url": "https://www.yulio.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "364925122131893"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "740207085261219"}, {"status": "PUBLISHED", "id": "932157080924688"}]}, "baseline_offer": {"id": "740207085261219"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1753206900, "status": "PUBLISHED", "id": "740207085261219"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25137207179295151", "version": "2.7.6"}, "id": "460896278286925", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3439093536199828", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25137207179295151"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1
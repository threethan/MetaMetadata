82942_n.png", "id": "248815500092853", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974735_248815503426186_3102150384443732344_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqgoYOtWNOEQ7kNvwEt4sZ2&_nc_oc=AdloTPKxOS6deh711QEMXC2szAmNZQ0L0Kg_bn-b88Sqpvl4ecukUDdcriqnzQog8a4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfziXHwYmhYaHzjdjuhPInLOby1phOLBza1XXWDOkcsoaw&oe=69BD3FB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12386263_1386300711400057_1121902864_n.png", "id": "737356153590454", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75196218_737356156923787_581073310781518135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hk3GsUD2lwQ7kNvwHXweXy&_nc_oc=AdmLYAlNkIBzLG0CHiY6DGc9smkG-hY62M6ph4rmWEQB_VaMsJt-T2W9a6hlm7e1omY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1VF7_jrqitSqUO13Tk0AjfDzUMT6IdObHsqx1Z0i7_Q&oe=69BD4E7B"}, "display_name": "Yulio Viewer", "keywords": [], "long_description": "Yulio Viewer is your window into the world of ultra-realistic architecture and interior designer virtual reality experiences. \n\nWith Yulio, designers use state of the art CAD (Computer Aided Design) tools like 3DS Max\u2122, Revit\u2122, and SketchUp\u2122 to produce virtual reality content and transform it into sharable Virtual Reality Experiences. \n\nVisit the Yulio.com Gallery to see some of the best experiences being created by professional architecture and design firms today - and check back often, we\u2019re publishing new content all the time.\n\nJust click a link from the Gallery or from your designer, follow the simple instructions to connect your headset with your email address and then grab your headset - your virtual reality experience will be downloaded automatically and ready to view!\n", "short_description": "Yulio Viewer is your window into the world of ultra-realistic architecture and interior designer virtual reality experiences.  "}]}, "developer_name": null, "develope
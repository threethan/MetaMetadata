Q&oe=6A22E1F9"}, {"file_name": "12727795_175792849497784_1186982942_n.png", "id": "248815500092853", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974735_248815503426186_3102150384443732344_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgaHXHh082wQ7kNvwGQvdzY&_nc_oc=AdqK91ghNTct2JCoNhmk1k24QKZNd10XUcvxQ3P01GFG-16xQnVOH-MjGeW10q7QQj4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JGBCOvvI3936zCouwzKafaoet7vuxymDdgNMMPk8ztw&oe=6A22FB78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12386263_1386300711400057_1121902864_n.png", "id": "737356153590454", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75196218_737356156923787_581073310781518135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kr90aMP5gNcQ7kNvwFjWVl6&_nc_oc=AdpUTwAVSsEp7hP-XgmPP87O26kNtb3C-wTW-8X_o1apoGvks5f4TO3Tj1xJNzDWazo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Rs324XbRVvPchVgb8sTC7VBW2gbXq_ruDfqnDmNx1Ig&oe=6A22D1FB"}, "display_name": "Yulio Viewer", "keywords": [], "long_description": "Yulio Viewer is your window into the world of ultra-realistic architecture and interior designer virtual reality experiences. \n\nWith Yulio, designers use state of the art CAD (Computer Aided Design) tools like 3DS Max\u2122, Revit\u2122, and SketchUp\u2122 to produce virtual reality content and transform it into sharable Virtual Reality Experiences. \n\nVisit the Yulio.com Gallery to see some of the best experiences being created by professional architecture and design firms today - and check back often, we\u2019re publishing new content all the time.\n\nJust click a link from the Gallery or from your designer, follow the simple instructions to connect your headset with your email address and then grab your headset - your virtual reality experience will be downloaded automatically and ready to view!\n", "short_description": "Yulio Viewer is your window into the world of ultra-realistic architecture and interior designer virtual reality experiences.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yulio.com/privacy-policy/", "developer_terms_of_service_url": "https://www.yulio.com/terms-and-conditions/", "publisher_name": "Yulio Technologies Inc.", "support_website_url": null, "website_url": "https://www.yulio.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "364925122131893"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "740207085261219"}, {"status": "PUBLISHED", "id": "932157080924688"}]}, "baseline_offer": {"id": "740207085261219"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1753206900, "status": "PUBLISHED", "id": "740207085261219"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26052086594473867", "version": "2.7.8"}, "id": "460896278286925", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3439093536199828", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26052086594473867"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", 
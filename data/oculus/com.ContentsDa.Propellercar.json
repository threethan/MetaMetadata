deo_trailer": null, "video_trailer_thumbnail": {"file_name": "10.coverImage.png", "id": "1695091151320299", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75241703_1695091154653632_1992125982069099939_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDzD481Zx94Q7kNvwFzDedn&_nc_oc=AdrzPPndPkVAtVyorOn74SAlHlbDsV48Pd-HOAszW3adbL97wNxnHI0ONOd2kH2I_Us&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zWSUOefK_w5yrGgLZPL9X4cHqeos7MeumVgJZqFz6bA&oe=69E764F3"}, "display_name": "propeller car", "keywords": [], "long_description": "\"Dive into the realm of realistic experiments through Virtual Reality (VR). Experience the excitement of conducting actual reactions in a risk-free digital laboratory. Mix substances, observe genuine changes, and engage with lifelike molecular structures\u2014all in an immersive 3D environment. Enhance your learning by interacting with accurate representations of laboratory equipment and substances, all while honing your scientific skills. Explore the world of chemistry in an unprecedented way, where hands-on experimentation meets cutting-edge technology for an educational adventure like no other.", "short_description": "It helps you build your own Propella car in virtual reality and understand the scientific principles of how an electric motor or engine generates rotational force and pushes air through the propeller to create propulsion"}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres"
cb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6XxzF3kb4cQ7kNvwHRR43w&_nc_oc=AdpiqzMKn63YKRiHZN21nXOq-ltiWzp55Peiy89d8NPk_BKgqMoYUMxXqCQhLf90CWo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTT91tj2LmtFtb6c38Ui-HJuxTaRhVLtBlX9EPV9KbTKg&oe=6B0DC13B"}, {"file_name": "Nano Screenshot 2 - Inject.png", "id": "1959865254400038", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195913_1959865257733371_5057974653827379400_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kydgdG_5vfkQ7kNvwHo0mAR&_nc_oc=AdpsZmHrym-SkanXr3vhHLE_wOCJ84QhYfZB5jvKNoRawPi0ArW6Pu9arVO7PXgsmrc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRqhqHf5xAK4y092Dw1Vez3yZB50ypxRP0e4oteIgzPQA&oe=6B0DBB18"}, {"file_name": "Nano Screenshot 4a - DNA.png", "id": "847034573796942", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003270_847034583796941_8741968486816313479_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icQ_RkcMADYQ7kNvwEUjSdy&_nc_oc=AdrJeeQKBQHz_-_xVO8hnHqtVOWzMtJj0Gu214JmNDwV1iQv8iw5tu2FJ7CV6-IdKuY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRvA6VsDdNVGUj3EVkyNMaOn0BVNB-zNTyv_Nm3R4_vzw&oe=6B0DB6F9"}, {"file_name": "Nano Screenshot 1 - Mitochondria.png", "id": "848607196971757", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035341_848607200305090_2566554253967233676_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_9xI_z6CDIQ7kNvwGmT7E2&_nc_oc=Adp6dojQSTdmfUgF_AZaiTgdJRGUVbEM9TaobR-rA0loruF0iB-r8d-aDIrZkWSAnZE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRnemnVCUgErNzcbZ5REbhjOIEHGYyiIgzSJJ1lZswioA&oe=6B0DC2DC"}, {"file_name": "Nano Screenshot 5 - Protein Menu -a.png", "id": "839499781215712", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75240096_839499784549045_2115663910019443641_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohcjyxfD4HsQ7kNvwHeDRkX&_nc_oc=AdqNiIb0Z7C8qeLX1MCk0yONuGB1U2cd0q9QqUV5NjHcE2y9fL_coT4HyfFXzHdsMn0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR38CyXOmS-zNGWlYz6ovGYEPKkaiwoEJMyVkyBPxOj4A&oe=6B0DB0CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1042544850097301", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982688_1042544853430634_596272523618844793_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBJWXEkOUV4Q7kNvwGcO0C6&_nc_oc=AdpPOyeC6m33dWuc68_-q5rT-GqlXxZ8LU3U7RnfzLxeO1HRZqC4qzIaTDvwZPt-RPU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSLGtlxWqHotQZdw4IQWlMxBr-Pk6fj6aM2njalxECdBA&oe=6B0DA443"}, "display_name": "Nano", "keywords": ["STEM", "Learning", "education", "high", "school"], "long_description": "Nano is a thrilling cellular adventure with real science in its DNA.  \n\nA strange virus is sweeping across the globe. As a trainee in a top-secret bioresearch program, you use your headset and haptic gloves to remotely control a nanodrone -- a tiny machine that gets injected into the human body. \n\nWith the drone, you operate a synthetic immune cell, jacking into infected patients around the world to fight their infections on the microscopic level, and ultimately track down and face the mystery virus itself. \n\nYou'll need to master the cell's living systems: you generate energy from food molecules, use the cell's DNA to manufacture a variety of proteins to keep the cell alive, and to combat invaders. This is not a science textbook -- it's a game to its core, but one that's based on real science.  You've never experienced biology, or gaming, like this.", "short_description": "Nano is a thrilling biology adventure with real science in its DNA.  \n\nA strange virus is sweeping across the globe. As a trainee in a top-secret bioresearch program, you control a nanodrone -- a tiny machine that can inject into patients around the world, fight their infections, and hunt down the mystery virus itself. To do so, you'll need to master the cell's living systems: energy, DNA, proteins and transport. You can unlock and build increasingly powerful immune weapons to take on invaders."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lighthaus.us/privacy", "developer_terms_of_service_url": "https://www.lighthaus.us/terms-of-service", "publisher_name": "Lighthaus Inc", "support_website_url": "https://lighthaus.us/contact", "website_url": "https://www.lighthaus.us/nano", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1497649097325133"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195910_1540456673392287_4800244435108077297_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoQp1i_jCc0Q7kNvwE847SB&_nc_oc=AdrtdpBqIN8kQseX0zTEsNqPcVOz3oIkTOfGf8igWE2XI42hBKzjYdbizyG0GHbK3Ak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSOxNMH25x9FQ6MobK91wW76Om6RBYgrJKOYyubzp1Vag&oe=6B0DC5D4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Nano", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1
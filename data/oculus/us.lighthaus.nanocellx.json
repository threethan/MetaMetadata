cb=1-7&_nc_sid=6e7a0a&_nc_ohc=6p8G9gM71JsQ7kNvwHzbbjg&_nc_oc=Adqc5NjMPwXbxP3ZYmDyoOzZUKWlcGoWDEp_GcOUReYR15gnuWnuWqvTVMGaWo9JaL8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKfyM8dycXuvvXLwBNDIPiuzWp-Eg8bEMIAcc-uL8Ucw&oe=6AFC657B"}, {"file_name": "Nano Screenshot 2 - Inject.png", "id": "1959865254400038", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75195913_1959865257733371_5057974653827379400_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CiXOIw5yia0Q7kNvwGoYVby&_nc_oc=AdoTU06nIyJHp5UbmF0EboFMmDcZSzAYjEVcyc1QW7TBVZHX3vWjJiJFjQ9xZ0pLJoQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSs99CmsxoYaF0NcgReWQckfNwpTfP0yRznelNP4PqMOQ&oe=6AFC5F58"}, {"file_name": "Nano Screenshot 4a - DNA.png", "id": "847034573796942", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003270_847034583796941_8741968486816313479_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKiwFfsalR0Q7kNvwF-6Zsa&_nc_oc=Adq3CjLhngGKt88oMI0mQts0hl1qmi-rUcL1g_F55M_Fci-0GbdPe2S7YaUDqQAnWQc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-UnBgpW9CaIimjZhM0qtHN5_CN1YvSqWlB0I2_Wx7qA&oe=6AFC9379"}, {"file_name": "Nano Screenshot 1 - Mitochondria.png", "id": "848607196971757", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39035341_848607200305090_2566554253967233676_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEe8zbDyFcQQ7kNvwGOKf5d&_nc_oc=Adp0ygI6E2Iu_s_oebAqmQsjSe9H_hxaN5fTM_KzlHt6fyc4GRxhL38U52Z49ivz0vk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5Dd-K-VS29uAwDSTxMDbwqF8kkCdA66_1hKgUFZT_cw&oe=6AFC671C"}, {"file_name": "Nano Screenshot 5 - Protein Menu -a.png", "id": "839499781215712", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75240096_839499784549045_2115663910019443641_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cKIReiyZ9sQ7kNvwHTjiTC&_nc_oc=AdpB88dc-R5uvBDYSRdm1cxa1WD-lR9unPL6tC-QZ3yE7ifbiSSDBXgfXM5BTOwFchY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRj4vJpHz4qevwtmk_BZ4SEu5z6A86FMecGyugAfvPwPQ&oe=6AFC8D4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1042544850097301", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982688_1042544853430634_596272523618844793_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1l_bfzsbkMQ7kNvwHfhLw_&_nc_oc=AdpuVZWAmDlyudWGVNG-pmaJl-p7O2jTTWFGdeS4T9b1FDtvZZabiXg_3lowF07NNO0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRn0SZZPylXfx6zz76WkEhIBkUb-Ws4haxE1oq-eccaLA&oe=6AFC80C3"}, "display_name": "Nano", "keywords": ["STEM", "Learning", "education", "high", "school"], "long_description": "Nano is a thrilling cellular adventure with real science in its DNA.  \n\nA strange virus is sweeping across the globe. As a trainee in a top-secret bioresearch program, you use your headset and haptic gloves to remotely control a nanodrone -- a tiny machine that gets injected into the human body. \n\nWith the drone, you operate a synthetic immune cell, jacking into infected patients around the world to fight their infections on the microscopic level, and ultimately track down and face the mystery virus itself. \n\nYou'll need to master the cell's living systems: you generate energy from food molecules, use the cell's DNA to manufacture a variety of proteins to keep the cell alive, and to combat invaders. This is not a science textbook -- it's a game to its core, but one that's based on real science.  You've never experienced biology, or gaming, like this.", "short_description": "Nano is a thrilling biology adventure with real science in its DNA.  \n\nA strange virus is sweeping across the globe. As a trainee in a top-secret bioresearch program, you control a nanodrone -- a tiny machine that can inject into patients around the world, fight their infections, and hunt down the mystery virus itself. To do so, you'll need to master the cell's living systems: energy, DNA, proteins and transport. You can unlock and build increasingly powerful immune weapons to take on invaders."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lighthaus.us/privacy", "developer_terms_of_service_url": "https://www.lighthaus.us/terms-of-service", "publisher_name": "Lighthaus Inc", "support_website_url": "https://lighthaus.us/contact", "website_url": "https://www.lighthaus.us/nano", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1497649097325133"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75195910_1540456673392287_4800244435108077297_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ICmO6P5GpMQ7kNvwEjq-o9&_nc_oc=AdqYeF2pIyZqhM9ucfJszTHA3QcZDVk008GOY6Yw74WnMgt48R2hPy70VFkEPoTcI9Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSy9VLHeLmsI2jnKkpGGh8Fob6M8729j-oiHO7IhHqNiQ&oe=6AFC6A14"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Nano", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1
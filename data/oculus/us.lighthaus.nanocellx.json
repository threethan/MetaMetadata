cb=1-7&_nc_sid=6e7a0a&_nc_ohc=Imix45nn6VYQ7kNvwHJ2Y7w&_nc_oc=AdpZy-6qy3pd-QKg5imLt9fFKfTImWAwjj0GE8-yz542Z7ea-vCLkGVhP9fvObx-dN8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSzlpEKsFcMkpkhLwz7R28vqHLcx8sAmFTwstGqVbROAA&oe=6B0B1E3B"}, {"file_name": "Nano Screenshot 2 - Inject.png", "id": "1959865254400038", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75195913_1959865257733371_5057974653827379400_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mc4eI0L9gEUQ7kNvwH6dNix&_nc_oc=Adp5DCfEVTyz7l8cPBRbxCP25n_hggivGJGCwiaoxiBbE1dEbskCVeOSRlVy2LfsFLc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRhMsjQRYi9d4nqbOP2HILsAOypf_eVr80bu6aj45p64w&oe=6B0B1818"}, {"file_name": "Nano Screenshot 4a - DNA.png", "id": "847034573796942", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003270_847034583796941_8741968486816313479_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLnH29bVXFwQ7kNvwGrbct4&_nc_oc=AdqMA3HN_WrcMiMOqC_nVTxyeka0N4N3_ppxfTiMP-FbzLuy7ub_z0VGwWpc8uYGXck&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQULVp7LTF4PzKZAuez1jFOkV94t7eOhudCIoOKjZigCg&oe=6B0B13F9"}, {"file_name": "Nano Screenshot 1 - Mitochondria.png", "id": "848607196971757", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035341_848607200305090_2566554253967233676_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_KG17mCq098Q7kNvwFppqmX&_nc_oc=AdqXE--H9IpS0MjEPYrMGUzMNsJfViTxjvj77SyBfUENmQKEDY47HFT9KH3oqFxWbtE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSHXMjIMVDcht9-TVdwiVlaLJw8xJ9kjTmaqR8dPN7BNA&oe=6B0B1FDC"}, {"file_name": "Nano Screenshot 5 - Protein Menu -a.png", "id": "839499781215712", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75240096_839499784549045_2115663910019443641_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohcjyxfD4HsQ7kNvwFPegZj&_nc_oc=AdqBV2Mzc29r2K7Bl-kiPQGlm5rQYLkAvGp9p-d9O3r-sefJbLYmps2CN4cZaXrpTvo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQGAoFkzM3LnN_1pwe_KqD0XGceMyAFbRDyZc1VUBGgnw&oe=6B0B0DCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1042544850097301", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982688_1042544853430634_596272523618844793_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuFFPZd5fzsQ7kNvwGMfv4c&_nc_oc=AdpG4fLUN2rIOLn6xvSkqIxrnPUCcbITU6tO66g1KopXhLO3RbztUif8DOpzOnXsr9U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRCLoJdY8962gAfqoo6ixq80zEA7ltYPaIl06ZBiozsjQ&oe=6B0B3983"}, "display_name": "Nano", "keywords": ["STEM", "Learning", "education", "high", "school"], "long_description": "Nano is a thrilling cellular adventure with real science in its DNA.  \n\nA strange virus is sweeping across the globe. As a trainee in a top-secret bioresearch program, you use your headset and haptic gloves to remotely control a nanodrone -- a tiny machine that gets injected into the human body. \n\nWith the drone, you operate a synthetic immune cell, jacking into infected patients around the world to fight their infections on the microscopic level, and ultimately track down and face the mystery virus itself. \n\nYou'll need to master the cell's living systems: you generate energy from food molecules, use the cell's DNA to manufacture a variety of proteins to keep the cell alive, and to combat invaders. This is not a science textbook -- it's a game to its core, but one that's based on real science.  You've never experienced biology, or gaming, like this.", "short_description": "Nano is a thrilling biology adventure with real science in its DNA.  \n\nA strange virus is sweeping across the globe. As a trainee in a top-secret bioresearch program, you control a nanodrone -- a tiny machine that can inject into patients around the world, fight their infections, and hunt down the mystery virus itself. To do so, you'll need to master the cell's living systems: energy, DNA, proteins and transport. You can unlock and build increasingly powerful immune weapons to take on invaders."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lighthaus.us/privacy", "developer_terms_of_service_url": "https://www.lighthaus.us/terms-of-service", "publisher_name": "Lighthaus Inc", "support_website_url": "https://lighthaus.us/contact", "website_url": "https://www.lighthaus.us/nano", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1497649097325133"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75195910_1540456673392287_4800244435108077297_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXH5bCq5zqkQ7kNvwGAdz0Y&_nc_oc=AdrIMD8Fd99_zOjTtOxPgwKqocZrrfdagBARAR-65fLk-UfdrAg3jtc5ZTLon7IYiJI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSqXEYPQf-9V6TRi7nP1xqTYUHNuduVaJsV6ucdaNjdfg&oe=6B0B22D4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Nano", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1
cb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4Nu8ukKNu4Q7kNvwGj8EXR&_nc_oc=Ado5H_eC0N28pIVMEFUgYx2GG_jByfNolIVX9XDv6v42Tk9DNBpjOElAUQeKKtKQdP8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIF_-OP4ZfGhf4Zlj9X96LmtOLORkBRb8DKie58rzdBQ&oe=6B05D83B"}, {"file_name": "Nano Screenshot 2 - Inject.png", "id": "1959865254400038", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195913_1959865257733371_5057974653827379400_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fP1ivcvwY4Q7kNvwG-2SLp&_nc_oc=AdqnZlymtS2rKcCB4RPz7ephwhkDefn9_uK8S-nRpCwMf1AjPPu8NlS93pOuReEHeww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaIvBW5H0Np-wzqpyHGx1DUalWez45vsnoUdBgwK-GEw&oe=6B05D218"}, {"file_name": "Nano Screenshot 4a - DNA.png", "id": "847034573796942", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003270_847034583796941_8741968486816313479_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_PxiDKytdoQ7kNvwGN1EBB&_nc_oc=Adq3OzCPlelKEpR1rjeUafmhOxvK43tU9qdZ65yNr4dgFnUjIVhAyNWYHNcKa8_y3u0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7E9aBI8sFWQGMIMuUAv-aYT9FmI1yk169x5MC8ZlcUg&oe=6B05CDF9"}, {"file_name": "Nano Screenshot 1 - Mitochondria.png", "id": "848607196971757", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035341_848607200305090_2566554253967233676_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHGkloZXsiIQ7kNvwHyw-Bb&_nc_oc=AdrF2yIn3A5gRMzMC37IE_sH7eZxHL2x2U-1q3Rq00m6VCC-o2TaiWZLhayocmxPjI8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQr5xDqThvf9SnxeIKuyjt1ACVEycs6LnVMpGPwYfLzdQ&oe=6B05A19C"}, {"file_name": "Nano Screenshot 5 - Protein Menu -a.png", "id": "839499781215712", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75240096_839499784549045_2115663910019443641_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IRFVkg9tcrsQ7kNvwGi4iuR&_nc_oc=Adq0K0AaAvF1tSgBm_yUR979LE2qKJcfvBy6Ez9fRxZy5uiNzGWuTvxqnH-Q68FuO8s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9gkSwCL4XltnN9cR9cnlDQo4_dtrlj9vHJ2bn-z6new&oe=6B05C7CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1042544850097301", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982688_1042544853430634_596272523618844793_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-NXaivIgtkQ7kNvwFK8XgK&_nc_oc=AdrY-KvbTZtGrMgY-d1fN39Kw3PR0ZdeiEmMh90AMDfInIZHre4mIYSxV8QBP-PiS38&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHj9hjWy9sHOp6Fl7uu0qJTfSG5mi5jvCDcZDaL95-oQ&oe=6B05BB43"}, "display_name": "Nano", "keywords": ["STEM", "Learning", "education", "high", "school"], "long_description": "Nano is a thrilling cellular adventure with real science in its DNA.  \n\nA strange virus is sweeping across the globe. As a trainee in a top-secret bioresearch program, you use your headset and haptic gloves to remotely control a nanodrone -- a tiny machine that gets injected into the human body. \n\nWith the drone, you operate a synthetic immune cell, jacking into infected patients around the world to fight their infections on the microscopic level, and ultimately track down and face the mystery virus itself. \n\nYou'll need to master the cell's living systems: you generate energy from food molecules, use the cell's DNA to manufacture a variety of proteins to keep the cell alive, and to combat invaders. This is not a science textbook -- it's a game to its core, but one that's based on real science.  You've never experienced biology, or gaming, like this.", "short_description": "Nano is a thrilling biology adventure with real science in its DNA.  \n\nA strange virus is sweeping across the globe. As a trainee in a top-secret bioresearch program, you control a nanodrone -- a tiny machine that can inject into patients around the world, fight their infections, and hunt down the mystery virus itself. To do so, you'll need to master the cell's living systems: energy, DNA, proteins and transport. You can unlock and build increasingly powerful immune weapons to take on invaders."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lighthaus.us/privacy", "developer_terms_of_service_url": "https://www.lighthaus.us/terms-of-service", "publisher_name": "Lighthaus Inc", "support_website_url": "https://lighthaus.us/contact", "website_url": "https://www.lighthaus.us/nano", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1497649097325133"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75195910_1540456673392287_4800244435108077297_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7sHf5yiKRkIQ7kNvwH9fD1m&_nc_oc=Ado__11kcIVjkQU9W94YLwEAtAWIOVquY5xcE8qgjRzkZIbaif1rah1u92_dIqvSbTc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5sUV3Ufdm9wRq2R2cFUUmc5lj99U1XS8VkxK7n6euWA&oe=6B05A494"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Nano", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1
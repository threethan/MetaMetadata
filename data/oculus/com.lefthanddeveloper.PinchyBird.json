scdn.com&_nc_ss=7f20f&oh=00_AQJQ9Mz-Or48Si0AEYn2ZNHwCOJQdfHdM-6zcdCdRDD09Q&oe=6A996E78"}, {"file_name": "screenshot_5_2560x1440.png", "id": "749365180486425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230052_749365183819758_7996068684862032177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9yCy1z_nyIQ7kNvwEujTWP&_nc_oc=Adoc_HNUW0N6FmKPGvI45DBxqi6nSMapZWXTHcdPJegH7SWVoL6tASrPVxpNHrkVS3o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJD20mrCUhJHmyIAjS0b81wH8IXo6bKXKZtO83uUCEfnQ&oe=6A9977CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_4_2560x1440.png", "id": "1483314488895600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036631_1483314492228933_3956075025214191325_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pbCX_dnroAQ7kNvwHDWJOx&_nc_oc=AdqN4T3DV7XgUzkFpwLOR3NQmOGSYdvWLFA7diNCAb0W3Rlyb2EH9Df37YH4hhY_KQE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwmB9AKRzUvuUXX6hOmH6FJckOf9ZwC1OY2WqZhpMn4g&oe=6A999D8E"}, "display_name": "PinchyBird", "keywords": [], "long_description": "Game Features:\n\n- Hand Tracking: control your character with hand tracking\n- Simple yet Addictive Gameplay: Immerse yourself in the simplicity and addictive nature of the game.\n- Passthrough Environment: Play PinchyBird in a passthrough environment, seamlessly blending with the physical reality.\n- Variety of Bird Characters and Pinch Effects: Collect coins and explore the game with new characters and effects\n- Leaderboard Challenges: Achieve high scores through prolonged survival and make your mark on the Top 10 leaderboard.\n- Challenging Level Design: Experience increasingly difficulty levels as you survive longer.", "short_description": "PinchyBird is an addictive casual VR game played through hand tracking, where you control an adorable bird character by pinching with your thumbs and index fingers. Navigate through cube blocks and survive as long as possible."}]}, "deve
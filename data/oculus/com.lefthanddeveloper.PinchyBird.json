scdn.com&_nc_ss=7f20f&oh=00_AQEoLyb8d0txIsMIHwj32pXI3_rALvfABizolHVbGhxPKA&oe=6A8AEDF8"}, {"file_name": "screenshot_5_2560x1440.png", "id": "749365180486425", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75230052_749365183819758_7996068684862032177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1chjQFRCUQQ7kNvwHev16x&_nc_oc=AdrjfiYb5OPKY-9XhSwcxo4rLLcVo_Pe7abGDSZIGPUEHjnDCX3EarxGZSQjqDNJfDc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3skWyaL37auEdnGdbksRFkEXVrW9f1GHX88pk9kPRZw&oe=6A8AF74E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_4_2560x1440.png", "id": "1483314488895600", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036631_1483314492228933_3956075025214191325_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6FGFn1Xpf0Q7kNvwERzU0C&_nc_oc=AdrI8tnE-ngsKvR-QUnRjg4r99nZv5zBQDyVtVZfClGgG4N3IUSnVA1NoLqYzj_EBIQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2eT-tz7HxMrI4BDebGzWjeXMP2Sms6AFkw1HmJaDB9g&oe=6A8AE4CE"}, "display_name": "PinchyBird", "keywords": [], "long_description": "Game Features:\n\n- Hand Tracking: control your character with hand tracking\n- Simple yet Addictive Gameplay: Immerse yourself in the simplicity and addictive nature of the game.\n- Passthrough Environment: Play PinchyBird in a passthrough environment, seamlessly blending with the physical reality.\n- Variety of Bird Characters and Pinch Effects: Collect coins and explore the game with new characters and effects\n- Leaderboard Challenges: Achieve high scores through prolonged survival and make your mark on the Top 10 leaderboard.\n- Challenging Level Design: Experience increasingly difficulty levels as you survive longer.", "short_description": "PinchyBird is an addictive casual VR game played through hand tracking, where you control an adorable bird character by pinching with your thumbs and index fingers. Navigate through cube blocks and survive as long as possible."}]}, "deve
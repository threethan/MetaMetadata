rd Challenges: Achieve high scores through prolonged survival and make your mark on the Top 10 leaderboard.\n- Challenging Level Design: Experience increasingly difficulty levels as you survive longer.", "short_description": "PinchyBird is an addictive casual VR game played through hand tracking, where you control an adorable bird character by pinching with your thumbs and index fingers. Navigate through cube blocks and survive as long as possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1vcqJD5rQrc1pL8RViwQTLZ66deA8P9CHQm9sJ217gkA/edit#heading=h.cf1polv3tiux", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://www.youtube.com/@lefthanddeveloper1522", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7094975450584792"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566684_1574006380110035_7503666942695373435_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmNbMCEe8t4Q7kNvwE1cyMU&_nc_oc=AdquW_tiP2oxVYuM49d5TiwG5ONx6IvvqLcjQJSa7ACCie9XB4DI5Q7fOKIGx-39bxM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSCRfbpBZk_uHEw8I8X7ben63k1_2nYczztFa0l-f8kw&oe=6B05CDC3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_na
QWuAca8g&oe=6B09C82C"}, {"file_name": "screenshot_4_2560x1440.png", "id": "1580553109426913", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982623_1580553112760246_6100030736353341626_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96XemwSmqH4Q7kNvwGTQiEB&_nc_oc=Adrj1yglwLu0OUyUJhwdYcvt_OZKkAkHFvUCG44TcjbImKaLOjHD0kjxhydYi3vpEC8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTKmerFr9qvfy0KefKMTVEFZNUfVN6MUAo2UPNAoc6ZA&oe=6B09B638"}, {"file_name": "screenshot_5_2560x1440.png", "id": "749365180486425", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75230052_749365183819758_7996068684862032177_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-tiTsd9ONfkQ7kNvwGHuSXN&_nc_oc=AdpOpgBzrw1XdRWrRiom_4sjwmUIskctW77tZ7a8bE0Fo4tWhAijLXvQEn-U_kWaIqY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoP1nuVcM15p5C-O3aNkVQrsQnhOf7I9KLMb5bQUfTuA&oe=6B09BF8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_4_2560x1440.png", "id": "1483314488895600", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036631_1483314492228933_3956075025214191325_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2uv5ycysJ0Q7kNvwEWZ0QC&_nc_oc=AdoHJElt-DSSrVj3CLwNXKl-KMmUu5Iq_rm2NVSYjd7mNwQgLhw9X3nOpXWizKGwnmA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPqVYeXUCChKLDTU88aEAjZHbacw5_6X-s1YLIIRTFIw&oe=6B09AD0E"}, "display_name": "PinchyBird", "keywords": [], "long_description": "Game Features:\n\n- Hand Tracking: control your character with hand tracking\n- Simple yet Addictive Gameplay: Immerse yourself in the simplicity and addictive nature of the game.\n- Passthrough Environment: Play PinchyBird in a passthrough environment, seamlessly blending with the physical reality.\n- Variety of Bird Characters and Pinch Effects: Collect coins and explore the game with new characters and effects\n- Leaderboard Challenges: Achieve high scores through prolonged survival and make your mark on the Top 10 leaderboard.\n- Challenging Level Design: Experience increasingly difficulty levels as you survive longer.", "short_description": "PinchyBird is an addictive casual VR game played through hand tracking, where you control an adorable bird character by pinching with your thumbs and index fingers. Navigate through cube blocks and survive as long as possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1vcqJD5rQrc1pL8RViwQTLZ66deA8P9CHQm9sJ217gkA/edit#heading=h.cf1polv3tiux", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://www.youtube.com/@lefthanddeveloper1522", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7094975450584792"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566684_1574006380110035_7503666942695373435_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8svNhXQh-IQ7kNvwF8tyVR&_nc_oc=AdpoeSyd0BB0jZllogf06L71MCe1CuuSaIibLQgx-RqWy_CvuZznKUukqsnuPPNxEQE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzQoyy2oN9hJ9igCFJ5DdLlZ3R-I3DrrsmtbQ_Tva9xw&oe=6B09C243"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_na
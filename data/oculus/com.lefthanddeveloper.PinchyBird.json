scdn.com&_nc_ss=7f20f&oh=00_AQIXivHYrfvis7WMPlm3Hr9Q4wfUgl4gaj-lmIr59Nvyqw&oe=6A9C1178"}, {"file_name": "screenshot_5_2560x1440.png", "id": "749365180486425", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230052_749365183819758_7996068684862032177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opdWPuVGJkkQ7kNvwEyVyBg&_nc_oc=AdoAW2d92LhoBFQgw79Q5U6vy5H3Oc3pHNFFid7XjUbFmbffh1fkyvnsneUUQgNVv1o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtzUMmu94cIkToztashsreS3k1oTWSLAxLTS4n-4ueMQ&oe=6A9C1ACE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_4_2560x1440.png", "id": "1483314488895600", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036631_1483314492228933_3956075025214191325_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pbCX_dnroAQ7kNvwFVpTgU&_nc_oc=AdqaJd5tR2hK5GJcYy4YnTB38J2jAA1Id7bCqwrUZMEiwZa_wVIPlG1EXtpePgXrDVI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTk1oVC96Was5wChocT0g4AGikc52wQ-w_ZtxWWvvqwg&oe=6A9C408E"}, "display_name": "PinchyBird", "keywords": [], "long_description": "Game Features:\n\n- Hand Tracking: control your character with hand tracking\n- Simple yet Addictive Gameplay: Immerse yourself in the simplicity and addictive nature of the game.\n- Passthrough Environment: Play PinchyBird in a passthrough environment, seamlessly blending with the physical reality.\n- Variety of Bird Characters and Pinch Effects: Collect coins and explore the game with new characters and effects\n- Leaderboard Challenges: Achieve high scores through prolonged survival and make your mark on the Top 10 leaderboard.\n- Challenging Level Design: Experience increasingly difficulty levels as you survive longer.", "short_description": "PinchyBird is an addictive casual VR game played through hand tracking, where you control an adorable bird character by pinching with your thumbs and index fingers. Navigate through cube blocks and survive as long as possible."}]}, "deve
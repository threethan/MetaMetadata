scdn.com&_nc_ss=7f20f&oh=00_AQHmV6zyAFamDDDI7mtQEUd8AF8Pti6r8suMUTQNzINd4g&oe=6A884AF8"}, {"file_name": "screenshot_5_2560x1440.png", "id": "749365180486425", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75230052_749365183819758_7996068684862032177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1chjQFRCUQQ7kNvwHnYgL1&_nc_oc=AdoCELto2XT5Lzn7zwclKBfILndy8B8tOGpA7BhhfVP1cHMkIfzP_6B9JLwVfL5_tYw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDDXa2SEtMhLRNqnPcSp88ZxDTvvSfHQvJPUNCG9F91Q&oe=6A881C0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_4_2560x1440.png", "id": "1483314488895600", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036631_1483314492228933_3956075025214191325_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAwByRWs5iEQ7kNvwEwrVH1&_nc_oc=AdpoOnkgv_kb8WW4NI0oV5rrus0dvO_rMKf8UaYJbETuiPNwsZ2CZCPzdp35QBLmfMc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFK88Y7LW_cHBQHi6Ey3HG-5Rqr-AaDaE3T7Evw2cguyA&oe=6A8841CE"}, "display_name": "PinchyBird", "keywords": [], "long_description": "Game Features:\n\n- Hand Tracking: control your character with hand tracking\n- Simple yet Addictive Gameplay: Immerse yourself in the simplicity and addictive nature of the game.\n- Passthrough Environment: Play PinchyBird in a passthrough environment, seamlessly blending with the physical reality.\n- Variety of Bird Characters and Pinch Effects: Collect coins and explore the game with new characters and effects\n- Leaderboard Challenges: Achieve high scores through prolonged survival and make your mark on the Top 10 leaderboard.\n- Challenging Level Design: Experience increasingly difficulty levels as you survive longer.", "short_description": "PinchyBird is an addictive casual VR game played through hand tracking, where you control an adorable bird character by pinching with your thumbs and index fingers. Navigate through cube blocks and survive as long as possible."}]}, "deve
scdn.com&_nc_ss=7f20f&oh=00_AQOSNzCK-bD1SAZmmN_dTB8DmH-H_zJbCSeUXGRMeeKe5g&oe=6AC52838"}, {"file_name": "screenshot_5_2560x1440.png", "id": "749365180486425", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75230052_749365183819758_7996068684862032177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFRw66OxlEgQ7kNvwEV5zNB&_nc_oc=AdrO3jqbtbVINi5SeMIkt9Cw0JWZqqkwlL7x58OjpOxzDhsvRmO8RnpWqK3BSX5kLqc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORJQzuMuBzEK5ET3cxzzV1swyrLDVWiSV2qaKNhdc7LA&oe=6AC4F94E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_4_2560x1440.png", "id": "1483314488895600", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036631_1483314492228933_3956075025214191325_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdR_qpDxhR8Q7kNvwHchL9b&_nc_oc=Adq9sTOFh8--fCPaqBEb6rjjXGvPceFAvIAtvb7sEo8QEAJxlHyowQb_A-tyXxn6L8U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFr9hcgP8fpjOlC5i-1JXDi8A7sNiyXN2Pb6hSTAlNqQ&oe=6AC51F0E"}, "display_name": "PinchyBird", "keywords": [], "long_description": "Game Features:\n\n- Hand Tracking: control your character with hand tracking\n- Simple yet Addictive Gameplay: Immerse yourself in the simplicity and addictive nature of the game.\n- Passthrough Environment: Play PinchyBird in a passthrough environment, seamlessly blending with the physical reality.\n- Variety of Bird Characters and Pinch Effects: Collect coins and explore the game with new characters and effects\n- Leaderboard Challenges: Achieve high scores through prolonged survival and make your mark on the Top 10 leaderboard.\n- Challenging Level Design: Experience increasingly difficulty levels as you survive longer.", "short_description": "PinchyBird is an addictive casual VR game played through hand tracking, where you control an adorable bird character by pinching with your thumbs and index fingers. Navigate through cube blocks and survive as long as possible."}]}, "deve
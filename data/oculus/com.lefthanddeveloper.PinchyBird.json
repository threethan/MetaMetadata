Q7kNvwGoU7JC&_nc_oc=AdrIwKwg19mdzLVJXPsK4PctGX_eATctxwHgwvQW9rNkPBcj-PFDvrDjlwSQDbYIfHQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSRKjGBB77Og_EdpL7Ug-MDAoKJ04DOOfEWNM06N1Hzw&oe=6AF1FB38"}, {"file_name": "screenshot_5_2560x1440.png", "id": "749365180486425", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75230052_749365183819758_7996068684862032177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuaaxZKhEMgQ7kNvwEvIe_h&_nc_oc=AdrJgDL1RFiu6Dl6-nhsKL5lxyRlrykb9ylBPW9D4s2jCoXJIDXvk-uLdRcAHwMMGaU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqgtnfFi7e0gyNE9hwisYDQ1pd77X1EAAxECm2HEiDvA&oe=6AF2048E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_4_2560x1440.png", "id": "1483314488895600", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036631_1483314492228933_3956075025214191325_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuj5xEs_3qUQ7kNvwGiEw9-&_nc_oc=Adq_OFiGUYElpn9_Tn_vAWJD84oD5IYQBXFBKi1pEWFxvEhYv_nVH3RwTVGBH3rWqG4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5Hklgqqwfh78rJCz8em47YG0A72Mo-nANntHGjpxZ9g&oe=6AF1F20E"}, "display_name": "PinchyBird", "keywords": [], "long_description": "Game Features:\n\n- Hand Tracking: control your character with hand tracking\n- Simple yet Addictive Gameplay: Immerse yourself in the simplicity and addictive nature of the game.\n- Passthrough Environment: Play PinchyBird in a passthrough environment, seamlessly blending with the physical reality.\n- Variety of Bird Characters and Pinch Effects: Collect coins and explore the game with new characters and effects\n- Leaderboard Challenges: Achieve high scores through prolonged survival and make your mark on the Top 10 leaderboard.\n- Challenging Level Design: Experience increasingly difficulty levels as you survive longer.", "short_description": "PinchyBird is an addictive casual VR game played through hand tracking, where you control an adorable bird chara
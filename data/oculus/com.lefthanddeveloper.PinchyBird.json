scdn.com&_nc_ss=7f20f&oh=00_AQInQZp6eKMg2dPtiHBWpvPTb-wvnJOlpr3JyXugRsmi2w&oe=6AA7EEF8"}, {"file_name": "screenshot_5_2560x1440.png", "id": "749365180486425", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75230052_749365183819758_7996068684862032177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKSejjN0Ey8Q7kNvwGwyMMI&_nc_oc=AdoCWrDzApVAxAyuNTnK30xyAVwWyGl16aCMnKGofTmYXfQtYFK7b-ge9_mVAq1xNk4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-obdH6tLocGyElATXUD8xGZudmPNGRqPIOhTnreHgvw&oe=6AA7F84E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_4_2560x1440.png", "id": "1483314488895600", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036631_1483314492228933_3956075025214191325_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Py0FTThmmF0Q7kNvwGxeYUz&_nc_oc=AdqjbMnhXrYlSpJtQ8cMcl_94aXJfJmK68UD5W55-PPtcqRvzOqGPtaOeEla1DiThNo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQWv858sYo1wCdAGeX70mjLbSUCQ0xUTMCKk1d95IDxA&oe=6AA7E5CE"}, "display_name": "PinchyBird", "keywords": [], "long_description": "Game Features:\n\n- Hand Tracking: control your character with hand tracking\n- Simple yet Addictive Gameplay: Immerse yourself in the simplicity and addictive nature of the game.\n- Passthrough Environment: Play PinchyBird in a passthrough environment, seamlessly blending with the physical reality.\n- Variety of Bird Characters and Pinch Effects: Collect coins and explore the game with new characters and effects\n- Leaderboard Challenges: Achieve high scores through prolonged survival and make your mark on the Top 10 leaderboard.\n- Challenging Level Design: Experience increasingly difficulty levels as you survive longer.", "short_description": "PinchyBird is an addictive casual VR game played through hand tracking, where you control an adorable bird character by pinching with your thumbs and index fingers. Navigate through cube blocks and survive as long as possible."}]}, "deve
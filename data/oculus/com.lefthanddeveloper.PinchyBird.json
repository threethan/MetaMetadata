scdn.com&_nc_ss=7f20f&oh=00_AQFJlonT1jJoN4jB4-YozNegp_r5uiisF9Cqy3cxiS5B1A&oe=6A92D6F8"}, {"file_name": "screenshot_5_2560x1440.png", "id": "749365180486425", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75230052_749365183819758_7996068684862032177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-EOAWUvB2NQQ7kNvwFQKBNh&_nc_oc=AdqyBafVgc2R8tMYxroc9NlgeKX3jCRV1rjIAEu_ghZwMMXK8zvrM_3wL7jQuIl6Hdk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8kxA9J8E4fPb8iRtcDWyVaaQ1z5UaNq3rwM_ErSIVwg&oe=6A92E04E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_4_2560x1440.png", "id": "1483314488895600", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036631_1483314492228933_3956075025214191325_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1G9YM_-JC4Q7kNvwE8UTme&_nc_oc=AdrGzxXdN3g-w2VckDzC7oS2hJSNx_glcSA1LRDxTyy_2ogLSsb2URcr0JC3PyrHIVM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9koxnKOgmJVa4geoBvCEOMXKDjZLs8c20epiArm46ng&oe=6A92CDCE"}, "display_name": "PinchyBird", "keywords": [], "long_description": "Game Features:\n\n- Hand Tracking: control your character with hand tracking\n- Simple yet Addictive Gameplay: Immerse yourself in the simplicity and addictive nature of the game.\n- Passthrough Environment: Play PinchyBird in a passthrough environment, seamlessly blending with the physical reality.\n- Variety of Bird Characters and Pinch Effects: Collect coins and explore the game with new characters and effects\n- Leaderboard Challenges: Achieve high scores through prolonged survival and make your mark on the Top 10 leaderboard.\n- Challenging Level Design: Experience increasingly difficulty levels as you survive longer.", "short_description": "PinchyBird is an addictive casual VR game played through hand tracking, where you control an adorable bird character by pinching with your thumbs and index fingers. Navigate through cube blocks and survive as long as possible."}]}, "deve
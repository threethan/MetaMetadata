scdn.com&_nc_ss=7f20f&oh=00_AQJy8s43PLP2gOf78TonjhLkjN6Sb7n3uNSlEbQTjx0kQw&oe=6AB91278"}, {"file_name": "screenshot_5_2560x1440.png", "id": "749365180486425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230052_749365183819758_7996068684862032177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9cNyFIPlgwQ7kNvwGorr15&_nc_oc=AdqXZtVJJzhp6LNY2Ck23ngB24Ippe1fn_mEOP8mV91m0yqPSkQ_903ne_rJ3jipFUA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbFp6h1YPEY59DvYFJESXIDGRpb9TKaVsMemQ0homI4g&oe=6AB91BCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_4_2560x1440.png", "id": "1483314488895600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036631_1483314492228933_3956075025214191325_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFer9ez-SZYQ7kNvwG979aH&_nc_oc=AdqSoviqOYm2TeVWP3p5UEvn4iozB-Jt0BrL1AZGzYAvpcrsIrYOlwBjZSb0RiWyM-w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyzGH-pYu2ESs6N5FSfIbU9wj6Ikeb7CB6BAM76RvouQ&oe=6AB9094E"}, "display_name": "PinchyBird", "keywords": [], "long_description": "Game Features:\n\n- Hand Tracking: control your character with hand tracking\n- Simple yet Addictive Gameplay: Immerse yourself in the simplicity and addictive nature of the game.\n- Passthrough Environment: Play PinchyBird in a passthrough environment, seamlessly blending with the physical reality.\n- Variety of Bird Characters and Pinch Effects: Collect coins and explore the game with new characters and effects\n- Leaderboard Challenges: Achieve high scores through prolonged survival and make your mark on the Top 10 leaderboard.\n- Challenging Level Design: Experience increasingly difficulty levels as you survive longer.", "short_description": "PinchyBird is an addictive casual VR game played through hand tracking, where you control an adorable bird character by pinching with your thumbs and index fingers. Navigate through cube blocks and survive as long as possible."}]}, "deve
scdn.com&_nc_ss=7f20f&oh=00_AQKeMGERnYadE3kZLTg5lmd8GU_rUh6nyOUB1fKmZQ4eNg&oe=6AA15778"}, {"file_name": "screenshot_5_2560x1440.png", "id": "749365180486425", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75230052_749365183819758_7996068684862032177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQrnNDVjMWwQ7kNvwFIpLjl&_nc_oc=AdqdxWn9QJMRHPcaLJfreNAqy18_asRbooBrz1YxhrB_AU992am8pjgFjZtwyLqgkU0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3SYwSV4YPy2CfA_V0aGQBsYexgO0zW6MH6wb9VkHGVA&oe=6AA160CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_4_2560x1440.png", "id": "1483314488895600", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036631_1483314492228933_3956075025214191325_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0xIksCdwQYQ7kNvwEmgEmX&_nc_oc=AdoqfkUrSINtarCGitJ-w0V9e2LNSwbaKuSiOznGslDungndOJz8uJoGNctQFTde7wQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzJf9uONFvIisHUw-4yBlfh9DxXJaU8PbOEY0Rbw97KA&oe=6AA14E4E"}, "display_name": "PinchyBird", "keywords": [], "long_description": "Game Features:\n\n- Hand Tracking: control your character with hand tracking\n- Simple yet Addictive Gameplay: Immerse yourself in the simplicity and addictive nature of the game.\n- Passthrough Environment: Play PinchyBird in a passthrough environment, seamlessly blending with the physical reality.\n- Variety of Bird Characters and Pinch Effects: Collect coins and explore the game with new characters and effects\n- Leaderboard Challenges: Achieve high scores through prolonged survival and make your mark on the Top 10 leaderboard.\n- Challenging Level Design: Experience increasingly difficulty levels as you survive longer.", "short_description": "PinchyBird is an addictive casual VR game played through hand tracking, where you control an adorable bird character by pinching with your thumbs and index fingers. Navigate through cube blocks and survive as long as possible."}]}, "deve
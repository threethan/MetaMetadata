scdn.com&_nc_ss=7f20f&oh=00_AQLxN9kXhlZ2o6S93KZKRMkUnw_zvF8QmqJ6Xp4DTG2UfA&oe=6AA2A8F8"}, {"file_name": "screenshot_5_2560x1440.png", "id": "749365180486425", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75230052_749365183819758_7996068684862032177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94a7tJ6cbDkQ7kNvwGsYNbU&_nc_oc=AdoLdrLlTU2v5L49Fg4_fKGhf8bFBCB1TUqIub2UsJdndPwN0QiqR6HnShG-RHPN_4o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItzJblMHmxK1jktjH7SMTVAbtrNbsJO4klKHgk5OMu5A&oe=6AA2B24E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_4_2560x1440.png", "id": "1483314488895600", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036631_1483314492228933_3956075025214191325_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0xIksCdwQYQ7kNvwEXt7Ea&_nc_oc=AdpuRJ2u329NPtfO4eAve3qVMoAwFxtgozXrHFJLe5UqWmoN_F60K880HoPLZl13JZ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTb9zU7LJ6l7Hf-_Qrhf3UU73gxgS15eOhCRD2zu4LzQ&oe=6AA29FCE"}, "display_name": "PinchyBird", "keywords": [], "long_description": "Game Features:\n\n- Hand Tracking: control your character with hand tracking\n- Simple yet Addictive Gameplay: Immerse yourself in the simplicity and addictive nature of the game.\n- Passthrough Environment: Play PinchyBird in a passthrough environment, seamlessly blending with the physical reality.\n- Variety of Bird Characters and Pinch Effects: Collect coins and explore the game with new characters and effects\n- Leaderboard Challenges: Achieve high scores through prolonged survival and make your mark on the Top 10 leaderboard.\n- Challenging Level Design: Experience increasingly difficulty levels as you survive longer.", "short_description": "PinchyBird is an addictive casual VR game played through hand tracking, where you control an adorable bird character by pinching with your thumbs and index fingers. Navigate through cube blocks and survive as long as possible."}]}, "deve
scdn.com&_nc_ss=7f20f&oh=00_AQLFu7CNZoofYT8B_ptCHHNx82Y8V5ge2KM_7bBbYWvI6g&oe=6AA69D78"}, {"file_name": "screenshot_5_2560x1440.png", "id": "749365180486425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230052_749365183819758_7996068684862032177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKSejjN0Ey8Q7kNvwGuASHn&_nc_oc=Ado0xHdQ9V5n4DfKRkBrS5Gzy1sYypRE9KGk4Y02Y9ZP2c7txqvyiEnqq4mNNbhrvlA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINGuhjZWsQWEjQ0Soes9Qssrm1r7_n0Kir6zGcEbnnTg&oe=6AA6A6CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_4_2560x1440.png", "id": "1483314488895600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036631_1483314492228933_3956075025214191325_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Py0FTThmmF0Q7kNvwGL6Ysf&_nc_oc=AdrMQMnB_5p6fLqJaimsQlgmQI9M0YM_eb5vsZrVVPNgevP9OdSgGpUA-M1w3dJXW-M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZGXUILPaDbj--i9_qQ2kEB1-DiVyALrbOinEyqBPt8Q&oe=6AA6944E"}, "display_name": "PinchyBird", "keywords": [], "long_description": "Game Features:\n\n- Hand Tracking: control your character with hand tracking\n- Simple yet Addictive Gameplay: Immerse yourself in the simplicity and addictive nature of the game.\n- Passthrough Environment: Play PinchyBird in a passthrough environment, seamlessly blending with the physical reality.\n- Variety of Bird Characters and Pinch Effects: Collect coins and explore the game with new characters and effects\n- Leaderboard Challenges: Achieve high scores through prolonged survival and make your mark on the Top 10 leaderboard.\n- Challenging Level Design: Experience increasingly difficulty levels as you survive longer.", "short_description": "PinchyBird is an addictive casual VR game played through hand tracking, where you control an adorable bird character by pinching with your thumbs and index fingers. Navigate through cube blocks and survive as long as possible."}]}, "deve
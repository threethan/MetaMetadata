Q7kNvwGTnh6w&_nc_oc=Adr97FFb3KG0UdU6P7Bp7IoOd7Tl3sYGrDyfuIngd6mEUJtHMgG2t9k1cHHUJvQOiE0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAj58LNDwoVJOWr2DD_Zls0OAMXPBZhE5Gd36gPj3-hA&oe=6AD105B8"}, {"file_name": "screenshot_5_2560x1440.png", "id": "749365180486425", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75230052_749365183819758_7996068684862032177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TBTlHPu5NgQ7kNvwGOyd2C&_nc_oc=Ado1X5ow14nTqX9EJ4k0mHSEupjXbVU5BCOaQTPi22O2SgLfNPKds-tgweOGs8Se6_8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhCqh4G01o17hR5BlQboY9D_IbCUICNzIDTOkpLPUbIA&oe=6AD0D6CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_4_2560x1440.png", "id": "1483314488895600", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036631_1483314492228933_3956075025214191325_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4_7OfvnlaMQ7kNvwGAYAl-&_nc_oc=Adphv5NI4vw3S4KffIT2PwE2lLd-__TtvUmP9y5pgWKOk0yd0NIEELZNZVOFsmaibfA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMR2UfdcnqPsoRMSMN1Z3MHiHlCjwkHyl8nfe4U8sYJmQ&oe=6AD0FC8E"}, "display_name": "PinchyBird", "keywords": [], "long_description": "Game Features:\n\n- Hand Tracking: control your character with hand tracking\n- Simple yet Addictive Gameplay: Immerse yourself in the simplicity and addictive nature of the game.\n- Passthrough Environment: Play PinchyBird in a passthrough environment, seamlessly blending with the physical reality.\n- Variety of Bird Characters and Pinch Effects: Collect coins and explore the game with new characters and effects\n- Leaderboard Challenges: Achieve high scores through prolonged survival and make your mark on the Top 10 leaderboard.\n- Challenging Level Design: Experience increasingly difficulty levels as you survive longer.", "short_description": "PinchyBird is an addictive casual VR game played through hand tracking, where you control an adorable bird chara
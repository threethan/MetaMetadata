scdn.com&_nc_ss=7f20f&oh=00_AQKkSdwuVYCaclkGNhfZjNODd9nq2yuuliLOtNNOo1k6fQ&oe=6A9ABFF8"}, {"file_name": "screenshot_5_2560x1440.png", "id": "749365180486425", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75230052_749365183819758_7996068684862032177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opdWPuVGJkkQ7kNvwHf2r2R&_nc_oc=AdqFLGASVUNq-EXW9sY6dLBHzXUOMa6kv1Gs8yk3vir-3vX1iHzEVgj1OE1I_vz8-vI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL87EPZPKey38GP0FRfgc1P9CjnuUqxvGHCRDcFuL0ZKQ&oe=6A9AC94E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_4_2560x1440.png", "id": "1483314488895600", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036631_1483314492228933_3956075025214191325_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pbCX_dnroAQ7kNvwH6wCM7&_nc_oc=AdpysNzhsr1dGn6pzgvwZfx--u-VHJWqAPBA_aEyhQjHda4jauiJz4dlVg7K4WDXRb4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjsJfIRvfeQPKosVyU13D1M_hn1-LVUi9tEMBMRPe3JQ&oe=6A9AEF0E"}, "display_name": "PinchyBird", "keywords": [], "long_description": "Game Features:\n\n- Hand Tracking: control your character with hand tracking\n- Simple yet Addictive Gameplay: Immerse yourself in the simplicity and addictive nature of the game.\n- Passthrough Environment: Play PinchyBird in a passthrough environment, seamlessly blending with the physical reality.\n- Variety of Bird Characters and Pinch Effects: Collect coins and explore the game with new characters and effects\n- Leaderboard Challenges: Achieve high scores through prolonged survival and make your mark on the Top 10 leaderboard.\n- Challenging Level Design: Experience increasingly difficulty levels as you survive longer.", "short_description": "PinchyBird is an addictive casual VR game played through hand tracking, where you control an adorable bird character by pinching with your thumbs and index fingers. Navigate through cube blocks and survive as long as possible."}]}, "deve
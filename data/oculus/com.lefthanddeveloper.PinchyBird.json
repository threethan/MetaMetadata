scdn.com&_nc_ss=7f20f&oh=00_AQJ7q3zv-tzshSSuNMN-nfsrf9p5jhvQxtbKCxAToVW13A&oe=6ABA63F8"}, {"file_name": "screenshot_5_2560x1440.png", "id": "749365180486425", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75230052_749365183819758_7996068684862032177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XC6k_cvcsggQ7kNvwGmT-J7&_nc_oc=Adr8VoiF2H8vx5YbDLZOjzxsMKAEKdNO2PnPjtUGpwmQYytwGsutI_gvuzk9aj96MLc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdiNambc_w-uddABDv0A7xW2MDogx7RpGeEZ3jl1mV5A&oe=6ABA6D4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_4_2560x1440.png", "id": "1483314488895600", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036631_1483314492228933_3956075025214191325_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFer9ez-SZYQ7kNvwGqAmuy&_nc_oc=Adov_9JbLgoTG0g653Qyy5kVSPfNtIXEa-86urJH1NJIemkeyFLxjXKbtNb5p0HEK44&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgcKPxth2Gu1n6MW8SJHY8_3iuhCLZIaVgPY1KEBo0qA&oe=6ABA5ACE"}, "display_name": "PinchyBird", "keywords": [], "long_description": "Game Features:\n\n- Hand Tracking: control your character with hand tracking\n- Simple yet Addictive Gameplay: Immerse yourself in the simplicity and addictive nature of the game.\n- Passthrough Environment: Play PinchyBird in a passthrough environment, seamlessly blending with the physical reality.\n- Variety of Bird Characters and Pinch Effects: Collect coins and explore the game with new characters and effects\n- Leaderboard Challenges: Achieve high scores through prolonged survival and make your mark on the Top 10 leaderboard.\n- Challenging Level Design: Experience increasingly difficulty levels as you survive longer.", "short_description": "PinchyBird is an addictive casual VR game played through hand tracking, where you control an adorable bird character by pinching with your thumbs and index fingers. Navigate through cube blocks and survive as long as possible."}]}, "deve
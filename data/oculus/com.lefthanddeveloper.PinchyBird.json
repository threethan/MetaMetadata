Q7kNvwGnV3jy&_nc_oc=AdoMCIua8JulS3NECyQucHXyYYiFyQqaj1w_swVI6tasmKv45TKqCUOUS8b4MY05WwA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRF8aN317i-WO45C8II5_jEE6toHme2q1U4rEdxG-VvtA&oe=6AF74138"}, {"file_name": "screenshot_5_2560x1440.png", "id": "749365180486425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230052_749365183819758_7996068684862032177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OI7m4BSBIu0Q7kNvwGLhY8V&_nc_oc=AdrDnHUNjYU0u_gmdjGnJKSXLXC-Qxia0Ps8theFobW36CzrTrsWWDXl-PgLk09rD8w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgngtXS8WUaHGB6Be4z8q_T0wTKwoRYNvOZqe8Fo53sw&oe=6AF74A8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_4_2560x1440.png", "id": "1483314488895600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036631_1483314492228933_3956075025214191325_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRiQDtTug5oQ7kNvwEK_oz-&_nc_oc=Adq1AOYN_ZEjG6yljOdoykLP_LoxniTgM1TskUyi7vRPiu6oszjYJhCMxUoltPBfiyM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6KgpJIEDcqzfT0vxmDpe_E2BrRXAJ--6XOE0Js41usQ&oe=6AF7380E"}, "display_name": "PinchyBird", "keywords": [], "long_description": "Game Features:\n\n- Hand Tracking: control your character with hand tracking\n- Simple yet Addictive Gameplay: Immerse yourself in the simplicity and addictive nature of the game.\n- Passthrough Environment: Play PinchyBird in a passthrough environment, seamlessly blending with the physical reality.\n- Variety of Bird Characters and Pinch Effects: Collect coins and explore the game with new characters and effects\n- Leaderboard Challenges: Achieve high scores through prolonged survival and make your mark on the Top 10 leaderboard.\n- Challenging Level Design: Experience increasingly difficulty levels as you survive longer.", "short_description": "PinchyBird is an addictive casual VR game played through hand tracking, where you control an adorable bird chara
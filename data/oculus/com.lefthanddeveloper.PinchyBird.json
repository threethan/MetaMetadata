nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz9OrttZPXzM1YYKFMAyZfpWc-JijkCFkac1X7Z0JcGOw&oe=69B2C14E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_4_2560x1440.png", "id": "1483314488895600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036631_1483314492228933_3956075025214191325_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rz_XCzCvhEQ7kNvwFPS5eE&_nc_oc=Adm94SypoQAjiEiJaCMCnBckXhk65C5n7MtZCLV38EYnfvgD4KeCRLIvqmqpElStVRU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwZHo9cKIn5RoZd45DioBD4sLn_5nQbvU89wkzKmIo-FA&oe=69B2AECE"}, "display_name": "PinchyBird", "keywords": [], "long_description": "Game Features:\n\n- Hand Tracking: control your character with hand tracking\n- Simple yet Addictive Gameplay: Immerse yourself in the simplicity and addictive nature of the game.\n- Passthrough Environment: Play PinchyBird in a passthrough environment, seamlessly blending with the physical reality.\n- Variety of Bird Characters and Pinch Effects: Collect coins and explore the game with new characters and effects\n- Leaderboard Challenges: Achieve high scores through prolonged survival and make your mark on the Top 10 leaderboard.\n- Challenging Level Design: Experience increasingly difficulty levels as you survive longer.", "short_description": "PinchyBird is an addictive casual VR game played through hand tracking, where you control an adorable bird character by pinching with your thumbs and index fingers. Navigate through cube blocks and survive as long as possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1vcqJD5rQrc1pL8RViwQTLZ66deA8P9CHQm9sJ217gkA/edit#heading=h.cf1polv3tiux", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://www.youtube.com/@lefthanddeveloper1522", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id":
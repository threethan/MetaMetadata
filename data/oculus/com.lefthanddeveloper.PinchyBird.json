scdn.com&_nc_ss=7f20f&oh=00_AQJ1Q7N9lULEebAG-HGVUSjf0h8rTphWGCX7U0nqyo3W2Q&oe=6AA005F8"}, {"file_name": "screenshot_5_2560x1440.png", "id": "749365180486425", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75230052_749365183819758_7996068684862032177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQrnNDVjMWwQ7kNvwEXUh_4&_nc_oc=AdoJkHAG9hfeCd7CwfNi2M05mkgECASF9Se7mKqEgu0FIhGIQ61YjYboqxgBODmnQr0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3uzPcLodacQHCHVXeNKW86qB2ApXyOlUCkwxPo6GCgw&oe=6AA00F4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_4_2560x1440.png", "id": "1483314488895600", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036631_1483314492228933_3956075025214191325_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpM4ulUcK7IQ7kNvwGw5kkp&_nc_oc=Adr5KKdAZZkQU9_3H3Pql0D_EcIUWzbRMGpqbZh7vzJku1vOHdaesCWxyqzW9BqWdYY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3K8SnbzzCf9TaHeQdw52AxvaMVJs44h3c85uyDeEtLA&oe=6A9FFCCE"}, "display_name": "PinchyBird", "keywords": [], "long_description": "Game Features:\n\n- Hand Tracking: control your character with hand tracking\n- Simple yet Addictive Gameplay: Immerse yourself in the simplicity and addictive nature of the game.\n- Passthrough Environment: Play PinchyBird in a passthrough environment, seamlessly blending with the physical reality.\n- Variety of Bird Characters and Pinch Effects: Collect coins and explore the game with new characters and effects\n- Leaderboard Challenges: Achieve high scores through prolonged survival and make your mark on the Top 10 leaderboard.\n- Challenging Level Design: Experience increasingly difficulty levels as you survive longer.", "short_description": "PinchyBird is an addictive casual VR game played through hand tracking, where you control an adorable bird character by pinching with your thumbs and index fingers. Navigate through cube blocks and survive as long as possible."}]}, "deve
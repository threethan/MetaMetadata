scdn.com&_nc_ss=7f20f&oh=00_AQL_zGW01NkUO7_g70fkbXGVcai48wZiCacmNdIsoUBtQQ&oe=6AB66F78"}, {"file_name": "screenshot_5_2560x1440.png", "id": "749365180486425", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75230052_749365183819758_7996068684862032177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9cNyFIPlgwQ7kNvwExdsoZ&_nc_oc=Adq2f01UvlrTIw_xTiQQsm5SBdgVLgSZK5ktgtR0c-2mxPrCzXjGHzBU_QE7r3ur-Q0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7HI-xT1UMSg-j245zWuv0GPTJHm1H4dmn-UzAkmXqmA&oe=6AB678CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_4_2560x1440.png", "id": "1483314488895600", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036631_1483314492228933_3956075025214191325_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2DvJJTN6pkQ7kNvwGIpVcz&_nc_oc=Ado9T7UbT-Yahnn98CmkM5jh80HJKxkvkH8ZNKp2uOEuV0Nby0wdnrWR6oYCtSyR5nQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCB8OIc-DV7NIvyzt-RxTZuM8Jn2U2ktzJi2fLjVWp-w&oe=6AB69E8E"}, "display_name": "PinchyBird", "keywords": [], "long_description": "Game Features:\n\n- Hand Tracking: control your character with hand tracking\n- Simple yet Addictive Gameplay: Immerse yourself in the simplicity and addictive nature of the game.\n- Passthrough Environment: Play PinchyBird in a passthrough environment, seamlessly blending with the physical reality.\n- Variety of Bird Characters and Pinch Effects: Collect coins and explore the game with new characters and effects\n- Leaderboard Challenges: Achieve high scores through prolonged survival and make your mark on the Top 10 leaderboard.\n- Challenging Level Design: Experience increasingly difficulty levels as you survive longer.", "short_description": "PinchyBird is an addictive casual VR game played through hand tracking, where you control an adorable bird character by pinching with your thumbs and index fingers. Navigate through cube blocks and survive as long as possible."}]}, "deve
scdn.com&_nc_ss=7f20f&oh=00_AQJ8GaGDp6JsmiR07vv5Vrx0ZM-GiNDX9C2jjFEECa7BVQ&oe=6AB27AF8"}, {"file_name": "screenshot_5_2560x1440.png", "id": "749365180486425", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75230052_749365183819758_7996068684862032177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HMU5qOVazkQ7kNvwHtCcpU&_nc_oc=AdrIy5IRjHUuQ8UdJkufquCIp2z6a1IOPU8I8KEe_wgW2qbK5EjHaMWDbZq1jBmH7Wc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9vLgqJU0M_JNKCKbYMwvePjchWXQ7zLOwLvZRfnKKxQ&oe=6AB2844E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_4_2560x1440.png", "id": "1483314488895600", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036631_1483314492228933_3956075025214191325_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBYpdFyZLq8Q7kNvwEC4om9&_nc_oc=Adr9ds00Qo2i2o4zs1wdlFZ2IaTHzGELl4o1CmZZ6L0kejnYsqnXkhKAhcyLDiyqoYs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7jdxcYsbLvQNZ_md575lEzo3bXmnLrG_S0orI2Z7vEw&oe=6AB271CE"}, "display_name": "PinchyBird", "keywords": [], "long_description": "Game Features:\n\n- Hand Tracking: control your character with hand tracking\n- Simple yet Addictive Gameplay: Immerse yourself in the simplicity and addictive nature of the game.\n- Passthrough Environment: Play PinchyBird in a passthrough environment, seamlessly blending with the physical reality.\n- Variety of Bird Characters and Pinch Effects: Collect coins and explore the game with new characters and effects\n- Leaderboard Challenges: Achieve high scores through prolonged survival and make your mark on the Top 10 leaderboard.\n- Challenging Level Design: Experience increasingly difficulty levels as you survive longer.", "short_description": "PinchyBird is an addictive casual VR game played through hand tracking, where you control an adorable bird character by pinching with your thumbs and index fingers. Navigate through cube blocks and survive as long as possible."}]}, "deve
Q7kNvwF_tXwe&_nc_oc=Adpv2oneVk9DlEpwlA7ld-9n7P78Rdp3uJ04CsBHzsPQugZjF-cJacer8OqrBLiol4w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwIKtZnAtwB7EYQge5S6Z6f1N2kcFegjJFWf2WNyGIew&oe=6AD25738"}, {"file_name": "screenshot_5_2560x1440.png", "id": "749365180486425", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75230052_749365183819758_7996068684862032177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQ6DUiG1s3UQ7kNvwE6SBnw&_nc_oc=Adok_n5vD2gB8V-ybwXOdxUPoVGQzOEiEGcIZZ4KtirbDopbOM9Nzmv9p8LPOd1DGew&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1d5wu5qcC05YkDq7FQ9KOQdeG1b9qGYrT3hXl8zfTPA&oe=6AD2284E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_4_2560x1440.png", "id": "1483314488895600", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036631_1483314492228933_3956075025214191325_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4_7OfvnlaMQ7kNvwFpOv-m&_nc_oc=AdoLoF6ep4txd8n55qRZS5iuxaSRfYOmLWsaqnVNYsde6TNQV15kHltDNR8MeflrqY4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhE2ysTpBuQsQ2YBFQHBz0kRjti_7SBtsr2MRJFcHZFw&oe=6AD24E0E"}, "display_name": "PinchyBird", "keywords": [], "long_description": "Game Features:\n\n- Hand Tracking: control your character with hand tracking\n- Simple yet Addictive Gameplay: Immerse yourself in the simplicity and addictive nature of the game.\n- Passthrough Environment: Play PinchyBird in a passthrough environment, seamlessly blending with the physical reality.\n- Variety of Bird Characters and Pinch Effects: Collect coins and explore the game with new characters and effects\n- Leaderboard Challenges: Achieve high scores through prolonged survival and make your mark on the Top 10 leaderboard.\n- Challenging Level Design: Experience increasingly difficulty levels as you survive longer.", "short_description": "PinchyBird is an addictive casual VR game played through hand tracking, where you control an adorable bird character by pinching with your thumbs and index fingers. Navigate through cube blocks and survive as long as possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1vcqJD5rQrc1pL8RViwQTLZ66deA8P9CHQm9sJ217gkA/edit#heading=h.cf1polv3tiux", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://www.youtube.com/@lefthanddeveloper1522", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7094975450584792"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566684_1574006380110035_7503666942695373435_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcJlZrgF4PAQ7kNvwFKRRo8&_nc_oc=Adpi3xeCWV_dO7K67UCy4xb4xVPojP4mzgNo86o2fMyM_op-48IpqH9uvN0MNXADnFE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPySMubnuUac-218eZB9ByQOkNgh5lmAHbyqdcfVH5hvg&oe=6AD22B03"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PinchyBird", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1707173828, "lastRevision": {"nodes": [{"id": "6908371605911845", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"ap
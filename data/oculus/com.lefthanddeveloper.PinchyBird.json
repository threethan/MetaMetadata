scdn.com&_nc_ss=7f20f&oh=00_AQIaq6fc0A3i46WFPd4AeUOmfWTBbYmTIZoVO01KiWrQlA&oe=6AB51DF8"}, {"file_name": "screenshot_5_2560x1440.png", "id": "749365180486425", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75230052_749365183819758_7996068684862032177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HMU5qOVazkQ7kNvwGrgUZ-&_nc_oc=AdqoCR_MtqmzWg6ToOIZjlYy9UmGL3ZKHZ_pIn88gLI_LAbbnor1i1SDZXWLeN7KrQ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLM9LO1UWxH5Vk3i4HFKgA_GT48mjs5P8n0PNBdkoeqow&oe=6AB5274E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_4_2560x1440.png", "id": "1483314488895600", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036631_1483314492228933_3956075025214191325_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2DvJJTN6pkQ7kNvwF8rSyH&_nc_oc=AdqWcCspL5Soy6LKV31eeSeJV-h-wUSnf1IYfpmfPeVoHHY9VDWkhKnBhSjtE1bSQc8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVWuIqpLD7X5VFR_rXgXMIxvxp8SOwvI0WsKMD0G1Xdg&oe=6AB54D0E"}, "display_name": "PinchyBird", "keywords": [], "long_description": "Game Features:\n\n- Hand Tracking: control your character with hand tracking\n- Simple yet Addictive Gameplay: Immerse yourself in the simplicity and addictive nature of the game.\n- Passthrough Environment: Play PinchyBird in a passthrough environment, seamlessly blending with the physical reality.\n- Variety of Bird Characters and Pinch Effects: Collect coins and explore the game with new characters and effects\n- Leaderboard Challenges: Achieve high scores through prolonged survival and make your mark on the Top 10 leaderboard.\n- Challenging Level Design: Experience increasingly difficulty levels as you survive longer.", "short_description": "PinchyBird is an addictive casual VR game played through hand tracking, where you control an adorable bird character by pinching with your thumbs and index fingers. Navigate through cube blocks and survive as long as possible."}]}, "deve
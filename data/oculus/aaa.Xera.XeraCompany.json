16_2895373716873424362_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vK51ACAUo1wQ7kNvwHhdcwI&_nc_oc=AdplL8zu0dB2EdC0mlGaGnUGJ0MI8d6xxtGD0OYkW8yObW84os64OP3PXsC6USbHICs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVmeOhlK6x0oChS_w47r5b0U1T08mmbLgrkqeocJjmJQ&oe=6B007362"}, {"file_name": "OtherPlayerAnimalCompany.png", "id": "1582297739651242", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304764_1582297746317908_3700609219412015807_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61xCpwlwkOsQ7kNvwHiMqO7&_nc_oc=AdoZHZNXbtQaRZF4MBWb1ywOFat1y1BPWXJ95L4sqpsQRaViPLgGRlj-eFyTtxPsuHM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxLCw4l4vmIl_yugbu6hKenS16HqLDeghL4tIYwdYXqA&oe=6B006709"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey company", "keywords": [], "long_description": "Made by MemeTheSIGMA and Mr Cheese \n\nWelcome to Monkey Company. You and your crew are contracted workers sent into abandoned facilities to recover valuable materials. Using full arm-based VR locomotion, you\u2019ll climb, launch, and maneuver through dark environments filled with hazards and unpredictable threats. Teamwork is everything. Communicate with your squad, collect loot, avoid dangers, and make it back to extraction before time runs out. The more you bring back, the greater the rewards \u2014 but the deeper you go, the riskier it gets.", "short_description": "Made by MemeTheSIGMA and Mr Cheese \n\nMonkey Company is a fast-paced VR multiplayer adventure where you use arm-based locomotion to explore dangerous facilities, collect valuable loot, and escape before it\u2019s too late. Work together, survive the unknown, and don\u2019t get left behind."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1hWCgj2dwWe_ifs46BbFwEupAY1QlzgUVq833TMI2VcU/edit?usp=sharing", "developer_terms_of_service_url": null
16_2895373716873424362_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkfCE3zuL6IQ7kNvwGdIAcU&_nc_oc=AdoLqWBRMEazBfCjEdyVae_rNSanPumYC8AJcrhQWA7LbXEpM2KK6qzhhHn20Y6HSXA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFysscptgktBfZTJTgJ6-7gONlMqOQU5Joqif1PZSbWg&oe=6B0467E2"}, {"file_name": "OtherPlayerAnimalCompany.png", "id": "1582297739651242", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304764_1582297746317908_3700609219412015807_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsAT1E2Q1iEQ7kNvwEx7kog&_nc_oc=AdpDPOQXyzRRu0e97W64UkC7q4sMhwhSG9atipqW4a5nTMERrKJXGmk-xn_HVV7z9SE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTajenObn85DvI_XXXoeWkI6jFLaETQV687qme9QuH9_Q&oe=6B045B89"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey company", "keywords": [], "long_description": "Made by MemeTheSIGMA and Mr Cheese \n\nWelcome to Monkey Company. You and your crew are contracted workers sent into abandoned facilities to recover valuable materials. Using full arm-based VR locomotion, you\u2019ll climb, launch, and maneuver through dark environments filled with hazards and unpredictable threats. Teamwork is everything. Communicate with your squad, collect loot, avoid dangers, and make it back to extraction before time runs out. The more you bring back, the greater the rewards \u2014 but the deeper you go, the riskier it gets.", "short_description": "Made by MemeTheSIGMA and Mr Cheese \n\nMonkey Company is a fast-paced VR multiplayer adventure where you use arm-based locomotion to explore dangerous facilities, collect valuable loot, and escape before it\u2019s too late. Work together, survive the unknown, and don\u2019t get left behind."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1hWCgj2dwWe_ifs46BbFwEupAY1QlzgUVq833TMI2VcU/edit?usp=sharing", "developer_terms_of_service_url": null
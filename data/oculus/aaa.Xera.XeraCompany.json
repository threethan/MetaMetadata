17908_3700609219412015807_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QT5ZjaM1j0EQ7kNvwEA1qJ4&_nc_oc=AdrNQo2pRv_fTCrdrf9V2tnCtSAtmJqBtfOLOJmZ1eNR4V36v8dZmjr5PHsoMOJg1Ls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2SNOoNDBUN57bnGheDLY77qOeYsqlrxtfj1wuIdJ_8uw&oe=69F0D209"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey company", "keywords": [], "long_description": "Made by MemeTheSIGMA and Mr Cheese \n\nWelcome to Monkey Company. You and your crew are contracted workers sent into abandoned facilities to recover valuable materials. Using full arm-based VR locomotion, you\u2019ll climb, launch, and maneuver through dark environments filled with hazards and unpredictable threats. Teamwork is everything. Communicate with your squad, collect loot, avoid dangers, and make it back to extraction before time runs out. The more you bring back, the greater the rewards \u2014 but the deeper you go, the riskier it gets.", "short_description": "Made by MemeTheSIGMA and Mr Cheese \n\nMonkey Company is a fast-paced VR multiplayer adventure where you use arm-based locomotion to explore dangerous facilities, collect valuable loot, and escape before it\u2019s too late. Work together, survive the unknown, and don\u2019t get left behind."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1hWCgj2dwWe_ifs46BbFwEupAY1QlzgUVq833TMI2VcU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "weareus", "support_website_url": null, "website_url": "https://dual-apps-1.preview.emergentagent.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_grap
etless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wR7F_FprkpQQ7kNvwGTBw-Q&_nc_oc=Adorv0My6538znnMZrQn3-Bk7ce1-qSUTxFJw2r_0enQmP6_FfV3oTcN2xRfiiVzxMk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUGLo9U3T1J7nLrdo0lM6IFEpFVwF1oAoS_k6EmNqjEKw&oe=6B104E1D"}]}, "id": "952122019008055", "locale": "en_US", "screenshots": [{"file_name": "DGHSS01.png", "id": "720377163216697", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982707_720377166550030_4233641927914123885_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PbGYB_css4Q7kNvwGclPl_&_nc_oc=Adp1lp4NoPn_JtCedvxiFU19ds-4RqqMkpzbFDC78kgu2wR0PjIEPABLcIfs5iam9v8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVf-Dii1yQmLrix9e8lOsBdNftofqHFcAPBnlPTQg6XRg&oe=6B10388D"}, {"file_name": "DGHSS02.png", "id": "3401114190218281", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221315_3401114196884947_5355821543096225839_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5yS00nb0KgQ7kNvwEvExI1&_nc_oc=Adp_PB6bojEQ-64jCmKLHA5_YGUax8giZ8Iw9mpKaTntJZ8KpPxyIDyA6OUv2UkONVg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV6YLla1tAT-0bhAqBSR-H_0F8owc7Gpxh52TtkIkXWpg&oe=6B10424A"}, {"file_name": "DGHSS03.png", "id": "1418679858957109", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982646_1418679862290442_5415975764009626963_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teMtljibWR0Q7kNvwExmQYX&_nc_oc=Adp_Hr1x6zOstiWYFY1A5blPqeCdb64z0e0nbz6jwIrTR-4hKarKIvVykMK4gNv1i7M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXPZJzPDZnlsC1ZJAMdvGcIfnxIoiXv2kbPxvEuvaTdKA&oe=6B10391C"}, {"file_name": "DGHSS04.png", "id": "772434997827671", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75411999_772435001161004_3714421331976247772_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEYAqvDXxjAQ7kNvwEhIkAP&_nc_oc=AdpN0DxuD4xo3rymriYMgblJx7pyhEH7ADdgSDdkS0_dGYlDthWOo4GcN1_ZA9zuukA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUo_M7DviN6B-fQ1MvoBXGnugcEePvm7iEeFVuDINHTow&oe=6B10699B"}, {"file_name": "DGHSS05.png", "id": "585320726694364", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031455_585320730027697_1480234652549113122_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKBqd6MisloQ7kNvwG6enof&_nc_oc=AdqdZZo_qA8wCxWLm8-aBJDblUne6m7mk17djD6ULyU1TT9fMqIRu-G676CDj0_mSuE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWJvQC_g4p1H0u2YifzFBRRlsLbspWi101cuStkHw-T1g&oe=6B1044EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560_1440.png", "id": "794778544969584", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031643_794778551636250_1146016866930456357_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bh2j2D4cONUQ7kNvwHIQco_&_nc_oc=AdqwHt4WTyuNyLvYYf5NR8RPI3PrOGmjQuA4aTy5UqgB8j2yjE4wh1IEqUywlNguoLs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXD4Nm6_xRyZKslx92MHQ2ti28XrHQT55rTwEVrD-lOWQ&oe=6B1049BD"}, "display_name": "Death Game Hotel", "keywords": [], "long_description": "Death Game Hotel, the online death game battle where players put their own body parts at stake in order to win the championship.\n\nThe \"Death Game 2000\" is a secret tournament in which it is said that \u201ccontestants can obtain anything they want if they win the tournament\u201d. Challenge this tournament in the single-player mode!\n\nIn every game mode players can bet chips like in other table games. However, in this game, players can also bet their own body parts! If the player loses, the player will also lose the respective body part in-game. By losing a body part a distinctive side effect will also be experienced.\n\nThrough this VR experience, the player can taste on their skin how frightening and thrilling could be to have a deadly battle, something that cannot be experienced in common gambling games. Cheating and deceiving the opponent is also allowed!\n\nConfront your opponents in two different game modes: the totally unique \u201cGoblet of the Reaper\u201d and \u201cDeath Poker\u201d a version of poker that includes some peculiar rules.\nDuring these death games, the contestants can use different \u201ccheats\u201d like \u201csee the next card in the deck\u201d or \u201creplace one of the cards in their hand\u201d in order to get an edge over the competitors. \nAs a VR game, the player's movements will be reflected from the player's avatar, so cheating might not be so easy. That\u2019s why reading the competitor's moves is vital.\n\nAfter enjoying the single-player mode, compete with people from all over the world in the multiplayer mode!", "short_description": "\"Death Game Hotel\" is an online death game battle in which players participate in the \"Death Game 2000\", a secret tournament where contestants can obtain anything they want if they win, but in order to do so, they might have to bet even their own body parts!"}, {"images": {"nodes": [{"file_name": "cover_landscape_2560_1440.png", "id": "6112948172106988", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035367_6112948175440321_6451161069029939314_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_SoY7PpNcEQ7kNvwGZDRfH&_nc_oc=AdphrbTvF2WeejGTI8RSaeSPHQM14QhAxdklcVggH5dLexHBYZzIof2e_P-yMVlUSI0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXlEBrCvcb-DBvAWqsCZ7wuQmdvTnb4e3_nvhBVqOb9eQ&oe=6B105B04"}, {"file_name": "icon_512.png", "id": "3371671376431982", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031552_3371671379765315_2780957423181262654_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPGnmosW4aMQ7kNvwHAQUxE&_nc_oc=AdrMardjShUbgp14oiPIgt9RBAncycq7FZAhIbgE_FC4ko1TjKvq0UBBKL
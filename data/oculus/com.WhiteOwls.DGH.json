reenshots": [{"file_name": "DGHSS01.png", "id": "720377163216697", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982707_720377166550030_4233641927914123885_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkKi-rNS8PIQ7kNvwHS3B9g&_nc_oc=AdofjWDogsoFYXBV3Bqi-0wYMF-cZSBvZPd1uEN7zkaLTIptaFQvb3uqe0zyaYQB-MY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-plC4qzUkVLtPvvt-al9p_4oDXw4XAxlRiZeCZyZGV-g&oe=6A316B0D"}, {"file_name": "DGHSS02.png", "id": "3401114190218281", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221315_3401114196884947_5355821543096225839_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_eE6DMFkJwQ7kNvwGDzcSV&_nc_oc=AdrFYm_IpthTe2-KvOVokpAn_TwG-eHh3hayNjQ3LQW4OEeVQuEW_yYrCkfN2CKGShs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91g6Z8PEpC5Qpiu5EBjcNx3IRCGWYYN4BfQ7yB7LzFbQ&oe=6A3174CA"}, {"file_name": "DGHSS03.png", "id": "1418679858957109", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982646_1418679862290442_5415975764009626963_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCJNieCdtgQQ7kNvwELZX5S&_nc_oc=AdrcSJnLS6tufHmtYKSAHpTv2fTvuzqaepZ2dLN-f_OQzKflVKgizZN3gZqd67ByrTM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KHIUwV4aFa6PQ52yGejt_0B60lB4UROyiWaECzEljFg&oe=6A316B9C"}, {"file_name": "DGHSS04.png", "id": "772434997827671", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75411999_772435001161004_3714421331976247772_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBL0iVowAFoQ7kNvwEuLlPK&_nc_oc=Ado71kzNERb-ekhKxV22joIrvWnxaX9zAGQU221sNvYnTcFitBbU6hftT8VxwZtGRgY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BU81GThGoyckHZ2yNDtgPkxwdZ2i11vYIRiDxOboHQw&oe=6A3163DB"}, {"file_name": "DGHSS05.png", "id": "585320726694364", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031455_585320730027697_1480234652549113122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUuDCLe_ec8Q7kNvwFawMmD&_nc_oc=AdqPKwoCIlYX7i4Lsxjh86JwR9ZgpWeBz2g-_S6WseWrW7q0s2nrpvMQRhDYAhSOsCA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ssBzLFI_FbiBWp_c3jes8k1I0-0vzYZTOvX9C5Vn7jA&oe=6A31776B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560_1440.png", "id": "794778544969584", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031643_794778551636250_1146016866930456357_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6s1hJADcLAQ7kNvwHmSXgr&_nc_oc=Adqb82DSFh_EAHZW_k6qEaoFunKjOgPs69gOYs15wW0niVLpyJmEZAYxOmYwnTG-dr8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85io5dhuYafwk-iTRmSepUr_h3IYYRktayg1rEQ0m71Q&oe=6A3143FD"}, "display_name": "Death Game Hotel", "keywords": [], "long_description": "Death Game Hotel, the online death game battle where players put their own body parts at stake in order to win the championship.\n\nThe \"Death Game 2000\" is a secret tournament in which it is said that \u201ccontestants can obtain anything they want if they win the tournament\u201d. Challenge this tournament in the single-player mode!\n\nIn every game mode players can bet chips like in other table games. However, in this game, players can also bet their own body parts! If the player loses, the player will also lose the respective body part in-game. By losing a body part a distinctive side effect will also be experienced.\n\nThrough this VR experience, the player can taste on their skin how frightening and thrilling could be to have a deadly battle, something that cannot be experienced in common gambling games. Cheating and deceiving the opponent is also allowed!\n\nConfront your opponents in two different game modes: the totally unique \u201cGoblet of the Reaper\u201d and \u201cDeath Poker\u201d a version of poker that includes some peculiar rules.\nDuring these death games, the contestants can use different \u201ccheats\u201d like \u201csee the next card in the deck\u201d or \u201creplace one of the cards in their hand\u201d in order to get an edge over the competitors. \nAs a VR game, the player's movements will be reflected from the player's avatar, so cheating might not be so easy. That\u2019s why reading the competitor's moves is vital.\n\nAfter enjoying the single-player mode, compete with people from all over the world in the multiplayer mode!", "short_description": "\"Death Game Hotel\" is an online death game battle in which players participate in the \"Death Game 2000\", a secret tournament where contestants can obtain anything they want if they win, but in order to do so, they might have to bet even their own body parts!"}, {"images": {"nodes": [{"file_name": "cover_landscape_2560_1440.png", "id": "6112948172106988", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035367_6112948175440321_6451161069029939314_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ht6wXh_hGXUQ7kNvwEmwVCJ&_nc_oc=AdrveCGdBrTL7RQbamXusgtw4y5oF_-g6_sxbTDLYgOrb-HYRQiFCoFV6PYjRDACgMc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hbB3Bovf5UgRXaBOiCaHsCiU5NBJSULhI-xZLUWEXjg&oe=6A315544"}, {"file_name": "icon_512.png", "id": "3371671376431982", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031552_3371671379765315_2780957423181262654_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gj64_56g-TwQ7kNvwFGxlPf&_nc_oc=AdpcUobvM7h3PzSliXh_veWCf-bWCaXESu6KgaLc75dWXEGDqhpppxrqyLLSxavdJ2A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Mucr4smeFoWuuXiyMriehrL9Z2hVaqYLbThI4kq6zmw&oe=6A315466"}, {"file_name": "logo_transparent_1024.png", "id": "1943980932621029", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/43997708_1943980935954362_2181026677061938546_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7WSfXbsLCsQ7kNvwGOtiLe&_nc_oc=AdovZb3TfFE17NODX6l1G5TULCAUSmmFD45IRmeM06QRdiVeNLapC1by0j56GPbIx8Q&_nc_zt=3&_nc_ht=sco
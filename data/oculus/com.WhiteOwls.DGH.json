reenshots": [{"file_name": "DGHSS01.png", "id": "720377163216697", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982707_720377166550030_4233641927914123885_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXfBUvBWUsMQ7kNvwHWUwma&_nc_oc=AdoRwTKBV9-gX_CO2hD8lqCfIN7FfV24myOAhHByihhnkgwVtSWEQxpui_0JgDnTylY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TLeoA79NBfwmLvTMjn0KiUAZGPGzIPWTlzD3mkyqh1A&oe=6A32BC8D"}, {"file_name": "DGHSS02.png", "id": "3401114190218281", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75221315_3401114196884947_5355821543096225839_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_eE6DMFkJwQ7kNvwG5QXuy&_nc_oc=AdonEL66Q6PfOQH3VatEF5AnXP6Ste6GIVbW3sjYud9tuHLkM-NoNl5m_B1MMDXCwjg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EFs7rUCZOrwNYFA6RCd1ni3C5voEH87Lyzjz1gmGfZA&oe=6A32C64A"}, {"file_name": "DGHSS03.png", "id": "1418679858957109", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982646_1418679862290442_5415975764009626963_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PlwuaK6OR0Q7kNvwG526qu&_nc_oc=AdoOL6WLGZpp_vOvQXCtz_THBc1tQNesROwBKzMyL60HRLvyap3lZzQV4LBR62YL8gc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uJqViiT3XEKq0WRqok4eCa7n_dZKEEVt4DBuwzbwuKw&oe=6A32BD1C"}, {"file_name": "DGHSS04.png", "id": "772434997827671", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75411999_772435001161004_3714421331976247772_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBL0iVowAFoQ7kNvwHd-8rs&_nc_oc=AdogREhLLBGZEgNVHHydJJDvYdK7phXSAoT9WYBdF_C06f7DOn3c6CwDbNz3-zOBgSI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Q_ti5rolZZZ37d1CzVsEnCHv2POUrjEQ3ZAPfnJapsQ&oe=6A32B55B"}, {"file_name": "DGHSS05.png", "id": "585320726694364", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031455_585320730027697_1480234652549113122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXTKobwsiD8Q7kNvwHksww-&_nc_oc=AdpXi9KfB50U3k8gPVZuFIUVPd0KFHOodvA-G3XRNTjOLp0vuhyTMDyPqx93IcSDUMo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cZPso-7IAp0XrurD15sD2tuNEcMXu0QXu7TZCI_Eqjw&oe=6A32C8EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560_1440.png", "id": "794778544969584", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031643_794778551636250_1146016866930456357_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6s1hJADcLAQ7kNvwHbZRx3&_nc_oc=Ado1H_JZzQ9nJt_oaNXIGUbc_SfZVBNoBE0Rm0vFcib9dSKXalT5_0CW93idZmflj8o&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-agJOZXLJMPruxsowggLo49Abx79lPXf3su00EK3Y3gw&oe=6A32957D"}, "display_name": "Death Game Hotel", "keywords": [], "long_description": "Death Game Hotel, the online death game battle where players put their own body parts at stake in order to win the championship.\n\nThe \"Death Game 2000\" is a secret tournament in which it is said that \u201ccontestants can obtain anything they want if they win the tournament\u201d. Challenge this tournament in the single-player mode!\n\nIn every game mode players can bet chips like in other table games. However, in this game, players can also bet their own body parts! If the player loses, the player will also lose the respective body part in-game. By losing a body part a distinctive side effect will also be experienced.\n\nThrough this VR experience, the player can taste on their skin how frightening and thrilling could be to have a deadly battle, something that cannot be experienced in common gambling games. Cheating and deceiving the opponent is also allowed!\n\nConfront your opponents in two different game modes: the totally unique \u201cGoblet of the Reaper\u201d and \u201cDeath Poker\u201d a version of poker that includes some peculiar rules.\nDuring these death games, the contestants can use different \u201ccheats\u201d like \u201csee the next card in the deck\u201d or \u201creplace one of the cards in their hand\u201d in order to get an edge over the competitors. \nAs a VR game, the player's movements will be reflected from the player's avatar, so cheating might not be so easy. That\u2019s why reading the competitor's moves is vital.\n\nAfter enjoying the single-player mode, compete with people from all over the world in the multiplayer mode!", "short_description": "\"Death Game Hotel\" is an online death game battle in which players participate in the \"Death Game 2000\", a secret tournament where contestants can obtain anything they want if they win, but in order to do so, they might have to bet even their own body parts!"}, {"images": {"nodes": [{"file_name": "cover_landscape_2560_1440.png", "id": "6112948172106988", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035367_6112948175440321_6451161069029939314_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXDly1Wli8EQ7kNvwG5hg0d&_nc_oc=Adrhhd5I4cisjxl95XtK52CbT1PsTjbsyQpsBS7hr_292t793afmvpy7ENQB-ANlkJI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2pHFZrPQJz2qeHtHf_jclv6vIS4OLh2gc7uFCNsB0rw&oe=6A32A6C4"}, {"file_name": "icon_512.png", "id": "3371671376431982", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031552_3371671379765315_2780957423181262654_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gj64_56g-TwQ7kNvwFOGqry&_nc_oc=AdomlI4ZdrTYDcHd3zlmxuH6OhbhQ8-QyrxSz92HYvrr1GACTlQo5GI4zxGiIGDYZ7A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-atcJwoHl38f2_nW_pCQS8PcYEF2MJQdQ1LxH3WL8GNA&oe=6A32A5E6"}, {"file_name": "logo_transparent_1024.png", "id": "1943980932621029", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/43997708_1943980935954362_2181026677061938546_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6WvvitU_3EQ7kNvwGJaqZr&_nc_oc=AdrZJzVEQamKZTc0Vq92giq4cAYDgwskTF7beI_YiMfbbulFBLYemMg7EKEn2Wg3YkQ&_nc_zt=3&_nc_ht=sco
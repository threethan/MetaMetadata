reenshots": [{"file_name": "DGHSS01.png", "id": "720377163216697", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982707_720377166550030_4233641927914123885_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkKi-rNS8PIQ7kNvwHVxcvO&_nc_oc=Adq8nuoGpBDtZCnqV1P-7tYr6h3U9E1nojzetpmclyBm6uy9ubH_4V2QXlwd98AJRjQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NWlCxdB9FEWSbWppRL3mn1322rRZPEBioteT-Si5EOQ&oe=6A30198D"}, {"file_name": "DGHSS02.png", "id": "3401114190218281", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75221315_3401114196884947_5355821543096225839_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LD-xrrWP78Q7kNvwEyUtSz&_nc_oc=AdraJr7MUQXSl9bzL6ydfRvNWmVhQhBrOI7fAt4KkqbgJmS_3CtPXThJHe86NHltFls&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_G1UvpDDYet7eNdCk4B5Vt40wHaiaZkXDZeHBMX3eQkg&oe=6A30234A"}, {"file_name": "DGHSS03.png", "id": "1418679858957109", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982646_1418679862290442_5415975764009626963_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCJNieCdtgQQ7kNvwGPibls&_nc_oc=AdqNWsOMZ8KXOP63dQ2282KnRHBodqVwZApKixvaMlU8GmPmq9Ugdt1OpcB74MAs86A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9f3GuL3zf6qBL4Nn1sT3hMlKYAMOljz280-flpauZMzw&oe=6A301A1C"}, {"file_name": "DGHSS04.png", "id": "772434997827671", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75411999_772435001161004_3714421331976247772_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBL0iVowAFoQ7kNvwH8hFmO&_nc_oc=AdrirPe1JDdg0fA9JYU_QIoG7IQyAdPCQ_9_whodXAevXclA0vjAZKbVbSe4MDlX1QU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cM2HqghgB-3zzlKV3wRFteHYMLzSDRgSEOoTsdgWqGQ&oe=6A30125B"}, {"file_name": "DGHSS05.png", "id": "585320726694364", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031455_585320730027697_1480234652549113122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUuDCLe_ec8Q7kNvwEvMFjj&_nc_oc=Adpcnxm6ijW39RUxcIK1o-_ca6hDl1ys9p8X2cSrn4e01rnuhetAFWF7lD-Q1ds0jsY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kZhRTlCl7HYoBiFescyUgkIbdMeM1nLrxT47twwxs4g&oe=6A3025EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560_1440.png", "id": "794778544969584", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031643_794778551636250_1146016866930456357_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKavTxI4-vkQ7kNvwFBA3Os&_nc_oc=AdrWDBztOVWm3xhE3zkOc8VRtffFgIwy69EOIyc5nU_7CgoZIX7ytAgKfnbMFPP3rZw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xNl6sWuFeQX8gwSuObEbeUS6EwAfAixPbpeYT-eWERQ&oe=6A2FF27D"}, "display_name": "Death Game Hotel", "keywords": [], "long_description": "Death Game Hotel, the online death game battle where players put their own body parts at stake in order to win the championship.\n\nThe \"Death Game 2000\" is a secret tournament in which it is said that \u201ccontestants can obtain anything they want if they win the tournament\u201d. Challenge this tournament in the single-player mode!\n\nIn every game mode players can bet chips like in other table games. However, in this game, players can also bet their own body parts! If the player loses, the player will also lose the respective body part in-game. By losing a body part a distinctive side effect will also be experienced.\n\nThrough this VR experience, the player can taste on their skin how frightening and thrilling could be to have a deadly battle, something that cannot be experienced in common gambling games. Cheating and deceiving the opponent is also allowed!\n\nConfront your opponents in two different game modes: the totally unique \u201cGoblet of the Reaper\u201d and \u201cDeath Poker\u201d a version of poker that includes some peculiar rules.\nDuring these death games, the contestants can use different \u201ccheats\u201d like \u201csee the next card in the deck\u201d or \u201creplace one of the cards in their hand\u201d in order to get an edge over the competitors. \nAs a VR game, the player's movements will be reflected from the player's avatar, so cheating might not be so easy. That\u2019s why reading the competitor's moves is vital.\n\nAfter enjoying the single-player mode, compete with people from all over the world in the multiplayer mode!", "short_description": "\"Death Game Hotel\" is an online death game battle in which players participate in the \"Death Game 2000\", a secret tournament where contestants can obtain anything they want if they win, but in order to do so, they might have to bet even their own body parts!"}, {"images": {"nodes": [{"file_name": "cover_landscape_2560_1440.png", "id": "6112948172106988", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035367_6112948175440321_6451161069029939314_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ht6wXh_hGXUQ7kNvwHFXNHh&_nc_oc=AdpKkWZf62eA9QvxCCf9kwgNeGxxULIdawvBY0wRDSJpP33hVWzrxrCsc91JmXzkp_0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-H2WxM-qGPssNg_8q12zmIUQQ9I2hl20DzfNHW6jF_Jw&oe=6A3003C4"}, {"file_name": "icon_512.png", "id": "3371671376431982", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031552_3371671379765315_2780957423181262654_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wd7fN2ZOfMUQ7kNvwHY3idy&_nc_oc=AdpQcECuDo7pHTWFKVVORYhXvnyTG4_vvURYub56hlFIxBuMbnGPL6K5tBoz5r6q6GM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-X7ixOKtHiSPob07ymOciIeAPhn7sD8UOPoFM_idhkZw&oe=6A3002E6"}, {"file_name": "logo_transparent_1024.png", "id": "1943980932621029", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/43997708_1943980935954362_2181026677061938546_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7WSfXbsLCsQ7kNvwExYXLI&_nc_oc=AdrbT--3DW0Np4JWUc4yGUSRqBRZEXRtnj5os5_rt8pP8QP0t2MX6b-R1QReRj7XZ3Q&_nc_zt=3&_nc_ht=sco
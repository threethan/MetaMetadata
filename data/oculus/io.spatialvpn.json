_screenshot_4.png", "id": "1045190640416353", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499311570_1045190643749686_6963919862558426760_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-7Y2E5jExkQ7kNvwHrn1fI&_nc_oc=AdoUX1S6Jiyt1lGecnM9QgbztvKl2nK-v-kJTIHduW1LogjjppgWdAOMP3bPF-0gN3A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkUHU0UByKeYLlU8B22y7biSBb9y-fHjXNFggELCd0sQ&oe=6AFB2453"}, {"file_name": "spatialvpn_screenshot_5.png", "id": "734752105782101", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499320091_734752109115434_8381809951458558164_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50Z_p3Ap7kIQ7kNvwGuL7-6&_nc_oc=AdphRTQmrDwSsMk9WFDVVIeVH6ZdxpBQO-JyAdN4XynMwTjxjY2bMi4QihVkXBRPLMQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZXRfG5DXdXIm-r2Z1lvN3Jv9KDPaS7b0KMJyUBMLN4g&oe=6AFB2A6B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SpatialVPN", "keywords": [], "long_description": "SpatialVPN is a virtual private network (VPN) service that helps users protect their privacy and bypass geo-blocking. SpatialVPN masks your IP address and encrypts the data, ensuring safe access to information and securing communication channels.\n\n**What does SpatialVPN offer?**\n- Protecting your privacy while surfing online.\n- Accessing geo-restricted content, such as Netflix or Amazon Prime.\n- Switch IPs to join game servers from other regions.\n\n**How do I install SpatialVPN?**\n\nYou can access Meta Quest App Store to download and install SpatialVPN.\n\n**How do I use SpatialVPN?**\n1. Launch SpatialVPN.\n2. Select the server whose ip you desire.\n3. Click the START button.\n4. Launch the app your want to use.", "short_description": "SpatialVPN is a virtual private network (VPN) service that helps users protect their privacy and bypass geo-blocking. SpatialVPN masks your IP address and encrypts the data, ensuring safe access to information and securing communication channels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatialvpn.com/privacy-policy", "developer_terms_of_service_url": "https://spatialvpn.com/terms-of-service", "publisher_name": "Jarvis Reality", "support_website_url": null, "website_url": "https://spatialvpn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9849108451871641"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "3762153654078498"}, {"status": "CANCELLED", "id": "878840001140551"}, {"status": "PUBLISHED", "id": "1243749490562541"}, {"status": "PUBLISHED", "id": "703421608828820"}]}, "baseline_offer": {"id": "3762153654078498"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1762761540, "status": "PUBLISHED", "id": "3762153654078498"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25425661817123053", "version": "0.26.0-beta"}, "id": "873467698085252", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8381373675311800", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2542
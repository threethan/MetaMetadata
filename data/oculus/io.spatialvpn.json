-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_N5ep1vCk2WFRBl6LaJgidb5FdCiT4GWtD8nCp3HPBA&oe=69B69B13"}, {"file_name": "spatialvpn_screenshot_5.png", "id": "734752105782101", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499320091_734752109115434_8381809951458558164_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBIm07Bmo_wQ7kNvwGsLH_w&_nc_oc=AdndBPLaFdAjchxzMWez7L4WnOAFWEzag328_Kb5_6X0zjD7wusZQziQ8IIdWcBPVuw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfweHgzt8vbQArU549aAgHKfsLtfowQpRCtwnoHS-f3BlQ&oe=69B6A12B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SpatialVPN", "keywords": [], "long_description": "SpatialVPN is a virtual private network (VPN) service that helps users protect their privacy and bypass geo-blocking. SpatialVPN masks your IP address and encrypts the data, ensuring safe access to information and securing communication channels.\n\n**What does SpatialVPN offer?**\n- Protecting your privacy while surfing online.\n- Accessing geo-restricted content, such as Netflix or Amazon Prime.\n- Switch IPs to join game servers from other regions.\n\n**How do I install SpatialVPN?**\n\nYou can access Meta Quest App Store to download and install SpatialVPN.\n\n**How do I use SpatialVPN?**\n1. Launch SpatialVPN.\n2. Select the server whose ip you desire.\n3. Click the START button.\n4. Launch the app your want to use.", "short_description": "SpatialVPN is a virtual private network (VPN) service that helps users protect their privacy and bypass geo-blocking. SpatialVPN masks your IP address and encrypts the data, ensuring safe access to information and securing communication channels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatialvpn.com/privacy-policy", "developer_terms_of_service_url": "https://spatialvpn.com/terms-of-service", "publisher_name": "Jarvis Reality", "support_website_url": null, "website_url": "https://spatialvpn.com/", "category": null, "comfort_rating": "COMFORTABLE
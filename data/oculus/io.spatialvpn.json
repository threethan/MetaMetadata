-2.oculuscdn.com&_nc_ss=8&oh=00_Afz0HkaRF6-sYqe5tnsPPvBbmsgHKydIVr_fDZMw3v_4cA&oe=69AC0F13"}, {"file_name": "spatialvpn_screenshot_5.png", "id": "734752105782101", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499320091_734752109115434_8381809951458558164_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hn1UWNYJCP8Q7kNvwEQy8QV&_nc_oc=Adlb9VLd_OTLRwlRxhE9h3XAnAvt4Hhf1k0o-xiaxJaflpCgonTEoyi99AjogjW_YUw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwawV7fo9HgEYlqkSESuzaNtL37NmErMR52lpTiGdfNig&oe=69AC152B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SpatialVPN", "keywords": [], "long_description": "SpatialVPN is a virtual private network (VPN) service that helps users protect their privacy and bypass geo-blocking. SpatialVPN masks your IP address and encrypts the data, ensuring safe access to information and securing communication channels.\n\n**What does SpatialVPN offer?**\n- Protecting your privacy while surfing online.\n- Accessing geo-restricted content, such as Netflix or Amazon Prime.\n- Switch IPs to join game servers from other regions.\n\n**How do I install SpatialVPN?**\n\nYou can access Meta Quest App Store to download and install SpatialVPN.\n\n**How do I use SpatialVPN?**\n1. Launch SpatialVPN.\n2. Select the server whose ip you desire.\n3. Click the START button.\n4. Launch the app your want to use.", "short_description": "SpatialVPN is a virtual private network (VPN) service that helps users protect their privacy and bypass geo-blocking. SpatialVPN masks your IP address and encrypts the data, ensuring safe access to information and securing communication channels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatialvpn.com/privacy-policy", "developer_terms_of_service_url": "https://spatialvpn.com/terms-of-service", "publisher_name": "Jarvis Reality", "support_website_url": null, "website_url": "https://spatialvpn.com/", "category": null, "comfort_rating": "COMFORTABLE
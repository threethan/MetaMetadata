jt-o6xZbBsRk795l_WQWenmdz7lhY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXvhGQfXovpkk7QuDtgE-e-jCpRSLwQmyTbvCubeOLkDg&oe=6B0F15B6"}, {"file_name": "3.png", "id": "3602710546566455", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619374_3602710549899788_4255259749896711678_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnlL4o5Ruw8Q7kNvwFeOF3a&_nc_oc=Adq1DBOiW02dbkvY1Uw1GtR1Du9r-HnwQqQgFAlQZe02CBfq801xmj19QE_LAHl5cG4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVjXEkjj9Ds_gtQISu38GQ4YGQfUrS5YfVxiQaLTORR9A&oe=6B0F0D37"}, {"file_name": "4.png", "id": "4740721102919449", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620666_4740721106252782_6429758701208672776_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnqy-u5Zrc0Q7kNvwGLkosb&_nc_oc=Adqi5zXIRXhcjlv1Q2O8fMKjE66srLZeGkK4vMXP-lxyY8mhBgmQ0y0KklA3dcmDS9c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWmrph4nlCp0-5dxPWJdfcLOBGn7QvxYpg85qoWQISPBA&oe=6B0EFD76"}, {"file_name": "5.png", "id": "2364803057598521", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619382_2364803060931854_3144603814991071160_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yyO-_AHL6gQ7kNvwGYq6k0&_nc_oc=AdpUTabUnGa9-2LsyC0Lu3jwvtqfC0a-xCrJ-5ByeJRZjMJdFMgTj-pPBFGvqfv1NXo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUvjQXrIYqe_MpU86qd4N1aPTAFNC9MewwKkZhtlh4-vQ&oe=6B0EFA08"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am Taxi Driver - VR TAXI", "keywords": ["taxi", "driver", "simulator", "crazy", "cab"], "long_description": "Welcome to I Am Taxi Driver - VR Taxi, the most immersive and interactive cab-driving simulation built exclusively for Meta Quest! \ud83e\udd7d Take control of your virtual yellow cab and experience the chaotic, highly detailed life of an urban taxi driver with complete hand-tracking freedom. \ud83d\udea6\n\nCore Gameplay Features:\n\ud83c\udf9b\ufe0f Fully Interactive Cockpit: Operate your vehicle using realistic physics and hand gestures\u2014shift gears, turn on signals, trigger wipers, and control dashboard systems with precision.\n\n\ud83d\udccd Dynamic Passenger Pickup & GPS Navigation: Use your in-car dashboard GPS to accept passenger requests, locate clients across the city streets, open doors, and transport them to their destinations against the clock. \u23f1\ufe0f\n\n\ud83d\udcfb In-Car Entertainment & Gadgets: Tune into different radio stations, adjust the volume, check your digital stats, interact with fun dashboard toys like bobbleheads and swinging dice, or handle items like drinks and snacks inside your cab. \ud83c\udf54\ud83c\udfb6\n\n\ud83c\udf06 Vibrant Open-World City: Cruise through colorful urban environments filled with lively pedestrians, dynamic traffic, and engaging street-level activities. \ud83d\udeb6\u200d\u2642\ufe0f\ud83d\ude97\n\n\ud83c\udfae Realistic VR Mechanics: Enjoy intuitive driving controls, responsive car components, and engaging arcade-style passenger interactions designed specifically for virtual reality. \ud83d\udcaf\n\nFasten your seatbelt, tune your favorite radio station, start the engine, and build your reputation as the best cab driver in town today! \ud83c\udfc6\ud83d\ude80", "short_description": "Dive into the ultimate virtual reality taxi simulator! Master fully interactive cockpit controls, pick up quirky passengers across a vibrant city, tune your radio, and navigate urban streets in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://teamdigitalaesthet.wixsite.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Digital Aesthetics", "support_website_url": null, "website_url": "https://teamdigitalaesthet.wixsite.com/privacypolicy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "
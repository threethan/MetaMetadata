0a&_nc_ohc=BO346cekRuEQ7kNvwErgwPJ&_nc_oc=AdoDyW3ZDCkdex7R_v6Hh3yn2YrEFTVh7p4t_L4bKAn4Kojrpnmv27vEVtD8f2ICXO0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0gU-IVCR0lHW3IADTMN0hiG06l6VauI76jL7eNQBkHw&oe=6A71E8DC"}, {"file_name": "Screenshot05.png", "id": "1498628125248633", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820855_1498628128581966_6083480357527824537_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoSRkIHR-7oQ7kNvwGnOK3B&_nc_oc=Adr0mExOwoZFeuEk7eaFG37q0Vkz6hjHa9RIl1ePAYt8uR2DKeA2WdQhvcqbb0KHTfg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBx6DXTNhwUOmE7if5tqH2syp2wfcYR_K7T0-DKabV4g&oe=6A71DBBF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tabernacle: An Immersive Journey", "keywords": ["Tabernacle", "Bible", "Israel", "Education", "History"], "long_description": "Experience a historical reconstruction of the biblical Tabernacle, built with attention to the descriptions found in the Book of Exodus.\n\nStep into a 1:1 scale environment designed for learning and immersion. Walk from the Outer Court into the Holy Place, encountering the furniture and architecture as described in the Bible.\n\nWhether for study or reflection, this 3D journey brings the dimensions and atmosphere of the Tabernacle to life with visual clarity.\n\nKey Features:\n\nHistorical Accuracy: Reconstructed based on the biblical record.\n\nVR Visuals: Textures and lighting optimized for VR performance.\n\nFocus on Learning: An educational environment for all ages.\n\nImmersive Scale: Experience the physical size of the Tabernacle in VR.\n\nYour Feedback is Appreciated\n\nAs a solo developer, I am working to refine this experience, and your insights are valuable to me. If you have suggestions, encounter technical issues, or would like to share your thoughts on the reconstruction, please feel free to reach out to me at: contact@andrescasaretto.ch\n\nYour feedback helps me ensure this journey is as accurate as possible. Thank you for your download and for exploring this journey.", "short_description": "Step into a historical reconstruction of the biblical Tabernacle, built based on the descriptions in the Book of Exodus.\n\nDesigned for learning and immersion, this experience allows you to walk through a 1:1 scale environment of the Outer Court and Holy Place. Encounter the architecture and artifacts in a 3D journey that brings the dimensions and atmosphere of the Bible to life with visual clarity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dropbox.com/scl/fi/eu5z3jwzsg7mdofssqsv6/Privacy-Policy.pdf?rlkey=7h25llbmgzzb1j83s1sgr9dz7&st=s3cepkum&dl=0", "developer_terms_of_service_url": null, "publisher_name": "Andres David Casaretto", "support_website_url": null, "website_url": "http://andrescasaretto.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26591774473855479"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825345_1478204370362076_6499545417108782209_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HxxcMA9HRwQ7kNvwFlFWjz&_nc_oc=AdqjlSVH4-6x2oANbuYD57R2pJZsqxQHWm9ppM4gurwbl5Twov8eos-kTwpDdi8NmKQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHFhCq4wJyXxgyifHVgBOixAXFcPllhpmf
nail": {"file_name": "Screen-shot-2.png", "id": "1597395304302621", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391812_1597395307635954_8820657106032723390_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJ60LPa8suAQ7kNvwFdjUrM&_nc_oc=AdkIzBrI8NqBay1Un6Rxd_M8L-rInYvXkUb6Ze-ptFtkx-lvtRT0hPRSVa9yRu9x240&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsDiHVw6hBv5nZ89jFRLkBKcTjM5MlXDSwmPpSJ6RuhPg&oe=69A2EC63"}, "display_name": "360DentalRelief", "keywords": ["Dentistry", "Sedation", "DentalAnxiety", "DigitalSedation", "VirtuaRealityDentistry"], "long_description": "\n360 Dental Relief Reduce Patients' Anxiety in Under 1 Minute with Risk-Free VR Sedation.\n\nThe consequences of dental anxiety for your patients can be:\n\nDelayed or avoided dental care.\nIncreased pain and discomfort during treatments.\nNegative dental experience.\nStress and anxiety that spill over into other aspects of their life.\n\nBenefits for Dental Practices:\n\nMore Relaxed & Cooperative Patients\nIncreased Efficiency & Patient Satisfaction\nImproved Online Reputation \n\n\nBacked by robust research\nMinimal setup, no delays\nPays for itself with one relaxed patient per month\n97% patient satisfaction\n\nKey benefits include:\n\nRapid Anxiety Reduction: VR Digital Sedation alleviates dental anxiety quickly, allowing patients to relax before and during procedures.\n\nEnhanced Patient Experience: A state-of-the-art immersive experience that not only eases anxiety but also builds trust and commitment.\n\nBoosted Revenue: With fewer cancellations and improved patient satisfaction, practices see a direct positive impact.\n\nProven and Risk-Free: Backed by extensive research, ensuring a safe and effective solution.\n\nEasy integration with existing dental practice setups.\n\nComprehensive ongoing support and regular software updates.\n\nDetailed analytics to monitor patient feedback and appointment adherence.", "short_description": "Revolutionize your dental practice with our VR Digital Sedation solution\u2014reduce patient anxiety in under 1 minute and boost appointment adherence with an immersive, risk-free experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Qqjk-NovdbyKjKvN4Rq6qSioV84zGaxAuPoDeWjQYcU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "FRZ", "support_website_url": null, "website_url": "https://360relief.care/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29886128317702374"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "3288662634630943"}, {"status": "PUBLISHED", "id": "4072262469692816"}, {"status": "PUBLISHED", "id": "1125503139756475"}, {"status": "PUBLISHED", "id": "25342115565404646"}, {"status": "PUBLISHED", "id": "1141556601215142"}, {"status": "PUBLISHED", "id": "1680182982665916"}, {"status": "PUBLISHED", "id": "1460314295122201"}, {"status": "PUBLISHED", "id": "674221535426832"}]}, "baseline_offer": {"id": "3288662634630943"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765531380, "status": "PUBLISHED", "id": "3288662634630943"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "32101741286141055", "version": "1.1"}, "id": "2287629894929347", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": fal
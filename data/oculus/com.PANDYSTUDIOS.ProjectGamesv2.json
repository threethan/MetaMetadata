6797203389002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZT4bBpCMsUQ7kNvwGKUyfK&_nc_oc=Adr8qItZQh_8RqqDPbaW9HLeb9tEJz8-3rWON_fP9HoPuwZnPCRNOUDoMR1CIrlwLLs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IF_XD_KWtlsdy2CA8JTQvcNAfRyDx0r9z1S10SsevvQ&oe=6A05B789"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKj_45iaPFsQ7kNvwEsbtiR&_nc_oc=Adqkb0Tl9tEFP4N97MigkZ32QDvJZW1B9gEG-3kfl5wACTWaJVc3xz_1QYS6gOu-nPQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sbwXr8YwRMY0pSGxmsDFhM4sHYS61F-gTyQMk6iIG9g&oe=6A05CA6B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ss7hg0q2raYQ7kNvwHXAYEb&_nc_oc=Adrz5i7D7TnF1iWWXkuEyOZsY6KgA6Wvri6izWn1kL65lZMLHXnda6XC2cH9V9Lz7as&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ye7E8tgzQfudqHtq8QAizA7kkR-8iT2IMtNILm5aYew&oe=6A05EB94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
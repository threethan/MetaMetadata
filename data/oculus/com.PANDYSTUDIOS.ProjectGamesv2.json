6797203389002", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoDcqNyN-BkQ7kNvwEXvBOg&_nc_oc=Adrsec_W_wLSQs16s_1V2FK1kI1MWa2j9l_WbsD8Xj8pZX3pHHqPsm5v-y4xG5HPZ8U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKz4H_l4di2Vczi4w0FFDsW86Vg_jzAEGxUjn9ZxoOf5w&oe=6ABA8D49"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfnDQ7ePrsoQ7kNvwG4sQGc&_nc_oc=AdrzAxOtdg3uIsa69F58Chnv3gFACoX-F2XP7CE0sVOI24R6GC_59XzmJ-5hSZTPOwM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCsAQKDXipWaCvMV3RfWTh3rjsbrpnPg6KnCQ3Kdp1Kw&oe=6ABA67EB"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQivdcheBDUQ7kNvwHXHlBZ&_nc_oc=AdrNb56CI__pLgLTb83QhAgpsgX7AfwdSwTPfcsMWCl1xQ-Do-V3Sa60YSCWMCS4UT8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlXD2PZnTRNJTxu3cTGTcOwoJvg9gwYZmB-fOygd49xQ&oe=6ABA8914"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
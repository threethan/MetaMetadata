6797203389002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqWjiUNrnuUQ7kNvwGQA6n3&_nc_oc=AdpncMEUkQTe-7--z2Yf80KW6NDHWY0qRo_J1NNr7_tlSOm0JdTRj_-K268v5L5Ny6g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQII_wU5DNcO-cdFPl4x8-dFyv4RLeKv9HywqK9UulDh1A&oe=6AA81849"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znT3cUiwencQ7kNvwE1xL4E&_nc_oc=AdrEyxRMpm03EhFACjXTUmrn8rtFDlhLi8ciA_uo1_29n_sMTUGB31Fq50TWfxUk5-Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKljgtYcdPtyRjB0TlcixZrRXPwLcc14d1IyRrQIgnaOg&oe=6AA7F2EB"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOvszI2x0ScQ7kNvwFbLUlj&_nc_oc=AdqO3DdyaZ2MdFtUYFx4RSKm0HEmgxqFEaVApxlCKRR0rsJXAnGNi_M_Q9Hmn8v-kOY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMrWS9EwEhcTcBj50Uba0FmpkhtNdgTDcdbryaJA02XQ&oe=6AA81414"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
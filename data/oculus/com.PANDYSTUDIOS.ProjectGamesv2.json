6797203389002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSxixxjsnkoQ7kNvwGblMDg&_nc_oc=Adp3K4xBmy7OIl9aMdMMuYQEjv4xQkowftIVhXBGsyVF1dTpuAb7XUB4yUvwNyrOaXY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LvLipkDechlWhsVGIwJsmW0nO6PAW-4ry4OERSL7xdA&oe=69D64189"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3UM649v5wUQ7kNvwFkClin&_nc_oc=Adre5vwCTZTLInxIcZy_G5mn1FsOMZgINDPtsSlAWsZR5Jf4EfzG6GgABJIK5UXdnCA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1shh719jcfyN4V-Vh71uD1YSmLVbMkp__C_zqt7kvw2Q&oe=69D6546B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbRrPlkfG5IQ7kNvwH02Ned&_nc_oc=Ado5W0wO86QTA-TH96fyORhAJwqn6Qdw1Mi7RRkKwob37i_xdrsOIEPzRFxXBMWomh8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34HszA7SbQOUvH73QxqNR2aNCluiM5A5N2gBObrzyJAw&oe=69D63D54"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
6797203389002", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0FtbQXkfq0Q7kNvwHRD58_&_nc_oc=Ado4Zot6rXBG08K0X5rk93jcKv_OAx3gknvjr66vyvXq-RMMg93E3OVUK9vM8YhDgy0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQpqPpdmSi9DMfTy9UyIUaU0fDuj-zh1KzEB5_jqjyPg&oe=6A620089"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AF475-kHoDsQ7kNvwGqW9PY&_nc_oc=Adp0I0uvKV3dIydyPwe4loPSNg5Ia3zDWYHsh5yilKkqmIvOgTqlXas9_XqdtYbFJC0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGljTG3oGR_ShkDfixhsSYYFQ3wKc-LDpe9eKpky-Y2w&oe=6A62136B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xmnns_2IlUEQ7kNvwHqihkd&_nc_oc=Adp4MiHCKtk_3la_6VNgiuu6e56kN5svw_O69EFjfDzbIQrjU08tLz2dFvoTSHVALvA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDND72uyIFWx8sCr5Wtce4I8ElR-F3C6BJZJjw_hZRKgQ&oe=6A623494"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
6797203389002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dugSD6kKSBUQ7kNvwFa2fTr&_nc_oc=Adrc-j0G2mSiwzMLUSKT2WDDKlKiRiEd3SLk4cWnQHrBO_QnTx9gP8laIqnmcvGIQVc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAa5r3MZcX11GsWz-lpQUf9dEYWqUUk2dC4zLnrCEEWaw&oe=6A6B3B09"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=isUk2q96LMIQ7kNvwGJTA7b&_nc_oc=AdptdmxLAZDzYlYpukS7-vsOhUz0pbE5VlKafiA8yIfQss9a-ThCtmmWddVXadFsBO0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmH3-PyxcF2FLuoD4kXXb7qqjCZhtxrNwu2_0iyVR5uA&oe=6A6B4DEB"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yylSe-9vnkQ7kNvwE1_dPr&_nc_oc=AdoFNISHsPtFkVWsBaqXfWD5sHwijj2n357_HF9BAXmD7a0A6d6wD0xqZhxfZw2wPU4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVlcCu9lVe3x2f6pXRN-gkCwSevMphAX8n-ebQ_ENM6g&oe=6A6B36D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
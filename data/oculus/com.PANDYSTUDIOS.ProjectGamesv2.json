6797203389002", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z86O-g3JpiwQ7kNvwFtpMlK&_nc_oc=AdrwlMLKjbF7z96uXBwAXknlr080zX3RssbwfowRVz3gQ_G6P7JJFyJOERJ3BIq6jTA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFPxYAYVWZNC_CFONgiWhNdBcuofA-GeAdCYa2jX9KkA&oe=6A9AE949"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqaO3TRhfv4Q7kNvwEESNcy&_nc_oc=Adp_Loh5dvDKM5wXzEwNKVlmVaGVFd2_ecR1uIeh-6M7inY_KuxUA-D8WpLX5ZkWjv8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIU7j9pBROR-Kj1alsdQFlMBDOLGGk7cALEMmYW2Hd-fQ&oe=6A9AC3EB"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUU5kcRoCF8Q7kNvwFuX53T&_nc_oc=Adoh3sCVcOpTaeRJGCTrWf0P4f4bBuGA6SC-jpsSmM1wcvvN2YmMAkDUmnyrMqXtqrk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINYsPSS6BcjduJYiTYsIJUoyLB9r5K_c0YN1q35tsD_Q&oe=6A9AE514"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
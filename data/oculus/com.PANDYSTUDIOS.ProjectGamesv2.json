6797203389002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ml8OpybLcGMQ7kNvwH7mWH2&_nc_oc=AdrP5T8XH1ETu-a1QU8f6K8sR9kHIql4fkYKVdAmlBZM7pGukOnLaJNmRhqGDLC1pBI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KT1-ZQIc-D6kqk6yc0PMpOsWZ3usfOZkEprxYSHONFQ&oe=6A3808C9"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkG7_uFCj78Q7kNvwEftf0K&_nc_oc=Adr6flGVJMt4T5nTTGO0mmbrSODTdHk_O9RleyqRmD2HWEwEvSBhwJOJrdqM9Y1F9Pc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GiVUZMG03cgtOwjoEA1YTruE9Yep7dUBfkEC7kmWXsw&oe=6A37E36B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4a-WYW-gexYQ7kNvwHvc7Og&_nc_oc=AdrXgUNRIIHdasFcFFDJyNNA9u2e5OINNa9FfzegZXwYg8qsan2h3PJreDEtABhiJR4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lK0LZJOZ0QcVn_c-boiQAjzZYLReSFniP5C279IBckQ&oe=6A380494"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
6797203389002", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUVaq771bBwQ7kNvwEcfVii&_nc_oc=Adppk2slBe7y_iiWGbfaGfGB6R0T_b7d2wqWfYhzbxH7wf-yXaApzDxpzfMgiWO9upY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiNfxJpryGST2h7G5-YYY0nLUo5hHm6AAJ5QtIm0J1mw&oe=6A6DDE09"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rj7PRLVeBGQQ7kNvwFTEHlz&_nc_oc=AdqUJwwf9vpdLGFfGnRb0e_8tPeAMpOyWJPC5l8WIi8vjh0HPbO6TRiLDM9OH0q_MQg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHT_ScN0WAxZZ0j9cZHONf873wKV6NHtLkR6Zn5IT39A&oe=6A6DF0EB"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAuUJlthpCYQ7kNvwGVnF2h&_nc_oc=Adr1l8x3wXkK0um2Fm4m8pZoZcyWEYzqGl1het23d-2c56UsU3fMeuxZ1CG1Fyat56Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuemI5WfwGR8fDYR5hQPyKn9RO0DRspKWQZzw34Tr5pw&oe=6A6DD9D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
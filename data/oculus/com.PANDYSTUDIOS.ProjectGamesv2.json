6797203389002", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEqgdzcvg4AQ7kNvwE199XI&_nc_oc=Ado9SgM2ZMk_eQdWksx5RtAfYM4uxcFD_YT3sF7iU6qziZ1umkmCzxD152qRIj0LSOg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH1BhjImiM7Sbey8OJNhcc-v46RYUpSJvrROqTC-lr4A&oe=6AF9D549"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdZ503W1d60Q7kNvwFt75D1&_nc_oc=Adoaxrr-7kxspwvs_AvI87k_gBgg-fdifKhCPnkvOhOgKXjYnckY23gCLU-zzgwIjyQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHfIl7chLhVvs5yYALnJ2y0JqOWSMWJg7gnXnSaMRg-g&oe=6AF9E82B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_MQcgsfaNsQ7kNvwFgt6r6&_nc_oc=Adpdk4pAMHS6WJ2dJiFjByqiswjZZmFPyhl2FeVo6b8rOw0CJF0n9_Z7cBGzts3PHFo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_WFC7BwnvldlC69WYLKRWRB-VsCxxoZImMAYpNGiaAA&oe=6AF9D114"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
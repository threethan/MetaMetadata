6797203389002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0ab96Q-lMAQ7kNvwGMxu0h&_nc_oc=Adp1S4K__SYCIdxoBAW8rvbPPGU9aMyTQmS0VibwnTvKlKzDJblZFvHERmE_E5qxyNU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-urzkeTpYasHeQHF_zWMHRsHyQYoKyADUQhZcXe2dBiQ&oe=6A3BFD49"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dAe2BBREMzMQ7kNvwEJg3kp&_nc_oc=AdrTqEQM8CgqxVbZFBXXDxo0SmG2S9cBFbEuuDyNfRik43Vz2t1oQKbm9O-2n6grQZY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RQgYQuIGVinCKGDeiJocZJc76YNtDRyA2tOyHg7x29Q&oe=6A3BD7EB"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJJy8sv1WHsQ7kNvwFIHvMG&_nc_oc=AdrhmWSkw64Dca7m4xkBACMkKMVMw4RcBGhp3JsCG-V87LHqTlS19Zs2MH_fry3SrBE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hJO4npB-btu1InYWMMyEysHRvaDi5uXX5_wgyVXwF2w&oe=6A3BF914"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
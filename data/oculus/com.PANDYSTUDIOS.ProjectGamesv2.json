6797203389002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k97kFapVCxsQ7kNvwFKK3Qh&_nc_oc=Adr9BI09mAWGsXmvrITOEbt9GiOyeAbnc8KkxBQLx5FRc1d0GRt5GCdYtvh7uMl3QeM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmRJLrEuHWsX97q6bUA0ShCKNhmeQ1lrToogH3C7mxSg&oe=6AEDF7C9"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hH9CFdmHsp4Q7kNvwHxa25w&_nc_oc=AdpCoLrm0SurnAyC9-4fdp13Zh6X_ObIsfrz2eKOznaeFBz6DUTgmdrA3VdyWm5n69c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhAjsQdHHurM8nMDcEE_Gwx9zz6xG3wGSgycsQURD4tA&oe=6AEE0AAB"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTwW0G2vIzkQ7kNvwFk6JTD&_nc_oc=AdqAZ1iAKZoZNQUTpfs-clllg9p1Z5iHOzTf5TXKdLct-_ot_0FrcMDTfLetRnrmbQM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTL4ljGyb8OzY4DruEh1KuFN96Pm79ujqufU7k9DzCThg&oe=6AEDF394"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
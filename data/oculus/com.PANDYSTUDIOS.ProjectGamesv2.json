6797203389002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cF5QzAWT2X0Q7kNvwHMS6td&_nc_oc=Adpi-qZ-JCUUY0678VA_MSjZ60P1Ol-22lBM7Bj1LfBdGJQpJK5XEI7rxlM9I2l2TIE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWjKBRWqxoobBhfZLPVG7YliTFPtlPOIe3cTXwrxU8rA&oe=6AD24849"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bh58vAh-ggQ7kNvwG_Z-vD&_nc_oc=AdpikWSpgWXTCQzQRRUcbIECjpj1Q2Vj0B9RLM-10IzFqxOWHz99YpppxNhgI0JQIE0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9k40Z6UkFR5o4hCx99mk7iAPXUP7cwieFcBkxViCrkA&oe=6AD25B2B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWQjCAByUVgQ7kNvwE5jJxC&_nc_oc=Adr3cXuOx1wiug6tChWxRLHddYZkCT8HlLfbZVvsFXhPKh-WnWM31OwwN0hjysjm3hM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOynSTplovpIJjjPPSPWItx-wQe1y60Smj5i-rYL0MNDg&oe=6AD24414"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
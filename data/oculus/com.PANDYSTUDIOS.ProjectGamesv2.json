6797203389002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09GBrXbIdq8Q7kNvwGH3Mz9&_nc_oc=AdqO0d0QAmnuPjLKREMV03tZoMzuCYmQiniUgPCg63AZZTUMYS8l2yygQ4alz1sXNfQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nUwz7JWBxWcfxdNIH3ycoci_aoER1zSMy3L6gNmnLiw&oe=6A43E649"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcZ1ZufbWAgQ7kNvwHSpVpH&_nc_oc=AdrUTKZho2DHDrHXK9ktfABt2qZQFIjoYlM7exxseNlzxgZ39lsjf_niBP4dS9DHsfc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cA6T3MnadJjSZQEm7Ptkis5mHrvZ2hCgin-E_Xz2bsA&oe=6A43C0EB"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mf9JbGQsbCEQ7kNvwFyr-9z&_nc_oc=Ado5onPUfAxXlpkqrprYevn1uIjdx8QU40jjLlddPsRkroUxEraDoQ3a-nQbvKvqQvo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7hiqawotYpVYN9sYxl3gtQQW6r9EaFAWjnGR_SRWw8A&oe=6A43E214"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
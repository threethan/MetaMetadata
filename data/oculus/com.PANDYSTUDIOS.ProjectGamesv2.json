6797203389002", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35luMrfEVTcQ7kNvwGzupPo&_nc_oc=AdrWjwkEHRGUMkbFE_m-16x7eT881t0U7fuVbK95DWbht4LK5ZHQYrj9Oa4u1Vo2I0c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFv4mEIOG-_HA991WtMxcKqvQOL-ilZVbzx2mKbRiocJw&oe=6A898D89"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HiT4jduDmJYQ7kNvwEEa7d7&_nc_oc=AdpeO4_TBb8e5TIgnBgRwt_U-rjyRHjtEV5vDI-sWyzv0KW77wSbFJNIhPG8UuiFgzg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfy_dHbFRl9tCwr95DdPQ_Xoy7B1cEQqv1Ucj_XjiwxQ&oe=6A89A06B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jX7q1d0GFdYQ7kNvwF-KFul&_nc_oc=AdrIv-SXz2wsErCqOLxpAShWPyX1L1QD4CTVc1jBuiLk7M1-GnA1TdSYnlgm1SQAtWQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmLPMnQTUDyOBrw1QIr9WAdliEnxu27NOjphYSgMGd3g&oe=6A898954"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
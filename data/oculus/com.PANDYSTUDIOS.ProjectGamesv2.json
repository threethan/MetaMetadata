6797203389002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApoiDRaqZoAQ7kNvwGTlEOr&_nc_oc=AdqNNc1BjX_5uf7lfqDwXkaHZ-s7it_yGFaq4pSSPuOz-mKXi3o9-4CuawTlqNpDoUE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14m7w_Il-nMPL1EwlcBNt1Tlu-k94ZWBZtgYJrrxmIIA&oe=69E37089"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZTiQ-oIhssQ7kNvwFbu3rp&_nc_oc=AdoIah1ouUQBN1WSmgMXAF6NOk7FdJmxZa-fglYF8lZY_dFKpaO9lnyoKGJJils_4PY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18SwCC6GsYYGI_Xcwdkftjw2tvC9J8P7TvSmkiTMXxJw&oe=69E3836B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lnf8jra6psEQ7kNvwFZtSzH&_nc_oc=AdqxHo4HezeuD66nca7uP7f_2hNrRFYm9yJ8pTsHXda6tSxVn3JrghR_t9OsbRtDSkM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0sVDbjwfti_p9O9GA23j35iMtLOmISSZZg-F-EU6K4_g&oe=69E36C54"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
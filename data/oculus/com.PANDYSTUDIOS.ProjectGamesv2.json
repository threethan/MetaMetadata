6797203389002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azGJDsjBl7oQ7kNvwE__0O_&_nc_oc=Adpb-wh_1JgLw2j8oKG2nH4-t-wnXK-_q8-3bKUkO9BH0pY8_rVINBd46P2eOwnkwSA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6hxJuNL4CQ1zB9I-ekYzz0WrW4yeQ5_bynSz8XCXwfA&oe=6AF1EC49"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nm7W7CLewPgQ7kNvwE8IFEL&_nc_oc=AdrpG_kteQ3jgWM6fA9OBhrgeHjXWd72NqaJXvdeJomnQbuwkmjd5KqV0i2UU7wg3vI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQshE2EPhlwEPI5kyq9YZr-vm78xbNc6ZGidl-qQHeDw&oe=6AF1FF2B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8v4DFgM2mQQ7kNvwE0kWMY&_nc_oc=AdrmSl-wOVzhOKeL9DxSHrFvtiFnkBg8X4bCDx4ytHNBDx8TlAeIlPxFDVzRIyDKu28&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsMPAzU8XYNq9Vuvsx7kzkbIDucku8i0bkIEFXUcT09A&oe=6AF1E814"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
6797203389002", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiR0IMxbRycQ7kNvwHkHfLj&_nc_oc=AdrFEW6az8-VGaFYr8-rmEA6qawCCk_zL8cTUj6A8Lm7EhIY3DiQe-v-8fDVb9pxX84&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3i5l-6-ajpYImllTktp3BlVbwSgvkxGeKIvNRHNIPvpQ&oe=69DE2A89"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjhbR_s4dUIQ7kNvwEJZe8l&_nc_oc=AdoIVqMGUzICQ__ZkbP20F4zCUtoEjoTT0REhadfpb-SYLd5AvCUa7PuoZzSZhejw2w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GLfuI6lUHaLlflsGj34L9WDpXNYJDJWVQ94TFORIxJg&oe=69DE3D6B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_-3xc_jQIgQ7kNvwHLjlKW&_nc_oc=AdrnfCzqRHWndiFrX5BueLv4aE-c69ruiq26FdA-VxrDaNU4vOxOe06VScWbnFXSPwc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Fij1HPj9a8U70p2pCepEHC2-t8_sbxzWeXtOS7oCnQQ&oe=69DE2654"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
6797203389002", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhxRs40MVmYQ7kNvwFWNYLw&_nc_oc=AdrHRrJqP2evoMCIpJ6KpF3D7JQt03mptxoucm9eRJGK9XFBHdZm_RmG-tJ3yHY90Y8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbeoa46iPyM32Hq5m5KhAs8vxpuOBU2gcOvYDI7O3Vgw&oe=6A9C3AC9"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JGYbqCp3M0Q7kNvwEd785H&_nc_oc=AdpPF8Sq8o-VKy_--MqCfZd0F6odX6yHZAgEuz0a3JqiICzBjE6yGcOOB0FOAqeQiDA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpWIUyk2riCO3tkCDiQaGlwMCw2DMO8nXM1b9BCVGilA&oe=6A9C156B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXH6T-cGxQQQ7kNvwEkIq5U&_nc_oc=AdoUNqV_hHgnYNllghJFa6Eu9h5ac8EK_DFMhFrVPHkah26O0yM99cg7IqW-Af4Dcs4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPM06RZCOxVdpc-VG-ujmahlie9yGuyOgsjLPh-Soswg&oe=6A9C3694"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
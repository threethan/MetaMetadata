6797203389002", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aCNfefMK5kQ7kNvwEm6sPT&_nc_oc=Adp-QluNn3Kitsct9FB88257alO2i3hRkfwtqW2ElWvVGuHs7v-OWdWz2CLRT8nc5ZQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gzFkNSgNX4ldlKhx6Mx-Yipve-a8nglzDtYj2CtgZBw&oe=6A317149"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-R_WFT_AhH4Q7kNvwFnSHl7&_nc_oc=Adq6qehYh_WOIEgUUpI79XOl8LhLIDz_bHgUs3LekmdGkyegEufDI7SoJtrGX2dT1x0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8f3f2HehCjZbP_GDszudFh0RwJn0J8heDUE6yqyVvUzw&oe=6A314BEB"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VoNV0yT9tWMQ7kNvwG_2UwT&_nc_oc=Adr3rbeeWyS4tvf054idamkay5MNb4iQpwndI5M3VTtCryBRCQuGadstjSz93v30wuE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aZ_Iozic2bqKTlJYf5gyLDOEDbMyypo6FBdvLt3Qt_Q&oe=6A316D14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while maintaining age-appropriate content and full compliance with Meta\u2019s data use and age group policies.\n\n", "short_description": "a fun gorilla tag fan game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gametaggersprivacypolicy/home?read_current=1", "developer_terms_of_service_url": null, "publisher_name": "Tonda", "support_website_url": null, "website_url": "https://youtube.com/@pandyvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "9651215518281398"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9688085587927724", "version": "1.1.43"}, "id": "592646347167762", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9638833419519608", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9688085587927724"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "592646347167762"}]}, "change_log": null, "created_date": 1745890235, "id": "9688085587927724", "version": 
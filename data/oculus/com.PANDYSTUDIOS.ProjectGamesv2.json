6797203389002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpz5W9raYq8Q7kNvwHJeEHT&_nc_oc=Adr8wsv4pHuZe07BesbkE2kIdWNEB4ZDuMGY_blmxfhPEmpeRSW-qmO8pdDlW4L02z8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcyUyoGWV1245bedUxc7FNs93MFmS-tMuPGip5Ym9rTQ&oe=6A8C3089"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZyijC0RNr4Q7kNvwGuC89y&_nc_oc=AdprdhyLql5S4MDHu23YUqevYSPTzoYkt1vlMylVSf44i9fUJvueypr_HlFZ9cGxNCs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbEHj7dWXKNc3Lx1tcU2gViTDPkUvlza9wEL2Wh7pVag&oe=6A8C436B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qsahFCH3xoQ7kNvwFQg3Ld&_nc_oc=AdouAV8hAsXvywhBdekkXlxgkhQNo4DY4wejsGlSgs58vd8Qic3T_cWCaSkzDrigbGw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELzZ0E673yufQhVfdl33od3SCrHPkb5o-_p_YX3wDKTw&oe=6A8C2C54"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
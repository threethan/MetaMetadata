6797203389002", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsfRy0qurbQQ7kNvwEgyXFG&_nc_oc=AdrTsK22iwG0AuoJt_JDA_QDRUase8Npe6ublpdnTPLi8UDTfICH1yf5wgvqWgLgtt8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZMdBgA3iAAumYahcntd-bO_k0IcI5O4ZEKqPz3H4_6Q&oe=6A54D189"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EiqKAImeytQQ7kNvwHJuhsv&_nc_oc=AdrXzZmRgbPVsvFxt0qMj3o5RQE0jA15s0DZ7OXh0Vk5ZOgcsvlT0pas9_PsxoIHnvQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5x4lmW2VANc-Kp7n_wS1sfUKvnbNMW4gL2NeE0HzkdQ&oe=6A54E46B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQVXQz1uT3gQ7kNvwHX-3_3&_nc_oc=AdqkPN7hO0u8v9OxJ9Kzw6igSbjEfgnzGXri31z4XT0s0_ltALvD9Ck5n7mE308XQ2I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfVsuKV16vLbMu3GMAjqpFVIA1kIcye_mywx9OF4-F7A&oe=6A550594"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
6797203389002", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1DJt7p0x6EQ7kNvwEU6UOb&_nc_oc=Adq2YNpBGvl8opxGAtHF_Mr27KcKz6AQ6_SKYxGAvxHMH1nyaruVoq1GiqHa1CNsfaA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKD8MKUxmlcYr9MkD_uQSguCVGbEthtTPzHoLMCKFsKgg&oe=6ABE81C9"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILkSbWMF-pEQ7kNvwFuzevb&_nc_oc=Adqptox0U67G1qEtAZMKNrrxoU7HImoN3EKbnuF-o6yqbWyEAOMSA_0mhxLlm9Iqwas&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBto4wl19x2j4abpb2YoBllDZSwtzCQXpKK61GxL03aA&oe=6ABE5C6B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQ9g4UzueAwQ7kNvwGdTXV3&_nc_oc=Adr-Ea4cc8j1d6BYa3sQedzQTGa6fxdNIWO_37vngfmzZ9h_vqXaF_6HSHW0HCEHWic&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLULY_fj3TrIfT2GTzjvtqqMD83xk_jZt-H0QflTsYRLA&oe=6ABE7D94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
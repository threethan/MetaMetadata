6797203389002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oPCPvlGtpoQ7kNvwFxbEAn&_nc_oc=AdrPnxeYl_DwtnBjN3BCqLLwJrdPbcA6hZM2NkqwdA6mdLO-SfVWJzQ_eTJeWAia9jA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALenP9hcvtexWCnz3LvKpMvR5g7bDrWPCJktXXDXtcQQ&oe=6A674689"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6-tcMmFMdMQ7kNvwGY3eTM&_nc_oc=AdoaYuRl9QYnbcbYPx9SslZMcBzmWAWhs2lzvC5_j2_ygJhKFoWoa07W3Gxv1tK4aio&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUtrJ7LrbDdd-4SUf25yv33evMLF-ZRjQYnVqcc6o53w&oe=6A67596B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVtw-jlDihgQ7kNvwE5SPhj&_nc_oc=AdqQLTPeAWGEeEUli_Nz_cpn1qnyUF7SIGPYFJmJAJE6EVym2PAGlCWmGSwddEzHq1Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6YwB8dbOAJaG1EReqaEpXtOtxm0yYNsEZWDbFNYKx-A&oe=6A674254"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
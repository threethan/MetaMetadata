6797203389002", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09GBrXbIdq8Q7kNvwE-7qBB&_nc_oc=AdpjU_KkOGh3W9DPDu8AwbsOfM58WgVtouPbeccdR-5v8WFlDmyyvK-ioUkCvMXqMOc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OD4TMOU_TMx8hQ3TsofPPgfYCimMbh-FkddR7eyX6gA&oe=6A4294C9"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcZ1ZufbWAgQ7kNvwFe6wMF&_nc_oc=AdriF5r9iASkEh9lHbpSQ2xIbqdOKbyTe5x3bklnZS9YZZF_OCHh7_yabY038mPH7_k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-W-VI-lUf2PbjUKuL1Yat7UoWvKQx0jlgurb8ivPFrig&oe=6A426F6B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mf9JbGQsbCEQ7kNvwGrF1PV&_nc_oc=AdrohS5pyxXETr2zJu31FER-It9Xquo9pyAbNmbDLjSBRU0BtTE_Crc0Ah08no9pT1Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ih8awuAZSywAEBEzTrcI1q0DbGffDqiZVJ7U4tcOQUw&oe=6A429094"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
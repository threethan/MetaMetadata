6797203389002", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7f5cKJCYLcQ7kNvwGKAXgZ&_nc_oc=AdpaS_jmWy7Ba1fSADerXz4lep_HYgW5rY7K3B_goVC3KUgZ9MRwYLMzCiNvbEP8DFA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzBIw1Kc6KyhB4zbMLTw2Rv6abJygbOygDQgqCSFxEnag&oe=69C27B09"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKkJqpNesggQ7kNvwGNrcq3&_nc_oc=AdolApUXf53-LdXs43bLvSuHmV5qyggJCt4ma5aB1B5zjDz9HJ-o_xhm8qzI1zdNzKs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyshtJD_TR3a70B8ey30kdi07kD0i9j9aQo5wOyqVNZrQ&oe=69C28DEB"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-G6W_r9rLhoQ7kNvwFI-hC_&_nc_oc=Adqb7BNYZjjZnmL0rBZ1j9rwSE8cNi4yudH8MUnGPWc6pUOBVh03MFQqaQXTDref4W0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwqNQew6z7BiuZRKfFXSNspd61hDWdjP9k_8PYNB6ssdw&oe=69C276D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
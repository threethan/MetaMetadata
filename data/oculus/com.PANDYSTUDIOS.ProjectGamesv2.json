6797203389002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzKv9g-G1nIQ7kNvwGdQCBY&_nc_oc=AdodS1YMJvvb7ygrJyiY1j_xQAH_JRpG6vrVROhfy-Atxod0fouaQIcWrmilA-nZ3FM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3GDDnAbHxKywewFVx5UHQ2UIBzzmmaz-xRGU3nKTlbA&oe=6ACA5F49"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hi_djClWSRcQ7kNvwEnBDiM&_nc_oc=Adr8jQ57ye9Jsu8dtNbcY_UBSnzFP_OFcnBwmyO4CWVRKiDvXpE80MG8fV-iBhjF5ew&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPdlIXaYiG96ec2iM9f11AwaLaSyD_k3mNutvcW566kQ&oe=6ACA722B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwloBMtnOqEQ7kNvwG5WBpI&_nc_oc=AdrWNVDMbt-YoCsnyvI9iZ8zT0ir7WiPzI-xmGLvb7C0fsaefW5GUyMM5wAek2UdMFQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjGBv2SDf9U814Xyfj7hqRRV1lagSj3kMyhoW8RkdxkQ&oe=6ACA5B14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
6797203389002", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgx5jLzlVqkQ7kNvwHnf8OS&_nc_oc=AdpcH2DspoZ8omhveiFUahj187arCvz29nTL3ORVhZ0RzzkzcJxJZKQop5J_KQc1u54&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5y6a_z8DcSuhwRpZsUwS_DePPBXwvSM4yYRZCKvx9o1Q&oe=6A0B35C9"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b97S3aYYDiIQ7kNvwFstVvo&_nc_oc=AdpAZSAZVUAdWiDwEC8gk5glpgry6qfJOD1r2XGXG2wn4ry9GSNmWD_u23siXktYZL0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DQAnY_ql3jnnEaDyt1mZHQCB7mJVO32zVllZU6lkzCQ&oe=6A0B106B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpiJ7NCsE9AQ7kNvwFN2HKk&_nc_oc=AdqJSv0sf0nwolmMw29u6qfsxmNSUcl9lGzOd-x9H6tQu3IFNbUJRAdUJRJocm86Ty0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YTXwVxGqyx8wwr5ELnK78oX2iZhXcLOuqc7DtyG2tGw&oe=6A0B3194"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
6797203389002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HGI06uFZFYQ7kNvwGtJjIz&_nc_oc=Adq1yd9l6oQqwjjbr17yDW7ZY3z-nIIOp9NuPwREPdBS4OhvvU1Dp_acR8C3ZKPJQG8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDc4MLd8yGHD-r79VhmTJQkNrYqODuNEe2vwyXQAMsHfg&oe=6A4A7DC9"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opUDB_PFdK8Q7kNvwFtk1X8&_nc_oc=Ado-SNnrt7uece0v_5UZenRDGWArsXCpD9t2nDXEG61IjLK8oLmc51TWAmD7-Ly8IOw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAopTA62ThOzu_vsKpl8lsDqbFuWNP5PWyFDXqMeoY3Xw&oe=6A4A586B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKxZkcpHx2IQ7kNvwExBogC&_nc_oc=Ado80_sSnxj-a3c_rKNPUm_A9MKOgr4cA99pzbUbW4rE65glfrSG15rmIMKL6AboThY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWvAOQYn_WTcXJv0x71e-GqO0xO7zFoMZvLNU_RZCzDg&oe=6A4A7994"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
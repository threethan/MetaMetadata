6797203389002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuYZS39Gz3sQ7kNvwGMWwvx&_nc_oc=AdrqWuD8H-xi87NN6fSd-s7monTXPotybNNK_28jD_mFLUCRHnu_tOpdmzWhyjIhdj8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5McsJsDUlgtSpcnsRLKO4-j3MgKmTzuR6vPoE68AsCRQ&oe=6A007189"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xstiDQWQKvEQ7kNvwEN6qgq&_nc_oc=AdpvtbgzDE3SUAbnq3E2gPYyRyM-BRZX2I-jM66vIlASW5gaeLIccPg9KseiRj39QsA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_5UKeLcOZghoSEYI2DqjP52PKw97SRCJRCeXDvn30AQ&oe=6A00846B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=498u7yxDMDEQ7kNvwG39lTE&_nc_oc=AdrW469nPbOXi_1JCCACYaQVkm2oalCS7amQT1i5On9nCJGB_HvXoLGkVq-yNR5V3to&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aYdS8yWgED1uNoF9eydUKmogJUllLLMubcyuGXtEr_Q&oe=6A00A594"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
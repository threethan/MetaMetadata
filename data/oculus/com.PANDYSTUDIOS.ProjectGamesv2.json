6797203389002", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6gVV-yoG1gQ7kNvwH44RXu&_nc_oc=AdpMcTxops5iS6LcBvqPxD0Mw4FtB9uP9zrVewKBlMms3gWe2hrpOkyyomuL9MGz8GQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyh3TK819CiEsomGS-9Lu4ma5pMWLSQIWD3eVrtXWugcw&oe=69C7C109"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UWRHwfVqu8Q7kNvwFtSR2Q&_nc_oc=Adr0GxSyHLrf79V9px_SSugPQ66nZzConN6KJSwWYTUJex4sCYszecgyqcSR6eoAd9w&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwUpcvFj86GtihGRrdlvAjWKz00cS6m9Q6DyP_C2SFIhw&oe=69C7D3EB"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYgXweg_52AQ7kNvwE1wDhB&_nc_oc=Adp_wgMrNmebeYuGnp1hXIWCWEadkcSaUzPg0jyaIQhwC3_UDsEuBid9TSngOTBBgC0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCoVFu3b2WcKTe1QbMne1Ze5pJNczNYbYbAXVn6CJwAA&oe=69C7BCD4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
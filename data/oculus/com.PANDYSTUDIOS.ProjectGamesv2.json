6797203389002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z86O-g3JpiwQ7kNvwE3gUDj&_nc_oc=AdoEWHV9_-Ufzh0A1cW6iFBfHRZGmYpj0RgRUvHlOs6FfyYdgGZ3SIrksyz67z1R4_o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWzIyDDtTwLKeYXDwBmWmZGNog12zIMOsvz_NpXA8ZBA&oe=6A984649"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqaO3TRhfv4Q7kNvwFs_Icl&_nc_oc=AdpEW2kK1BRfKg6j9hRloF2t-pwHkPK6IvGkSsowIxhJDQSJfqyagYpiLHGMaQrdoLI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJN_GYk5tknWJL6DEg9OFB6t2Tu3dvgH3XdOybK8kAISw&oe=6A98592B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUU5kcRoCF8Q7kNvwGwJqC-&_nc_oc=AdpxiUMShJMtujSLhj_-a_roc48QiauaKbIOBPb5W6Nx1EBMWJdc0rgMcoxC4I3gMbQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7fcW5c4heKekjGYLWZEkk8KYnjWhMWqy5f9VYSPHQCw&oe=6A984214"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
6797203389002", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzKv9g-G1nIQ7kNvwH2q7KY&_nc_oc=AdqYhVdWiRZMhgup5EpQr8p0gG4UczkcrlBZ-SItiO-T0I5m5A1TeLEkS0IqVL-BJa8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWP6hHIBn2_SscDWgW5XYzN68R50r1zNLUgHabryCM_g&oe=6AC7BC49"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hi_djClWSRcQ7kNvwEtzQYx&_nc_oc=AdoSF5-RFmbs8rDgiU0q5G9ylw8tqY9Rd7s7JEJrAFZMbJQ6mveVdCF9LRBPaoNDYy8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJ_m9pdPsf0igoKxt4LSHKd7vDnu3uHD-pK5VzDQJEdA&oe=6AC7CF2B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwloBMtnOqEQ7kNvwG3WfZr&_nc_oc=Adqh5i0iRqJfyspBRwTGyafiuIS4E3axhNM7PHdZLOS8-hH-MP2T88UI3nw2ZGlJFuI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpkYRyVh68FZcojDUBIgk02kyQOI9lfr-PdWzf1cBVog&oe=6AC7B814"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
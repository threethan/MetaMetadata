6797203389002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnWpUtE8yuQQ7kNvwFIskRB&_nc_oc=AdoX-TAJK2yCIqkurreQJibnZAjvRBTgIOv1sw73A38fB1vXBBJgwK5VMiVmPsfHpFQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFt4E81RDKMFUes8Fsa3QwN--JM-dCSVqRQBdVJpSwlxA&oe=6A7F0189"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXOyCtItZ9IQ7kNvwHjwo24&_nc_oc=AdqDlgUBdjbp8VZzRC7oRIJ8O4Ohuz4oIXmIH7hPPIEBpAZuFg-S1pGMb4UgatpEZAQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVO0GGYnLRxtScffJMEBHXDsLn0ZN_dJLA-QA-6_Elsg&oe=6A7F146B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkDi0Jo7C5YQ7kNvwEqhwDs&_nc_oc=Adoliap7BkaibViDWRBQDpwy6B53JTki2p33wTuqEJp4LgkJOfL-EfW5aTNwGqmskM8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHK0djho693RyHKxssz4QaH3Pd8NfPBNdbal6plxpIZoQ&oe=6A7EFD54"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
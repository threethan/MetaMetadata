6797203389002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEqgdzcvg4AQ7kNvwGC9C_l&_nc_oc=AdphmHb0FfDunYMJ8bQJbwoh_1rvlwuUn3h5pBoVRusyInzAzp77jbzpUfxvUeF4XZI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqZvl8ElCaAM-M7WJjJhRSB9EOQog4iBvahPYm6W0ZVg&oe=6AF73249"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdZ503W1d60Q7kNvwE47EKc&_nc_oc=AdqsSjEnTnRoV4IWubF-equhBsgXONxujlxy7ALisfuUl_pGrMFiHEirw8jQh4aKodk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTSQdJfqDFmqQxoDOnI7AqvAlssZG_F-o0y9TQ5-h-kA&oe=6AF7452B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_MQcgsfaNsQ7kNvwHs83i6&_nc_oc=AdpPnQqhUbrkS1aLNUVC2BZPDDNMIMJE-0ecuwDyDTGM-iGWBUUiktMeW96WOdabniM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoip6cP_HkWZyVtmtlLsNeL-zG3hZOtOiTRSnSRC-NjQ&oe=6AF72E14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
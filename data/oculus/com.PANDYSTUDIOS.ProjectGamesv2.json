6797203389002", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SH-ZBoaQhAwQ7kNvwG9QS7s&_nc_oc=AdrRk1MdRcra1dPr72uxCp2VWiRopBxv1jlu52OmhhuhZMrsxhkS0xRrv8LqP6Mgl9I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqsd2mvmCsht2LSYVfgcXYONuXwwE22Z7uQ4sOY1xNVw&oe=6A771889"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXBkWNi3RWAQ7kNvwH-xyAl&_nc_oc=AdqSQ7oCp_UjHONzFs60HkHuJtUoQqDwK3uqcVUP5vhGni-q9FfqXBlW-Esd-M-3WXY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElXz4yBRHrtnBMrJzJXW_lkYzZbFbslHkWecR-ji02nw&oe=6A772B6B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_UuloJ4CjAQ7kNvwGczww3&_nc_oc=Adr1IgJbCWtMN0URERZUuUlGyDmnTOUEYCPd09rENzed-64kYO-AkL2mHTL6ep-Bz4w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqMpy79ApCqdCCSZ7dk2Y9hcF9Aw-USTgdnOga1vnf4Q&oe=6A771454"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
6797203389002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YyALLfWk8ngQ7kNvwF-xUcx&_nc_oc=AdqdZ9WKKF4Rx41Xw321brlnvWQ4JgANVi1ek-easwP6qS5ShN6RfHXxm5l-7kARqzE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0Zn2-u6KKN8EPEh2ZIeHSO819r5umSBqSifLfAx8nXg&oe=6AB54749"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8WDmW7DFCwQ7kNvwHMCHzc&_nc_oc=AdpPGDoqBrFoYntOTWpxoZ8SlKxpjN1FbygY5F0PKUZOtAF7JxJymWG9VpPgKO-gfAw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoaApN2m8gzZu49FNQkOzO2iHhOQbHIVzjTrGmRnJu3A&oe=6AB521EB"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRzSuzKOaW8Q7kNvwFgOrX1&_nc_oc=AdrtNQFbf-tYczZZOKcf_vI9-mQkZzmgYWKQ7bvNaepI2anZgCMGUKkaL8Usz5dDt8Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_XgbzKYVl7ADlSk8uXzDcbnMHgEJiFTIIj1KaQrRoaw&oe=6AB54314"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
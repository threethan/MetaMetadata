6797203389002", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-05zYl8nJcQ7kNvwG1KM4X&_nc_oc=AdpAVmc0PqJi5Fuidf3Da4YYyqw-4sW0N8DYMx5N43VJBXjkxsqLEG2OyRI-SAiiAtg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1k_gM7-crV43W_Z83C8PDPSng1_zGTwBPPAdVzueyvA&oe=6AE0C8C9"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3rcozcZtckQ7kNvwHpw3Qc&_nc_oc=AdrOeDVJ3MfMd_aYFQshS-0iJfmbN13L3-W4AEcYddU0i1XSTs0VHV3Vsp95wUoimSo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6B6bfNuMVIPpyljHbl4peqb2JcK2qIJG7UvfUtRG2zQ&oe=6AE0A36B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RbYePMHUC0Q7kNvwGvoU1u&_nc_oc=AdppiYzQqDh-mVaJn1n-4wKh68NAYWSlR_1R81z9LKhjV6OQFEK-2hsQZSJshWOdY64&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSMm_znKR5wHsGH9xJaSvdV0tkUgnPz83Jtc9QjpydKA&oe=6AE0C494"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
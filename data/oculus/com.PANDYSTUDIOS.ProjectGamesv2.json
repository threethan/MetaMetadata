6797203389002", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5e_lBP9n64Q7kNvwFPIHl9&_nc_oc=AdoxmfmKWfIBX8zOGoRv_k29L1aL_5dD5z1KGIchF_KiKkjiVS5pDwnHzeMuDm-tw5E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2N7o1wMzpvGTejtH6YR38tcVA1YqcbNmNDkq2MJAx2w&oe=6A3EA049"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=094LZioEJzQQ7kNvwFJqZMl&_nc_oc=AdqKLujFPGow9V0l-igFoRMT6FXccOC5rEyqglBwHJbfNrsJyfRQx46XKfxUssCAHMU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ukt8pho2iZI52pus8NGC_2ks9vtD6_I_VrOVNS4StFQ&oe=6A3E7AEB"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXEYrZMul5wQ7kNvwHHkuBt&_nc_oc=Ado95cRzTRPfNa14xIl-ywRAJYnu4G_Ohe6kWGxg-PkpRIGldLX1z6aHpbsSsIZ0hGg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8k9i3SmexLyooyn7V58JEvNQPuPTYLR-28IdGg3ZRrBQ&oe=6A3E9C14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
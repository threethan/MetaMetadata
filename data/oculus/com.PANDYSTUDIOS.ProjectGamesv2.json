6797203389002", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXmdSJRlP8wQ7kNvwEnNtz6&_nc_oc=Adq-H8eT6kGY0a9fnoIoiTldIh28JVhX3k85rXUE4raguy8ym3MDrvPmvideTQLpvfA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0P9a_GcD6C4JI7yR8zjYmRBSLjIrb5I4UpE7-ncETYqQ&oe=69EF4E09"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_j4VjkiunJkQ7kNvwFBtjPa&_nc_oc=AdqoKHDnCUZnxCtIQLHTC68OgGW62-mETeX5Dnu0O8NoPwKxBfEtxW9wdNzs275xiwY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af38GS8YwqLdSadQAXWA5aCMvbjxsX17B1hIIHWgbLhpyw&oe=69EF60EB"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URhLIKlRHCgQ7kNvwFJvFYg&_nc_oc=AdpR88TlmO4sGbaBR-6ajVmWCprUrAOyNtUiJTeDAqWOu3wQlW5pD0bjCGBZjf6t-O4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0JkkKWIqJTnFC3mrZHNZl6M-hIltY6dvNWW4yrXQaLug&oe=69EF49D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
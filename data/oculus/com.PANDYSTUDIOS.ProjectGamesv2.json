6797203389002", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ml8OpybLcGMQ7kNvwGW58TB&_nc_oc=AdpjXZh9LHXjWHT51MdRHFUcVAp9TuvvTbLytZ85TEpPHlgpi0qzsFdN-EvCI32Hn-Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_k17k2pJK6KPbrEq89C9e7pywqkYY2vky9slvM3Li1xA&oe=6A3565C9"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkG7_uFCj78Q7kNvwG48aZt&_nc_oc=AdoxiuGnGwrpqFdFWHkeX6y5zqmTVThYszexKu3Etmzax4SL0Y2uX6kQBG_4JV-OJQA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-F_ubw9BjFcuCKueAFYOZyZuE4tjHaHcyRf_pWw7v00Q&oe=6A35406B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4a-WYW-gexYQ7kNvwFOEvgJ&_nc_oc=Ado80Vst8O1BzlOfdTNRWfkteX7moKZbfR9yQoAZdCUpcxkuNuhXuxRZq7s9Ha2DEEw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8X3NxyyE5STl-WaelbeXgtxFUf61KPgWSYARiTzGcdwQ&oe=6A356194"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
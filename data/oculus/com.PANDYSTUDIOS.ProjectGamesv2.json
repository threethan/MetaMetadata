6797203389002", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDZoEWfJZmYQ7kNvwFZ3JrS&_nc_oc=Adq45p08arfyRtM6DaON2Jk50942yZgqadHhwp9DnHSy-UgnvS3BzY6EoDOF5-W167M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8ZMkVep9BAOR1VEpXzy335e1dxxsc59sLQTG_sAN-Og&oe=6A86EA89"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJ-jG5gQzYsQ7kNvwH_KLTo&_nc_oc=AdqCGBaNJR9FrtgWXhF5WkgmZtyp6zrpIhT6rZGXaTJk3o6S6tgis8AEscUe7l-d36I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAnegeaFF8K1BVzL8aZBYvuwSFoGRIhL0esNzAnYwA4g&oe=6A86FD6B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkMW7pI4SQwQ7kNvwF6dzNm&_nc_oc=AdrR4zgGr6ErmoQOCFsCqGjF7tFf3LQfcL1Z9QtOZLk17vc7-VZ7Abkaq7yp0zPycwQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfzsHEPr1rKWCyf6mJQ-4lPhmYc2rnNYNFLhJ5V1zyxQ&oe=6A86E654"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
6797203389002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3CqFrbrppoQ7kNvwGFTY89&_nc_oc=AdoTtYpg8X4A43eYRYLLTXPpGRhKDGS0Xh1BwgC3ZcRDcgoH-BNlUWfdj0iX1NYPxxA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8Men0nsuQsCbUp4m5OKkU4khhDxT_-1cM7W5F-P7H8w&oe=6ABFD349"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpuutRIiZ8wQ7kNvwFYWm5q&_nc_oc=Ado2LTp3W357QfUJSwFMKVbYoL61hz-vySLmfiH8XJHZrkxosusCU3Ejm9nq31eBtC4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNH78N_aqyEJ_hHC_X7saTGH679vehJ9MC3rxokzU6XBA&oe=6ABFADEB"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyQ0Rrf3bwwQ7kNvwGhmJPT&_nc_oc=AdpFrDKyRFqLFuJSW5rxX-MzaUBuB9rxYExHPkAa_Hp7qxDz58Q_y91ChIB7DiwWTjg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuhDfCdjtGfc235oGpT_iBe-zdIgWis64Y-b_QfNm1hQ&oe=6ABFCF14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
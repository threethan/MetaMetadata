6797203389002", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgx5jLzlVqkQ7kNvwHDQJTw&_nc_oc=AdqTNvM5UHUVCkoaiKLw-8w36nDL9sUATHhxk9EyvS7j_h91QTWYH5FYzBiJ58gcYXU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CW6kES-mJajaQhWoEpi59kkmvYO6lULr0WLjf0irjTQ&oe=6A0C8749"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b97S3aYYDiIQ7kNvwGRcOtH&_nc_oc=Ado-G0dpddFJ8ziPzsG5IOXDmSJPE44qmMeqkuVC81A5-plTyofUi3ZI43dxI7-xxdE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58yBzbFceut_Y0ekNKYTsinln1dgZlxFv8yAOMn_kA-w&oe=6A0C61EB"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpiJ7NCsE9AQ7kNvwGPidHp&_nc_oc=AdrYQFdrkHSnlJWAI2zbi4G14pmX2LgtM-Mjl70nLU8uWAz1bPpVqpQp5Glrzhjav4o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BmgM96iigaRJjx-60bUjYDfkL7Lm7ReNLE9R8nMcPvw&oe=6A0C8314"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
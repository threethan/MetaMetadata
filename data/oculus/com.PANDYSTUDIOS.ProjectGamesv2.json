6797203389002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cI-dFbT6smgQ7kNvwEISuaO&_nc_oc=Ado4lJz84znsr00hhlgBnQKEg5ZdHfaIyzIzL_rfouPWjrPEf3i_JRtCySmWF4Rc85U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pybdUzcMuxFEN45WJGogT0CEvbyIM2ESJxKeR36mz9Q&oe=69D39E89"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2kW3HinMAsQ7kNvwGlU92h&_nc_oc=AdpzsPg57pfmyQ1CKgEs2EyELFJGZvaWyiH8o1HjG0kCyqNlR2oUt3T30cHgSQO5JPI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05XhkqmduxNmNe6sBi5L427g5f7__5cgCnaza4SgAWOw&oe=69D3B16B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-b8i3zTN0LMQ7kNvwG3eP7k&_nc_oc=AdoW8If4Tg-UWh08sJmoa8PAjrs-x98HZ0-ZzMxF50A-NhP9_eXCXnXGMAo4mFVn0vY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0g0lYj-mRlw9ib8GRxrrdCBIpsfNMobqCRIIIZNUxEUg&oe=69D39A54"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
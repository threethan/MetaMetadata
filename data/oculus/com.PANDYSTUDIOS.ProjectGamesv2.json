6797203389002", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgx5jLzlVqkQ7kNvwGuvr6G&_nc_oc=AdrpYj5YFkpqRtuHIuiKokdR0ZnAjx0kO2v8QAsMWFScXSbQ8zhyB8Dn0em4cz7KNRU&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Pqjjp3BkL_f0l5j0SQ5Js9ONkAU8fHTIkjAGubAnk3A&oe=6A09E449"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b97S3aYYDiIQ7kNvwFNadRd&_nc_oc=AdrSZMximsKOtBRDEjO06Jp6kSm8BUZxo7qMyPzM8fpGTiSfe15bsVGnuEE3T6tPFlA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5H2ed0YRPWKRuMqyGPIC1vkLpNc8YMuTHw-cpAJ_Js3A&oe=6A09BEEB"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpiJ7NCsE9AQ7kNvwHoB1-b&_nc_oc=Adrs7HjsyDzEcG0XN8ArcwBPBQXyDHFIZ1GU1R3ox9j5gtZSaUCWo6R4vYIr-0WN4wY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LewDECUWy0FUc2qe428znZU9crDR8sx6R4Y1p_oryyg&oe=6A09E014"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
6797203389002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXp4PDpK0_EQ7kNvwEmsEc6&_nc_oc=AdoPeW0QzsKTASjnPNvdYcXX_OPKdvXbMfS-RNOCU4WPEjWHugLhiTFsfbZtl6M6Hrs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35j5sbiXoKYVeew1RP6eK_LFFyDg8lEKy0LaT2fWKKPA&oe=69EA0809"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDRYjF3I2JAQ7kNvwEaxw9_&_nc_oc=Adoxo_A0ByFUuz0rjyJTbcS1_vGcCX91Rdq5R4vWt2npNJkKu0oJeq5Gp5w6ZH7XoQ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2L8XkoeJkCnJPFmwRjh07B5z-2fhEhFICryjrWWfz2xg&oe=69EA1AEB"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJ_D2r0Ar24Q7kNvwGsWOzh&_nc_oc=AdqLzqO8F9RuLUBM1pGRa1anXyePBLlbknK1iKAT2-Zolv55Jt7EqVvsuan6co3Zw7I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17WjnHdtYMckC1IWlPYc0glmAUHt9juH-EOR3_3hfDqg&oe=69EA03D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
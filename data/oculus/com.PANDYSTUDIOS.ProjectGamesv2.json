6797203389002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llUpK_xtKpMQ7kNvwGFsqb-&_nc_oc=AdoTTduSL5sUHXblD7MEoiSLf35A66hXY5Gb1I2zaRWOHxu8aHS_fAL6f4Baaw8bPqI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sS31tx_9pWLa3H88oFuZdy5AOL0NgZ3-QzyklZ-do7A&oe=69FC7D09"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgoPUt0tNxUQ7kNvwEt7feN&_nc_oc=Ado40o5XevGr-02pNHHYt6qQMSusMhvSmtrxrseHS4flJMh17V3-DvgbnGzEzmuHUsg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4d6vgeJUShj0s9WAzzzKyEwRUm5TVu7eUKMjSlUGTqQw&oe=69FC8FEB"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-t6uk-FoHsQ7kNvwGbQ2M0&_nc_oc=Ado714H9g7YNePlsNnF6pGnBCysnr57lgHKG--OyCx3CGZoj1r9RfpodrPzw-SDSTYU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gADQQuXDQL9kuIm53OEKQsA79J6cbhraeo7pTSbtBiw&oe=69FCB114"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
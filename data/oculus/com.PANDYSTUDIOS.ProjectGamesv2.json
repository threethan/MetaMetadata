6797203389002", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnWpUtE8yuQQ7kNvwF_xiAO&_nc_oc=AdrEjyQy4iTgWconRjFrxNC-p-mw0ZWV7TDX_82QTo-3digPSijOlwi_aHyzo6ZxqcE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH37zgXW3zEE5eJHecHwsQw02FbvN3bVXJwallIPr0Tjw&oe=6A7C5E89"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXOyCtItZ9IQ7kNvwFk_p-L&_nc_oc=AdrM8cxRNmGhWOusmeOpFCbMFQDXctcsZgfeCZ_v8_c-5vdogQ22Z0O3CEIqDWn-aJE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiGFS853_N24pdSjK8VdUns1fPiajdPfpUIKlXVtBDpg&oe=6A7C716B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkDi0Jo7C5YQ7kNvwFvPv-1&_nc_oc=Adr4c63BacE92H-eHdOq9pZBGwUQ_eJyjrRLlq5UzLf-AIdFtfZtGdp7Hu1WBgOeiaU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcGwgSCx9IX-zOXUqQfrpO4lxh3Up05Nlm6uJnWFWNLQ&oe=6A7C5A54"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
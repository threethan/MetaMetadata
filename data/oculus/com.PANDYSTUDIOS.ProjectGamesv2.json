6797203389002", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDZoEWfJZmYQ7kNvwFVpqVn&_nc_oc=AdqnUSb8n7bgR5U3MwI9Rn1JXIQLgK3Theplp-BEmino5mwM1HisNMlNS2TV2dWM8AY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE07sE8yt48dps9K15uGa1BxtMFOtC0hyzWwbnBzj0I2A&oe=6A844789"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJ-jG5gQzYsQ7kNvwG2kmG_&_nc_oc=AdqZFRCSlmfqqliNUFP5yaKCUpSoporlNUJ4mxkT_pMLg9t6Jg5w8YKcVUqa5jKFGNM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlcB_S9Yi54dumYv-8qn7jYyw-aZ1jmq6UaAoH7sknww&oe=6A845A6B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkMW7pI4SQwQ7kNvwGhe9eZ&_nc_oc=AdpxUmlqVBUehmPtt0AX9P-vDaufXHvm2zFXn4t1wCKJT5Fcj8UzuiLTWFNGxinsgJ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhkM_8l_v9rLZWgK3tSgvdGs-hfJ39AtjDrf7x330IqQ&oe=6A844354"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
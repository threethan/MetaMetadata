6797203389002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjMEtSPdVSQQ7kNvwErHQqK&_nc_oc=AdqX7mrfYbb0TO6F8MlAXfFL-NLQljc5EsyelfQhSZyoKnhyBUQqc1-pS4KQVuOWpX8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAArOvNGnp2AG1aqKQK5ATUM7F0XUYg1DWEKk-Gn7hPdg&oe=6A4CE889"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bxnwUwttYYQ7kNvwGM5t_l&_nc_oc=AdqIplZEjdVkFSf6L8ATcaIXSL88-Jcm4_IgpWa3uYOA_BMKkU8otI0Q3KeuGQv3ei8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAX8LIgkWfMU5-6YTmvDFJKcxUCn0ZTDGLHFNbHGgP27Q&oe=6A4CFB6B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQ8zheQN7GQQ7kNvwGSXJGJ&_nc_oc=AdrdEDRufn7FM-dSE3ZtVweLj-W3wVM9Zs_Q9HQtMRTq7-UFOLjsmOWAUob5IqihHfw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKrrC35Y5I-8OzhmhN0d48JALoV7e29YsKsPzBOV8Tuw&oe=6A4D1C94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
6797203389002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJPySKDfCzwQ7kNvwGzYfU-&_nc_oc=AdqPQmFrBSNWBXwpMnr4XHdpF93U5TcU5EanQc6DctUTucMOAb6_Bclc_sxzUT8njKo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lC2qQFIAHnPSiX2dU39qi4B1hjpy2gHhZtZlYyZgeIA&oe=6A031489"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vZd8DcBvVsQ7kNvwHP0OZN&_nc_oc=AdrKpSauqZTkDPDVgv9qhacw1dhl3PH2CNqvlcA470f15iPbQzi1Gp9Rm2h-xPOiy_k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WEysubedoc27k-HFW7aDnZ8-f30OKgmO6gwp6tgTqNA&oe=6A03276B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOaQOFkNT80Q7kNvwEi1g46&_nc_oc=Adp0WmDx0I3Sjfa2lZ5tweJva9M4vyQQ6dUgs2H4ElX1lnGlM4drbURgv7RoBWRzHdk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53PgWfgdyqQENPdBwcG8VEgbfojbKUw0XZ6aI7-whbmA&oe=6A034894"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
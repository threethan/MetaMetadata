6797203389002", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1c7y1angtSMQ7kNvwHa67XC&_nc_oc=Adof5PeOVbMV5b5FM0v-FdZe8bkWhLd7HZ6EqCBtz3oXQbk9yvIMoviST7p7N__b69Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzfiIMkg2c3mo8q4bRM56WS0M7D1nqhEPNUM-qAnzxnbg&oe=69CBB589"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbTmw3y0oXwQ7kNvwEYOwNS&_nc_oc=Adq73yuyeylinatEGGjAAARvXQDAkvqfTroStHBJR0k4ciku3nUolEluwjAn_ESWzJ0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfywM8eS0DC6o3KTSVirFVaWYIq-xLX6GGk3YPbwEJKdPw&oe=69CBC86B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqcE9MSlsT4Q7kNvwGSyFQ5&_nc_oc=Adp25k4N4CHlEChIVh6Iajz4QW78XbciR2mBKJ3cCFGSZh0egJNeQq4UfJ_w_SzVZwo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwHZAvu5pzWsIofdZCDJ8bk7vIpaeKIlLnVsgIdmu81kQ&oe=69CBB154"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
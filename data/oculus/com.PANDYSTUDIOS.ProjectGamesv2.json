6797203389002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-Q9jnjaDXEQ7kNvwFQAIqa&_nc_oc=Ado7PdtSbW1Op45TjDl2QQyEFTgI9nncT61IYMk7nHrfZ9yFSFlu8SvqixDvEx_bYJg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHb_Ghoq73PAsroGrrAWSg1Fqr49EQBIA0UHZkKPYVV2A&oe=6A79BB89"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KrVm-_t59sAQ7kNvwHbIbFt&_nc_oc=AdpbrVzErlzsccPEYIoQkzJeCq5h2cPyIPrS5pDa50LcXJroqkhd_AmHZylUx6KwMy4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHby1_XhDFVkVxHn9uaFqOHcDB5MOPgxTDoo3g1urlfTw&oe=6A79CE6B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhYZfHzYRYIQ7kNvwGMZiei&_nc_oc=AdqGMqjOXdnzDCqd7aOwxc5R7wVGJFVZGWbHjZQM-rPEcKg-dj9kf3lrq2GGEtd3LEc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBExjVlS5OvwTfVi0xbroKJvB1zBeeSb6voSLd04XIpA&oe=6A79B754"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
6797203389002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QkU_hKDLhAQ7kNvwGbaptf&_nc_oc=AdrL6uXRN2mOtLbn0GbLKe5tZWL6qIGCTP8nf7z1GGre_h6TmQzcDfyD1jdBE6R_8ds&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITUEPj7WC2INAHw1Ed7Oi3jd3BSHcbVc4o-fra85uzdA&oe=6AA2D249"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4IggwY-6g4Q7kNvwFxi0zo&_nc_oc=AdrPXQ_NyO7cNJJta_uL197Z5779R7h_PmCPMDrYniKam3poJ__jkCJXj4OGhlzQZjI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfJJPXEAyRJixYI5DjUOm-vGXUFmS1N7BkOH8bTr2_bw&oe=6AA2ACEB"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WU3Yx9ceX94Q7kNvwH0fL0o&_nc_oc=Adp5NgNU-8JBo_j4zy0Kdc6M9T37ztKLxjzAkUhx9wabySFlXuSLjrD0jetaIY3gJyA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2YSAqNTRlzYV_ehC4Z0DRnCc9l1hliTSa4zRLtSpy-A&oe=6AA2CE14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
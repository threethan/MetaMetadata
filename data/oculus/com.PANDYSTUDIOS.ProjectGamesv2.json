6797203389002", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JS945MVICUIQ7kNvwERFpDT&_nc_oc=AdrpH3uU5IrmOfNUnXUq0fCJydszlGsfLZj5oIbC7zGaXWBbCLNvjOLB9zAXrKloMCM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DqiuJtI5fkC-KZMfYjZAP8GE205WapgF1yGaX3YgkAg&oe=6A171349"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0E_nmYFCkIQ7kNvwFTD-Nc&_nc_oc=Adpdip5sfKImgq9l7usKObmLsZWlwU6iUv_xBUfB_lQLnjAfvUdb5HFntl8xjq2SC1w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wLw7ZUJYVcmRhk4pyYQYHP1DNS2XRwIv37W-6hk2y2A&oe=6A16EDEB"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMkoEb6jAFIQ7kNvwGvNr_2&_nc_oc=AdoP8E9B8gFbXKByKMmldoK1BaYwNosRs3BA5etQ9XMwQdd1AN-4a7R_G9BL4002rUY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77Tu60OeFHDNyd6joTLv25OanPjoOUTtfxJ9RTN3bmyQ&oe=6A170F14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
6797203389002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HGI06uFZFYQ7kNvwHAiCtg&_nc_oc=Adr84U9RGaoqKWfPA3EjEtPaKcU_gvC4xPKJkI4UNFbwM3pcTIpy_zLlPsJf2fEu1BU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPeV4Xs6wc8h4pr2sthRh83AY6kn9h6qmbWRzKdnzSrA&oe=6A492C49"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opUDB_PFdK8Q7kNvwEjzrIs&_nc_oc=Ado5wzUlTi7Z0mWC-LvmWZ8sT0rn4JtHp_ARW3e2yWZOR-ax19CQbfSPwH60pbbdf9s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7_0fteUa61WmyWUynU27JQj34BGg_GKaxOjmC8AJIJg&oe=6A4906EB"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKxZkcpHx2IQ7kNvwGOomip&_nc_oc=AdoHFqEJXRDCSgIytMaO7OWDbXwiPTqw4eU81e--C61aFJ7k1-4CWasCfSRsAr75Dk4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1d09Zabs1GFyaEazkfXdIR20fHklk05OKWfRvjyFEcg&oe=6A492814"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
6797203389002", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBcXHq7KTEIQ7kNvwGlxAVr&_nc_oc=Ado4114E3jQas7sGu6EfPvS6zNTuSg92Gb2gPxVb-2_DhFODEIf3DxkNlh9t44OjL1U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy8-esqFJwrAXVVXogHE8hM8LBGgFKBHMhB0MtfdGl-dQ&oe=69D0FB89"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4rK_LCZbr8Q7kNvwEhjnUO&_nc_oc=AdqGJ--Frr3nk1A5rRfAN8qBxxnTT0BAAX8jIzShSa0O6Orz7tsgPkyS7s2Vo3p6Ifo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxn-6uqTOtgkbIZSg_OojwI38RxgyroG9tLGKZtl-XPZw&oe=69D10E6B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmzF7HztQ7oQ7kNvwGPKQ_B&_nc_oc=Adp_fl35Nfcxy-H17fwwkqrb3tZQuoGC_nQ4_B57BdhdaJmmFJCLtlLS6Se4WjFn2q4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxkhew1Z8RTIp9M0r3SZyfu2VHCYdIRMqLGx84xfpHdTA&oe=69D0F754"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
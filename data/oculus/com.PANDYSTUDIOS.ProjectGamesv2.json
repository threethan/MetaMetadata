6797203389002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DH2k5vaKDsAQ7kNvwEiqOUf&_nc_oc=Adou_17ffczR9BVIaSUwuV7qq-H5UXu95ewhq-qZkZs-rD0UYYNs2mqelI1ekkDQfxw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGh_m8E1wQxPKCTS8x3mEijqeQRBExhxW7-tHYoZlglg&oe=6A5E0C09"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1UCbWb7ta0Q7kNvwHMj4j0&_nc_oc=Adr8wWVxWX3LH7LCSrtHJ_3rkDHktzbw2A88npC2vboKNSyifEYZjdRjSJmEDugRv6w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuRJmfLrgt7QrIdRPWtZ2iX2YErxI7DaSa-7VGbSll7w&oe=6A5E1EEB"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXK8wrbK9n8Q7kNvwGKMmhq&_nc_oc=AdrjaXD-48oXS4fKkfEVQGVttiEGuKMJAtU_l5irPx1ekVaTzoNMbMlZE15T_Jgc0NA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkTg8lTEAZLt4v2gzfG4VjeNbK7fivlWNfqloSn2VolQ&oe=6A5E07D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
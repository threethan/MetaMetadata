6797203389002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSxixxjsnkoQ7kNvwHliY35&_nc_oc=AdrHypj0eTMmMunVOfWphl6nFpcDyP7jydzwlcKmYPT5p0hGn-sf8pUa0WWif1u2Tew&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qGPkRBv7G0RihfVzRZqNFeh7CxQEfI_cdTu_WVurzRQ&oe=69D8E489"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3UM649v5wUQ7kNvwG7NwXz&_nc_oc=AdpNMsx2B6KW1djpk-TFTlX3vunWNlUv14ayi5QKxG8CeFZUGHHzGMQKjdilvJXSU9E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ifYLxFw-k_46UW_lW2bcymkbr0wa0nz0BgBZd7JrwuA&oe=69D8F76B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbRrPlkfG5IQ7kNvwFSn-Cq&_nc_oc=Adr9Jvm7JPpgQ4xHVlAp0sbg5vkhmwFadC7eJ_lSlQ5VQZC3vi7IIwlqe8rWAq9fIM4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XVenXmGh_M6FhzLkMmca-MMcXSkz1VP05ZzSXhR1v2w&oe=69D8E054"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
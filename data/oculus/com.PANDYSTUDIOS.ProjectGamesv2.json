6797203389002", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcMVEE1WQuEQ7kNvwHZQ-lY&_nc_oc=Adow_JLiZ7ShKHf9xQ6anncx8w-htUKsbFX06kTwV8Owvh3WXdCTp7kg5wkW42LwHtY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEh8qFVp8oySHjfeJcGpdcD1LNgIJzlUI_Bcanw1fsr6w&oe=6A972D09"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrQRIIBW11QQ7kNvwGFIEw2&_nc_oc=AdpXTIU79wxwDxrq_GfwGWoAjEOaBGuFjzG4W8QQZKBhQobTQkSV9HcqJKd1uPDlYdQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJ-EXz7MFgMbivq_7SGc3bbm6dI68jhxJdYNkae3OSAg&oe=6A973FEB"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyJ9HMclP3AQ7kNvwH5uY2A&_nc_oc=AdqnReAwdybL4c0Jmh2lPLlMcw7TjXtwU33zdZMM6Lk81EMpGSvuAFi8k2dpyEAjia8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuuGmT25r6vh7a1x3h0DZsJGh0AF1vlNEcUZwxegMn1w&oe=6A9728D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
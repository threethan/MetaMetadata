6797203389002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZT4bBpCMsUQ7kNvwEyHwhQ&_nc_oc=Adol6gSBPRjess5yUBnhVh2VtpjtJMSgKLH22Vk1f3n7_TOySXzokeBeip95AqfR2Pk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iMPEVYH7W4HFmqD2rWbb7yxO-FiC-_IdCj7dXyJAxjA&oe=6A085A89"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKj_45iaPFsQ7kNvwFn-0ua&_nc_oc=AdqxU0jdwBO88TARy2jG1bSppG9ka4DeLamBdiidD8_SMQwacm-brdY2T9zmfyd47Mg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hNVvFr468Ag8qda1d95yqcga_MislifBO5AqbUfUPoQ&oe=6A086D6B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ss7hg0q2raYQ7kNvwHx-8Ul&_nc_oc=AdrhxD2C45vkslGAo9rAQfXXMkvoY-GSZl-7liEjSyiSJx7NLRvK71HsKVL6JddCCjY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VZLJr02ox47K8Xk8uz6JQNqgj-VVOyiBWmM4W4Z1-vA&oe=6A088E94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
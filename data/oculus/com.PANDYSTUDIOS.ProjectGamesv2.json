6797203389002", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9X90SdMm_cQ7kNvwEKDF0f&_nc_oc=AdrXVotAAyRM3PWSvGFfLx_V5MCe45cG9mAWve77PgyegcUl8DMQi5z_ps3URV45c6I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76UcHjaE4vzjX0duwZkAsWxnkynX32MxQkjltfKy1mVw&oe=6A131EC9"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WjiuK6I4ScQ7kNvwH8e2Xw&_nc_oc=AdoMSAw2HMmuJ-o4UPv65Z53PPEHqFOocxqolWqOwzh5xnulb54t9UcAA3RCKfQaHX8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ykcV2frkTfl2RU6YgwUtx52-b25ZYQlVWSoficJWCcQ&oe=6A12F96B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiW8kNIijSMQ7kNvwH_IbJu&_nc_oc=AdoG8gzvK8UjUtemiNy0v0PwYb9SmTQUAJ5eppxYrmfZ51KmcH0pK2KA2G4KZTYo9XY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZlF2C18nR_1t7ZMQ4NVbhPb2swYJCATZkRo6Vsk7nrQ&oe=6A131A94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
6797203389002", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gYyechznW8Q7kNvwFehOiN&_nc_oc=Adr7VuyHSd3VDBDCPgA0P37dlIUVGdKpmSt9iYIDtXqZBVtXErA14ChRyiCXpD4aNck&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFv9j5ok13KjW3AS9QcI-ipxdQFnFM3wv4-Xu_-9nzvA&oe=6A538009"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jiitkJRgM8Q7kNvwHDEbh-&_nc_oc=AdpPGZ5it8b65c3WnumYh-98tPdUY9cdchWoWb315kARDzYBedZ_aUgVhnYSmfJzwos&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5FOLgkeifDUOMWFLm76vDyOf6zbHjmmYPF-atpOcHPg&oe=6A5392EB"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHxiyEzdET4Q7kNvwHI49sF&_nc_oc=Adq85KwBi41dC-WbYxAW9mvUFZjLf2Zd5PxX3WPk8ZX1-0-80bYPfRDU6wISGIB_YzA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMFK82KxPEScqiVO4VuYpiecj3oSsqpprymCA3-9L7OQ&oe=6A537BD4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
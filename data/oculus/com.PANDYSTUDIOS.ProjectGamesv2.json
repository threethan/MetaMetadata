6797203389002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEqgdzcvg4AQ7kNvwEHT2ha&_nc_oc=AdpuDC0RWt8iNuPuQuWz0JJlzm2U66Fe-IanCCTgVF0IMDWSd9vxQnLrHHvf5cviNkg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVDA9d7XNaZj3aak2kfzJ-RIFuRmmHwk47A0xabZTn0g&oe=6AF883C9"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdZ503W1d60Q7kNvwEpMJyg&_nc_oc=AdpYTPbwK2ddjrHnhH3NyvHx4cX_1U-6tQpsTE7QsoT6CS7gFVLUBM3VmvIuhveM9dY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUW_n0gABOZmJztuRssNXMPgg7CtviPTXcOyWnWPUHvw&oe=6AF896AB"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_MQcgsfaNsQ7kNvwEA882C&_nc_oc=Adp6Bxu4hxlB-nWiRtpNqLyprm9hc6l6Yn-bK7okBIou55-vUN4ZChRyOnKIpw6SC2U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwYFcDzpI_j4h9vqLf1fI9Tw5qW_aIDjtjqDrZBYCJkA&oe=6AF87F94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
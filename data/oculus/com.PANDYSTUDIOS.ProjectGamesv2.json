6797203389002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lh65MP9he2wQ7kNvwGlWVx1&_nc_oc=AdoGKbIBWlhXPtXjOCLOl6cv4CASM-IHF_nWo3YFkhUYP7DhjZdX6ddz1j4kMwQ50i4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEy0XaUm5lw-KLs_UQVWilbNmQk1YRZOVuKwzNVL7jPcQ&oe=6A708109"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1nB-xsS34gQ7kNvwHDTSEk&_nc_oc=Ados412qi4g18lzRWloIIoZwqxfXdAiTkAsUkqZfX4simVENR6q_L7LK92WRY7DaQnE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsCE5e9uMZ1kW_FuqzZC0dEeMPr6Y8vsyvamNkHMA3dg&oe=6A7093EB"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVZizaKyzgoQ7kNvwFCBXRa&_nc_oc=AdqTVcaNFELd61VtnumjghYBZKNJZqxRFBpJeTzj8r-OOBihsTaqAReK08aaPbUrPMI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyNmmWHMUkTGHcRGWX-XxJnELM_r-8eT6gMSGyb2mlmg&oe=6A707CD4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
6797203389002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZT4bBpCMsUQ7kNvwFdneOP&_nc_oc=Adr3eYG8WAuWLTlBfNA0F8g72dGP1j2kJwD_EK1A2aDQlFtMJ-D3CQfxT2HS7JepfuA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Tr5u7DYWmaPWn5WBO1IZdYO_t1sl5IrdbfGsWsdA8pg&oe=6A074149"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKj_45iaPFsQ7kNvwGULvWs&_nc_oc=AdoXCXcNeewrjKnk-E04WUwh1rW1wgGHscKzqEC_BwU_4PUZAkjC2524RNBq_0VstqA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Up-470uYwaocyPNY9764xIyX88oMU5-6uyYDPVgnDWA&oe=6A071BEB"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ss7hg0q2raYQ7kNvwGxclBc&_nc_oc=AdpqHsNaEahljanv4uqBUmygKHtsW79p3DPm-5y4dumy47eTnZLcrdoz6LxVAjkdUzA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RkY3bg7EO0PNcZQBZDWdwCRfp0UsEceb8OJZnbCtsOQ&oe=6A073D14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
6797203389002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAGMO8VVbT8Q7kNvwGiSKrs&_nc_oc=AdoExALn9soI4RvTtkPrWdynWdm2h2oVIq7FrorhafGQlwvfH5_tkXz46IpQtToyBLE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlqYAjapZhBznK14qk9q-xeOyt71QC_KwH7D04XUGYtA&oe=6AEA0349"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSqSUaeAbnUQ7kNvwGp3T5b&_nc_oc=AdrGVKcCQb2qNjejn_7ooDYSQmeZ-1VFSkQBt91kMgUlMTACw-8kmCOHZ3z26LaoZHg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSztDCJ9qGN7soYagFEQW9OaUQhVWTQtFkLY5l8OnDNNg&oe=6AE9DDEB"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lb3UW6znORMQ7kNvwGXVrRY&_nc_oc=AdoDrdYkDi2XHQoS0ERR1armey8VSrxasuPKTvvnr5cLL1QFQbo6Ua_0t_bTW0cAmPk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRd1tSw-5sOZWL9MNZ8OfDGH4CtksT75le7mb75E_nnVA&oe=6AE9FF14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
6797203389002", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiR0IMxbRycQ7kNvwFpGYfE&_nc_oc=AdoCZSVS_y150nb-MolpgJyjGmh9X1el0tml4G0JDkT3MaksOt9E4aKDnahhiQpL-XM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TlH6IEqrMu7yUiXr0-c-fEki0f7-hSiA32EOT-iAZMA&oe=69E0CD89"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjhbR_s4dUIQ7kNvwHtsF1c&_nc_oc=AdoNhbP9rHIOFD9WGJXGAdYqVU0Bi4WWjItTDqFLg3YWCG9QAmVrf43-oqVlSYtap94&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UL_5P-dTSqWhCnC5A5QI60d28BqD4r7LjYzdtqq9uZw&oe=69E0E06B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_-3xc_jQIgQ7kNvwEDlBxH&_nc_oc=AdqgNLVvyIGRVKTLObuJ7duXcEsVy0mbvrPkS6gFVpjSkoni7InLsEPn0DYYwywJLbs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ek7e-Hvq0vspsmn34wDVtl9Wc69Mi2nCYwZne4fFyrg&oe=69E0C954"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
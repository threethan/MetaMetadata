6797203389002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k97kFapVCxsQ7kNvwGYAjmp&_nc_oc=Adozse03tibI19hqdRx27fGLTra81EohC92Z3e99l2oGWHWZGa2an-TEn4PuZ6obepE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNnAuaqBEBKWUjAPSjRCFLSS5AtZZr-GxqO9x0n3vJkA&oe=6AEB54C9"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hH9CFdmHsp4Q7kNvwEZD2xv&_nc_oc=AdrZdgSb3m819GUOVCht9awXufBn2kqelNXg8ZyzjCka66MYulJlyVC0dnXdW_LV-Q8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnSRuph-dHbaXehpI2pztnkpuDC8ZjQsFNhbTLakHc6g&oe=6AEB2F6B"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTwW0G2vIzkQ7kNvwEADiXP&_nc_oc=AdqRdqotFAoaKElQO0bchjMxcYDPW8NMjbfVpg8tx8n2yTCW7G9WYqOJl5STnJD2wdA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7FQaNFok6ca6fI-CKOyzxTppFJv8A_El7PW-SDOUB8A&oe=6AEB5094"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
6797203389002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819502_1216797206722335_2336877249586941457_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXp4PDpK0_EQ7kNvwGidw5z&_nc_oc=Adok_K29b0kGI4bo6TqM_fT7f6mY621UodCMx-u0548LwDUDcTCF8xnlAeEdg3RuGCY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af171WXgzMUtweQ5eWSSo_TlKwCzjqSG9SBBcZ7ICoznlw&oe=69ECAB09"}, {"file_name": "gorillalife3_resized.png", "id": "4067354840188537", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819405_4067354843521870_3748405066783218413_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDRYjF3I2JAQ7kNvwHbH2_j&_nc_oc=Ado-3EiZfi8xH4fmR-dXBA3ZMK8IAtTKrB3UgfmOuLlrfm2C-YS7w8hGYN-ym4LlvKE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lcpy___s63MEgSQHiK6ejVrWlTtKxIpeQxjY937ni9A&oe=69ECBDEB"}, {"file_name": "gorillalife2_resized.png", "id": "1367608167903194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821837_1367608171236527_1065743988298372773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJ_D2r0Ar24Q7kNvwGUmP9_&_nc_oc=AdozXc1Ms0cSd-RAuYsO1Cn2YMnejbBboIV0Aa7Fzp0lD800sZgC3mTa5P13Ufu-MBs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FMx49UppR2pM4fbL9RJCgwSZaq6E9G6gsPpaK98PzhA&oe=69ECA6D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games v2", "keywords": ["projectgamesv2", "projectgames"], "long_description": "Project Games V2 is a fast-paced VR multiplayer experience inspired by Gorilla Tag, designed for the Meta Quest platform. Players swing, climb, and bounce through immersive environments using only their arms\u2014no buttons, no sticks\u2014just pure movement. Built with Photon for smooth online play and PlayFab for secure data handling, Games V2 features a variety of game modes, custom maps, and fun social interactions. The game focuses on energetic physical activity, creative exploration, and community-driven gameplay, all while main
ent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQREmxotmA3I88P3ci43-QjoMCFecdTdfuenRitRG-YayA&oe=6B0DCFC7"}, "display_name": "The Returns Desk: A Cozy Library", "keywords": ["cozy", "relaxing", "sorting", "organizing", "atmospheric"], "long_description": "The library has been closed for years, and the returns desk is full. You are the librarian. Pick up a book, read its cover, carry it to its shelf and slide it into its slot, by hand. **864 books, eight wings, one Victorian rotunda.**\n\n**Every book tells you where it goes**\n\nNothing lights up the answer and nothing sorts itself.\n\n- The emblem and color point to one of the eight wings, and the shade narrows it down further.\n- The title is the row.\n- The volume number is the slot.\n\nSome books come back damaged: rub them clean before they go on the shelf.\n\n**Open the library, one wing at a time**\n\nEvery row you finish earns a point. Open another wing and its lanterns light up and its banner takes its color. Points also buy help with the carrying, never the searching: a book basket, bigger deliveries, a repair brush, and the power to summon a book into your hand. Earn back the weather, rain, snow, wind and storm, and the hours from dawn to night.\n\n**The reading room**\n\nA fire to poke with the irons, a gramophone with four records to wind up and play, and display cases that fill with a volume for every row you finish.\n\n**No hurry**\n\nNo timers, no score, no fail state. The game saves as you go.\n\n**Comfort**\n\n- Seated or standing, with a crouch button\n- Teleport or smooth movement\n- Snap or smooth turning\n- Comfort vignette\n- Left- or right-handed\n- Haptics on or off\n- Master, ambience and effects volume\n\n*Requires tracked controllers. Hand tracking is not supported.*\n", "short_description": "Put 864 books back where they belong in a Victorian rotunda library. Every cover tells you its wing, its row and its slot, and nothing sorts itself. Each finished row earns a point to open another wing, bring back rain, snow and the hours of the day, and furnish a reading room with a fire and a gramophone. No timers, no score, no fail state. Play seated or standing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lamplitgames.github.io/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Lamplit", "support_website_url": "https://lamplitgames.github.io/support.html", "website_url": "https://lamplitgames.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1438196226036154"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "884797374623166"}]}, "baseline_offer": {"id": "884797374623166"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793638800, "status": "PUBLISHED", "id": "884797374623166"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1496081456914297", "version": "0.1.7"}, "id": "4423524174527496", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1379798675209243", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1496081456914297"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4423524174527496"}]}, "change_log": "The Returns Desk now speaks Russian, and finishing a wing finally feels like an event.\n\nRussian language\n- The whole game is now in Russian: menus, the rewards panel, tutorials, and every book. Spines, covers and shelf labels are all translated, along with each volume's own line and the display copies in the reading room.\n- The game picks Russian automatically when your Steam or system language is Russian.\n- Change it anytime in Settings > Audio > Language. The room reloads in the new language; your progress is kept, and books not yet shelved go back.\n\nFinishing a wing\n- Shelving the last row of a wing now plays a short celebration: the wing's lanterns and emblem swell and glow, with a little fanfare from its banner.\n\nYour save carries over as it is; nothing to do.", "created_date": 1793802619, "id": "1496081456914297", "version": "0.1.7", "version_code": 7, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1379798675209243", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1496081456914297"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4423524174527496"}]}, "change_log": null, "created_date": 1793757731, "id": "1494071553781954", "version": "0.1.6", "version_code": 6, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_appli
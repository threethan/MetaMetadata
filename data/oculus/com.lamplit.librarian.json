2394112_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7YHmSDNA28Q7kNvwE1GPvH&_nc_oc=AdqYrTzyFCdHtQF0f-oIH262-6GONCOjzwyAdKx2MbsF9tanh9vqJ4U2ZS1yTWFiSQs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjJWRJWBvZl__OUVg26s53ZnnFSTZO-E7pL5_SmfI4Bw&oe=6B008209"}, {"file_name": "02_shelving_with_basket.png", "id": "1149390584281793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825481_1149390594281792_2189494161264728969_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTVI2ElLiZIQ7kNvwGnzcFv&_nc_oc=AdrudKKbhHwcGrOwvPWqIXCeCkudolC8TiEe0SqZGYNiSac--IeIaiy_JotPHGbD-l8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDqwNbXZ3_rmpiUcNXE7k0My1T-LwGeszVJC7AkhcLAA&oe=6B007174"}, {"file_name": "03_hearth_poke.png", "id": "1536615101566404", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_1536615104899737_3931916051574611137_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_fUjR2v0NoQ7kNvwECxSQ9&_nc_oc=AdrErQqGLYQMFXWYUIcO3lJwdzptrgdiNsD_mVKwoGJvUWj-IfVGFyD2rFmwa4GK_Sc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkHGbWpLdiXKqyLvvxWlVroMC4QZefvoLrPfl5kkPlAw&oe=6B006F05"}, {"file_name": "04_gramophone.png", "id": "1095099573348070", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_1095099580014736_2317256326798325812_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wd7hTud4XNAQ7kNvwGuk270&_nc_oc=AdpKui_CFTf8iIf8WdtrinmcF7-CZi9NmYw4L4622waCtZxSf2g7nxTSKRs-Chl5KFg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8cKLDYtXivJ2eKnlnWNU0m6UMqOY9wklCVzQOmZ_5Ew&oe=6B00675F"}, {"file_name": "05_rewards_weather.png", "id": "1407089481536381", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823812_1407089484869714_4136268726935503782_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yq9a7QvWe0Q7kNvwFR0j5J&_nc_oc=Adrh9DN-5kdA-9HLKbHRmgveAKPSiKde9OIqAxf5v4wBOo4A4ZgKkGXlmMcCeS01Js0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShvLo3ZNWMCd5Zl1zIN6tBJczqYBElq7aMA9dBSm7QGw&oe=6B00552A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1083587874419567", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_1083587877752900_6025402076285170642_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHC0jlJob5QQ7kNvwHD5dKq&_nc_oc=AdqRk59hjjoRCK8jNiG8OtJBNrC4mdFnQacWs4QaSDady5A0G1hmned0g8tvVBLbTKM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzYVn1LbXG10Ys23hd-_R62H4Jm6zXaipUOgN9oLQKRQ&oe=6B006887"}, "display_name": "The Returns Desk: A Cozy Library", "keywords": ["tidy", "cozy", "relaxing", "organizing", "sorting"], "long_description": "A cozy tidy-up game for VR. The library has been closed for years, and the returns desk is full. You are the librarian. Pick up a book, read its cover, carry it to its shelf and slide it into its slot. **864 books, eight wings, one Victorian rotunda.**\r\n\r\n**Every book tells you where it goes**\r\n\r\nNothing highlights the answer, and nothing sorts itself.\r\n\r\n- Emblem and cover color identify the wing; the shade narrows it down.\r\n- The title identifies the row.\r\n- The volume number identifies the slot.\r\n\r\nSome books are damaged. Rub them clean before shelving.\r\n\r\n**Restore the library**\r\n\r\nEvery completed row earns a point. Unlock wings, light their lanterns and restore their colorful banners. Spend points on carrying aids: a book basket, larger deliveries, a cleaning brush and the ability to summon books into your hand. Bring back rain, snow, wind, storms and the changing hours from dawn to night.\r\n\r\n**The reading room**\r\n\r\nTend the fireplace, wind up the gramophone and discover four records. Fill display cases with a volume for every completed row.\r\n\r\n**No hurry**\r\n\r\nNo timers, leaderboards or fail state. The game saves as you go.\r\n\r\n**Comfort**\r\n\r\n- Seated or standing, adjustable reach and button-based crouching\r\n- Teleport or smooth movement\r\n- Snap or smooth turning\r\n- Comfort vignette\r\n- Left- or right-handed play\r\n- Haptics on or off\r\n\r\n*Requires tracked controllers. Hand tracking is not supported.*\r\n", "short_description": "A cozy tidy-up game for VR. Put 864 books back where they belong in a Victorian rotunda library. Every cover tells you its wing, its row and its slot, and nothing sorts itself. Each finished row earns a point to open another wing, bring back rain, snow and the hours of the day, and furnish a reading room with a fire and a gramophone. No timers, no score, no fail state. Play seated or standing."}, {"images": {"nodes": []}, "id": "1109418125239877", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Returns Desk: \u0443\u044e\u0442\u043d\u0430\u044f \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0430", "keywords": ["\u043f\u043e\u0440\u044f\u0434\u043e\u043a", "\u0443\u044e\u0442\u043d\u0430\u044f", "\u0440\u0430\u0441\u0441\u043b\u0430\u0431\u043b\u044f\u044e\u0449\u0430\u044f", "\u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u044f", "\u0441\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u043a\u0430"], "long_description": "\u0423\u044e\u0442\u043d\u0430\u044f VR-\u0438\u0433\u0440\u0430 \u043f\u0440\u043e \u043d\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043f\u043e\u0440\u044f\u0434\u043a\u0430. \u0411\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0430 \u043c\u043d\u043e\u0433\u043e \u043b\u0435\u0442 \u0441\u0442\u043e\u044f\u043b\u0430 \u0437\u0430\u043a\u0440\u044b\u0442\u043e\u0439, \u0430 \u0441\u0442\u043e\u043b \u0432\u043e\u0437\u0432\u0440\u0430\u0442\u0430 \u0437\u0430\u0432\u0430\u043b\u0435\u043d \u043a\u043d\u0438\u0433\u0430\u043c\u0438. \u0422\u0435\u043f\u0435\u0440\u044c \u0432\u044b \u0437\u0434\u0435\u0441\u044c \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0430\u0440\u044c. \u0412\u043e\u0437\u044c\u043c\u0438\u0442\u0435 \u043a\u043d\u0438\u0433\u0443, \u0438\u0437\u0443\u0447\u0438\u0442\u0435 \u043e\u0431\u043b\u043e\u0436\u043a\u0443, \u043e\u0442\u043d\u0435\u0441\u0438\u0442\u0435 \u0435\u0451 \u043a \u043d\u0443\u0436\u043d\u043e\u0439 \u043f\u043e\u043b\u043a\u0435 \u0438 \u043f\u043e\u0441\u0442\u0430\u0432\u044c\u0442\u0435 \u043d\u0430 \u0441\u0432\u043e\u0451 \u043c\u0435\u0441\u0442\u043e. **864 \u043a\u043d\u0438\u0433\u0438, \u0432\u043e\u0441\u0435\u043c\u044c \u043a\u0440\u044b\u043b\u044c\u0435\u0432, \u043e\u0434\u043d\u0430 \u0432\u0438\u043a\u0442\u043e\u0440\u0438\u0430\u043d\u0441\u043a\u0430\u044f \u0440\u043e\u0442\u043e\u043d\u0434\u0430.**\n\n**\u041a\u0430\u0436\u0434\u0430\u044f \u043a\u043d\u0438\u0433\u0430 \u043f\u043e\u0434\u0441\u043a\u0430\u0436\u0435\u0442, \u0433\u0434\u0435 \u0435\u0451 \u043c\u0435\u0441\u0442\u043e**\n\n\u041d\u0438\u0447\u0442\u043e \u043d\u0435 \u043f\u043e\u0434\u0441\u0432\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043e\u0442\u0432\u0435\u0442, \u0438 \u043d\u0438\u0447\u0442\u043e \u043d\u0435 \u0441\u043e\u0440\u0442\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u0441\u0430\u043c\u043e.\n\n- \u042d\u043c\u0431\u043b\u0435\u043c\u0430 \u0438 \u0446\u0432\u0435\u0442 \u043e\u0431\u043b\u043e\u0436\u043a\u0438 \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u043d\u0430 \u043a\u0440\u044b\u043b\u043e, \u043e\u0442\u0442\u0435\u043d\u043e\u043a \u043f\u043e\u043c\u043e\u0433\u0430\u0435\u0442 \u043d\u0430\u0439\u0442\u0438 \u043d\u0443\u0436\u043d\u043e\u0435 \u043c\u0435\u0441\u0442\u043e.\n- \u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u043d\u0430 \u0440\u044f\u0434.\n- \u041d\u043e\u043c\u0435\u0440 \u0442\u043e\u043c\u0430 \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u043d\u0430 \u043c\u0435\u0441\u0442\u043e \u0432 \u0440\u044f\u0434\u0443.\n\n\u041f\u043e\u0432\u0440\u0435\u0436\u0434\u0451\u043d\u043d\u044b\u0435 \u043a\u043d\u0438\u0433\u0438 \u043d\u0443\u0436\u043d\u043e \u043f\u0440\u043e\u0442\u0435\u0440\u0435\u0442\u044c \u043f\u0435\u0440\u0435\u0434 \u0442\u0435\u043c, \u043a\u0430\u043a \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u043d\u0430 \u043f\u043e\u043b\u043a\u0443.\n\n**\u0412\u0435\u0440\u043d\u0438\u0442\u0435 \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0435 \u0436\u0438\u0437\u043d\u044c**\n\n\u0417\u0430 \u043a\u0430\u0436\u0434\u044b\u0439 \u0441\u043e\u0431\u0440\u0430\u043d\u043d\u044b\u0439 \u0440\u044f\u0434 \u0432\u044b \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442\u0435 \u043e\u0447\u043a\u043e. \u041e\u0442\u043a\u0440\u044b\u0432\u0430\u0439\u0442\u0435 \u043d\u043e\u0432\u044b\u0435 \u043a\u0440\u044b\u043b\u044c\u044f, \u0437\u0430\u0436\u0438\u0433\u0430\u0439\u0442\u0435 \u0438\u0445 \u0444\u043e\u043d\u0430\u0440\u0438 \u0438 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0442\u0435 \u0446\u0432\u0435\u0442 \u0437\u043d\u0430\u043c\u0451\u043d\u0430\u043c. \u0417\u0430 \u043e\u0447\u043a\u0438 \u043c\u043e\u0436\u043d\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u044c \u043f\u043e\u043c\u043e\u0449\u044c \u0432 \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u043a\u0435: \u043a\u043e\u0440\u0437\u0438\u043d\u0443 \u0434\u043b\u044f \u043a\u043d\u0438\u0433, \u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u043f\u043e\u0441\u0442\u0430\u0432\u043a\u0438, \u0449\u0451\u0442\u043a\u0443 \u0434\u043b\u044f \u043e\u0447\u0438\u0441\u0442\u043a\u0438 \u0438 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0438\u0437\u0432\u0430\u0442\u044c \u043a\u043d\u0438\u0433\u0443 \u043f\u0440\u044f\u043c\u043e \u0432 \u0440\u0443\u043a\u0443. \u0412\u0435\u0440\u043d\u0438\u0442\u0435 \u0434\u043e\u0436\u0434\u044c, \u0441\u043d\u0435\u0433, \u0432\u0435\u0442\u0435\u0440, \u0433\u0440\u043e\u0437\u0443 \u0438 \u0441\u043c\u0435\u043d\u0443 \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0441\u0443\u0442\u043e\u043a: \u043e\u0442 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430 \u0434\u043e \u043d\u043e\u0447\u0438.\n\n**\u0427\u0438\u0442\u0430\u043b\u044c\u043d\u044b\u0439 \u0437\u0430\u043b**\n\n\u041a\u0430\u043c\u0438\u043d, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043c\u043e\u0436\u043d\u043e \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044c \u043a\u043e\u0447\u0435\u0440\u0433\u043e\u0439, \u0433\u0440\u0430\u043c\u043c\u043e\u0444\u043e\u043d \u0441 \u0447\u0435\u0442\u044b\u0440\u044c\u043c\u044f \u043f\u043b\u0430\u0441\u0442\u0438\u043d\u043a\u0430\u043c\u0438 \u0438 \u0432\u0438\u0442\u0440\u0438\u043d\u044b, \u043f\u043e\u043f\u043e\u043b\u043d\u044f\u044e\u0449\u0438\u0435\u0441\u044f \u0437\u0430 \u043a\u0430\u0436\u0434\u044b\u0439 \u0441\u043e\u0431\u0440\u0430\u043d\u043d\u044b\u0439 \u0440\u044f\u0434.\n\n**\u0411\u0435\u0437 \u0441\u043f\u0435\u0448\u043a\u0438**\n\n\u0411\u0435\u0437 \u0442\u0430\u0439\u043c\u0435\u0440\u043e\u0432, \u0442\u0430\u0431\u043b\u0438\u0446 \u0440\u0435\u043a\u043e\u0440\u0434\u043e\u0432 \u0438 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0439. \u0418\u0433\u0440\u0430 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438.\n\n**\u041a\u043e\u043c\u0444\u043e\u0440\u0442**\n\n- \u0418\u0433\u0440\u0430 \u0441\u0438\u0434\u044f \u0438\u043b\u0438 \u0441\u0442\u043e\u044f, \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430 \u0432\u044b\u0441\u043e\u0442\u044b \u0434\u043e\u0441\u044f\u0433\u0430\u0435\u043c\u043e\u0441\u0442\u0438 \u0438 \u043f\u0440\u0438\u0441\u0435\u0434\u0430\u043d\u0438\u0435 \u043f\u043e \u043a\u043d\u043e\u043f\u043a\u0435\n- \u0422\u0435\u043b\u0435\u043f\u043e\u0440\u0442\u0430\u0446\u0438\u044f \u0438\u043b\u0438 \u043f\u043b\u0430\u0432\u043d\u043e\u0435 \u043f\u0435\u0440\u0435\u043c\u0435\u0449\u0435\u043d\u0438\u0435\n- \u041f\u043e\u0432\u043e\u0440\u043e\u0442 \u0440\u044b\u0432\u043a\u0430\u043c\u0438 \u0438\u043b\u0438 \u043f\u043b\u0430\u0432\u043d\u044b\u0439\n- \u041a\u043e\u043c\u0444\u043e\u0440\u0442\u043d\u043e\u0435 \u0437\u0430\u0442\u0435\u043c\u043d\u0435\u043d\u0438\u0435 \u043f\u043e \u043a\u0440\u0430\u044f\u043c\n- \u0414\u043b\u044f \u043b\u0435\u0432\u0448\u0435\u0439 \u0438 \u043f\u0440\u0430\u0432\u0448\u0435\u0439\n- \u0412\u0438\u0431\u0440\u0430\u0446\u0438\u044f: \u0432\u043a\u043b. \u0438\u043b\u0438 \u0432\u044b\u043a\u043b.", "short_description": "\u0423\u044e\u0442\u043d\u0430\u044f VR-\u0438\u0433\u0440\u0430 \u043f\u0440\u043e \u043d\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043f\u043e\u0440\u044f\u0434\u043a\u0430. \u0420\u0430\u0441\u0441\u0442\u0430\u0432\u044c\u0442\u0435 864 \u043a\u043d\u0438\u0433\u0438 \u043f\u043e \u043c\u0435\u0441\u0442\u0430\u043c \u0432 \u0432\u0438\u043a\u0442\u043e\u0440\u0438\u0430\u043d\u0441\u043a\u043e\u0439 \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0435-\u0440\u043e\u0442\u043e\u043d\u0434\u0435. \u041e\u0431\u043b\u043e\u0436\u043a\u0430 \u043f\u043e\u0434\u0441\u043a\u0430\u0436\u0435\u0442 \u043a\u0440\u044b\u043b\u043e, \u0440\u044f\u0434 \u0438 \u043c\u0435\u0441\u0442\u043e, \u0430 \u0441\u0430\u043c\u043e \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0441\u043e\u0440\u0442\u0438\u0440\u0443\u0435\u0442\u0441\u044f. \u041a\u0430\u0436\u0434\u044b\u0439 \u0441\u043e\u0431\u0440\u0430\u043d\u043d\u044b\u0439 \u0440\u044f\u0434 \u043f\u0440\u0438\u043d\u043e\u0441\u0438\u0442 \u043e\u0447\u043a\u043e: \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0439\u0442\u0435 \u043d\u043e\u0432\u044b\u0435 \u043a\u0440\u044b\u043b\u044c\u044f, \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0442\u0435 \u0434\u043e\u0436\u0434\u044c, \u0441\u043d\u0435\u0433 \u0438 \u0432\u0440\u0435\u043c\u044f \u0441\u0443\u0442\u043e\u043a, \u043e\u0431\u0441\u0442\u0430\u0432\u043b\u044f\u0439\u0442\u0435 \u0447\u0438\u0442\u0430\u043b\u044c\u043d\u044b\u0439 \u0437\u0430\u043b \u043a\u0430\u043c\u0438\u043d\u043e\u043c \u0438 \u0433\u0440\u0430\u043c\u043c\u043e\u0444\u043e\u043d\u043e\u043c. \u0411\u0435\u0437 \u0442\u0430\u0439\u043c\u0435\u0440\u043e\u0432, \u0431\u0435\u0437 \u0440\u0435\u043a\u043e\u0440\u0434\u043e\u0432, \u0431\u0435\u0437 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0439. \u0418\u0433\u0440\u0430\u0439\u0442\u0435 \u0441\u0438\u0434\u044f \u0438\u043b\u0438 \u0441\u0442\u043e\u044f."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lamplitgames.github.io/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Lamplit", "support_website_url": "https://lamplitgames.github.io/support.html", "website_url": "https://lamplitgames.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1496185870237189"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825305_1131283882756664_5583130182214548014_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOxyr0UDEuYQ7kNvwE_A7Tx&_nc_oc=AdrMa2zRIKWdOTtlIfBkq2Jz2IAmZH9N-n3-XJsqEcmvZC25Iwt1_tYeEdiitGoo9AQ&_nc_zt=3&_nc_ht=sconten
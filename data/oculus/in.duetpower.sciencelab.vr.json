le_name": "SCREEN-4-headset-view.png", "id": "1749905612769779", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823279_1749905616103112_6140588547312033177_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Hc4vzyEEAAQ7kNvwEqKYZ6&_nc_oc=Adou2jwDOxr6gJKYFURwGNOJ2zyHXxAvWNYJPvgsOpk0nwKgWOWvwmmtAO7JDP-M_QY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQz1Dr-6WthuuaAeescaVLiutGOP_jPtU3PufTKZBq1iw&oe=6B0DAE79"}, {"file_name": "SCREEN-2-prism-spectrum.png", "id": "1745767789856474", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823901_1745767793189807_6998339716240413281_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g53XVrXpCxMQ7kNvwG_KOLS&_nc_oc=AdoFa7MRTybVYUl0ub7VuwjTUwJ_mUT-Dh5p86-U7jvO51RoY97aUmmCNRzxKDcvTRM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSQL37T3wgwy-qsnsUk7ZMdRbZtcljzBCwD4zLZt7b0ng&oe=6B0DA33A"}, {"file_name": "SCREEN-5-lab-overview.png", "id": "1658059189029427", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827973_1658059192362760_3584702867107389902_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=voVFsTRNpwgQ7kNvwHX0h01&_nc_oc=AdpeU9pPOyLKAkE92A6Nvsc9OyZJcCCUOJQlmadbxWWvpnhJwvEZ2xJ7_8lPiC9yWfM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT7BTAuGE1czzeY4xU0IkvUqZZnDcE8YwGEqzgAre7few&oe=6B0DBF28"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DUET Science Lab 360", "keywords": ["science", "chemistry", "physics", "education"], "long_description": "Step into a real-looking school science lab and perform the experiments from your textbooks with your own hands.\n\n\u2022 More than 185 experiments from the NCERT science books for Classes 6 to 10: 85 in chemistry and over 100 in physics, plus open labs where you can try anything.\n\u2022 Results follow what you actually do. Add too much acid and the solution turns acidic; overfill a test tube and it overflows; drop a beaker and it breaks. After every step, \"You see\" and \"Why\" explain what happened, and at the end you see your own result next to the book's.\n\u2022 Pick up glassware, pour, stir, heat, strike a match to light the burner and wire circuits by hand.\n\u2022 Every step says how much to add (mL, drops or a spoonful), and a read-out shows the volume while you pour.\n\u2022 Watch solids dissolve, or not: the lab tells you what is happening in every beaker.\n\u2022 Browse class by class or by topic: acids and bases, metals, separation of mixtures, light, electricity, magnetism and more.\n\u2022 Text and narration in English, Hindi and Hinglish.\n\u2022 Works offline after the first use.\n\nFor schools: full access comes with a DUET STEM school subscription code. Without a code, a free demo includes the open labs and the first experiment of every class.", "short_description": "Do real school chemistry and physics experiments with your own hands in a true-to-life lab \u2014 NCERT Classes 6 to 10, in English, Hindi and Hinglish."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ashutoshduet.github.io/duet-lms-media/science/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "DUET Power", "support_website_url": null, "website_url": "https://ashutoshduet.github.io/duet-lms-media/science/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "hi"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1355790607626589"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_2344953486901711_3114308355150270674_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kekvb0d3-JsQ7kNvwFX9Y3x&_nc_oc=AdpbgmIC9eyL8hbEVLPAjExsgN2zCpuUxh-simLNOwW-hrk6uCFcHKTGDMMehQbaVS8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTZ2d7pRwSLX6oo0zMCoXiVb-s1uEMzNhnRgORpooYaJw&oe=6B0DAC7D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DUET Science Lab 360", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1794942660, "lastRevision": {"nodes": [{"id": "1355790627626587", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1355790597626590", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1162485422869481"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "2-SCIENCE-square.png", "id": "2344953483568378", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_2344953486901711_3114308355150270674_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kekvb0d3-JsQ7kNvwFX9Y3x&_nc_oc=AdpbgmIC9eyL8hbEVLPAjExsgN2zCpuUxh-simLNOwW-hrk6uCFcHKTGDMMehQbaVS8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS2TMp4KxH6DkzLfDfu9JL5Z9dgR8jYMBo1kLKpXABTgQ&oe=6B0DAC7D"}, {"file_name": "5-SCIENCE-icon.png", "id": "2242696859639041", "image_type": "APP_IM
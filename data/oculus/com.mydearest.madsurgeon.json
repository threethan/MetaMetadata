null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "978183367588671", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619590_978183370922004_2895796590385404103_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoquN2ZVqSEQ7kNvwGwICBV&_nc_oc=AdoFn43SaBiL67P3G-gbGV_Zx_uBFS3wbV40TIhFFE6JaadqKeDgKQJY_VkmTQAQ_aY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5b9Ez51yhh9tkcVxG_87eEtVl82kWqx8kCTwGQMbwHA&oe=6B0841EB"}, "display_name": "MAD SURGEON -Goblin Hospital-", "keywords": ["Surgery", "Simulator"], "long_description": "A limited-time Devil's Roulette collaboration is here! Accelerate your mad operations with new modification parts and exclusive items!\n\n\u26d1\ufe0f MADNESS HAS NEVER BEEN THIS FUN \u26d1\ufe0f\nMAD SURGEON -Goblin Hospital- is a chaotic VR surgery simulator where YOU become a crazed surgeon, modifying eager patients in their quest for ultimate strength.\n\n\ud83d\udee0\ufe0f Swap, Stitch, and Sell Every Part! \ud83d\udee0\ufe0f\nFreely detach and reattach a variety of insane body parts! Sell your spare limbs on the black market and receive even crazier enhancements in return!\n\n\ud83d\udc79 Build the Ultimate Goblin \ud83d\udc79\nMix and match endless combinations to create the strongest, weirdest, and most unstoppable goblins imaginable. Release your creations back into everyday goblin life\u2014or toss your mistakes down the trash chute. Their fate is entirely in your twisted hands!", "short_description": "\u26d1\ufe0f NEW UPDATE ALERT \u26d1\ufe0f\nThe operating room just got a whole lot wilder!\nNow you can create even more outrageous goblins with a brand-new selection of body parts and accessories. Mix, match, and experiment to your heart\u2019s content! What bizarre creation will you unleash next?\n\n\u26d1\ufe0f MADNESS HAS NEVER BEEN THIS FUN \u26d1\ufe0f\nMAD SURGEON -Goblin Hospital- is a chaotic VR surgery simulator where YOU become a crazed surgeon, modifying eager patients in their quest for ultimate strength."}]}, "developer_name": "Bazooka Studio", "developer_privacy_policy_url": "https://mydearestvr.com/en/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://mydearestvr.com/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24123411720576055"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499298183_1130953142125337_1835962231500630038_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bra5rqifu0gQ7kNvwEQdEVr&_nc_oc=Adqj-xu7HMqmI-APl0q1I81w9_YNwSW7yDoszPAA-2kb2oC-7UqYIOI2YnB9jEx0Xd4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQOF_ymh-zE_cdTmKI01nmClBoAaBXcA_Gztzh_JqArw&oe=6B08568A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MAD SURGEON -Goblin Hospital-", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1745514000, "lastRevision": {"nodes": [{"id": "9799350083408791", "release_type"
_oc=AdpDx4nQ8tsNPQKLW0eH6_TImjytgqY33JiJHda3Np1nD6NWLt8i9ZnPeyz9QvKFrI8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7xUSvMKCMWiEVNcZud2C6O8LbAHoJqX_J3vGBlBmIvQ&oe=6A50E1F4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret of the Ark", "keywords": ["Escape", "Secret", "Game", "SciFi", "Wormhole"], "long_description": "Virtual Discovery's fictional escape game stories are based on the free and creative interpretation of historically proven or biblical events as well as myths and legends. The purpose of this escape game is exciting and unconditional entertainment and has no claim to impart knowledge, factual accuracy, scientifically recognized findings or educational aspects. The blending of fact, fiction and religion corresponds to the idea of a \"mockumentary\", the purpose of which is to parody claims to objectivity and cultural relevance. Virtual Discovery used various online sources such as Wikipedia for its research. Fictional components in this storyboard are marked with (fiction).", "short_description": "Immerse yourself in the fascinating world of science fiction and explore the greatest mysteries of human history. In this immersive virtual reality adventure, you will follow in the footsteps of a 3'000-year-old story told in 4 exciting chapters. Play now and unravel the ancient and long-forgotten mystery of the legendary Ark of the Covenant."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vi-di.ch/en/data-policy-xr", "developer_terms_of_service_url": null, "publisher_name": "Virtual Discovery", "support_website_url": null, "website_url": "https://vi-di.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_con
0_AQS_jYvR_TXeozNz8_y664yTZSFm9czKbkev-cGkBsjKQw&oe=6B0C7E57"}, {"file_name": "DGB_Screenshot_05.png", "id": "2507132332951675", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393444_2507132336285008_1551562711474287242_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvYs415Aa3sQ7kNvwEBGWcw&_nc_oc=Ado1EPi8evw2G6EaEFVPnFT9v77JazyuF5BgAq3vRhFvsLFp2xFGopaR6IB8Z_G8LEM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ2aKPksfECMlLkWCJ-kRmzJaRC1aiAQHlgnQPhSkuWCg&oe=6B0C4F34"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret of the Ark", "keywords": ["Escape", "Secret", "Game", "SciFi", "Wormhole"], "long_description": "Virtual Discovery's fictional escape game stories are based on the free and creative interpretation of historically proven or biblical events as well as myths and legends. The purpose of this escape game is exciting and unconditional entertainment and has no claim to impart knowledge, factual accuracy, scientifically recognized findings or educational aspects. The blending of fact, fiction and religion corresponds to the idea of a \"mockumentary\", the purpose of which is to parody claims to objectivity and cultural relevance. Virtual Discovery used various online sources such as Wikipedia for its research. Fictional components in this storyboard are marked with (fiction).", "short_description": "Immerse yourself in the fascinating world of science fiction and explore the greatest mysteries of human history. In this immersive virtual reality adventure, you will follow in the footsteps of a 3'000-year-old story told in 4 exciting chapters. Play now and unravel the ancient and long-forgotten mystery of the legendary Ark of the Covenant."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vi-di.ch/en/data-policy-xr", "developer_terms_of_service_url": null, "publisher_name": "Virtual Discovery", "support_website_url": null, "website_url": "https://vi-
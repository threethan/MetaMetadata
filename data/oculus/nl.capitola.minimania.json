3-2.oculuscdn.com/v/t64.5771-25/491825481_1441175107653233_7263019337560633984_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAnVbtT9nu4Q7kNvwEBxPjm&_nc_oc=Ado6_AwIoGYrbVb3lyyf7l9PU7DnlNq_haa0UJSMVb2_SoDzFrETuH7od6CNPChgUb4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaSe2ZmPIOtCAJDE0LKP5RSODdx-TmSebPpxdsioDcEg&oe=6A4E3F2E"}, {"file_name": "5. Mage.png", "id": "973950404977992", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499304952_973950408311325_3023131213521363858_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Qh7GdviTBQQ7kNvwHV9VTX&_nc_oc=AdquVaA40Sskhr7i5KanT8mAK47of76v5SRIEmG5peqknW6x6AoP1rdaF0fPi93cdFo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7Wj_Uod8xSRHfLjL48vSQj5f3ukOuBOFhr4bkfX_JMA&oe=6A4E63D9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Miniature Mania", "keywords": ["Paint", "Painting", "Miniatures", "Brush"], "long_description": "# Miniature Mania\n\nStep into a relaxing space and paint miniatures in mixed and virtual reality.\n\nMiniature Mania lets you pick up a brush, choose your paint, and bring miniatures to life at your own pace. The game currently focuses on a relaxing painting experience without the stress and worry of ruining your very first miniature.\n\nUse intuitive controls to pick up, scale, and paint your minis with precision. You can place your hobby desk directly into your real environment in mixed reality and paint as if the miniatures were sitting right on your table.\n\nThis early version focuses on delivering a satisfying painting experience inspired by real-world hobby painting. Miniature Mania will expand over time into a broader tabletop experience where your painted miniatures can take the stage on the battlefield in a rules-agnostic tabletop experience.\n\n\n# Current Features\n\n* Paint miniatures in VR or Mixed Reality\n* Intuitive tools designed to make painting easier in a virtual environment:\n   scaling the model, instantly filling the base paint, adjustable brush positions\n* Relaxing hobby-focused environment\n* And more\u2026\n\n\n# Planned Features\n\n* A full rules-agnostic tabletop experience\n* Multiplayer hobby and tabletop sessions\n* Miniature collections\n* Quality of Life improvements\n\n\nMiniature Mania offers a peaceful digital environment, seasoned hobbyists as well as those newly discovering miniature painting, to practice your craft and prepare your collection for adventures yet to come.", "short_description": "Miniature Mania lets you pick up a brush, choose your paint, and bring miniatures to life at your own pace. The game currently focuses on a relaxing painting experience without the stress and worry of ruining your very first miniature."}]}, "developer_name": "Capitola", "developer_privacy_policy_url": "https://capitola-test-bucket.s3.eu-central-1.amazonaws.com/MiniatureMania/Privacy+Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Capitola", "support_website_url": null, "website_url": "https://capitola.nl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8982057681883515"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "921960730720130"}]}, "baseline_offer": {"id": "921960730720130"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 177
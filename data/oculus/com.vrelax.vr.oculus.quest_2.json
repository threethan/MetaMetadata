44759968_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4iq__LQ9YTAQ7kNvwFns8Nc&_nc_oc=AdlvbTaEXfKzwvQejIUY8ze-zeOZMk8crTE02SFG3o68CU8lwe0j--y43vWCDxcRzL0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afu7d5ABuOvljeFq-dZsql-9L3XaazYXbGhSTHUhIx5Thw&oe=69A56A60"}, {"file_name": "oculus_screen_5.png", "id": "601876348250221", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75462965_601876351583554_5297430548521710064_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NFvS06uL8kQ7kNvwE_vFd6&_nc_oc=AdnmmB9KDgKShtVGmrlpHpSv0PLFBlOjswqYPsXZWYQP05UQYJs7WiDJua7eUaqmpY0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsQDYOHh9SqNLE-WEfH81-vf1YUux8SvpdQsgQkjrGatA&oe=69A59E54"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRelax - Quest 2", "keywords": [], "long_description": "Many people suffer from stress, such as burn-out, depression or anxiety. This results in a lot of personal suffering and high medical costs (CBS, 2019).Reducing stress and learning to relax is an important pillar of good mental health. But that is easier said than done. That\u2019s why VRelax was created because we have experienced that Virtual Reality has a very fast and strong effect on body and mind.", "short_description": "VRelax is a virtual reality app that helps people to reduce their stress level and improve their mood. Scientific research has shown that VRelax is effective. It is a relaxation tool to reduce stress, burnout, anxiety and depression. VRelax can also be used as a distraction tool for pain management, physical discomfort and medical procedures. From mild stress to severe health complications, VRelax can provide relief at any time and place for any kind of stress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrelax.com/en/privacy-statement/", "developer_terms_of_service_url": "https://vrelax.com/wp-content/uploads/2022/06/VRelax_Algemene-Voorwaarden_NL-C00421-1679622868-61-002_ver.-WeFact.pdf", "publisher_na
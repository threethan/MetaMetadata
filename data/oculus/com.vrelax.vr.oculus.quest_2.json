_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSl53ZFUzoYQ7kNvwER11bO&_nc_oc=AdqVn7-2YdWdNlBgwOmreJNJ3WV7X3y8l6Z6H7-XFZUlE8BXnrbgREbrMNS5KwOx-S8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSs88bISd0HdxWi4I9dHvLiM7dkJ9se7XHeKHzvt9FmPw&oe=6B0DAC58"}, {"file_name": "oculus_screen_4.png", "id": "5441969075881181", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210891_5441969079214514_5020506565144759968_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4ROU-iiwvAQ7kNvwH69OuP&_nc_oc=AdolrdOC4fA1sBS2JVhhC4H8M1H0YU4xv_7wvt-ksjsMH-tyCHWG7gifQrO82ZjsMC8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQThf4xL_kcA2GwCC5ArmYhegF_5yUgzzPHOWkJWQBTZ5Q&oe=6B0DC460"}, {"file_name": "oculus_screen_5.png", "id": "601876348250221", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462965_601876351583554_5297430548521710064_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDoDrZZxRH0Q7kNvwHfD_Yi&_nc_oc=AdryGR-9WZ9xD5KctIulAaL-GtxeKqyNu5QxIDKdltruJqxLj0-IzFM2FUn8IWK2LbA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ5E0bKhHhbODbxTYMvdCnH2pUPQ0mblxct9CmQgfgKbA&oe=6B0DC014"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRelax - Quest 2", "keywords": [], "long_description": "Many people suffer from stress, such as burn-out, depression or anxiety. This results in a lot of personal suffering and high medical costs (CBS, 2019).Reducing stress and learning to relax is an important pillar of good mental health. But that is easier said than done. That\u2019s why VRelax was created because we have experienced that Virtual Reality has a very fast and strong effect on body and mind.", "short_description": "VRelax is a virtual reality app that helps people to reduce their stress level and improve their mood. Scientific research has shown that VRelax is effective. It is a relaxation tool to reduce stress, burnout, anxiety and depression. VRelax can also be used as a distraction tool for pain management, physical discomfort and medical procedures. From mild stress to severe health complications, VRelax can provide relief at any time and place for any kind of stress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrelax.com/en/privacy-statement/", "developer_terms_of_service_url": "https://vrelax.com/wp-content/uploads/2022/06/VRelax_Algemene-Voorwaarden_NL-C00421-1679622868-61-002_ver.-WeFact.pdf", "publisher_name": "VRelax B.V.", "support_website_url": "https://vrelax.com/en/support", "website_url": "https://vrelax.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": ["MEDICINE", "RELAXATION_MEDITATION", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "3372446039736798"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1396744745106277"}, {"status": "PUBLISHED", "id": "649545306577354"}, {"status": "PUBLISHED", "id": "360349606461809"}]}, "baseline_offer": {"id": "1396744745106277"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742821260, "status": "PUBLISHED", "id": "1396744745106277"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "40011713458472688", "version": "5.9.1"}, "id": "3092053397776407", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": fal
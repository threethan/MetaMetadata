896", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619704_1454384789367229_5841630293291162906_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDUuC5LhVUEQ7kNvwFlcw1Z&_nc_oc=AdmkMCuXXnkKlTCoKJmO7m2K3Er5BGnA_xh1Z_Y1fxXoaFB6X2PbWr1yZoSp6WekZTo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsjwuINZA857AovoXL0IlhbNfs51UqrxDL0H6VtCOzCvQ&oe=699DAE91"}, {"file_name": "ApplicationFrameHost_41icXhh925.png", "id": "903174598790875", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620497_903174602124208_57751738118648371_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwn_C3KXexsQ7kNvwFXq9CD&_nc_oc=AdnfWXQocHVjNuhKKqwZ3FafXgQZ7NdrYIMkSxHIbsnat-4SkRkAbwmvyZRBJHjYZ3g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfszovZUoltytkOzBHZVg80dhGNl2WRasuc36znu-a4GYg&oe=699DA3A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_2560x1440-Trailor_Socialvalue_ver-001.png", "id": "1889282125281428", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499294601_1889282128614761_1353268151910155388_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fk3vBlZv1vEQ7kNvwEvs1uN&_nc_oc=AdlglNvyvc4KPdOsnKwW3KgMjN58X_wjElv9MKaXu9boPdEBlOqrP0baGsJbEfh5l4E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afua2jF6VA1H1q8uUGCmQRXDlCIfFRmNXf7W9MYQ-ZC5KA&oe=699DA3DC"}, "display_name": "Kitchen Assistant", "keywords": ["vocation", "job", "kitchen", "training", "contentsda"], "long_description": "1. Press the button to turn on the water.\n2. Wash the carrots in water and place them in the basket.\n3. Peel the scallions and onions, wash them in water, and place them in the basket.\n4. Cut the washed onions, scallions, and carrots with a knife and place them in the empty container.\n5. Put on gloves.\n6. Use a mop to wipe the floor.\n7. Clean the table using disinfectant and a sponge.\n8. Fill the utensil holder with cutlery.\n9. Refill the tissue box in the trash can.\n10. Refill the cups.\n11. Put on rubber gloves.\n12. Wash the dishes in the dishwasher.\n13. Organize the washed dishes. ", "short_description": "Kitchen Assistant Content designed to enhance the kitchen assistant skills of individuals with developmental disabilities by performing tasks such as preparing ingredients, cleaning the store, and washing dishes in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDA Inc.", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25490546207307794"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499626172_878994935123931_671229973114902432_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZt7dWl1SGoQ7kNvwHJUHHz&_nc_oc=AdmUEuyVXyRIA8pN7WfXvzXG-YWLM_TkN-14nlmi5A8mH6iFQBxlDtaYZqMl3OJiy3s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvBqs4rQLZoDcdKVpsaIZPiWtReHZBlUj3-DfH5K_dVRQ&oe=699DA8CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Kitchen Assistant", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "c
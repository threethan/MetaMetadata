5\ub2c8\ub2e4.\n\uc7a5\uc804\uacfc \uc0ac\uaca9\uc5d0 \ud604\uc2e4\uac10\uc744 \uc801\uc6a9\ud558\ub824\uace0 \ub178\ub825\ud588\uc2b5\ub2c8\ub2e4. \n\ud074\ub808\uc774\uc5d0 \uba85\uc911\ud558\uba74 \ubcf4\uc0c1\uc73c\ub85c \ud558\ub298\uc5d0\uc11c \ucf54\uc778\uc774 \ub5a8\uc5b4\uc9d1\ub2c8\ub2e4.\n\ucf54\uc778\uc744 \uc0b0\ucc98\ub7fc \uc313\uc544\ubcf4\uc138\uc694!\n\n\ud604\ub300 \ud074\ub808\uc774 \uc0ac\uaca9\uc7a5\uc744 \ubc30\uacbd\uc73c\ub85c\ud55c \ub9f5\uc774 \uc801\uc6a9\ub420 \uc608\uc815\uc785\ub2c8\ub2e4.\n\ucd94\uac00 \uc5c5\ub370\uc774\ud2b8\ub97c \uae30\ub2e4\ub824 \uc8fc\uc154\uc11c \uac10\uc0ac\ud569\ub2c8\ub2e4!\n\n- \ub9ac\uc18c\uc2a4 \uc800\uc791\uad8c \ubaa9\ub85d\nhttps://jeongday.notion.site/Clay-Shooter-Copyright-List-c102e36456584cd88290cf1b6300858f", "short_description": "\ud074\ub808\uc774 \uc0ac\uaca9\uc740 2\uac00\uc9c0 \ubaa8\ub4dc\ub85c \uacbd\ud5d8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"images": {"nodes": [{"file_name": "Hero Squre.png", "id": "7685443268148096", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982568_7685443271481429_4568655724685904204_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPAAVlXyfKcQ7kNvwEdhpex&_nc_oc=Adkzs1xoQV_praMLjzedCKNgj1gQT1jp6I9kCWi6RFwKh_GM9vhjxuayNAeoqNNLwpY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfugtxkwQQMPZxyBp0qoV4iBk9Jthaj9ncoBee9T3XqpUw&oe=69A04D4B"}, {"file_name": "Portrait.png", "id": "5163813080295916", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75508953_5163813083629249_4502689513949697733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2i7grnWATfoQ7kNvwFXePzO&_nc_oc=AdloWfaZOXZY1DEPh435aDeim6-oKTsVyOXkOiXY8F20jVY1MHyrxXe4_-5nfYZIKeU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftsnErBOzQRGlnq88vxzdMPQ5rrmEkHtpSVGDu5xK5GMQ&oe=69A037F5"}, {"file_name": "Hero PDP.png", "id": "1143860009750048", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https:
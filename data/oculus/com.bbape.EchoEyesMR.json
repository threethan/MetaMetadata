}, {"file_name": "2.png", "id": "529212099585384", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39035308_529212102918717_6273627732483575683_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LASHkNdny0YQ7kNvwHsJwNE&_nc_oc=AdqYUpbDBfW3CBZbO7DO9Yh89EZqC2PHpn6hOSzB4K-weL0dEWIhZz0j2iP9oxE5N7o&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JPcHDF6ouJlGxcY4gZB1wd7KDUMgfesEM03QUqc-yTg&oe=6A3948C7"}, {"file_name": "1.png", "id": "412945418477055", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75540507_412945425143721_5785752479458802654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIcm7O1cZlAQ7kNvwFss4KK&_nc_oc=Ado8DhgPFhSlhWeoipRbNrsY246NI-vycqeo0kyh1gjV-Cs2bpp0T1fGP7r_mdq2CR0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9x73zzAmRqC4Amc9tzkh-kSrZsMCz6l9LypLRuzcKG3Q&oe=6A395EF9"}, {"file_name": "3.png", "id": "483004181231791", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974835_483004184565124_5881156970613015115_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPamEn_gYloQ7kNvwGBoZNp&_nc_oc=AdpCC-KdJ3dt6FkEuClWrE3nBiMidCcVFv1kOfgUlufJ2jnGZwq3DaUoCfN2u-Fm3nM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FA4LCUwtz0ZDsCnrRxmH9H3S7N6do8C6iPdRcvbZLDA&oe=6A395F1A"}, {"file_name": "4.png", "id": "1193974355271044", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75272208_1193974358604377_1156306078450200288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmmKpwCxRLYQ7kNvwHqMtWK&_nc_oc=Adr-YOl-xDzzDmYOseK9Xjc0JWCzTvZBwcZPNXfevTqQb0nuHIv30IUHZKs8XojWYa4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MPuaRPDftURnNolbUnHWobmIUaW4JQ4ABVJUzJmOCnQ&oe=6A394DA0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Echo Eyes", "keywords": [], "long_description": "# EchoEyes: Your AI-Powered Companion for Visual Understanding\n\n# \ud83d\udc41\ufe0f See the World Through AI\n\nWelcome to EchoEyes, an innovative AI-powered app designed to empower individuals with visual impairments. Using cutting-edge technology and intuitive hand gestures, EchoEyes helps you understand your surroundings and navigate the world with confidence.\n{1233961281090920}\n## \ud83c\udf1f Key Features\n- **Gesture-Based Interface**: Simple hand movements control the app, ensuring ease of use.\n- **Real-Time Environment Description**: Get instant audio descriptions of your surroundings.\n- **Obstacle Detection**: Receive timely alerts about potential hazards in your path.\n\n\n## \ud83d\udd27 How It Works\n- Activate EchoEyes with a simple gesture.\n- Explore your environment using intuitive hand movements.\n- Listen to clear, concise audio descriptions and alerts.\n\n## \ud83d\ude80 Benefits\n\n- **Enhanced Independence**: Navigate unfamiliar spaces with greater confidence.\n- **Improved Safety**: Stay aware of potential dangers in your surroundings.\n- **Expanded Access**: Interact with visual information previously out of reach.\n- **Seamless Integration**: Fits naturally into your daily routine.\n\n## \ud83d\udca1 Perfect For\n\n- Individuals with visual impairments\n- Those experiencing gradual vision loss\n- Anyone seeking an extra layer of environmental awareness", "short_description": "Welcome to EchoEyes, an AI-powered app designed for the blind. With just simple hand gestures, it helps you understand your surroundings."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bbape.com/privacypolicy_echoeyes.html", "developer_terms_of_service_url": null, "publisher_name": "BBAPE", "support_website_url": null, "website_url": "https://bbape.com/privacypolicy_echoeyes.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "
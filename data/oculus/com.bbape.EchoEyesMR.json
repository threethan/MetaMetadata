AfsLujifNzC2sK34rOOq9hxFFyH31IPITp7JKs5ATJHapg&oe=699F0947"}, {"file_name": "1.png", "id": "412945418477055", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75540507_412945425143721_5785752479458802654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wh6ddJscsU4Q7kNvwFSNgyD&_nc_oc=AdnEWBsmEpXKRJuuPShQdjpHN2Xb3xcxAgg8RkRa5gwX1OaeD4feNzAnhi-D6kf6AJ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftZ48TP-B4MW9Xfzcwjmx_NBGgYApn5xLEAJfxi6Mm0VQ&oe=699EE739"}, {"file_name": "3.png", "id": "483004181231791", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974835_483004184565124_5881156970613015115_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaoQTP69k0kQ7kNvwFHyu1P&_nc_oc=AdnT8ItzwRCsA66j0iWP6dLPB9ThvDAK_umqd3ypY48y0w66MMNVJX8GXclwYMbbfzM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvIC14KQN656Tdmrb50c6lyrfJuYNpk9rC4i5drgGmvDg&oe=699EE75A"}, {"file_name": "4.png", "id": "1193974355271044", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75272208_1193974358604377_1156306078450200288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7XW9UYVap4Q7kNvwFjN9h2&_nc_oc=AdlX3rLIIGwj7yMDlLYrGSASaPGVFQFECtYbfdBAInnWjFty37kwTHkjiXfJwA0k5sQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsImIoxAWgX1BGdd0taiDI5x9afxcTnJm7r0LSKyVAF-g&oe=699ED5E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Echo Eyes", "keywords": [], "long_description": "# EchoEyes: Your AI-Powered Companion for Visual Understanding\n\n# \ud83d\udc41\ufe0f See the World Through AI\n\nWelcome to EchoEyes, an innovative AI-powered app designed to empower individuals with visual impairments. Using cutting-edge technology and intuitive hand gestures, EchoEyes helps you understand your surroundings and navigate the world with confidence.\n{1233961281090920}\n## \ud83c\udf1f Key Features\n- **Gesture-Based Interface**: Simple hand movements control the app, ensuring ease of use.\n- **Real-Time Environment Description**: Get instant audio descriptions of your surroundings.\n- **Obstacle Detection**: Receive timely alerts about potential hazards in your path.\n\n\n## \ud83d\udd27 How It Works\n- Activate EchoEyes with a simple gesture.\n- Explore your environment using intuitive hand movements.\n- Listen to clear, concise audio descriptions and alerts.\n\n## \ud83d\ude80 Benefits\n\n- **Enhanced Independence**: Navigate unfamiliar spaces with greater confidence.\n- **Improved Safety**: Stay aware of potential dangers in your surroundings.\n- **Expanded Access**: Interact with visual information previously out of reach.\n- **Seamless Integration**: Fits naturally into your daily routine.\n\n## \ud83d\udca1 Perfect For\n\n- Individuals with visual impairments\n- Those experiencing gradual vision loss\n- Anyone seeking an extra layer of environmental awareness", "short_description": "Welcome to EchoEyes, an AI-powered app designed for the blind. With just simple hand gestures, it helps you understand your surroundings."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bbape.com/privacypolicy_echoeyes.html", "developer_terms_of_service_url": null, "publisher_name": "BBAPE", "support_website_url": null, "website_url": "https://bbape.com/privacypolicy_echoeyes.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8111503255634369"}}]}, "scheduled_offers": {"count": 13, "nod
}, {"file_name": "2.png", "id": "529212099585384", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39035308_529212102918717_6273627732483575683_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LASHkNdny0YQ7kNvwHe8yXq&_nc_oc=Adp4IbaCDLTn8XAxn38yHmJ7j5l9PrfqROwftBuzznLqc98HLlSA_KJSb0jHVX7ms80&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KkNRBoFtLbpHcepoyz7BjiNXSgslXoYDMZ1wSJueZ0A&oe=6A36A5C7"}, {"file_name": "1.png", "id": "412945418477055", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75540507_412945425143721_5785752479458802654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x61Vzji_vUoQ7kNvwHELI0p&_nc_oc=AdrluwQGyByJO3HAQYEJiqy8zi4KUszuwB6cRiaNrWQdS4tPS1KJthJ1h1wxuiH89KM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zaDq_hQRjcOMpxq6Cjk35h4SpP76m75j2J9KqF72qpg&oe=6A36BBF9"}, {"file_name": "3.png", "id": "483004181231791", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974835_483004184565124_5881156970613015115_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNNqA_wzKgQQ7kNvwFZQJtG&_nc_oc=Adpvf72NoIvT6O13scd6ZUnvH-Rd2GtYP1fy38r77W-sqYEp61PEHfERuYgl514_a8o&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yrWWS1Yff-3-gOzPe0b3CRbDF5YYbXw55h2dhXH_cqQ&oe=6A36BC1A"}, {"file_name": "4.png", "id": "1193974355271044", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75272208_1193974358604377_1156306078450200288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9kP5W4QuWsQ7kNvwE_jhJP&_nc_oc=AdrzqcUsodPKNYs7E-ofqclQg5RpBU5AUBy6CTwM_5cXorKdoCfikprXr5dQY6LYdZU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UiaM_2LCicLE0aL6RVIadpZKpUsm6oO7ic5XA79ztQw&oe=6A36AAA0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Echo Eyes", "keywords": [], "long_description": "# EchoEyes: Your AI-Powered Companion for Visual Understanding\n\n# \ud83d\udc41\ufe0f See the World Through AI\n\nWelcome to EchoEyes, an innovative AI-powered app designed to empower individuals with visual impairments. Using cutting-edge technology and intuitive hand gestures, EchoEyes helps you understand your surroundings and navigate the world with confidence.\n{1233961281090920}\n## \ud83c\udf1f Key Features\n- **Gesture-Based Interface**: Simple hand movements control the app, ensuring ease of use.\n- **Real-Time Environment Description**: Get instant audio descriptions of your surroundings.\n- **Obstacle Detection**: Receive timely alerts about potential hazards in your path.\n\n\n## \ud83d\udd27 How It Works\n- Activate EchoEyes with a simple gesture.\n- Explore your environment using intuitive hand movements.\n- Listen to clear, concise audio descriptions and alerts.\n\n## \ud83d\ude80 Benefits\n\n- **Enhanced Independence**: Navigate unfamiliar spaces with greater confidence.\n- **Improved Safety**: Stay aware of potential dangers in your surroundings.\n- **Expanded Access**: Interact with visual information previously out of reach.\n- **Seamless Integration**: Fits naturally into your daily routine.\n\n## \ud83d\udca1 Perfect For\n\n- Individuals with visual impairments\n- Those experiencing gradual vision loss\n- Anyone seeking an extra layer of environmental awareness", "short_description": "Welcome to EchoEyes, an AI-powered app designed for the blind. With just simple hand gestures, it helps you understand your surroundings."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bbape.com/privacypolicy_echoeyes.html", "developer_terms_of_service_url": null, "publisher_name": "BBAPE", "support_website_url": null, "website_url": "https://bbape.com/privacypolicy_echoeyes.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "
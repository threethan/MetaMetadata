0YPm27qv3sJe0lpeRayAZ3Xc6TI-g9Xu5r62NCmMRPkjlFtzBmY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2K30ag4ccZFAPHwLut7QozGqtQRtZcKq0JGmtJ00md3g&oe=69F217C7"}, {"file_name": "1.png", "id": "412945418477055", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75540507_412945425143721_5785752479458802654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeazEVc8IRsQ7kNvwFTfOVH&_nc_oc=AdqSpOc2YE6PJdQ2y1J2s121E1uU22eIDFvCxWaFuPYTGvpPJcurPYZT1_pUjfzkKkg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0KZP04zlOwohGKHw5cqUrRmZRGc6rxrtlBaQ0MHKRfOQ&oe=69F1F5B9"}, {"file_name": "3.png", "id": "483004181231791", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974835_483004184565124_5881156970613015115_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-b1DNwAR0YQ7kNvwHZ8nu_&_nc_oc=AdqA_QX8Eynb015AfjzZU2SQHx7OxTT-kekHdxkguMFzOScZKQz-muDOc_JiUbPicMM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1K0Tjuwa3AhtHv4ef_oTg2hSynX6uepGaWL6aARAbkiA&oe=69F1F5DA"}, {"file_name": "4.png", "id": "1193974355271044", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75272208_1193974358604377_1156306078450200288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HoPySKiQI04Q7kNvwEHMvcv&_nc_oc=AdoFZtg3w7dmyiYF7ajNINiHSZtDzxhpvFX16SdmaRSTjuVfbJNlvU2G66GKqhMm6f8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0-7bXZZcZlCQ2eZK4qwsz2Lc5GZOVFsrNuXAVMrZ2Rtg&oe=69F1E460"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Echo Eyes", "keywords": [], "long_description": "# EchoEyes: Your AI-Powered Companion for Visual Understanding\n\n# \ud83d\udc41\ufe0f See the World Through AI\n\nWelcome to EchoEyes, an innovative AI-powered app designed to empower individuals with visual impairments. Using cutting-edge technology and intuitive hand gestures, EchoEyes helps you understand your surroundings and navigate the world with confidence.\n{1233961281090920}\n## \ud83c\udf1f Key Features\n- **Gesture-Based Interface**: Simple hand movements control the app, ensuring ease of use.\n- **Real-Time Environment Description**: Get instant audio descriptions of your surroundings.\n- **Obstacle Detection**: Receive timely alerts about potential hazards in your path.\n\n\n## \ud83d\udd27 How It Works\n- Activate EchoEyes with a simple gesture.\n- Explore your environment using intuitive hand movements.\n- Listen to clear, concise audio descriptions and alerts.\n\n## \ud83d\ude80 Benefits\n\n- **Enhanced Independence**: Navigate unfamiliar spaces with greater confidence.\n- **Improved Safety**: Stay aware of potential dangers in your surroundings.\n- **Expanded Access**: Interact with visual information previously out of reach.\n- **Seamless Integration**: Fits naturally into your daily routine.\n\n## \ud83d\udca1 Perfect For\n\n- Individuals with visual impairments\n- Those experiencing gradual vision loss\n- Anyone seeking an extra layer of environmental awareness", "short_description": "Welcome to EchoEyes, an AI-powered app designed for the blind. With just simple hand gestures, it helps you understand your surroundings."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bbape.com/privacypolicy_echoeyes.html", "developer_terms_of_service_url": null, "publisher_name": "BBAPE", "support_website_url": null, "website_url": "https://bbape.com/privacypolicy_echoeyes.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tr
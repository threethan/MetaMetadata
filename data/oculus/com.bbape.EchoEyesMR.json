Afs9jZmXypW2rtN7BngKWWNKSiGa7yxpc2TUosvBZsw86w&oe=69A05AC7"}, {"file_name": "1.png", "id": "412945418477055", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75540507_412945425143721_5785752479458802654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wh6ddJscsU4Q7kNvwECB9t8&_nc_oc=AdmHNAO2S-1ZEp5VDtiz964WBNxz4OLM9Tkzpmhvb8eKqCmVKfFMD3Q40lBX78XkyTk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvjTCqMEHJ7nJ6npI-G6LGT878NMa87aITJD_JXpA0zeQ&oe=69A038B9"}, {"file_name": "3.png", "id": "483004181231791", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974835_483004184565124_5881156970613015115_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaoQTP69k0kQ7kNvwHKXLHN&_nc_oc=Adk8tm_54zHVh0Zj8jV8yrc3risOm9QhlF0X6Wn6GrRWSUfNJHw2e68YqJx6nVg1xgQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvP5omAJhWyk1JGvJi3I68LDD2FH4NG8OKvgx36CxbHcw&oe=69A038DA"}, {"file_name": "4.png", "id": "1193974355271044", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75272208_1193974358604377_1156306078450200288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7XW9UYVap4Q7kNvwGVueIr&_nc_oc=AdnoSFdWVjrcbv0lkguRAYjeRnZgey6IKyiaiwP2fZFN1j-IC_FhTB1YXamWSl7do_s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvO1o2eYSpO8HlAX73uEGPFO8MOuMlvCNNign0N1IeDjw&oe=69A02760"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Echo Eyes", "keywords": [], "long_description": "# EchoEyes: Your AI-Powered Companion for Visual Understanding\n\n# \ud83d\udc41\ufe0f See the World Through AI\n\nWelcome to EchoEyes, an innovative AI-powered app designed to empower individuals with visual impairments. Using cutting-edge technology and intuitive hand gestures, EchoEyes helps you understand your surroundings and navigate the world with confidence.\n{1233961281090920}\n## \ud83c\udf1f Key Features\n- **Gesture-Based Interface**: Simple hand movements control the app, ensuring ease of use.\n- **Real-Time Environment Description**: Get instant audio descriptions of your surroundings.\n- **Obstacle Detection**: Receive timely alerts about potential hazards in your path.\n\n\n## \ud83d\udd27 How It Works\n- Activate EchoEyes with a simple gesture.\n- Explore your environment using intuitive hand movements.\n- Listen to clear, concise audio descriptions and alerts.\n\n## \ud83d\ude80 Benefits\n\n- **Enhanced Independence**: Navigate unfamiliar spaces with greater confidence.\n- **Improved Safety**: Stay aware of potential dangers in your surroundings.\n- **Expanded Access**: Interact with visual information previously out of reach.\n- **Seamless Integration**: Fits naturally into your daily routine.\n\n## \ud83d\udca1 Perfect For\n\n- Individuals with visual impairments\n- Those experiencing gradual vision loss\n- Anyone seeking an extra layer of environmental awareness", "short_description": "Welcome to EchoEyes, an AI-powered app designed for the blind. With just simple hand gestures, it helps you understand your surroundings."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bbape.com/privacypolicy_echoeyes.html", "developer_terms_of_service_url": null, "publisher_name": "BBAPE", "support_website_url": null, "website_url": "https://bbape.com/privacypolicy_echoeyes.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8111503255634369"}}]}, "scheduled_offers": {"count": 13, "nod
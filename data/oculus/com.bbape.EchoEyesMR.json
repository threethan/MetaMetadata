2.png", "id": "529212099585384", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035308_529212102918717_6273627732483575683_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlFF2-833p0Q7kNvwGRdAVu&_nc_oc=AdqerPbQJ26OAueIRjXZZ5Xiojadei8w4OeGXKBgCkO05rr1QSrd0RWiKaOU_fZyFm0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_1HWCUIbOBN8O7pwkasfXLOZvWXJ41FJOZX0MyIVMsg&oe=6A130D47"}, {"file_name": "1.png", "id": "412945418477055", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75540507_412945425143721_5785752479458802654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwtjkFwGxLEQ7kNvwFWkm5u&_nc_oc=AdpynNat5GqmOcWaRUzmucybIBnd_e10qgw8qWYqs5SHOBZuMBS7dHw-ycG4b9TMaNs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mJRlBd6XKX6tPDtWe7blcIzJ3z7VYKkmcZK2yO-GVWA&oe=6A132379"}, {"file_name": "3.png", "id": "483004181231791", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974835_483004184565124_5881156970613015115_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1LciP9yzccAQ7kNvwEJJ-nA&_nc_oc=Adou3NAH0tZub5Qp6ziytHB8H8RN-qm_7R7xie5YnUkiV1efFbNxF8GpeMW1atGx0Lw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7elmMDxNxOj7D6Z0ug5R_7S5Z0ac9a1Dz0BsOSKsfh1w&oe=6A13239A"}, {"file_name": "4.png", "id": "1193974355271044", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75272208_1193974358604377_1156306078450200288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mm28bxVAk1MQ7kNvwGZmF4w&_nc_oc=Adr1_swcXEkUCgmUgIwkdpWP9acIs0ak6pRMTqRyGBhjUBsaF0waSvpBI8G1ImA-X4c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78shmY5t5fs7RJPr186ZLNufa18iAdBBSENGeDnPt36Q&oe=6A131220"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Echo Eyes", "keywords": [], "long_description": "# EchoEyes: Your AI-Powered Companion for Visual Understanding\n\n# \ud83d\udc41\ufe0f See the World Through AI\n\nWelcome to EchoEyes, an innovative AI-powered app designed to empower individuals with visual impairments. Using cutting-edge technology and intuitive hand gestures, EchoEyes helps you understand your surroundings and navigate the world with confidence.\n{1233961281090920}\n## \ud83c\udf1f Key Features\n- **Gesture-Based Interface**: Simple hand movements control the app, ensuring ease of use.\n- **Real-Time Environment Description**: Get instant audio descriptions of your surroundings.\n- **Obstacle Detection**: Receive timely alerts about potential hazards in your path.\n\n\n## \ud83d\udd27 How It Works\n- Activate EchoEyes with a simple gesture.\n- Explore your environment using intuitive hand movements.\n- Listen to clear, concise audio descriptions and alerts.\n\n## \ud83d\ude80 Benefits\n\n- **Enhanced Independence**: Navigate unfamiliar spaces with greater confidence.\n- **Improved Safety**: Stay aware of potential dangers in your surroundings.\n- **Expanded Access**: Interact with visual information previously out of reach.\n- **Seamless Integration**: Fits naturally into your daily routine.\n\n## \ud83d\udca1 Perfect For\n\n- Individuals with visual impairments\n- Those experiencing gradual vision loss\n- Anyone seeking an extra layer of environmental awareness", "short_description": "Welcome to EchoEyes, an AI-powered app designed for the blind. With just simple hand gestures, it helps you understand your surroundings."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bbape.com/privacypolicy_echoeyes.html", "developer_terms_of_service_url": null, "publisher_name": "BBAPE", "support_website_url": null, "website_url": "https://bbape.com/privacypolicy_echoeyes.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEM
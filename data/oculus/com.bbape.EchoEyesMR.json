}, {"file_name": "2.png", "id": "529212099585384", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39035308_529212102918717_6273627732483575683_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X54tC6vPJ1QQ7kNvwHrGBv2&_nc_oc=AdrYwW81DaWMXx1uJQrI-XgazuxH3CHdO-Ho_WGwZhiod-SOvpmsuDRAWB6GtwEXbFg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhdwgwx43cuJo-hI1rnIdwIg2uMg7b8v0sxiFD1qbfkQ&oe=6AA41247"}, {"file_name": "1.png", "id": "412945418477055", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75540507_412945425143721_5785752479458802654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TedcUHNlfQ8Q7kNvwHmoZul&_nc_oc=AdrMKpJN1ie_4y9dq8oRauG4jnccjnCgM8vmQagWcFqokfRZGBU1TPcIfeFN6v_HPME&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYvhIPVT6wXniH996sf-IrtQwpuv9fYF3KsRet9qbiQA&oe=6AA3F039"}, {"file_name": "3.png", "id": "483004181231791", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974835_483004184565124_5881156970613015115_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LwIq9I9j0EQ7kNvwFdyobG&_nc_oc=AdrK1Y7rzrJd3zAjOHYG6yKvwJBcT5fsKZKyBX9Kgx7oPv4hYGL3DpcOnU49oTG6jMU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqbtjVI7Uhpm1AD4bjv855mWLXjTmRy0UWqhxkyztE-w&oe=6AA3F05A"}, {"file_name": "4.png", "id": "1193974355271044", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75272208_1193974358604377_1156306078450200288_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htb6lPnmZPAQ7kNvwEJNtI3&_nc_oc=Adr9B7ZzW8u4Aczw_wJIv-u-RrK76ZIEY-PBp-_T8jMCozGiXont7-z2OfyAr8p8c2E&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKyvl4UPVuayUwVHrUSgwRbFTBzQWQgbt_1juaU8Aa9w&oe=6AA41720"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Echo Eyes", "keywords": [], "long_description": "# EchoEyes: Your AI-Powered Companion for Visual Understanding\n\n# \ud83d\udc41\ufe0f See the World Through AI\n\nWelcome to EchoEyes, an innovative AI-powered app designed to empower individuals with visual impairments. Using cutting-edge technology and intuitive hand gestures, EchoEyes helps you understand your surroundings and navigate the world with confidence.\n{1233961281090920}\n## \ud83c\udf1f Key Features\n- **Gesture-Based Interface**: Simple hand movements control the app, ensuring ease of use.\n- **Real-Time Environment Description**: Get instant audio descriptions of your surroundings.\n- **Obstacle Detection**: Receive timely alerts about potential hazards in your path.\n\n\n## \ud83d\udd27 How It Works\n- Activate EchoEyes with a simple gesture.\n- Explore your environment using intuitive hand movements.\n- Listen to clear, concise audio descriptions and alerts.\n\n## \ud83d\ude80 Benefits\n\n- **Enhanced Independence**: Navigate unfamiliar spaces with greater confidence.\n- **Improved Safety**: Stay aware of potential dangers in your surroundings.\n- **Expanded Access**: Interact with visual information previously out of reach.\n- **Seamless Integration**: Fits naturally into your daily routine.\n\n## \ud83d\udca1 Perfect For\n\n- Individuals with visual impairments\n- Those experiencing gradual vision loss\n- Anyone seeking an extra layer of environmental awareness", "short_description": "Welcome to EchoEyes, an AI-powered app designed for the blind. With just simple hand gestures, it helps you understand your surroundings."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bbape.com/privacypolicy_echoeyes.html", "developer_terms_of_service_url": null, "publisher_name": "BBAPE", "support_website_url": null, "website_url": "https://bbape.com/privacypolicy_echoeyes.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "
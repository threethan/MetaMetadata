jr_2TmtiNvQmrNMEL3yWhQ&oe=69B3F2A1"}, {"file_name": "0.png", "id": "2311328955882136", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036657_2311328962548802_8183369815991323783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrlTda8nsc8Q7kNvwFseP3y&_nc_oc=AdkewY3SgP2FvoVJkFmsCkcSdSFmjBedUrIyKyHouK1Ja4kAhj-PHnO3kRicMV53v4o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyfSzhz7dw56JJwxhlCpMlTOEkuCPwwgE7D7m5jHpKemA&oe=69B3F9D1"}, {"file_name": "1.png", "id": "1062674858571716", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75240106_1062674861905049_448257407803339299_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5CHgIwoItIQ7kNvwGKC7FT&_nc_oc=Adl5gDyDG8a7taQfIaOZ6FoB63EAXwBOy-O0FnOr-41MJ6cxODs8jSuTFYkcMVeAeJ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUIAaKpDUsOZovr52tzjNvIfcr-95SxGSzz0a4aCw55A&oe=69B40EE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "4323366401316608", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618910_4323366407983274_8132472247214722963_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-k9Nx9IglkQ7kNvwGuiOM2&_nc_oc=AdmC5UC7Zp79vt8c6FMaWVbHTouP2bvUgMimc4PvXUChp8kBI5ybSMegbizQ1yb5A9M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyMVtEOevwAAXv1FtFb1EIDI1p8rmwY75toWSU0kROXkw&oe=69B4110D"}, "display_name": "Echo Eyes", "keywords": ["blind", "impaired", "echoeyes", "ai", "microgestures"], "long_description": "# EchoEyes: AI Vision Assistance for Blind & Low-Vision Users\n\n# \ud83d\udc41\ufe0f See the World Through AI\n\nEchoEyes is an AI-powered accessibility tool for blind and low-vision users.\n\nWith simple microgestures, understand surroundings, read text, detect danger, and navigate with spatial audio\u2014hands-free and intuitive.\n\n{541757971654618}\n\n\n# \ud83c\udfaf Key Features\n\n**\u270b Microgesture Controls**\nNo buttons\u2014just tiny thumb motions to control everything one-handed.\n\n**\ud83d\udc42 Real-Time Environment Understanding**\n\nInstant audio descriptions of people, objects, and details around you.\n{698820153064551}\n\n**\ud83d\udd24 Text Recognition**\n\nSwipe to read signs, labels, screens, and documents instantly.\n{1980090422559372}\n\n\n**\u26a0\ufe0f Danger Detection**\n\nImmediate alerts when hazards are detected ahead or behind you.\n{1522562372352780}\n\n**\ud83e\uddaf EchoRay: Virtual Guide Cane**\n\nTurn your hand into a spatial audio guide cane. Through MR, EchoRay transforms surfaces into 3D sound\u2014closer obstacles sound louder. Navigate by listening, like a white cane.\n{1188999569319260}\n\n# \u270b How It Works\n- **Scan surroundings** \u2192 Thumb Tap\n- **Left / Right Swipe** \u2192 Read text\n- **Detect danger** \u2192 Forward / Backward Swipe\n- **EchoRay** \u2192 Pinch & Hold 3 sec\n\nRaise thumb beside index finger, tap or slide. EchoRay: pinch and hold. Both hands work independently.\n\n{840249464553769}\n# \ud83d\udc8e Benefits\n\n- Independence: Move confidently anywhere.\n- Safety: Real-time hazard awareness.\n- Spatial Awareness: Sense obstacles with 3D audio.\n\n# \ud83c\udf1f Perfect For\n\n- Blind and low-vision users\n- Those with gradual vision loss\n- Anyone needing environmental awareness\n\n", "short_description": "Welcome to EchoEyes, an AI-powered app designed for the blind. With just simple hand micro-gestures, it helps you understand your surroundings."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bbape.com/privacypolicy_echoeyes.html", "developer_terms_of_service_url": null, "publisher_name": "BBAPE", "support_website_url": null, "website_url": "https://bbape.com/privacypolicy_echoeyes.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "int
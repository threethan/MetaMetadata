0&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NaQaRv_JzhEQ7kNvwED7ZfG&_nc_oc=Adr4tE3381vAi_DmGskdNuq471HBbZlj9mVYj-t07atS08rQvdaJlH0HpflUWbwFNvw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFk0bwOH4IxwEYqcwqQ2XJbhyvigAKJHxAQuOd8j3Ip3g&oe=6A7091BC"}, {"file_name": "SF_Screen_5.png", "id": "1487467098261800", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974479_1487467101595133_7409386826309460236_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1oEtQRE2UnIQ7kNvwGWR53S&_nc_oc=Adp_xkTrc_OhjSg6iBP-AxS0YJEUMO5QmNNg8hTdyYxG2FDN8wFVksSmxmcl4vNiHkA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFplbiDqRaOt84TdyHKFWtPtRRfzEx2DCCGjYwnh0Y7IA&oe=6A70859E"}, {"file_name": "SF_Screen_3.png", "id": "3030513400505944", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974654_3030513403839277_1765957144461533522_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7a0GNbisTYQ7kNvwHoRKHC&_nc_oc=AdqqzQh5laqBnRjx4sDVwiwPRy_ErWiMWgi7OqYl3CZ4ljR1QrlMNj0OyxTWRvuEbDk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4kZ5B6KXHOyzcMXxK9LNgHfvf0BSrvTU0Y--ULW2-aQ&oe=6A7073E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultimate Snowball Fight", "keywords": [], "long_description": "Compete for the Crown by throwing Snowballs and Snowbombs to defeat other real players and bots all while staying out of the storm! Search and loot powerups to aid you in battle as you fight to remain the last one standing!\n\nSprint, jump, fly, and climb to fully take advantage of the physics based gameplay. Maintain momentum to cover large areas of ground quickly, search for powerups, and seek out enemies.\n\nPhysics Based Gameplay!\nNo more pointing a gun and pulling the trigger, now your physical throwing accuracy translates directly to where you hit.\n\nClimb Anything, Fly Anywhere!\nLiterally no limits. If you want to fly out of the game world, go for it. Results may vary.\n\nDrop in / Drop Out Spectating!\nJoin in mid round or want to take a break for a round? Easily swap between spectator mode and gameplay mode on the fly.\n\n- A Battle Royale like no other... Winter Has Arrived! -", "short_description": "Physics-Based Online Multiplayer Battle Royale!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://grittygames.wixsite.com/snowballfight/privacy", "developer_terms_of_service_url": null, "publisher_name": "Gritty Games", "support_website_url": null, "website_url": "https://sidequestvr.com/app/2195/ultimate-snowball-fight", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "8232119693470969"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974703_3094284664128513_1511556308391395431_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IqRwYLF11NkQ7kNvwFkYGkf&_nc_oc=Adrtfep1q8lpfAIPVtnmMxx4nV8FeIHLQjEG41MtPLCFQK3DawWiII4qVrcEECqzabI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWZtLzxvIHB7MhVdEw63r-858nIqs5PxSwutd8R9qxwA&oe=6A7097CA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ultimate Snowball Fight", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "
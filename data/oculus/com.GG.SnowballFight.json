t3kobvWjFSQ1pEEdsx7Fs0oC6PtmhaZrjLgxg&oe=6AFC6987"}, {"file_name": "SF_Screen_4.png", "id": "2900330063567687", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982580_2900330070234353_7340895607163326257_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DXXGxkJWWcQ7kNvwE5frkl&_nc_oc=AdpkX4QZ5PJPC6as6DOZjlnqqGCJUJB2N1Zdqpg9lGzrL2iK2PBLqYDEW5xwDXjgZzo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSl_SPQ7zZoSHvHBr54VQ8UyzjR0qt1O7GqX4qS3wa17g&oe=6AFC88FC"}, {"file_name": "SF_Screen_5.png", "id": "1487467098261800", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974479_1487467101595133_7409386826309460236_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lp5aJAm5bcQQ7kNvwFmLJfh&_nc_oc=AdpcQ8duQ-hwDcfvpQUU9ECry0NZk20CPi0b637StOrwMx7f3V6kSDcOnAF1O09Azts&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDfgn9ChA6k_WVDrgfq2gXNMJCqh3OFtwmupREFWIWTw&oe=6AFC7CDE"}, {"file_name": "SF_Screen_3.png", "id": "3030513400505944", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974654_3030513403839277_1765957144461533522_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQxdZmVHGP0Q7kNvwFKopQ0&_nc_oc=AdqI2hjF4BUrhdWphICQuj4KKgSlSFOTChPhwQn6EGaqML6BCEq2h-4udGhU-QKJZVc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThLThADYGVKHzZ14NeikXawv7VTGkWrK6hRpClSxsBOg&oe=6AFC6B29"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultimate Snowball Fight", "keywords": [], "long_description": "Compete for the Crown by throwing Snowballs and Snowbombs to defeat other real players and bots all while staying out of the storm! Search and loot powerups to aid you in battle as you fight to remain the last one standing!\n\nSprint, jump, fly, and climb to fully take advantage of the physics based gameplay. Maintain momentum to cover large areas of ground quickly, search for powerups, and seek out enemies.\n\nPhysics Based Gameplay!\nNo more pointing a gun and pulling the trigger, now your physical throwing accuracy translates directly to where you hit.\n\nClimb Anything, Fly Anywhere!\nLiterally no limits. If you want to fly out of the game world, go for it. Results may vary.\n\nDrop in / Drop Out Spectating!\nJoin in mid round or want to take a break for a round? Easily swap between spectator mode and gameplay mode on the fly.\n\n- A Battle Royale like no other... Winter Has Arrived! -", "short_description": "Physics-Based Online Multiplayer Battle Royale!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://grittygames.wixsite.com/snowballfight/privacy", "developer_terms_of_service_url": null, "publisher_name": "Gritty Games", "support_website_url": null, "website_url": "https://sidequestvr.com/app/2195/ultimate-snowball-fight", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "8232119693470969"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974703_3094284664128513_1511556308391395431_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6K8YjVbIeDsQ7kNvwGs0l4u&_nc_oc=AdrW7yloCQ3r6ArhvgrIo9uQ-aMRhUoEOpmp3tOi5xUOaTgKGcI1pr__QK5g0aTqoEg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f
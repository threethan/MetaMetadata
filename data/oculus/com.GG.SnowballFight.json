0&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32NyTRwW9UUQ7kNvwG9_BPr&_nc_oc=Ado67CTgM-vFFOJmO13OYhWY_RNE2BdEB0tZRasUuRic_Mw2D-Em7hO4jQV9IVScZcI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VL5GAewHPyrn3igdk1m_9hRrvWBG4QTLvBdrdrsC_YQ&oe=6A10543C"}, {"file_name": "SF_Screen_5.png", "id": "1487467098261800", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974479_1487467101595133_7409386826309460236_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C736VLY8t3UQ7kNvwEUdAHs&_nc_oc=Adqj5WlPA803vEECxy4B9yJppodSHvo5Yux7Qh25-Mq5-2_Ato90vjf0RcjaXdN9V38&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6u5Udiszy08nDWv_4hR0RnH_mBslPM3RF8CiD0MQIf6A&oe=6A10481E"}, {"file_name": "SF_Screen_3.png", "id": "3030513400505944", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974654_3030513403839277_1765957144461533522_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVKLk42mSO4Q7kNvwEox0K9&_nc_oc=Adq4zf-sFE1QvctcHHdfPwXdQRmhc2gnUAHMN38EfhvAWehtLOd6CfAj6yjODC1BJTA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tMkw5KTtf1zodP8xyPu0nt1ACzhQr9QtKjd8bKgdjvA&oe=6A106EA9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultimate Snowball Fight", "keywords": [], "long_description": "Compete for the Crown by throwing Snowballs and Snowbombs to defeat other real players and bots all while staying out of the storm! Search and loot powerups to aid you in battle as you fight to remain the last one standing!\n\nSprint, jump, fly, and climb to fully take advantage of the physics based gameplay. Maintain momentum to cover large areas of ground quickly, search for powerups, and seek out enemies.\n\nPhysics Based Gameplay!\nNo more pointing a gun and pulling the trigger, now your physical throwing accuracy translates directly to where you hit.\n\nClimb Anything, Fly Anywhere!\nLiterally no limits. If you want to fly out of the game world, go for it. Results may vary.\n\nDrop in / Drop Out Spectating!\nJoin in mid round or want to take a break for a round? Easily swap between spectator mode and gameplay mode on the fly.\n\n- A Battle Royale like no other... Winter Has Arrived! -", "short_description": "Physics-Based Online Multiplayer Battle Royale!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://grittygames.wixsite.com/snowballfight/privacy", "developer_terms_of_service_url": null, "publisher_name": "Gritty Games", "support_website_url": null, "website_url": "https://sidequestvr.com/app/2195/ultimate-snowball-fight", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "8232119693470969"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974703_3094284664128513_1511556308391395431_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nyMNZ8TetUQ7kNvwEG5Y9f&_nc_oc=Adp9Jv8mnYCjDAzSgMMw6y2ZLn5bzyvo_dmsRa2eC1AaGTpYf7MTUXa-7awJv-4Uqfo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5N0uVQybxSwT7u8NqCsVC2RqK9Jg9aS9vxdcCKG6LX-A&oe=6A105A4A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ultimate Snowball Fight", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "
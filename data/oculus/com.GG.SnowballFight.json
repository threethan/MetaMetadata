5vecITp6wl2a7Yf_BAyISd1DBAwcXHBTqgCcg&oe=6AFB1807"}, {"file_name": "SF_Screen_4.png", "id": "2900330063567687", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982580_2900330070234353_7340895607163326257_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DXXGxkJWWcQ7kNvwGZsQO_&_nc_oc=AdpxmKUjQIYX3NF2j5eKfpF-eEhKbzYNgmcyZAjXpBAuUXivpS3xMzLUr7dNJTu0eFM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKZsx7_hEt9dpjmYFETAYH6QBqFuWcOnzFeiyFJNPT5g&oe=6AFB377C"}, {"file_name": "SF_Screen_5.png", "id": "1487467098261800", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974479_1487467101595133_7409386826309460236_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObLjpwpYtuwQ7kNvwEJQJAk&_nc_oc=Ado3WaMo8D8rgvKVJnTvttE0o3GEibhDqrhUIoDJVs_ynrP4JywHDyOuqroyXvaHghY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCiARMUZnj_OHug98y234xdOPQcsiN377zYyBnafAnHg&oe=6AFB2B5E"}, {"file_name": "SF_Screen_3.png", "id": "3030513400505944", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974654_3030513403839277_1765957144461533522_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQxdZmVHGP0Q7kNvwGG6yjq&_nc_oc=AdrhivAGEX_87bPv6fm2d_t1USWl6T0kbxnp75w6vgcAlypktJyBXOmghqkC8oixv9E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTM8N5oi0CcwNpwJOLN-Y0w0dDwzeE4H0wNBUi0A0loxQ&oe=6AFB19A9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultimate Snowball Fight", "keywords": [], "long_description": "Compete for the Crown by throwing Snowballs and Snowbombs to defeat other real players and bots all while staying out of the storm! Search and loot powerups to aid you in battle as you fight to remain the last one standing!\n\nSprint, jump, fly, and climb to fully take advantage of the physics based gameplay. Maintain momentum to cover large areas of ground quickly, search for powerups, and seek out enemies.\n\nPhysics Based Gameplay!\nNo more pointing a gun and pulling the trigger, now your physical throwing accuracy translates directly to where you hit.\n\nClimb Anything, Fly Anywhere!\nLiterally no limits. If you want to fly out of the game world, go for it. Results may vary.\n\nDrop in / Drop Out Spectating!\nJoin in mid round or want to take a break for a round? Easily swap between spectator mode and gameplay mode on the fly.\n\n- A Battle Royale like no other... Winter Has Arrived! -", "short_description": "Physics-Based Online Multiplayer Battle Royale!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://grittygames.wixsite.com/snowballfight/privacy", "developer_terms_of_service_url": null, "publisher_name": "Gritty Games", "support_website_url": null, "website_url": "https://sidequestvr.com/app/2195/ultimate-snowball-fight", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "8232119693470969"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974703_3094284664128513_1511556308391395431_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkoK69KbhmMQ7kNvwG75NbF&_nc_oc=AdozACR2P-gqciaqsRjcb5v_CDu__GOyDwMKzv3QBd92LUGREJcYRXlY--NhrKsXWPU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f
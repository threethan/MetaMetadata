0&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PUl8pfqJq4Q7kNvwEf6ilT&_nc_oc=AdpUI6tuoEdP1cu0cMKPeWadqRdjzuauBeF9HPKZU-emjBB3Qx50EcK7IT-xyx_v04M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0t5VUYcxMMNzXUc_fJhSPhs-6L3lA_8f9N7AL_jJ4Ug&oe=6AF0AB7C"}, {"file_name": "SF_Screen_5.png", "id": "1487467098261800", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974479_1487467101595133_7409386826309460236_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qENAM-1DfuUQ7kNvwGeNGty&_nc_oc=AdrxCyfdAj9unucMQL9g7gmbdf5L5-P3tLcBaCHRA49TioB9R9m3FkkjVCLKDWbcTiw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTV-bxhi6OqussqTOUhEfpVKdHImQQLc5RUFX8s6Cxugg&oe=6AF09F5E"}, {"file_name": "SF_Screen_3.png", "id": "3030513400505944", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974654_3030513403839277_1765957144461533522_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBIC3XnU7nUQ7kNvwE9WqRA&_nc_oc=Adp3mCRTrhupk4Q1C1WUs0Hg4ahpVCupEqd4cOwcfAM7JsJkW-AeiTu6aBOSLKg3-Jc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpCLhjvnvCQvOyXN3uInr0PUDKL_qkGDM9bt66gQrP2A&oe=6AF08DA9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultimate Snowball Fight", "keywords": [], "long_description": "Compete for the Crown by throwing Snowballs and Snowbombs to defeat other real players and bots all while staying out of the storm! Search and loot powerups to aid you in battle as you fight to remain the last one standing!\n\nSprint, jump, fly, and climb to fully take advantage of the physics based gameplay. Maintain momentum to cover large areas of ground quickly, search for powerups, and seek out enemies.\n\nPhysics Based Gameplay!\nNo more pointing a gun and pulling the trigger, now your physical throwing accuracy translates directly to where you hit.\n\nClimb Anything, Fly Anywhere!\nLiterally no limits. If you want to fly out of the game world, go for it. Results may vary.\n\nDrop in / Drop Out Spectating!\nJoin in mid round or want to take a break for a round? Easily swap between spectator mode and gameplay mode on the fly.\n\n- A Battle Royale like no other... Winter Has Arrived! -", "short_description": "Physics-Based Online Multiplayer Battle Royale!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://grittygames.wixsite.com/snowballfight/privacy", "developer_terms_of_service_url": null, "publisher_name": "Gritty Games", "support_website_url": null, "website_url": "https://sidequestvr.com/app/2195/ultimate-snowball-fight", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "8232119693470969"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974703_3094284664128513_1511556308391395431_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jIJ0PVXSgIQ7kNvwGslI0n&_nc_oc=AdokPjzuUVvexqC5FuvO1eE5hKx_my3H9-rIV3IAn6nFLMfRzYZ4BWSTbjcqiDSerwg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqYw8NVgaKlRGu0YerRSV3Xxy5OYRONI34hgPeM1g89Q&oe=6AF0B18A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ultimate Snowball Fight", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "
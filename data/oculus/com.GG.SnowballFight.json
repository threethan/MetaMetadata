0&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1p5SI3EclpIQ7kNvwFC4Tnp&_nc_oc=AdodwDrubjDlHvjQd2YsmDKUiim9vQFuHeAFzntIoSDC7favq2AHRtMMUzXE9Y8ParQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAs9l68dKtokK_nrAglYuCWn-_M6Y7--uGgF2WTdNYgOQ&oe=6A4CF93C"}, {"file_name": "SF_Screen_5.png", "id": "1487467098261800", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974479_1487467101595133_7409386826309460236_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XU9FEB3cyoQ7kNvwFYvK6t&_nc_oc=Adp6kv9s_gUXC8xcZRvcxagojNy2jO261zrh-gaJKg34Y_V0o0PZFwzkzNzu9PoHV3E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXMBGmOlC5g1bXqgTd0YH7lsXckARdZ2YQKGqXi8pJ3A&oe=6A4CED1E"}, {"file_name": "SF_Screen_3.png", "id": "3030513400505944", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974654_3030513403839277_1765957144461533522_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czFNNPPJq78Q7kNvwE5xUPM&_nc_oc=AdpglJvI1mELGVdRGRROEMpq1lBmEI-iwigxJ3OnU5XmovZHptR48zKzrCDw1035NLI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxgUnG4hjpTRXe2iqTaz1CPr4Akj6STf0wzrzoU5x9Ww&oe=6A4D13A9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultimate Snowball Fight", "keywords": [], "long_description": "Compete for the Crown by throwing Snowballs and Snowbombs to defeat other real players and bots all while staying out of the storm! Search and loot powerups to aid you in battle as you fight to remain the last one standing!\n\nSprint, jump, fly, and climb to fully take advantage of the physics based gameplay. Maintain momentum to cover large areas of ground quickly, search for powerups, and seek out enemies.\n\nPhysics Based Gameplay!\nNo more pointing a gun and pulling the trigger, now your physical throwing accuracy translates directly to where you hit.\n\nClimb Anything, Fly Anywhere!\nLiterally no limits. If you want to fly out of the game world, go for it. Results may vary.\n\nDrop in / Drop Out Spectating!\nJoin in mid round or want to take a break for a round? Easily swap between spectator mode and gameplay mode on the fly.\n\n- A Battle Royale like no other... Winter Has Arrived! -", "short_description": "Physics-Based Online Multiplayer Battle Royale!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://grittygames.wixsite.com/snowballfight/privacy", "developer_terms_of_service_url": null, "publisher_name": "Gritty Games", "support_website_url": null, "website_url": "https://sidequestvr.com/app/2195/ultimate-snowball-fight", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "8232119693470969"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974703_3094284664128513_1511556308391395431_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3DQ_h6tuHQQ7kNvwE-SbTU&_nc_oc=Adqw91MfA2R5qD2tvX6wZd-I5y9r4TgYQ3dvUSOtr0lu1Ok3GUjDMqj834jF5wu5l-U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDg7dSc1zG25a777lLpe4wnDEXd0nSwHRy1eeYqlEn2rA&oe=6A4CFF4A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ultimate Snowball Fight", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "
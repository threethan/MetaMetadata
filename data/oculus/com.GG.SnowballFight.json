0&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75sTJlZSI_AQ7kNvwHzeMY1&_nc_oc=AdoL8cGb-GppAJHl6sZdmryT2P5HiqoJ_TJP5rI4DThrjclLqWoiudr8TVGRPDj0d3E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44iGFc5xnkwgn-mOQRvnDlnbqi1h44reM6zLtrCOfr3A&oe=6A03253C"}, {"file_name": "SF_Screen_5.png", "id": "1487467098261800", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_1487467101595133_7409386826309460236_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-x7d_OFfocQ7kNvwHOV2y2&_nc_oc=AdqpPye9Yd4Kl5RhyMQR1XswkALCllFR_yuw4TWYbTUGeBO93kt306QNMpJbYMXzPCc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZuShmexizAVwT8-vvAw-6WLb65ZJwW45nLyzTVR4XlQ&oe=6A03191E"}, {"file_name": "SF_Screen_3.png", "id": "3030513400505944", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974654_3030513403839277_1765957144461533522_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ADPEE0etxsQ7kNvwH5yBFa&_nc_oc=AdozCL6bewVYK5NDMzoNaWDQ6lpc_DIJ0l-o3XzWHybY2Ws862Cj3UZGpLrpuLsDqk8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dzto_y5fUDCWnPJSiMcgdIhP4ptouRFVOHaMolRD9-Q&oe=6A033FA9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultimate Snowball Fight", "keywords": [], "long_description": "Compete for the Crown by throwing Snowballs and Snowbombs to defeat other real players and bots all while staying out of the storm! Search and loot powerups to aid you in battle as you fight to remain the last one standing!\n\nSprint, jump, fly, and climb to fully take advantage of the physics based gameplay. Maintain momentum to cover large areas of ground quickly, search for powerups, and seek out enemies.\n\nPhysics Based Gameplay!\nNo more pointing a gun and pulling the trigger, now your physical throwing accuracy translates directly to where you hit.\n\nClimb Anything, Fly Anywhere!\nLiterally no limits. If you want to fly out of the game world, go for it. Results may vary.\n\nDrop in / Drop Out Spectating!\nJoin in mid round or want to take a break for a round? Easily swap between spectator mode and gameplay mode on the fly.\n\n- A Battle Royale like no other... Winter Has Arrived! -", "short_description": "Physics-Based Online Multiplayer Battle Royale!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://grittygames.wixsite.com/snowballfight/privacy", "developer_terms_of_service_url": null, "publisher_name": "Gritty Games", "support_website_url": null, "website_url": "https://sidequestvr.com/app/2195/ultimate-snowball-fight", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "8232119693470969"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974703_3094284664128513_1511556308391395431_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_XwKTb5gQ0Q7kNvwHghbXJ&_nc_oc=AdpDoTXsc3Xhv2vPoSJ6WsxzA0-lA9AS7Z3tl5kuE-SQDWyrH-Fti8Yur-P60R7xtQU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cb54BUbdVvhjPOTtUJ8rfqpfhaNqa-oWD3enxuGw69w&oe=6A032B4A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ultimate Snowball Fight", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "
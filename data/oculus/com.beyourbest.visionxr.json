oculuscdn.com&oh=00_AftpNdekwm3rnb0rGI_hM2QFEU0Q9GfqvLLCaUoSAGucmQ&oe=699EF3D8"}, {"file_name": "10.png", "id": "1540499197282513", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821081_1540499200615846_5633955096765532476_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mpxhpPGh_nMQ7kNvwEK7NGP&_nc_oc=AdmNFZl4WOkRGqy8iMj85ThFiycveXNdq32UGcK1L6_Wv1W6kwf6F3hZw3c7Nnr_MVs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvkscJ1Ox4DE-RzTXGulEbqTJRvvs85TJDoKxImxNbfVQ&oe=699F05FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "byb_landscape_2560x1440.png", "id": "1648517615520174", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210889_1648517618853507_2007437631331052425_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yu7zyTp02sQ7kNvwGauvpI&_nc_oc=Adk8S8On9VCJyiG6pX3s8PJa9QXsqIKosS7u5BDU-9Q33mySIKXJfVvKToJMEyC_IHw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu6Ewgz_IjNUsDXbLUMbBqBJDkBtxVwBauy8rO3WVeKcw&oe=699ED46D"}, "display_name": "Be Your Best - Football Training", "keywords": ["soccer", "football", "sports", "futbol", "training"], "long_description": "Step into the game with Be Your Best, the world\u2019s leading virtual reality football (soccer) training tool used by players at every level - from professionals to rising talents.\n\nExperience hundreds of real match scenarios recreated from top games around the world. On the virtual pitch, you\u2019ll take the role of a single player in realistic 11-a-side situations - scanning, making quick decisions, and improving your vision, awareness, and game intelligence.\nTrain like the pros do:\n\n \u2022 Scan the pitch and make the right passes under pressure\n \u2022 React to awareness challenges that sharpen your decision-making speed\n \u2022 Track your stats and progress over time\n\nThis is next-generation cognitive training. Perfect for players who want to:\n\n \u2022 Fit in extra training sessions at home\n \u2022 Stay sharp during injury recovery\n \u2022 Gain an edge before match day\n\nBe Your Best is a professional performance tool, not a game. Improvement comes from consistency, focus, and real training - just like on the pitch.", "short_description": "Step into the game with Be Your Best, the world\u2019s leading virtual reality football (soccer) training tool used by players at every level - from professionals to rising talents."}]}, "developer_name": "Be Your Best", "developer_privacy_policy_url": "https://www.beyourbest.com/privacy", "developer_terms_of_service_url": "https://www.beyourbest.com/terms", "publisher_name": "Be Your Best", "support_website_url": "https://www.beyourbest.com/contact", "website_url": "https://www.beyourbest.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25368277666097517"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001719_907859234815633_5412928493520085012_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZA_dbZgHjIQ7kNvwEM45Yj&_nc_oc=Adl9FHRvz8zJIEzb5K7KQIUcov_IMohKKp9qAR5UzZT-9r9xiDU8sZoGoWKey7fadcg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsfWFpnYTCeKEuMMYSvSt-Di0i7vPVahssu2nWkPmBTxw&oe=699ED678"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Be Your Best - Football Training", 
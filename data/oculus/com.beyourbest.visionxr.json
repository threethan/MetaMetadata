j4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSzpHmbvxKUG7Xz943OKI2YKoVYyBD1GlBILxYQM7oCw&oe=6A5E2975"}, {"file_name": "2021_8_26_14_18_19_537.png", "id": "301405778616276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031440_301405781949609_347936537591304936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkSLsXiFS-sQ7kNvwEZPmk1&_nc_oc=AdogaRYrUVTr6BYUTcFKc5LlsVWFulGtIzJCCV-rB9mikND6w60m8KlpvghtlvRoilI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUOJ4fbBT4mBOKlK7hY-U_ppvJ4gt9Ew29XFzwfOFG2w&oe=6A5E26CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "byb_landscape_2560x1440.png", "id": "1648517615520174", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210889_1648517618853507_2007437631331052425_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yzh70aZlYo8Q7kNvwGq9DGp&_nc_oc=AdrqlczIlYGKaOAVZKe1bsR7MboLw9VJMuhVI7vz3RQ5JE1wYGSHJzH_edsCSLA5fzg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_-0n9Vh_tmSDE5o5LQIAs-hwfrtKHWwH6sQEZmhDXgg&oe=6A5E362D"}, "display_name": "Be Your Best", "keywords": [], "long_description": "To gain an edge over your competition in football, it's essential to put in high-quality extra repetitions. Training that lets you replicate situations you meet on the field is key to maximizing your time and potential.\n\nWith Be Your Best, you can train perception & decision-making via real football match simulations, which is the same principle used for training airplane pilots, military personnel, and other high-performance professionals who need to react quickly and accurately to new information.", "short_description": "Build for professional footballers, Be Your Best provides a soccer training system based on real-world situations specially designed to improve the cognitive performance of players on and off the pitch. "}]}, "developer_name": "Be Your Best", "developer_privacy_policy_url": "https://www.beyourbest.com/privacy", "developer_terms_of_service_url": "https://www.beyourbest.com/terms", "publisher_name": "Be Your Best", "support_website_url": "https://www.beyourbest.com/contact", "website_url": "https://www.beyourbest.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "487888099456928"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1184296290376655"}, {"status": "PUBLISHED", "id": "666454971168314"}]}, "baseline_offer": {"id": "1184296290376655"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1747215060, "status": "PUBLISHED", "id": "1184296290376655"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27760540740204519", "version": "2.18.4"}, "id": "4474300072680174", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5105468496138399", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27760540740204519"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4474300072680174"}]}, "change_log": "\ufffd Update 2.18.4\n\nThis minor update brings some international tournament flair to your dressing room along with a few quality-of-life performance improvements.\n\n\ufffd What\u2019s New\n\n\u2022 World Cup Dressing Room Theme: Get into the tournament spirit! We\u2019ve added a brand-new World Cup theme to the dressing room experience.\n\n\u2022 Snappier Loading Times: We\u2019ve optimized performance behind the scenes to improve loading speeds for both Results and Replays.", "created_date": 1781177438, "id": "27760540740204519", "version": "2.18.4", "version_code": 109, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5105468496138399", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27760540740204519"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4474300072680174"}]}, "change_log": "Patch release that fixed missing Critical Scan results after some sessions.", "created_date": 1778068152, "id": "27295661006692497", "version": "2.18.3", "version_code": 108, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5105468496138399", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27760540740204519"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4474300072680174"}]}, "change_log": "Patch release to correct critical scan missing in  some results", "created_date": 1778005686, "id": "27287476250844306", "version": "2.18.4", "version_code": 107, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5105468496138399", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27760540740204519"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4474300072680174"}]}, "change_log": "The Data-Driven Decision Engine\nThis update marks a significant evolution in how we evaluate performance. We have upgraded to a fully objective, data-driven calculation for Decisions.\n\nNew Objective Decision Logic\nWe\u2019ve replaced the previous expert analysis for decision scores with a sophisticated new model that uses Gold Standard metrics to calculate decision quality. By analyzing a multitude of factors in every play, our new system ensures your stats are consistent, fair, and based on hard evidence.\n\nIt looks at four key pillars:\n\nExpected Goals (xG): How dangerous was the opportunity you created?\nExpected Threat (xT): Did your decision move the ball into a more threatening position?\nPass Completion Probability: How difficult was the pass you attempted?\nPass Turnover Probability: How risky was your decision?\n\n\nEnhanced Transparency\nTo help you understand the \"why\" behind your scores, these factors are now clearly broken down in the Explanation Screen. You can see exactly how the data-driven model weighed your choices against objective footballing standards.\n\nWhy the change?\nBy removing human bias, we\u2019re providing you with a more accurate reflection of your performance that aligns with the same advanced analytics used at the highest levels of professional football.\n\nAwareness Score Calibration\nWe\u2019ve fine-tuned the math behind the Awareness Score on the Performance Screen! We discovered that the previous summary calculation was a bit too \"generous,\" leading to inflated overall scores. We\u2019ve implemented a more rigorous calculation to ensure your stats are a 1:1 reflection of your performance.\nWhat this means for you:\n\nThe Number Might Change: You will likely see your overall Awareness Score shift downward on your profile. Don't worry\u2014you haven't lost any skill! The scale is simply more accurate now.\nRetroactive Accuracy: We\u2019ve applied this fix to your entire training history. This ensures that your past, present, and future data are all on the same scale, giving you a true look at your progression over time.\nSession Scoring: Your scores immediately following a session (the Results Screen) remain as accurate as ever; this change only affects the high-level summary on your Performance page.\n\n\nOther Improvements & Bug Fixes\n\nScoring Alignment: Previously, small discrepancies existed between VR, Mobile, and Portal. Everything is now perfectly aligned so your metrics are consistent across the entire ecosystem.\nAwareness Test Fix: Resolved an issue where players could be partially or fully hidden by the blacked-out area and still be included in the test.\nPerformance: Optimized leaderboard backend to significantly reduce loading times.\nVR App is now Dark mode only\n\n\nBe Your Best App Update 2.18.2\nAlongside the live service improvements above, we have also released Be Your Best app version 2.18.2 with a few important fixes inside the training experience. You will need to update your app for these changes to take effect.\n\nWhat\u2019s improved in the app:\n\nMore accurate awareness visuals: During awareness tests, the vignette and tunnel vision will more accurately match where you are looking as the test starts.\nSmoother 3D replays: Replays now feel more stable and comfortable, with less unwanted tilt during playback.\nMore reliable session endings: We fixed an issue that could cause the end curtain to appear twice or leave the app stuck after finishing a scenario.", "created_date": 1777538640, "id": "27226689893589609", "version": "2.18.2", "version_code": 106, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5105468496138399", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27760540740204519"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4474300072680174"}]}, "change_log": "Fixed an issue where a white screen loaded instead of main menu\nFixed an issue where some scenarios were missing from results", "created_date": 1771315534, "id": "26466890942902845", "version": "2.18.1", "version_code": 105, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
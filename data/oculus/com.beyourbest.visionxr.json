uU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_RHCWdC5n9wfO9OWhrfvP1SdJ2OEADDTHJ7490NXrtQ&oe=6A997CF5"}, {"file_name": "2021_8_26_14_18_19_537.png", "id": "301405778616276", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031440_301405781949609_347936537591304936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szojQ0L5MC4Q7kNvwF2YDLh&_nc_oc=Adpyz7TbfQ5yAWjYGRt3mku2mjWX1ChnC8k1aOPa2f-aAUna9amzfS_hOzxvcKUi9pU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaWU_7HRZQXfQLl3kbdScLQCs5zQVDAyDR2aDqXcHESA&oe=6A997A4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "byb_landscape_2560x1440.png", "id": "1648517615520174", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210889_1648517618853507_2007437631331052425_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viPPxIfLV0EQ7kNvwHOQ5gv&_nc_oc=AdpYxlF3O8-zeGmCpwHtkeM2UHaHdQdOir_Y2yYGC7PwCjULOP0NOIheIxNA768qCDM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ41dXHSYbjbup7KrxSuLExf-hpg8BGZX2iZ4R7M41VJg&oe=6A9989AD"}, "display_name": "Be Your Best", "keywords": [], "long_description": "To gain an edge over your competition in football, it's essential to put in high-quality extra repetitions. Training that lets you replicate situations you meet on the field is key to maximizing your time and potential.\n\nWith Be Your Best, you can train perception & decision-making via real football match simulations, which is the same principle used for training airplane pilots, military personnel, and other high-performance professionals who need to react quickly and accurately to new information.", "short_description": "Build for professional footballers, Be Your Best provides a soccer training system based on real-world situations specially designed to improve the cognitive performance of players on and off the pitch. "}]}, "developer_name": "Be Your Best", "developer_privacy_policy_url": "https://www.beyourbest.com/privacy", "devel
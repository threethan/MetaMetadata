-p3ylrSfiNzz420dIUtbtVkKqpSAbSj3UtAsXO9QQy6Fh6gU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfymWidNyGMN31HH3MguCFmjxHiOZ24FObqdH5LB0mPDWQ&oe=69B168D8"}, {"file_name": "10.png", "id": "1540499197282513", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821081_1540499200615846_5633955096765532476_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yJTxC67LF4Q7kNvwGDTLef&_nc_oc=AdmvvslHT-aLeIfY2C1nSIs9i0PbFqjiUN0O5mObpp8uoSvF3tcTo1lo38lhDRHnQU8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLaFOccbGy3BKjq2GUxP6rmIhJZapDHFxWKx0t1_nKfQ&oe=69B17AFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "byb_landscape_2560x1440.png", "id": "1648517615520174", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210889_1648517618853507_2007437631331052425_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbkFZOMt0EIQ7kNvwFYs2Rd&_nc_oc=AdlGScr4Lhjh7vaCy1QpQnUjWDakVB3UsNxoOsa_o9izBjEjSc0AlPbpbj4aOpMBAeM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwUUeAELJ1rMiaIlRkK1rgdYHItMbLALSDrW8A-xFINIg&oe=69B1496D"}, "display_name": "Be Your Best - Football Training", "keywords": ["soccer", "football", "sports", "futbol", "training"], "long_description": "Step into the game with Be Your Best, the world\u2019s leading virtual reality football (soccer) training tool used by players at every level - from professionals to rising talents.\n\nExperience hundreds of real match scenarios recreated from top games around the world. On the virtual pitch, you\u2019ll take the role of a single player in realistic 11-a-side situations - scanning, making quick decisions, and improving your vision, awareness, and game intelligence.\nTrain like the pros do:\n\n \u2022 Scan the pitch and make the right passes under pressure\n \u2022 React to awareness challenges that sharpen your decision-making speed\n \u2022 Track your stats and progress over time\n\nThis is next-generation cognitive training. Perfect for players who want to:\n\n \u2022 Fit in extra training sessions at home\n \u2022 Stay sharp during injury recovery\n \u2022 Gain an edge before match day\n\nBe Your Best is a professional performance tool, not a game. Improvement comes from consistency, focus, and real training - just like on the pitch.", "short_description": "Step into the game with Be Your Best, the world\u2019s leading virtual reality football (soccer) training tool used by players at every level - from professionals to rising talents."}]}, "developer_name": "Be Your Best", "developer_privacy_policy_url": "https://www.beyourbest.com/privacy", "developer_terms_of_service_url": "https://www.beyourbest.com/terms", "publisher_name": "Be Your Best", "support_website_url": "https://www.beyourbest.com/contact", "website_url": "https://www.beyourbest.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25368277666097517"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001719_907859234815633_5412928493520085012_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBSMsIquESAQ7kNvwH6gKon&_nc_oc=AdnVAoDCOL4lXrPymOtvRr9PP8L-9kQYgncZ-rQCj6FdlUZTIJOEhqaBlO6go27RKT8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyeUwOQGgU640buvA1yvC2fcxjnkVjx0522XZu6QfY2kw&oe=69B14B78"}, "is_c
oculuscdn.com&oh=00_Afu0RUAsrv1bF_NWDrDSxuvMmXnKENERe-zWVTQrgM9NnQ&oe=699DA258"}, {"file_name": "10.png", "id": "1540499197282513", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821081_1540499200615846_5633955096765532476_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mpxhpPGh_nMQ7kNvwEeSSbV&_nc_oc=Adlyu9klxzEBPD_1M0ZTcK2yQzR8oV5a4r-ky7KTpKBjFxrfKAO7X892GtDxaEYmu9g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv08IUi-4QV75cQOVPeQ7pPbfcvYTfMWRtqfs8P9msdnw&oe=699DB47E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "byb_landscape_2560x1440.png", "id": "1648517615520174", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210889_1648517618853507_2007437631331052425_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Yq218fLBlsQ7kNvwGwWtJM&_nc_oc=AdnQnmYIaKL6116DYL1EQYqmv-Rp04CsPnLCE1f0_zDjxbaM4DRZ6IrV8km_VYABCCs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfslbdkngobV7A0hE3XypopMmKBJVqyPxTsQqvxdiMRnQg&oe=699D82ED"}, "display_name": "Be Your Best - Football Training", "keywords": ["soccer", "football", "sports", "futbol", "training"], "long_description": "Step into the game with Be Your Best, the world\u2019s leading virtual reality football (soccer) training tool used by players at every level - from professionals to rising talents.\n\nExperience hundreds of real match scenarios recreated from top games around the world. On the virtual pitch, you\u2019ll take the role of a single player in realistic 11-a-side situations - scanning, making quick decisions, and improving your vision, awareness, and game intelligence.\nTrain like the pros do:\n\n \u2022 Scan the pitch and make the right passes under pressure\n \u2022 React to awareness challenges that sharpen your decision-making speed\n \u2022 Track your stats and progress over time\n\nThis is next-generation cognitive training. Perfect for players who want to:\n\n \u2022 Fit in extra training sessions at home\n \u2022 Stay sharp during injury recovery\n \u2022 Gain an edge before match day\n\nBe Your Best is a professional performance tool, not a game. Improvement comes from consistency, focus, and real training - just like on the pitch.", "short_description": "Step into the game with Be Your Best, the world\u2019s leading virtual reality football (soccer) training tool used by players at every level - from professionals to rising talents."}]}, "developer_name": "Be Your Best", "developer_privacy_policy_url": "https://www.beyourbest.com/privacy", "developer_terms_of_service_url": "https://www.beyourbest.com/terms", "publisher_name": "Be Your Best", "support_website_url": "https://www.beyourbest.com/contact", "website_url": "https://www.beyourbest.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25368277666097517"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001719_907859234815633_5412928493520085012_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZA_dbZgHjIQ7kNvwGrcGMu&_nc_oc=AdlLDjtQG0KjXAkZEcHWj_WAPcFbSKKENmB6uXAQUGMi2S2WL4NgSdKeci1xhHcgmLI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs_u18IfOYnjPsMr1sAdzx_VXSqfkG6AvtQnUh-5cIYXQ&oe=699D84F8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Be Your Best - Football Training", 
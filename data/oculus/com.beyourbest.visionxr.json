tw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoe9e4JXqAKJtiVuiV_DGFOJbjwlCTZw4KN-QOLU4_rQ&oe=6A93FEB5"}, {"file_name": "2021_8_26_14_18_19_537.png", "id": "301405778616276", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031440_301405781949609_347936537591304936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-UtbKP1WPsQ7kNvwGtp76W&_nc_oc=AdrpA2YzOVKVAOJK4bhxMv13RyUfzEHdiIIvpgyL5MLtkAZz75k9GRHyA-c4sunG3Ds&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJlHVawDF6KEDuDQOoZZpN4VieFIOFGDuNZlKOIfD6wg&oe=6A93FC0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "byb_landscape_2560x1440.png", "id": "1648517615520174", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75210889_1648517618853507_2007437631331052425_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMJlyvKyrHwQ7kNvwEHn06h&_nc_oc=Adp_kDNUs95xTrQHYsCZ4yUQFyIcBkLKyysJYWTyj80wpT1DOwwF7miYBb-WSEo7zMU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpwRGKrp_jyXO1gC7j1cyTb7C0Jd8pEJHoQuyoeADosA&oe=6A940B6D"}, "display_name": "Be Your Best", "keywords": [], "long_description": "To gain an edge over your competition in football, it's essential to put in high-quality extra repetitions. Training that lets you replicate situations you meet on the field is key to maximizing your time and potential.\n\nWith Be Your Best, you can train perception & decision-making via real football match simulations, which is the same principle used for training airplane pilots, military personnel, and other high-performance professionals who need to react quickly and accurately to new information.", "short_description": "Build for professional footballers, Be Your Best provides a soccer training system based on real-world situations specially designed to improve the cognitive performance of players on and off the pitch. "}]}, "developer_name": "Be Your Best", "developer_privacy_policy_url": "https://www.beyourbest.com/privacy", "devel
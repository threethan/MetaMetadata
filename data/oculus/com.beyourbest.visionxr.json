SQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmZUMRc48NeJmc0rChowWu922lTx1KmpQAzQWp6bhAqg&oe=6AAD4375"}, {"file_name": "2021_8_26_14_18_19_537.png", "id": "301405778616276", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031440_301405781949609_347936537591304936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3Wa7QCe1MMQ7kNvwEkYkLn&_nc_oc=Adrw7MCPhHHlkuqqJJN7PgCQejUqP-uttulXYkVsiuiueERjD9_RmhrwpSK0u_eklYM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_3RCD0h2F8WBEf7XNvuewNP1n2qqaOD4fugQs_fWWFw&oe=6AAD40CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "byb_landscape_2560x1440.png", "id": "1648517615520174", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210889_1648517618853507_2007437631331052425_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UtIxJ1LjbycQ7kNvwFelnI5&_nc_oc=Adp67A1e8zAU7Jy9ciyjwle8j779lzIIiAStyE5vpmbnZj9B-m9HsYq6hcAXfeXIIso&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLT7dNlNLDzzNji7kz17MLWAcbgH-5I2e7feI2Z3JlZKQ&oe=6AAD502D"}, "display_name": "Be Your Best", "keywords": [], "long_description": "To gain an edge over your competition in football, it's essential to put in high-quality extra repetitions. Training that lets you replicate situations you meet on the field is key to maximizing your time and potential.\n\nWith Be Your Best, you can train perception & decision-making via real football match simulations, which is the same principle used for training airplane pilots, military personnel, and other high-performance professionals who need to react quickly and accurately to new information.", "short_description": "Build for professional footballers, Be Your Best provides a soccer training system based on real-world situations specially designed to improve the cognitive performance of players on and off the pitch. "}]}, "developer_name": "Be Your Best", "developer_privacy_policy_url": "https://www.beyourbest.com/privacy", "developer_terms_of_service_url": "https://www.beyourbest.com/terms", "publisher_name": "Be Your Best", "support_website_url": "https://www.beyourbest.com/contact", "website_url": "https://www.beyourbest.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "487888099456928"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1184296290376655"}, {"status": "PUBLISHED", "id": "666454971168314"}]}, "baseline_offer": {"id": "1184296290376655"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1747215060, "status": "PUBLISHED", "id": "1184296290376655"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28858085337116715", "version": "2.18.7"}, "id": "4474300072680174", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5105468496138399", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28858085337116715"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4474300072680174"}]}, "change_log": "\ufffd Training Focus, Streamlined Experience & New Audio!\r\n\r\nThis update is designed to help you pinpoint your growth areas, get through training faster, and keep your energy high with a fresh look and sound. Find a bite-sized summary below, followed by more in-depth details.\r\n\r\n\ufffd The Quick Summary\r\n\r\n\r\n\r\n\r\n\r\nTargeted Growth: Introduced \"Training Focus\" mode to help you identify which metric needs improvement.\r\n\r\n\r\n\r\nFaster Bootcamp: Updated the Bootcamp onboarding flow for better clarity and quicker completion times.\r\n\r\n\r\n\r\nRedesigned Activity Page: A cleaner, clearer layout to help you search and review past training sessions effortlessly.\r\n\r\n\r\n\r\nNew App Music: Pumped up the soundtrack with a higher-energy vibe to keep you locked in.\r\n\r\n\r\n\r\nPositive Feedback Model: Removed negative in-game feedback like \"weak pass\" or \"okay pass\" for low-scoring decisions.\r\n\r\n\ufffd In-Depth: Training Focus Mode\r\n\r\nWant to know exactly where to direct your effort next? The new Training Focus mode analyzes your performance to highlight the specific cognitive metric you should concentrate on improving. Use this feature to target your weaknesses, turn them into strengths, and elevate your overall game faster.\r\n\r\n\ufffd In-Depth: Onboarding & Activity Page Redesign\r\n\r\n\r\n\r\n\r\n\r\nStreamlined Bootcamp Flow: We\u2019ve overhauled the Bootcamp to increase instructions clarity while reducing the time it takes to finish. Get through the basics faster so you can jump straight into the pitch action.\r\n\r\n\r\n\r\nClearer Activity History: Your training history got a major visual upgrade! The newly designed Activity Page makes it simpler than ever to navigate your history and locate a specific session.\r\n\r\n\ufffd In-Depth: Audio & Feedback Enhancements\r\n\r\n\r\n\r\n\r\n\r\nUpgraded Soundtrack: Enjoy brand-new, energetic background music designed to keep your focus sharp and your motivation high throughout the app.\r\n\r\n\r\n\r\nConstructive In-Game Feedback: We are focusing on constructive growth! We have removed negative descriptors like \"weak pass\" or \"okay pass\" during sessions, ensuring your feedback remains focused on performance metrics without discouraging labels.", "created_date": 1788943442, "id": "28858085337116715", "version": "2.18.7", "version_code": 113, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5105468496138399", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28858085337116715"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4474300072680174"}]}, "change_log": null, "created_date": 1786510580, "id": "28491471747111411", "version": "2.18.6", "version_code": 111, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5105468496138399", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28858085337116715"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4474300072680174"}]}, "change_log": null, "created_date": 1784880223, "id": "28262840449974543", "version": "2.18.5", "version_code": 110, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5105468496138399", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28858085337116715"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4474300072680174"}]}, "change_log": "\ufffd Update 2.18.4\n\nThis minor update brings some international tournament flair to your dressing room along with a few quality-of-life performance improvements.\n\n\ufffd What\u2019s New\n\n\u2022 World Cup Dressing Room Theme: Get into the tournament spirit! We\u2019ve added a brand-new World Cup theme to the dressing room experience.\n\n\u2022 Snappier Loading Times: We\u2019ve optimized performance behind the scenes to improve loading speeds for both Results and Replays.", "created_date": 1781177438, "id": "27760540740204519", "version": "2.18.4", "version_code": 109, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5105468496138399", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28858085337116715"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4474300072680174"}]}, "change_log": "Patch release that fixed missing Critical Scan results after some sessions.", "created_date": 1778068152, "id": "27295661006692497", "version": "2.18.3", "version_code": 108, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
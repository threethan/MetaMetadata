NQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8eHzu5iOcGrqhTI3dyGtmPC-4NI25eHqupFFIUX1JPA&oe=6A9C1FF5"}, {"file_name": "2021_8_26_14_18_19_537.png", "id": "301405778616276", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031440_301405781949609_347936537591304936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szojQ0L5MC4Q7kNvwEpQPpN&_nc_oc=Adqcs39KfV1n0HwtgE0kpKkbCgwFQTwjzfFEHolt39Qajj_9HT8a-5qMTab6ei4N7uA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9i7zC1fIrHQqRm-ox0BHh5Nj4RAyehlhuY8zO8XjxqQ&oe=6A9C1D4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "byb_landscape_2560x1440.png", "id": "1648517615520174", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210889_1648517618853507_2007437631331052425_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uq_XFFpe244Q7kNvwEWfNRO&_nc_oc=AdoEU3Pa_p1vJ7-WhtdAAxWyhb8p2ygD6SkOMxe4cJ6gzQAYItqAFjk2oVd1BAEIJjM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYd93MfTCRwXcBdGrJXjfMEHllto8GNmas5HDOzSol_g&oe=6A9C2CAD"}, "display_name": "Be Your Best", "keywords": [], "long_description": "To gain an edge over your competition in football, it's essential to put in high-quality extra repetitions. Training that lets you replicate situations you meet on the field is key to maximizing your time and potential.\n\nWith Be Your Best, you can train perception & decision-making via real football match simulations, which is the same principle used for training airplane pilots, military personnel, and other high-performance professionals who need to react quickly and accurately to new information.", "short_description": "Build for professional footballers, Be Your Best provides a soccer training system based on real-world situations specially designed to improve the cognitive performance of players on and off the pitch. "}]}, "developer_name": "Be Your Best", "developer_privacy_policy_url": "https://www.beyourbest.com/privacy", "devel
oculuscdn.com&oh=00_AftPRf8ca3CPMA0Yl4LYSHKX-rK1B_ALFms65TeNi11dgw&oe=699AFF58"}, {"file_name": "10.png", "id": "1540499197282513", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821081_1540499200615846_5633955096765532476_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pSz7_dwUC-4Q7kNvwE8eNe1&_nc_oc=Adlu13g7tXdkOyE591WH4fPFwIMXs1W_7fuHpSSt6HAMj5ixuL-qMq0qEjsBBwhH3GM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsknSa1phMA-LePHkUO2-UirH_exx6E4e84pAZlXwJpSg&oe=699B117E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "byb_landscape_2560x1440.png", "id": "1648517615520174", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210889_1648517618853507_2007437631331052425_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Yq218fLBlsQ7kNvwEROUx0&_nc_oc=AdljezEMYxBpooveuDOfzTCUBqfsOYeFpwwTZwLjgnBzoN98XSZ0w5iLNgEprCSEYfo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftVXYVKAuBgBZ9ZLU2N-6uKo5vhY_GL53Tygb8WSyr-kw&oe=699ADFED"}, "display_name": "Be Your Best - Football Training", "keywords": ["soccer", "football", "sports", "futbol", "training"], "long_description": "Step into the game with Be Your Best, the world\u2019s leading virtual reality football (soccer) training tool used by players at every level - from professionals to rising talents.\n\nExperience hundreds of real match scenarios recreated from top games around the world. On the virtual pitch, you\u2019ll take the role of a single player in realistic 11-a-side situations - scanning, making quick decisions, and improving your vision, awareness, and game intelligence.\nTrain like the pros do:\n\n \u2022 Scan the pitch and make the right passes under pressure\n \u2022 React to awareness challenges that sharpen your decision-making speed\n \u2022 Track your stats and progress over time\n\nThis is next-generation cognitive training. Perfect for players who want to:\n\n \u2022 Fit in extra training sessions at home\n \u2022 Stay sharp during injury recovery\n \u2022 Gain an edge before match day\n\nBe Your Best is a professional performance tool, not a game. Improvement comes from consistency, focus, and real training - just like on the pitch.", "short_description": "Step into the game with Be Your Best, the world\u2019s leading virtual reality football (soccer) training tool used by players at every level - from professionals to rising talents."}]}, "developer_name": "Be Your Best", "developer_privacy_policy_url": "https://www.beyourbest.com/privacy", "developer_terms_of_service_url": "https://www.beyourbest.com/terms", "publisher_name": "Be Your Best", "support_website_url": "https://www.beyourbest.com/contact", "website_url": "https://www.beyourbest.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25368277666097517"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001719_907859234815633_5412928493520085012_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wYSk6lyuwUQ7kNvwENzWZS&_nc_oc=Adn5FdSfaggZq3AqAP9EdDyaxNp70eZZ-5K2emBsitawO8yv_4tnoTnKWU4nYk7ADog&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsoHDiyCe9alRMwlkBBUIP5x6r9wo4z33PGcz0FxbfnKg&oe=699AE1F8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Be Your Best - Football Training", 
KOIL&_nc_oc=Adopzj6ADWibToCSdYGIn5LGGN3sb9kTmGQcNYFHJSl14pBdJQsP7zdiattPpgqJ61s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58_k19YBvC0tcSUR1LyH2urdFjNd3g7edMANZF-5NBVQ&oe=6A0C663C"}, {"file_name": "screenshot2.png", "id": "670327675055236", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035434_670327678388569_1821984589435737113_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzTQ9d61oYQQ7kNvwF-m7Sj&_nc_oc=Ado6DExkIFPNS-GHR_NK2S16YkMgl9Y_pBSJEgED5Raiwu8YGqJ_nFEzpmWSyelYei4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OSVdERx0v4nwaaHwftWlrFE68UOuUR4NFaFtFFJWtSA&oe=6A0C6C92"}, {"file_name": "screenshot4.png", "id": "6408837845912667", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57568669_6408837855912666_6537066644795707454_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UICpTLhfxx8Q7kNvwE780SD&_nc_oc=AdoF7lOiiREfSCEz66Ri_hL1dZ35H58Py7ZiPF9LF_pRlQCtDelnHG9U6gLO2npNnvk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xEGPrd1OqJapKlSx_TJaTr81cYDh4S1QEGz8xwCmmyw&oe=6A0C559E"}, {"file_name": "screenshot6.png", "id": "3606552606259922", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982686_3606552609593255_7282817138265599561_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vG3H91_1DMQQ7kNvwGNZJMf&_nc_oc=AdrmyWpiDQioQwFtM5h5i5QVuru7YjGsxVB7bGGYFzWqKu9eDjZ8mkO9VZVWNsgrOWc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tPjgysNl5NRIDpl9qCFiKHHYjA74EBt3yhb4BElvD1w&oe=6A0C53C0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Intakegesprek 2.0", "keywords": [], "long_description": "Oefen met gespreksvaardigheden zoals luisteren, samenvatten en doorvragen. In een realistisch virtueel rollenspel ga je in gesprek met Max, een cli\u00ebnt van een gezondheidscentrum. Het doel van het intakegesprek is Max beter te leren kennen en zicht krijgen op zijn hulpvraag. Dit lukt alleen goed als je verbinding maakt, bijvoorbeeld door hem op gemak te stellen, interesse te tonen en emphatisch te reageren. De uitkomst van het gesprek is afhankelijk van hoe goed je de gespreksvaardigheden toepast. Is het niet direct gelukt om Max te laten vertellen wat hem echt bezig houdt? Geen nood, na elk gesprek krijg je feedback en tips die je kunt toepassen in de de volgende ronde. \n\nDeze unieke gespreksimulatie maakt gebruik van vrije spraak waardoor het initiatief in het gesprek bij jou ligt. Door de realistische omgeving en virtuele gesprekspartner wordt je helemaal ondergedompeld in de situatie. Met de ingebouwde feedback en intelligente begeleiding krijg je jouw gespreksvaardigheden op een hoger niveau.", "short_description": "Oefenen gespreksvaardigheden in een intakegesprek met een cli\u00ebnt van een gezondheidscentrum."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cdn.jutten.com/docs/Privacyverklaring_The_Simulation_Crew_1.1.pdf", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew BV", "support_website_url": "https://thesimulationcrew.com/contact/", "website_url": "https://thesimulationcrew.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "27362927396627898"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7992889037397266"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1450534966366812"}, {"status": "PUBLISHED", "id": "2705428416277358"}]}, "baseline_offer": {"id": "1450534966366812"}, 
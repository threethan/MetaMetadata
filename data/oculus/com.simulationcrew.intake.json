s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR87bcgr-lec7MPf-Vi7eHGNYbzblarzF9_UvMfLIGbog&oe=6B05B508"}, {"file_name": "screenshot3.png", "id": "271912528502924", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974869_271912531836257_6438876834576636323_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFQFtXfdkKAQ7kNvwFJ_OMp&_nc_oc=AdoYzXPCfRP_fNSFKeJ5-nn4biSMqAQSpe5I82Ecv28AjW9vX23aKuViwFuqVw7O20Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3GlPhCCui6ZZckUK2dXFYgtG5J1Hcu7x9nYdTGS425w&oe=6B05C9FC"}, {"file_name": "screenshot2.png", "id": "670327675055236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035434_670327678388569_1821984589435737113_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2bcQ5JdFY0Q7kNvwHu1hqo&_nc_oc=AdoNk_o9pyyV9AdesNvmXE-X_ylsX7ZbNNXhqx9HBALHOdex2BipRlPyZKOD_bh_ku0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoTPc8nRYohrS1TLlmS_oeqYsRYj5WwPrGkalFfUXyvQ&oe=6B05D052"}, {"file_name": "screenshot4.png", "id": "6408837845912667", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568669_6408837855912666_6537066644795707454_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uk4sbYk4tY8Q7kNvwHNgKVH&_nc_oc=AdouTWlRNYRV7JDpOJyAdS6GJ94OEb4_ya9_2DpUnj748lwVSjQ1KZ1tsd0GD0LJdl0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8AN4kgnQ4U8CtaExAAtQXDafCknke1B_dBAQ57vJnLA&oe=6B05B95E"}, {"file_name": "screenshot6.png", "id": "3606552606259922", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982686_3606552609593255_7282817138265599561_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85a4s2-QIlUQ7kNvwEITrml&_nc_oc=AdpIsCnpWsAdx5JUv0UPBIPSGX0EYPfYL4cc0CUaVdBm_5swvMBGy7CPrAUDZ4MPBu0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSV4kezI07G-WRERmTdRlXDtgVPbEbmOYn1DjBwX8FTw&oe=6B05B780"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Intakegesprek 2.0", "keywords": [], "long_description": "Oefen met gespreksvaardigheden zoals luisteren, samenvatten en doorvragen. In een realistisch virtueel rollenspel ga je in gesprek met Max, een cli\u00ebnt van een gezondheidscentrum. Het doel van het intakegesprek is Max beter te leren kennen en zicht krijgen op zijn hulpvraag. Dit lukt alleen goed als je verbinding maakt, bijvoorbeeld door hem op gemak te stellen, interesse te tonen en emphatisch te reageren. De uitkomst van het gesprek is afhankelijk van hoe goed je de gespreksvaardigheden toepast. Is het niet direct gelukt om Max te laten vertellen wat hem echt bezig houdt? Geen nood, na elk gesprek krijg je feedback en tips die je kunt toepassen in de de volgende ronde. \n\nDeze unieke gespreksimulatie maakt gebruik van vrije spraak waardoor het initiatief in het gesprek bij jou ligt. Door de realistische omgeving en virtuele gesprekspartner wordt je helemaal ondergedompeld in de situatie. Met de ingebouwde feedback en intelligente begeleiding krijg je jouw gespreksvaardigheden op een hoger niveau.", "short_description": "Oefenen gespreksvaardigheden in een intakegesprek met een cli\u00ebnt van een gezondheidscentrum."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cdn.jutten.com/docs/Privacyverklaring_The_Simulation_Crew_1.1.pdf", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew BV", "support_website_url": "https://thesimulationcrew.com/contact/", "website_url": "https://thesimulationcrew.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "27362927396627898"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_
hot2.png", "id": "670327675055236", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035434_670327678388569_1821984589435737113_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YdaLUC4BXYQ7kNvwF1TS_T&_nc_oc=AdoK-9C5qCOn8y6tJSeeCWoyCbV1YNi58H-TQYJImqDz1NRXzd4Kd-Hadpd39aAC1hg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af29kJI1YEnKEkGaQENUXrstfHyErXvIN-_8JIXd4cd3rQ&oe=69F20E92"}, {"file_name": "screenshot4.png", "id": "6408837845912667", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57568669_6408837855912666_6537066644795707454_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4dDnj7kdAoQ7kNvwFmJqTI&_nc_oc=AdrLLTHjpVIq_URjMtwIH4P9qXbDedVnrAMKOBRyvPYqBDTQZXarWO0HzrGld_5eyEk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3y1FfJRt-tVGhkq5yRKuekDAH1e1e43HVhuxOuZR02Vw&oe=69F1F79E"}, {"file_name": "screenshot6.png", "id": "3606552606259922", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982686_3606552609593255_7282817138265599561_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUq6BC1hVrIQ7kNvwEnk-ed&_nc_oc=AdrDwaRefRSmk6C7A7BUABU6AZViraBFAmD5kmH6qZ5kznuoNHoLTCPu75majMBrpU4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Fx4iTTYfBFc3HACO4cjWITo9TJM_4P6ikHRAvVh8aag&oe=69F1F5C0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Intakegesprek 2.0", "keywords": [], "long_description": "Oefen met gespreksvaardigheden zoals luisteren, samenvatten en doorvragen. In een realistisch virtueel rollenspel ga je in gesprek met Max, een cli\u00ebnt van een gezondheidscentrum. Het doel van het intakegesprek is Max beter te leren kennen en zicht krijgen op zijn hulpvraag. Dit lukt alleen goed als je verbinding maakt, bijvoorbeeld door hem op gemak te stellen, interesse te tonen en emphatisch te reageren. De uitkomst van het gesprek is afhankelijk van hoe goed je de gespreksvaardigheden toepast. Is het niet direct gelukt om Max te laten vertellen wat hem echt bezig houdt? Geen nood, na elk gesprek krijg je feedback en tips die je kunt toepassen in de de volgende ronde. \n\nDeze unieke gespreksimulatie maakt gebruik van vrije spraak waardoor het initiatief in het gesprek bij jou ligt. Door de realistische omgeving en virtuele gesprekspartner wordt je helemaal ondergedompeld in de situatie. Met de ingebouwde feedback en intelligente begeleiding krijg je jouw gespreksvaardigheden op een hoger niveau.", "short_description": "Oefenen gespreksvaardigheden in een intakegesprek met een cli\u00ebnt van een gezondheidscentrum."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cdn.jutten.com/docs/Privacyverklaring_The_Simulation_Crew_1.1.pdf", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew BV", "support_website_url": "https://thesimulationcrew.com/contact/", "website_url": "https://thesimulationcrew.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "27362927396627898"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7992889037397266"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1450534966366812"}, {"status": "PUBLISHED", "id": "2705428416277358"}]}, "baseline_offer": {"id": "1450534966366812"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1751900160, "status": "PUBLISHED", "id": "1450534966366812"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes"
Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIyfKwzeo53LKpIxcs4qmg6xI5KaLXJhplway3jyBVqg&oe=6B046388"}, {"file_name": "screenshot3.png", "id": "271912528502924", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974869_271912531836257_6438876834576636323_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFQFtXfdkKAQ7kNvwEhF6pI&_nc_oc=AdoZ7DRW0NZhSDG7DRZ3OXSRvX0Wr7n7KQ6WtkYqVm1eSJNnL1i2Oq-DqBnmU2N6QSM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVmav3jCv1MWZt_SvF6DqtV3Tz8G6O7HAEZ3ycX7qstw&oe=6B04787C"}, {"file_name": "screenshot2.png", "id": "670327675055236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035434_670327678388569_1821984589435737113_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2bcQ5JdFY0Q7kNvwFKdXNX&_nc_oc=Adrcg-jTn91LWjaItBI1mJIs4PViw5JiFc9UR3xVIC-oLJTt01JdCelU9GccGYeTuJ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmo4bqB5rCidZj2WUf2KRVMzBsHLj_GE1wxxu1-c78Fw&oe=6B047ED2"}, {"file_name": "screenshot4.png", "id": "6408837845912667", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568669_6408837855912666_6537066644795707454_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ojzG0U6iKkQ7kNvwHJrzKc&_nc_oc=AdreeKvwvksoSIR-PoFW1ipL1y1J1QxBsWScXmKlxIi0qopAImmZBmAn8On-W1hVX6U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRf7-CkZRWnoowR3zYfDI2qJYA83GCIG9CfRzhnJJCG8A&oe=6B0467DE"}, {"file_name": "screenshot6.png", "id": "3606552606259922", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982686_3606552609593255_7282817138265599561_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iab9NkKJxwIQ7kNvwFi7dG1&_nc_oc=AdpHb2fHkaRTa9ofJtX_sCwFGre9oVe6OxaZNG2yfjov0dJMjeZxIfbyZ6yVEhXvnpQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5ceHQ60uxGkC3GU500j4vPyw8d5jeeAR4BEq1Hdwxlg&oe=6B046600"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Intakegesprek 2.0", "keywords": [], "long_description": "Oefen met gespreksvaardigheden zoals luisteren, samenvatten en doorvragen. In een realistisch virtueel rollenspel ga je in gesprek met Max, een cli\u00ebnt van een gezondheidscentrum. Het doel van het intakegesprek is Max beter te leren kennen en zicht krijgen op zijn hulpvraag. Dit lukt alleen goed als je verbinding maakt, bijvoorbeeld door hem op gemak te stellen, interesse te tonen en emphatisch te reageren. De uitkomst van het gesprek is afhankelijk van hoe goed je de gespreksvaardigheden toepast. Is het niet direct gelukt om Max te laten vertellen wat hem echt bezig houdt? Geen nood, na elk gesprek krijg je feedback en tips die je kunt toepassen in de de volgende ronde. \n\nDeze unieke gespreksimulatie maakt gebruik van vrije spraak waardoor het initiatief in het gesprek bij jou ligt. Door de realistische omgeving en virtuele gesprekspartner wordt je helemaal ondergedompeld in de situatie. Met de ingebouwde feedback en intelligente begeleiding krijg je jouw gespreksvaardigheden op een hoger niveau.", "short_description": "Oefenen gespreksvaardigheden in een intakegesprek met een cli\u00ebnt van een gezondheidscentrum."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cdn.jutten.com/docs/Privacyverklaring_The_Simulation_Crew_1.1.pdf", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew BV", "support_website_url": "https://thesimulationcrew.com/contact/", "website_url": "https://thesimulationcrew.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "27362927396627898"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_
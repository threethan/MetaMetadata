J4ol&_nc_oc=AdriouNhJ-7B-_sA4r2kRNolQU2G3hOzlSBQ07FGsHTTQ6ViOb5HPzvPf3GWxs6P_70&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57xOicVl0oVdtECbd7HNuDMDeuWPbElLvCCSibzdjtlA&oe=6A1C383C"}, {"file_name": "screenshot2.png", "id": "670327675055236", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035434_670327678388569_1821984589435737113_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWlT9egu_MYQ7kNvwF9XeEC&_nc_oc=AdqFb38oyvHbzzhNezdav2Sx6YtfJh4w3oKqTG8JcVHumRbQbOgRne1DwZ-38sFm5K4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fCnJfKW7UAqhFkvT6Cnv4S4FZagVqh88tLfsgc5O1BQ&oe=6A1C3E92"}, {"file_name": "screenshot4.png", "id": "6408837845912667", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57568669_6408837855912666_6537066644795707454_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrKDb0eKvgYQ7kNvwFe5Tzl&_nc_oc=AdpSIA02Uo7AAn4YeTln4uWVZzl4M9fJ7MTjA9xbJ-F8QDQaHkAZ8zkp1l0ECelB1gc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DnlZRhRYYNmncnEsz-dAYeZHesYkLlQJuykbDDUC9Mg&oe=6A1C5FDE"}, {"file_name": "screenshot6.png", "id": "3606552606259922", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982686_3606552609593255_7282817138265599561_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4U5Ttk1wtkQ7kNvwFJvCji&_nc_oc=Ado_2-H9OekhKsStsdZg3ZdqZLJ_Qxhdl1Kk-YAbX3uA8Kpo0zS8mMgcirNIUzTjoGY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5q066LKWQipOdTNw1ryfu_xLiPdqARDhehyOpfzjxOeQ&oe=6A1C5E00"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Intakegesprek 2.0", "keywords": [], "long_description": "Oefen met gespreksvaardigheden zoals luisteren, samenvatten en doorvragen. In een realistisch virtueel rollenspel ga je in gesprek met Max, een cli\u00ebnt van een gezondheidscentrum. Het doel van het intakegesprek is Max beter te leren kennen en zicht krijgen op zijn hulpvraag. Dit lukt alleen goed als je verbinding maakt, bijvoorbeeld door hem op gemak te stellen, interesse te tonen en emphatisch te reageren. De uitkomst van het gesprek is afhankelijk van hoe goed je de gespreksvaardigheden toepast. Is het niet direct gelukt om Max te laten vertellen wat hem echt bezig houdt? Geen nood, na elk gesprek krijg je feedback en tips die je kunt toepassen in de de volgende ronde. \n\nDeze unieke gespreksimulatie maakt gebruik van vrije spraak waardoor het initiatief in het gesprek bij jou ligt. Door de realistische omgeving en virtuele gesprekspartner wordt je helemaal ondergedompeld in de situatie. Met de ingebouwde feedback en intelligente begeleiding krijg je jouw gespreksvaardigheden op een hoger niveau.", "short_description": "Oefenen gespreksvaardigheden in een intakegesprek met een cli\u00ebnt van een gezondheidscentrum."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cdn.jutten.com/docs/Privacyverklaring_The_Simulation_Crew_1.1.pdf", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew BV", "support_website_url": "https://thesimulationcrew.com/contact/", "website_url": "https://thesimulationcrew.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "27362927396627898"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7992889037397266"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1450534966366812"}, {"status": "PUBLISHED", "id": "2705428416277358"}]}, "baseline_offer": {"id": "1450534966366812"}, 
2sGL&_nc_oc=AdrdunZyyvOUB-Gyqth-YCRmRmPLrG_o4QrayaXELLLNLUqTrmamOCI2HUUO3aMGJlo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xuIDiCa_DNKJjAr8YI5tlPw7iggxjV0VwOZMSpalaXg&oe=6A1D89BC"}, {"file_name": "screenshot2.png", "id": "670327675055236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035434_670327678388569_1821984589435737113_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWlT9egu_MYQ7kNvwFTxg4R&_nc_oc=Adqqmi94MnNe26SgDygg085K_U-vYCukb5qSzZHg27VF1W0S9X9P14ctbqUDhxkLc5M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YwLrxXj0OIbL2wY2uys9wU2GxObl6Zf3vgIQg_Jo-Qw&oe=6A1D9012"}, {"file_name": "screenshot4.png", "id": "6408837845912667", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568669_6408837855912666_6537066644795707454_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrKDb0eKvgYQ7kNvwHF2ysO&_nc_oc=Adpr1Q16nHKGTxeVrfN8zKbKfK8M2jNV7TIZz0CgllVNyDtEgpwaGtzf_zAmddJfQ3M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KjtJ_m8PXX5owN-MNUCuTyrkLpzA_HTbPG4VAgcipUA&oe=6A1D791E"}, {"file_name": "screenshot6.png", "id": "3606552606259922", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982686_3606552609593255_7282817138265599561_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4U5Ttk1wtkQ7kNvwEROwNN&_nc_oc=Adoay6uC7pE8zcKO6W0vm1kWOUWdapIeCcYUU9OW-VboyfSrFH2D_QvbhGoToYYziU4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vkeNlkwPZiL8518VAiZVSsO697xjs9EpUrK0dToUvbQ&oe=6A1D7740"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Intakegesprek 2.0", "keywords": [], "long_description": "Oefen met gespreksvaardigheden zoals luisteren, samenvatten en doorvragen. In een realistisch virtueel rollenspel ga je in gesprek met Max, een cli\u00ebnt van een gezondheidscentrum. Het doel van het intakegesprek is Max beter te leren kennen en zicht krijgen op zijn hulpvraag. Dit lukt alleen goed als je verbinding maakt, bijvoorbeeld door hem op gemak te stellen, interesse te tonen en emphatisch te reageren. De uitkomst van het gesprek is afhankelijk van hoe goed je de gespreksvaardigheden toepast. Is het niet direct gelukt om Max te laten vertellen wat hem echt bezig houdt? Geen nood, na elk gesprek krijg je feedback en tips die je kunt toepassen in de de volgende ronde. \n\nDeze unieke gespreksimulatie maakt gebruik van vrije spraak waardoor het initiatief in het gesprek bij jou ligt. Door de realistische omgeving en virtuele gesprekspartner wordt je helemaal ondergedompeld in de situatie. Met de ingebouwde feedback en intelligente begeleiding krijg je jouw gespreksvaardigheden op een hoger niveau.", "short_description": "Oefenen gespreksvaardigheden in een intakegesprek met een cli\u00ebnt van een gezondheidscentrum."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cdn.jutten.com/docs/Privacyverklaring_The_Simulation_Crew_1.1.pdf", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew BV", "support_website_url": "https://thesimulationcrew.com/contact/", "website_url": "https://thesimulationcrew.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "27362927396627898"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7992889037397266"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1450534966366812"}, {"status": "PUBLISHED", "id": "2705428416277358"}]}, "baseline_offer": {"id": "1450534966366812"}, 
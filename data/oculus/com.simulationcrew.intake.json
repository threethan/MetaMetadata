kP27&_nc_oc=AdqanFA9zAPaypC1a2Pq04XTy8j-yaJgbhkWf0iREqppliCFolUco5fOfw0YZEnTPHk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bin5yNvAnGIIvyMO71Y6E_lZMDf-HV7tf39oyA5aRMA&oe=6A2FFEBC"}, {"file_name": "screenshot2.png", "id": "670327675055236", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035434_670327678388569_1821984589435737113_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qF79dHrPUHgQ7kNvwGDwmzO&_nc_oc=AdqsevwbF8CS1y7_9zMDUojDzLhqaF3MFKxa-ZsnQvrSTDF5sNGEruSNlhYRsrwWc9k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ubVUS-YdVZymEQLjNchSPf_VxWMvJOWUxPDKXJH4fWw&oe=6A300512"}, {"file_name": "screenshot4.png", "id": "6408837845912667", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57568669_6408837855912666_6537066644795707454_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-nIjoDY-yi4Q7kNvwExb2KW&_nc_oc=AdqEBm7FYssSFgzKWnkLjN_WzHktVT8F0dCfQ0mmsSApurXouGkvG_UaSuTgnn4Zhs4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-um8UphwZS7bMTDIePibBsZ8Q8nMEpLYxFddM_S8Yj_g&oe=6A30265E"}, {"file_name": "screenshot6.png", "id": "3606552606259922", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982686_3606552609593255_7282817138265599561_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZHZBEnPWFYQ7kNvwHgjr0r&_nc_oc=AdrXJ4R3YBJcVCuxLUwaLClKwaGGDbcSMqTYlUyCJmYkK5GpTcEOP3t7waqdYNQvYjA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mUnFqSqtWz4XwhwjeZdyxOyQMxdaMjphDAGv41pZqJQ&oe=6A302480"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Intakegesprek 2.0", "keywords": [], "long_description": "Oefen met gespreksvaardigheden zoals luisteren, samenvatten en doorvragen. In een realistisch virtueel rollenspel ga je in gesprek met Max, een cli\u00ebnt van een gezondheidscentrum. Het doel van het intakegesprek is Max beter te leren kennen en zicht krijgen op zijn hulpvraag. Dit lukt alleen goed als je verbinding maakt, bijvoorbeeld door hem op gemak te stellen, interesse te tonen en emphatisch te reageren. De uitkomst van het gesprek is afhankelijk van hoe goed je de gespreksvaardigheden toepast. Is het niet direct gelukt om Max te laten vertellen wat hem echt bezig houdt? Geen nood, na elk gesprek krijg je feedback en tips die je kunt toepassen in de de volgende ronde. \n\nDeze unieke gespreksimulatie maakt gebruik van vrije spraak waardoor het initiatief in het gesprek bij jou ligt. Door de realistische omgeving en virtuele gesprekspartner wordt je helemaal ondergedompeld in de situatie. Met de ingebouwde feedback en intelligente begeleiding krijg je jouw gespreksvaardigheden op een hoger niveau.", "short_description": "Oefenen gespreksvaardigheden in een intakegesprek met een cli\u00ebnt van een gezondheidscentrum."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cdn.jutten.com/docs/Privacyverklaring_The_Simulation_Crew_1.1.pdf", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew BV", "support_website_url": "https://thesimulationcrew.com/contact/", "website_url": "https://thesimulationcrew.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "27362927396627898"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7992889037397266"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1450534966366812"}, {"status": "PUBLISHED", "id": "2705428416277358"}]}, "baseline_offer": {"id": "1450534966366812"}, 
QAe6&_nc_oc=AdoKnGKX_leyEqnqWuny3yqD_XoT4nYH9dAi6BThC7Te0oLgiRi1Z82KNrC7QPH1buY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAT05oV9YWoFscTj9FyS4QFtwtYIOa5_r_abqIfihsj9g&oe=6A4A5CBC"}, {"file_name": "screenshot2.png", "id": "670327675055236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035434_670327678388569_1821984589435737113_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sVhhiZrL3oQ7kNvwG3y9WP&_nc_oc=AdrGhEGWcygyd0TZP7Irxv-s3JGdQ4FTh_bs72nD2x92URVRhPKuuaEa2diSmzU1pdg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBT1cp5WoPbzwLdwGTfji4Qm_nqZUoYqAkE9e1j09HyHA&oe=6A4A6312"}, {"file_name": "screenshot4.png", "id": "6408837845912667", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568669_6408837855912666_6537066644795707454_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8vVrIK4feAQ7kNvwGg44N6&_nc_oc=AdqVjOLqT0xXReCQOGQYut-mVUfJq64SqAFrkkymE66FrjfX2XztW34jBA95og7fZLA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-Pz4RXkk7vHnXy6pHRpGjvf6kIrUV19CE9ao5vSwYVg&oe=6A4A845E"}, {"file_name": "screenshot6.png", "id": "3606552606259922", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982686_3606552609593255_7282817138265599561_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxwyXU5AvnQQ7kNvwGJX_wX&_nc_oc=AdpLpJdLj2vTdqr_zx3DH8r8c_mD0IAK3SZw4dFE1EPxsx22VWryMxeiDdl6IzLNkx8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-MwWJkc79o4eqMOM7_ZfgDXaPqvGgFUa3X2mm8wt-1Q&oe=6A4A8280"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Intakegesprek 2.0", "keywords": [], "long_description": "Oefen met gespreksvaardigheden zoals luisteren, samenvatten en doorvragen. In een realistisch virtueel rollenspel ga je in gesprek met Max, een cli\u00ebnt van een gezondheidscentrum. Het doel van het intakegesprek is Max beter te leren kennen en zicht krijgen op zijn hulpvraag. Dit lukt alleen goed als je verbinding maakt, bijvoorbeeld door hem op gemak te stellen, interesse te tonen en emphatisch te reageren. De uitkomst van het gesprek is afhankelijk van hoe goed je de gespreksvaardigheden toepast. Is het niet direct gelukt om Max te laten vertellen wat hem echt bezig houdt? Geen nood, na elk gesprek krijg je feedback en tips die je kunt toepassen in de de volgende ronde. \n\nDeze unieke gespreksimulatie maakt gebruik van vrije spraak waardoor het initiatief in het gesprek bij jou ligt. Door de realistische omgeving en virtuele gesprekspartner wordt je helemaal ondergedompeld in de situatie. Met de ingebouwde feedback en intelligente begeleiding krijg je jouw gespreksvaardigheden op een hoger niveau.", "short_description": "Oefenen gespreksvaardigheden in een intakegesprek met een cli\u00ebnt van een gezondheidscentrum."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cdn.jutten.com/docs/Privacyverklaring_The_Simulation_Crew_1.1.pdf", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew BV", "support_website_url": "https://thesimulationcrew.com/contact/", "website_url": "https://thesimulationcrew.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "27362927396627898"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7992889037397266"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1450534966366812"}, {"status": "PUBLISHED", "id": "2705428416277358"}]}, "baseline_offer": {"id": "1450534966366812"}, 
NFwr&_nc_oc=AdowcHfx23TRzkX60ozGCdS3Qy4a-aTNVVdeZjCd41bY4IcR2xf99Z5gxLuRaNfDcA8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHy_-NUUVH7Ta-aFQDnZXYGszk7gJUaJ8ujXXXSkYKZyQ&oe=6A89A4BC"}, {"file_name": "screenshot2.png", "id": "670327675055236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035434_670327678388569_1821984589435737113_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yk-P9f9Z0CQQ7kNvwFdotor&_nc_oc=AdpVcnCET5oOnFhhV5BRxg9vqvyFBhvImj2iCl3Hml-cuxM-157-vp8FWwAyks8hzlg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQr1AAjZLtkpHxZOLCNJYfQP9ez4suMWGp9ODL6pfqTw&oe=6A8972D2"}, {"file_name": "screenshot4.png", "id": "6408837845912667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57568669_6408837855912666_6537066644795707454_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfWCk8y59EgQ7kNvwHppLsS&_nc_oc=Adpwk_P2Hrh2Pjyk2wqwFRISyzIzlJLqURhQoBnopfZqARbHP2g7xsx3nTs0YQ_RMds&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETV0IuCAW8_xVEvU8ENPT-fXftDImZFf6m6SUi7tAfiw&oe=6A89941E"}, {"file_name": "screenshot6.png", "id": "3606552606259922", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982686_3606552609593255_7282817138265599561_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Td7EnGUJ7VcQ7kNvwGCABDI&_nc_oc=Adp2yNwpq5ByyIc2JVWfzy88pc_t9SrQ9R_W_rcKS_cAwIl1upbPf3_gr-10vtKbqro&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwjeMZ0q2muTYQRDqlllPBvdNPVgnWqIibdl0nVLfMeA&oe=6A899240"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Intakegesprek 2.0", "keywords": [], "long_description": "Oefen met gespreksvaardigheden zoals luisteren, samenvatten en doorvragen. In een realistisch virtueel rollenspel ga je in gesprek met Max, een cli\u00ebnt van een gezondheidscentrum. Het doel van het intakegesprek is Max beter te leren kennen en zicht krijgen op zijn hulpvraag. Dit lukt alleen goed als je verbinding maakt, bijvoorbeeld door hem op gemak te stellen, interesse te tonen en emphatisch te reageren. De uitkomst van het gesprek is afhankelijk van hoe goed je de gespreksvaardigheden toepast. Is het niet direct gelukt om Max te laten vertellen wat hem echt bezig houdt? Geen nood, na elk gesprek krijg je feedback en tips die je kunt toepassen in de de volgende ronde. \n\nDeze unieke gespreksimulatie maakt gebruik van vrije spraak waardoor het initiatief in het gesprek bij jou ligt. Door de realistische omgeving en virtuele gesprekspartner wordt je helemaal ondergedompeld in de situatie. Met de ingebouwde feedback en intelligente begeleiding krijg je jouw gespreksvaardigheden op een hoger niveau.", "short_description": "Oefenen gespreksvaardigheden in een intakegesprek met een cli\u00ebnt van een gezondheidscentrum."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cdn.jutten.com/docs/Privacyverklaring_The_Simulation_Crew_1.1.pdf", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew BV", "support_website_url": "https://thesimulationcrew.com/contact/", "website_url": "https://thesimulationcrew.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "27362927396627898"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7992889037397266"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1450534966366812"}, {"status": "PUBLISHED", "id": "2705428416277358"}]}, "baseline_offer": {"id": "1450534966366812"}, 
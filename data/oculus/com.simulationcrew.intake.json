oT7g&_nc_oc=AdremhhHlTQQznROLUwUme55wrG7bJBVXSy6M0WmG-Vc2M2v8pN4G1IY7HR83I-PUek&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN24pO6eulSmvpAOSG4lspd79zeTCqNw4S6IQ0rV9QQFQ&oe=6AC8ECBC"}, {"file_name": "screenshot2.png", "id": "670327675055236", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035434_670327678388569_1821984589435737113_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGv5uaUtrycQ7kNvwHH2JXv&_nc_oc=AdoJavwSbGJ_zugZ0pxOL6h8eGtilv9c-MaMkZ2PgK8EX1SEYltajtwzHkAI5hPUlUA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbkaYhBJbe8WKR9ACIhe5BbcOtPV890M_4t3ZGvfv4xA&oe=6AC8F312"}, {"file_name": "screenshot4.png", "id": "6408837845912667", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57568669_6408837855912666_6537066644795707454_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6m7Xy9ZUEp8Q7kNvwFJdPnV&_nc_oc=Adr29aHgY0cDlHMmIExDlWyJjyJiYy6rmPF-2EDjsr2VS2J3KmQRg0lkDSiiPaIAMxs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYCfxpP5blztqUJfByQcx-9msVhg2FxTEUVtkgmbdCIQ&oe=6AC9145E"}, {"file_name": "screenshot6.png", "id": "3606552606259922", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982686_3606552609593255_7282817138265599561_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbnHDwXWsHUQ7kNvwHHCio-&_nc_oc=AdqjW3qtxVFthlAPMyzlxdfKOq1FI_QiBlvS2lEoA3vCvnjSwMpm9Xa33jS0q2GeEEI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAQYGSycEur2Q3oxqT3TywpECqMCRKfB1JGEPYFHDblQ&oe=6AC91280"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Intakegesprek 2.0", "keywords": [], "long_description": "Oefen met gespreksvaardigheden zoals luisteren, samenvatten en doorvragen. In een realistisch virtueel rollenspel ga je in gesprek met Max, een cli\u00ebnt van een gezondheidscentrum. Het doel van het intakegesprek is Max beter te leren kennen en zicht krijgen op zijn hulpvraag. Dit lukt alleen goed als je verbinding maakt, bijvoorbeeld door hem op gemak te stellen, interesse te tonen en emphatisch te reageren. De uitkomst van het gesprek is afhankelijk van hoe goed je de gespreksvaardigheden toepast. Is het niet direct gelukt om Max te laten vertellen wat hem echt bezig houdt? Geen nood, na elk gesprek krijg je feedback en tips die je kunt toepassen in de de volgende ronde. \n\nDeze unieke gespreksimulatie maakt gebruik van vrije spraak waardoor het initiatief in het gesprek bij jou ligt. Door de realistische omgeving en virtuele gesprekspartner wordt je helemaal ondergedompeld in de situatie. Met de ingebouwde feedback en intelligente begeleiding krijg je jouw gespreksvaardigheden op een hoger niveau.", "short_description": "Oefenen gespreksvaardigheden in een intakegesprek met een cli\u00ebnt van een gezondheidscentrum."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cdn.jutten.com/docs/Privacyverklaring_The_Simulation_Crew_1.1.pdf", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew BV", "support_website_url": "https://thesimulationcrew.com/contact/", "website_url": "https://thesimulationcrew.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "27362927396627898"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7992889037397266"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1450534966366812"}, {"status": "PUBLISHED", "id": "2705428416277358"}]}, "baseline_offer": {"id": "1450534966366812"}, 
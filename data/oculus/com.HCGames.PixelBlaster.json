tless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNhra5gdNtoQ7kNvwFg4VB_&_nc_oc=AdouMNgOZ8jNTou47bsDF3pjCliWS4oJZdq7cU0esLlPRuRpaCCa5tBimMfyNgERjzw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGlsUu2U27nu5_Q8BwX-n84plg9x4AcuTJpJjumh5a3g&oe=6AFC8687"}, {"file_name": "Screen SHot Images5-gigapixel-very_compressed-width-3000px.png", "id": "2126573598245031", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499302374_2126573601578364_7985846943905164403_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKUGVMBJ1d8Q7kNvwEd7VFS&_nc_oc=AdpZoIX8TxjmCQt7709_l0VYLgC61iyfqz_mQdJLMj_xCMSfQVWT_QKc9q0i1HEUiE4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzg8AcwojrODVqUTnmVVj7xiQG4unnvtgcs5Y6oQDFuQ&oe=6AFC641D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Example RealEstate Cover Art 1 Final-low_res-width-2560px.png", "id": "1771241013915081", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303769_1771241017248414_4574746054435536526_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8BqRiuojQcQ7kNvwEoCzTO&_nc_oc=AdqYdXDAmxtnEDLkGgfT3IT9WCpdWn3D3ylEnAkr0ioXdLWd3CCejHST7_HXbVw33d8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ212vfiPrFFgu7ThL5EsZYSL1PZld96TvvxTUj-5oCVg&oe=6AFC7773"}, "display_name": "Pixel Blaster", "keywords": ["Arcade", "Shooter", "Games", "Action", "Survival"], "long_description": "THE RETRO INVASION HAS BREACHED REALITY!!\n\n The boundary between the digital world and your physical reality has shattered, transforming your familiar surroundings into a high-stakes, neon-drenched warzone.\n\nIf you grew up pumping quarters into neon-lit arcade cabinets then this game is definitely for YOU!! You are no longer standing on the outside looking at a flat glass screen with a joystick in hand\u2014you are completely enveloped by the digital horde, standing shoulder-to-shoulder with the action.\n\nINTENSE, PHYSICAL COMBAT!!\n\nAs vibrant voxel projectiles light up the airspace around you, survival demands constant movement.To push back the digital onslaught, you will be armed to the teeth. Take command of an arsenal of 12 distinct firearms, each engineered with unique firing rates, handling mechanics, tactical advantages, and explosive visual effects.\n\nFACE THE VOXEL HORDE!!\n\nPrepare to battle across waves featuring 14 different enemy types, each designed with distinct flight patterns, attack vectors, and tactical behaviors.When the battlefield becomes entirely overwhelmed and the odds seem impossible, deploy game-changing power-ups that instantly turn the tide of war.\n\nCLAIM THE CROWN OF PIXEL MASTER!!\n\nAs the waves intensify, in true arcade fashion, simple survival is only the baseline; total battlefield dominance is the real prize.The global leaderboards are waiting!!\n\nNote: Think you\u2019ve mastered the invasion? Try Hard Mode if you dare!!", "short_description": "PIXEL ENEMIES ARE INVADING YOUR HOME!! DESTROY THEM ALL!!\n\nWe have taken the classic, old-school arcade type gameplay and fused it with a groundbreaking new style format with VR, putting you directly on the front lines of the invasion. You are no longer just looking at a flat screen with a joystick in hand\u2014you are entirely inside the game, standing face-to-face with the digital horde.\n\nYou must SHOOT and physically duck, dodge, and move to evade enemy blasts.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pixelblaster.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HC Games", "support_website_url": null, "website_url": "https://www.pixelblaster.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_
545170682672201_8173163312927248326_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84eKhPSIvvMQ7kNvwHK_mdo&_nc_oc=AdoiVjwxrdL-4RlQZo9bqS93dIE3kvWn7PFZ-lOp32OL6_5EalQ89fReqI6DQ5X1m8A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXqoOZRCh3OnTUoZtLM9GqBiIJ102ENb5B2xYVq9eWOzQ&oe=6B0F0085"}, "display_name": "Arok and Puku Last Page", "keywords": ["book", "arok", "puku", "puzzle", "adventure"], "long_description": "Every story has a beginning. But not every story wants to end.\nSomewhere inside a forgotten storybook, a tiny knight named Arok and his magical companion Puku are about to begin a journey neither of them could have imagined.\nAt first, their world seems like something from a beautiful fairy tale. Sunlit meadows, enchanted forests, curious creatures, and places filled with wonder. But as the pages turn, strange things begin to happen. Familiar paths lead somewhere unexpected, shadows creep into once-peaceful places, and the story they thought they knew begins to change.\nAnd somehow, these two little heroes are caught in the middle of it all.\n\nA Little Knight and a Touch of Magic\n\nArok may be small, but he has the heart of a true knight. With his sword and shield, he'll face dangerous creatures, overcome tricky obstacles, and venture into places much bigger than himself.\n\nPuku is more than a companion. With a little magic and your help, Puku can move objects, awaken mysterious mechanisms, and reveal paths that Arok could never discover on his own.\n\nSometimes courage is enough. Sometimes a clever idea is all you need. And sometimes, the two must work together to find a way forward.\n\nGuide Arok through beautiful fantasy worlds, discover hidden corners, solve environmental puzzles, and take on enemies and powerful bosses along the way.\n\nIn VR, you're not simply watching their adventure. You're part of", "short_description": "Guide Arok and Puku through a magical VR adventure filled with puzzles, combat, and storybook worlds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/arok-puku-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "Medus Games", "support_website_url": null, "website_url": "https://medusgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "tr", "fr", "es", "it", "pt", "pt_BR", "ja", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1484297194763566"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1718237503196431"}]}, "baseline_offer": {"id": "1718237503196431"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795208580, "status": "PUBLISHED", "id": "1718237503196431"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1492011933992092", "version": "1.0.1"}, "id": "29049234101385296", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1484297181430234", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1492011933992092"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "L
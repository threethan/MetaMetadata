s6reKcafqpDvkF9poszNNOa2sP-qWfhbrEYffcdJ60VnOkIZKpSeLoeCBE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRYxwJmZYj6l0wNgW-vKUe_rSl1la5pCRrCtqzn9xhqWg&oe=6B0B28AA"}, {"file_name": "2023-11-02_HL-Space_Q4_Release_VR-Skybox_2560x1440.png", "id": "2498147683692091", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031314_2498147687025424_1994782466127995006_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SnDYfGs7RKUQ7kNvwES6sEB&_nc_oc=AdoqC_TjqDohjZyOXCdjQUr88ZU4tffQHl_cK9l2JgO7vmLz8G-5OquVPY9rtpKP_ug&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSasWWM0KPC5UmKb1QuMSd5pp2QoHA2JcwdKpW1Tadv0w&oe=6B0B37C2"}, {"file_name": "Meta_Store_Screenshot_2560x1440_04.png", "id": "424012580590788", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984449_424012583924121_3077076726565803147_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5gtcBzyw9AQ7kNvwG1ylfK&_nc_oc=AdoxB8n6Vc1qJTqY4qjbqziK-78_q3dESuRQIXSUFGciddNmlroqd4anu8Q5KqRk6_I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT35Vg8coD87_zWh0KsQtMr3DMpaP1cuJ6wl3ndbT4YFA&oe=6B0B3AF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail Trailer Meta Store.png", "id": "1684744125640541", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031339_1684744132307207_7309041796108357773_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLbAZTmkIGAQ7kNvwFMwq4j&_nc_oc=Adr-6P0x1DV1c3qiI3ujugDMl8Q0XUoA2Zpz5Zp2nV_s2R0FXpjdK3iVo5i936VpFMI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQdiwrF644BnFgT04jfAkqtFxjSZBJLqG62mhzK5BvhDQ&oe=6B0B1EB5"}, "display_name": "Hololight Space", "keywords": [], "long_description": "Hololight Space enables the unlimited visualization of complex 3D CAD models in the highest quality via remote rendering.\n\nHololight Space creates a collaborative, industrial VR working environment. The app enables engineers to visualize, manipulate and share 3D CAD data in a real-world environment. The app gives you secure access to your shared files and folder structures on the server/cloud. \n\nHololight Space supports Meta Quest 2/3 VR headset, enabling seamless interaction and multi-user mode between Augmented Reality and Virtual Reality. Multi-user sessions can be conducted in AR+AR, AR+VR and VR+VR constellations. This makes Hololight Space very versatile and accessible, offering a variety of experiences in a single application.\n\nFrom creating a cross-section to disassembling the model into individual parts: Many familiar CAD functions are at your disposal.\n\nWhat\u2019s more, you can set up remote meetings for smooth collaboration with colleagues. Hololight Space makes it easy to interact with 3D content and work together on projects, saving time and increasing efficiency. Key use cases include prototyping, design reviews, factory planning and training.\n\nStart a virtual engineering session and work on the 3D model with your colleagues.\n\nHololight is a global leader in Augmented and Virtual Reality technology, dedicated to unlocking the full potential of XR in the enterprise market. For more information, visit our website.", "short_description": "Hololight Space enables the unlimited visualization of complex 3D CAD models in the highest quality via remote rendering."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hololight.com/privacy-policy/", "developer_terms_of_service_url": "https://hololight.com/terms-conditions/", "publisher_name": "Holo-Light GmbH", "support_website_url": null, "website_url": "https://hololight.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "inter
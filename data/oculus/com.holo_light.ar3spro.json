YU8euW9OIqyrBcBHArOHCJnIKXUKFcYBP6L1JF1VS7o2d41OIzDgDLOVoA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWoVfiq8Lch4L-j6GbSNHV9QNNGzkcipIm1zAwjT5M-g&oe=6B084D6A"}, {"file_name": "2023-11-02_HL-Space_Q4_Release_VR-Skybox_2560x1440.png", "id": "2498147683692091", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031314_2498147687025424_1994782466127995006_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJmaepsKrmAQ7kNvwEfChhQ&_nc_oc=Adp67uTK7i-IzRNpQ-chiwGvQv-mFw_ks1kfjtQT-fXpHT_KpTbf8YpsyNC_LUiqFfM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxLKXwxwBB58eQykXRTfkE7hsM5NeJo9XOe74Hkzpx6A&oe=6B085C82"}, {"file_name": "Meta_Store_Screenshot_2560x1440_04.png", "id": "424012580590788", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38984449_424012583924121_3077076726565803147_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUPHYwy9JkwQ7kNvwFGg5rd&_nc_oc=Adq7Dg_W2t2guX4vKQOBMj6JPxbL6-i0AdozJNB_R08bp35KvvxmekpkX4hFKlD9Y7U&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQODJC8vsRe9sL5OhbTmLJq3uwJ2gNGwxwnJLoHBOaUjg&oe=6B085FB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail Trailer Meta Store.png", "id": "1684744125640541", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031339_1684744132307207_7309041796108357773_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCJyGSkpqF4Q7kNvwG0mVRr&_nc_oc=Adqqq_cwCygCvO4vqQtR99-GEm_cOMW75AUSWDYkSKRzfk1AOImBrNN8ATKBH--Wa3U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiulmeSbO4tLAoq-u0iF7nITFxnnlsiocn5f4HA1jglw&oe=6B084375"}, "display_name": "Hololight Space", "keywords": [], "long_description": "Hololight Space enables the unlimited visualization of complex 3D CAD models in the highest quality via remote rendering.\n\nHololight Space creates a collaborative, industrial VR working environment. The app enables engineers to visualize, manipulate and share 3D CAD data in a real-world environment. The app gives you secure access to your shared files and folder structures on the server/cloud. \n\nHololight Space supports Meta Quest 2/3 VR headset, enabling seamless interaction and multi-user mode between Augmented Reality and Virtual Reality. Multi-user sessions can be conducted in AR+AR, AR+VR and VR+VR constellations. This makes Hololight Space very versatile and accessible, offering a variety of experiences in a single application.\n\nFrom creating a cross-section to disassembling the model into individual parts: Many familiar CAD functions are at your disposal.\n\nWhat\u2019s more, you can set up remote meetings for smooth collaboration with colleagues. Hololight Space makes it easy to interact with 3D content and work together on projects, saving time and increasing efficiency. Key use cases include prototyping, design reviews, factory planning and training.\n\nStart a virtual engineering session and work on the 3D model with your colleagues.\n\nHololight is a global leader in Augmented and Virtual Reality technology, dedicated to unlocking the full potential of XR in the enterprise market. For more information, visit our website.", "short_description": "Hololight Space enables the unlimited visualization of complex 3D CAD models in the highest quality via remote rendering."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hololight.com/privacy-policy/", "developer_terms_of_service_url": "https://hololight.com/terms-conditions/", "publisher_name": "Holo-Light GmbH", "support_website_url": null, "website_url": "https://hololight.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "inter
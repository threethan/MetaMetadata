astructure.\n\nHololight Space is a Windows application that allows you to connect to your XR device. From there, you drop your 3D CAD files into the application. The application renders the scene and the rendered image is streamed to the XR device.", "short_description": "This application connects to a Hololight Space Server, deployed on a Server, Desktop or cloud infrastructure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hololight.com/legal/privacy-policy", "developer_terms_of_service_url": "https://hololight.com/legal/terms-conditions", "publisher_name": "Holo-Light GmbH", "support_website_url": "https://hololight.com/support-base", "website_url": "https://hololight.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25917088611248558"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031378_9038516439496452_6497258639387149661_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfpRWQdeA48Q7kNvwEzboxj&_nc_oc=Ado5h6B5PJNSgxr--czJfPiUl7LG3vx3FLLi569mxP8X9tnxQ4Ju6aZi5K2vvKgOJkk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwIxYY9W-zGB649-RJaxLPuCxqJaCqxiNnG6tFdGMYD0Q&oe=69D0F474"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "H
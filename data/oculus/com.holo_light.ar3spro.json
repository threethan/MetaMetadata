71-25/39031314_2498147687025424_1994782466127995006_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTTWyRPm7gQQ7kNvwHVadIH&_nc_oc=Adplw6V3cbOtsXNc4gl6VQ3CV7VbjK1qUVQX_AVRd0RgsxsNRWFzc9Q0HuqoMfOPm9M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDyEEZgJAGkURCyOm5G7v_jSdv8pX4qcjZimEAmcABsA&oe=6A64AA42"}, {"file_name": "Meta_Store_Screenshot_2560x1440_04.png", "id": "424012580590788", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984449_424012583924121_3077076726565803147_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34aPMfByhloQ7kNvwHaSfvR&_nc_oc=Ado4XyfSlXgYl8slGh16BvAKZoTGSMsJjfjWOGick49BhU22DLWPQdx97JEd3XLYa8Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8XsUklHdSVRNAVrt7Lg_bimVSrSvGFPhVb0nz_2Pf9Q&oe=6A64AD77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail Trailer Meta Store.png", "id": "1684744125640541", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031339_1684744132307207_7309041796108357773_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9r2xs6I2JBwQ7kNvwGsa6Kt&_nc_oc=AdpVHKcS6ZQrAHPfLtadUvNEV3YMvLWcQKbxH-lPeNIC9NGub5VGuBejahGL0XXh-u8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcspyj45wFXTewM04Xo2Lv7bFBkLcfw3IUZs5QJ81WuA&oe=6A64C975"}, "display_name": "Hololight Space", "keywords": [], "long_description": "Hololight Space enables the unlimited visualization of complex 3D CAD models in the highest quality via remote rendering.\n\nHololight Space creates a collaborative, industrial VR working environment. The app enables engineers to visualize, manipulate and share 3D CAD data in a real-world environment. The app gives you secure access to your shared files and folder structures on the server/cloud. \n\nHololight Space supports Meta Quest 2/3 VR headset, enabling seamless interaction and multi-user mode between Augmented Reality and Virtual Reality. Multi-user sessions can be conducted in AR+AR, AR+VR and VR+VR constellations. This makes Hololight Space very versatile and accessible, offering a variety of experiences in a single application.\n\nFrom creating a cross-section to disassembling the model into individual parts: Many familiar CAD functions are at your disposal.\n\nWhat\u2019s more, you can set up remote meetings for smooth collaboration with colleagues. Hololight Space makes it easy to interact with 3D content and work together on projects, saving time and increasing efficiency. Key use cases include prototyping, design reviews, factory planning and training.\n\nStart a virtual engineering session and work on the 3D model with your colleagues.\n\nHololight is a global leader in Augmented and Virtual Reality technology, dedicated to unlocking the full potential of XR in the enterprise market. For more information, visit our website.", "short_description": "Hololight Space enables the unlimited visualization of complex 3D CAD models in the highest quality via remote rendering."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hololight.com/privacy-policy/", "developer_terms_of_service_url": "https://hololight.com/terms-conditions/", "publisher_name": "Holo-Light GmbH", "support_website_url": null, "website_url": "https://hololight.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8907844602599558"}}]}, "scheduled_of
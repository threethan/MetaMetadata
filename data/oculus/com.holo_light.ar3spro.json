ream in order to connect to a Hololight Space 2026.0.0.0 instance.\n\nThis application connects to a Hololight Space Server, deployed on a Server, Desktop or cloud infrastructure.\n\nHololight Space is a Windows application that allows you to connect to your XR device. From there, you drop your 3D CAD files into the application. The application renders the scene and the rendered image is streamed to the XR device.", "short_description": "With the release of Hololight Space 2026.0.0.0 this client is deprecated. Please use Hololight Stream in order to connect to a Hololight Space 2026.0.0.0 instance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hololight.com/legal/privacy-policy", "developer_terms_of_service_url": "https://hololight.com/legal/terms-conditions", "publisher_name": "Holo-Light GmbH", "support_website_url": "https://hololight.com/support-base", "website_url": "https://hololight.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27944798398477559"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031378_9038516439496452_6497258639387149661_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qmE9TmndhcQ7kNvwG_tHNm&_nc_oc=AdrV_89BoJSuicYmrdYRj93s9ynnYUyNpufbw1ZlJW70Figci-H9EfnU5O6_Y
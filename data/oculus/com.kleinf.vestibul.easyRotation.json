n71_BS6mAZgubogvw&oe=69A6D05D"}, {"file_name": "5-screen.png", "id": "901196535652985", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_901196538986318_8161464699861577651_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWTTMdL73yYQ7kNvwE6g-Ll&_nc_oc=AdlqxwbzMaEE69r_AAVMlWV5OQDvCEewP8NytJw4n1W50C59L2W4CIbI-WCLUFyeiXM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftxgbD0p-_uqLfMi-Hu4zk8TqBfIg1qdK1G4KsedUyvaA&oe=69A6D16F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "737438435896156", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/585720338_737438439229489_2209587200449965494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I48Zat-REL4Q7kNvwEAOJ1i&_nc_oc=AdkDIAEWEP9t-DDtbIEP322WwlaIVEGtvo1EalycwgWQhBYpc6W4ilD_DZXM-_H79KQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsogZVJmnvX7sRTyWO7kZCLqr9lhwywM_MxdR5DTzlbRA&oe=69A6D684"}, "display_name": "Vestibul: easy Rotation", "keywords": ["VR", "illussion", "rotation", "vestibular", "immersive"], "long_description": "Vestibul: easy Rotation is a hand-tracking VR experience designed to explore spatial perception and rotational illusions.\n\nEnter a controlled virtual environment where visual motion challenges your vestibular system and creates a powerful sensation of rotation without physical movement.\n\n\u26a0\ufe0f Important:\nThis experience requires physical room space.\nThere is no teleportation or artificial movement system.\nUsers must be able to safely move within their guardian boundary.\n\nFeatures:\n\u2022 Hand tracking only \u2013 no controllers required\n\u2022 Immersive rotational tunnel experience\n\u2022 Minimal and clean interaction design\n\u2022 Short, intense sessions\n\nComfort Notice:\nThis experience may cause dizziness or disorientation. Recommended for users aged 13+.\n\nRequires Meta Quest with hand tracking enabled.\n", "short_description": "A minimalist hand-tracking VR rotation experience.\nRequ
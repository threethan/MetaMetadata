Elf_wW3tb-lB1poIg&oe=69A038DD"}, {"file_name": "5-screen.png", "id": "901196535652985", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_901196538986318_8161464699861577651_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMOUUrD3Ub8Q7kNvwHvYiRN&_nc_oc=Adln_-v03A1hgTXeWSkKt6iUsR8k9oRPRl-xPopFERt7f9pWGWZeItgdT0ASG8YUZAo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu9_LarVeZhiWKHT7zIE-TvARWtmcLqC0HXRbztSdXexQ&oe=69A039EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "737438435896156", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/585720338_737438439229489_2209587200449965494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qN8oaImdGoAQ7kNvwFiQXT4&_nc_oc=Adk8mLcJd6dF_m_yWC_EzFq8OmjrOqlkdPzKZEx1zbAX85OMxZa8qVOMMGLu1blrPSc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuSTYnaWKTF0PhOwyNAbn48RATKizsumi8Qqvn4UyU1gA&oe=69A03F04"}, "display_name": "Vestibul: easy Rotation", "keywords": ["VR", "illussion", "rotation", "vestibular", "immersive"], "long_description": "Vestibul: easy Rotation is a hand-tracking VR experience designed to explore spatial perception and rotational illusions.\n\nEnter a controlled virtual environment where visual motion challenges your vestibular system and creates a powerful sensation of rotation without physical movement.\n\n\u26a0\ufe0f Important:\nThis experience requires physical room space.\nThere is no teleportation or artificial movement system.\nUsers must be able to safely move within their guardian boundary.\n\nFeatures:\n\u2022 Hand tracking only \u2013 no controllers required\n\u2022 Immersive rotational tunnel experience\n\u2022 Minimal and clean interaction design\n\u2022 Short, intense sessions\n\nComfort Notice:\nThis experience may cause dizziness or disorientation. Recommended for users aged 13+.\n\nRequires Meta Quest with hand tracking enabled.\n", "short_description": "A minimalist hand-tracking VR rotation experience.\nRequires physical movement space. No artificial locomotion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kleinf.com/privacy-policy-for-vestibul-easy-rotation/", "developer_terms_of_service_url": null, "publisher_name": "kleinFELDER", "support_website_url": null, "website_url": "https://kleinf.com/privacy-policy-for-vestibul-easy-rotation/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26267855709467580"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827038_1365584038653130_6736479353068638338_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFgO9lFZjNgQ7kNvwEZp5ls&_nc_oc=Adkrj9riJpa4sZxVojw1xAtdWipzH6d-lEf7EQxS26dmjVcGPjRZ4j_m06EcREiQbJM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuvMtcE838JEyKsjAoC8MCjkknoBWu_J6kh4zCM-YrOIg&oe=69A0249B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vestibul: easy Rotation", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1771250940, "lastRevision": {"nodes": [{"id": "26267855739467577", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "262678556
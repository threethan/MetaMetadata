c_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVADx2LwqN99Hobqb0b7sa2Xem5EXpQeCg9GMO8s1_Mw&oe=6AFC7D1D"}, {"file_name": "5-screen.png", "id": "901196535652985", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491821099_901196538986318_8161464699861577651_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOdqJ9tBiGkQ7kNvwGn4NXg&_nc_oc=AdqJlm3-YoQory4f48GNpw1v2v-4uYc47dT3SPTIh2A36IESk2u-HB1PUUZSoTlRtgk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCyexc-n2LolT3T5yGipaGimIqv4B445769pAh31q9Dw&oe=6AFC7E2F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "737438435896156", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/585720338_737438439229489_2209587200449965494_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2r8vPXPDm8Q7kNvwF9g7fT&_nc_oc=AdoBfWOE5rrPjMugkRsb5ygxzzwLMDVS02AiGdXhQdvrYxFYqAPX-H_J40Ezhgpxbwk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpkiIYuBVXMCzHzZ8AvUFhK-iRKSqLIz15vmbRUkmdEQ&oe=6AFC8344"}, "display_name": "Vestibul: easy Rotation", "keywords": ["VR", "illussion", "rotation", "vestibular", "immersive"], "long_description": "Vestibul: easy Rotation is a hand-tracking VR experience designed to explore spatial perception and rotational illusions.\n\nEnter a controlled virtual environment where visual motion challenges your vestibular system and creates a powerful sensation of rotation without physical movement.\n\n\u26a0\ufe0f Important:\nThis experience requires physical room space.\nThere is no teleportation or artificial movement system.\nUsers must be able to safely move within their guardian boundary.\n\nFeatures:\n\u2022 Hand tracking only \u2013 no controllers required\n\u2022 Immersive rotational tunnel experience\n\u2022 Minimal and clean interaction design\n\u2022 Short, intense sessions\n\nComfort Notice:\nThis experience may cause dizziness or disorientation. Recommended for users aged 13+.\n\nRequires Meta Quest with hand tracking enabled.\n", "short_description": "A minimalist hand-tracking VR rotation experience.\nRequires physical movement space. No artificial locomotion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kleinf.de/vestubul/", "developer_terms_of_service_url": null, "publisher_name": "kleinFELDER", "support_website_url": null, "website_url": "https://kleinf.de/xr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27680241084895695"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827038_1365584038653130_6736479353068638338_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0BwI0GinZ6QQ7kNvwF35-5R&_nc_oc=AdrsNCile7oVANo1dn71Ynzn3UX18P-WbciNNQTQnA2Iw77-203G2FU_Cc-Ras2YA4I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKIS0cxWsB7jE3l2tl5gTwpn7k5-cGRmktIrRMIcQFmA&oe=6AFC68DB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vestibul: easy Rotation", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1771250940, "lastRevision": {"nodes": [{"id": "26267855739467577", "release_type": "
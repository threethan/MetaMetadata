WgjkZxurfbgwRj6UDpboBjxgKPvJxn2U6EpapLugA&oe=69D27B0F"}, {"file_name": "Map2_pre (Benutzerdefiniert).png", "id": "1347536410228622", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827286_1347536413561955_2419419053629367646_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjQk2NcnbfsQ7kNvwEKiZpn&_nc_oc=AdrnD7eTpBAY1LyZuzEUZhomEDlpoB5qWJbGFKVs6oMvYPbv0HFSNdGzaq0LKpscMaA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3N-be5_YQQfZHiUEwEZb0RnO7pae-rmY1srfJO77cpLA&oe=69D258B9"}, {"file_name": "Map3_pre (Benutzerdefiniert).png", "id": "1296510208816091", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499301053_1296510212149424_8925495157160777224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fi5tRWlpxBMQ7kNvwHqWL8k&_nc_oc=AdpR0_DvCpZtvW7N9J2fSR_8oaK-WJOuqSYhZpacFoqZqwQXGMqnX6yTqbE_EaY8TEg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ocD_VDB3vzHJ9QNl1mMgMkyGGorta2cldm32_jGSj5A&oe=69D25F9A"}, {"file_name": "vending pic (Benutzerdefiniert).png", "id": "1746083095995186", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507829689_1746083099328519_8192139514779858461_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVLJ5bJn4TIQ7kNvwHmU7Fx&_nc_oc=AdrreylouZnk3DzbN9kQXfkHc2i83kze_HT3gtW_pxoeBU5B3ShQgiNbyBb6_ZuPYgY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08zNvoWwjArTUDWbwri9-B8KNSxAB3YQS973SDFPhb1g&oe=69D25027"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Quackdown - Early Access Trailer - Thumbnail (Benutzerdefiniert).png", "id": "703743045820842", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314641_703743049154175_9035390746938803102_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_0Tb4Yx4LAQ7kNvwFI61Ja&_nc_oc=AdpowGQ9vEwHE6KNcZRQMz-bORRCFLtvbawsBoZCyxGsrPAeoduPYnxkWmNHqCetye8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EnSpgM6FIbEpPGYld_Xz0hLi1Mhs-eOqMwPnkPGFCEg&oe=69D25BFC"}, "display_name": "Quackdown", "keywords": ["Duck", "Arena", "Shooter", "Gorilla", "Monkey"], "long_description": "Use close-range blasters, long-range rifles, or even explosive launchers. each kill earns you Quacks, the in-game currency. Spend them to unlock new and better weapons. But watch out: if you get taken down, your weapon might break.\n\nMatches support up to 10 players online, with everyone fighting to get the highest kill count. The more you play, the more gear you can earn. Customize your duck with hats, and more to stand out from the rest.\n\nMore maps, weapons, and game modes are coming, so every match stays fresh. It's quick, it's wild, and it's all about being the best duck.", "short_description": "Quackdown is a multiplayer arena shooter where players are ducks armed with different weapons. Fight across various maps in fast-paced rounds to get the highest kill count.\nEach kill earns you Quacks, the in-game currency. Use them to buy new and better weapons. But be careful! If you get killed, your weapon might break."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/e983690f-d839-4cf7-b107-8cd78082ee17", "developer_terms_of_service_url": null, "publisher_name": "132magnet", "support_website_url": null, "website_url": "https://132magnet.com/quackdown/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_U
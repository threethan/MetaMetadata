n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7Y7g6BWsCwQ7kNvwHaeuIC&_nc_oc=AdmUZO7ZcxKQ5ahlJcngNEtYTmNljSPErrC6JyPAsoOdvgYfs_xZj7yXWF1fQaCJEkY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuR_ZLz2JbWPwCo5uiSZf522NNSBKWRD0rtnCUWcmZIGw&oe=69999FA7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Quackdown - Early Access Trailer - Thumbnail (Benutzerdefiniert).png", "id": "703743045820842", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314641_703743049154175_9035390746938803102_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0h7eYRVAq0Q7kNvwH85eU9&_nc_oc=AdmOtpEGbpN4HV_KrZntOurB4XGPHESlG8vlE5Dqx6LKD5nGRV__PvGzaGQOzITKnAA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftjYStHvOuAEknGDjv6DLfCke83LzhDdjU4wjninAMVkw&oe=6999AB7C"}, "display_name": "Quackdown", "keywords": ["Duck", "Arena", "Shooter", "Gorilla", "Monkey"], "long_description": "Use close-range blasters, long-range rifles, or even explosive launchers. each kill earns you Quacks, the in-game currency. Spend them to unlock new and better weapons. But watch out: if you get taken down, your weapon might break.\n\nMatches support up to 10 players online, with everyone fighting to get the highest kill count. The more you play, the more gear you can earn. Customize your duck with hats, and more to stand out from the rest.\n\nMore maps, weapons, and game modes are coming, so every match stays fresh. It's quick, it's wild, and it's all about being the best duck.", "short_description": "Quackdown is a multiplayer arena shooter where players are ducks armed with different weapons. Fight across various maps in fast-paced rounds to get the highest kill count.\nEach kill earns you Quacks, the in-game currency. Use them to buy new and better weapons. But be careful! If you get killed, your weapon might break."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/e983690f-d839-4cf7-b107-8cd78082ee17", "developer_terms_of_s
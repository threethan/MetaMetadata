", "id": "1347536410228622", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827286_1347536413561955_2419419053629367646_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5asz8RCkjTIQ7kNvwHFg-3X&_nc_oc=AdpQ_hvEc294yWqsAHOleJH7ua8r3G4pwWWl1d2zNDDZ7l6O-UAZinx4aNJjrAYAP08&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3nieUJhDzdCdw0GSt5jq3dErPEcvmXa1DaS3yi2UXMGw&oe=69F0AB39"}, {"file_name": "Map3_pre (Benutzerdefiniert).png", "id": "1296510208816091", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499301053_1296510212149424_8925495157160777224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1APMZxN9t4Q7kNvwE82kYC&_nc_oc=Adrdo6YObL9L3IlwpJwD23GKjvYPyqRhfJpbYqv9FU43q4NwHp3mlUf-NqEfuEFcQQY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af241juz1HPcFQeMZoijhx13i7mQLFm7R1LJqSrxtmZF6Q&oe=69F0B21A"}, {"file_name": "vending pic (Benutzerdefiniert).png", "id": "1746083095995186", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507829689_1746083099328519_8192139514779858461_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKq0mXQLJ9cQ7kNvwEhhF43&_nc_oc=AdoqGgpgHG-9Hyqe58tMSYQ3WJKpvx_rXX17QQvDMHM7ejgDtN6tkpIcYOteyJTcDtg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3wfkQ4JpojDa4W-ESPPD16zYJsMxkhGpQ_w6EO4NycfQ&oe=69F0A2A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Quackdown - Early Access Trailer - Thumbnail (Benutzerdefiniert).png", "id": "703743045820842", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_703743049154175_9035390746938803102_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blprzMCRHeIQ7kNvwEp_7XS&_nc_oc=Adp7CmETdfLykegGbgz8C15KQRBUwirFO-QAjU1qWPMYM0vYMjxWI97ggtZyxcVfUnQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2UhYJMwjQmV5S_FvCJPXfUokaFiBL8qYH7w69YJeJK2A&oe=69F0AE7C"}, "display_name": "Quackdown", "keywords": ["Duck", "Arena", "Shooter", "Gorilla", "Monkey"], "long_description": "Use close-range blasters, long-range rifles, or even explosive launchers. each kill earns you Quacks, the in-game currency. Spend them to unlock new and better weapons. But watch out: if you get taken down, your weapon might break.\n\nMatches support up to 10 players online, with everyone fighting to get the highest kill count. The more you play, the more gear you can earn. Customize your duck with hats, and more to stand out from the rest.\n\nMore maps, weapons, and game modes are coming, so every match stays fresh. It's quick, it's wild, and it's all about being the best duck.", "short_description": "Quackdown is a multiplayer arena shooter where players are ducks armed with different weapons. Fight across various maps in fast-paced rounds to get the highest kill count.\nEach kill earns you Quacks, the in-game currency. Use them to buy new and better weapons. But be careful! If you get killed, your weapon might break."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/e983690f-d839-4cf7-b107-8cd78082ee17", "developer_terms_of_service_url": null, "publisher_name": "132magnet", "support_website_url": null, "website_url": "https://132magnet.com/quackdown/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9292247150857462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821702_133
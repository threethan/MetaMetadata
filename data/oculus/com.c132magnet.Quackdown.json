t=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaYjO4vnaC7IYPp8Dq9TqTS6drm9lms_iQetqPKK5AkQ&oe=6A884E9A"}, {"file_name": "vending pic (Benutzerdefiniert).png", "id": "1746083095995186", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/507829689_1746083099328519_8192139514779858461_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBiJwruyU5cQ7kNvwGucJd4&_nc_oc=Adp8i5uUgQm5oRrKRpZ20fwcd-rCG2C2e8BHZyzRmTk4uuSQLyhOfWxtXFivpEBtaK0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-2NBIq-TutXmLgyuBgEMl_NVRVsehVuwJ30DHGmJgCQ&oe=6A883F27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Quackdown - Early Access Trailer - Thumbnail (Benutzerdefiniert).png", "id": "703743045820842", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499314641_703743049154175_9035390746938803102_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYVp1gU_HygQ7kNvwGe1Ubb&_nc_oc=AdpLaIbDycziUzzCDrruAmTQHanxJiOSWYnrtbcCebskHeABXkoa7-xSqO2amTcYZF4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiuxmGsDcd1vgqjRHrzNSASFW45l8Ilpw7drpsoxyvHg&oe=6A884AFC"}, "display_name": "Quackdown", "keywords": ["Duck", "Arena", "Shooter", "Gorilla", "Monkey"], "long_description": "Use close-range blasters, long-range rifles, or even explosive launchers. each kill earns you Quacks, the in-game currency. Spend them to unlock new and better weapons. But watch out: if you get taken down, your weapon might break.\n\nMatches support up to 10 players online, with everyone fighting to get the highest kill count. The more you play, the more gear you can earn. Customize your duck with hats, and more to stand out from the rest.\n\nMore maps, weapons, and game modes are coming, so every match stays fresh. It's quick, it's wild, and it's all about being the best duck.", "short_description": "Quackdown is a multiplayer arena shooter where players are ducks armed with different weapons. Fight across various maps in fast-paced rounds to get the highest kill count.\nEach kill earns you Quacks, the in-game currency. Use them to buy new and better weapons. But be careful! If you get killed, your weapon might break."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/e983690f-d839-4cf7-b107-8cd78082ee17", "developer_terms_of_service_url": null, "publisher_name": "132magnet", "support_website_url": null, "website_url": "https://132magnet.com/quackdown/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9292247150857462"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "742668871485739"}]}, "baseline_offer": {"id": "742668871485739"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1753309320, "status": "PUBLISHED", "id": "742668871485739"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27472682785720621", "version": "0.2.4"}, "id": "1297867164822604", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9292247140857463", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27472682785720621"}, "release_status": 
Mq3xn0Qg_3edheHJZWv2qrIx1g5wwkDoPloeGQlxg&oe=69CE4E4F"}, {"file_name": "Map2_pre (Benutzerdefiniert).png", "id": "1347536410228622", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827286_1347536413561955_2419419053629367646_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bqpy6uhHcVIQ7kNvwGWH7z_&_nc_oc=AdoPKzQO7QRAMCqyLYMC-OQP62-oyJR5u2MCyKLYD1Cm-cp8cJrtTVkbv-e2vrGoA9g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzhSKQPoHieh_LiWdwNkBl-AI7Xh3DbZm_dnTFfX_Tvjg&oe=69CE6439"}, {"file_name": "Map3_pre (Benutzerdefiniert).png", "id": "1296510208816091", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301053_1296510212149424_8925495157160777224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EV3cGMmRmL0Q7kNvwEJHCBE&_nc_oc=AdpH07iZxDITDGNLk1M_7vv13VXZF0xb2BB7Aj-Y9-2nMxLgVujoSHNeNzXBI9Ttvhw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxHqNexjY1ZVc7IF-VUqXaL9KEPUKMjRkbwKIuIQPWR4Q&oe=69CE6B1A"}, {"file_name": "vending pic (Benutzerdefiniert).png", "id": "1746083095995186", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507829689_1746083099328519_8192139514779858461_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPZp_Rp31YcQ7kNvwEOP9lA&_nc_oc=AdpQlqYnzdJ9h3ff6uj6Tm4xx5hbCJOrltxdjH7w9t3ZxGzpMJ7vtLeLJaRavWlfmdI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzR5Pqe1UqR4OL5DmqjUZlu-fV9AANRCIn1gpq3bhaVuQ&oe=69CE5BA7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Quackdown - Early Access Trailer - Thumbnail (Benutzerdefiniert).png", "id": "703743045820842", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499314641_703743049154175_9035390746938803102_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxHY-jQjs3EQ7kNvwF_f9ir&_nc_oc=AdqfqbLZiBOalxL_Q3nSc-s8wP5v0azMPbrF-VsDDIPwrFNAqNLdvTHjcOpPJMGxlZM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy1ky9G9rE54qMoWLsdWHcMzk53uuqAq-CtG9EFhvW6YA&oe=69CE677C"}, "display_name": "Quackdown", "keywords": ["Duck", "Arena", "Shooter", "Gorilla", "Monkey"], "long_description": "Use close-range blasters, long-range rifles, or even explosive launchers. each kill earns you Quacks, the in-game currency. Spend them to unlock new and better weapons. But watch out: if you get taken down, your weapon might break.\n\nMatches support up to 10 players online, with everyone fighting to get the highest kill count. The more you play, the more gear you can earn. Customize your duck with hats, and more to stand out from the rest.\n\nMore maps, weapons, and game modes are coming, so every match stays fresh. It's quick, it's wild, and it's all about being the best duck.", "short_description": "Quackdown is a multiplayer arena shooter where players are ducks armed with different weapons. Fight across various maps in fast-paced rounds to get the highest kill count.\nEach kill earns you Quacks, the in-game currency. Use them to buy new and better weapons. But be careful! If you get killed, your weapon might break."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/e983690f-d839-4cf7-b107-8cd78082ee17", "developer_terms_of_service_url": null, "publisher_name": "132magnet", "support_website_url": null, "website_url": "https://132magnet.com/quackdown/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_U
n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwlPtQEHD3MQ7kNvwHB4K8k&_nc_oc=AdnsSCOoqpN5CRVj-zlKF1AxN89bZFl5s3OSRE_DJ-DtBLK_sM4U9ABrWsBzjdDr_5w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsXMElpukzCJuV2yGseP1UQE9haiJpYlJt_3_94NMwdWw&oe=699C42A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Quackdown - Early Access Trailer - Thumbnail (Benutzerdefiniert).png", "id": "703743045820842", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499314641_703743049154175_9035390746938803102_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNDogxcYn0oQ7kNvwEs9UL9&_nc_oc=AdmIeaxt63EF5a3Hn2ipi_yhabSP9EWu5oGBznqTZMmC68d5q3-tl_B9ZS-50FSNHX0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvEGLECH_yDG2XszqVCSqImlCqm3Muqu6L839bqxQ9jOA&oe=699C4E7C"}, "display_name": "Quackdown", "keywords": ["Duck", "Arena", "Shooter", "Gorilla", "Monkey"], "long_description": "Use close-range blasters, long-range rifles, or even explosive launchers. each kill earns you Quacks, the in-game currency. Spend them to unlock new and better weapons. But watch out: if you get taken down, your weapon might break.\n\nMatches support up to 10 players online, with everyone fighting to get the highest kill count. The more you play, the more gear you can earn. Customize your duck with hats, and more to stand out from the rest.\n\nMore maps, weapons, and game modes are coming, so every match stays fresh. It's quick, it's wild, and it's all about being the best duck.", "short_description": "Quackdown is a multiplayer arena shooter where players are ducks armed with different weapons. Fight across various maps in fast-paced rounds to get the highest kill count.\nEach kill earns you Quacks, the in-game currency. Use them to buy new and better weapons. But be careful! If you get killed, your weapon might break."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/e983690f-d839-4cf7-b107-8cd78082ee17", "developer_terms_of_s
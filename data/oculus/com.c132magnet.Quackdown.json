r4xsQGaPqFTyLAAJyj6vzQuPrQfy2TDl6k0JCrW8A&oe=6A09DA0F"}, {"file_name": "Map2_pre (Benutzerdefiniert).png", "id": "1347536410228622", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491827286_1347536413561955_2419419053629367646_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNestjeOfDcQ7kNvwHmuYLI&_nc_oc=AdrxboSdJXXjL1RhbfECevnS80EZWmyQst7bmPLeGal2j-h8JMRX_AGjjoMMnySiOd0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZSs7Xm90e8h1J_kt68_4dK8pNC9w3LrxI21UD1lTaRg&oe=6A09B7B9"}, {"file_name": "Map3_pre (Benutzerdefiniert).png", "id": "1296510208816091", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499301053_1296510212149424_8925495157160777224_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7S7GHD6EBfQQ7kNvwFCSu6I&_nc_oc=Adph_ezPKP3OV32EmAtCEJ3yQJOu89e0pXIcQlpe5ewwvflO891-TJwGBZotrcEQFY4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42gaOwWOZKzHHa3HKp4LCrYt0w2dA0HnmLmlMODUayPg&oe=6A09BE9A"}, {"file_name": "vending pic (Benutzerdefiniert).png", "id": "1746083095995186", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/507829689_1746083099328519_8192139514779858461_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pP8HyTnu7ZYQ7kNvwHnqY3a&_nc_oc=AdqXr2RPN7wxMy_D2bJQzesKM6-Y7W2ZQPG9hk5HHM02qUpi1mydHDLP7PLO5rTSvBw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af588V9qFXOXYpqntO0kJ01kZUrJaoQfagPB1DmWcuiPZQ&oe=6A09AF27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Quackdown - Early Access Trailer - Thumbnail (Benutzerdefiniert).png", "id": "703743045820842", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499314641_703743049154175_9035390746938803102_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Obg13fdu3qoQ7kNvwFkcJBj&_nc_oc=Adpmv8t0GZtBeVGKQXBzLo8nVf2_z8XkJX6LPovCFL8TrO9HjDh8nzbl4VWdl0FCCgo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WVz6H2bHw0c4rzEg6W16I__P9oZGyjrljZEYZp4FD_A&oe=6A09BAFC"}, "display_name": "Quackdown", "keywords": ["Duck", "Arena", "Shooter", "Gorilla", "Monkey"], "long_description": "Use close-range blasters, long-range rifles, or even explosive launchers. each kill earns you Quacks, the in-game currency. Spend them to unlock new and better weapons. But watch out: if you get taken down, your weapon might break.\n\nMatches support up to 10 players online, with everyone fighting to get the highest kill count. The more you play, the more gear you can earn. Customize your duck with hats, and more to stand out from the rest.\n\nMore maps, weapons, and game modes are coming, so every match stays fresh. It's quick, it's wild, and it's all about being the best duck.", "short_description": "Quackdown is a multiplayer arena shooter where players are ducks armed with different weapons. Fight across various maps in fast-paced rounds to get the highest kill count.\nEach kill earns you Quacks, the in-game currency. Use them to buy new and better weapons. But be careful! If you get killed, your weapon might break."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/e983690f-d839-4cf7-b107-8cd78082ee17", "developer_terms_of_service_url": null, "publisher_name": "132magnet", "support_website_url": null, "website_url": "https://132magnet.com/quackdown/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_U
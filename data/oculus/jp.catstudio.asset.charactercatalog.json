zCklUIpmdBIrPwBfRZmA&oe=6B030A3C"}, {"file_name": "CharacterCatalog_Options.png", "id": "1879666203022034", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593815290_1879666206355367_4529918254029405347_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSFyKYXkbGIQ7kNvwGEI7j_&_nc_oc=AdqgudA-cGCM7c294E6GGiqjT3W1gkdfJLHF1DJCqa4hGZW5M0TyVbOYCtsEAHMeeAw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmCYKQBm521Ek3X4HvdIrYKt3MZvf9PkPExuJuR5Nr7A&oe=6B032006"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CatStudio Asset - Character Catalog -", "keywords": ["unity", "asset", "character"], "long_description": "\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u9b45\u529b\u3092VR\u30fbAR\u3067\u4f53\u9a13\u3002\n\nCatStudio Asset - Character Catalog - \u306f\u3001CatStudio \u304c\u5236\u4f5c\u3059\u308b3D\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30a2\u30bb\u30c3\u30c8\u3092\u3001VR\u3068AR\u3067\u9451\u8cde\u3067\u304d\u308b\u30d3\u30e5\u30fc\u30a2\u30a2\u30d7\u30ea\u3067\u3059\u3002\n\u7b49\u8eab\u5927\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u307e\u308f\u308a\u3092\u6b69\u3044\u3066\u5168\u8eab\u3092\u78ba\u304b\u3081\u305f\u308a\u3001\u30e2\u30fc\u30b7\u30e7\u30f3\u3092\u5207\u308a\u66ff\u3048\u3066\u52d5\u304d\u3092\u78ba\u8a8d\u3057\u305f\u308a\u3067\u304d\u307e\u3059\u3002\n\n\u53ce\u9332\u30ad\u30e3\u30e9\u30af\u30bf\u30fc(\u51687\u4f53):\n\u30fbMonsters \u30b7\u30ea\u30fc\u30ba \u2014 Gnome / Cyclops / Evil Knight / Golem / Mummy / Goblin / Orc\n\n\u7279\u5fb4:\n\u30fb\u7b49\u8eab\u5927\u3067\u9451\u8cde \u2014 \u5b9f\u5bf8\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u307e\u308f\u308a\u3092\u6b69\u3044\u3066\u3001\u5168\u8eab\u3092\u9593\u8fd1\u3067\u78ba\u8a8d\n\u30fb16\u7a2e\u985e\u306e\u30e2\u30fc\u30b7\u30e7\u30f3 \u2014 Stand\u30fbWalk\u30fbRun\u30fbBattle Attack \u306a\u3069\u3002\u6b66\u5668\u3092\u6301\u3064\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306f Battle In / Out \u3067\u6b66\u5668\u3092\u629c\u304d\u3001\u7d0d\u3081\u308b\n\u30fb\u8996\u7dda\u8ffd\u5f93 \u2014 \u8fd1\u3065\u304f\u3068\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u3053\u3061\u3089\u3092\u5411\u304f\n\u30fbVR\u3068AR\u3092\u5207\u308a\u66ff\u3048 \u2014 \u4eee\u60f3\u306e\u30b9\u30c6\u30fc\u30b8\u3068\u3001\u76ee\u306e\u524d\u306e\u73fe\u5b9f\u306e\u666f\u8272\u3092\u884c\u304d\u6765\u3067\u304d\u308b\n\u30fbAR\u3067\u306e\u8868\u793a \u2014 \u5468\u56f2\u306e\u660e\u308b\u3055\u306b\u5408\u308f\u305b\u305f\u30e9\u30a4\u30c6\u30a3\u30f3\u30b0(Auto Lighting)\u3001\u5e8a\u306b\u843d\u3061\u308b\u5f71(AR Floor)\u3001\u73fe\u5b9f\u306e\u7269\u306e\u88cf\u306b\u96a0\u308c\u308b\u8868\u793a(AR Occlusion)\n\u30fbGoblin \u306f\u982d\u90e83\u7a2e\u3092\u5207\u308a\u66ff\u3048\u53ef\u80fd\n\u30fb\u8868\u793a\u30fb\u975e\u8868\u793a\u306e\u6f14\u51fa\u30923\u7a2e\u985e\u304b\u3089\u9078\u629e\n\u30fb\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3054\u3068\u306e\u7d39\u4ecb\u30da\u30fc\u30b8\u3068\u7d39\u4ecb\u52d5\u753b\u3092\u958b\u3051\u308b\n\u30fb\u56de\u8ee2\u65b9\u5f0f\u3084\u97f3\u91cf\u306a\u3069\u3092 Options \u3067\u8abf\u6574\n\n\u203b AR Occlusion \u306f Meta Quest 3 / 3S \u306e\u307f\u5bfe\u5fdc\u3067\u3059\u3002", "short_description": "\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u9b45\u529b\u3092VR\u30fbAR\u3067\u4f53\u9a13\u3002\nCatStudio\u306e3D\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30a2\u30bb\u30c3\u30c8\u3092\u3001VR\u3067\u306f\u7b49\u8eab\u5927\u3067\u9593\u8fd1\u306b\u3001AR\u3067\u306f\u76ee\u306e\u524d\u306e\u666f\u8272\u306e\u4e2d\u306b\u547c\u3073\u51fa\u3057\u3066\u9451\u8cde\u3067\u304d\u308b\u30d3\u30e5\u30fc\u30a2\u3067\u3059\u3002"}, {"images": {"nodes": [{"file_name": "\u30ab\u30cf\u3099\u30fc\u30a2\u30fc\u30c81440x1440.png", "id": "29654198927497130", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623558_29654198930830463_6532461144075026354_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0
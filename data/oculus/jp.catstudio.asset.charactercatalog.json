scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622202_1132163539790651_6391935335648412540_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I79OXfC6bfQQ7kNvwGGAXxu&_nc_oc=Adqqa3D_NY884Jaht_DGoRo355PpI4Jg4LxjXrzR0TxAq5pu-MLyJDSj4ElqolO_7i8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQwoQh7XuPFXOIeAhJZCwlOEBmfh2CuIUFcqE5RNQBnwg&oe=6B0D9A16"}, {"file_name": "CharacterCatalog_Character_AR.png", "id": "1131015422620400", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624577_1131015425953733_562381279208309417_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWqmfXldI6IQ7kNvwHBrX8k&_nc_oc=AdpR2VjG7ZuviUmHIkXHE9loPGB7yr9dEn5lEt-grgam8ld5jHcJfwQ_KFUGDbXw79M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRD0eDvthnx_zASzYqkF8-oLcK3g19BFnNkDuGQz01dLg&oe=6B0DB491"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CatStudio Asset - Character Catalog -", "keywords": ["unity", "asset", "character"], "long_description": "Experience each character in VR and AR.\n\nCatStudio Asset - Character Catalog - is a viewer for the 3D character assets created by CatStudio, in VR and AR.\nWalk around life-size characters to see every detail, and switch motions to watch them move.\n\nIncluded characters (7 total):\n- Monsters series: Gnome / Cyclops / Evil Knight / Golem / Mummy / Goblin / Orc\n\nFeatures:\n- Life size: Walk around full-scale characters and inspect them up close\n- 16 motions: Stand, Walk, Run, Battle Attack and more. Characters with weapons draw and sheathe them with Battle In / Out\n- Head look: Characters turn to look at you as you approach\n- VR and AR: Switch between a virtual stage and the real world around you\n- AR display: Lighting that matches your surroundings (Auto Lighting), shadows on the floor (AR Floor), and characters hidden behind real objects (AR Occlusion)\n- Three head variations for Goblin\n- Choose from three appear / disappear effects\n- Open each character's introduction page and video\n- Adjust turning, volume and more in Options\n\nNote: AR Occlusion is supported on Meta Quest 3 / 3S only.", "short_description": "Experience each character in VR and AR. A viewer for CatStudio's 3D character assets: see them life-size and up close in VR, or bring them into the world around you in AR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.catstudio.jp/privacypolicy_quest.html", "developer_terms_of_service_url": null, "publisher_name": "CatStudio LLC", "support_website_url": null, "website_url": "https://www.catstudio.jp/xr_charactercatalog_en.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1477865902072994"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1684591649941749"}]}, "baseline_offer": {"id": "1684591649941749"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794880920, "status": "PUBLISHED", "id": "1684591649941749"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1470987482760836", "version": "1.0.0"}, "id": "1457079936357600", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application
UY9r3NZvLwcOVUg76L0UUm0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXv0hfFI7IohJr_yfaGQw26oG3-UghX0M8CD2lepTKaxg&oe=6B0F0020"}, {"file_name": "CharacterCatalog_Character_VR.png", "id": "2054737291905550", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622153_2054737295238883_7770081035380951567_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PT2d1Uh4OKYQ7kNvwE6RQXz&_nc_oc=Adq5E3Y23yVXJWZWxsGuIbSoBZPxlRdNm_Qjm3wOKDqZrm_pmRcVOJxKhGKcuya7LKk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUhbU40IrbZDiKNJ_S_KKytymw0LzLQW9E_uHPLJbB69Q&oe=6B0EF41C"}, {"file_name": "CharacterCatalog_CharacterSelect.png", "id": "1132163536457318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622202_1132163539790651_6391935335648412540_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I79OXfC6bfQQ7kNvwG41A27&_nc_oc=AdrQ-PsktEY5B39JgHOvT1_Yu3TjS6ecsXuSLB6h6lyZ5zxQSqRGqNnVbPCn6k1DlIA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU_FCKQG94YmisqSjEtir2BT0NCV-pzBJaf-1g-FHDL3g&oe=6B0EEB96"}, {"file_name": "CharacterCatalog_Character_AR.png", "id": "1131015422620400", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624577_1131015425953733_562381279208309417_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWqmfXldI6IQ7kNvwG8fNjj&_nc_oc=AdoiE9s5UycoeDV6PRQhOJLxvaA4VSJjunwN_WFx0hIcDCMslkKaFXRzzyOcVc3br0Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVOKDF7-CV2E9iKKD38WOCUzy2SqOz0dMZ8-6_qOShj0w&oe=6B0F0611"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CatStudio Asset - Character Catalog -", "keywords": ["unity", "asset", "character"], "long_description": "Experience each character in VR and AR.\n\nCatStudio Asset - Character Catalog - is a viewer for the 3D character assets created by CatStudio, in VR and AR.\nWalk around life-size characters to see every detail, and switch motions to watch them move.\n\nIncluded characters (7 total):\n- Monsters series: Gnome / Cyclops / Evil Knight / Golem / Mummy / Goblin / Orc\n\nFeatures:\n- Life size: Walk around full-scale characters and inspect them up close\n- 16 motions: Stand, Walk, Run, Battle Attack and more. Characters with weapons draw and sheathe them with Battle In / Out\n- Head look: Characters turn to look at you as you approach\n- VR and AR: Switch between a virtual stage and the real world around you\n- AR display: Lighting that matches your surroundings (Auto Lighting), shadows on the floor (AR Floor), and characters hidden behind real objects (AR Occlusion)\n- Three head variations for Goblin\n- Choose from three appear / disappear effects\n- Open each character's introduction page and video\n- Adjust turning, volume and more in Options\n\nNote: AR Occlusion is supported on Meta Quest 3 / 3S only.", "short_description": "Experience each character in VR and AR. A viewer for CatStudio's 3D character assets: see them life-size and up close in VR, or bring them into the world around you in AR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.catstudio.jp/privacypolicy_quest.html", "developer_terms_of_service_url": null, "publisher_name": "CatStudio LLC", "support_website_url": null, "website_url": "https://www.catstudio.jp/xr_charactercatalog_en.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tra
 patterns, and boss encounters, your adventures always feel new.", "short_description": "A Boy A Shield And A Sword is a high paced, color slashing adventure.\n\nTrapped in a childhood dream, use your shield and your sword in creative ways and overcome your nightmares.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalportalgames.godaddysites.com/private-policy-bss", "developer_terms_of_service_url": null, "publisher_name": "Digital Portal Games LLC", "support_website_url": null, "website_url": "https://digitalportalgames.godaddysites.com/a-boy-a-shield-and-a-swor", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29000528402915912"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974466_1216454282404130_8000299056405811414_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ftd2NmUWtO8Q7kNvwFit4ET&_nc_oc=AdqlxuMcPh6m-U3qC9cpQQj_RsWJ78tuRL2o3EqkHT1TVD4rgPMyqMN2Q6eWkVthKDI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMygfb4BHgS69cbzLNRK1njz1Ag9C2MLEFb6c7IDgQ_RA&oe=6AE357B4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "A Boy A Shield And A Sword", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "con
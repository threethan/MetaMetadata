_nc_oc=Adp9E8qSfrW_b38inKl0fJB8drk_CcJkMkYvxygl9mCL94s7KiTSSXCAM90X4GgS8fY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSS73iSQ1OFOtawwK4SHN8JPklt0Mmaq2X2LERK3qoyNA&oe=6AF8AB42"}]}, "id": "1449037613702821", "locale": "en_US", "screenshots": [{"file_name": "screenshot01.png", "id": "758789270624918", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824700_758789273958251_6969508170895999372_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZM-35rrr1coQ7kNvwF7vuiQ&_nc_oc=AdogEmzuc_-tKPF4Z99tLtnYl5DXPqRYGZvLaW9dDniVD4ZglTFMq_Hc-lnA0qzDDtw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLNjcsIX1VZWeGUrACFShgq37SLQGLLzhpDWULw0Ak4Q&oe=6AF8AA2D"}, {"file_name": "screenshot06.png", "id": "1347518460879683", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827585_1347518464213016_1366990769821528650_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fS-V8OG9KkoQ7kNvwF8ZY2G&_nc_oc=AdqYK_afWod0tRGdHvUlyesiGWSaWEHHjuxn1bBJ2d9UduR-tzcuw9PnTywoQVzQAPk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLwiujbn9Stf5tr2LQjxlR7FaJudk8EBU8ILzhYMET0g&oe=6AF88A7B"}, {"file_name": "screenshot07.png", "id": "1409258500794757", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_1409258504128090_4766244097474490919_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lE4j6awf5hcQ7kNvwHtKWrw&_nc_oc=AdoOZqPueUj4DkoEvmDse3UxcMTI1p_vtyM9LZVqRCM94YRLs04KRJTHilZaPzNdZMg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhtsDZeUD_GaACvyxSfPK2uPDr6anJ082jdPBGXRl_Tw&oe=6AF88FC1"}, {"file_name": "screenshot05.png", "id": "2723584728024936", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828104_2723584738024935_1026674729403308787_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1JIKFRz3cQQ7kNvwHSzR_a&_nc_oc=Adp7phKkxUIpfAm8KW_PUiEujDO6BpAgLF7yC-bcdysH7sqWWoiDirgCMJpyJXphd3A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_2857FhdGDy3B0qmjeMQ_STrtpzgJOGD3LP3rMuweag&oe=6AF88B1A"}, {"file_name": "screenshot02.png", "id": "1035089742424944", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823930_1035089745758277_4290052347984452955_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqPsmJWNrsgQ7kNvwH5-DjR&_nc_oc=AdqceNQgS9dPzZ1ItBB1CEERYo_pncdnmtai7vY8UkYipYwvFSrRdB6MGKQ502bsMos&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3opb6w3K9OBxyGHRmW0TFDMC1h1e6lXfggoA1HhlFFw&oe=6AF88AB8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OnlyIPTV", "keywords": ["iptv", "player", "m3u", "xtream"], "long_description": "# Watch your own IPTV content on Meta Quest\n\nOnlyIPTV is a VR-friendly, 2D IPTV player designed for Meta Quest. It allows you to add and watch your own IPTV content through Xtream codes to your provide or by adding M3U playlists, with a clean interface built for comfortable live TV viewing in virtual reality.\n\n# A simple IPTV media player for VR\n\nWith OnlyIPTV, you can browse your live TV channels and movies playlists, and enjoy a simple yet complete media player experience directly on your Quest headset.\n\nThe app is designed for users who already have a legal IPTV subscription or a personal M3U playlist from their own provider.\n\n# Key features\n\n- IPTV player for Meta Quest\n- Support for M3U playlists\n- Support for Xtream Codes login, in this Premium version\n- Live TV replays when provided by your Xtream channels\n- Clean and simple playlist navigation in List or Gallery view mode. \n- App wall like scrolling among your movies posters in your VOD playlist.\n- Series management with seasons and automatic resume to your last episode\n- EPG support when guide data is provided by your playlist or added manually\n\n# Important\n\nOnlyIPTV does not provide TV channels, movies, subscriptions, playlists, or any media content.\n\nUsers must provide their own legal M3U playlist or Xtream Codes credentials from an authorized provider. OnlyIPTV is a media player only.", "short_description": "OnlyIPTV is an IPTV player for Meta Quest that lets you watch your own Xtream & M3U playlists, live TV channels, movies, and streaming playlists in a clean VR-friendly interface. It also supports EPG guide and Replays when provided by your playlist.\nCompared to the free version this version offers unlimited playlists and ads the possibility to conect to your Xtream provider."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onlyiptv.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "AT SoftSpot", "support_website_url": null, "website_url": "https://onlyiptv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "es"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1298556060005296"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823940_2079686439629455_6603362906018445476_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXwJLi5TZV8Q7kNvwH21juO&_nc_oc=AdoDRlvdmebBkFYZTqvy94PuqdOIoTMtmljrN0oTJAv2wkrXNgSU_-OUP8Lh67avZU8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQllaC3rf3hRztDkdx07Iy-bx4G5SfCJR04886Mg4Z1ag&oe=6AF89FB3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "OnlyIPTV", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1782252000, "lastRevision": {"nodes": [{"id": "1175620322298871", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1175620312298872", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2066901940868539"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1329907215523730", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OnlyIPTV", "keywords": [], "long_description": "# Regardez votre propre contenu IPTV sur Meta Quest\n\nOnlyIPTV est un lecteur IPTV gratuit, adapt\u00e9 \u00e0 la r\u00e9alit\u00e9 virtuelle et con\u00e7u pour Meta Quest. Il vous permet d\u2019ajouter et de regarder votre propre contenu IPTV via des playlists M3U, avec une interface claire pens\u00e9e pour un visionnage confortable de la TV en direct en r\u00e9alit\u00e9 virtuelle.\n\n# Un lecteur multim\u00e9dia IPTV simple pour la r\u00e9alit\u00e9 virtuelle\n\nAvec OnlyIPTV, vous pouvez parcourir vos cha\u00eenes TV en direct, organiser vos playlists et profiter d\u2019une exp\u00e9rience simple de lecteur multim\u00e9dia directement sur votre casque Quest.\n\nL\u2019application est con\u00e7ue pour les utilisateurs qui disposent d\u00e9j\u00e0 d\u2019un abonnement IPTV l\u00e9gal ou d\u2019une playlist M3U personnelle fournie par leur propre fournisseur.\n\n# Fonctionnalit\u00e9s principales\n\n- Lecteur IPTV pour Meta Quest\n- Prise en charge des playlists M3U\n- Prise en charge de la connexion Xtream Codes, disponible uniquement dans la version Premium\n- Navigation dans les cha\u00eenes TV en direct\n- Interface de lecteur multim\u00e9dia adapt\u00e9e \u00e0 la r\u00e9alit\u00e9 virtuelle\n- Navigation claire et simple dans les playlists\n- Con\u00e7u pour les playlists IPTV personnelles et les playlists de streaming\n- Prise en charge de l\u2019EPG lorsque les donn\u00e9es du guide sont fournies par votre playlist ou ajout\u00e9es manuellement\n\n# Important\n\nOnlyIPTV ne fournit pas de cha\u00eenes TV, de films, d\u2019abonnements, de playlists ni aucun contenu multim\u00e9dia.\n\nLes utilisateurs doivent fournir leur propre playlist M3U l\u00e9gale ou leurs identifiants Xtream", "short_description": "OnlyIPTV est un lecteur multim\u00e9dia IPTV gratuit pour Meta Quest qui vous permet de regarder vos propres playlists M3U, cha\u00eenes TV en direct, films et playlists de streaming dans une interface claire et adapt\u00e9e \u00e0 la r\u00e9alit\u00e9 virtuelle. L\u2019application prend \u00e9galement en charge les donn\u00e9es de guide TV EPG lorsqu\u2019elles sont fournies par votre playlist ou ajout\u00e9es manuellement."}, {"images": {"nodes": [{"file_name": "only-iptv-cover-meta-horizon.png", "id": "2101181424077307", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_2101181427410640_4284256583655577498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJF120nw7NwQ7kNvwHvjJ_X&_nc_oc=Adq_Vwye0Fra5b9r5nObn00Gx6LCueVoBEqkRZHjH1FpBq5G6Ovq8mcPqmPyyyQaXP8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrjFdgH6wg6qjJqrdIuywua9daKio7f3YMp3Lsuc3apQ&oe=6AF88152"}, {"file_name": "only-iptv-cover-meta-horizon-square-premium.png", "id": "2079686436296122", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823940_2079686439629455_6603362906018445476_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXwJLi5TZV8Q7kNvwH21juO&_nc_oc=AdoDRlvdmebBkFYZTqvy94PuqdOIoTMtmljrN0oTJAv2wkrXNgSU_-OUP8Lh67avZU8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_SqlnFtIsICGdd-nP4u-UWlOjGX-SyQejx7WiVXWU6w&oe=6AF89FB3"}, {"file_name": "layered_icon_composited.pn
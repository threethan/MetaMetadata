4697650944_2536168880300875659_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-lmFgsjJNYQ7kNvwFwzj0p&_nc_oc=Adrm0rVbu4xaamk0gRHyrLiySi268LeJYa63Is21FHaZDwBcGi2vvZljkuTYmVTR8ic&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVtMZovgB5r4epK-Bu--trISQLHHf2vhOSmM102idS8Q&oe=6AF89374"}, {"file_name": "screenshot02.png", "id": "1035089742424944", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823930_1035089745758277_4290052347984452955_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqPsmJWNrsgQ7kNvwH5-DjR&_nc_oc=AdqceNQgS9dPzZ1ItBB1CEERYo_pncdnmtai7vY8UkYipYwvFSrRdB6MGKQ502bsMos&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3opb6w3K9OBxyGHRmW0TFDMC1h1e6lXfggoA1HhlFFw&oe=6AF88AB8"}, {"file_name": "screenshot05.png", "id": "2723584728024936", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828104_2723584738024935_1026674729403308787_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1JIKFRz3cQQ7kNvwHSzR_a&_nc_oc=Adp7phKkxUIpfAm8KW_PUiEujDO6BpAgLF7yC-bcdysH7sqWWoiDirgCMJpyJXphd3A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_2857FhdGDy3B0qmjeMQ_STrtpzgJOGD3LP3rMuweag&oe=6AF88B1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image-trailer.png", "id": "1027680369756824", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825462_1027680373090157_7550551693394303313_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Dyf7D0kNbEQ7kNvwFMgRTI&_nc_oc=AdrA-gWlihrV6plwJjVCI8qma88mH6c7g8cy3JROopKiF3Wl_GDsai3-rfIPzdyTTlg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtcfyBW6Rn5mocyTypEfyS5K8x1fnwpdHK8Xniy2VYXw&oe=6AF8A84A"}, "display_name": "OnlyIPTV", "keywords": [], "long_description": "# Watch your own IPTV content on Meta Quest\n\nOnlyIPTV is a free, VR-friendly IPTV player designed for Meta Quest. It allows you to add and watch your own IPTV content through M3U playlists, with a clean interface built for comfortable live TV viewing in virtual reality.\n\n# A simple IPTV media player for VR\n\nWith OnlyIPTV, you can browse your live TV channels, organize your playlists, and enjoy a simple media player experience directly on your Quest headset.\n\nThe app is designed for users who already have a legal IPTV subscription or a personal M3U playlist from their own provider.\n\n# Key features\n\n- IPTV player for Meta Quest\n- Support for M3U playlists\n- Support for Xtream Codes login, in this Premium version\n- Live TV channel browsing\n- VR-friendly media player interface\n- Clean and simple playlist navigation\n- Designed for personal IPTV and streaming playlists\n- EPG support when guide data is provided by your playlist or added manually\n\n# Important\n\nOnlyIPTV does not provide TV channels, movies, subscriptions, playlists, or any media content.\n\nUsers must provide their own legal M3U playlist or Xtream Codes credentials from an authorized provider. OnlyIPTV is a media player only.", "short_description": "OnlyIPTV is a free IPTV media player for Meta Quest that lets you watch your own M3U playlists, live TV channels, movies, and streaming playlists in a clean VR-friendly interface. It also supports EPG guide data when provided by your playlist or added manually."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onlyiptv.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "AT SoftSpot", "support_website_url": null, "website_url": "https://onlyiptv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "es
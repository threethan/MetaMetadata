=00_AQReSMwgYQJO1-lrWTVPfKF2sPX6-bM5UUWaO4KbhulWjA&oe=6B0489B5"}, {"file_name": "Screenshot2.png", "id": "772621199966659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303839_772621203299992_901764100694895677_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcTy_-FlpGgQ7kNvwGHq277&_nc_oc=AdoLIc23wVF3W4guZbjh1SZD_65PcuNttvOdSQuun4rUPRkWRbP9vUD9BJOVZ7oZ-R0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwNhc51kiESd6S9Tcse2yLyhcvCsx_Uqlc3MfvJXOtmw&oe=6B048869"}, {"file_name": "Screenshot4.png", "id": "621166988563325", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75236132_621166991896658_5926173084447122477_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ws1SOjkyMk4Q7kNvwEaVodD&_nc_oc=Ado5bLAaBPXmBJ2l8CDcRP2lloqM8_0RlHQAmw_T3F6BGINWOgAxlPq2v_towXE7FC8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5rsLvgxj6BkhOXxlRQFid62NEiRwyPY1Yfwzqnukkng&oe=6B048A2B"}, {"file_name": "Screenshot5.png", "id": "387741545589296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195906_387741548922629_7225152166692278936_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mk7Y3a08mDQQ7kNvwG1laJP&_nc_oc=AdrqwX7tOjGcz8iASE8jcRFqA708y3ihWqwqOGM_P3JfY__T9yl2UpMFdbCeKQ_hzeE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVtgUZU2qyasnabtvoK5QxK_bOHuUsx0eAZBg6PJ5QMA&oe=6B047A0F"}, {"file_name": "Screenshot3.png", "id": "341528160625264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031590_341528163958597_8138720215760918648_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6-0FDs0deYQ7kNvwHeNIHB&_nc_oc=AdrrkgDARCClwl64e2E98WHUXKhlxZ9I3yT17OKKdHwDUrzZ6QdzsCowPdMU-U_2d-o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQO2h9KAu7-cI18Dg7A018ERdI1mxk0R5dHEtqQAqBHDQ&oe=6B045BE8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TimeSnap: The Boston Massacre", "keywords": ["history"], "long_description": "What caused British soldiers to shoot into a crowd of British colonists on March 5, 1770? In this TimeSnap, players investigate the causes of the Boston Massacre by listening to historical figures, discovering primary sources, and asking probing questions. With evidence collected from significant sites across colonial Boston, players weigh competing perspectives, contextualize the events of March 5th, and construct a multi-factored explanation of the Boston Massacre.\n\nTimeSnap is a 20-30 minute experience designed for use in high school American history classrooms and includes full lesson plans and materials from the project website. It also makes for a great standalone experience for history buffs of any age.", "short_description": "As an agent for C.A.R.P.A. (Chronological Advanced Research Projects Agency) in a slightly dystopian future, travel back in time to restore the world's understanding of history and how the events of yesteryear reverberate and inform today. You'll navigate rich visual scenes, discover historical items and documents, and read the minds of people (including Paul Revere). In this TimeSnap, you'll explore the causes of what became known as the Boston Massacre in 1770."}]}, "developer_name": "Electric Funstuff", "developer_privacy_policy_url": "https://www.wnet.org/about/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "WNET", "support_website_url": "https://www.mission-us.org/timesnap/", "website_url": "https://www.mission-us.org/timesnap/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nul
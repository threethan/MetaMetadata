=00_AQQYk6PlgtTH6-Dsz0pZHdRR4PMzW5S6Q0ovXVc-sxxVaw&oe=6B06F475"}, {"file_name": "Screenshot2.png", "id": "772621199966659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303839_772621203299992_901764100694895677_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcTy_-FlpGgQ7kNvwGf3Bxc&_nc_oc=AdqKdJmLmm48Ivr0KsWdHj59a0OrmCeY5x2xedHOL3m9ax1zR6RAh3sP3dTBm3tKNb4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRq8XGKq37G5B26DKH2jsur-5IM7pENmj_VKv310ZaqAQ&oe=6B06F329"}, {"file_name": "Screenshot4.png", "id": "621166988563325", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75236132_621166991896658_5926173084447122477_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Od8duHTUc7MQ7kNvwE2oWH3&_nc_oc=AdpB5Azu6Hx82uvsM9kvpNnqf_x0f68Ok7lSV3sYsVIkfl0IhkHjonEDFoTwH5OCCHA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3hsbZKZTNnT4WqOgxlgWBrRy2mvL5L7P1HfRygqhC2Q&oe=6B06F4EB"}, {"file_name": "Screenshot5.png", "id": "387741545589296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195906_387741548922629_7225152166692278936_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hub-74KS0F4Q7kNvwHQt7nS&_nc_oc=AdodkU6N40sqNUhEBcWgMCMRwKnatBsFWiGG137pla9IWn9w9PdkLlEQe7A1wiiSYVU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-0fljnijxoZVNZirMEPooYHydVMTn8_BIqgr5vtBoJw&oe=6B071D0F"}, {"file_name": "Screenshot3.png", "id": "341528160625264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031590_341528163958597_8138720215760918648_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6-0FDs0deYQ7kNvwG0n-U-&_nc_oc=Adr9OjTNWTd85tIJPn-yWttY6VcUfTbZFZ70LepFGwwYPV9OQE1scm-th2mLV-O2Erw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSq7-YY7Vf8-dzCpH20CGqtLXFGJpfxvReQYf9w-DroRA&oe=6B06FEE8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TimeSnap: The Boston Massacre", "keywords": ["history"], "long_description": "What caused British soldiers to shoot into a crowd of British colonists on March 5, 1770? In this TimeSnap, players investigate the causes of the Boston Massacre by listening to historical figures, discovering primary sources, and asking probing questions. With evidence collected from significant sites across colonial Boston, players weigh competing perspectives, contextualize the events of March 5th, and construct a multi-factored explanation of the Boston Massacre.\n\nTimeSnap is a 20-30 minute experience designed for use in high school American history classrooms and includes full lesson plans and materials from the project website. It also makes for a great standalone experience for history buffs of any age.", "short_description": "As an agent for C.A.R.P.A. (Chronological Advanced Research Projects Agency) in a slightly dystopian future, travel back in time to restore the world's understanding of history and how the events of yesteryear reverberate and inform today. You'll navigate rich visual scenes, discover historical items and documents, and read the minds of people (including Paul Revere). In this TimeSnap, you'll explore the causes of what became known as the Boston Massacre in 1770."}]}, "developer_name": "Electric Funstuff", "developer_privacy_policy_url": "https://www.wnet.org/about/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "WNET", "support_website_url": "https://www.mission-us.org/timesnap/", "website_url": "https://www.mission-us.org/timesnap/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nul
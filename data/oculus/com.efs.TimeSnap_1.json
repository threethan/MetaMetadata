1688_347388886336803_3938685633159959883_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LgIptTCRG4Q7kNvwEdLkHh&_nc_oc=Adrui9wJupWb4RxI0h1n3KMnKo80o5Wg2Q-61FsaY6DJppI7UAP0Ex25EYhiQMltTHk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jlhuXWxmYX75JK1DDYr5rN8WmALGV9vXP9LU0M3MWdQ&oe=69D4F8A6"}]}, "id": "920605115090481", "locale": "en_US", "screenshots": [{"file_name": "Screenshot1.png", "id": "1229688317403814", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575369_1229688320737147_6287395094218696818_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NG74CmTWWWUQ7kNvwGeMUZU&_nc_oc=AdrGbQoFYA77tTNlYzJX2GxvAA2VKwu96kkVtFJSlXS48_QD64_sPLjef-WwyHooj1Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gAkAsJYU6rKDEip4tVV6nvU624zG8xa3r_sbkQc1GXA&oe=69D51875"}, {"file_name": "Screenshot2.png", "id": "772621199966659", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75303839_772621203299992_901764100694895677_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDhY27bUBTMQ7kNvwFtGSvv&_nc_oc=Adpji0p2peh28V0DNyry4FWaRC6pbdA2PAHgBrbBPkyPwTqdfipa-cf4XoN0D6D8zlw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Pet4dLlVQN7tctK_bE42beKoTITRymXVQwiyMI088Xg&oe=69D51729"}, {"file_name": "Screenshot4.png", "id": "621166988563325", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75236132_621166991896658_5926173084447122477_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQcekhI26NIQ7kNvwHzI_DX&_nc_oc=Adpo118CDf0JQWOeThMQ-HroTxmfCoIjoydUSeU-v9GgyOghvaFsMsr4EMaThUr9SRQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pNG726_LZsNWP8hNCufmcXTiz0pxVk69B5yz3Ca09Pw&oe=69D518EB"}, {"file_name": "Screenshot5.png", "id": "387741545589296", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195906_387741548922629_7225152166692278936_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7d6havqEBgQ7kNvwH-O1c5&_nc_oc=Adofib6_3w4VSn9B2OBoVakhQ7GWx2mWrnzVteexTZE7Rr-_oeFzKY47ou8iF0AVKZw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af242v-LMQ6XnsQU9TyKg1nwoo4PqvG-71w7_3ByxDe_2w&oe=69D508CF"}, {"file_name": "Screenshot3.png", "id": "341528160625264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031590_341528163958597_8138720215760918648_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9A-lKkYcG8cQ7kNvwEkohtw&_nc_oc=AdpMSZbsksw1sv3NdpyYbtgthknl0z7kPSfO0xzSjvkgSjIRQcEOXqO2o37Ken95ZXg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CMaVWQGLgQrh5K_6XNnmQPWxPnm-kmyaL27Jznrmt_g&oe=69D4EAA8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TimeSnap: The Boston Massacre", "keywords": ["history"], "long_description": "What caused British soldiers to shoot into a crowd of British colonists on March 5, 1770? In this TimeSnap, players investigate the causes of the Boston Massacre by listening to historical figures, discovering primary sources, and asking probing questions. With evidence collected from significant sites across colonial Boston, players weigh competing perspectives, contextualize the events of March 5th, and construct a multi-factored explanation of the Boston Massacre.\n\nTimeSnap is a 20-30 minute experience designed for use in high school American history classrooms and includes full lesson plans and materials from the project website. It also makes for a great standalone experience for history buffs of any age.", "short_description": "As an agent for C.A.R.P.A. (Chronological Advanced Research Projects Agency) in a slightly dystopian future, travel back in time to restore the world's understanding of history and how the events of yesteryear reverberate and inform today. You'll navigate rich visual scenes, discover historical items and documents, and read the minds of people (including Paul Revere). In this TimeSnap, you'll explore the causes of what became known as the Boston Massacre in 1770."}]}, "developer_name": "Electric Funstuff", "developer_privacy_po
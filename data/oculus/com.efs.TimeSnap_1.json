=00_AQTC7BJbdUC3scqm7nDrRO8B8kDEE5k5WgNEoPXLSbf5zw&oe=6B0845F5"}, {"file_name": "Screenshot2.png", "id": "772621199966659", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75303839_772621203299992_901764100694895677_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDv7SZHqQdkQ7kNvwHXI8MO&_nc_oc=Ado1IFumEzf6tForZl0cy3UGMX8vYdYXi8LuZwNHXhc3-qCdfBB7X7Z3D6a7wvKrQ4Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9UA0X4J2Ct2mVCd2U9oA64v2JG00WNcVWZ53ObSOjHA&oe=6B0844A9"}, {"file_name": "Screenshot4.png", "id": "621166988563325", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75236132_621166991896658_5926173084447122477_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Od8duHTUc7MQ7kNvwG7-8J-&_nc_oc=AdpKCfUs8NKyEn5eSuQesDIHS_ROWpsf9FtTSUDTLTq2m6vntSjtwp9dHFG8rX88fLs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR29XP1Pa9HdzjcMEIJ1MKY1PtkyXPOkNz_O_jWXc4rZg&oe=6B08466B"}, {"file_name": "Screenshot5.png", "id": "387741545589296", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75195906_387741548922629_7225152166692278936_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hub-74KS0F4Q7kNvwEoY26B&_nc_oc=AdrW3ggpspsBQEEYbmIENNt1ihfDyC1etsgoUSjSq56kdU_tbjBxwg_8ZxZeFxyO1_c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1s7dUPgPNOGFXy1hqSbCwPLK98W2UcU1wbqCapIBqag&oe=6B086E8F"}, {"file_name": "Screenshot3.png", "id": "341528160625264", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031590_341528163958597_8138720215760918648_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRiy5zYqBxkQ7kNvwHZunfw&_nc_oc=Adqr5nLsf_FyXu8UH1Okfq9a58NGfKpKnPYCoIitqpb-1KCc7vIrceE7ejDUFZwi6Xw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpw9A8LugU0Pe2B8IBQzBLSj9UVmBbBeArNEknH_u0dg&oe=6B085068"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TimeSnap: The Boston Massacre", "keywords": ["history"], "long_description": "What caused British soldiers to shoot into a crowd of British colonists on March 5, 1770? In this TimeSnap, players investigate the causes of the Boston Massacre by listening to historical figures, discovering primary sources, and asking probing questions. With evidence collected from significant sites across colonial Boston, players weigh competing perspectives, contextualize the events of March 5th, and construct a multi-factored explanation of the Boston Massacre.\n\nTimeSnap is a 20-30 minute experience designed for use in high school American history classrooms and includes full lesson plans and materials from the project website. It also makes for a great standalone experience for history buffs of any age.", "short_description": "As an agent for C.A.R.P.A. (Chronological Advanced Research Projects Agency) in a slightly dystopian future, travel back in time to restore the world's understanding of history and how the events of yesteryear reverberate and inform today. You'll navigate rich visual scenes, discover historical items and documents, and read the minds of people (including Paul Revere). In this TimeSnap, you'll explore the causes of what became known as the Boston Massacre in 1770."}]}, "developer_name": "Electric Funstuff", "developer_privacy_policy_url": "https://www.wnet.org/about/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "WNET", "support_website_url": "https://www.mission-us.org/timesnap/", "website_url": "https://www.mission-us.org/timesnap/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nul